diff --git a/asdf/_raw_tree.py b/asdf/_raw_tree.py
new file mode 100644
index 0000000..6c69bec
--- /dev/null
+++ b/asdf/_raw_tree.py
@@ -0,0 +1,222 @@
+import importlib
+
+from . import tagged
+from .lazy_nodes import AsdfDictNode, AsdfListNode, AsdfOrderedDictNode, _AsdfNode, _resolve_af_ref
+from .tags.core import AsdfObject
+
+_NDARRAY_PREFIX = "tag:stsci.edu:asdf/core/ndarray-"
+
+
+def is_lazy(node):
+    return isinstance(node, _AsdfNode) or (isinstance(node, AsdfObject) and isinstance(node.data, _AsdfNode))
+
+
+def _lazy_of(node):
+    if isinstance(node, AsdfObject) and isinstance(node.data, _AsdfNode):
+        return node.data
+    return node
+
+
+def is_raw(value):
+    return isinstance(value, (tagged.Tagged, dict, list)) and not isinstance(value, (_AsdfNode, AsdfObject))
+
+
+def raw_children(node):
+    node = _lazy_of(node)
+    if not isinstance(node, _AsdfNode):
+        return None
+    af = _resolve_af_ref(node._af_ref)
+    items = enumerate(node.data) if isinstance(node, AsdfListNode) else node.data.items()
+    children = []
+    for key, value in items:
+        if is_raw(value) and (obj := af._tagged_object_cache.retrieve(value)) is not None:
+            value = obj
+        children.append((key, value))
+    return children
+
+
+def owner(node):
+    node = _lazy_of(node)
+    if isinstance(node, _AsdfNode):
+        return _resolve_af_ref(node._af_ref)
+    return None
+
+
+def is_pending(value, extension_manager):
+    return isinstance(value, tagged.Tagged) and extension_manager.handles_tag(value._tag)
+
+
+def materialize(value, af):
+    if af is None or not isinstance(value, tagged.Tagged):
+        return value
+    if (obj := af._tagged_object_cache.retrieve(value)) is not None:
+        return obj
+    if not af.extension_manager.handles_tag(value._tag):
+        return value
+    from .yamlutil import tagged_tree_to_custom_tree
+
+    obj = tagged_tree_to_custom_tree(value, af)
+    af._tagged_object_cache.store(value, obj)
+    return obj
+
+
+def pending_fields(raw):
+    if raw._tag.startswith(_NDARRAY_PREFIX) and isinstance(raw, tagged.TaggedDict):
+        shape = raw.get("shape", [])
+        return [("shape", tuple(shape) if isinstance(shape, list) else shape), ("dtype", raw.get("datatype"))]
+    if isinstance(raw, tagged.TaggedDict):
+        return list(raw.data.items())
+    if isinstance(raw, tagged.TaggedList):
+        return list(enumerate(raw.data))
+    return []
+
+
+def children(node, extension_manager, expand=False):
+    raw = raw_children(node)
+    if raw is not None:
+        return raw
+    if is_pending(node, extension_manager):
+        return pending_fields(node) if expand else []
+    from .treeutil import get_children
+
+    return get_children(node)
+
+
+def declared_types(raw, extension_manager):
+    tag = getattr(raw, "_tag", None)
+    if tag is None or not extension_manager.handles_tag(tag):
+        return None
+    types = []
+    for typ in extension_manager.get_converter_for_tag(tag).types:
+        if isinstance(typ, str):
+            module_name, _, class_name = typ.rpartition(".")
+            try:
+                typ = getattr(importlib.import_module(module_name), class_name)
+            except (ImportError, AttributeError):
+                return None
+        types.append(typ)
+    return types
+
+
+def type_label(raw, extension_manager):
+    types = declared_types(raw, extension_manager)
+    if types and len({t.__name__ for t in types}) == 1:
+        return types[0].__name__
+    return raw._tag.rpartition("/")[-1]
+
+
+def fully_qualified(typ):
+    if typ.__module__ == "builtins":
+        return typ.__name__
+    return f"{typ.__module__}.{typ.__name__}"
+
+
+class _WriteView:
+    def __init__(self, af, serialization_context):
+        self._af = af
+        self._ctx = serialization_context
+        self._manager = serialization_context.extension_manager
+        self._memo = {}
+        self._private_blocks = self._has_private_blocks()
+
+    def _has_private_blocks(self):
+        claimed = set()
+
+        def _collect(node):
+            if isinstance(node, tagged.TaggedDict) and node._tag.startswith(_NDARRAY_PREFIX):
+                if isinstance(node.get("source"), int):
+                    claimed.add(node["source"])
+            if isinstance(node, (dict, tagged.TaggedDict)):
+                for value in node.values():
+                    _collect(value)
+            elif isinstance(node, (list, tagged.TaggedList)):
+                for value in node:
+                    _collect(value)
+
+        root = _lazy_of(self._af._tree)
+        if isinstance(root, _AsdfNode):
+            _collect(root.data)
+        return len(claimed) < len(self._af._blocks.blocks)
+
+    def build(self, node, parent=None, key=None):
+        if id(node) in self._memo:
+            return self._memo[id(node)]
+        if isinstance(node, AsdfObject) and isinstance(node.data, _AsdfNode):
+            result = AsdfObject()
+            self._memo[id(node)] = result
+            result.data = self._container(node.data, {})
+        elif isinstance(node, _AsdfNode):
+            result = self._container(node, [] if isinstance(node, AsdfListNode) else {})
+        elif isinstance(node, tagged.Tagged):
+            if (obj := self._af._tagged_object_cache.retrieve(node)) is not None:
+                return obj
+            result = self._tagged(node, parent, key)
+        elif isinstance(node, (dict, list)) and parent is not None:
+            result = self._plain(node)
+        else:
+            return node
+        self._memo[id(node)] = result
+        return result
+
+    def _container(self, lazy, result):
+        if isinstance(lazy, AsdfOrderedDictNode):
+            result = type(lazy.data)()
+        self._memo[id(lazy)] = result
+        for key, value in raw_children(lazy):
+            child = self.build(value, lazy, key)
+            if isinstance(result, list):
+                result.append(child)
+            else:
+                result[key] = child
+        return result
+
+    def _plain(self, node):
+        result = type(node)()
+        self._memo[id(node)] = result
+        items = enumerate(node) if isinstance(node, list) else node.items()
+        for key, value in items:
+            child = self.build(value, node, key)
+            if isinstance(result, list):
+                result.append(child)
+            else:
+                result[key] = child
+        return result
+
+    def _tagged(self, raw, parent, key):
+        tag = raw._tag
+        handled = self._manager.handles_tag(tag)
+        if tag.startswith(_NDARRAY_PREFIX) or (handled and self._private_blocks):
+            return self._force(raw, parent, key)
+        if handled:
+            self._ctx._mark_extension_used(self._manager.get_converter_for_tag(tag).extension)
+        if isinstance(raw, tagged.TaggedString):
+            return raw
+        result = type(raw)(tag=tag)
+        self._memo[id(raw)] = result
+        items = enumerate(raw.data) if isinstance(raw, tagged.TaggedList) else raw.data.items()
+        for child_key, value in items:
+            child = self.build(value, raw, child_key)
+            if isinstance(result, tagged.TaggedList):
+                result.append(child)
+            else:
+                result[child_key] = child
+        return result
+
+    def _force(self, raw, parent, key):
+        if isinstance(parent, _AsdfNode):
+            return parent[key]
+        from .yamlutil import tagged_tree_to_custom_tree
+
+        obj = tagged_tree_to_custom_tree(raw, self._af)
+        self._af._tagged_object_cache.store(raw, obj)
+        if parent is not None:
+            parent[key] = obj
+        return obj
+
+
+def write_view(tree, af, serialization_context):
+    if af is None or not is_lazy(tree):
+        return tree
+    if getattr(af, "_read_version", None) != af.version:
+        return tree
+    return _WriteView(af, serialization_context).build(tree)
