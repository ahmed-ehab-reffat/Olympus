+        if "GROUP" in keyword:
+            return [p for p in positions if not low <= p <= high]
+        if "TIES" in keyword:
+            return [p for p in positions if p == position or not low <= p <= high]
+        return positions
+
+    def _peer_bounds(self, keys):
+        length = len(keys)
+        first = [0] * length
+        last = [0] * length
+        start = 0
+        while start < length:
+            end = start
+            while end + 1 < length and keys[end + 1] == keys[start]:
+                end += 1
+            for i in range(start, end + 1):
+                first[i] = start
+                last[i] = end
+            start = end + 1
+        return first, last
+
+    def _group_meta(self, keys):
+        groups = []
+        group_index = [0] * len(keys)
+        start = 0
+        while start < len(keys):
+            end = start
+            while end + 1 < len(keys) and keys[end + 1] == keys[start]:
+                end += 1
+            for i in range(start, end + 1):
+                group_index[i] = len(groups)
+            groups.append((start, end))
+            start = end + 1
+        return groups, group_index
+
+    def _window_reducer(self, kind):
+        return self.env[kind.sql_names()[0].upper()]
