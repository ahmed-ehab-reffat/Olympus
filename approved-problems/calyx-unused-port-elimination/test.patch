+use calyx_frontend as frontend;
+use calyx_ir as ir;
+use calyx_opt::pass_manager::PassManager;
+use std::collections::{HashMap, HashSet};
+use std::path::PathBuf;
+
+fn compile(label: &str, src: &str, opts: &[String]) -> ir::Context {
+    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let path = std::env::temp_dir().join(format!("calyx_dpe_{label}.futil"));
+    std::fs::write(&path, src).unwrap();
+    let ws = frontend::Workspace::construct(&Some(path.clone()), &[root])
+        .expect("failed to build workspace");
+    let mut ctx = ir::from_ast::ast_to_ir(
+        ws,
+        ir::from_ast::AstConversionConfig::default(),
+    )
+    .expect("failed to build ir");
+    ctx.extra_opts = opts.to_vec();
+    let pm = PassManager::default_passes().unwrap();
+    pm.execute_plan(
+        &mut ctx,
+        &["dead-port-elimination".to_string()],
+        &[],
+        &[],
+        false,
+    )
+    .expect("failed to run dead-port-elimination");
+    std::fs::remove_file(&path).ok();
+    ctx
+}
+
+fn build(label: &str, src: &str, opts: &[String]) -> String {
+    let ctx = compile(label, src, opts);
+    let mut buf = Vec::new();
+    for comp in &ctx.components {
+        ir::Printer::write_component(comp, &mut buf).unwrap();
+        buf.push(b'\n');
+    }
+    String::from_utf8(buf).unwrap()
+}
+
+fn run(label: &str, src: &str) -> String {
+    build(label, src, &[])
+}
+
+/// Run the pass and then the repository's own well-formedness checker. Returns
+/// true when the rewritten program is still structurally valid, which fails if
+/// the pass removed a port whose value some surviving construct still needs.
+fn stays_well_formed(label: &str, src: &str) -> bool {
+    let root = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let path = std::env::temp_dir().join(format!("calyx_dpe_wf_{label}.futil"));
+    std::fs::write(&path, src).unwrap();
+    let ws = frontend::Workspace::construct(&Some(path.clone()), &[root])
+        .expect("failed to build workspace");
+    let mut ctx = ir::from_ast::ast_to_ir(
+        ws,
+        ir::from_ast::AstConversionConfig::default(),
+    )
+    .expect("failed to build ir");
+    let pm = PassManager::default_passes().unwrap();
+    let result = pm.execute_plan(
+        &mut ctx,
+        &[
+            "dead-port-elimination".to_string(),
+            "well-formed".to_string(),
+        ],
+        &[],
+        &[],
+        false,
+    );
+    std::fs::remove_file(&path).ok();
+    result.is_ok()
+}
+
+fn report(label: &str, src: &str) -> serde_json::Value {
+    let path = std::env::temp_dir().join(format!("calyx_dpe_{label}.json"));
+    let opt = format!("dead-port-elimination:dump={}", path.display());
+    build(label, src, &[opt]);
+    let out = std::fs::read_to_string(&path).expect("no report was written");
+    std::fs::remove_file(&path).ok();
+    serde_json::from_str(&out).expect("report is not valid json")
+}
+
+fn signature(out: &str, comp: &str) -> String {
+    let needle = format!("component {comp}");
+    out.lines()
+        .find(|line| {
+            let trimmed = line.trim_start();
+            trimmed.starts_with(&needle)
+                && trimmed[needle.len()..].starts_with(['(', '<'])
+        })
+        .unwrap_or_else(|| panic!("component `{comp}` not found in:\n{out}"))
+        .trim()
+        .trim_end_matches('{')
+        .trim()
+        .to_string()
+}
+
+fn body_has(out: &str, text: &str) -> bool {
+    out.lines().any(|line| line.trim() == text)
+}
+
+fn binding_present(out: &str, text: &str) -> bool {
+    out.lines()
+        .any(|line| line.trim().trim_end_matches(',') == text)
+}
+
+const PREAMBLE: &str = concat!(
+    "import \"primitives/core.futil\";\n",
+    "import \"primitives/memories/comb.futil\";\n"
+);
+
+fn program(body: &str) -> String {
+    format!("{PREAMBLE}{body}")
+}
