+    r = reg0.out;
+    s = b;
+  }
+  control { g; }
+}
+component mid(x: 32) -> (y: 32) {
+  cells { l = leaf(); r0 = std_reg(32); }
+  wires {
+    group g2 { r0.in = l.r; r0.write_en = 1'd1; g2[done] = r0.done; }
+    y = r0.out;
+  }
+  control { seq { invoke l(a = x, b = x)(); g2; } }
+}
+component main() -> () {
+  cells { m = mid(); src = std_reg(32); }
+  wires { }
+  control { invoke m(x = src.out)(); }
+}
+"#,
+        ),
