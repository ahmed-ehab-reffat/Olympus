+#[test]
+fn every_instance_keeps_exactly_the_ports_its_component_declares() {
+    let ctx = compile(
+        "instance_ports",
+        &program(
+            r#"
+component leaf(a: 32, b: 32) -> (r: 32, s: 32) {
+  cells { reg0 = std_reg(32); }
+  wires {
+    group g { reg0.in = a; reg0.write_en = 1'd1; g[done] = reg0.done; }
+    r = reg0.out;
+    s = b;
+  }
+  control { g; }
+}
+component mid(x: 32) -> (y: 32) {
+  cells { l = leaf(); r0 = std_reg(32); }
+  wires {
+    group g2 { r0.in = l.r; r0.write_en = 1'd1; g2[done] = r0.done; }
+    y = r0.out;
+  }
+  control { seq { invoke l(a = x, b = x)(); g2; } }
+}
+component main() -> () {
+  cells { m = mid(); src = std_reg(32); }
+  wires { }
+  control { invoke m(x = src.out)(); }
+}
+"#,
+        ),
+        &[],
+    );
+    let declared: HashMap<ir::Id, HashSet<ir::Id>> = ctx
+        .components
+        .iter()
+        .map(|comp| {
+            let ports = comp
+                .signature
+                .borrow()
+                .ports
+                .iter()
+                .map(|port| port.borrow().name)
+                .collect();
+            (comp.name, ports)
+        })
+        .collect();
+    for comp in &ctx.components {
+        for cell in comp.cells.iter() {
+            let cell = cell.borrow();
+            let ir::CellType::Component { name } = &cell.prototype else {
+                continue;
+            };
+            let actual: HashSet<ir::Id> =
+                cell.ports.iter().map(|port| port.borrow().name).collect();
+            assert_eq!(
+                actual,
+                declared[name],
+                "instance `{}` of `{}` disagrees with the component signature",
+                cell.name(),
+                name
+            );
+        }
+    }
+}
