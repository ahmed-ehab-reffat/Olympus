+#!/usr/bin/env bash
+set -u
+
+export PATH="/root/.cargo/bin:$PATH"
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TARGET="port_elim_21f11a"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+# Run a cargo test target and convert the libtest json stream into JUnit
+# testsuite elements on stdout.
+cargo_suites() {
+  local json="$WORK/cargo.json" err="$WORK/cargo.err" xml="$WORK/cargo.xml"
+  cargo test --offline "$@" -- -Z unstable-options --format json --report-time \
+    > "$json" 2> "$err"
+  printf %s "$?" > "$WORK/cargo.status"
+  cat "$err" >&2
+  cargo2junit < "$json" > "$xml" 2>/dev/null
+  if grep -q '<testcase' "$xml"; then
+    sed -n '/<testsuite /,/<\/testsuite>/p' "$xml"
+  else
+    local detail
+    detail=$( { cat "$err"; cat "$json"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    printf '<testsuite name="cargo-build" tests="1" failures="1" errors="0">\n'
+    printf '<testcase name="compilation" classname="cargo-build"><failure message="build failed"><![CDATA[%s]]></failure></testcase>\n' "$detail"
+    printf '</testsuite>\n'
+    printf 1 > "$WORK/cargo.status"
+  fi
+}
+
+# Replay the golden compilation tests the way the repository's runt
+# configuration does and report each file as its own testcase.
+golden_suite() {
+  local total=0 failed=0 body="" f e flags out err code actual
+  for f in $(find tests/passes -name '*.futil' | sort); do
+    e="${f%.futil}.expect"
+    [ -f "$e" ] || continue
+    total=$((total + 1))
+    flags="$(head -n 1 "$f" | cut -c 3-)"
+    out=$(./target/debug/calyx "$f" $flags -m file -l . 2>"$WORK/err" \
+      | sed "s|extern \"$PWD/|extern \"<ROOT>/calyx/|")
+    code=$?
+    err=$(cat "$WORK/err")
+    actual=""
+    [ -n "$out" ] && actual="$out"
+    if [ -n "$err" ]; then
+      [ -n "$actual" ] && actual="$actual
+"
+      actual="$actual---STDERR---
+$err"
+    fi
+    if [ "$code" -ne 0 ]; then
+      [ -n "$actual" ] && actual="$actual
+"
+      actual="$actual---CODE---
+$code"
+    fi
+    if [ "$actual" = "$(cat "$e")" ]; then
+      body="$body<testcase name=\"$(printf '%s' "$f" | xml_escape)\" classname=\"golden\"/>
+"
+    else
+      failed=$((failed + 1))
+      body="$body<testcase name=\"$(printf '%s' "$f" | xml_escape)\" classname=\"golden\"><failure message=\"output does not match $e\"/></testcase>
+"
+    fi
+  done
+  printf '<testsuite name="golden" tests="%s" failures="%s" errors="0">\n%s</testsuite>\n' \
+    "$total" "$failed" "$body"
+  printf %s "$failed" > "$WORK/golden.failed"
+}
+
+STATUS=0
+SUITES=""
+
+if [ "$MODE" = "new" ]; then
+  SUITES=$(cargo_suites --test "$NEW_TARGET")
+  STATUS=$(cat "$WORK/cargo.status")
+else
+  cargo build --offline -p calyx >&2
+  SUITES=$(golden_suite)
+  [ "$(cat "$WORK/golden.failed")" -eq 0 ] || STATUS=1
+  SUITES="$SUITES
+$(cargo_suites --lib -p calyx-utils -p calyx-frontend)"
+  [ "$(cat "$WORK/cargo.status")" -eq 0 ] || STATUS=1
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+    printf '%s\n' "$SUITES"
+    printf '</testsuites>\n'
+  } > "$OUTPUT_PATH"
+fi
+
+exit $STATUS
