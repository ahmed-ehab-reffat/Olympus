+#[test]
+fn unread_output_port_is_removed() {
+    let out = run(
+        "unread_output",
+        &program(
+            r#"
+component leaf(a: 32) -> (r: 32) {
+  cells { reg0 = std_reg(32); }
+  wires {
+    group g { reg0.in = a; reg0.write_en = 1'd1; g[done] = reg0.done; }
+    r = reg0.out;
+  }
+  control { g; }
+}
+component main() -> () {
+  cells { l = leaf(); src = std_reg(32); }
+  wires { }
+  control { invoke l(a = src.out)(); }
+}
+"#,
+        ),
+    );
+    assert_eq!(
+        signature(&out, "leaf"),
+        "component leaf(a: 32, @go go: 1, @clk clk: 1, @reset reset: 1) -> (@done done: 1)"
+    );
+}
