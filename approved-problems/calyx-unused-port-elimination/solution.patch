+use calyx_ir::{self as ir, RRC};
+use std::collections::{HashMap, HashSet};
+
+/// A port on a component signature, identified by the name of the component and
+/// the name of the port.
+pub type SignaturePort = (ir::Id, ir::Id);
+
+/// A `ref` cell in a component's signature, identified by the name of the
+/// component and the name of the cell.
+pub type SignatureRef = (ir::Id, ir::Id);
+
+/// Whole-program liveness information for component signatures.
+///
+/// A signature port is live when removing it could change the behavior of the
+/// program. Because the analysis is whole-program, an output port is live only
+/// when some instantiation of the component has that port read, and an input
+/// port is live only when the body of the component reads it.
+///
+/// The two facts depend on each other: dropping a read of an instance port can
+/// make a port of the instantiated component dead, which in turn drops more
+/// reads. [PortLiveness] therefore computes the least set of live ports that is
+/// closed under both rules.
+pub struct PortLiveness {
+    live_ports: HashSet<SignaturePort>,
+    live_refs: HashSet<SignatureRef>,
+    live_comb: HashSet<(ir::Id, ir::Id)>,
+}
+
+/// Ports that the compiler uses to implement the go-done protocol. They are
+/// never removed because the surrounding machinery assumes they exist.
+fn is_interface_port(port: &ir::Port) -> bool {
+    port.attributes.has(ir::NumAttr::Go)
+        || port.attributes.has(ir::NumAttr::Done)
+        || port.attributes.has(ir::BoolAttr::Clk)
+        || port.attributes.has(ir::BoolAttr::Reset)
+}
+
+/// The component instantiated by `cell`, if the cell is an instance of a
+/// component defined in this program.
+fn instance_of(cell: &ir::Cell) -> Option<ir::Id> {
+    match &cell.prototype {
+        ir::CellType::Component { name } => Some(*name),
+        _ => None,
+    }
+}
+
+/// The `(value, width)` of a constant if `port` belongs to a constant cell.
+fn const_of(port: &ir::Port) -> Option<(u64, u64)> {
+    let ir::PortParent::Cell(cell_wref) = &port.parent else {
+        return None;
+    };
+    let cell = cell_wref.upgrade();
+    let cell = cell.borrow();
+    match &cell.prototype {
+        ir::CellType::Constant { val, width } => Some((*val, *width)),
+        _ => None,
+    }
+}
+
+/// Whether `a`'s destination is `inst.<port>`.
+fn writes_port<T>(a: &ir::Assignment<T>, inst: ir::Id, port: ir::Id) -> bool {
+    let d = a.dst.borrow();
+    d.get_parent_name() == inst && d.name == port
+}
+
+/// Whether `a` reads `inst.<port>` on its source or in its guard.
+fn reads_port<T>(a: &ir::Assignment<T>, inst: ir::Id, port: ir::Id) -> bool {
+    {
+        let s = a.src.borrow();
+        if s.get_parent_name() == inst && s.name == port {
+            return true;
+        }
+    }
+    a.guard.all_ports().iter().any(|p| {
+        let p = p.borrow();
+        p.get_parent_name() == inst && p.name == port
+    })
+}
+
+/// Whether anything in `comp` other than an `invoke` of `inst` drives the `@go`
+/// port of `inst`, which starts the instance outside the bindings those invokes
+/// carry. Structural wiring and the destination of another `invoke`'s output
+/// binding both count.
+fn go_driven_structurally(comp: &ir::Component, inst: ir::Id) -> bool {
+    let drives_go = |d: &ir::Port| {
+        d.get_parent_name() == inst && d.attributes.has(ir::NumAttr::Go)
+    };
+    let mut bound_by_invoke = false;
+    visit_invokes(&comp.control.borrow(), &mut |_, _, outputs| {
+        if outputs.iter().any(|(_, p)| drives_go(&p.borrow())) {
+            bound_by_invoke = true;
+        }
+    });
+    if bound_by_invoke {
+        return true;
+    }
+    if comp
+        .continuous_assignments
+        .iter()
+        .any(|a| drives_go(&a.dst.borrow()))
+    {
+        return true;
+    }
+    for group in comp.get_groups().iter() {
+        if group
+            .borrow()
+            .assignments
+            .iter()
+            .any(|a| drives_go(&a.dst.borrow()))
+        {
+            return true;
+        }
+    }
+    for group in comp.comb_groups.iter() {
+        if group
+            .borrow()
+            .assignments
+            .iter()
+            .any(|a| drives_go(&a.dst.borrow()))
+        {
+            return true;
+        }
+    }
+    for group in comp.get_static_groups().iter() {
+        if group
+            .borrow()
+            .assignments
+            .iter()
+            .any(|a| drives_go(&a.dst.borrow()))
+        {
+            return true;
+        }
+    }
+    for fsm in comp.fsms.iter() {
+        for state in &fsm.borrow().assignments {
+            if state.iter().any(|a| drives_go(&a.dst.borrow())) {
+                return true;
+            }
+        }
+    }
+    false
+}
+
+/// The single constant that every unconditional driver of `inst.<port>` writes,
+/// or `None` when it is read from, left undriven, driven conditionally (in a
+/// group), or driven with a guard / non-constant / two disagreeing constants.
+fn value_driven_to(
+    comp: &ir::Component,
+    inst: ir::Id,
+    port: ir::Id,
+) -> Option<(u64, u64)> {
+    // Only an unconditional driver (a continuous assignment or an `invoke`
+    // binding) proves the port always carries a constant. A group / comb-group /
+    // static-group write is active only while its group runs, so it is
+    // conditional and disqualifies the port. Any read disqualifies it too.
+    let mut writes: Vec<Option<(u64, u64)>> = Vec::new();
+    let mut read = false;
+    let mut conditional_write = false;
+    let mut continuous_write = false;
+
+    for a in &comp.continuous_assignments {
+        if writes_port(a, inst, port) {
+            continuous_write = true;
+            writes.push(if a.guard.is_true() {
+                const_of(&a.src.borrow())
+            } else {
+                None
+            });
+        }
+        if reads_port(a, inst, port) {
+            read = true;
+        }
+    }
+    for group in comp.get_groups().iter() {
+        for a in &group.borrow().assignments {
+            if writes_port(a, inst, port) {
+                conditional_write = true;
+            }
+            if reads_port(a, inst, port) {
+                read = true;
+            }
+        }
+    }
+    for group in comp.comb_groups.iter() {
+        for a in &group.borrow().assignments {
+            if writes_port(a, inst, port) {
+                conditional_write = true;
+            }
+            if reads_port(a, inst, port) {
+                read = true;
+            }
+        }
+    }
+    for group in comp.get_static_groups().iter() {
+        for a in &group.borrow().assignments {
+            if writes_port(a, inst, port) {
+                conditional_write = true;
+            }
+            if reads_port(a, inst, port) {
+                read = true;
+            }
+        }
+    }
+    for fsm in comp.fsms.iter() {
+        let fsm = fsm.borrow();
+        for state in &fsm.assignments {
+            for a in state {
+                if writes_port(a, inst, port) {
+                    conditional_write = true;
+                }
+                if reads_port(a, inst, port) {
+                    read = true;
+                }
+            }
+        }
+        for transition in &fsm.transitions {
+            if let ir::Transition::Conditional(arms) = transition {
+                for (guard, _) in arms {
+                    if guard.all_ports().iter().any(|p| {
+                        let p = p.borrow();
+                        p.get_parent_name() == inst && p.name == port
+                    }) {
+                        read = true;
+                    }
+                }
+            }
+        }
+    }
+
+    // An `invoke` of the instance that omits the port leaves it undriven for
+    // that activation, unless a continuous assignment drives it at all times.
+    let mut invocations = 0usize;
+    let mut bound = 0usize;
+    visit_invokes(&comp.control.borrow(), &mut |target, inputs, outputs| {
+        if target != inst {
+            return;
+        }
+        invocations += 1;
+        for (name, src) in inputs {
+            if *name == port {
+                bound += 1;
+                writes.push(const_of(&src.borrow()));
+            }
+        }
+        for (name, _) in outputs {
+            if *name == port {
+                read = true;
+            }
+        }
+    });
+
+    if read || conditional_write || writes.is_empty() {
+        return None;
+    }
+    if !continuous_write && bound < invocations {
+        return None;
+    }
+    if !continuous_write && go_driven_structurally(comp, inst) {
+        return None;
+    }
+    let mut value = None;
+    for w in writes {
+        match (w, value) {
+            (Some(k), None) => value = Some(k),
+            (Some(k), Some(v)) if k == v => {}
+            _ => return None,
+        }
+    }
+    value
+}
+
+/// Apply `f(invoked_cell, inputs, outputs)` to every dynamic and static
+/// `invoke` in a control program.
+fn visit_invokes(
+    con: &ir::Control,
+    f: &mut impl FnMut(
+        ir::Id,
+        &[(ir::Id, RRC<ir::Port>)],
+        &[(ir::Id, RRC<ir::Port>)],
+    ),
+) {
+    match con {
+        ir::Control::Invoke(i) => {
+            f(i.comp.borrow().name(), &i.inputs, &i.outputs)
+        }
+        ir::Control::Seq(seq) => {
+            seq.stmts.iter().for_each(|s| visit_invokes(s, f))
+        }
+        ir::Control::Par(par) => {
+            par.stmts.iter().for_each(|s| visit_invokes(s, f))
+        }
+        ir::Control::If(if_) => {
+            visit_invokes(&if_.tbranch, f);
+            visit_invokes(&if_.fbranch, f);
+        }
+        ir::Control::While(wh) => visit_invokes(&wh.body, f),
+        ir::Control::Repeat(rep) => visit_invokes(&rep.body, f),
+        ir::Control::Static(sc) => visit_static_invokes(sc, f),
+        ir::Control::Empty(_)
+        | ir::Control::Enable(_)
+        | ir::Control::FSMEnable(_) => {}
+    }
+}
+
+/// Apply `f(invoked_cell, inputs, outputs)` to every `static invoke` in a
+/// static control program.
+fn visit_static_invokes(
+    con: &ir::StaticControl,
+    f: &mut impl FnMut(
+        ir::Id,
+        &[(ir::Id, RRC<ir::Port>)],
+        &[(ir::Id, RRC<ir::Port>)],
+    ),
+) {
+    match con {
+        ir::StaticControl::Invoke(i) => {
+            f(i.comp.borrow().name(), &i.inputs, &i.outputs)
+        }
+        ir::StaticControl::Seq(seq) => {
+            seq.stmts.iter().for_each(|s| visit_static_invokes(s, f))
+        }
+        ir::StaticControl::Par(par) => {
+            par.stmts.iter().for_each(|s| visit_static_invokes(s, f))
+        }
+        ir::StaticControl::If(if_) => {
+            visit_static_invokes(&if_.tbranch, f);
+            visit_static_invokes(&if_.fbranch, f);
+        }
+        ir::StaticControl::Repeat(rep) => visit_static_invokes(&rep.body, f),
+        ir::StaticControl::Empty(_) | ir::StaticControl::Enable(_) => {}
+    }
+}
+
+/// Input ports that every instantiation drives with the same constant, mapped to
+/// that constant. The entrypoint and `@fixed_signature` components are excluded
+/// because their signatures are fixed.
+pub fn constant_input_ports(
+    ctx: &ir::Context,
+) -> HashMap<(ir::Id, ir::Id), (u64, u64)> {
+    let mut instances: HashMap<ir::Id, Vec<(ir::Id, ir::Id)>> = HashMap::new();
+    for d in &ctx.components {
+        for cell in d.cells.iter() {
+            if let Some(target) = instance_of(&cell.borrow()) {
+                instances
+                    .entry(target)
+                    .or_default()
+                    .push((d.name, cell.borrow().name()));
+            }
+        }
+    }
+
+    let by_name: HashMap<ir::Id, &ir::Component> =
+        ctx.components.iter().map(|c| (c.name, c)).collect();
+
+    let mut result = HashMap::new();
+    for comp in &ctx.components {
+        if comp.name == ctx.entrypoint
+            || comp.attributes.has(ir::BoolAttr::FixedSignature)
+        {
+            continue;
+        }
+        let sites = match instances.get(&comp.name) {
+            Some(s) if !s.is_empty() => s,
+            _ => continue,
+        };
+        for port in comp.signature.borrow().ports.iter() {
+            let name = port.borrow().name;
+            if is_interface_port(&port.borrow()) {
+                continue;
+            }
+            let mut common: Option<(u64, u64)> = None;
+            let mut uniform = true;
+            for (d_name, inst) in sites {
+                let d = by_name[d_name];
+                match value_driven_to(d, *inst, name) {
+                    Some(k) if common.is_none_or(|c| c == k) => {
+                        common = Some(k)
+                    }
+                    _ => {
+                        uniform = false;
+                        break;
+                    }
+                }
+            }
+            if let (true, Some(k)) = (uniform, common) {
+                result.insert((comp.name, name), k);
+            }
+        }
+    }
+    result
+}
+
+/// Whether `port` is the signature port named `name` of `comp` (as opposed to a
+/// same-named port on some cell inside `comp`).
+fn is_signature_port(
+    comp: &ir::Component,
+    name: ir::Id,
+    port: &ir::Port,
+) -> bool {
+    port.name == name
+        && port.get_parent_name() == comp.signature.borrow().name()
+}
+
+/// Output ports that the component always drives with one constant, mapped to
+/// that constant. Such an output can be dropped once every reader is given the
+/// constant directly, wherever it is read.
+pub fn constant_output_ports(
+    ctx: &ir::Context,
+) -> HashMap<(ir::Id, ir::Id), (u64, u64)> {
+    let mut instances: HashMap<ir::Id, Vec<(ir::Id, ir::Id)>> = HashMap::new();
+    for d in &ctx.components {
+        for cell in d.cells.iter() {
+            if let Some(target) = instance_of(&cell.borrow()) {
+                instances
+                    .entry(target)
+                    .or_default()
+                    .push((d.name, cell.borrow().name()));
+            }
+        }
+    }
+    let by_name: HashMap<ir::Id, &ir::Component> =
+        ctx.components.iter().map(|c| (c.name, c)).collect();
+
+    let mut result = HashMap::new();
+    for comp in &ctx.components {
+        if comp.name == ctx.entrypoint
+            || comp.attributes.has(ir::BoolAttr::FixedSignature)
+        {
+            continue;
+        }
+        if !instances.get(&comp.name).is_some_and(|s| !s.is_empty()) {
+            continue;
+        }
+        for port in comp.signature.borrow().ports.iter() {
+            let name = port.borrow().name;
+            if is_interface_port(&port.borrow()) {
+                continue;
+            }
+            let mut value: Option<(u64, u64)> = None;
+            let mut cont_writes = 0usize;
+            let mut other_writer = false;
+            for a in &comp.continuous_assignments {
+                if is_signature_port(comp, name, &a.dst.borrow()) {
+                    cont_writes += 1;
+                    if a.guard.is_true() {
+                        value = const_of(&a.src.borrow());
+                    } else {
+                        value = None;
+                    }
+                }
+            }
+            // A group, comb-group, or static-group write drives the port only
+            // while that group is active, so it is not unconditionally constant.
+            let mut group_writer = |group: &RRC<ir::Group>| {
+                for a in &group.borrow().assignments {
+                    if is_signature_port(comp, name, &a.dst.borrow()) {
+                        other_writer = true;
+                    }
+                }
+            };
+            comp.get_groups().iter().for_each(&mut group_writer);
+            for group in comp.comb_groups.iter() {
+                for a in &group.borrow().assignments {
+                    if is_signature_port(comp, name, &a.dst.borrow()) {
+                        other_writer = true;
+                    }
+                }
+            }
+            for group in comp.get_static_groups().iter() {
+                for a in &group.borrow().assignments {
+                    if is_signature_port(comp, name, &a.dst.borrow()) {
+                        other_writer = true;
+                    }
+                }
+            }
+            for fsm in comp.fsms.iter() {
+                for state in &fsm.borrow().assignments {
+                    for a in state {
+                        if is_signature_port(comp, name, &a.dst.borrow()) {
+                            other_writer = true;
+                        }
+                    }
+                }
+            }
+
+            let k = match value {
+                Some(k) if cont_writes == 1 && !other_writer => k,
+                _ => continue,
+            };
+            // An `invoke` output binding writes the port's value into a
+            // destination in the caller. Removing the port would drop that
+            // write instead of replacing it, so the port stays.
+            let bound_at_invoke =
+                instances[&comp.name].iter().any(|(d, inst)| {
+                    let mut found = false;
+                    visit_invokes(
+                        &by_name[d].control.borrow(),
+                        &mut |target, _, outputs| {
+                            if target == *inst
+                                && outputs.iter().any(|(n, _)| *n == name)
+                            {
+                                found = true;
+                            }
+                        },
+                    );
+                    found
+                });
+            if bound_at_invoke {
+                continue;
+            }
+            result.insert((comp.name, name), k);
+        }
+    }
+    result
+}
+
+/// Where a port lives, from the point of view of the component being analyzed.
+enum PortOwner {
+    /// A port of the component's own signature.
+    Signature(ir::Id),
+    /// A port of an instance of another component.
+    Instance(ir::Id, ir::Id),
+    /// A port of a primitive, a constant, or a group hole.
+    Opaque,
+}
+
+impl PortLiveness {
+    /// Compute liveness for every component in `ctx`.
+    pub fn new(ctx: &ir::Context) -> Self {
+        let mut analysis = PortLiveness {
+            live_ports: HashSet::new(),
+            live_refs: HashSet::new(),
+            live_comb: HashSet::new(),
+        };
+        analysis.seed(ctx);
+        while analysis.round(ctx) {}
+        analysis
+    }
+
+    /// Whether `port` on `comp`'s signature must be retained.
+    pub fn is_live_port(&self, comp: ir::Id, port: ir::Id) -> bool {
+        self.live_ports.contains(&(comp, port))
+    }
+
+    /// Whether the `ref` cell `cell` in `comp` must be retained.
+    pub fn is_live_ref(&self, comp: ir::Id, cell: ir::Id) -> bool {
+        self.live_refs.contains(&(comp, cell))
+    }
+
+    /// Mark the ports that are live regardless of how the program uses them:
+    /// the entire signature of the entrypoint, which the outside world drives,
+    /// and the go-done protocol ports of every component.
+    fn seed(&mut self, ctx: &ir::Context) {
+        for comp in &ctx.components {
+            let fixed = comp.name == ctx.entrypoint
+                || comp.attributes.has(ir::BoolAttr::FixedSignature);
+            for port in comp.signature.borrow().ports.iter() {
+                let port = port.borrow();
+                if fixed || is_interface_port(&port) {
+                    self.live_ports.insert((comp.name, port.name));
+                }
+            }
+            if fixed {
+                for cell in comp.cells.iter() {
+                    let cell = cell.borrow();
+                    if cell.is_reference() {
+                        self.live_refs.insert((comp.name, cell.name()));
+                    }
+                }
+            }
+        }
+    }
+
+    /// Classify the owner of `port` relative to the component being analyzed.
+    fn owner(&self, port: &ir::Port) -> PortOwner {
+        let ir::PortParent::Cell(cell_wref) = &port.parent else {
+            return PortOwner::Opaque;
+        };
+        let cell_ref = cell_wref.upgrade();
+        let cell = cell_ref.borrow();
+        match &cell.prototype {
+            ir::CellType::ThisComponent => PortOwner::Signature(port.name),
+            ir::CellType::Component { name } => {
+                PortOwner::Instance(*name, port.name)
+            }
+            _ => PortOwner::Opaque,
+        }
+    }
+
+    /// Whether the value written into `port` can still reach an observable sink.
+    /// A read on the source side of an assignment only keeps the source alive
+    /// when the destination it feeds is itself live: the assignment is otherwise
+    /// removed along with the destination and carries the source with it.
+    ///
+    /// A destination is a sink when it drives a group hole, a `ref` cell, an
+    /// `@external` cell, or a stateful cell, because those observe the value
+    /// regardless of what reads it back. A destination on a combinational cell
+    /// is live only when that cell's own output is live, which is what turns the
+    /// analysis into a transitive dataflow closure rather than a syntactic
+    /// use-count.
+    fn write_survives(&self, comp: &ir::Component, port: &ir::Port) -> bool {
+        match self.owner(port) {
+            PortOwner::Signature(name) => self.is_live_port(comp.name, name),
+            PortOwner::Instance(target, name) => {
+                self.is_live_port(target, name)
+            }
+            PortOwner::Opaque => {
+                if port.is_hole() {
+                    return true;
+                }
+                let ir::PortParent::Cell(cell_wref) = &port.parent else {
+                    return true;
+                };
+                let cell = cell_wref.upgrade();
+                let cell = cell.borrow();
+                if cell.is_reference()
+                    || cell.attributes.has(ir::BoolAttr::External)
+                {
+                    return true;
+                }
+                if cell.is_comb_cell() {
+                    return self.live_comb.contains(&(comp.name, cell.name()));
+                }
+                true
+            }
+        }
+    }
+
+    /// Record that the combinational cell owning `port` computes a value that is
+    /// used, which keeps its inputs reachable in the next round.
+    fn mark_comb_use(&mut self, comp: &ir::Component, port: &ir::Port) -> bool {
+        let ir::PortParent::Cell(cell_wref) = &port.parent else {
+            return false;
+        };
+        let cell = cell_wref.upgrade();
+        let cell = cell.borrow();
+        if cell.is_comb_cell() {
+            self.live_comb.insert((comp.name, cell.name()))
+        } else {
+            false
+        }
+    }
+
+    /// Record that `port` is read from inside `comp`.
+    fn record_read(&mut self, comp: &ir::Component, port: &ir::Port) -> bool {
+        let entry = match self.owner(port) {
+            PortOwner::Signature(name) => (comp.name, name),
+            PortOwner::Instance(target, name) => (target, name),
+            PortOwner::Opaque => return false,
+        };
+        self.live_ports.insert(entry)
+    }
+
+    /// Record that the `ref` cell `cell` is used inside `comp`.
+    fn record_ref_use(
+        &mut self,
+        comp: &ir::Component,
+        cell: &ir::Cell,
+    ) -> bool {
+        if !cell.is_reference() {
+            return false;
+        }
+        self.live_refs.insert((comp.name, cell.name()))
+    }
+
+    /// Record every port a surviving assignment reads: its source and every
+    /// port its guard inspects.
+    fn read_assignment<T>(
+        &mut self,
+        comp: &ir::Component,
+        assign: &ir::Assignment<T>,
+    ) -> bool {
+        if !self.write_survives(comp, &assign.dst.borrow()) {
+            return false;
+        }
+        let mut changed = self.record_read(comp, &assign.src.borrow());
+        changed |= self.mark_comb_use(comp, &assign.src.borrow());
+        changed |= self.record_ref_cell_of(comp, &assign.src);
+        changed |= self.record_ref_cell_of(comp, &assign.dst);
+        for port in assign.guard.all_ports() {
+            changed |= self.record_read(comp, &port.borrow());
+            changed |= self.mark_comb_use(comp, &port.borrow());
+            changed |= self.record_ref_cell_of(comp, &port);
+        }
+        changed
+    }
+
+    /// Record a use of the `ref` cell that owns `port`, if there is one.
+    fn record_ref_cell_of(
+        &mut self,
+        comp: &ir::Component,
+        port: &RRC<ir::Port>,
+    ) -> bool {
+        let port = port.borrow();
+        let ir::PortParent::Cell(cell_wref) = &port.parent else {
+            return false;
+        };
+        let cell = cell_wref.upgrade();
+        let cell = cell.borrow();
+        self.record_ref_use(comp, &cell)
+    }
+
+    /// Walk the control program of `comp`, recording the ports it reads.
+    fn read_control(
+        &mut self,
+        comp: &ir::Component,
+        con: &ir::Control,
+    ) -> bool {
+        let mut changed = false;
+        match con {
+            ir::Control::Empty(_) | ir::Control::FSMEnable(_) => {}
+            ir::Control::Enable(_) => {}
+            ir::Control::Seq(seq) => {
+                for stmt in &seq.stmts {
+                    changed |= self.read_control(comp, stmt);
+                }
+            }
+            ir::Control::Par(par) => {
+                for stmt in &par.stmts {
+                    changed |= self.read_control(comp, stmt);
+                }
+            }
+            ir::Control::If(if_) => {
+                changed |= self.record_read(comp, &if_.port.borrow());
+                changed |= self.mark_comb_use(comp, &if_.port.borrow());
+                changed |= self.record_ref_cell_of(comp, &if_.port);
+                changed |= self.read_control(comp, &if_.tbranch);
+                changed |= self.read_control(comp, &if_.fbranch);
+            }
+            ir::Control::While(wh) => {
+                changed |= self.record_read(comp, &wh.port.borrow());
+                changed |= self.mark_comb_use(comp, &wh.port.borrow());
+                changed |= self.record_ref_cell_of(comp, &wh.port);
+                changed |= self.read_control(comp, &wh.body);
+            }
+            ir::Control::Repeat(rep) => {
+                changed |= self.read_control(comp, &rep.body);
+            }
+            ir::Control::Invoke(invoke) => {
+                changed |= self.read_invoke(
+                    comp,
+                    &invoke.comp,
+                    &invoke.inputs,
+                    &invoke.outputs,
+                    &invoke.ref_cells,
+                );
+            }
+            ir::Control::Static(sc) => {
+                changed |= self.read_static_control(comp, sc);
+            }
+        }
+        changed
+    }
+
+    /// Walk a static control program, recording the ports it reads.
+    fn read_static_control(
+        &mut self,
+        comp: &ir::Component,
+        con: &ir::StaticControl,
+    ) -> bool {
+        let mut changed = false;
+        match con {
+            ir::StaticControl::Empty(_) | ir::StaticControl::Enable(_) => {}
+            ir::StaticControl::Seq(seq) => {
+                for stmt in &seq.stmts {
+                    changed |= self.read_static_control(comp, stmt);
+                }
+            }
+            ir::StaticControl::Par(par) => {
+                for stmt in &par.stmts {
+                    changed |= self.read_static_control(comp, stmt);
+                }
+            }
+            ir::StaticControl::If(if_) => {
+                changed |= self.record_read(comp, &if_.port.borrow());
+                changed |= self.mark_comb_use(comp, &if_.port.borrow());
+                changed |= self.record_ref_cell_of(comp, &if_.port);
+                changed |= self.read_static_control(comp, &if_.tbranch);
+                changed |= self.read_static_control(comp, &if_.fbranch);
+            }
+            ir::StaticControl::Repeat(rep) => {
+                changed |= self.read_static_control(comp, &rep.body);
+            }
+            ir::StaticControl::Invoke(invoke) => {
+                changed |= self.read_invoke(
+                    comp,
+                    &invoke.comp,
+                    &invoke.inputs,
+                    &invoke.outputs,
+                    &invoke.ref_cells,
+                );
+            }
+        }
+        changed
+    }
+
+    /// An invocation reads the ports bound to the invoked cell's inputs and
+    /// reads the invoked cell's outputs that it binds. A binding whose port on
+    /// the invoked cell is removed disappears with it.
+    fn read_invoke(
+        &mut self,
+        comp: &ir::Component,
+        target: &RRC<ir::Cell>,
+        inputs: &[(ir::Id, RRC<ir::Port>)],
+        outputs: &[(ir::Id, RRC<ir::Port>)],
+        ref_cells: &[(ir::Id, RRC<ir::Cell>)],
+    ) -> bool {
+        let mut changed = false;
+        let invoked = instance_of(&target.borrow());
+        changed |= self.record_ref_use(comp, &target.borrow());
+        for (name, port) in inputs {
+            if let Some(invoked) = invoked {
+                if !self.is_live_port(invoked, *name) {
+                    continue;
+                }
+            }
+            changed |= self.record_read(comp, &port.borrow());
+            changed |= self.mark_comb_use(comp, &port.borrow());
+            changed |= self.record_ref_cell_of(comp, port);
+        }
+        for (name, port) in outputs {
+            if !self.write_survives(comp, &port.borrow()) {
+                continue;
+            }
+            if let Some(invoked) = invoked {
+                changed |= self.live_ports.insert((invoked, *name));
+            }
+            changed |= self.record_ref_cell_of(comp, port);
+        }
+        for (name, cell) in ref_cells {
+            if let Some(invoked) = invoked {
+                if !self.is_live_ref(invoked, *name) {
+                    continue;
+                }
+            }
+            changed |= self.record_ref_use(comp, &cell.borrow());
+        }
+        changed
+    }
+
+    /// A `ref` cell of `comp` is used when the body of `comp` mentions it. The
+    /// enclosing program cannot observe it otherwise, so an unmentioned `ref`
+    /// cell is dropped from the signature.
+    fn round(&mut self, ctx: &ir::Context) -> bool {
+        let mut changed = false;
+        for comp in &ctx.components {
+            comp.iter_assignments(|assign| {
+                changed |= self.read_assignment(comp, assign);
+            });
+            comp.iter_static_assignments(|assign| {
+                changed |= self.read_assignment(comp, assign);
+            });
+            for fsm in comp.fsms.iter() {
+                let fsm = fsm.borrow();
+                for state in &fsm.assignments {
+                    for assign in state {
+                        changed |= self.read_assignment(comp, assign);
+                    }
+                }
+                for transition in &fsm.transitions {
+                    if let ir::Transition::Conditional(arms) = transition {
+                        for (guard, _) in arms {
+                            for port in guard.all_ports() {
+                                changed |=
+                                    self.record_read(comp, &port.borrow());
+                                changed |=
+                                    self.mark_comb_use(comp, &port.borrow());
+                                changed |= self.record_ref_cell_of(comp, &port);
+                            }
+                        }
+                    }
+                }
+            }
+            changed |= self.read_control(comp, &comp.control.borrow());
+            for cell in comp.cells.iter() {
+                let cell = cell.borrow();
+                if let Some(target) = instance_of(&cell) {
+                    for port in cell.ports.iter() {
+                        let port = port.borrow();
+                        if is_interface_port(&port) {
+                            changed |=
+                                self.live_ports.insert((target, port.name));
+                        }
+                    }
+                }
+            }
+        }
+        changed
+    }
+
+    /// The signature ports of `comp` that the rewrite removes.
+    pub fn dead_ports(&self, comp: &ir::Component) -> HashSet<ir::Id> {
+        comp.signature
+            .borrow()
+            .ports
+            .iter()
+            .filter_map(|port| {
+                let port = port.borrow();
+                if self.is_live_port(comp.name, port.name) {
+                    None
+                } else {
+                    Some(port.name)
+                }
+            })
+            .collect()
+    }
+
+    /// The `ref` cells of `comp` that the rewrite removes.
+    pub fn dead_refs(&self, comp: &ir::Component) -> HashSet<ir::Id> {
+        comp.cells
+            .iter()
+            .filter_map(|cell| {
+                let cell = cell.borrow();
+                if cell.is_reference()
+                    && !self.is_live_ref(comp.name, cell.name())
+                {
+                    Some(cell.name())
+                } else {
+                    None
+                }
+            })
+            .collect()
+    }
+
+    /// A map from each component to the ports the rewrite removes from it.
+    pub fn removal_plan(
+        &self,
+        ctx: &ir::Context,
+    ) -> HashMap<ir::Id, HashSet<ir::Id>> {
+        ctx.components
+            .iter()
+            .map(|comp| (comp.name, self.dead_ports(comp)))
+            .collect()
+    }
+}
