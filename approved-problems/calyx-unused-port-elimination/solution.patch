diff --git a/calyx/opt/src/passes/dead_port_elimination.rs b/calyx/opt/src/passes/dead_port_elimination.rs
new file mode 100644
index 00000000..2edd3f48
--- /dev/null
+++ b/calyx/opt/src/passes/dead_port_elimination.rs
@@ -0,0 +1,498 @@
+use crate::analysis::{
+    PortLiveness, constant_input_ports, constant_output_ports,
+};
+use crate::traversal::{
+    Action, ConstructVisitor, Named, ParseVal, PassOpt, VisResult, Visitor,
+};
+use calyx_ir::{self as ir, RRC, rewriter};
+use calyx_utils::{CalyxResult, OutputFile};
+use itertools::Itertools;
+use serde::Serialize;
+use std::collections::{HashMap, HashSet};
+use std::io::Write;
+use std::rc::Rc;
+
+/// Removes ports that no instantiation of a component can observe.
+///
+/// The pass is whole-program: an output port survives only when some instance
+/// of the component has it read, and an input port survives only when the body
+/// of the component reads it. Every assignment and every `invoke` binding that
+/// mentions a removed port is removed with it, which lets the dead cell and
+/// dead assignment passes make more progress.
+///
+/// The signature of the entrypoint is left alone because the program cannot see
+/// how the outside world drives it, and the go-done protocol ports are left
+/// alone because the rest of the compiler assumes they exist. A component
+/// marked `@fixed_signature` is left alone for the same reason.
+///
+/// Passing `-x dead-port-elimination:dump=file-name` writes a json summary of
+/// everything the pass removed.
+pub struct DeadPortElimination {
+    /// Ports removed from each component's signature.
+    dead_ports: HashMap<ir::Id, HashSet<ir::Id>>,
+    /// `ref` cells removed from each component's signature.
+    dead_refs: HashMap<ir::Id, HashSet<ir::Id>>,
+    /// Ports removed across all rounds, for the summary report.
+    report_ports: HashMap<ir::Id, HashSet<ir::Id>>,
+    /// `ref` cells removed across all rounds, for the summary report.
+    report_refs: HashMap<ir::Id, HashSet<ir::Id>>,
+    /// Stream that receives the summary of what was removed.
+    dump: Option<OutputFile>,
+}
+
+/// Summary of the removals performed on a single component.
+#[derive(Serialize)]
+struct Removals {
+    component: String,
+    ports: Vec<String>,
+    ref_cells: Vec<String>,
+}
+
+impl Named for DeadPortElimination {
+    fn name() -> &'static str {
+        "dead-port-elimination"
+    }
+
+    fn description() -> &'static str {
+        "removes component ports that no instantiation observes"
+    }
+
+    fn opts() -> Vec<PassOpt> {
+        vec![PassOpt::new(
+            "dump",
+            "write a json summary of the removed ports and ref cells",
+            ParseVal::OutStream(OutputFile::Null),
+            PassOpt::parse_outstream,
+        )]
+    }
+}
+
+impl ConstructVisitor for DeadPortElimination {
+    fn from(ctx: &ir::Context) -> CalyxResult<Self>
+    where
+        Self: Sized,
+    {
+        let opts = Self::get_opts(ctx);
+        Ok(DeadPortElimination {
+            dead_ports: HashMap::default(),
+            dead_refs: HashMap::default(),
+            report_ports: HashMap::default(),
+            report_refs: HashMap::default(),
+            dump: opts[&"dump"].not_null_outstream(),
+        })
+    }
+
+    fn clear_data(&mut self) {
+        self.dead_ports = HashMap::default();
+        self.dead_refs = HashMap::default();
+        self.report_ports = HashMap::default();
+        self.report_refs = HashMap::default();
+    }
+}
+
+impl DeadPortElimination {
+    /// Whether `port` has been removed, resolving the port through the
+    /// component that owns it.
+    fn is_removed(&self, comp: ir::Id, port: &ir::Port) -> bool {
+        let ir::PortParent::Cell(cell_wref) = &port.parent else {
+            return false;
+        };
+        let cell_ref = cell_wref.upgrade();
+        let cell = cell_ref.borrow();
+        let owner = match &cell.prototype {
+            ir::CellType::ThisComponent => comp,
+            ir::CellType::Component { name } => *name,
+            _ => return false,
+        };
+        self.dead_ports
+            .get(&owner)
+            .is_some_and(|ports| ports.contains(&port.name))
+    }
+
+    /// An assignment survives when none of the ports it mentions was removed.
+    fn survives<T>(&self, comp: ir::Id, assign: &ir::Assignment<T>) -> bool {
+        let mentioned = [&assign.dst, &assign.src]
+            .into_iter()
+            .cloned()
+            .chain(assign.guard.all_ports());
+        !mentioned
+            .into_iter()
+            .any(|port| self.is_removed(comp, &port.borrow()))
+    }
+
+    /// Drop the removed ports from a cell that instantiates a component.
+    fn prune_cell(&self, cell: &RRC<ir::Cell>) {
+        let mut cell = cell.borrow_mut();
+        let ir::CellType::Component { name } = cell.prototype else {
+            return;
+        };
+        let Some(dead) = self.dead_ports.get(&name) else {
+            return;
+        };
+        cell.remove_ports(dead);
+    }
+
+    /// Drop the bindings of an `invoke` that mention a removed port or a
+    /// removed `ref` cell, on either side of the binding.
+    fn prune_invoke(
+        &self,
+        comp: ir::Id,
+        target: &RRC<ir::Cell>,
+        inputs: &mut Vec<(ir::Id, RRC<ir::Port>)>,
+        outputs: &mut Vec<(ir::Id, RRC<ir::Port>)>,
+        ref_cells: &mut Vec<(ir::Id, RRC<ir::Cell>)>,
+    ) {
+        outputs.retain(|(_, port)| !self.is_removed(comp, &port.borrow()));
+        let ir::CellType::Component { name: invoked } =
+            target.borrow().prototype
+        else {
+            return;
+        };
+        if let Some(dead) = self.dead_ports.get(&invoked) {
+            inputs.retain(|(name, _)| !dead.contains(name));
+            outputs.retain(|(name, _)| !dead.contains(name));
+        }
+        if let Some(dead) = self.dead_refs.get(&invoked) {
+            ref_cells.retain(|(name, _)| !dead.contains(name));
+        }
+    }
+
+    /// Walk the control program, pruning every `invoke` it contains.
+    fn prune_control(&self, comp: ir::Id, con: &mut ir::Control) {
+        match con {
+            ir::Control::Empty(_)
+            | ir::Control::Enable(_)
+            | ir::Control::FSMEnable(_) => {}
+            ir::Control::Seq(seq) => {
+                for stmt in &mut seq.stmts {
+                    self.prune_control(comp, stmt);
+                }
+            }
+            ir::Control::Par(par) => {
+                for stmt in &mut par.stmts {
+                    self.prune_control(comp, stmt);
+                }
+            }
+            ir::Control::If(if_) => {
+                self.prune_control(comp, &mut if_.tbranch);
+                self.prune_control(comp, &mut if_.fbranch);
+            }
+            ir::Control::While(wh) => {
+                self.prune_control(comp, &mut wh.body);
+            }
+            ir::Control::Repeat(rep) => {
+                self.prune_control(comp, &mut rep.body);
+            }
+            ir::Control::Invoke(invoke) => {
+                self.prune_invoke(
+                    comp,
+                    &invoke.comp,
+                    &mut invoke.inputs,
+                    &mut invoke.outputs,
+                    &mut invoke.ref_cells,
+                );
+            }
+            ir::Control::Static(sc) => self.prune_static_control(comp, sc),
+        }
+    }
+
+    /// Walk a static control program, pruning every `invoke` it contains.
+    fn prune_static_control(&self, comp: ir::Id, con: &mut ir::StaticControl) {
+        match con {
+            ir::StaticControl::Empty(_) | ir::StaticControl::Enable(_) => {}
+            ir::StaticControl::Seq(seq) => {
+                for stmt in &mut seq.stmts {
+                    self.prune_static_control(comp, stmt);
+                }
+            }
+            ir::StaticControl::Par(par) => {
+                for stmt in &mut par.stmts {
+                    self.prune_static_control(comp, stmt);
+                }
+            }
+            ir::StaticControl::If(if_) => {
+                self.prune_static_control(comp, &mut if_.tbranch);
+                self.prune_static_control(comp, &mut if_.fbranch);
+            }
+            ir::StaticControl::Repeat(rep) => {
+                self.prune_static_control(comp, &mut rep.body);
+            }
+            ir::StaticControl::Invoke(invoke) => {
+                self.prune_invoke(
+                    comp,
+                    &invoke.comp,
+                    &mut invoke.inputs,
+                    &mut invoke.outputs,
+                    &mut invoke.ref_cells,
+                );
+            }
+        }
+    }
+
+    /// Write the summary of removals, ordered by component and by name so that
+    /// the same program always produces the same report.
+    fn emit_report(&mut self) -> CalyxResult<()> {
+        let Some(dump) = &mut self.dump else {
+            return Ok(());
+        };
+        let summary = self
+            .dead_ports
+            .keys()
+            .chain(self.dead_refs.keys())
+            .copied()
+            .collect::<HashSet<_>>()
+            .into_iter()
+            .map(|comp| {
+                let names = |set: Option<&HashSet<ir::Id>>| {
+                    set.into_iter()
+                        .flatten()
+                        .map(|id| id.to_string())
+                        .sorted()
+                        .collect_vec()
+                };
+                Removals {
+                    component: comp.to_string(),
+                    ports: names(self.dead_ports.get(&comp)),
+                    ref_cells: names(self.dead_refs.get(&comp)),
+                }
+            })
+            .filter(|r| !r.ports.is_empty() || !r.ref_cells.is_empty())
+            .sorted_by(|a, b| Ord::cmp(&a.component, &b.component))
+            .collect_vec();
+        write!(
+            dump.get_write(),
+            "{}",
+            serde_json::to_string_pretty(&summary)?
+        )?;
+        Ok(())
+    }
+
+    /// Apply the removals to a single component.
+    fn rewrite(&self, comp: &mut ir::Component) {
+        let name = comp.name;
+        if let Some(dead) = self.dead_ports.get(&name) {
+            comp.signature.borrow_mut().remove_ports(dead);
+        }
+        for cell in comp.cells.iter() {
+            self.prune_cell(cell);
+        }
+
+        for group in comp.get_groups().iter() {
+            group
+                .borrow_mut()
+                .assignments
+                .retain(|assign| self.survives(name, assign));
+        }
+        for group in comp.get_static_groups().iter() {
+            group
+                .borrow_mut()
+                .assignments
+                .retain(|assign| self.survives(name, assign));
+        }
+        for group in comp.comb_groups.iter() {
+            group
+                .borrow_mut()
+                .assignments
+                .retain(|assign| self.survives(name, assign));
+        }
+        for fsm in comp.fsms.iter() {
+            for state in &mut fsm.borrow_mut().assignments {
+                state.retain(|assign| self.survives(name, assign));
+            }
+        }
+        comp.continuous_assignments
+            .retain(|assign| self.survives(name, assign));
+
+        let control = std::rc::Rc::clone(&comp.control);
+        self.prune_control(name, &mut control.borrow_mut());
+
+        if let Some(dead) = self.dead_refs.get(&name) {
+            let cells = comp.cells.drain().collect::<Vec<_>>();
+            comp.cells.append(
+                cells
+                    .into_iter()
+                    .filter(|cell| !dead.contains(&cell.borrow().name())),
+            );
+        }
+    }
+}
+
+/// Apply `rewriter` to the assignments and transition guards of every `fsm`,
+/// which the shared component rewriter does not visit.
+fn rewrite_fsms(rewriter: &rewriter::Rewriter, comp: &mut ir::Component) {
+    for fsm in comp.fsms.iter() {
+        let mut fsm = fsm.borrow_mut();
+        for state in &mut fsm.assignments {
+            for assign in state.iter_mut() {
+                rewriter.rewrite_assign(assign);
+            }
+        }
+        for transition in &mut fsm.transitions {
+            if let ir::Transition::Conditional(arms) = transition {
+                for (guard, _) in arms.iter_mut() {
+                    rewriter.rewrite_guard(guard);
+                }
+            }
+        }
+    }
+}
+
+impl DeadPortElimination {
+    /// Replace every read of a constant-valued input port with that constant so
+    /// that the port itself can then be removed. Because every instance drives
+    /// the port with the same constant, the substitution preserves behavior.
+    fn inline_constant_inputs(
+        &mut self,
+        ctx: &mut ir::Context,
+        constants: &HashMap<(ir::Id, ir::Id), (u64, u64)>,
+    ) {
+        for comp in &mut ctx.components {
+            let ports: Vec<(ir::Id, (u64, u64))> = comp
+                .signature
+                .borrow()
+                .ports
+                .iter()
+                .filter_map(|p| {
+                    let p = p.borrow();
+                    constants.get(&(comp.name, p.name)).map(|k| (p.name, *k))
+                })
+                .collect();
+            if ports.is_empty() {
+                continue;
+            }
+            let mut port_map = rewriter::PortRewriteMap::default();
+            {
+                let mut builder = ir::Builder::new(comp, &ctx.lib);
+                for (name, (val, width)) in &ports {
+                    let cst = builder.add_constant(*val, *width);
+                    let out = Rc::clone(&cst.borrow().get("out"));
+                    let sig = builder.component.signature.borrow();
+                    let canon =
+                        sig.ports.iter().find(|p| p.borrow().name == *name);
+                    if let Some(p) = canon {
+                        port_map.insert(p.borrow().canonical(), out);
+                    }
+                }
+            }
+            let rewriter = rewriter::Rewriter {
+                port_map,
+                ..Default::default()
+            };
+            rewriter.rewrite(comp);
+            rewrite_fsms(&rewriter, comp);
+            let dead = self.dead_ports.entry(comp.name).or_default();
+            for (name, _) in ports {
+                dead.insert(name);
+            }
+        }
+    }
+
+    /// Give every reader of a constant-valued output port the constant directly,
+    /// so the output becomes unread and is removed. Propagating a constant output
+    /// can make a reader's own output constant, which is why the pass iterates.
+    fn propagate_constant_outputs(
+        &mut self,
+        ctx: &mut ir::Context,
+        constants: &HashMap<(ir::Id, ir::Id), (u64, u64)>,
+    ) {
+        for comp in &mut ctx.components {
+            let reads: Vec<(ir::Canonical, (u64, u64))> = comp
+                .cells
+                .iter()
+                .filter_map(|cell| {
+                    let cell = cell.borrow();
+                    let ir::CellType::Component { name } = cell.prototype
+                    else {
+                        return None;
+                    };
+                    Some((cell.name(), name))
+                })
+                .flat_map(|(inst, target)| {
+                    constants.iter().filter_map(move |((c, o), k)| {
+                        (*c == target)
+                            .then(|| (ir::Canonical::new(inst, *o), *k))
+                    })
+                })
+                .collect();
+            if reads.is_empty() {
+                continue;
+            }
+            let mut port_map = rewriter::PortRewriteMap::default();
+            {
+                let mut builder = ir::Builder::new(comp, &ctx.lib);
+                for (canon, (val, width)) in &reads {
+                    let cst = builder.add_constant(*val, *width);
+                    let out = Rc::clone(&cst.borrow().get("out"));
+                    port_map.insert(canon.clone(), out);
+                }
+            }
+            let rewriter = rewriter::Rewriter {
+                port_map,
+                ..Default::default()
+            };
+            rewriter.rewrite(comp);
+            rewrite_fsms(&rewriter, comp);
+        }
+        for ((c, o), _) in constants {
+            self.dead_ports.entry(*c).or_default().insert(*o);
+        }
+    }
+
+    /// Accumulate this round's removals into the cumulative report.
+    fn record_round(&mut self) {
+        for (comp, ports) in &self.dead_ports {
+            self.report_ports
+                .entry(*comp)
+                .or_default()
+                .extend(ports.iter().copied());
+        }
+        for (comp, refs) in &self.dead_refs {
+            self.report_refs
+                .entry(*comp)
+                .or_default()
+                .extend(refs.iter().copied());
+        }
+    }
+}
+
+impl Visitor for DeadPortElimination {
+    fn start_context(&mut self, ctx: &mut ir::Context) -> VisResult {
+        // Liveness, constant-input inlining, and constant-output propagation feed
+        // each other: propagating a constant output leaves a further port unread,
+        // and removing ports can leave a further output constant. Iterate the
+        // whole analysis until a round removes nothing.
+        loop {
+            let liveness = PortLiveness::new(ctx);
+            self.dead_ports = liveness.removal_plan(ctx);
+            self.dead_refs = ctx
+                .components
+                .iter()
+                .map(|comp| (comp.name, liveness.dead_refs(comp)))
+                .collect();
+
+            let inputs = constant_input_ports(ctx);
+            self.inline_constant_inputs(ctx, &inputs);
+            let outputs = constant_output_ports(ctx);
+            self.propagate_constant_outputs(ctx, &outputs);
+
+            let progress = self
+                .dead_ports
+                .values()
+                .chain(self.dead_refs.values())
+                .any(|s| !s.is_empty());
+            if !progress {
+                break;
+            }
+            self.record_round();
+            for comp in &mut ctx.components {
+                self.rewrite(comp);
+            }
+        }
+
+        self.dead_ports = std::mem::take(&mut self.report_ports);
+        self.dead_refs = std::mem::take(&mut self.report_refs);
+        self.emit_report()?;
+
+        Ok(Action::Stop)
+    }
+}
