+def check_knots(C):
+    """Check knots of a piecewise-geodesic curve.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+
+    Returns
+    -------
+    C : ndarray, shape (n_knots, n, n)
+        The checked knots.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    if not hasattr(C, "ndim"):
+        C = _xpnp.asarray(C)
+    if C.ndim != 3:
+        raise ValueError(f"Knots must have 3 dimensions, got {C.ndim}.")
+    if C.shape[-2] != C.shape[-1]:
+        raise ValueError("Knots must contain square matrices")
+    if C.shape[0] < 2:
+        raise ValueError(
+            f"Curve must have at least 2 knots, got {C.shape[0]}."
+        )
+    return C
diff --git a/pyriemann/geometry/curve.py b/pyriemann/geometry/curve.py
new file mode 100644
index 0000000..97eb097
--- /dev/null
+++ b/pyriemann/geometry/curve.py
@@ -0,0 +1,897 @@
+"""Piecewise-geodesic curves of SPD/HPD matrices."""
+
+import numpy as np
+
+from ._check import check_knots
+from .base import logm
+from .distance import distance
+from .geodesic import geodesic
+from .mean import gmean
+from .tangentspace import log_map
+
+
+curve_metrics = ["euclid", "logchol", "logeuclid", "riemann"]
+curve_parameterizations = ["arclength", "uniform"]
+
+_INVPHI = (np.sqrt(5.0) - 1.0) / 2.0
+
+
+def check_curve_metric(metric):
+    """Check the metric used for curves.
+
+    Parameters
+    ----------
+    metric : string
+        Metric to check.
+
+    Returns
+    -------
+    metric : string
+        Checked metric.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    if metric not in curve_metrics:
+        raise ValueError(
+            f"Unknown metric '{metric}' for curves. Must be one of "
+            f"{' '.join(curve_metrics)}"
+        )
+    return metric
+
+
+def check_curve_parameterization(parameterization):
+    """Check the parameterization used for curves.
+
+    Parameters
+    ----------
+    parameterization : string
+        Parameterization to check.
+
+    Returns
+    -------
+    parameterization : string
+        Checked parameterization.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    if parameterization not in curve_parameterizations:
+        raise ValueError(
+            f"Unknown parameterization '{parameterization}'. Must be one of "
+            f"{' '.join(curve_parameterizations)}"
+        )
+    return parameterization
+
+
+def curve_lengths(C, *, metric="riemann"):
+    """Lengths of the segments of a piecewise-geodesic curve.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    metric : string, default="riemann"
+        Metric of the curve, can be: "euclid", "logchol", "logeuclid",
+        "riemann".
+
+    Returns
+    -------
+    lengths : ndarray, shape (n_knots-1,)
+        Geodesic length of each segment.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    lengths = distance(C[:-1], C[1:], metric=metric)
+    return np.reshape(np.asarray(lengths), (len(C) - 1,))
+
+
+def curve_parameters(C, *, metric="riemann", parameterization="arclength"):
+    """Parameters of the knots of a piecewise-geodesic curve.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    params : ndarray, shape (n_knots,)
+        Parameter of each knot, increasing from 0 to 1.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_parameterization(parameterization)
+    if parameterization == "uniform":
+        check_curve_metric(metric)
+        return np.linspace(0.0, 1.0, len(C))
+
+    lengths = curve_lengths(C, metric=metric)
+    cumulated = np.concatenate(([0.0], np.cumsum(lengths)))
+    total = cumulated[-1]
+    if total <= 0:
+        return np.zeros(len(C))
+    return cumulated / total
+
+
+def _locate(params, s):
+    """Segment index and position within the segment for curve parameters."""
+    s = np.asarray(s, dtype=float)
+    if s.ndim > 1:
+        raise ValueError(
+            f"Parameters must have at most 1 dimension, got {s.ndim}."
+        )
+    s = np.clip(np.reshape(s, (-1,)), 0.0, 1.0)
+    index = np.searchsorted(params, s, side="left") - 1
+    index = np.clip(index, 0, len(params) - 2)
+    width = params[index + 1] - params[index]
+    safe = np.where(width > 0, width, 1.0)
+    alpha = np.where(width > 0, (s - params[index]) / safe, 0.0)
+    return index, np.clip(alpha, 0.0, 1.0)
+
+
+def interpolate_curve(C, s, *, metric="riemann", parameterization="arclength"):
+    """Interpolate a piecewise-geodesic curve at given parameters.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    s : float | array-like, shape (n_points,)
+        Parameters where the curve is evaluated, clipped into [0, 1].
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    X : ndarray, shape (n_points, n, n)
+        Matrices of the curve at the given parameters.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    params = curve_parameters(
+        C, metric=metric, parameterization=parameterization,
+    )
+    index, alpha = _locate(params, s)
+    return geodesic(C[index], C[index + 1], alpha, metric=metric)
+
+
+def resample_curve(C, n_knots=None, *, step=None, metric="riemann",
+                   parameterization="arclength"):
+    """Resample a piecewise-geodesic curve.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots_orig, n, n)
+        Knots of the curve, in order.
+    n_knots : None | int, default=None
+        Number of knots of the resampled curve, at least 2.
+    step : None | float, default=None
+        Positive geodesic length between consecutive knots of the resampled
+        curve.
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    C_new : ndarray, shape (n_knots, n, n)
+        Knots of the resampled curve.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    if (n_knots is None) == (step is None):
+        raise ValueError("Exactly one of n_knots and step must be given.")
+
+    if n_knots is not None:
+        if n_knots < 2:
+            raise ValueError(
+                f"Curve must have at least 2 knots, got {n_knots}."
+            )
+        return interpolate_curve(
+            C, np.linspace(0.0, 1.0, n_knots), metric=metric,
+            parameterization=parameterization,
+        )
+
+    if step <= 0:
+        raise ValueError(
+            f"Parameter step must be strictly positive, got {step}."
+        )
+    check_curve_parameterization(parameterization)
+    total = np.sum(curve_lengths(C, metric=metric))
+    if total <= 0:
+        raise ValueError("Curve of zero length cannot be resampled by step.")
+
+    params = np.arange(0.0, 1.0, step / total)
+    params = np.append(params[params < 1.0], 1.0)
+    return interpolate_curve(
+        C, params, metric=metric, parameterization="arclength",
+    )
+
+
+def curve_tangent(C, s, *, metric="riemann", parameterization="arclength"):
+    """Velocity of a piecewise-geodesic curve at given parameters.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    s : float | array-like, shape (n_points,)
+        Parameters where the velocity is evaluated, clipped into [0, 1].
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    T : ndarray, shape (n_points, n, n)
+        Velocity of the curve, as a tangent vector at each curve point.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    params = curve_parameters(
+        C, metric=metric, parameterization=parameterization,
+    )
+    index, alpha = _locate(params, s)
+    points = geodesic(C[index], C[index + 1], alpha, metric=metric)
+
+    ahead = alpha <= 0.5
+    target = np.where(ahead[:, None, None], C[index + 1], C[index])
+    scale = np.where(ahead, 1.0 - alpha, -alpha)
+    width = params[index + 1] - params[index]
+    scale = scale * np.where(width > 0, width, 1.0)
+    return log_map(target, points, metric=metric) / scale[:, None, None]
+
+
+def _squared_distance_at(X, A, B, alpha, metric):
+    """Squared distance between matrices and points of a geodesic."""
+    Y = geodesic(A, B, alpha, metric=metric)
+    d2 = distance(Y, X, metric=metric, squared=True)
+    return np.reshape(np.asarray(d2), (-1,))
+
+
+def _chart(X, metric):
+    """Map matrices to the Euclidean chart flattening a metric."""
+    if metric == "euclid":
+        return X
+    if metric == "logeuclid":
+        return logm(X)
+    chol = np.linalg.cholesky(X)
+    rows, cols = np.diag_indices(chol.shape[-1])
+    chart = np.tril(chol, -1).astype(chol.dtype)
+    chart[..., rows, cols] = np.log(np.real(chol[..., rows, cols]))
+    return chart
+
+
+def _project_flat(X, A, B, metric):
+    """Closed-form projection for metrics flattened by a chart."""
+    A, B, X = _chart(A, metric), _chart(B, metric), _chart(X, metric)
+    delta = B - A
+    numerator = np.sum(np.real(np.conj(delta) * (X - A)), axis=(-2, -1))
+    denominator = np.sum(np.real(np.conj(delta) * delta), axis=(-2, -1))
+    return np.where(
+        denominator > 0,
+        numerator / np.where(denominator > 0, denominator, 1.0),
+        0.0,
+    )
+
+
+def _bracket(X, A, B, metric, maxiter):
+    """Expand a search interval until it brackets the minimizer."""
+    probe = 1e-6
+    low, high = np.zeros(len(X)), np.ones(len(X))
+    step = np.ones(len(X))
+    for _ in range(maxiter):
+        down = _squared_distance_at(X, A, B, low - probe, metric) \
+            < _squared_distance_at(X, A, B, low, metric)
+        up = _squared_distance_at(X, A, B, high + probe, metric) \
+            < _squared_distance_at(X, A, B, high, metric)
+        if not (np.any(down) or np.any(up)):
+            break
+        low = np.where(down, low - step, low)
+        high = np.where(up, high + step, high)
+        step = np.where(down | up, 2.0 * step, step)
+    return low, high
+
+
+def _golden_section(X, A, B, metric, low, high, tol, maxiter):
+    """Minimize a strictly convex function of the geodesic parameter."""
+    for _ in range(maxiter):
+        if np.max(high - low) <= tol:
+            break
+        left = high - _INVPHI * (high - low)
+        right = low + _INVPHI * (high - low)
+        f_left = _squared_distance_at(X, A, B, left, metric)
+        f_right = _squared_distance_at(X, A, B, right, metric)
+        keep_left = f_left < f_right
+        low = np.where(keep_left, low, left)
+        high = np.where(keep_left, right, high)
+    return 0.5 * (low + high)
+
+
+def project_on_geodesic(X, A, B, *, metric="riemann", clip=True, tol=1e-10,
+                        maxiter=100):
+    """Project matrices on the geodesic joining two matrices.
+
+    Parameters
+    ----------
+    X : ndarray, shape (n, n) or (n_matrices, n, n)
+        Matrices to project.
+    A : ndarray, shape (n, n)
+        Matrix at position 0 of the geodesic.
+    B : ndarray, shape (n, n)
+        Matrix at position 1 of the geodesic.
+    metric : string, default="riemann"
+        Metric of the geodesic.
+    clip : bool, default=True
+        If True, positions are restricted to the segment [0, 1].
+    tol : float, default=1e-10
+        Tolerance on the width of the search interval.
+    maxiter : int, default=100
+        Maximum number of iterations.
+
+    Returns
+    -------
+    alpha : ndarray, shape (n_matrices,)
+        Position on the geodesic of the closest point to each matrix.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    check_curve_metric(metric)
+    X = np.asarray(X)
+    if X.ndim == 2:
+        X = X[np.newaxis, ...]
+    if X.ndim != 3:
+        raise ValueError(f"Input must have 2 or 3 dimensions, got {X.ndim}.")
+    A, B = np.asarray(A), np.asarray(B)
+    if np.array_equal(A, B):
+        return np.zeros(len(X))
+    A = np.broadcast_to(A, X.shape)
+    B = np.broadcast_to(B, X.shape)
+
+    if metric in ("euclid", "logchol", "logeuclid"):
+        alpha = _project_flat(X, A, B, metric)
+        return np.clip(alpha, 0.0, 1.0) if clip else alpha
+
+    if clip:
+        low, high = np.zeros(len(X)), np.ones(len(X))
+    else:
+        low, high = _bracket(X, A, B, metric, maxiter)
+    return _golden_section(X, A, B, metric, low, high, tol, maxiter)
+
+
+def _monotone_segments(dists):
+    """Non-decreasing segment assignment minimizing a total cost."""
+    n_segments, n_matrices = dists.shape
+    total = np.empty((n_matrices, n_segments))
+    previous = np.zeros((n_matrices, n_segments), dtype=int)
+    total[0] = dists[:, 0]
+    for i in range(1, n_matrices):
+        for j in range(n_segments):
+            best = int(np.argmin(total[i - 1, :j + 1]))
+            total[i, j] = total[i - 1, best] + dists[j, i]
+            previous[i, j] = best
+
+    best = np.empty(n_matrices, dtype=int)
+    best[-1] = int(np.argmin(total[-1]))
+    for i in range(n_matrices - 1, 0, -1):
+        best[i - 1] = previous[i, best[i]]
+    return best
+
+
+def project_on_curve(X, C, *, metric="riemann", parameterization="arclength",
+                     monotone=False, tol=1e-10, maxiter=100):
+    """Project matrices on a piecewise-geodesic curve.
+
+    Parameters
+    ----------
+    X : ndarray, shape (n, n) or (n_matrices, n, n)
+        Matrices to project.
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+    monotone : bool, default=False
+        If True, matrices are assigned to non-decreasing segments.
+    tol : float, default=1e-10
+        Tolerance on the width of the search interval.
+    maxiter : int, default=100
+        Maximum number of iterations.
+
+    Returns
+    -------
+    s : ndarray, shape (n_matrices,)
+        Parameter of the closest point of the curve to each matrix.
+    d : ndarray, shape (n_matrices,)
+        Distance between each matrix and the curve.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    params = curve_parameters(
+        C, metric=metric, parameterization=parameterization,
+    )
+    X = np.asarray(X)
+    if X.ndim == 2:
+        X = X[np.newaxis, ...]
+
+    n_segments, n_matrices = len(C) - 1, len(X)
+    alphas = np.empty((n_segments, n_matrices))
+    dists = np.empty((n_segments, n_matrices))
+    for j in range(n_segments):
+        alphas[j] = project_on_geodesic(
+            X, C[j], C[j + 1], metric=metric, tol=tol, maxiter=maxiter,
+        )
+        dists[j] = _squared_distance_at(
+            X, np.broadcast_to(C[j], X.shape),
+            np.broadcast_to(C[j + 1], X.shape), alphas[j], metric,
+        )
+
+    best = _monotone_segments(dists) if monotone else np.argmin(dists, axis=0)
+    rows = np.arange(n_matrices)
+    alpha = alphas[best, rows]
+    s = params[best] + alpha * (params[best + 1] - params[best])
+    return s, np.sqrt(dists[best, rows])
+
+
+def curve_length_between(C, s1, s2, *, metric="riemann",
+                         parameterization="arclength"):
+    """Length of a piecewise-geodesic curve between two parameters.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    s1 : float
+        First parameter, clipped into [0, 1].
+    s2 : float
+        Second parameter, clipped into [0, 1].
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    length : float
+        Geodesic length of the curve between the two parameters.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    params = curve_parameters(
+        C, metric=metric, parameterization=parameterization,
+    )
+    lengths = curve_lengths(C, metric=metric)
+    bounds = np.sort(np.clip(np.asarray([s1, s2], dtype=float), 0.0, 1.0))
+    index, alpha = _locate(params, bounds)
+
+    if index[0] == index[1]:
+        return float((alpha[1] - alpha[0]) * lengths[index[0]])
+    length = (1.0 - alpha[0]) * lengths[index[0]] \
+        + alpha[1] * lengths[index[1]]
+    return float(length + np.sum(lengths[index[0] + 1:index[1]]))
+
+
+def insert_knot(C, s, *, metric="riemann", parameterization="arclength"):
+    """Insert a knot in a piecewise-geodesic curve.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    s : float
+        Parameter of the inserted knot, clipped into [0, 1].
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    C_new : ndarray, shape (n_knots_new, n, n)
+        Knots of the curve with the inserted knot.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    params = curve_parameters(
+        C, metric=metric, parameterization=parameterization,
+    )
+    s = float(np.clip(s, 0.0, 1.0))
+    if np.any(params == s):
+        return C
+
+    index, alpha = _locate(params, [s])
+    knot = geodesic(C[index], C[index + 1], alpha, metric=metric)
+    return np.concatenate([C[:index[0] + 1], knot, C[index[0] + 1:]])
+
+
+def split_curve(C, s, *, metric="riemann", parameterization="arclength"):
+    """Split a piecewise-geodesic curve at a parameter.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the curve, in order.
+    s : float
+        Parameter where the curve is split, strictly between 0 and 1.
+    metric : string, default="riemann"
+        Metric of the curve.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+
+    Returns
+    -------
+    C1 : ndarray, shape (n_knots_1, n, n)
+        Knots of the curve before the split.
+    C2 : ndarray, shape (n_knots_2, n, n)
+        Knots of the curve after the split.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    if not 0 < s < 1:
+        raise ValueError(
+            f"Parameter s must be strictly inside [0, 1], got {s}."
+        )
+
+    params = curve_parameters(
+        C, metric=metric, parameterization=parameterization,
+    )
+    if np.any(params == s):
+        cut = int(np.flatnonzero(params == s)[0])
+        return C[:cut + 1], C[cut:]
+
+    index, alpha = _locate(params, [s])
+    point = geodesic(C[index], C[index + 1], alpha, metric=metric)
+    cut = int(index[0])
+    return (
+        np.concatenate([C[:cut + 1], point]),
+        np.concatenate([point, C[cut + 1:]]),
+    )
+
+
+def simplify_curve(C, epsilon=None, *, n_knots=None, metric="riemann",
+                   tol=1e-10, maxiter=100):
+    """Simplify a piecewise-geodesic curve by dropping knots.
+
+    Parameters
+    ----------
+    C : ndarray, shape (n_knots_orig, n, n)
+        Knots of the curve, in order.
+    epsilon : None | float, default=None
+        Positive tolerance on the distance to the simplified curve.
+    n_knots : None | int, default=None
+        Maximum number of knots kept, at least 2.
+    metric : string, default="riemann"
+        Metric of the curve.
+    tol : float, default=1e-10
+        Tolerance on the width of the search interval.
+    maxiter : int, default=100
+        Maximum number of iterations.
+
+    Returns
+    -------
+    C_new : ndarray, shape (n_knots_new, n, n)
+        Knots of the simplified curve.
+    indices : ndarray, shape (n_knots_new,)
+        Indices of the kept knots, in increasing order.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C = check_knots(C)
+    check_curve_metric(metric)
+    if (epsilon is None) == (n_knots is None):
+        raise ValueError("Exactly one of epsilon and n_knots must be given.")
+    if epsilon is not None and epsilon <= 0:
+        raise ValueError(
+            f"Parameter epsilon must be strictly positive, got {epsilon}."
+        )
+    if n_knots is not None and n_knots < 2:
+        raise ValueError(f"Curve must have at least 2 knots, got {n_knots}.")
+
+    kept = np.zeros(len(C), dtype=bool)
+    kept[0], kept[-1] = True, True
+    whole = (0, len(C) - 1)
+    parts = {whole: _farthest_knot(C, *whole, metric, tol, maxiter)}
+    budget = len(C) if n_knots is None else n_knots
+
+    while parts and np.count_nonzero(kept) < budget:
+        part = min(parts, key=lambda p: (-parts[p][1], p[0]))
+        position, deviation = parts.pop(part)
+        if position < 0 or (epsilon is not None and deviation <= epsilon):
+            if epsilon is None:
+                continue
+            break
+        kept[position] = True
+        for bounds in [(part[0], position), (position, part[1])]:
+            parts[bounds] = _farthest_knot(C, *bounds, metric, tol, maxiter)
+
+    indices = np.flatnonzero(kept)
+    return C[indices], indices
+
+
+def _farthest_knot(C, start, stop, metric, tol, maxiter):
+    """Index and deviation of the knot farthest from a chord of a curve."""
+    if stop <= start + 1:
+        return -1, 0.0
+    inner = C[start + 1:stop]
+    alpha = project_on_geodesic(
+        inner, C[start], C[stop], metric=metric, tol=tol, maxiter=maxiter,
+    )
+    dists = np.sqrt(_squared_distance_at(
+        inner, np.broadcast_to(C[start], inner.shape),
+        np.broadcast_to(C[stop], inner.shape), alpha, metric,
+    ))
+    farthest = int(np.argmax(dists))
+    return start + 1 + farthest, float(dists[farthest])
+
+
+def _segment_deviations(X, metric, tol, maxiter):
+    """Squared cost and largest deviation of every candidate segment."""
+    n_matrices = len(X)
+    costs = np.zeros((n_matrices, n_matrices))
+    deviations = np.zeros((n_matrices, n_matrices))
+    for start in range(n_matrices - 1):
+        for stop in range(start + 2, n_matrices):
+            inner = X[start + 1:stop]
+            alpha = project_on_geodesic(
+                inner, X[start], X[stop], metric=metric, tol=tol,
+                maxiter=maxiter,
+            )
+            squared = _squared_distance_at(
+                inner, np.broadcast_to(X[start], inner.shape),
+                np.broadcast_to(X[stop], inner.shape), alpha, metric,
+            )
+            costs[start, stop] = np.sum(squared)
+            deviations[start, stop] = np.sqrt(np.max(squared))
+    return costs, deviations
+
+
+def fit_curve(X, n_segments=None, *, epsilon=None, metric="riemann", tol=1e-10,
+              maxiter=100):
+    """Fit a piecewise-geodesic curve to an ordered set of matrices.
+
+    Parameters
+    ----------
+    X : ndarray, shape (n_matrices, n, n)
+        Set of SPD/HPD matrices, in order.
+    n_segments : None | int, default=None
+        Number of segments of the fitted curve, at least 1.
+    epsilon : None | float, default=None
+        Positive tolerance on the distance between a matrix and the curve.
+    metric : string, default="riemann"
+        Metric of the curve.
+    tol : float, default=1e-10
+        Tolerance on the width of the search interval.
+    maxiter : int, default=100
+        Maximum number of iterations.
+
+    Returns
+    -------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the fitted curve.
+    indices : ndarray, shape (n_knots,)
+        Indices of the matrices used as knots, in increasing order.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    X = check_knots(X)
+    check_curve_metric(metric)
+    if (n_segments is None) == (epsilon is None):
+        raise ValueError(
+            "Exactly one of n_segments and epsilon must be given."
+        )
+    if n_segments is not None and n_segments < 1:
+        raise ValueError(
+            f"Curve must have at least 1 segment, got {n_segments}."
+        )
+    if epsilon is not None and epsilon <= 0:
+        raise ValueError(
+            f"Parameter epsilon must be strictly positive, got {epsilon}."
+        )
+
+    n_matrices = len(X)
+    if n_segments is not None and n_segments >= n_matrices - 1:
+        indices = np.arange(n_matrices)
+        return X[indices], indices
+
+    costs, deviations = _segment_deviations(X, metric, tol, maxiter)
+    if epsilon is not None:
+        n_segments = _fewest_segments(deviations, epsilon)
+
+    total = np.full((n_segments + 1, n_matrices), np.inf)
+    previous = np.zeros((n_segments + 1, n_matrices), dtype=int)
+    total[0, 0] = 0.0
+    for count in range(1, n_segments + 1):
+        for stop in range(count, n_matrices):
+            candidates = total[count - 1, :stop] + costs[:stop, stop]
+            if epsilon is not None:
+                candidates = np.where(
+                    deviations[:stop, stop] <= epsilon, candidates, np.inf,
+                )
+            best = int(np.argmin(candidates))
+            total[count, stop], previous[count, stop] = candidates[best], best
+
+    indices, stop = [n_matrices - 1], n_matrices - 1
+    for count in range(n_segments, 0, -1):
+        stop = previous[count, stop]
+        indices.append(stop)
+    indices = np.array(indices[::-1])
+    return X[indices], indices
+
+
+def _fewest_segments(deviations, epsilon):
+    """Fewest segments keeping every deviation within a tolerance."""
+    n_matrices = len(deviations)
+    counts = np.zeros(n_matrices, dtype=int)
+    for stop in range(1, n_matrices):
+        allowed = deviations[:stop, stop] <= epsilon
+        counts[stop] = np.min(counts[:stop][allowed]) + 1
+    return int(counts[-1])
+
+
+def mean_curve(curves, *, metric="riemann", n_knots=None,
+               parameterization="arclength"):
+    """Mean of piecewise-geodesic curves.
+
+    Parameters
+    ----------
+    curves : list of ndarray, shape (n_knots_i, n, n)
+        Curves to average, each given by its knots in order.
+    metric : string, default="riemann"
+        Metric of the curves.
+    n_knots : None | int, default=None
+        Number of knots of the mean curve. If None, it uses the largest number
+        of knots among the curves.
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curves.
+
+    Returns
+    -------
+    C : ndarray, shape (n_knots, n, n)
+        Knots of the mean curve.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    curves = [check_knots(C) for C in curves]
+    check_curve_metric(metric)
+    if len(curves) == 0:
+        raise ValueError("At least one curve is required.")
+    if n_knots is None:
+        n_knots = max(len(C) for C in curves)
+
+    resampled = np.stack([
+        resample_curve(
+            C, n_knots, metric=metric, parameterization=parameterization,
+        )
+        for C in curves
+    ])
+    return np.stack([
+        gmean(resampled[:, k], metric=metric) for k in range(n_knots)
+    ])
+
+
+def curve_distance(C1, C2, *, metric="riemann", return_coupling=False):
+    """Discrete Frechet distance between two piecewise-geodesic curves.
+
+    Parameters
+    ----------
+    C1 : ndarray, shape (n_knots_1, n, n)
+        Knots of the first curve, in order.
+    C2 : ndarray, shape (n_knots_2, n, n)
+        Knots of the second curve, in order.
+    metric : string, default="riemann"
+        Metric used for distances between knots.
+    return_coupling : bool, default=False
+        If True, also return the coupling reaching the distance.
+
+    Returns
+    -------
+    d : float
+        Discrete Frechet distance between the two curves.
+    coupling : ndarray, shape (n_steps, 2)
+        Pairs of knot indices of the coupling, from the first pair to the last
+        one. Only returned if ``return_coupling`` is True.
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+    C1, C2 = check_knots(C1), check_knots(C2)
+    check_curve_metric(metric)
+    if C1.shape[-1] != C2.shape[-1]:
+        raise ValueError("Curves must have equal matrix dimensions")
+
+    n_1, n_2 = len(C1), len(C2)
+    pairs = distance(
+        np.repeat(C1, n_2, axis=0), np.tile(C2, (n_1, 1, 1)), metric=metric,
+    )
+    pairs = np.reshape(np.asarray(pairs), (n_1, n_2))
+
+    coupling = np.empty((n_1, n_2))
+    for i in range(n_1):
+        for j in range(n_2):
+            if i == 0 and j == 0:
+                previous = 0.0
+            elif i == 0:
+                previous = coupling[0, j - 1]
+            elif j == 0:
+                previous = coupling[i - 1, 0]
+            else:
+                previous = min(
+                    coupling[i - 1, j], coupling[i, j - 1],
+                    coupling[i - 1, j - 1],
+                )
+            coupling[i, j] = max(previous, pairs[i, j])
+
+    if not return_coupling:
+        return float(coupling[-1, -1])
+
+    steps, i, j = [(n_1 - 1, n_2 - 1)], n_1 - 1, n_2 - 1
+    while i > 0 or j > 0:
+        if i == 0:
+            j -= 1
+        elif j == 0:
+            i -= 1
+        else:
+            options = [
+                (coupling[i - 1, j - 1], i - 1, j - 1),
+                (coupling[i - 1, j], i - 1, j),
+                (coupling[i, j - 1], i, j - 1),
+            ]
+            _, i, j = min(options, key=lambda option: option[0])
+        steps.append((i, j))
+    return float(coupling[-1, -1]), np.array(steps[::-1])
