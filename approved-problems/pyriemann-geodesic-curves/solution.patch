+class CurveEmbedding(TransformerMixin, BaseEstimator):
+    """Embedding of SPD/HPD matrices along a piecewise-geodesic curve.
+
+    Embed SPD/HPD matrices into two coordinates relative to a reference
+    piecewise-geodesic curve: the parameter of the closest point of the curve,
+    and the distance to the curve.
+
+    Parameters
+    ----------
+    metric : string, default="riemann"
+        Metric of the curve, can be: "euclid", "logchol", "logeuclid",
+        "riemann".
+    parameterization : {"arclength", "uniform"}, default="arclength"
+        Parameterization of the curve.
+    n_segments : None | int, default=None
+        If not None, knots are fitted with this number of segments.
+    epsilon : None | float, default=None
+        If not None, knots are simplified with this tolerance.
+    n_knots : None | int, default=None
+        If not None, knots are resampled to this number of knots.
+    tol : float, default=1e-10
+        Tolerance on the width of the search interval.
+    maxiter : int, default=100
+        Maximum number of iterations.
+
+    Attributes
+    ----------
+    knots_ : ndarray, shape (n_knots, n_channels, n_channels)
+        Knots of the reference curve.
+
+    See Also
+    --------
+    SpectralEmbedding
+
+    Notes
+    -----
+    .. versionadded:: 0.13
+    """
+
+    def __init__(self, metric="riemann", parameterization="arclength",
+                 n_segments=None, epsilon=None, n_knots=None, tol=1e-10,
+                 maxiter=100):
+        self.metric = metric
+        self.parameterization = parameterization
+        self.n_segments = n_segments
+        self.epsilon = epsilon
+        self.n_knots = n_knots
+        self.tol = tol
+        self.maxiter = maxiter
+
+    def fit(self, X, y=None):
+        """Estimate the reference curve.
+
+        Parameters
+        ----------
+        X : ndarray, shape (n_matrices, n_channels, n_channels)
+            Set of SPD/HPD matrices.
+        y : None | ndarray, shape (n_matrices,), default=None
+            Labels of the matrices. If None, matrices are the knots of the
+            curve, in the order they are given.
+
+        Returns
+        -------
+        self : CurveEmbedding instance
+            The CurveEmbedding instance.
+        """
+        X = np.asarray(X)
+        if y is None:
+            if self.n_segments is None:
+                knots = X
+            else:
+                knots, _ = fit_curve(
+                    X, self.n_segments, metric=self.metric, tol=self.tol,
+                    maxiter=self.maxiter,
+                )
+        else:
+            if self.n_segments is not None:
+                raise ValueError("Parameters y and n_segments are exclusive.")
+            y = np.asarray(y)
+            knots = np.stack([
+                gmean(X[y == label], metric=self.metric)
+                for label in np.unique(y)
+            ])
+        knots = check_knots(knots)
+
+        if self.epsilon is not None:
+            knots, _ = simplify_curve(
+                knots, self.epsilon, metric=self.metric, tol=self.tol,
+                maxiter=self.maxiter,
+            )
+        if self.n_knots is not None:
+            knots = resample_curve(
+                knots, self.n_knots, metric=self.metric,
+                parameterization=self.parameterization,
+            )
+
+        self.knots_ = knots
+        return self
+
+    def transform(self, X):
+        """Embed matrices relative to the reference curve.
+
+        Parameters
+        ----------
+        X : ndarray, shape (n_matrices, n_channels, n_channels)
+            Set of SPD/HPD matrices.
+
+        Returns
+        -------
+        X_new : ndarray, shape (n_matrices, 2)
+            Curve parameter and distance to the curve of each matrix.
+        """
+        s, d = project_on_curve(
+            X, self.knots_, metric=self.metric,
+            parameterization=self.parameterization, tol=self.tol,
+            maxiter=self.maxiter,
+        )
+        return np.stack([s, d], axis=-1)
+
+    def inverse_transform(self, X, y=None):
+        """Return the matrices of the curve at the embedded parameters.
+
+        Parameters
+        ----------
+        X : ndarray, shape (n_matrices, 2)
+            Embedded matrices.
+        y : None
+            Not used, here for compatibility with sklearn API.
+
+        Returns
+        -------
+        X_original : ndarray, shape (n_matrices, n_channels, n_channels)
+            Matrices of the curve at the embedded parameters.
+        """
+        X = np.asarray(X)
+        return interpolate_curve(
+            self.knots_, X[..., 0], metric=self.metric,
+            parameterization=self.parameterization,
+        )
+
+
 ###############################################################################
 
 
