+    C = rand_curve(3, seed=835)
+    X = np.stack([rand_spd(3, 845 + i) for i in range(3)])
+    for metric in METRICS:
+        for clip in (True, False):
+            got = project_on_geodesic(
+                X, C[0], C[1], metric=metric, clip=clip, tol=1e-13,
+                maxiter=400,
+            )
+            assert got.shape == (3,)
+            assert np.all(np.isfinite(got))
+            if clip:
+                assert np.all(got >= 0.0)
+                assert np.all(got <= 1.0)
