+def test_monotone_projection_is_the_constrained_optimum():
+    C = rand_curve(3, seed=795)
+    X = np.stack([rand_spd(3, 805 + i) for i in range(4)])
+    _, distances = project_on_curve(X, C, metric="riemann", monotone=True)
+
+    costs = np.empty((len(X), 2))
+    for i, x in enumerate(X):
+        for j in range(2):
+            alpha = brute_alpha(x, C[j], C[j + 1], "riemann")
+            costs[i, j] = squared_at(x, C[j], C[j + 1], alpha, "riemann")
+    best = np.inf
+    for a in range(2):
+        for b in range(a, 2):
+            for c in range(b, 2):
+                for d in range(c, 2):
+                    assignment = (a, b, c, d)
+                    best = min(best, sum(
+                        costs[i, assignment[i]] for i in range(4)
+                    ))
+    assert np.sum(distances ** 2) <= best + 1e-6
+
