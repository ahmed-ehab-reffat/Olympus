+def test_curve_distance_matches_exhaustive_coupling():
+    C1 = diag_curve([[1.0, 1.0, 1.0], [np.e, 1.0, 1.0], [np.e ** 4, 1.0, 1.0]])
+    C2 = diag_curve([[np.e ** 0.5, 1.0, 1.0], [np.e ** 3, 1.0, 1.0]])
+    pairs = np.array([
+        [abs(log_diag(a)[0] - log_diag(b)[0]) for b in C2] for a in C1
+    ])
+    best = np.inf
+    for coupling in [
+        [(0, 0), (1, 0), (2, 0), (2, 1)],
+        [(0, 0), (1, 0), (1, 1), (2, 1)],
+        [(0, 0), (0, 1), (1, 1), (2, 1)],
+        [(0, 0), (1, 1), (2, 1)],
+        [(0, 0), (1, 0), (2, 1)],
+    ]:
+        best = min(best, max(pairs[i, j] for i, j in coupling))
+    assert_allclose(curve_distance(C1, C2, metric="riemann"), best, rtol=1e-9)
