index 0000000..7bd77cd
--- /dev/null
+++ b/tests/test_embedding_curve_f060f9.py
@@ -0,0 +1,242 @@
+import numpy as np
+from numpy.testing import assert_allclose
+import pytest
+from sklearn.base import clone
+
+from pyriemann.geometry.mean import gmean
+
+try:
+    from pyriemann.embedding import CurveEmbedding
+    from pyriemann.geometry.curve import (
+        curve_parameters,
+        fit_curve,
+        interpolate_curve,
+        project_on_curve,
+        resample_curve,
+        simplify_curve,
+    )
+except ImportError:
+    pass
+
+
+def rand_spd(n_channels, seed):
+    rs = np.random.RandomState(seed)
+    A = rs.randn(n_channels, n_channels)
+    return A @ A.T + n_channels * np.eye(n_channels)
+
+
+def rand_curve(n_knots, n_channels=3, seed=0):
+    return np.stack([rand_spd(n_channels, seed + i) for i in range(n_knots)])
+
+
+def test_fit_without_labels_keeps_the_training_matrices():
+    X = rand_curve(5, seed=900)
+    embedding = CurveEmbedding(metric="riemann").fit(X)
+    assert_allclose(embedding.knots_, X, atol=1e-12)
+
+
+def test_fit_with_labels_uses_group_means():
+    X = rand_curve(6, seed=910)
+    y = np.array([2, 0, 2, 1, 0, 1])
+    embedding = CurveEmbedding(metric="riemann").fit(X, y)
+    expected = np.stack([
+        gmean(X[y == label], metric="riemann") for label in [0, 1, 2]
+    ])
+    assert_allclose(embedding.knots_, expected, atol=1e-8)
+
+
+def test_fit_with_string_labels_orders_them():
+    X = rand_curve(4, seed=920)
+    y = np.array(["late", "early", "late", "early"])
+    embedding = CurveEmbedding(metric="logeuclid").fit(X, y)
+    expected = np.stack([
+        gmean(X[y == label], metric="logeuclid") for label in ["early", "late"]
+    ])
+    assert_allclose(embedding.knots_, expected, atol=1e-8)
+
+
+def test_fit_with_segments_fits_the_curve():
+    X = rand_curve(8, seed=930)
+    embedding = CurveEmbedding(metric="riemann", n_segments=3).fit(X)
+    expected, _ = fit_curve(X, 3, metric="riemann")
+    assert_allclose(embedding.knots_, expected, atol=1e-10)
+
+
+def test_fit_simplifies_before_resampling():
+    X = rand_curve(8, seed=940)
+    embedding = CurveEmbedding(
+        metric="riemann", epsilon=0.7, n_knots=4,
+    ).fit(X)
+    simplified, _ = simplify_curve(X, 0.7, metric="riemann")
+    expected = resample_curve(simplified, 4, metric="riemann")
+    assert_allclose(embedding.knots_, expected, atol=1e-8)
+    assert embedding.knots_.shape == (4, 3, 3)
+
+
+def test_fit_applies_segments_then_simplification():
+    X = rand_curve(9, seed=950)
+    embedding = CurveEmbedding(
+        metric="riemann", n_segments=5, epsilon=0.9,
+    ).fit(X)
+    fitted, _ = fit_curve(X, 5, metric="riemann")
+    expected, _ = simplify_curve(fitted, 0.9, metric="riemann")
+    assert_allclose(embedding.knots_, expected, atol=1e-10)
+
+
+def test_transform_returns_parameter_and_distance():
+    X = rand_curve(5, seed=960)
+    probes = np.stack([rand_spd(3, 970 + i) for i in range(4)])
+    embedding = CurveEmbedding(metric="riemann").fit(X)
+    got = embedding.transform(probes)
+    s, d = project_on_curve(probes, X, metric="riemann")
+    assert got.shape == (4, 2)
+    assert_allclose(got[:, 0], s, atol=1e-8)
+    assert_allclose(got[:, 1], d, atol=1e-8)
+
+
+def test_transform_of_the_knots_gives_their_parameters():
+    X = rand_curve(5, seed=980)
+    embedding = CurveEmbedding(metric="riemann").fit(X)
+    got = embedding.transform(X)
+    params = curve_parameters(X, metric="riemann")
+    assert_allclose(got[:, 0], params, atol=1e-6)
+    assert_allclose(got[:, 1], np.zeros(5), atol=1e-6)
+
+
+def test_inverse_transform_returns_curve_points():
+    X = rand_curve(5, seed=990)
+    embedding = CurveEmbedding(metric="riemann").fit(X)
+    coordinates = np.column_stack([[0.0, 0.25, 1.0], [3.0, 4.0, 5.0]])
+    assert_allclose(
+        embedding.inverse_transform(coordinates),
+        interpolate_curve(X, [0.0, 0.25, 1.0], metric="riemann"),
+        atol=1e-10,
+    )
+
+
+def test_inverse_transform_recovers_matrices_taken_on_the_curve():
+    X = rand_curve(5, seed=1000)
+    probes = interpolate_curve(X, [0.13, 0.55, 0.87], metric="riemann")
+    embedding = CurveEmbedding(metric="riemann").fit(X)
+    got = embedding.inverse_transform(embedding.transform(probes))
+    assert_allclose(got, probes, atol=1e-6)
+
+
+def test_fit_transform_matches_fit_then_transform():
+    X = rand_curve(5, seed=1010)
+    embedding = CurveEmbedding(metric="logeuclid")
+    assert_allclose(
+        embedding.fit_transform(X),
+        CurveEmbedding(metric="logeuclid").fit(X).transform(X),
+        atol=1e-10,
+    )
+
+
+def test_uniform_parameterization_changes_the_embedding():
+    X = rand_curve(5, seed=1020)
+    probes = np.stack([rand_spd(3, 1030 + i) for i in range(3)])
+    arclength = CurveEmbedding(metric="riemann").fit(X).transform(probes)
+    uniform = CurveEmbedding(
+        metric="riemann", parameterization="uniform",
+    ).fit(X).transform(probes)
+    assert not np.allclose(arclength[:, 0], uniform[:, 0], atol=1e-6)
+    assert_allclose(arclength[:, 1], uniform[:, 1], atol=1e-8)
+
+
+def test_labels_then_simplification_then_resampling():
+    X = rand_curve(8, seed=1080)
+    y = np.array([0, 0, 1, 1, 2, 2, 3, 3])
+    embedding = CurveEmbedding(
+        metric="riemann", epsilon=0.5, n_knots=5,
+    ).fit(X, y)
+
+    means = np.stack([
+        gmean(X[y == label], metric="riemann") for label in [0, 1, 2, 3]
+    ])
+    simplified, _ = simplify_curve(means, 0.5, metric="riemann")
+    expected = resample_curve(simplified, 5, metric="riemann")
+    assert_allclose(embedding.knots_, expected, atol=1e-8)
+    assert embedding.knots_.shape == (5, 3, 3)
+
+
+def test_parameterization_reaches_resampling_and_inversion():
+    X = rand_curve(5, seed=1060)
+    embedding = CurveEmbedding(
+        metric="riemann", parameterization="uniform", n_knots=4,
+    ).fit(X)
+    expected = resample_curve(
+        X, 4, metric="riemann", parameterization="uniform",
+    )
+    assert_allclose(embedding.knots_, expected, atol=1e-9)
+
+    coordinates = np.column_stack([[0.0, 0.4, 1.0], [0.0, 0.0, 0.0]])
+    assert_allclose(
+        embedding.inverse_transform(coordinates),
+        interpolate_curve(
+            expected, [0.0, 0.4, 1.0], metric="riemann",
+            parameterization="uniform",
+        ),
+        atol=1e-9,
+    )
+
+
+def test_labels_and_segments_are_exclusive():
+    X = rand_curve(5, seed=1040)
+    y = np.array([0, 0, 1, 1, 1])
+    with pytest.raises(ValueError):
+        CurveEmbedding(metric="riemann", n_segments=2).fit(X, y)
+
+
+def test_embedding_handles_hpd_matrices():
+    rs = np.random.RandomState(1100)
+    X = np.stack([
+        (lambda A: A @ A.conj().T + 3 * np.eye(3))(
+            rs.randn(3, 3) + 1j * rs.randn(3, 3)
+        )
+        for _ in range(5)
+    ])
+    embedding = CurveEmbedding(metric="riemann").fit(X)
+    coordinates = embedding.transform(X)
+    assert coordinates.shape == (5, 2)
+    assert_allclose(coordinates[:, 1], np.zeros(5), atol=1e-6)
+    recovered = embedding.inverse_transform(coordinates)
+    assert np.iscomplexobj(recovered)
+    assert_allclose(recovered, X, atol=1e-6)
+
+
+def test_embedding_defaults_match_explicit_options():
+    X = rand_curve(6, seed=1105)
+    probes = np.stack([rand_spd(3, 1115 + i) for i in range(3)])
+    default = CurveEmbedding().fit(X)
+    explicit = CurveEmbedding(
+        metric="riemann", parameterization="arclength",
+    ).fit(X)
+    assert_allclose(default.knots_, explicit.knots_, atol=1e-12)
+    assert_allclose(
+        default.transform(probes), explicit.transform(probes), atol=1e-12,
+    )
+
+
+def test_invalid_options_raise():
+    X = rand_curve(5, seed=1090)
+    for options in [
+        {"metric": "wasserstein"},
+        {"parameterization": "index"},
+        {"n_knots": 1},
+        {"epsilon": -1.0},
+        {"n_segments": 0},
+    ]:
+        with pytest.raises(ValueError):
+            CurveEmbedding(**options).fit(X).transform(X)
+
+
+def test_estimator_is_clonable():
+    embedding = CurveEmbedding(metric="logeuclid", n_knots=3, epsilon=0.5)
+    copy = clone(embedding)
+    assert copy.get_params() == embedding.get_params()
+
+
+def test_fit_returns_self():
+    X = rand_curve(4, seed=1050)
+    embedding = CurveEmbedding(metric="riemann")
+    assert embedding.fit(X) is embedding
