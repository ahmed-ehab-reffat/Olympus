+def test_fit_curve_by_epsilon_minimizes_cost_among_fewest_segments():
+    X = rand_curve(6, seed=815)
+    epsilon = 0.9
+    _, indices = fit_curve(X, epsilon=epsilon, metric="riemann")
+    n_segments = len(indices) - 1
+    chosen = sum(
+        brute_segment_cost(X, int(indices[i]), int(indices[i + 1]), "riemann")
+        for i in range(n_segments)
+    )
+    for interior in combinations(range(1, len(X) - 1), n_segments - 1):
+        knots = (0,) + interior + (len(X) - 1,)
+        worst = max(
+            brute_segment_deviation(X, knots[i], knots[i + 1], "riemann")
+            for i in range(n_segments)
+        )
+        if worst > epsilon:
+            continue
+        rival = sum(
+            brute_segment_cost(X, knots[i], knots[i + 1], "riemann")
+            for i in range(n_segments)
+        )
+        assert chosen <= rival + 1e-6
