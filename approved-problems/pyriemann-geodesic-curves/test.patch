index 0000000..c17cf7a
--- /dev/null
+++ b/tests/test_geometry_curve_f060f9.py
@@ -0,0 +1,1454 @@
+from itertools import combinations
+
+import numpy as np
+from numpy.testing import assert_allclose
+import pytest
+
+from pyriemann.geometry.distance import distance
+from pyriemann.geometry.geodesic import geodesic
+from pyriemann.geometry.tangentspace import exp_map
+
+try:
+    from pyriemann.geometry.curve import (
+        curve_distance,
+        curve_length_between,
+        curve_lengths,
+        curve_metrics,
+        curve_parameters,
+        curve_tangent,
+        fit_curve,
+        insert_knot,
+        interpolate_curve,
+        mean_curve,
+        project_on_curve,
+        project_on_geodesic,
+        resample_curve,
+        simplify_curve,
+        split_curve,
+    )
+except ImportError:
+    pass
+
+
+METRICS = ["euclid", "logchol", "logeuclid", "riemann"]
+
+
+def diag_spd(values):
+    return np.diag(np.asarray(values, dtype=float))
+
+
+def rand_spd(n_channels, seed):
+    rs = np.random.RandomState(seed)
+    A = rs.randn(n_channels, n_channels)
+    return A @ A.T + n_channels * np.eye(n_channels)
+
+
+def rand_hpd(n_channels, seed):
+    rs = np.random.RandomState(seed)
+    A = rs.randn(n_channels, n_channels) \
+        + 1j * rs.randn(n_channels, n_channels)
+    return A @ A.conj().T + n_channels * np.eye(n_channels)
+
+
+def rand_curve(n_knots, n_channels=3, seed=0):
+    return np.stack([rand_spd(n_channels, seed + i) for i in range(n_knots)])
+
+
+def diag_curve(rows):
+    return np.stack([diag_spd(row) for row in rows])
+
+
+def log_diag(X):
+    return np.log(np.diag(np.real(X)))
+
+
+def diag_geodesic(A, B, alpha):
+    return diag_spd(np.exp((1 - alpha) * log_diag(A) + alpha * log_diag(B)))
+
+
+def diag_projection(X, A, B):
+    delta = log_diag(B) - log_diag(A)
+    return float((log_diag(X) - log_diag(A)) @ delta / (delta @ delta))
+
+
+def squared_at(X, A, B, alpha, metric):
+    point = geodesic(A, B, float(alpha), metric=metric)
+    return float(np.asarray(distance(point, X, metric=metric, squared=True)))
+
+
+def brute_alpha(X, A, B, metric, low=0.0, high=1.0, n_points=4001):
+    grid = np.linspace(low, high, n_points)
+    values = [squared_at(X, A, B, t, metric) for t in grid]
+    return grid[int(np.argmin(values))]
+
+
+def brute_segment_cost(X, start, stop, metric):
+    total = 0.0
+    for k in range(start + 1, stop):
+        alpha = brute_alpha(X[k], X[start], X[stop], metric)
+        total += squared_at(X[k], X[start], X[stop], alpha, metric)
+    return total
+
+
+def brute_segment_deviation(X, start, stop, metric):
+    worst = 0.0
+    for k in range(start + 1, stop):
+        alpha = brute_alpha(X[k], X[start], X[stop], metric)
+        value = squared_at(X[k], X[start], X[stop], alpha, metric)
+        worst = max(worst, np.sqrt(value))
+    return worst
+
+
+def brute_simplify(C, epsilon, metric):
+    kept = {0, len(C) - 1}
+    parts = [(0, len(C) - 1)]
+    while parts:
+        start, stop = parts.pop()
+        if stop <= start + 1:
+            continue
+        deviations = []
+        for k in range(start + 1, stop):
+            alpha = brute_alpha(C[k], C[start], C[stop], metric)
+            value = squared_at(C[k], C[start], C[stop], alpha, metric)
+            deviations.append(np.sqrt(value))
+        farthest = int(np.argmax(deviations))
+        if deviations[farthest] > epsilon:
+            kept.add(start + 1 + farthest)
+            parts.append((start, start + 1 + farthest))
+            parts.append((start + 1 + farthest, stop))
+    return sorted(kept)
+
+
+def brute_fit(X, n_segments, metric):
+    best, best_cost = None, np.inf
+    for interior in combinations(range(1, len(X) - 1), n_segments - 1):
+        knots = (0,) + interior + (len(X) - 1,)
+        cost = sum(
+            brute_segment_cost(X, knots[i], knots[i + 1], metric)
+            for i in range(n_segments)
+        )
+        if cost < best_cost - 1e-9:
+            best, best_cost = knots, cost
+    return list(best)
+
+
+@pytest.mark.parametrize("metric", METRICS)
+def test_lengths_are_pairwise_distances(metric):
+    C = rand_curve(5, seed=10)
+    expected = [
+        float(np.asarray(distance(C[i], C[i + 1], metric=metric)))
+        for i in range(4)
+    ]
+    assert_allclose(curve_lengths(C, metric=metric), expected, rtol=1e-12)
+
+
+def test_lengths_shape_is_one_per_segment():
+    C = rand_curve(6, seed=20)
+    assert curve_lengths(C, metric="riemann").shape == (5,)
+
+
+def test_parameters_start_at_zero_and_end_at_one():
+    params = curve_parameters(rand_curve(4, seed=30), metric="riemann")
+    assert params[0] == 0.0
+    assert_allclose(params[-1], 1.0, rtol=1e-12)
+
+
+def test_parameters_arclength_on_diagonal_curve():
+    C = diag_curve([[1, 1, 1], [np.e, 1, 1], [np.e, np.e ** 4, 1]])
+    lengths = np.array([1.0, 4.0])
+    assert_allclose(
+        curve_parameters(C, metric="riemann"),
+        np.concatenate(([0.0], np.cumsum(lengths) / lengths.sum())),
+        atol=1e-12,
+    )
+
+
+def test_parameters_uniform_ignores_lengths():
+    C = diag_curve([[1, 1, 1], [np.e, 1, 1], [np.e, np.e ** 4, 1]])
+    assert_allclose(
+        curve_parameters(C, metric="riemann", parameterization="uniform"),
+        [0.0, 0.5, 1.0],
+        atol=1e-12,
+    )
+
+
+def test_parameters_are_nondecreasing():
+    params = curve_parameters(rand_curve(7, seed=40), metric="riemann")
+    assert np.all(np.diff(params) >= 0)
+
+
+@pytest.mark.parametrize("metric", ["euclid", "logchol", "logeuclid"])
+def test_parameters_of_zero_length_curve_are_all_zero(metric):
+    A = rand_spd(3, 50)
+    C = np.stack([A, A, A])
+    assert_allclose(curve_parameters(C, metric=metric), np.zeros(3), atol=0)
+
+
+def test_defaults_are_riemann_and_arclength():
+    C = rand_curve(4, seed=875)
+    X = np.stack([rand_spd(3, 885 + i) for i in range(3)])
+
+    assert_allclose(
+        curve_lengths(C), curve_lengths(C, metric="riemann"), rtol=1e-12,
+    )
+    assert_allclose(
+        curve_parameters(C),
+        curve_parameters(C, metric="riemann", parameterization="arclength"),
+        rtol=1e-12,
+    )
+    assert_allclose(
+        interpolate_curve(C, [0.3]),
+        interpolate_curve(
+            C, [0.3], metric="riemann", parameterization="arclength",
+        ),
+        atol=1e-12,
+    )
+    assert_allclose(
+        project_on_geodesic(X, C[0], C[1]),
+        project_on_geodesic(X, C[0], C[1], metric="riemann", clip=True),
+        atol=1e-12,
+    )
+    free, distances = project_on_curve(X, C)
+    explicit, expected = project_on_curve(
+        X, C, metric="riemann", parameterization="arclength", monotone=False,
+    )
+    assert_allclose(free, explicit, atol=1e-12)
+    assert_allclose(distances, expected, atol=1e-12)
+    assert_allclose(
+        curve_distance(C, C[::-1]),
+        curve_distance(C, C[::-1], metric="riemann"),
+        rtol=1e-12,
+    )
+
+
+def test_defaults_reach_every_routine():
+    C = rand_curve(4, seed=1085)
+    X = np.stack([rand_spd(3, 1095 + i) for i in range(3)])
+    both = {"metric": "riemann", "parameterization": "arclength"}
+
+    assert_allclose(
+        resample_curve(C, 5), resample_curve(C, 5, **both), atol=1e-12,
+    )
+    assert_allclose(
+        curve_tangent(C, [0.3]), curve_tangent(C, [0.3], **both), atol=1e-12,
+    )
+    assert_allclose(
+        curve_length_between(C, 0.1, 0.8),
+        curve_length_between(C, 0.1, 0.8, **both),
+        rtol=1e-12,
+    )
+    assert_allclose(
+        insert_knot(C, 0.42), insert_knot(C, 0.42, **both), atol=1e-12,
+    )
+    first, second = split_curve(C, 0.42)
+    expected_first, expected_second = split_curve(C, 0.42, **both)
+    assert_allclose(first, expected_first, atol=1e-12)
+    assert_allclose(second, expected_second, atol=1e-12)
+    assert_allclose(
+        mean_curve([C, C]), mean_curve([C, C], **both), atol=1e-8,
+    )
+
+    assert list(simplify_curve(C, 0.5)[1]) == \
+        list(simplify_curve(C, 0.5, metric="riemann")[1])
+    assert list(fit_curve(X, 2)[1]) == \
+        list(fit_curve(X, 2, metric="riemann")[1])
+
+
+def test_geodesic_endpoints_of_different_sizes_raise():
+    X = np.stack([rand_spd(3, 1125 + i) for i in range(2)])
+    small, large = rand_spd(3, 1135), rand_spd(4, 1145)
+    with pytest.raises(ValueError):
+        project_on_geodesic(X, small, large, metric="riemann")
+    with pytest.raises(ValueError):
+        project_on_geodesic(X, large, small, metric="riemann")
+
+
+def test_epsilon_boundary_is_strict_then_inclusive():
+    C = diag_curve([
+        [1.0, 1.0, 1.0], [2.0, 3.0, 1.0], [3.0, 1.0, 1.0],
+    ])
+    alpha = project_on_geodesic(C[1], C[0], C[2], metric="euclid")
+    assert_allclose(alpha, [0.5], atol=0)
