+import numpy as np
+
+from ..copc import Bounds
+from .grid import stored_coords, to_world
+
+
+class DatasetSummary:
+    """What a dataset holds, counted from the points themselves"""
+
+    def __init__(
+        self,
+        point_count,
+        bounds,
+        counts_by_classification,
+        counts_by_return,
+        gps_time_span,
+        extra_dimension_names,
+        density,
+    ):
+        self.point_count = point_count
+        self.bounds = bounds
+        self.counts_by_classification = counts_by_classification
+        self.counts_by_return = counts_by_return
+        self.gps_time_span = gps_time_span
+        self.extra_dimension_names = extra_dimension_names
+        self.density = density
+
+    def as_dict(self):
+        return {
+            "point_count": self.point_count,
+            "bounds": self.bounds,
+            "counts_by_classification": self.counts_by_classification,
+            "counts_by_return": self.counts_by_return,
+            "gps_time_span": self.gps_time_span,
+            "extra_dimension_names": self.extra_dimension_names,
+            "density": self.density,
+        }
+
+    def __repr__(self):
+        return "<DatasetSummary({} points, {} classes)>".format(
+            self.point_count, len(self.counts_by_classification)
+        )
+
+
+def _counts(values):
+    counts = {}
+    if len(values) == 0:
+        return counts
+    keys, totals = np.unique(np.asarray(values), return_counts=True)
+    for key, total in zip(keys, totals):
+        counts[key.item()] = int(total)
+    return counts
+
+
+def summarize(data):
+    """Describes the content of a dataset.
+
+    Parameters
+    ----------
+    data: laspy.LasData
+        The dataset to describe.
+
+    Returns
+    -------
+        laspy.DatasetSummary
+    """
+    scales = np.asarray(data.header.scales)
+    offsets = np.asarray(data.header.offsets)
+    coords = stored_coords(data, 3)
+    point_count = int(coords.shape[1])
+    extra_dimension_names = tuple(data.point_format.extra_dimension_names)
+
+    if point_count == 0:
+        return DatasetSummary(
+            point_count=0,
+            bounds=None,
+            counts_by_classification={},
+            counts_by_return={},
+            gps_time_span=None,
+            extra_dimension_names=extra_dimension_names,
+            density=None,
+        )
+
+    mins = [
+        float(to_world(coords[axis].min(), scales[axis], offsets[axis]))
+        for axis in range(3)
+    ]
+    maxs = [
+        float(to_world(coords[axis].max(), scales[axis], offsets[axis]))
+        for axis in range(3)
+    ]
+    area = (maxs[0] - mins[0]) * (maxs[1] - mins[1])
+    density = point_count / area if area > 0 else None
+
+    if "gps_time" in data.point_format.dimension_names:
+        gps_time = np.asarray(data["gps_time"])
+        gps_time_span = (float(gps_time.min()), float(gps_time.max()))
+    else:
+        gps_time_span = None
+
+    return DatasetSummary(
+        point_count=point_count,
+        bounds=Bounds(np.array(mins), np.array(maxs)),
+        counts_by_classification=_counts(data["classification"]),
+        counts_by_return=_counts(data["return_number"]),
+        gps_time_span=gps_time_span,
+        extra_dimension_names=extra_dimension_names,
+        density=density,
+    )
