+def test_operations_do_not_modify_their_source():
+    data = with_extra(
+        build([0.5, 1.5], [0.5, 1.5], classification=[3, 4], synthetic=[False, False]),
+        "echo",
+        [4, 5],
+    )
+    data.vlrs.append(laspy.VLR(user_id="custom", record_id=9, record_data=b"keep"))
+    def snapshot():
+        dimension = data.point_format.dimension_by_name("echo")
+        return (
+            stored(data),
+            values(data, "classification"),
+            values(data, "synthetic"),
+            values(data, "echo"),
+            [vlr.record_id for vlr in data.vlrs],
+            data.header.point_count,
+            list(data.header.offsets),
+            list(data.header.mins),
+            list(data.header.maxs),
+            list(data.header.number_of_points_by_return),
+            (dimension.name, dimension.dtype, dimension.description),
+        )
+
+    before = snapshot()
+    laspy.partition(data, cell_size=1.0, buffer=0.6)
+    laspy.crop(data, (0.0, 0.0, 1.0, 1.0))
+    laspy.thin(data, 1.0)
+    laspy.split_by(data, "classification")
+    laspy.summarize(data)
+    laspy.merge_datasets([data, data], scales=(0.5, 0.5, 0.5))
+    assert snapshot() == before
