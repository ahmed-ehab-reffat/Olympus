+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+PYTHON="python3"
+command -v python3 >/dev/null 2>&1 || PYTHON="python"
+
+PYTEST_ARGS="-p no:cacheprovider -o addopts="
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  PYTEST_ARGS="$PYTEST_ARGS --junitxml=$OUTPUT_PATH"
+fi
+
+if [ "$MODE" = "new" ]; then
+  $PYTHON -m pytest $PYTEST_ARGS tests/test_assembly_e63428.py
+else
+  $PYTHON -m pytest $PYTEST_ARGS \
+    --ignore docs/conf.py --ignore laspy/cli --doctest-modules --doctest-glob='*.rst' \
+    --ignore tests/test_assembly_e63428.py \
+    tests laspy docs
+fi
