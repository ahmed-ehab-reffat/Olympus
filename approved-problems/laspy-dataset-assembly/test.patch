+def test_merge_default_version_is_the_largest():
+    merged = laspy.merge_datasets(
+        [
+            build([0.0], [0.0], point_format=1, version="1.2"),
+            build([1.0], [1.0], point_format=1, version="1.3"),
+        ]
+    )
+    assert str(merged.header.version) == "1.3"
+
