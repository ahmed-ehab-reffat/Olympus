+def test_partition_then_merge_restores_the_dataset():
+    data = build(
+        [0.1, 1.2, 2.3, 3.4],
+        [0.1, 1.2, 2.3, 3.4],
+        [1.0, 2.0, 3.0, 4.0],
+        classification=[1, 2, 3, 4],
+    )
+    parts = laspy.partition(data, cell_size=1.0)
+    merged = laspy.merge_datasets([part.data for part in parts])
+    restored = sorted(zip(world(merged), values(merged, "classification")))
+    original = sorted(zip(world(data), values(data, "classification")))
+    assert [point[1] for point in restored] == [point[1] for point in original]
+    assert [point[0] for point in restored] == pytest.approx(
+        [point[0] for point in original]
+    )
+
