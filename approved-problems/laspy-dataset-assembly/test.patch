+    merged = laspy.merge_datasets([data], point_format_id=6)
+    assert values(merged, "scan_angle") == [0]
+
+
+def test_merge_unions_extra_dimensions():
+    first = with_extra(build([0.0], [0.0]), "amplitude", [11])
+    second = with_extra(build([1.0], [1.0]), "echo", [22])
+    merged = laspy.merge_datasets([first, second])
+    assert list(merged.point_format.extra_dimension_names) == ["amplitude", "echo"]
+
+
+def test_merge_extra_dimensions_keep_first_appearance_order():
