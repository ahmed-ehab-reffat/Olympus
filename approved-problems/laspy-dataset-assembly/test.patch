+import numpy as np
+import pytest
+
+import laspy
+from laspy import ExtraBytesParams
+
+
+def build(
+    xs,
+    ys,
+    zs=None,
+    *,
+    scales=(0.01, 0.01, 0.01),
+    offsets=(0.0, 0.0, 0.0),
+    point_format=3,
+    version="1.2",
+    classification=None,
+    return_number=None,
+    intensity=None,
+    point_source_id=None,
+    gps_time=None,
+    synthetic=None,
+):
+    header = laspy.LasHeader(version=version, point_format=point_format)
+    header.scales = np.array(scales, dtype=np.float64)
+    header.offsets = np.array(offsets, dtype=np.float64)
+    data = laspy.LasData(header)
+    if zs is None:
+        zs = [0.0] * len(xs)
+    data.x = np.array(xs, dtype=np.float64)
+    data.y = np.array(ys, dtype=np.float64)
+    data.z = np.array(zs, dtype=np.float64)
+    if classification is not None:
+        data.classification = np.array(classification)
+    if return_number is not None:
+        data.return_number = np.array(return_number)
+    if intensity is not None:
+        data.intensity = np.array(intensity)
+    if point_source_id is not None:
+        data.point_source_id = np.array(point_source_id)
+    if gps_time is not None:
+        data.gps_time = np.array(gps_time, dtype=np.float64)
+    if synthetic is not None:
+        data.synthetic = np.array(synthetic)
+    data.update_header()
+    return data
+
+
+def with_extra(data, name, values, dtype=np.uint16):
+    data.add_extra_dim(ExtraBytesParams(name=name, type=dtype))
+    data[name] = np.array(values, dtype=dtype)
+    return data
+
+
+def stored(data, name="X"):
+    return [int(value) for value in np.asarray(data[name])]
+
+
+def world(data, name="x"):
+    return [float(value) for value in np.asarray(data[name])]
+
+
+def values(data, name):
+    return [int(value) for value in np.asarray(data[name])]
+
+
+def keys(partitions):
+    return [part.key for part in partitions]
+
+
+def extent(bounds):
+    return [float(value) for value in bounds.mins] + [
+        float(value) for value in bounds.maxs
+    ]
+
+
+def test_assembly_module_exposes_the_public_names():
+    import laspy.assembly
+
+    assert laspy.assembly.merge_datasets is laspy.merge_datasets
+    assert laspy.assembly.partition is laspy.partition
+    assert laspy.assembly.crop is laspy.crop
+    assert laspy.assembly.thin is laspy.thin
+    assert laspy.assembly.split_by is laspy.split_by
+    assert laspy.assembly.summarize is laspy.summarize
+    assert laspy.assembly.Partition is laspy.Partition
+    assert laspy.assembly.DatasetSummary is laspy.DatasetSummary
+
+
+def test_merge_single_dataset_keeps_points():
+    data = build([0.0, 1.0], [0.0, 1.0], [2.0, 3.0])
+    merged = laspy.merge_datasets([data])
+    assert stored(merged) == [0, 100]
+    assert stored(merged, "Z") == [0, 100]
+
+
+def test_merge_keeps_input_order():
+    first = build([0.0], [0.0], intensity=[11])
+    second = build([1.0], [1.0], intensity=[22])
+    merged = laspy.merge_datasets([second, first])
+    assert values(merged, "intensity") == [22, 11]
+
+
+def test_merge_point_count():
+    merged = laspy.merge_datasets(
+        [build([0.0, 1.0], [0.0, 1.0]), build([2.0], [2.0]), build([3.0], [3.0])]
+    )
+    assert merged.header.point_count == 4
+    assert len(merged.points) == 4
+
+
+def test_merge_empty_sequence_raises():
+    with pytest.raises(laspy.LaspyException):
+        laspy.merge_datasets([])
+
+
+def test_merge_default_scales_are_the_finest():
+    first = build([0.0], [0.0], scales=(0.01, 0.01, 0.01))
+    second = build([1.0], [1.0], scales=(0.001, 0.1, 0.05))
+    merged = laspy.merge_datasets([first, second])
+    assert list(merged.header.scales) == [0.001, 0.01, 0.01]
+
+
+def test_merge_default_offsets_are_the_smallest_coordinates():
+    first = build([5.0, 7.0], [5.0, 7.0], [1.0, 2.0], offsets=(0.0, 0.0, 0.0))
+    second = build([-3.0], [4.0], [9.0], offsets=(100.0, 100.0, 100.0))
+    merged = laspy.merge_datasets([first, second])
+    assert list(merged.header.offsets) == [-3.0, 4.0, 1.0]
+
+
+def test_merge_offsets_ignore_empty_datasets():
+    populated = build([5.0], [5.0], [5.0])
+    empty = build([], [], [], offsets=(-1000.0, -1000.0, -1000.0))
+    merged = laspy.merge_datasets([empty, populated])
+    assert list(merged.header.offsets) == [5.0, 5.0, 5.0]
+
+
+def test_merge_of_only_empty_datasets_keeps_first_offsets():
+    merged = laspy.merge_datasets(
+        [build([], [], [], offsets=(7.0, 8.0, 9.0)), build([], [], [])]
+    )
+    assert list(merged.header.offsets) == [7.0, 8.0, 9.0]
+    assert merged.header.point_count == 0
+
+
+def test_merge_explicit_scales_and_offsets():
+    data = build([10.0], [20.0], [30.0])
+    merged = laspy.merge_datasets([data], scales=(0.5, 0.5, 0.5), offsets=(10.0, 20.0, 30.0))
+    assert stored(merged) == [0]
+    assert list(merged.header.scales) == [0.5, 0.5, 0.5]
+    assert list(merged.header.offsets) == [10.0, 20.0, 30.0]
+
+
+def test_merge_requantizes_to_the_target_scale():
+    first = build([1.25], [0.0], [0.0], scales=(0.25, 0.25, 0.25))
+    second = build([2.0], [0.0], [0.0], scales=(0.05, 0.05, 0.05))
+    merged = laspy.merge_datasets([first, second])
+    assert list(merged.header.scales) == [0.05, 0.05, 0.05]
+    assert stored(merged) == [0, 15]
+
+
+def test_merge_requantization_rounds_half_to_even():
+    first = build([0.0], [0.0], [0.0], scales=(0.02, 0.02, 0.02))
+    second = build([0.05, 0.15], [0.0, 0.0], [0.0, 0.0], scales=(0.05, 0.05, 0.05))
+    merged = laspy.merge_datasets([first, second], scales=(0.1, 0.1, 0.1), offsets=(0.0, 0.0, 0.0))
+    assert stored(merged) == [0, 0, 2]
+
+
+def test_merge_negative_coordinates_round_half_to_even():
+    data = build([-0.05, -0.15], [0.0, 0.0], [0.0, 0.0], scales=(0.05, 0.05, 0.05))
+    merged = laspy.merge_datasets([data], scales=(0.1, 0.1, 0.1), offsets=(0.0, 0.0, 0.0))
+    assert stored(merged) == [0, -2]
+
+
+def test_merge_accepts_the_signed_32_bit_limits():
+    data = build(
+        [-2147483648.0, 2147483647.0],
+        [0.0, 0.0],
+        [0.0, 0.0],
+        scales=(1.0, 1.0, 1.0),
+    )
+    merged = laspy.merge_datasets(
+        [data], scales=(1.0, 1.0, 1.0), offsets=(0.0, 0.0, 0.0)
+    )
+    assert stored(merged) == [-2147483648, 2147483647]
+
+
+def test_merge_overflow_raises():
+    first = build([0.0], [0.0], [0.0], scales=(0.001, 0.001, 0.001))
+    second = build(
+        [3_000_000.0], [0.0], [0.0], scales=(0.001, 0.001, 0.001), offsets=(3_000_000.0, 0.0, 0.0)
+    )
+    with pytest.raises(laspy.LaspyException):
+        laspy.merge_datasets([first, second])
+
+
+def test_merge_negative_overflow_raises():
+    first = build([0.0], [0.0], [0.0], scales=(0.001, 0.001, 0.001))
+    second = build(
+        [-3_000_000.0],
+        [0.0],
+        [0.0],
+        scales=(0.001, 0.001, 0.001),
+        offsets=(-3_000_000.0, 0.0, 0.0),
+    )
+    with pytest.raises(laspy.LaspyException):
+        laspy.merge_datasets([first, second], offsets=(0.0, 0.0, 0.0))
+
+
+def test_merge_explicit_overrides_requantize_every_axis():
+    data = build([-2.5, 3.5], [-1.5, 2.5], [0.5, -0.5])
+    merged = laspy.merge_datasets(
+        [data], scales=(1.0, 1.0, 1.0), offsets=(0.0, 0.0, 0.0)
+    )
+    assert stored(merged) == [-2, 4]
+    assert stored(merged, "Y") == [-2, 2]
+    assert stored(merged, "Z") == [0, 0]
