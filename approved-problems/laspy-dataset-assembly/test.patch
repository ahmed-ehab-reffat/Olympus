+def test_merge_copies_dimensions_by_name():
+    first = build([0.0], [0.0], classification=[7], intensity=[300])
+    second = build([1.0], [1.0], classification=[9], intensity=[400])
+    merged = laspy.merge_datasets([first, second])
+    assert values(merged, "classification") == [7, 9]
+    assert values(merged, "intensity") == [300, 400]
+
+
+def test_merge_keeps_flags():
+    first = build([0.0, 1.0], [0.0, 1.0], synthetic=[True, False])
+    merged = laspy.merge_datasets([first])
+    assert values(merged, "synthetic") == [1, 0]
+
+
+def test_merge_drops_dimensions_absent_from_the_target_format():
+    data = build([0.0], [0.0], point_format=3, gps_time=[123.5])
+    merged = laspy.merge_datasets([data], point_format_id=0)
+    assert "gps_time" not in list(merged.point_format.dimension_names)
+
+
+def test_merge_zero_fills_dimensions_missing_in_a_source():
