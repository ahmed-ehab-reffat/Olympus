diff --git a/amaranth/sim/_instance.py b/amaranth/sim/_instance.py
new file mode 100644
index 0000000..c6063d9
--- /dev/null
+++ b/amaranth/sim/_instance.py
@@ -0,0 +1,327 @@
+from collections.abc import Mapping
+
+from ..hdl._ast import Value, IOValue, Const, Operator, Slice, Concat
+from ..hdl._ir import Instance, DriverConflict
+from ..hdl._xfrm import LHSMaskCollector
+
+
+__all__ = ["InstanceModel", "SubmoduleModel"]
+
+
+class _PortMap(Mapping):
+    def __init__(self, ports):
+        self._ports = dict(ports)
+
+    def __getitem__(self, name):
+        return self._ports[name]
+
+    def __iter__(self):
+        return iter(self._ports)
+
+    def __len__(self):
+        return len(self._ports)
+
+    def __repr__(self):
+        ports = ", ".join(f"{name}={value!r}" for name, value in self._ports.items())
+        return f"({ports})"
+
+
+def _assignable(value, collector, mask):
+    """Feed the parts of ``value`` a model can drive to ``collector``, and return the mask of its
+    bits that are drivable at all.
+
+    A port may be connected to something carrying bits nothing can assign, such as a constant, on
+    its own or inside a concatenation. Those bits belong to no target, so they grant no ownership
+    and writing them conflicts like writing any other foreign bit.
+    """
+    if isinstance(value, (Const, IOValue)):
+        return 0
+    mask &= (1 << len(value)) - 1
+    if isinstance(value, Operator) and value.operator in ("s", "u"):
+        return _assignable(value.operands[0], collector, mask)
+    if isinstance(value, Slice):
+        inner = (mask << value.start) & ((1 << value.stop) - (1 << value.start))
+        return (_assignable(value.value, collector, inner) >> value.start) & mask
+    if isinstance(value, Concat):
+        drivable, offset = 0, 0
+        for part in value.parts:
+            part_mask = (mask >> offset) & ((1 << len(part)) - 1)
+            drivable |= _assignable(part, collector, part_mask) << offset
+            offset += len(part)
+        return drivable
+    collector.visit_value(value, mask)
+    return mask
+
+
+def _driven_masks(values):
+    collector = LHSMaskCollector()
+    for value in values:
+        _assignable(Value.cast(value), collector, ~0)
+    return collector.lhs
+
+
+class _Model:
+    def __init__(self, path, inputs, outputs):
+        self.path = path
+        self.inputs = _PortMap(inputs)
+        self.outputs = _PortMap(outputs)
+        self._driven = _driven_masks(outputs.values())
+
+    def _check_driven(self, expr):
+        value = Value.cast(expr)
+        collector = LHSMaskCollector()
+        if _assignable(value, collector, ~0) != (1 << len(value)) - 1:
+            raise DriverConflict(
+                f"Model of {self.path!r} cannot drive {value!r} because part of it is not "
+                f"connected to anything the model replaces drives")
+        for signal, mask in collector.lhs.items():
+            if mask & ~self._driven.get(signal, 0):
+                raise DriverConflict(
+                    f"Model of {self.path!r} cannot drive {signal!r} because it is not connected "
+                    f"to an output of what the model replaces")
+
+
+class InstanceModel(_Model):
+    """InstanceModel(...)
+
+    Handle of an instance of an external module that is replaced with a simulation model.
+
+    Passed as the second argument to the constructor function of a model added with
+    :meth:`Simulator.add_instance_model <amaranth.sim.Simulator.add_instance_model>`, once per
+    instance the model is attached to.
+
+    Attributes
+    ----------
+    type : :class:`str`
+        Type of the instance.
+    path : :class:`str`
+        Path of the instance within the hierarchy of the simulated design, with the components
+        separated by dots.
+    parameters : :class:`dict`
+        Parameters of the instance, keyed by name without the :py:`p_` prefix.
+    attributes : :class:`dict`
+        Attributes of the instance, keyed by name without the :py:`a_` prefix.
+    inputs : :class:`~collections.abc.Mapping` of :class:`str` to :class:`~amaranth.hdl.Value`
+        Values connected to the input ports of the instance, keyed by name without the :py:`i_`
+        prefix.
+    outputs : :class:`~collections.abc.Mapping` of :class:`str` to :class:`~amaranth.hdl.Value`
+        Values connected to the output ports of the instance, keyed by name without the :py:`o_`
+        prefix.
+    """
+    def __init__(self, fragment, path):
+        inputs, outputs = {}, {}
+        for name, (value, kind) in fragment.ports.items():
+            if isinstance(value, IOValue):
+                continue
+            if kind == "i":
+                inputs[name] = value
+            elif kind == "o":
+                outputs[name] = value
+        super().__init__(path, inputs, outputs)
+        self.type = fragment.type
+        self.parameters = dict(fragment.parameters)
+        self.attributes = dict(fragment.attrs)
+
+    def __repr__(self):
+        return f"<amaranth.sim.InstanceModel {self.type!r} at {self.path!r}>"
+
+
+class SubmoduleModel(_Model):
+    """SubmoduleModel(...)
+
+    Handle of a submodule that is replaced with a simulation model.
+
+    Passed as the second argument to the constructor function of a model added with
+    :meth:`Simulator.add_submodule_model <amaranth.sim.Simulator.add_submodule_model>`.
+
+    Attributes
+    ----------
+    path : :class:`str`
+        Path of the submodule within the hierarchy of the simulated design, with the components
+        separated by dots.
+    inputs : :class:`~collections.abc.Mapping` of :class:`str` to :class:`~amaranth.hdl.Value`
+        Values of the members of the submodule's signature that flow into it, keyed by the path of
+        the member with the components separated by dots.
+    outputs : :class:`~collections.abc.Mapping` of :class:`str` to :class:`~amaranth.hdl.Value`
+        Values of the members of the submodule's signature that flow out of it, keyed by the path
+        of the member with the components separated by dots.
+    """
+    def __init__(self, component, path):
+        from ..lib.wiring import Out
+        inputs, outputs = {}, {}
+        for member_path, member, value in component.signature.flatten(component):
+            name = ".".join(str(item) for item in member_path)
+            if member.flow is Out:
+                outputs[name] = value
+            else:
+                inputs[name] = value
+        super().__init__(path, inputs, outputs)
+
+    def __repr__(self):
+        return f"<amaranth.sim.SubmoduleModel at {self.path!r}>"
+
+
+def collect_instances(design):
+    """Collect every instance of an external module in ``design``.
+
+    Returns a list of ``(fragment, path)`` pairs, where ``path`` is the dotted name of
+    the instance within the hierarchy of the design.
+    """
+    instances = []
+    for fragment, fragment_info in design.fragments.items():
+        if isinstance(fragment, Instance):
+            instances.append((fragment, ".".join(fragment_info.name)))
+    return instances
+
+
+def collect_components(design):
+    """Collect every submodule of ``design`` that is an interface object with a signature.
+
+    Returns a dict of dotted hierarchy paths to ``(fragment, elaboratable)`` pairs. The top level
+    of the design is not included.
+    """
+    components = {}
+    for elaboratable, fragment in design.elaboratables.items():
+        if not hasattr(elaboratable, "signature"):
+            continue
+        fragment_info = design.fragments.get(fragment)
+        if fragment_info is None or fragment_info.parent is None:
+            continue
+        components[".".join(fragment_info.name)] = (fragment, elaboratable)
+    return components
+
+
+def subtree(fragment):
+    """Return ``fragment`` and every fragment below it in the hierarchy."""
+    fragments = [fragment]
+    for subfragment, _name, _src_loc in fragment.subfragments:
+        fragments.extend(subtree(subfragment))
+    return fragments
+
+
+class ModelBindings:
+    """Records which model constructor is attached to which part of the design.
+
+    A binding by path is more specific than a binding by type and overrides it for the instance it
+    names; two bindings of the same kind that would attach two models to one part of the design
+    conflict, as does a submodule model that would replace an instance that has a model of its own.
+    """
+    def __init__(self, design):
+        self._design = design
+        self._order = {id(fragment): index for index, fragment in enumerate(design.fragments)}
+        self._instances = collect_instances(design)
+        self._components = collect_components(design)
+        self._by_type = {}
+        self._by_path = {}
+        self._submodules = {}
+
+    def live_instances(self):
+        """Return the instances whose logic is still evaluated, as ``(type, path)`` pairs."""
+        replaced = self._replaced_fragments()
+        return [(fragment.type, path) for fragment, path in self._instances
+                if id(fragment) not in replaced]
+
+    def live_submodules(self):
+        """Return the paths of the submodules that can still be replaced, keeping the ones that
+        already have a model but dropping everything they swallowed."""
+        replaced = self._replaced_fragments()
+        roots = {id(self._components[path][0]) for path in self._submodules}
+        return [path for path, (fragment, _elaboratable) in self._components.items()
+                if id(fragment) not in replaced or id(fragment) in roots]
+
+    def snapshot(self):
+        """Return the bindings recorded so far, so that an addition that turns out to conflict can
+        be rolled back and leave no trace."""
+        return (dict(self._by_type), dict(self._by_path), dict(self._submodules))
+
+    def restore(self, snapshot):
+        by_type, by_path, submodules = snapshot
+        self._by_type = by_type
+        self._by_path = by_path
+        self._submodules = submodules
+
+    def _replaced_fragments(self):
+        replaced = set()
+        for path in self._submodules:
+            fragment, _elaboratable = self._components[path]
+            replaced.update(id(item) for item in subtree(fragment))
+        return replaced
+
+    def add_instance_model(self, constructor, *, type, path):
+        if (type is None) == (path is None):
+            raise ValueError("Exactly one of `type` and `path` must be provided")
+        if type is not None:
+            if type in self._by_type:
+                raise DriverConflict(
+                    f"Instances of type {type!r} already have a model attached to them")
+            if not any(fragment.type == type for fragment, _path in self._instances):
+                raise NameError(f"Design does not contain an instance of type {type!r}")
+            self._by_type[type] = constructor
+        else:
+            if path in self._by_path:
+                raise DriverConflict(f"Instance {path!r} already has a model attached to it")
+            if not any(inst_path == path for _fragment, inst_path in self._instances):
+                raise NameError(f"Design does not contain an instance at path {path!r}")
+            self._by_path[path] = constructor
+        self._check_no_replaced_instance_models()
+
+    def add_submodule_model(self, constructor, *, path):
+        if path not in self._components:
+            raise NameError(
+                f"Design does not contain a submodule with a signature at path {path!r}")
+        if path in self._submodules:
+            raise DriverConflict(f"Submodule {path!r} already has a model attached to it")
+        fragment, _elaboratable = self._components[path]
+        replaced = self._replaced_fragments()
+        if id(fragment) in replaced:
+            raise DriverConflict(
+                f"Submodule {path!r} is already replaced by a model of a submodule containing it")
+        for other_path in self._submodules:
+            other_fragment, _other_elaboratable = self._components[other_path]
+            if id(other_fragment) in {id(item) for item in subtree(fragment)}:
+                raise DriverConflict(
+                    f"Submodule {path!r} contains submodule {other_path!r}, which already has "
+                    f"a model attached to it")
+        self._submodules[path] = constructor
+        self._check_no_replaced_instance_models()
+
+    def _check_no_replaced_instance_models(self):
+        replaced = self._replaced_fragments()
+        for fragment, path in self._instances:
+            if id(fragment) not in replaced:
+                continue
+            if path in self._by_path or fragment.type in self._by_type:
+                raise DriverConflict(
+                    f"Instance {path!r} has a model attached to it and is also replaced by "
+                    f"a model of a submodule containing it")
+
+    def resolve(self):
+        """Return the ``(constructor, model)`` pairs that are in effect, with a binding by path
+        overriding a binding by type."""
+        models = []
+        replaced = self._replaced_fragments()
+        for fragment, path in self._instances:
+            if id(fragment) in replaced:
+                continue
+            if path in self._by_path:
+                constructor = self._by_path[path]
+            elif fragment.type in self._by_type:
+                constructor = self._by_type[fragment.type]
+            else:
+                continue
+            models.append((self._order[id(fragment)], constructor, InstanceModel(fragment, path)))
+        for path, constructor in self._submodules.items():
+            fragment, elaboratable = self._components[path]
+            models.append((self._order[id(fragment)], constructor,
+                           SubmoduleModel(elaboratable, path)))
+        models.sort(key=lambda entry: entry[0])
+        return [(constructor, model) for _index, constructor, model in models]
+
+    def suppressed_fragments(self):
+        """Return the fragments whose own logic must not be evaluated because a model replaces
+        them."""
+        suppressed = []
+        for path in self._submodules:
+            fragment, _elaboratable = self._components[path]
+            suppressed.extend(subtree(fragment))
+        return suppressed
