+    def instances(self):
+        """Return the instances of external modules in the simulated design.
+
+        Returns a :class:`list` of :py:`(type, path)` pairs, one per
+        :class:`~amaranth.hdl.Instance` in the design, ordered from the top of the hierarchy down.
+        The paths in it are the ones accepted by the :py:`path` argument of
+        :meth:`add_instance_model`.
+        """
+        return self._engine.live_instances()
+
+    def submodules(self):
+        """Return the submodules of the simulated design that can be replaced with a model.
+
+        Returns a :class:`list` of the paths of the submodules that are interface objects with
+        a signature, ordered from the top of the hierarchy down. The paths in it are the ones
+        accepted by the :py:`path` argument of :meth:`add_submodule_model`.
+        """
+        return self._engine.live_submodules()
+
+    def add_instance_model(self, constructor, *, type=None, path=None):
+        """Add a model of an instance of an external module to the simulation.
+
+        An :class:`~amaranth.hdl.Instance` refers to a module that is external to the design, and
+        the simulator has no way to know what it does; the outputs of an instance that has no model
+        stay at 0. Adding a model gives such an instance behavior, provided by Python code.
+
+        The behavior of the model is defined by its *constructor function*, which is an :py:`async`
+        function taking two arguments, the :class:`SimulatorContext` and
+        the :class:`~amaranth.sim.InstanceModel` handle of the instance it is attached to: ::
+
+            async def model_of_adder(ctx, instance):
+                async for a, b in ctx.changed(instance.inputs["A"], instance.inputs["B"]):
+                    ctx.set(instance.outputs["Y"], a + b)
+
+            sim.add_instance_model(model_of_adder, type="ADDER")
+
+        The instances the model is attached to are selected by exactly one of the :py:`type` and
+        :py:`path` arguments: :py:`type` selects every instance of that type, and :py:`path`
+        selects the single instance at that location in the hierarchy of the design. The
+        constructor function is called once per selected instance, as well as by the :meth:`reset`
+        method.
+
+        A model is evaluated as a part of the :py:`toplevel` elaboratable, like a process, and what
+        it drives becomes visible to the design in the same delta cycle. Unlike a process, a model
+        may call :meth:`~SimulatorContext.get`; unlike a testbench, it may only drive the output
+        ports of the instance it is attached to.
+
+        Models are added as background and do not keep :meth:`run` advancing the simulation.
+
+        Raises
+        ------
+        :exc:`ValueError`
+            If neither or both of :py:`type` and :py:`path` are provided.
+        :exc:`NameError`
+            If the design contains no instance selected by :py:`type` or :py:`path`.
+        :exc:`~amaranth.hdl.DriverConflict`
+            If a model with the same :py:`type` or the same :py:`path` has already been added.
+        :exc:`RuntimeError`
+            If the simulation has been advanced since its creation or last reset.
+        """
+        if self._running:
