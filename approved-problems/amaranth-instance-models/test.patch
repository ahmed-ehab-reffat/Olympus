+            width, var_id, name = match.groups()
+            if name == "y" and int(width) == 8:
+                identifier = var_id
+        self.assertIsNotNone(identifier)
+        values = [int(match.group(1), 2)
+                  for match in re.finditer(rf"^b([01]+)\s+{re.escape(identifier)}$", vcd,
