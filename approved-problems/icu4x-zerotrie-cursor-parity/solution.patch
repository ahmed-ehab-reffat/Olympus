+/// Borrowed state for walking byte-capable trie variants one byte at a time.
+///
+/// Unlike the ASCII-only cursor, a byte cursor can stop in the middle of a
+/// span node. `span` is the unconsumed part of that node and `trie` starts at
+/// the next serialized node.
+#[derive(Debug, Clone)]
+pub(crate) struct ByteTrieCursor<'a> {
+    trie: &'a [u8],
+    span: &'a [u8],
+}
+
+impl<'a> ByteTrieCursor<'a> {
+    #[inline]
+    pub(crate) fn new(trie: &'a [u8]) -> Self {
+        Self { trie, span: &[] }
+    }
+
+    #[inline]
+    fn clear(&mut self) {
+        self.trie = &[];
+        self.span = &[];
+    }
+
+    #[inline]
+    pub(crate) fn is_empty(&self) -> bool {
+        self.trie.is_empty() && self.span.is_empty()
+    }
+}
+
+/// Steps one byte through any of the serialized trie layouts.
+pub(crate) fn step_byte<T: ZeroTrieWithOptions + ?Sized>(
+    cursor: &mut ByteTrieCursor<'_>,
+    byte: u8,
+) -> Option<u8> {
+    if let Some((expected, remaining)) = cursor.span.split_first() {
+        if *expected == byte {
+            cursor.span = remaining;
+            return Some(*expected);
+        }
+        cursor.clear();
+        return None;
+    }
+
+    loop {
+        let Some((head, remainder)) = cursor.trie.split_first() else {
+            cursor.clear();
+            return None;
+        };
+        cursor.trie = remainder;
+        match byte_type(*head) {
+            NodeType::Ascii => {
+                if *head == byte {
+                    return Some(*head);
+                }
+                cursor.clear();
+                return None;
+            }
+            NodeType::Span => {
+                let (len, remainder) = read_varint_meta3(*head, cursor.trie);
+                let (span, trie) = remainder.debug_split_at(len);
+                cursor.span = span;
+                cursor.trie = trie;
+                if cursor.span.is_empty() {
+                    continue;
+                }
+                return step_byte::<T>(cursor, byte);
+            }
+            NodeType::Value => {
+                (_, cursor.trie) = read_varint_meta3(*head, cursor.trie);
+            }
+            NodeType::Branch => {
+                let (raw, remainder) = read_varint_meta2(*head, cursor.trie);
+                cursor.trie = remainder;
+                let (n, mut width) = if raw >= 256 {
+                    (raw & 0xff, raw >> 8)
+                } else {
+                    (raw, 0)
+                };
+                if !matches!(T::OPTIONS.capacity_mode, CapacityMode::Extended) {
+                    debug_assert!(width <= 3, "step_byte: width exceeds normal capacity");
+                    width &= 0x3;
+                }
+                let n = if n == 0 { 256 } else { n };
+
+                let index;
+                if matches!(T::OPTIONS.phf_mode, PhfMode::UsePhf) && n >= 16 {
+                    let (search, trie) = cursor.trie.debug_split_at(n * 2 + 1);
+                    cursor.trie = trie;
+                    let Some(found) = PerfectByteHashMap::from_store(search).get(byte) else {
+                        cursor.clear();
+                        return None;
+                    };
+                    index = found;
+                } else {
+                    let (search, trie) = cursor.trie.debug_split_at(n);
+                    cursor.trie = trie;
+                    let Ok(found) = search.binary_search(&byte) else {
+                        cursor.clear();
+                        return None;
+                    };
+                    index = found;
+                }
+
+                cursor.trie = if width == 0 {
+                    get_branch_w0(cursor.trie, index, n)
+                } else {
+                    get_branch(cursor.trie, index, n, width)
+                };
+                return Some(byte);
+            }
+        }
+    }
+}
+
+/// Steps to a child by its serialized iteration index.
+pub(crate) fn probe_byte<T: ZeroTrieWithOptions + ?Sized>(
+    cursor: &mut ByteTrieCursor<'_>,
+    index: usize,
+) -> Option<ByteProbeResult> {
+    if let Some((byte, remaining)) = cursor.span.split_first() {
+        if index == 0 {
+            cursor.span = remaining;
+            return Some(ByteProbeResult {
+                byte: *byte,
+                total_siblings: 1,
+            });
+        }
+        cursor.clear();
+        return None;
+    }
+
+    loop {
+        let Some((head, remainder)) = cursor.trie.split_first() else {
+            cursor.clear();
+            return None;
+        };
+        cursor.trie = remainder;
+        match byte_type(*head) {
+            NodeType::Ascii => {
+                if index == 0 {
+                    return Some(ByteProbeResult {
+                        byte: *head,
+                        total_siblings: 1,
+                    });
+                }
+                cursor.clear();
+                return None;
+            }
+            NodeType::Span => {
+                let (len, remainder) = read_varint_meta3(*head, cursor.trie);
+                let (span, trie) = remainder.debug_split_at(len);
+                cursor.span = span;
+                cursor.trie = trie;
+                if cursor.span.is_empty() {
+                    continue;
+                }
+                return probe_byte::<T>(cursor, index);
+            }
+            NodeType::Value => {
+                (_, cursor.trie) = read_varint_meta3(*head, cursor.trie);
+            }
+            NodeType::Branch => {
+                let (raw, remainder) = read_varint_meta2(*head, cursor.trie);
+                cursor.trie = remainder;
+                let (n, mut width) = if raw >= 256 {
+                    (raw & 0xff, raw >> 8)
+                } else {
+                    (raw, 0)
+                };
+                if !matches!(T::OPTIONS.capacity_mode, CapacityMode::Extended) {
+                    debug_assert!(width <= 3, "probe_byte: width exceeds normal capacity");
+                    width &= 0x3;
+                }
+                let n = if n == 0 { 256 } else { n };
+                if index >= n {
+                    cursor.clear();
+                    return None;
+                }
+
+                let byte;
+                if matches!(T::OPTIONS.phf_mode, PhfMode::UsePhf) && n >= 16 {
+                    let (search, trie) = cursor.trie.debug_split_at(n * 2 + 1);
+                    cursor.trie = trie;
+                    byte = *search.get(index + n + 1).debug_unwrap_or(&0);
+                } else {
+                    let (search, trie) = cursor.trie.debug_split_at(n);
+                    cursor.trie = trie;
+                    byte = *search.get(index).debug_unwrap_or(&0);
+                }
+
+                cursor.trie = if width == 0 {
+                    get_branch_w0(cursor.trie, index, n)
+                } else {
+                    get_branch(cursor.trie, index, n, width)
+                };
+                return Some(ByteProbeResult {
+                    byte,
+                    total_siblings: n,
+                });
+            }
+        }
+    }
+}
+
+#[inline]
+pub(crate) fn take_value_byte(cursor: &mut ByteTrieCursor<'_>) -> Option<usize> {
+    if cursor.span.is_empty() {
+        take_value(&mut cursor.trie)
+    } else {
+        None
+    }
+}
