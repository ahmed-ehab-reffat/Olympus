+/// Information about an edge probed from a byte-capable trie.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct ByteProbeResult {
+    /// The byte between the probed node and its parent.
+    pub byte: u8,
+    /// The number of siblings of this node, including itself.
+    pub total_siblings: usize,
+}
+
+/// An event emitted while walking the entries below a byte cursor.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+#[non_exhaustive]
+pub enum ByteTrieEvent {
+    /// Descend through one byte edge.
+    Push(u8),
+    /// Visit the value at the current key before visiting its children.
+    Value(usize),
+    /// Return from the most recently pushed byte edge.
+    Pop,
+}
+
+fn probe_simple_ascii(
