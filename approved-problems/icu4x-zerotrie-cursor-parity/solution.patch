+            ZeroTrieCursorFlavor::SimpleAscii(cursor) => cursor.step(byte),
+            ZeroTrieCursorFlavor::PerfectHash(cursor) => cursor.step(byte),
+            ZeroTrieCursorFlavor::ExtendedCapacity(cursor) => cursor.step(byte),
+        }
+    }
+
+    /// Takes the value at the current position, if present.
+    #[inline]
+    pub fn take_value(&mut self) -> Option<usize> {
+        match &mut self.inner {
+            ZeroTrieCursorFlavor::SimpleAscii(cursor) => cursor.take_value(),
+            ZeroTrieCursorFlavor::PerfectHash(cursor) => cursor.take_value(),
+            ZeroTrieCursorFlavor::ExtendedCapacity(cursor) => cursor.take_value(),
+        }
+    }
+
+    /// Steps to a child by its iteration index and returns its byte and sibling
+    /// count.
+    #[inline]
+    pub fn probe(&mut self, index: usize) -> Option<ByteProbeResult> {
+        match &mut self.inner {
+            ZeroTrieCursorFlavor::SimpleAscii(cursor) => {
+                cursor.probe(index).map(|result| ByteProbeResult {
+                    byte: result.byte,
+                    total_siblings: result.total_siblings as usize,
+                })
+            }
+            ZeroTrieCursorFlavor::PerfectHash(cursor) => cursor.probe(index),
+            ZeroTrieCursorFlavor::ExtendedCapacity(cursor) => cursor.probe(index),
+        }
+    }
+
+    /// Checks whether the cursor points to an empty trie.
+    #[inline]
+    pub fn is_empty(&self) -> bool {
+        match &self.inner {
+            ZeroTrieCursorFlavor::SimpleAscii(cursor) => cursor.is_empty(),
+            ZeroTrieCursorFlavor::PerfectHash(cursor) => cursor.is_empty(),
+            ZeroTrieCursorFlavor::ExtendedCapacity(cursor) => cursor.is_empty(),
+        }
+    }
+
+    /// Returns the number of entries remaining below this cursor without allocating.
+    #[inline]
+    pub fn len(&self) -> usize {
