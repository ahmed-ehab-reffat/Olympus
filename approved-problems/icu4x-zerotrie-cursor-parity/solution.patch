+macro_rules! impl_byte_cursor {
+    ($cursor:ident, $trie:ident) => {
+        impl $cursor<'_> {
+            /// Steps the cursor one byte into the trie.
+            ///
+            /// A mismatch leaves the cursor empty.
+            #[inline]
+            pub fn step(&mut self, byte: u8) {
+                reader::step_byte::<$trie<[u8]>>(&mut self.state, byte);
+            }
+
+            /// Takes the value at the current position, if present.
+            ///
+            /// A value can be taken only once, without preventing later steps
+            /// to keys for which the current key is a prefix.
+            #[inline]
+            pub fn take_value(&mut self) -> Option<usize> {
+                reader::take_value_byte(&mut self.state)
+            }
+
+            /// Steps to a child by its iteration index and returns its byte and
+            /// sibling count.
+            ///
+            /// An out-of-range index leaves the cursor empty.
+            #[inline]
+            pub fn probe(&mut self, index: usize) -> Option<ByteProbeResult> {
+                reader::probe_byte::<$trie<[u8]>>(&mut self.state, index)
+            }
+
+            /// Checks whether the cursor points to an empty trie.
+            #[inline]
+            pub fn is_empty(&self) -> bool {
+                self.state.is_empty()
+            }
+
+            /// Returns the number of entries remaining below this cursor.
+            ///
+            /// This operation does not allocate and is also available without
+            /// default features.
+            #[inline]
+            pub fn len(&self) -> usize {
+                byte_trie_len(self, Self::take_value, Self::probe)
+            }
+
+            /// Walks the remaining entries without allocating.
+            ///
+            /// Values are emitted before their children. Each child is enclosed
+            /// by matching [`ByteTrieEvent::Push`] and [`ByteTrieEvent::Pop`]
+            /// events, in the same order as [`Self::probe`].
+            #[inline]
+            pub fn visit<E>(
+                &self,
+                mut visitor: impl FnMut(ByteTrieEvent) -> Result<(), E>,
+            ) -> Result<(), E> {
+                visit_byte_trie(self, Self::take_value, Self::probe, &mut visitor)
+            }
+
+            /// Converts this cursor into a reusable view of the remaining suffix trie.
+            #[inline]
+            pub fn into_suffix_trie(self) -> Self {
+                self
+            }
+
+            /// Gets a fresh cursor rooted at this suffix view.
+            #[inline]
+            pub fn cursor(&self) -> Self {
+                self.clone()
+            }
+
+            /// Looks up a byte suffix without changing this suffix view.
+            #[inline]
+            pub fn get<K>(&self, key: K) -> Option<usize>
+            where
+                K: AsRef<[u8]>,
+            {
+                let mut cursor = self.cursor();
+                for byte in key.as_ref() {
+                    cursor.step(*byte);
+                }
+                cursor.take_value()
+            }
+
+            /// Looks up a text suffix written by a closure without changing this view.
+            #[inline]
+            pub fn get_with_write_fn(
+                &self,
+                write_fn: impl FnOnce(&mut Self) -> fmt::Result,
+            ) -> Option<usize> {
+                let mut cursor = self.cursor();
+                write_fn(&mut cursor).ok()?;
+                cursor.take_value()
+            }
+
+            /// Iterates over the byte suffixes and values remaining below this view.
+            ///
+            /// ✨ *Enabled with the `alloc` Cargo feature.*
+            #[cfg(feature = "alloc")]
+            #[inline]
+            pub fn iter(&self) -> ZeroTrieByteIterator<Self> {
+                ZeroTrieByteIterator::new(self.clone(), Self::take_value, Self::probe)
+            }
+
+            /// Materializes this suffix view into a self-contained owned trie.
+            ///
+            /// ✨ *Enabled with the `alloc` Cargo feature.*
+            #[cfg(feature = "alloc")]
+            #[inline]
+            pub fn to_owned(&self) -> $trie<Vec<u8>> {
+                self.iter().collect()
+            }
+        }
+    };
+}
