+/// An iterator over the byte key/value pairs remaining below a byte cursor.
+///
+/// ✨ *Enabled with the `alloc` Cargo feature.*
+#[cfg(feature = "alloc")]
+#[derive(Debug)]
+pub struct ZeroTrieByteIterator<C> {
+    entries: alloc::vec::IntoIter<(Vec<u8>, usize)>,
+    marker: core::marker::PhantomData<fn() -> C>,
+}
+
+#[cfg(feature = "alloc")]
+impl<C> ZeroTrieByteIterator<C> {
+    fn new(
+        cursor: C,
+        take_value: fn(&mut C) -> Option<usize>,
+        probe: fn(&mut C, usize) -> Option<ByteProbeResult>,
+    ) -> Self
+    where
+        C: Clone,
+    {
+        let mut key = Vec::new();
+        let mut entries = Vec::new();
+        let result: Result<(), core::convert::Infallible> =
+            visit_byte_trie(&cursor, take_value, probe, &mut |event| {
+                match event {
+                    ByteTrieEvent::Push(byte) => key.push(byte),
+                    ByteTrieEvent::Value(value) => entries.push((key.clone(), value)),
+                    ByteTrieEvent::Pop => {
+                        key.pop();
+                    }
+                }
+                Ok(())
+            });
+        match result {
+            Ok(()) => Self {
+                entries: entries.into_iter(),
+                marker: core::marker::PhantomData,
+            },
+            Err(error) => match error {},
+        }
+    }
+}
+
+#[cfg(feature = "alloc")]
+impl<C: Clone> Iterator for ZeroTrieByteIterator<C> {
+    type Item = (Vec<u8>, usize);
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.entries.next()
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.entries.size_hint()
+    }
+}
+
+#[cfg(feature = "alloc")]
