+
+fn visit_byte_trie<C, E>(
+    cursor: &C,
+    take_value: fn(&mut C) -> Option<usize>,
+    probe: fn(&mut C, usize) -> Option<ByteProbeResult>,
+    visitor: &mut impl FnMut(ByteTrieEvent) -> Result<(), E>,
+) -> Result<(), E>
+where
+    C: Clone,
+{
+    let mut node = cursor.clone();
+    if let Some(value) = take_value(&mut node) {
+        visitor(ByteTrieEvent::Value(value))?;
+    }
+
+    let mut index = 0;
+    loop {
+        let mut child = node.clone();
+        let Some(result) = probe(&mut child, index) else {
+            return Ok(());
+        };
+        visitor(ByteTrieEvent::Push(result.byte))?;
+        visit_byte_trie(&child, take_value, probe, visitor)?;
+        visitor(ByteTrieEvent::Pop)?;
+        index += 1;
+        if index >= result.total_siblings {
+            return Ok(());
+        }
+    }
+}
+
+fn byte_trie_len<C>(
+    cursor: &C,
+    take_value: fn(&mut C) -> Option<usize>,
+    probe: fn(&mut C, usize) -> Option<ByteProbeResult>,
+) -> usize
+where
+    C: Clone,
+{
+    let mut count = 0;
+    let result: Result<(), core::convert::Infallible> =
+        visit_byte_trie(cursor, take_value, probe, &mut |event| {
+            if matches!(event, ByteTrieEvent::Value(_)) {
+                count += 1;
+            }
+            Ok(())
+        });
+    match result {
+        Ok(()) => count,
+        Err(error) => match error {},
+    }
+}
