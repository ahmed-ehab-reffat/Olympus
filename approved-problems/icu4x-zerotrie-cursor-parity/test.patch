+#!/usr/bin/env bash
+#
+#   ./test.sh [--output_path <path>] <base|new>
+#
+# `base` runs only the repository's pre-existing zerotrie tests. `new` runs
+# the cursor-parity checks added by the task.
+
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="${2-}"
+            shift 2
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#*=}"
+            shift
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+if [ -z "$MODE" ]; then
+    echo "usage: $0 [--output_path <path>] <base|new>" >&2
+    exit 2
+fi
+
+cd "$(dirname "$0")" || exit 2
+
+case "$MODE" in
+    base)
+        TARGET=(
+            --lib
+            --test asciitrie_test
+            --test builder_test
+            --test dense_test
+            --test derive_test
+            --test ignorecase_test
+            --test locale_aux_test
+        )
+        ;;
+    new)
+        TARGET=(--test cursor_contract_8b72d6)
+        ;;
+esac
+
+TARGET_ROOT="${CARGO_TARGET_DIR:-target}"
+find "$TARGET_ROOT/nextest" -name junit.xml -type f -delete 2>/dev/null
+DIAGNOSTIC_FILE="$(mktemp "${TMPDIR:-/tmp}/zerotrie-nextest.XXXXXX")" || exit 2
+trap 'rm -f -- "$DIAGNOSTIC_FILE"' EXIT
+
+CARGO_TERM_COLOR=never NO_COLOR=1 cargo nextest run \
+    --offline \
+    --locked \
+    --target-dir "$TARGET_ROOT" \
+    --profile default \
+    --no-fail-fast \
+    -p zerotrie \
+    --all-features \
+    "${TARGET[@]}" \
+    2>&1 | tee "$DIAGNOSTIC_FILE"
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    JUNIT_SRC="$(find "$TARGET_ROOT/nextest" -name junit.xml -type f 2>/dev/null | head -1)"
+    if [ -n "$JUNIT_SRC" ] && [ -f "$JUNIT_SRC" ]; then
+        cp "$JUNIT_SRC" "$OUTPUT_PATH"
+    else
+        REPORT_STATUS="$STATUS"
+        if [ "$STATUS" -eq 0 ]; then
+            STATUS=1
+        fi
+        {
+            printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
+            printf '%s\n' '<testsuites name="nextest" tests="1" failures="1" errors="0" time="0">'
+            printf '%s\n' '  <testsuite name="nextest" tests="1" failures="1" errors="0" time="0">'
+            printf '%s\n' '    <testcase classname="harness" name="harness-startup" time="0">'
+            printf '      <failure message="nextest exited without producing JUnit">mode=%s; exit_status=%s\ndiagnostic:\n' "$MODE" "$REPORT_STATUS"
+            LC_ALL=C tr -d '\000-\010\013\014\016-\037' < "$DIAGNOSTIC_FILE" \
+                | sed -e 's/\&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+            printf '%s\n' '</failure>'
+            printf '%s\n' '    </testcase>'
+            printf '%s\n' '  </testsuite>'
+            printf '%s\n' '</testsuites>'
+        } > "$OUTPUT_PATH"
+    fi
+fi
+
+exit "$STATUS"
