+use std::collections::BTreeMap;
+use zerotrie::{ZeroTrieExtendedCapacity, ZeroTriePerfectHash};
+
+fn normalized<K: AsRef<[u8]>>(
+    iter: impl IntoIterator<Item = (K, usize)>,
+) -> Vec<(Vec<u8>, usize)> {
+    iter.into_iter()
+        .map(|(key, value)| (key.as_ref().to_vec(), value))
+        .collect()
+}
+
+fn entries() -> BTreeMap<Vec<u8>, usize> {
+    let values = [
+        0,
+        15,
+        16,
+        2_063,
+        2_064,
+        264_207,
+        264_208,
+        usize::MAX,
+    ];
+    let mut entries = BTreeMap::from([(Vec::new(), usize::MAX)]);
+    for byte in 0u8..20 {
+        entries.insert(vec![0x80 + byte], values[usize::from(byte) % values.len()]);
+    }
+    entries
+}
+
+macro_rules! check_cursor_values {
+    ($trie:expr, $expected:expr, $constructor:path) => {{
+        let trie = $trie;
+        let expected = $expected;
+
+        let mut root = trie.cursor();
+        assert_eq!(root.take_value(), Some(usize::MAX));
+        assert_eq!(root.take_value(), None);
+
+        for (key, value) in expected.iter().filter(|(key, _)| !key.is_empty()) {
+            let mut stepped = trie.cursor();
+            stepped.step(key[0]);
+            assert_eq!(stepped.take_value(), Some(*value));
+        }
+
+        let expected_children = expected
+            .iter()
+            .filter(|(key, _)| !key.is_empty())
+            .cloned()
+            .collect::<Vec<_>>();
+        let mut probed = Vec::new();
+        for index in 0usize.. {
+            let mut child = trie.cursor();
+            let Some(result) = child.probe(index) else {
+                break;
+            };
+            probed.push((vec![result.byte], child.take_value().unwrap()));
+        }
+        assert_eq!(probed, expected_children);
+
+        let suffix = trie.cursor().into_suffix_trie();
+        assert_eq!(suffix.get(b""), Some(usize::MAX));
+        assert_eq!(normalized(suffix.iter()), expected);
+        let owned = suffix.to_owned();
+        assert_eq!(owned.get(b""), Some(usize::MAX));
+        assert_eq!(normalized($constructor(owned.as_bytes()).iter()), expected);
+        assert_eq!(
+            normalized($constructor(owned.clone().into_store()).iter()),
+            expected
+        );
+    }};
+}
+
+fn main() {
+    let entries = entries();
+
+    let perfect: ZeroTriePerfectHash<Vec<u8>> = entries.clone().into_iter().collect();
+    let perfect_expected = normalized(perfect.iter());
+    check_cursor_values!(
+        perfect.clone(),
+        perfect_expected.clone(),
+        ZeroTriePerfectHash::from_store
+    );
+    check_cursor_values!(
+        perfect.into_zerotrie(),
+        perfect_expected,
+        ZeroTriePerfectHash::from_store
+    );
+
+    let extended: ZeroTrieExtendedCapacity<Vec<u8>> = entries.into_iter().collect();
+    let extended_expected = normalized(extended.iter());
+    check_cursor_values!(
+        extended.clone(),
+        extended_expected.clone(),
+        ZeroTrieExtendedCapacity::from_store
+    );
+    check_cursor_values!(
+        extended.into_zerotrie(),
+        extended_expected,
+        ZeroTrieExtendedCapacity::from_store
+    );
+}
