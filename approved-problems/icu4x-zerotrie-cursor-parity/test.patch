@@ -0,0 +1,85 @@
+// Public parity check across all runtime-dispatched storage flavors.
+use zerotrie::{ZeroTrieExtendedCapacity, ZeroTriePerfectHash, ZeroTrieSimpleAscii};
+
+const EXTENDED_W4: &[u8] = &[0xe7, 0x62, b'a', b'b', 0, 0, 0, 0, 1, 0x81, 0x82];
+
+macro_rules! assert_absorbing_failures {
+    ($trie:expr, $valid:expr, $missing:expr, $out_of_range:expr) => {{
+        let mut failed_step = $trie.cursor();
+        failed_step.step($missing);
+        assert!(failed_step.is_empty());
+        failed_step.step($valid);
+        assert!(failed_step.is_empty());
+        assert!(failed_step.probe(0).is_none());
+        assert_eq!(failed_step.take_value(), None);
+
+        let mut failed_probe = $trie.cursor();
+        assert!(failed_probe.probe($out_of_range).is_none());
+        assert!(failed_probe.is_empty());
+        failed_probe.step($valid);
+        assert!(failed_probe.is_empty());
+        assert!(failed_probe.probe(0).is_none());
+        assert_eq!(failed_probe.take_value(), None);
+    }};
+}
+
+fn main() {
+    let simple = ZeroTrieSimpleAscii::from_store(&b"abc\x81"[..]).into_zerotrie();
+    assert_absorbing_failures!(simple, b'a', b'z', 1);
+    let mut simple_cursor = simple.cursor().clone();
+    for byte in b"abc" {
+        simple_cursor.step(*byte);
+    }
+    assert_eq!(simple_cursor.take_value(), Some(1));
+    let mut simple_runtime_probe = simple.cursor();
+    let result = simple_runtime_probe.probe(0).unwrap();
+    assert_eq!((result.byte, result.total_siblings), (b'a', 1));
+    let mut simple_moved = simple.into_cursor();
+    for byte in b"abc" {
+        simple_moved.step(*byte);
+    }
+    assert_eq!(simple_moved.take_value(), Some(1));
+
+    let mut simple_probe = ZeroTrieSimpleAscii::from_bytes(b"abc\x81").cursor();
+    let result = simple_probe.probe(0).unwrap();
+    assert_eq!(result.total_siblings, 1);
+
+    let perfect_owned: ZeroTriePerfectHash<Vec<u8>> = vec![
+        ("élan".as_bytes().to_vec(), 41),
+        ("étude".as_bytes().to_vec(), 42),
+    ]
+    .into_iter()
+    .collect();
+    let perfect = ZeroTriePerfectHash::from_store(perfect_owned.as_bytes()).into_zerotrie();
+    assert_absorbing_failures!(perfect, 0xc3, b'x', 1);
+    let mut perfect_cursor = perfect.cursor().clone();
+    for byte in "étude".bytes() {
+        perfect_cursor.step(byte);
+    }
+    assert_eq!(perfect_cursor.take_value(), Some(42));
+    let mut perfect_runtime_probe = perfect.cursor();
+    for byte in "é".bytes() {
+        perfect_runtime_probe.step(byte);
+    }
+    let result = perfect_runtime_probe.probe(0).unwrap();
+    assert_eq!(result.byte, b'l');
+    assert_eq!(result.total_siblings, 2);
+    let mut moved = perfect.into_cursor();
+    for byte in "élan".bytes() {
+        moved.step(byte);
+    }
+    assert_eq!(moved.take_value(), Some(41));
+
+    let extended = ZeroTrieExtendedCapacity::from_store(EXTENDED_W4).into_zerotrie();
+    assert_absorbing_failures!(extended, b'a', b'c', 2);
+    let mut extended_step = extended.cursor().clone();
+    extended_step.step(b'a');
+    assert_eq!(extended_step.take_value(), Some(1));
+    let mut extended_cursor = extended.cursor();
+    let probe = extended_cursor.probe(1).unwrap();
+    assert_eq!(probe.byte, b'b');
+    assert_eq!(extended_cursor.take_value(), Some(2));
+    let mut extended_moved = extended.into_cursor();
+    extended_moved.step(b'b');
+    assert_eq!(extended_moved.take_value(), Some(2));
+}
diff --git a/utils/zerotrie/tests/cursor_contract_cases_c4a91f/span_prefix_62fa10.rs b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/span_prefix_62fa10.rs
