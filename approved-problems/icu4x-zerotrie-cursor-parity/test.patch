@@ -0,0 +1,65 @@
+// Public state-lifecycle check across spans, values, clones, and failures.
+use zerotrie::ZeroTriePerfectHash;
+
+fn main() {
+    let entries = vec![
+        (Vec::new(), 7),
+        (vec![0x80, 0x90, 0x00, 0xfe], 13),
+        (vec![0x80, 0x90, 0x00, 0xff], 11),
+        (vec![0x80, 0x90, 0x00, 0xff, b'a'], 12),
+    ];
+    let trie: ZeroTriePerfectHash<Vec<u8>> = entries.clone().into_iter().collect();
+    for (key, value) in &entries {
+        assert_eq!(trie.get(key), Some(*value));
+    }
+
+    let mut span_probe = trie.cursor();
+    assert_eq!(span_probe.take_value(), Some(7));
+    for expected in [0x80, 0x90, 0x00] {
+        let result = span_probe.probe(0).expect("the span has one next byte");
+        assert_eq!((result.byte, result.total_siblings), (expected, 1));
+        assert!(!span_probe.is_empty());
+    }
+
+    let literal = ZeroTriePerfectHash::from_bytes(b"a\x81");
+    let mut literal_probe = literal.cursor();
+    let result = literal_probe.probe(0).expect("literal byte is probeable");
+    assert_eq!((result.byte, result.total_siblings), (b'a', 1));
+    assert_eq!(literal_probe.take_value(), Some(1));
+
+    let mut root = trie.cursor();
+    assert_eq!(root.take_value(), Some(7));
+    assert_eq!(root.take_value(), None);
+    root.step(0x80);
+    root.step(0x90);
+
+    let mut left = root.clone();
+    left.step(0x00);
+    left.step(0xfe);
+    assert_eq!(left.take_value(), Some(13));
+
+    let mut right = root;
+    right.step(0x00);
+    right.step(0xff);
+    assert_eq!(right.take_value(), Some(11));
+    assert_eq!(right.take_value(), None);
+    right.step(b'a');
+    assert_eq!(right.take_value(), Some(12));
+
+    let mut mismatch = trie.cursor();
+    mismatch.step(0x80);
+    mismatch.step(0x90);
+    mismatch.step(0x01);
+    assert!(mismatch.is_empty());
+    mismatch.step(0x00);
+    assert!(mismatch.is_empty());
+    assert_eq!(mismatch.take_value(), None);
+    assert_eq!(mismatch.probe(0), None);
+
+    let borrowed = ZeroTriePerfectHash::from_store(trie.as_bytes());
+    let mut moved = borrowed.into_cursor();
+    for byte in [0x80, 0x90, 0x00, 0xff, b'a'] {
+        moved.step(byte);
+    }
+    assert_eq!(moved.take_value(), Some(12));
+}
diff --git a/utils/zerotrie/tests/cursor_contract_cases_c4a91f/suffix_traversal_4da71c.rs b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/suffix_traversal_4da71c.rs
