--- /dev/null
+++ b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/phf_probe_19ce84.rs
@@ -0,0 +1,35 @@
+// Public iteration-order and sibling-count check for indexed probing.
+use zerotrie::ZeroTriePerfectHash;
+
+fn main() {
+    let trie: ZeroTriePerfectHash<Vec<u8>> = (u8::MIN..=u8::MAX)
+        .map(|byte| (vec![byte], usize::from(byte) + 1000))
+        .collect();
+    let runtime = ZeroTriePerfectHash::from_store(trie.as_bytes()).into_zerotrie();
+    let expected = trie.iter().collect::<Vec<_>>();
+    assert_eq!(expected.len(), 256);
+
+    let root = trie.cursor();
+    let mut recovered = Vec::new();
+    for index in 0..256 {
+        let mut child = root.clone();
+        let result = child.probe(index).expect("every byte is a root edge");
+        assert_eq!(result.total_siblings, 256);
+        let value = child.take_value().expect("one-byte key has a value");
+        assert_eq!(trie.get([result.byte]), Some(value));
+        let mut erased = runtime.cursor();
+        let erased_result = erased.probe(index).expect("runtime root edge");
+        assert_eq!(erased_result.byte, result.byte);
+        assert_eq!(erased_result.total_siblings, 256);
+        assert_eq!(erased.take_value(), Some(value));
+        recovered.push((vec![result.byte], value));
+    }
+    assert_eq!(recovered, expected);
+
+    let mut out_of_range = root;
+    assert_eq!(out_of_range.probe(256), None);
+    assert!(out_of_range.is_empty());
+    assert_eq!(out_of_range.probe(0), None);
+    out_of_range.step(0);
+    assert!(out_of_range.is_empty());
+}
