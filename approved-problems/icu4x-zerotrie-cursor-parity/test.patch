+// Public formatting and closure-driven lookup check.
+use core::fmt::{self, Write};
+use zerotrie::{ZeroTrieExtendedCapacity, ZeroTriePerfectHash};
+
+fn main() {
+    let perfect: ZeroTriePerfectHash<Vec<u8>> = vec![
+        ("élan".as_bytes().to_vec(), 17),
+        ("étude".as_bytes().to_vec(), 23),
+    ]
+    .into_iter()
+    .collect();
+
+    assert_eq!(
+        perfect.get_with_write_fn(|sink| {
+            sink.write_str("é")?;
+            sink.write_char('l')?;
+            sink.write_str("an")
+        }),
+        Some(17)
+    );
+    assert_eq!(
+        perfect.get_with_write_fn(|sink| {
+            sink.write_str("étude")?;
+            Err(fmt::Error)
+        }),
+        None
+    );
+
+    let mut perfect_cursor = perfect.cursor();
+    write!(&mut perfect_cursor, "{}{}", "é", "tude").unwrap();
+    assert_eq!(perfect_cursor.take_value(), Some(23));
+    let mut perfect_char_cursor = perfect.cursor();
+    perfect_char_cursor.write_char('é').unwrap();
+    perfect_char_cursor.write_str("lan").unwrap();
+    assert_eq!(perfect_char_cursor.take_value(), Some(17));
+
+    let extended = ZeroTrieExtendedCapacity::from_store(perfect.as_bytes().to_vec());
+    assert_eq!(
+        extended.get_with_write_fn(|sink| {
+            sink.write_str("é")?;
+            sink.write_str("lan")
+        }),
+        Some(17)
+    );
+    assert_eq!(
+        extended.get_with_write_fn(|sink| {
+            sink.write_str("élan")?;
+            Err(fmt::Error)
+        }),
+        None
+    );
+    let mut extended_char_cursor = extended.cursor();
+    extended_char_cursor.write_char('é').unwrap();
+    extended_char_cursor.write_str("tude").unwrap();
+    assert_eq!(extended_char_cursor.take_value(), Some(23));
+
+    let runtime = ZeroTriePerfectHash::from_store(perfect.as_bytes()).into_zerotrie();
+    assert_eq!(
+        runtime.get_with_write_fn(|sink| {
+            sink.write_str("é")?;
+            sink.write_str("tude")
+        }),
+        Some(23)
+    );
+    assert_eq!(runtime.get_with_write_fn(|_| Err(fmt::Error)), None);
+    let mut runtime_char_cursor = runtime.cursor();
+    runtime_char_cursor.write_char('é').unwrap();
+    runtime_char_cursor.write_str("lan").unwrap();
+    assert_eq!(runtime_char_cursor.take_value(), Some(17));
+
+    let runtime_simple = zerotrie::ZeroTrieSimpleAscii::from_store(&b"abc\x81"[..]).into_zerotrie();
+    assert_eq!(
+        runtime_simple.get_with_write_fn(|sink| sink.write_str("abc")),
+        Some(1)
+    );
+    let runtime_extended = ZeroTrieExtendedCapacity::from_store(perfect.as_bytes()).into_zerotrie();
+    assert_eq!(
+        runtime_extended.get_with_write_fn(|sink| sink.write_str("étude")),
+        Some(23)
+    );
+    let mut runtime_extended_char_cursor = runtime_extended.cursor();
+    runtime_extended_char_cursor.write_char('é').unwrap();
+    runtime_extended_char_cursor.write_str("lan").unwrap();
+    assert_eq!(runtime_extended_char_cursor.take_value(), Some(17));
+}

