@@ -0,0 +1,38 @@
+use zerotrie::ZeroTriePerfectHash;
+
+// Two valid two-child branches with one-byte subtries. The first has W=0;
+// the second stores the same offset using the largest normal width, W=3.
+const NORMAL_W0: &[u8] = &[0xc2, b'a', b'b', 1, 0x81, 0x82];
+const NORMAL_W3: &[u8] = &[0xe5, 0x62, b'a', b'b', 0, 0, 0, 1, 0x81, 0x82];
+
+fn main() {
+    for bytes in [NORMAL_W0, NORMAL_W3] {
+        let trie = ZeroTriePerfectHash::from_bytes(bytes);
+        assert_eq!(trie.get(b"a"), Some(1));
+        assert_eq!(trie.get(b"b"), Some(2));
+
+        for (byte, value) in [(b'a', 1), (b'b', 2)] {
+            let mut concrete = trie.cursor();
+            concrete.step(byte);
+            assert_eq!(concrete.take_value(), Some(value));
+
+            let runtime = ZeroTriePerfectHash::from_store(bytes).into_zerotrie();
+            let mut erased = runtime.cursor();
+            erased.step(byte);
+            assert_eq!(erased.take_value(), Some(value));
+        }
+
+        for (index, byte, value) in [(0, b'a', 1), (1, b'b', 2)] {
+            let mut concrete = trie.cursor();
+            let result = concrete.probe(index).expect("concrete offset child");
+            assert_eq!((result.byte, result.total_siblings), (byte, 2));
+            assert_eq!(concrete.take_value(), Some(value));
+
+            let runtime = ZeroTriePerfectHash::from_store(bytes).into_zerotrie();
+            let mut erased = runtime.cursor();
+            let result = erased.probe(index).expect("runtime offset child");
+            assert_eq!((result.byte, result.total_siblings), (byte, 2));
+            assert_eq!(erased.take_value(), Some(value));
+        }
+    }
+}
diff --git a/utils/zerotrie/tests/cursor_contract_cases_c4a91f/phf_probe_19ce84.rs b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/phf_probe_19ce84.rs
