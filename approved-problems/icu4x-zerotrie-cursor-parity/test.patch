@@ -0,0 +1,36 @@
+// Public traversal check for an extended-width offset table.
+use zerotrie::ZeroTrieExtendedCapacity;
+
+// A two-way branch whose offset table uses five bytes (W = 4). The first
+// subtree is one byte long, followed by the second subtree.
+const EXTENDED_W4: &[u8] = &[0xe7, 0x62, b'a', b'b', 0, 0, 0, 0, 1, 0x81, 0x82];
+
+fn main() {
+    let trie = ZeroTrieExtendedCapacity::from_bytes(EXTENDED_W4);
+    assert_eq!(trie.get(b"a"), Some(1));
+    assert_eq!(trie.get(b"b"), Some(2));
+
+    let mut cloned = trie.cursor().clone();
+    cloned.step(b'a');
+    assert_eq!(cloned.take_value(), Some(1));
+
+    for (byte, value) in [(b'a', 1), (b'b', 2)] {
+        let mut cursor = trie.cursor();
+        cursor.step(byte);
+        assert_eq!(cursor.take_value(), Some(value));
+    }
+
+    let mut first = trie.cursor();
+    let result = first.probe(0).unwrap();
+    assert_eq!((result.byte, result.total_siblings), (b'a', 2));
+    assert_eq!(first.take_value(), Some(1));
+
+    let mut second = trie.cursor();
+    let result = second.probe(1).unwrap();
+    assert_eq!((result.byte, result.total_siblings), (b'b', 2));
+    assert_eq!(second.take_value(), Some(2));
+
+    let mut moved = ZeroTrieExtendedCapacity::from_store(EXTENDED_W4).into_cursor();
+    moved.step(b'b');
+    assert_eq!(moved.take_value(), Some(2));
+}
