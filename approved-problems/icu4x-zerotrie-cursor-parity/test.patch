+// Exercise cursor behavior through standalone public consumers so return types
+// and implementation details remain inferred.
+
+use std::env;
+use std::ffi::OsString;
+use std::fs;
+use std::path::PathBuf;
+use std::process::{Command, Output};
+
+fn render_output(output: &Output) -> String {
+    format!(
+        "status: {}\nstdout:\n{}\nstderr:\n{}",
+        output.status,
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    )
+}
+
+fn run_case(case: &str) {
+    let manifest_dir = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let source = manifest_dir
+        .join("tests/cursor_contract_cases_c4a91f")
+        .join(case);
+    let stem = case.strip_suffix(".rs").unwrap_or(case);
+    let project = env::temp_dir().join(format!(
+        "zerotrie-cursor-all-features-{}-{stem}",
+        std::process::id()
+    ));
+    let _ = fs::remove_dir_all(&project);
+    let source_dir = project.join("src");
+    fs::create_dir_all(&source_dir).expect("create all-features public client directory");
+    fs::copy(&source, source_dir.join("main.rs")).expect("copy public client source");
+
+    let escaped_manifest_dir = manifest_dir
+        .to_string_lossy()
+        .replace('\\', "\\\\")
+        .replace('"', "\\\"");
+    fs::write(
+        project.join("Cargo.toml"),
+        format!(
+            "[package]\nname = \"zerotrie_cursor_{stem}\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\nzerotrie = {{ path = \"{escaped_manifest_dir}\", features = [\"alloc\", \"litemap\"] }}\n\n[workspace]\n"
+        ),
+    )
+    .expect("write all-features public client manifest");
+
+    let cargo: OsString = env::var_os("CARGO").unwrap_or_else(|| OsString::from("cargo"));
+    let output = Command::new(cargo)
+        .arg("run")
+        .arg("--offline")
+        .arg("--quiet")
+        .arg("--manifest-path")
+        .arg(project.join("Cargo.toml"))
+        .arg("--target-dir")
+        .arg(project.join("target"))
+        .output()
+        .expect("run all-features public API client");
+    let _ = fs::remove_dir_all(&project);
+    assert!(
+        output.status.success(),
+        "public cursor case {case} failed against the composed source:\n{}",
+        render_output(&output)
+    );
+}
+
+fn run_no_default_feature_case() {
+    let manifest_dir = PathBuf::from(env!("CARGO_MANIFEST_DIR"));
+    let escaped_manifest_dir = manifest_dir
+        .to_string_lossy()
+        .replace('\\', "\\\\")
+        .replace('"', "\\\"");
+    let project =
+        env::temp_dir().join(format!("zerotrie-cursor-no-default-{}", std::process::id()));
+    let source_dir = project.join("src");
+    fs::create_dir_all(&source_dir).expect("create no-default-feature client directory");
+    fs::write(
+        project.join("Cargo.toml"),
+        format!(
+            "[package]\nname = \"zerotrie_cursor_no_default\"\nversion = \"0.0.0\"\nedition = \"2021\"\n\n[dependencies]\nzerotrie = {{ path = \"{escaped_manifest_dir}\", default-features = false }}\n\n[workspace]\n"
+        ),
+    )
+    .expect("write no-default-feature client manifest");
+    fs::write(
+        source_dir.join("main.rs"),
+        r#"
+use core::alloc::{GlobalAlloc, Layout};
+use core::fmt::Write;
+use core::sync::atomic::{AtomicUsize, Ordering};
+use std::alloc::System;
+use zerotrie::cursor::ByteTrieEvent;
+use zerotrie::{
+    ZeroAsciiIgnoreCaseTrie, ZeroTrie, ZeroTrieExtendedCapacity, ZeroTriePerfectHash,
+    ZeroTrieSimpleAscii,
+};
+
+struct CountingAllocator;
+
+static ALLOCATIONS: AtomicUsize = AtomicUsize::new(0);
+
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        ALLOCATIONS.fetch_add(1, Ordering::SeqCst);
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        ALLOCATIONS.fetch_add(1, Ordering::SeqCst);
+        unsafe { System.alloc_zeroed(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(ptr, layout) }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        ALLOCATIONS.fetch_add(1, Ordering::SeqCst);
+        unsafe { System.realloc(ptr, layout, new_size) }
+    }
+}
+
+#[global_allocator]
+static GLOBAL: CountingAllocator = CountingAllocator;
+
+macro_rules! check_suffix_walk {
+    ($suffix:expr) => {{
+        assert_eq!($suffix.len(), 1);
+        let mut pushes = 0;
+        let mut values = 0;
+        let mut pops = 0;
+        let result: Result<(), ()> = $suffix.visit(|event| {
+            match event {
+                ByteTrieEvent::Push(_) => pushes += 1,
+                ByteTrieEvent::Value(1) => values += 1,
+                ByteTrieEvent::Value(value) => panic!("unexpected value {value}"),
+                ByteTrieEvent::Pop => pops += 1,
+                _ => panic!("unknown traversal event"),
+            }
+            Ok(())
+        });
+        result.unwrap();
+        assert_eq!((pushes, values, pops), (2, 1, 2));
+    }};
+}
+
+fn exercise_runtime(runtime: ZeroTrie<&[u8]>) {
+    let mut runtime_cursor = runtime.cursor().clone();
+    assert!(!runtime_cursor.is_empty());
+    let mut runtime_probe = runtime.cursor();
+    let runtime_result = runtime_probe.probe(0).unwrap();
+    assert_eq!((runtime_result.byte, runtime_result.total_siblings), (b'a', 1));
+    runtime_cursor.write_str("abc").unwrap();
+    assert_eq!(runtime_cursor.take_value(), Some(1));
+    assert_eq!(
+        runtime.get_with_write_fn(|sink| sink.write_str("abc")),
+        Some(1)
+    );
+    let mut runtime_moved = runtime.into_cursor();
+    runtime_moved.step(b'a');
+    assert!(!runtime_moved.is_empty());
+    let runtime_suffix = runtime_moved.into_suffix_trie();
+    assert!(!runtime_suffix.is_empty());
+    let runtime_suffix_clone = runtime_suffix.clone();
+    assert!(!runtime_suffix_clone.is_empty());
+    assert_eq!(runtime_suffix_clone.get(b"bc"), Some(1));
+    assert_eq!(runtime_suffix.get(b"bc"), Some(1));
+    assert_eq!(
+        runtime_suffix.get_with_write_fn(|sink| sink.write_str("bc")),
+        Some(1)
+    );
+    check_suffix_walk!(runtime_suffix);
+    let mut runtime_suffix_cursor = runtime_suffix.cursor();
+    runtime_suffix_cursor.step(b'b');
+    assert!(!runtime_suffix_cursor.is_empty());
+}
+
+fn main() {
+    let legacy_simple = ZeroTrieSimpleAscii::from_bytes(b"abc\x81");
+    let legacy_ignore = ZeroAsciiIgnoreCaseTrie::from_bytes(b"aBc\x81");
+    let perfect = ZeroTriePerfectHash::from_bytes(b"abc\x81");
+    let perfect_moved = ZeroTriePerfectHash::from_store(&b"abc\x81"[..]);
+    let extended = ZeroTrieExtendedCapacity::from_bytes(b"abc\x81");
+    let extended_moved = ZeroTrieExtendedCapacity::from_store(&b"abc\x81"[..]);
+    let runtime_ascii = ZeroTrieSimpleAscii::from_store(&b"abc\x81"[..]).into_zerotrie();
+    let runtime_perfect =
+        ZeroTriePerfectHash::from_store(&b"abc\x81"[..]).into_zerotrie();
+    let runtime_extended =
+        ZeroTrieExtendedCapacity::from_store(&b"abc\x81"[..]).into_zerotrie();
+    ALLOCATIONS.store(0, Ordering::SeqCst);
+
+    let mut legacy_simple_cursor = legacy_simple.cursor();
+    legacy_simple_cursor.step(b'a');
+    let legacy_simple_suffix = legacy_simple_cursor.into_suffix_trie();
+    assert_eq!(legacy_simple_suffix.get(b"bc"), Some(1));
+    check_suffix_walk!(legacy_simple_suffix);
+
+    let mut legacy_ignore_cursor = legacy_ignore.cursor();
+    assert_eq!(legacy_ignore_cursor.step(b'A'), Some(b'a'));
+    let legacy_ignore_suffix = legacy_ignore_cursor.into_suffix_trie();
+    assert_eq!(legacy_ignore_suffix.get(b"BC"), Some(1));
+    check_suffix_walk!(legacy_ignore_suffix);
+
+    let mut perfect_cursor = perfect.cursor().clone();
+    assert!(!perfect_cursor.is_empty());
+    let mut perfect_probe = perfect.cursor();
+    let perfect_result = perfect_probe.probe(0).unwrap();
+    assert_eq!((perfect_result.byte, perfect_result.total_siblings), (b'a', 1));
+    perfect_cursor.write_str("abc").unwrap();
+    assert_eq!(perfect_cursor.take_value(), Some(1));
+    assert_eq!(
+        perfect.get_with_write_fn(|sink| sink.write_str("abc")),
+        Some(1)
+    );
+    let mut perfect_moved = perfect_moved.into_cursor();
+    perfect_moved.step(b'a');
+    assert!(!perfect_moved.is_empty());
+    let perfect_suffix = perfect_moved.into_suffix_trie();
+    assert!(!perfect_suffix.is_empty());
+    let perfect_suffix_clone = perfect_suffix.clone();
+    assert!(!perfect_suffix_clone.is_empty());
+    assert_eq!(perfect_suffix_clone.get(b"bc"), Some(1));
+    assert_eq!(perfect_suffix.get(b"bc"), Some(1));
+    assert_eq!(
+        perfect_suffix.get_with_write_fn(|sink| sink.write_str("bc")),
+        Some(1)
+    );
+    check_suffix_walk!(perfect_suffix);
+    let mut perfect_suffix_cursor = perfect_suffix.cursor();
+    perfect_suffix_cursor.step(b'b');
+    assert!(!perfect_suffix_cursor.is_empty());
+
+    let mut extended_cursor = extended.cursor().clone();
+    assert!(!extended_cursor.is_empty());
+    let mut extended_probe = extended.cursor();
+    let extended_result = extended_probe.probe(0).unwrap();
+    assert_eq!((extended_result.byte, extended_result.total_siblings), (b'a', 1));
+    for byte in b"abc" {
+        extended_cursor.step(*byte);
+    }
+    assert_eq!(extended_cursor.take_value(), Some(1));
+    assert_eq!(
+        extended.get_with_write_fn(|sink| sink.write_str("abc")),
+        Some(1)
+    );
+    let mut extended_moved = extended_moved.into_cursor();
+    extended_moved.step(b'a');
+    assert!(!extended_moved.is_empty());
+    let extended_suffix = extended_moved.into_suffix_trie();
+    assert!(!extended_suffix.is_empty());
+    let extended_suffix_clone = extended_suffix.clone();
+    assert!(!extended_suffix_clone.is_empty());
+    assert_eq!(extended_suffix_clone.get(b"bc"), Some(1));
+    assert_eq!(extended_suffix.get(b"bc"), Some(1));
+    assert_eq!(
+        extended_suffix.get_with_write_fn(|sink| sink.write_str("bc")),
+        Some(1)
+    );
+    check_suffix_walk!(extended_suffix);
+    let mut extended_suffix_cursor = extended_suffix.cursor();
+    extended_suffix_cursor.step(b'b');
+    assert!(!extended_suffix_cursor.is_empty());
+
+    exercise_runtime(runtime_ascii);
+    exercise_runtime(runtime_perfect);
+    exercise_runtime(runtime_extended);
+
+    assert_eq!(
+        ALLOCATIONS.load(Ordering::SeqCst),
+        0,
+        "cursor and convenience lookup operations allocated"
+    );
+}
+"#,
+    )
+    .expect("write no-default-feature client source");
+
