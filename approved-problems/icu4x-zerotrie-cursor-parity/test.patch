@@ -0,0 +1,63 @@
+// Public traversal check for PHF data stored by the extended-capacity flavor.
+use zerotrie::ZeroTrieExtendedCapacity;
+
+fn main() {
+    let bytes = [
+        0x00, 0x03, 0x07, 0x0b, 0x11, 0x18, 0x20, 0x2a, 0x35, 0x40, 0x4c, 0x59, 0x67, 0x72, 0x7f,
+        0x80, 0x88, 0x91, 0x9b, 0xa6, 0xb0, 0xbb, 0xc5, 0xcf, 0xd8, 0xe0, 0xe7, 0xed, 0xf2, 0xf6,
+        0xfa, 0xfd,
+    ];
+    let trie: ZeroTrieExtendedCapacity<Vec<u8>> = bytes
+        .iter()
+        .enumerate()
+        .map(|(index, byte)| (vec![*byte], index + 400))
+        .collect();
+    let expected = trie.iter().collect::<Vec<_>>();
+    assert_eq!(expected.len(), 32);
+
+    let runtime = ZeroTrieExtendedCapacity::from_store(trie.as_bytes()).into_zerotrie();
+    let concrete_root = trie.cursor();
+    let runtime_root = runtime.cursor();
+
+    let mut failed_step = concrete_root.clone();
+    failed_step.step(0x01);
+    assert!(failed_step.is_empty());
+    failed_step.step(bytes[0]);
+    assert!(failed_step.is_empty());
+    assert!(failed_step.probe(0).is_none());
+    assert_eq!(failed_step.take_value(), None);
+
+    let mut failed_probe = concrete_root.clone();
+    assert!(failed_probe.probe(expected.len()).is_none());
+    assert!(failed_probe.is_empty());
+    failed_probe.step(bytes[0]);
+    assert!(failed_probe.is_empty());
+    assert!(failed_probe.probe(0).is_none());
+    assert_eq!(failed_probe.take_value(), None);
+
+    for (key, value) in &expected {
+        assert_eq!(trie.get(key), Some(*value));
+
+        let mut concrete = concrete_root.clone();
+        concrete.step(key[0]);
+        assert_eq!(concrete.take_value(), Some(*value));
+
+        let mut erased = runtime_root.clone();
+        erased.step(key[0]);
+        assert_eq!(erased.take_value(), Some(*value));
+    }
+
+    for (index, (key, value)) in expected.iter().enumerate() {
+        let mut concrete = concrete_root.clone();
+        let concrete_result = concrete.probe(index).expect("concrete child");
+        assert_eq!(concrete_result.byte, key[0]);
+        assert_eq!(concrete_result.total_siblings, 32);
+        assert_eq!(concrete.take_value(), Some(*value));
+
+        let mut erased = runtime_root.clone();
+        let runtime_result = erased.probe(index).expect("runtime child");
+        assert_eq!(runtime_result.byte, key[0]);
+        assert_eq!(runtime_result.total_siblings, 32);
+        assert_eq!(erased.take_value(), Some(*value));
+    }
+}
diff --git a/utils/zerotrie/tests/cursor_contract_cases_c4a91f/long_span_91b7e4.rs b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/long_span_91b7e4.rs
