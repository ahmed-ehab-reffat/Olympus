+++ b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/ascii_visit_alloc_9e4b20.rs
@@ -0,0 +1,215 @@
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::collections::BTreeMap;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use zerotrie::cursor::ByteTrieEvent;
+use zerotrie::{
+    ZeroAsciiIgnoreCaseTrie, ZeroTrieExtendedCapacity, ZeroTriePerfectHash,
+    ZeroTrieSimpleAscii,
+};
+
+struct CountingAllocator;
+
+static COUNTING: AtomicBool = AtomicBool::new(false);
+static ALLOCATIONS: AtomicUsize = AtomicUsize::new(0);
+
+unsafe impl GlobalAlloc for CountingAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        if COUNTING.load(Ordering::SeqCst) {
+            ALLOCATIONS.fetch_add(1, Ordering::SeqCst);
+        }
+        // SAFETY: Forwarded unchanged to the system allocator.
+        unsafe { System.alloc(layout) }
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        // SAFETY: Forwarded unchanged to the system allocator.
+        unsafe { System.dealloc(ptr, layout) }
+    }
+}
+
+#[global_allocator]
+static GLOBAL: CountingAllocator = CountingAllocator;
+
+fn normalize<K: AsRef<[u8]>>(iter: impl Iterator<Item = (K, usize)>) -> Vec<(Vec<u8>, usize)> {
+    iter.map(|(key, value)| (key.as_ref().to_vec(), value))
+        .collect()
+}
+
+fn below_prefix(entries: &[(Vec<u8>, usize)], prefix: &[u8]) -> Vec<(Vec<u8>, usize)> {
+    entries
+        .iter()
+        .filter_map(|(key, value)| {
+            key.strip_prefix(prefix)
+                .map(|key| (key.to_vec(), *value))
+        })
+        .collect()
+}
+
+fn collect_events<E>(
+    visit: impl FnOnce(&mut dyn FnMut(ByteTrieEvent) -> Result<(), E>) -> Result<(), E>,
+) -> Result<Vec<(Vec<u8>, usize)>, E> {
+    let mut key = Vec::new();
+    let mut entries = Vec::new();
+    visit(&mut |event| {
+        match event {
+            ByteTrieEvent::Push(byte) => key.push(byte),
+            ByteTrieEvent::Value(value) => entries.push((key.clone(), value)),
+            ByteTrieEvent::Pop => {
+                key.pop();
+            }
+            _ => unreachable!("unknown traversal event"),
+        }
+        Ok(())
+    })?;
+    Ok(entries)
+}
+
+macro_rules! assert_view {
+    ($view:expr, $expected:expr) => {{
+        let view = $view;
+        let expected = $expected;
+        assert_eq!(view.len(), expected.len());
+        assert_eq!(
+            collect_events::<core::convert::Infallible>(|visitor| view.visit(visitor)).unwrap(),
+            expected
+        );
+
+        if !expected.is_empty() {
+            let mut calls = 0;
+            assert_eq!(
+                view.visit(|_| {
+                    calls += 1;
+                    if calls == 3 { Err(73u8) } else { Ok(()) }
+                }),
+                Err(73)
+            );
+            assert_eq!(calls, 3, "visitor called again after returning Err");
+            assert_eq!(view.len(), expected.len());
+        }
+    }};
+}
+
+macro_rules! exercise_without_allocating {
+    ($total:ident, $view:expr) => {{
+        $total = $total.wrapping_add($view.len());
+        $total = $total.wrapping_add(usize::from($view.get(&[][..]).is_some()));
+        $total = $total.wrapping_add(usize::from(!$view.cursor().is_empty()));
+        let mut events = 0usize;
+        let result: Result<(), ()> = $view.visit(|_| {
+            events += 1;
+            Ok(())
+        });
+        $total = $total.wrapping_add(events + usize::from(result.is_ok()));
+    }};
+}
+
+fn main() {
+    let simple: ZeroTrieSimpleAscii<Vec<u8>> = [
+        ("", 10),
+        ("a", 11),
+        ("ab", 12),
+        ("ac", 13),
+        ("b", 14),
+    ]
+    .into_iter()
+    .collect();
+    let simple_expected = normalize(simple.iter());
+    assert_view!(simple.cursor().into_suffix_trie(), simple_expected.clone());
+
+    let mut simple_partial = simple.cursor();
+    simple_partial.step(b'a');
+    assert_view!(
+        simple_partial.into_suffix_trie(),
+        below_prefix(&simple_expected, b"a")
+    );
+
+    let mut simple_taken = simple.cursor();
+    assert_eq!(simple_taken.take_value(), Some(10));
+    assert_view!(
+        simple_taken.into_suffix_trie(),
+        simple_expected
+            .iter()
+            .filter(|(key, _)| !key.is_empty())
+            .cloned()
+            .collect::<Vec<_>>()
+    );
+
+    let mut simple_failed = simple.cursor();
+    simple_failed.step(0xff);
+    assert_view!(simple_failed.into_suffix_trie(), Vec::new());
+
+    let ignore: ZeroAsciiIgnoreCaseTrie<Vec<u8>> = [
+        ("", 20),
+        ("aB", 21),
+        ("ac", 22),
+        ("D", 23),
+    ]
+    .into_iter()
+    .collect();
+    let ignore_expected = normalize(ignore.iter());
+    assert_view!(ignore.cursor().into_suffix_trie(), ignore_expected.clone());
+
+    let mut ignore_partial = ignore.cursor();
+    assert_eq!(ignore_partial.step(b'A'), Some(b'a'));
+    assert_view!(
+        ignore_partial.into_suffix_trie(),
+        below_prefix(&ignore_expected, b"a")
+    );
+
+    let mut ignore_taken = ignore.cursor();
+    assert_eq!(ignore_taken.take_value(), Some(20));
+    assert_view!(
+        ignore_taken.into_suffix_trie(),
+        ignore_expected
+            .iter()
+            .filter(|(key, _)| !key.is_empty())
+            .cloned()
+            .collect::<Vec<_>>()
+    );
+
+    let mut ignore_failed = ignore.cursor();
+    assert_eq!(ignore_failed.step(0xff), None);
+    assert_view!(ignore_failed.into_suffix_trie(), Vec::new());
+
+    let binary_entries = BTreeMap::from([
+        (Vec::new(), 30),
+        (b"a".to_vec(), 31),
+        (b"ab".to_vec(), 32),
+        (vec![0x80, 0xff], 33),
+    ]);
+    let perfect = ZeroTriePerfectHash::try_from(&binary_entries).unwrap();
+    let extended = ZeroTrieExtendedCapacity::try_from(&binary_entries).unwrap();
+    let runtime_simple = ZeroTrieSimpleAscii::from_store(simple.as_bytes()).into_zerotrie();
+    let runtime_perfect =
+        ZeroTriePerfectHash::from_store(perfect.as_bytes()).into_zerotrie();
+    let runtime_extended =
+        ZeroTrieExtendedCapacity::from_store(extended.as_bytes()).into_zerotrie();
+
+    let simple_view = simple.cursor().into_suffix_trie();
+    let ignore_view = ignore.cursor().into_suffix_trie();
+    let perfect_view = perfect.cursor().into_suffix_trie();
+    let extended_view = extended.cursor().into_suffix_trie();
+    let runtime_simple_view = runtime_simple.cursor().into_suffix_trie();
+    let runtime_perfect_view = runtime_perfect.cursor().into_suffix_trie();
+    let runtime_extended_view = runtime_extended.cursor().into_suffix_trie();
+
+    ALLOCATIONS.store(0, Ordering::SeqCst);
+    COUNTING.store(true, Ordering::SeqCst);
+    let mut observed = 0usize;
+    exercise_without_allocating!(observed, simple_view);
+    exercise_without_allocating!(observed, ignore_view);
+    exercise_without_allocating!(observed, perfect_view);
+    exercise_without_allocating!(observed, extended_view);
+    exercise_without_allocating!(observed, runtime_simple_view);
+    exercise_without_allocating!(observed, runtime_perfect_view);
+    exercise_without_allocating!(observed, runtime_extended_view);
+    COUNTING.store(false, Ordering::SeqCst);
+
+    assert!(observed > 0);
+    assert_eq!(
+        ALLOCATIONS.load(Ordering::SeqCst),
+        0,
+        "core cursor/suffix operations allocated with all features enabled"
+    );
+}
