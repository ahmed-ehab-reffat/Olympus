+++ b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/suffix_traversal_4da71c.rs
@@ -0,0 +1,160 @@
+use std::collections::BTreeMap;
+use std::iter::FusedIterator;
+
+use zerotrie::cursor::ByteTrieEvent;
+use zerotrie::{ZeroTrieExtendedCapacity, ZeroTriePerfectHash, ZeroTrieSimpleAscii};
+
+fn entries() -> BTreeMap<Vec<u8>, usize> {
+    let mut entries = BTreeMap::new();
+    entries.insert(Vec::new(), usize::MAX);
+    for byte in 0u8..20 {
+        entries.insert(vec![0, 1, 2, byte], 2_064 + byte as usize);
+        entries.insert(vec![byte, 0xff, 0x80, byte], 264_208 + byte as usize);
+    }
+    entries
+}
+
+fn normalize<K: AsRef<[u8]>>(iter: impl Iterator<Item = (K, usize)>) -> Vec<(Vec<u8>, usize)> {
+    iter.map(|(key, value)| (key.as_ref().to_vec(), value))
+        .collect()
+}
+
+fn collect_events<E>(
+    visit: impl FnOnce(&mut dyn FnMut(ByteTrieEvent) -> Result<(), E>) -> Result<(), E>,
+) -> Result<Vec<(Vec<u8>, usize)>, E> {
+    let mut key = Vec::new();
+    let mut entries = Vec::new();
+    visit(&mut |event| {
+        match event {
+            ByteTrieEvent::Push(byte) => key.push(byte),
+            ByteTrieEvent::Value(value) => entries.push((key.clone(), value)),
+            ByteTrieEvent::Pop => {
+                key.pop();
+            }
+            _ => unreachable!("unknown traversal event"),
+        }
+        Ok(())
+    })?;
+    Ok(entries)
+}
+
+fn assert_iterator<I, K>(mut iter: I, expected: &[(Vec<u8>, usize)])
+where
+    I: DoubleEndedIterator<Item = (K, usize)> + ExactSizeIterator + FusedIterator,
+    K: AsRef<[u8]>,
+{
+    assert_eq!(iter.len(), expected.len());
+    assert_eq!(iter.size_hint(), (expected.len(), Some(expected.len())));
+    let first = iter.next().map(|(key, value)| (key.as_ref().to_vec(), value));
+    assert_eq!(first, expected.first().cloned());
+    assert_eq!(iter.len(), expected.len().saturating_sub(1));
+    let last = iter
+        .next_back()
+        .map(|(key, value)| (key.as_ref().to_vec(), value));
+    assert_eq!(last, expected.last().cloned().filter(|_| expected.len() > 1));
+    let middle_expected = if expected.len() > 1 {
+        &expected[1..expected.len() - 1]
+    } else {
+        &[]
+    };
+    assert_eq!(normalize(iter.by_ref()), middle_expected);
+    assert_eq!(iter.len(), 0);
+    assert!(iter.next().is_none());
+    assert!(iter.next_back().is_none());
+}
+
+macro_rules! exercise_binary {
+    ($trie:expr, $expected:expr) => {{
+        let trie = $trie;
+        let expected = $expected;
+        let view = trie.cursor().into_suffix_trie();
+        assert_eq!(view.len(), expected.len());
+        assert_eq!(
+            collect_events::<core::convert::Infallible>(|visitor| view.visit(visitor)).unwrap(),
+            expected
+        );
+        assert_iterator(view.iter(), &expected);
+
+        let mut taken = view.cursor();
+        assert_eq!(taken.take_value(), Some(usize::MAX));
+        let taken = taken.into_suffix_trie();
+        assert_eq!(taken.len(), expected.len() - 1);
+        assert_eq!(
+            collect_events::<core::convert::Infallible>(|visitor| taken.visit(visitor)).unwrap(),
+            expected[1..]
+        );
+
+        let mut partial = trie.cursor();
+        partial.step(0);
+        partial.step(1);
+        let partial = partial.into_suffix_trie();
+        let expected_partial: Vec<_> = expected
+            .iter()
+            .filter_map(|(key, value)| {
+                key.strip_prefix(&[0, 1])
+                    .map(|key| (key.to_vec(), *value))
+            })
+            .collect();
+        assert_eq!(partial.len(), expected_partial.len());
+        assert_eq!(
+            collect_events::<core::convert::Infallible>(|visitor| partial.visit(visitor)).unwrap(),
+            expected_partial
+        );
+
+        let mut calls = 0;
+        assert_eq!(
+            partial.visit(|_| {
+                calls += 1;
+                if calls == 5 { Err("stop") } else { Ok(()) }
+            }),
+            Err("stop")
+        );
+        assert_eq!(calls, 5, "visitor called again after returning Err");
+        assert_eq!(partial.len(), expected_partial.len());
+        assert_eq!(normalize(partial.iter()), expected_partial);
+
+        let mut failed = trie.cursor();
+        failed.step(0xfe);
+        let failed = failed.into_suffix_trie();
+        assert_eq!(failed.len(), 0);
+        let mut event_count = 0;
+        let result: Result<(), ()> = failed.visit(|_| {
+            event_count += 1;
+            Ok(())
+        });
+        assert_eq!(result, Ok(()));
+        assert_eq!(event_count, 0);
+        assert_iterator(failed.iter(), &[]);
+    }};
+}
+
+fn main() {
+    let entries = entries();
+    let phf = ZeroTriePerfectHash::try_from(&entries).unwrap();
+    let expected = normalize(phf.iter());
+    exercise_binary!(phf.clone(), expected.clone());
+    exercise_binary!(phf.into_zerotrie(), expected);
+
+    let extended = ZeroTrieExtendedCapacity::try_from(&entries).unwrap();
+    let expected = normalize(extended.iter());
+    exercise_binary!(extended.clone(), expected.clone());
+    exercise_binary!(extended.into_zerotrie(), expected);
+
+    let ascii: ZeroTrieSimpleAscii<Vec<u8>> = [
+        ("", usize::MAX),
+        ("a", 1),
+        ("ab", 2),
+        ("b", 3),
+    ]
+    .into_iter()
+    .collect();
+    let expected = normalize(ascii.iter());
+    let runtime = ascii.into_zerotrie();
+    let view = runtime.cursor().into_suffix_trie();
+    assert_eq!(view.len(), expected.len());
+    assert_eq!(
+        collect_events::<core::convert::Infallible>(|visitor| view.visit(visitor)).unwrap(),
+        expected
+    );
+    assert_iterator(view.iter(), &expected);
+}
diff --git a/utils/zerotrie/tests/cursor_contract_cases_c4a91f/suffix_view_6f2a91.rs b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/suffix_view_6f2a91.rs
