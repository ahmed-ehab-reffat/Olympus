+use core::fmt::Write;
+use std::collections::BTreeMap;
+use zerotrie::{ZeroTrieExtendedCapacity, ZeroTriePerfectHash, ZeroTrieSimpleAscii};
+
+fn normalized_items<K: AsRef<[u8]>>(
+    items: impl IntoIterator<Item = (K, usize)>,
+) -> Vec<(Vec<u8>, usize)> {
+    items
+        .into_iter()
+        .map(|(key, value)| (key.as_ref().to_vec(), value))
+        .collect()
+}
+
+macro_rules! assert_binary_suffix_view {
+    ($cursor:expr, $remaining:expr, $value:expr, $expected:expr) => {{
+        let expected = $expected;
+        let suffix = $cursor.into_suffix_trie();
+        assert!(!suffix.is_empty());
+        assert_eq!(suffix.get($remaining), Some($value));
+        assert_eq!(suffix.get($remaining), Some($value));
+        assert_eq!(normalized_items(suffix.iter()), expected);
+
+        let suffix_clone = suffix.clone();
+        assert_eq!(suffix_clone.get($remaining), Some($value));
+        assert_eq!(normalized_items(suffix_clone.iter()), expected);
+
+        let mut child = suffix.cursor();
+        for byte in $remaining {
+            child.step(*byte);
+        }
+        assert_eq!(child.take_value(), Some($value));
+        assert_eq!(child.take_value(), None);
+
+        let mut miss = suffix.cursor();
+        miss.step(0x7f);
+        assert!(miss.is_empty());
+        assert_eq!(suffix.get($remaining), Some($value));
+    }};
+}
+
+macro_rules! assert_empty_suffix_view {
+    ($cursor:expr, $constructor:path) => {{
+        let suffix = $cursor.into_suffix_trie();
+        assert!(suffix.is_empty());
+        assert_eq!(suffix.get(b""), None);
+        assert_eq!(suffix.get(b"anything"), None);
+        assert!(suffix.cursor().is_empty());
+        assert!(suffix.iter().next().is_none());
+        assert!(suffix.iter().next().is_none());
+
+        let suffix_clone = suffix.clone();
+        assert!(suffix_clone.is_empty());
+        assert_eq!(suffix_clone.get_with_write_fn(|sink| sink.write_str("x")), None);
+        assert!(suffix_clone.cursor().is_empty());
+
+        let owned = suffix.to_owned();
+        assert!(owned.is_empty());
+        assert_eq!(owned.byte_len(), 0);
+        assert!(owned.as_bytes().is_empty());
+        assert!(owned.cursor().is_empty());
+        let store = owned.clone().into_store();
+        let reconstructed = $constructor(store);
+        assert!(reconstructed.is_empty());
+        assert_eq!(reconstructed.get(b""), None);
+        assert!(reconstructed.iter().next().is_none());
+        assert!(owned.is_empty());
+    }};
+}
+
+macro_rules! assert_serialized_binary_owned {
+    ($owned:expr, $constructor:path, $expected:expr) => {{
+        let owned = &$owned;
+        let expected = $expected;
+        assert_eq!(owned.byte_len(), owned.as_bytes().len());
+        let borrowed = $constructor(owned.as_bytes());
+        assert_eq!(normalized_items(borrowed.iter()), expected);
+        let stored = owned.clone().into_store();
+        let reconstructed = $constructor(stored);
+        assert_eq!(normalized_items(reconstructed.iter()), expected);
+    }};
+}
+
+fn remaining_items<K: AsRef<[u8]>>(
+    items: impl Iterator<Item = (K, usize)>,
+    prefix: &[u8],
+) -> Vec<(Vec<u8>, usize)> {
+    items
+        .filter_map(|(key, value)| {
+            key.as_ref()
+                .strip_prefix(prefix)
+                .map(|suffix| (suffix.to_vec(), value))
+        })
+        .collect()
+}
+
+fn long_binary_entries() -> (BTreeMap<Vec<u8>, usize>, Vec<u8>) {
+    let common = vec![0x80; 300];
+    let mut selected = common.clone();
+    selected.extend_from_slice(&[0x00, 0xfe, 0x01]);
+
+    let mut sibling = common.clone();
+    sibling.extend_from_slice(&[0x01, 0xfd, 0x02]);
+
+    let mut entries = BTreeMap::new();
+    entries.insert(common, 41);
+    entries.insert(selected.clone(), 42);
+    entries.insert(sibling, 43);
+    (entries, selected)
+}
+
+fn main() {
+    let empty_perfect = ZeroTriePerfectHash::from_store(&[][..]);
+    assert_empty_suffix_view!(empty_perfect.cursor(), ZeroTriePerfectHash::from_store);
+    let empty_extended = ZeroTrieExtendedCapacity::from_store(&[][..]);
+    assert_empty_suffix_view!(
+        empty_extended.cursor(),
+        ZeroTrieExtendedCapacity::from_store
+    );
+    let empty_runtime_perfect =
+        ZeroTriePerfectHash::from_store(&[][..]).into_zerotrie();
+    assert_empty_suffix_view!(
+        empty_runtime_perfect.cursor(),
+        ZeroTriePerfectHash::from_store
+    );
+    let empty_runtime_extended =
+        ZeroTrieExtendedCapacity::from_store(&[][..]).into_zerotrie();
+    assert_empty_suffix_view!(
+        empty_runtime_extended.cursor(),
+        ZeroTrieExtendedCapacity::from_store
+    );
+    let empty_runtime_ascii = ZeroTrieSimpleAscii::from_store(&[][..]).into_zerotrie();
+    assert_empty_suffix_view!(
+        empty_runtime_ascii.cursor(),
+        ZeroTrieSimpleAscii::from_store
+    );
+
+    let failed_perfect_source = ZeroTriePerfectHash::from_store(&b"abc\x81"[..]);
+    let mut failed_perfect = failed_perfect_source.cursor();
+    failed_perfect.step(b'x');
+    assert!(failed_perfect.is_empty());
+    assert_empty_suffix_view!(failed_perfect, ZeroTriePerfectHash::from_store);
+
+    let failed_extended_source = ZeroTrieExtendedCapacity::from_store(&b"abc\x81"[..]);
+    let mut failed_extended = failed_extended_source.cursor();
+    failed_extended.step(b'x');
+    assert!(failed_extended.is_empty());
+    assert_empty_suffix_view!(failed_extended, ZeroTrieExtendedCapacity::from_store);
+
+    let failed_runtime_perfect_source =
+        ZeroTriePerfectHash::from_store(&b"abc\x81"[..]).into_zerotrie();
+    let mut failed_runtime_perfect = failed_runtime_perfect_source.cursor();
+    failed_runtime_perfect.step(b'x');
+    assert!(failed_runtime_perfect.is_empty());
+    assert_empty_suffix_view!(failed_runtime_perfect, ZeroTriePerfectHash::from_store);
+
+    let failed_runtime_extended_source =
+        ZeroTrieExtendedCapacity::from_store(&b"abc\x81"[..]).into_zerotrie();
+    let mut failed_runtime_extended = failed_runtime_extended_source.cursor();
+    failed_runtime_extended.step(b'x');
+    assert!(failed_runtime_extended.is_empty());
+    assert_empty_suffix_view!(
+        failed_runtime_extended,
+        ZeroTrieExtendedCapacity::from_store
+    );
+
+    let failed_runtime_ascii_source =
+        ZeroTrieSimpleAscii::from_store(&b"abc\x81"[..]).into_zerotrie();
+    let mut failed_runtime_ascii = failed_runtime_ascii_source.cursor();
+    failed_runtime_ascii.step(b'x');
+    assert!(failed_runtime_ascii.is_empty());
+    assert_empty_suffix_view!(failed_runtime_ascii, ZeroTrieSimpleAscii::from_store);
+
+    let (entries, selected) = long_binary_entries();
+    let split = 173;
+    let remaining = &selected[split..];
+
+    let perfect: ZeroTriePerfectHash<Vec<u8>> = entries.clone().into_iter().collect();
+    let mut concrete_perfect = perfect.cursor();
+    for byte in &selected[..split] {
+        concrete_perfect.step(*byte);
+    }
+    let perfect_expected = remaining_items(perfect.iter(), &selected[..split]);
+    assert_binary_suffix_view!(concrete_perfect, remaining, 42, perfect_expected.clone());
+
+    let runtime_perfect_trie = ZeroTriePerfectHash::from_store(perfect.as_bytes()).into_zerotrie();
+    let mut runtime_perfect = runtime_perfect_trie.cursor();
+    for byte in &selected[..split] {
+        runtime_perfect.step(*byte);
+    }
+    assert_binary_suffix_view!(runtime_perfect, remaining, 42, perfect_expected);
+
+    let extended: ZeroTrieExtendedCapacity<Vec<u8>> = entries.into_iter().collect();
+    let mut concrete_extended = extended.cursor();
+    for byte in &selected[..split] {
+        concrete_extended.step(*byte);
+    }
+    let extended_expected = remaining_items(extended.iter(), &selected[..split]);
+    assert_binary_suffix_view!(concrete_extended, remaining, 42, extended_expected.clone());
+
+    let runtime_extended_trie =
+        ZeroTrieExtendedCapacity::from_store(extended.as_bytes()).into_zerotrie();
+    let mut runtime_extended = runtime_extended_trie.cursor();
+    for byte in &selected[..split] {
+        runtime_extended.step(*byte);
+    }
+    assert_binary_suffix_view!(runtime_extended, remaining, 42, extended_expected);
+
+    let text_entries = BTreeMap::from([
+        (b"root".to_vec(), 50),
+        ("root/🚂/end".as_bytes().to_vec(), 51),
+        (b"root/other".to_vec(), 52),
