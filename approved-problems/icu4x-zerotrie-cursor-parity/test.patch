+++ b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/phf_threshold_7ac5f2.rs
@@ -0,0 +1,60 @@
+use zerotrie::ZeroTriePerfectHash;
+
+fn main() {
+    let mut entries = Vec::new();
+    for byte in 0u8..15 {
+        entries.push((vec![b'L', byte], 100 + usize::from(byte)));
+    }
+    for byte in 0u8..16 {
+        entries.push((vec![b'H', byte], 200 + usize::from(byte)));
+    }
+
+    let trie: ZeroTriePerfectHash<Vec<u8>> = entries.clone().into_iter().collect();
+    let runtime = ZeroTriePerfectHash::from_store(trie.as_bytes()).into_zerotrie();
+
+    for (key, value) in &entries {
+        assert_eq!(trie.get(key), Some(*value));
+
+        let mut concrete = trie.cursor();
+        concrete.step(key[0]);
+        concrete.step(key[1]);
+        assert_eq!(concrete.take_value(), Some(*value));
+
+        let mut erased = runtime.cursor();
+        erased.step(key[0]);
+        erased.step(key[1]);
+        assert_eq!(erased.take_value(), Some(*value));
+    }
+
+    for (prefix, sibling_count) in [(b'L', 15), (b'H', 16)] {
+        let expected = trie
+            .iter()
+            .filter(|(key, _)| key[0] == prefix)
+            .collect::<Vec<_>>();
+        assert_eq!(expected.len(), sibling_count);
+
+        for (index, (key, value)) in expected.iter().enumerate() {
+            let mut concrete = trie.cursor();
+            concrete.step(prefix);
+            let result = concrete.probe(index).expect("nested concrete child");
+            assert_eq!(result.byte, key[1]);
+            match prefix {
+                b'L' => assert_eq!(result.total_siblings, 15),
+                b'H' => assert_eq!(result.total_siblings, 16),
+                _ => unreachable!(),
+            }
+            assert_eq!(concrete.take_value(), Some(*value));
+
+            let mut erased = runtime.cursor();
+            erased.step(prefix);
+            let result = erased.probe(index).expect("nested runtime child");
+            assert_eq!(result.byte, key[1]);
+            match prefix {
+                b'L' => assert_eq!(result.total_siblings, 15),
+                b'H' => assert_eq!(result.total_siblings, 16),
+                _ => unreachable!(),
+            }
+            assert_eq!(erased.take_value(), Some(*value));
+        }
+    }
+}
