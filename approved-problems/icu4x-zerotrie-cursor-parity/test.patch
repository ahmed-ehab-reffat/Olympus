@@ -0,0 +1,137 @@
+use zerotrie::{ZeroTrieExtendedCapacity, ZeroTriePerfectHash};
+
+fn main() {
+    let prefix = vec![0x80; 300];
+    let mut left_key = prefix.clone();
+    left_key.push(0xfe);
+    let mut right_key = prefix.clone();
+    right_key.push(0xff);
+
+    let trie: ZeroTriePerfectHash<Vec<u8>> = vec![
+        (prefix.clone(), 70),
+        (left_key.clone(), 71),
+        (right_key.clone(), 72),
+    ]
+    .into_iter()
+    .collect();
+    assert_eq!(trie.get(&prefix), Some(70));
+    assert_eq!(trie.get(&left_key), Some(71));
+    assert_eq!(trie.get(&right_key), Some(72));
+
+    let mut partial = trie.cursor();
+    for byte in &prefix[..173] {
+        partial.step(*byte);
+    }
+    let mut mismatch = partial.clone();
+    mismatch.step(0x81);
+    assert!(mismatch.is_empty());
+    mismatch.step(0x80);
+    assert!(mismatch.is_empty());
+
+    let mut left = partial.clone();
+    for byte in &prefix[173..] {
+        left.step(*byte);
+    }
+    assert_eq!(left.take_value(), Some(70));
+    left.step(0xfe);
+    assert_eq!(left.take_value(), Some(71));
+
+    let mut probed = trie.cursor();
+    for _ in 0..prefix.len() {
+        let result = probed.probe(0).expect("one child while inside the span");
+        assert_eq!((result.byte, result.total_siblings), (0x80, 1));
+    }
+    assert_eq!(probed.take_value(), Some(70));
+    let result = probed.probe(1).expect("second child after the span");
+    assert_eq!(result.byte, 0xff);
+    assert_eq!(result.total_siblings, 2);
+    assert_eq!(probed.take_value(), Some(72));
+
+    let runtime = ZeroTriePerfectHash::from_store(trie.as_bytes()).into_zerotrie();
+    let mut erased = runtime.cursor();
+    for byte in &right_key {
+        erased.step(*byte);
+    }
+    assert_eq!(erased.take_value(), Some(72));
+
+    let extended: ZeroTrieExtendedCapacity<Vec<u8>> = vec![
+        (prefix.clone(), 170),
+        (left_key.clone(), 171),
+        (right_key.clone(), 172),
+    ]
+    .into_iter()
+    .collect();
+    assert_eq!(extended.get(&prefix), Some(170));
+    assert_eq!(extended.get(&left_key), Some(171));
+    assert_eq!(extended.get(&right_key), Some(172));
+
+    let concrete_root = extended.cursor();
+    let mut concrete = concrete_root.clone();
+    for byte in &prefix[..173] {
+        concrete.step(*byte);
+    }
+    assert!(!concrete.is_empty());
+    assert_eq!(concrete.take_value(), None);
+    for _ in &prefix[173..] {
+        let result = concrete.probe(0).expect("one child inside the extended span");
+        assert_eq!((result.byte, result.total_siblings), (0x80, 1));
+    }
+    assert_eq!(concrete.take_value(), Some(170));
+    concrete.step(0xfe);
+    assert_eq!(concrete.take_value(), Some(171));
+
+    let mut concrete_mismatch = concrete_root.clone();
+    for byte in &prefix[..173] {
+        concrete_mismatch.step(*byte);
+    }
+    concrete_mismatch.step(0x81);
+    assert!(concrete_mismatch.is_empty());
+    concrete_mismatch.step(0x80);
+    assert!(concrete_mismatch.probe(0).is_none());
+    assert_eq!(concrete_mismatch.take_value(), None);
+
+    let mut concrete_bad_probe = concrete_root.clone();
+    for byte in &prefix[..173] {
+        concrete_bad_probe.step(*byte);
+    }
+    assert!(concrete_bad_probe.probe(1).is_none());
+    assert!(concrete_bad_probe.is_empty());
+    concrete_bad_probe.step(0x80);
+    assert!(concrete_bad_probe.probe(0).is_none());
+    assert_eq!(concrete_bad_probe.take_value(), None);
+
+    let runtime_extended =
+        ZeroTrieExtendedCapacity::from_store(extended.as_bytes()).into_zerotrie();
+    let runtime_root = runtime_extended.cursor();
+    let mut runtime_success = runtime_root.clone();
+    for byte in &prefix[..173] {
+        runtime_success.step(*byte);
+    }
+    for _ in &prefix[173..] {
+        let result = runtime_success.probe(0).expect("one child inside the erased span");
+        assert_eq!((result.byte, result.total_siblings), (0x80, 1));
+    }
+    assert_eq!(runtime_success.take_value(), Some(170));
+    runtime_success.step(0xff);
+    assert_eq!(runtime_success.take_value(), Some(172));
+
+    let mut runtime_mismatch = runtime_root.clone();
+    for byte in &prefix[..173] {
+        runtime_mismatch.step(*byte);
+    }
+    runtime_mismatch.step(0x81);
+    assert!(runtime_mismatch.is_empty());
+    runtime_mismatch.step(0x80);
+    assert!(runtime_mismatch.probe(0).is_none());
+    assert_eq!(runtime_mismatch.take_value(), None);
+
+    let mut runtime_bad_probe = runtime_root;
+    for byte in &prefix[..173] {
+        runtime_bad_probe.step(*byte);
+    }
+    assert!(runtime_bad_probe.probe(1).is_none());
+    assert!(runtime_bad_probe.is_empty());
+    runtime_bad_probe.step(0x80);
+    assert!(runtime_bad_probe.probe(0).is_none());
+    assert_eq!(runtime_bad_probe.take_value(), None);
+}
