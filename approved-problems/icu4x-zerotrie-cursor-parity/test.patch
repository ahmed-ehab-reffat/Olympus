+// Public byte-step check over a perfect-hash branch.
+use zerotrie::ZeroTriePerfectHash;
+
+fn main() {
+    let bytes = [
+        0x00, 0x03, 0x07, 0x0b, 0x11, 0x18, 0x20, 0x2a, 0x35, 0x40, 0x4c, 0x59, 0x67, 0x72, 0x7f,
+        0x80, 0x88, 0x91, 0x9b, 0xa6, 0xb0, 0xbb, 0xc5, 0xcf, 0xd8, 0xe0, 0xe7, 0xed, 0xf2, 0xf6,
+        0xfa, 0xfd,
+    ];
+    let trie: ZeroTriePerfectHash<Vec<u8>> = bytes
+        .iter()
+        .enumerate()
+        .map(|(index, byte)| (vec![*byte], index + 100))
+        .collect();
+
+    for (index, byte) in bytes.iter().enumerate() {
+        assert_eq!(trie.get([*byte]), Some(index + 100));
+        let mut cursor = trie.cursor();
+        cursor.step(*byte);
+        assert!(!cursor.is_empty());
+        assert_eq!(cursor.take_value(), Some(index + 100));
+        assert_eq!(cursor.take_value(), None);
+    }
+
+    let mut missing = trie.cursor();
+    missing.step(0xff);
+    assert!(missing.is_empty());
+    missing.step(bytes[0]);
+    assert!(missing.is_empty());
+    assert_eq!(missing.take_value(), None);
+    assert_eq!(missing.probe(0), None);
+}
diff --git a/utils/zerotrie/tests/cursor_contract_cases_c4a91f/phf_threshold_7ac5f2.rs b/utils/zerotrie/tests/cursor_contract_cases_c4a91f/phf_threshold_7ac5f2.rs
