+    '''
+
+    # List of all members of this union, flattened.
+    hint_wrappers_flat = flatten_hint_wrappers(hint_wrappers)
+
+    # For each such member, if this member is the "typing.Any" catch-all, then
+    # this entire union reduces to that catch-all. Return that member alone.
+    #
+    # Note that this test *MUST* precede deduplication. Why? Because that
+    # catch-all is both a subhint and a superhint of every other hint and is
+    # thus equal to every other hint, which deduplication would elide.
+    for hint_wrapper in hint_wrappers_flat:
+        if hint_wrapper._hint is Any:
+            return (hint_wrapper,)
+
+    # List of all members of this union, deduplicated in first-appearance order.
+    hint_wrappers_unique: List = []
+
+    for hint_wrapper in hint_wrappers_flat:
+        if hint_wrapper not in hint_wrappers_unique:
+            hint_wrappers_unique.append(hint_wrapper)
+
+    # List of all members of this union, with literal members fused into the
+    # single literal member first appearing in this union.
+    hint_wrappers_fused = fuse_hint_wrappers_literal(hint_wrappers_unique)
+
+    # List of all members of this union, with each literal object accepted by
+    # another member removed from that fused literal member.
+    hint_wrappers_thinned = absorb_hint_args_literal(hint_wrappers_fused)
+
+    # Return these members, with subsumed members absorbed into subsuming
+    # members. Note that fusion *MUST* precede absorption. Why? Because a fused
+    # literal is subsumed by a member subsuming *ALL* of the literals fused into
+    # that literal, which is undecidable before that fusion.
+    return tuple(absorb_hint_wrappers(hint_wrappers_thinned))
+
+
+def flatten_hint_wrappers(hint_wrappers: tuple) -> List:
+    '''
+    List of all **transitive union members** (i.e., type hint wrappers) of the
+    passed tuple of type hint wrappers, in first-appearance order.
+
+    Parameters
+    ----------
+    hint_wrappers : tuple
+        Tuple of one or more type hint wrappers to be flattened.
+
+    Returns
+    -------
+    List
+        List of all transitive members of these wrappers.
+    '''
+
+    # List of all transitive members of these wrappers.
+    hint_wrappers_flat: List = []
+
+    # For each passed wrapper...
+    for hint_wrapper in hint_wrappers:
+        # Tuple of the one or more branches of this wrapper, which is this
+        # wrapper itself unless this wrapper is itself a union.
+        hint_wrapper_branches = tuple(hint_wrapper._branches)
+
+        # If this wrapper is itself a union, inline the transitive members of
+        # this union into this list.
+        if len(hint_wrapper_branches) > 1:
+            hint_wrappers_flat.extend(
+                flatten_hint_wrappers(hint_wrapper_branches))
+        # Else, this wrapper is *NOT* a union.
+        else:
+            hint_wrappers_flat.append(hint_wrapper)
+
+    return hint_wrappers_flat
+
+
+def fuse_hint_wrappers_literal(hint_wrappers: List) -> List:
+    '''
+    List of the passed type hint wrappers, with all :pep:`586`-compliant literal
+    members fused into a single literal member at the position of the first such
+    member.
+
+    Parameters
+    ----------
+    hint_wrappers : List
+        List of one or more type hint wrappers to be fused.
+
+    Returns
+    -------
+    List
+        List of these wrappers, fused.
+    '''
+
+    # Avoid circular import dependencies.
+    from beartype.door._cls.doorsuper import TypeHint
+    from beartype.typing import Literal
+
+    # Tuple of all literal objects subscripting all literal members, in
+    # first-appearance order and deduplicated.
+    hint_args_literal: Tuple = ()
+
+    # Index of the first literal member if any *OR* "None" otherwise.
+    hint_wrapper_literal_index: Optional[int] = None
+
+    # For each passed wrapper...
+    for hint_wrapper_index, hint_wrapper in enumerate(hint_wrappers):
+        # If this wrapper is *NOT* a literal, silently ignore this wrapper.
+        if hint_wrapper._hint_sign is not HintSignLiteral:
+            continue
+        # Else, this wrapper is a literal.
+
+        # Record the position of the first such literal.
+        if hint_wrapper_literal_index is None:
+            hint_wrapper_literal_index = hint_wrapper_index
+
+        # Accumulate the literal objects subscripting this literal.
+        for hint_arg in hint_wrapper._args:
+            if hint_arg not in hint_args_literal:
+                hint_args_literal += (hint_arg,)
+
+    # If fewer than two literal members were fused, preserve this list as is.
+    if hint_wrapper_literal_index is None or len(hint_args_literal) < 2:
+        return hint_wrappers
+    # Else, two or more literal objects were fused into one literal member.
+
+    # Fused literal member.
+    hint_wrapper_fused = TypeHint(Literal[hint_args_literal])  # type: ignore
+
+    # List of these wrappers, with each literal member replaced by either this
+    # fused member (for the first such member) or nothing (for all others).
+    hint_wrappers_fused: List = []
+
+    for hint_wrapper_index, hint_wrapper in enumerate(hint_wrappers):
+        if hint_wrapper_index == hint_wrapper_literal_index:
+            hint_wrappers_fused.append(hint_wrapper_fused)
+        elif hint_wrapper._hint_sign is not HintSignLiteral:
+            hint_wrappers_fused.append(hint_wrapper)
+
+    return hint_wrappers_fused
+
+
+def absorb_hint_args_literal(hint_wrappers: List) -> List:
+    '''
+    List of the passed type hint wrappers, with each literal object accepted by
+    a differing member removed from the single :pep:`586`-compliant literal
+    member of these wrappers if any, which is itself removed if *no* literal
+    object survives.
+
+    Parameters
+    ----------
+    hint_wrappers : List
+        List of one or more type hint wrappers to be thinned.
+
+    Returns
+    -------
+    List
+        List of these wrappers, thinned.
+    '''
+
+    # Avoid circular import dependencies.
+    from beartype.door._cls.doorsuper import TypeHint
+    from beartype.typing import Literal
+
+    # List of these wrappers, thinned.
+    hint_wrappers_thinned: List = []
+
+    # For each passed wrapper...
+    for hint_wrapper_index, hint_wrapper in enumerate(hint_wrappers):
+        # If this wrapper is *NOT* a literal, preserve this wrapper as is.
+        if hint_wrapper._hint_sign is not HintSignLiteral:
+            hint_wrappers_thinned.append(hint_wrapper)
+            continue
+        # Else, this wrapper is a literal.
+
+        # Tuple of the literal objects subscripting this literal that *NO*
+        # differing member accepts.
+        hint_args_kept: Tuple = ()
+
+        # For each such literal object...
+        for hint_arg in hint_wrapper._args:
+            # Literal accepting only this literal object.
+            hint_wrapper_arg = TypeHint(Literal[(hint_arg,)])  # type: ignore
+
+            # True only if a differing member subsumes this literal object.
+            is_hint_arg_absorbed = any(
+                hint_wrapper_arg.is_subhint(hint_wrapper_other)
+                for hint_wrapper_other_index, hint_wrapper_other in enumerate(
+                    hint_wrappers)
+                if hint_wrapper_other_index != hint_wrapper_index
+            )
+
+            if not is_hint_arg_absorbed:
+                hint_args_kept += (hint_arg,)
+
+        # If *NO* literal object survives, remove this literal member entirely.
+        if not hint_args_kept:
+            continue
+        # Else, one or more literal objects survive.
+        #
+        # If *ALL* literal objects survive, preserve this member as is.
+        elif hint_args_kept == hint_wrapper._args:
+            hint_wrappers_thinned.append(hint_wrapper)
+        # Else, only some literal objects survive.
+        else:
+            hint_wrappers_thinned.append(TypeHint(
+                Literal[hint_args_kept]))  # type: ignore
+
+    return hint_wrappers_thinned
+
+
+def is_hint_wrapper_subsumed(hint_wrapper, hint_wrapper_other) -> bool:
+    '''
+    :data:`True` only if the first passed type hint wrapper is subsumed by the
+    second passed type hint wrapper.
+
+    Two annotated hints are compared through their metadata and metahints rather
+    than through the subhint relation, which reports two annotated hints
+    annotated by the same metadata to be subhints of one another even when their
+    metahints are unrelated. Absorbing either into the other would then silently
+    discard the other.
+
+    Parameters
+    ----------
+    hint_wrapper : beartype.door.TypeHint
+        Type hint wrapper to be tested as the subsumed wrapper.
+    hint_wrapper_other : beartype.door.TypeHint
+        Type hint wrapper to be tested as the subsuming wrapper.
+
+    Returns
+    -------
+    bool
+        :data:`True` only if this wrapper is subsumed by that wrapper.
+    '''
+
+    # Avoid circular import dependencies.
+    from beartype.door._cls.pep.doorpep593 import AnnotatedTypeHint
+    from contextlib import suppress
+
+    # If both hints are annotated...
+    if (
+        isinstance(hint_wrapper, AnnotatedTypeHint) and
+        isinstance(hint_wrapper_other, AnnotatedTypeHint)
+    ):
+        # True only if these hints are annotated by equivalent metadata, which
+        # arbitrary caller-defined metadata may refuse to decide.
+        is_metadata_equal = False
+
+        with suppress(Exception):
+            is_metadata_equal = bool(
+                hint_wrapper._metadata == hint_wrapper_other._metadata)
+
+        # Return true only if these hints share metadata and the metahint of
+        # this hint is subsumed by the metahint of that hint.
+        return is_metadata_equal and is_hint_wrapper_subsumed(
+            hint_wrapper._metahint_wrapper,
+            hint_wrapper_other._metahint_wrapper,
+        )
+    # Else, at most one of these hints is annotated.
+
+    return hint_wrapper.is_subhint(hint_wrapper_other)
+
+
+def absorb_hint_wrappers(hint_wrappers: List) -> List:
+    '''
+    List of the passed type hint wrappers, with each wrapper subsumed by a
+    differing surviving wrapper absorbed into that wrapper.
+
+    Of two mutually subsuming wrappers, only the first survives. Ergo, this
+    absorber is guaranteed to return a non-empty list.
+
+    Parameters
+    ----------
+    hint_wrappers : List
+        List of one or more type hint wrappers to be absorbed.
+
+    Returns
+    -------
+    List
+        List of the surviving wrappers, in first-appearance order.
+    '''
+
+    # List of the surviving wrappers.
+    hint_wrappers_absorbed: List = []
+
+    # For each passed wrapper...
+    for hint_wrapper_index, hint_wrapper in enumerate(hint_wrappers):
+        # True only if this wrapper is subsumed by a differing wrapper.
+        is_hint_wrapper_absorbed = False
+
+        # For each differing wrapper...
+        for hint_wrapper_other_index, hint_wrapper_other in enumerate(
+            hint_wrappers):
+            if hint_wrapper_other_index == hint_wrapper_index:
+                continue
+            # Else, this differing wrapper differs from this wrapper.
+
+            # If this wrapper is *NOT* subsumed by this differing wrapper,
+            # this differing wrapper does *NOT* absorb this wrapper.
+            if not is_hint_wrapper_subsumed(hint_wrapper, hint_wrapper_other):
+                continue
+            # Else, this differing wrapper subsumes this wrapper.
+
+            # If these wrappers mutually subsume one another, only the first
+            # such wrapper survives.
+            if (
+                is_hint_wrapper_subsumed(hint_wrapper_other, hint_wrapper) and
+                hint_wrapper_other_index > hint_wrapper_index
+            ):
+                continue
+            # Else, this differing wrapper strictly subsumes this wrapper.
+
+            is_hint_wrapper_absorbed = True
+            break
+
+        if not is_hint_wrapper_absorbed:
+            hint_wrappers_absorbed.append(hint_wrapper)
+
+    return hint_wrappers_absorbed
+
+# ....................{ FACTORIES                          }....................
+def make_hint_wrappers_union(hint_wrappers: tuple):
+    '''
+    Type hint wrapper wrapping the union of the passed non-empty tuple of
+    canonical type hint wrappers, which is simply the single passed wrapper if
+    only one wrapper is passed.
+
+    Parameters
+    ----------
+    hint_wrappers : tuple
+        Tuple of one or more canonical type hint wrappers to be unioned.
+
+    Returns
+    -------
+    beartype.door.TypeHint
+        Type hint wrapper wrapping this union.
+    '''
+
+    # Avoid circular import dependencies.
+    from beartype.door._cls.doorsuper import TypeHint
+
+    # If only one wrapper is passed, this union reduces to that wrapper. Note
+    # that preserving that wrapper as is preserves the identity of the hint
+    # wrapped by that wrapper.
+    if len(hint_wrappers) == 1:
+        return hint_wrappers[0]
+    # Else, two or more wrappers are passed.
+
+    # Low-level union of the hints wrapped by these wrappers.
+    hint_union: Hint = make_hint_pep484604_union(
+        tuple(hint_wrapper._hint for hint_wrapper in hint_wrappers))
+
+    return TypeHint(hint_union)
+
+# ....................{ SUBTRACTORS                        }....................
+def _get_hint_args_literal(hint_wrapper) -> Tuple:
+    '''
+    Tuple of the zero or more literal objects subscripting the passed type hint
+    wrapper if that wrapper is a literal *or* the empty tuple otherwise.
+
+    An annotated wrapper yields the empty tuple even when the metahint it
+    annotates is a literal, as the subhint relation reports no literal to be a
+    subhint of an annotated hint.
+
+    Parameters
+    ----------
+    hint_wrapper : beartype.door.TypeHint
+        Type hint wrapper to be inspected.
+
+    Returns
+    -------
+    Tuple
+        Tuple of the literal objects subscripting this wrapper.
+    '''
+
+    return (
+        hint_wrapper._args
+        if hint_wrapper._hint_sign is HintSignLiteral else
+        ()
+    )
+
+def subtract_hint_wrappers(hint_wrapper, hint_wrapper_other):
+    '''
+    Difference of the passed canonical type hint wrappers (i.e., the widest type
+    hint wrapper accepting every object accepted by the first wrapper that the
+    second wrapper rejects) *or* :data:`None` if the first wrapper is a subhint
+    of the second wrapper.
+
+    Parameters
+    ----------
+    hint_wrapper : beartype.door.TypeHint
+        Canonical type hint wrapper to be subtracted from.
+    hint_wrapper_other : beartype.door.TypeHint
+        Canonical type hint wrapper to be subtracted.
+
+    Returns
+    -------
+    Optional[beartype.door.TypeHint]
+        Either this difference *or* :data:`None`.
+    '''
+
+    # Avoid circular import dependencies.
+    from beartype.typing import Literal
+
+    # Tuple of the surviving members of this difference.
+    hint_wrappers_kept: tuple = ()
+
+    # For each member of the minuend...
+    for hint_wrapper_branch in hint_wrapper._branches:
+        # If this member is a literal, the subtrahend removes only those literal
+        # objects subscripting this literal that the subtrahend accepts.
+        if hint_wrapper_branch._hint_sign is HintSignLiteral:
+            # Meet of this literal and the subtrahend if any *OR* "None".
+            hint_wrapper_meet = hint_wrapper_branch._meet_simplified(
+                hint_wrapper_other)
+
+            # If the subtrahend accepts one or more of these literal objects...
+            if hint_wrapper_meet is not None:
+                # Tuple of the literal objects that meet accepts. Note that
+                # this meet is *NOT* necessarily a literal itself, an annotated
+                # subtrahend yielding an annotated meet from which no literal
+                # object is removed.
+                hint_args_met = _get_hint_args_literal(hint_wrapper_meet)
+
+                # Tuple of the literal objects the subtrahend rejects.
+                hint_args_kept = tuple(
+                    hint_arg
+                    for hint_arg in hint_wrapper_branch._args
+                    if hint_arg not in hint_args_met
+                )
+
+                # If the subtrahend rejects *NO* such object, silently ignore
+                # this member.
+                if not hint_args_kept:
+                    continue
+                # Else, the subtrahend rejects one or more such objects.
+
+                hint_wrapper_branch = type(hint_wrapper_branch)(
+                    Literal[hint_args_kept])  # type: ignore
+            # Else, the subtrahend accepts *NO* such object. In this case,
+            # preserve this literal as is.
+        # Else if this member is subsumed by the subtrahend, the subtrahend
+        # removes this member in its entirety. Silently ignore this member.
+        elif is_hint_wrapper_subsumed(hint_wrapper_branch, hint_wrapper_other):
+            continue
+        # Else, this member survives the subtrahend in its entirety. Note that a
+        # member that is *NOT* a subhint of the subtrahend is preserved whole,
+        # as the removal of a strict subhint of that member is inexpressible as
+        # a type hint.
+
+        hint_wrappers_kept += (hint_wrapper_branch,)
+
+    # If *NO* member survives, this difference is empty.
+    if not hint_wrappers_kept:
+        return None
+    # Else, one or more members survive.
+
+    return make_hint_wrappers_union(
+        reduce_hint_wrappers_union(hint_wrappers_kept))
