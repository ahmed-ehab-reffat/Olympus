+# ....................{ REDUCERS                           }....................
+def reduce_hint_wrappers_union(hint_wrappers: tuple) -> tuple:
+    '''
+    Tuple of the one or more **canonical union members** (i.e., type hint
+    wrappers) reduced from the passed tuple of one or more type hint wrappers
+    conceptually unioned together.
+
+    This reducer flattens nested unions, deduplicates equal members, fuses
+    literal members, and absorbs members subsumed by other members -- in that
+    order, as absorption is only decidable after fusion.
+
+    Parameters
+    ----------
+    hint_wrappers : tuple
+        Tuple of one or more type hint wrappers to be reduced.
+
+    Returns
