@@ -0,0 +1,278 @@
+#!/usr/bin/env python3
+# --------------------( LICENSE                            )--------------------
+# Copyright (c) 2014-2026 Beartype authors.
+# See "LICENSE" for further details.
+
+'''
+Beartype **Decidedly Object-Oriented Runtime-checking (DOOR) coverage classes**
+(i.e., high-level objects describing how exhaustively an ordered sequence of type
+hints covers another type hint).
+'''
+
+# ....................{ IMPORTS                            }....................
+from beartype.door._cls.doorsuper import TypeHint
+from beartype.roar import BeartypeDoorException
+from beartype._data.typing.datatypingport import Hint
+from beartype.typing import (
+    Iterable,
+    Optional,
+    Tuple,
+)
+
+# ....................{ CLASSES                            }....................
+class HintCoverage(object):
+    '''
+    **Type hint coverage** (i.e., high-level object describing how exhaustively
+    an ordered sequence of type hints covers another type hint).
+
+    Each hint of that sequence is matched against only the **residual** (i.e.,
+    the portion of that other hint left uncovered by all preceding hints of that
+    sequence), exactly as an ordered sequence of dispatch cases would be.
+
+    Attributes
+    ----------
+    _hint_residual : Optional[Hint]
+        Portion of the covered hint left uncovered by *all* hints of this
+        sequence if any *or* :data:`None` otherwise.
+    _hints_matched : Tuple[Optional[Hint], ...]
+        Tuple of the portion of the covered hint newly covered by each hint of
+        this sequence, where each such portion is :data:`None` if the
+        corresponding hint of this sequence is unreachable.
+    _hints_overlapping : Tuple[Tuple[int, int], ...]
+        Tuple of the index pairs of all pairs of hints of this sequence that are
+        *not* disjoint, in ascending order.
+    _hints_removable : Tuple[int, ...]
+        Tuple of the indices of all removable hints of this sequence, in
+        ascending order.
+    _hints_unreachable : Tuple[int, ...]
+        Tuple of the indices of all unreachable hints of this sequence, in
+        ascending order.
+    '''
+
+    # ..................{ INITIALIZERS                       }..................
+    def __init__(self, hint: Hint, hints: Iterable[Hint]) -> None:
+        '''
+        Initialize this coverage from the passed covered type hint and ordered
+        sequence of covering type hints.
+
+        Parameters
+        ----------
+        hint : Hint
+            Type hint to be covered.
+        hints : Iterable[Hint]
+            Ordered sequence of type hints covering that hint.
+
+        Raises
+        ------
+        beartype.roar.BeartypeDoorException
+            If this sequence is *not* iterable.
+        '''
+
+        # Iterator over the hints of this sequence.
+        #
+        # Note that this sequence is iterated exactly once, as this sequence is
+        # only guaranteed to be an iterable rather than a container.
+        try:
+            hints_iterator = iter(hints)
+        except TypeError:
+            raise BeartypeDoorException(
+                f'Covering type hints {repr(hints)} not iterable.') from None
+
+        # Tuple of the canonical forms of the hints of this sequence.
+        hint_wrappers = tuple(
+            TypeHint(hint_other).simplify() for hint_other in hints_iterator)
+
+        # Canonical form of the covered hint.
+        hint_wrapper_covered = TypeHint(hint).simplify()
+
+        # Portion of that hint left uncovered by all hints visited thus far,
+        # initialized to the canonical form of that hint.
+        hint_residual: Optional[TypeHint] = hint_wrapper_covered
+
+        # Tuples of the portions newly covered by each hint of this sequence and
+        # the indices of all unreachable hints of this sequence.
+        hints_matched: Tuple[Optional[Hint], ...] = ()
+        hints_unreachable: Tuple[int, ...] = ()
+
+        # For each hint of this sequence...
+        for hint_index, hint_wrapper in enumerate(hint_wrappers):
+            # Portion of the residual newly covered by this hint, defined as the
+            # meet of the residual and this hint. Note that a hint following a
+            # hint exhausting the residual covers nothing.
+            hint_matched = (
+                None
+                if hint_residual is None else
+                hint_residual.meet(hint_wrapper)
+            )
+
+            # If this hint newly covers *NO* portion of the residual, this hint
+            # is unreachable.
+            if hint_matched is None:
+                hints_matched += (None,)
+                hints_unreachable += (hint_index,)
+            # Else, this hint newly covers a portion of the residual. In this
+            # case, remove that portion from the residual.
+            else:
+                hints_matched += (hint_matched._hint,)
+                hint_residual = hint_residual.difference(  # type: ignore[union-attr]
+                    hint_wrapper)
+
+        # Tuple of the index pairs of all pairs of these hints sharing a common
+        # subhint, in ascending order. Note that overlap is a property of these
+        # hints alone and is thus *NOT* residual-sensitive: two hints overlap
+        # even when an earlier hint already covers both.
+        hints_overlapping: Tuple[Tuple[int, int], ...] = ()
+
+        for hint_index, hint_wrapper in enumerate(hint_wrappers):
+            for hint_other_index in range(hint_index + 1, len(hint_wrappers)):
+                if not hint_wrapper.is_disjoint(
+                    hint_wrappers[hint_other_index]):
+                    hints_overlapping += ((hint_index, hint_other_index),)
+
+        # Tuple of the indices of all hints of this sequence whose removal
+        # leaves the residual unchanged, in ascending order.
+        hints_removable: Tuple[int, ...] = ()
+
+        for hint_index in range(len(hint_wrappers)):
+            # Residual of this sequence with this hint removed.
+            hint_residual_other = self._make_hint_residual(
+                hint_wrapper_covered,
+                hint_wrappers[:hint_index] + hint_wrappers[hint_index + 1:],
+            )
+
+            # If removing this hint leaves the residual unchanged, this hint is
+            # removable. Note that an unreachable hint is always removable.
+            if (
+                (hint_residual is None) == (hint_residual_other is None) and
+                (hint_residual is None or hint_residual == hint_residual_other)
+            ):
+                hints_removable += (hint_index,)
+
+        self._hint_residual: Optional[Hint] = (
+            None if hint_residual is None else hint_residual._hint)
+        self._hints_removable = hints_removable
+        self._hints_overlapping = hints_overlapping
+        self._hints_matched = hints_matched
+        self._hints_unreachable = hints_unreachable
+
+    # ..................{ PRIVATE                            }..................
+    @staticmethod
+    def _make_hint_residual(
+        hint_wrapper: TypeHint, hint_wrappers: Tuple[TypeHint, ...]) -> (
+        Optional[TypeHint]):
+        '''
+        Portion of the passed covered type hint wrapper left uncovered by the
+        passed ordered sequence of canonical covering type hint wrappers if any
+        *or* :data:`None` otherwise.
+
+        Parameters
+        ----------
+        hint_wrapper : TypeHint
+            Canonical type hint wrapper to be covered.
+        hint_wrappers : Tuple[TypeHint, ...]
+            Ordered sequence of canonical type hint wrappers covering that
+            wrapper.
+
+        Returns
+        -------
+        Optional[TypeHint]
+            Either this residual *or* :data:`None`.
+        '''
+
+        # Portion of that wrapper left uncovered by all wrappers visited thus
+        # far, initialized to that wrapper.
+        hint_residual: Optional[TypeHint] = hint_wrapper
+
+        # For each covering wrapper...
+        for hint_wrapper_other in hint_wrappers:
+            # If the residual is exhausted, all remaining wrappers cover
+            # nothing. Halt iteration.
+            if hint_residual is None:
+                break
+            # Else, the residual is *NOT* exhausted.
+
+            hint_residual = hint_residual.difference(hint_wrapper_other)
+
+        return hint_residual
+
+    # ..................{ DUNDERS                            }..................
+    def __repr__(self) -> str:
+
+        return (
+            f'HintCoverage('
+            f'residual={repr(self._hint_residual)}, '
+            f'unreachable={repr(self._hints_unreachable)}, '
+            f'overlapping={repr(self._hints_overlapping)})'
+        )
+
+    # ..................{ PROPERTIES                         }..................
+    @property
+    def residual(self) -> Optional[Hint]:
+        '''
+        Portion of the covered type hint left uncovered by *all* covering type
+        hints in canonical form if any *or* :data:`None` otherwise (i.e., if
+        these covering hints are exhaustive).
+        '''
+
+        return self._hint_residual
+
+
+    @property
+    def matched(self) -> Tuple[Optional[Hint], ...]:
+        '''
+        Tuple of the portion of the covered type hint newly covered by each
+        covering type hint in canonical form, where each such portion is
+        :data:`None` if the corresponding covering hint is unreachable.
+        '''
+
+        return self._hints_matched
+
+
+    @property
+    def unreachable(self) -> Tuple[int, ...]:
+        '''
+        Tuple of the indices of all **unreachable covering type hints** (i.e.,
+        covering hints newly covering *no* portion of the covered hint), in
+        ascending order.
+        '''
+
+        return self._hints_unreachable
+
+
+    @property
+    def overlapping(self) -> Tuple[Tuple[int, int], ...]:
+        '''
+        Tuple of the index pairs of all pairs of covering type hints that are
+        *not* disjoint, in ascending order.
+
+        Unlike unreachability, overlap ignores the order of these covering
+        hints: two covering hints overlap even when an earlier covering hint
+        already covers both.
+        '''
+
+        return self._hints_overlapping
+
+
+    @property
+    def removable(self) -> Tuple[int, ...]:
+        '''
+        Tuple of the indices of all **removable covering type hints** (i.e.,
+        covering hints whose removal leaves the residual unchanged), in
+        ascending order.
+
+        Every unreachable covering hint is removable, but a reachable covering
+        hint is removable as well when the covering hints following it cover
+        everything it covers.
+        '''
+
+        return self._hints_removable
+
+
+    @property
+    def is_exhaustive(self) -> bool:
+        '''
+        :data:`True` only if these covering type hints leave *no* portion of the
+        covered type hint uncovered.
+        '''
+
+        return self._hint_residual is None
