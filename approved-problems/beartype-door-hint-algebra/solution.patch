+    # ..................{ PRIVATE ~ lattice                  }..................
+    def _make_hint(self, args: tuple):
+        '''
+        Low-level type hint of the same form as the low-level type hint wrapped
+        by this wrapper, subscripted by the passed low-level child type hints.
+
+        Subclasses are advised to override this method for hints whose child
+        hints are *not* simply the arguments subscripting those hints (e.g.,
+        ``Callable[...]`` hints, whose parameter hints are themselves
+        subscripted by a nested list).
+
+        Parameters
+        ----------
+        args : tuple
+            Tuple of the one or more low-level child type hints subscripting the
+            returned type hint.
+
+        Returns
+        -------
+        Hint
+            This type hint, subscripted by these child type hints.
+        '''
+
+        return self._origin[args]  # type: ignore[index]
+
+
+    def _simplify_wrapper(self) -> 'TypeHint':
+        '''
+        Canonical form of this type hint wrapper, deferred to by the public
+        :meth:`simplify` method.
+
+        Subclasses are advised to override this method for hints whose canonical
+        form is *not* simply this hint subscripted by the canonical forms of the
+        child hints subscripting this hint (e.g., unions).
+
+        Returns
+        -------
+        TypeHint
+            Canonical form of this type hint wrapper.
+        '''
+
+        # Tuple of the zero or more child hint wrappers of this wrapper.
+        args_wrapped = self._args_wrapped_tuple
+
+        # If this hint is unsubscripted, this hint is already canonical.
+        if not args_wrapped:
+            return self
+        # Else, this hint is subscripted.
+
+        # Tuple of the canonical forms of these child hint wrappers.
+        args_wrapped_simple = tuple(
+            arg_wrapped._simplified for arg_wrapped in args_wrapped)
+
+        # If *NO* child hint of this hint changed, this hint is already
+        # canonical. Preserve the identity of this hint by returning this
+        # wrapper as is.
+        #
+        # Note that these child hints are compared by identity rather than
+        # equality. Why? Because equality is the mutual subhint relation, under
+        # which a hint is equal to its own canonical form -- which would then
+        # discard that canonical form entirely.
+        if all(
+            arg_wrapped_simple is arg_wrapped
+            for arg_wrapped_simple, arg_wrapped in zip(
+                args_wrapped_simple, args_wrapped)
+        ):
+            return self
+        # Else, one or more child hints of this hint changed.
+
+        return TypeHint(self._make_hint(tuple(
+            arg_wrapped._hint for arg_wrapped in args_wrapped_simple)))
+
+
+    def _meet_simplified(self, other: 'TypeHint') -> 'Optional[TypeHint]':
+        '''
+        Meet of this and the passed type hint wrappers, both of which are
+        assumed to already be in canonical form.
+
+        This method implements the ordered resolution of the meet relation:
+        the :obj:`typing.Any` catch-all, then union distribution, then the
+        subclass-specific :meth:`_meet_branch` implementations of these
+        wrappers, and then the subhint relation.
+
+        Parameters
+        ----------
+        other : TypeHint
+            Other canonical type hint wrapper to be met with this wrapper.
+
+        Returns
+        -------
+        Optional[TypeHint]
+            Either the meet of these wrappers *or* :data:`None` if these
+            wrappers are disjoint.
+        '''
+
+        # If either hint is the "typing.Any" catch-all, the meet of these hints
+        # is the other hint.
+        if other._hint is Any:
+            return self
+        elif self._hint is Any:
+            return other
+        # Else, neither hint is that catch-all.
+
+        # If either hint is a union, the meet of these hints distributes over
+        # the branches of these hints.
+        if len(tuple(self._branches)) > 1 or len(tuple(other._branches)) > 1:
+            return self._meet_branches(other)
+        # Else, neither hint is a union.
+
+        # Meet of these hints according to the subclass-specific implementation
+        # of this hint if any *OR* "None" otherwise.
+        hint_meet = self._meet_branch(other)
+
+        # If this hint implements *NO* meet with that hint, fallback to the
+        # subclass-specific implementation of that hint. Note that the meet
+        # relation is symmetric, whereas these implementations are not.
+        if hint_meet is None:
+            hint_meet = other._meet_branch(self)
+        # Else, this hint implements a meet with that hint.
+
+        return hint_meet
