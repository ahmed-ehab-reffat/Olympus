+def test_functions_reject_non_hints() -> None:
+
+    from beartype.door import (
+        cover_hint,
+        difference_hints,
+        is_disjoint,
+        join_hints,
+        meet_hints,
+        simplify_hint,
+    )
+    from beartype.roar import BeartypeDoorException
+
+    with raises(BeartypeDoorException):
+        simplify_hint(NOT_A_HINT)
+    with raises(BeartypeDoorException):
+        join_hints(NOT_A_HINT, int)
+    with raises(BeartypeDoorException):
+        meet_hints(int, NOT_A_HINT)
+    with raises(BeartypeDoorException):
+        difference_hints(NOT_A_HINT, int)
+    with raises(BeartypeDoorException):
+        is_disjoint(int, NOT_A_HINT)
+    with raises(BeartypeDoorException):
+        cover_hint(NOT_A_HINT, (int,))
+    with raises(BeartypeDoorException):
+        cover_hint(int, (NOT_A_HINT,))
+
