+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+NEW_TESTS="beartype_test/a00_unit/a30_api/door/a80_algebra"
+
+# Integration test installing this package from a remote package index, which
+# the offline environment running these tests cannot reach.
+NETWORK_TEST="beartype_test/a90_func/a50_external/test_poetry.py::test_poetry"
+
+PYTEST_ARGS=(-p no:cacheprovider -p no:randomly --no-header)
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  PYTEST_ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${PYTEST_ARGS[@]}" "$NEW_TESTS"
+else
+  python -m pytest "${PYTEST_ARGS[@]}" beartype_test \
+    --ignore="$NEW_TESTS" --deselect="$NETWORK_TEST"
+fi
+
+exit $?
