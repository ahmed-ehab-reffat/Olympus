+class CountingIterable(object):
+    '''
+    Iterable counting how often it is iterated and how many hints it yields.
+    '''
+
+    def __init__(self, hints) -> None:
+        self._hints = tuple(hints)
+        self.iter_count = 0
+        self.next_count = 0
+
+    def __iter__(self):
+        self.iter_count += 1
+
+        for hint in self._hints:
+            self.next_count += 1
+            yield hint
+
+
+class RaisingMetadata(object):
+    '''
+    Annotated metadata refusing to be compared for equality.
+    '''
+
+    def __eq__(self, other) -> bool:
+        raise ValueError('RaisingMetadata refuses comparison.')
+
+    def __hash__(self) -> int:
+        return id(self)
+
+# ....................{ HELPERS                            }....................
+def _structure(hint):
+    '''
+    Spelling-agnostic structure of the passed type hint, normalizing the two
+    equivalent spellings of unions into one comparable form, collapsing a hint
+    subscripted only by ignorable children onto its origin, and treating the
+    members of a union and the arguments of a literal as unordered.
+    '''
+
+    if isinstance(hint, list):
+        return ('params', tuple(
+            _structure(hint_child) for hint_child in hint))
+
+    hint_args = get_args(hint)
+
+    if not hint_args:
+        return hint
+
+    hint_origin = get_origin(hint)
+
+    if hint_origin is Literal:
+        return ('literal', frozenset(hint_args))
+    elif hint_origin is not None and hint_origin is not Annotated and all(
+        hint_child is Any or hint_child is object for hint_child in hint_args):
+        return hint_origin
+    elif hint_origin is Union or str(hint_origin) == "<class 'types.UnionType'>":
+        return ('union', frozenset(
+            _structure(hint_child) for hint_child in hint_args))
+
+    return (hint_origin, tuple(
+        _structure(hint_child) for hint_child in hint_args))
+
+
+def _assert_hint(hint_actual, hint_expected):
+    '''
+    Assert the passed actual type hint to structurally match the passed expected
+    type hint.
+    '''
+
+    assert hint_actual is not None
+    assert _structure(hint_actual) == _structure(hint_expected)
+
+
+def _union_members(hint):
+    '''
+    Frozen set of the members of the passed union type hint.
+    '''
+
+    return frozenset(get_args(hint))
+
+
+def _literal_args(hint):
+    '''
+    Frozen set of the arguments subscripting the passed literal type hint.
+    '''
+
+    return frozenset(get_args(hint))
