+def test_cover_parts_recover_the_covered_hint() -> None:
+
+    from beartype.door import TypeHint, cover_hint, join_hints
+
+    hint = Union[int, str, bytes]
+    coverage = cover_hint(hint, (str, bool))
+    hint_parts = [
+        hint_matched
+        for hint_matched in coverage.matched
+        if hint_matched is not None
+    ]
+    hint_parts.append(coverage.residual)
+
+    hint_recovered = hint_parts[0]
+    for hint_part in hint_parts[1:]:
+        hint_recovered = join_hints(hint_recovered, hint_part)
+
+    assert TypeHint(hint_recovered) == TypeHint(hint)
