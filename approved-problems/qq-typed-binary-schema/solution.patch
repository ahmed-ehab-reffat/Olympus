index 0000000..9ebc6e5
--- /dev/null
+++ b/codec/util/shape.go
@@ -0,0 +1,212 @@
+package util
+
+import (
+	"fmt"
+	"maps"
+	"math/big"
+	"slices"
+
+	"github.com/goccy/go-json"
+)
+
+type Kind int
+
+const (
+	KindNull Kind = iota
+	KindBool
+	KindInt
+	KindFloat
+	KindString
+	KindRecord
+	KindList
+	KindMixed
+)
+
+type Shape struct {
+	Kind     Kind
+	Nullable bool
+	Fields   map[string]*Shape
+	Elem     *Shape
+	Name     string
+}
+
+func (s *Shape) FieldNames() []string {
+	return slices.Sorted(maps.Keys(s.Fields))
+}
+
+func Records(v any) ([]any, error) {
+	switch t := v.(type) {
+	case map[string]any:
+		return []any{t}, nil
+	case []any:
+		if len(t) == 0 {
+			return nil, fmt.Errorf("no data to write")
+		}
+		for i, item := range t {
+			if _, ok := item.(map[string]any); !ok {
+				return nil, fmt.Errorf("record %d is not an object", i)
+			}
+		}
+		return t, nil
+	case []map[string]any:
+		out := make([]any, len(t))
+		for i, item := range t {
+			out[i] = item
+		}
+		return Records(out)
+	}
+	return nil, fmt.Errorf("output requires an array of objects or a single object")
+}
+
+func InferShape(values []any) *Shape {
+	s := &Shape{Kind: KindNull}
+	for _, v := range values {
+		s = mergeShapes(s, shapeOf(v))
+	}
+	return s
+}
+
+func shapeOf(v any) *Shape {
+	switch t := v.(type) {
+	case nil:
+		return &Shape{Kind: KindNull, Nullable: true}
+	case bool:
+		return &Shape{Kind: KindBool}
+	case int, int8, int16, int32, int64, uint8, uint16, uint32:
+		return &Shape{Kind: KindInt}
+	case float32, float64:
+		return &Shape{Kind: KindFloat}
+	case string:
+		return &Shape{Kind: KindString}
+	case map[string]any:
+		fields := make(map[string]*Shape, len(t))
+		for key, item := range t {
+			fields[key] = shapeOf(item)
+		}
+		return &Shape{Kind: KindRecord, Fields: fields}
+	case []any:
+		return &Shape{Kind: KindList, Elem: InferShape(t)}
+	}
+	return &Shape{Kind: KindMixed}
+}
+
+func mergeShapes(a, b *Shape) *Shape {
+	if a.Kind == KindNull {
+		merged := *b
+		merged.Nullable = merged.Nullable || a.Nullable
+		return &merged
+	}
+	if b.Kind == KindNull {
+		merged := *a
+		merged.Nullable = true
+		return &merged
+	}
+	merged := &Shape{Kind: a.Kind, Nullable: a.Nullable || b.Nullable}
+	switch {
+	case a.Kind == KindRecord && b.Kind == KindRecord:
+		merged.Fields = make(map[string]*Shape)
+		for key, fa := range a.Fields {
+			if fb, ok := b.Fields[key]; ok {
+				merged.Fields[key] = mergeShapes(fa, fb)
+			} else {
+				merged.Fields[key] = mergeShapes(fa, &Shape{Kind: KindNull, Nullable: true})
+			}
+		}
+		for key, fb := range b.Fields {
+			if _, ok := a.Fields[key]; !ok {
+				merged.Fields[key] = mergeShapes(fb, &Shape{Kind: KindNull, Nullable: true})
+			}
+		}
+	case a.Kind == KindList && b.Kind == KindList:
+		merged.Elem = mergeShapes(a.Elem, b.Elem)
+	case a.Kind == b.Kind:
+	case isNumeric(a.Kind) && isNumeric(b.Kind):
+		merged.Kind = KindFloat
+	default:
+		merged.Kind = KindMixed
+	}
+	return merged
+}
+
+func isNumeric(k Kind) bool {
+	return k == KindInt || k == KindFloat
+}
+
+func (s *Shape) IsNullable() bool {
+	return s.Nullable || s.Kind == KindNull
+}
+
+func (s *Shape) Leaf() Kind {
+	if s.Kind == KindNull {
+		return KindString
+	}
+	return s.Kind
+}
+
+func Conform(v any, s *Shape) any {
+	if v == nil {
+		return nil
+	}
+	switch s.Leaf() {
+	case KindInt:
+		return toInt64(v)
+	case KindFloat:
+		return toFloat64(v)
+	case KindRecord:
+		m := v.(map[string]any)
+		out := make(map[string]any, len(s.Fields))
+		for key, field := range s.Fields {
+			out[key] = Conform(m[key], field)
+		}
+		return out
+	case KindList:
+		items := v.([]any)
+		out := make([]any, len(items))
+		for i, item := range items {
+			out[i] = Conform(item, s.Elem)
+		}
+		return out
+	case KindMixed:
+		b, err := json.Marshal(v)
+		if err != nil {
+			return fmt.Sprintf("%v", v)
+		}
+		return string(b)
+	}
+	return v
+}
+
+func toInt64(v any) int64 {
+	switch n := v.(type) {
+	case int:
+		return int64(n)
+	case int8:
+		return int64(n)
+	case int16:
+		return int64(n)
+	case int32:
+		return int64(n)
+	case int64:
+		return n
+	case uint8:
+		return int64(n)
+	case uint16:
+		return int64(n)
+	case uint32:
+		return int64(n)
+	}
+	return 0
+}
+
+func toFloat64(v any) float64 {
+	switch n := v.(type) {
+	case float64:
+		return n
+	case float32:
+		return float64(n)
+	case *big.Int:
+		f, _ := new(big.Float).SetInt(n).Float64()
+		return f
+	}
+	return float64(toInt64(v))
+}
