@@ -0,0 +1,398 @@
+package codec
+
+import (
+	"bytes"
+	stdjson "encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/apache/arrow/go/v16/arrow"
+	"github.com/apache/arrow/go/v16/arrow/memory"
+	"github.com/apache/arrow/go/v16/parquet/file"
+	"github.com/apache/arrow/go/v16/parquet/pqarrow"
+	"github.com/hamba/avro/v2"
+	"github.com/hamba/avro/v2/ocf"
+	"github.com/itchyny/gojq"
+)
+
+func fromJSON641087(t *testing.T, text string) any {
+	t.Helper()
+	var v any
+	if err := Unmarshal([]byte(text), JSON, &v); err != nil {
+		t.Fatalf("bad fixture %s: %v", text, err)
+	}
+	return v
+}
+
+func canonical641087(t *testing.T, v any) string {
+	t.Helper()
+	b, err := stdjson.Marshal(v)
+	if err != nil {
+		t.Fatalf("cannot encode %#v: %v", v, err)
+	}
+	return string(b)
+}
+
+func roundTrip641087(t *testing.T, enc EncodingType, input string) ([]byte, any) {
+	t.Helper()
+	data, err := Marshal(fromJSON641087(t, input), enc)
+	if err != nil {
+		t.Fatalf("%s marshal failed: %v", enc, err)
+	}
+	var out any
+	if err := Unmarshal(data, enc, &out); err != nil {
+		t.Fatalf("%s unmarshal failed: %v", enc, err)
+	}
+	return data, out
+}
+
+func sameJSON641087(t *testing.T, enc EncodingType, got any, want string) {
+	t.Helper()
+	g := canonical641087(t, got)
+	w := canonical641087(t, fromJSON641087(t, want))
+	if g != w {
+		t.Errorf("%s read back:\n  got:  %s\n  want: %s", enc, g, w)
+	}
+}
+
+func avroColumn641087(s avro.Schema) (avro.Schema, bool) {
+	u, ok := s.(*avro.UnionSchema)
+	if !ok {
+		return s, false
+	}
+	var other []avro.Schema
+	for _, branch := range u.Types() {
+		if branch.Type() != avro.Null {
+			other = append(other, branch)
+		}
+	}
+	if len(other) == 1 && len(u.Types()) == 2 {
+		return other[0], true
+	}
+	return s, false
+}
+
+func avroPaths641087(prefix string, s avro.Schema, out map[string]string) {
+	inner, nullable := avroColumn641087(s)
+	kind := string(inner.Type())
+	if nullable && !strings.HasSuffix(prefix, "[]") {
+		kind += "?"
+	}
+	out[prefix] = kind
+	switch v := inner.(type) {
+	case *avro.RecordSchema:
+		for _, f := range v.Fields() {
+			avroPaths641087(prefix+"."+f.Name(), f.Type(), out)
+		}
+	case *avro.ArraySchema:
+		avroPaths641087(prefix+"[]", v.Items(), out)
+	}
+}
+
+func arrowKind641087(dt arrow.DataType) string {
+	switch dt.ID() {
+	case arrow.INT64:
+		return "long"
+	case arrow.FLOAT64:
+		return "double"
+	case arrow.BOOL:
+		return "boolean"
+	case arrow.STRING, arrow.LARGE_STRING:
+		return "string"
+	case arrow.STRUCT:
+		return "record"
+	case arrow.LIST, arrow.LARGE_LIST:
+		return "array"
+	}
+	return dt.Name()
+}
+
+func arrowPaths641087(prefix string, f arrow.Field, out map[string]string) {
+	kind := arrowKind641087(f.Type)
+	if f.Nullable && !strings.HasSuffix(prefix, "[]") {
+		kind += "?"
+	}
+	out[prefix] = kind
+	switch v := f.Type.(type) {
+	case *arrow.StructType:
+		for _, child := range v.Fields() {
+			arrowPaths641087(prefix+"."+child.Name, child, out)
+		}
+	case arrow.ListLikeType:
+		arrowPaths641087(prefix+"[]", v.ElemField(), out)
+	}
+}
+
+func columns641087(t *testing.T, enc EncodingType, data []byte) map[string]string {
+	t.Helper()
+	out := map[string]string{}
+	switch enc {
+	case AVRO:
+		avro.SkipNameValidation = false
+		dec, err := ocf.NewDecoder(bytes.NewReader(data))
+		if err != nil {
+			t.Fatalf("not an avro container: %v", err)
+		}
+		root, ok := dec.Schema().(*avro.RecordSchema)
+		if !ok {
+			t.Fatalf("avro schema is not a record: %s", dec.Schema())
+		}
+		for _, f := range root.Fields() {
+			avroPaths641087(f.Name(), f.Type(), out)
+		}
+	case PARQUET:
+		pf, err := file.NewParquetReader(bytes.NewReader(data))
+		if err != nil {
+			t.Fatalf("not a parquet file: %v", err)
+		}
+		defer pf.Close()
+		fr, err := pqarrow.NewFileReader(pf, pqarrow.ArrowReadProperties{}, memory.DefaultAllocator)
+		if err != nil {
+			t.Fatalf("cannot read parquet schema: %v", err)
+		}
+		schema, err := fr.Schema()
+		if err != nil {
+			t.Fatalf("cannot read parquet schema: %v", err)
+		}
+		for _, f := range schema.Fields() {
+			arrowPaths641087(f.Name, f, out)
+		}
+	}
+	return out
+}
+
+func sameColumns641087(t *testing.T, enc EncodingType, data []byte, want map[string]string) {
+	t.Helper()
+	got := columns641087(t, enc, data)
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("%s columns:\n  got:  %v\n  want: %v", enc, got, want)
+	}
+}
+
+func query641087(t *testing.T, enc EncodingType, v any, expr string, want string) {
+	t.Helper()
+	q, err := gojq.Parse(expr)
+	if err != nil {
+		t.Fatalf("bad query %s: %v", expr, err)
+	}
+	var results []any
+	iter := q.Run(v)
+	for {
+		r, ok := iter.Next()
+		if !ok {
+			break
+		}
+		if err, ok := r.(error); ok {
+			t.Fatalf("%s query %s failed: %v", enc, expr, err)
+		}
+		results = append(results, r)
+	}
+	sameJSON641087(t, enc, results, want)
+}
+
+var binaryCodecs641087 = []EncodingType{AVRO, PARQUET}
+
+func TestBinarySchemaTypedScalarsAndNesting(t *testing.T) {
+	input := `[
+		{"n": 9007199254740993, "f": 1.5, "b": true, "s": "alpha", "o": {"x": -9007199254740995, "y": "in"}, "l": [1, 2, 3]},
+		{"n": -4, "f": 0.25, "b": false, "s": "beta", "o": {"x": 7, "y": "out"}, "l": [9223372036854775807]}
+	]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, input)
+		sameColumns641087(t, enc, data, map[string]string{
+			"n": "long", "f": "double", "b": "boolean", "s": "string",
+			"o": "record", "o.x": "long", "o.y": "string",
+			"l": "array", "l[]": "long",
+		})
+	}
+}
+
+func TestBinarySchemaColumnsComeFromEveryRecord(t *testing.T) {
+	input := `[{"a": 1}, {"a": 2, "b": "x"}, {"a": 3, "c": true}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[
+			{"a": 1, "b": null, "c": null},
+			{"a": 2, "b": "x", "c": null},
+			{"a": 3, "b": null, "c": true}
+		]`)
+		sameColumns641087(t, enc, data, map[string]string{"a": "long", "b": "string?", "c": "boolean?"})
+	}
+}
+
+func TestBinarySchemaNullInFirstRecordDoesNotFixTheType(t *testing.T) {
+	input := `[{"v": null}, {"v": 5}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, input)
+		sameColumns641087(t, enc, data, map[string]string{"v": "long?"})
+	}
+}
+
+func TestBinarySchemaIntegersAndFloatsMergeToDouble(t *testing.T) {
+	input := `[{"v": 1, "w": 2.0}, {"v": 2.5, "w": 3.0}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[{"v": 1, "w": 2}, {"v": 2.5, "w": 3}]`)
+		sameColumns641087(t, enc, data, map[string]string{"v": "double", "w": "double"})
+	}
+}
+
+func TestBinarySchemaMixedKindsStoreJSONText(t *testing.T) {
+	input := `[{"v": 1}, {"v": "x"}, {"v": {"k": true}}, {"v": null}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[{"v": "1"}, {"v": "\"x\""}, {"v": "{\"k\":true}"}, {"v": null}]`)
+		sameColumns641087(t, enc, data, map[string]string{"v": "string?"})
+	}
+}
+
+func TestBinarySchemaNullableNestedRecord(t *testing.T) {
+	input := `[{"id": 1, "o": {"x": 1, "y": "a"}}, {"id": 2, "o": null}, {"id": 3}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[{"id": 1, "o": {"x": 1, "y": "a"}}, {"id": 2, "o": null}, {"id": 3, "o": null}]`)
+		sameColumns641087(t, enc, data, map[string]string{"id": "long", "o": "record?", "o.x": "long", "o.y": "string"})
+	}
+}
+
+func TestBinarySchemaDecodedValuesWorkInQueries(t *testing.T) {
+	input := `[{"n": 9007199254740993, "o": {"x": 20}, "l": [1, 2, 3]}, {"n": 1, "o": {"x": 1}, "l": []}]`
+	for _, enc := range binaryCodecs641087 {
+		_, out := roundTrip641087(t, enc, input)
+		query641087(t, enc, out, `.[] | [.n + 1, .o.x * 2, (.l | add), .n > 2]`,
+			`[[9007199254740994, 40, 6, true], [2, 2, null, false]]`)
+	}
+}
+
+func TestBinarySchemaSingleObjectIsOneRecord(t *testing.T) {
+	input := `{"a": 1, "o": {"b": [true]}}`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[`+input+`]`)
+		sameColumns641087(t, enc, data, map[string]string{"a": "long", "o": "record", "o.b": "array", "o.b[]": "boolean"})
+	}
+}
+
+func TestBinarySchemaRejectsInputThatIsNotRecords(t *testing.T) {
+	for _, enc := range binaryCodecs641087 {
+		for _, input := range []string{`[]`, `[{"a": 1}, 2]`, `"text"`, `[[{"a": 1}]]`} {
+			if _, err := Marshal(fromJSON641087(t, input), enc); err == nil {
+				t.Errorf("%s accepted %s", enc, input)
+			}
+		}
+	}
+}
+
+func TestBinarySchemaParquetGoRecordsKeepTheirTypes(t *testing.T) {
+	records := []map[string]any{
+		{"ID": 1, "Name": "Alice", "Age": 30, "Active": true, "Score": 95.5, "OptionalField": nil},
+		{"ID": 2, "Name": "Bob", "Age": 25, "Active": false, "Score": 87.2, "OptionalField": "Some Value"},
+		{"ID": 3, "Name": "Charlie", "Active": true, "Score": 92.0},
+	}
+	for _, enc := range binaryCodecs641087 {
+		data, err := Marshal(records, enc)
+		if err != nil {
+			t.Fatalf("%s marshal failed: %v", enc, err)
+		}
+		var out any
+		if err := Unmarshal(data, enc, &out); err != nil {
+			t.Fatalf("%s unmarshal failed: %v", enc, err)
+		}
+		sameJSON641087(t, enc, out, `[
+			{"ID": 1, "Name": "Alice", "Age": 30, "Active": true, "Score": 95.5, "OptionalField": null},
+			{"ID": 2, "Name": "Bob", "Age": 25, "Active": false, "Score": 87.2, "OptionalField": "Some Value"},
+			{"ID": 3, "Name": "Charlie", "Age": null, "Active": true, "Score": 92, "OptionalField": null}
+		]`)
+		sameColumns641087(t, enc, data, map[string]string{
+			"ID": "long", "Name": "string", "Age": "long?", "Active": "boolean", "Score": "double", "OptionalField": "string?",
+		})
+	}
+}
+
+func TestBinarySchemaParquetLargeRecordSetKeepsIntegers(t *testing.T) {
+	records := make([]map[string]any, 1000)
+	for i := range records {
+		records[i] = map[string]any{"ID": i + 1, "Value": float64(i) * 1.5}
+	}
+	data, err := Marshal(records, PARQUET)
+	if err != nil {
+		t.Fatalf("parquet marshal failed: %v", err)
+	}
+	var out any
+	if err := Unmarshal(data, PARQUET, &out); err != nil {
+		t.Fatalf("parquet unmarshal failed: %v", err)
+	}
+	query641087(t, PARQUET, out, `length, .[0].ID, .[999].ID, .[999].Value, (map(.ID) | add)`, `[1000, 1, 1000, 1498.5, 500500]`)
+}
+
+func TestBinarySchemaAnyKeyComesBack(t *testing.T) {
+	input := `[
+		{"first-name": "Ada", "1x": 2, "ok": true, "": null, "caf\u00e9": 1.5},
+		{"first-name": "Bob", "1x": 3, "ok": false, "": "e", "caf\u00e9": 2.5}
+	]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, input)
+		cols := columns641087(t, enc, data)
+		if cols["ok"] != "boolean" {
+			t.Errorf("%s column ok: got %q in %v", enc, cols["ok"], cols)
+		}
+		if len(cols) != 5 {
+			t.Errorf("%s columns: want 5, got %v", enc, cols)
+		}
+	}
+}
+
+func TestBinarySchemaRenamedKeysDoNotCollide(t *testing.T) {
+	input := `[
+		{"a b": 1, "a-b": "two", "a_b": 3.5, "a_b_2": true, "a.b": {"x y": 4, "x_y": "five"}},
+		{"a b": 6, "a-b": "seven", "a_b": 8, "a_b_2": false, "a.b": {"x y": 9, "x_y": "ten"}}
+	]`
+	for _, enc := range binaryCodecs641087 {
+		_, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, input)
+	}
+}
+
+func TestBinarySchemaOddKeysInsideNestedValues(t *testing.T) {
+	input := `[
+		{"o": {"k.v": 1, "l": [{"$x": 2, "y-z": "s"}, null, {"$x": 3}]}},
+		{"o": null},
+		{"o": {"k.v": 4, "l": []}, "p-q": [{"r s": {"t.u": [1.5]}}]}
+	]`
+	want := `[
+		{"o": {"k.v": 1, "l": [{"$x": 2, "y-z": "s"}, null, {"$x": 3, "y-z": null}]}, "p-q": null},
+		{"o": null, "p-q": null},
+		{"o": {"k.v": 4, "l": []}, "p-q": [{"r s": {"t.u": [1.5]}}]}
+	]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, want)
+		columns641087(t, enc, data)
+		query641087(t, enc, out, `[.[0].o.l[0]["$x"] + .[2].o["k.v"], (.[2]["p-q"][0]["r s"] | keys)]`, `[[6, ["t.u"]]]`)
+	}
+}
+
+func TestBinarySchemaMixedColumnKeepsOriginalKeys(t *testing.T) {
+	input := `[{"v-1": {"a-b": 1, "c d": [true]}}, {"v-1": "x"}, {"v-1": null}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[{"v-1": "{\"a-b\":1,\"c d\":[true]}"}, {"v-1": "\"x\""}, {"v-1": null}]`)
+		columns641087(t, enc, data)
+	}
+}
+
+func TestBinarySchemaNullableLists(t *testing.T) {
+	input := `[{"l": [1], "m": [[1, 2], null, [3]]}, {"l": null, "m": [null]}, {"m": []}]`
+	for _, enc := range binaryCodecs641087 {
+		data, out := roundTrip641087(t, enc, input)
+		sameJSON641087(t, enc, out, `[{"l": [1], "m": [[1, 2], null, [3]]}, {"l": null, "m": [null]}, {"l": null, "m": []}]`)
+		cols := columns641087(t, enc, data)
+		if cols["l"] != "array?" || cols["l[]"] != "long" || cols["m"] != "array" || cols["m[][]"] != "long" {
+			t.Errorf("%s columns: %v", enc, cols)
+		}
+	}
+}
