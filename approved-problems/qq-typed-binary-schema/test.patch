+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/report.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+ROOT="$(pwd)"
+
+export GOFLAGS="${GOFLAGS:--buildvcs=false}"
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+export GOTOOLCHAIN=local
+export HOME="${HOME:-/tmp}"
+
+NEW_FILE="codec/binary_schema_641087_test.go"
+NEW_TESTS='^TestBinarySchema'
+LOG=$(mktemp)
+OVERLAY=$(mktemp --suffix=.json)
+
+synthesize() {
+  suite="$1"
+  shift
+  detail=$(tail -c 4000 "$LOG" | sed 's/]]>/]] >/g')
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites>\n'
+    printf '<testsuite name="%s" tests="%s" failures="%s" errors="0" time="0">\n' "$suite" "$#" "$#"
+    for n in "$@"; do
+      printf '<testcase name="%s" classname="%s" time="0"><failure message="no result for %s"><![CDATA[%s]]></failure></testcase>\n' \
+        "$n" "$suite" "$n" "$detail"
+    done
+    printf '</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+}
+
+if [ "$MODE" = "base" ]; then
+  printf '{"Replace":{"%s":""}}\n' "$ROOT/$NEW_FILE" > "$OVERLAY"
+  go test -trimpath -v -count=1 -overlay "$OVERLAY" ./... > "$LOG" 2>&1
+  EXIT=$?
+  go-junit-report -set-exit-code < "$LOG" > "$OUTPUT_PATH"
+  if [ $EXIT -ne 0 ] && ! grep -q '<failure' "$OUTPUT_PATH" 2>/dev/null; then
+    synthesize "github.com/JFryy/qq" "TestBaseSuite"
+  fi
+  rm -f "$LOG" "$OVERLAY"
+  exit $EXIT
+fi
+
+go test -trimpath -v -count=1 -run "$NEW_TESTS" ./codec/ > "$LOG" 2>&1
+EXIT=$?
+go-junit-report -set-exit-code < "$LOG" > "$OUTPUT_PATH"
+
+NAMES=$(grep -oE '^func TestBinarySchema[A-Za-z0-9_]*' "$NEW_FILE" 2>/dev/null | awk '{print $2}')
+MISSING=0
+for n in $NAMES; do
+  if ! grep -q "name=\"${n}\"" "$OUTPUT_PATH" 2>/dev/null; then
+    MISSING=1
+  fi
+done
+if [ $MISSING -ne 0 ] || { [ $EXIT -ne 0 ] && ! grep -q '<failure' "$OUTPUT_PATH" 2>/dev/null; }; then
+  synthesize "github.com/JFryy/qq/codec" $NAMES
+  EXIT=1
+fi
+
+rm -f "$LOG" "$OVERLAY"
+exit $EXIT
