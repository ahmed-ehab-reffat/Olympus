+
+/// Lowers the capture group of a pattern accessor like `@a[1][2]`.
+///
+/// The group is either a number, or the name of a group in `pattern`. Names
+/// are resolved here, so the rest of the compiler only deals with numbers.
+/// The pattern is not known when the accessor is the `@` or `!` form used
+/// inside a `for .. of` statement, and a name can't be used in that case.
+fn group_from_ast<'src>(
+    ctx: &mut CompileContext<'_, 'src>,
+    group: &Option<ast::Expr<'src>>,
+    pattern: Option<&ast::Ident<'src>>,
+) -> Result<Option<ExprId>, CompileError> {
+    let group = match group {
+        Some(group) => group,
+        None => return Ok(None),
+    };
+
+    if let ast::Expr::LiteralString(name) = group {
+        let span = name.span();
+        let number = pattern
+            .and_then(|ident| ctx.get_pattern_mut(ident).ok())
+            .and_then(|(_, pattern)| match pattern.pattern() {
+                Pattern::Regexp(re) | Pattern::Hex(re) => Some(&re.hir),
+                Pattern::Text(_) => None,
+            })
+            .and_then(|hir| {
+                hir.capture_names()
+                    .into_iter()
+                    .find(|(n, _)| n.as_str() == name.value.as_ref())
+                    .map(|(_, group)| group)
+            });
+
+        return match number {
+            Some(number) => Ok(Some(ctx.ir.constant(TypeValue::const_integer_from(
+                number as i64,
+            )))),
+            None => Err(UnknownCaptureGroup::build(
+                ctx.report_builder,
+                name.value.to_string(),
+                ctx.report_builder.span_to_code_loc(span),
+            )),
+        };
+    }
+
+    Ok(Some(integer_in_range_from_ast(ctx, group, 0..=i64::MAX)?))
+}
