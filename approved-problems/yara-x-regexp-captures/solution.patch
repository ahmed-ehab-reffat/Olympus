 impl Hir {
+    /// Number of capturing groups in the regexp.
+    ///
+    /// Non-capturing groups (i.e: `(?:...)`) are not counted.
+    pub fn num_captures(&self) -> usize {
+        self.inner.properties().explicit_captures_len()
+    }
+
+    /// Number of capture slots required by the regexp, two per capturing
+    /// group: one for the start of the group and one for its end.
+    pub fn num_capture_slots(&self) -> usize {
+        self.num_captures() * 2
+    }
+
+    /// Names of the capturing groups in the regexp, together with the number
+    /// of the group each name refers to.
+    ///
+    /// Unnamed groups are not included. When the same name is used more than
+    /// once only the first group carrying it is included.
+    pub fn capture_names(&self) -> Vec<(String, u16)> {
+        let mut names: Vec<(String, u16)> = Vec::new();
+        let mut stack = vec![&self.inner];
+
+        while let Some(hir) = stack.pop() {
+            match hir.kind() {
+                regex_syntax::hir::HirKind::Capture(capture) => {
+                    if let Some(name) = &capture.name
+                        && let Ok(group) = u16::try_from(capture.index)
+                        && !names.iter().any(|(n, _)| n == name.as_ref())
+                    {
+                        names.push((name.to_string(), group));
+                    }
+                    stack.push(&capture.sub);
+                }
+                regex_syntax::hir::HirKind::Concat(subs)
+                | regex_syntax::hir::HirKind::Alternation(subs) => {
+                    stack.extend(subs.iter().rev());
+                }
+                regex_syntax::hir::HirKind::Repetition(rep) => {
+                    stack.push(&rep.sub);
+                }
+                _ => {}
+            }
+        }
+
+        names.sort_by(|a, b| a.1.cmp(&b.1));
+        names
+    }
