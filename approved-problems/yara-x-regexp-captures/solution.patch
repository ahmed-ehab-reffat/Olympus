+/// A capture group name that the pattern doesn't define.
+///
+/// ## Example
+///
+/// ```text
+/// error[E048]: unknown capture group `day`
+///  --> line:5:23
+///   |
+/// 5 |    condition: @a[1]["day"] == 0
+///   |                     ^^^^^ this pattern has no group with this name
+///   |
+/// ```
+#[derive(ErrorStruct, Clone, Debug, PartialEq, Eq)]
+#[associated_enum(CompileError)]
+#[error(code = "E048", title = "unknown capture group `{group_name}`")]
+#[label("this pattern has no group with this name", error_loc)]
+pub struct UnknownCaptureGroup {
+    report: Report,
+    group_name: String,
+    error_loc: CodeLoc,
+}
