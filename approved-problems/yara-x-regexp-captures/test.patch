+use yara_x::{Scanner, compile};
+
+fn rule_src(pattern: &str, condition: &str) -> String {
+    format!("rule test {{ strings: $a = {pattern} condition: {condition} }}")
+}
+
+fn scan(src: &str, data: &[u8]) -> usize {
+    let rules = compile(src).unwrap();
+    let mut scanner = Scanner::new(&rules);
+    scanner.scan(data).unwrap().matching_rules().len()
+}
+
+fn holds(pattern: &str, condition: &str, data: &[u8]) {
+    let src = rule_src(pattern, condition);
+    assert_eq!(scan(src.as_str(), data), 1, "expected a match for {src}");
+}
+
+fn fails(pattern: &str, condition: &str, data: &[u8]) {
+    let src = rule_src(pattern, condition);
+    assert_eq!(scan(src.as_str(), data), 0, "expected no match for {src}");
+}
+
+fn scan_twice(pattern: &str, condition: &str, first: &[u8], second: &[u8]) -> (usize, usize) {
+    let src = rule_src(pattern, condition);
+    let rules = compile(src.as_str()).unwrap();
+    let mut scanner = Scanner::new(&rules);
+    let a = scanner.scan(first).unwrap().matching_rules().len();
+    let b = scanner.scan(second).unwrap().matching_rules().len();
+    (a, b)
+}
+
+fn rejects(pattern: &str, condition: &str) {
+    let src = rule_src(pattern, condition);
+    assert!(compile(src.as_str()).is_err(), "expected an error for {src}");
+}
