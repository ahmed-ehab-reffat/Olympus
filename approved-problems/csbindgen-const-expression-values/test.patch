+fn const_decl(csharp: &str, name: &str) -> Option<(String, String)> {
+    csharp.lines().find_map(|line| {
+        let rest = line.trim().split_once(" const ")?.1;
+        let (left, value) = rest.split_once(" = ")?;
+        let (ty, decl_name) = left.rsplit_once(' ')?;
+        (decl_name == name).then(|| (ty.to_string(), value.trim_end_matches(';').to_string()))
+    })
+}
+
+fn int_literal(body: &str) -> Option<(i128, String)> {
+    let digits = body.trim_end_matches(['u', 'U', 'l', 'L']);
+    let suffix = body[digits.len()..].to_ascii_lowercase();
+    if !matches!(suffix.as_str(), "" | "u" | "l" | "ul" | "lu") {
+        return None;
+    }
+    let (radix, digits, prefixed) = if let Some(hex) = digits
+        .strip_prefix("0x")
+        .or_else(|| digits.strip_prefix("0X"))
+    {
+        (16, hex, true)
+    } else if let Some(bin) = digits
+        .strip_prefix("0b")
+        .or_else(|| digits.strip_prefix("0B"))
+    {
+        (2, bin, true)
+    } else {
+        (10, digits, false)
+    };
+    if digits.ends_with('_') || (!prefixed && digits.starts_with('_')) {
+        return None;
+    }
+    let clean = digits.replace('_', "");
+    if clean.is_empty() || !clean.chars().all(|c| c.is_digit(radix)) {
+        return None;
+    }
+    Some((i128::from_str_radix(&clean, radix).ok()?, suffix))
+}
+
+fn int_magnitude(body: &str) -> Option<i128> {
+    int_literal(body).map(|(magnitude, _)| magnitude)
+}
+
+fn literal_type(magnitude: i128, suffix: &str, negative: bool) -> Option<&'static str> {
+    let candidates: &[&'static str] = match suffix {
+        "" => &["int", "uint", "long", "ulong"],
+        "u" => &["uint", "ulong"],
+        "l" => &["long", "ulong"],
+        _ => &["ulong"],
+    };
+    let ty = *candidates.iter().find(|ty| {
+        let (low, high) = csharp_enum_range(ty);
+        (low..=high).contains(&magnitude)
+    })?;
+    if !negative {
+        return Some(ty);
+    }
+    match (ty, magnitude) {
+        ("int", _) | ("long", _) => Some(ty),
+        ("uint", 2_147_483_648) if suffix.is_empty() => Some("int"),
+        ("uint", _) => Some("long"),
+        ("ulong", 9_223_372_036_854_775_808) if suffix.is_empty() || suffix == "l" => Some("long"),
+        _ => None,
+    }
+}
+
+fn assignable(source: &str, value: i128, target: &str) -> bool {
+    let in_range = |ty: &str| {
+        let ty = match ty {
+            "nint" => "int",
+            "nuint" => "uint",
+            other => other,
+        };
+        let (low, high) = csharp_enum_range(ty);
+        (low..=high).contains(&value)
+    };
+    source == target
+        || match source {
+            "int" => match target {
+                "sbyte" | "byte" | "short" | "ushort" | "uint" | "ulong" | "nint" | "nuint" => {
+                    in_range(target)
+                }
+                "long" | "float" | "double" => true,
+                _ => false,
+            },
+            "uint" => matches!(target, "long" | "ulong" | "nuint" | "float" | "double"),
+            "long" => match target {
+                "ulong" => value >= 0,
+                "float" | "double" => true,
+                _ => false,
+            },
+            "ulong" => matches!(target, "float" | "double"),
+            _ => false,
+        }
+}
+
+fn parse_int(literal: &str) -> i128 {
+    let (negative, body) = match literal.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, literal),
+    };
+    let magnitude =
+        int_magnitude(body).unwrap_or_else(|| panic!("not a C# integer literal: {literal}"));
+    if negative {
+        -magnitude
+    } else {
+        magnitude
+    }
+}
+
+fn parse_int_as(literal: &str, target: &str) -> i128 {
+    if let Some((owner, member)) = literal.split_once('.') {
+        let (low, high) = csharp_enum_range(owner);
+        let value = match member {
+            "MinValue" => low,
+            "MaxValue" => high,
+            _ => panic!("not a C# integer constant: {literal}"),
+        };
+        assert!(
+            assignable(owner, value, target),
+            "C# cannot assign {literal} ({owner}) to {target}"
+        );
+        return value;
+    }
+    let (negative, body) = match literal.strip_prefix('-') {
+        Some(rest) => (true, rest),
+        None => (false, literal),
+    };
+    let (magnitude, suffix) =
+        int_literal(body).unwrap_or_else(|| panic!("not a C# integer literal: {literal}"));
+    let value = if negative { -magnitude } else { magnitude };
+    let source = literal_type(magnitude, &suffix, negative)
+        .unwrap_or_else(|| panic!("not a C# integer constant: {literal}"));
+    assert!(
+        assignable(source, value, target),
+        "C# cannot assign {literal} ({source}) to {target}"
+    );
+    value
+}
+
+fn is_int_literal(literal: &str) -> bool {
+    int_magnitude(literal.strip_prefix('-').unwrap_or(literal)).is_some()
+}
+
+fn special_real(literal: &str, csharp_type: &str) -> Option<f64> {
+    let literal = literal
+        .strip_prefix('(')
+        .and_then(|l| l.strip_suffix(')'))
+        .unwrap_or(literal)
+        .trim();
+    if let Some((owner, member)) = literal.rsplit_once('.') {
+        let owners: &[&str] = match csharp_type {
+            "float" => &["float", "Single", "System.Single"],
+            _ => &["double", "Double", "System.Double"],
+        };
+        if owners.contains(&owner) {
+            return match member {
+                "NaN" => Some(f64::NAN),
+                "PositiveInfinity" => Some(f64::INFINITY),
+                "NegativeInfinity" => Some(f64::NEG_INFINITY),
+                _ => None,
+            };
+        }
+    }
+    let (left, right) = literal.split_once('/')?;
+    let (left, right) = (left.trim(), right.trim());
+    if csharp_type == "float" {
+        let l = parse_real(left, csharp_type) as f32;
+        let r = parse_real(right, csharp_type) as f32;
+        Some((l / r) as f64)
+    } else {
+        Some(parse_real(left, csharp_type) / parse_real(right, csharp_type))
+    }
+}
+
+fn parse_real(literal: &str, csharp_type: &str) -> f64 {
+    if let Some(value) = special_real(literal, csharp_type) {
+        return value;
+    }
+    if is_int_literal(literal) {
+        let value = parse_int(literal);
+        assert!(
+            value.unsigned_abs() <= u64::MAX as u128,
+            "integer literal out of C# range: {literal}"
+        );
+        return value as f64;
+    }
+    let (sign, unsigned) = match literal.strip_prefix('-') {
+        Some(rest) => ("-", rest),
+        None => ("", literal),
+    };
+    let (body, suffix) = match unsigned.char_indices().last() {
+        Some((i, c)) if c.is_ascii_alphabetic() => (&unsigned[..i], Some(c.to_ascii_lowercase())),
+        _ => (unsigned, None),
+    };
+    assert!(is_real_body(body), "not a C# real literal: {literal}");
+    let text = format!("{sign}{}", body.replace('_', ""));
+    let value = match (csharp_type, suffix) {
+        ("float", Some('f')) | ("double", Some('f')) => text.parse::<f32>().unwrap() as f64,
+        ("double", Some('d')) | ("double", None) => text.parse().unwrap(),
+        _ => panic!("not a valid C# {csharp_type} literal: {literal}"),
+    };
+    assert!(value.is_finite(), "real literal out of C# range: {literal}");
+    value
+}
+
+fn is_digits(text: &str) -> bool {
+    !text.is_empty()
+        && !text.starts_with('_')
+        && !text.ends_with('_')
+        && text.chars().all(|c| c.is_ascii_digit() || c == '_')
+}
