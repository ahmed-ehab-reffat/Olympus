+fn is_real_body(body: &str) -> bool {
+    let (mantissa, exponent) = match body.find(['e', 'E']) {
+        Some(i) => (&body[..i], Some(&body[i + 1..])),
+        None => (body, None),
+    };
+    let mantissa_ok = match mantissa.split_once('.') {
+        Some((int, frac)) => (int.is_empty() || is_digits(int)) && is_digits(frac),
+        None => is_digits(mantissa),
+    };
+    let exponent_ok = exponent.map_or(true, |e| is_digits(e.strip_prefix(['+', '-']).unwrap_or(e)));
+    mantissa_ok && exponent_ok
+}
+
+fn assert_int_const(csharp: &str, name: &str, csharp_type: &str, expected: i128) {
+    let (ty, value) =
+        const_decl(csharp, name).unwrap_or_else(|| panic!("const {name} missing:\n{csharp}"));
+    assert_eq!(ty, csharp_type, "C# type of {name}");
+    assert_eq!(
+        parse_int_as(&value, &ty),
+        expected,
+        "value of {name} ({value})"
+    );
+}
+
+fn assert_real_const(csharp: &str, name: &str, csharp_type: &str, expected: f64) {
+    let (ty, value) =
+        const_decl(csharp, name).unwrap_or_else(|| panic!("const {name} missing:\n{csharp}"));
+    assert_eq!(ty, csharp_type, "C# type of {name}");
+    let parsed = parse_real(&value, csharp_type);
+    if expected.is_nan() {
+        assert!(parsed.is_nan(), "value of {name} ({value})");
+    } else if csharp_type == "float" {
+        assert_eq!(
+            (parsed as f32).to_bits(),
+            (expected as f32).to_bits(),
+            "value of {name} ({value})"
+        );
+    } else {
+        assert_eq!(
+            parsed.to_bits(),
+            expected.to_bits(),
+            "value of {name} ({value})"
+        );
+    }
+}
+
+fn push_unit(units: &mut Vec<u16>, c: char) {
+    let mut buf = [0u16; 2];
+    units.extend_from_slice(c.encode_utf16(&mut buf));
+}
+
+fn decode_csharp_text(literal: &str, quote: char) -> String {
+    if quote == '"' {
+        if let Some(inner) = literal
+            .strip_prefix("@\"")
+            .and_then(|rest| rest.strip_suffix('"'))
+        {
+            assert!(
+                !inner.replace("\"\"", "").contains('"'),
+                "unescaped quote in {literal:?}"
+            );
+            return inner.replace("\"\"", "\"");
+        }
+    }
+    let inner = literal
+        .strip_prefix(quote)
+        .and_then(|rest| rest.strip_suffix(quote))
+        .unwrap_or_else(|| panic!("not a C# {quote} literal: {literal:?}"));
+    let mut chars = inner.chars().peekable();
+    let mut units = Vec::new();
+    while let Some(c) = chars.next() {
+        assert!(
+            !matches!(c, '\r' | '\n' | '\u{85}' | '\u{2028}' | '\u{2029}'),
+            "line break inside C# literal: {literal:?}"
+        );
+        assert!(c != quote, "unescaped quote in C# literal: {literal:?}");
+        if c != '\\' {
+            push_unit(&mut units, c);
+            continue;
+        }
+        let escape = chars
+            .next()
+            .unwrap_or_else(|| panic!("dangling escape: {literal:?}"));
+        let simple = match escape {
+            '\'' | '"' | '\\' => Some(escape as u16),
+            '0' => Some(0),
+            'a' => Some(7),
+            'b' => Some(8),
+            'f' => Some(12),
+            'n' => Some(10),
+            'r' => Some(13),
+            't' => Some(9),
+            'v' => Some(11),
+            'x' | 'u' | 'U' => None,
+            other => panic!("unknown C# escape \\{other} in {literal:?}"),
+        };
+        if let Some(unit) = simple {
+            units.push(unit);
+            continue;
+        }
+        let (min, max) = match escape {
+            'x' => (1, 4),
+            'u' => (4, 4),
+            _ => (8, 8),
+        };
+        let mut digits = String::new();
+        while digits.len() < max && chars.peek().is_some_and(|d| d.is_ascii_hexdigit()) {
+            digits.push(chars.next().unwrap());
+        }
+        assert!(digits.len() >= min, "bad \\{escape} escape in {literal:?}");
+        let code = u32::from_str_radix(&digits, 16).unwrap();
+        if escape == 'U' {
+            let c = char::from_u32(code).unwrap_or_else(|| panic!("bad code point in {literal:?}"));
+            push_unit(&mut units, c);
+        } else {
+            units.push(code as u16);
+        }
+    }
+    String::from_utf16(&units).unwrap_or_else(|_| panic!("unpaired surrogate in {literal:?}"))
+}
+
+fn assert_char_const(csharp: &str, name: &str, expected: char) {
+    let (ty, value) =
+        const_decl(csharp, name).unwrap_or_else(|| panic!("const {name} missing:\n{csharp}"));
+    assert_eq!(ty, "char", "C# type of {name}");
+    assert_eq!(
+        decode_csharp_text(&value, '\''),
+        expected.to_string(),
+        "value of {name} ({value})"
+    );
+}
+
+fn assert_char_value_const(csharp: &str, name: &str, expected: char) {
+    let (ty, value) =
+        const_decl(csharp, name).unwrap_or_else(|| panic!("const {name} missing:\n{csharp}"));
+    match ty.as_str() {
+        "char" => assert_eq!(
+            decode_csharp_text(&value, '\''),
+            expected.to_string(),
+            "value of {name} ({value})"
+        ),
+        "uint" => assert_eq!(
+            parse_int_as(&value, &ty),
+            expected as i128,
+            "value of {name} ({value})"
+        ),
+        other => panic!("C# type of {name} is {other}, expected char or uint"),
+    }
+}
+
+fn byte_span(csharp: &str, name: &str) -> Option<Vec<i128>> {
+    let line = csharp
+        .lines()
+        .find(|line| line.contains(&format!(" ReadOnlySpan<byte> {name} =>")))?;
+    let body = line.split_once('{')?.1.rsplit_once('}')?.0;
+    Some(
+        body.split(',')
+            .map(str::trim)
+            .filter(|item| !item.is_empty())
+            .map(|item| {
+                let value = parse_int_as(item, "byte");
+                value
+            })
+            .collect(),
+    )
+}
+
+fn bytes(values: &[u8]) -> Option<Vec<i128>> {
+    Some(values.iter().map(|b| *b as i128).collect())
+}
+
+fn bool_const(value: bool) -> Option<(String, String)> {
+    Some(("bool".to_string(), value.to_string()))
+}
+
+fn enum_values(csharp: &str, name: &str) -> Option<Vec<(String, i128)>> {
+    let mut lines = csharp.lines().skip_while(|line| {
+        let line = line.trim();
+        !(line.contains(&format!("enum {name} ")) || line.ends_with(&format!("enum {name}")))
+    });
+    let header = lines.next()?.trim();
+    let backing = header.split_once(" : ").map_or("int", |(_, ty)| ty.trim());
+    let (low, high) = csharp_enum_range(backing);
+    let mut next = 0i128;
+    let mut values = Vec::new();
+    for line in lines.map(str::trim) {
+        if line == "{" || line.is_empty() || line.starts_with("//") {
+            continue;
+        }
+        if line == "}" {
+            break;
+        }
+        let entry = line.trim_end_matches(',');
+        let (variant, value) = match entry.split_once(" = ") {
+            Some((variant, literal)) => (variant.trim(), parse_int_as(literal.trim(), backing)),
+            None => (entry, next),
+        };
+        assert!(
+            (low..=high).contains(&value),
+            "{name}.{variant} = {value} does not fit the C# enum type {backing}"
+        );
+        values.push((variant.to_string(), value));
+        next = value + 1;
+    }
+    Some(values)
+}
+
+fn enum_backing(csharp: &str, name: &str) -> String {
+    let header = csharp
+        .lines()
+        .map(str::trim)
+        .find(|line| {
+            line.contains(&format!("enum {name} ")) || line.ends_with(&format!("enum {name}"))
+        })
+        .unwrap_or_else(|| panic!("enum {name} missing:\n{csharp}"));
+    header
+        .split_once(" : ")
+        .map_or("int", |(_, ty)| ty.trim())
+        .to_string()
+}
+
+fn csharp_enum_range(backing: &str) -> (i128, i128) {
+    match backing {
+        "sbyte" => (i8::MIN as i128, i8::MAX as i128),
+        "byte" => (0, u8::MAX as i128),
+        "short" => (i16::MIN as i128, i16::MAX as i128),
+        "ushort" => (0, u16::MAX as i128),
+        "int" => (i32::MIN as i128, i32::MAX as i128),
+        "uint" => (0, u32::MAX as i128),
+        "long" => (i64::MIN as i128, i64::MAX as i128),
+        "ulong" => (0, u64::MAX as i128),
+        other => panic!("not a C# enum type: {other}"),
+    }
+}
+
+fn named(values: &[(&str, i128)]) -> Vec<(String, i128)> {
+    values.iter().map(|(n, v)| (n.to_string(), *v)).collect()
+}
