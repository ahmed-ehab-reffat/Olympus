+fn generate(sources: &[&str], filter: fn(&str) -> bool, types: &[&str]) -> String {
+    generate_from(sources, filter, types, false)
+}
+
+fn generate_bindgen(sources: &[&str], filter: fn(&str) -> bool, types: &[&str]) -> String {
+    generate_from(sources, filter, types, true)
+}
+
+fn generate_from(
+    sources: &[&str],
+    filter: fn(&str) -> bool,
+    types: &[&str],
+    bindgen: bool,
+) -> String {
+    static COUNTER: AtomicUsize = AtomicUsize::new(0);
+    let dir = std::env::temp_dir().join(format!(
+        "csbindgen_const_values_{}_{}",
+        std::process::id(),
+        COUNTER.fetch_add(1, Ordering::SeqCst)
+    ));
+    std::fs::create_dir_all(&dir).unwrap();
+    let mut builder = csbindgen::Builder::new()
+        .csharp_generate_const_filter(filter)
+        .always_included_types(types.iter().copied());
+    for (i, source) in sources.iter().enumerate() {
+        let path = dir.join(format!("input{i}.rs"));
+        std::fs::write(&path, source).unwrap();
+        builder = if bindgen {
+            builder.input_bindgen_file(path)
+        } else {
+            builder.input_extern_file(path)
+        };
+    }
+    let output = dir.join("output.cs");
+    builder.generate_csharp_file(&output).unwrap();
+    let csharp = std::fs::read_to_string(&output).unwrap();
+    std::fs::remove_dir_all(&dir).unwrap();
+    csharp
+}
