+    def _fill_times(self, count):
+        """
+        Pull times from the sequence until `count` of them are retained.
+
+        Only the times a run has reached are kept, so an endless sequence is
+        never exhausted and a one-shot iterator stays replayable. A sequence
+        that runs out is complete, and so is one restored from a state: neither
+        is asked for more, so a restored controller falls back to the final
+        time where the controller its state came from did. What has been pulled
+        is kept, so a state that holds no schedule of its own rewinds within
+        the one already retained.
+        """
+        while len(self.times) < count:
+            if self.is_complete:
+                return False
+
+            try:
+                self.times.append(next(self.iter_times))
+
+            except StopIteration:
+                self.is_complete = True
+                return False
+
+        return True
+
+    def _next_time(self, default):
+        if not self._fill_times(self.index + 1):
+            return default
+
+        time = self.times[self.index]
+        self.index += 1
+
+        return time
+
+    def _retain_schedule(self):
+        """
+        Pull every time up to the final time from the sequence.
+
+        A one-shot iterator is spent by the run that takes a state, so a
+        controller given the state back has to get the times it has not
+        reached yet from the state rather than from the sequence. Nothing past
+        the final time is pulled, so an endless sequence stays usable.
+        """
+        if self.t1 is None:
+            return
+
+        while not self.is_complete:
+            if self.times and (self.times[-1] >= self.t1):
+                self.is_complete = True
+
+            elif not self._fill_times(len(self.times) + 1):
+                return
+
