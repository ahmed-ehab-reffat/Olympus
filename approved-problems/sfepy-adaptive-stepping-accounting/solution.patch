+class StepRecord(Struct):
+    """
+    A record of a single attempt at a time step.
+
+    Attributes
+    ----------
+    step : int
+        The index of the time step the attempt belongs to.
+    time : float
+        The time the attempt aimed at.
+    dt : float
+        The time step size used by the attempt.
+    result : str
+        Either 'accept' or 'reject'.
+    emax : float or None
+        The error estimate of the time step controller, None if the controller
+        computes none.
+    condition : int
+        The exit condition of the nonlinear solver.
+    n_iter : int
+        The number of nonlinear solver iterations.
+    """
+
+    def __init__(self, step, time, dt, result, emax, condition, n_iter):
+        Struct.__init__(self, step=step, time=time, dt=dt, result=result,
+                        emax=emax, condition=condition, n_iter=n_iter)
+
+def make_step_record(ts, dt, result, emax, nls_status, time=None):
+    """
+    Build the record of a single time step attempt.
+
+    `time` is the time the attempt aimed at. It defaults to the current
+    stepper time, and has to be passed explicitly by callers that adapt the
+    step size before recording, as adapting moves the stepper to the retry.
+    """
+    if nls_status is not None:
+        condition = nls_status.get('condition', 0)
+        n_iter = nls_status.get('n_iter', 0)
+
+    else:
+        condition, n_iter = 0, 0
+
+    return StepRecord(ts.step, ts.time if time is None else float(time),
+                      dt, result, emax if emax is None else float(emax),
+                      condition, n_iter)
+
+def get_retry_time_step(ts, dt, red_factor):
+    """
+    Size the retry of a rejected attempt.
+
+    The retry has to be smaller than the attempt it replaces and has to stay
+    within the final time. The size the controller proposes need not do either,
+    as it comes from the default step size and so ignores both the shortening
+    of the attempt that was rejected and the time left to run.
+    """
