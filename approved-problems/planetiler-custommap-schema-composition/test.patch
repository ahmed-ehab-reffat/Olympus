+  private static final String BASE = BODY + """
+    examples:
+    - name: base water
+      input:
+        source: osm
+        geometry: polygon
+        tags:
+          natural: water
+      output:
+        layer: water
+        geometry: polygon
+        tags:
+          natural: water
+    """;
+
+  private Path write(String name, String yaml) {
+    try {
+      Path path = dir.resolve(name);
+      Files.createDirectories(path.getParent());
+      return Files.writeString(path, yaml);
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    }
+  }
+
+  private SchemaConfig load(String name) {
+    return SchemaConfig.load(dir.resolve(name));
+  }
+
+  private static List<String> layerIds(SchemaConfig schema) {
+    return schema.layers().stream().map(FeatureLayer::id).toList();
+  }
+
+  private static FeatureLayer layer(SchemaConfig schema, String id) {
+    return schema.layers().stream().filter(l -> id.equals(l.id())).findFirst().orElseThrow();
+  }
+
+  private static Object arg(SchemaConfig schema, String key) {
+    return Contexts.buildRootContext(Arguments.of().silence(), schema.args()).argument(key);
+  }
+
+  private static BaseSchemaValidator.Result validate(SchemaConfig schema) {
+    var spec = com.onthegomap.planetiler.util.YAML.convertValue(schema, SchemaSpecification.class);
+    return SchemaValidator.validate(schema, spec);
+  }
+
+  private static List<String> exampleNames(SchemaConfig schema) {
+    return com.onthegomap.planetiler.util.YAML.convertValue(schema, SchemaSpecification.class).examples().stream()
+      .map(SchemaSpecification.Example::name).toList();
+  }
+
+  private static String name(Path path) {
+    return path.getFileName().toString();
+  }
