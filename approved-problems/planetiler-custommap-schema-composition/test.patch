+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")" || exit 1
+fi
+
+NEW_TEST="SchemaCompositionf87c01Test"
+NEW_TEST_FILE="planetiler-custommap/src/test/java/com/onthegomap/planetiler/custommap/validator/$NEW_TEST.java"
+REPORTS="planetiler-custommap/target/surefire-reports"
+LOG="$(mktemp)"
+HIDDEN=""
+WRITE_FAILED=0
+
+restore() {
+  if [ -n "$HIDDEN" ] && [ -f "$HIDDEN" ]; then
+    mv "$HIDDEN" "$NEW_TEST_FILE"
+  fi
+  rm -f "$LOG"
+}
+trap restore EXIT
+
+rm -rf "$REPORTS"
+
+if [ "$MODE" = "new" ]; then
+  FILTER="$NEW_TEST"
+else
+  FILTER="!$NEW_TEST"
+  if [ -f "$NEW_TEST_FILE" ]; then
+    HIDDEN="$(mktemp -d)/$NEW_TEST.java"
+    mv "$NEW_TEST_FILE" "$HIDDEN"
+  fi
+fi
+
+run_tests() {
+  rm -rf "$REPORTS"
+  mvn -B -o -q -pl planetiler-custommap test -Dtest="$FILTER" -Dsurefire.failIfNoSpecifiedTests=false -Dmaven.test.failure.ignore=true > "$LOG" 2>&1
+}
+
+run_tests
+MVN_EXIT=$?
+if [ $MVN_EXIT -ne 0 ] && grep -qF 'planetiler-parent:pom:${revision}' "$LOG"; then
+  mvn -B -o -q -Pflatten -pl planetiler-core -am -DskipTests install > /dev/null 2>&1
+  run_tests
+  MVN_EXIT=$?
+fi
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  if ls "$REPORTS"/TEST-*.xml > /dev/null 2>&1; then
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      for f in "$REPORTS"/TEST-*.xml; do
+        sed '1{/^<?xml/d}' "$f"
+      done
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH" || WRITE_FAILED=1
+  else
+    cat "$LOG"
+    detail="$(grep -E 'ERROR' "$LOG" | head -20 | xml_escape)"
+    names=""
+    if [ "$MODE" = "new" ] && [ -f "$NEW_TEST_FILE" ]; then
+      names="$(grep -oE '^  void [A-Za-z0-9_]+\(\)' "$NEW_TEST_FILE" | sed -E 's/^  void ([A-Za-z0-9_]+)\(\)/\1/')"
+    fi
+    [ -n "$names" ] || names="build"
+    count="$(printf '%s\n' "$names" | wc -l | tr -d ' ')"
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo "<testsuite name=\"$NEW_TEST\" tests=\"$count\" failures=\"$count\" errors=\"0\">"
+      for name in $names; do
+        echo "<testcase name=\"$name\" classname=\"com.onthegomap.planetiler.custommap.validator.$NEW_TEST\">"
+        echo "<failure message=\"Build failed\">$detail</failure>"
+        echo '</testcase>'
+      done
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH" || WRITE_FAILED=1
+  fi
+fi
+
+if [ -n "$OUTPUT_PATH" ] && { [ "$WRITE_FAILED" -ne 0 ] || [ ! -s "$OUTPUT_PATH" ]; }; then
+  echo "Failed to write JUnit report to $OUTPUT_PATH" >&2
+  exit 1
+fi
+if [ $MVN_EXIT -ne 0 ]; then
+  cat "$LOG"
+  exit $MVN_EXIT
+fi
+if ! ls "$REPORTS"/TEST-*.xml > /dev/null 2>&1; then
+  exit 1
+fi
+grep -qE '<(failure|error)[ >]' "$REPORTS"/TEST-*.xml && exit 1
+exit 0
