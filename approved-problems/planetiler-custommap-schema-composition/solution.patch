+package com.onthegomap.planetiler.custommap.configschema;
+
+import com.onthegomap.planetiler.custommap.expression.ParseException;
+import com.onthegomap.planetiler.util.YAML;
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/**
+ * Resolves the {@code extends} graph of schema files and folds the files into a single {@link SchemaConfig}.
+ * <p>
+ * Files contribute parents-first in the order they are listed, each file once at its first position. A file that is
+ * reached again while it is still being expanded is a cycle. A parent that does not exist as a file is looked up among
+ * the sample schemas bundled with planetiler, the same way {@code --schema} does.
+ */
+class SchemaComposer {
+
+  private static final String SAMPLES = "/samples/";
+
+  private SchemaComposer() {}
+
+  /** Where a schema was read from: a file on disk, or a sample bundled in the jar. */
+  record Ref(Path file, String resource) {
+
+    static Ref of(Path path) {
+      return locate(canonical(path), path.toString().replace(File.separatorChar, '/'));
+    }
+
+    static Ref ofFile(Path path) {
+      return new Ref(canonical(path), null);
+    }
+
+    private static Ref locate(Path candidate, String reference) {
+      if (Files.isRegularFile(candidate)) {
+        return new Ref(candidate, null);
+      }
+      String resource = reference.startsWith(SAMPLES) ? reference : SAMPLES + reference;
+      if (SchemaComposer.class.getResource(resource) != null) {
+        return new Ref(null, resource);
+      }
+      return new Ref(candidate, null);
+    }
+
+    boolean exists() {
+      return resource != null || Files.isRegularFile(file);
+    }
+
+    boolean bundled() {
+      return resource != null;
+    }
+
+    String name() {
+      return resource != null ? resource.substring(SAMPLES.length()) : file.getFileName().toString();
+    }
+
+    Ref parent(String reference) {
+      var path = Path.of(reference);
+      if (path.isAbsolute()) {
+        return locate(canonical(path), reference);
+      }
+      if (resource != null) {
+        return new Ref(null, resource.substring(0, resource.lastIndexOf('/') + 1) + reference);
+      }
+      return locate(canonical(file.resolveSibling(path)), reference);
+    }
+
+    Ref examples(String reference) {
+      var path = Path.of(reference);
+      if (path.isAbsolute()) {
+        return ofFile(path);
+      }
+      if (resource != null) {
+        return new Ref(null, resource.substring(0, resource.lastIndexOf('/') + 1) + reference);
+      }
+      return ofFile(file.resolveSibling(path));
+    }
+
+    SchemaConfig parse() {
+      return resource != null ? YAML.loadResource(resource, SchemaConfig.class) :
+        YAML.load(file, SchemaConfig.class);
+    }
+
+    Map<?, ?> parseSpecification() {
+      return resource != null ? YAML.loadResource(resource, Map.class) : YAML.load(file, Map.class);
+    }
+
+    @Override
+    public String toString() {
+      return resource != null ? "bundled sample " + name() : file.toString();
+    }
+  }
+
+  static List<Path> files(Path root) {
+    return contributions(List.of(Ref.of(root)), new HashMap<>()).stream()
+      .filter(ref -> !ref.bundled())
+      .map(Ref::file)
+      .toList();
+  }
+
+  static List<Path> exampleFiles(Path root) {
+    Map<Ref, SchemaConfig> parsed = new HashMap<>();
+    List<Path> result = new ArrayList<>();
+    for (var ref : contributions(List.of(Ref.of(root)), parsed)) {
+      if (parsed.get(ref).examples() instanceof String reference) {
+        var spec = ref.examples(reference);
+        if (!spec.bundled()) {
+          result.add(spec.file());
+        }
+      }
+    }
+    return result;
+  }
+
+  private static List<Ref> contributions(List<Ref> roots, Map<Ref, SchemaConfig> parsed) {
+    List<Ref> result = new ArrayList<>();
+    for (var root : roots) {
+      collect(root, result, new ArrayDeque<>(), parsed);
+    }
+    return result;
+  }
+
+  private static void collect(Ref ref, List<Ref> result, Deque<Ref> stack, Map<Ref, SchemaConfig> parsed) {
+    if (stack.contains(ref)) {
+      var cycle = new ArrayList<>(stack);
+      Collections.reverse(cycle);
+      cycle.add(ref);
+      throw new ParseException("Schema extends cycle: " +
+        cycle.stream().map(Ref::name).collect(Collectors.joining(" -> ")));
+    }
+    if (result.contains(ref)) {
+      return;
+    }
+    if (!ref.exists()) {
+      throw new ParseException("Schema file not found: " + ref + (stack.isEmpty() ? "" :
+        " (extended from " + stack.peek().name() + ")"));
+    }
+    var config = parsed.computeIfAbsent(ref, Ref::parse);
+    stack.push(ref);
+    for (String parent : config.parents()) {
+      collect(ref.parent(parent), result, stack, parsed);
+    }
+    stack.pop();
+    result.add(ref);
+  }
+
+  static SchemaConfig load(Path root) {
+    Map<Ref, SchemaConfig> parsed = new HashMap<>();
+    List<Ref> refs = contributions(List.of(Ref.of(root)), parsed);
+    if (refs.size() == 1) {
+      return SchemaConfig.EMPTY.mergeFrom(parsed.get(refs.get(0)));
+    }
+    return fold(refs, parsed);
+  }
+
+  static SchemaConfig load(List<Path> roots) {
+    if (roots.size() == 1) {
+      return load(roots.get(0));
+    }
+    return loadWithInlineExamples(roots);
+  }
+
+  static SchemaConfig loadWithInlineExamples(List<Path> roots) {
+    if (roots.isEmpty()) {
+      throw new IllegalArgumentException("No schema file given");
+    }
+    Map<Ref, SchemaConfig> parsed = new HashMap<>();
+    return fold(contributions(roots.stream().map(Ref::of).toList(), parsed), parsed);
+  }
+
+  static SchemaConfig compose(SchemaConfig config) {
+    if (config.parents().isEmpty()) {
+      return SchemaConfig.EMPTY.mergeFrom(config);
+    }
+    Map<Ref, SchemaConfig> parsed = new HashMap<>();
+    List<Ref> roots = new ArrayList<>();
+    for (String parent : config.parents()) {
+      var path = Path.of(parent);
+      if (!path.isAbsolute() && SchemaComposer.class.getResource(SAMPLES + parent) == null) {
+        throw new ParseException("Cannot resolve relative schema " + parent + " without a schema file");
+      }
+      roots.add(path.isAbsolute() ? Ref.of(path) : new Ref(null, SAMPLES + parent));
+    }
+    return fold(contributions(roots, parsed), parsed).mergeFrom(inlineExamples(config, null));
+  }
+
+  private static SchemaConfig fold(List<Ref> refs, Map<Ref, SchemaConfig> parsed) {
+    SchemaConfig result = SchemaConfig.EMPTY;
+    for (var ref : refs) {
+      result = result.mergeFrom(inlineExamples(parsed.get(ref), ref));
+    }
+    return result;
+  }
+
+  private static SchemaConfig inlineExamples(SchemaConfig config, Ref ref) {
+    if (config.examples() instanceof String reference) {
+      var path = Path.of(reference);
+      if (ref == null && !path.isAbsolute()) {
+        throw new ParseException("Cannot resolve relative examples " + reference + " without a schema file");
+      }
+      var spec = (ref == null ? Ref.ofFile(path) : ref.examples(reference)).parseSpecification();
+      return config.withExamples(spec == null ? List.of() : spec.get("examples"));
+    }
+    return config;
+  }
+
+  private static Path canonical(Path path) {
+    return path.toAbsolutePath().normalize();
+  }
+}
