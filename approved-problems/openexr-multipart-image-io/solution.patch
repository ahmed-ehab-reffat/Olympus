+
+Box2i
+flatTileStagingWindow (
+    TiledInputPart& part,
+    const Box2i&    window,
+    int&            dx1,
+    int&            dx2,
+    int&            dy1,
+    int&            dy2)
+{
+    const Box2i& source = part.header ().dataWindow ();
+    dx1                 = (window.min.x - source.min.x) / part.tileXSize ();
+    dx2                 = (window.max.x - source.min.x) / part.tileXSize ();
+    dy1                 = (window.min.y - source.min.y) / part.tileYSize ();
+    dy2                 = (window.max.y - source.min.y) / part.tileYSize ();
+    return Box2i (
+        part.dataWindowForTile (dx1, dy1).min,
+        part.dataWindowForTile (dx2, dy2).max);
+}
