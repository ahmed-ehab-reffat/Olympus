+void
+loadFlatScanLineWindow (
+    MultiPartInputFile& in,
+    int                 partNumber,
+    const Box2i&        window,
+    FlatImage&          image)
+{
+    const Header& header = in.header (partNumber);
+    const Box2i   stagingWindow (
+        V2i (header.dataWindow ().min.x, window.min.y),
+        V2i (header.dataWindow ().max.x, window.max.y));
+    FlatImage staging;
+    prepareWindowImage (staging, header, stagingWindow);
+    FrameBuffer frameBuffer;
+    for (FlatImageLevel::ConstIterator i = staging.level ().begin ();
+         i != staging.level ().end ();
+         ++i)
+        frameBuffer.insert (i.name (), i.channel ().slice ());
+    InputPart part (in, partNumber);
+    part.setFrameBuffer (frameBuffer);
+    part.readPixels (window.min.y, window.max.y);
+    copyFlatWindow (staging, image, header, window);
+}
