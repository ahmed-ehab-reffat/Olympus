+void
+saveImages (
+    const string& fileName, const ImageParts& parts, DataWindowSource dws)
+{
+    vector<Header>      headers = headersForParts (parts, dws);
+    MultiPartOutputFile out (
+        fileName.c_str (), headers.data (), static_cast<int> (headers.size ()));
+    writeImageParts (out, parts, headers);
+}
+
+void
+saveImages (OStream& stream, const ImageParts& parts, DataWindowSource dws)
+{
+    vector<Header>      headers = headersForParts (parts, dws);
+    MultiPartOutputFile out (
+        stream, headers.data (), static_cast<int> (headers.size ()));
+    writeImageParts (out, parts, headers);
+}
+
+ImageParts
+loadImages (const string& fileName)
+{
+    MultiPartInputFile in = openMultipartInput (fileName);
+    return loadImageParts (in);
+}
+
+ImageParts
+loadImages (IStream& stream)
+{
+    MultiPartInputFile in (
+        stream.fileName (),
+        ContextInitializer ()
+            .silentHeaderParse (true)
+            .strictHeaderValidation (false)
+            .setInputStream (&stream),
+        globalThreadCount (),
+        true);
+    return loadImageParts (in);
+}
+
+ImagePart
+loadImagePart (const string& fileName, const string& partName)
+{
+    MultiPartInputFile in = openMultipartInput (fileName);
+    return loadNamedImagePart (in, partName);
+}
+
+ImagePart
+loadImagePart (IStream& stream, const string& partName)
+{
+    MultiPartInputFile in (
+        stream.fileName (),
+        ContextInitializer ()
+            .silentHeaderParse (true)
+            .strictHeaderValidation (false)
+            .setInputStream (&stream),
+        globalThreadCount (),
+        true);
+    return loadNamedImagePart (in, partName);
+}
+
+ImagePart
+loadImagePart (
+    const string& fileName, const string& partName, const Box2i& dataWindow)
+{
+    MultiPartInputFile input = openMultipartInput (fileName);
+    return loadNamedImagePart (input, partName, dataWindow);
+}
+
+ImagePart
+loadImagePart (IStream& stream, const string& partName, const Box2i& dataWindow)
+{
+    MultiPartInputFile input (
+        stream.fileName (),
+        ContextInitializer ()
+            .silentHeaderParse (true)
+            .strictHeaderValidation (false)
+            .setInputStream (&stream),
+        globalThreadCount (),
+        true);
+    return loadNamedImagePart (input, partName, dataWindow);
+}
+
+void
+rewriteImages (
+    const string&     inputFileName,
+    const string&     outputFileName,
+    const ImageParts& replacements,
+    DataWindowSource  dws)
+{
+    if (inputFileName == outputFileName)
+        throw ArgExc ("Input and output image filenames must be different.");
+
+    bool       tiled, deep, multiPart;
+    const bool flatSingle =
+        isOpenExrFile (inputFileName.c_str (), tiled, deep, multiPart) &&
+        !deep && !multiPart;
+    Header exactHeader;
+    if (flatSingle) exactHeader = flatSingleHeader (inputFileName, tiled);
+
+    MultiPartInputFile  input = openMultipartInput (inputFileName);
+    vector<RewritePart> plan  = prepareRewrite (input, replacements, dws);
+    if (flatSingle && !exactHeader.hasType () && !plan.front ().replacement)
+    {
+        copyFlatSingle (inputFileName, outputFileName, exactHeader, tiled);
+        return;
+    }
+    StdOFStream output (outputFileName.c_str ());
+    writeRewrite (input, output, plan);
+}
+
+void
+rewriteImages (
+    IStream&          inputStream,
+    OStream&          outputStream,
+    const ImageParts& replacements,
+    DataWindowSource  dws)
+{
+    bool       tiled, deep, multiPart;
+    const bool flatSingle =
+        isOpenExrFile (inputStream, tiled, deep, multiPart) && !deep &&
+        !multiPart;
+    Header exactHeader;
+    if (flatSingle) exactHeader = flatSingleHeader (inputStream, tiled);
+
+    {
+        MultiPartInputFile input (
+            inputStream.fileName (),
+            ContextInitializer ()
+                .silentHeaderParse (true)
+                .strictHeaderValidation (false)
+                .setInputStream (&inputStream),
+            globalThreadCount (),
+            true);
+        vector<RewritePart> plan = prepareRewrite (input, replacements, dws);
+        if (!flatSingle || exactHeader.hasType () || plan.front ().replacement)
+        {
+            writeRewrite (input, outputStream, plan);
+            return;
+        }
+    }
+
+    copyFlatSingle (inputStream, outputStream, exactHeader, tiled);
+}
