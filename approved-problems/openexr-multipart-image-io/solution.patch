+Box2i
+intersectWindow (const Box2i& a, const Box2i& b)
+{
+    Box2i result (
+        V2i (std::max (a.min.x, b.min.x), std::max (a.min.y, b.min.y)),
+        V2i (std::min (a.max.x, b.max.x), std::min (a.max.y, b.max.y)));
+    if (result.min.x > result.max.x || result.min.y > result.max.y)
+        throw ArgExc ("The requested data window does not intersect the part.");
+    return result;
+}
