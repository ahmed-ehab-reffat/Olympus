+Header
+headerForPart (const ImagePart& part, DataWindowSource dws)
+{
+    if (!part.image)
+        throw ArgExc ("Cannot save an image part without an image.");
+
+    const Image& img = *part.image;
+    Header       hdr;
+
+    for (Header::ConstIterator i = part.header.begin ();
+         i != part.header.end ();
+         ++i)
+    {
+        if (strcmp (i.name (), "channels") &&
+            strcmp (i.name (), "dataWindow") && strcmp (i.name (), "tiles") &&
+            strcmp (i.name (), "type"))
+        {
+            hdr.insert (i.name (), i.attribute ());
+        }
+    }
+
+    hdr.dataWindow () = dataWindowForFile (part.header, img, dws);
+
+    const bool tiled = img.levelMode () != ONE_LEVEL ||
+                       part.header.hasTileDescription ();
+
+    if (tiled)
+    {
+        if (part.header.hasTileDescription ())
+        {
+            hdr.setTileDescription (TileDescription (
+                part.header.tileDescription ().xSize,
+                part.header.tileDescription ().ySize,
+                img.levelMode (),
+                img.levelRoundingMode ()));
+        }
+        else
+        {
+            hdr.setTileDescription (TileDescription (
+                64, 64, img.levelMode (), img.levelRoundingMode ()));
+        }
+    }
+
+    if (const FlatImage* fimg = dynamic_cast<const FlatImage*> (&img))
+    {
+        const FlatImageLevel& level = fimg->level (0, 0);
+        for (FlatImageLevel::ConstIterator i = level.begin ();
+             i != level.end ();
+             ++i)
+            hdr.channels ().insert (i.name (), i.channel ().channel ());
+
+        hdr.setType (tiled ? TILEDIMAGE : SCANLINEIMAGE);
+    }
+    else if (const DeepImage* dimg = dynamic_cast<const DeepImage*> (&img))
+    {
+        const DeepImageLevel& level = dimg->level (0, 0);
+        for (DeepImageLevel::ConstIterator i = level.begin ();
+             i != level.end ();
+             ++i)
+            hdr.channels ().insert (i.name (), i.channel ().channel ());
+
+        hdr.compression () = ZIPS_COMPRESSION;
+        hdr.setType (tiled ? DEEPTILE : DEEPSCANLINE);
+    }
+    else
+    {
+        throw ArgExc ("Cannot save an unsupported image type.");
+    }
+
+    return hdr;
+}
