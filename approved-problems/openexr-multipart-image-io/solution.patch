+//
+// An ImagePart owns the header and image data for one part in an image file.
+// ImageParts stores parts in file order.
+//
+
+struct ImagePart
+{
+    ImagePart (Header h, std::unique_ptr<Image> i)
+        : header (std::move (h)), image (std::move (i))
+    {}
+
+    ImagePart (ImagePart&&) noexcept            = default;
+    ImagePart& operator= (ImagePart&&) noexcept = default;
+
+    ImagePart (const ImagePart&)            = delete;
+    ImagePart& operator= (const ImagePart&) = delete;
+
+    Header                 header;
+    std::unique_ptr<Image> image;
+};
+
+using ImageParts = std::vector<ImagePart>;
