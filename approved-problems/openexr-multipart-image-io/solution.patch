+template <class T>
+void
+copyFlatChannel (
+    const FlatImageLevel& source,
+    FlatImageLevel&       target,
+    const string&         name,
+    const Channel&        channel,
+    const Box2i&          window)
+{
+    const TypedFlatImageChannel<T>& input  = source.typedChannel<T> (name);
+    TypedFlatImageChannel<T>&       output = target.typedChannel<T> (name);
+    for (int y = window.min.y; y <= window.max.y; ++y)
+        for (int x = window.min.x; x <= window.max.x; ++x)
+            if (x % channel.xSampling == 0 && y % channel.ySampling == 0)
+                output.at (x, y) = input.at (x, y);
+}
+
+void
+copyFlatWindow (
+    const FlatImage& source,
+    FlatImage&       target,
+    const Header&    header,
+    const Box2i&     window)
+{
+    prepareWindowImage (target, header, window);
+    for (ChannelList::ConstIterator i = header.channels ().begin ();
+         i != header.channels ().end ();
+         ++i)
+    {
+        if (i.channel ().type == HALF)
+            copyFlatChannel<half> (
+                source.level (),
+                target.level (),
+                i.name (),
+                i.channel (),
+                window);
+        else if (i.channel ().type == FLOAT)
+            copyFlatChannel<float> (
+                source.level (),
+                target.level (),
+                i.name (),
+                i.channel (),
+                window);
+        else
+            copyFlatChannel<unsigned int> (
+                source.level (),
+                target.level (),
+                i.name (),
+                i.channel (),
+                window);
+    }
+}
+
+template <class T>
+void
+copyDeepChannel (
+    const DeepImageLevel& source,
+    DeepImageLevel&       target,
+    const string&         name,
+    const Box2i&          window)
+{
+    const TypedDeepImageChannel<T>& input  = source.typedChannel<T> (name);
+    TypedDeepImageChannel<T>&       output = target.typedChannel<T> (name);
+    for (int y = window.min.y; y <= window.max.y; ++y)
+        for (int x = window.min.x; x <= window.max.x; ++x)
+            for (unsigned int s = 0; s < target.sampleCounts ().at (x, y); ++s)
+                output.at (x, y)[s] = input.at (x, y)[s];
+}
+
+void
+copyDeepWindow (
+    const DeepImage& source,
+    DeepImage&       target,
+    const Header&    header,
+    const Box2i&     window)
+{
+    prepareWindowImage (target, header, window);
+    const DeepImageLevel& input  = source.level ();
+    DeepImageLevel&       output = target.level ();
+    for (int y = window.min.y; y <= window.max.y; ++y)
+        for (int x = window.min.x; x <= window.max.x; ++x)
+            output.sampleCounts ().set (x, y, input.sampleCounts ().at (x, y));
+
+    for (ChannelList::ConstIterator i = header.channels ().begin ();
+         i != header.channels ().end ();
+         ++i)
+    {
+        if (i.channel ().type == HALF)
+            copyDeepChannel<half> (input, output, i.name (), window);
+        else if (i.channel ().type == FLOAT)
+            copyDeepChannel<float> (input, output, i.name (), window);
+        else
+            copyDeepChannel<unsigned int> (input, output, i.name (), window);
+    }
+}
