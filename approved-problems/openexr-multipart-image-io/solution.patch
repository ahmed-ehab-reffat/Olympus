+vector<Header>
+headersForParts (const ImageParts& parts, DataWindowSource dws)
+{
+    if (parts.empty ()) throw ArgExc ("Cannot save an empty image collection.");
+
+    vector<Header> headers;
+    headers.reserve (parts.size ());
+    set<string> names;
+
+    for (const ImagePart& part: parts)
+    {
+        Header hdr = headerForPart (part, dws);
+        if (!hdr.hasName () || hdr.name ().empty ())
+            throw ArgExc ("Each image part must have a name.");
+        if (!names.insert (hdr.name ()).second)
+            throw ArgExc ("Image part names must be unique.");
+        headers.push_back (std::move (hdr));
+    }
+
+    return headers;
+}
+
+void
+writeImageParts (
+    MultiPartOutputFile&  out,
+    const ImageParts&     parts,
+    const vector<Header>& headers)
+{
+    for (size_t i = 0; i < parts.size (); ++i)
+    {
+        const Image& img = *parts[i].image;
+        if (const FlatImage* fimg = dynamic_cast<const FlatImage*> (&img))
+        {
+            if (headers[i].hasTileDescription ())
+                saveFlatTiledPart (out, static_cast<int> (i), *fimg);
+            else
+                saveFlatScanLinePart (out, static_cast<int> (i), *fimg);
+        }
+        else if (const DeepImage* dimg = dynamic_cast<const DeepImage*> (&img))
+        {
+            if (headers[i].hasTileDescription ())
+                saveDeepTiledPart (out, static_cast<int> (i), *dimg);
+            else
+                saveDeepScanLinePart (out, static_cast<int> (i), *dimg);
+        }
+    }
+}
+
+void
+writeImagePart (
+    MultiPartOutputFile& out,
+    int                  partNumber,
+    const ImagePart&     part,
+    const Header&        header)
+{
+    const Image& image = *part.image;
+    if (const FlatImage* flat = dynamic_cast<const FlatImage*> (&image))
+    {
+        if (header.hasTileDescription ())
+            saveFlatTiledPart (out, partNumber, *flat);
+        else
+            saveFlatScanLinePart (out, partNumber, *flat);
+    }
+    else
+    {
+        const DeepImage& deep = static_cast<const DeepImage&> (image);
+        if (header.hasTileDescription ())
+            saveDeepTiledPart (out, partNumber, deep);
+        else
+            saveDeepScanLinePart (out, partNumber, deep);
+    }
+}
+
+ImagePart
+loadImagePartAt (MultiPartInputFile& in, int partNumber)
+{
+    const Header& hdr = in.header (partNumber);
+    if (!hdr.hasType () || !isSupportedType (hdr.type ()))
+        throw ArgExc ("Cannot load a non-image part.");
+
+    if (hdr.type () == SCANLINEIMAGE)
+    {
+        std::unique_ptr<FlatImage> img (new FlatImage);
+        loadFlatScanLinePart (in, partNumber, *img);
+        return ImagePart (hdr, std::move (img));
+    }
+    if (hdr.type () == TILEDIMAGE)
+    {
+        std::unique_ptr<FlatImage> img (new FlatImage);
+        loadFlatTiledPart (in, partNumber, *img);
+        return ImagePart (hdr, std::move (img));
+    }
+    if (hdr.type () == DEEPSCANLINE)
+    {
+        std::unique_ptr<DeepImage> img (new DeepImage);
+        loadDeepScanLinePart (in, partNumber, *img);
+        return ImagePart (hdr, std::move (img));
+    }
+
+    std::unique_ptr<DeepImage> img (new DeepImage);
+    loadDeepTiledPart (in, partNumber, *img);
+    return ImagePart (hdr, std::move (img));
+}
+
+ImagePart
+loadImagePartAtWindow (
+    MultiPartInputFile& in, int partNumber, const Box2i& requestedWindow)
+{
+    const Header& header = in.header (partNumber);
+    if (!header.hasType () || !isSupportedType (header.type ()))
+        throw ArgExc ("Cannot load a non-image part.");
+    if (header.hasTileDescription () &&
+        header.tileDescription ().mode != ONE_LEVEL)
+        throw ArgExc ("Windowed loading requires a ONE_LEVEL image part.");
+
+    const Box2i window =
+        intersectWindow (header.dataWindow (), requestedWindow);
+    Header outputHeader (header);
+    outputHeader.dataWindow () = window;
+
+    if (header.type () == SCANLINEIMAGE)
+    {
+        std::unique_ptr<FlatImage> image (new FlatImage);
+        loadFlatScanLineWindow (in, partNumber, window, *image);
+        return ImagePart (outputHeader, std::move (image));
+    }
+    if (header.type () == TILEDIMAGE)
+    {
+        std::unique_ptr<FlatImage> image (new FlatImage);
+        loadFlatTiledWindow (in, partNumber, window, *image);
+        return ImagePart (outputHeader, std::move (image));
+    }
+    if (header.type () == DEEPSCANLINE)
+    {
+        std::unique_ptr<DeepImage> image (new DeepImage);
+        loadDeepScanLineWindow (in, partNumber, window, *image);
+        return ImagePart (outputHeader, std::move (image));
+    }
+
+    std::unique_ptr<DeepImage> image (new DeepImage);
+    loadDeepTiledWindow (in, partNumber, window, *image);
+    return ImagePart (outputHeader, std::move (image));
+}
+
+ImageParts
+loadImageParts (MultiPartInputFile& in)
+{
+    ImageParts parts;
+    parts.reserve (in.parts ());
+
+    for (int i = 0; i < in.parts (); ++i)
+    {
+        const Header& header = in.header (i);
+        if (header.hasType () && isSupportedType (header.type ()))
+            parts.push_back (loadImagePartAt (in, i));
+    }
+
+    return parts;
+}
+
+ImagePart
+loadNamedImagePart (MultiPartInputFile& in, const string& partName)
+{
+    for (int i = 0; i < in.parts (); ++i)
+    {
+        const Header& hdr = in.header (i);
+        if (hdr.hasName () && hdr.name () == partName)
+            return loadImagePartAt (in, i);
+    }
+
+    throw ArgExc ("No image part has the requested name.");
+}
+
+ImagePart
+loadNamedImagePart (
+    MultiPartInputFile& in, const string& partName, const Box2i& dataWindow)
+{
+    for (int i = 0; i < in.parts (); ++i)
+    {
+        const Header& header = in.header (i);
+        if (header.hasName () && header.name () == partName)
+            return loadImagePartAtWindow (in, i, dataWindow);
+    }
+    throw ArgExc ("No image part has the requested name.");
+}
+
+struct RewritePart
+{
+    int              sourcePart;
+    const ImagePart* replacement;
+    Header           header;
+};
+
+vector<RewritePart>
+prepareRewrite (
+    MultiPartInputFile& in,
+    const ImageParts&   replacements,
+    DataWindowSource    dws)
+{
+    vector<Header> prepared;
+    prepared.reserve (replacements.size ());
+    set<string> replacementNames;
+
+    for (const ImagePart& replacement: replacements)
+    {
+        Header header = headerForPart (replacement, dws);
+        if (header.dataWindow ().min.x > header.dataWindow ().max.x ||
+            header.dataWindow ().min.y > header.dataWindow ().max.y)
+            throw ArgExc (
+                "Replacement header and image data windows do not intersect.");
+        if (!header.hasName () || header.name ().empty ())
+            throw ArgExc ("Each replacement image part must have a name.");
+        if (!replacementNames.insert (header.name ()).second)
+            throw ArgExc ("Replacement image part names must be unique.");
+        prepared.push_back (std::move (header));
+    }
+
+    vector<bool>        used (replacements.size (), false);
+    vector<RewritePart> result;
+    set<string>         sourceNames;
+
+    for (int sourcePart = 0; sourcePart < in.parts (); ++sourcePart)
+    {
+        const Header& sourceHeader = in.header (sourcePart);
+        if (!sourceHeader.hasType () || !isSupportedType (sourceHeader.type ()))
+            continue;
+
+        const bool named =
+            sourceHeader.hasName () && !sourceHeader.name ().empty ();
+        if (named && !sourceNames.insert (sourceHeader.name ()).second)
+            throw ArgExc ("Source image part names must be unique.");
+
+        const ImagePart* replacement = nullptr;
+        Header           outputHeader (sourceHeader);
+        for (size_t i = 0; i < replacements.size (); ++i)
+        {
+            if (named && prepared[i].name () == sourceHeader.name ())
+            {
+                replacement  = &replacements[i];
+                outputHeader = prepared[i];
+                used[i]      = true;
+                break;
+            }
+        }
+
+        result.push_back (
+            RewritePart{sourcePart, replacement, std::move (outputHeader)});
+    }
+
+    if (result.empty ())
+        throw ArgExc ("The source contains no supported image parts.");
+    for (bool matched: used)
+        if (!matched)
+            throw ArgExc (
+                "A replacement name does not match a supported part.");
+
+    return result;
+}
+
+void
+copyImagePart (
+    MultiPartInputFile&  input,
+    MultiPartOutputFile& output,
+    int                  inputPart,
+    int                  outputPart,
+    const string&        type)
+{
+    if (type == SCANLINEIMAGE)
+    {
+        InputPart  in (input, inputPart);
+        OutputPart out (output, outputPart);
+        out.copyPixels (in);
+    }
+    else if (type == TILEDIMAGE)
+    {
+        TiledInputPart  in (input, inputPart);
+        TiledOutputPart out (output, outputPart);
+        out.copyPixels (in);
+    }
+    else if (type == DEEPSCANLINE)
+    {
+        DeepScanLineInputPart  in (input, inputPart);
+        DeepScanLineOutputPart out (output, outputPart);
+        out.copyPixels (in);
+    }
+    else
+    {
+        DeepTiledInputPart  in (input, inputPart);
+        DeepTiledOutputPart out (output, outputPart);
+        out.copyPixels (in);
+    }
+}
+
+Header
+flatSingleHeader (const string& fileName, bool tiled)
+{
+    if (tiled)
+    {
+        TiledInputFile input (fileName.c_str ());
+        return input.header ();
+    }
+
+    InputFile input (fileName.c_str ());
+    return input.header ();
+}
+
+Header
+flatSingleHeader (IStream& stream, bool tiled)
+{
+    Header header;
+    if (tiled)
+    {
+        TiledInputFile input (stream);
+        header = input.header ();
+    }
+    else
+    {
+        InputFile input (stream);
+        header = input.header ();
+    }
+    stream.seekg (0);
+    return header;
+}
+
+void
+copyFlatSingle (
+    const string& inputFileName,
+    const string& outputFileName,
+    const Header& header,
+    bool          tiled)
+{
+    if (tiled)
+    {
+        TiledInputFile  input (inputFileName.c_str ());
+        TiledOutputFile output (outputFileName.c_str (), header);
+        output.copyPixels (input);
+    }
+    else
+    {
+        InputFile  input (inputFileName.c_str ());
+        OutputFile output (outputFileName.c_str (), header);
+        output.copyPixels (input);
+    }
+}
+
+void
+copyFlatSingle (
+    IStream&      inputStream,
+    OStream&      outputStream,
+    const Header& header,
+    bool          tiled)
+{
+    inputStream.seekg (0);
+    if (tiled)
+    {
+        TiledInputFile  input (inputStream);
+        TiledOutputFile output (outputStream, header);
+        output.copyPixels (input);
+    }
+    else
+    {
+        InputFile  input (inputStream);
+        OutputFile output (outputStream, header);
+        output.copyPixels (input);
+    }
+}
+
+void
+writeRewrite (
+    MultiPartInputFile& input, OStream& output, const vector<RewritePart>& plan)
+{
+    vector<Header> headers;
+    headers.reserve (plan.size ());
+    for (const RewritePart& part: plan)
+        headers.push_back (part.header);
+
+    MultiPartOutputFile out (
+        output, headers.data (), static_cast<int> (headers.size ()), false);
+
+    for (size_t i = 0; i < plan.size (); ++i)
+    {
+        const RewritePart& part = plan[i];
+        if (part.replacement)
+            writeImagePart (
+                out, static_cast<int> (i), *part.replacement, part.header);
+        else
+            copyImagePart (
+                input,
+                out,
+                part.sourcePart,
+                static_cast<int> (i),
+                input.header (part.sourcePart).type ());
+    }
+}
+
+MultiPartInputFile
+openMultipartInput (const string& fileName)
+{
+    return MultiPartInputFile (
+        fileName.c_str (),
+        ContextInitializer ().silentHeaderParse (true).strictHeaderValidation (
+            false),
+        globalThreadCount (),
+        true);
+}
