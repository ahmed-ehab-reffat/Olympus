+
+void
+saveFlatTiledPart (
+    MultiPartOutputFile& out, int partNumber, const FlatImage& img)
+{
+    TiledOutputPart part (out, partNumber);
+
+    switch (img.levelMode ())
+    {
+        case ONE_LEVEL: saveFlatTiledLevel (part, img, 0, 0); break;
+
+        case MIPMAP_LEVELS:
+            for (int x = 0; x < part.numLevels (); ++x)
+                saveFlatTiledLevel (part, img, x, x);
+            break;
+
+        case RIPMAP_LEVELS:
+            for (int y = 0; y < part.numYLevels (); ++y)
+                for (int x = 0; x < part.numXLevels (); ++x)
+                    saveFlatTiledLevel (part, img, x, y);
+            break;
+
+        default: assert (false);
+    }
+}
