+ImageParts
+makeHeterogeneousParts ()
+{
+    const Box2i display (V2i (0, 0), V2i (7, 5));
+    const Box2i pixels (V2i (0, 0), V2i (7, 5));
+    ImageParts  parts;
+    parts.emplace_back (
+        makeHeader ("flat-scan", display, false),
+        makeFlat (pixels, ONE_LEVEL, 10));
+    parts.emplace_back (
+        makeHeader ("flat-ripmap", display, true),
+        makeFlat (pixels, RIPMAP_LEVELS, 20));
+    parts.emplace_back (
+        makeHeader ("flat-mipmap", display, false),
+        makeFlat (pixels, MIPMAP_LEVELS, 25, ROUND_UP));
+    parts.emplace_back (
+        makeHeader ("deep-scan", display, false),
+        makeDeep (pixels, ONE_LEVEL, 30));
+    parts.emplace_back (
+        makeHeader ("deep-mipmap", display, true),
+        makeDeep (pixels, MIPMAP_LEVELS, 40, ROUND_UP));
+    parts.emplace_back (
+        makeHeader ("deep-ripmap", display, true),
+        makeDeep (pixels, RIPMAP_LEVELS, 45));
+    parts.emplace_back (
+        makeHeader ("deep-tiled-one", display, true),
+        makeDeep (pixels, ONE_LEVEL, 50));
+    parts[0].header.dataWindow ()  = Box2i (V2i (1, 1), V2i (6, 4));
+    parts[0].header.compression () = PIZ_COMPRESSION;
+    return parts;
+}
