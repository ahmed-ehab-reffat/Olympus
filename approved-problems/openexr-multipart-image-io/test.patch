+void
+testSinglePartLoad (const string& prefix)
+{
+    const string      file = prefix + "-single.exr";
+    unique_ptr<Image> expected =
+        makeFlat (Box2i (V2i (0, 0), V2i (6, 4)), MIPMAP_LEVELS, 90, ROUND_UP);
+    saveImage (file, *expected);
+
+    Header exactSourceHeader;
+    {
+        TiledInputFile input (file.c_str ());
+        exactSourceHeader = input.header ();
+    }
+    require (!exactSourceHeader.hasName (), "legacy single source is unnamed");
+    require (!exactSourceHeader.hasType (), "legacy single source is typeless");
+
+    ImageParts loaded = loadImages (file);
+    require (loaded.size () == 1, "single input returns one part");
+    compareHeaderIgnoringType (
+        loaded[0].header, exactSourceHeader, "single input header");
+    compareImage (*loaded[0].image, *expected, "single producer");
+
+    ImageParts   noReplacements;
+    const string rewrittenFile = prefix + "-single-rewritten.exr";
+    rewriteImages (file, rewrittenFile, noReplacements);
+    {
+        TiledInputFile rewrittenInput (rewrittenFile.c_str ());
+        require (
+            !rewrittenInput.header ().hasType (),
+            "single filename rewrite remains typeless");
+        compareHeader (
+            rewrittenInput.header (),
+            exactSourceHeader,
+            "single filename exact header");
+    }
+    ImageParts rewritten = loadImages (rewrittenFile);
+    require (rewritten.size () == 1, "single filename rewrite count");
+    compareHeaderIgnoringType (
+        rewritten[0].header,
+        exactSourceHeader,
+        "single filename rewrite header");
+    compareImage (
+        *rewritten[0].image, *expected, "single filename rewrite samples");
+
+    const vector<char> sourceBytes = readBytes (file);
+    MemoryInputStream  streamInput (sourceBytes);
+    MemoryOutputStream streamOutput;
+    rewriteImages (streamInput, streamOutput, noReplacements);
+    MemoryInputStream exactRewrittenInput (streamOutput.bytes ());
+    TiledInputFile    exactRewritten (exactRewrittenInput);
+    require (
+        !exactRewritten.header ().hasType (),
+        "single stream rewrite remains typeless");
+    compareHeader (
+        exactRewritten.header (),
+        exactSourceHeader,
+        "single stream exact header");
+    MemoryInputStream rewrittenInput (streamOutput.bytes ());
+    ImageParts        streamRewritten = loadImages (rewrittenInput);
+    require (streamRewritten.size () == 1, "single stream rewrite count");
+    compareHeaderIgnoringType (
+        streamRewritten[0].header,
+        exactSourceHeader,
+        "single stream rewrite header");
+    compareImage (
+        *streamRewritten[0].image, *expected, "single stream rewrite samples");
+
+    const string namedFile = prefix + "-single-named.exr";
+    Header       namedSourceHeader (exactSourceHeader);
+    namedSourceHeader.setName ("legacy-named");
+    addComments (namedSourceHeader, "named typeless source");
+    saveImage (namedFile, namedSourceHeader, *expected);
+    {
+        TiledInputFile namedInput (namedFile.c_str ());
+        require (
+            namedInput.header ().hasName () &&
+                namedInput.header ().name () == "legacy-named",
+            "named legacy source keeps its name");
+        require (
+            !namedInput.header ().hasType (),
+            "named legacy source is typeless");
+    }
+
+    const Box2i replacementWindow (V2i (-2, 1), V2i (5, 6));
+    ImageParts  namedReplacements;
+    Header      namedReplacementHeader =
+        makeHeader ("legacy-named", replacementWindow, false);
+    namedReplacementHeader.lineOrder () = DECREASING_Y;
+    namedReplacementHeader.insert ("replacementToken", IntAttribute (406));
+    namedReplacements.emplace_back (
+        namedReplacementHeader, makeFlat (replacementWindow, ONE_LEVEL, 610));
+
+    MemoryOutputStream expectedNamedOutput;
+    saveImages (expectedNamedOutput, namedReplacements);
+    MemoryInputStream expectedNamedInput (expectedNamedOutput.bytes ());
+    ImageParts        expectedNamed = loadImages (expectedNamedInput);
+    require (expectedNamed.size () == 1, "named replacement save count");
+
+    const string namedRewrittenFile = prefix + "-single-named-rewritten.exr";
+    rewriteImages (namedFile, namedRewrittenFile, namedReplacements);
+    ImageParts namedRewritten = loadImages (namedRewrittenFile);
+    require (namedRewritten.size () == 1, "named filename rewrite count");
+    compareHeader (
+        namedRewritten[0].header,
+        expectedNamed[0].header,
+        "named filename replacement header");
+    compareImage (
+        *namedRewritten[0].image,
+        *namedReplacements[0].image,
+        "named filename replacement samples");
+
+    const vector<char> namedSourceBytes = readBytes (namedFile);
+    MemoryInputStream  namedStreamInput (namedSourceBytes);
+    MemoryOutputStream namedStreamOutput;
+    rewriteImages (namedStreamInput, namedStreamOutput, namedReplacements);
+    MemoryInputStream namedResultInput (namedStreamOutput.bytes ());
+    ImageParts        namedStreamRewritten = loadImages (namedResultInput);
+    require (namedStreamRewritten.size () == 1, "named stream rewrite count");
+    compareHeader (
+        namedStreamRewritten[0].header,
+        expectedNamed[0].header,
+        "named stream replacement header");
+    compareImage (
+        *namedStreamRewritten[0].image,
+        *namedReplacements[0].image,
+        "named stream replacement samples");
+
+    remove (namedRewrittenFile.c_str ());
+    remove (namedFile.c_str ());
+
+    remove (rewrittenFile.c_str ());
+    remove (file.c_str ());
+}
