+void
+testUtf8Filename (const string& prefix)
+{
+    const string fileName =
+        prefix + "-\xe7\x94\xbb\xe5\x83\x8f-\xc3\xa9-\xd1\x84.exr";
+    const string rewrittenName =
+        prefix + "-\xd1\x84-\xc3\xa9-\xe7\x94\xbb\xe5\x83\x8f-rewritten.exr";
+    const Box2i window (V2i (0, 0), V2i (7, 5));
+    ImageParts  source;
+    source.emplace_back (
+        makeHeader ("utf8-flat", window, false),
+        makeFlat (window, ONE_LEVEL, 160));
+    source.emplace_back (
+        makeHeader ("utf8-deep", window, true),
+        makeDeep (window, MIPMAP_LEVELS, 170, ROUND_UP));
+
+    removeUtf8File (fileName);
+    saveImages (fileName, source);
+
+    MultiPartInputFile lowLevel (fileName.c_str ());
+    require (lowLevel.parts () == 2, "UTF-8 filename low-level part count");
+    require (
+        lowLevel.header (0).name () == "utf8-flat" &&
+            lowLevel.header (1).name () == "utf8-deep",
+        "UTF-8 filename low-level names");
+
+    ImageParts loaded = loadImages (fileName);
+    require (loaded.size () == source.size (), "UTF-8 filename load count");
+    for (size_t i = 0; i < source.size (); ++i)
+    {
+        require (
+            loaded[i].header.name () == source[i].header.name (),
+            "UTF-8 filename load order/name");
+        compareImage (
+            *loaded[i].image, *source[i].image, "UTF-8 filename part");
+    }
+
+    ImagePart selected = loadImagePart (fileName, "utf8-deep");
+    require (
+        selected.header.name () == "utf8-deep", "UTF-8 filename selected name");
+    compareImage (
+        *selected.image, *source[1].image, "UTF-8 filename selected part");
+
+    const Box2i utf8Crop (V2i (1, 1), V2i (5, 3));
+    ImagePart   windowed = loadImagePart (fileName, "utf8-flat", utf8Crop);
+    Header      expectedWindowedHeader (loaded[0].header);
+    expectedWindowedHeader.dataWindow () = utf8Crop;
+    compareHeader (
+        windowed.header,
+        expectedWindowedHeader,
+        "UTF-8 filename windowed header");
+    unique_ptr<Image> expectedWindowed = makeFlat (utf8Crop, ONE_LEVEL, 160);
+    compareImage (
+        *windowed.image, *expectedWindowed, "UTF-8 filename windowed part");
+
+    ImageParts noReplacements;
+    removeUtf8File (rewrittenName);
+    rewriteImages (fileName, rewrittenName, noReplacements);
+    ImageParts rewritten = loadImages (rewrittenName);
+    require (rewritten.size () == source.size (), "UTF-8 rewrite part count");
+    for (size_t i = 0; i < source.size (); ++i)
+    {
+        require (
+            rewritten[i].header.name () == source[i].header.name (),
+            "UTF-8 rewrite order/name");
+        compareImage (
+            *rewritten[i].image, *source[i].image, "UTF-8 rewritten part");
+    }
+    removeUtf8File (rewrittenName);
+    removeUtf8File (fileName);
+}
