+void
+testStreamRoundTrip (const string& prefix)
+{
+    ImageParts         source = makeHeterogeneousParts ();
+    MemoryOutputStream output;
+    saveImages (output, source);
+    require (!output.bytes ().empty (), "stream save produced bytes");
+
+    ImageParts loaded;
+    {
+        MemoryInputStream input (output.bytes ());
+        loaded = loadImages (input);
+    }
+
+    require (loaded.size () == source.size (), "stream load part count");
+    for (size_t i = 0; i < loaded.size (); ++i)
+    {
+        require (
+            loaded[i].header.name () == source[i].header.name (),
+            "stream part order/name");
+        require (
+            comments (loaded[i].header) == comments (source[i].header),
+            "stream custom header");
+        compareImage (*loaded[i].image, *source[i].image, "stream part");
+    }
+
+    const size_t selectedIndexes[] = {0, 1, 3, 5};
+    for (size_t index: selectedIndexes)
+    {
+        ImagePart selected = [&] {
+            MemoryInputStream input (output.bytes ());
+            return loadImagePart (input, source[index].header.name ());
+        }();
+        require (
+            selected.header.name () == source[index].header.name (),
+            "stream selected name");
+        compareImage (
+            *selected.image, *source[index].image, "stream selected part");
+    }
+
+    MemoryInputStream missingInput (output.bytes ());
+    requireThrows (
+        [&] { loadImagePart (missingInput, "not-a-part"); },
+        "missing stream part must be rejected");
+
+    const Box2i cropPixels (V2i (-2, -2), V2i (5, 5));
+    const Box2i cropHeaderWindow (V2i (0, 0), V2i (7, 7));
+    ImageParts  cropSource;
+    Header cropHeader = makeHeader ("stream-crop", cropHeaderWindow, false);
+    cropHeader.dataWindow () = cropHeaderWindow;
+    cropSource.emplace_back (cropHeader, makeFlat (cropPixels, ONE_LEVEL, 140));
+    MemoryOutputStream cropOutput;
+    saveImages (cropOutput, cropSource, USE_HEADER_DATA_WINDOW);
+    MemoryInputStream cropInput (cropOutput.bytes ());
+    ImageParts        cropped = loadImages (cropInput);
+    const Box2i       expectedCrop (V2i (0, 0), V2i (5, 5));
+    require (
+        cropped[0].header.dataWindow () == expectedCrop,
+        "stream save honors header data window");
+    unique_ptr<Image> expectedCropped = makeFlat (expectedCrop, ONE_LEVEL, 140);
+    compareImage (*cropped[0].image, *expectedCropped, "stream cropped part");
+
+    const string      singleFile = prefix + "-stream-single.exr";
+    unique_ptr<Image> singleExpected =
+        makeFlat (Box2i (V2i (0, 0), V2i (6, 4)), MIPMAP_LEVELS, 150, ROUND_UP);
+    Header singleHeader (7, 5);
+    addComments (singleHeader, "stream-single-producer");
+    saveImage (singleFile, singleHeader, *singleExpected);
+    const vector<char> singleBytes = readBytes (singleFile);
+    remove (singleFile.c_str ());
+    MemoryInputStream singleInput (singleBytes);
+    ImageParts        singleLoaded = loadImages (singleInput);
+    require (singleLoaded.size () == 1, "stream single input part count");
+    require (
+        comments (singleLoaded[0].header) == "stream-single-producer",
+        "stream single input header");
+    compareImage (
+        *singleLoaded[0].image, *singleExpected, "stream single input samples");
+}
