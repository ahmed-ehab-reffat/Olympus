+unique_ptr<Image>
+makeFlat (
+    const Box2i&      window,
+    LevelMode         mode,
+    float             seed,
+    LevelRoundingMode rounding       = ROUND_DOWN,
+    bool              sampledChannel = false)
+{
+    unique_ptr<FlatImage> image (new FlatImage (window, mode, rounding));
+    image->insertChannel ("F", FLOAT);
+    image->insertChannel ("U", UINT, 1, 1, true);
+    if (sampledChannel) image->insertChannel ("S", HALF, 2, 2, true);
+
+    for (int ly = 0; ly < image->numYLevels (); ++ly)
+        for (int lx = 0; lx < image->numXLevels (); ++lx)
+        {
+            if (!validLevel (mode, lx, ly)) continue;
+            FlatImageLevel& level = image->level (lx, ly);
+            for (int y = level.dataWindow ().min.y;
+                 y <= level.dataWindow ().max.y;
+                 ++y)
+                for (int x = level.dataWindow ().min.x;
+                     x <= level.dataWindow ().max.x;
+                     ++x)
+                    level.typedChannel<float> ("F").at (x, y) =
+                        flatValue (seed, lx, ly, x, y);
+            for (int y = level.dataWindow ().min.y;
+                 y <= level.dataWindow ().max.y;
+                 ++y)
+                for (int x = level.dataWindow ().min.x;
+                     x <= level.dataWindow ().max.x;
+                     ++x)
+                    level.typedChannel<unsigned int> ("U").at (x, y) =
+                        uintValue (seed, lx, ly, x, y);
+            if (sampledChannel)
+                for (int y = level.dataWindow ().min.y;
+                     y <= level.dataWindow ().max.y;
+                     ++y)
+                    for (int x = level.dataWindow ().min.x;
+                         x <= level.dataWindow ().max.x;
+                         ++x)
+                        if (x % 2 == 0 && y % 2 == 0)
+                            level.typedChannel<half> ("S").at (x, y) =
+                                sampledValue (seed, lx, ly, x, y);
+        }
+
+    return unique_ptr<Image> (image.release ());
+}
+
+unique_ptr<Image>
+makeLossyFlat (const Box2i& window)
+{
+    unique_ptr<FlatImage> image (new FlatImage (window));
+    image->insertChannel ("R", HALF);
+    image->insertChannel ("G", HALF);
+    image->insertChannel ("B", HALF);
+
+    FlatImageLevel& level = image->level ();
+    for (int y = window.min.y; y <= window.max.y; ++y)
+        for (int x = window.min.x; x <= window.max.x; ++x)
+        {
+            const unsigned int hash =
+                static_cast<unsigned int> ((x + 17) * 2654435761u) ^
+                static_cast<unsigned int> ((y + 31) * 2246822519u);
+            level.typedChannel<half> ("R").at (x, y) =
+                half (static_cast<float> (hash % 4093) / 37.0f - 40.0f);
+            level.typedChannel<half> ("G").at (x, y) =
+                half (static_cast<float> ((hash >> 5) % 3251) / 29.0f - 30.0f);
+            level.typedChannel<half> ("B").at (x, y) =
+                half (static_cast<float> ((hash >> 11) % 2539) / 23.0f - 20.0f);
+        }
+
+    return unique_ptr<Image> (image.release ());
+}
+
+unique_ptr<Image>
+makeDeep (
+    const Box2i&      window,
+    LevelMode         mode,
+    float             seed,
+    LevelRoundingMode rounding = ROUND_DOWN)
+{
+    unique_ptr<DeepImage> image (new DeepImage (window, mode, rounding));
+    image->insertChannel ("A", HALF, 1, 1, true);
+    image->insertChannel ("Z", FLOAT);
+
+    for (int ly = 0; ly < image->numYLevels (); ++ly)
+        for (int lx = 0; lx < image->numXLevels (); ++lx)
+        {
+            if (!validLevel (mode, lx, ly)) continue;
+            DeepImageLevel& level = image->level (lx, ly);
+            for (int y = level.dataWindow ().min.y;
+                 y <= level.dataWindow ().max.y;
+                 ++y)
+                for (int x = level.dataWindow ().min.x;
+                     x <= level.dataWindow ().max.x;
+                     ++x)
+                {
+                    const unsigned int count = static_cast<unsigned int> (
+                        (((x % 3 + 3) % 3) + 2 * ((y % 3 + 3) % 3) + lx + ly) %
+                        3);
+                    level.sampleCounts ().set (x, y, count);
+                    for (unsigned int s = 0; s < count; ++s)
+                    {
+                        level.typedChannel<half> ("A").at (x, y)[s] =
+                            half (deepValue (seed + 1, lx, ly, x, y, s));
+                        level.typedChannel<float> ("Z").at (x, y)[s] =
+                            deepValue (seed, lx, ly, x, y, s);
+                    }
+                }
+        }
+
+    return unique_ptr<Image> (image.release ());
+}
