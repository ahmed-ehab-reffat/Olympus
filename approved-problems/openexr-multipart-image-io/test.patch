+    parts.clear ();
+    Header unnamed (4, 4);
+    parts.emplace_back (
+        unnamed, makeFlat (Box2i (V2i (0, 0), V2i (3, 3)), ONE_LEVEL, 1));
+    requireSaveRejectedBoth (
+        prefix + "-unnamed.exr",
+        parts,
+        USE_IMAGE_DATA_WINDOW,
+        "unnamed part must be rejected");
+
+    parts.clear ();
+    Header emptyNamed (4, 4);
+    emptyNamed.setName ("");
+    parts.emplace_back (
+        emptyNamed, makeFlat (Box2i (V2i (0, 0), V2i (3, 3)), ONE_LEVEL, 1));
+    requireSaveRejectedBoth (
+        prefix + "-empty-name.exr",
+        parts,
+        USE_IMAGE_DATA_WINDOW,
+        "empty part name must be rejected");
+
+    parts.clear ();
+    parts.emplace_back (
+        named, makeFlat (Box2i (V2i (0, 0), V2i (3, 3)), ONE_LEVEL, 2));
+    parts.emplace_back (
+        named, makeFlat (Box2i (V2i (0, 0), V2i (3, 3)), ONE_LEVEL, 3));
+    requireSaveRejectedBoth (
+        prefix + "-duplicate.exr",
+        parts,
+        USE_IMAGE_DATA_WINDOW,
+        "duplicate names must be rejected");
+
+    parts.clear ();
+    parts.emplace_back (named, unique_ptr<Image> (new UnsupportedImage));
+    requireSaveRejectedBoth (
+        prefix + "-unsupported.exr",
+        parts,
+        USE_IMAGE_DATA_WINDOW,
+        "unsupported image type must be rejected");
+
+    ImageParts moved = std::move (parts);
+    require (moved.size () == 1, "ImageParts move ownership");
+
+    parts.clear ();
+    parts.emplace_back (
+        makeHeader ("crop-one", Box2i (V2i (0, 0), V2i (7, 7)), false),
+        makeFlat (Box2i (V2i (0, 0), V2i (7, 7)), ONE_LEVEL, 4));
+    parts.emplace_back (
+        makeHeader ("crop-mipmap", Box2i (V2i (0, 0), V2i (7, 7)), false),
+        makeFlat (Box2i (V2i (0, 0), V2i (7, 7)), MIPMAP_LEVELS, 5));
+    requireSaveRejectedBoth (
+        prefix + "-multires-crop.exr",
+        parts,
+        USE_HEADER_DATA_WINDOW,
+        "header data window must reject a later multiresolution part");
+}
