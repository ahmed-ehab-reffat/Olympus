+void
+corruptFirstScanlineChunk (const string& fileName)
+{
+    exr_context_t context = nullptr;
+    require (
+        exr_start_read (&context, fileName.c_str (), nullptr) ==
+            EXR_ERR_SUCCESS,
+        "open core context for corruption fixture");
+
+    exr_attr_box2i_t   dataWindow;
+    exr_chunk_info_t   chunk;
+    const exr_result_t windowResult =
+        exr_get_data_window (context, 0, &dataWindow);
+    const exr_result_t chunkResult =
+        exr_read_scanline_chunk_info (context, 0, dataWindow.min.y, &chunk);
+    exr_finish (&context);
+
+    require (windowResult == EXR_ERR_SUCCESS, "query corrupt part window");
+    require (chunkResult == EXR_ERR_SUCCESS, "query corrupt part chunk");
+    require (
+        chunk.packed_size > 0 && chunk.packed_size < chunk.unpacked_size,
+        "corrupt fixture must use a compressed chunk");
+
+    fstream output (fileName, ios::binary | ios::in | ios::out);
+    require (output.good (), "open corrupt fixture for update");
+    output.seekp (static_cast<streamoff> (chunk.data_offset));
+    vector<char> damaged (static_cast<size_t> (chunk.packed_size), '\0');
+    output.write (damaged.data (), static_cast<streamsize> (damaged.size ()));
+    require (output.good (), "damage unselected compressed payload");
+}
+
+void
+corruptScanlineChunk (
+    const string& fileName, int partIndex, int scanLine, const string& context)
+{
+    exr_context_t contextHandle = nullptr;
+    require (
+        exr_start_read (&contextHandle, fileName.c_str (), nullptr) ==
+            EXR_ERR_SUCCESS,
+        context + ": open core context");
+    exr_chunk_info_t   chunk;
+    const exr_result_t result = exr_read_scanline_chunk_info (
+        contextHandle, partIndex, scanLine, &chunk);
+    exr_finish (&contextHandle);
+    require (result == EXR_ERR_SUCCESS, context + ": query scanline chunk");
+    require (chunk.packed_size > 0, context + ": nonempty scanline chunk");
+
+    fstream output (fileName, ios::binary | ios::in | ios::out);
+    require (output.good (), context + ": open scanline fixture");
+    output.seekp (static_cast<streamoff> (chunk.data_offset));
+    vector<char> damaged (
+        static_cast<size_t> (chunk.packed_size), static_cast<char> (0xff));
+    output.write (damaged.data (), static_cast<streamsize> (damaged.size ()));
+    require (output.good (), context + ": damage scanline chunk");
+}
+
+void
+corruptTileChunk (
+    const string& fileName,
+    int           partIndex,
+    int           tileX,
+    int           tileY,
+    const string& context)
+{
+    exr_context_t contextHandle = nullptr;
+    require (
+        exr_start_read (&contextHandle, fileName.c_str (), nullptr) ==
+            EXR_ERR_SUCCESS,
+        context + ": open core context");
+    exr_chunk_info_t   chunk;
+    const exr_result_t result = exr_read_tile_chunk_info (
+        contextHandle, partIndex, tileX, tileY, 0, 0, &chunk);
+    exr_finish (&contextHandle);
+    require (result == EXR_ERR_SUCCESS, context + ": query tile chunk");
+    require (chunk.packed_size > 0, context + ": nonempty tile chunk");
+
+    fstream output (fileName, ios::binary | ios::in | ios::out);
+    require (output.good (), context + ": open tile fixture");
+    output.seekp (static_cast<streamoff> (chunk.data_offset));
+    vector<char> damaged (
+        static_cast<size_t> (chunk.packed_size), static_cast<char> (0xff));
+    output.write (damaged.data (), static_cast<streamsize> (damaged.size ()));
+    if (chunk.sample_count_table_size > 0)
+    {
+        output.seekp (static_cast<streamoff> (chunk.sample_count_data_offset));
+        vector<char> damagedCounts (
+            static_cast<size_t> (chunk.sample_count_table_size),
+            static_cast<char> (0xff));
+        output.write (
+            damagedCounts.data (),
+            static_cast<streamsize> (damagedCounts.size ()));
+    }
+    require (output.good (), context + ": damage tile chunk");
+}
+
+void
+compareFlat (const Image& actual, const Image& expected, const string& context)
+{
+    const FlatImage* a = dynamic_cast<const FlatImage*> (&actual);
+    const FlatImage* e = dynamic_cast<const FlatImage*> (&expected);
+    require (a && e, context + ": flat dynamic type");
+    require (a->dataWindow () == e->dataWindow (), context + ": data window");
+    require (a->levelMode () == e->levelMode (), context + ": level mode");
+    require (
+        a->levelRoundingMode () == e->levelRoundingMode (),
+        context + ": rounding mode");
+    require (a->numXLevels () == e->numXLevels (), context + ": x levels");
+    require (a->numYLevels () == e->numYLevels (), context + ": y levels");
+
+    for (int ly = 0; ly < a->numYLevels (); ++ly)
+        for (int lx = 0; lx < a->numXLevels (); ++lx)
+        {
+            if (!validLevel (a->levelMode (), lx, ly)) continue;
+            const FlatImageLevel& al = a->level (lx, ly);
+            const FlatImageLevel& el = e->level (lx, ly);
+            require (
+                al.dataWindow () == el.dataWindow (),
+                context + ": level data window");
+            require (al.findChannel ("F") != nullptr, context + ": F channel");
+            require (al.findChannel ("U") != nullptr, context + ": U channel");
+            const bool hasSampled = el.findChannel ("S") != nullptr;
+            require (
+                (al.findChannel ("S") != nullptr) == hasSampled,
+                context + ": S channel");
+            const Channel& actualF   = al.findChannel ("F")->channel ();
+            const Channel& expectedF = el.findChannel ("F")->channel ();
+            require (
+                actualF.type == expectedF.type &&
+                    actualF.xSampling == expectedF.xSampling &&
+                    actualF.ySampling == expectedF.ySampling &&
+                    actualF.pLinear == expectedF.pLinear,
+                context + ": F channel metadata");
+            const Channel& actualU   = al.findChannel ("U")->channel ();
+            const Channel& expectedU = el.findChannel ("U")->channel ();
+            require (
+                actualU.type == expectedU.type &&
+                    actualU.xSampling == expectedU.xSampling &&
+                    actualU.ySampling == expectedU.ySampling &&
+                    actualU.pLinear == expectedU.pLinear,
+                context + ": U channel metadata");
+            if (hasSampled)
+            {
+                const Channel& actualS   = al.findChannel ("S")->channel ();
+                const Channel& expectedS = el.findChannel ("S")->channel ();
+                require (
+                    actualS.type == expectedS.type &&
+                        actualS.xSampling == expectedS.xSampling &&
+                        actualS.ySampling == expectedS.ySampling &&
+                        actualS.pLinear == expectedS.pLinear,
+                    context + ": S channel metadata");
+            }
+            for (int y = al.dataWindow ().min.y; y <= al.dataWindow ().max.y;
+                 ++y)
+                for (int x = al.dataWindow ().min.x;
+                     x <= al.dataWindow ().max.x;
+                     ++x)
+                    require (
+                        al.typedChannel<float> ("F").at (x, y) ==
+                            el.typedChannel<float> ("F").at (x, y),
+                        context + ": flat sample");
+            for (int y = al.dataWindow ().min.y; y <= al.dataWindow ().max.y;
+                 ++y)
+                for (int x = al.dataWindow ().min.x;
+                     x <= al.dataWindow ().max.x;
+                     ++x)
+                    require (
+                        al.typedChannel<unsigned int> ("U").at (x, y) ==
+                            el.typedChannel<unsigned int> ("U").at (x, y),
+                        context + ": uint flat sample");
+            if (hasSampled)
+                for (int y = al.dataWindow ().min.y;
+                     y <= al.dataWindow ().max.y;
+                     ++y)
+                    for (int x = al.dataWindow ().min.x;
+                         x <= al.dataWindow ().max.x;
+                         ++x)
+                        if (x % 2 == 0 && y % 2 == 0)
+                            require (
+                                al.typedChannel<half> ("S").at (x, y) ==
+                                    el.typedChannel<half> ("S").at (x, y),
+                                context + ": sampled flat sample");
+        }
+}
+
+void
+compareDeep (const Image& actual, const Image& expected, const string& context)
+{
+    const DeepImage* a = dynamic_cast<const DeepImage*> (&actual);
+    const DeepImage* e = dynamic_cast<const DeepImage*> (&expected);
+    require (a && e, context + ": deep dynamic type");
+    require (a->dataWindow () == e->dataWindow (), context + ": data window");
+    require (a->levelMode () == e->levelMode (), context + ": level mode");
+    require (
+        a->levelRoundingMode () == e->levelRoundingMode (),
+        context + ": rounding mode");
+
+    for (int ly = 0; ly < a->numYLevels (); ++ly)
+        for (int lx = 0; lx < a->numXLevels (); ++lx)
+        {
+            if (!validLevel (a->levelMode (), lx, ly)) continue;
+            const DeepImageLevel& al = a->level (lx, ly);
+            const DeepImageLevel& el = e->level (lx, ly);
+            require (al.findChannel ("A") != 0, context + ": actual A channel");
+            require (
+                el.findChannel ("A") != 0, context + ": expected A channel");
+            const Channel& actualA   = al.findChannel ("A")->channel ();
+            const Channel& expectedA = el.findChannel ("A")->channel ();
+            require (
+                actualA.type == expectedA.type &&
+                    actualA.xSampling == expectedA.xSampling &&
+                    actualA.ySampling == expectedA.ySampling &&
+                    actualA.pLinear == expectedA.pLinear,
+                context + ": A channel metadata");
+            require (al.findChannel ("Z") != 0, context + ": actual Z channel");
+            require (
+                el.findChannel ("Z") != 0, context + ": expected Z channel");
+            const Channel& actualZ   = al.findChannel ("Z")->channel ();
+            const Channel& expectedZ = el.findChannel ("Z")->channel ();
+            require (
+                actualZ.type == expectedZ.type &&
+                    actualZ.xSampling == expectedZ.xSampling &&
+                    actualZ.ySampling == expectedZ.ySampling &&
+                    actualZ.pLinear == expectedZ.pLinear,
+                context + ": Z channel metadata");
+            for (int y = al.dataWindow ().min.y; y <= al.dataWindow ().max.y;
+                 ++y)
+                for (int x = al.dataWindow ().min.x;
+                     x <= al.dataWindow ().max.x;
+                     ++x)
+                {
+                    const unsigned int count = al.sampleCounts ().at (x, y);
+                    require (
+                        count == el.sampleCounts ().at (x, y),
+                        context + ": deep sample count");
+                    for (unsigned int s = 0; s < count; ++s)
+                    {
+                        require (
+                            al.typedChannel<half> ("A").at (x, y)[s] ==
+                                el.typedChannel<half> ("A").at (x, y)[s],
+                            context + ": deep half sample");
+                        require (
+                            al.typedChannel<float> ("Z").at (x, y)[s] ==
+                                el.typedChannel<float> ("Z").at (x, y)[s],
+                            context + ": deep sample");
+                    }
+                }
+        }
+}
+
+void
+compareImage (const Image& actual, const Image& expected, const string& context)
+{
+    if (dynamic_cast<const FlatImage*> (&expected))
+        compareFlat (actual, expected, context);
+    else
+        compareDeep (actual, expected, context);
+}
+
+void
+compareLossyFlat (
+    const Image& actual, const Image& expected, const string& context)
+{
+    const FlatImage* a = dynamic_cast<const FlatImage*> (&actual);
+    const FlatImage* e = dynamic_cast<const FlatImage*> (&expected);
+    require (a && e, context + ": flat dynamic type");
+    require (a->dataWindow () == e->dataWindow (), context + ": data window");
+
+    const FlatImageLevel& al         = a->level ();
+    const FlatImageLevel& el         = e->level ();
+    const char*           channels[] = {"R", "G", "B"};
+    for (const char* channel: channels)
+    {
+        require (
+            al.findChannel (channel) && el.findChannel (channel),
+            context + ": RGB channel");
+        for (int y = al.dataWindow ().min.y; y <= al.dataWindow ().max.y; ++y)
+            for (int x = al.dataWindow ().min.x; x <= al.dataWindow ().max.x;
+                 ++x)
+                require (
+                    al.typedChannel<half> (channel).at (x, y) ==
+                        el.typedChannel<half> (channel).at (x, y),
+                    context + ": RGB sample");
+    }
+}
+
+void
+copyInputPartToOutput (
+    MultiPartInputFile& input, MultiPartOutputFile& output, int index)
+{
+    const string& type = input.header (0).type ();
+    if (type == SCANLINEIMAGE)
+    {
+        InputPart  in (input, 0);
+        OutputPart out (output, index);
+        out.copyPixels (in);
+    }
+    else if (type == TILEDIMAGE)
+    {
+        TiledInputPart  in (input, 0);
+        TiledOutputPart out (output, index);
+        out.copyPixels (in);
+    }
+    else if (type == DEEPSCANLINE)
+    {
+        DeepScanLineInputPart  in (input, 0);
+        DeepScanLineOutputPart out (output, index);
+        out.copyPixels (in);
+    }
+    else
+    {
+        DeepTiledInputPart  in (input, 0);
+        DeepTiledOutputPart out (output, index);
+        out.copyPixels (in);
+    }
+}
+
+void
+writeLowLevelMultipart (
+    const string& fileName, const string& prefix, const ImageParts& parts)
+{
+    vector<string> partFiles;
+    vector<Header> headers;
+    for (size_t i = 0; i < parts.size (); ++i)
+    {
+        const string single = prefix + "-source-" + to_string (i) + ".exr";
+        partFiles.push_back (single);
+        saveImage (single, parts[i].header, *parts[i].image);
+        MultiPartInputFile input (single.c_str ());
+        headers.push_back (input.header (0));
+    }
+
+    {
+        MultiPartOutputFile output (
+            fileName.c_str (),
+            headers.data (),
+            static_cast<int> (headers.size ()));
+        for (size_t i = 0; i < partFiles.size (); ++i)
+        {
+            MultiPartInputFile input (partFiles[i].c_str ());
+            copyInputPartToOutput (input, output, static_cast<int> (i));
+        }
+    }
+
+    for (const string& partFile: partFiles)
+        remove (partFile.c_str ());
+}
+
+unique_ptr<Image>
+extractAndLoadPart (
+    const string& multipartFile,
+    const string& singleFile,
+    int           index,
+    Header&       loadedHeader)
+{
+    {
+        MultiPartInputFile input (multipartFile.c_str ());
+        const Header&      header = input.header (index);
+        if (header.type () == SCANLINEIMAGE)
+        {
+            InputPart  in (input, index);
+            OutputFile out (singleFile.c_str (), header);
+            out.copyPixels (in);
+        }
+        else if (header.type () == TILEDIMAGE)
+        {
+            TiledInputPart  in (input, index);
+            TiledOutputFile out (singleFile.c_str (), header);
+            out.copyPixels (in);
+        }
+        else if (header.type () == DEEPSCANLINE)
+        {
+            DeepScanLineInputPart  in (input, index);
+            DeepScanLineOutputFile out (singleFile.c_str (), header);
+            out.copyPixels (in);
+        }
+        else
+        {
+            DeepTiledInputPart  in (input, index);
+            DeepTiledOutputFile out (singleFile.c_str (), header);
+            out.copyPixels (in);
+        }
+    }
+
+    unique_ptr<Image> image (loadImage (singleFile, loadedHeader));
+    remove (singleFile.c_str ());
+    return image;
+}
