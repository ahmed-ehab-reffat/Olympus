+void
+testHeaderAndCrop (const string& prefix)
+{
+    const Box2i display (V2i (0, 0), V2i (7, 7));
+    const Box2i pixels (V2i (-2, -2), V2i (5, 5));
+    Header      header = makeHeader ("cropped-tile", display, true);
+    const Box2i expectedCrop (V2i (0, 0), V2i (5, 5));
+    const Box2i expectedDeepCrop (V2i (2, 1), V2i (6, 5));
+    header.channels ().insert ("discarded", Channel (HALF));
+    ImageParts parts;
+    parts.emplace_back (header, makeFlat (pixels, ONE_LEVEL, 70));
+    parts.emplace_back (
+        makeHeader ("sampled-scan", display, false),
+        makeFlat (display, ONE_LEVEL, 80, ROUND_DOWN, true));
+    Header deepHeader        = makeHeader ("cropped-deep", display, false);
+    deepHeader.dataWindow () = expectedDeepCrop;
+    parts.emplace_back (deepHeader, makeDeep (display, ONE_LEVEL, 90));
+
+    const string file = prefix + "-crop.exr";
+    saveImages (file, parts, USE_HEADER_DATA_WINDOW);
+    MultiPartInputFile input (file.c_str ());
+    const Header&      saved = input.header (0);
+    require (saved.type () == TILEDIMAGE, "explicit one-level tile type");
+    require (saved.displayWindow () == display, "saved display window");
+    require (saved.dataWindow () == expectedCrop, "intersected data window");
+    require (
+        saved.tileDescription ().xSize == 3 &&
+            saved.tileDescription ().ySize == 2 &&
+            saved.tileDescription ().mode == ONE_LEVEL &&
+            saved.tileDescription ().roundingMode == ROUND_DOWN,
+        "tile description reconciled");
+    require (
+        saved.channels ().findChannel ("F") != nullptr, "image channel saved");
+    const Header&  sampledHeader = input.header (1);
+    const Channel* sampled       = sampledHeader.channels ().findChannel ("S");
+    require (sampled != nullptr, "sampled image channel saved");
+    require (
+        sampled->type == HALF && sampled->xSampling == 2 &&
+            sampled->ySampling == 2 && sampled->pLinear,
+        "sampled channel metadata saved");
+    const Header& deepSaved = input.header (2);
+    require (deepSaved.type () == DEEPSCANLINE, "deep crop part type");
+    require (deepSaved.dataWindow () == expectedDeepCrop, "deep crop window");
+    require (
+        saved.channels ().findChannel ("discarded") == nullptr,
+        "header channels replaced");
+    require (comments (saved) == "header-cropped-tile", "custom header saved");
+
+    Header            loadedHeader;
+    unique_ptr<Image> cropped =
+        extractAndLoadPart (file, prefix + "-crop-single.exr", 0, loadedHeader);
+    unique_ptr<Image> expected = makeFlat (expectedCrop, ONE_LEVEL, 70);
+    compareImage (*cropped, *expected, "cropped samples");
+    unique_ptr<Image> sampledExpected =
+        makeFlat (display, ONE_LEVEL, 80, ROUND_DOWN, true);
+    unique_ptr<Image> sampledImage = extractAndLoadPart (
+        file, prefix + "-sampled-single.exr", 1, loadedHeader);
+    compareImage (*sampledImage, *sampledExpected, "sampled samples");
+    unique_ptr<Image> deepExpected = makeDeep (expectedDeepCrop, ONE_LEVEL, 90);
+    unique_ptr<Image> deepImage    = extractAndLoadPart (
+        file, prefix + "-deep-crop-single.exr", 2, loadedHeader);
+    compareImage (*deepImage, *deepExpected, "deep cropped samples");
+    ImageParts loaded = loadImages (file);
+    require (loaded.size () == 3, "direct cropped load part count");
+    compareImage (*loaded[0].image, *expected, "direct one-level tiled load");
+    compareImage (*loaded[1].image, *sampledExpected, "direct sampled load");
+    compareImage (*loaded[2].image, *deepExpected, "direct deep cropped load");
+    remove (file.c_str ());
+}
