+Header
+makeHeader (const string& name, const Box2i& displayWindow, bool tiled)
+{
+    Header header (displayWindow, displayWindow);
+    header.setName (name);
+    addComments (header, "header-" + name);
+    if (tiled) header.setTileDescription (TileDescription (3, 2));
+    return header;
+}
