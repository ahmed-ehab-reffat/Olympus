+bool
+validLevel (LevelMode mode, int x, int y)
+{
+    if (mode == ONE_LEVEL) return x == 0 && y == 0;
+    if (mode == MIPMAP_LEVELS) return x == y;
+    return true;
+}
+
+float
+flatValue (float seed, int lx, int ly, int x, int y)
+{
+    return seed + 1000 * lx + 100 * ly + 10 * y + x;
+}
+
+half
+sampledValue (float seed, int lx, int ly, int x, int y)
+{
+    return half (seed + 100 * lx + 10 * ly + 2 * y + x);
+}
+
+unsigned int
+uintValue (float seed, int lx, int ly, int x, int y)
+{
+    return static_cast<unsigned int> (
+        10 * seed + 1000 * lx + 100 * ly + 2 * y + x);
+}
+
+float
+deepValue (float seed, int lx, int ly, int x, int y, unsigned int sample)
+{
+    return seed + 1000 * lx + 100 * ly + 10 * y + x + sample / 4.0f;
+}
