+void
+compareHeaderIgnoringType (
+    const Header& actual, const Header& expected, const string& context)
+{
+    Header actualWithoutType (actual);
+    Header expectedWithoutType (expected);
+    actualWithoutType.erase ("type");
+    expectedWithoutType.erase ("type");
+    compareHeader (actualWithoutType, expectedWithoutType, context);
