+void
+testUnsupportedParts (const string& prefix)
+{
+    const Box2i window (V2i (0, 0), V2i (7, 5));
+    ImageParts  source;
+    source.emplace_back (
+        makeHeader ("supported-before", window, false),
+        makeDeep (window, ONE_LEVEL, 180));
+    source.emplace_back (
+        makeHeader ("unsupported-middle", window, false),
+        makeFlat (window, ONE_LEVEL, 190));
+    source.emplace_back (
+        makeHeader ("supported-after", window, true),
+        makeFlat (window, ONE_LEVEL, 200));
+
+    const string fileName = prefix + "-unsupported-input.exr";
+    writeLowLevelMultipart (fileName, prefix + "-unsupported", source);
+    vector<char> bytes = readBytes (fileName);
+    replaceUniqueBytes (bytes, "scanlineimage", "unsupported__");
+    writeBytes (fileName, bytes);
+
+    ImageParts loaded = loadImages (fileName);
+    require (loaded.size () == 2, "unsupported filename load count");
+    require (
+        loaded[0].header.name () == "supported-before" &&
+            loaded[1].header.name () == "supported-after",
+        "unsupported filename relative order");
+    compareImage (*loaded[0].image, *source[0].image, "supported before");
+    compareImage (*loaded[1].image, *source[2].image, "supported after");
+
+    MemoryInputStream stream (bytes);
+    ImageParts        streamLoaded = loadImages (stream);
+    require (streamLoaded.size () == 2, "unsupported stream load count");
+    require (
+        streamLoaded[0].header.name () == "supported-before" &&
+            streamLoaded[1].header.name () == "supported-after",
+        "unsupported stream relative order");
+
+    ImagePart selected = loadImagePart (fileName, "supported-after");
+    compareImage (
+        *selected.image, *source[2].image, "select after unsupported");
+    requireThrows (
+        [&] { loadImagePart (fileName, "unsupported-middle"); },
+        "named unsupported part must be rejected");
+
+    const Box2i selectedCrop (V2i (2, 1), V2i (6, 4));
+    ImagePart   windowedSelected =
+        loadImagePart (fileName, "supported-after", selectedCrop);
+    unique_ptr<Image> expectedWindowed =
+        makeFlat (selectedCrop, ONE_LEVEL, 200);
+    compareImage (
+        *windowedSelected.image,
+        *expectedWindowed,
+        "windowed select after unsupported");
+    requireThrows (
+        [&] { loadImagePart (fileName, "unsupported-middle", selectedCrop); },
+        "windowed named unsupported part must be rejected");
+
+    MemoryInputStream selectedStream (bytes);
+    ImagePart         streamSelected =
+        loadImagePart (selectedStream, "supported-after");
+    compareImage (
+        *streamSelected.image,
+        *source[2].image,
+        "stream select after unsupported");
+    MemoryInputStream unsupportedSelectedStream (bytes);
+    requireThrows (
+        [&] {
+            loadImagePart (unsupportedSelectedStream, "unsupported-middle");
+        },
+        "stream named unsupported part must be rejected");
+    MemoryInputStream windowedSelectedStream (bytes);
+    ImagePart         streamWindowedSelected =
+        loadImagePart (windowedSelectedStream, "supported-after", selectedCrop);
+    compareImage (
+        *streamWindowedSelected.image,
+        *expectedWindowed,
+        "stream windowed select after unsupported");
+    MemoryInputStream windowedUnsupportedStream (bytes);
+    requireThrows (
+        [&] {
+            loadImagePart (
+                windowedUnsupportedStream, "unsupported-middle", selectedCrop);
+        },
+        "stream windowed named unsupported part must be rejected");
+
+    const string rewriteFile = prefix + "-unsupported-rewrite.exr";
+    ImageParts   noReplacements;
+    rewriteImages (fileName, rewriteFile, noReplacements);
+    ImageParts rewritten = loadImages (rewriteFile);
+    require (rewritten.size () == 2, "rewrite skips unsupported part");
+    require (
+        rewritten[0].header.name () == "supported-before" &&
+            rewritten[1].header.name () == "supported-after",
+        "rewrite supported relative order");
+
+    MemoryInputStream  rewriteInput (bytes);
+    MemoryOutputStream rewriteOutput;
+    rewriteImages (rewriteInput, rewriteOutput, noReplacements);
+    MemoryInputStream rewrittenInput (rewriteOutput.bytes ());
+    ImageParts        streamRewritten = loadImages (rewrittenInput);
+    require (streamRewritten.size () == 2, "stream rewrite skips unsupported");
+    require (
+        streamRewritten[0].header.name () == "supported-before" &&
+            streamRewritten[1].header.name () == "supported-after",
+        "stream rewrite supported relative order");
+
+    remove (rewriteFile.c_str ());
+    remove (fileName.c_str ());
+}
+
+ImageParts
+makeRewriteSource (const Box2i& window)
+{
+    ImageParts source;
+    Header     lossy             = makeHeader ("lossy-keep", window, false);
+    lossy.compression ()         = DWAA_COMPRESSION;
+    lossy.dwaCompressionLevel () = 200.0f;
+    lossy.lineOrder ()           = DECREASING_Y;
+    lossy.insert ("rewriteToken", IntAttribute (401));
+    source.emplace_back (lossy, makeLossyFlat (window));
+    source.emplace_back (
+        makeHeader ("replace-me", window, true),
+        makeFlat (window, MIPMAP_LEVELS, 210, ROUND_UP));
+    Header deepKeep       = makeHeader ("deep-keep", window, false);
+    deepKeep.lineOrder () = DECREASING_Y;
+    deepKeep.insert ("rewriteToken", IntAttribute (402));
+    source.emplace_back (deepKeep, makeDeep (window, ONE_LEVEL, 220));
+    Header deepTiled       = makeHeader ("deep-tiled-keep", window, true);
+    deepTiled.lineOrder () = RANDOM_Y;
+    deepTiled.insert ("rewriteToken", IntAttribute (403));
+    source.emplace_back (deepTiled, makeDeep (window, RIPMAP_LEVELS, 230));
+    source.emplace_back (
+        makeHeader ("replace-second", window, false),
+        makeFlat (window, ONE_LEVEL, 235));
+    return source;
+}
+
+void
+checkRewriteResult (
+    const ImageParts& output,
+    const ImageParts& sourceDecoded,
+    const ImageParts& replacements,
+    const ImageParts& expectedReplacements,
+    const string&     context)
+{
+    require (output.size () == 5, context + ": output count");
+    require (
+        output[0].header.name () == "lossy-keep" &&
+            output[1].header.name () == "replace-me" &&
+            output[2].header.name () == "deep-keep" &&
+            output[3].header.name () == "deep-tiled-keep" &&
+            output[4].header.name () == "replace-second",
+        context + ": source order");
+    require (
+        output[0].header.compression () == DWAA_COMPRESSION,
+        context + ": lossy compression metadata");
+    compareHeader (
+        output[0].header, sourceDecoded[0].header, context + ": lossy header");
+    compareHeader (
+        output[2].header,
+        sourceDecoded[2].header,
+        context + ": deep scanline header");
+    compareHeader (
+        output[3].header,
+        sourceDecoded[3].header,
+        context + ": deep tiled header");
+    compareLossyFlat (
+        *output[0].image, *sourceDecoded[0].image, context + ": lossy keep");
+    require (
+        output[1].header.type () == DEEPTILE, context + ": replacement family");
+    compareHeader (
+        output[1].header,
+        expectedReplacements[0].header,
+        context + ": first replacement header");
+    compareImage (
+        *output[1].image,
+        *replacements[0].image,
+        context + ": first replacement");
+    compareImage (
+        *output[2].image, *sourceDecoded[2].image, context + ": deep keep");
+    compareImage (
+        *output[3].image,
+        *sourceDecoded[3].image,
+        context + ": deep tiled keep");
+    require (
+        output[4].header.type () == SCANLINEIMAGE,
+        context + ": second replacement family");
+    compareHeader (
+        output[4].header,
+        expectedReplacements[1].header,
+        context + ": second replacement header");
+    compareImage (
+        *output[4].image,
+        *replacements[1].image,
+        context + ": second replacement");
+}
+
+void
+testRewriteParts (const string& prefix)
+{
+    const Box2i  window (V2i (0, 0), V2i (63, 31));
+    ImageParts   source     = makeRewriteSource (window);
+    const string sourceFile = prefix + "-rewrite-source.exr";
+    writeLowLevelMultipart (sourceFile, prefix + "-rewrite", source);
+    ImageParts sourceDecoded = loadImages (sourceFile);
+
+    ImageParts replacements;
+    Header     replacementHeader   = makeHeader ("replace-me", window, true);
+    replacementHeader.lineOrder () = RANDOM_Y;
+    replacementHeader.insert ("replacementToken", IntAttribute (404));
+    replacements.emplace_back (
+        replacementHeader, makeDeep (window, MIPMAP_LEVELS, 240, ROUND_UP));
+    Header secondReplacementHeader =
+        makeHeader ("replace-second", window, false);
+    secondReplacementHeader.lineOrder () = DECREASING_Y;
+    secondReplacementHeader.insert ("replacementToken", IntAttribute (405));
+    replacements.emplace_back (
+        secondReplacementHeader, makeFlat (window, ONE_LEVEL, 245));
+
+    MemoryOutputStream expectedReplacementOutput;
+    saveImages (expectedReplacementOutput, replacements);
+    MemoryInputStream expectedReplacementInput (
+        expectedReplacementOutput.bytes ());
+    ImageParts expectedReplacement = loadImages (expectedReplacementInput);
+    require (
+        expectedReplacement.size () == 2, "replacement save header source");
+
+    const string outputFile = prefix + "-rewrite-output.exr";
+    rewriteImages (sourceFile, outputFile, replacements);
+    ImageParts output = loadImages (outputFile);
+    checkRewriteResult (
+        output,
+        sourceDecoded,
+        replacements,
+        expectedReplacement,
+        "filename rewrite");
+
+    const vector<char> sourceBytes = readBytes (sourceFile);
+    MemoryInputStream  input (sourceBytes);
+    MemoryOutputStream outputStream;
+    rewriteImages (input, outputStream, replacements);
+    MemoryInputStream outputInput (outputStream.bytes ());
+    ImageParts        streamOutput = loadImages (outputInput);
+    checkRewriteResult (
+        streamOutput,
+        sourceDecoded,
+        replacements,
+        expectedReplacement,
+        "stream rewrite");
+
+    const Box2i cropWindow (V2i (4, 3), V2i (31, 15));
+    ImageParts  cropReplacements;
+    Header      cropHeader   = makeHeader ("replace-me", window, false);
+    cropHeader.dataWindow () = cropWindow;
+    cropReplacements.emplace_back (
+        cropHeader, makeDeep (window, ONE_LEVEL, 350));
+    unique_ptr<Image> expectedCrop = makeDeep (cropWindow, ONE_LEVEL, 350);
+
+    const string cropFile = prefix + "-rewrite-crop.exr";
+    rewriteImages (
+        sourceFile, cropFile, cropReplacements, USE_HEADER_DATA_WINDOW);
+    ImagePart filenameCrop = loadImagePart (cropFile, "replace-me");
+    require (
+        filenameCrop.header.dataWindow () == cropWindow,
+        "filename rewrite replacement crop window");
+    compareImage (
+        *filenameCrop.image, *expectedCrop, "filename rewrite deep crop");
+
+    MemoryInputStream  cropInput (sourceBytes);
+    MemoryOutputStream cropOutput;
+    rewriteImages (
+        cropInput, cropOutput, cropReplacements, USE_HEADER_DATA_WINDOW);
+    MemoryInputStream cropResultInput (cropOutput.bytes ());
+    ImagePart streamCrop = loadImagePart (cropResultInput, "replace-me");
+    require (
+        streamCrop.header.dataWindow () == cropWindow,
+        "stream rewrite replacement crop window");
+    compareImage (*streamCrop.image, *expectedCrop, "stream rewrite deep crop");
+
+    MemoryInputStream  copyInput (sourceBytes);
+    MemoryOutputStream copyOutput;
+    ImageParts         noReplacements;
+    rewriteImages (copyInput, copyOutput, noReplacements);
+    MemoryInputStream copiedInput (copyOutput.bytes ());
+    ImageParts        copied = loadImages (copiedInput);
+    require (copied.size () == sourceDecoded.size (), "empty rewrite count");
+    compareLossyFlat (
+        *copied[0].image, *sourceDecoded[0].image, "empty rewrite lossy keep");
+    for (size_t i = 1; i < copied.size (); ++i)
+        compareImage (
+            *copied[i].image, *sourceDecoded[i].image, "empty rewrite part");
+
+    const string corruptSource = prefix + "-rewrite-corrupt-source.exr";
+    const string corruptOutput = prefix + "-rewrite-corrupt-output.exr";
+    ImageParts   corruptionSource;
+    Header       damagedHeader   = makeHeader ("damaged-keep", window, false);
+    damagedHeader.compression () = ZIP_COMPRESSION;
+    corruptionSource.emplace_back (
+        damagedHeader, makeFlat (window, ONE_LEVEL, 330));
+    corruptionSource.emplace_back (
+        makeHeader ("replace-me", window, true),
+        makeFlat (window, MIPMAP_LEVELS, 340));
+    writeLowLevelMultipart (
+        corruptSource, prefix + "-rewrite-corrupt", corruptionSource);
+    corruptFirstScanlineChunk (corruptSource);
+    rewriteImages (corruptSource, corruptOutput, cropReplacements);
+    ImagePart corruptSelected = loadImagePart (corruptOutput, "replace-me");
+    compareImage (
+        *corruptSelected.image,
+        *cropReplacements[0].image,
+        "filename rewrite past unreadable untouched part");
+    requireThrows (
+        [&] {
+            Header ignored;
+            extractAndLoadPart (
+                corruptOutput,
+                prefix + "-rewrite-corrupt-extract.exr",
+                0,
+                ignored);
+        },
+        "rewritten untouched corruption remains observable");
+
+    const vector<char> corruptBytes = readBytes (corruptSource);
+    MemoryInputStream  corruptInput (corruptBytes);
+    MemoryOutputStream corruptStreamOutput;
+    rewriteImages (corruptInput, corruptStreamOutput, cropReplacements);
+    MemoryInputStream corruptSelectedInput (corruptStreamOutput.bytes ());
+    ImagePart         streamCorruptSelected =
+        loadImagePart (corruptSelectedInput, "replace-me");
+    compareImage (
+        *streamCorruptSelected.image,
+        *cropReplacements[0].image,
+        "stream rewrite past unreadable untouched part");
+
+    remove ((prefix + "-rewrite-corrupt-extract.exr").c_str ());
+    remove (corruptOutput.c_str ());
+    remove (corruptSource.c_str ());
+    remove (cropFile.c_str ());
+    remove (outputFile.c_str ());
+    remove (sourceFile.c_str ());
+}
+
+void
+testRewriteValidation (const string& prefix)
+{
+    const Box2i window (V2i (0, 0), V2i (7, 7));
+    ImageParts  source;
+    source.emplace_back (
+        makeHeader ("target", window, false),
+        makeFlat (window, ONE_LEVEL, 250));
+    source.emplace_back (
+        makeHeader ("other", window, true), makeDeep (window, ONE_LEVEL, 260));
+
+    const string sourceFile = prefix + "-rewrite-validation-source.exr";
+    writeLowLevelMultipart (sourceFile, prefix + "-rewrite-validation", source);
+    const vector<char> sourceBytes = readBytes (sourceFile);
+
+    const string       outputFile = prefix + "-rewrite-invalid-output.exr";
+    const vector<char> sentinel   = {'k', 'e', 'e', 'p'};
+    auto               rejectAgainstBoth = [&] (
+                                 const string&       inputFile,
+                                 const vector<char>& inputBytes,
+                                 const ImageParts&   replacements,
+                                 DataWindowSource    dws,
+                                 const string&       message) {
+        writeBytes (outputFile, sentinel);
+        requireThrows (
+            [&] { rewriteImages (inputFile, outputFile, replacements, dws); },
+            message + " filename");
+        require (
+            readBytes (outputFile) == sentinel,
+            message + ": filename output remains unchanged");
+
+        MemoryInputStream  input (inputBytes);
+        MemoryOutputStream output;
+        requireThrows (
+            [&] { rewriteImages (input, output, replacements, dws); },
+            message + " stream");
+        require (
+            output.bytes ().empty (),
+            message + ": stream output remains empty");
+    };
+    auto rejectBoth = [&] (
+                          const ImageParts& replacements,
+                          DataWindowSource  dws,
+                          const string&     message) {
+        rejectAgainstBoth (sourceFile, sourceBytes, replacements, dws, message);
+    };
+
+    ImageParts replacements;
+    Header     target = makeHeader ("target", window, false);
+    replacements.emplace_back (target, unique_ptr<Image> ());
+    rejectBoth (
+        replacements, USE_IMAGE_DATA_WINDOW, "null replacement rejected");
+
+    replacements.clear ();
+    Header unnamed (window, window);
+    replacements.emplace_back (unnamed, makeFlat (window, ONE_LEVEL, 270));
+    rejectBoth (
+        replacements, USE_IMAGE_DATA_WINDOW, "unnamed replacement rejected");
+
+    replacements.clear ();
+    Header emptyName (window, window);
+    emptyName.setName ("");
+    replacements.emplace_back (emptyName, makeFlat (window, ONE_LEVEL, 280));
+    rejectBoth (
+        replacements, USE_IMAGE_DATA_WINDOW, "empty replacement name rejected");
+
+    replacements.clear ();
+    replacements.emplace_back (target, makeFlat (window, ONE_LEVEL, 290));
+    replacements.emplace_back (target, makeFlat (window, ONE_LEVEL, 300));
+    rejectBoth (
+        replacements, USE_IMAGE_DATA_WINDOW, "duplicate replacements rejected");
+
+    replacements.clear ();
+    replacements.emplace_back (
+        target, unique_ptr<Image> (new UnsupportedImage));
+    rejectBoth (
+        replacements,
+        USE_IMAGE_DATA_WINDOW,
+        "unsupported replacement rejected");
+
+    replacements.clear ();
+    replacements.emplace_back (
+        makeHeader ("missing", window, false),
+        makeFlat (window, ONE_LEVEL, 310));
+    rejectBoth (
+        replacements, USE_IMAGE_DATA_WINDOW, "unmatched replacement rejected");
+
+    ImageParts unsupportedSource;
+    unsupportedSource.emplace_back (
+        makeHeader ("supported-only", window, false),
+        makeFlat (window, ONE_LEVEL, 311));
+    unsupportedSource.emplace_back (
+        makeHeader ("unsupported-only", window, true),
+        makeFlat (window, ONE_LEVEL, 312));
+    const string unsupportedSourceFile =
+        prefix + "-rewrite-unsupported-source.exr";
+    writeLowLevelMultipart (
+        unsupportedSourceFile,
+        prefix + "-rewrite-unsupported-source",
+        unsupportedSource);
+    vector<char> unsupportedSourceBytes = readBytes (unsupportedSourceFile);
+    const string unknownType            = "unknown___";
+    require (
+        unknownType != SCANLINEIMAGE && unknownType != TILEDIMAGE &&
+            unknownType != DEEPSCANLINE && unknownType != DEEPTILE,
+        "replacement validation fixture type is unsupported");
+    replaceUniqueBytes (unsupportedSourceBytes, TILEDIMAGE, unknownType);
+    writeBytes (unsupportedSourceFile, unsupportedSourceBytes);
+
+    replacements.clear ();
+    replacements.emplace_back (
+        makeHeader ("unsupported-only", window, false),
+        makeFlat (window, ONE_LEVEL, 313));
+    rejectAgainstBoth (
+        unsupportedSourceFile,
+        unsupportedSourceBytes,
+        replacements,
+        USE_IMAGE_DATA_WINDOW,
+        "replacement matching only an unsupported source rejected");
+    remove (unsupportedSourceFile.c_str ());
+
+    replacements.clear ();
+    replacements.emplace_back (
+        makeHeader ("TARGET", window, false),
+        makeFlat (window, ONE_LEVEL, 315));
+    rejectBoth (
+        replacements,
+        USE_IMAGE_DATA_WINDOW,
+        "case-folded replacement name rejected");
+
+    replacements.clear ();
+    replacements.emplace_back (target, makeFlat (window, MIPMAP_LEVELS, 320));
+    rejectBoth (
+        replacements,
+        USE_HEADER_DATA_WINDOW,
+        "multiresolution replacement crop rejected");
+
+    replacements.clear ();
+    Header disjointHeader        = makeHeader ("target", window, false);
+    disjointHeader.dataWindow () = Box2i (V2i (20, 20), V2i (27, 27));
+    replacements.emplace_back (
+        disjointHeader, makeFlat (window, ONE_LEVEL, 325));
+    rejectBoth (
+        replacements,
+        USE_HEADER_DATA_WINDOW,
+        "disjoint replacement crop rejected before output modification");
+
+    requireThrows (
+        [&] { rewriteImages (sourceFile, sourceFile, replacements); },
+        "identical filename rewrite rejected");
+    require (
+        readBytes (sourceFile) == sourceBytes,
+        "identical filename rejection leaves source unchanged");
+
+    remove (outputFile.c_str ());
+    remove (sourceFile.c_str ());
+}
+
+} // namespace
+
+int
+main (int argc, char* argv[])
+{
+    if (argc != 2)
+    {
+        cerr << "expected one test name" << endl;
+        return 2;
+    }
+
+    const string name   = argv[1];
+    const string prefix = "/tmp/openexr-util-multipart-" + name;
+
+    try
+    {
+        if (name == "ApiAndValidation")
+            testApiAndValidation (prefix);
+        else if (name == "LoadHeterogeneous")
+            testLoadHeterogeneous (prefix);
+        else if (name == "SaveHeterogeneous")
+            testSaveHeterogeneous (prefix);
+        else if (name == "HeaderAndCrop")
+            testHeaderAndCrop (prefix);
+        else if (name == "OwnershipIsolation")
+            testOwnershipIsolation (prefix);
+        else if (name == "SinglePartLoad")
+            testSinglePartLoad (prefix);
+        else if (name == "StreamRoundTrip")
+            testStreamRoundTrip (prefix);
+        else if (name == "SelectiveLoad")
+            testSelectiveLoad (prefix);
+        else if (name == "WindowedLoad")
+            testWindowedLoad (prefix);
+        else if (name == "Utf8Filename")
+            testUtf8Filename (prefix);
+        else if (name == "UnsupportedParts")
+            testUnsupportedParts (prefix);
+        else if (name == "RewriteParts")
+            testRewriteParts (prefix);
+        else if (name == "RewriteValidation")
+            testRewriteValidation (prefix);
+        else
+            throw runtime_error ("unknown test name");
+
+        cout << name << " ok" << endl;
+        return 0;
+    }
+    catch (const exception& error)
+    {
+        cerr << name << " failed: " << error.what () << endl;
+        return 1;
+    }
+}
