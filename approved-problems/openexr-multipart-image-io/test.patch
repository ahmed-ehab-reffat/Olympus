+#!/usr/bin/env bash
+
+set -euo pipefail
+
+output_path=""
+mode=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            output_path="$2"
+            shift 2
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ -z "$output_path" || -z "$mode" ]]; then
+    echo "usage: $0 --output_path <results.xml> <base|new>" >&2
+    exit 2
+fi
+
+if [[ "$output_path" != /* ]]; then
+    output_path="$PWD/$output_path"
+fi
+mkdir -p "$(dirname "$output_path")"
+
+build_dir="$(dirname "$output_path")/build-evaluator"
+runner_log="$(dirname "$output_path")/test-runner.log"
+: >"$runner_log"
+
+run_logged ()
+{
+    set +e
+    "$@" 2>&1 | tee -a "$runner_log"
+    command_status=${PIPESTATUS[0]}
+    set -e
+}
+
+write_failure_junit ()
+{
+    local status="$1"
+    local phase="$2"
+    local testcase="OpenEXRUtilMultipart.Build"
+    if [[ "$mode" == "base" ]]; then testcase="OpenEXRUtil.testIO"; fi
+    local diagnostics
+    diagnostics="$(tail -c 16384 "$runner_log" | sed \
+        -e 's/&/\&amp;/g' \
+        -e 's/</\&lt;/g' \
+        -e 's/>/\&gt;/g')"
+    cat >"$output_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="1">
+  <testsuite name="$mode" tests="1" failures="0" errors="1">
+    <testcase name="$testcase" classname="$testcase">
+      <error message="$phase failed before CTest produced JUnit (exit $status)"/>
+      <system-out>$diagnostics</system-out>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+}
+
+run_logged cmake -S . -B "$build_dir" -G Ninja \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_TESTING=ON \
+    -DOPENEXR_BUILD_EXAMPLES=OFF \
+    -DOPENEXR_BUILD_TOOLS=OFF
+if (( command_status != 0 )); then
+    write_failure_junit "$command_status" "configuration"
+    exit "$command_status"
+fi
+
+if [[ "$mode" == "base" ]]; then
+    run_logged cmake --build "$build_dir" --target OpenEXRUtilTest --parallel 2
+    if (( command_status != 0 )); then
+        write_failure_junit "$command_status" "base build"
+        exit "$command_status"
+    fi
+    run_logged ctest --test-dir "$build_dir" \
+        --output-on-failure \
+        --output-junit "$output_path" \
+        -R '^OpenEXRUtil\.(testFlatImage|testDeepImage|testIO|testImageChannel)$'
+else
+    run_logged ctest --test-dir "$build_dir" \
+        --output-on-failure \
+        --output-junit "$output_path" \
+        -R '^OpenEXRUtilMultipart\.'
+fi
+
+if [[ ! -s "$output_path" ]]; then
+    if (( command_status == 0 )); then command_status=97; fi
+    write_failure_junit "$command_status" "CTest"
+fi
+exit "$command_status"
