+void
+testOwnershipIsolation (const string& prefix)
+{
+    ImageParts   source    = makeHeterogeneousParts ();
+    const string savedFile = prefix + "-ownership-save.exr";
+    saveImages (savedFile, source);
+    FlatImage& sourceFlat = dynamic_cast<FlatImage&> (*source[0].image);
+    sourceFlat.level ().typedChannel<float> ("F").at (0, 0) = -1;
+    source[0].header.setName ("mutated-source");
+
+    ImageParts persisted = loadImages (savedFile);
+    require (
+        persisted[0].header.name () == "flat-scan", "saved header detached");
+    require (
+        dynamic_cast<FlatImage&> (*persisted[0].image)
+                .level ()
+                .typedChannel<float> ("F")
+                .at (0, 0) == 10,
+        "saved pixels detached");
+
+    const float siblingBefore = dynamic_cast<FlatImage&> (*persisted[1].image)
+                                    .level (0, 0)
+                                    .typedChannel<float> ("F")
+                                    .at (0, 0);
+    dynamic_cast<FlatImage&> (*persisted[0].image)
+        .level ()
+        .typedChannel<float> ("F")
+        .at (0, 0) = -2;
+    persisted[0].header.setName ("mutated-loaded");
+    require (persisted[1].header.name () == "flat-ripmap", "header isolation");
+    require (
+        dynamic_cast<FlatImage&> (*persisted[1].image)
+                .level (0, 0)
+                .typedChannel<float> ("F")
+                .at (0, 0) == siblingBefore,
+        "pixel isolation");
+
+    remove (savedFile.c_str ());
+}
