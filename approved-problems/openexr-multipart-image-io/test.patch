+vector<char>
+readBytes (const string& fileName)
+{
+    ifstream input (fileName, ios::binary | ios::ate);
+    require (input.good (), "open file for byte read");
+    const streamoff byteCount = input.tellg ();
+    require (byteCount >= 0, "measure file bytes");
+    vector<char> bytes (static_cast<size_t> (byteCount));
+    input.seekg (0);
+    if (!bytes.empty ()) input.read (bytes.data (), byteCount);
+    require (input.good (), "read complete file bytes");
+    return bytes;
+}
+
+void
+writeBytes (const string& fileName, const vector<char>& bytes)
+{
+    ofstream output (fileName, ios::binary | ios::trunc);
+    require (output.good (), "open file for byte write");
+    if (!bytes.empty ())
+        output.write (bytes.data (), static_cast<streamsize> (bytes.size ()));
+    require (output.good (), "write complete file bytes");
+}
+
+void
+replaceUniqueBytes (vector<char>& bytes, const string& from, const string& to)
+{
+    require (from.size () == to.size (), "replacement byte width");
+    vector<char>::iterator match =
+        search (bytes.begin (), bytes.end (), from.begin (), from.end ());
+    require (match != bytes.end (), "replacement source bytes present");
+    require (
+        search (
+            match + from.size (), bytes.end (), from.begin (), from.end ()) ==
+            bytes.end (),
+        "replacement source bytes unique");
+    copy (to.begin (), to.end (), match);
+}
