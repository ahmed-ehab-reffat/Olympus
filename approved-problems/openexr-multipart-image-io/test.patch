+void
+testWindowedLoad (const string& prefix)
+{
+    const Box2i sourceWindow (V2i (-6, -4), V2i (17, 11));
+    const Box2i crop (V2i (-2, -2), V2i (7, 7));
+    ImageParts  source;
+    source.emplace_back (
+        makeHeader ("window-flat-scan", sourceWindow, false),
+        makeFlat (sourceWindow, ONE_LEVEL, 410, ROUND_DOWN, true));
+    source.emplace_back (
+        makeHeader ("window-flat-tiled", sourceWindow, true),
+        makeFlat (sourceWindow, ONE_LEVEL, 420));
+    source.emplace_back (
+        makeHeader ("window-deep-scan", sourceWindow, false),
+        makeDeep (sourceWindow, ONE_LEVEL, 430));
+    source.emplace_back (
+        makeHeader ("window-deep-tiled", sourceWindow, true),
+        makeDeep (sourceWindow, ONE_LEVEL, 440));
+    source.emplace_back (
+        makeHeader ("window-mipmap", sourceWindow, true),
+        makeFlat (sourceWindow, MIPMAP_LEVELS, 450));
+    source.emplace_back (
+        makeHeader ("window-ripmap", sourceWindow, true),
+        makeFlat (sourceWindow, RIPMAP_LEVELS, 455));
+
+    const string fileName = prefix + "-families.exr";
+    saveImages (fileName, source);
+    const vector<char> bytes    = readBytes (fileName);
+    ImageParts         complete = loadImages (fileName);
+
+    const char* names[] = {
+        "window-flat-scan",
+        "window-flat-tiled",
+        "window-deep-scan",
+        "window-deep-tiled"};
+    const float seeds[] = {410, 420, 430, 440};
+    for (size_t i = 0; i < 4; ++i)
+    {
+        unique_ptr<Image> expected =
+            i < 2 ? makeFlat (crop, ONE_LEVEL, seeds[i], ROUND_DOWN, i == 0)
+                  : makeDeep (crop, ONE_LEVEL, seeds[i]);
+        Header expectedHeader (complete[i].header);
+        expectedHeader.dataWindow () = crop;
+
+        ImagePart filenamePart = loadImagePart (fileName, names[i], crop);
+        compareHeader (
+            filenamePart.header,
+            expectedHeader,
+            string ("window filename header ") + names[i]);
+        compareImage (
+            *filenamePart.image,
+            *expected,
+            string ("window filename samples ") + names[i]);
+
+        MemoryInputStream input (bytes);
+        ImagePart         streamPart = loadImagePart (input, names[i], crop);
+        compareHeader (
+            streamPart.header,
+            expectedHeader,
+            string ("window stream header ") + names[i]);
+        compareImage (
+            *streamPart.image,
+            *expected,
+            string ("window stream samples ") + names[i]);
+    }
+
+    const Box2i partialRequest (V2i (-10, -8), V2i (-1, 3));
+    const Box2i partialCrop (V2i (-6, -4), V2i (-1, 3));
+    ImagePart   partial =
+        loadImagePart (fileName, "window-flat-scan", partialRequest);
+    unique_ptr<Image> partialExpected =
+        makeFlat (partialCrop, ONE_LEVEL, 410, ROUND_DOWN, true);
+    require (
+        partial.header.dataWindow () == partialCrop,
+        "window request is intersected with source");
+    compareImage (*partial.image, *partialExpected, "partial window samples");
+
+    requireThrows (
+        [&] { loadImagePart (fileName, "WINDOW-FLAT-SCAN", crop); },
+        "windowed filename name matching is case-sensitive");
+    MemoryInputStream wrongCaseInput (bytes);
+    requireThrows (
+        [&] { loadImagePart (wrongCaseInput, "WINDOW-FLAT-SCAN", crop); },
+        "windowed stream name matching is case-sensitive");
+
+    requireThrows (
+        [&] {
+            loadImagePart (
+                fileName,
+                "window-flat-scan",
+                Box2i (V2i (30, 20), V2i (34, 24)));
+        },
+        "disjoint window rejected");
+    MemoryInputStream disjointInput (bytes);
+    requireThrows (
+        [&] {
+            loadImagePart (
+                disjointInput,
+                "window-flat-scan",
+                Box2i (V2i (30, 20), V2i (34, 24)));
+        },
+        "stream disjoint window rejected");
+    const Box2i unsampledWindow (V2i (-1, -2), V2i (7, 7));
+    requireThrows (
+        [&] { loadImagePart (fileName, "window-flat-scan", unsampledWindow); },
+        "filename sampled-channel-incompatible window rejected");
+    MemoryInputStream unsampledInput (bytes);
+    requireThrows (
+        [&] {
+            loadImagePart (unsampledInput, "window-flat-scan", unsampledWindow);
+        },
+        "stream sampled-channel-incompatible window rejected");
+    requireThrows (
+        [&] { loadImagePart (fileName, "window-mipmap", crop); },
+        "windowed mipmap rejected");
+    MemoryInputStream multiresInput (bytes);
+    requireThrows (
+        [&] { loadImagePart (multiresInput, "window-mipmap", crop); },
+        "stream windowed mipmap rejected");
+    requireThrows (
+        [&] { loadImagePart (fileName, "window-ripmap", crop); },
+        "windowed ripmap rejected");
+    MemoryInputStream ripmapInput (bytes);
+    requireThrows (
+        [&] { loadImagePart (ripmapInput, "window-ripmap", crop); },
+        "stream windowed ripmap rejected");
+
+    const Box2i faultWindow (V2i (0, 0), V2i (63, 63));
+    const Box2i scanCrop (V2i (5, 0), V2i (18, 7));
+    ImageParts  scanSource;
+    Header      scanHeader    = makeHeader ("scan-fault", faultWindow, false);
+    scanHeader.compression () = ZIP_COMPRESSION;
+    scanSource.emplace_back (
+        scanHeader, makeFlat (faultWindow, ONE_LEVEL, 460));
+    const string scanFile = prefix + "-scan-fault.exr";
+    saveImages (scanFile, scanSource);
+    corruptScanlineChunk (scanFile, 0, 48, "scan fault fixture");
+    requireThrows (
+        [&] { loadImagePart (scanFile, "scan-fault"); },
+        "full scanline load observes damaged unrequested chunk");
+    unique_ptr<Image> expectedScan = makeFlat (scanCrop, ONE_LEVEL, 460);
+    ImagePart isolatedScan = loadImagePart (scanFile, "scan-fault", scanCrop);
+    compareImage (
+        *isolatedScan.image,
+        *expectedScan,
+        "filename scanline fault isolation");
+    const vector<char> scanBytes = readBytes (scanFile);
+    MemoryInputStream  scanInput (scanBytes);
+    ImagePart streamScan = loadImagePart (scanInput, "scan-fault", scanCrop);
+    compareImage (
+        *streamScan.image, *expectedScan, "stream scanline fault isolation");
+
+    ImageParts deepScanSource;
+    Header deepScanHeader = makeHeader ("deep-scan-fault", faultWindow, false);
+    deepScanHeader.compression () = ZIP_COMPRESSION;
+    deepScanSource.emplace_back (
+        deepScanHeader, makeDeep (faultWindow, ONE_LEVEL, 465));
+    const string deepScanFile = prefix + "-deep-scan-fault.exr";
+    saveImages (deepScanFile, deepScanSource);
+    corruptScanlineChunk (deepScanFile, 0, 48, "deep scanline fault fixture");
+    requireThrows (
+        [&] { loadImagePart (deepScanFile, "deep-scan-fault"); },
+        "full deep scanline load observes damaged unrequested chunk");
+    unique_ptr<Image> expectedDeepScan = makeDeep (scanCrop, ONE_LEVEL, 465);
+    ImagePart         isolatedDeepScan =
+        loadImagePart (deepScanFile, "deep-scan-fault", scanCrop);
+    compareImage (
+        *isolatedDeepScan.image,
+        *expectedDeepScan,
+        "filename deep scanline fault isolation");
+    const vector<char> deepScanBytes = readBytes (deepScanFile);
+    MemoryInputStream  deepScanInput (deepScanBytes);
+    ImagePart          streamDeepScan =
+        loadImagePart (deepScanInput, "deep-scan-fault", scanCrop);
+    compareImage (
+        *streamDeepScan.image,
+        *expectedDeepScan,
+        "stream deep scanline fault isolation");
+
+    const Box2i tileCrop (V2i (0, 0), V2i (2, 1));
+    ImageParts  flatTileSource;
+    Header flatTileHeader = makeHeader ("flat-tile-fault", faultWindow, true);
+    flatTileHeader.tileDescription () = TileDescription (16, 16);
+    flatTileHeader.compression ()     = ZIP_COMPRESSION;
+    flatTileSource.emplace_back (
+        flatTileHeader, makeFlat (faultWindow, ONE_LEVEL, 468));
+    const string flatTileFile = prefix + "-flat-tile-fault.exr";
+    saveImages (flatTileFile, flatTileSource);
+    corruptTileChunk (flatTileFile, 0, 3, 3, "flat tile fault fixture");
+    requireThrows (
+        [&] { loadImagePart (flatTileFile, "flat-tile-fault"); },
+        "full flat tiled load observes damaged unrequested tile");
+    unique_ptr<Image> expectedFlatTile = makeFlat (tileCrop, ONE_LEVEL, 468);
+    ImagePart         isolatedFlatTile =
+        loadImagePart (flatTileFile, "flat-tile-fault", tileCrop);
+    compareImage (
+        *isolatedFlatTile.image,
+        *expectedFlatTile,
+        "filename flat tile fault isolation");
+    const vector<char> flatTileBytes = readBytes (flatTileFile);
+    MemoryInputStream  flatTileInput (flatTileBytes);
+    ImagePart          streamFlatTile =
+        loadImagePart (flatTileInput, "flat-tile-fault", tileCrop);
+    compareImage (
+        *streamFlatTile.image,
+        *expectedFlatTile,
+        "stream flat tile fault isolation");
+
+    ImageParts tileSource;
+    tileSource.emplace_back (
+        makeHeader ("deep-tile-fault", sourceWindow, true),
+        makeDeep (sourceWindow, ONE_LEVEL, 470));
+    const string tileFile = prefix + "-tile-fault.exr";
+    saveImages (tileFile, tileSource);
+    corruptTileChunk (tileFile, 0, 7, 7, "deep tile fault fixture");
+    requireThrows (
+        [&] { loadImagePart (tileFile, "deep-tile-fault"); },
+        "full tiled load observes damaged unrequested tile");
+    unique_ptr<Image> expectedTile = makeDeep (tileCrop, ONE_LEVEL, 470);
+    ImagePart         isolatedTile =
+        loadImagePart (tileFile, "deep-tile-fault", tileCrop);
+    compareImage (
+        *isolatedTile.image, *expectedTile, "filename tile fault isolation");
+    const vector<char> tileBytes = readBytes (tileFile);
+    MemoryInputStream  tileInput (tileBytes);
+    ImagePart          streamTile =
+        loadImagePart (tileInput, "deep-tile-fault", tileCrop);
+    compareImage (
+        *streamTile.image, *expectedTile, "stream tile fault isolation");
+
+    remove (tileFile.c_str ());
+    remove (flatTileFile.c_str ());
+    remove (deepScanFile.c_str ());
+    remove (scanFile.c_str ());
+    remove (fileName.c_str ());
+}
