+void
+testSelectiveLoad (const string& prefix)
+{
+    const Box2i window (V2i (0, 0), V2i (63, 63));
+    ImageParts  source;
+    Header      damagedHeader    = makeHeader ("damaged-flat", window, false);
+    damagedHeader.compression () = ZIP_COMPRESSION;
+    source.emplace_back (damagedHeader, makeFlat (window, ONE_LEVEL, 110));
+    Header selectedHeader       = makeHeader ("Hero", window, true);
+    selectedHeader.lineOrder () = RANDOM_Y;
+    selectedHeader.insert ("selectiveToken", IntAttribute (731));
+    source.emplace_back (
+        selectedHeader, makeDeep (window, MIPMAP_LEVELS, 120, ROUND_UP));
+    source.emplace_back (
+        makeHeader ("hero", window, true), makeFlat (window, ONE_LEVEL, 130));
+
+    const string fileName = prefix + "-selective.exr";
+    saveImages (fileName, source);
+    const vector<char> validBytes = readBytes (fileName);
+    ImageParts         complete   = loadImages (fileName);
+    requireThrows (
+        [&] { loadImagePart (fileName, "HERO"); },
+        "case-folded missing name must be rejected");
+
+    corruptFirstScanlineChunk (fileName);
+    const string damagedCheckFile = prefix + "-damaged-check.exr";
+    requireThrows (
+        [&] {
+            Header ignored;
+            extractAndLoadPart (fileName, damagedCheckFile, 0, ignored);
+        },
+        "low-level fixture check must observe damaged payload");
+    remove (damagedCheckFile.c_str ());
+
+    ImagePart selected = loadImagePart (fileName, "Hero");
+    require (selected.header.name () == "Hero", "filename exact-case name");
+    compareHeader (
+        selected.header, complete[1].header, "filename selected header");
+    compareImage (*selected.image, *source[1].image, "filename selected part");
+    ImagePart trailingFile = loadImagePart (fileName, "hero");
+    require (
+        trailingFile.header.name () == "hero", "filename case-neighbor name");
+    compareImage (
+        *trailingFile.image,
+        *source[2].image,
+        "filename selected tiled flat part");
+
+    const vector<char> damagedBytes   = readBytes (fileName);
+    ImagePart          streamSelected = [&] {
+        MemoryInputStream input (damagedBytes);
+        return loadImagePart (input, "Hero");
+    }();
+    require (
+        streamSelected.header.name () == "Hero",
+        "stream exact-case damaged-sibling name");
+    compareHeader (
+        streamSelected.header, complete[1].header, "stream selected header");
+    compareImage (
+        *streamSelected.image,
+        *source[1].image,
+        "stream selected damaged-sibling part");
+
+    MemoryInputStream validInput (validBytes);
+    ImagePart         trailing = loadImagePart (validInput, "hero");
+    require (trailing.header.name () == "hero", "stream case-neighbor name");
+    compareImage (
+        *trailing.image, *source[2].image, "later selected flat part");
+    remove (fileName.c_str ());
+}
