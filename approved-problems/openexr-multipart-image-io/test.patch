+class MemoryOutputStream : public OStream
+{
+public:
+    MemoryOutputStream () : OStream ("memory-output.exr"), _position (0) {}
+
+    void write (const char bytes[], int count) override
+    {
+        if (count < 0) throw ArgExc ("negative memory write");
+        const uint64_t end = _position + static_cast<uint64_t> (count);
+        if (end > _bytes.size ()) _bytes.resize (static_cast<size_t> (end));
+        memcpy (_bytes.data () + _position, bytes, static_cast<size_t> (count));
+        _position = end;
+    }
+
+    uint64_t tellp () override { return _position; }
+
+    void seekp (uint64_t position) override
+    {
+        if (position > _bytes.size ()) throw ArgExc ("memory seek past end");
+        _position = position;
+    }
+
+    const vector<char>& bytes () const { return _bytes; }
+
+private:
+    vector<char> _bytes;
+    uint64_t     _position;
+};
+
+class MemoryInputStream : public IStream
+{
+public:
+    explicit MemoryInputStream (const vector<char>& bytes)
+        : IStream ("memory-input.exr"), _bytes (bytes), _position (0)
+    {}
+
+    bool read (char destination[], int count) override
+    {
+        if (count < 0 ||
+            _position + static_cast<uint64_t> (count) > _bytes.size ())
+            throw InputExc ("memory read past end");
+        memcpy (
+            destination,
+            _bytes.data () + _position,
+            static_cast<size_t> (count));
+        _position += static_cast<uint64_t> (count);
+        return _position < _bytes.size ();
+    }
+
+    uint64_t tellg () override { return _position; }
+
+    void seekg (uint64_t position) override
+    {
+        if (position > _bytes.size ()) throw InputExc ("memory seek past end");
+        _position = position;
+    }
+
+    int64_t size () override { return static_cast<int64_t> (_bytes.size ()); }
+
+private:
+    const vector<char>& _bytes;
+    uint64_t            _position;
+};
