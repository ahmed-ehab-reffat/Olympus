+package tech.tablesaw.io.arrow;
+
+import java.io.File;
+import java.io.InputStream;
+import java.nio.file.Path;
+import tech.tablesaw.io.ReadOptions;
+import tech.tablesaw.io.Source;
+
+/** Options for reading an Arrow IPC stream. */
+public final class ArrowReadOptions extends ReadOptions {
+
+  private ArrowReadOptions(Builder builder) {
+    super(builder);
+  }
+
+  public static Builder builder(Source source) {
+    return new Builder(source);
+  }
+
+  public static Builder builder(File file) {
+    return new Builder(file);
+  }
+
+  public static Builder builder(Path path) {
+    return builder(path.toFile());
+  }
+
+  public static Builder builder(String fileName) {
+    return builder(new File(fileName));
+  }
+
+  public static Builder builder(InputStream stream) {
+    return new Builder(stream);
+  }
+
+  public static final class Builder extends ReadOptions.Builder {
+
+    private Builder(Source source) {
+      super(source);
+    }
+
+    private Builder(File file) {
+      super(file);
+    }
+
+    private Builder(InputStream stream) {
+      super(stream);
+    }
+
+    @Override
+    public Builder tableName(String tableName) {
+      super.tableName(tableName);
+      return this;
+    }
+
+    @Override
+    public ArrowReadOptions build() {
+      return new ArrowReadOptions(this);
+    }
+  }
+}
