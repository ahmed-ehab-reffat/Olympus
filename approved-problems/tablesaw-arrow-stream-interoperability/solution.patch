+package tech.tablesaw.io.arrow;
+
+import com.google.common.base.Preconditions;
+import java.io.File;
+import java.io.OutputStream;
+import java.nio.file.Path;
+import tech.tablesaw.io.Destination;
+import tech.tablesaw.io.WriteOptions;
+
+/** Options for writing an Arrow IPC stream. */
+public final class ArrowWriteOptions extends WriteOptions {
+
+  private static final int DEFAULT_BATCH_SIZE = 65_536;
+
+  private final int batchSize;
+
+  private ArrowWriteOptions(Builder builder) {
+    super(builder);
+    this.batchSize = builder.batchSize;
+  }
+
+  public int batchSize() {
+    return batchSize;
+  }
+
+  public boolean autoClose() {
+    return autoClose;
+  }
+
+  public static Builder builder(Destination destination) {
+    return new Builder(destination);
+  }
+
+  public static Builder builder(OutputStream stream) {
+    return new Builder(stream);
+  }
+
+  public static Builder builder(File file) {
+    return new Builder(file);
+  }
+
+  public static Builder builder(Path path) {
+    return builder(path.toFile());
+  }
+
+  public static Builder builder(String fileName) {
+    return builder(new File(fileName));
+  }
+
+  public static final class Builder extends WriteOptions.Builder {
+
+    private int batchSize = DEFAULT_BATCH_SIZE;
+
+    private Builder(Destination destination) {
+      super(destination);
+    }
+
+    private Builder(OutputStream stream) {
+      super(stream);
+    }
+
+    private Builder(File file) {
+      super(file);
+    }
+
+    public Builder batchSize(int batchSize) {
+      Preconditions.checkArgument(batchSize > 0, "Arrow batch size must be positive");
+      this.batchSize = batchSize;
+      return this;
+    }
+
+    public ArrowWriteOptions build() {
+      return new ArrowWriteOptions(this);
+    }
+  }
+}
