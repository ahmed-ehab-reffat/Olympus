+package tech.tablesaw.io.arrow;
+
+import static org.apache.arrow.vector.types.FloatingPointPrecision.DOUBLE;
+import static org.apache.arrow.vector.types.FloatingPointPrecision.SINGLE;
+
+import java.nio.charset.StandardCharsets;
+import java.time.DateTimeException;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.LocalTime;
+import java.time.ZoneOffset;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.Supplier;
+import org.apache.arrow.vector.BigIntVector;
+import org.apache.arrow.vector.BitVector;
+import org.apache.arrow.vector.DateDayVector;
+import org.apache.arrow.vector.DateMilliVector;
+import org.apache.arrow.vector.FieldVector;
+import org.apache.arrow.vector.Float4Vector;
+import org.apache.arrow.vector.Float8Vector;
+import org.apache.arrow.vector.IntVector;
+import org.apache.arrow.vector.SmallIntVector;
+import org.apache.arrow.vector.TimeMicroVector;
+import org.apache.arrow.vector.TimeMilliVector;
+import org.apache.arrow.vector.TimeNanoVector;
+import org.apache.arrow.vector.TimeSecVector;
+import org.apache.arrow.vector.TimeStampMilliTZVector;
+import org.apache.arrow.vector.TimeStampMilliVector;
+import org.apache.arrow.vector.TimeStampVector;
+import org.apache.arrow.vector.VarCharVector;
+import org.apache.arrow.vector.types.DateUnit;
+import org.apache.arrow.vector.types.TimeUnit;
+import org.apache.arrow.vector.types.Types;
+import org.apache.arrow.vector.types.pojo.ArrowType;
+import org.apache.arrow.vector.types.pojo.Field;
+import org.apache.arrow.vector.types.pojo.FieldType;
+import tech.tablesaw.api.BooleanColumn;
+import tech.tablesaw.api.DateColumn;
+import tech.tablesaw.api.DateTimeColumn;
+import tech.tablesaw.api.DoubleColumn;
+import tech.tablesaw.api.FloatColumn;
+import tech.tablesaw.api.InstantColumn;
+import tech.tablesaw.api.IntColumn;
+import tech.tablesaw.api.LongColumn;
+import tech.tablesaw.api.ShortColumn;
+import tech.tablesaw.api.StringColumn;
+import tech.tablesaw.api.TimeColumn;
+import tech.tablesaw.columns.Column;
+
+/** Central registry for the two directions of the Tablesaw/Arrow type boundary. */
+final class ArrowColumnAdapters {
+
+  private static final long MILLIS_PER_DAY = 86_400_000L;
+  private static final long NANOS_PER_DAY = 86_400_000_000_000L;
+  private static final Map<Types.MinorType, ReadAdapter> READERS = new HashMap<>();
+  private static final Map<String, WriteAdapter> WRITERS = new HashMap<>();
+
+  static {
+    registerReader(
+        name -> StringColumn.create(name),
+        (vector, column) -> {
+          VarCharVector values = (VarCharVector) vector;
+          StringColumn target = (StringColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) target.appendMissing();
+            else {
+              String value = new String(values.get(row), StandardCharsets.UTF_8);
+              if (value.isEmpty()) throw missingCollision(vector, "empty UTF-8 string");
+              target.append(value);
+            }
+          }
+        },
+        Types.MinorType.VARCHAR);
+    registerReader(
+        name -> LongColumn.create(name),
+        (vector, column) -> {
+          BigIntVector values = (BigIntVector) vector;
+          LongColumn target = (LongColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) target.appendMissing();
+            else {
+              long value = values.get(row);
+              if (value == Long.MIN_VALUE) throw missingCollision(vector, "Long.MIN_VALUE");
+              target.append(value);
+            }
+          }
+        },
+        Types.MinorType.BIGINT);
+    registerReader(
+        name -> IntColumn.create(name),
+        (vector, column) -> {
+          IntVector values = (IntVector) vector;
+          IntColumn target = (IntColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) target.appendMissing();
+            else {
+              int value = values.get(row);
+              if (value == Integer.MIN_VALUE) throw missingCollision(vector, "Integer.MIN_VALUE");
+              target.append(value);
+            }
+          }
+        },
+        Types.MinorType.INT);
+    registerReader(
+        name -> ShortColumn.create(name),
+        (vector, column) -> {
+          SmallIntVector values = (SmallIntVector) vector;
+          ShortColumn target = (ShortColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) target.appendMissing();
+            else {
+              short value = values.get(row);
+              if (value == Short.MIN_VALUE) throw missingCollision(vector, "Short.MIN_VALUE");
+              target.append(value);
+            }
+          }
+        },
+        Types.MinorType.SMALLINT);
+    registerReader(
+        name -> DateColumn.create(name),
+        ArrowColumnAdapters::appendDates,
+        Types.MinorType.DATEDAY,
+        Types.MinorType.DATEMILLI);
+    registerReader(
+        name -> TimeColumn.create(name),
+        ArrowColumnAdapters::appendTimes,
+        Types.MinorType.TIMESEC,
+        Types.MinorType.TIMEMILLI,
+        Types.MinorType.TIMEMICRO,
+        Types.MinorType.TIMENANO);
+    registerReader(
+        name -> DateTimeColumn.create(name),
+        ArrowColumnAdapters::appendDateTimes,
+        Types.MinorType.TIMESTAMPSEC,
+        Types.MinorType.TIMESTAMPMILLI,
+        Types.MinorType.TIMESTAMPMICRO,
+        Types.MinorType.TIMESTAMPNANO);
+    registerReader(
+        name -> InstantColumn.create(name),
+        ArrowColumnAdapters::appendInstants,
+        Types.MinorType.TIMESTAMPSECTZ,
+        Types.MinorType.TIMESTAMPMILLITZ,
+        Types.MinorType.TIMESTAMPMICROTZ,
+        Types.MinorType.TIMESTAMPNANOTZ);
+    registerReader(
+        name -> BooleanColumn.create(name),
+        (vector, column) -> {
+          BitVector values = (BitVector) vector;
+          BooleanColumn target = (BooleanColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) target.appendMissing();
+            else target.append((byte) values.get(row));
+          }
+        },
+        Types.MinorType.BIT);
+    registerReader(
+        name -> FloatColumn.create(name),
+        (vector, column) -> {
+          Float4Vector values = (Float4Vector) vector;
+          FloatColumn target = (FloatColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) {
+              target.appendMissing();
+            } else {
+              float value = values.get(row);
+              if (Float.isNaN(value)) throw validNan(vector);
+              target.append(value);
+            }
+          }
+        },
+        Types.MinorType.FLOAT4);
+    registerReader(
+        name -> DoubleColumn.create(name),
+        (vector, column) -> {
+          Float8Vector values = (Float8Vector) vector;
+          DoubleColumn target = (DoubleColumn) column;
+          for (int row = 0; row < values.getValueCount(); row++) {
+            if (values.isNull(row)) {
+              target.appendMissing();
+            } else {
+              double value = values.get(row);
+              if (Double.isNaN(value)) throw validNan(vector);
+              target.append(value);
+            }
+          }
+        },
+        Types.MinorType.FLOAT8);
+
+    registerWriter(
+        "STRING",
+        ArrowType.Utf8::new,
+        (vector, column, firstRow, rowCount) -> {
+          VarCharVector values = (VarCharVector) vector;
+          StringColumn source = (StringColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.get(sourceRow).getBytes(StandardCharsets.UTF_8));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "LONG",
+        () -> new ArrowType.Int(64, true),
+        (vector, column, firstRow, rowCount) -> {
+          BigIntVector values = (BigIntVector) vector;
+          LongColumn source = (LongColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.getLong(sourceRow));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "INTEGER",
+        () -> new ArrowType.Int(32, true),
+        (vector, column, firstRow, rowCount) -> {
+          IntVector values = (IntVector) vector;
+          IntColumn source = (IntColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.getInt(sourceRow));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "SHORT",
+        () -> new ArrowType.Int(16, true),
+        (vector, column, firstRow, rowCount) -> {
+          SmallIntVector values = (SmallIntVector) vector;
+          ShortColumn source = (ShortColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.getShort(sourceRow));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "LOCAL_DATE",
+        () -> new ArrowType.Date(DateUnit.DAY),
+        (vector, column, firstRow, rowCount) -> {
+          DateDayVector values = (DateDayVector) vector;
+          DateColumn source = (DateColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, Math.toIntExact(source.get(sourceRow).toEpochDay()));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "LOCAL_DATE_TIME",
+        () -> new ArrowType.Timestamp(TimeUnit.MILLISECOND, null),
+        (vector, column, firstRow, rowCount) -> {
+          TimeStampMilliVector values = (TimeStampMilliVector) vector;
+          DateTimeColumn source = (DateTimeColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else
+              values.setSafe(row, source.get(sourceRow).toInstant(ZoneOffset.UTC).toEpochMilli());
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "LOCAL_TIME",
+        () -> new ArrowType.Time(TimeUnit.MILLISECOND, 32),
+        (vector, column, firstRow, rowCount) -> {
+          TimeMilliVector values = (TimeMilliVector) vector;
+          TimeColumn source = (TimeColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, (int) (source.get(sourceRow).toNanoOfDay() / 1_000_000L));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "INSTANT",
+        () -> new ArrowType.Timestamp(TimeUnit.MILLISECOND, "UTC"),
+        (vector, column, firstRow, rowCount) -> {
+          TimeStampMilliTZVector values = (TimeStampMilliTZVector) vector;
+          InstantColumn source = (InstantColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.get(sourceRow).toEpochMilli());
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "BOOLEAN",
+        ArrowType.Bool::new,
+        (vector, column, firstRow, rowCount) -> {
+          BitVector values = (BitVector) vector;
+          BooleanColumn source = (BooleanColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.getByte(sourceRow));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "FLOAT",
+        () -> new ArrowType.FloatingPoint(SINGLE),
+        (vector, column, firstRow, rowCount) -> {
+          Float4Vector values = (Float4Vector) vector;
+          FloatColumn source = (FloatColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.getFloat(sourceRow));
+          }
+          values.setValueCount(rowCount);
+        });
+    registerWriter(
+        "DOUBLE",
+        () -> new ArrowType.FloatingPoint(DOUBLE),
+        (vector, column, firstRow, rowCount) -> {
+          Float8Vector values = (Float8Vector) vector;
+          DoubleColumn source = (DoubleColumn) column;
+          for (int row = 0; row < rowCount; row++) {
+            int sourceRow = firstRow + row;
+            if (source.isMissing(sourceRow)) values.setNull(row);
+            else values.setSafe(row, source.getDouble(sourceRow));
+          }
+          values.setValueCount(rowCount);
+        });
+  }
+
+  private ArrowColumnAdapters() {}
+
+  static Column<?> createColumn(FieldVector vector) {
+    return reader(vector).factory.apply(vector.getName());
+  }
+
+  static void append(FieldVector vector, Column<?> column) {
+    reader(vector).appender.append(vector, column);
+  }
+
+  static Field field(Column<?> column) {
+    WriteAdapter adapter = writer(column);
+    return new Field(column.name(), FieldType.nullable(adapter.type.get()), null);
+  }
+
+  static void write(FieldVector vector, Column<?> column, int firstRow, int rowCount) {
+    writer(column).writer.write(vector, column, firstRow, rowCount);
+  }
+
+  private static ReadAdapter reader(FieldVector vector) {
+    ReadAdapter adapter = READERS.get(vector.getMinorType());
+    if (adapter == null) {
+      throw new IllegalArgumentException(
+          "Unsupported Arrow type "
+              + vector.getMinorType().name()
+              + " for field "
+              + vector.getName());
+    }
+    return adapter;
+  }
+
+  private static WriteAdapter writer(Column<?> column) {
+    WriteAdapter adapter = WRITERS.get(column.type().name());
+    if (adapter == null) {
+      throw new IllegalArgumentException(
+          "Unsupported Tablesaw column type " + column.type().name());
+    }
+    return adapter;
+  }
+
+  private static void registerReader(
+      Function<String, Column<?>> factory, BatchAppender appender, Types.MinorType... types) {
+    ReadAdapter adapter = new ReadAdapter(factory, appender);
+    Arrays.stream(types).forEach(type -> READERS.put(type, adapter));
+  }
+
+  private static void registerWriter(
+      String columnType, Supplier<ArrowType> type, VectorWriter writer) {
+    WRITERS.put(columnType, new WriteAdapter(type, writer));
+  }
+
+  private static void appendDates(FieldVector vector, Column<?> column) {
+    DateColumn target = (DateColumn) column;
+    for (int row = 0; row < vector.getValueCount(); row++) {
+      if (vector.isNull(row)) {
+        target.appendMissing();
+      } else if (vector instanceof DateDayVector) {
+        LocalDate date = LocalDate.ofEpochDay(((DateDayVector) vector).get(row));
+        requirePackedYear(date, vector);
+        target.append(date);
+      } else {
+        long millis = ((DateMilliVector) vector).get(row);
+        requireMultiple(millis, MILLIS_PER_DAY, vector, "date millisecond");
+        LocalDate date = LocalDate.ofEpochDay(millis / MILLIS_PER_DAY);
+        requirePackedYear(date, vector);
+        target.append(date);
+      }
+    }
+  }
+
+  private static void appendTimes(FieldVector vector, Column<?> column) {
+    TimeColumn target = (TimeColumn) column;
+    for (int row = 0; row < vector.getValueCount(); row++) {
+      if (vector.isNull(row)) {
+        target.appendMissing();
+        continue;
+      }
+      long nanos;
+      try {
+        nanos = timeNanos(vector, row);
+      } catch (ArithmeticException e) {
+        throw new IllegalArgumentException(
+            "Arrow time value is outside one day for field " + vector.getName(), e);
+      }
+      if (nanos < 0 || nanos >= NANOS_PER_DAY) {
+        throw new IllegalArgumentException(
+            "Arrow time value is outside one day for field " + vector.getName());
+      }
+      target.append(LocalTime.ofNanoOfDay(nanos));
+    }
+  }
+
+  private static long timeNanos(FieldVector vector, int row) {
+    switch (vector.getMinorType()) {
+      case TIMESEC:
+        return Math.multiplyExact(((TimeSecVector) vector).get(row), 1_000_000_000L);
+      case TIMEMILLI:
+        return Math.multiplyExact(((TimeMilliVector) vector).get(row), 1_000_000L);
+      case TIMEMICRO:
+        long micros = ((TimeMicroVector) vector).get(row);
+        requireMultiple(micros, 1_000L, vector, "microsecond time");
+        return Math.multiplyExact(micros, 1_000L);
+      case TIMENANO:
+        long nanos = ((TimeNanoVector) vector).get(row);
+        requireMultiple(nanos, 1_000_000L, vector, "nanosecond time");
+        return nanos;
+      default:
+        throw new AssertionError(vector.getMinorType());
+    }
+  }
+
+  private static void appendDateTimes(FieldVector vector, Column<?> column) {
+    DateTimeColumn target = (DateTimeColumn) column;
+    TimeStampVector values = (TimeStampVector) vector;
+    for (int row = 0; row < values.getValueCount(); row++) {
+      if (values.isNull(row)) {
+        target.appendMissing();
+      } else {
+        try {
+          LocalDateTime dateTime = LocalDateTime.ofInstant(timestamp(values, row), ZoneOffset.UTC);
+          requirePackedYear(dateTime.toLocalDate(), vector);
+          target.append(dateTime);
+        } catch (DateTimeException e) {
+          throw new IllegalArgumentException(
+              "Arrow timestamp is outside Tablesaw's range for field " + vector.getName(), e);
+        }
+      }
+    }
+  }
+
+  private static void appendInstants(FieldVector vector, Column<?> column) {
+    InstantColumn target = (InstantColumn) column;
+    TimeStampVector values = (TimeStampVector) vector;
+    for (int row = 0; row < values.getValueCount(); row++) {
+      if (values.isNull(row)) target.appendMissing();
+      else {
+        try {
+          Instant instant = timestamp(values, row);
+          requirePackedYear(LocalDateTime.ofInstant(instant, ZoneOffset.UTC).toLocalDate(), vector);
+          target.append(instant);
+        } catch (DateTimeException e) {
+          throw new IllegalArgumentException(
+              "Arrow timestamp is outside Tablesaw's range for field " + vector.getName(), e);
+        }
+      }
+    }
+  }
+
+  private static Instant timestamp(TimeStampVector vector, int row) {
+    long value = vector.get(row);
+    switch (vector.getMinorType()) {
+      case TIMESTAMPSEC:
+      case TIMESTAMPSECTZ:
+        return Instant.ofEpochSecond(value);
+      case TIMESTAMPMILLI:
+      case TIMESTAMPMILLITZ:
+        return Instant.ofEpochMilli(value);
+      case TIMESTAMPMICRO:
+      case TIMESTAMPMICROTZ:
+        requireMultiple(value, 1_000L, vector, "microsecond timestamp");
+        return Instant.ofEpochMilli(value / 1_000L);
+      case TIMESTAMPNANO:
+      case TIMESTAMPNANOTZ:
+        requireMultiple(value, 1_000_000L, vector, "nanosecond timestamp");
+        return Instant.ofEpochMilli(value / 1_000_000L);
+      default:
+        throw new AssertionError(vector.getMinorType());
+    }
+  }
+
+  private static void requireMultiple(
+      long value, long unit, FieldVector vector, String description) {
+    if (value % unit != 0) {
+      throw new IllegalArgumentException(
+          "Cannot represent " + description + " without loss for field " + vector.getName());
+    }
+  }
+
+  private static IllegalArgumentException validNan(FieldVector vector) {
+    return new IllegalArgumentException(
+        "Cannot represent a valid NaN separately from missingness for field " + vector.getName());
+  }
+
+  private static IllegalArgumentException missingCollision(FieldVector vector, String description) {
+    return new IllegalArgumentException(
+        "Cannot represent valid "
+            + description
+            + " separately from missingness for field "
+            + vector.getName());
+  }
+
+  private static void requirePackedYear(LocalDate date, FieldVector vector) {
+    if (date.getYear() < Short.MIN_VALUE || date.getYear() > Short.MAX_VALUE) {
+      throw new IllegalArgumentException(
+          "Year "
+              + date.getYear()
+              + " is outside Tablesaw's representable packed range for field "
+              + vector.getName());
+    }
+  }
+
+  private interface BatchAppender {
+    void append(FieldVector vector, Column<?> column);
+  }
+
+  private interface VectorWriter {
+    void write(FieldVector vector, Column<?> column, int firstRow, int rowCount);
+  }
+
+  private static final class ReadAdapter {
+    private final Function<String, Column<?>> factory;
+    private final BatchAppender appender;
+
+    private ReadAdapter(Function<String, Column<?>> factory, BatchAppender appender) {
+      this.factory = factory;
+      this.appender = appender;
+    }
+  }
+
+  private static final class WriteAdapter {
+    private final Supplier<ArrowType> type;
+    private final VectorWriter writer;
+
+    private WriteAdapter(Supplier<ArrowType> type, VectorWriter writer) {
+      this.type = type;
+      this.writer = writer;
+    }
+  }
+}
