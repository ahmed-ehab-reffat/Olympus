+  @Test
+  void readsDictionaryEncodedUtf8WithIndexValidity() throws Exception {
+    Path file = tempDir.resolve("dictionary.arrows");
+    DictionaryEncoding encoding = new DictionaryEncoding(73L, false, new ArrowType.Int(32, true));
+
+    try (BufferAllocator allocator = new RootAllocator(Long.MAX_VALUE);
+        DictionaryProvider.MapDictionaryProvider provider =
+            new DictionaryProvider.MapDictionaryProvider();
+        VarCharVector source =
+            new VarCharVector(
+                "label", new FieldType(true, new ArrowType.Utf8(), encoding), allocator)) {
+      VarCharVector values = new VarCharVector("labels", allocator);
+      values.allocateNew();
+      values.setSafe(0, "alpha".getBytes(StandardCharsets.UTF_8));
+      values.setSafe(1, "café".getBytes(StandardCharsets.UTF_8));
+      values.setValueCount(2);
+      provider.put(new Dictionary(values, encoding));
+
+      source.allocateNew();
+      source.setSafe(0, "café".getBytes(StandardCharsets.UTF_8));
+      source.setNull(1);
+      source.setSafe(2, "alpha".getBytes(StandardCharsets.UTF_8));
+      source.setSafe(3, "café".getBytes(StandardCharsets.UTF_8));
+      source.setValueCount(4);
+
+      try (FieldVector encoded =
+              (FieldVector) DictionaryEncoder.encode(source, provider.lookup(73L));
+          VectorSchemaRoot root = VectorSchemaRoot.of(encoded);
+          FileOutputStream out = new FileOutputStream(file.toFile());
+          ArrowStreamWriter writer =
+              new ArrowStreamWriter(root, provider, Channels.newChannel(out))) {
+        root.setRowCount(4);
+        writer.start();
+        writer.writeBatch();
+        writer.end();
+      }
+    }
+
+    Table table = assertDoesNotThrow(() -> new ArrowReader(file).read());
+    assertEquals("STRING", table.column("label").type().name());
+    assertEquals(Arrays.asList("café", "", "alpha", "café"), table.stringColumn("label").asList());
+    assertTrue(table.stringColumn("label").isMissing(1));
+  }
