+  @Test
+  void standardIoOptionsPreserveValuesAcrossConfiguredBatchBoundaries() throws Exception {
+    IntColumn numbers = IntColumn.create("number");
+    StringColumn labels = StringColumn.create("label");
+    for (int value : new int[] {10, 20, 30, 40, 50}) numbers.append(value);
+    labels.append("a");
+    labels.appendMissing();
+    labels.append("c");
+    labels.append("d");
+    labels.appendMissing();
+    Table source = Table.create("source", numbers, labels);
+
+    TrackingOutputStream output = new TrackingOutputStream();
+    WriteOptions writeOptions = arrowWriteOptions(output, 2);
+    assertDoesNotThrow(() -> source.write().usingOptions(writeOptions));
+    assertFalse(output.closed);
+
+    List<Integer> batchSizes = new ArrayList<>();
+    List<Integer> actualNumbers = new ArrayList<>();
+    List<String> actualLabels = new ArrayList<>();
+    try (BufferAllocator allocator = new RootAllocator(Long.MAX_VALUE);
+        ArrowStreamReader reader =
+            new ArrowStreamReader(
+                Channels.newChannel(new ByteArrayInputStream(output.toByteArray())), allocator)) {
+      while (reader.loadNextBatch()) {
+        int rowCount = reader.getVectorSchemaRoot().getRowCount();
+        batchSizes.add(rowCount);
+        assertTrue(rowCount > 0 && rowCount <= 2, "batch row count " + rowCount);
+        IntVector number = (IntVector) reader.getVectorSchemaRoot().getVector("number");
+        VarCharVector label = (VarCharVector) reader.getVectorSchemaRoot().getVector("label");
+        for (int row = 0; row < rowCount; row++) {
+          actualNumbers.add(number.get(row));
+          actualLabels.add(label.isNull(row) ? null : utf8(label, row));
+        }
+      }
+    }
+    assertTrue(batchSizes.size() > 1, batchSizes.toString());
+    assertEquals(5, batchSizes.stream().mapToInt(Integer::intValue).sum());
+    assertEquals(Arrays.asList(10, 20, 30, 40, 50), actualNumbers);
+    assertEquals(Arrays.asList("a", null, "c", "d", null), actualLabels);
+
+    ReadOptions readOptions =
+        arrowReadOptions(new ByteArrayInputStream(output.toByteArray()), "recovered");
+    Table recovered = assertDoesNotThrow(() -> Table.read().usingOptions(readOptions));
+    assertEquals("recovered", recovered.name());
+    assertEquals(source.intColumn("number").asList(), recovered.intColumn("number").asList());
+    assertEquals(source.stringColumn("label").asList(), recovered.stringColumn("label").asList());
+    assertDoesNotThrow(() -> output.write(42));
+  }
