+  private static LocalDate arrowDate(VectorSchemaRoot root, String name, int row) {
+    FieldVector vector = root.getVector(name);
+    ArrowType.Date type = (ArrowType.Date) vector.getField().getType();
+    switch (type.getUnit()) {
+      case DAY:
+        return LocalDate.ofEpochDay(((DateDayVector) vector).get(row));
+      case MILLISECOND:
+        return LocalDate.ofEpochDay(
+            Math.floorDiv(((DateMilliVector) vector).get(row), 86_400_000L));
+      default:
+        throw new AssertionError("unsupported Arrow date unit " + type.getUnit());
+    }
+  }
+
+  private static LocalTime arrowTime(VectorSchemaRoot root, String name, int row) {
+    FieldVector vector = root.getVector(name);
+    ArrowType.Time type = (ArrowType.Time) vector.getField().getType();
+    long nanos;
+    switch (type.getUnit()) {
+      case SECOND:
+        nanos = Math.multiplyExact(((TimeSecVector) vector).get(row), 1_000_000_000L);
+        break;
+      case MILLISECOND:
+        nanos = Math.multiplyExact(((TimeMilliVector) vector).get(row), 1_000_000L);
+        break;
+      case MICROSECOND:
+        nanos = Math.multiplyExact(((TimeMicroVector) vector).get(row), 1_000L);
+        break;
+      case NANOSECOND:
+        nanos = ((TimeNanoVector) vector).get(row);
+        break;
+      default:
+        throw new AssertionError("unsupported Arrow time unit " + type.getUnit());
+    }
+    return LocalTime.ofNanoOfDay(nanos);
+  }
+
+  private static LocalDateTime arrowLocalDateTime(VectorSchemaRoot root, String name, int row) {
+    FieldVector vector = root.getVector(name);
+    ArrowType.Timestamp type = (ArrowType.Timestamp) vector.getField().getType();
+    assertEquals(null, type.getTimezone(), name + " must remain timezone-free");
+    return LocalDateTime.ofInstant(
+        instantFromArrowTimestamp(((TimeStampVector) vector).get(row), type.getUnit()),
+        ZoneOffset.UTC);
+  }
+
+  private static Instant arrowInstant(VectorSchemaRoot root, String name, int row) {
+    FieldVector vector = root.getVector(name);
+    ArrowType.Timestamp type = (ArrowType.Timestamp) vector.getField().getType();
+    assertTrue(type.getTimezone() != null, name + " must remain timezone-bearing");
+    return instantFromArrowTimestamp(((TimeStampVector) vector).get(row), type.getUnit());
+  }
+
+  private static Instant instantFromArrowTimestamp(long value, TimeUnit unit) {
+    switch (unit) {
+      case SECOND:
+        return Instant.ofEpochSecond(value);
+      case MILLISECOND:
+        return Instant.ofEpochMilli(value);
+      case MICROSECOND:
+        return Instant.ofEpochSecond(
+            Math.floorDiv(value, 1_000_000L), Math.floorMod(value, 1_000_000L) * 1_000L);
+      case NANOSECOND:
+        return Instant.ofEpochSecond(
+            Math.floorDiv(value, 1_000_000_000L), Math.floorMod(value, 1_000_000_000L));
+      default:
+        throw new AssertionError("unsupported Arrow timestamp unit " + unit);
+    }
+  }
