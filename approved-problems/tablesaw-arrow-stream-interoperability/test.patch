+    assertEquals(LocalTime.of(1, 2, 3), table.timeColumn("timeSec").get(0));
+    assertEquals(time, table.timeColumn("timeMilli").get(0));
+    assertEquals(time, table.timeColumn("timeMicro").get(0));
+    assertEquals(time, table.timeColumn("timeNano").get(0));
+    assertEquals(
+        localDateTime(Instant.ofEpochSecond(millis / 1_000L)),
