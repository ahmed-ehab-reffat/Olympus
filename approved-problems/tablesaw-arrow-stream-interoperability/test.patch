+    assertEquals(
+        localDateTime(Instant.ofEpochMilli(millis)), table.dateTimeColumn("localMilli").get(0));
+    assertEquals(
+        localDateTime(Instant.ofEpochMilli(millis)), table.dateTimeColumn("localMicro").get(0));
+    assertEquals(
+        localDateTime(Instant.ofEpochMilli(millis)), table.dateTimeColumn("localNano").get(0));
+    assertEquals(Instant.ofEpochSecond(millis / 1_000L), table.instantColumn("instantSec").get(0));
+    assertEquals(Instant.ofEpochMilli(millis), table.instantColumn("instantMilli").get(0));
