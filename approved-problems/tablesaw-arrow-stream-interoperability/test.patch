+  @Test
+  void independentStreamPreservesEveryPopulatedAndZeroRowBatch() throws Exception {
+    Schema schema =
+        schema(field("text", new ArrowType.Utf8()), field("number", new ArrowType.Int(32, true)));
+    Path file = tempDir.resolve("multi.arrows");
+    writeStream(
+        file,
+        schema,
+        root -> setTextAndInt(root, "alpha", 1),
+        root -> setRowCount(root, 0),
+        root -> setNullTextAndInt(root, 2),
+        root -> setTextAndInt(root, "café", 3));
+
+    Table table = assertDoesNotThrow(() -> new ArrowReader(file).read());
+    assertEquals(3, table.rowCount());
+    assertEquals(Arrays.asList("alpha", "", "café"), table.stringColumn("text").asList());
+    assertTrue(table.stringColumn("text").isMissing(1));
+    assertEquals(Arrays.asList(1, 2, 3), table.intColumn("number").asList());
+
+    Path zeroOnly = tempDir.resolve("zero-only.arrows");
+    writeStream(
+        zeroOnly,
+        schema(field("number", new ArrowType.Int(32, true))),
+        root -> setRowCount(root, 0));
+
+    Table empty = assertDoesNotThrow(() -> new ArrowReader(zeroOnly).read());
+    assertEquals(1, empty.columnCount());
+    assertEquals("number", empty.intColumn("number").name());
+    assertEquals(0, empty.rowCount());
+  }
