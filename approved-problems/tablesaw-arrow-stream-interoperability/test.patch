+  private void writeMixedTextDictionary(Path file, boolean dictionaryFirst) throws Exception {
+    DictionaryEncoding encoding = new DictionaryEncoding(85L, false, new ArrowType.Int(32, true));
+    try (BufferAllocator allocator = new RootAllocator(Long.MAX_VALUE);
+        DictionaryProvider.MapDictionaryProvider provider =
+            new DictionaryProvider.MapDictionaryProvider();
+        VarCharVector values = new VarCharVector("mixedTextValues", allocator);
+        VarCharVector direct = new VarCharVector("direct", allocator);
+        IntVector indices =
+            new IntVector(
+                "encoded", new FieldType(true, encoding.getIndexType(), encoding), allocator)) {
+      values.allocateNew();
+      values.setSafe(0, "alpha".getBytes(StandardCharsets.UTF_8));
+      values.setSafe(1, "café".getBytes(StandardCharsets.UTF_8));
+      values.setValueCount(2);
+      provider.put(new Dictionary(values, encoding));
+      direct.allocateNew();
+      indices.allocateNew();
+      FieldVector[] fields =
+          dictionaryFirst
+              ? new FieldVector[] {indices, direct}
+              : new FieldVector[] {direct, indices};
+      try (VectorSchemaRoot root = VectorSchemaRoot.of(fields);
+          FileOutputStream out = new FileOutputStream(file.toFile());
+          ArrowStreamWriter writer =
+              new ArrowStreamWriter(root, provider, Channels.newChannel(out))) {
+        writer.start();
+        direct.setSafe(0, "plain-a".getBytes(StandardCharsets.UTF_8));
+        direct.setNull(1);
+        indices.setSafe(0, 0);
+        indices.setSafe(1, 1);
+        direct.setValueCount(2);
+        indices.setValueCount(2);
+        root.setRowCount(2);
+        writer.writeBatch();
+
+        direct.reset();
+        indices.reset();
+        direct.setSafe(0, "plain-c".getBytes(StandardCharsets.UTF_8));
+        indices.setNull(0);
+        direct.setValueCount(1);
+        indices.setValueCount(1);
+        root.setRowCount(1);
+        writer.writeBatch();
+        writer.end();
+      }
+    }
+  }
