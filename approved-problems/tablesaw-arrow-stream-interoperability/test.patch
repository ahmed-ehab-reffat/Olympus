+    }
+    long millis = 1_700_000_000_123L;
+    LocalTime time = LocalTime.of(1, 2, 3, 4_000_000);
+    assertEquals("snowman ☃", table.stringColumn("text").get(0));
+    assertEquals(9_000_000_000L, table.longColumn("i64").getLong(0));
