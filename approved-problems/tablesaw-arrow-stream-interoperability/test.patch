+            output_path="$2"
+            shift 2
+            ;;
+        --output_path=*)
+            output_path="${1#*=}"
+            shift
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            echo "usage: $0 --output_path PATH {base|new}" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ -z "$output_path" || -z "$mode" ]]; then
+    echo "usage: $0 --output_path PATH {base|new}" >&2
+    exit 2
+fi
+
+case "$output_path" in
+    /*) ;;
+    *) output_path="$PWD/$output_path" ;;
+esac
+
+run_root="$(mktemp -d /tmp/tablesaw-arrow-tests.XXXXXX)" || exit 2
+repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 2
+cleanup() {
+    case "$run_root" in
+        /tmp/tablesaw-arrow-tests.*) rm -rf -- "$run_root" ;;
+    esac
+}
+trap cleanup EXIT
+
+cp -R "$repository_root/." "$run_root/source" || exit 2
+cd "$run_root/source" || exit 2
+rm -rf target core/target arrow/target
+
+run_user_home="$run_root/user-home"
+report_dir="arrow/target/surefire-reports"
+mkdir -p "$run_user_home" "$run_root/java-tmp" "$(dirname "$output_path")"
+
+if [[ "$mode" == "base" ]]; then
+    tests="ArrowWriterTest"
+else
+    tests="ArrowInteroperability_6f5cTest"
+fi
+
+mvn -o -B -Dmaven.repo.local="${MAVEN_REPO_LOCAL:-/root/.m2/repository}" \
+    -Duser.home="$run_user_home" -Djava.io.tmpdir="$run_root/java-tmp" -Dstyle.color=never \
+    -pl arrow -Dtest="$tests" -Dsurefire.failIfNoSpecifiedTests=false test \
+    2>&1 | tee "$run_root/maven-$mode.log"
+maven_status=${PIPESTATUS[0]}
+status=$maven_status
+
+reports=("$report_dir"/TEST-*.xml)
+if [[ -e "${reports[0]}" ]]; then
+    {
+        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<testsuites>'
+        for report in "${reports[@]}"; do
+            sed -n '/<testsuite /,/<\/testsuite>/p' "$report"
+        done
+        if [[ $maven_status -ne 0 ]]; then
+            printf '%s\n' \
+                '  <testsuite name="test-harness-diagnostics" tests="0" failures="0" errors="0">' \
+                "    <system-err>Maven exited with status $maven_status after producing Surefire XML"
+            tail -n 200 "$run_root/maven-$mode.log" \
+                | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+            printf '%s\n' '    </system-err>' '  </testsuite>'
+        fi
+        printf '%s\n' '</testsuites>'
+    } >"$output_path"
+else
+    [[ $status -ne 0 ]] || status=1
+    {
+        printf '%s\n' \
+            '<?xml version="1.0" encoding="UTF-8"?>' \
+            '<testsuites tests="1" failures="1" errors="0">' \
+            '  <testsuite name="test-harness" tests="1" failures="1" errors="0">' \
+            "    <testcase name=\"maven-$mode\">" \
+            "      <failure message=\"Maven exited with status $maven_status without producing Surefire XML\">"
+        tail -n 200 "$run_root/maven-$mode.log" \
+            | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+        printf '%s\n' \
+            '      </failure>' \
+            '    </testcase>' \
+            '  </testsuite>' \
+            '</testsuites>'
+    } >"$output_path"
+fi
+
+exit "$status"
