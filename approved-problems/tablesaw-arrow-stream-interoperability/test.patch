+  private static void setDictionaryIndex(FieldVector vector, int row, int value) {
+    switch (vector.getMinorType()) {
+      case TINYINT:
+        ((TinyIntVector) vector).setSafe(row, (byte) value);
+        break;
+      case SMALLINT:
+        ((SmallIntVector) vector).setSafe(row, (short) value);
+        break;
+      case INT:
+        ((IntVector) vector).setSafe(row, value);
+        break;
+      case BIGINT:
+        ((BigIntVector) vector).setSafe(row, value);
+        break;
+      case UINT1:
+        ((UInt1Vector) vector).setSafe(row, value);
+        break;
+      case UINT2:
+        ((UInt2Vector) vector).setSafe(row, value);
+        break;
+      case UINT4:
+        ((UInt4Vector) vector).setSafe(row, value);
+        break;
+      case UINT8:
+        ((UInt8Vector) vector).setSafe(row, value);
+        break;
+      default:
+        throw new AssertionError("unexpected dictionary index vector " + vector.getMinorType());
+    }
+  }
