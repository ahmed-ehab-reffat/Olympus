+  private static void assertWriterValues(VectorSchemaRoot root, int row) {
+    assertEquals("writer ☃", utf8(root, "text", row));
+    assertEquals(9_000_000_000L, ((BigIntVector) root.getVector("i64")).get(row));
+    assertEquals(42, ((IntVector) root.getVector("i32")).get(row));
+    assertEquals(7, ((SmallIntVector) root.getVector("i16")).get(row));
+    assertEquals(LocalDate.of(2020, 2, 3), arrowDate(root, "date", row));
+    assertEquals(
+        LocalDateTime.of(2020, 2, 3, 4, 5, 6, 7_000_000),
+        arrowLocalDateTime(root, "dateTime", row));
+    assertEquals(LocalTime.of(4, 5, 6, 7_000_000), arrowTime(root, "time", row));
+    assertEquals(Instant.ofEpochMilli(1_700_000_000_123L), arrowInstant(root, "instant", row));
+    assertEquals(1, ((BitVector) root.getVector("bool")).get(row));
+    assertEquals(1.25f, ((Float4Vector) root.getVector("f32")).get(row));
