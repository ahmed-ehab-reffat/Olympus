+    block = ct.nlsys(update, output, states=1, inputs=1, outputs=1, dt=0.1,
+                     name='block')
+    single = ct.interconnect(
+        [mr481b8f_fast(), block], connections=[['block.u[0]', 'fast.y']],
+        inplist=['fast.u'], outlist=['block.y[0]'])
