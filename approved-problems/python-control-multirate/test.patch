+def test_unspecified_discrete_subsystem_timebase_481b8f():
+    gain = ct.ss(np.zeros((0, 0)), np.zeros((0, 1)), np.zeros((1, 0)), [[2.]],
+                 dt=True, name='gain', inputs='u', outputs='y')
+    sys = ct.interconnect(
+        [mr481b8f_fast(), mr481b8f_slow(), gain],
+        connections=[['gain.u', 'fast.y'], ['slow.u', 'gain.y']],
+        inplist=['fast.u'], outlist=['slow.y'])
+    assert isinstance(sys, ct.MultirateSystem)
+    assert sys.dt == pytest.approx(0.1)
+    assert sys.nphases == 2
+
+    time = np.arange(0, 0.6, 0.1)
+    outputs = ct.input_output_response(sys, time, 1.0).outputs
+    xfast, xslow, held = 0., 0., 0.
+    expected = []
+    for step in range(len(time)):
+        yfast = xfast
+        acts = step % 2 == 0
+        yslow = 2 * xslow + 0.5 * (2 * yfast) if acts else held
+        expected.append(yslow)
+        xfast_next = 0.5 * xfast + 1.0
+        if acts:
+            xslow, held = 0.8 * xslow + 2 * yfast, yslow
+        xfast = xfast_next
+    np.testing.assert_allclose(outputs, expected)
+
