+    assert not isinstance(single, ct.MultirateSystem)
+    assert single.nstates == 2
+
+    block_slow = ct.nlsys(update, output, states=1, inputs=1, outputs=1,
+                          dt=0.2, name='block')
+    mixed = ct.interconnect(
+        [mr481b8f_fast(), block_slow],
+        connections=[['block.u[0]', 'fast.y']], inplist=['fast.u'],
