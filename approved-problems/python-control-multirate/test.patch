+#!/bin/sh
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")" || exit 1
+
+export MPLBACKEND=Agg
+export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/matplotlib}"
+export SETUPTOOLS_SCM_PRETEND_VERSION=0.10.2
+
+NEW_TESTS="control/tests/multirate_481b8f_test.py"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -v -p no:cacheprovider \
+      --junitxml="$OUTPUT_PATH"
+  EXIT_CODE=$?
+else
+  python -m pytest control/tests -v -p no:cacheprovider \
+      --ignore="$NEW_TESTS" --junitxml="$OUTPUT_PATH"
+  EXIT_CODE=$?
+fi
+
+if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0" time="0">
+<testcase classname="control.tests.multirate_481b8f_test" name="collection">
+<failure message="test collection failed">The test module could not be collected.</failure>
+</testcase>
+</testsuite></testsuites>
+XMLEOF
+  exit 1
+fi
+
+exit $EXIT_CODE
