+def mr481b8f_fast(name='fast', dt=0.1):
+    return ct.ss([[0.5]], [[1.]], [[1.]], [[0.]], dt=dt, name=name,
+                 inputs='u', outputs='y', states='x')
+
+
+def mr481b8f_slow(name='slow', dt=0.2):
+    return ct.ss([[0.8]], [[1.]], [[2.]], [[0.5]], dt=dt, name=name,
+                 inputs='u', outputs='y', states='x')
+
+
+def mr481b8f_cascade(offsets=None, slow_dt=0.2, name=None):
+    return ct.interconnect(
+        [mr481b8f_fast(), mr481b8f_slow(dt=slow_dt)],
+        connections=[['slow.u', 'fast.y']], inplist=['fast.u'],
+        outlist=['slow.y'], offsets=offsets, name=name)
+
+
+def mr481b8f_cascade_reference(u, ratio=2, offset=0):
+    xfast, xslow, held = 0., 0., 0.
+    outputs = []
+    for step, value in enumerate(u):
+        yfast = xfast
+        acts = step >= offset and (step - offset) % ratio == 0
+        yslow = 2 * xslow + 0.5 * yfast if acts else held
+        outputs.append(yslow)
+        xfast_next = 0.5 * xfast + value
+        if acts:
+            xslow, held = 0.8 * xslow + yfast, yslow
+        xfast = xfast_next
+    return np.array(outputs)
+
+
+def mr481b8f_lift_reference(models, nsteps):
+    nstates = models[0].A.shape[0]
+    ninputs = models[0].B.shape[1]
+    noutputs = models[0].C.shape[0]
+    A = np.eye(nstates)
+    B = np.zeros((nstates, nsteps * ninputs))
+    C = np.zeros((nsteps * noutputs, nstates))
+    D = np.zeros((nsteps * noutputs, nsteps * ninputs))
+    transition = np.eye(nstates)
+    for step in range(nsteps):
+        C[step * noutputs:(step + 1) * noutputs] = models[step].C @ transition
+        transition = models[step].A @ transition
+    A = transition
+    for step in range(nsteps):
+        reach = models[step].B
+        D[step * noutputs:(step + 1) * noutputs,
+          step * ninputs:(step + 1) * ninputs] = models[step].D
+        for later in range(step + 1, nsteps):
+            D[later * noutputs:(later + 1) * noutputs,
+              step * ninputs:(step + 1) * ninputs] = models[later].C @ reach
+            reach = models[later].A @ reach
+        B[:, step * ninputs:(step + 1) * ninputs] = reach
+    return A, B, C, D
+
