+def commensurate_timebase(dtlist):
+    """Find the base timebase for a set of commensurate sample times.
+
+    Sample times are commensurate when each of them is an integer multiple
+    of their greatest common divisor.  That divisor is the base timebase,
+    the rate at which an interconnection of systems having those sample
+    times has to be simulated.
+
+    Parameters
+    ----------
+    dtlist : list of `InputOutputSystem` or float
+        Sample times, or systems with a 'dt' attribute (e.g.
+        `TransferFunction` or `StateSpace` system).
+
+    Returns
+    -------
+    dt : float
+        The base timebase, the greatest common divisor of the sample times.
+    ratios : list of int
+        The sample time of each entry divided by the base timebase.
+    period : float
+        The least common multiple of the sample times, after which the
+        pattern of which systems act at which time repeats.
+
+    Raises
+    ------
+    ValueError
+        If any entry is continuous time or has an unspecified timebase, or
+        if the sample times are not commensurate.
+
+    Examples
+    --------
+    >>> ct.commensurate_timebase([0.2, 0.3])
+    (0.1, [2, 3], 0.6)
+
+    """
+    dtlist = [dt.dt if hasattr(dt, 'dt') else dt for dt in dtlist]
+    if not dtlist:
+        raise ValueError("systems have incompatible timebases")
+    for dt in dtlist:
+        if dt is None or dt is True or \
+           not isinstance(dt, (int, float, np.integer, np.floating)) or \
+           not np.isfinite(dt) or dt <= 0:
+            raise ValueError("systems have incompatible timebases")
+    shortest = min(float(dt) for dt in dtlist)
+    fractions = [_timebase_fraction(float(dt) / shortest) for dt in dtlist]
+    base = reduce(_fraction_gcd, fractions)
+    ratios = [int(frac / base) for frac in fractions]
+    period = base * reduce(math.lcm, ratios)
+    return float(base) * shortest, ratios, float(period) * shortest
