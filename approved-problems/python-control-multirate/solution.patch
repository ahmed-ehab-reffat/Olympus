+        model = StateSpace(
+            inner.A, inner.B, inner.C, inner.D, dt=inner.dt, name=sys.name,
+            inputs=sys.input_labels, outputs=sys.output_labels,
+            states=sys.state_labels)
+    else:
+        model = NonlinearIOSystem(
+            lambda t, x, u, params: inner.dynamics(t, x, u, params),
+            lambda t, x, u, params: inner.output(t, x, u, params),
+            dt=inner.dt, name=sys.name, inputs=sys.input_labels,
+            outputs=sys.output_labels, states=sys.state_labels)
+    return model, acts
+
+
+def _multirate_subsystem(sys, ratio, offset, phase, dt):
+    # Build the base rate model of a subsystem that acts once every `ratio`
+    # base steps, starting at step `offset`.  A subsystem that acts at every
+    # step is used as is; the others carry one extra state per input, holding
+    # the value that was read when the subsystem last acted.
+    from .statesp import StateSpace
+
+    model, acts = _multirate_action(sys, ratio, offset, phase)
+    if ratio == 1:
+        return model
+
+    nstates, ninputs = model.nstates, model.ninputs
+    noutputs = model.noutputs
+    delim = config.defaults['iosys.state_name_delim']
+    states = list(model.state_labels) + \
+        [label + delim + 'hold' for label in model.output_labels]
+
+    if not isinstance(model, StateSpace):
+        def updfcn(t, x, u, params):
+            if not acts:
+                return x
+            return np.concatenate([
+                np.asarray(model.dynamics(t, x[:nstates], u, params)),
+                np.asarray(model.output(t, x[:nstates], u, params))])
+
+        def outfcn(t, x, u, params):
+            if not acts:
+                return x[nstates:]
+            return model.output(t, x[:nstates], u, params)
+
+        return NonlinearIOSystem(
+            updfcn, outfcn, params=model.params, dt=dt, name=sys.name,
+            inputs=model.input_labels, outputs=model.output_labels,
+            states=states)
+
+    if acts:
+        A = np.block([
+            [model.A, np.zeros((nstates, noutputs))],
+            [model.C, np.zeros((noutputs, noutputs))]])
+        B = np.vstack([model.B, model.D])
+        C = np.hstack([model.C, np.zeros((noutputs, noutputs))])
+        D = model.D
+    else:
+        A = np.eye(nstates + noutputs)
+        B = np.zeros((nstates + noutputs, ninputs))
+        C = np.hstack([np.zeros((noutputs, nstates)), np.eye(noutputs)])
+        D = np.zeros((noutputs, ninputs))
+
+    return StateSpace(
+        A, B, C, D, dt=dt, name=sys.name, inputs=model.input_labels,
+        outputs=model.output_labels, states=states)
+
+
+def _multirate_offsets(offsets, ratios):
+    # Check the requested offsets against the rate of each subsystem
+    if offsets is None:
+        return [0] * len(ratios)
+    if all(ratio == 1 for ratio in ratios):
+        raise ValueError(
+            "`offsets` requires systems with different sample times")
+    if len(offsets) != len(ratios):
+        raise ValueError("`offsets` must have one entry per system")
+
+    checked = []
+    for offset, ratio in zip(offsets, ratios):
+        step = _base_step(offset, f"offset {offset}")
+        if step < 0 or step >= ratio:
+            raise ValueError(
+                f"offset {step} is out of range for a system acting every "
+                f"{ratio} steps")
+        checked.append(step)
+    return checked
+
+
+def _multirate_interconnect(syslist, base, ratios, period, offsets=None,
+                            **kwargs):
+    # Build a multirate interconnection by assembling, for each base step of
+    # the period, the interconnection of the base rate models of the
+    # subsystems at that step.  Continuous-time subsystems see signals that
+    # are constant over a base step, so they enter as their zero order hold
+    # equivalent at the base timebase.
+    from .dtime import sample_system
+    from .statesp import StateSpace, _convert_to_statespace
+    from .xferfcn import TransferFunction
+
+    prepared = []
+    for sys in syslist:
+        if isinstance(sys, TransferFunction):
+            sys = _convert_to_statespace(sys)
+        if sys.dt == 0:
+            if not isinstance(sys, StateSpace):
+                raise ValueError(
+                    f"continuous-time system '{sys.name}' must be linear to "
+                    "take part in a multirate interconnection")
+            sys = sample_system(sys, base, method='zoh', name=sys.name)
+        prepared.append(sys)
+
+    offsets = _multirate_offsets(offsets, ratios)
+    name = kwargs.pop('name', None)
+    check_unused = kwargs.pop('check_unused', True)
+    nphases = int(round(period / base))
+
+    phase_systems = []
+    for phase in range(nphases):
+        phase_list = [
+            _multirate_subsystem(sys, ratio, offset, phase, base)
+            for sys, ratio, offset in zip(prepared, ratios, offsets)]
+        phase_systems.append(interconnect(
+            phase_list, check_unused=check_unused and phase == 0,
+            name=name if nphases == 1 else 'multirate_phase',
+            warn_duplicate=False, **kwargs))
+
+    if nphases == 1:
+        return phase_systems[0]
+    return MultirateSystem(phase_systems, period, name=name)
+
