+
+def _base_step(value, what):
+    # A base step is identified by value, so a whole valued float counts,
+    # while one that is merely close to a whole number does not
+    try:
+        return operator.index(value)
+    except TypeError:
+        pass
+    if isinstance(value, (float, np.floating)) and float(value).is_integer():
+        return int(value)
+    raise ValueError(f"{what} is not a base step")
