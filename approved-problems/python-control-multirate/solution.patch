+
+def _multirate_structure(syslist):
+    # Work out the base timebase, the per-system ratios and the period of a
+    # list of systems, or None when the single rate code path already covers
+    # the list.  Continuous-time systems ride along at the base timebase; a
+    # subsystem that is itself multirate repeats after its own period, not
+    # after its sample time.
+    dtlist = [getattr(sys, 'dt', None) for sys in syslist]
+    unspecified = [dt is None or dt is True for dt in dtlist]
+    continuous = [not free and dt == 0 for dt, free in zip(dtlist, unspecified)]
+
+    sampled = [dt for dt, free, cont in zip(dtlist, unspecified, continuous)
+               if not free and not cont]
+    if not sampled:
+        return None
+    base, _, _ = commensurate_timebase(sampled)
