+class MultirateSystem(NonlinearIOSystem):
+    """Interconnection of discrete-time systems with different sample times.
+
+    A multirate system runs at the base timebase of its subsystems, the
+    greatest common divisor of their sample times.  Each subsystem acts once
+    every `ratio` base steps, where `ratio` is its sample time divided by
+    the base timebase; between those steps it holds the input it last read
+    and its state does not move.  The behavior therefore repeats with a
+    period given by the least common multiple of the sample times, and the
+    system is described by one linear model per base step of that period.
+
+    Multirate systems are created by `interconnect` (or by `series`,
+    `parallel` and `feedback`) and are not usually created directly.
+
+    Parameters
+    ----------
+    phase_systems : list of `StateSpace`
+        Linear model that applies at each base step of the period, in order.
+    period : float
+        Least common multiple of the subsystem sample times.
+    name : string, optional
+        System name.
+
+    Attributes
+    ----------
+    ninputs, noutputs, nstates : int
+        Number of input, output and state variables.
+    nphases : int
+        Number of base steps in one period.
+    input_labels, output_labels, state_labels : list of str
+        Names for the input, output, and state variables.
+
+    See Also
+    --------
+    interconnect, lift, NonlinearIOSystem
+
+    """
+    def __init__(self, phase_systems, period, name=None, **kwargs):
+        from .statesp import StateSpace
+
+        self.phase_systems = list(phase_systems)
+        self.period = period
+        self._linear = all(
+            isinstance(sys, StateSpace) for sys in self.phase_systems)
+        template = self.phase_systems[0]
+        super().__init__(
+            lambda t, x, u, params: self._rhs(t, x, u),
+            lambda t, x, u, params: self._out(t, x, u),
+            name=name, dt=template.dt,
+            inputs=template.input_labels, outputs=template.output_labels,
+            states=template.state_labels, **kwargs)
+
+    @property
+    def nphases(self):
+        """Number of base steps in one period."""
+        return len(self.phase_systems)
+
+    def __str__(self):
+        return InputOutputSystem.__str__(self) + \
+            f"\n\nPeriod: {self.period}\nPhases: {self.nphases}"
+
+    def _phase(self, t):
+        # The base step holding t, so a time between two steps belongs to the
+        # one that started; the rounding keeps a step boundary off the step
+        # below it when t / dt lands just under an integer
+        return int(np.floor(round(t / self.dt, 9))) % self.nphases
+
+    def phase_system(self, phase):
+        """Linear model that applies at a given base step.
+
+        Parameters
+        ----------
+        phase : int
+            Index of the base step within the period, taken modulo the
+            number of phases.
+
+        Returns
+        -------
+        sys : `StateSpace`
+            System giving the state update and output at that base step.
+
+        Raises
+        ------
+        ValueError
+            If `phase` is not a base step.
+
+        """
+        step = _base_step(phase, f"phase {phase}")
+        return self.phase_systems[step % self.nphases]
+
+    def __neg__(self):
+        from .statesp import StateSpace
+
+        if not self._linear:
+            raise ValueError("system is not linear")
+        negated = [
+            StateSpace(sys.A, sys.B, -sys.C, -sys.D, dt=sys.dt,
+                       inputs=self.input_labels, outputs=self.output_labels,
+                       states=self.state_labels)
+            for sys in self.phase_systems]
+        return MultirateSystem(negated, self.period)
+
+    def __mul__(self, other):
