+    def dcgain(self):
+        """Steady-state response of a multirate system at each base step.
+
+        Returns the output the system settles to for a constant unit input,
+        one entry for each base step of the period.
+
+        Returns
+        -------
+        gain : 3D array
+            Array of shape (`nphases`, `noutputs`, `ninputs`) holding the
+            steady-state gain at each base step of the period.
+
+        Raises
+        ------
+        ValueError
