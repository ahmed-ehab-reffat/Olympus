+        """
+        if not self._linear:
+            raise ValueError("system is not linear")
+        monodromy = np.eye(self.nstates)
+        forced = np.zeros((self.nstates, self.ninputs))
+        for sys in self.phase_systems:
+            forced = sys.A @ forced + sys.B
+            monodromy = sys.A @ monodromy
