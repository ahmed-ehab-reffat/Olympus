+def lift(sys, dt=None, name=None):
+    """Lift a discrete-time system to a slower sample time.
+
+    Returns the time-invariant system obtained by taking the inputs and the
+    outputs of `sys` over one longer sampling interval as single stacked
+    signals.  The lifted input holds the inputs applied at the successive
+    base steps of that interval, earliest first, and the lifted output holds
+    the outputs produced at those steps in the same order.  The state of the
+    lifted system is the state of `sys` at the start of the interval, so the
+    two systems have the same states and the same initial conditions.
+
+    Lifting a multirate system over its period removes the dependence on
+    which base step is being taken, so the result describes the whole
+    system with a single set of matrices.
+
+    Parameters
+    ----------
+    sys : `StateSpace`, `TransferFunction` or `MultirateSystem`
+        Discrete-time system to lift.
+    dt : float, optional
+        Sample time of the lifted system.  It must be a positive integer
+        multiple of the sample time of `sys`, and for a multirate system
+        also of its period.  Defaults to the period of a multirate system
+        and to the sample time of `sys` otherwise.
+    name : string, optional
+        Name of the lifted system.
+
+    Returns
+    -------
+    sysl : `StateSpace`
+        Lifted system, with `dt` as its sample time.
+
+    Raises
+    ------
+    ValueError
+        If `sys` is not a discrete-time system with a specified sample time,
+        or if `dt` is not an allowed multiple of its sample time.
+
+    Examples
+    --------
+    >>> sys = ct.ss([[0.5]], [[1]], [[1]], [[0]], dt=0.1)
+    >>> ct.lift(sys, 0.2).D
+    array([[0. , 0. ],
+           [1. , 0. ]])
+
+    """
+    from .nlsys import MultirateSystem
+    from .statesp import StateSpace, _convert_to_statespace
+    from .xferfcn import TransferFunction
+
+    if isinstance(sys, TransferFunction):
+        sys = _convert_to_statespace(sys)
+    if not isinstance(sys, (StateSpace, MultirateSystem)):
+        raise ValueError("system must be a linear or multirate system")
+    if sys.dt is None or sys.dt is True or sys.dt == 0:
+        raise ValueError("system must have a specified sample time")
+    if isinstance(sys, MultirateSystem) and not sys._linear:
+        raise ValueError("system must be linear to be lifted")
+
+    nphases = sys.nphases if isinstance(sys, MultirateSystem) else 1
+    period = sys.period if isinstance(sys, MultirateSystem) else sys.dt
+    dt = period if dt is None else dt
+
+    if not isinstance(dt, (int, float, np.integer, np.floating)) or \
+       not np.isfinite(dt):
+        raise ValueError(
+            "sample time of the lifted system must be a finite number")
+
+    nsteps = int(round(dt / sys.dt))
+    if nsteps < 1 or not np.isclose(nsteps * sys.dt, dt) or \
+       nsteps % nphases != 0:
+        raise ValueError(
+            "sample time of the lifted system must be a positive integer "
+            f"multiple of {period}")
+
+    if isinstance(sys, MultirateSystem):
+        models = [sys.phase_system(step) for step in range(nsteps)]
+    else:
+        models = [sys] * nsteps
+
+    nstates, ninputs, noutputs = sys.nstates, sys.ninputs, sys.noutputs
+    A = np.eye(nstates)
+    C = np.zeros((nsteps * noutputs, nstates))
+    for step, model in enumerate(models):
+        C[step * noutputs:(step + 1) * noutputs, :] = model.C @ A
+        A = model.A @ A
+
+    B = np.zeros((nstates, nsteps * ninputs))
+    D = np.zeros((nsteps * noutputs, nsteps * ninputs))
+    for step, model in enumerate(models):
+        # Propagate the effect of the input applied at this step forward
+        reach = model.B
+        D[step * noutputs:(step + 1) * noutputs,
+          step * ninputs:(step + 1) * ninputs] = model.D
+        for later in range(step + 1, nsteps):
+            D[later * noutputs:(later + 1) * noutputs,
+              step * ninputs:(step + 1) * ninputs] = models[later].C @ reach
+            reach = models[later].A @ reach
+        B[:, step * ninputs:(step + 1) * ninputs] = reach
+
+    return StateSpace(
+        A, B, C, D, dt=dt, name=name, states=list(sys.state_labels))
+
+
