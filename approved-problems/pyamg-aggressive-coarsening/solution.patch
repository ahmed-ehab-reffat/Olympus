+"""Sparsification of coarse-grid operators for Classical AMG.
+
+A Galerkin coarse-grid operator fills in as a hierarchy is built, and the fill
+is what makes a hierarchy expensive.  Sparsification drops the weak entries of
+an operator and lumps what it dropped back into the rows it kept, so that the
+action of the operator on a constant vector is unchanged.
+"""
+
+import numpy as np
+from scipy.sparse import csr_array, issparse
+
+__all__ = ['sparsify_coarse_operator']
+
+
+def sparsify_coarse_operator(A, theta=0.1, lump='diagonal', symmetric=True,
+                             B=None, protect=None):
+    """Drop the weak entries of an operator and lump them back in.
+
+    Parameters
+    ----------
+    A : csr_array
+        NxN matrix in CSR format.
+    theta : float in [0, 1), default 0.1
+        An off-diagonal entry is retained when its magnitude is at least theta
+        times the largest off-diagonal magnitude in its row.
+    lump : {'diagonal', 'strong', 'none'}, default 'diagonal'
+        Where the sum of the dropped entries of a row goes: onto the diagonal,
+        spread over the retained off-diagonal entries in proportion to their
+        magnitudes, or nowhere.
+    symmetric : bool, default True
+        Retain an entry when either it or its transpose is retained.
+    B : array, default None
+        Vector whose image under A the sparsified operator must reproduce.
+        Defaults to the vector of ones.
+    protect : csr_array, default None
+        Matrix whose stored positions are retained whatever the threshold says.
+
+    Returns
+    -------
+    csr_array
+        Sparsified operator with the same shape and diagonal positions as A.
+
+    See Also
+    --------
+    pyamg.classical.classical.ruge_stuben_solver
+
+    Examples
+    --------
+    >>> import numpy as np
+    >>> from scipy.sparse import csr_array
+    >>> from pyamg.classical.sparsify import sparsify_coarse_operator
+    >>> A = csr_array(np.array([[4.0, -2.0, -0.1], [-2.0, 4.0, -2.0],
+    ...                         [-0.1, -2.0, 4.0]]))
+    >>> sparsify_coarse_operator(A, theta=0.5).toarray()
+    array([[ 3.9, -2. ,  0. ],
+           [-2. ,  4. , -2. ],
+           [ 0. , -2. ,  3.9]])
+
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix')
+    if not 0 <= theta < 1:
+        raise ValueError('theta must lie in [0, 1)')
+    if lump not in ('diagonal', 'strong', 'none'):
+        raise ValueError(f'Unknown lumping method {lump}')
+
+    n = A.shape[0]
+    if n == 0:
+        return A.copy()
+
+    if B is None:
+        B = np.ones(n, dtype=float)
+    else:
+        B = np.asarray(B).ravel()
+        if B.dtype.kind not in 'fc':
+            B = B.astype(float)
+        if B.shape != (n,):
+            raise ValueError('B must have one entry per row of A')
+        if lump != 'none' and (B == 0).any():
+            raise ValueError('B must have no zero entry when lumping')
+
+    A = A.copy()
+    A.sort_indices()
+    retained = _retained_pattern(A, theta)
+    if protect is not None:
+        if not issparse(protect) or protect.format != 'csr':
+            raise TypeError('expected csr_array for protect')
+        if protect.shape != A.shape:
+            raise ValueError('protect must have the shape of A')
+        retained |= _inside(A, protect)
+    if symmetric:
+        retained = _symmetrize(A, retained)
+
+    diagonal = A.diagonal().astype(A.dtype, copy=True)
+    indptr = np.zeros(n + 1, dtype=A.indptr.dtype)
+    indices = []
+    data = []
+    for i in range(n):
+        start, end = A.indptr[i], A.indptr[i + 1]
+        columns = A.indices[start:end]
+        values = A.data[start:end]
+        keep = retained[start:end]
+
+        offdiag = columns != i
+        gone = offdiag & ~keep
+        dropped = (values[gone] * B[columns[gone]]).sum()
+        kept_columns = columns[offdiag & keep]
+        kept_values = values[offdiag & keep].astype(A.dtype, copy=True)
+
+        if lump == 'diagonal':
+            diagonal[i] = diagonal[i] + dropped / B[i]
+        elif lump == 'strong':
+            weights = np.abs(kept_values)
+            share = (weights * B[kept_columns]).sum()
+            if share == 0:
+                diagonal[i] = diagonal[i] + dropped / B[i]
+            else:
+                kept_values = kept_values + dropped * weights / share
+
+        row = {column: value
+               for column, value in zip(kept_columns.tolist(),
+                                        kept_values.tolist())
+               if value != 0}
+        row[i] = diagonal[i]
+        for column in sorted(row):
+            indices.append(column)
+            data.append(row[column])
+        indptr[i + 1] = len(indices)
+
+    out = csr_array((np.array(data, dtype=A.dtype),
+                     np.array(indices, dtype=A.indices.dtype), indptr),
+                    shape=A.shape)
+    out.sort_indices()
+    return out
+
+
+def _retained_pattern(A, theta):
+    """Flag the stored entries of A that survive the threshold."""
+    keep = np.zeros(A.data.shape[0], dtype=bool)
+    for i in range(A.shape[0]):
+        start, end = A.indptr[i], A.indptr[i + 1]
+        columns = A.indices[start:end]
+        values = np.abs(A.data[start:end])
+        offdiag = columns != i
+        if not offdiag.any():
+            continue
+        cutoff = theta * values[offdiag].max()
+        keep[start:end] = values >= cutoff
+        keep[start:end][~offdiag] = True
+    return keep
+
+
+def _inside(A, protect):
+    """Flag the stored entries of A that lie in the pattern of protect."""
+    marked = protect.copy()
+    marked.sort_indices()
+    flags = np.zeros(A.data.shape[0], dtype=bool)
+    for i in range(A.shape[0]):
+        start, end = A.indptr[i], A.indptr[i + 1]
+        wanted = marked.indices[marked.indptr[i]:marked.indptr[i + 1]]
+        flags[start:end] = np.isin(A.indices[start:end], wanted)
+    return flags
+
+
+def _symmetrize(A, keep):
+    """Retain an entry whenever its transpose is retained."""
+    marks = csr_array((keep.astype(float), A.indices.copy(), A.indptr.copy()),
+                      shape=A.shape)
+    marks.eliminate_zeros()
+    both = (marks + marks.T.tocsr()).tocsr()
+    both.data[:] = 1.0
+
+    pattern = A.copy()
+    pattern.data = np.ones_like(pattern.data, dtype=float)
+    overlap = pattern.multiply(both).tocsr()
+    overlap.sort_indices()
+
+    flags = np.zeros(A.data.shape[0], dtype=bool)
+    for i in range(A.shape[0]):
+        start, end = A.indptr[i], A.indptr[i + 1]
+        wanted = overlap.indices[overlap.indptr[i]:overlap.indptr[i + 1]]
+        flags[start:end] = np.isin(A.indices[start:end], wanted)
+    return flags
