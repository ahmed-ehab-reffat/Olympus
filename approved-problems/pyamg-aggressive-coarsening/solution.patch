+def interpolation_passes(A, C, splitting, theta=None, norm='min'):
+    """Report the pass in which multipass interpolation reaches each point.
+
+    Parameters
+    ----------
+    A : csr_array
+        NxN matrix in CSR format.
+    C : csr_array
+        Strength-of-Connection matrix.
+    splitting : array
+        C/F splitting stored in an array of length N.
+    theta : float in [0, 1), default None
+        theta value defining strong connections in a classical AMG sense.
+    norm : string, default 'min'
+        Norm used in redefining classical SOC, 'min' or 'abs'.
+
+    Returns
+    -------
+    ndarray
+        Array of length N holding zero for a coarse point, the one-based number
+        of the pass that reached a fine point, and minus one for a fine point
+        that no pass reaches.
+
+    See Also
+    --------
+    multipass_interpolation
+
+    Examples
+    --------
+    >>> import numpy as np
+    >>> from pyamg.gallery import poisson
+    >>> from pyamg.classical.interpolate import interpolation_passes
+    >>> A = poisson((5,), format='csr')
+    >>> splitting = np.array([1, 0, 0, 0, 1], dtype='intc')
+    >>> interpolation_passes(A, A, splitting)
+    array([ 0,  1,  2,  1,  0], dtype=int32)
+
+    """
+    A, C, splitting = _check_multipass_args(A, C, splitting, theta, norm)
+    _, passes, _ = _multipass_rows(A, C, splitting)
+    return passes
+
+
+def multipass_interpolation(A, C, splitting, theta=None, norm='min',
+                            trunc=None, improve=0, strict=False, lump=False,
+                            max_passes=None):
+    """Create prolongator using multipass interpolation.
+
+    Parameters
+    ----------
+    A : csr_array
+        NxN matrix in CSR format.
+    C : csr_array
+        Strength-of-Connection matrix. Must have zero diagonal.
+    splitting : array
+        C/F splitting stored in an array of length N.
+    theta : float in [0, 1), default None
+        theta value defining strong connections in a classical AMG sense.
+        Provide if a different SOC is used for P than for CF-splitting;
+        otherwise, theta = None.
+    norm : string, default 'min'
+        Norm used in redefining classical SOC, 'min' or 'abs'.
+    trunc : float in [0, 1), default None
+        Truncate the finished prolongator with this threshold. No truncation
+        is applied when None.
+    improve : int, default 0
+        Number of weighted-Jacobi sweeps applied to the finished prolongator.
+    strict : bool, default False
+        Raise when a fine point is reached by no pass, instead of leaving its
+        row empty.
+    lump : bool, default False
+        Add the entries of the strong neighbours a row could not use to the
+        diagonal that scales it.
+    max_passes : int, default None
+        Stop after this many passes. Unlimited when not provided.
+
+    Returns
+    -------
+    csr_array
+        Prolongator using multipass interpolation.
+
+    See Also
+    --------
+    direct_interpolation, truncate_interpolation, jacobi_improve_interpolation
+
+    References
+    ----------
+    .. [1] Stuben K. "An introduction to algebraic multigrid"
+       In Multigrid, Trottenberg U, Oosterlee CW, Schuller A (eds).
+       Academic Press: London, 2001; 413-532.
+
+    Examples
+    --------
+    >>> import numpy as np
+    >>> from pyamg.gallery import poisson
+    >>> from pyamg.classical.interpolate import multipass_interpolation
+    >>> A = poisson((5,), format='csr')
+    >>> splitting = np.array([1, 0, 0, 0, 1], dtype='intc')
+    >>> multipass_interpolation(A, A, splitting).toarray()
+    array([[1. , 0. ],
+           [1. , 0. ],
+           [0.5, 0.5],
+           [0. , 1. ],
+           [0. , 1. ]])
+
+    """
+    A, C, splitting = _check_multipass_args(A, C, splitting, theta, norm)
+    if trunc is not None and not 0 <= trunc < 1:
+        raise ValueError('trunc must lie in [0, 1)')
+    if int(improve) != improve or improve < 0:
+        raise ValueError('improve must be a non-negative integer')
+    if max_passes is not None and (int(max_passes) != max_passes or max_passes < 1):
+        raise ValueError('max_passes must be an integer of at least 1')
+    if max_passes is not None:
+        max_passes = int(max_passes)
+    improve = int(improve)
+
+    rows, passes, unused = _multipass_rows(A, C, splitting, max_passes)
+    if strict and (passes < 0).any():
+        stranded = int((passes < 0).sum())
+        raise ValueError(f'{stranded} fine points are reached by no pass')
+    P = _scale_and_assemble(A, splitting, rows, unused if lump else None)
+    if trunc is not None:
+        P = truncate_interpolation(P, trunc)
+    if improve:
+        P = jacobi_improve_interpolation(A, P, splitting, degree=improve)
+    return _match_index_dtype(P, A.indptr.dtype)
+
+
+def truncate_interpolation(P, theta):
+    """Drop the small entries of a prolongator, keeping every row sum.
+
+    Parameters
+    ----------
+    P : csr_array
+        Prolongator.
+    theta : float in [0, 1)
+        An entry is kept when its magnitude is at least theta times the largest
+        magnitude in its row.
+
+    Returns
+    -------
+    csr_array
+        Prolongator whose kept entries are rescaled so that each row sum is the
+        row sum of P. A row whose kept entries sum to zero is left as it was.
+
+    See Also
+    --------
+    multipass_interpolation
+
+    Examples
+    --------
+    >>> import numpy as np
+    >>> from scipy.sparse import csr_array
+    >>> from pyamg.classical.interpolate import truncate_interpolation
+    >>> P = csr_array(np.array([[0.8, 0.2], [0.5, 0.5]]))
+    >>> truncate_interpolation(P, 0.5).toarray()
+    array([[1. , 0. ],
+           [0.5, 0.5]])
+
+    """
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    if not 0 <= theta < 1:
+        raise ValueError('theta must lie in [0, 1)')
+
+    P = P.copy()
+    P.sort_indices()
+    data = P.data
+    for i in range(P.shape[0]):
+        start, end = P.indptr[i], P.indptr[i + 1]
+        row = data[start:end]
+        if row.size == 0:
+            continue
+        total = row.sum()
+        cutoff = theta * np.abs(row).max()
+        keep = np.abs(row) >= cutoff
+        kept = row[keep].sum()
+        if kept == 0:
+            continue
+        row[~keep] = 0.0
+        row[keep] *= total / kept
+    P.eliminate_zeros()
+    return P
+
+
+def jacobi_improve_interpolation(A, P, splitting, omega=4.0 / 3.0, degree=1,
+                                 C=None):
+    """Improve a prolongator with weighted-Jacobi sweeps on its fine rows.
+
+    Parameters
+    ----------
+    A : csr_array
+        NxN matrix in CSR format.
+    P : csr_array
+        Prolongator.
+    splitting : array
+        C/F splitting stored in an array of length N.
+    omega : float, default 4.0/3.0
+        Weight of the Jacobi sweep. Must be positive.
+    degree : int, default 1
+        Number of sweeps.
+    C : csr_array, default None
+        Strength-of-Connection matrix. When provided, the sweep uses the
+        entries of A inside the pattern of C with the entries left outside it
+        added to the diagonal.
+
+    Returns
+    -------
+    csr_array
+        Prolongator whose fine rows have been swept and whose coarse rows still
+        hold a single one.
+
+    See Also
+    --------
+    multipass_interpolation
+
+    Examples
+    --------
+    >>> import numpy as np
+    >>> from pyamg.gallery import poisson
+    >>> from pyamg.classical.interpolate import jacobi_improve_interpolation
+    >>> from pyamg.classical.interpolate import multipass_interpolation
+    >>> A = poisson((5,), format='csr')
+    >>> splitting = np.array([1, 0, 1, 0, 1], dtype='intc')
+    >>> P = multipass_interpolation(A, A, splitting)
+    >>> np.allclose(jacobi_improve_interpolation(A, P, splitting, degree=0).toarray(),
+    ...             P.toarray())
+    True
+
+    """
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(P) or P.format != 'csr':
+        raise TypeError('expected csr_array for P')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix')
+    if omega <= 0:
+        raise ValueError('omega must be positive')
+    if int(degree) != degree or degree < 0:
+        raise ValueError('degree must be a non-negative integer')
+
+    splitting = np.asarray(splitting)
+    if splitting.shape != (A.shape[0],):
+        raise ValueError('splitting must have one entry per row of A')
+    if P.shape != (A.shape[0], int((splitting != 0).sum())):
+        raise ValueError('P must have a row per row of A and a column per '
+                         'coarse point')
+
+    if C is not None:
+        if not issparse(C) or C.format != 'csr':
+            raise TypeError('expected csr_array for C')
+        if C.shape != A.shape:
+            raise ValueError('C must have the shape of A')
+        A = _filter_operator(A, C)
+
+    diagonal = A.diagonal()
+    if degree and (diagonal == 0).any():
+        raise ValueError('A must have a nonzero diagonal')
+    index_dtype = P.indptr.dtype
+
+    n = A.shape[0]
+    coarse = np.flatnonzero(splitting != 0)
+    fine = np.zeros(n, dtype=float)
+    fine[splitting == 0] = 1.0
+    identity = csr_array((np.ones(coarse.size), (coarse, np.arange(coarse.size))),
+                         shape=(n, coarse.size))
+
+    for _ in range(int(degree)):
+        scaled = diags_array(np.where(diagonal == 0, 1.0, 1.0 / diagonal))
+        P = (P - omega * (scaled @ (A @ P))).tocsr()
+        P = (diags_array(fine) @ P).tocsr() + identity
+
+    P = P.tocsr()
+    P.eliminate_zeros()
+    P.sort_indices()
+    return _match_index_dtype(P, index_dtype)
+
+
+def _filter_operator(A, C):
+    """Keep the entries of A inside the pattern of C, lumping the rest."""
+    pattern = C.copy()
+    pattern.setdiag(1.0)
+    pattern.eliminate_zeros()
+    pattern.data[:] = 1.0
+
+    kept = pattern.multiply(A).tocsr()
+    lumped = np.asarray(A.sum(axis=1)).ravel() - np.asarray(kept.sum(axis=1)).ravel()
+    out = (kept + diags_array(lumped)).tocsr()
+    out.sort_indices()
+    return out
+
+
+def _match_index_dtype(P, dtype):
+    """Return P with its index arrays stored in the given integer dtype."""
+    if P.indptr.dtype == dtype and P.indices.dtype == dtype:
+        return P
+    return csr_array((P.data, P.indices.astype(dtype), P.indptr.astype(dtype)),
+                     shape=P.shape)
+
+
+def _check_multipass_args(A, C, splitting, theta, norm):
+    """Validate and prepare the arguments of the multipass routines."""
+    if not issparse(A) or A.format != 'csr':
+        raise TypeError('expected csr_array for A')
+    if not issparse(C) or C.format != 'csr':
+        raise TypeError('expected csr_array for C')
+    if A.shape[0] != A.shape[1]:
+        raise ValueError('expected square matrix')
+    if C.shape != A.shape:
+        raise ValueError('C must have the shape of A')
+
+    splitting = np.asarray(splitting)
+    if splitting.shape != (A.shape[0],):
+        raise ValueError('splitting must have one entry per row of A')
+
+    if theta is not None:
+        C = classical_strength_of_connection(A, theta=theta, norm=norm)
+    else:
+        C = C.copy()
+    C = C.tocsr()
+    C.setdiag(0.0)
+    C.eliminate_zeros()
+    return A, C, splitting
+
+
+def _multipass_rows(A, C, splitting, max_passes=None):
+    """Build the unscaled interpolation rows, one pass at a time."""
+    n = A.shape[0]
+    coarse = splitting != 0
+    column = np.full(n, -1, dtype=np.int64)
+    column[coarse] = np.arange(int(coarse.sum()))
+
+    weights = C.copy()
+    weights.data[:] = 1.0
+    weights = weights.multiply(A).tocsr()
+    weights.sort_indices()
+
+    rows = [None] * n
+    passes = np.full(n, -1, dtype='intc')
+    passes[coarse] = 0
+    unused = np.zeros(n, dtype=weights.dtype)
+
+    current = 1
+    while True:
+        settled = []
+        for i in np.flatnonzero(passes < 0):
+            start, end = weights.indptr[i], weights.indptr[i + 1]
+            entries = {}
+            skipped = 0.0
+            for j, value in zip(weights.indices[start:end], weights.data[start:end]):
+                if value == 0:
+                    continue
+                if coarse[j]:
+                    entries[column[j]] = entries.get(column[j], 0.0) + value
+                elif rows[j] is not None and passes[j] < current:
+                    for col, share in rows[j].items():
+                        entries[col] = entries.get(col, 0.0) + value * share
+                else:
+                    skipped += value
+            if entries:
+                settled.append((i, entries, skipped))
+        if not settled:
+            break
+        for i, entries, skipped in settled:
+            rows[i] = entries
+            passes[i] = current
+            unused[i] = skipped
+        if max_passes is not None and current >= max_passes:
+            break
+        current += 1
+
+    return rows, passes, unused
+
+
+def _scale_and_assemble(A, splitting, rows, unused=None):
+    """Scale each finished row once and assemble the prolongator."""
+    n = A.shape[0]
+    coarse = splitting != 0
+    ncoarse = int(coarse.sum())
+    column = np.full(n, -1, dtype=np.int64)
+    column[coarse] = np.arange(ncoarse)
+
+    offdiag = np.asarray(A.sum(axis=1)).ravel() - A.diagonal()
+    diagonal = A.diagonal()
+
+    indptr = np.zeros(n + 1, dtype=A.indptr.dtype)
+    indices = []
+    data = []
+    for i in range(n):
+        if coarse[i]:
+            indices.append(column[i])
+            data.append(1.0)
+        elif rows[i]:
+            entries = rows[i]
+            total = sum(entries.values())
+            pivot = diagonal[i]
+            if unused is not None:
+                pivot = pivot + unused[i]
+            factor = 1.0
+            if total != 0 and pivot != 0:
+                factor = -offdiag[i] / (pivot * total)
+            for col in sorted(entries):
+                value = entries[col] * factor
+                if value != 0:
+                    indices.append(col)
+                    data.append(value)
+        indptr[i + 1] = len(indices)
+
+    P = csr_array((np.array(data, dtype=A.dtype),
+                   np.array(indices, dtype=A.indices.dtype), indptr),
+                  shape=(n, ncoarse))
+    P.eliminate_zeros()
+    P.sort_indices()
+    return P
