+def test_every_galerkin_operator_is_sparsified_once():
+    A = grid(24)
+    ml = pyamg.ruge_stuben_solver(A, sparsify=('lump', {'theta': 0.6}),
+                                  max_coarse=10)
+    assert len(ml.levels) >= 3
+    assert ml.levels[0].A.nnz == A.nnz
+    dropped = 0
+    for fine, coarse in zip(ml.levels[:-1], ml.levels[1:]):
+        galerkin = (fine.R @ fine.A @ fine.P).tocsr()
+        dropped += galerkin.nnz - coarse.A.nnz
+        assert_allclose(dense(coarse.A), dense(sparsify(galerkin, theta=0.6)))
+    assert dropped > 0
