+    def count_over_bools(self, formula, bools, bvs):
+        res = 0
+        ranges = [(False, True)] * len(bools) + \
+                 [range(1 << s.bv_width()) for s in bvs]
+        for values in itertools.product(*ranges):
+            assignment = {}
+            for symbol, value in zip(bools, values[:len(bools)]):
+                assignment[symbol] = Bool(value)
+            for symbol, value in zip(bvs, values[len(bools):]):
+                assignment[symbol] = BV(value, symbol.bv_width())
+            if evaluate(formula, assignment).is_true():
+                res += 1
+        return res
