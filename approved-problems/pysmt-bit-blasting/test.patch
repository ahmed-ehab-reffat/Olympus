+    def test_model_holds_the_source_symbols_and_nothing_else(self):
+        x, y = bv_symbol("x", 2), bv_symbol("y", 2)
+        q = Symbol("q")
+        blaster = BitBlaster()
+        clauses = blaster.cnf(Equals(BVAdd(x, y), BV(2, 2)))
+        bits = set(blaster.bit_symbols(x)) | set(blaster.bit_symbols(y))
+        helpers = clause_symbols(clauses) - bits
+        assignment = {symbol: Bool(True) for symbol in helpers}
+        assignment.update(bit_assignment(blaster, x, 1))
+        assignment.update(bit_assignment(blaster, y, 1))
+        assignment[q] = Bool(True)
+        model = blaster.model(assignment)
+        self.assertEqual({symbol for symbol, _ in model}, set([x, y, q]))
+        self.assertEqual(model.get_value(x), BV(1, 2))
+        self.assertEqual(model.get_value(q), Bool(True))
+        for helper in helpers:
+            self.assertNotIn(helper, model)
