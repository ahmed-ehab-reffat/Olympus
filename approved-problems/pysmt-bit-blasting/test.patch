+    def check_equisatisfiable(self, formula):
+        blaster = BitBlaster()
+        converted = blaster.convert(formula)
+        clauses = blaster.cnf(formula)
+        source = sorted(converted.get_free_variables(), key=str)
+        extra = sorted(clause_symbols(clauses) - set(source), key=str)
+        for values in itertools.product((False, True), repeat=len(source)):
+            base = dict(zip(source, values))
+            truth = evaluate(converted,
+                             {s: Bool(v) for s, v in base.items()}).is_true()
+            found = satisfiable(residual_clauses(clauses, base))
+            self.assertEqual(found, truth,
+                             "%s disagree on %s" % (formula, base))
+        return clauses
