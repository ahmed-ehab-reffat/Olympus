+
+
+def bv_symbol(name, width):
+    return Symbol(name, BVType(width))
+
+
+def free_bv_symbols(formula):
+    return sorted((s for s in formula.get_free_variables()
+                   if s.symbol_type().is_bv_type()), key=str)
+
+
+def free_array_symbols(formula):
+    return sorted((s for s in formula.get_free_variables()
+                   if s.symbol_type().is_array_type()), key=str)
+
+
+def free_bool_symbols(formula):
+    return sorted((s for s in formula.get_free_variables()
+                   if s.symbol_type().is_bool_type()), key=str)
+
+
+def bit_assignment(blaster, symbol, value):
+    res = {}
+    for index, bit in enumerate(blaster.bit_symbols(symbol)):
+        res[bit] = Bool(bool((value >> index) & 1))
+    return res
+
+
+def cell_assignment(blaster, symbol, values):
+    res = {}
+    for cell, value in zip(blaster.bit_symbols(symbol), values):
+        for index, bit in enumerate(cell):
+            res[bit] = Bool(bool((value >> index) & 1))
+    return res
+
+
+def value_space(value_type):
+    if value_type.is_bv_type():
+        return list(range(1 << value_type.width))
+    cells = 1 << value_type.index_type.width
+    return list(itertools.product(value_space(value_type.elem_type),
+                                  repeat=cells))
+
+
+def zero_constant(value_type):
+    if value_type.is_bv_type():
+        return BV(0, value_type.width)
+    return Array(value_type.index_type, zero_constant(value_type.elem_type))
+
+
+def constant_of(value_type, value):
+    if value_type.is_bv_type():
+        return BV(value, value_type.width)
+    default = zero_constant(value_type.elem_type)
+    assigned = {}
+    for index, cell in enumerate(value):
+        constant = constant_of(value_type.elem_type, cell)
+        if constant != default:
+            assigned[BV(index, value_type.index_type.width)] = constant
+    return Array(value_type.index_type, default, assigned)
+
+
+def value_assignment(bits, value_type, value):
+    res = {}
+    if value_type.is_bv_type():
+        for index, bit in enumerate(bits):
+            res[bit] = Bool(bool((value >> index) & 1))
+        return res
+    for cell, cell_value in zip(bits, value):
+        res.update(value_assignment(cell, value_type.elem_type, cell_value))
+    return res
+
+
+def cells_of(term, value_type):
+    if value_type.is_bv_type():
+        return [term]
+    res = []
+    for index in range(1 << value_type.index_type.width):
+        selected = Select(term, BV(index, value_type.index_type.width))
+        res.extend(cells_of(selected, value_type.elem_type))
+    return res
+
+
+def cellwise(first, second):
+    value_type = first.get_type()
+    return And(Equals(left, right)
+               for left, right in zip(cells_of(first, value_type),
+                                      cells_of(second, value_type)))
+
+
+def model_count(formula, symbols):
+    res = 0
+    for values in itertools.product((False, True), repeat=len(symbols)):
+        assignment = dict(zip(symbols, (Bool(v) for v in values)))
+        if evaluate(formula, assignment).is_true():
+            res += 1
+    return res
+
+
+def bv_model_count(formula, symbols):
+    res = 0
+    ranges = [range(1 << s.bv_width()) for s in symbols]
+    for values in itertools.product(*ranges):
+        assignment = {s: BV(v, s.bv_width())
+                      for s, v in zip(symbols, values)}
+        if evaluate(formula, assignment).is_true():
+            res += 1
+    return res
+
+
+def literal_symbol(literal):
+    return literal.arg(0) if literal.is_not() else literal
+
+
+def clause_symbols(clauses):
+    return {literal_symbol(l) for clause in clauses for l in clause}
+
+
+def residual_clauses(clauses, assignment):
+    res = []
+    for clause in clauses:
+        rest = []
+        satisfied = False
+        for literal in clause:
+            symbol = literal_symbol(literal)
+            positive = not literal.is_not()
+            if symbol in assignment:
+                if assignment[symbol] == positive:
+                    satisfied = True
+                    break
+            else:
+                rest.append((symbol, positive))
+        if not satisfied:
+            res.append(rest)
+    return res
+
+
+def assume(clauses, symbol, value):
+    res = []
+    for clause in clauses:
+        if any(s == symbol and p == value for s, p in clause):
+            continue
+        rest = [(s, p) for s, p in clause if s != symbol]
+        if not rest:
+            return None
+        res.append(rest)
+    return res
+
+
+def solve(clauses, assignment=None):
+    assignment = {} if assignment is None else dict(assignment)
+    if any(not clause for clause in clauses):
+        return None
+    while True:
+        unit = next((c[0] for c in clauses if len(c) == 1), None)
+        if unit is None:
+            break
+        assignment[unit[0]] = unit[1]
+        clauses = assume(clauses, unit[0], unit[1])
+        if clauses is None:
+            return None
+        if not clauses:
+            return assignment
+    if not clauses:
+        return assignment
+    symbol = clauses[0][0][0]
+    for value in (True, False):
+        rest = assume(clauses, symbol, value)
+        if rest is None:
+            continue
+        branch = dict(assignment)
+        branch[symbol] = value
+        found = solve(rest, branch)
+        if found is not None:
+            return found
+    return None
+
+
+def satisfiable(clauses):
+    if any(not clause for clause in clauses):
+        return False
+    while True:
+        unit = next((c[0] for c in clauses if len(c) == 1), None)
+        if unit is None:
+            break
+        clauses = assume(clauses, unit[0], unit[1])
+        if clauses is None:
+            return False
+        if not clauses:
+            return True
+    if not clauses:
+        return True
+    symbol = clauses[0][0][0]
+    for value in (True, False):
+        rest = assume(clauses, symbol, value)
+        if rest is not None and satisfiable(rest):
+            return True
+    return False
+
+
+def evaluate(formula, assignment):
+    return formula.substitute(assignment).simplify()
+
+
+class TestBitBlasting(TestCase):
+
+    def check_equivalent(self, formula, blaster=None, reference=None):
+        blaster = blaster if blaster is not None else BitBlaster()
+        reference = formula if reference is None else reference
+        blasted = blaster.convert(formula)
+        self.check_boolean_only(blasted)
+        bvs = free_bv_symbols(formula)
+        arrays = free_array_symbols(formula)
+        bools = free_bool_symbols(formula)
+        bv_ranges = [range(1 << s.bv_width()) for s in bvs]
+        array_ranges = [value_space(s.symbol_type()) for s in arrays]
+        bool_ranges = [(False, True)] * len(bools)
+        for values in itertools.product(*(bv_ranges + array_ranges +
+                                          bool_ranges)):
+            bv_values = values[:len(bvs)]
+            array_values = values[len(bvs):len(bvs) + len(arrays)]
+            bool_values = values[len(bvs) + len(arrays):]
+            original = {}
+            blasted_assignment = {}
+            for symbol, value in zip(bvs, bv_values):
+                original[symbol] = BV(value, symbol.bv_width())
+                blasted_assignment.update(bit_assignment(blaster, symbol,
+                                                         value))
+            for symbol, value in zip(arrays, array_values):
+                original[symbol] = constant_of(symbol.symbol_type(), value)
+                blasted_assignment.update(value_assignment(
+                    blaster.bit_symbols(symbol), symbol.symbol_type(), value))
+            for symbol, value in zip(bools, bool_values):
+                original[symbol] = Bool(value)
+                blasted_assignment[symbol] = Bool(value)
+            expected = evaluate(reference, original)
+            self.assertTrue(expected.is_constant(),
+                            "%s did not evaluate to a constant" % formula)
+            actual = evaluate(blasted, blasted_assignment)
+            self.assertTrue(actual.is_constant(),
+                            "the converted formula kept free symbols")
+            self.assertEqual(actual, expected,
+                             "%s disagree on %s" % (formula, original))
+        return blasted
+
+    def check_boolean_only(self, blasted):
+        self.assertTrue(self.env.stc.get_type(blasted).is_bool_type())
+        stack = [blasted]
+        seen = set()
+        while stack:
+            current = stack.pop()
+            if current in seen:
+                continue
+            seen.add(current)
+            self.assertFalse(current.is_bv_op(),
+                             "%s is still a bit-vector operation" % current)
+            self.assertFalse(current.is_bv_constant())
+            if current.is_symbol():
+                self.assertTrue(current.symbol_type().is_bool_type())
+            stack.extend(current.args())
+
