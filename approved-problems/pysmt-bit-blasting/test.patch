+        x = mgr.Symbol("x", BVType(2))
+        formula = mgr.Equals(x, mgr.BV(1, 2))
+        blaster = BitBlaster(environment=env)
+        blasted = blaster.convert(formula)
+        self.assertTrue(env.stc.get_type(blasted).is_bool_type())
+        owned = set(mgr.get_all_symbols())
+        elsewhere = set(get_env().formula_manager.get_all_symbols())
+        self.assertTrue(blasted.get_free_variables() <= owned)
+        for bit in blaster.bit_symbols(x):
+            self.assertIn(bit, owned)
+            self.assertNotIn(bit, elsewhere)
