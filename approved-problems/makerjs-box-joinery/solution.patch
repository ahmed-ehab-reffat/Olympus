new file mode 100644
index 00000000..da8c7f3b
--- /dev/null
+++ b/packages/maker.js/src/core/joinery.ts
@@ -0,0 +1,355 @@
+namespace MakerJs.joinery {
+
+    /**
+     * One span along a jointed edge. A tab span is material, a slot span is removed.
+     */
+    export interface IFinger {
+
+        /**
+         * Distance from the start of the edge to the beginning of this span.
+         */
+        start: number;
+
+        /**
+         * Distance from the start of the edge to the end of this span.
+         */
+        end: number;
+
+        /**
+         * True when this span is a tab, false when it is a slot.
+         */
+        tab: boolean;
+    }
+
+    /**
+     * Options for generating the fingers of one edge.
+     */
+    export interface IFingerOptions {
+
+        /**
+         * Nominal width of one finger.
+         */
+        fingerWidth: number;
+
+        /**
+         * Thickness of the sheet material.
+         */
+        thickness: number;
+
+        /**
+         * Optional width of the cutting beam, default zero.
+         */
+        kerf?: number;
+
+        /**
+         * Optional flag to make the first finger a tab, default true.
+         */
+        startWithTab?: boolean;
+    }
+
+    /**
+     * Tally of the joints within a model.
+     */
+    export interface IJointReport {
+
+        /**
+         * Number of jointed faces found.
+         */
+        faces: number;
+
+        /**
+         * Total number of tabs across all faces.
+         */
+        tabs: number;
+
+        /**
+         * Total number of slots across all faces.
+         */
+        slots: number;
+
+        /**
+         * Total length of every path in the model.
+         */
+        cutLength: number;
+    }
+
+    /**
+     * A model whose edges carry finger joints.
+     */
+    export interface IJointedModel extends IModel {
+
+        /**
+         * Fingers by edge name.
+         */
+        joints: { [edgeId: string]: IFinger[] };
+    }
+
+    /**
+     * @private
+     */
+    function positive(value: number, name: string) {
+        if (!(value > 0)) {
+            throw 'joinery: ' + name + ' must be greater than zero';
+        }
+    }
+
+    /**
+     * @private
+     */
+    function allowedKerf(kerf: number) {
+        if (kerf < 0) {
+            throw 'joinery: kerf cannot be negative';
+        }
+    }
+
+    /**
+     * Find the number of fingers which divide an edge. The count is always odd so that both ends of
+     * the edge are the same kind of span.
+     *
+     * @param length Length of the edge.
+     * @param fingerWidth Nominal width of one finger.
+     * @returns Odd number of fingers, never less than three.
+     */
+    export function fingerCount(length: number, fingerWidth: number): number {
+        positive(length, 'length');
+        positive(fingerWidth, 'fingerWidth');
+
+        var odd = 2 * Math.round((length / fingerWidth - 1) / 2) + 1;
+
+        return Math.max(odd, 3);
+    }
+
+    /**
+     * Divide an edge into alternating tabs and slots, compensated for the width of the cutting beam.
+     *
+     * @param length Length of the edge.
+     * @param options IFingerOptions object.
+     * @returns Array of IFinger in increasing order, spanning the whole edge.
+     */
+    export function fingers(length: number, options: IFingerOptions): IFinger[] {
+        positive(length, 'length');
+        positive(options.thickness, 'thickness');
+
+        var kerf = options.kerf || 0;
+        allowedKerf(kerf);
+
+        var startWithTab = options.startWithTab !== false;
+        var count = fingerCount(length, options.fingerWidth);
+
+        if (kerf >= length / count) {
+            throw 'joinery: kerf must be smaller than the width of one finger';
+        }
+
+        var result: IFinger[] = [];
+
+        for (var i = 0; i < count; i++) {
+            var tab = startWithTab === (i % 2 === 0);
+            var start = i * length / count;
+            var end = (i + 1) * length / count;
+
+            if (i > 0) {
+                start += tab ? -kerf / 2 : kerf / 2;
+            }
+
+            if (i < count - 1) {
+                end += tab ? kerf / 2 : -kerf / 2;
+            }
+
+            result.push({ start: start, end: end, tab: tab });
+        }
+
+        return result;
+    }
+
+    /**
+     * Find the partition which interlocks with the given one.
+     *
+     * @param fingersToMate Array of IFinger from the opposing edge.
+     * @param kerf Optional width of the cutting beam used to make the opposing edge, default zero.
+     * @returns Array of IFinger with the opposite polarity.
+     */
+    export function complement(fingersToMate: IFinger[], kerf = 0): IFinger[] {
+        if (!fingersToMate || fingersToMate.length === 0) {
+            throw 'joinery: fingers must not be empty';
+        }
+
+        allowedKerf(kerf);
+
+        var last = fingersToMate.length - 1;
+        var result: IFinger[] = [];
+
+        for (var i = 0; i <= last; i++) {
+            var tab = !fingersToMate[i].tab;
+            var start = fingersToMate[i].start;
+            var end = fingersToMate[i].end;
+
+            if (i > 0) {
+                start += tab ? -kerf : kerf;
+            }
+
+            if (i < last) {
+                end += tab ? kerf : -kerf;
+            }
+
+            result.push({ start: start, end: end, tab: tab });
+        }
+
+        return result;
+    }
+
+    /**
+     * Trace the outline of a jointed edge in local space, where the edge runs along the x axis and
+     * material lies toward positive y.
+     *
+     * @param fingersToTrace Array of IFinger describing the edge.
+     * @param thickness Thickness of the sheet material.
+     * @returns Array of IPoint from the start of the edge to its end.
+     */
+    export function profile(fingersToTrace: IFinger[], thickness: number): IPoint[] {
+        if (!fingersToTrace || fingersToTrace.length === 0) {
+            throw 'joinery: fingers must not be empty';
+        }
+        positive(thickness, 'thickness');
+
+        var depth = function (finger: IFinger) {
+            return finger.tab ? 0 : thickness;
+        };
+
+        var last = fingersToTrace.length - 1;
+        var points: IPoint[] = [[fingersToTrace[0].start, depth(fingersToTrace[0])]];
+
+        for (var i = 1; i <= last; i++) {
+            points.push([fingersToTrace[i].start, depth(fingersToTrace[i - 1])]);
+            points.push([fingersToTrace[i].start, depth(fingersToTrace[i])]);
+        }
+
+        points.push([fingersToTrace[last].end, depth(fingersToTrace[last])]);
+
+        return points;
+    }
+
+    /**
+     * Create the pockets which receive the tabs of a partition. The pockets run along the y axis and
+     * are centred on x, so a model of them can be dropped onto the face which receives the panel.
+     *
+     * @param fingersToReceive Array of IFinger from the panel which enters the face.
+     * @param thickness Thickness of the sheet material.
+     * @param kerf Optional width of the cutting beam, default zero.
+     * @returns Model containing one closed rectangle per tab.
+     */
+    export function mortises(fingersToReceive: IFinger[], thickness: number, kerf = 0): IModel {
+        if (!fingersToReceive || fingersToReceive.length === 0) {
+            throw 'joinery: fingers must not be empty';
+        }
+        positive(thickness, 'thickness');
+        allowedKerf(kerf);
+
+        if (kerf >= thickness) {
+            throw 'joinery: kerf must be smaller than the thickness';
+        }
+
+        var pockets = complement(fingersToReceive, kerf);
+        var half = (thickness - kerf) / 2;
+        var result: IModel = { models: {} };
+        var index = 0;
+
+        for (var i = 0; i < pockets.length; i++) {
+            if (pockets[i].tab) continue;
+
+            index++;
+
+            result.models['Mortise' + index] = new models.ConnectTheDots(true, [
+                [-half, pockets[i].start],
+                [half, pockets[i].start],
+                [half, pockets[i].end],
+                [-half, pockets[i].end]
+            ]);
+        }
+
+        return result;
+    }
+
+    /**
+     * @private
+     */
+    function nominal(fingersToRead: IFinger[], kerf: number) {
+        var boundaries = [fingersToRead[0].start];
+
+        for (var i = 1; i < fingersToRead.length; i++) {
+            boundaries.push(fingersToRead[i].start + (fingersToRead[i].tab ? kerf / 2 : -kerf / 2));
+        }
+
+        boundaries.push(fingersToRead[fingersToRead.length - 1].end);
+
+        return boundaries;
+    }
+
+    /**
+     * Determine whether two partitions of the same edge interlock once both have been cut.
+     *
+     * @param a Array of IFinger from one face.
+     * @param b Array of IFinger from the opposing face.
+     * @param kerf Optional width of the cutting beam used for both faces, default zero.
+     * @returns True when both describe the same division of the edge with opposite polarity.
+     */
+    export function mates(a: IFinger[], b: IFinger[], kerf = 0): boolean {
+        if (!a || !b || a.length === 0 || b.length === 0) {
+            throw 'joinery: fingers must not be empty';
+        }
+
+        allowedKerf(kerf);
+
+        if (a.length !== b.length) return false;
+
+        var boundariesA = nominal(a, kerf);
+        var boundariesB = nominal(b, kerf);
+
+        for (var i = 0; i < a.length; i++) {
+            if (a[i].tab === b[i].tab) return false;
+        }
+
+        for (var j = 0; j < boundariesA.length; j++) {
+            if (round(boundariesA[j] - boundariesB[j]) !== 0) return false;
+        }
+
+        return true;
+    }
+
+    /**
+     * Tally the joints of a model and all of its children.
+     *
+     * @param modelToReport Model to inspect.
+     * @returns IJointReport object.
+     */
+    export function report(modelToReport: IModel): IJointReport {
+        var result: IJointReport = { faces: 0, tabs: 0, slots: 0, cutLength: 0 };
+
+        var visit = function (m: IModel) {
+            var joints = (<IJointedModel>m).joints;
+
+            if (joints) {
+                result.faces++;
+
+                for (var edgeId in joints) {
+                    for (var i = 0; i < joints[edgeId].length; i++) {
+                        if (joints[edgeId][i].tab) {
+                            result.tabs++;
+                        } else {
+                            result.slots++;
+                        }
+                    }
+                }
+            }
+
+            for (var childId in m.models) {
+                visit(m.models[childId]);
+            }
+        };
+
+        visit(modelToReport);
+
+        result.cutLength = measure.modelPathLength(modelToReport);
+
+        return result;
+    }
+}
diff --git a/packages/maker.js/src/models/FingerBox.ts b/packages/maker.js/src/models/FingerBox.ts
new file mode 100644
index 00000000..a85d6272
--- /dev/null
+++ b/packages/maker.js/src/models/FingerBox.ts
@@ -0,0 +1,193 @@
+namespace MakerJs.models {
+
+    /**
+     * One shared edge between two faces of a box.
+     */
+    export interface ISeam {
+
+        /**
+         * Face id and edge id of the face which begins with a tab.
+         */
+        tabbed: string[];
+
+        /**
+         * Face id and edge id of the face which begins with a slot.
+         */
+        slotted: string[];
+    }
+
+    /**
+     * Options for a box of finger jointed faces.
+     */
+    export interface IFingerBoxOptions extends joinery.IFingerOptions {
+
+        /**
+         * Optional flag to omit the top face and the joints which would meet it, default false.
+         */
+        open?: boolean;
+
+        /**
+         * Optional distances from the left face at which to stand an internal panel.
+         */
+        dividers?: number[];
+    }
+
+    /**
+     * @private
+     */
+    var dividerHosts = [['bottom', 'bottom'], ['top', 'top'], ['front', 'right'], ['back', 'left']];
+
+    /**
+     * @private
+     */
+    var seamPlan: ISeam[] = [
+        { tabbed: ['front', 'bottom'], slotted: ['bottom', 'bottom'] },
+        { tabbed: ['back', 'bottom'], slotted: ['bottom', 'top'] },
+        { tabbed: ['left', 'bottom'], slotted: ['bottom', 'left'] },
+        { tabbed: ['right', 'bottom'], slotted: ['bottom', 'right'] },
+        { tabbed: ['front', 'left'], slotted: ['left', 'right'] },
+        { tabbed: ['front', 'right'], slotted: ['right', 'right'] },
+        { tabbed: ['back', 'left'], slotted: ['right', 'left'] },
+        { tabbed: ['back', 'right'], slotted: ['left', 'left'] },
+        { tabbed: ['front', 'top'], slotted: ['top', 'bottom'] },
+        { tabbed: ['back', 'top'], slotted: ['top', 'top'] },
+        { tabbed: ['left', 'top'], slotted: ['top', 'left'] },
+        { tabbed: ['right', 'top'], slotted: ['top', 'right'] }
+    ];
+
+    /**
+     * @private
+     */
+    function faceEdges(faceId: string, open: boolean) {
+        var edges: { [edgeId: string]: boolean } = {};
+
+        for (var i = 0; i < seamPlan.length; i++) {
+            if (open && seamPlan[i].slotted[0] === 'top') continue;
+
+            if (seamPlan[i].tabbed[0] === faceId) {
+                edges[seamPlan[i].tabbed[1]] = true;
+            }
+
+            if (seamPlan[i].slotted[0] === faceId) {
+                edges[seamPlan[i].slotted[1]] = false;
+            }
+        }
+
+        return edges;
+    }
+
+    export class FingerBox implements IModel {
+
+        public models: IModelMap = {};
+
+        /**
+         * Every shared edge of this box, as face id and edge id pairs.
+         */
+        public seams: ISeam[] = [];
+
+        /**
+         * Create the flat faces of a box which assemble with finger joints.
+         *
+         * Example:
+         * ```
+         * var makerjs = require('makerjs');
+         * var box = new makerjs.models.FingerBox(120, 80, 60, { fingerWidth: 12, thickness: 3, kerf: 0.2 });
+         * ```
+         *
+         * @param width Outer width of the box, along the x axis.
+         * @param depth Outer depth of the box, along the y axis.
+         * @param height Outer height of the box, along the z axis.
+         * @param options IFingerBoxOptions object.
+         */
+        constructor(width: number, depth: number, height: number, options: IFingerBoxOptions) {
+
+            if (!(width > 0) || !(depth > 0) || !(height > 0)) {
+                throw 'joinery: width, depth and height must be greater than zero';
+            }
+
+            var open = !!options.open;
+            var sizes: { [faceId: string]: number[] } = {
+                front: [width, height],
+                back: [width, height],
+                left: [depth, height],
+                right: [depth, height],
+                bottom: [width, depth],
+                top: [width, depth]
+            };
+
+            for (var faceId in sizes) {
+                if (open && faceId === 'top') continue;
+
+                this.models[faceId] = new JointedRectangle(sizes[faceId][0], sizes[faceId][1], {
+                    fingerWidth: options.fingerWidth,
+                    thickness: options.thickness,
+                    kerf: options.kerf,
+                    edges: faceEdges(faceId, open)
+                });
+            }
+
+            for (var i = 0; i < seamPlan.length; i++) {
+                if (open && seamPlan[i].slotted[0] === 'top') continue;
+
+                this.seams.push(seamPlan[i]);
+            }
+
+            var dividers = options.dividers || [];
+
+            for (var d = 0; d < dividers.length; d++) {
+                var position = dividers[d];
+
+                if (!(position > 0) || !(position < width)) {
+                    throw 'joinery: a divider must stand between zero and the width of the box';
+                }
+
+                var panelId = 'divider' + (d + 1);
+                var panelEdges: { [edgeId: string]: boolean } = { bottom: false, right: false, left: false };
+
+                if (!open) {
+                    panelEdges['top'] = false;
+                }
+
+                var panel = new JointedRectangle(depth, height, {
+                    fingerWidth: options.fingerWidth,
+                    thickness: options.thickness,
+                    kerf: options.kerf,
+                    edges: panelEdges
+                });
+
+                this.models[panelId] = panel;
+
+                for (var h = 0; h < dividerHosts.length; h++) {
+                    var faceId = dividerHosts[h][0];
+                    var edgeId = dividerHosts[h][1];
+
+                    if (open && faceId === 'top') continue;
+
+                    var pockets = joinery.mortises(panel.joints[edgeId], options.thickness, options.kerf);
+                    pockets.origin = [position, 0];
+
+                    var face = this.models[faceId];
+
+                    if (!face.models) {
+                        face.models = {};
+                    }
+
+                    face.models[panelId] = pockets;
+                }
+            }
+        }
+    }
+
+    (<IKit>FingerBox).metaParameters = [
+        { title: "width", type: "range", min: 20, max: 300, value: 120 },
+        { title: "depth", type: "range", min: 20, max: 300, value: 80 },
+        { title: "height", type: "range", min: 20, max: 300, value: 60 },
+        {
+            title: "options", type: "select", value: [
+                { fingerWidth: 12, thickness: 3 },
+                { fingerWidth: 12, thickness: 3, kerf: 0.2 },
+                { fingerWidth: 12, thickness: 3, kerf: 0.2, open: true }
+            ]
+        }
+    ];
+}
diff --git a/packages/maker.js/src/models/JointedRectangle.ts b/packages/maker.js/src/models/JointedRectangle.ts
new file mode 100644
index 00000000..fe4e7711
--- /dev/null
+++ b/packages/maker.js/src/models/JointedRectangle.ts
@@ -0,0 +1,158 @@
+namespace MakerJs.models {
+
+    /**
+     * Options for a rectangle whose edges carry finger joints.
+     */
+    export interface IJointedRectangleOptions extends joinery.IFingerOptions {
+
+        /**
+         * Optional map of edge id to the polarity of that edge. An edge which is absent is left straight.
+         */
+        edges?: { [edgeId: string]: boolean };
+    }
+
+    /**
+     * @private
+     */
+    var edgeOrder = ['bottom', 'right', 'top', 'left'];
+
+    /**
+     * @private
+     */
+    function edgeFrame(edgeId: string, width: number, height: number) {
+        switch (edgeId) {
+            case 'bottom':
+                return { corner: [0, 0], along: [1, 0], into: [0, 1], length: width };
+
+            case 'right':
+                return { corner: [width, 0], along: [0, 1], into: [-1, 0], length: height };
+
+            case 'top':
+                return { corner: [width, height], along: [-1, 0], into: [0, -1], length: width };
+
+            default:
+                return { corner: [0, height], along: [0, -1], into: [1, 0], length: height };
+        }
+    }
+
+    export class JointedRectangle implements joinery.IJointedModel {
+
+        public paths: IPathMap = {};
+        public joints: { [edgeId: string]: joinery.IFinger[] } = {};
+
+        /**
+         * Create a rectangle whose edges are cut into interlocking fingers.
+         *
+         * Example:
+         * ```
+         * var makerjs = require('makerjs');
+         * var face = new makerjs.models.JointedRectangle(80, 50, {
+         *   fingerWidth: 10, thickness: 3, edges: { bottom: true, left: false }
+         * });
+         * ```
+         *
+         * @param width Width of the rectangle.
+         * @param height Height of the rectangle.
+         * @param options IJointedRectangleOptions object.
+         */
+        constructor(width: number, height: number, options: IJointedRectangleOptions) {
+
+            if (!(width > 0) || !(height > 0)) {
+                throw 'joinery: width and height must be greater than zero';
+            }
+
+            if (!(options.fingerWidth > 0) || !(options.thickness > 0)) {
+                throw 'joinery: fingerWidth and thickness must be greater than zero';
+            }
+
+            if (options.kerf < 0) {
+                throw 'joinery: kerf cannot be negative';
+            }
+
+            var edges = options.edges || {};
+            var frames: any[] = [];
+            var runs: IPoint[][] = [];
+            var sunkAtStart: boolean[] = [];
+            var sunkAtEnd: boolean[] = [];
+
+            for (var i = 0; i < edgeOrder.length; i++) {
+                var edgeId = edgeOrder[i];
+                var frame = edgeFrame(edgeId, width, height);
+                var next = edgeFrame(edgeOrder[(i + 1) % edgeOrder.length], width, height);
+
+                frames.push(frame);
+
+                if (!(edgeId in edges)) {
+                    runs.push([[frame.corner[0], frame.corner[1]], [next.corner[0], next.corner[1]]]);
+                    sunkAtStart.push(false);
+                    sunkAtEnd.push(false);
+                    continue;
+                }
+
+                var fingers = joinery.fingers(frame.length, {
+                    fingerWidth: options.fingerWidth,
+                    thickness: options.thickness,
+                    kerf: options.kerf,
+                    startWithTab: edges[edgeId]
+                });
+
+                this.joints[edgeId] = fingers;
+
+                var local = joinery.profile(fingers, options.thickness);
+                var run: IPoint[] = [];
+
+                for (var j = 0; j < local.length; j++) {
+                    run.push([
+                        frame.corner[0] + frame.along[0] * local[j][0] + frame.into[0] * local[j][1],
+                        frame.corner[1] + frame.along[1] * local[j][0] + frame.into[1] * local[j][1]
+                    ]);
+                }
+
+                runs.push(run);
+                sunkAtStart.push(!fingers[0].tab);
+                sunkAtEnd.push(!fingers[fingers.length - 1].tab);
+            }
+
+            var points: IPoint[] = [];
+
+            for (var k = 0; k < runs.length; k++) {
+                var before = (k + runs.length - 1) % runs.length;
+                var after = (k + 1) % runs.length;
+                var run = runs[k];
+                var notched = sunkAtEnd[before] && sunkAtStart[k];
+
+                if (notched) {
+                    points.push([
+                        frames[k].corner[0] + (frames[before].into[0] + frames[k].into[0]) * options.thickness,
+                        frames[k].corner[1] + (frames[before].into[1] + frames[k].into[1]) * options.thickness
+                    ]);
+                }
+
+                var first = (notched || sunkAtEnd[before]) ? 1 : 0;
+                var last = (sunkAtEnd[k] && !sunkAtStart[after]) ? run.length - 1 : run.length - 2;
+
+                for (var n = first; n <= last; n++) {
+                    points.push(run[n]);
+                }
+            }
+
+            var index = 0;
+
+            for (var p = 0; p < points.length; p++) {
+                index++;
+                this.paths['Edge' + index] = new paths.Line(points[p], points[(p + 1) % points.length]);
+            }
+        }
+    }
+
+    (<IKit>JointedRectangle).metaParameters = [
+        { title: "width", type: "range", min: 10, max: 200, value: 80 },
+        { title: "height", type: "range", min: 10, max: 200, value: 50 },
+        {
+            title: "options", type: "select", value: [
+                { fingerWidth: 10, thickness: 3, edges: { bottom: true, right: false, top: true, left: false } },
+                { fingerWidth: 8, thickness: 3, kerf: 0.2, edges: { bottom: true } }
+            ]
+        }
+    ];
+}
