+describe('Joinery complement', function () {
+
+  it('should flip the polarity of every finger', function () {
+    var f = fingers(100, 20, 3);
+    var c = makerjs.joinery.complement(f);
+    for (var i = 0; i < f.length; i++) {
+      assert.notEqual(c[i].tab, f[i].tab, 'finger ' + i);
+    }
+  });
+
+  it('should keep the same number of fingers', function () {
+    assert.equal(makerjs.joinery.complement(fingers(100, 20, 3)).length, 5);
+  });
+
+  it('should keep the outer boundaries', function () {
+    var c = makerjs.joinery.complement(fingers(100, 20, 3, 1), 1);
+    near(c[0].start, 0, 'first start');
+    near(c[c.length - 1].end, 100, 'last end');
+  });
+
+  it('should equal the partition built with the opposite polarity', function () {
+    assert.deepEqual(
+      spans(makerjs.joinery.complement(fingers(100, 20, 3, 1), 1)),
+      spans(fingers(100, 20, 3, 1, false))
+    );
+  });
+
+  it('should equal the opposite partition without kerf', function () {
+    assert.deepEqual(
+      spans(makerjs.joinery.complement(fingers(100, 20, 3))),
+      spans(fingers(100, 20, 3, undefined, false))
+    );
+  });
+
+  it('should return the original when applied twice', function () {
+    var f = fingers(100, 20, 3, 1);
+    assert.deepEqual(spans(makerjs.joinery.complement(makerjs.joinery.complement(f, 1), 1)), spans(f));
+  });
+
+  it('should return the original when applied twice without kerf', function () {
+    var f = fingers(90, 14, 3);
+    assert.deepEqual(spans(makerjs.joinery.complement(makerjs.joinery.complement(f))), spans(f));
+  });
+
+  it('should narrow what the original widened', function () {
+    var c = makerjs.joinery.complement(fingers(100, 20, 3, 2), 2);
+    near(widths(c)[0], 19, 'first slot');
+    near(widths(c)[2], 18, 'interior slot');
+  });
+
+  it('should reject an empty partition', function () {
+    expectThrows(function () { makerjs.joinery.complement([]); }, 'must not be empty');
+  });
+
+  it('should reject a negative kerf', function () {
+    expectThrows(function () { makerjs.joinery.complement(fingers(100, 20, 3), -1); }, 'negative kerf');
+  });
+});
