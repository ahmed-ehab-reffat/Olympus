+    assert.equal(report.faces, 1);
+    assert.equal(report.tabs, 2);
+    assert.equal(report.slots, 1);
+  });
+
+  it('should balance tabs and slots across a closed box', function () {
+    var report = makerjs.joinery.report(box(opts(12, 3)));
+    assert.equal(report.tabs, report.slots);
+  });
+});
