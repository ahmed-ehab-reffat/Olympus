+    var b = box({ fingerWidth: 12, thickness: 3, dividers: [40] });
+    var extents = pocketExtents(b, 'bottom', 'divider1', 'Mortise1');
+    near(extents.high[0] - extents.low[0], 3, 'pocket thickness');
