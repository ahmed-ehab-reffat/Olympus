+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+PKG="$ROOT/packages/maker.js"
+NEW_TESTS="test/joinery_816324.js"
+MOCHA="$ROOT/node_modules/.bin/mocha"
+TSC="$ROOT/node_modules/.bin/tsc"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+write_build_failure() {
+  if [ -z "$OUTPUT_PATH" ]; then
+    return
+  fi
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="maker.js" tests="1" failures="1" errors="0" time="0">
+<testsuite name="build" tests="1" failures="1" errors="0" time="0">
+<testcase name="typescript build succeeds" classname="build" time="0">
+<failure message="build failed">The TypeScript sources did not compile.</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+}
+
+cd "$PKG" || exit 1
+
+if ! "$TSC" -p target; then
+  write_build_failure
+  exit 1
+fi
+
+if [ ! -f dist/index.js ]; then
+  write_build_failure
+  exit 1
+fi
+
+printf 'var Bezier = require("bezier-js");\n' >> dist/index.js
+
+if [ "$MODE" = "new" ]; then
+  set -- "$NEW_TESTS"
+else
+  set -- --ignore "$NEW_TESTS"
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  "$MOCHA" --timeout 15000 --reporter xunit --reporter-option output="$OUTPUT_PATH" "$@"
+  EXIT_CODE=$?
+
+  if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    write_build_failure
+    exit $EXIT_CODE
+  fi
+
+  if ! head -n 1 "$OUTPUT_PATH" | grep -q '<testsuites'; then
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+      cat "$OUTPUT_PATH"
+      printf '\n</testsuites>\n'
+    } > "$OUTPUT_PATH.wrapped"
+    mv "$OUTPUT_PATH.wrapped" "$OUTPUT_PATH"
+  fi
+
+  exit $EXIT_CODE
+fi
+
+"$MOCHA" --timeout 15000 "$@"
