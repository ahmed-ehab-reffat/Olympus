+describe('Joinery report', function () {
+
+  it('should count every jointed face', function () {
+    assert.equal(makerjs.joinery.report(box(opts(12, 3))).faces, 6);
+  });
+
+  it('should count the panels of a divided box', function () {
+    assert.equal(makerjs.joinery.report(box({ fingerWidth: 12, thickness: 3, dividers: [40] })).faces, 7);
+  });
+
+  it('should count the tabs of a single face', function () {
+    var r = new makerjs.models.JointedRectangle(60, 40, { fingerWidth: 20, thickness: 3, edges: { bottom: true } });
+    assert.equal(makerjs.joinery.report(r).tabs, 2);
+  });
+
+  it('should count the slots of a single face', function () {
+    var r = new makerjs.models.JointedRectangle(60, 40, { fingerWidth: 20, thickness: 3, edges: { bottom: true } });
+    assert.equal(makerjs.joinery.report(r).slots, 1);
+  });
+
+  it('should measure the cut length of a face', function () {
+    var r = new makerjs.models.JointedRectangle(60, 40, { fingerWidth: 20, thickness: 3, edges: { bottom: true } });
