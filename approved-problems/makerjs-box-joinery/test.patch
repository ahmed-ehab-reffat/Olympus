+    near(makerjs.joinery.report(plain).cutLength, makerjs.measure.modelPathLength(plain), 'cut length');
+  });
+
+  it('should report nothing for a model without joints', function () {
+    var report = makerjs.joinery.report(new makerjs.models.Rectangle(10, 10));
+    assert.equal(report.faces, 0);
+    assert.equal(report.tabs, 0);
+    assert.equal(report.slots, 0);
+  });
+
+  it('should measure the cut length of a divided box', function () {
+    var b = box({ fingerWidth: 12, thickness: 3, dividers: [40] });
+    near(makerjs.joinery.report(b).cutLength, makerjs.measure.modelPathLength(b), 'cut length');
+  });
+
+  it('should count only the children which carry joints', function () {
+    var jointed = new makerjs.models.JointedRectangle(60, 40, { fingerWidth: 20, thickness: 3, edges: { bottom: true } });
+    var report = makerjs.joinery.report({ models: { a: jointed, b: new makerjs.models.Rectangle(10, 10) } });
+    assert.equal(report.faces, 1);
+    assert.equal(report.tabs, 2);
+    assert.equal(report.slots, 1);
+  });
+
+  it('should add the paths of the root and its children to the cut length', function () {
+    var jointed = new makerjs.models.JointedRectangle(60, 40, { fingerWidth: 20, thickness: 3, edges: { bottom: true } });
+    var root = new makerjs.models.Rectangle(10, 10);
+    root.models = { inner: jointed };
+    var report = makerjs.joinery.report(root);
