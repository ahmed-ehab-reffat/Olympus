+
+  it('should narrow an interior slot by a whole kerf', function () {
+    var f = fingers(100, 20, 3, 2);
+    near(widths(f)[1], 18, 'interior slot');
+  });
+
+  it('should widen an end tab by half a kerf', function () {
+    var f = fingers(100, 20, 3, 2);
+    near(widths(f)[0], 21, 'first tab');
+    near(widths(f)[4], 21, 'last tab');
+  });
+
+  it('should narrow an end slot by half a kerf', function () {
+    var f = fingers(100, 20, 3, 2, false);
+    near(widths(f)[0], 19, 'first slot');
+    near(widths(f)[4], 19, 'last slot');
+  });
+
+  it('should not move the outer boundaries of the edge', function () {
+    var f = fingers(100, 20, 3, 2);
+    near(f[0].start, 0, 'first start');
+    near(f[f.length - 1].end, 100, 'last end');
+  });
+
+  it('should keep the total width equal to the edge with kerf', function () {
+    var f = fingers(100, 20, 3, 2);
+    var total = widths(f).reduce(function (a, b) { return a + b; }, 0);
+    near(total, 100, 'total');
+  });
+
+  it('should place the exact spans of a kerf compensated edge', function () {
+    assert.deepEqual(spans(fingers(100, 20, 3, 1)), [[0, 20.5, true], [20.5, 39.5, false], [39.5, 60.5, true], [60.5, 79.5, false], [79.5, 100, true]]);
+  });
+
+  it('should treat a missing kerf as zero', function () {
+    assert.deepEqual(spans(fingers(60, 20, 3)), spans(fingers(60, 20, 3, 0)));
+  });
+
+  it('should reject a kerf as wide as one finger', function () {
+    expectThrows(function () { fingers(60, 20, 3, 20); }, 'smaller than the width of one finger');
+  });
+
+  it('should reject a kerf wider than one finger', function () {
+    expectThrows(function () { fingers(60, 20, 3, 25); }, 'smaller than the width of one finger');
+  });
+
+  it('should reject a negative kerf', function () {
+    expectThrows(function () { fingers(60, 20, 3, -1); }, 'kerf cannot be negative');
+  });
+
+  it('should reject a negative finger width', function () {
+    expectThrows(function () { fingers(60, -20, 3); }, 'negative finger width');
+  });
+
+  it('should reject a finger width of zero', function () {
+    expectThrows(function () { fingers(60, 0, 3); }, 'zero finger width');
+  });
+
+  it('should reject a negative thickness', function () {
+    expectThrows(function () { fingers(60, 20, -3); }, 'negative thickness');
+  });
+
+  it('should reject a thickness of zero', function () {
+    expectThrows(function () { fingers(60, 20, 0); }, 'must be greater than zero');
+  });
+
+  it('should reject a length of zero', function () {
+    expectThrows(function () { fingers(0, 20, 3); }, 'must be greater than zero');
+  });
+
+  it('should reject a negative length', function () {
+    expectThrows(function () { fingers(-60, 20, 3); }, 'negative length');
+  });
+});
