+    }
+  });
+
+  it('should make every finger the same width without kerf', function () {
+    nearList(widths(fingers(60, 20, 3)), [20, 20, 20]);
+  });
+
+  it('should divide the remainder evenly rather than leaving it at the end', function () {
+    nearList(widths(fingers(100, 12, 3)), [100 / 9, 100 / 9, 100 / 9, 100 / 9, 100 / 9, 100 / 9, 100 / 9, 100 / 9, 100 / 9]);
+  });
+
+  it('should start with a tab by default', function () {
+    assert.equal(fingers(60, 20, 3)[0].tab, true);
