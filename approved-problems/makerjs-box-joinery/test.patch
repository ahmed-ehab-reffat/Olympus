+var assert = require('assert');
+var makerjs = require('../dist/index.js')
+
+function opts(fingerWidth, thickness, kerf, startWithTab) {
+  var o = { fingerWidth: fingerWidth, thickness: thickness };
+  if (kerf !== undefined) o.kerf = kerf;
+  if (startWithTab !== undefined) o.startWithTab = startWithTab;
+  return o;
+}
+
+function fingers(length, fingerWidth, thickness, kerf, startWithTab) {
+  return makerjs.joinery.fingers(length, opts(fingerWidth, thickness, kerf, startWithTab));
+}
+
+function spans(list) {
+  return list.map(function (f) { return [f.start, f.end, f.tab]; });
+}
+
+function widths(list) {
+  return list.map(function (f) { return f.end - f.start; });
+}
+
+function near(actual, expected, label) {
+  assert.ok(Math.abs(actual - expected) < 1e-9, (label || 'value') + ' expected ' + expected + ' but was ' + actual);
+}
+
+function nearList(actual, expected, label) {
+  assert.equal(actual.length, expected.length, (label || 'list') + ' length');
+  for (var i = 0; i < expected.length; i++) {
+    near(actual[i], expected[i], (label || 'list') + '[' + i + ']');
+  }
+}
+
+function nearPoints(actual, expected) {
+  assert.equal(actual.length, expected.length, 'point count');
+  for (var i = 0; i < expected.length; i++) {
+    near(actual[i][0], expected[i][0], 'point ' + i + ' x');
+    near(actual[i][1], expected[i][1], 'point ' + i + ' y');
+  }
+}
+
+function expectThrows(fn, label) {
+  var caught = null;
+  try {
+    fn();
+  } catch (e) {
+    caught = e;
+  }
+  assert.ok(caught !== null, 'expected a rejection: ' + label);
+  assert.ok(String(caught).indexOf('joinery:') >= 0, 'expected a joinery rejection for ' + label + ' but got "' + String(caught) + '"');
+}
+
+function box(options) {
+  return new makerjs.models.FingerBox(120, 80, 60, options);
+}
+
+function seamMates(model, seam, kerf) {
+  var a = model.models[seam.tabbed[0]].joints[seam.tabbed[1]];
+  var b = model.models[seam.slotted[0]].joints[seam.slotted[1]];
+  return makerjs.joinery.mates(a, b, kerf);
+}
+
+function hasCoordinate(model, axis, value) {
+  for (var id in model.paths) {
+    var line = model.paths[id];
+    if (Math.abs(line.origin[axis] - value) < 1e-9) return true;
+    if (Math.abs(line.end[axis] - value) < 1e-9) return true;
+  }
+  return false;
+}
+
+function touchesPoint(model, point) {
+  for (var id in model.paths) {
+    var line = model.paths[id];
+    if (line.origin[0] === point[0] && line.origin[1] === point[1]) return true;
+    if (line.end[0] === point[0] && line.end[1] === point[1]) return true;
+  }
+  return false;
+}
+
+function pathCount(model) {
+  return Object.keys(model.paths || {}).length;
+}
+
+function pocketExtents(model, faceId, panelId, pocketId) {
+  var face = makerjs.cloneObject(model.models[faceId]);
+  makerjs.model.originate(face);
+  return makerjs.measure.modelExtents(face.models[panelId].models[pocketId]);
+}
+
+describe('Joinery finger count', function () {
+
+  it('should divide an edge into a whole number of fingers', function () {
+    assert.equal(makerjs.joinery.fingerCount(100, 20), 5);
+  });
+
+  it('should return an odd count when the quotient is even', function () {
+    assert.equal(makerjs.joinery.fingerCount(100, 25), 5);
+  });
+
+  it('should round up when two odd counts are equally near', function () {
+    assert.equal(makerjs.joinery.fingerCount(80, 10), 9);
+  });
+
+  it('should round down to the nearer odd count', function () {
+    assert.equal(makerjs.joinery.fingerCount(100, 33), 3);
+  });
+
+  it('should round up to the nearer odd count', function () {
+    assert.equal(makerjs.joinery.fingerCount(100, 12), 9);
+  });
+
+  it('should never return fewer than three fingers', function () {
+    assert.equal(makerjs.joinery.fingerCount(5, 10), 3);
+  });
+
+  it('should return three for an edge shorter than one finger', function () {
+    assert.equal(makerjs.joinery.fingerCount(1, 1000), 3);
+  });
+
+  it('should reject a length of zero', function () {
+    expectThrows(function () { makerjs.joinery.fingerCount(0, 10); }, 'must be greater than zero');
+  });
+
+  it('should reject a negative length', function () {
+    expectThrows(function () { makerjs.joinery.fingerCount(-10, 10); }, 'must be greater than zero');
+  });
+
+  it('should reject a finger width of zero', function () {
+    expectThrows(function () { makerjs.joinery.fingerCount(100, 0); }, 'must be greater than zero');
+  });
+
+  it('should reject a negative finger width', function () {
+    expectThrows(function () { makerjs.joinery.fingerCount(100, -20); }, 'negative finger width');
+  });
+});
