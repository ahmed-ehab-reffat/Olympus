+#[test]
+fn polyline_sweep_matches_the_direct_path_through_start_peak_and_end_across_the_branch_cut() {
+    let base = right_turn_corner();
+    let half_width = 1.0;
+    let theta: f32 = 150.0_f32.to_radians();
+    let (s, c) = theta.sin_cos();
+    let rotated: Vec<Point> = base
+        .iter()
+        .map(|p| point(p.x * c - p.y * s, p.x * s + p.y * c))
+        .collect();
+    let join = rotated[1];
+    let poly = compute_arcs_join_polyline(rotated[0], rotated[1], rotated[2], half_width, 5.0, 0.01, true);
+
+    let mut total_sweep = 0.0f32;
+    for w in poly.windows(2) {
+        total_sweep += unsigned_angle_at_join(join, w[0], w[1]);
+    }
+
+    let start = poly[0];
+    let peak = compute_arcs_join(rotated[0], rotated[1], rotated[2], half_width, 5.0, true).unwrap();
+    let end = *poly.last().unwrap();
+    let direct_sweep =
+        unsigned_angle_at_join(join, start, peak) + unsigned_angle_at_join(join, peak, end);
+
+    assert!(
+        (total_sweep - direct_sweep).abs() < 0.01,
+        "the polyline's accumulated sweep ({}) must match the direct angular path from start through the peak to end ({}); a construction that fails to unwrap the swept angle across the atan2 branch cut takes the long way around instead",
+        total_sweep,
+        direct_sweep
+    );
+}
