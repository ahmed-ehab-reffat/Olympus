+// --- core behavior: arcs is a genuinely distinct join, not an alias ---
+
+fn arcs_mesh(corner: &[Point; 3], miter_limit: f32) -> (Vec<Point>, Vec<u16>) {
+    let mut o = opts().with_line_join(LineJoin::Arcs);
+    o.miter_limit = miter_limit;
+    tessellate(&open_path(corner), &o)
+}
+
+#[test]
+fn arcs_differs_from_bevel() {
+    let corner = right_turn_corner();
+    let [a, b, c] = corner;
+    let peak = compute_arcs_join(a, b, c, 1.0, 10.0, true).unwrap();
+    let (av, ai) = arcs_mesh(&corner, 10.0);
+    assert!(
+        mesh_boundary_distance(&av, &ai, peak) < NEAR_SURFACE,
+        "the Arcs surface must pass near the curvature-following point {:?}",
+        peak
+    );
+    let (v, i) = tessellate(&open_path(&corner), &{
+        let mut o = opts().with_line_join(LineJoin::Bevel);
+        o.miter_limit = 10.0;
+        o
+    });
+    assert!(
+        mesh_boundary_distance(&v, &i, peak) > NEAR_SURFACE,
+        "a Bevel join's surface must not pass near the curvature-following point {:?}",
+        peak
+    );
+}
