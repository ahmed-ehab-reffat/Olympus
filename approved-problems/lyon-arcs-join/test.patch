+#[test]
+fn arcs_join_matches_independent_circumcircle_oracle_for_asymmetric_corner() {
+    let prev = point(0.0, 0.0);
+    let join = point(12.0, 0.0);
+    let next = point(17.0, -5.0);
+    let half_width = 1.0;
+
+    let (center, radius) = circumcircle_oracle(prev, join, next);
+    let radial = (join - center) / (join - center).length();
+    let expected = center + radial * (radius + half_width);
+
+    let peak = compute_arcs_join(prev, join, next, half_width, 5.0, true).unwrap();
+    assert!(
+        (peak - expected).length() < 1e-3,
+        "compute_arcs_join {:?} must match the independently derived circumcircle oracle {:?}",
+        peak,
+        expected
+    );
+
+    let (v, i) = arcs_mesh(&[prev, join, next], 5.0);
+    assert!(
+        mesh_boundary_distance(&v, &i, expected) < NEAR_SURFACE,
+        "the tessellated Arcs surface must reach the independently derived oracle point {:?}",
+        expected
+    );
+}
