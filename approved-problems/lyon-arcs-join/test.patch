+    let fine_polyline = compute_arcs_join_polyline(a, b, c, 1.0, 5.0, 0.001, true);
+    let interior_point = fine_polyline[fine_polyline.len() / 4];
+
+    let mut o = opts().with_line_join(LineJoin::Arcs).with_tolerance(0.001);
+    o.miter_limit = 5.0;
+    let (v, i) = tessellate(&open_path(&corner), &o);
+    assert!(
+        mesh_boundary_distance(&v, &i, interior_point) < NEAR_SURFACE,
+        "at a fine tolerance, the tessellated Arcs surface must pass near an interior point of the curvature-following arc, not only its start, peak and end; an implementation that ignores tolerance and always draws two straight segments through the peak would miss this point by a wide margin"
+    );
+}
