+    StrokeOptions, StrokeTessellator,
+};
+
+fn tessellate_variable_width(path: &Path, options: &StrokeOptions) -> (Vec<Point>, Vec<u16>) {
+    let mut buffers: VertexBuffers<Point, u16> = VertexBuffers::new();
+    let mut tess = StrokeTessellator::new();
+    tess.tessellate_path(path, options, &mut simple_builder(&mut buffers))
+        .unwrap();
+    (buffers.vertices, buffers.indices)
+}
+
+fn variable_width_path(pts: &[(Point, f32)]) -> Path {
+    let mut b = Path::builder_with_attributes(1);
+    b.begin(pts[0].0, &[pts[0].1]);
+    for (p, w) in &pts[1..] {
+        b.line_to(*p, &[*w]);
+    }
+    b.end(false);
+    b.build()
+}
+
+fn variable_width_area_with(join: LineJoin, miter_limit: f32, corner: &[(Point, f32)]) -> f32 {
+    let mut o = StrokeOptions::default().with_variable_line_width(0).with_line_join(join);
+    o.miter_limit = miter_limit;
+    let (v, i) = tessellate_variable_width(&variable_width_path(corner), &o);
+    total_area(&v, &i)
+}
+
+fn right_angle_corner_vw() -> [(Point, f32); 3] {
+    [
+        (point(0.0, 0.0), 2.0),
+        (point(10.0, 0.0), 2.0),
+        (point(10.0, 8.0), 2.0),
+    ]
+}
+
+fn tessellate(path: &Path, options: &StrokeOptions) -> (Vec<Point>, Vec<u16>) {
+    let mut buffers: VertexBuffers<Point, u16> = VertexBuffers::new();
+    let mut tess = StrokeTessellator::new();
+    tess.tessellate_path(path, options, &mut simple_builder(&mut buffers))
+        .unwrap();
+    (buffers.vertices, buffers.indices)
+}
+
+fn cross(a: Point, b: Point, c: Point) -> f32 {
+    (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
+}
+
+fn point_in_triangle(p: Point, a: Point, b: Point, c: Point) -> bool {
+    let d1 = cross(a, b, p);
+    let d2 = cross(b, c, p);
+    let d3 = cross(c, a, p);
+    let has_neg = d1 < 0.0 || d2 < 0.0 || d3 < 0.0;
+    let has_pos = d1 > 0.0 || d2 > 0.0 || d3 > 0.0;
+    !(has_neg && has_pos)
+}
+
+fn filled(verts: &[Point], indices: &[u16], p: Point) -> bool {
+    for tri in indices.chunks_exact(3) {
+        let a = verts[tri[0] as usize];
+        let b = verts[tri[1] as usize];
+        let c = verts[tri[2] as usize];
+        if point_in_triangle(p, a, b, c) {
+            return true;
+        }
+    }
+    false
+}
+
+fn total_area(verts: &[Point], indices: &[u16]) -> f32 {
+    let mut area = 0.0;
+    for tri in indices.chunks_exact(3) {
+        let a = verts[tri[0] as usize];
+        let b = verts[tri[1] as usize];
+        let c = verts[tri[2] as usize];
+        area += cross(a, b, c).abs() * 0.5;
+    }
+    area
+}
+
+fn open_path(pts: &[Point]) -> Path {
+    let mut b = Path::builder();
+    b.begin(pts[0]);
+    for p in &pts[1..] {
+        b.line_to(*p);
+    }
+    b.end(false);
+    b.build()
+}
+
+fn closed_path(pts: &[Point]) -> Path {
+    let mut b = Path::builder();
+    b.begin(pts[0]);
+    for p in &pts[1..] {
+        b.line_to(*p);
+    }
+    b.end(true);
+    b.build()
+}
+
+fn opts() -> StrokeOptions {
+    StrokeOptions::DEFAULT.with_line_width(2.0)
+}
+
+fn area_with(join: LineJoin, miter_limit: f32, corner: &[Point]) -> f32 {
+    let mut o = opts().with_line_join(join);
+    o.miter_limit = miter_limit;
+    let (v, i) = tessellate(&open_path(corner), &o);
+    total_area(&v, &i)
+}
