+fn circumcircle_oracle(a: Point, b: Point, c: Point) -> (Point, f32) {
+    let (ax, ay) = (a.x, a.y);
+    let (bx, by) = (b.x, b.y);
+    let (cx, cy) = (c.x, c.y);
+    let d = 2.0 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));
+    let a2 = ax * ax + ay * ay;
+    let b2 = bx * bx + by * by;
+    let c2 = cx * cx + cy * cy;
+    let ux = (a2 * (by - cy) + b2 * (cy - ay) + c2 * (ay - by)) / d;
+    let uy = (a2 * (cx - bx) + b2 * (ax - cx) + c2 * (bx - ax)) / d;
+    let center = point(ux, uy);
+    (center, (center - b).length())
+}
