+// --- independent geometric oracle: for a symmetric (equal-leg) corner, ANY
+// reasonable curvature-following construction must place the peak exactly on
+// the angle bisector through the join, by reflection symmetry alone. This is
+// true regardless of which specific curvature formula computes the direction,
+// so it does not pin an implementation choice the description never states. ---
+
+#[test]
+fn arcs_join_peak_lies_on_the_bisector_for_a_symmetric_corner() {
+    let prev = point(0.0, 0.0);
+    let join = point(10.0, 0.0);
+    let theta: f32 = 150.0_f32.to_radians();
+    let next = point(join.x + 10.0 * theta.cos(), join.y + 10.0 * theta.sin());
+    assert!((prev - join).length() - (next - join).length() < 1e-4, "corner must be isoceles");
+
+    let peak = compute_arcs_join(prev, join, next, 1.0, 5.0, true).unwrap();
+
+    let bisector = ((prev - join).normalize() + (next - join).normalize()).normalize();
+    let peak_dir = (peak - join).normalize();
+    let cross = peak_dir.x * bisector.y - peak_dir.y * bisector.x;
+    assert!(
+        cross.abs() < 1e-3,
+        "peak {:?} is not on the bisector line through the join (cross {})",
+        peak,
+        cross
+    );
+}
