+// Distance from p to the nearest edge of the tessellated mesh (not just its
+// vertices). This checks whether the rendered surface actually passes near p,
+// without assuming any particular subdivision or vertex-placement strategy.
+fn point_segment_distance(p: Point, a: Point, b: Point) -> f32 {
+    let ab = b - a;
+    let len2 = ab.square_length();
+    if len2 < 1e-12 {
+        return (p - a).length();
+    }
+    let t = ((p - a).dot(ab) / len2).max(0.0).min(1.0);
+    (p - (a + ab * t)).length()
+}
+
+fn mesh_boundary_distance(verts: &[Point], indices: &[u16], p: Point) -> f32 {
+    let mut best = f32::MAX;
+    for tri in indices.chunks_exact(3) {
+        let a = verts[tri[0] as usize];
+        let b = verts[tri[1] as usize];
+        let c = verts[tri[2] as usize];
+        for (x, y) in [(a, b), (b, c), (c, a)] {
+            let d = point_segment_distance(p, x, y);
+            if d < best {
+                best = d;
+            }
+        }
+    }
+    best
+}
+
+const NEAR_SURFACE: f32 = 0.01;
+
+fn square_loop() -> [Point; 4] {
+    [point(0.0, 0.0), point(20.0, 0.0), point(20.0, 20.0), point(0.0, 20.0)]
