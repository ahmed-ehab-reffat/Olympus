+#[test]
+fn both_fallback_conditions_are_independent() {
+    // collinear AND a generous limit: must still fall back (limit alone would not trigger it)
+    let collinear = [point(0.0, 0.0), point(10.0, 0.0), point(20.0, 0.0)];
+    let arcs_area = area_with(LineJoin::Arcs, 50.0, &collinear);
+    let bevel_area = area_with(LineJoin::Bevel, 50.0, &collinear);
+    assert!((arcs_area - bevel_area).abs() < 0.01, "collinear should fall back even with a generous limit");
+
+    // non-collinear AND a tight limit: must still fall back (non-collinearity alone would not trigger it)
+    let arcs_area2 = area_with(LineJoin::Arcs, 1.0, &sharp_corner());
+    let bevel_area2 = area_with(LineJoin::Bevel, 1.0, &sharp_corner());
+    assert!((arcs_area2 - bevel_area2).abs() < 0.05, "a tight limit should fall back even without collinearity");
