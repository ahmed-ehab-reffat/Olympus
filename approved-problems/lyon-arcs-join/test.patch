+fn unsigned_angle_at_join(join: Point, a: Point, b: Point) -> f32 {
+    let ua = (a - join).normalize();
+    let ub = (b - join).normalize();
+    ua.dot(ub).max(-1.0).min(1.0).acos()
+}
