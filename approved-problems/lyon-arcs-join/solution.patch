+/// Computes the polyline `[start, .., peak, .., end]` that an actual
+/// `LineJoin::Arcs` join on the requested side would tessellate at the given
+/// `tolerance` (see `StrokeOptions::tolerance`), or an empty vector under the
+/// same fallback conditions as [`compute_arcs_join`].
+///
+/// `start` and `end` are the stroke's offset points on the requested side of
+/// the `prev`-to-`join` and `join`-to-`next` edges; `peak` is the point
+/// [`compute_arcs_join`] would return for the same inputs.
+#[cfg_attr(feature = "profiling", inline(never))]
+pub fn compute_arcs_join_polyline(
+    prev: Point,
+    join: Point,
+    next: Point,
+    half_width: f32,
+    miter_limit: f32,
+    tolerance: f32,
+    positive_side: bool,
+) -> Vec<Point> {
+    debug_assert!(half_width > 0.0 && half_width.is_finite());
+    debug_assert!(tolerance > 0.0 && tolerance.is_finite());
+    debug_assert!(miter_limit >= StrokeOptions::MINIMUM_MITER_LIMIT);
+    nan_check!(prev, join, next);
+    if prev == join || join == next {
+        return Vec::new();
+    }
+
+    let prev_tangent = (join - prev).normalize();
+    let next_tangent = (next - join).normalize();
+    let normal = side_signed_normal(prev_tangent, next_tangent, positive_side);
+
+    if miter_limit_is_exceeded(normal, miter_limit) {
+        return Vec::new();
+    }
+
+    let peak = match arcs_join_position(prev, join, next, normal, half_width) {
+        Some(p) => p,
+        None => return Vec::new(),
+    };
+
+    let side_sign = if positive_side { 1.0 } else { -1.0 };
+    let start = join + vector(-prev_tangent.y, prev_tangent.x) * half_width * side_sign;
+    let end = join + vector(-next_tangent.y, next_tangent.x) * half_width * side_sign;
+    nan_check!(start, end);
+
+    let angle_sign = if positive_side { -1.0 } else { 1.0 };
+    let start_angle = (start - join).angle_from_x_axis();
+
+    let mut peak_diff = start_angle.angle_to((peak - join).angle_from_x_axis());
+    if peak_diff.radians * angle_sign < 0.0 {
+        peak_diff.radians = angle_sign * (2.0 * PI - peak_diff.radians.abs());
+    }
+    let peak_angle = (start_angle + peak_diff).radians;
+
+    let mut end_diff = start_angle.angle_to((end - join).angle_from_x_axis());
+    if end_diff.radians * angle_sign < 0.0 {
+        end_diff.radians = angle_sign * (2.0 * PI - end_diff.radians.abs());
+    }
+    let end_angle = (start_angle + end_diff).radians;
+
+    let step = circle_flattening_step(half_width, tolerance);
+
+    let mut points = Vec::new();
+    points.push(start);
+    push_arc_subdivisions(&mut points, join, half_width, start_angle.radians, peak_angle, step);
+    points.push(peak);
+    push_arc_subdivisions(&mut points, join, half_width, peak_angle, end_angle, step);
+    points.push(end);
+
+    debug_assert!(points.len() >= 3, "polyline must contain at least start, peak and end");
+    debug_assert!(
+        points.iter().all(|p| (*p - join).length() > 0.0),
+        "no polyline point should coincide with the join"
+    );
+
+    points
+}
+
+/// Pushes the intermediate points of a circular arc of radius `radius`
+/// centered on `center`, strictly between the angles `a0` and `a1` (both
+/// exclusive), onto `points`. The number of intermediate points is derived
+/// from `step`, the maximum angular span (in radians) of a single segment.
+#[cfg_attr(feature = "profiling", inline(never))]
+fn push_arc_subdivisions(points: &mut Vec<Point>, center: Point, radius: f32, a0: f32, a1: f32, step: f32) {
+    debug_assert!(radius > 0.0);
+    debug_assert!(a0.is_finite() && a1.is_finite());
+    nan_check!(center);
+    let num_segments = ((a1 - a0).abs() / step).ceil().max(1.0) as u32;
+    for i in 1..num_segments {
+        let t = i as f32 / num_segments as f32;
+        let a = a0 + (a1 - a0) * t;
+        let p = center + vector(a.cos(), a.sin()) * radius;
+        nan_check!(p);
+        points.push(p);
+    }
+}
