+/// The extrapolated-arc join vertex on the `front_normal` side, or `None`
+/// when the neighboring points are collinear.
+#[cfg_attr(feature = "profiling", inline(never))]
+fn arcs_join_position(
+    prev_pos: Point,
+    join_pos: Point,
+    next_pos: Point,
+    front_normal: Vector,
+    half_width: f32,
+) -> Option<Point> {
+    let (center, radius) = circumcircle(prev_pos, join_pos, next_pos)?;
+
+    let radial = (join_pos - center).normalize();
+    let sign = if radial.dot(front_normal) >= 0.0 { 1.0 } else { -1.0 };
+    let offset_radius = radius + sign * half_width;
+    if offset_radius <= 0.0 {
+        return None;
+    }
+
+    let result = center + radial * offset_radius;
+    nan_check!(result);
+
+    Some(result)
+}
+
+/// The normal at a join between `prev_tangent` and `next_tangent`, on the
+/// positive side (see [`compute_normal`]) when `positive_side` is `true`, or
+/// the opposite side otherwise.
+fn side_signed_normal(prev_tangent: Vector, next_tangent: Vector, positive_side: bool) -> Vector {
+    let normal = compute_normal(prev_tangent, next_tangent);
+    if positive_side {
+        normal
+    } else {
+        -normal
+    }
+}
+
+/// Computes the join vertex a `LineJoin::Arcs` join would use on the requested
+/// side of the turn from `prev` through `join` to `next` (`positive_side`
+/// selects the side described in [`compute_normal`], `!positive_side` the
+/// other one), or `None` when that side would fall back to a plain `Bevel`
+/// corner (either because `prev`, `join` and `next` are collinear, or because
+/// the join would exceed `miter_limit`).
+///
+/// `prev`, `join` and `next` are three consecutive points on a stroked path's
+/// centerline and `half_width` is half of the stroke's line width at `join`.
+/// This mirrors the geometry the stroke tessellator produces for an `Arcs`
+/// join on that side without requiring a full path or a tessellation pass,
+/// which is useful for previewing or hit-testing a stroke outline ahead of
+/// time. When the requested side is the concave (inner) side of the turn,
+/// the tessellator connects it directly regardless of `line_join` and does
+/// not use this geometry; this function still reports what an `Arcs` join
+/// would compute for that side in isolation.
+#[cfg_attr(feature = "profiling", inline(never))]
+pub fn compute_arcs_join(
+    prev: Point,
+    join: Point,
+    next: Point,
+    half_width: f32,
+    miter_limit: f32,
+    positive_side: bool,
+) -> Option<Point> {
+    debug_assert!(half_width > 0.0 && half_width.is_finite());
+    debug_assert!(miter_limit >= StrokeOptions::MINIMUM_MITER_LIMIT);
+    nan_check!(prev, join, next);
+    if prev == join || join == next {
+        return None;
+    }
+
+    let prev_tangent = (join - prev).normalize();
+    let next_tangent = (next - join).normalize();
+    let normal = side_signed_normal(prev_tangent, next_tangent, positive_side);
+
+    if miter_limit_is_exceeded(normal, miter_limit) {
+        return None;
+    }
+
+    arcs_join_position(prev, join, next, normal, half_width)
+}
+
+/// Returns `true` when the requested side (`positive_side` selects the side
+/// described in [`compute_normal`], `!positive_side` the other one) of the
+/// turn from `prev` through `join` to `next` is the convex side of the turn:
+/// the side an actual stroke tessellation draws a `LineJoin::Arcs` fan on.
+/// The other, concave side always connects directly regardless of
+/// `line_join`, and [`compute_arcs_join`]'s result is not used by the
+/// tessellator there.
+#[cfg_attr(feature = "profiling", inline(never))]
+pub fn arcs_join_side_is_convex(prev: Point, join: Point, next: Point, positive_side: bool) -> bool {
+    nan_check!(prev, join, next);
+    debug_assert!(prev != join && join != next, "prev, join and next must be distinct points");
+
+    let prev_tangent = (join - prev).normalize();
+    let next_tangent = (next - join).normalize();
+    nan_check!(prev_tangent, next_tangent);
+
+    let positive_is_convex = prev_tangent.cross(next_tangent) < 0.0;
+    positive_is_convex == positive_side
+}
