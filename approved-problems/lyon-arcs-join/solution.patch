+#[cfg_attr(feature = "profiling", inline(never))]
+fn tessellate_arcs_join(
+    join: &mut EndpointData,
+    side: usize,
+    options: &StrokeOptions,
+    vertex: &mut StrokeVertexData,
+    attributes: &dyn AttributeStore,
+    output: &mut dyn StrokeGeometryBuilder,
+) -> Result<(), TessellationError> {
+    let center = join.position;
+    let radius = join.half_width;
+    let peak = join.side_points[side].arcs_peak.unwrap();
+    let start_normal = join.side_points[side].prev - center;
+    let end_normal = join.side_points[side].next - center;
+    let peak_normal = peak - center;
+
+    let mut start_vertex = join.side_points[side].prev_vertex;
+    let mut end_vertex = join.side_points[side].next_vertex;
+
+    let angle_sign = if side == SIDE_NEGATIVE { 1.0 } else { -1.0 };
+
+    let mut start_angle = start_normal.angle_from_x_axis();
+    let mut diff = start_angle.angle_to(end_normal.angle_from_x_axis());
+    if diff.radians * angle_sign < 0.0 {
+        diff.radians = angle_sign * (2.0 * PI - diff.radians.abs());
+    }
+    let mut end_angle = start_angle + diff;
+
+    let mut peak_diff = start_angle.angle_to(peak_normal.angle_from_x_axis());
+    if peak_diff.radians * angle_sign < 0.0 {
+        peak_diff.radians = angle_sign * (2.0 * PI - peak_diff.radians.abs());
+    }
+
+    if peak_diff.radians.abs() > diff.radians.abs() {
+        // The curvature-derived peak fell outside the swept range between the two
+        // side offsets; keep the base triangle already produced by the caller and
+        // skip the additional fan rather than risk a self-crossing arc.
+        return Ok(());
+    }
+
+    let peak_angle = start_angle + peak_diff;
+
+    if side == SIDE_NEGATIVE {
+        core::mem::swap(&mut start_angle, &mut end_angle);
+        core::mem::swap(&mut start_vertex, &mut end_vertex);
+    }
+
+    let step = circle_flattening_step(radius, options.tolerance);
+
+    vertex.side = if side == SIDE_POSITIVE {
+        Side::Positive
+    } else {
+        Side::Negative
+    };
+    vertex.normal = peak_normal / radius;
+    let peak_vertex = output.add_stroke_vertex(StrokeVertex(vertex, attributes))?;
+
+    let first_span = (peak_angle.radians - start_angle.radians).abs();
+    let num_subdivisions_1 = (first_span / step).ceil().max(1.0).log2().round().max(1.0) as u32;
+
+    let second_span = (end_angle.radians - peak_angle.radians).abs();
+    let num_subdivisions_2 = (second_span / step).ceil().max(1.0).log2().round().max(1.0) as u32;
+
+    tessellate_arc(
+        (start_angle.radians, peak_angle.radians),
+        start_vertex,
+        peak_vertex,
+        num_subdivisions_1,
+        vertex,
+        attributes,
+        output,
+    )?;
+
+    tessellate_arc(
+        (peak_angle.radians, end_angle.radians),
+        peak_vertex,
+        end_vertex,
+        num_subdivisions_2,
+        vertex,
+        attributes,
+        output,
+    )
+}
