+	NtpLayer::TailInfo NtpLayer::parseV4Tail() const
+	{
+		TailInfo result = { false, 0, 0 };
+		if (getVersion() != 4 || m_DataLen < sizeof(ntp_header))
+			return result;
+
+		size_t tailLength = m_DataLen - sizeof(ntp_header);
+		if (tailLength == 0 || tailLength == 4 || tailLength == sizeof(ntp_v4_auth_md5) ||
+		    tailLength == sizeof(ntp_v4_auth_sha1))
+		{
+			result.valid = true;
+			result.authenticationLength = tailLength;
+			return result;
+		}
+
+		size_t offset = 0;
+		size_t lastFieldLength = 0;
+		while (offset < tailLength)
+		{
+			size_t remaining = tailLength - offset;
+			if (offset > 0 &&
+			    (remaining == 4 || remaining == sizeof(ntp_v4_auth_md5) || remaining == sizeof(ntp_v4_auth_sha1)))
+			{
+				result.valid = true;
+				result.extensionLength = offset;
+				result.authenticationLength = remaining;
+				return result;
+			}
+			if (remaining < 16)
+				return result;
+
+			uint16_t encodedLength;
+			memcpy(&encodedLength, m_Data + sizeof(ntp_header) + offset + sizeof(uint16_t), sizeof(encodedLength));
+			lastFieldLength = netToHost16(encodedLength);
+			if (lastFieldLength < 16 || lastFieldLength % 4 != 0 || lastFieldLength > remaining)
+				return result;
+			offset += lastFieldLength;
+		}
+
+		if (lastFieldLength < 28)
+			return result;
+		result.valid = true;
+		result.extensionLength = offset;
+		return result;
+	}
+
+	NtpExtensionField NtpLayer::getFirstExtensionField() const
+	{
+		TailInfo tail = parseV4Tail();
+		if (!tail.valid || tail.extensionLength == 0)
+			return NtpExtensionField();
+		return NtpExtensionField(m_Data + sizeof(ntp_header), false, this);
+	}
+
+	NtpExtensionField NtpLayer::getNextExtensionField(const NtpExtensionField& field) const
+	{
+		TailInfo tail = parseV4Tail();
+		uint8_t* extensionStart = m_Data + sizeof(ntp_header);
+		uintptr_t fieldAddress = reinterpret_cast<uintptr_t>(field.getRecordBasePtr());
+		uintptr_t startAddress = reinterpret_cast<uintptr_t>(extensionStart);
+		if (!tail.valid || field.m_ParentLayer != this || field.isNull() || fieldAddress < startAddress ||
+		    fieldAddress >= startAddress + tail.extensionLength)
+			return NtpExtensionField();
+
+		size_t nextOffset = static_cast<size_t>(field.getRecordBasePtr() - extensionStart) + field.getTotalSize();
+		if (nextOffset >= tail.extensionLength)
+			return NtpExtensionField();
+		return NtpExtensionField(extensionStart + nextOffset, false, this);
+	}
+
+	size_t NtpLayer::getExtensionFieldCount() const
+	{
+		TailInfo tail = parseV4Tail();
+		if (!tail.valid)
+			return 0;
+		size_t count = 0;
+		size_t offset = 0;
+		while (offset < tail.extensionLength)
+		{
+			NtpExtensionField field(m_Data + sizeof(ntp_header) + offset, false, this);
+			offset += field.getTotalSize();
+			++count;
+		}
+		return count;
+	}
+
+	NtpExtensionField NtpLayer::addExtensionFieldAt(const NtpExtensionFieldBuilder& builder, size_t offset)
+	{
+		TailInfo tail = parseV4Tail();
+		NtpExtensionField field = builder.build();
+		if (!tail.valid || tail.authenticationLength != 0 || field.isNull() || offset > tail.extensionLength ||
+		    (offset == tail.extensionLength && field.getTotalSize() < 28))
+		{
+			field.purgeRecordData();
+			return NtpExtensionField();
+		}
+
+		size_t insertionOffset = sizeof(ntp_header) + offset;
+		if (!extendLayer(static_cast<int>(insertionOffset), field.getTotalSize()))
+		{
+			field.purgeRecordData();
+			return NtpExtensionField();
+		}
+		memcpy(m_Data + insertionOffset, field.getRecordBasePtr(), field.getTotalSize());
+		field.purgeRecordData();
+		return NtpExtensionField(m_Data + insertionOffset, false, this);
+	}
+
+	NtpExtensionField NtpLayer::addExtensionField(const NtpExtensionFieldBuilder& builder)
+	{
+		TailInfo tail = parseV4Tail();
+		if (!tail.valid)
+			return NtpExtensionField();
+		return addExtensionFieldAt(builder, tail.extensionLength);
+	}
+
+	NtpExtensionField NtpLayer::addExtensionFieldBefore(const NtpExtensionFieldBuilder& builder, uint16_t nextFieldType)
+	{
+		TailInfo tail = parseV4Tail();
+		if (!tail.valid)
+			return NtpExtensionField();
+		size_t offset = 0;
+		while (offset < tail.extensionLength)
+		{
+			NtpExtensionField field(m_Data + sizeof(ntp_header) + offset, false, this);
+			if (field.getFieldType() == nextFieldType)
+				return addExtensionFieldAt(builder, offset);
+			offset += field.getTotalSize();
+		}
+		return addExtensionFieldAt(builder, tail.extensionLength);
+	}
+
+	bool NtpLayer::removeExtensionField(uint16_t fieldType)
+	{
+		TailInfo tail = parseV4Tail();
+		if (!tail.valid || tail.authenticationLength != 0)
+			return false;
+
+		size_t offset = 0;
+		size_t previousLength = 0;
+		while (offset < tail.extensionLength)
+		{
+			NtpExtensionField field(m_Data + sizeof(ntp_header) + offset, false, this);
+			if (field.getFieldType() == fieldType)
+			{
+				bool removingLast = offset + field.getTotalSize() == tail.extensionLength;
+				if (removingLast && offset != 0 && previousLength < 28)
+					return false;
+				return shortenLayer(static_cast<int>(sizeof(ntp_header) + offset), field.getTotalSize());
+			}
+			previousLength = field.getTotalSize();
+			offset += field.getTotalSize();
+		}
+		return false;
+	}
+
+	bool NtpLayer::removeAllExtensionFields()
+	{
+		TailInfo tail = parseV4Tail();
+		if (!tail.valid || tail.authenticationLength != 0)
+			return false;
+		if (tail.extensionLength == 0)
+			return true;
+		return shortenLayer(sizeof(ntp_header), tail.extensionLength);
+	}
+
+	NtpExtensionField::NtpExtensionField(const NtpExtensionField& other)
+	    : m_Data(other.m_Data), m_ParentLayer(other.m_ParentLayer)
