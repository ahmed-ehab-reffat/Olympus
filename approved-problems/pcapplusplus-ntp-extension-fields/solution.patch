+			memcpy(data, other.m_Data, totalSize);
+			m_OwnedData = std::shared_ptr<uint8_t>(data, std::default_delete<uint8_t[]>());
+			m_Data = data;
+			m_ParentLayer = nullptr;
+		}
+	}
+
