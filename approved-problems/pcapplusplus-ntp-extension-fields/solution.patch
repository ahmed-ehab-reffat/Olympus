+	NtpExtensionFieldBuilder::NtpExtensionFieldBuilder(uint16_t fieldType, const uint8_t* fieldData,
+	                                                   size_t fieldDataLength)
+	{
+		if (fieldDataLength > 65528 || (fieldData == nullptr && fieldDataLength != 0))
+			return;
+		size_t fieldLength = fieldDataLength + 2 * sizeof(uint16_t);
+		fieldLength += (4 - fieldLength % 4) % 4;
+		if (fieldLength < 16)
+			fieldLength = 16;
+		if (fieldLength > 65532)
+			return;
+
+		m_Data.resize(fieldLength, 0);
+		uint16_t encodedType = hostToNet16(fieldType);
+		uint16_t encodedLength = hostToNet16(static_cast<uint16_t>(fieldLength));
+		memcpy(m_Data.data(), &encodedType, sizeof(encodedType));
+		memcpy(m_Data.data() + sizeof(encodedType), &encodedLength, sizeof(encodedLength));
+		if (fieldDataLength != 0)
+			memcpy(m_Data.data() + 2 * sizeof(uint16_t), fieldData, fieldDataLength);
+	}
