+
+/**
+ * Deciding temporal properties over the executions produced by the simulator.
+ *
+ * A run is a finite sequence of states. When one of its states repeats, the run stands for the
+ * infinite behavior that reaches the first repeated state and then cycles forever, and every
+ * formula has a definite value on it. When no state repeats, the run is a prefix that could be
+ * continued in ways we did not explore, so a formula is only reported as violated when no
+ * continuation could satisfy it. Both cases are covered by evaluating with three values.
+ *
+ * @module
+ */
+
+import { Either, right } from '@sweet-monads/either'
+import { OrderedMap } from 'immutable'
+import { QuintEx } from '../../ir/quintIr'
+import { LookupDefinition, LookupTable } from '../../names/base'
+import { QuintError } from '../../quintError'
+import { RuntimeValue } from './runtimeValue'
+import { ACTION_TAKEN, NONDET_PICKS } from '../../itf'
+
+/**
+ * The value of a formula over a run: definitely true, definitely false, or not decided by this run.
+ */
+export type Verdict = 'true' | 'false' | 'unknown'
+
+/**
+ * The operators that talk about a whole execution rather than about a single state.
+ */
+const temporalOperators = ['always', 'eventually', 'leadsTo']
+
+/**
+ * The boolean connectives that a temporal formula may be built from.
+ */
+const connectives = ['and', 'or', 'not', 'implies', 'iff']
+
+/**
+ * The fields that the storage adds to a state record to carry trace metadata. They describe how a
+ * state was reached rather than what the state is, so states are compared without them.
+ */
+const metadataFields = [ACTION_TAKEN, NONDET_PICKS]
+
+/**
+ * Unfolds a reference to a definition that takes no arguments, so that the formula it stands for
+ * can be inspected. Anything else is returned unchanged.
+ *
+ * @param ex - the expression to unfold
+ * @param table - the lookup table
+ *
+ * @returns the body the name stands for, or the expression itself
+ */
+export function unfoldDefinition(ex: QuintEx, table: LookupTable): QuintEx {
+  let current = ex
+  const seen: Set<bigint> = new Set()
+
+  while (current.kind === 'name') {
+    const def: LookupDefinition | undefined = table.get(current.id)
+    if (def === undefined || def.kind !== 'def' || def.expr === undefined || def.expr.kind === 'lambda') {
+      return current
+    }
+    if (seen.has(def.id)) {
+      return current
+    }
+    seen.add(def.id)
+    current = def.expr
+  }
+
+  return current
+}
+
+/**
+ * Whether an expression talks about a whole execution, that is, whether a temporal operator occurs
+ * in it, including through the definitions it refers to.
+ *
+ * @param ex - the expression to inspect
+ * @param table - the lookup table
+ *
+ * @returns true iff the expression is a temporal formula
+ */
+export function isTemporalFormula(ex: QuintEx, table: LookupTable): boolean {
+  return occurs(ex, table, opcode => temporalOperators.includes(opcode))
+}
+
+/**
+ * Whether an expression reads the next state, that is, whether `next` occurs in it, including
+ * through the definitions it refers to.
+ *
+ * @param ex - the expression to inspect
+ * @param table - the lookup table
+ *
+ * @returns true iff the expression reads the next state
+ */
+export function readsNextState(ex: QuintEx, table: LookupTable): boolean {
+  return occurs(ex, table, opcode => opcode === 'next')
+}
+
+function occurs(ex: QuintEx, table: LookupTable, predicate: (opcode: string) => boolean): boolean {
+  const visited: Set<bigint> = new Set()
+
+  const scan = (current: QuintEx): boolean => {
+    if (visited.has(current.id)) {
+      return false
+    }
+    visited.add(current.id)
+
+    switch (current.kind) {
+      case 'app':
+        return predicate(current.opcode) || current.args.some(scan)
+      case 'lambda':
+        return scan(current.expr)
+      case 'let':
+        return scan(current.opdef.expr) || scan(current.expr)
+      case 'name': {
+        const unfolded = unfoldDefinition(current, table)
+        return unfolded.kind === 'name' ? false : scan(unfolded)
+      }
+      default:
+        return false
+    }
+  }
+
+  return scan(ex)
+}
+
+/**
+ * The shape a run has when it is read as a behavior: the states it visits, and, when a state
+ * repeats, where the cycle starts.
+ */
+export class RunShape {
+  /**
+   * The states of the run, up to but not including the repeated one.
+   */
+  readonly states: RuntimeValue[]
+
+  /**
+   * The position the behavior returns to after the last one, when the run cycles.
+   */
+  readonly loopStart: number | undefined
+
+  private constructor(states: RuntimeValue[], loopStart: number | undefined) {
+    this.states = states
+    this.loopStart = loopStart
+  }
+
+  /**
+   * Reads a run as a behavior, looking for the earliest state that repeats an earlier one. The
+   * repeated state is dropped, since the behavior returns to the earlier occurrence instead.
+   *
+   * @param states - the states of the run, in order
+   *
+   * @returns the shape of the run
+   */
+  static of(states: RuntimeValue[]): RunShape {
+    const visited = states.map(withoutMetadata)
+
+    for (let position = 0; position < visited.length; position++) {
+      for (let earlier = 0; earlier < position; earlier++) {
+        if (visited[earlier].equals(visited[position])) {
+          return new RunShape(states.slice(0, position), earlier)
+        }
+      }
+    }
+
+    return new RunShape(states, undefined)
+  }
+
+  /**
+   * Whether the run cycles, and therefore stands for a complete behavior.
+   */
+  get cycles(): boolean {
+    return this.loopStart !== undefined
+  }
+
+  /**
+   * The last position of the run.
+   */
+  get lastPosition(): number {
+    return this.states.length - 1
+  }
+
+  /**
+   * The positions the behavior visits from a position onwards. A cycling run comes back to the
+   * start of its cycle, so every position from there on is visited again.
+   *
+   * @param position - the position to start from
+   *
+   * @returns the positions visited from that position onwards
+   */
+  positionsFrom(position: number): number[] {
+    const first = this.loopStart === undefined ? position : Math.min(position, this.loopStart)
+    const positions = []
+    for (let p = first; p <= this.lastPosition; p++) {
+      positions.push(p)
+    }
+    return positions
+  }
+
+  /**
+   * The position that follows a position in the behavior, which for the last position of a cycling
+   * run is the start of the cycle, and which does not exist for the last position of a run that
+   * does not cycle.
+   *
+   * @param position - the position to take the successor of
+   *
+   * @returns the following position, if there is one
+   */
+  successorOf(position: number): number | undefined {
+    if (position < this.lastPosition) {
+      return position + 1
+    }
+    return this.loopStart
+  }
+}
+
+/**
+ * The variables of a state, without the metadata that records how the state was reached. Two states
+ * are the same state when their variables are the same, however they were arrived at.
+ *
+ * @param state - the state record
+ *
+ * @returns the variables of the state
+ */
+function withoutMetadata(state: RuntimeValue): OrderedMap<string, RuntimeValue> {
+  return state.toOrderedMap().filter((_value, key) => !metadataFields.includes(key))
+}
+
+function negate(verdict: Verdict): Verdict {
+  switch (verdict) {
+    case 'true':
+      return 'false'
+    case 'false':
+      return 'true'
+    default:
+      return 'unknown'
+  }
+}
+
+function conjoin(left_: Verdict, right_: Verdict): Verdict {
+  if (left_ === 'false' || right_ === 'false') {
+    return 'false'
+  }
+  return left_ === 'true' && right_ === 'true' ? 'true' : 'unknown'
+}
+
+function disjoin(left_: Verdict, right_: Verdict): Verdict {
+  if (left_ === 'true' || right_ === 'true') {
+    return 'true'
+  }
+  return left_ === 'false' && right_ === 'false' ? 'false' : 'unknown'
+}
+
+/**
+ * Decides a temporal property over a run.
+ *
+ * State predicates are handed back to the caller, which knows how to evaluate an expression at a
+ * position of the run. A predicate that reads the next state has no value at the last position of
+ * a run that does not cycle, since that position has no successor there.
+ */
+export class TemporalChecker {
+  private shape: RunShape
+  private table: LookupTable
+  private evaluateAt: (ex: QuintEx, position: number, successor: number | undefined) => Either<QuintError, boolean>
+
+  /**
+   * @param states - the states of the run, in order
+   * @param table - the lookup table
+   * @param evaluateAt - evaluates a state predicate at a position, given the position that follows it
+   */
+  constructor(
+    states: RuntimeValue[],
+    table: LookupTable,
+    evaluateAt: (ex: QuintEx, position: number, successor: number | undefined) => Either<QuintError, boolean>
+  ) {
+    this.shape = RunShape.of(states)
+    this.table = table
+    this.evaluateAt = evaluateAt
+  }
+
+  /**
+   * Decides the property over the run, from its first state.
+   *
+   * @param property - the property to decide
+   *
+   * @returns the verdict, or an error raised while evaluating a state predicate
+   */
+  check(property: QuintEx): Either<QuintError, Verdict> {
+    if (this.shape.states.length === 0) {
+      return right('unknown')
+    }
+    return this.verdictAt(property, 0)
+  }
+
+  private verdictAt(formula: QuintEx, position: number): Either<QuintError, Verdict> {
+    const ex = unfoldDefinition(formula, this.table)
+
+    if (ex.kind !== 'app' || !this.isTemporal(ex)) {
+      return this.statePredicateAt(ex, position)
+    }
+
+    switch (ex.opcode) {
+      case 'always':
+        return this.overPositions(position, p => this.verdictAt(ex.args[0], p), 'all')
+
+      case 'eventually':
+        return this.overPositions(position, p => this.verdictAt(ex.args[0], p), 'some')
+
+      case 'leadsTo':
+        // Whenever the cause holds, the effect has to hold then or later. A position where the cause
+        // does not hold says nothing, so the effect is not looked for there.
+        return this.overPositions(
+          position,
+          p =>
+            this.verdictAt(ex.args[0], p).chain(cause =>
+              cause === 'false'
+                ? right('true')
+                : this.overPositions(p, q => this.verdictAt(ex.args[1], q), 'some').map(effect =>
+                    disjoin(negate(cause), effect)
+                  )
+            ),
+          'all'
+        )
+
+      case 'not':
+        return this.verdictAt(ex.args[0], position).map(negate)
+
+      case 'and':
+        return this.foldOperands(ex.args, position, conjoin, 'true', 'false')
+
+      case 'or':
+        return this.foldOperands(ex.args, position, disjoin, 'false', 'true')
+
+      case 'implies': {
+        // As with the boolean operator, an antecedent that does not hold settles the implication and
+        // the consequent is not looked at
+        const antecedent = this.verdictAt(ex.args[0], position)
+        if (antecedent.isLeft()) {
+          return antecedent
+        }
+        if (antecedent.value === 'false') {
+          return right('true')
+        }
+        const settled = antecedent.value
+        return this.verdictAt(ex.args[1], position).map(consequent => disjoin(negate(settled), consequent))
+      }
+
+      case 'iff':
+        return this.verdictAt(ex.args[0], position).chain(l =>
+          this.verdictAt(ex.args[1], position).map(r =>
+            disjoin(conjoin(l, r), conjoin(negate(l), negate(r)))
+          )
+        )
+
+      default:
+        return this.statePredicateAt(ex, position)
+    }
+  }
+
+  /**
+   * A temporal formula is one that has a temporal operator in it. A connective only counts as part
+   * of the formula when one of its operands is temporal; otherwise it is an ordinary predicate and
+   * is evaluated in one go.
+   */
+  private isTemporal(ex: QuintEx): boolean {
+    if (ex.kind !== 'app') {
+      return false
+    }
+    if (temporalOperators.includes(ex.opcode)) {
+      return true
+    }
+    return connectives.includes(ex.opcode) && ex.args.some(arg => isTemporalFormula(arg, this.table))
+  }
+
+  /**
+   * Folds a connective over its operands, short-circuiting the way the boolean operators do: once an
+   * operand settles the connective, the ones after it are not looked at.
+   */
+  private foldOperands(
+    operands: QuintEx[],
+    position: number,
+    combine: (a: Verdict, b: Verdict) => Verdict,
+    unit: Verdict,
+    settles: Verdict
+  ): Either<QuintError, Verdict> {
+    let sofar: Verdict = unit
+    for (const operand of operands) {
+      if (sofar === settles) {
+        return right(sofar)
+      }
+      const next = this.verdictAt(operand, position)
+      if (next.isLeft()) {
+        return next
+      }
+      sofar = combine(sofar, next.value)
+    }
+    return right(sofar)
+  }
+
+  /**
+   * Folds a verdict over every position the behavior visits from a position onwards. A run that
+   * does not cycle can only refute: it never concludes that a property holds forever, or that one
+   * never comes to hold.
+   */
+  private overPositions(
+    position: number,
+    verdictOf: (p: number) => Either<QuintError, Verdict>,
+    quantifier: 'all' | 'some'
+  ): Either<QuintError, Verdict> {
+    const decisive: Verdict = quantifier === 'all' ? 'false' : 'true'
+    let sawOnlyOpposite = true
+
+    for (const p of this.shape.positionsFrom(position)) {
+      const verdict = verdictOf(p)
+      if (verdict.isLeft()) {
+        return verdict
+      }
+      if (verdict.value === decisive) {
+        return right(decisive)
+      }
+      sawOnlyOpposite = sawOnlyOpposite && verdict.value !== 'unknown'
+    }
+
+    if (this.shape.cycles && sawOnlyOpposite) {
+      return right(negate(decisive))
+    }
+    return right('unknown')
+  }
+
+  private statePredicateAt(ex: QuintEx, position: number): Either<QuintError, Verdict> {
+    const successor = this.shape.successorOf(position)
+    if (successor === undefined && readsNextState(ex, this.table)) {
+      // The last position of a run that does not cycle has no successor, so a predicate that reads
+      // the next state says nothing there.
+      return right('unknown')
+    }
+
+    return this.evaluateAt(ex, position, successor).map((value): Verdict => (value ? 'true' : 'false'))
+  }
+}
