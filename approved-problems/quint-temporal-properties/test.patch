+describe('mustChange', () => {
+  it('holds when the action changes the value', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('Climb.mustChange(Set(x))'), 'true')
+    assert.deepEqual(h.value('next(x)'), '1')
+  })
+
+  it('commits every assignment of a step it accepts, observed or not', () => {
+    const h = harness(twoVars).atInitialState()
