+describe('orKeep', () => {
+  it('takes the action when it is enabled', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('Climb.orKeep(Set(x))'), 'true')
+    assert.deepEqual(h.value('next(x)'), '1')
+  })
+
+  it('stutters when the action is not enabled', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('Fall.orKeep(Set(x))'), 'true')
+    assert.deepEqual(h.value('next(x)'), '0')
+  })
+
+  it('rolls back an assignment the action made before it failed', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 42, x > 100 }.orKeep(Set(x))`), 'true')
+    assert.deepEqual(h.value('next(x)'), '0')
+  })
+
+  it('drops an assignment the action made to a variable it does not keep', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`(y' = 9 and false).orKeep(Set(x))`), 'true')
+    assert.deepEqual(h.value('next(x)'), '0')
+    h.errorOf('next(y)')
+  })
+
+  it('stutters over a pending assignment and leaves the others where they were', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 5, y' = 9 }`), 'true')
+    assert.deepEqual(h.value(`(all { x > 100, x' = 1 }).orKeep(Set(x))`), 'true')
+    assert.deepEqual(h.value('next(x)'), '0')
+    assert.deepEqual(h.value('next(y)'), '9')
+  })
+
+  it('keeps every variable occurring in its second argument', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 1, y' = 1, false }.orKeep((x, y))`), 'true')
+    assert.deepEqual(h.value('next(x)'), '0')
+    assert.deepEqual(h.value('next(y)'), '0')
+  })
+
+  it('commits every assignment of an action it takes, observed or not', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`(all { x' = 7, y' = 8 }).orKeep(Set(x))`), 'true')
+    assert.deepEqual(h.value('next(x)'), '7')
+    assert.deepEqual(h.value('next(y)'), '8')
+  })
+
+  it('keeps every variable of an arbitrary observation expression', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 5, y' = 9 }`), 'true')
+    assert.deepEqual(h.value(`(all { x > 100, x' = 1 }).orKeep(x + y)`), 'true')
+    assert.deepEqual(h.value('next(x)'), '0')
+    assert.deepEqual(h.value('next(y)'), '0')
+  })
+
+  it('keeps nothing when nothing is observed', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`(all { x' = 1, y' = 1, false }).orKeep(())`), 'true')
+    h.errorOf('next(x)')
+  })
+
+  it('still takes the action when nothing is observed', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`(all { x' = 1, y' = 1 }).orKeep(())`), 'true')
+    assert.deepEqual(h.value('next(x)'), '1')
+  })
+
+  it('lets a run continue past a state where the action is not enabled', () => {
+    const h = harness(`
+      var x: int
+      action Init = x' = 0
+      action Climb = all { x < 2, x' = x + 1 }
+      action Next = Climb.orKeep(Set(x))
+    `)
+    assert.equal(h.status('eventually(x == 2)'), 'ok')
+  })
+})
