+describe('an action that raises an error while being tried', () => {
+  it('leaves the next state as it was when the probed action errors', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`x' = 5`), 'true')
+    h.errorOf(`enabled(all { x' = 77, 1 / 0 == 0 })`)
+    assert.deepEqual(h.value('next(x)'), '5')
+  })
+
+  it('leaves the next state as it was when the action under orKeep errors', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`x' = 5`), 'true')
+    h.errorOf(`(all { x' = 77, 1 / 0 == 0 }).orKeep(Set(x))`)
+    assert.deepEqual(h.value('next(x)'), '5')
+  })
+
+  it('leaves the next state as it was when the action under mustChange errors', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`x' = 5`), 'true')
+    h.errorOf(`(all { x' = 77, 1 / 0 == 0 }).mustChange(Set(x))`)
+    assert.deepEqual(h.value('next(x)'), '5')
+  })
+
+  it('records the step a probe sat in as if the probe had not happened', () => {
+    const run = (probe: string, expected: string | undefined, assignment: string, again: boolean): string => {
+      const h = harness(booming, true).atInitialState()
+      const attempt = () => {
+        if (expected === undefined) {
+          h.errorOf(probe)
+        } else {
+          assert.deepEqual(h.value(probe), expected)
+        }
+      }
+      attempt()
+      assert.deepEqual(h.value(assignment), 'true')
+      if (again) {
+        attempt()
+      }
+      return h.shiftAndRecord()
+    }
+
+    const cases: [string, string | undefined, string][] = [
+      ['enabled(Boom)', undefined, `x' = 5`],
+      ['Boom.orKeep(Set(x))', undefined, `x' = 5`],
+      ['Boom.mustChange(Set(x))', undefined, `x' = 5`],
+      ['Pick.mustChange(1 / 0)', undefined, `x' = 5`],
+      ['enabled(Pick)', 'true', `x' = 5`],
+      ['Same.mustChange(Set(x))', 'false', `x' = 5`],
+      ['Never.orKeep(Set(x))', 'true', `x' = x`],
+    ]
+
+    cases.forEach(([probe, expected, assignment]) => {
+      assert.equal(run(probe, expected, assignment, true), run(probe, expected, assignment, false), probe)
+    })
+  })
+
