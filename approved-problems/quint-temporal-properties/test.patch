+describe('enabled', () => {
+  it('is true when the action can be taken', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('enabled(Climb)'), 'true')
+  })
+
+  it('is false when a precondition does not hold', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('enabled(Fall)'), 'false')
+  })
+
+  it('does not assign anything of its own', () => {
+    const h = harness(`
+      var x: int
+      action Init = x' = 0
+      action Climb = all { x < 100, x' = x + 1 }
+      action Next = all { x' = x + 10, enabled(Climb) }
+    `)
+    assert.equal(h.status('always(next(x) == x + 10)', 3), 'ok')
+  })
+
+  it('drops what the action it tried assigned before failing', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 9, not(enabled(all { x' = 77, x > 100 })), next(x) == 9 }`), 'true')
+  })
+
+  it('does not disturb an assignment made before it', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 9, enabled(Climb), next(x) == 9 }`), 'true')
+  })
+
+  it('is true when some branch of a choice is enabled', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('enabled(any { Climb, Fall })'), 'true')
+  })
+
+  it('is false when no branch of a choice is enabled', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value('enabled(any { all { x > 5, x\' = 1 }, Fall })'), 'false')
+  })
+
+  it('is true for an action that picks from a set, and keeps the pick out of the state', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`x' = 5`), 'true')
+    assert.deepEqual(h.value(`enabled(nondet i = Set(1, 2).oneOf() { x' = i })`), 'true')
+    assert.deepEqual(h.value('next(x)'), '5')
+    h.errorOf('next(y)')
+  })
+
+  it('is false for an action that picks from an empty set', () => {
+    const h = harness(guarded).atInitialState()
+    assert.deepEqual(h.value(`enabled(nondet i = Set().oneOf() { x' = i })`), 'false')
+  })
+
+  it('describes when an action is available, over a whole run', () => {
+    assert.equal(harness(guarded).status('always(enabled(Climb) iff x < 2)'), 'ok')
+    assert.equal(harness(guarded).status('always(enabled(Fall))'), 'violation')
+  })
+
+  it('never holds for an action that can never be taken', () => {
+    assert.equal(harness(guarded).status(`always(not(enabled(all { x < 0, x' = x })))`), 'ok')
+  })
+})
