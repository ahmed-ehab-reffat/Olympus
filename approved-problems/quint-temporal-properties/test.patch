+import { describe, it } from 'mocha'
+import { assert } from 'chai'
+import { newIdGenerator } from '../../src/idGenerator'
+import { newRng } from '../../src/rng'
+import { fileSourceResolver } from '../../src/parsing/sourceResolver'
+import { QuintEx, parseExpressionOrDeclaration, walkExpression } from '../../src'
+import { parse } from '../../src/parsing/quintParserFrontend'
+import { newTraceRecorder } from '../../src/runtime/trace'
+import { Evaluator } from '../../src/runtime/impl/evaluator'
+import { expressionToString } from '../../src/ir/IRprinting'
+import { QuintError } from '../../src/quintError'
+import { Outcome } from '../../src/simulation'
+
+const idGen = newIdGenerator()
+
+class Harness {
+  readonly evaluator: Evaluator
+  private exprCache: Map<string, QuintEx> = new Map()
+  private build: (text: string) => QuintEx
+
+  constructor(defs: string, storeMetadata: boolean) {
+    const lookupPath = fileSourceResolver(new Map()).lookupPath('/', './mock')
+    const { resolver, sourceMap, errors } = parse(idGen, '<test>', lookupPath, `module m { ${defs} }`)
+    assert.isEmpty(errors, 'the fixture must parse without errors')
+
+    this.build = (text: string): QuintEx => {
+      const parsed = parseExpressionOrDeclaration(text, '<input>', idGen, sourceMap)
+      if (parsed.kind !== 'expr') {
+        assert.fail(`expected an expression, found ${parsed.kind}`)
+      }
+      walkExpression(resolver, parsed.expr)
+      assert.isEmpty(resolver.errors, `the expression ${text} must resolve`)
+      return parsed.expr
+    }
+
+    const rng = newRng(0n)
+    this.evaluator = new Evaluator(resolver.table, newTraceRecorder(0, rng), rng, storeMetadata)
+  }
+
+  expr(text: string): QuintEx {
+    const cached = this.exprCache.get(text)
+    if (cached !== undefined) {
+      return cached
+    }
+    const built = this.build(text)
+    this.exprCache.set(text, built)
+    return built
+  }
+
+  atInitialState(): Harness {
+    assert.isTrue(this.evaluator.evaluate(this.expr('Init')).isRight(), 'Init must evaluate')
+    this.evaluator.shift()
+    return this
+  }
+
+  value(text: string): string {
+    const result = this.evaluator.evaluate(this.expr(text))
+    if (result.isLeft()) {
+      assert.fail(`evaluating ${text} failed with ${result.value.code}: ${result.value.message}`)
+    }
+    return expressionToString(result.value)
+  }
+
+  errorOf(text: string): QuintError {
+    const result = this.evaluator.evaluate(this.expr(text))
+    if (result.isRight()) {
+      assert.fail(`expected an error, found ${expressionToString(result.value)}`)
+    }
+    return result.value
+  }
+
+  run(property: string, steps: number = 10, runs: number = 1): Outcome {
+    return this.evaluator.simulate(this.expr('Init'), this.expr('Next'), this.expr(property), [], runs, steps, 1)
+  }
+
+  status(property: string, steps: number = 10, runs: number = 1): string {
+    return this.run(property, steps, runs).status
+  }
+
+  shiftAndRecord(): string {
+    this.evaluator.shift()
+    const states = this.evaluator.trace.get()
+    return expressionToString(states[states.length - 1].toQuintEx(idGen))
+  }
+
+}
+
+function harness(defs: string, storeMetadata: boolean = false): Harness {
+  return new Harness(defs, storeMetadata)
+}
+
+const counter = `
+  var x: int
+  action Init = x' = 0
+  action Next = x' = (x + 1) % 3
+`
+
+const guarded = `
+  var x: int
+  action Init = x' = 0
+  action Climb = all { x < 2, x' = x + 1 }
+  action Fall = all { x == 2, x' = 0 }
+  action Next = any { Climb, Fall }
+`
+
+const twoVars = `
+  var x: int
+  var y: int
+  action Init = all { x' = 0, y' = 0 }
+  action Next = all { x' = (x + 1) % 2, y' = y }
+`
+
+const stem = `
+  var x: int
+  action Init = x' = 0
+  action Next = x' = if (x == 1) 2 else 1
+`
+
+const branching = `
+  var x: int
+  action Init = x' = 0
+  action Next = any { x' = 1, x' = 2 }
+`
+
+const climbing = `
+  var x: int
+  action Init = x' = 0
+  action Next = x' = x + 1
+`
+
+const wideCycle = `
+  var x: int
+  action Init = x' = 0
+  action Next = x' = (x + 1) % 4
+`
+
+const stutter = `
+  var x: int
+  action Init = x' = 0
+  action Next = x' = x
+`
+
+const probing = `
+  var x: int
+  action Init = x' = 0
+  action Probe = nondet i = Set(1, 2).oneOf() { all { i > 5, x' = i } }
+  action Next = all { not(enabled(Probe)), x' = (x + 1) % 3 }
+`
+
+const derived = `
+  var x: int
+  var y: int
+  val total = x + y
+  action Init = all { x' = 1, y' = 1 }
+  action Next = all { x' = x, y' = y }
+`
+
+const deadlocking = `
+  var x: int
+  action Init = x' = 0
+  action Next = all { x < 2, x' = x + 1 }
+`
+
+const booming = `
+  var x: int
+  action Boom = nondet i = Set(1, 2).oneOf() { all { x' = i, 1 / 0 == 0 } }
+  action Pick = nondet i = Set(1, 2).oneOf() { x' = i }
+  action Never = nondet i = Set(1, 2).oneOf() { all { i > 5, x' = i } }
+  action Same = nondet i = Set(1, 2).oneOf() { all { i > 0, x' = x } }
+  action Init = x' = 0
+  action Next = x' = x + 1
+`
+
+const structured = `
+  var s: Set[int]
+  var r: { tag: str, size: int }
+  action Init = all { s' = Set(1, 2), r' = { tag: "a", size: 1 } }
+  action Next = all {
+    s' = if (s == Set(1, 2)) Set(2, 3) else Set(1, 2),
+    r' = if (r.tag == "a") { tag: "b", size: 2 } else { tag: "a", size: 1 },
+  }
+`
+
+describe('next over a transition', () => {
+  it('reads the value a variable was just given', () => {
+    const h = harness(counter).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 7, next(x) == 7 }`), 'true')
+  })
+
+  it('is false when the next value differs from the one compared against', () => {
+    const h = harness(counter).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 7, next(x) == 8 }`), 'false')
+  })
+
+  it('reads the next state of several variables', () => {
+    const h = harness(twoVars).atInitialState()
+    assert.deepEqual(h.value(`all { x' = 3, y' = 4, next(x) + next(y) == 7 }`), 'true')
+  })
+
+  it('reads the next state through a definition that is also read in the current state', () => {
+    const h = harness(`
+      var x: int
+      var y: int
+      val total = x + y
+      action Init = all { x' = 1, y' = 1 }
+      action Next = all { x' = x + 1, y' = y + 1 }
+    `).atInitialState()
+    assert.deepEqual(h.value('total'), '2')
+    assert.deepEqual(h.value(`all { x' = 5, y' = 5, next(total) == 10 }`), 'true')
+    assert.deepEqual(h.value('total'), '2')
+  })
+
+  it('holds over every transition of a run', () => {
+    assert.equal(harness(counter).status('always(next(x) != x)'), 'ok')
+  })
+
+  it('is looked up from the position it is read at, under eventually', () => {
+    assert.equal(harness(counter).status('eventually(next(x) == 0)'), 'ok')
+    assert.equal(harness(counter).status('eventually(next(x) == 7)'), 'violation')
+  })
+
+  it('is looked up from the position it is read at, under leadsTo', () => {
+    assert.equal(harness(counter).status('(x == 2).leadsTo(next(x) == 0)'), 'ok')
+    assert.equal(harness(counter).status('(x == 2).leadsTo(next(x) == 7)'), 'violation')
+  })
+
+  it('reports a transition that does not match', () => {
+    assert.equal(harness(counter).status('always(next(x) == x + 1)'), 'violation')
+  })
+
+  it('has no value when the transition has not given the variable one', () => {
+    assert.deepEqual(harness(counter).atInitialState().value(`all { x' = 4, next(x) == 4 }`), 'true')
+    harness(counter).atInitialState().errorOf('next(x)')
+  })
+
+  it('says nothing at a position that has no successor', () => {
+    const h = harness(`
+      var x: int
+      action Init = x' = 0
+      action Next = x' = x + 1
+    `)
+    assert.equal(h.status('always(next(x) > x)', 3), 'ok')
+  })
+})
