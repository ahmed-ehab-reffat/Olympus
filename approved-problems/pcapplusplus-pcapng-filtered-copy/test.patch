+#!/usr/bin/env python3
+
+import argparse
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("log")
+    parser.add_argument("output")
+    parser.add_argument("status", type=int)
+    parser.add_argument("--expected-test", action="append", default=[])
+    args = parser.parse_args()
+
+    with open(args.log, encoding="utf-8", errors="replace") as handle:
+        log = handle.read()
+
+    pattern = re.compile(r"^(Test[A-Za-z0-9_]+)\s*:\s*(PASSED|FAILED|SKIPPED)\s*$", re.MULTILINE)
+    results = pattern.findall(log)
+    suite = ET.Element("testsuite", name="Pcap++Test")
+
+    failures = 0
+    skipped = 0
+    for name, result in results:
+        case = ET.SubElement(suite, "testcase", classname="Pcap++Test", name=name)
+        if result == "FAILED":
+            failures += 1
+            failure = ET.SubElement(case, "failure", message="test failed")
+            failure.text = log
+        elif result == "SKIPPED":
+            skipped += 1
+            ET.SubElement(case, "skipped")
+
+    if not results:
+        expected_tests = args.expected_test or ["Harness"]
+        for name in expected_tests:
+            failures += 1
+            case = ET.SubElement(suite, "testcase", classname=name, name=name)
+            failure = ET.SubElement(case, "failure", message="test command failed")
+            failure.text = log
+    elif args.status != 0 and failures == 0:
+        failures += 1
+        case = ET.SubElement(suite, "testcase", classname="Pcap++Test", name="Harness")
+        failure = ET.SubElement(case, "failure", message="test command failed")
+        failure.text = log
+
+    suite.set("tests", str(len(suite.findall("testcase"))))
+    suite.set("failures", str(failures))
+    suite.set("errors", "0")
+    suite.set("skipped", str(skipped))
+    tree = ET.ElementTree(suite)
+    tree.write(args.output, encoding="utf-8", xml_declaration=True)
+    return 0 if args.status == 0 and failures == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
