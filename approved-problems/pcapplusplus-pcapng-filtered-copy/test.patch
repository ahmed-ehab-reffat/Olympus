+int main(int argc, char* argv[])
+{
+	if (argc != 2)
+	{
+		std::cerr << "usage: PcapNgCopyTest SCENARIO\n";
+		return 2;
+	}
+
+	try
+	{
+		const std::string scenario = argv[1];
+		if (scenario == "StructureAndFiltering")
+			testStructureAndFiltering();
+		else if (scenario == "InPlaceReplacement")
+			testInPlaceReplacement();
+		else if (scenario == "InterfaceSelection")
+			testInterfaceSelection();
+		else if (scenario == "OptionPreservation")
+			testOptionPreservation();
+		else if (scenario == "DiscardedPacketOptions")
+			testDiscardedPacketOptions();
+		else if (scenario == "OptionTermination")
+			testOptionTermination();
+		else if (scenario == "FilterState")
+			testFilterState();
+		else if (scenario == "DefaultAndClearedFilter")
+			testDefaultAndClearedFilter();
+		else if (scenario == "ReservedFieldOpacity")
+			testReservedFieldOpacity();
+		else if (scenario == "LocalUseOpacity")
+			testLocalUseOpacity();
+		else if (scenario == "ReaderLifecycle")
+			testReaderLifecycle();
+		else if (scenario == "NoMatchingPackets")
+			testNoMatchingPackets();
+		else if (scenario == "MalformedFraming")
+			testMalformedFraming();
+		else if (scenario == "MalformedOptions")
+			testMalformedOptions();
+		else if (scenario == "MalformedReferences")
+			testMalformedReferences();
+		else if (scenario == "UnsupportedAndIo")
+			testUnsupportedAndIo();
+		else
+			throw std::runtime_error("unknown scenario: " + scenario);
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::cerr << error.what() << '\n';
+		return 1;
+	}
+}
