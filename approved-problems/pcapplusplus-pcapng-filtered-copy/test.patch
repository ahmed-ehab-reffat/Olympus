+	struct ScanStats
+	{
+		size_t sections = 0;
+		size_t interfaces = 0;
+		size_t packets = 0;
+		size_t statistics = 0;
+		size_t names = 0;
+		size_t secrets = 0;
+		size_t copyableCustom = 0;
+		size_t doNotCopyCustom = 0;
+		size_t unknown = 0;
+	};
+
+	ScanStats scan(const Bytes& bytes)
+	{
+		ScanStats stats;
+		ByteOrder order = ByteOrder::Little;
+		size_t offset = 0;
+		size_t interfacesInSection = 0;
+		size_t finiteEnd = 0;
+		bool finite = false;
+		bool haveSection = false;
+		while (offset < bytes.size())
+		{
+			require(bytes.size() - offset >= 12, "scanner found truncated block");
+			const uint8_t* block = bytes.data() + offset;
+			const bool section = block[0] == 0x0a && block[1] == 0x0d && block[2] == 0x0d && block[3] == 0x0a;
+			if (section)
+			{
+				if (finite)
+					require(offset == finiteEnd, "finite section does not end at next SHB");
+				require(bytes.size() - offset >= 28, "short SHB");
+				if (block[8] == 0x4d && block[9] == 0x3c && block[10] == 0x2b && block[11] == 0x1a)
+					order = ByteOrder::Little;
+				else if (block[8] == 0x1a && block[9] == 0x2b && block[10] == 0x3c && block[11] == 0x4d)
+					order = ByteOrder::Big;
+				else
+					throw std::runtime_error("invalid scanner byte-order magic");
+				haveSection = true;
+				interfacesInSection = 0;
+				stats.sections++;
+			}
+			require(haveSection, "block before SHB");
+			const uint32_t type = read32(block, order);
+			const uint32_t length = read32(block + 4, order);
+			require(length >= 12 && length % 4 == 0 && length <= bytes.size() - offset, "invalid block length");
+			require(read32(block + length - 4, order) == length, "mismatched trailing block length");
+
+			if (type == SectionHeader)
+			{
+				require(section && read16(block + 12, order) == 1, "invalid section header");
+				const uint64_t declared = read64(block + 16, order);
+				finite = declared != UINT64_MAX;
+				if (finite)
+					finiteEnd = offset + length + static_cast<size_t>(declared);
+			}
+			else if (type == InterfaceDescription)
+			{
+				interfacesInSection++;
+				stats.interfaces++;
+			}
+			else if (type == EnhancedPacket)
+			{
+				require(length >= 32 && read32(block + 8, order) < interfacesInSection, "invalid EPB interface");
+				stats.packets++;
+			}
+			else if (type == SimplePacket)
+			{
+				require(interfacesInSection > 0, "SPB has no local IDB 0");
+				stats.packets++;
+			}
+			else if (type == InterfaceStatistics)
+			{
+				require(length >= 24 && read32(block + 8, order) < interfacesInSection, "invalid ISB interface");
+				stats.statistics++;
+			}
+			else if (type == NameResolution)
+				stats.names++;
+			else if (type == DecryptionSecrets)
+				stats.secrets++;
+			else if (type == CopyableCustom)
+				stats.copyableCustom++;
+			else if (type == DoNotCopyCustom)
+				stats.doNotCopyCustom++;
+			else if (type == UnknownBlock)
+				stats.unknown++;
+			offset += length;
+		}
+		if (finite)
+			require(offset == finiteEnd, "finite final section has wrong end");
+		return stats;
+	}
+
+	void verifyComplex(const Bytes& actual, const Bytes& expected, size_t packets)
+	{
+		require(actual == expected, "filtered output differs from expected retained bytes");
+		const auto stats = scan(actual);
+		require(stats.sections == 2 && stats.interfaces == 2, "section/interface count mismatch");
+		require(stats.packets == packets, "packet count mismatch");
+		require(stats.statistics == 2 && stats.names == 2 && stats.secrets == 2, "metadata block count mismatch");
+		require(stats.copyableCustom == 2 && stats.doNotCopyCustom == 0, "Custom Block copy policy mismatch");
+		require(stats.unknown == 2, "unknown block count mismatch");
+	}
+
+	bool copyTcp(const std::string& input, const std::string& output)
+	{
+		pcpp::PcapNgFileReaderDevice reader(input);
+		require(reader.setFilter("tcp"), "cannot configure TCP filter");
+		return reader.copyFiltered(output);
+	}
+
+	size_t findBlock(const Bytes& bytes, uint32_t wanted, size_t occurrence)
+	{
+		ByteOrder order = ByteOrder::Little;
+		size_t offset = 0;
+		while (offset < bytes.size())
+		{
+			const uint8_t* block = bytes.data() + offset;
+			const bool section = block[0] == 0x0a && block[1] == 0x0d && block[2] == 0x0d && block[3] == 0x0a;
+			if (section)
+			{
+				if (block[8] == 0x4d)
+					order = ByteOrder::Little;
+				else
+					order = ByteOrder::Big;
+			}
+			const uint32_t type = read32(block, order);
+			const uint32_t length = read32(block + 4, order);
+			if (type == wanted)
+			{
+				if (occurrence == 0)
+					return offset;
+				occurrence--;
+			}
+			offset += length;
+		}
+		throw std::runtime_error("block type not found");
+	}
+
+	void expectReject(const Bytes& inputBytes, const std::string& suffix)
+	{
+		Files files;
+		const auto input = files.add(suffix + "-input.pcapng");
+		const auto output = files.add(suffix + "-output.pcapng");
+		const Bytes sentinel{ 0x73, 0x61, 0x66, 0x65 };
+		writeFile(input, inputBytes);
+		writeFile(output, sentinel);
+		require(!copyTcp(input, output), "invalid input was accepted: " + suffix);
+		require(readFile(output) == sentinel, "destination changed after invalid input: " + suffix);
+	}
