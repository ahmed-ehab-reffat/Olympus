+#!/usr/bin/env bash
+
+set -u
+
+output_path=""
+mode=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      output_path="$2"
+      shift 2
+      ;;
+    base|new)
+      mode="$1"
+      shift
+      ;;
+    *)
+      echo "usage: $0 --output_path FILE {base|new}" >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [[ -z "$output_path" || -z "$mode" ]]; then
+  echo "usage: $0 --output_path FILE {base|new}" >&2
+  exit 2
+fi
+
+output_path="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$output_path")"
+build_dir="build-pcapng-copy-tests"
+configure_log="$build_dir/configure.log"
+mkdir -p "$build_dir"
+
+new_test_args=()
+if [[ "$mode" == "new" ]]; then
+  new_test_args=(
+    --expected-test PcapNgCopy.StructureAndFiltering
+    --expected-test PcapNgCopy.InPlaceReplacement
+    --expected-test PcapNgCopy.InterfaceSelection
+    --expected-test PcapNgCopy.OptionPreservation
+    --expected-test PcapNgCopy.DiscardedPacketOptions
+    --expected-test PcapNgCopy.OptionTermination
+    --expected-test PcapNgCopy.FilterState
+    --expected-test PcapNgCopy.DefaultAndClearedFilter
+    --expected-test PcapNgCopy.ReservedFieldOpacity
+    --expected-test PcapNgCopy.LocalUseOpacity
+    --expected-test PcapNgCopy.ReaderLifecycle
+    --expected-test PcapNgCopy.NoMatchingPackets
+    --expected-test PcapNgCopy.MalformedFraming
+    --expected-test PcapNgCopy.MalformedOptions
+    --expected-test PcapNgCopy.MalformedReferences
+    --expected-test PcapNgCopy.UnsupportedAndIo
+  )
+fi
+
+cmake -S . -B "$build_dir" \
+  -DCMAKE_BUILD_TYPE=Debug \
+  -DPCAPPP_BUILD_TESTS=ON \
+  -DPCAPPP_BUILD_EXAMPLES=OFF \
+  -DPCAPPP_BUILD_TUTORIALS=OFF >"$configure_log" 2>&1
+configure_status=$?
+if [[ $configure_status -ne 0 ]]; then
+  python3 Tests/PcapNgCopyTest/ptf_to_junit.py \
+    "$configure_log" "$output_path" "$configure_status" "${new_test_args[@]}"
+  exit $?
+fi
+
+if [[ "$mode" == "base" ]]; then
+  build_log="$build_dir/base-build.log"
+  cmake --build "$build_dir" --target Pcap++Test --parallel >"$build_log" 2>&1
+  build_status=$?
+  if [[ $build_status -ne 0 ]]; then
+    python3 Tests/PcapNgCopyTest/ptf_to_junit.py "$build_log" "$output_path" "$build_status"
+    exit $?
+  fi
+
+  test_log="$build_dir/base-test.log"
+  (
+    cd "$build_dir/Tests/Pcap++Test"
+    ./Pcap++Test -n -s -x live_device
+  ) >"$test_log" 2>&1
+  test_status=$?
+  python3 Tests/PcapNgCopyTest/ptf_to_junit.py "$test_log" "$output_path" "$test_status"
+  exit $?
+fi
+
+build_log="$build_dir/new-build.log"
+cmake --build "$build_dir" --target PcapNgCopyTest --parallel >"$build_log" 2>&1
+build_status=$?
+if [[ $build_status -ne 0 ]]; then
+  python3 Tests/PcapNgCopyTest/ptf_to_junit.py \
+    "$build_log" "$output_path" "$build_status" "${new_test_args[@]}"
+  exit $?
+fi
+
+ctest --test-dir "$build_dir" \
+  --output-on-failure \
+  --output-junit "$output_path" \
+  -R '^PcapNgCopy\.'
