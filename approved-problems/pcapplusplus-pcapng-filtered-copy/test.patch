+	void writeFile(const std::string& path, const Bytes& bytes)
+	{
+		std::ofstream output(path, std::ios::binary | std::ios::trunc);
+		require(static_cast<bool>(output), "cannot open output fixture: " + path);
+		output.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+		require(static_cast<bool>(output), "cannot write fixture: " + path);
+	}
+
+	Bytes readFile(const std::string& path)
+	{
+		std::ifstream input(path, std::ios::binary);
+		require(static_cast<bool>(input), "cannot open input fixture: " + path);
+		return Bytes(std::istreambuf_iterator<char>(input), std::istreambuf_iterator<char>());
+	}
