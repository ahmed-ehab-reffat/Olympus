+
+		auto byteOrder = makeComplexCapture(false, false);
+		std::fill(byteOrder.begin() + 8, byteOrder.begin() + 12, 0);
+		expectReject(byteOrder, "bad-byte-order");
+
+		auto finite = makeComplexCapture(false, false);
+		set64(finite, 16, finite.size() + 100, ByteOrder::Little);
+		expectReject(finite, "bad-finite-length");
+
+		auto version = makeComplexCapture(false, false);
+		set16(version, 12, 2, ByteOrder::Little);
