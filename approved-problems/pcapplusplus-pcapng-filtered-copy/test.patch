+
+		auto nameRecord = makeOptionCapture();
+		const auto nameOffset = findBlock(nameRecord, NameResolution, 0);
+		set16(nameRecord, nameOffset + 10, 0xfffc, ByteOrder::Little);
+		expectReject(nameRecord, "bad-name-record-length");
+
+		auto nameOption = makeOptionCapture();
+		const auto nameOptionOffset = findBlock(nameOption, NameResolution, 0);
+		const size_t nameRecordLength = read16(nameOption.data() + nameOptionOffset + 10, ByteOrder::Little);
+		const size_t nameOptions = nameOptionOffset + 16 + ((nameRecordLength + 3) & ~size_t(3));
+		set16(nameOption, nameOptions + 2, 0xfffc, ByteOrder::Little);
+		expectReject(nameOption, "bad-name-option-length");
+
+		auto secretsOption = makeOptionCapture();
+		const auto secretsOffset = findBlock(secretsOption, DecryptionSecrets, 0);
+		const size_t secretsLength = read32(secretsOption.data() + secretsOffset + 12, ByteOrder::Little);
+		const size_t secretsOptions = secretsOffset + 16 + ((secretsLength + 3) & ~size_t(3));
+		set16(secretsOption, secretsOptions + 2, 0xfffc, ByteOrder::Little);
+		expectReject(secretsOption, "bad-secrets-option-length");
+	}
