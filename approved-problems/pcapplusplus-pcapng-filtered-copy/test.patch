+		const size_t packetDataLength = read32(packetOption.data() + packetOffset + 20, ByteOrder::Little);
+		const size_t packetOptions = packetOffset + 28 + ((packetDataLength + 3) & ~size_t(3));
+		set16(packetOption, packetOptions + 2, 0xfffc, ByteOrder::Little);
+		expectReject(packetOption, "bad-packet-option-length");
+
+		auto statisticsOption = makeOptionCapture();
