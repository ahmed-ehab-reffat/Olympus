@@ -0,0 +1,1118 @@
+#include "PcapFileDevice.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdint>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace
+{
+	enum class ByteOrder
+	{
+		Little,
+		Big
+	};
+
+	using Bytes = std::vector<uint8_t>;
+
+	constexpr uint32_t SectionHeader = 0x0a0d0d0a;
+	constexpr uint32_t InterfaceDescription = 1;
+	constexpr uint32_t ObsoletePacket = 2;
+	constexpr uint32_t SimplePacket = 3;
+	constexpr uint32_t NameResolution = 4;
+	constexpr uint32_t InterfaceStatistics = 5;
+	constexpr uint32_t EnhancedPacket = 6;
+	constexpr uint32_t DecryptionSecrets = 10;
+	constexpr uint32_t CopyableCustom = 0x00000bad;
+	constexpr uint32_t DoNotCopyCustom = 0x40000bad;
+	constexpr uint32_t LocalUseBlock = 0x80000001;
+	constexpr uint32_t UnknownBlock = 0x8000beef;
+	constexpr uint16_t CopyableCustomOption = 2989;
+	constexpr uint16_t DoNotCopyCustomOption = 19373;
+
+	void require(bool condition, const std::string& message)
+	{
+		if (!condition)
+			throw std::runtime_error(message);
+	}
+
+	void append16(Bytes& bytes, uint16_t value, ByteOrder order)
+	{
+		if (order == ByteOrder::Little)
+		{
+			bytes.push_back(static_cast<uint8_t>(value));
+			bytes.push_back(static_cast<uint8_t>(value >> 8));
+		}
+		else
+		{
+			bytes.push_back(static_cast<uint8_t>(value >> 8));
+			bytes.push_back(static_cast<uint8_t>(value));
+		}
+	}
+
+	void append32(Bytes& bytes, uint32_t value, ByteOrder order)
+	{
+		if (order == ByteOrder::Little)
+		{
+			for (unsigned shift = 0; shift < 32; shift += 8)
+				bytes.push_back(static_cast<uint8_t>(value >> shift));
+		}
+		else
+		{
+			for (int shift = 24; shift >= 0; shift -= 8)
+				bytes.push_back(static_cast<uint8_t>(value >> shift));
+		}
+	}
+
+	void append64(Bytes& bytes, uint64_t value, ByteOrder order)
+	{
+		if (order == ByteOrder::Little)
+		{
+			for (unsigned shift = 0; shift < 64; shift += 8)
+				bytes.push_back(static_cast<uint8_t>(value >> shift));
+		}
+		else
+		{
+			for (int shift = 56; shift >= 0; shift -= 8)
+				bytes.push_back(static_cast<uint8_t>(value >> shift));
+		}
+	}
+
+	uint16_t read16(const uint8_t* data, ByteOrder order)
+	{
+		if (order == ByteOrder::Little)
+			return static_cast<uint16_t>(data[0] | (data[1] << 8));
+		return static_cast<uint16_t>((data[0] << 8) | data[1]);
+	}
+
+	uint32_t read32(const uint8_t* data, ByteOrder order)
+	{
+		uint32_t value = 0;
+		if (order == ByteOrder::Little)
+		{
+			for (int index = 3; index >= 0; --index)
+				value = (value << 8) | data[index];
+		}
+		else
+		{
+			for (int index = 0; index < 4; ++index)
+				value = (value << 8) | data[index];
+		}
+		return value;
+	}
+
+	uint64_t read64(const uint8_t* data, ByteOrder order)
+	{
+		uint64_t value = 0;
+		if (order == ByteOrder::Little)
+		{
+			for (int index = 7; index >= 0; --index)
+				value = (value << 8) | data[index];
+		}
+		else
+		{
+			for (int index = 0; index < 8; ++index)
+				value = (value << 8) | data[index];
+		}
+		return value;
+	}
+
+	void set16(Bytes& bytes, size_t offset, uint16_t value, ByteOrder order)
+	{
+		Bytes encoded;
+		append16(encoded, value, order);
+		std::copy(encoded.begin(), encoded.end(), bytes.begin() + static_cast<std::ptrdiff_t>(offset));
+	}
+
+	void set32(Bytes& bytes, size_t offset, uint32_t value, ByteOrder order)
+	{
+		Bytes encoded;
+		append32(encoded, value, order);
+		std::copy(encoded.begin(), encoded.end(), bytes.begin() + static_cast<std::ptrdiff_t>(offset));
+	}
+
+	void set64(Bytes& bytes, size_t offset, uint64_t value, ByteOrder order)
+	{
+		Bytes encoded;
+		append64(encoded, value, order);
+		std::copy(encoded.begin(), encoded.end(), bytes.begin() + static_cast<std::ptrdiff_t>(offset));
+	}
+
+	void appendPadded(Bytes& bytes, const Bytes& value)
+	{
+		bytes.insert(bytes.end(), value.begin(), value.end());
+		while (bytes.size() % 4 != 0)
+			bytes.push_back(0);
+	}
+
+	Bytes text(const std::string& value)
+	{
+		return Bytes(value.begin(), value.end());
+	}
+
+	void appendOption(Bytes& body, ByteOrder order, uint16_t code, const Bytes& value)
+	{
+		append16(body, code, order);
+		append16(body, static_cast<uint16_t>(value.size()), order);
+		appendPadded(body, value);
+	}
+
+	void finishOptions(Bytes& body, ByteOrder order)
+	{
+		append16(body, 0, order);
+		append16(body, 0, order);
+	}
+
+	void appendStandardCustomOptions(Bytes& body, ByteOrder order, uint8_t marker)
+	{
+		Bytes copyable;
+		append32(copyable, 32473, order);
+		copyable.insert(copyable.end(), { marker, 0xc0, 0x50, 0x59 });
+		appendOption(body, order, CopyableCustomOption, copyable);
+
+		Bytes doNotCopy;
+		append32(doNotCopy, 32473, order);
+		doNotCopy.insert(doNotCopy.end(), { marker, 0x4e, 0x43, 0x50 });
+		appendOption(body, order, DoNotCopyCustomOption, doNotCopy);
+	}
+
+	Bytes makeBlock(ByteOrder order, uint32_t type, const Bytes& body)
+	{
+		Bytes result;
+		const uint32_t length = static_cast<uint32_t>(body.size() + 12);
+		append32(result, type, order);
+		append32(result, length, order);
+		result.insert(result.end(), body.begin(), body.end());
+		append32(result, length, order);
+		return result;
+	}
+
+	Bytes withoutEndOption(Bytes block, ByteOrder order)
+	{
+		require(block.size() >= 16, "option block is too short");
+		require(read32(block.data() + block.size() - 8, order) == 0, "option block has no final end marker");
+		block.erase(block.end() - 8, block.end() - 4);
+		const auto blockLength = static_cast<uint32_t>(block.size());
+		set32(block, 4, blockLength, order);
+		set32(block, block.size() - 4, blockLength, order);
+		return block;
+	}
+
+	Bytes makeSectionHeader(ByteOrder order, uint64_t sectionLength, const std::string& comment)
+	{
+		Bytes body;
+		append32(body, 0x1a2b3c4d, order);
+		append16(body, 1, order);
+		append16(body, 0, order);
+		append64(body, sectionLength, order);
+		appendOption(body, order, 1, text(comment));
+		finishOptions(body, order);
+		return makeBlock(order, SectionHeader, body);
+	}
+
+	Bytes makeInterface(ByteOrder order, uint16_t linkType, uint32_t snapLength, uint8_t resolution,
+	                    const std::string& name, bool customOptions = false)
+	{
+		Bytes body;
+		append16(body, linkType, order);
+		append16(body, 0, order);
+		append32(body, snapLength, order);
+		appendOption(body, order, 2, text(name));
+		appendOption(body, order, 3, text("description-" + name));
+		appendOption(body, order, 9, Bytes{ resolution });
+		Bytes offset;
+		append64(offset, 7, order);
+		appendOption(body, order, 14, offset);
+		appendOption(body, order, 0x1234, Bytes{ 0xde, 0xad, 0xbe });
+		if (customOptions)
+			appendStandardCustomOptions(body, order, static_cast<uint8_t>(name.size()));
+		finishOptions(body, order);
+		return makeBlock(order, InterfaceDescription, body);
+	}
+
+	Bytes makeIpv4Packet(bool ethernet, uint8_t protocol, uint8_t marker)
+	{
+		Bytes packet;
+		if (ethernet)
+		{
+			packet.insert(packet.end(),
+			              { 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0x08, 0x00 });
+		}
+		else
+		{
+			packet.insert(packet.end(), { 0x00, 0x00, 0x00, 0x01, 0x00, 0x06, 0x66, 0x77, 0x88, 0x99, 0xaa, 0xbb, 0x00,
+			                              0x00, 0x08, 0x00 });
+		}
+
+		const uint16_t transportLength = protocol == 6 ? 20 : 8;
+		const uint16_t totalLength = static_cast<uint16_t>(20 + transportLength);
+		packet.insert(packet.end(), { 0x45, marker });
+		packet.push_back(static_cast<uint8_t>(totalLength >> 8));
+		packet.push_back(static_cast<uint8_t>(totalLength));
+		packet.insert(packet.end(), { 0x12, marker, 0x00, 0x00, 0x40, protocol, 0x00, 0x00, 192, 0, 2, marker, 198, 51,
+		                              100, marker });
+		if (protocol == 6)
+		{
+			packet.insert(packet.end(),
+			              { 0x04, 0xd2, 0x01, 0xbb, 0, 0, 0, marker, 0, 0, 0, 0, 0x50, 0x02, 0x20, 0, 0, 0, 0, 0 });
+		}
+		else
+		{
+			packet.insert(packet.end(), { 0x14, 0xe9, 0x00, 0x35, 0x00, 0x08, 0x00, 0x00 });
+		}
+		return packet;
+	}
+
+	Bytes makeEnhancedPacket(ByteOrder order, const Bytes& packet, uint64_t timestamp, uint32_t originalLength,
+	                         const std::string& comment, uint8_t marker, uint32_t interfaceId = 0,
+	                         bool customOptions = false)
+	{
+		Bytes body;
+		append32(body, interfaceId, order);
+		append32(body, static_cast<uint32_t>(timestamp >> 32), order);
+		append32(body, static_cast<uint32_t>(timestamp), order);
+		append32(body, static_cast<uint32_t>(packet.size()), order);
+		append32(body, originalLength, order);
+		appendPadded(body, packet);
+		appendOption(body, order, 1, text(comment));
+		Bytes flags;
+		append32(flags, 2, order);
+		appendOption(body, order, 2, flags);
+		appendOption(body, order, 3, Bytes{ 2, marker, 0x5a, 0xa5 });
+		Bytes dropCount;
+		append64(dropCount, 3 + marker, order);
+		appendOption(body, order, 4, dropCount);
+		Bytes packetId;
+		append64(packetId, 0x0102030405060700ULL | marker, order);
+		appendOption(body, order, 5, packetId);
+		Bytes queue;
+		append32(queue, marker, order);
+		appendOption(body, order, 6, queue);
+		appendOption(body, order, 0x2222, Bytes{ marker, 0xca, 0xfe });
+		if (customOptions)
+			appendStandardCustomOptions(body, order, marker);
+		finishOptions(body, order);
+		return makeBlock(order, EnhancedPacket, body);
+	}
+
+	Bytes makeSimplePacket(ByteOrder order, const Bytes& packet, uint32_t originalLength)
+	{
+		Bytes body;
+		append32(body, originalLength, order);
+		appendPadded(body, packet);
+		return makeBlock(order, SimplePacket, body);
+	}
+
+	Bytes makeNameResolution(ByteOrder order, const std::string& name, uint8_t addressSuffix)
+	{
+		Bytes body;
+		Bytes record{ 203, 0, 113, addressSuffix };
+		record.insert(record.end(), name.begin(), name.end());
+		record.push_back(0);
+		append16(body, 1, order);
+		append16(body, static_cast<uint16_t>(record.size()), order);
+		appendPadded(body, record);
+		append16(body, 0, order);
+		append16(body, 0, order);
+		appendOption(body, order, 1, text("nrb-" + name));
+		finishOptions(body, order);
+		return makeBlock(order, NameResolution, body);
+	}
+
+	Bytes makeInterfaceStatistics(ByteOrder order, uint64_t timestamp, uint64_t received, uint32_t interfaceId = 0)
+	{
+		Bytes body;
+		append32(body, interfaceId, order);
+		append32(body, static_cast<uint32_t>(timestamp >> 32), order);
+		append32(body, static_cast<uint32_t>(timestamp), order);
+		Bytes receivedValue;
+		append64(receivedValue, received, order);
+		appendOption(body, order, 4, receivedValue);
+		appendOption(body, order, 1, text("interface-statistics-" + std::to_string(interfaceId)));
+		finishOptions(body, order);
+		return makeBlock(order, InterfaceStatistics, body);
+	}
+
+	Bytes makeSecrets(ByteOrder order, const std::string& secret)
+	{
+		Bytes body;
+		append32(body, 0x544c534b, order);
+		append32(body, static_cast<uint32_t>(secret.size()), order);
+		appendPadded(body, text(secret));
+		appendOption(body, order, 1, text("opaque-secret"));
+		finishOptions(body, order);
+		return makeBlock(order, DecryptionSecrets, body);
+	}
+
+	Bytes makeCustom(ByteOrder order, uint32_t type, uint32_t pen, uint8_t marker)
+	{
+		Bytes body;
+		append32(body, pen, order);
+		body.insert(body.end(), { marker, 0xaa, 0x55, marker });
+		return makeBlock(order, type, body);
+	}
+
+	Bytes makeUnknown(ByteOrder order, uint8_t marker)
+	{
+		return makeBlock(order, UnknownBlock, Bytes{ marker, 1, 2, 3, 4, 5, 6, marker });
+	}
+
+	void appendBlock(Bytes& section, const Bytes& block)
+	{
+		section.insert(section.end(), block.begin(), block.end());
+	}
+
+	Bytes makeLittleSection(bool filtered, bool noMatches)
+	{
+		const auto order = ByteOrder::Little;
+		Bytes section = makeSectionHeader(order, 0, "little-endian-section");
+		const size_t headerLength = section.size();
+		appendBlock(section, makeInterface(order, 1, 65535, 6, "eth-little"));
+		if (!filtered || !noMatches)
+		{
+			appendBlock(section,
+			            makeEnhancedPacket(order, makeIpv4Packet(true, noMatches ? 17 : 6, 1), 0x000000020001e241ULL,
+			                               80, noMatches ? "drop-little-udp-one" : "keep-little-tcp", 1));
+		}
+		appendBlock(section, makeNameResolution(order, "little.example", 1));
+		if (!filtered)
+			appendBlock(section, makeCustom(order, DoNotCopyCustom, 32473, 0xd1));
+		if (!filtered)
+		{
+			appendBlock(section, makeEnhancedPacket(order, makeIpv4Packet(true, 17, 2), 0x0000000200067932ULL, 72,
+			                                        "drop-little-udp-two", 2));
+		}
+		appendBlock(section, makeInterfaceStatistics(order, 0x0000000200080001ULL, 17));
+		appendBlock(section, makeCustom(order, CopyableCustom, 32473, 0xc1));
+		appendBlock(section, makeUnknown(order, 0xa1));
+		appendBlock(section, makeSecrets(order, "CLIENT_RANDOM 0102 0304\n"));
+		set64(section, 16, section.size() - headerLength, order);
+		return section;
+	}
+
+	Bytes makeBigSection(bool filtered, bool noMatches)
+	{
+		const auto order = ByteOrder::Big;
+		Bytes section = makeSectionHeader(order, UINT64_MAX, "big-endian-section");
+		appendBlock(section, makeInterface(order, 113, 56, 9, "sll-big"));
+		appendBlock(section, makeSecrets(order, "SERVER_HANDSHAKE_TRAFFIC_SECRET 0a 0b\n"));
+		if (!filtered)
+		{
+			appendBlock(section, makeEnhancedPacket(order, makeIpv4Packet(false, 17, 3), 0x0102030405060708ULL, 64,
+			                                        "drop-big-udp", 3));
+		}
+		appendBlock(section, makeNameResolution(order, "big.example", 2));
+		appendBlock(section, makeCustom(order, CopyableCustom, 32473, 0xc2));
+		if (!filtered || !noMatches)
+		{
+			auto packet = makeIpv4Packet(false, noMatches ? 17 : 6, 4);
+			if (noMatches)
+				packet.resize(56, 0);
+			appendBlock(section, makeSimplePacket(order, packet, 72));
+		}
+		appendBlock(section, makeInterfaceStatistics(order, 0x1112131415161718ULL, 23));
+		if (!filtered)
+			appendBlock(section, makeCustom(order, DoNotCopyCustom, 32473, 0xd2));
+		appendBlock(section, makeUnknown(order, 0xa2));
+		return section;
+	}
+
+	Bytes makeComplexCapture(bool filtered, bool noMatches)
+	{
+		Bytes result = makeLittleSection(filtered, noMatches);
+		appendBlock(result, makeBigSection(filtered, noMatches));
+		return result;
+	}
+
+	Bytes makeInterfaceSelectionSection(ByteOrder order, bool filtered)
+	{
+		const bool ethernetPacket = order == ByteOrder::Little;
+		const uint16_t firstLinkType = ethernetPacket ? 113 : 1;
+		const uint16_t secondLinkType = ethernetPacket ? 1 : 113;
+		const uint64_t declaredLength = order == ByteOrder::Little ? 0 : UINT64_MAX;
+		Bytes section =
+		    makeSectionHeader(order, declaredLength, ethernetPacket ? "multi-interface-little" : "multi-interface-big");
+		const size_t headerLength = section.size();
+		appendBlock(section, makeInterface(order, firstLinkType, 96, 6, "unused-interface-zero"));
+		appendBlock(section, makeInterface(order, secondLinkType, 65535, 9, "selected-interface-one"));
+		appendBlock(section, makeEnhancedPacket(order, makeIpv4Packet(ethernetPacket, 6, ethernetPacket ? 31 : 41),
+		                                        ethernetPacket ? 0x0102030405060708ULL : 0x1112131415161718ULL, 96,
+		                                        "keep-interface-one-tcp", ethernetPacket ? 31 : 41, 1));
+		if (!filtered)
+		{
+			appendBlock(section, makeEnhancedPacket(order, makeIpv4Packet(ethernetPacket, 17, ethernetPacket ? 32 : 42),
+			                                        ethernetPacket ? 0x2122232425262728ULL : 0x3132333435363738ULL, 96,
+			                                        "drop-interface-one-udp", ethernetPacket ? 32 : 42, 1));
+		}
+		appendBlock(section, makeInterfaceStatistics(order, 0x4142434445464748ULL, 29, 1));
+		if (order == ByteOrder::Little)
+			set64(section, 16, section.size() - headerLength, order);
+		return section;
+	}
+
+	Bytes makeInterfaceSelectionCapture(bool filtered)
+	{
+		Bytes result = makeInterfaceSelectionSection(ByteOrder::Little, filtered);
+		appendBlock(result, makeInterfaceSelectionSection(ByteOrder::Big, filtered));
+		return result;
+	}
+
+	Bytes makeOptionCapture()
+	{
+		const auto order = ByteOrder::Little;
+		Bytes result = makeSectionHeader(order, UINT64_MAX, "custom-options");
+		appendBlock(result, makeInterface(order, 1, 65535, 6, "custom-option-interface", true));
+		appendBlock(result, makeEnhancedPacket(order, makeIpv4Packet(true, 6, 51), 0x5152535455565758ULL, 96,
+		                                       "custom-option-packet", 51, 0, true));
+		appendBlock(result, makeInterfaceStatistics(order, 0x6162636465666768ULL, 31));
+		appendBlock(result, makeNameResolution(order, "options.example", 51));
+		appendBlock(result, makeSecrets(order, "CLIENT_RANDOM 5152 5354\n"));
+		return result;
+	}
+
+	Bytes makeDiscardedOptionCapture(bool filtered)
+	{
+		const auto order = ByteOrder::Little;
+		Bytes result = makeSectionHeader(order, UINT64_MAX, "discarded-packet-options");
+		appendBlock(result, makeInterface(order, 1, 65535, 6, "discarded-option-interface"));
+		if (!filtered)
+		{
+			const auto udp = makeIpv4Packet(true, 17, 61);
+			auto discarded = makeEnhancedPacket(order, udp, 61, 80, "discard-malformed-options", 61);
+			const size_t optionsOffset = 28 + ((udp.size() + 3) & ~size_t(3));
+			set16(discarded, optionsOffset + 2, 0xfffc, order);
+			appendBlock(result, discarded);
+		}
+		appendBlock(result, makeEnhancedPacket(order, makeIpv4Packet(true, 6, 62), 62, 80, "keep-valid-options", 62));
+		return result;
+	}
+
+	Bytes makeOptionTerminationSection(ByteOrder order, uint8_t marker)
+	{
+		Bytes result = withoutEndOption(makeSectionHeader(order, UINT64_MAX, "unterminated-options"), order);
+		appendBlock(result, withoutEndOption(makeInterface(order, 1, 65535, 6, "unterminated-interface"), order));
+		appendBlock(result, withoutEndOption(makeEnhancedPacket(order, makeIpv4Packet(true, 6, marker), marker, 80,
+		                                                        "unterminated-packet", marker),
+		                                     order));
+		appendBlock(result, withoutEndOption(makeInterfaceStatistics(order, marker, marker), order));
+		appendBlock(result, withoutEndOption(makeNameResolution(order, "unterminated.example", marker), order));
+		appendBlock(result, withoutEndOption(makeSecrets(order, "CLIENT_RANDOM 7172 7374\n"), order));
+		return result;
+	}
+
+	Bytes makeOptionTerminationCapture()
+	{
+		Bytes result = makeOptionTerminationSection(ByteOrder::Little, 71);
+		appendBlock(result, makeOptionTerminationSection(ByteOrder::Big, 72));
+		return result;
+	}
+
+	Bytes makeFilterStateCapture(bool filtered)
+	{
+		const auto order = ByteOrder::Little;
+		Bytes result = makeSectionHeader(order, UINT64_MAX, "filter-state");
+		appendBlock(result, makeInterface(order, 1, 65535, 6, "filter-state-interface"));
+		if (!filtered)
+		{
+			appendBlock(result, makeEnhancedPacket(order, makeIpv4Packet(true, 6, 81), 81, 80,
+			                                       "reject-current-filter-tcp", 81));
+		}
+		appendBlock(result,
+		            makeEnhancedPacket(order, makeIpv4Packet(true, 17, 82), 82, 80, "keep-current-filter-udp", 82));
+		if (!filtered)
+			appendBlock(result, makeSimplePacket(order, makeIpv4Packet(true, 6, 83), 54));
+		appendBlock(result, makeSimplePacket(order, makeIpv4Packet(true, 17, 84), 42));
+		return result;
+	}
+
+	Bytes makeReservedFieldCapture()
+	{
+		const auto order = ByteOrder::Little;
+		const auto packet = makeIpv4Packet(true, 6, 85);
+		Bytes result = makeSectionHeader(order, UINT64_MAX, "reserved-field");
+		auto interface = makeInterface(order, 1, 65535, 6, "reserved-field-interface");
+		set16(interface, 10, 0xa55a, order);
+		appendBlock(result, interface);
+		appendBlock(result, makeEnhancedPacket(order, packet, 85, 80, "reserved-field-epb", 85));
+		appendBlock(result, makeSimplePacket(order, packet, static_cast<uint32_t>(packet.size())));
+		return result;
+	}
+
+	Bytes makeLocalUseCapture()
+	{
+		const auto order = ByteOrder::Little;
+		const auto packet = makeIpv4Packet(true, 6, 86);
+		Bytes result = makeSectionHeader(order, UINT64_MAX, "local-use");
+		appendBlock(result, makeInterface(order, 1, 65535, 6, "local-use-interface"));
+		Bytes opaqueBody;
+		append32(opaqueBody, 0x10203040, order);
+		append16(opaqueBody, 0x1234, order);
+		append16(opaqueBody, 0xfffc, order);
+		appendBlock(result, makeBlock(order, LocalUseBlock, opaqueBody));
+		appendBlock(result, makeEnhancedPacket(order, packet, 86, 80, "local-use-epb", 86));
+		return result;
+	}
