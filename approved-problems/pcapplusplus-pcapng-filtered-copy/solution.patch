+		enum class PcapNgByteOrder
+		{
+			Little,
+			Big
+		};
+
+		template <typename T> T readPcapNg(const uint8_t* data, PcapNgByteOrder order)
+		{
+			T result = 0;
+			for (size_t index = 0; index < sizeof(T); ++index)
+				result |= static_cast<T>(data[index])
+				          << (order == PcapNgByteOrder::Little ? index * 8 : (sizeof(T) - index - 1) * 8);
+			return result;
+		}
+
+		template <typename T> void writePcapNg(uint8_t* data, T value, PcapNgByteOrder order)
+		{
+			for (size_t index = 0; index < sizeof(T); ++index)
+				data[index] = static_cast<uint8_t>(
+				    value >> (order == PcapNgByteOrder::Little ? index * 8 : (sizeof(T) - index - 1) * 8));
+		}
+
+		bool advancePcapNgField(size_t& offset, uint16_t valueLength, size_t end)
+		{
+			const size_t paddedLength = (static_cast<size_t>(valueLength) + 3) & ~size_t(3);
+			if (offset > end || paddedLength > end - offset)
+				return false;
+			offset += paddedLength;
+			return true;
+		}
+
+		bool validatePcapNgOptions(const uint8_t* block, uint32_t blockLength, size_t optionsOffset,
+		                           PcapNgByteOrder order)
+		{
+			const size_t optionsEnd = blockLength - 4;
+			if (optionsOffset > optionsEnd)
+				return false;
+			while (optionsOffset < optionsEnd)
+			{
+				if (optionsEnd - optionsOffset < 4)
+					return false;
+				const uint16_t optionType = readPcapNg<uint16_t>(block + optionsOffset, order);
+				const uint16_t optionLength = readPcapNg<uint16_t>(block + optionsOffset + 2, order);
+				optionsOffset += 4;
+				if (!advancePcapNgField(optionsOffset, optionLength, optionsEnd))
+					return false;
+				if (optionType == 0)
+					return optionLength == 0 && optionsOffset == optionsEnd;
+			}
+			return true;
+		}
+
+		bool findPcapNgNameResolutionOptions(const uint8_t* block, uint32_t blockLength, PcapNgByteOrder order,
+		                                     size_t& optionsOffset)
+		{
+			const size_t recordsEnd = blockLength - 4;
+			size_t recordOffset = 8;
+			while (recordOffset < recordsEnd)
+			{
+				if (recordsEnd - recordOffset < 4)
+					return false;
+				const uint16_t recordType = readPcapNg<uint16_t>(block + recordOffset, order);
+				const uint16_t recordLength = readPcapNg<uint16_t>(block + recordOffset + 2, order);
+				recordOffset += 4;
+				if (!advancePcapNgField(recordOffset, recordLength, recordsEnd))
+					return false;
+				if (recordType == 0)
+				{
+					if (recordLength != 0)
+						return false;
+					optionsOffset = recordOffset;
+					return true;
+				}
+			}
+			return false;
+		}
