diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..71c1c76
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,136 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+cd "$(dirname "$0")"
+
+NEW_DIRS="bank_extent_4d1427 bank_derived_c41fad"
+
+xml_escape() {
+  printf '%s' "$1" \
+    | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' \
+    | tr -d '\000-\010\013\014\016-\037'
+}
+
+captured_output() {
+  local name="$1"
+  local log_file="$2"
+
+  awk -v target="---- $name stdout ----" '
+    $0 == target { capture = 1; next }
+    capture && /^---- .* stdout ----$/ { capture = 0 }
+    capture && /^failures:$/ { capture = 0 }
+    capture { print }
+  ' "$log_file" | tail -n 80
+}
+
+write_junit() {
+  local suite_name="$1"
+  local log_file="$2"
+
+  [ -z "$OUTPUT_PATH" ] && return 0
+
+  local cases=""
+  local total=0
+  local failures=0
+
+  while IFS= read -r line; do
+    local name status
+    name="$(printf '%s' "$line" | sed -n 's/^test \([A-Za-z0-9_:]*\) \.\.\. \(ok\|FAILED\|ignored\)$/\1/p')"
+    status="$(printf '%s' "$line" | sed -n 's/^test \([A-Za-z0-9_:]*\) \.\.\. \(ok\|FAILED\|ignored\)$/\2/p')"
+
+    [ -z "$name" ] && continue
+
+    total=$((total + 1))
+    local esc_name
+    esc_name="$(xml_escape "$name")"
+
+    if [ "$status" = "FAILED" ]; then
+      failures=$((failures + 1))
+
+      local detail
+      detail="$(captured_output "$name" "$log_file")"
+      if [ -z "$detail" ]; then
+        detail="test ${name} failed"
+      fi
+
+      cases="${cases}<testcase name=\"${esc_name}\" classname=\"${suite_name}\"><failure message=\"assertion failed\">$(xml_escape "$detail")</failure></testcase>"
+    else
+      cases="${cases}<testcase name=\"${esc_name}\" classname=\"${suite_name}\"></testcase>"
+    fi
+  done < <(grep -E '^test [A-Za-z0-9_:]+ \.\.\. (ok|FAILED|ignored)$' "$log_file" | sort)
+
+  if [ "$total" -eq 0 ]; then
+    total=1
+    failures=1
+
+    local reason
+    reason="$(tail -n 120 "$log_file")"
+    if [ -z "$reason" ]; then
+      reason="the crate failed to build or produced no test results"
+    fi
+
+    cases="<testcase name=\"build\" classname=\"${suite_name}\"><failure message=\"no tests ran\">$(xml_escape "$reason")</failure></testcase>"
+  fi
+
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites name="customasm" tests="%s" failures="%s" errors="0" time="0">\n' "$total" "$failures"
+    printf '<testsuite name="%s" tests="%s" failures="%s" errors="0" time="0">\n' "$suite_name" "$total" "$failures"
+    printf '%s\n' "$cases"
+    printf '</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH" || return 1
+
+  [ -s "$OUTPUT_PATH" ] || return 1
+
+  return 0
+}
+
+LOG="$(mktemp)"
+trap 'rm -f "$LOG"' EXIT
+
+if [ "$MODE" = "new" ]; then
+  EXIT_CODE=0
+  : > "$LOG"
+  for d in $NEW_DIRS; do
+    cargo test --lib -- "$d" 2>&1 | tee -a "$LOG"
+    RC="${PIPESTATUS[0]}"
+    [ "$RC" -ne 0 ] && EXIT_CODE="$RC"
+  done
+
+  if ! write_junit "new" "$LOG"; then
+    echo "failed to write the JUnit report to ${OUTPUT_PATH}" >&2
+    EXIT_CODE=1
+  fi
+else
+  SKIP_ARGS=""
+  for d in $NEW_DIRS; do
+    SKIP_ARGS="$SKIP_ARGS --skip $d"
+  done
+  cargo test --lib -- $SKIP_ARGS 2>&1 | tee "$LOG"
+  EXIT_CODE="${PIPESTATUS[0]}"
+
+  if ! write_junit "base" "$LOG"; then
+    echo "failed to write the JUnit report to ${OUTPUT_PATH}" >&2
+    EXIT_CODE=1
+  fi
+fi
+
+exit "$EXIT_CODE"
