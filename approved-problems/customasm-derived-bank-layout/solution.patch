+fn eval_layout_field_simple(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    decls: &asm::ItemDecls,
+    defs: &asm::ItemDefs,
+    maybe_expr: &Option<expr::Expr>)
+    -> Result<expr::Value, ()>
+{
+    match maybe_expr
+    {
+        None => Ok(expr::Value::make_void().statically_known()),
+        Some(expr) => asm::resolver::eval_simple(
+            report,
+            opts,
+            decls,
+            defs,
+            expr),
+    }
+}
