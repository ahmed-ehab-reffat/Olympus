@@ -0,0 +1,613 @@
+use crate::*;
+
+
+pub fn resolve_bankdef(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    fileserver: &mut dyn util::FileServer,
+    ast_bankdef: &asm::AstDirectiveBankdef,
+    decls: &asm::ItemDecls,
+    defs: &mut asm::ItemDefs,
+    ctx: &asm::ResolverContext)
+    -> Result<asm::ResolutionState, ()>
+{
+    let item_ref = ast_bankdef.item_ref.unwrap();
+
+    let bankdef = defs.bankdefs.get(item_ref);
+
+    if bankdef.layout_resolved && opts.optimize_statically_known {
+        return Ok(asm::ResolutionState::Resolved);
+    }
+
+    let layout = asm::BankdefLayout {
+        addr_start: eval_bank_field(
+            report,
+            fileserver,
+            opts,
+            decls,
+            defs,
+            ctx,
+            &ast_bankdef.addr_start)?,
+        addr_end: eval_bank_field(
+            report,
+            fileserver,
+            opts,
+            decls,
+            defs,
+            ctx,
+            &ast_bankdef.addr_end)?,
+        addr_size: eval_bank_field(
+            report,
+            fileserver,
+            opts,
+            decls,
+            defs,
+            ctx,
+            &ast_bankdef.addr_size)?,
+        output_offset: eval_bank_field(
+            report,
+            fileserver,
+            opts,
+            decls,
+            defs,
+            ctx,
+            &ast_bankdef.output_offset)?,
+    };
+
+    let bankdef = defs.bankdefs.get_mut(item_ref);
+    let is_stable = layout.is_stable(&bankdef.layout);
+    bankdef.layout = layout;
+
+    finalize_bankdef(
+        report,
+        ast_bankdef,
+        defs,
+        ctx.can_guess())?;
+
+    let bankdef = defs.bankdefs.get_mut(item_ref);
+
+    asm::resolver::handle_value_resolution(
+        opts,
+        report,
+        ast_bankdef.header_span,
+        ctx.can_guess(),
+        bankdef.layout.is_guess(),
+        is_stable,
+        &mut bankdef.layout_resolved,
+        false,
+        "bankdef",
+        "bank placement",
+        Some(&ast_bankdef.name),
+        &bankdef.layout.addr_start)
+}
+
+
+enum SettleNode<'ast>
+{
+    Bank(&'ast asm::AstDirectiveBankdef),
+    Constant(&'ast asm::AstSymbol),
+}
+
+
+pub fn settle_bankdefs(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    fileserver: &mut dyn util::FileServer,
+    ast: &asm::AstTopLevel,
+    decls: &asm::ItemDecls,
+    defs: &mut asm::ItemDefs,
+    iter: &asm::ResolveIterator)
+    -> Result<bool, ()>
+{
+    let mut nodes = Vec::new();
+    let mut index_of_bank = Vec::new();
+    let mut index_of_symbol = Vec::new();
+
+    for any_node in &ast.nodes
+    {
+        match any_node
+        {
+            asm::AstAny::DirectiveBankdef(ast_bankdef) =>
+            {
+                let raw = ast_bankdef.item_ref.unwrap().get_raw();
+
+                while index_of_bank.len() <= raw
+                {
+                    index_of_bank.push(None);
+                }
+
+                index_of_bank[raw] = Some(nodes.len());
+                nodes.push(SettleNode::Bank(ast_bankdef));
+            }
+
+            asm::AstAny::Symbol(ast_symbol) =>
+            {
+                let asm::AstSymbolKind::Constant(_) = ast_symbol.kind
+                    else { continue };
+
+                let item_ref = ast_symbol.item_ref.unwrap();
+                let symbol = defs.symbols.get(item_ref);
+
+                if symbol.bank_reads.len() == 0 ||
+                    symbol.address_dependent
+                {
+                    continue;
+                }
+
+                let raw = item_ref.get_raw();
+
+                while index_of_symbol.len() <= raw
+                {
+                    index_of_symbol.push(None);
+                }
+
+                index_of_symbol[raw] = Some(nodes.len());
+                nodes.push(SettleNode::Constant(ast_symbol));
+            }
+
+            _ => {}
+        }
+    }
+
+    let mut deps = Vec::new();
+    let mut changed = false;
+
+    for index in 0..nodes.len()
+    {
+        let mut log = asm::BankReadLog::new();
+
+        changed |= settle_node(
+            report,
+            opts,
+            fileserver,
+            &nodes[index],
+            decls,
+            defs,
+            iter,
+            &mut log)?;
+
+        let mut node_deps = Vec::new();
+
+        for bank_ref in log.banks
+        {
+            push_dep(
+                &mut node_deps,
+                index_of_bank.get(bank_ref.get_raw()),
+                index);
+        }
+
+        for symbol_ref in log.symbols
+        {
+            push_dep(
+                &mut node_deps,
+                index_of_symbol.get(symbol_ref.get_raw()),
+                index);
+        }
+
+        deps.push(node_deps);
+    }
+
+    let order = dependency_order(&deps);
+
+    for index in order
+    {
+        changed |= settle_node(
+            report,
+            opts,
+            fileserver,
+            &nodes[index],
+            decls,
+            defs,
+            iter,
+            &mut asm::BankReadLog::new())?;
+    }
+
+    Ok(changed)
+}
+
+
+fn push_dep(
+    node_deps: &mut Vec<usize>,
+    slot: Option<&Option<usize>>,
+    index: usize)
+{
+    let Some(Some(dep)) = slot
+        else { return };
+
+    if *dep != index && !node_deps.contains(dep)
+    {
+        node_deps.push(*dep);
+    }
+}
+
+
+fn settle_node(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    fileserver: &mut dyn util::FileServer,
+    node: &SettleNode,
+    decls: &asm::ItemDecls,
+    defs: &mut asm::ItemDefs,
+    iter: &asm::ResolveIterator,
+    log: &mut asm::BankReadLog)
+    -> Result<bool, ()>
+{
+    match node
+    {
+        SettleNode::Bank(ast_bankdef) =>
+            settle_one(
+                report,
+                opts,
+                fileserver,
+                ast_bankdef,
+                decls,
+                defs,
+                iter,
+                log),
+
+        SettleNode::Constant(ast_symbol) =>
+            settle_constant(
+                report,
+                opts,
+                fileserver,
+                ast_symbol,
+                decls,
+                defs,
+                iter,
+                log),
+    }
+}
+
+
+fn settle_constant(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    fileserver: &mut dyn util::FileServer,
+    ast_symbol: &asm::AstSymbol,
+    decls: &asm::ItemDecls,
+    defs: &mut asm::ItemDefs,
+    iter: &asm::ResolveIterator,
+    log: &mut asm::BankReadLog)
+    -> Result<bool, ()>
+{
+    let item_ref = ast_symbol.item_ref.unwrap();
+    let previous = defs.symbols.get(item_ref).value.clone();
+    let previously_resolved = defs.symbols.get(item_ref).resolved;
+
+    let bank_reads = std::cell::RefCell::new(asm::BankReadLog::new());
+
+    {
+        let ctx = iter.constant_context(
+            ast_symbol,
+            decls,
+            Some(&bank_reads));
+
+        asm::resolver::resolve_constant(
+            report,
+            opts,
+            fileserver,
+            ast_symbol,
+            decls,
+            defs,
+            &ctx)?;
+    }
+
+    let mut read = bank_reads.into_inner();
+    log.banks.append(&mut read.banks);
+    log.symbols.append(&mut read.symbols);
+
+    let symbol = defs.symbols.get(item_ref);
+
+    Ok(symbol.value != previous ||
+        symbol.resolved != previously_resolved)
+}
+
+
+fn settle_one(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    fileserver: &mut dyn util::FileServer,
+    ast_bankdef: &asm::AstDirectiveBankdef,
+    decls: &asm::ItemDecls,
+    defs: &mut asm::ItemDefs,
+    iter: &asm::ResolveIterator,
+    log: &mut asm::BankReadLog)
+    -> Result<bool, ()>
+{
+    let item_ref = ast_bankdef.item_ref.unwrap();
+    let previous = defs.bankdefs.get(item_ref).layout.clone();
+
+    let bank_reads = std::cell::RefCell::new(asm::BankReadLog::new());
+
+    {
+        let ctx = iter.bankdef_context(
+            ast_bankdef,
+            Some(&bank_reads));
+
+        resolve_bankdef(
+            report,
+            opts,
+            fileserver,
+            ast_bankdef,
+            decls,
+            defs,
+            &ctx)?;
+    }
+
+    let mut read = bank_reads.into_inner();
+    log.banks.append(&mut read.banks);
+    log.symbols.append(&mut read.symbols);
+
+    Ok(!defs.bankdefs.get(item_ref).layout.same_as(&previous))
+}
+
+
+fn dependency_order(
+    deps: &Vec<Vec<usize>>)
+    -> Vec<usize>
+{
+    let count = deps.len();
+
+    let mut pending = deps
+        .iter()
+        .map(|d| d.len())
+        .collect::<Vec<_>>();
+
+    let mut dependents = vec![Vec::new(); count];
+
+    for index in 0..count
+    {
+        for dep in &deps[index]
+        {
+            dependents[*dep].push(index);
+        }
+    }
+
+    let mut order = Vec::new();
+    let mut queue = (0..count)
+        .filter(|i| pending[*i] == 0)
+        .collect::<Vec<_>>();
+
+    let mut cursor = 0;
+
+    while cursor < queue.len()
+    {
+        let index = queue[cursor];
+        cursor += 1;
+        order.push(index);
+
+        for dependent in &dependents[index]
+        {
+            pending[*dependent] -= 1;
+
+            if pending[*dependent] == 0
+            {
+                queue.push(*dependent);
+            }
+        }
+    }
+
+    for index in 0..count
+    {
+        if pending[index] != 0
+        {
+            order.push(index);
+        }
+    }
+
+    order
+}
+
+
+fn eval_bank_field(
+    report: &mut diagn::Report,
+    fileserver: &mut dyn util::FileServer,
+    opts: &asm::AssemblyOptions,
+    decls: &asm::ItemDecls,
+    defs: &asm::ItemDefs,
+    ctx: &asm::ResolverContext,
+    maybe_expr: &Option<expr::Expr>)
+    -> Result<expr::Value, ()>
+{
+    let Some(expr) = maybe_expr
+        else { return Ok(expr::Value::make_void().statically_known()); };
+
+    let mut provider = |query: expr::EvalQuery|
+    {
+        match query
+        {
+            expr::EvalQuery::CtxLabel(query_ctxlabel) =>
+                asm::resolver::eval_ctxlabel(
+                    decls,
+                    defs,
+                    ctx,
+                    query_ctxlabel),
+
+            expr::EvalQuery::Variable(query_var) =>
+                asm::resolver::eval_variable(
+                    decls,
+                    defs,
+                    ctx,
+                    query_var),
+
+            expr::EvalQuery::Member(query_member) =>
+                asm::resolver::eval_member(
+                    decls,
+                    defs,
+                    Some(ctx),
+                    query_member),
+
+            expr::EvalQuery::Function(query_fn) =>
+                asm::resolver::eval_fn(
+                    fileserver,
+                    opts,
+                    decls,
+                    defs,
+                    ctx,
+                    query_fn),
+
+            expr::EvalQuery::AsmBlock(query_asm) =>
+                asm::resolver::eval_asm(
+                    fileserver,
+                    opts,
+                    decls,
+                    defs,
+                    ctx,
+                    query_asm),
+        }
+    };
+
+    expr.eval_with_ctx(
+        report,
+        &mut expr::EvalContext::new(opts),
+        &mut provider)
+}
+
+
+pub fn finalize_bankdef(
+    report: &mut diagn::Report,
+    ast_bankdef: &asm::AstDirectiveBankdef,
+    defs: &mut asm::ItemDefs,
+    can_guess: bool)
+    -> Result<(), ()>
+{
+    let item_ref = ast_bankdef.item_ref.unwrap();
+
+    let bankdef = defs.bankdefs.get(item_ref);
+    let layout = bankdef.layout.clone();
+    let addr_unit = bankdef.addr_unit;
+
+    let addr_start = layout_bigint(
+        report,
+        &layout.addr_start,
+        &ast_bankdef.addr_start,
+        can_guess)?
+        .unwrap_or_else(|| util::BigInt::new(0, None));
+
+    let addr_size = layout_usize(
+        report,
+        &layout.addr_size,
+        &ast_bankdef.addr_size,
+        can_guess)?;
+
+    let addr_end = layout_bigint(
+        report,
+        &layout.addr_end,
+        &ast_bankdef.addr_end,
+        can_guess)?;
+
+    let addr_size = match (addr_size, addr_end)
+    {
+        (Some(size), _) => Some(size),
+        (None, None) => None,
+        (None, Some(end)) =>
+        {
+            let span = field_span(&ast_bankdef.addr_end, ast_bankdef.header_span);
+
+            if can_guess &&
+                (layout.addr_end.is_guess() || layout.addr_start.is_guess())
+            {
+                end.maybe_sub(&addr_start)
+                    .and_then(|s| s.maybe_into::<usize>())
+            }
+            else
+            {
+                Some(end
+                    .checked_sub(report, span, &addr_start)?
+                    .checked_into::<usize>(report, span)?)
+            }
+        }
+    };
+
+    let size_in_bits = match addr_size
+    {
+        None => None,
+        Some(size) => match size.checked_mul(addr_unit)
+        {
+            Some(s) => Some(s),
+            None =>
+            {
+                report.error_span(
+                    "value is outside the supported range",
+                    field_span(&ast_bankdef.addr_size, ast_bankdef.header_span));
+
+                return Err(());
+            }
+        },
+    };
+
+    let output_offset = layout_usize(
+        report,
+        &layout.output_offset,
+        &ast_bankdef.output_offset,
+        can_guess)?;
+
+    let bankdef = defs.bankdefs.get_mut(item_ref);
+    bankdef.addr_start = addr_start;
+    bankdef.size_in_units = addr_size;
+    bankdef.size_in_bits = size_in_bits;
+    bankdef.output_offset = output_offset;
+
+    Ok(())
+}
+
+
+fn field_span(
+    maybe_expr: &Option<expr::Expr>,
+    fallback: diagn::Span)
+    -> diagn::Span
+{
+    match maybe_expr
+    {
+        Some(expr) => expr.span(),
+        None => fallback,
+    }
+}
+
+
+fn layout_bigint(
+    report: &mut diagn::Report,
+    value: &expr::Value,
+    maybe_expr: &Option<expr::Expr>,
+    can_guess: bool)
+    -> Result<Option<util::BigInt>, ()>
+{
+    let Some(expr) = maybe_expr
+        else { return Ok(None); };
+
+    if value.is_guess() &&
+        (can_guess || value.is_unknown())
+    {
+        return Ok(match value
+        {
+            expr::Value::Integer(_, bigint) => Some(bigint.clone()),
+            _ => None,
+        });
+    }
+
+    Ok(Some(value.expect_bigint(report, expr.span())?.clone()))
+}
+
+
+fn layout_usize(
+    report: &mut diagn::Report,
+    value: &expr::Value,
+    maybe_expr: &Option<expr::Expr>,
+    can_guess: bool)
+    -> Result<Option<usize>, ()>
+{
+    let Some(expr) = maybe_expr
+        else { return Ok(None); };
+
+    if value.is_guess() &&
+        (can_guess || value.is_unknown())
+    {
+        return Ok(match value
+        {
+            expr::Value::Integer(_, bigint) => bigint.maybe_into::<usize>(),
+            _ => None,
+        });
+    }
+
+    Ok(Some(value.expect_usize(report, expr.span())?))
+}
