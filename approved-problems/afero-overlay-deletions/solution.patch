index 0000000..155fdbd
--- /dev/null
+++ b/overlayDeletions.go
@@ -0,0 +1,573 @@
+package afero
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+const (
+	deletionMarkerPrefix = ".afero_wh."
+	directorySealName    = ".afero_opq"
+)
+
+// overlayPath roots a name at the overlay so a relative and an absolute
+// spelling of the same path key the same bookkeeping, without leaning on the
+// backing filesystem to normalise for us.
+func overlayPath(name string) string {
+	clean := filepath.Clean(name)
+	if !filepath.IsAbs(clean) {
+		clean = filepath.Join(FilePathSeparator, clean)
+	}
+	return clean
+}
+
+func deletionMarkerPath(name string) string {
+	return filepath.Join(filepath.Dir(name), deletionMarkerPrefix+filepath.Base(name))
+}
+
+func directorySealPath(dir string) string {
+	return filepath.Join(dir, directorySealName)
+}
+
+func isOverlayBookkeeping(base string) bool {
+	return base == directorySealName || strings.HasPrefix(base, deletionMarkerPrefix)
+}
+
+func isPathRoot(name string) bool {
+	return name == "." || name == string(filepath.Separator) || name == ""
+}
+
+func pathAncestors(name string) []string {
+	clean := overlayPath(name)
+	var reversed []string
+	for {
+		parent := filepath.Dir(clean)
+		if parent == clean {
+			break
+		}
+		reversed = append(reversed, parent)
+		clean = parent
+	}
+	out := make([]string, 0, len(reversed))
+	for i := len(reversed) - 1; i >= 0; i-- {
+		out = append(out, reversed[i])
+	}
+	return out
+}
+
+func (u *CopyOnWriteFs) markerExists(path string) (bool, error) {
+	if _, err := u.layer.Stat(path); err == nil {
+		return true, nil
+	} else if u.isNotExist(err) || os.IsNotExist(err) {
+		return false, nil
+	} else {
+		return false, err
+	}
+}
+
+func (u *CopyOnWriteFs) touchMarker(path string) error {
+	fh, err := u.layer.Create(path)
+	if err != nil {
+		return err
+	}
+	return fh.Close()
+}
+
+func (u *CopyOnWriteFs) sealDirectory(dir string) error {
+	return u.touchMarker(directorySealPath(dir))
+}
+
+func (u *CopyOnWriteFs) recordRemoval(name string) error {
+	clean := overlayPath(name)
+	if err := u.ensureLayerDir(filepath.Dir(clean)); err != nil {
+		return err
+	}
+	return u.touchMarker(deletionMarkerPath(clean))
+}
+
+// mirrorBaseDir gives the copy the overlay had to make in the layer the same
+// permissions and modification time the base directory has. A directory that was
+// removed and made again is the caller's, not a copy, and keeps its own.
+func (u *CopyOnWriteFs) mirrorBaseDir(dir string) error {
+	fi, err := u.base.Stat(dir)
+	if err != nil || !fi.IsDir() {
+		return nil
+	}
+	sealed, err := u.markerExists(directorySealPath(dir))
+	if err != nil || sealed {
+		return err
+	}
+	return u.adoptBaseDirMetadata(dir)
+}
+
+// adoptBaseDirMetadata gives a directory the overlay stood up itself the
+// permissions and modification time the base keeps for it.
+func (u *CopyOnWriteFs) adoptBaseDirMetadata(dir string) error {
+	fi, err := u.base.Stat(dir)
+	if err != nil || !fi.IsDir() {
+		return nil
+	}
+	if err := u.layer.Chmod(dir, fi.Mode().Perm()); err != nil {
+		return err
+	}
+	return u.layer.Chtimes(dir, fi.ModTime(), fi.ModTime())
+}
+
+func (u *CopyOnWriteFs) reviveDir(step string, perm os.FileMode) error {
+	if err := u.layer.MkdirAll(step, perm); err != nil {
+		return err
+	}
+	if err := u.layer.Remove(deletionMarkerPath(step)); err != nil {
+		return err
+	}
+	if wasDir, _ := IsDir(u.base, step); wasDir {
+		return u.sealDirectory(step)
+	}
+	return nil
+}
+
+// ensureLayerDir makes the layer able to hold something at name. Directories the
+// overlay creates for its own sake shadow the base ones, so they take the base
+// permissions and modification time; a directory that had been removed is made
+// again instead, and keeps the base contents under it hidden.
+func (u *CopyOnWriteFs) ensureLayerDir(name string) error {
+	clean := overlayPath(name)
+	if !u.deletions {
+		return u.layer.MkdirAll(clean, 0o777)
+	}
+	for _, step := range append(pathAncestors(clean), clean) {
+		if isPathRoot(step) {
+			continue
+		}
+		removed, err := u.markerExists(deletionMarkerPath(step))
+		if err != nil {
+			return err
+		}
+		if removed {
+			if err := u.reviveDir(step, 0o777); err != nil {
+				return err
+			}
+			if err := u.adoptBaseDirMetadata(step); err != nil {
+				return err
+			}
+			continue
+		}
+		if _, err := u.layer.Stat(step); err == nil {
+			continue
+		} else if !u.isNotExist(err) && !os.IsNotExist(err) {
+			return err
+		}
+		if err := u.layer.Mkdir(step, 0o777); err != nil {
+			return err
+		}
+		if err := u.mirrorBaseDir(step); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (u *CopyOnWriteFs) clearRemoval(name string) error {
+	marker := deletionMarkerPath(overlayPath(name))
+	present, err := u.markerExists(marker)
+	if err != nil || !present {
+		return err
+	}
+	return u.layer.Remove(marker)
+}
+
+// hidden reports whether the overlay keeps name out of sight: the path itself or
+// one of the directories above it has been removed, or the base entry sits under
+// a directory that was removed and made again.
+func (u *CopyOnWriteFs) hidden(name string) (bool, error) {
+	if !u.deletions {
+		return false, nil
+	}
+	clean := overlayPath(name)
+	if isOverlayBookkeeping(filepath.Base(clean)) {
+		return u.markerExists(clean)
+	}
+	for _, step := range append(pathAncestors(clean), clean) {
+		if isPathRoot(step) {
+			continue
+		}
+		removed, err := u.markerExists(deletionMarkerPath(step))
+		if err != nil {
+			return false, err
+		}
+		if removed {
+			return true, nil
+		}
+	}
+	if _, err := u.layer.Stat(clean); err == nil {
+		return false, nil
+	} else if !u.isNotExist(err) && !os.IsNotExist(err) {
+		return false, err
+	}
+	for _, dir := range pathAncestors(clean) {
+		sealed, err := u.markerExists(directorySealPath(dir))
+		if err != nil {
+			return false, err
+		}
+		if sealed {
+			return true, nil
+		}
+		shadowed, err := u.layerHoldsNonDirectory(dir)
+		if err != nil {
+			return false, err
+		}
+		if shadowed {
+			return true, nil
+		}
+	}
+	return false, nil
+}
+
+// layerHoldsNonDirectory reports whether the layer stands something other than a
+// directory at dir, which leaves nothing underneath it for the base to fill in.
+func (u *CopyOnWriteFs) layerHoldsNonDirectory(dir string) (bool, error) {
+	fi, err := u.layer.Stat(dir)
+	if err != nil {
+		if u.isNotExist(err) || os.IsNotExist(err) {
+			return false, nil
+		}
+		return false, err
+	}
+	return !fi.IsDir(), nil
+}
+
+func (u *CopyOnWriteFs) readDirInfos(fs Fs, dir string) ([]os.FileInfo, error) {
+	fh, err := fs.Open(dir)
+	if err != nil {
+		if u.isNotExist(err) || os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	defer fh.Close()
+	fi, err := fh.Stat()
+	if err != nil {
+		if u.isNotExist(err) || os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	if !fi.IsDir() {
+		return nil, nil
+	}
+	return fh.Readdir(-1)
+}
+
+// mergedInfos builds the view of a directory the overlay shows: the layer's own
+// entries, the base entries the layer neither replaces nor removes, sorted by
+// name and stripped of the bookkeeping the layer keeps for removals.
+func (u *CopyOnWriteFs) mergedInfos(dir string) ([]os.FileInfo, error) {
+	clean := overlayPath(dir)
+
+	layerInfos, err := u.readDirInfos(u.layer, clean)
+	if err != nil {
+		return nil, err
+	}
+
+	visible := make([]os.FileInfo, 0, len(layerInfos))
+	for _, fi := range layerInfos {
+		if u.deletions {
+			if isOverlayBookkeeping(fi.Name()) {
+				continue
+			}
+			gone, err := u.hidden(filepath.Join(clean, fi.Name()))
+			if err != nil {
+				return nil, err
+			}
+			if gone {
+				continue
+			}
+		}
+		visible = append(visible, fi)
+	}
+
+	baseInfos, err := u.readDirInfos(u.base, clean)
+	if err != nil {
+		return nil, err
+	}
+	present := make(map[string]bool, len(visible))
+	for _, fi := range visible {
+		present[fi.Name()] = true
+	}
+	for _, fi := range baseInfos {
+		if present[fi.Name()] {
+			continue
+		}
+		gone, err := u.hidden(filepath.Join(clean, fi.Name()))
+		if err != nil {
+			return nil, err
+		}
+		if gone {
+			continue
+		}
+		visible = append(visible, fi)
+	}
+
+	sort.Slice(visible, func(i, j int) bool { return visible[i].Name() < visible[j].Name() })
+	return visible, nil
+}
+
+// mkdirAllInLayer creates a directory the caller asked for, with the permissions
+// the caller asked for, over whatever the base and the removal records hold.
+func (u *CopyOnWriteFs) mkdirAllInLayer(name string, perm os.FileMode) error {
+	clean := overlayPath(name)
+	if !u.deletions {
+		return u.layer.MkdirAll(clean, perm)
+	}
+	parent := filepath.Dir(clean)
+	if parent != clean && !isPathRoot(parent) {
+		if err := u.ensureLayerDir(parent); err != nil {
+			return err
+		}
+	}
+	removed, err := u.markerExists(deletionMarkerPath(clean))
+	if err != nil {
+		return err
+	}
+	if removed {
+		return u.reviveDir(clean, perm)
+	}
+	return u.layer.MkdirAll(clean, perm)
+}
+
+func (u *CopyOnWriteFs) stripBookkeeping(dir string) error {
+	infos, err := u.readDirInfos(u.layer, dir)
+	if err != nil {
+		return err
+	}
+	for _, fi := range infos {
+		if !isOverlayBookkeeping(fi.Name()) {
+			continue
+		}
+		if err := u.layer.Remove(filepath.Join(dir, fi.Name())); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// pruneLayer drops what the layer holds at name, keeping the removals recorded
+// under it so that bringing name back does not bring them back with it.
+func (u *CopyOnWriteFs) pruneLayer(name string) error {
+	fi, err := u.layer.Stat(name)
+	if err != nil {
+		if u.isNotExist(err) || os.IsNotExist(err) {
+			return nil
+		}
+		return err
+	}
+	if !fi.IsDir() {
+		return u.layer.Remove(name)
+	}
+
+	infos, err := u.readDirInfos(u.layer, name)
+	if err != nil {
+		return err
+	}
+	occupied := false
+	for _, entry := range infos {
+		if isOverlayBookkeeping(entry.Name()) {
+			occupied = true
+			continue
+		}
+		child := filepath.Join(name, entry.Name())
+		if err := u.pruneLayer(child); err != nil {
+			return err
+		}
+		if _, err := u.layer.Stat(child); err == nil {
+			occupied = true
+		}
+	}
+	if occupied {
+		return nil
+	}
+	return u.layer.Remove(name)
+}
+
+// hidePath drops whatever the layer holds for name and, when the base still has
+// something there, writes the removal into the layer.
+func (u *CopyOnWriteFs) hidePath(name string) error {
+	clean := overlayPath(name)
+	if isPathRoot(clean) {
+		infos, err := u.mergedInfos(clean)
+		if err != nil {
+			return err
+		}
+		for _, entry := range infos {
+			if err := u.hidePath(filepath.Join(clean, entry.Name())); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	inBase := false
+	if _, err := u.base.Stat(clean); err == nil {
+		inBase = true
+	} else if !u.isNotExist(err) && !os.IsNotExist(err) {
+		return err
+	}
+
+	if inBase {
+		if err := u.recordRemoval(clean); err != nil {
+			return err
+		}
+	} else if err := u.clearRemoval(clean); err != nil {
+		return err
+	}
+	return u.pruneLayer(clean)
+}
+
+// Restore drops the removal recorded at name so the base entry, and everything
+// under it that is not recorded separately, shows through again. A path with no
+// removal recorded reports os.ErrNotExist.
+func (u *CopyOnWriteFs) Restore(name string) error {
+	clean := overlayPath(name)
+	if u.deletions {
+		marker := deletionMarkerPath(clean)
+		present, err := u.markerExists(marker)
+		if err != nil {
+			return err
+		}
+		if present {
+			return u.layer.Remove(marker)
+		}
+	}
+	return &os.PathError{Op: "restore", Path: name, Err: os.ErrNotExist}
+}
+
+// Flatten writes the view the overlay shows into dst: directories are created,
+// files are copied with their contents and modification times, and nothing the
+// overlay hides is written.
+func (u *CopyOnWriteFs) Flatten(dst Fs) error {
+	return u.flattenPath(dst, FilePathSeparator)
+}
+
+func (u *CopyOnWriteFs) flattenPath(dst Fs, name string) error {
+	fi, err := u.Stat(name)
+	if err != nil {
+		return err
+	}
+	if err := u.clearConflicting(dst, name, fi.IsDir()); err != nil {
+		return err
+	}
+	if !fi.IsDir() {
+		return copyVisibleFile(u, dst, name, fi)
+	}
+	if err := dst.MkdirAll(name, fi.Mode()); err != nil {
+		return err
+	}
+	infos, err := u.mergedInfos(name)
+	if err != nil {
+		return err
+	}
+	for _, entry := range infos {
+		if err := u.flattenPath(dst, filepath.Join(name, entry.Name())); err != nil {
+			return err
+		}
+	}
+	if isPathRoot(overlayPath(name)) {
+		return nil
+	}
+	if err := dst.Chmod(name, fi.Mode().Perm()); err != nil {
+		return err
+	}
+	return dst.Chtimes(name, fi.ModTime(), fi.ModTime())
+}
+
+// clearConflicting drops a destination entry that is there as the other kind, so
+// the view lands whole rather than on top of something it cannot overwrite.
+func (u *CopyOnWriteFs) clearConflicting(dst Fs, name string, wantDir bool) error {
+	dfi, err := dst.Stat(name)
+	if err != nil {
+		if u.isNotExist(err) || os.IsNotExist(err) {
+			return nil
+		}
+		return err
+	}
+	if dfi.IsDir() == wantDir {
+		return nil
+	}
+	return dst.RemoveAll(name)
+}
+
+func copyVisibleFile(src Fs, dst Fs, name string, fi os.FileInfo) error {
+	in, err := src.Open(name)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+
+	if err := dst.MkdirAll(filepath.Dir(name), 0o777); err != nil {
+		return err
+	}
+	out, err := dst.OpenFile(name, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, fi.Mode())
+	if err != nil {
+		return err
+	}
+	if _, err := io.Copy(out, in); err != nil {
+		out.Close()
+		return err
+	}
+	if err := out.Close(); err != nil {
+		return err
+	}
+	if err := dst.Chmod(name, fi.Mode().Perm()); err != nil {
+		return err
+	}
+	return dst.Chtimes(name, fi.ModTime(), fi.ModTime())
+}
+
+// Deleted reports the paths the overlay currently hides, slash separated and
+// rooted at the overlay, sorted, leaving out anything that is only out of sight
+// because a directory above it is. An overlay without deletion support reports
+// nothing.
+func (u *CopyOnWriteFs) Deleted() ([]string, error) {
+	if !u.deletions {
+		return []string{}, nil
+	}
+	var found []string
+	err := Walk(u.layer, FilePathSeparator, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			if u.isNotExist(err) || os.IsNotExist(err) {
+				return nil
+			}
+			return err
+		}
+		if info == nil || info.IsDir() {
+			return nil
+		}
+		if !strings.HasPrefix(info.Name(), deletionMarkerPrefix) {
+			return nil
+		}
+		target := filepath.Join(filepath.Dir(path), strings.TrimPrefix(info.Name(), deletionMarkerPrefix))
+		found = append(found, filepath.ToSlash(target))
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	sort.Strings(found)
+
+	pruned := make([]string, 0, len(found))
+	for _, candidate := range found {
+		covered := false
+		for _, kept := range pruned {
+			if candidate == kept || strings.HasPrefix(candidate, strings.TrimSuffix(kept, "/")+"/") {
+				covered = true
+				break
+			}
+		}
+		if !covered {
+			pruned = append(pruned, candidate)
+		}
+	}
+	return pruned, nil
+}
