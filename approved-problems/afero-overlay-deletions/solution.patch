index 0000000..a1c7dea
--- /dev/null
+++ b/overlayDir.go
@@ -0,0 +1,166 @@
+package afero
+
+import (
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+)
+
+// overlayDir is the directory handle CopyOnWriteFs hands out. It answers
+// Readdir and Readdirnames from the merged view of the two layers so the order
+// is stable and the layer's removal bookkeeping never shows up.
+type overlayDir struct {
+	*UnionFile
+	fs     *CopyOnWriteFs
+	path   string
+	off    int
+	infos  []os.FileInfo
+	loaded bool
+}
+
+func (u *CopyOnWriteFs) asDirectory(name string, lfile, bfile File) (File, error) {
+	probe := lfile
+	if probe == nil {
+		probe = bfile
+	}
+	fi, err := probe.Stat()
+	if err != nil {
+		probe.Close()
+		return nil, err
+	}
+	if !fi.IsDir() {
+		return probe, nil
+	}
+	return &overlayDir{
+		UnionFile: &UnionFile{Base: bfile, Layer: lfile},
+		fs:        u,
+		path:      name,
+	}, nil
+}
+
+func (d *overlayDir) Close() error {
+	var err error
+	if d.UnionFile.Base != nil {
+		err = d.UnionFile.Base.Close()
+	}
+	if d.UnionFile.Layer != nil {
+		if lerr := d.UnionFile.Layer.Close(); err == nil {
+			err = lerr
+		}
+	}
+	return err
+}
+
+func (d *overlayDir) Readdir(c int) ([]os.FileInfo, error) {
+	if !d.loaded {
+		infos, err := d.fs.mergedInfos(d.path)
+		if err != nil {
+			return nil, err
+		}
+		d.infos = infos
+		d.loaded = true
+	}
+
+	files := d.infos[d.off:]
+	if c <= 0 {
+		return files, nil
+	}
+	if len(files) == 0 {
+		return nil, io.EOF
+	}
+	if c > len(files) {
+		c = len(files)
+	}
+	d.off += c
+	return files[:c], nil
+}
+
+func (d *overlayDir) Readdirnames(c int) ([]string, error) {
+	infos, err := d.Readdir(c)
+	if err != nil {
+		return nil, err
+	}
+	var names []string
+	for _, fi := range infos {
+		names = append(names, fi.Name())
+	}
+	return names, nil
+}
+
+func (u *CopyOnWriteFs) copyBaseFileAs(src, dst string) error {
+	base, layer := u.base, u.layer
+
+	bfh, err := base.Open(src)
+	if err != nil {
+		return err
+	}
+	defer bfh.Close()
+
+	if err := u.ensureLayerDir(filepath.Dir(dst)); err != nil {
+		return err
+	}
+
+	bfi, err := bfh.Stat()
+	if err != nil {
+		return err
+	}
+
+	lfh, err := layer.OpenFile(dst, os.O_CREATE|os.O_TRUNC|os.O_WRONLY, bfi.Mode().Perm())
+	if err != nil {
+		return err
+	}
+	if _, err := io.Copy(lfh, bfh); err != nil {
+		lfh.Close()
+		layer.Remove(dst)
+		return err
+	}
+	if err := lfh.Close(); err != nil {
+		layer.Remove(dst)
+		return err
+	}
+
+	if err := layer.Chmod(dst, bfi.Mode().Perm()); err != nil {
+		return err
+	}
+	return layer.Chtimes(dst, bfi.ModTime(), bfi.ModTime())
+}
+
+// materializeSubtree pulls everything the overlay shows at name into the layer
+// so the layer alone can carry it, and drops the removal bookkeeping that has
+// been satisfied by the copy.
+func (u *CopyOnWriteFs) materializeSubtree(name string) error {
+	clean := filepath.Clean(name)
+	fi, err := u.Stat(clean)
+	if err != nil {
+		return err
+	}
+
+	if !fi.IsDir() {
+		if _, err := u.layer.Stat(clean); err == nil {
+			return nil
+		} else if !u.isNotExist(err) && !os.IsNotExist(err) {
+			return err
+		}
+		return u.copyBaseFileAs(clean, clean)
+	}
+
+	infos, err := u.mergedInfos(clean)
+	if err != nil {
+		return err
+	}
+	if err := u.ensureLayerDir(clean); err != nil {
+		return err
+	}
+	names := make([]string, 0, len(infos))
+	for _, entry := range infos {
+		names = append(names, entry.Name())
+	}
+	sort.Strings(names)
+	for _, entry := range names {
+		if err := u.materializeSubtree(filepath.Join(clean, entry)); err != nil {
+			return err
+		}
+	}
+	return u.stripBookkeeping(clean)
+}
