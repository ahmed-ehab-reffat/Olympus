+		ovlWrite(t, base, name, "x")
+	}
+	u := ovlOverlay(base, afero.NewMemMapFs())
+	ovlWrite(t, u, "/box/beta", "y")
+
+	fh, err := u.Open("/box")
+	if err != nil {
+		t.Fatalf("open: %v", err)
+	}
+	defer fh.Close()
+
+	var got []string
+	for round := 0; ; round++ {
+		if round > 8 {
+			t.Fatalf("chunked Readdir never reported io.EOF, got %v so far", got)
+		}
+		infos, err := fh.Readdir(2)
+		for _, fi := range infos {
+			got = append(got, fi.Name())
+		}
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatalf("readdir: %v", err)
+		}
+		if len(infos) == 0 {
+			t.Fatal("readdir returned nothing without reporting io.EOF")
+		}
+	}
+	want := []string{"alpha", "beta", "mike", "zeta"}
+	if strings.Join(got, ",") != strings.Join(want, ",") {
+		t.Fatalf("chunked Readdir gave %v, want %v", got, want)
+	}
+}
