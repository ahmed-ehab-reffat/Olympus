+func ovlMode(t *testing.T, fs afero.Fs, path string) os.FileMode {
+	t.Helper()
+	fi, err := fs.Stat(path)
+	if err != nil {
+		t.Fatalf("stat %s: %v", path, err)
+	}
+	return fi.Mode().Perm()
+}
+
+func ovlModTime(t *testing.T, fs afero.Fs, path string) time.Time {
+	t.Helper()
+	fi, err := fs.Stat(path)
+	if err != nil {
+		t.Fatalf("stat %s: %v", path, err)
+	}
+	return fi.ModTime()
+}
+
+func ovlStamped(t *testing.T) (afero.Fs, afero.Fs, *afero.CopyOnWriteFs) {
+	t.Helper()
+	base := afero.NewMemMapFs()
+	ovlWrite(t, base, "/data/notes.txt", "base notes")
+	ovlWrite(t, base, "/data/keep.txt", "base keep")
+	ovlWrite(t, base, "/data/deep/inner.txt", "base inner")
+	if err := base.Chmod("/data", 0o750); err != nil {
+		t.Fatalf("chmod: %v", err)
+	}
+	if err := base.Chmod("/data/deep", 0o711); err != nil {
+		t.Fatalf("chmod: %v", err)
+	}
+	stamp := time.Unix(1700000000, 0)
+	if err := base.Chtimes("/data", stamp, stamp); err != nil {
+		t.Fatalf("chtimes: %v", err)
+	}
+	layer := afero.NewMemMapFs()
+	return base, layer, ovlOverlay(base, layer)
+}
