+func TestOverlayMixedRootRemovalAndSelectiveRestore(t *testing.T) {
+	base := afero.NewMemMapFs()
+	ovlWrite(t, base, "/baseonly.txt", "base only")
+	ovlWrite(t, base, "/shared.txt", "base shared")
+	ovlWrite(t, base, "/gone.txt", "base gone")
+	ovlWrite(t, base, "/tree/leaf.txt", "base leaf")
+	layer := afero.NewMemMapFs()
+	u := ovlOverlay(base, layer)
+	ovlWrite(t, u, "/layeronly.txt", "layer only")
+	ovlWrite(t, u, "/shared.txt", "layer shared")
+	if err := u.Remove("/gone.txt"); err != nil {
+		t.Fatalf("remove: %v", err)
+	}
+
+	if err := u.RemoveAll("/"); err != nil {
+		t.Fatalf("removeall root: %v", err)
+	}
+	ovlRequireNames(t, u, "/")
+	for _, path := range []string{"/baseonly.txt", "/shared.txt", "/layeronly.txt", "/tree/leaf.txt"} {
+		if ovlExists(t, u, path) {
+			t.Fatalf("%s is still visible after the root was cleared", path)
+		}
+	}
+
+	again := ovlOverlay(base, layer)
+	ovlRequireNames(t, again, "/")
+	ovlRequireDeleted(t, again, "/baseonly.txt", "/gone.txt", "/shared.txt", "/tree")
+
+	if err := again.Restore("/tree"); err != nil {
+		t.Fatalf("restore: %v", err)
+	}
+	if got := ovlRead(t, again, "/tree/leaf.txt"); got != "base leaf" {
+		t.Fatalf("restored content = %q", got)
+	}
+	ovlRequireNames(t, again, "/", "tree")
+	ovlRequireDeleted(t, again, "/baseonly.txt", "/gone.txt", "/shared.txt")
+}
