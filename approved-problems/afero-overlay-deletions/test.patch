+func TestOverlayRebuiltIntermediateDirectoriesTakeBaseMetadata(t *testing.T) {
+	base := afero.NewMemMapFs()
+	ovlWrite(t, base, "/a/b/c/leaf.txt", "leaf")
+	modes := map[string]os.FileMode{"/a": 0o750, "/a/b": 0o711, "/a/b/c": 0o705}
+	stamp := time.Unix(1650000000, 0)
+	for dir, mode := range modes {
+		if err := base.Chmod(dir, mode); err != nil {
+			t.Fatalf("chmod %s: %v", dir, err)
+		}
+		if err := base.Chtimes(dir, stamp, stamp); err != nil {
+			t.Fatalf("chtimes %s: %v", dir, err)
+		}
+	}
+	u := ovlOverlay(base, afero.NewMemMapFs())
+	if err := u.RemoveAll("/a"); err != nil {
+		t.Fatalf("removeall: %v", err)
+	}
+
+	fh, err := u.OpenFile("/a/b/c/made.txt", os.O_CREATE|os.O_WRONLY, 0o642)
+	if err != nil {
+		t.Fatalf("openfile: %v", err)
+	}
+	fh.Close()
+
+	for dir, want := range modes {
+		if got := ovlMode(t, u, dir); got != want {
+			t.Fatalf("permissions of the rebuilt %s = %v, want %v", dir, got, want)
+		}
+		if got := ovlModTime(t, u, dir); !got.Equal(stamp) {
+			t.Fatalf("modification time of the rebuilt %s = %v, want %v", dir, got, stamp)
+		}
+	}
+	if got := ovlMode(t, u, "/a/b/c/made.txt"); got != 0o642 {
+		t.Fatalf("permissions of the created file = %v, want 0642", got)
+	}
+	if ovlExists(t, u, "/a/b/c/leaf.txt") {
+		t.Fatal("a base child came back with the rebuilt directories")
+	}
+}
