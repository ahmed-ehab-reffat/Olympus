+func ovlMixedTree(t *testing.T) (afero.Fs, *afero.CopyOnWriteFs) {
+	t.Helper()
+	base := afero.NewMemMapFs()
+	ovlWrite(t, base, "/src/shared.txt", "base shared")
+	ovlWrite(t, base, "/src/gone.txt", "base gone")
+	ovlWrite(t, base, "/src/only.txt", "base only")
+	ovlWrite(t, base, "/src/sub/leaf.txt", "base leaf")
+	u := ovlOverlay(base, afero.NewMemMapFs())
+	ovlWrite(t, u, "/src/shared.txt", "layer shared")
+	ovlWrite(t, u, "/src/added.txt", "layer added")
+	if err := u.Remove("/src/gone.txt"); err != nil {
+		t.Fatalf("remove: %v", err)
+	}
+	return base, u
+}
