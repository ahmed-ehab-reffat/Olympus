+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/afero-report.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+
+export GOFLAGS=-buildvcs=false
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+export GOPATH="${GOPATH:-/tmp/gopath}"
+mkdir -p "$GOCACHE" "$GOPATH" 2>/dev/null
+
+NEW_PKG="./overlaydel78e863"
+NEW_FILE="overlaydel78e863/overlay_deletions_78e863_test.go"
+NEW_CLASS="github.com/spf13/afero/overlaydel78e863"
+
+has_named_cases() {
+  [ -s "$OUTPUT_PATH" ] && grep -q 'name="TestOverlay' "$OUTPUT_PATH"
+}
+
+synthesize_failures() {
+  reason="$1"
+  names=$(grep -oE '^func (TestOverlay[A-Za-z0-9_]+)' "$NEW_FILE" 2>/dev/null | awk '{print $2}')
+  if [ -z "$names" ]; then
+    names="TestOverlayPackageBuild"
+  fi
+  count=$(printf '%s\n' "$names" | wc -l | tr -d ' ')
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites>\n'
+    printf '<testsuite name="%s" tests="%s" failures="%s" errors="0" time="0">\n' "$NEW_CLASS" "$count" "$count"
+    printf '%s\n' "$names" | while IFS= read -r n; do
+      [ -z "$n" ] && continue
+      printf '<testcase name="%s" classname="%s" time="0"><failure message="%s">%s</failure></testcase>\n' \
+        "$n" "$NEW_CLASS" "$reason" "$reason"
+    done
+    printf '</testsuite>\n'
+    printf '</testsuites>\n'
+  } > "$OUTPUT_PATH"
+}
+
+if [ "$MODE" = "base" ]; then
+  go test -v -count=1 . ./mem ./tarfs ./zipfs 2>&1 | go-junit-report > "$OUTPUT_PATH"
+  status=${PIPESTATUS[0]}
+  exit "$status"
+fi
+
+go test -v -count=1 "$NEW_PKG" 2>&1 | go-junit-report > "$OUTPUT_PATH"
+status=${PIPESTATUS[0]}
+if ! has_named_cases; then
+  synthesize_failures "the overlay deletion package does not build"
+  exit 1
+fi
+exit "$status"
