+type ovlFailingFs struct {
+	afero.Fs
+	failOn      string
+	failChmod   string
+	failChtimes string
+	failOpen    string
+}
+
+func ovlHits(name, want string) bool {
+	if want == "" {
+		return false
+	}
+	return strings.HasSuffix(filepath.ToSlash(filepath.Clean(name)), want)
+}
+
+func (f *ovlFailingFs) Chmod(name string, mode os.FileMode) error {
+	if ovlHits(name, f.failChmod) {
+		return &os.PathError{Op: "chmod", Path: name, Err: syscall.EACCES}
+	}
+	return f.Fs.Chmod(name, mode)
+}
+
+func (f *ovlFailingFs) Chtimes(name string, atime, mtime time.Time) error {
+	if ovlHits(name, f.failChtimes) {
+		return &os.PathError{Op: "chtimes", Path: name, Err: syscall.EACCES}
+	}
+	return f.Fs.Chtimes(name, atime, mtime)
+}
+
+func (f *ovlFailingFs) Open(name string) (afero.File, error) {
+	if ovlHits(name, f.failOpen) {
+		return nil, &os.PathError{Op: "open", Path: name, Err: syscall.EACCES}
+	}
+	return f.Fs.Open(name)
+}
+
+func (f *ovlFailingFs) OpenFile(name string, flag int, perm os.FileMode) (afero.File, error) {
+	if ovlHits(name, f.failOn) {
+		return nil, &os.PathError{Op: "open", Path: name, Err: syscall.EACCES}
+	}
+	return f.Fs.OpenFile(name, flag, perm)
+}
