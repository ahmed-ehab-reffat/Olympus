+func ovlDeepStamped(t *testing.T) (afero.Fs, *afero.CopyOnWriteFs, time.Time) {
+	t.Helper()
+	base := afero.NewMemMapFs()
+	ovlWrite(t, base, "/a/b/c/leaf.txt", "leaf")
+	ovlWrite(t, base, "/a/f.txt", "f")
+	stamp := time.Unix(1700000000, 0)
+	for _, dir := range []string{"/a", "/a/b", "/a/b/c"} {
+		if err := base.Chtimes(dir, stamp, stamp); err != nil {
+			t.Fatalf("chtimes %s: %v", dir, err)
+		}
+	}
+	return base, ovlOverlay(base, afero.NewMemMapFs()), stamp
+}
+
+func ovlRequireAncestorTimes(t *testing.T, fs afero.Fs, want time.Time) {
+	t.Helper()
+	for _, dir := range []string{"/a", "/a/b", "/a/b/c"} {
+		if got := ovlModTime(t, fs, dir); !got.Equal(want) {
+			t.Fatalf("modification time of %s = %v, want %v", dir, got, want)
+		}
+	}
+}
