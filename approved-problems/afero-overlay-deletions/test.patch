+func ovlDiskOverlay(t *testing.T) (string, *afero.CopyOnWriteFs) {
+	t.Helper()
+	root := t.TempDir()
+	baseDir := filepath.Join(root, "base")
+	layerDir := filepath.Join(root, "layer")
+	if err := os.MkdirAll(filepath.Join(baseDir, "data"), 0o755); err != nil {
+		t.Fatalf("mkdir base: %v", err)
+	}
+	if err := os.MkdirAll(layerDir, 0o755); err != nil {
+		t.Fatalf("mkdir layer: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(baseDir, "data", "target.txt"), []byte("target"), 0o644); err != nil {
+		t.Fatalf("write target: %v", err)
+	}
+	if err := os.Symlink("target.txt", filepath.Join(baseDir, "data", "link.txt")); err != nil {
+		t.Skipf("symlinks unavailable: %v", err)
+	}
+	base := afero.NewBasePathFs(afero.NewOsFs(), baseDir)
+	layer := afero.NewBasePathFs(afero.NewOsFs(), layerDir)
+	return root, ovlOverlay(base, layer)
+}
