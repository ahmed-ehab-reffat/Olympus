+func ovlWrite(t *testing.T, fs afero.Fs, path, data string) {
+	t.Helper()
+	if err := fs.MkdirAll(ovlDir(path), 0o777); err != nil {
+		t.Fatalf("mkdirall %s: %v", ovlDir(path), err)
+	}
+	fh, err := fs.Create(path)
+	if err != nil {
+		t.Fatalf("create %s: %v", path, err)
+	}
+	if _, err := fh.WriteString(data); err != nil {
+		t.Fatalf("write %s: %v", path, err)
+	}
+	if err := fh.Close(); err != nil {
+		t.Fatalf("close %s: %v", path, err)
+	}
+}
+
+func ovlDir(path string) string {
+	idx := strings.LastIndex(path, "/")
+	if idx <= 0 {
+		return "/"
+	}
+	return path[:idx]
+}
+
+func ovlMkdir(t *testing.T, fs afero.Fs, path string) {
+	t.Helper()
+	if err := fs.MkdirAll(path, 0o777); err != nil {
+		t.Fatalf("mkdirall %s: %v", path, err)
+	}
+}
+
+func ovlOverlay(base, layer afero.Fs) *afero.CopyOnWriteFs {
+	return afero.NewCopyOnWriteFsWithDeletions(afero.NewReadOnlyFs(base), layer)
+}
+
+func ovlSample(t *testing.T) (afero.Fs, afero.Fs, *afero.CopyOnWriteFs) {
+	t.Helper()
+	base := afero.NewMemMapFs()
+	layer := afero.NewMemMapFs()
+	ovlWrite(t, base, "/data/notes.txt", "base notes")
+	ovlWrite(t, base, "/data/keep.txt", "base keep")
+	ovlWrite(t, base, "/data/deep/inner.txt", "base inner")
+	return base, layer, ovlOverlay(base, layer)
+}
+
+func ovlRead(t *testing.T, fs afero.Fs, path string) string {
+	t.Helper()
+	fh, err := fs.Open(path)
+	if err != nil {
+		t.Fatalf("open %s: %v", path, err)
+	}
+	defer fh.Close()
+	buf, err := io.ReadAll(fh)
+	if err != nil {
+		t.Fatalf("read %s: %v", path, err)
+	}
+	return string(buf)
+}
+
+func ovlNames(t *testing.T, fs afero.Fs, dir string) []string {
+	t.Helper()
+	fh, err := fs.Open(dir)
+	if err != nil {
+		t.Fatalf("open %s: %v", dir, err)
+	}
+	defer fh.Close()
+	names, err := fh.Readdirnames(-1)
+	if err != nil {
+		t.Fatalf("readdirnames %s: %v", dir, err)
+	}
+	return names
+}
+
+func ovlEqual(got, want []string) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for i := range got {
+		if got[i] != want[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func ovlRequireNames(t *testing.T, fs afero.Fs, dir string, want ...string) {
+	t.Helper()
+	got := ovlNames(t, fs, dir)
+	if !ovlEqual(got, want) {
+		t.Fatalf("listing of %s = %v, want %v", dir, got, want)
+	}
+}
+
+func ovlRequireGone(t *testing.T, err error, op, path string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("%s %s: expected an error", op, path)
+	}
+	perr, ok := err.(*os.PathError)
+	if !ok {
+		t.Fatalf("%s %s: error %v is not an *os.PathError", op, path, err)
+	}
+	if perr.Path != path {
+		t.Fatalf("%s %s: error Path is %q", op, path, perr.Path)
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("%s %s: error %v is not os.ErrNotExist", op, path, err)
+	}
+}
+
+type ovlReporter interface {
+	Deleted() ([]string, error)
+	Restore(name string) error
+	Flatten(dst afero.Fs) error
+}
+
+func ovlRequireNotExist(t *testing.T, err error, what string) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("%s: expected an error", what)
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("%s: error %v is not os.ErrNotExist", what, err)
+	}
+}
+
+func ovlRequireDeleted(t *testing.T, u ovlReporter, want ...string) {
+	t.Helper()
+	got, err := u.Deleted()
+	if err != nil {
+		t.Fatalf("Deleted: %v", err)
+	}
+	if !ovlEqual(got, want) {
+		t.Fatalf("Deleted() = %v, want %v", got, want)
+	}
+}
+
+func ovlExists(t *testing.T, fs afero.Fs, path string) bool {
+	t.Helper()
+	_, err := fs.Stat(path)
+	return err == nil
+}
