+import type {
+  Condition,
+  Context,
+  DatafileContent,
+  Force,
+  GroupSegment,
+  RequiredFeature,
+  Traffic,
+  VariableOverride,
+} from "@featurevisor/types";
+import { allConditionsAreMatched } from "@featurevisor/sdk";
+
+export type Decision = true | false | "unknown";
+
+export interface Specialized<T> {
+  decision: Decision;
+  residual: T;
+}
+
+type Tree = Condition | Condition[] | GroupSegment | GroupSegment[];
+
+export interface SegmentDecisions {
+  [segmentKey: string]: Specialized<Condition | Condition[]>;
+}
+
+const ALWAYS_FALSE = { not: ["*"] };
+
+function parseConditionsIfStringified<T>(value: T): T {
+  if (typeof value !== "string" || value === "*") {
+    return value;
+  }
+
+  try {
+    return JSON.parse(value) as T;
+  } catch {
+    return value;
+  }
+}
+
+function parseSegmentsIfStringified<T>(value: T): T {
+  if (typeof value === "string" && (value.startsWith("{") || value.startsWith("["))) {
+    return JSON.parse(value) as T;
+  }
+
+  return value;
+}
+
+function hasValueAtPath(context: Context, path: string): boolean {
+  let current: unknown = context;
+
+  for (const part of path.split(".")) {
+    if (!current || typeof current !== "object") {
+      return false;
+    }
+
+    current = (current as Record<string, unknown>)[part];
+  }
+
+  return typeof current !== "undefined";
+}
+
+function known<T>(decision: boolean, residual: T): Specialized<T> {
+  return { decision, residual };
+}
+
+function combineAll(
+  children: Specialized<Tree>[],
+  wrap: (items: Tree[]) => Tree,
+): Specialized<Tree> {
+  if (children.some((c) => c.decision === false)) {
+    return known(false, ALWAYS_FALSE as Tree);
+  }
+
+  const unknowns = children.filter((c) => c.decision === "unknown").map((c) => c.residual);
+  if (unknowns.length === 0) {
+    return known(true, "*");
+  }
+
+  return { decision: "unknown", residual: wrap(unknowns) };
+}
+
+function combineAny(children: Specialized<Tree>[]): Specialized<Tree> {
+  if (children.some((c) => c.decision === true)) {
+    return known(true, "*");
+  }
+
+  const unknowns = children.filter((c) => c.decision === "unknown").map((c) => c.residual);
+  if (unknowns.length === 0) {
+    return known(false, ALWAYS_FALSE as Tree);
+  }
+
+  return { decision: "unknown", residual: { or: unknowns } as Tree };
+}
+
+function negate(children: Specialized<Tree>[]): Specialized<Tree> {
+  if (children.length === 0) {
+    return known(false, ALWAYS_FALSE as Tree);
+  }
+
+  const inner = combineAll(children, (items) => items as Tree);
+  if (inner.decision === "unknown") {
+    const items = inner.residual as Tree[];
+    return { decision: "unknown", residual: { not: items } as Tree };
+  }
+
+  return inner.decision ? known(false, ALWAYS_FALSE as Tree) : known(true, "*");
+}
+
+function specializeTree(
+  tree: Tree,
+  decideLeaf: (leaf: Tree) => Specialized<Tree>,
+): Specialized<Tree> {
+  const recurse = (items: Tree[]) => items.map((item) => specializeTree(item, decideLeaf));
+
+  if (tree === "*") {
+    return known(true, "*");
+  }
+
+  if (Array.isArray(tree)) {
+    return combineAll(recurse(tree), (items) => items as Tree);
+  }
+
+  if (typeof tree === "object" && tree !== null) {
+    if ("and" in tree && Array.isArray(tree.and)) {
+      return combineAll(recurse(tree.and as Tree[]), (items) => ({ and: items }) as Tree);
+    }
+
+    if ("or" in tree && Array.isArray(tree.or)) {
+      return combineAny(recurse(tree.or as Tree[]));
+    }
+
+    if ("not" in tree && Array.isArray(tree.not)) {
+      return negate(recurse(tree.not as Tree[]));
+    }
+  }
+
+  return decideLeaf(tree);
+}
+
+export function specializeConditions(
+  conditions: Condition | Condition[],
+  context: Context,
+): Specialized<Condition | Condition[]> {
+  return specializeTree(parseConditionsIfStringified(conditions), (leaf) => {
+    if (typeof leaf === "object" && leaf !== null && "attribute" in leaf) {
+      if (!hasValueAtPath(context, leaf.attribute)) {
+        return { decision: "unknown", residual: leaf };
+      }
+
+      return allConditionsAreMatched(leaf, context)
+        ? known(true, "*")
+        : known(false, ALWAYS_FALSE as Tree);
+    }
+
+    return known(false, ALWAYS_FALSE as Tree);
+  }) as Specialized<Condition | Condition[]>;
+}
+
+export function specializeSegments(
+  segments: GroupSegment | GroupSegment[],
+  segmentDecisions: SegmentDecisions,
+): Specialized<GroupSegment | GroupSegment[]> {
+  return specializeTree(parseSegmentsIfStringified(segments), (leaf) => {
+    if (typeof leaf === "string" && Object.prototype.hasOwnProperty.call(segmentDecisions, leaf)) {
+      const decision = segmentDecisions[leaf].decision;
+
+      if (decision === "unknown") {
+        return { decision, residual: leaf };
+      }
+
+      return known(decision, decision ? "*" : (ALWAYS_FALSE as Tree));
+    }
+
+    return known(false, ALWAYS_FALSE as Tree);
+  }) as Specialized<GroupSegment | GroupSegment[]>;
+}
+
+function and(...decisions: Decision[]): Decision {
+  if (decisions.indexOf(false) !== -1) {
+    return false;
+  }
+
+  return decisions.indexOf("unknown") !== -1 ? "unknown" : true;
+}
+
+function or(...decisions: Decision[]): Decision {
+  if (decisions.indexOf(true) !== -1) {
+    return true;
+  }
+
+  return decisions.indexOf("unknown") !== -1 ? "unknown" : false;
+}
+
+function requiredFeaturesGate(requiredFeatures: RequiredFeature[] | string | undefined): Decision {
+  if (typeof requiredFeatures === "undefined") {
+    return true;
+  }
+
+  return Array.isArray(requiredFeatures) && requiredFeatures.length === 0 ? true : "unknown";
+}
+
+interface Selectors {
+  conditions?: unknown;
+  segments?: unknown;
+}
+
+class EntrySpecializer {
+  constructor(
+    private context: Context,
+    private segmentDecisions: SegmentDecisions,
+  ) {}
+
+  conditions(entry: Selectors): Decision {
+    const result = specializeConditions(entry.conditions as Condition, this.context);
+    entry.conditions = result.residual;
+    return result.decision;
+  }
+
+  segments(entry: Selectors): Decision {
+    const result = specializeSegments(entry.segments as GroupSegment, this.segmentDecisions);
+    entry.segments = result.residual;
+    return result.decision;
+  }
+
+  force(force: Force): Decision {
+    const byConditions = force.conditions ? this.conditions(force) : false;
+    const bySegments = force.segments ? this.segments(force) : false;
+
+    if (byConditions === false) {
+      delete force.conditions;
+    }
+    if (bySegments === false) {
+      delete force.segments;
+    }
+
+    return or(byConditions, bySegments);
+  }
+
+  traffic(traffic: Traffic): Decision {
+    return this.segments(traffic);
+  }
+
+  featureOverride(override: VariableOverride): Decision {
+    const gate = requiredFeaturesGate(override.requiredFeatures as RequiredFeature[]);
+
+    if (override.conditions) {
+      return and(gate, this.conditions(override));
+    }
+
+    if (override.segments) {
+      return and(gate, this.segments(override));
+    }
+
+    return typeof override.requiredFeatures !== "undefined" ? gate : false;
+  }
+
+  globalOverride(override: Selectors & { requiredFeatures?: RequiredFeature[] }): Decision {
+    const gate = requiredFeaturesGate(override.requiredFeatures);
+    const bySegments = override.segments ? this.segments(override) : true;
+    const byConditions = override.conditions ? this.conditions(override) : true;
+
+    return and(gate, bySegments, byConditions);
+  }
+}
+
+export function pruneEntries<T>(entries: T[], decide: (entry: T) => Decision): T[] {
+  const remaining: T[] = [];
+
+  for (const entry of entries) {
+    const decision = decide(entry);
+
+    if (decision === false) {
+      continue;
+    }
+
+    remaining.push(entry);
+
+    if (decision === true) {
+      break;
+    }
+  }
+
+  return remaining;
+}
+
+function pruneOverrideMap(
+  overridesByVariable: Record<string, VariableOverride[]> | undefined,
+  decide: (override: VariableOverride) => Decision,
+) {
+  if (!overridesByVariable) {
+    return;
+  }
+
+  for (const variableKey of Object.keys(overridesByVariable)) {
+    overridesByVariable[variableKey] = pruneEntries(overridesByVariable[variableKey], decide);
+  }
+}
+
+function collectSegmentKeys(tree: unknown, keys: Set<string>) {
+  if (typeof tree === "string") {
+    if (tree !== "*") {
+      keys.add(tree);
+    }
+    return;
+  }
+
+  if (Array.isArray(tree)) {
+    tree.forEach((item) => collectSegmentKeys(item, keys));
+    return;
+  }
+
+  if (tree && typeof tree === "object") {
+    for (const operator of ["and", "or", "not"]) {
+      collectSegmentKeys((tree as Record<string, unknown>)[operator], keys);
+    }
+  }
+}
+
+function referencedSegmentKeys(datafile: DatafileContent): Set<string> {
+  const keys = new Set<string>();
+  const collectOverrides = (map?: Record<string, VariableOverride[]>) => {
+    Object.values(map || {}).forEach((overrides) =>
+      overrides.forEach((override) => collectSegmentKeys(override.segments, keys)),
+    );
+  };
+
+  for (const feature of Object.values(datafile.features)) {
+    (feature.force || []).forEach((force) => collectSegmentKeys(force.segments, keys));
+    (feature.traffic || []).forEach((traffic) => {
+      collectSegmentKeys(traffic.segments, keys);
+      collectOverrides(traffic.variableOverrides);
+    });
+    (feature.variations || []).forEach((variation) =>
+      collectOverrides(variation.variableOverrides),
+    );
+  }
+
+  for (const variable of Object.values(datafile.variables || {})) {
+    (variable.overrides || []).forEach((override) => collectSegmentKeys(override.segments, keys));
+  }
+
+  return keys;
+}
+
+export function specializeDatafileForTarget(
+  datafile: DatafileContent,
+  context: Context,
+): DatafileContent {
+  const segmentDecisions: SegmentDecisions = {};
+  for (const segmentKey of Object.keys(datafile.segments)) {
+    segmentDecisions[segmentKey] = specializeConditions(
+      datafile.segments[segmentKey].conditions as Condition,
+      context,
+    );
+  }
+
+  const entries = new EntrySpecializer(context, segmentDecisions);
+
+  for (const feature of Object.values(datafile.features)) {
+    if (feature.force) {
+      feature.force = pruneEntries(feature.force, (force) => entries.force(force));
+    }
+
+    if (feature.traffic) {
+      feature.traffic = pruneEntries(feature.traffic, (traffic) => entries.traffic(traffic));
+      feature.traffic.forEach((traffic) =>
+        pruneOverrideMap(traffic.variableOverrides, (o) => entries.featureOverride(o)),
+      );
+    }
+
+    (feature.variations || []).forEach((variation) =>
+      pruneOverrideMap(variation.variableOverrides, (o) => entries.featureOverride(o)),
+    );
+  }
+
+  for (const variable of Object.values(datafile.variables || {})) {
+    if (variable.overrides) {
+      variable.overrides = pruneEntries(variable.overrides, (o) => entries.globalOverride(o));
+    }
+  }
+
+  const referenced = referencedSegmentKeys(datafile);
+  for (const segmentKey of Object.keys(datafile.segments)) {
+    if (!referenced.has(segmentKey)) {
+      delete datafile.segments[segmentKey];
+    } else {
+      datafile.segments[segmentKey].conditions = segmentDecisions[segmentKey].residual;
+    }
+  }
+
+  return datafile;
+}
