diff --git a/packages/core/src/builder/targetSpecialization_cb9400.spec.ts b/packages/core/src/builder/targetSpecialization_cb9400.spec.ts
new file mode 100644
index 00000000..4549531b
--- /dev/null
+++ b/packages/core/src/builder/targetSpecialization_cb9400.spec.ts
@@ -0,0 +1,972 @@
+import * as fs from "fs";
+import * as os from "os";
+import * as path from "path";
+
+import type {
+  Condition,
+  Context,
+  DatafileContent,
+  Feature,
+  GroupSegment,
+  ParsedFeature,
+  Segment,
+} from "@featurevisor/types";
+import { createFeaturevisor } from "@featurevisor/sdk";
+import { parsers } from "@featurevisor/parsers";
+
+import type { ProjectConfig } from "../config";
+import { applyContextToDatafile } from "./applyContextToDatafile";
+import { buildTargetDatafile } from "./buildProject";
+
+type Segments = DatafileContent["segments"];
+type Variables = DatafileContent["variables"];
+
+function datafile(
+  features: Record<string, Feature>,
+  segments: Segments = {},
+  variables?: unknown,
+): DatafileContent {
+  const content: DatafileContent = { schemaVersion: "2", revision: "1", segments, features };
+  if (variables) {
+    content.variables = variables as Variables;
+  }
+  return content;
+}
+
+function segment(conditions: Condition | Condition[]) {
+  return { conditions };
+}
+
+function is(attribute: string, value: string | boolean) {
+  return { attribute, operator: "equals", value } as Condition;
+}
+
+function isNot(attribute: string, value: string) {
+  return { attribute, operator: "notEquals", value } as Condition;
+}
+
+function rule(key: string, segments: GroupSegment | GroupSegment[], extra: object = {}) {
+  return { key, segments, percentage: 100000, ...extra };
+}
+
+function flag(traffic: Feature["traffic"], extra: Partial<Feature> = {}): Feature {
+  return { bucketBy: "userId", traffic, ...extra } as Feature;
+}
+
+function evaluateAll(content: DatafileContent, context: Context) {
+  const f = createFeaturevisor({ datafile: content, logLevel: "fatal" });
+  const globals: Record<string, unknown> = {};
+  for (const key of Object.keys(content.variables || {})) {
+    globals[key] = f.getVariable(key, context);
+  }
+  return { features: f.getFeatureEvaluations(context), globals };
+}
+
+function expectEquivalent(full: DatafileContent, target: Context, contexts: Context[]) {
+  const specialized = applyContextToDatafile(full, target);
+  for (const context of contexts) {
+    expect([context, evaluateAll(specialized, context)]).toEqual([
+      context,
+      evaluateAll(full, { ...context, ...target }),
+    ]);
+  }
+  return specialized;
+}
+
+function ruleKeys(content: DatafileContent, featureKey: string) {
+  return content.features[featureKey].traffic.map((t) => t.key);
+}
+
+const users = [
+  { userId: "u1" },
+  { userId: "u1", country: "de" },
+  { userId: "u2", country: "nl" },
+  { userId: "u3", country: "nl", beta: true },
+  { userId: "u4", beta: false, browser: "chrome" },
+  { userId: "u5", country: "us", browser: "firefox", beta: true },
+];
+
+describe("core: target specialization", function () {
+  describe("undecided attributes", function () {
+    test("notEquals on an attribute the target does not fix stays for runtime", function () {
+      const full = datafile(
+        { f: flag([rule("r1", "notDe", { enabled: false }), rule("r2", "*")]) },
+        { notDe: segment([isNot("country", "de")]) },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r1", "r2"]);
+      expect(Object.keys(result.segments)).toEqual(["notDe"]);
+    });
+
+    test("notExists on an attribute the target does not fix stays for runtime", function () {
+      const full = datafile({
+        f: flag([rule("r1", "*", { enabled: false })], {
+          force: [{ conditions: [{ attribute: "beta", operator: "notExists" }], enabled: true }],
+        }),
+      });
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(result.features.f.force).toHaveLength(1);
+      expect(result.features.f.force?.[0].enabled).toBe(true);
+    });
+
+    test("a nested path the target fixes is decided", function () {
+      const full = datafile(
+        { f: flag([rule("r1", "ios", { enabled: false }), rule("r2", "*")]) },
+        { ios: segment([is("device.os", "ios")]) },
+      );
+
+      const result = expectEquivalent(full, { device: { os: "android" } }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r2"]);
+      expect(result.segments).toEqual({});
+    });
+  });
+
+  describe("decided negations", function () {
+    test("a negative condition the target makes false is removed with its rule", function () {
+      const full = datafile(
+        { f: flag([rule("r1", "notWeb"), rule("r2", "*", { enabled: false })]) },
+        { notWeb: segment([isNot("platform", "web")]) },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r2"]);
+      expect(result.segments).toEqual({});
+    });
+
+    test("not over a decided-false child and an undecided child always matches", function () {
+      const full = datafile(
+        {
+          f: flag([
+            rule("r1", { not: ["ios", "beta"] } as GroupSegment),
+            rule("r2", "*", { enabled: false }),
+          ]),
+        },
+        { ios: segment([is("platform", "ios")]), beta: segment([is("beta", true)]) },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r1"]);
+      expect(result.segments).toEqual({});
+    });
+
+    test("an empty not never matches", function () {
+      const full = datafile(
+        { f: flag([rule("r1", "never"), rule("r2", "*", { enabled: false })]) },
+        { never: segment({ not: [] } as Condition) },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r2"]);
+    });
+
+    test("or over decided-false children and an undecided child keeps only the undecided child", function () {
+      const full = datafile(
+        {
+          f: flag([
+            rule("r1", { or: ["ios", "android", "beta"] } as GroupSegment, { enabled: false }),
+            rule("r2", "*"),
+          ]),
+        },
+        {
+          ios: segment([is("platform", "ios")]),
+          android: segment([is("platform", "android")]),
+          beta: segment([is("beta", true)]),
+        },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r1", "r2"]);
+      expect(Object.keys(result.segments)).toEqual(["beta"]);
+    });
+  });
+
+  describe("traffic rules", function () {
+    test("rules the target can never match are removed", function () {
+      const full = datafile(
+        {
+          f: flag([
+            rule("ios", "ios"),
+            rule("android", "android"),
+            rule("beta", "beta", { enabled: false }),
+            rule("everyone", "*"),
+          ]),
+        },
+        {
+          ios: segment([is("platform", "ios")]),
+          android: segment([is("platform", "android")]),
+          beta: segment([is("beta", true)]),
+        },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["beta", "everyone"]);
+      expect(Object.keys(result.segments)).toEqual(["beta"]);
+    });
+
+    test("rules after one the target always matches are removed", function () {
+      const full = datafile(
+        {
+          f: flag([
+            rule("beta", "beta", { enabled: false }),
+            rule("web", "web"),
+            rule("de", "de", { enabled: false }),
+            rule("everyone", "*", { enabled: false }),
+          ]),
+        },
+        {
+          web: segment([is("platform", "web")]),
+          beta: segment([is("beta", true)]),
+          de: segment([is("country", "de")]),
+        },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["beta", "web"]);
+      expect(Object.keys(result.segments)).toEqual(["beta"]);
+    });
+
+    test("stringified rule segments are specialized", function () {
+      const full = datafile(
+        {
+          f: flag([
+            rule("r1", JSON.stringify({ and: ["web", "beta"] }), { enabled: false }),
+            rule("r2", JSON.stringify(["ios"])),
+            rule("r3", "*"),
+          ]),
+        },
+        {
+          web: segment([is("platform", "web")]),
+          ios: segment([is("platform", "ios")]),
+          beta: segment([is("beta", true)]),
+        },
+      );
+
+      const result = expectEquivalent(full, { platform: "web" }, users);
+
+      expect(ruleKeys(result, "f")).toEqual(["r1", "r3"]);
+      expect(Object.keys(result.segments)).toEqual(["beta"]);
+    });
+  });
+
+  describe("force entries", function () {
+    test("a force matching by conditions or by segments follows either one", function () {
+      const full = datafile(
+        {
+          f: flag([rule("r1", "*", { enabled: false })], {
+            force: [
+              { conditions: [is("platform", "ios")], segments: "beta", enabled: true },
+              { conditions: [is("platform", "ios")], segments: "android", enabled: true },
+              { segments: "de", conditions: [is("platform", "web")], variables: { color: "red" } },
+              { conditions: [is("country", "nl")], enabled: true },
+            ],
+            variablesSchema: {
