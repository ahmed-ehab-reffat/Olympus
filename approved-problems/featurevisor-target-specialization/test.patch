+function mulberry32(seed: number) {
+  return function () {
+    seed |= 0;
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+const ATTRIBUTES: Record<string, (string | boolean)[]> = {
+  platform: ["web", "ios", "android"],
+  country: ["nl", "de", "us"],
+  beta: [true, false],
+  "device.os": ["ios", "android"],
+};
+
+function randomDatafile(random: () => number): DatafileContent {
+  const pick = <T>(items: T[]): T => items[Math.floor(random() * items.length)];
+  const attributes = Object.keys(ATTRIBUTES);
+
+  const leaf = (): Condition => {
+    const attribute = pick(attributes);
+    const operator = pick(["equals", "notEquals", "in", "notIn", "exists", "notExists"]);
+    if (operator === "exists" || operator === "notExists") {
+      return { attribute, operator } as Condition;
+    }
+    if (operator === "in" || operator === "notIn") {
+      return {
+        attribute,
+        operator,
+        value: [pick(ATTRIBUTES[attribute]), pick(ATTRIBUTES[attribute])],
+      } as Condition;
+    }
+    return { attribute, operator, value: pick(ATTRIBUTES[attribute]) } as Condition;
+  };
+
+  const tree = <T>(makeLeaf: () => T, depth: number): T => {
+    const roll = random();
+    if (depth === 0 || roll < 0.4) {
+      return makeLeaf();
+    }
+    const children = Array.from({ length: Math.floor(random() * 3) }, () =>
+      tree(makeLeaf, depth - 1),
+    );
+    if (roll < 0.55) return children as unknown as T;
+    if (roll < 0.7) return { and: children } as unknown as T;
+    if (roll < 0.85) return { or: children } as unknown as T;
+    return { not: children } as unknown as T;
+  };
+
+  const segments: Segments = {};
+  const segmentKeys = ["s1", "s2", "s3", "s4"];
+  for (const key of segmentKeys) {
+    segments[key] = segment(tree(leaf, 2));
+  }
+  const groupSegment = () => tree(() => pick([...segmentKeys, "*"]) as GroupSegment, 2);
+
+  const selector = () => {
+    const roll = random();
+    if (roll < 0.4) return { conditions: tree(leaf, 2) };
+    if (roll < 0.8) return { segments: groupSegment() };
+    return { segments: groupSegment(), requiredFeatures: ["f0"] };
+  };
+
+  const schema = { v: { key: "v", type: "string", defaultValue: "d" } };
+  const features: Record<string, Feature> = {};
+  for (let i = 0; i < 3; i++) {
+    const traffic = Array.from({ length: 1 + Math.floor(random() * 4) }, (_, r) =>
+      rule(`r${r}`, groupSegment(), {
+        percentage: pick([0, 50000, 100000]),
+        enabled: pick([undefined, false]),
+        allocation: [
+          { variation: "a", range: [0, 50000] },
+          { variation: "b", range: [50000, 100000] },
+        ],
+        variableOverrides: {
+          v: Array.from({ length: Math.floor(random() * 3) }, (_, o) => ({
+            ...selector(),
+            value: `rule-${r}-${o}`,
+          })),
+        },
+      }),
+    );
+    const force = Array.from({ length: Math.floor(random() * 3) }, (_, n) => {
+      const roll = random();
+      const base = { enabled: pick([true, false]), variables: { v: `force-${n}` } };
+      if (roll < 0.33) return { conditions: tree(leaf, 1), ...base };
+      if (roll < 0.66) return { segments: groupSegment(), ...base };
+      return { conditions: tree(leaf, 1), segments: groupSegment(), ...base };
+    });
+    features[`f${i}`] = flag(traffic as Feature["traffic"], {
+      force,
+      variablesSchema: schema as Feature["variablesSchema"],
+      variations: [
+        {
+          value: "a",
+          variableOverrides: {
+            v: [{ ...selector(), value: `variation-a` }],
+          },
+        },
+        { value: "b" },
+      ] as Feature["variations"],
+      ...(i > 0 && random() < 0.3 ? { requiredFeatures: ["f0"] } : {}),
+    });
+  }
+
+  const variables = {
+    g: {
+      type: "string",
+      defaultValue: "d",
+      overrides: Array.from({ length: Math.floor(random() * 4) }, (_, o) => {
+        const roll = random();
+        const value = `global-${o}`;
+        if (roll < 0.25) return { conditions: tree(leaf, 2), value };
+        if (roll < 0.5) return { segments: groupSegment(), value };
+        if (roll < 0.75) return { segments: groupSegment(), conditions: tree(leaf, 1), value };
+        return { requiredFeatures: ["f1"], value };
+      }),
+    },
+  };
+
+  return datafile(features, segments, variables);
+}
+
+function contextsWithout(fixed: string[]): Context[] {
+  const free = Object.keys(ATTRIBUTES).filter((a) => fixed.indexOf(a.split(".")[0]) === -1);
+  const contexts: Context[] = [];
+  for (let userIndex = 0; userIndex < 3; userIndex++) {
+    const context: Context = { userId: `user-${userIndex}` };
+    contexts.push({ ...context });
+    free.forEach((attribute, i) => {
+      const values = ATTRIBUTES[attribute];
+      const value = values[(userIndex + i) % values.length];
+      if (attribute === "device.os") {
+        context.device = { os: value };
+      } else {
+        context[attribute] = value;
+      }
+    });
+    contexts.push(context);
+  }
+  return contexts;
+}
