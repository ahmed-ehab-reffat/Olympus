+/// The parts every iterating construct has in common.
+///
+/// The `for` family and the aggregate expressions differ in what they do on
+/// each iteration and in what they leave on the stack, but they walk their
+/// iterables in exactly the same way.
+struct Loop<'a> {
+    iterable: &'a Iterable,
+    variables: &'a [Var],
+    for_vars: &'a ForVars,
+    quantifier: &'a Quantifier,
+}
+
+/// Emits the loop described by `loop_`, using `body` on every iteration.
+///
+/// `body` must leave an I32 on the stack, and the loop keeps going while that
+/// value is 1, exactly as [`emit_for`] describes.
+fn emit_loop<C>(
+    ctx: &mut EmitContext,
+    ir: &IR,
+    loop_: &Loop<'_>,
+    body: C,
+    instr: &mut InstrSeqBuilder,
+) where
+    C: FnOnce(&mut EmitContext, &mut InstrSeqBuilder),
+{
+    match loop_.iterable {
+        Iterable::Range(_) => emit_for_in_range(ctx, ir, loop_, body, instr),
+        Iterable::ExprTuple(_) => {
+            emit_for_in_expr_tuple(ctx, ir, loop_, body, instr)
+        }
+        Iterable::Expr(_) => emit_for_in_expr(ctx, ir, loop_, body, instr),
+        Iterable::PatternSet(_) => {
+            emit_for_in_pattern_set(ctx, ir, loop_, body, instr)
+        }
+    }
+}
+
+/// Iterates over a set of patterns, binding the current pattern's id to the
+/// loop's `item` variable so that `$`, `#`, `@` and `!` inside the body refer
+/// to it.
+fn emit_for_in_pattern_set<C>(
+    ctx: &mut EmitContext,
+    ir: &IR,
+    loop_: &Loop<'_>,
+    body: C,
+    instr: &mut InstrSeqBuilder,
+) where
+    C: FnOnce(&mut EmitContext, &mut InstrSeqBuilder),
+{
+    let Iterable::PatternSet(pattern_set) = loop_.iterable else {
+        unreachable!()
+    };
+
+    let num_patterns = pattern_set.len();
+    let mut patterns = pattern_set.iter();
+    let item = loop_.for_vars.item;
+
+    emit_for(
+        ctx,
+        ir,
+        loop_.for_vars,
+        loop_.quantifier,
+        |ctx, instr, n, _| {
+            set_var(ctx, instr, n, |_, instr| {
+                instr.i64_const(num_patterns as i64);
+            });
+        },
+        |ctx, instr, i| {
+            set_var(ctx, instr, item, |ctx, instr| {
+                load_var(ctx, instr, i);
+                emit_switch(ctx, I64, instr, |ctx, instr| {
+                    if let Some(pattern) = patterns.next() {
+                        instr.i64_const(ctx.pattern_id(*pattern).into());
+                        return true;
+                    }
+                    false
+                });
+            });
+        },
+        body,
+        |_, _, _| {},
+        instr,
+    );
+}
+
+/// Emits an aggregate expression.
+///
+/// The loop itself is the same one the `for` family uses, but the body
+/// accumulates into a variable instead of deciding a quantifier, and the loop
+/// visits every iteration because the body always reports that it can keep
+/// going. Once the loop is done the accumulated value is left on the stack,
+/// unless nothing contributed to it and the operation has no value for that
+/// case, in which case an undefined value is thrown.
+fn emit_for_agg(
+    ctx: &mut EmitContext,
+    ir: &IR,
+    for_agg: &ForAgg,
+    instr: &mut InstrSeqBuilder,
+) {
+    let accum = for_agg.accum;
+    let contributed = for_agg.contributed;
+    let op = for_agg.operation;
+    let is_float = for_agg.is_float;
+    let body_expr = for_agg.body;
+
+    // `min` and `max` start from the first value that contributes, so their
+    // initial value is never read. `count` and `sum` start from zero.
+    set_var(ctx, instr, accum, |_, instr| {
+        if is_float {
+            instr.f64_const(0.0);
+        } else {
+            instr.i64_const(0);
+        }
+    });
+
+    set_var(ctx, instr, contributed, |_, instr| {
+        instr.i64_const(0);
+    });
+
+    let loop_ = Loop {
+        iterable: &for_agg.iterable,
+        variables: &for_agg.variables,
+        for_vars: &for_agg.for_vars,
+        // The aggregate visits every iteration, so the loop keeps going as
+        // long as the body says so, and the body always says so.
+        quantifier: &Quantifier::All,
+    };
+
+    emit_loop(
+        ctx,
+        ir,
+        &loop_,
+        |ctx, instr| {
+            // An iteration whose value is undefined contributes nothing, so
+            // the accumulator and the flag are both left untouched.
+            catch_undef(
+                ctx,
+                None,
+                instr,
+                |ctx, instr| {
+                    emit_agg_accumulate(
+                        ctx, ir, op, is_float, body_expr, accum, contributed,
+                        instr,
+                    );
+                },
+                |_, _| {},
+            );
+            instr.i32_const(1);
+        },
+        instr,
+    );
+
+    // Drop whatever the loop left on the stack, the aggregate's value is in
+    // the accumulator.
+    instr.drop();
+
+    match op {
+        AggOp::Count | AggOp::Sum => {
+            load_var(ctx, instr, accum);
+        }
+        AggOp::Avg => {
+            // An average of nothing has no value, and otherwise it is the
+            // accumulated sum divided by the number of contributions.
+            load_var(ctx, instr, contributed);
+            instr.i64_const(0);
+            instr.binop(BinaryOp::I64Eq);
+            instr.if_else(
+                None,
+                |then_| {
+                    throw_undef(ctx, then_);
+                },
+                |_| {},
+            );
+            load_var(ctx, instr, accum);
+            if !is_float {
+                instr.unop(UnaryOp::F64ConvertSI64);
+            }
+            load_var(ctx, instr, contributed);
+            instr.unop(UnaryOp::F64ConvertSI64);
+            instr.binop(BinaryOp::F64Div);
+        }
+        AggOp::Min | AggOp::Max => {
+            // With nothing to compare there is no minimum nor maximum.
+            load_var(ctx, instr, contributed);
+            instr.i64_const(0);
+            instr.binop(BinaryOp::I64Eq);
+            instr.if_else(
+                None,
+                |then_| {
+                    throw_undef(ctx, then_);
+                },
+                |_| {},
+            );
+            load_var(ctx, instr, accum);
+        }
+    }
+}
+
+/// Emits the code that folds one iteration into the accumulator.
+#[allow(clippy::too_many_arguments)]
+fn emit_agg_accumulate(
+    ctx: &mut EmitContext,
+    ir: &IR,
+    op: AggOp,
+    is_float: bool,
+    body: ExprId,
+    accum: Var,
+    contributed: Var,
+    instr: &mut InstrSeqBuilder,
+) {
+    match op {
+        AggOp::Count => {
+            emit_bool_expr(ctx, ir, body, instr);
+            instr.if_else(
+                None,
+                |then_| {
+                    incr_var(ctx, then_, accum);
+                    incr_var(ctx, then_, contributed);
+                },
+                |_| {},
+            );
+            // `count` is done, an iteration that is false still counts as
+            // having been looked at, but there is nothing to accumulate.
+            return;
+        }
+        AggOp::Sum | AggOp::Avg => {
+            set_var(ctx, instr, accum, |ctx, instr| {
+                load_var(ctx, instr, accum);
+                emit_expr(ctx, ir, body, instr);
+                if is_float {
+                    instr.binop(BinaryOp::F64Add);
+                } else {
+                    instr.binop(BinaryOp::I64Add);
+                }
+            });
+        }
+        AggOp::Min | AggOp::Max => {
+            let tmp = if is_float {
+                ctx.wasm_symbols.f64_tmp
+            } else {
+                ctx.wasm_symbols.i64_tmp_a
+            };
+
+            emit_expr(ctx, ir, body, instr);
+            instr.local_set(tmp);
+
+            // The first value that contributes becomes the accumulator, the
+            // rest replace it only when they compare better against it.
+            set_var(ctx, instr, accum, |ctx, instr| {
+                instr.local_get(tmp);
+                load_var(ctx, instr, accum);
+
+                load_var(ctx, instr, contributed);
+                instr.i64_const(0);
+                instr.binop(BinaryOp::I64Eq);
+
+                instr.local_get(tmp);
+                load_var(ctx, instr, accum);
+                match (op, is_float) {
+                    (AggOp::Min, true) => instr.binop(BinaryOp::F64Lt),
+                    (AggOp::Min, false) => instr.binop(BinaryOp::I64LtS),
+                    (_, true) => instr.binop(BinaryOp::F64Gt),
+                    (_, false) => instr.binop(BinaryOp::I64GtS),
+                };
+
+                instr.binop(BinaryOp::I32Or);
+                instr.select(None);
+            });
+        }
+    }
+
+    incr_var(ctx, instr, contributed);
+}
