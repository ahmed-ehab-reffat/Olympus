+fn matches_in_both_scan_modes(src: &str, data: &[u8]) -> (bool, bool) {
+    let rules = yara_x::compile(src)
+        .unwrap_or_else(|e| panic!("compile error:\n{e}"));
+
+    let mut normal = Scanner::new(&rules);
+    let a = normal.scan(data).expect("scan failed").matching_rules().len() > 0;
+
+    let mut fast = Scanner::new(&rules);
+    fast.fast_scan(true);
+    let b = fast.scan(data).expect("scan failed").matching_rules().len() > 0;
+
+    (a, b)
+}
