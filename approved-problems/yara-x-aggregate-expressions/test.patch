+use assert_cmd::{Command, cargo_bin};
+use assert_fs::TempDir;
+use assert_fs::prelude::*;
+
+/// Runs `yr deps` and returns one entry per non-empty output line, stripped of
+/// the tree drawing characters so the assertions do not depend on them.
+fn dep_lines(source: &str) -> Vec<String> {
+    let temp_dir = TempDir::new().unwrap();
+    let input_file = temp_dir.child("rule.yar");
+    input_file.write_str(source).unwrap();
+
+    let output = Command::new(cargo_bin!("yr"))
+        .arg("deps")
+        .arg(input_file.path())
+        .output()
+        .unwrap();
+
+    String::from_utf8(output.stdout)
+        .unwrap()
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .map(|line| {
+            line.trim_matches(|c: char| !c.is_alphanumeric() && c != '_')
+                .to_string()
+        })
+        .collect()
+}
+
+/// How many times `name` appears in the reported tree. A rule that is only
+/// declared appears once; one that is also someone's dependency appears again.
+fn mentions(lines: &[String], name: &str) -> usize {
+    lines.iter().filter(|line| line.contains(name)).count()
+}
+
+#[test]
+fn aggregate_loop_variable_is_not_a_dependency() {
+    let lines = dep_lines(
+        r#"rule i { condition: true }
+           rule agg_test { condition: for sum i in (1..3) : ( i ) == 6 }"#,
+    );
+    // The rule has to be reported at all, otherwise a source that failed to
+    // compile would satisfy the count below by accident.
+    assert_eq!(
+        mentions(&lines, "agg_test"),
+        1,
+        "the aggregate rule was not reported: {lines:?}"
+    );
+    assert_eq!(
+        mentions(&lines, "i"),
+        1,
+        "the aggregate's loop variable was reported as a dependency: {lines:?}"
+    );
+}
+
+#[test]
+fn aggregate_over_patterns_keeps_real_dependencies() {
+    let lines = dep_lines(
+        r#"rule helper { condition: true }
+           rule agg_test {
+               strings: $a = "AAAA"
+               condition: helper and for sum of them : ( # ) == 1
+           }"#,
+    );
+    assert_eq!(
+        mentions(&lines, "helper"),
+        2,
+        "a real rule dependency went missing: {lines:?}"
+    );
+}
+
+#[test]
+fn dependencies_inside_every_aggregate_child_are_found() {
+    // A rule referenced from the body, from a range bound, from a quantifier
+    // and from a tuple item must each be reported, which only holds if the
+    // walk descends into all of the aggregate's children.
+    for condition in [
+        "for count i in (1..2) : ( helper ) == 2",
+        "for sum i in (1 .. for count j in (1..2) : ( helper )) : ( i ) == 3",
+        "for (for count i in (1..2) : ( helper )) j in (1..3) : ( j > 0 )",
+        "for sum x in ((for count i in (1..2) : ( helper )), 5) : ( x ) == 7",
+    ] {
+        let lines = dep_lines(&format!(
+            "rule helper {{ condition: true }}\n\
+             rule agg_test {{ condition: {condition} }}"
+        ));
+        assert_eq!(
+            mentions(&lines, "agg_test"),
+            1,
+            "the aggregate rule was not reported for `{condition}`: {lines:?}"
+        );
+        assert_eq!(
+            mentions(&lines, "helper"),
+            2,
+            "dependency missed for `{condition}`: {lines:?}"
+        );
+    }
+}
+
+#[test]
+fn module_used_inside_an_aggregate_is_reported() {
+    for condition in [
+        "for sum i in (1..2) : ( math.min(i, 5) ) == 3",
+        "for sum i in (1 .. math.min(2, 5)) : ( i ) == 3",
+    ] {
+        let lines = dep_lines(&format!(
+            "import \"math\"\nrule agg_test {{ condition: {condition} }}"
+        ));
+        assert_eq!(
+            mentions(&lines, "agg_test"),
+            1,
+            "the aggregate rule was not reported for `{condition}`: {lines:?}"
+        );
+        assert_eq!(
+            mentions(&lines, "math"),
+            1,
+            "module dependency missed for `{condition}`: {lines:?}"
+        );
+    }
+
+    let lines = dep_lines(
+        "import \"math\"\n\
+         rule agg_test { strings: $a = \"AAAA\"\n\
+         condition: for sum of them : ( math.min(#, 5) ) == 1 }",
+    );
+    assert_eq!(
+        mentions(&lines, "math"),
+        1,
+        "module dependency missed inside a pattern-set aggregate: {lines:?}"
+    );
+}
+
+#[test]
+fn module_named_like_an_aggregate_variable_still_tracked() {
+    let lines = dep_lines(
+        r#"import "math"
+           rule agg_test {
+               condition: for sum math in (1..2) : ( math ) == 3 and
+                          math.min(1, 2) == 1
+           }"#,
+    );
+    // The loop variable shadows the module name inside the aggregate, but the
+    // real use of `math.min` still has to be reported, exactly once.
+    assert_eq!(
+        mentions(&lines, "math"),
+        1,
+        "module dependency tracking changed around the aggregate: {lines:?}"
+    );
+}
