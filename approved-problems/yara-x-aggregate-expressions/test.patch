+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+[ -n "$OUTPUT_PATH" ] && mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+NEW_TEST=aggregate_685dcf
+NEW_CLI_TEST=deps_agg_685dcf
+NEW_PARSER_TEST=dfs_agg_685dcf
+
+NEW_TEST_NAMES="aggregate_in_arithmetic
+aggregate_in_another_loops_header
+aggregate_in_boolean_context
+aggregate_inside_for_body
+aggregate_inside_with
+aggregate_is_defined_when_something_contributes
+aggregate_as_expression_tuple_item
+aggregate_names_are_not_reserved
+aggregate_over_pattern_set
+array_iterable
+avg_over_range
+avg_is_always_a_float
+avg_divides_by_the_contributions_not_the_iterations
+avg_of_nothing_has_no_value
+avg_over_a_partially_undefined_float_body
+avg_accumulates_in_the_body_type
+body_must_be_numeric
+constant_reversed_range_is_rejected
+count_body_judged_like_any_loop_body
+count_over_non_numeric_collections
+count_over_range
+empty_iteration_per_operation
+duplicate_loop_bindings_shadow_like_the_quantified_for
+empty_collection_iterables
+every_operation_in_every_header_slot
+expression_tuple_iterable
+float_aggregate_rejected_in_loop_headers
+float_body_partially_undefined
+float_zero_contributes_but_undefined_does_not
+float_body_produces_float
+float_body_with_no_contributions
+float_iterables
+float_map_iterable
+integer_body_avg_stays_float_through_inference
+aggregate_loop_variable_is_not_a_dependency
+aggregate_over_patterns_keeps_real_dependencies
+integer_body_produces_integer
+module_named_like_an_aggregate_variable_still_tracked
+integer_results_wrap_on_overflow
+iterable_type_validation
+loop_variable_scope
+loop_variables_do_not_outlive_the_aggregate
+map_iterable
+min_and_max_over_range
+named_pattern_subsets_for_every_operation
+nan_body_is_a_value_not_a_missing_one
+negative_constant_loop_headers_are_rejected
+dependencies_inside_every_aggregate_child_are_found
+module_used_inside_an_aggregate_is_reported
+walk_reaches_the_body_of_an_aggregate
+walk_reaches_both_bounds_of_an_aggregate
+walk_reaches_every_item_of_a_tuple_iterable
+walk_reaches_an_aggregate_nested_in_a_loop_header
+walk_reaches_the_body_of_a_pattern_set_aggregate
+aggregate_span_covers_the_whole_construct
+pattern_set_aggregate_span_covers_the_whole_construct
+nested_aggregate_spans_are_each_complete
+negative_values
+nested_aggregates
+parenthesized_operation_name_is_an_ordinary_quantifier
+pattern_count_in_body
+pattern_set_aggregate_agrees_in_fast_scan_mode
+pattern_set_avg_counts_only_contributing_patterns
+pattern_set_body_variables
+pattern_set_with_nothing_matching
+quantified_for_still_works
+of_expressions_still_work
+operation_names_work_as_local_identifiers
+operation_words_outside_the_aggregate_form
+result_type_in_integer_only_contexts
+runtime_reversed_range
+rules_can_be_named_after_an_aggregate
+structured_collection_iterables
+sum_over_range
+undefined_iterations_contribute_nothing
+undefined_nested_aggregate_is_skipped_as_a_body
+undefined_aggregate_as_a_loop_bound
+undefined_aggregate_propagates_through_arithmetic
+undefined_loop_header
+undefined_mixed_with_defined
+wrong_number_of_loop_variables"
+
+RAW=$(mktemp)
+trap 'rm -f "$RAW"' EXIT
+
+if [ "$MODE" = "new" ]; then
+  cargo test -p yara-x --test "$NEW_TEST" -- --test-threads=1 > "$RAW" 2>&1
+  EXIT_CODE=$?
+  cargo test -p yara-x-cli --test "$NEW_CLI_TEST" -- --test-threads=1 >> "$RAW" 2>&1
+  CLI_CODE=$?
+  [ $EXIT_CODE -eq 0 ] && EXIT_CODE=$CLI_CODE
+  cargo test -p yara-x-parser --test "$NEW_PARSER_TEST" -- --test-threads=1 >> "$RAW" 2>&1
+  PARSER_CODE=$?
+  [ $EXIT_CODE -eq 0 ] && EXIT_CODE=$PARSER_CODE
+else
+  cargo test -p yara-x --lib -- --test-threads=1 > "$RAW" 2>&1
+  EXIT_CODE=$?
+  cargo test -p yara-x-parser --lib -- --test-threads=1 >> "$RAW" 2>&1
+  PARSER_CODE=$?
+  [ $EXIT_CODE -eq 0 ] && EXIT_CODE=$PARSER_CODE
+fi
+
+cat "$RAW"
+
+[ -z "$OUTPUT_PATH" ] && exit $EXIT_CODE
+
+# Turn `test <name> ... ok|FAILED|ignored` lines into JUnit test cases.
+awk '
+  /^test .* \.\.\. / {
+    name = $2
+    status = $NF
+    gsub(/\r/, "", status)
+    if (status == "ok") { print "P\t" name }
+    else if (status == "FAILED") { print "F\t" name }
+  }
+' "$RAW" > "$RAW.cases"
+
+# A crate that fails to build produces no test lines at all, and the new tests
+# live in three crates, so one of them failing to build would silently drop its
+# cases instead of reporting them. Any expected test with no parsed result is
+# reported as a failure.
+if [ "$MODE" = "new" ]; then
+  echo "$NEW_TEST_NAMES" | while read -r name; do
+    [ -z "$name" ] && continue
+    if ! grep -qE "^[PF]	$name\$" "$RAW.cases" 2>/dev/null; then
+      printf 'F\t%s\n' "$name" >> "$RAW.cases"
+    fi
+  done
+fi
+
+TOTAL=$(wc -l < "$RAW.cases" | tr -d ' ')
+FAILURES=$(grep -c '^F' "$RAW.cases" || true)
+
+{
+  echo '<?xml version="1.0" encoding="UTF-8"?>'
+  printf '<testsuites name="yara-x" tests="%s" failures="%s" errors="0" time="0">\n' "$TOTAL" "$FAILURES"
+  printf '<testsuite name="%s" tests="%s" failures="%s" errors="0" time="0">\n' "$MODE" "$TOTAL" "$FAILURES"
+  while IFS=$(printf '\t') read -r status name; do
+    [ -z "$name" ] && continue
+    printf '<testcase name="%s" classname="%s" time="0">' "$name" "$MODE"
+    [ "$status" = "F" ] && printf '<failure message="test failed">see stdout</failure>'
+    printf '</testcase>\n'
+  done < "$RAW.cases"
+  echo '</testsuite>'
+  echo '</testsuites>'
+} > "$OUTPUT_PATH"
+
+rm -f "$RAW.cases"
+
+exit $EXIT_CODE
