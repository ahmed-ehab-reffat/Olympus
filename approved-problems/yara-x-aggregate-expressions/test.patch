+fn pattern_set_aggregate_agrees_in_fast_scan_mode() {
+    let rule = |cond: &str| {
+        format!(
+            r#"rule agg_test {{ strings: $a = "AAAA" $b = "BBBB"
+               condition: {cond} }}"#
+        )
+    };
+    // The fast scan stops after a pattern's first match, so a divergence only
+    // shows on data where a pattern matches more than once.
+    let repeated = b"AAAABBBBAAAACCCC";
+    for cond in [
+        "for sum of them : ( # ) == 3",
+        "for max of them : ( # ) == 2",
+        "for min of them : ( # ) == 1",
+        "for avg of them : ( # ) == 1.5",
+        "for count of them : ( # > 1 ) == 1",
+        "for sum of them : ( ! ) == 8",
+        "for max of them : ( @ ) == 4",
+        "for count of them : ( $ ) == 2",
+    ] {
+        let (normal, fast) = matches_in_both_scan_modes(&rule(cond), repeated);
+        assert!(normal, "`{cond}` did not match in normal mode");
+        assert_eq!(normal, fast, "`{cond}` disagrees between scan modes");
+    }
+}
