new file mode 100644
index 00000000..db715ddc
--- /dev/null
+++ b/parser/tests/dfs_agg_685dcf.rs
@@ -0,0 +1,127 @@
+use yara_x_parser::ast::dfs::{DFSEvent, DFSIter};
+use yara_x_parser::ast::{AST, Expr, WithSpan};
+
+/// Parses one rule and returns the identifiers the AST walk reaches, in the
+/// order it reaches them.
+fn walked_identifiers(source: &str) -> Vec<String> {
+    let ast = AST::from(source.as_bytes());
+    assert!(ast.errors().is_empty(), "parse errors in `{source}`");
+
+    let condition = &ast.rules().next().unwrap().condition;
+    let mut names = Vec::new();
+
+    for event in DFSIter::new(condition) {
+        if let DFSEvent::Enter(Expr::Ident(ident)) = event {
+            names.push(ident.name.to_string());
+        }
+    }
+
+    names
+}
+
+fn assert_reaches(source: &str, expected: &[&str]) {
+    let names = walked_identifiers(source);
+    for want in expected {
+        assert!(
+            names.iter().any(|n| n == want),
+            "the walk never reached `{want}`, it reached {names:?}"
+        );
+    }
+}
+
+#[test]
+fn walk_reaches_the_body_of_an_aggregate() {
+    assert_reaches(
+        "rule t { condition: for sum i in (1..2) : ( body_id ) == 1 }",
+        &["body_id"],
+    );
+}
+
+#[test]
+fn walk_reaches_both_bounds_of_an_aggregate() {
+    assert_reaches(
+        "rule t { condition: for sum i in (lower_id .. upper_id) : ( 1 ) == 1 }",
+        &["lower_id", "upper_id"],
+    );
+}
+
+#[test]
+fn walk_reaches_every_item_of_a_tuple_iterable() {
+    assert_reaches(
+        "rule t { condition: for sum i in (first_id, second_id) : ( 1 ) == 1 }",
+        &["first_id", "second_id"],
+    );
+}
+
+#[test]
+fn walk_reaches_an_aggregate_nested_in_a_loop_header() {
+    assert_reaches(
+        "rule t { condition: for (for sum i in (1..2) : ( quantifier_id )) j in \
+         (1 .. for max k in (1..2) : ( bound_id )) : ( body_id ) }",
+        &["quantifier_id", "bound_id", "body_id"],
+    );
+}
+
+#[test]
+fn walk_reaches_the_body_of_a_pattern_set_aggregate() {
+    assert_reaches(
+        "rule t { strings: $a = \"AAAA\" \
+         condition: for sum of them : ( body_id ) == 1 }",
+        &["body_id"],
+    );
+}
+
+/// Returns the source text spanned by every expression in the condition. The
+/// aggregate's own node is not singled out by name, so this says nothing about
+/// how the aggregate is represented in the tree.
+fn spanned_sources(source: &str) -> Vec<String> {
+    let ast = AST::from(source.as_bytes());
+    assert!(ast.errors().is_empty(), "parse errors in `{source}`");
+
+    let condition = &ast.rules().next().unwrap().condition;
+
+    DFSIter::new(condition)
+        .filter_map(|event| match event {
+            DFSEvent::Enter(expr) => {
+                let span = expr.span();
+                Some(source[span.start()..span.end()].to_string())
+            }
+            DFSEvent::Leave(_) => None,
+        })
+        .collect()
+}
+
+fn assert_some_node_spans(source: &str, expected: &str) {
+    let spans = spanned_sources(source);
+    assert!(
+        spans.iter().any(|s| s == expected),
+        "no expression spans `{expected}`; the spans were {spans:?}"
+    );
+}
+
+#[test]
+fn aggregate_span_covers_the_whole_construct() {
+    assert_some_node_spans(
+        "rule t { condition: for sum i in (1..3) : ( i ) == 6 }",
+        "for sum i in (1..3) : ( i )",
+    );
+}
+
+#[test]
+fn pattern_set_aggregate_span_covers_the_whole_construct() {
+    assert_some_node_spans(
+        "rule t { strings: $a = \"AAAA\" condition: for sum of them : ( # ) == 1 }",
+        "for sum of them : ( # )",
+    );
+}
+
+#[test]
+fn nested_aggregate_spans_are_each_complete() {
+    let source =
+        "rule t { condition: for sum i in (1 .. for max j in (1..2) : ( j )) : ( i ) == 3 }";
+    assert_some_node_spans(source, "for max j in (1..2) : ( j )");
+    assert_some_node_spans(
+        source,
+        "for sum i in (1 .. for max j in (1..2) : ( j )) : ( i )",
+    );
+}
