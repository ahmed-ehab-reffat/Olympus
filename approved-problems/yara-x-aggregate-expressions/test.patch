+use yara_x::Scanner;
+
+const DATA: &[u8] = b"AAAABBBBCCCC";
+
+fn matches(condition: &str) -> bool {
+    let src = format!(
+        r#"import "math" import "test_proto2" rule agg_test {{ condition: {condition} }}"#
+    );
+    let rules = yara_x::compile(src.as_str())
+        .unwrap_or_else(|e| panic!("compile error in `{condition}`:\n{e}"));
+    let mut scanner = Scanner::new(&rules);
+    let results = scanner.scan(DATA).expect("scan failed");
+    results.matching_rules().len() > 0
+}
+
+fn assert_true(condition: &str) {
+    assert!(matches(condition), "expected a match for `{condition}`");
+}
+
+fn assert_false(condition: &str) {
+    assert!(!matches(condition), "expected no match for `{condition}`");
+}
+
+fn assert_rejected(condition: &str) {
+    let src = format!(
+        r#"import "math" import "test_proto2" rule agg_test {{ condition: {condition} }}"#
+    );
+    assert!(
+        yara_x::compile(src.as_str()).is_err(),
+        "`{condition}` compiled, it should have been rejected"
+    );
+}
+
+fn matches_rule(src: &str) -> bool {
+    let rules = yara_x::compile(src)
+        .unwrap_or_else(|e| panic!("compile error:\n{e}"));
+    let mut scanner = Scanner::new(&rules);
+    scanner.scan(DATA).expect("scan failed").matching_rules().len() > 0
+}
+
+#[test]
+fn count_over_range() {
+    assert_true("for count i in (0..4) : ( i > 1 ) == 3");
+    assert_true("for count i in (0..4) : ( i > 1 ) != 4");
+    assert_false("for count i in (0..4) : ( i > 1 ) == 2");
+    assert_true("for count i in (1..3) : ( true ) == 3");
+    assert_true("for count i in (1..3) : ( false ) == 0");
+    assert_true("for count i in (7..7) : ( i == 7 ) == 1");
+}
+
+#[test]
+fn sum_over_range() {
+    assert_true("for sum i in (1..4) : ( i ) == 10");
+    assert_true("for sum i in (1..3) : ( i * 2 ) == 12");
+    assert_true("for sum i in (5..5) : ( i ) == 5");
+    assert_true("for sum i in (1..4) : ( 0 ) == 0");
+}
+
+#[test]
+fn min_and_max_over_range() {
+    assert_true("for min i in (3..6) : ( i ) == 3");
+    assert_true("for max i in (3..6) : ( i ) == 6");
+    assert_true("for min i in (3..6) : ( 10 - i ) == 4");
+    assert_true("for max i in (3..6) : ( 10 - i ) == 7");
+    assert_true("for min i in (2..2) : ( i ) == 2");
+    assert_true("for max i in (2..2) : ( i ) == 2");
+}
+
+#[test]
+fn negative_values() {
+    assert_true("for min i in (0..3) : ( 0 - i ) == -3");
+    assert_true("for max i in (0..3) : ( 0 - i ) == 0");
+    assert_true("for sum i in (0..3) : ( 0 - i ) == -6");
+}
+
+#[test]
+fn float_body_produces_float() {
+    assert_true("for sum i in (0..2) : ( 1.5 ) == 4.5");
+    assert_true("for min i in (0..2) : ( 1.5 ) == 1.5");
+    assert_true("for max i in (0..2) : ( 1.5 ) == 1.5");
+    assert_true("for sum i in (1..3) : ( i + 0.5 ) == 7.5");
+    assert_true("for min i in (1..3) : ( i + 0.5 ) == 1.5");
+    assert_true("for max i in (1..3) : ( i + 0.5 ) == 3.5");
+}
+
+#[test]
+fn integer_body_produces_integer() {
+    assert_true("for sum i in (1..2) : ( i ) == 3");
+    assert_false("for sum i in (1..2) : ( i ) == 3.5");
+    assert_true("for max i in (1..3) : ( i \\ 2 ) == 1");
+}
+
+#[test]
+fn count_body_judged_like_any_loop_body() {
+    assert_true("for count i in (0..3) : ( i ) == 3");
+    assert_true("for count i in (0..3) : ( i - 1 ) == 3");
+    assert_true("for count i in (1..3) : ( 0 ) == 0");
+    assert_true("for count i in (1..3) : ( \"abc\" ) == 3");
+    assert_true("for count i in (1..3) : ( \"\" ) == 0");
+    assert_true("for count i in (1..3) : ( 1.5 ) == 3");
+    assert_true("for count i in (1..3) : ( 0.0 ) == 0");
+    assert_rejected("for count i in (1..3) : ( 1 \\ ) == 1");
+    // The quantified form accepts the same non-boolean bodies, so this is
+    // inherited behavior and not a rule invented for the aggregate.
+    assert_true("for any i in (1..3) : ( i )");
+    assert_true("for any i in (1..3) : ( \"abc\" )");
+    assert_true("for any i in (1..3) : ( 1.5 )");
+    assert_true("for 0 i in (1..3) : ( \"\" )");
+}
+
+#[test]
+fn integer_results_wrap_on_overflow() {
+    assert_true(
+        "for sum i in (1..2) : ( 0x7fffffffffffffff ) == -2",
+    );
+    assert_true(
+        "for sum i in (1..3) : ( 0x7fffffffffffffff ) == 0x7ffffffffffffffd",
+    );
+    assert_true("for max i in (1..2) : ( 0x7fffffffffffffff ) == 0x7fffffffffffffff");
+    assert_true(
+        "for sum i in (1..2) : ( 0 - 0x4000000000000000 - 0x4000000000000000 ) == 0",
+    );
+    assert_true(
+        "for sum i in (1..3) : ( 0 - 0x7fffffffffffffff ) == \
+         0 - 0x7fffffffffffffff + 2",
+    );
+    assert_true(
+        "for min i in (1..2) : ( 0 - 0x7fffffffffffffff ) == 0 - 0x7fffffffffffffff",
+    );
+}
+
+#[test]
+fn empty_iteration_per_operation() {
+    let rule = |cond: &str| {
+        format!(r#"rule agg_test {{ strings: $z = "ZZZZ" condition: {cond} }}"#)
+    };
+    assert!(matches_rule(&rule("#z == 0")));
+    assert!(matches_rule(&rule("for count i in (1..#z) : ( true ) == 0")));
+    assert!(matches_rule(&rule("for sum i in (1..#z) : ( @z[i] ) == 0")));
+    assert!(matches_rule(&rule("not defined for min i in (1..#z) : ( @z[i] )")));
+    assert!(matches_rule(&rule("not defined for max i in (1..#z) : ( @z[i] )")));
+}
+
+#[test]
+fn empty_collection_iterables() {
+    let rule = |cond: &str| {
+        format!(r#"import "pe" import "elf" rule agg_test {{ condition: {cond} }}"#)
+    };
+    assert!(matches_rule(&rule("for count s in pe.sections : ( true ) == 0")));
+    assert!(matches_rule(&rule(
+        "for sum s in pe.sections : ( s.raw_data_size ) == 0"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for min s in pe.sections : ( s.raw_data_size )"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for max s in pe.sections : ( s.raw_data_size )"
+    )));
+    assert!(matches_rule(&rule(
+        "for count k, v in pe.version_info : ( true ) == 0"
+    )));
+    assert!(matches_rule(&rule("for sum k, v in pe.version_info : ( 1 ) == 0")));
+    assert!(matches_rule(&rule(
+        "for sum k, v in pe.version_info : ( 1.5 ) == 0.0"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for min k, v in pe.version_info : ( 1 )"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for max k, v in pe.version_info : ( 1 )"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for avg s in pe.sections : ( s.raw_data_size )"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for avg s in elf.sections : ( s.size )"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for avg k, v in pe.version_info : ( 1 )"
+    )));
+    assert!(matches_rule(&rule(
+        "not defined for avg k, v in pe.version_info : ( 1.5 )"
+    )));
+    assert!(matches_rule(&rule("for sum s in elf.sections : ( s.size ) == 0")));
+    assert!(matches_rule(&rule(
+        "not defined for min s in elf.sections : ( s.size )"
+    )));
+}
+
+#[test]
+fn negative_constant_loop_headers_are_rejected() {
+    assert_true("for sum i in (1..3) : ( i ) == 6");
+
+    // Inherited constant-bound validation: asserted for the aggregate and the
+    // quantified form together so the rule is pinned as inherited.
+    for (agg, quantified) in [
+        ("for sum i in (-1..3) : ( i ) == 5", "for any i in (-1..3) : ( i > 0 )"),
+        (
+            "for count i in (0 - 1 .. 3) : ( true ) == 5",
+            "for any i in (0 - 1 .. 3) : ( true )",
+        ),
+        (
+            "for sum i in (1 .. 0 - 1) : ( i ) == 0",
+            "for any i in (1 .. 0 - 1) : ( true )",
+        ),
+    ] {
+        assert_rejected(agg);
+        assert_rejected(quantified);
+    }
+    assert_rejected("for (0 - 1) i in (1..3) : ( i > 0 )");
+
+    // Negative values inside a body are unaffected.
+    assert_true("for sum i in (1..3) : ( 0 - i ) == 0 - 6");
+    assert_true("for min i in (1..3) : ( 0 - i ) == 0 - 3");
+}
+
+#[test]
+fn constant_reversed_range_is_rejected() {
+    assert_true("for sum i in (1..2) : ( i ) == 3");
+    assert_rejected("for sum i in (2..1) : ( i ) == 1");
+    assert_rejected("for min i in (2..1) : ( i ) == 1");
+    assert_rejected("for max i in (2..1) : ( i ) == 1");
+    assert_rejected("for count i in (2..1) : ( true ) == 1");
+    // The quantified form is rejected the same way.
+    assert_rejected("for any i in (2..1) : ( true )");
+}
+
+#[test]
+fn float_map_iterable() {
+    assert_true("for count k, v in test_proto2.map_string_float : ( true ) == 1");
+    assert_true("for sum k, v in test_proto2.map_string_float : ( v ) == 1.0");
+    assert_true("for min k, v in test_proto2.map_string_float : ( v ) == 1.0");
+    assert_true("for max k, v in test_proto2.map_string_float : ( v ) == 1.0");
+    assert_true("for count k, v in test_proto2.map_string_float : ( v > 0.5 ) == 1");
+    assert_true("for sum k, v in test_proto2.map_string_float : ( v ) + 0.5 == 1.5");
+
+    // This map holds a single entry whose value is not a round number, so it
+    // is pinned structurally instead of by a literal.
+    assert_true("for count k, v in test_proto2.map_int64_float : ( true ) == 1");
+    assert_true(
+        "for sum k, v in test_proto2.map_int64_float : ( v ) == \
+         for min k, v in test_proto2.map_int64_float : ( v )",
+    );
+    assert_true(
+        "for min k, v in test_proto2.map_int64_float : ( v ) == \
+         for max k, v in test_proto2.map_int64_float : ( v )",
+    );
+}
+
+#[test]
+fn undefined_loop_header() {
+    // An undefined bound yields no iterations, so the no-contribution
+    // identities apply, exactly as an undefined bound makes the quantified
+    // form false.
+    assert_true("for count i in (1 .. 1 \\ 0) : ( true ) == 0");
+    assert_true("for sum i in (1 .. 1 \\ 0) : ( i ) == 0");
+    assert_true("for sum i in ((1 \\ 0) .. 3) : ( i ) == 0");
+    assert_true("not defined for min i in (1 .. 1 \\ 0) : ( i )");
+    assert_true("not defined for max i in (1 .. 1 \\ 0) : ( i )");
+    assert_false("for any i in (1 .. 1 \\ 0) : ( true )");
+
+    // An undefined quantifier leaves the whole loop undefined, including when
+    // that quantifier is itself an aggregate.
+    assert_true("not defined (for (1 \\ 0) i in (1..3) : ( true ))");
+    assert_true(
+        "not defined (for (for min j in (1..2) : ( j \\ 0 )) i in (1..3) : ( true ))",
+    );
+}
+
+#[test]
+fn nan_body_is_a_value_not_a_missing_one() {
+    // A NaN is a value, so an iteration producing one contributes; only an
+    // iteration with NO value is skipped. Which value the extrema settle on
+    // when a NaN is compared against a number is not asserted, the engine
+    // states no policy for it.
+    assert_true("defined for sum i in (1..2) : ( 0.0 \\ 0.0 )");
+    assert_true("defined for min i in (1..2) : ( 0.0 \\ 0.0 )");
+    assert_true("defined for max i in (1..2) : ( 0.0 \\ 0.0 )");
+    assert_true("for sum i in (1..2) : ( 0.0 \\ 0.0 ) != 0.0");
+    // Contrast with a body that genuinely has no value.
+    assert_true("not defined for min i in (1..2) : ( math.mean(0, 0) )");
+}
+
+#[test]
+fn runtime_reversed_range() {
+    // The outer loop is what lets the inner range be reversed without
+    // constants, which the compiler rejects outright.
+    assert_true("for any i in (1..1) : ( for count j in (i + 1..i) : ( true ) == 0 )");
+    assert_true("for any i in (1..1) : ( for sum j in (i + 1..i) : ( j ) == 0 )");
+    assert_true("for any i in (1..1) : ( not defined for min j in (i + 1..i) : ( j ) )");
+    assert_true("for any i in (1..1) : ( not defined for max j in (i + 1..i) : ( j ) )");
+    assert_false("for any i in (1..1) : ( for all j in (i + 1..i) : ( true ) )");
+}
+
+#[test]
+fn float_zero_contributes_but_undefined_does_not() {
+    // Undefined at i = 0, exactly 0.0 afterwards.
+    let body = "math.mean(0, i) - math.mean(0, i)";
+    assert_true(&format!("for sum i in (0..2) : ( {body} ) == 0.0"));
+    assert_true(&format!("for min i in (0..2) : ( {body} ) == 0.0"));
+    assert_true(&format!("for max i in (0..2) : ( {body} ) == 0.0"));
+    assert_true(&format!("defined for min i in (0..2) : ( {body} )"));
+    assert_true(&format!("defined for max i in (0..2) : ( {body} )"));
+    // A zero is falsy, so it contributes to sum, min and max but not to count.
+    assert_true(&format!("for count i in (0..2) : ( {body} ) == 0"));
+    // Contrast: when nothing contributes at all there is no value.
+    assert_true("not defined for min i in (0..2) : ( math.mean(0, 0) )");
+    assert_true("not defined for max i in (0..2) : ( math.mean(0, 0) )");
+}
+
+#[test]
+fn result_type_in_integer_only_contexts() {
+    assert_true("uint8(for sum i in (1..1) : ( i )) == 0x41");
+    assert_rejected("uint8(for sum i in (1..1) : ( 1.5 )) == 0x41");
+    assert_rejected("uint8(for min i in (1..1) : ( i + 0.5 )) == 0x41");
+
+    let rule = |cond: &str| {
+        format!(r#"rule agg_test {{ strings: $a = "AAAA" condition: {cond} }}"#)
+    };
+    assert!(matches_rule(&rule("@a[for sum i in (1..1) : ( i )] == 0")));
+    assert!(
+        yara_x::compile(rule("@a[for sum i in (1..1) : ( 1.5 )] == 0").as_str())
+            .is_err(),
+        "a float aggregate should not be accepted as a match index"
+    );
+}
+
+#[test]
+fn undefined_iterations_contribute_nothing() {
+    assert_true("for sum i in (0..3) : ( i \\ 0 ) == 0");
+    assert_true("for count i in (0..3) : ( 1 \\ 0 == 0 ) == 0");
+    assert_true("not defined for min i in (0..3) : ( i \\ 0 )");
+    assert_true("not defined for max i in (0..3) : ( i \\ 0 )");
+}
+
+#[test]
+fn undefined_mixed_with_defined() {
+    assert_true("for sum i in (0..3) : ( 6 \\ i ) == 11");
+    assert_true("for min i in (0..3) : ( 6 \\ i ) == 2");
+    assert_true("for max i in (0..3) : ( 6 \\ i ) == 6");
+    assert_true("for count i in (0..3) : ( 6 \\ i > 2 ) == 2");
+}
+
+#[test]
+fn float_body_with_no_contributions() {
+    assert_true("for sum i in (0..2) : ( math.mean(0, 0) ) == 0.0");
+    assert_true("defined for sum i in (0..2) : ( math.mean(0, 0) )");
+    assert_true("for sum i in (0..2) : ( math.mean(0, 0) ) + 0.5 == 0.5");
+    assert_true("not defined for min i in (0..2) : ( math.mean(0, 0) )");
+    assert_true("not defined for max i in (0..2) : ( math.mean(0, 0) )");
+    assert_true("for count i in (0..2) : ( math.mean(0, 0) > 0.0 ) == 0");
+}
+
+#[test]
+fn float_body_partially_undefined() {
+    assert_true("not defined math.mean(0, 0)");
+    assert_true("for sum i in (0..3) : ( math.mean(0, i) + i ) == 201.0");
+    assert_true("for min i in (0..3) : ( math.mean(0, i) + i ) == 66.0");
+    assert_true("for max i in (0..3) : ( math.mean(0, i) + i ) == 68.0");
+    assert_true("for count i in (0..3) : ( math.mean(0, i) + i > 66.5 ) == 2");
+    assert_true("for sum i in (0..3) : ( math.mean(0, i) + i ) + 0.5 == 201.5");
+}
+
+#[test]
+fn undefined_aggregate_propagates_through_arithmetic() {
+    assert_true("not defined (for min i in (0..3) : ( i \\ 0 ) + 1)");
+    assert_true("not defined (for max i in (0..3) : ( i \\ 0 ) * 2)");
