+               condition: {cond} }}"#
+        )
+    };
+    // A match count is always a value, zero for a pattern that never matched,
+    // so every iteration contributes and the extrema are defined.
+    assert!(matches_rule(&rule("for count of them : ( # > 0 ) == 0")));
+    assert!(matches_rule(&rule("for sum of them : ( # ) == 0")));
+    assert!(matches_rule(&rule("for min of them : ( # ) == 0")));
+    assert!(matches_rule(&rule("for max of them : ( # ) == 0")));
+
+    // A match offset has no value when the pattern never matched, so nothing
+    // contributes at all and the extrema have no value either.
+    assert!(matches_rule(&rule("for sum of them : ( @ ) == 0")));
+    assert!(matches_rule(&rule("not defined for min of them : ( @ )")));
+    assert!(matches_rule(&rule("not defined for max of them : ( @ )")));
+
+    // `count` judges a body with no value as false, so it is 0 for the forms
+    // that have no value and for `#`, whose zero is falsy.
+    assert!(matches_rule(&rule("for count of them : ( @ ) == 0")));
+    assert!(matches_rule(&rule("for count of them : ( ! ) == 0")));
+    assert!(matches_rule(&rule("for count of them : ( # ) == 0")));
+
+    // `avg` needs a contribution like the extrema do, so it has no value over
+    // the forms that have none, but it is a defined 0.0 over `#`, whose zero
+    // does contribute.
+    assert!(matches_rule(&rule("not defined for avg of them : ( @ )")));
+    assert!(matches_rule(&rule("not defined for avg of them : ( ! )")));
+    assert!(matches_rule(&rule("for avg of them : ( # ) == 0.0")));
+    assert!(matches_rule(&rule("defined for avg of them : ( # )")));
