+    assert_true("with m = for avg i in (1..4) : ( i ) : ( m == 2.5 )");
+    assert_true("with m = for avg i in (1..4) : ( i ) : ( m + 0.5 == 3.0 )");
+    assert_true("with m = for avg i in (1..3) : ( i ) : ( m == 2.0 )");
+    assert_true("with m = for avg x in (1.0, 2.0) : ( x ) : ( m == 1.5 )");
+    assert_true(
+        "with a = for avg i in (1..4) : ( i ), b = for sum i in (1..2) : ( i ) : \
+         ( a == 2.5 and b == 3 )",
+    );
+    assert_true("for sum x in ((for avg i in (1..4) : ( i )), 0.5) : ( x ) == 3.0");
+    assert_true("for max x in ((for avg i in (1..4) : ( i )), 1.5) : ( x ) == 2.5");
+    assert_true("for min x in (0.5, (for avg i in (1..4) : ( i ))) : ( x ) == 0.5");
+}
+
+#[test]
+fn avg_is_always_a_float() {
+    // The result is a float even when every contribution is an integer, so
+    // it survives arithmetic that an integer result would truncate.
+    assert_true("for avg i in (1..4) : ( i ) + 0.25 == 2.75");
+    assert_true("for avg i in (1..4) : ( i ) * 2.0 == 5.0");
+    assert_rejected("uint8(for avg i in (1..1) : ( i )) == 0x41");
+    assert_true("uint8(for sum i in (1..1) : ( i )) == 0x41");
+}
+
+#[test]
+fn avg_divides_by_the_contributions_not_the_iterations() {
+    // The i = 0 iteration has no value, so the divisor is 3 and not 4.
+    let body = "math.mean(0, i) + i";
+    assert_true(&format!("for avg i in (0..3) : ( {body} ) == 67.0"));
+    assert_false(&format!("for avg i in (0..3) : ( {body} ) == 50.25"));
+    assert_true(&format!("for sum i in (0..3) : ( {body} ) == 201.0"));
+}
+
+#[test]
+fn avg_over_a_partially_undefined_float_body() {
+    // Undefined at i = 0, then 65.5 and 66.0, so the mean is fractional and
+    // the divisor is 2 rather than 3.
+    let body = "math.mean(0, i) + i * 0.5";
+    assert_true(&format!("for avg i in (0..2) : ( {body} ) == 65.75"));
+    assert_true(&format!("for sum i in (0..2) : ( {body} ) == 131.5"));
+    assert_true(&format!("for count i in (0..2) : ( {body} > 0.0 ) == 2"));
+    assert_true("for avg x in (1.5, 2.5, 3.5) : ( x ) == 2.5");
+}
+
+#[test]
+fn avg_of_nothing_has_no_value() {
+    // Unlike `sum`, which is 0 when nothing contributes.
+    assert_true("not defined for avg i in (1..2) : ( i \\ 0 )");
+    assert_true("for sum i in (1..2) : ( i \\ 0 ) == 0");
+    assert!(matches_rule(
+        r#"rule agg_test { strings: $z = "ZZZZ"
+           condition: not defined for avg i in (1..#z) : ( @z[i] ) }"#
+    ));
+    assert_true("not defined (for avg i in (1..2) : ( i \\ 0 ) + 1.0)");
+}
+
+#[test]
+fn avg_accumulates_in_the_body_type() {
+    // The total wraps as an integer before it is divided, so an
+    // implementation that accumulated in floating point would disagree.
+    assert_true(
+        "for avg i in (1..2) : ( 0 - 0x4000000000000000 - 0x4000000000000000 ) == 0.0",
+    );
+    assert_true("for avg i in (1..2) : ( 0x7fffffffffffffff ) == -1.0");
+}
+
+#[test]
+fn nested_aggregates() {
+    assert_true("for sum i in (1..3) : ( for sum j in (1..2) : ( j ) ) == 9");
+    assert_true("for max i in (1..3) : ( for sum j in (1..i) : ( j ) ) == 6");
+    assert_true("for count i in (1..3) : ( for count j in (1..3) : ( j >= i ) == 3 ) == 1");
+}
+
+#[test]
+fn aggregate_inside_for_body() {
+    assert_true("for any i in (0..3) : ( for count j in (0..3) : ( j == i ) == 1 )");
+    assert_true("for all i in (1..3) : ( for sum j in (1..i) : ( j ) >= i )");
+}
+
+#[test]
+fn aggregate_inside_with() {
+    assert_true("with k = 2 : ( for sum i in (1..3) : ( i * k ) == 12 )");
+    assert_true("with total = for sum i in (1..4) : ( i ) : ( total == 10 )");
+}
+
+#[test]
+fn loop_variable_scope() {
+    assert_true("for sum i in (1..2) : ( i ) == 3 and for sum i in (3..4) : ( i ) == 7");
+    assert_true("for sum i in (1..2) : ( for sum i in (5..6) : ( i ) ) == 22");
+}
+
+#[test]
+fn pattern_count_in_body() {
+    let src = r#"
+        rule agg_test {
+            strings:
+                $a = "AAAA"
+                $b = "BBBB"
+            condition:
+                for sum i in (1..#a) : ( @a[i] ) == 0 and
+                for count i in (1..#b) : ( @b[i] == 4 ) == 1
+        }"#;
+    let rules = yara_x::compile(src).unwrap();
+    let mut scanner = Scanner::new(&rules);
+    assert_eq!(scanner.scan(DATA).unwrap().matching_rules().len(), 1);
+}
+
+#[test]
+fn body_must_be_numeric() {
+    assert_true("for sum i in (1..3) : ( i ) == 6");
+    assert_rejected("for sum i in (1..3) : ( true ) == 1");
+    assert_rejected("for min i in (1..3) : ( \"abc\" ) == 1");
+    assert_rejected("for max i in (1..3) : ( i > 1 ) == 1");
+    assert_rejected("for sum i in (1..3) : ( test_proto2.nested ) == 1");
+    assert_rejected("for sum i in (1..3) : ( test_proto2.array_int64 ) == 1");
+    assert_rejected("for sum i in (1..3) : ( test_proto2.map_string_int64 ) == 1");
+    assert_rejected("for min i in (1..3) : ( test_proto2.array_float ) == 1");
+    assert_rejected("for avg i in (1..3) : ( true ) == 1.0");
+    assert_rejected("for avg i in (1..3) : ( \"abc\" ) == 1.0");
+    assert_rejected("for avg i in (1..3) : ( i > 1 ) == 1.0");
+    assert_rejected("for avg i in (1..3) : ( test_proto2.nested ) == 1.0");
+    assert_rejected("for avg i in (1..3) : ( test_proto2.array_int64 ) == 1.0");
+}
+
+#[test]
+fn wrong_number_of_loop_variables() {
+    assert_true("for sum i in (1..3) : ( i ) == 6");
+    // The quantified form is asserted alongside each case, because the
+    // aggregate inherits this rule rather than introducing one.
+    for (agg, quantified) in [
+        ("for sum k, v in (1..3) : ( k ) == 1", "for any k, v in (1..3) : ( k > 0 )"),
+        (
+            "for sum x in test_proto2.map_string_int64 : ( x ) == 1",
+            "for any x in test_proto2.map_string_int64 : ( x > 0 )",
+        ),
+        (
+            "for count k, v in test_proto2.array_int64 : ( true ) == 1",
+            "for any k, v in test_proto2.array_int64 : ( true )",
+        ),
+    ] {
+        assert_rejected(agg);
+        assert_rejected(quantified);
+    }
+}
+
+#[test]
+fn aggregate_names_are_not_reserved() {
+    assert_true("math.min(1, 2) == 1");
+    assert_true("math.max(3, 4) == 4");
+    assert_true("math.count(0x41) == 4");
+    assert_true("for sum i in (0..1) : ( math.min(i, 5) ) == 1");
+    assert_true("for max i in (0..1) : ( math.max(i, 5) ) == 5");
+}
+
+#[test]
+fn rules_can_be_named_after_an_aggregate() {
+    let src = r#"
+        rule count { condition: true }
+        rule sum { condition: count }
+        rule min { condition: sum }
+        rule max { condition: min }
+        rule avg { condition: max }
+        rule agg_test {
+            condition:
+                count and sum and min and max and avg and
+                for sum count in (1..3) : ( count ) == 6 and
+                for avg avg in (1..3) : ( avg ) == 2.0
+        }"#;
+    let rules = yara_x::compile(src).unwrap();
+    let mut scanner = Scanner::new(&rules);
+    assert_eq!(scanner.scan(DATA).unwrap().matching_rules().len(), 6);
+}
+
+#[test]
+fn operation_words_outside_the_aggregate_form() {
+    let rule = |cond: &str| {
+        format!(r#"rule agg_test {{ strings: $a = "AAAA" condition: {cond} }}"#)
+    };
+    assert!(matches_rule(&rule("$a and for sum i in (1..3) : ( i ) == 6")));
+    for bad in [
+        "sum of them",
+        "min of them",
+        "count of them",
+        "for sum in (1..3) : ( 1 )",
+        "for sum i (1..3) : ( i ) == 1",
+    ] {
+        assert!(
+            yara_x::compile(rule(bad).as_str()).is_err(),
+            "`{bad}` compiled, it should have been rejected"
+        );
+    }
+}
+
+#[test]
+fn duplicate_loop_bindings_shadow_like_the_quantified_for() {
+    assert_true("for any x, x in test_proto2.map_string_int64 : ( x > 0 )");
+    assert_true(
+        "for sum x, x in test_proto2.map_string_int64 : ( x ) == \
+         for sum k, v in test_proto2.map_string_int64 : ( v )",
+    );
+    assert_true(
+        "for min x, x in test_proto2.map_string_int64 : ( x ) == \
+         for min k, v in test_proto2.map_string_int64 : ( v )",
+    );
+    assert_true(
+        "for count x, x in test_proto2.map_string_int64 : ( x > 0 ) == \
+         for count k, v in test_proto2.map_string_int64 : ( v > 0 )",
+    );
+}
+
+#[test]
+fn parenthesized_operation_name_is_an_ordinary_quantifier() {
+    // `for (sum) i in ...` is a loop whose quantifier is the value of a
+    // variable named `sum`, not an aggregate. Recognising the operation by
+    // name alone regresses this, which base yara-x already accepts.
+    assert_true("with sum = 2 : ( for (sum) i in (1..3) : ( i > 1 ) )");
+    assert_true("with sum = 1 : ( for (sum) i in (1..2) : ( true ) )");
+    assert_true("with min = 2 : ( for (min) i in (1..3) : ( i > 1 ) )");
+    assert_true("with max = 2 : ( for (max) i in (1..3) : ( i > 1 ) )");
+    assert_true("with count = 2 : ( for (count) i in (1..3) : ( i > 1 ) )");
+    assert_true("with avg = 2 : ( for (avg) i in (1..3) : ( i > 1 ) )");
+
+    // A variable whose name is not an operation behaves identically, which is
+    // what makes the cases above a regression rather than a new rule.
+    assert_true("with n = 2 : ( for (n) i in (1..3) : ( i > 1 ) )");
+
+    // The bare form is still the aggregate, even with a variable of the same
+    // name in scope.
+    assert_true("for sum i in (1..3) : ( i ) == 6");
+    assert_true("with sum = 2 : ( for sum i in (1..3) : ( i ) == 6 )");
+}
+
+#[test]
+fn operation_names_work_as_local_identifiers() {
+    assert_true("for sum count in (1..3) : ( count ) == 6");
+    assert_true("for count sum in (1..3) : ( sum > 1 ) == 2");
+    assert_true("for min max in (2..4) : ( max ) == 2");
+    assert_true("for max min in (2..4) : ( min ) == 4");
+    assert_true("for any count in (1..3) : ( count == 2 )");
+    assert_true("with min = 3 : ( min == 3 )");
+    assert_true("with count = 2, sum = 5 : ( count + sum == 7 )");
+    assert_true("with max = 4 : ( for sum i in (1..2) : ( i * max ) == 12 )");
+    assert_true("for sum avg in (1..3) : ( avg ) == 6");
+    assert_true("for avg avg in (1..3) : ( avg ) == 2.0");
+    assert_true("with avg = 3 : ( avg == 3 )");
+    assert_true("for any avg in (1..3) : ( avg == 2 )");
+}
+
+#[test]
+fn loop_variables_do_not_outlive_the_aggregate() {
+    assert_true("for sum i in (1..3) : ( i ) == 6");
+    assert_rejected("for sum i in (1..3) : ( i ) == 6 and i == 1");
+    assert_rejected("for count i in (1..3) : ( true ) == 3 and i > 0");
+    assert_rejected("(for sum i in (1..3) : ( i )) + i == 7");
+}
+
+#[test]
+fn quantified_for_still_works() {
+    assert_true(
+        "for any i in (0..3) : ( i == 2 ) and \
+         for count i in (0..3) : ( i == 2 ) == 1",
+    );
+    assert_true("for any i in (0..3) : ( i == 2 )");
+    assert_true("for all i in (0..3) : ( i < 4 )");
+    assert_true("for none i in (0..3) : ( i > 5 )");
+    assert_true("for 2 i in (0..3) : ( i > 1 )");
+    assert_false("for 3 i in (0..3) : ( i > 1 )");
+    assert_true("for 50% i in (0..3) : ( i > 1 )");
+    assert_true("for any x in (1, 2, 3) : ( x == 3 )");
+}
+
+#[test]
+fn of_expressions_still_work() {
+    let src = r#"
+        rule agg_test {
+            strings:
+                $a = "AAAA"
+                $b = "BBBB"
+                $c = "ZZZZ"
+            condition:
+                2 of them and any of ($a, $c) and not all of them and
+                for count i in (1..3) : ( 1 of them ) == 3
+        }"#;
+    let rules = yara_x::compile(src).unwrap();
+    let mut scanner = Scanner::new(&rules);
+    assert_eq!(scanner.scan(DATA).unwrap().matching_rules().len(), 1);
+}
