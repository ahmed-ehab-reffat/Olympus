+const MOUSE_FAMILY: u8 = 1 << 0;
+const MEDIA_FAMILY: u8 = 1 << 1;
+const SYSTEM_FAMILY: u8 = 1 << 2;
+#[cfg(feature = "steno")]
+const STENO_FAMILY: u8 = 1 << 3;
+
+#[derive(Clone, Copy)]
+struct HidReportState {
+    keyboard_modifier: u8,
+    keyboard_reserved: u8,
+    keyboard_leds: u8,
+    keyboard_keycodes: [u8; 6],
+    mouse_buttons: u8,
+    media_usage_id: u16,
+    system_usage_id: u8,
+    #[cfg(feature = "steno")]
+    steno_keys: [u8; 8],
+    usb_dirty: u8,
+    ble_dirty: u8,
+}
+
+impl HidReportState {
+    const fn new() -> Self {
+        Self {
+            keyboard_modifier: 0,
+            keyboard_reserved: 0,
+            keyboard_leds: 0,
+            keyboard_keycodes: [0; 6],
+            mouse_buttons: 0,
+            media_usage_id: 0,
+            system_usage_id: 0,
+            #[cfg(feature = "steno")]
+            steno_keys: [0; 8],
+            usb_dirty: 0,
+            ble_dirty: 0,
+        }
+    }
+
+    fn remember(&mut self, report: &Report) -> Option<u8> {
+        match report {
+            Report::KeyboardReport(report) => {
+                self.keyboard_modifier = report.modifier;
+                self.keyboard_reserved = report.reserved;
+                self.keyboard_leds = report.leds;
+                self.keyboard_keycodes = report.keycodes;
+                None
+            }
+            Report::MouseReport(report) => {
+                self.mouse_buttons = report.buttons;
+                (report.buttons != 0).then_some(MOUSE_FAMILY)
+            }
+            Report::MediaKeyboardReport(report) => {
+                self.media_usage_id = report.usage_id;
+                (report.usage_id != 0).then_some(MEDIA_FAMILY)
+            }
+            Report::SystemControlReport(report) => {
+                self.system_usage_id = report.usage_id;
+                (report.usage_id != 0).then_some(SYSTEM_FAMILY)
+            }
+            #[cfg(feature = "steno")]
+            Report::StenoReport(report) => {
+                self.steno_keys = report.keys;
+                (report.keys != [0; 8]).then_some(STENO_FAMILY)
+            }
+        }
+    }
+
+    fn mark_dirty(&mut self, transport: ConnectionType, family: Option<u8>) {
+        let Some(family) = family else { return };
+        match transport {
+            ConnectionType::Usb => self.usb_dirty |= family,
+            ConnectionType::Ble => self.ble_dirty |= family,
+        }
+    }
+
+    fn take_dirty(&mut self, transport: ConnectionType) -> u8 {
+        let dirty = match transport {
+            ConnectionType::Usb => &mut self.usb_dirty,
+            ConnectionType::Ble => &mut self.ble_dirty,
+        };
+        let result = *dirty;
+        *dirty = 0;
+        result
+    }
+
+    fn releases(self, dirty: u8) -> Deque<Report, RECONCILIATION_REPORTS> {
+        let mut reports = Deque::new();
+        let _ = reports.push_back(Report::KeyboardReport(KeyboardReport::default()));
+        if dirty & MOUSE_FAMILY != 0 {
+            let _ = reports.push_back(Report::MouseReport(MouseReport {
+                buttons: 0,
+                x: 0,
+                y: 0,
+                wheel: 0,
+                pan: 0,
+            }));
+        }
+        if dirty & MEDIA_FAMILY != 0 {
+            let _ = reports.push_back(Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0 }));
+        }
+        if dirty & SYSTEM_FAMILY != 0 {
+            let _ = reports.push_back(Report::SystemControlReport(SystemControlReport { usage_id: 0 }));
+        }
+        #[cfg(feature = "steno")]
+        if dirty & STENO_FAMILY != 0 {
+            let _ = reports.push_back(Report::StenoReport(StenoReport { keys: [0; 8] }));
+        }
+        reports
+    }
+
+    fn current(self) -> (Deque<Report, RECONCILIATION_REPORTS>, u8) {
+        let mut reports = Deque::new();
+        if self.keyboard_modifier != 0 || self.keyboard_keycodes != [0; 6] {
+            let _ = reports.push_back(Report::KeyboardReport(KeyboardReport {
+                modifier: self.keyboard_modifier,
+                reserved: self.keyboard_reserved,
+                leds: self.keyboard_leds,
+                keycodes: self.keyboard_keycodes,
+            }));
+        }
+        let mut dirty = 0;
+        if self.mouse_buttons != 0 {
+            dirty |= MOUSE_FAMILY;
+            let _ = reports.push_back(Report::MouseReport(MouseReport {
+                buttons: self.mouse_buttons,
+                x: 0,
+                y: 0,
+                wheel: 0,
+                pan: 0,
+            }));
+        }
+        if self.media_usage_id != 0 {
+            dirty |= MEDIA_FAMILY;
+            let _ = reports.push_back(Report::MediaKeyboardReport(MediaKeyboardReport {
+                usage_id: self.media_usage_id,
+            }));
+        }
+        if self.system_usage_id != 0 {
+            dirty |= SYSTEM_FAMILY;
+            let _ = reports.push_back(Report::SystemControlReport(SystemControlReport {
+                usage_id: self.system_usage_id,
+            }));
+        }
+        #[cfg(feature = "steno")]
+        if self.steno_keys != [0; 8] {
+            dirty |= STENO_FAMILY;
+            let _ = reports.push_back(Report::StenoReport(StenoReport { keys: self.steno_keys }));
+        }
+        (reports, dirty)
+    }
+}
