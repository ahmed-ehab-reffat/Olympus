+// Each active-output change creates a new route activation. The transport may
+// be the same before and after an intervening disconnect or preference change,
+// so transport identity alone cannot identify the route a blocked send joined.
+static ACTIVE_ROUTE_GENERATION: AtomicU32 = AtomicU32::new(0);
+
 pub(crate) fn active_transport() -> Option<ConnectionType> {
     CONNECTION_STATUS.lock(|c| c.get().decide_active())
 }
 
+pub(crate) fn with_active_transport<R>(f: impl FnOnce(Option<ConnectionType>) -> R) -> R {
+    CONNECTION_STATUS.lock(|c| f(c.get().decide_active()))
+}
+
+pub(crate) fn active_route() -> Option<(ConnectionType, u32)> {
+    CONNECTION_STATUS.lock(|c| {
+        c.get()
+            .decide_active()
+            .map(|transport| (transport, ACTIVE_ROUTE_GENERATION.load(Ordering::Relaxed)))
+    })
+}
+
+pub(crate) fn with_active_route<R>(f: impl FnOnce(Option<(ConnectionType, u32)>) -> R) -> R {
+    CONNECTION_STATUS.lock(|c| {
+        let route = c
