+/// Drains stale traffic, releases state the previous host may have observed,
+/// and replays currently-held absolute state to the new host.
+pub(crate) fn reconcile_report_channels(previous: Option<ConnectionType>, current: Option<ConnectionType>) {
+    let (snapshot, previous_dirty) = HID_REPORT_STATE.lock(|state| {
+        let mut state = state.borrow_mut();
+        let previous_dirty = previous.map(|transport| state.take_dirty(transport)).unwrap_or(0);
+        (*state, previous_dirty)
+    });
+
+    if let Some(previous) = previous
+        && let Some(channel) = report_channel(previous)
+    {
+        channel.replace_with(snapshot.releases(previous_dirty));
+    }
+
+    if let Some(current) = current
+        && let Some(channel) = report_channel(current)
+    {
+        let (reports, dirty) = snapshot.current();
+        channel.replace_with(reports);
+        HID_REPORT_STATE.lock(|state| state.borrow_mut().mark_dirty(current, Some(dirty)));
     }
 }
 
