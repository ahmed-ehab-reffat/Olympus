-type ReportChannel = Channel<RawMutex, Report, REPORT_CHANNEL_SIZE>;
+const RECONCILIATION_REPORTS: usize = 5;
+
+/// A configured-size live report channel with a bounded reconciliation backlog.
+///
+/// Handoffs can require one snapshot per enabled report family even when the
+/// configured live channel has only one slot. The backlog is lazily moved into
+/// that live channel as the transport writer consumes reports.
+pub struct ReportChannel {
+    live: Channel<RawMutex, Report, REPORT_CHANNEL_SIZE>,
+    pending: Mutex<RawMutex, RefCell<Deque<Report, RECONCILIATION_REPORTS>>>,
+}
+
+impl ReportChannel {
+    const fn new() -> Self {
+        Self {
+            live: Channel::new(),
+            pending: Mutex::new(RefCell::new(Deque::new())),
+        }
+    }
+
+    fn refill(&self) {
+        loop {
+            let Some(report) = self.pending.lock(|pending| pending.borrow_mut().pop_front()) else {
+                return;
+            };
+            if let Err(TrySendError::Full(report)) = self.live.try_send(report) {
+                self.pending.lock(|pending| {
+                    let _ = pending.borrow_mut().push_front(report);
+                });
+                return;
+            }
+        }
+    }
+
+    fn has_pending(&self) -> bool {
+        self.pending.lock(|pending| !pending.borrow().is_empty())
+    }
+
+    fn replace_with(&self, reports: Deque<Report, RECONCILIATION_REPORTS>) {
+        self.live.clear();
+        self.pending.lock(|pending| *pending.borrow_mut() = reports);
+        self.refill();
+    }
+
+    pub fn clear(&self) {
+        self.live.clear();
+        self.pending.lock(|pending| pending.borrow_mut().clear());
+    }
+
+    pub fn len(&self) -> usize {
+        self.live.len() + self.pending.lock(|pending| pending.borrow().len())
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.live.is_empty() && !self.has_pending()
+    }
+
+    pub fn try_send(&self, report: Report) -> Result<(), TrySendError<Report>> {
+        self.refill();
+        if self.has_pending() {
+            Err(TrySendError::Full(report))
+        } else {
+            self.live.try_send(report)
+        }
+    }
+
+    pub fn poll_ready_to_send(&self, cx: &mut Context<'_>) -> Poll<()> {
+        self.refill();
+        self.live.poll_ready_to_send(cx)
+    }
+
+    pub async fn receive(&self) -> Report {
+        self.refill();
+        let report = self.live.receive().await;
+        self.refill();
+        report
+    }
+
+    pub fn try_receive(&self) -> Result<Report, TryReceiveError> {
+        self.refill();
+        let report = self.live.try_receive()?;
+        self.refill();
+        Ok(report)
+    }
+}
+
+impl core::ops::Deref for ReportChannel {
+    type Target = Channel<RawMutex, Report, REPORT_CHANNEL_SIZE>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.live
+    }
+}
+
+impl AsRef<Channel<RawMutex, Report, REPORT_CHANNEL_SIZE>> for ReportChannel {
+    fn as_ref(&self) -> &Channel<RawMutex, Report, REPORT_CHANNEL_SIZE> {
+        &self.live
+    }
+}
