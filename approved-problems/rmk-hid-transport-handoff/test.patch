+#[cfg(feature = "steno")]
+fn disconnection_complete_event() -> ControllerInput {
+    ControllerInput::Event(Vec::from_slice(&[0x05, 0x04, 0x00, 0x01, 0x00, 0x13]).unwrap())
+}
+
+fn att_request(pdu: &[u8]) -> ControllerInput {
+    let mut bytes = Vec::new();
+    bytes
+        .extend_from_slice(&(pdu.len() as u16).to_le_bytes())
+        .expect("L2CAP length fits");
+    bytes.extend_from_slice(&4u16.to_le_bytes()).expect("ATT CID fits");
+    bytes.extend_from_slice(pdu).expect("ATT request fits");
+    ControllerInput::Acl(bytes)
+}
+
+fn notification(packet: &[u8]) -> Option<(u16, Vec<u8, 16>)> {
+    (packet.len() >= 7 && packet[2..4] == [4, 0] && packet[4] == 0x1b).then(|| {
+        let handle = u16::from_le_bytes([packet[5], packet[6]]);
+        (
+            handle,
+            Vec::from_slice(&packet[7..]).expect("notification payload fits"),
+        )
+    })
+}
+
+async fn next_hid_notification(value_handles: &BTreeMap<u8, u16>) -> (u8, Vec<u8, 16>) {
+    loop {
+        let packet = CONTROLLER_OUTPUT.receive().await;
+        if let Some((value_handle, payload)) = notification(&packet)
+            && let Some((&report_id, _)) = value_handles.iter().find(|(_, handle)| **handle == value_handle)
+        {
+            return (report_id, payload);
+        }
+    }
+}
