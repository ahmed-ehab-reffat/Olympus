+#[cfg(feature = "steno")]
+#[derive(Clone, Copy, Default)]
+struct HidGlobals {
+    usage_page: u32,
+    report_size: Option<u32>,
+    report_id: Option<u32>,
+    report_count: Option<u32>,
+}
+
+#[cfg(feature = "steno")]
+fn hid_item_value(bytes: &[u8]) -> u32 {
+    bytes
+        .iter()
+        .enumerate()
+        .fold(0, |value, (shift, byte)| value | (u32::from(*byte) << (shift * 8)))
+}
+
+#[cfg(feature = "steno")]
+fn assert_coherent_plover_input_report(report_map: &[u8]) {
+    let mut offset = 0;
+    let mut depth = 0usize;
+    let mut globals = HidGlobals::default();
+    let mut global_stack = std::vec::Vec::new();
+    let mut local_usage = None;
+    let mut plover_depth = None;
+    let mut plover_report_id = false;
+    let mut plover_report_size = false;
+    let mut plover_report_count = false;
+    let mut coherent_input = false;
+    let mut found = false;
+
+    while offset < report_map.len() {
+        let prefix = report_map[offset];
+        offset += 1;
+        if prefix == 0xfe {
+            assert!(offset + 2 <= report_map.len(), "truncated long HID item header");
+            let length = usize::from(report_map[offset]);
+            offset += 2;
+            assert!(offset + length <= report_map.len(), "truncated long HID item payload");
+            offset += length;
+            continue;
+        }
+
+        let size = match prefix & 0x03 {
+            0 => 0,
+            1 => 1,
+            2 => 2,
+            3 => 4,
+            _ => unreachable!(),
+        };
+        assert!(offset + size <= report_map.len(), "truncated short HID item payload");
+        let value = hid_item_value(&report_map[offset..offset + size]);
+        offset += size;
+        let item_type = (prefix >> 2) & 0x03;
+        let tag = prefix >> 4;
+
+        match (item_type, tag) {
+            (1, 0) => globals.usage_page = value,
+            (1, 7) => {
+                globals.report_size = Some(value);
+                if plover_depth.is_some() {
+                    plover_report_size = true;
+                }
+            }
+            (1, 8) => {
+                globals.report_id = Some(value);
+                if plover_depth.is_some() {
+                    plover_report_id = true;
+                }
+            }
+            (1, 9) => {
+                globals.report_count = Some(value);
+                if plover_depth.is_some() {
+                    plover_report_count = true;
+                }
+            }
+            (1, 10) => global_stack.push(globals),
+            (1, 11) => globals = global_stack.pop().expect("HID global Pop without Push"),
+            (2, 0) => local_usage = Some(value),
+            (0, 10) => {
+                depth += 1;
+                if plover_depth.is_none() && value == 2 && globals.usage_page == 0xff50 && local_usage == Some(0x4c56) {
+                    plover_depth = Some(depth);
+                    plover_report_id = false;
+                    plover_report_size = false;
+                    plover_report_count = false;
+                    coherent_input = false;
+                }
+            }
+            (0, 8) if plover_depth.is_some() => {
+                coherent_input |= plover_report_id
+                    && plover_report_size
+                    && plover_report_count
+                    && globals.report_id == Some(0x50)
+                    && globals
+                        .report_size
+                        .zip(globals.report_count)
+                        .and_then(|(size, count)| size.checked_mul(count))
+                        == Some(64)
+                    && value & 0x07 == 0x02;
+            }
+            (0, 12) => {
+                assert!(depth > 0, "HID End Collection without Collection");
+                if plover_depth == Some(depth) {
+                    found |= coherent_input;
+                    plover_depth = None;
+                }
+                depth -= 1;
+            }
+            _ => {}
+        }
+
+        if item_type == 0 {
+            local_usage = None;
+        }
+    }
+
+    assert_eq!(depth, 0, "unterminated HID collection");
+    assert!(global_stack.is_empty(), "unterminated HID global Push");
+    assert!(
+        found,
+        "BLE HID report map lacks one coherent Plover logical input collection"
+    );
+}
+
+fn enable_every_notification(server: &Server<'_>, conn: &GattConnection<'_, '_, DefaultPacketPool>) -> Vec<u16, 16> {
+    let mut table = server
+        .get_client_att_table(conn.raw())
+        .expect("GATT connection has a client attribute table");
+    let raw = table.raw();
+    let count = u16::from_le_bytes([raw[0], raw[1]]) as usize;
+    let handles: Vec<u16, 16> = (0..count)
+        .filter_map(|index| {
+            let start = 4 + index * 4;
+            let handle = u16::from_le_bytes([raw[start], raw[start + 1]]) & 0x7fff;
+            (table.get(handle).map(<[u8]>::len) == Some(2)).then_some(handle)
+        })
+        .collect();
+    for &handle in &handles {
+        table.write(handle, 0, &[1, 0]).expect("enable notification CCCD");
+    }
+    server.set_client_att_table(conn.raw(), &table.view());
+    handles
+}
+
+#[cfg(feature = "steno")]
+async fn discover_input_reports(
+    server: &Server<'_>,
+    conn: &GattConnection<'_, '_, DefaultPacketPool>,
+) -> BTreeMap<u8, (u16, u16)> {
+    let table = server
+        .get_client_att_table(conn.raw())
+        .expect("GATT connection has a client attribute table");
+    let raw = table.raw();
+    let count = u16::from_le_bytes([raw[0], raw[1]]) as usize;
+    let cccd_handles: Vec<u16, 16> = (0..count)
+        .filter_map(|index| {
+            let start = 4 + index * 4;
+            let handle = u16::from_le_bytes([raw[start], raw[start + 1]]) & 0x7fff;
+            (table.get(handle).map(<[u8]>::len) == Some(2)).then_some(handle)
+        })
+        .collect();
+    let mut reports = BTreeMap::new();
+    for cccd_handle in cccd_handles {
+        let reference_handle = cccd_handle + 1;
+        CONTROLLER_INPUT
+            .send(att_request(&[
+                0x0a,
+                reference_handle as u8,
+                (reference_handle >> 8) as u8,
+            ]))
+            .await;
+        loop {
+            if let GattConnectionEvent::Gatt { event } = conn.next().await {
+                event.accept().expect("accept report-reference read").send().await;
+                break;
+            }
+        }
+        let response = CONTROLLER_OUTPUT.receive().await;
+        if response.len() == 7 && response[4] == 0x0b && response[6] == 0x01 {
+            reports.insert(response[5], (cccd_handle, cccd_handle - 1));
+        }
+    }
+    reports
+}
+
+#[cfg(feature = "steno")]
+fn enable_input_reports(
+    server: &Server<'_>,
+    conn: &GattConnection<'_, '_, DefaultPacketPool>,
+    reports: &BTreeMap<u8, (u16, u16)>,
+    report_ids: &[u8],
+) -> BTreeMap<u8, u16> {
+    let mut table = server
+        .get_client_att_table(conn.raw())
+        .expect("GATT connection has a client attribute table");
+    let mut value_handles = BTreeMap::new();
+    for &report_id in report_ids {
+        let &(cccd_handle, value_handle) = reports
+            .get(&report_id)
+            .unwrap_or_else(|| panic!("BLE GATT service has no input report id {report_id:#x}"));
+        table
+            .write(cccd_handle, 0, &[1, 0])
+            .expect("enable HID notification CCCD");
+        value_handles.insert(report_id, value_handle);
+    }
+    server.set_client_att_table(conn.raw(), &table.view());
+    value_handles
+}
