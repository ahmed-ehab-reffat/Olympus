+            match select(keyboard, with_timeout(HOST_PROBE_WATCHDOG, observe)).await {
+                Either::Second(Ok(())) => {}
+                Either::Second(Err(_)) => {
+                    panic!("no-steno BLE host did not complete handoff replay")
+                }
+                Either::First(()) => {
+                    panic!("no-steno BLE keyboard task ended before handoff validation")
+                }
+            }
+        };
+
+        match select4(rx.run(), control.run(), tx.run(), exercise_host_output).await {
+            Either4::Fourth(()) => {}
+            _ => panic!("scripted BLE runner ended before the no-steno host-output probe"),
+        }
+    });
+}
+
+#[cfg(feature = "steno")]
+fn run_hid_handoff_ble_host_probe() {
+    CONTROLLER_INPUT.clear();
+    CONTROLLER_OUTPUT.clear();
+    BLE_REPORT_CHANNEL.clear();
+    USB_REPORT_CHANNEL.clear();
+
+    let server = Server::new_with_config(GapConfig::Peripheral(PeripheralConfig {
+        name: "rmk-handoff-test",
+        appearance: &appearance::human_interface_device::KEYBOARD,
+    }))
+    .expect("construct BLE HID server");
+    let report_map = server
+        .get(&server.hid_service.report_map)
+        .expect("read BLE HID report map");
+    let report_map: &[u8] = report_map.as_ref();
+    assert_coherent_plover_input_report(report_map);
+
+    let mut resources: HostResources<DefaultPacketPool, 1, 4> = HostResources::new();
+    let stack = trouble_host::new(HostOutputController, &mut resources)
+        .set_random_address(Address::random([6, 5, 4, 3, 2, 1]))
+        .build();
+    let runner = stack.runner();
+    let (mut rx, mut control, mut tx) = runner.split();
+
+    block_on(async {
+        let exercise_host_output = async {
+            let mut peripheral = stack.peripheral();
+            let adv_data = [2, 1, LE_GENERAL_DISCOVERABLE | BR_EDR_NOT_SUPPORTED];
+            let acceptor = peripheral
+                .advertise(
+                    &Default::default(),
+                    Advertisement::ConnectableScannableUndirected {
+                        adv_data: &adv_data,
+                        scan_data: &[],
+                    },
+                )
+                .await
+                .expect("start scripted BLE advertising");
+            CONTROLLER_INPUT.send(connection_complete_event()).await;
+            let conn = with_timeout(HOST_PROBE_WATCHDOG, acceptor.accept())
+                .await
+                .expect("scripted controller did not establish the BLE connection")
+                .expect("scripted BLE connection was rejected")
+                .with_attribute_server(&server)
+                .expect("attach RMK GATT server");
+            let cccd_handles = enable_every_notification(&server, &conn);
+            let mut value_handles = BTreeMap::new();
+            for cccd_handle in cccd_handles {
+                let reference_handle = cccd_handle + 1;
+                CONTROLLER_INPUT
+                    .send(att_request(&[
+                        0x0a,
+                        reference_handle as u8,
+                        (reference_handle >> 8) as u8,
+                    ]))
+                    .await;
+                loop {
+                    if let GattConnectionEvent::Gatt { event } = conn.next().await {
+                        event.accept().expect("accept report-reference read").send().await;
+                        break;
+                    }
+                }
+                let response = CONTROLLER_OUTPUT.receive().await;
+                if response.len() == 7 && response[4] == 0x0b && response[6] == 0x01 {
+                    value_handles.insert(response[5], cccd_handle - 1);
+                }
+            }
+            for report_id in [1, 2, 3, 4, 0x50] {
+                assert!(
+                    value_handles.contains_key(&report_id),
+                    "BLE GATT service has no input report reference for id {report_id:#x}"
+                );
+            }
+
+            let cutover_keys = [0x87, 13, 21, 37, 69, 0x88, 0x89, 0x8a];
+            let observe = async {
+                set_preferred_connection(ConnectionType::Ble);
+                set_usb_state(UsbState::Disabled);
+                set_ble_state(BleState::Inactive);
+                USB_REPORT_CHANNEL.clear();
+                BLE_REPORT_CHANNEL.clear();
+                let offline_keys = [0x86, 11, 19, 35, 67, 0x87, 0x88, 0x89];
+                for report in [
+                    Report::KeyboardReport(KeyboardReport {
+                        modifier: 2,
+                        reserved: 0,
+                        leds: 0,
+                        keycodes: [4, 0, 0, 0, 0, 0],
+                    }),
+                    Report::MouseReport(MouseReport {
+                        buttons: 6,
+                        x: 14,
+                        y: -13,
+                        wheel: 12,
+                        pan: -11,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00e9 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0x81 }),
+                    Report::StenoReport(StenoReport { keys: offline_keys }),
+                ] {
+                    try_send_hid_report(report);
+                }
+                set_ble_state(BleState::Connected);
+                let offline_expected = ExpectedBleSnapshot {
+                    keyboard_modifier: 2,
+                    keyboard_keycode: 4,
+                    mouse_buttons: 6,
+                    media_usage_id: 0x00e9,
+                    system_usage_id: 0x81,
+                    steno_keys: offline_keys,
+                };
+                assert_ble_snapshot(
+                    &collect_ble_snapshot(&value_handles, offline_expected).await,
+                    offline_expected,
+                );
+
+                set_ble_state(BleState::Inactive);
+                for report in [
+                    Report::KeyboardReport(KeyboardReport::default()),
+                    Report::MouseReport(MouseReport {
+                        buttons: 0,
+                        x: -14,
+                        y: 13,
+                        wheel: -12,
+                        pan: 11,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0 }),
+                    Report::StenoReport(StenoReport { keys: [0; 8] }),
+                ] {
+                    try_send_hid_report(report);
+                }
+                CONTROLLER_OUTPUT.clear();
+                BLE_REPORT_CHANNEL.clear();
+
+                let offline_async_keys = [0x8b, 14, 22, 38, 70, 0x8c, 0x8d, 0x8e];
+                for report in [
+                    Report::KeyboardReport(KeyboardReport {
+                        modifier: 4,
+                        reserved: 0,
+                        leds: 0,
+                        keycodes: [5, 0, 0, 0, 0, 0],
+                    }),
+                    Report::MouseReport(MouseReport {
+                        buttons: 7,
+                        x: -15,
+                        y: 14,
+                        wheel: -13,
+                        pan: 12,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00ea }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0x82 }),
+                    Report::StenoReport(StenoReport {
+                        keys: offline_async_keys,
+                    }),
+                ] {
+                    send_hid_report(report).await;
+                }
+                set_ble_state(BleState::Connected);
+                let offline_async_expected = ExpectedBleSnapshot {
+                    keyboard_modifier: 4,
+                    keyboard_keycode: 5,
+                    mouse_buttons: 7,
+                    media_usage_id: 0x00ea,
+                    system_usage_id: 0x82,
+                    steno_keys: offline_async_keys,
+                };
+                assert_ble_snapshot(
+                    &collect_ble_snapshot(&value_handles, offline_async_expected).await,
+                    offline_async_expected,
+                );
+
+                set_ble_state(BleState::Inactive);
+                for report in [
+                    Report::KeyboardReport(KeyboardReport::default()),
+                    Report::MouseReport(MouseReport {
+                        buttons: 0,
+                        x: 15,
+                        y: -14,
+                        wheel: 13,
+                        pan: -12,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0 }),
+                    Report::StenoReport(StenoReport { keys: [0; 8] }),
+                ] {
+                    send_hid_report(report).await;
+                }
+                CONTROLLER_OUTPUT.clear();
+                BLE_REPORT_CHANNEL.clear();
+
+                set_preferred_connection(ConnectionType::Usb);
+                set_usb_state(UsbState::Configured);
+                set_ble_state(BleState::Connected);
+                USB_REPORT_CHANNEL.clear();
+                BLE_REPORT_CHANNEL.clear();
+                for _ in 0..crate::REPORT_CHANNEL_SIZE {
+                    USB_REPORT_CHANNEL
+                        .try_send(Report::KeyboardReport(KeyboardReport::default()))
+                        .expect("fill the USB queue");
+                }
+
+                let keys = [0x80, 1, 2, 4, 8, 16, 32, 0x81];
+                for report in [
+                    Report::KeyboardReport(KeyboardReport {
+                        modifier: 2,
+                        reserved: 0,
+                        leds: 0,
+                        keycodes: [4, 0, 0, 0, 0, 0],
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00e9 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0x81 }),
+                    Report::StenoReport(StenoReport { keys }),
+                ] {
+                    try_send_hid_report(report);
+                }
+                let blocked = send_hid_report(Report::MouseReport(MouseReport {
+                    buttons: 5,
+                    x: 12,
+                    y: -11,
+                    wheel: 10,
+                    pan: -9,
+                }));
+                let mut blocked = pin!(blocked);
+                poll_fn(|cx| match blocked.as_mut().poll(cx) {
+                    Poll::Pending => Poll::Ready(()),
+                    Poll::Ready(()) => panic!("send did not block on the full USB route"),
+                })
+                .await;
+                set_usb_state(UsbState::Disabled);
+
+                let cutover_expected = ExpectedBleSnapshot {
+                    keyboard_modifier: 2,
+                    keyboard_keycode: 4,
+                    mouse_buttons: 5,
+                    media_usage_id: 0x00e9,
+                    system_usage_id: 0x81,
+                    steno_keys: keys,
+                };
+                assert_ble_snapshot(
+                    &collect_ble_snapshot(&value_handles, cutover_expected).await,
+                    cutover_expected,
+                );
+
+                for report in [
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x1234 }),
+                    Report::MouseReport(MouseReport {
+                        buttons: 0x80,
+                        x: 1,
+                        y: -1,
+                        wheel: 1,
+                        pan: -1,
+                    }),
+                    Report::StenoReport(StenoReport {
+                        keys: [0x91, 2, 4, 8, 16, 32, 64, 0x89],
+                    }),
+                ]
+                .into_iter()
+                .take(crate::REPORT_CHANNEL_SIZE)
+                {
+                    BLE_REPORT_CHANNEL
+                        .try_send(report)
+                        .expect("fill the stale BLE queue before cutover");
+                }
+                set_usb_state(UsbState::Configured);
+
+                USB_REPORT_CHANNEL.clear();
+                let dropped_neutral_keys = [0x92, 3, 5, 9, 17, 33, 65, 0x8a];
+                for report in [
+                    Report::KeyboardReport(KeyboardReport {
+                        modifier: 4,
+                        reserved: 0,
+                        leds: 0,
+                        keycodes: [5, 0, 0, 0, 0, 0],
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00ea }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0x82 }),
+                    Report::StenoReport(StenoReport {
+                        keys: dropped_neutral_keys,
+                    }),
+                ] {
+                    send_hid_report(report).await;
+                    USB_REPORT_CHANNEL
+                        .try_receive()
+                        .expect("simulate delivery of held state to the active USB host");
+                }
+                for _ in 0..crate::REPORT_CHANNEL_SIZE {
+                    USB_REPORT_CHANNEL
+                        .try_send(Report::KeyboardReport(KeyboardReport::default()))
+                        .expect("fill the USB queue before neutral updates");
+                }
+                for report in [
+                    Report::KeyboardReport(KeyboardReport::default()),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0 }),
+                    Report::StenoReport(StenoReport { keys: [0; 8] }),
+                ] {
+                    try_send_hid_report(report);
+                }
+                try_send_hid_report(Report::MouseReport(MouseReport {
+                    buttons: 0x40,
+                    x: 5,
+                    y: -4,
+                    wheel: 3,
+                    pan: -2,
+                }));
+                set_preferred_connection(ConnectionType::Ble);
+
+                loop {
+                    let (report_id, payload) = next_hid_notification(&value_handles).await;
+                    assert_neutral_ble_state(report_id, &payload);
+                    if report_id == 2 {
+                        assert!(
+                            payload.iter().all(|byte| *byte == 0) || payload.as_slice() == [0x40, 0, 0, 0, 0],
+                            "BLE received stale mouse state before the current replay marker: {payload:?}"
+                        );
+                    }
+                    if report_id == 2 && payload.as_slice() == [0x40, 0, 0, 0, 0] {
+                        break;
+                    }
+                }
+                set_preferred_connection(ConnectionType::Usb);
+
+                if crate::REPORT_CHANNEL_SIZE == 1 {
+                    USB_REPORT_CHANNEL.clear();
+                    BLE_REPORT_CHANNEL.clear();
+                    send_hid_report(Report::MouseReport(MouseReport {
+                        buttons: 0x20,
+                        x: 7,
+                        y: -6,
+                        wheel: 5,
+                        pan: -4,
+                    }))
+                    .await;
+                    USB_REPORT_CHANNEL
+                        .try_receive()
+                        .expect("simulate delivery of held mouse buttons to USB");
+                    for _ in 0..crate::REPORT_CHANNEL_SIZE {
+                        USB_REPORT_CHANNEL
+                            .try_send(Report::KeyboardReport(KeyboardReport::default()))
+                            .expect("fill USB before the neutral mouse update");
+                    }
+                    try_send_hid_report(Report::MouseReport(MouseReport {
+                        buttons: 0,
+                        x: -7,
+                        y: 6,
+                        wheel: -5,
+                        pan: 4,
+                    }));
+                    try_send_hid_report(Report::SystemControlReport(SystemControlReport { usage_id: 0x83 }));
+                    set_preferred_connection(ConnectionType::Ble);
+
+                    loop {
+                        let (report_id, payload) = next_hid_notification(&value_handles).await;
+                        let current_system = report_id == 4 && payload.as_slice() == [0x83];
+                        assert!(
+                            current_system || payload.iter().all(|byte| *byte == 0),
+                            "stale report id {report_id:#x} crossed the BLE writer before the current system marker: {payload:?}"
+                        );
+                        if report_id == 4 && payload.as_slice() == [0x83] {
+                            break;
+                        }
+                    }
+                    set_preferred_connection(ConnectionType::Usb);
+                }
+
+                set_preferred_connection(ConnectionType::Ble);
+                set_usb_state(UsbState::Configured);
+                let (settled_id, settled_payload): (u8, &[u8]) = if crate::REPORT_CHANNEL_SIZE == 1 {
+                    (4, &[0x83])
+                } else {
+                    (2, &[0x40, 0, 0, 0, 0])
+                };
+                loop {
+                    let (report_id, payload) = next_hid_notification(&value_handles).await;
+                    let settled = report_id == settled_id && payload.as_slice() == settled_payload;
+                    assert!(
+                        settled || payload.iter().all(|byte| *byte == 0),
+                        "stale report id {report_id:#x} crossed the BLE writer before its settled-state marker: {payload:?}"
+                    );
+                    if settled {
+                        break;
+                    }
+                }
+                let delivered = [
+                    (
+                        Report::KeyboardReport(KeyboardReport {
+                            modifier: 2,
+                            reserved: 0,
+                            leds: 0,
+                            keycodes: [4, 0, 0, 0, 0, 0],
+                        }),
+                        1,
+                        &[2, 0, 4, 0, 0, 0, 0, 0][..],
+                    ),
+                    (
+                        Report::MouseReport(MouseReport {
+                            buttons: 4,
+                            x: 3,
+                            y: -2,
+                            wheel: 1,
+                            pan: -1,
+                        }),
+                        2,
+                        &[4, 3, 0xfe, 1, 0xff][..],
+                    ),
+                    (
+                        Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00e9 }),
+                        3,
+                        &[0xe9, 0][..],
+                    ),
+                    (
+                        Report::SystemControlReport(SystemControlReport { usage_id: 0x81 }),
+                        4,
+                        &[0x81][..],
+                    ),
+                    (
+                        Report::StenoReport(StenoReport { keys: cutover_keys }),
+                        0x50,
+                        &cutover_keys[..],
+                    ),
+                ];
+                for (report, expected_id, expected_payload) in delivered {
+                    send_hid_report(report).await;
+                    loop {
+                        let (report_id, payload) = next_hid_notification(&value_handles).await;
+                        if report_id == expected_id && payload.as_slice() == expected_payload {
+                            break;
+                        }
+                        assert!(
+                            (report_id == settled_id && payload.as_slice() == settled_payload)
+                                || payload.iter().all(|byte| *byte == 0),
+                            "stale report id {report_id:#x} crossed the BLE writer before a live report marker: {payload:?}"
+                        );
+                    }
+                }
+                for _ in 0..crate::REPORT_CHANNEL_SIZE {
+                    BLE_REPORT_CHANNEL
+                        .try_send(Report::KeyboardReport(KeyboardReport::default()))
+                        .expect("fill the BLE queue");
+                }
+                let blocked = send_hid_report(Report::MouseReport(MouseReport {
+                    buttons: 5,
+                    x: 12,
+                    y: -11,
+                    wheel: 10,
+                    pan: -9,
+                }));
+                let mut blocked = pin!(blocked);
+                poll_fn(|cx| match blocked.as_mut().poll(cx) {
+                    Poll::Pending => Poll::Ready(()),
+                    Poll::Ready(()) => panic!("send did not block on the full BLE route"),
+                })
+                .await;
+                set_ble_state(BleState::Inactive);
+
+                USB_REPORT_CHANNEL.clear();
+                for report in [
+                    Report::KeyboardReport(KeyboardReport::default()),
+                    Report::MouseReport(MouseReport {
+                        buttons: 0,
+                        x: 0,
+                        y: 0,
+                        wheel: 0,
+                        pan: 0,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0 }),
+                    Report::StenoReport(StenoReport { keys: [0; 8] }),
+                ] {
+                    send_hid_report(report).await;
+                    USB_REPORT_CHANNEL
+                        .try_receive()
+                        .expect("simulate delivery of the terminal neutral state to USB");
+                }
+
+                set_ble_state(BleState::Connected);
+                // Resume only after BLE has returned. The pending send belongs
+                // to the earlier BLE activation and must not enter this one.
+                blocked.await;
+                send_hid_report(Report::SystemControlReport(SystemControlReport { usage_id: 0x84 })).await;
+                loop {
+                    let (report_id, payload) = next_hid_notification(&value_handles).await;
+                    if report_id == 4 && payload.as_slice() == [0x84] {
+                        break;
+                    }
+                    assert!(
+                        payload.iter().all(|byte| *byte == 0),
+                        "stale report id {report_id:#x} crossed the BLE writer before the terminal marker: {payload:?}"
+                    );
+                }
+            };
+
+            let battery = BleBatteryConfig::disabled();
+            let keyboard = run_ble_keyboard(
+                &server,
+                &conn,
+                &stack,
+                None,
+                &battery,
+                #[cfg(feature = "host")]
+                None,
+            );
+            match select(keyboard, with_timeout(HOST_PROBE_WATCHDOG, observe)).await {
+                Either::Second(Ok(())) => {}
+                Either::Second(Err(_)) => panic!("BLE host did not complete handoff replay"),
+                Either::First(()) => panic!("BLE keyboard task ended before completing the handoff"),
+            }
+        };
+
+        match select4(rx.run(), control.run(), tx.run(), exercise_host_output).await {
+            Either4::Fourth(()) => {}
+            _ => panic!("scripted BLE runner ended before the host-output probe"),
+        }
+    });
+}
+
+#[cfg(not(feature = "steno"))]
+#[test]
+fn hid_handoff_no_steno_ble_host_replays_every_family() {
+    assert_eq!(crate::REPORT_CHANNEL_SIZE, 1, "test requires the capacity-one lane");
+    run_no_steno_ble_host_probe();
+}
+
+#[cfg(feature = "steno")]
+#[test]
+fn hid_handoff_ble_host_replays_every_family() {
+    assert_eq!(crate::REPORT_CHANNEL_SIZE, 1, "test requires the capacity-one lane");
+    run_hid_handoff_ble_host_probe();
+}
+
+#[cfg(feature = "steno")]
+#[test]
+fn hid_handoff_ble_profiles_isolate_plover_subscriptions_and_blocked_sends() {
+    assert_eq!(crate::REPORT_CHANNEL_SIZE, 1, "test requires the capacity-one lane");
+    run_ble_profile_handoff_probe();
+}
+
+#[cfg(feature = "steno")]
+#[test]
+fn hid_handoff_multi_stale_ble_cutover_discards_every_queued_packet() {
+    assert_eq!(crate::REPORT_CHANNEL_SIZE, 3, "test requires the capacity-three lane");
+    run_hid_handoff_ble_host_probe();
+}
