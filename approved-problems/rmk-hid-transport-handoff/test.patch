+fn hid_handoff_multi_stale_usb_cutover_discards_every_queued_packet() {
+    assert_eq!(crate::REPORT_CHANNEL_SIZE, 3, "test requires the capacity-three lane");
+    reset();
+    set_preferred_connection(ConnectionType::Usb);
+    set_ble_state(BleState::Connected);
+    set_usb_state(UsbState::Configured);
+    USB_REPORT_CHANNEL.clear();
+    BLE_REPORT_CHANNEL.clear();
+
+    let held_steno = [0x96, 6, 8, 12, 20, 36, 68, 0x8e];
+    for report in held_reports(held_steno) {
+        block_on(send_hid_report(report));
+        USB_REPORT_CHANNEL
+            .try_receive()
+            .expect("simulate delivery of current state to the active USB host");
+    }
+
+    let stale_steno = [0x95, 5, 7, 11, 19, 35, 67, 0x8d];
+    for report in [
+        Report::MouseReport(MouseReport {
+            buttons: 7,
+            x: 12,
+            y: -11,
+            wheel: 10,
+            pan: -9,
+        }),
+        Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x1234 }),
+        Report::StenoReport(StenoReport { keys: stale_steno }),
+    ] {
+        USB_REPORT_CHANNEL
+            .try_send(report)
+            .expect("queue three stale USB reports");
+    }
+
+    set_preferred_connection(ConnectionType::Ble);
+
+    run_writer_test(async {
+        // Reactivate USB before using it as the progress boundary. A writer is
+        // allowed to stop old-host output while its transport is inactive.
+        set_preferred_connection(ConnectionType::Usb);
+        assert_snapshot(&collect_snapshot(held_steno).await, held_steno);
+
+        send_hid_report(Report::SystemControlReport(SystemControlReport { usage_id: 0x86 })).await;
+        loop {
+            let packet = HOST_PACKETS.receive().await;
+            let Some((family, payload)) = family_payload(&packet) else {
+                continue;
+            };
+            if family == 4 && payload == [0x86] {
+                break;
+            }
+            let current = match family {
+                1 => &[2, 0, 4, 0, 0, 0, 0, 0][..],
+                2 => &[3, 0, 0, 0, 0][..],
+                3 => &[0xe9, 0][..],
+                4 => &[0x81][..],
+                0x50 => &held_steno[..],
+                _ => continue,
+            };
+            assert!(
+                payload == current || payload.iter().all(|byte| *byte == 0),
+                "stale USB report family {family:#x} survived cutover and reactivation: {payload:?}"
+            );
+        }
+    });
+}
