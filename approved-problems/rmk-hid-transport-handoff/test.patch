+fn run_writer_test(exercise: impl Future<Output = ()>) {
+    let mut keyboard_state = State::new();
+    let mut other_state = State::new();
+    let mut steno_state = State::new();
+    let mut keyboard_handler = crate::usb::UsbRequestHandler {};
+    let mut other_handler = crate::usb::UsbRequestHandler {};
+    let mut steno_handler = crate::usb::UsbRequestHandler {};
+    let mut config_descriptor = [0; 512];
+    let mut bos_descriptor = [0; 64];
+    let mut msos_descriptor = [0; 64];
+    let mut control = [0; 64];
+    let config = embassy_usb::Config::new(0x1209, 0x0001);
+    let mut builder = Builder::new(
+        MockDriver::new(),
+        config,
+        &mut config_descriptor,
+        &mut bos_descriptor,
+        &mut msos_descriptor,
+        &mut control,
+    );
+    let mut keyboard: HidWriter<'_, MockDriver, 8> = HidWriter::new(
+        &mut builder,
+        &mut keyboard_state,
+        HidConfig {
+            report_descriptor: KeyboardReport::desc(),
+            request_handler: Some(&mut keyboard_handler),
+            poll_ms: 1,
+            max_packet_size: 8,
+            hid_subclass: HidSubclass::No,
+            hid_boot_protocol: HidBootProtocol::None,
+        },
+    );
+    let mut other: HidWriter<'_, MockDriver, 9> = HidWriter::new(
+        &mut builder,
+        &mut other_state,
+        HidConfig {
+            report_descriptor: CompositeReport::desc(),
+            request_handler: Some(&mut other_handler),
+            poll_ms: 1,
+            max_packet_size: 16,
+            hid_subclass: HidSubclass::No,
+            hid_boot_protocol: HidBootProtocol::None,
+        },
+    );
+    let mut steno: HidWriter<'_, MockDriver, 9> = HidWriter::new(
+        &mut builder,
+        &mut steno_state,
+        HidConfig {
+            report_descriptor: StenoReport::desc(),
+            request_handler: Some(&mut steno_handler),
+            poll_ms: 1,
+            max_packet_size: 16,
+            hid_subclass: HidSubclass::No,
+            hid_boot_protocol: HidBootProtocol::None,
+        },
+    );
+    let mut writer = UsbKeyboardWriter::new(&mut keyboard, &mut other, &mut steno);
+
+    block_on(async {
+        match select(with_timeout(HOST_PROBE_WATCHDOG, exercise), writer.run_writer()).await {
+            Either::First(Ok(())) => {}
+            Either::First(Err(_)) => panic!("USB writer did not emit the expected host reports"),
+            Either::Second(never) => match never {},
+        }
+    });
+}
