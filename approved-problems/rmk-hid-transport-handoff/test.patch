+#[cfg(feature = "steno")]
+fn run_ble_profile_handoff_probe() {
+    CONTROLLER_INPUT.clear();
+    CONTROLLER_OUTPUT.clear();
+    BLE_REPORT_CHANNEL.clear();
+    USB_REPORT_CHANNEL.clear();
+    crate::test_support::reset_connection_status();
+    set_preferred_connection(ConnectionType::Ble);
+    set_usb_state(UsbState::Disabled);
+    set_ble_profile(0);
+    set_ble_state(BleState::Inactive);
+
+    let server = Server::new_with_config(GapConfig::Peripheral(PeripheralConfig {
+        name: "rmk-profile-test",
+        appearance: &appearance::human_interface_device::KEYBOARD,
+    }))
+    .expect("construct BLE HID server for profile handoff");
+    let mut resources: HostResources<DefaultPacketPool, 1, 4> = HostResources::new();
+    let stack = trouble_host::new(HostOutputController, &mut resources)
+        .set_random_address(Address::random([6, 5, 4, 3, 2, 1]))
+        .build();
+    let mut profile_manager = ProfileManager::new(&stack);
+    let initial_profile = ProfileInfo {
+        slot_num: 0,
+        removed: false,
+        info: BondInformation::new(
+            Identity {
+                addr: Address::new(AddrKind::PUBLIC, BdAddr::new([1, 2, 3, 4, 5, 6])),
+                irk: None,
+            },
+            LongTermKey::from_le_bytes([0; 16]),
+            SecurityLevel::Encrypted,
+            false,
+        ),
+        cccd_table: heapless::Vec::new(),
+    };
+    let runner = stack.runner();
+    let (mut rx, mut control, mut tx) = runner.split();
+
+    block_on(async {
+        let exercise = async {
+            let mut peripheral = stack.peripheral();
+            let adv_data = [2, 1, LE_GENERAL_DISCOVERABLE | BR_EDR_NOT_SUPPORTED];
+
+            profile_manager.add_profile_info(initial_profile).await;
+            FLASH_CHANNEL.clear();
+
+            let acceptor = peripheral
+                .advertise(
+                    &Default::default(),
+                    Advertisement::ConnectableScannableUndirected {
+                        adv_data: &adv_data,
+                        scan_data: &[],
+                    },
+                )
+                .await
+                .expect("start scripted advertising for profile-zero subscription");
+            CONTROLLER_INPUT.send(connection_complete_event()).await;
+            let profile_zero = with_timeout(HOST_PROBE_WATCHDOG, acceptor.accept())
+                .await
+                .expect("scripted controller did not establish profile zero")
+                .expect("scripted profile-zero connection was rejected")
+                .with_attribute_server(&server)
+                .expect("attach RMK GATT server for profile zero");
+            let profile_zero_reports = discover_input_reports(&server, &profile_zero).await;
+            let &(steno_cccd, _) = profile_zero_reports
+                .get(&0x50)
+                .expect("BLE GATT service has no Plover input report reference");
+
+            let persisted_subscription = async {
+                CONTROLLER_INPUT.send(encryption_change_event()).await;
+                while current_ble_status().state != BleState::Connected {
+                    embassy_futures::yield_now().await;
+                }
+                CONTROLLER_INPUT
+                    .send(att_request(&[0x12, steno_cccd as u8, (steno_cccd >> 8) as u8, 1, 0]))
+                    .await;
+                loop {
+                    if let FlashOperationMessage::ProfileInfo(profile) = FLASH_CHANNEL.receive().await
+                        && profile.slot_num == 0
+                        && !profile.cccd_table.is_empty()
+                    {
+                        return profile;
+                    }
+                }
+            };
+            let saved_profile = match select3(
+                gatt_events_task(&server, &profile_zero),
+                profile_manager.update_profile(),
+                with_timeout(HOST_PROBE_WATCHDOG, persisted_subscription),
+            )
+            .await
+            {
+                Either3::Third(Ok(profile)) => profile,
+                Either3::Third(Err(_)) => panic!("Plover subscription did not enter profile persistence"),
+                Either3::First(result) => {
+                    panic!("GATT task ended before Plover subscription was captured: {result:?}")
+                }
+                Either3::Second(()) => panic!("profile manager ended before Plover subscription was captured"),
+            };
+
+            CONTROLLER_INPUT.send(disconnection_complete_event()).await;
+            loop {
+                if let GattConnectionEvent::Disconnected { .. } = profile_zero.next().await {
+                    break;
+                }
+            }
+            drop(profile_zero);
+            CONTROLLER_OUTPUT.clear();
+
+            set_ble_state(BleState::Connected);
+            BLE_REPORT_CHANNEL
+                .try_send(Report::KeyboardReport(KeyboardReport {
+                    modifier: 2,
+                    reserved: 0,
+                    leds: 0,
+                    keycodes: [4, 0, 0, 0, 0, 0],
+                }))
+                .expect("fill profile zero's one-entry live queue");
+            let held_steno = [0x93, 3, 6, 12, 24, 48, 96, 0x8b];
+            try_send_hid_report(Report::StenoReport(StenoReport { keys: held_steno }));
+            let blocked = send_hid_report(Report::MouseReport(MouseReport {
+                buttons: 5,
+                x: 12,
+                y: -11,
+                wheel: 10,
+                pan: -9,
+            }));
+            let mut blocked = pin!(blocked);
+            poll_fn(|cx| match blocked.as_mut().poll(cx) {
+                Poll::Pending => Poll::Ready(()),
+                Poll::Ready(()) => panic!("profile-zero send did not block on the full queue"),
+            })
+            .await;
+            set_ble_profile(1);
+            assert_eq!(current_ble_status().state, BleState::Inactive);
+
+            let acceptor = peripheral
+                .advertise(
+                    &Default::default(),
+                    Advertisement::ConnectableScannableUndirected {
+                        adv_data: &adv_data,
+                        scan_data: &[],
+                    },
+                )
+                .await
+                .expect("start scripted advertising for profile one");
+            CONTROLLER_INPUT.send(connection_complete_event()).await;
+            let profile_one = with_timeout(HOST_PROBE_WATCHDOG, acceptor.accept())
+                .await
+                .expect("scripted controller did not establish profile one")
+                .expect("scripted profile-one connection was rejected")
+                .with_attribute_server(&server)
+                .expect("attach RMK GATT server for profile one");
+            let profile_one_reports = discover_input_reports(&server, &profile_one).await;
+            let value_handles = enable_input_reports(&server, &profile_one, &profile_one_reports, &[1, 2, 3, 4]);
+
+            let observe_profile_one = async {
+                set_ble_state(BleState::Connected);
+                send_hid_report(Report::SystemControlReport(SystemControlReport { usage_id: 0x85 })).await;
+                let mut saw_replayed_mouse = false;
+                loop {
+                    let packet = CONTROLLER_OUTPUT.receive().await;
+                    let Some((value_handle, payload)) = notification(&packet) else {
+                        continue;
+                    };
+                    let report_id = value_handles
+                        .iter()
+                        .find_map(|(report_id, handle)| (*handle == value_handle).then_some(*report_id));
+                    match report_id {
+                        Some(2) => match payload.as_slice() {
+                            [0, 0, 0, 0, 0] => {}
+                            [5, 0, 0, 0, 0] => saw_replayed_mouse = true,
+                            _ => panic!("profile one received the old profile's raw blocked mouse report: {payload:?}"),
+                        },
+                        Some(4) if payload.as_slice() == [0x85] => {
+                            assert!(
+                                saw_replayed_mouse,
+                                "profile one did not receive the latest held mouse state"
+                            );
+                            break;
+                        }
+                        Some(_) => assert!(
+                            payload.iter().all(|byte| *byte == 0),
+                            "profile one received stale non-neutral HID state: {payload:?}"
+                        ),
+                        None => panic!("profile one inherited profile zero's Plover subscription"),
+                    }
+                }
+                set_ble_profile(0);
+            };
+            let battery = BleBatteryConfig::disabled();
+            let keyboard = run_ble_keyboard(
+                &server,
+                &profile_one,
+                &stack,
+                None,
+                &battery,
+                #[cfg(feature = "host")]
+                None,
+            );
+            let validate_profile_one = async {
+                join(blocked.as_mut(), observe_profile_one).await;
+            };
+            match select(keyboard, with_timeout(HOST_PROBE_WATCHDOG, validate_profile_one)).await {
+                Either::Second(Ok(())) => {}
+                Either::Second(Err(_)) => panic!("profile-one handoff did not complete"),
+                Either::First(()) => panic!("BLE keyboard task ended during profile-one handoff"),
+            }
+            assert_eq!(current_ble_status().profile, 0);
+            assert_eq!(current_ble_status().state, BleState::Inactive);
+
+            CONTROLLER_INPUT.send(disconnection_complete_event()).await;
+            loop {
+                if let GattConnectionEvent::Disconnected { .. } = profile_one.next().await {
+                    break;
+                }
+            }
+            drop(profile_one);
+            CONTROLLER_OUTPUT.clear();
+
+            let acceptor = peripheral
+                .advertise(
+                    &Default::default(),
+                    Advertisement::ConnectableScannableUndirected {
+                        adv_data: &adv_data,
+                        scan_data: &[],
+                    },
+                )
+                .await
+                .expect("restart scripted advertising for profile zero");
+            CONTROLLER_INPUT.send(connection_complete_event()).await;
+            let profile_zero = with_timeout(HOST_PROBE_WATCHDOG, acceptor.accept())
+                .await
+                .expect("scripted controller did not re-establish profile zero")
+                .expect("scripted profile-zero reconnection was rejected")
+                .with_attribute_server(&server)
+                .expect("reattach RMK GATT server for profile zero");
+            let profile_zero_reports = discover_input_reports(&server, &profile_zero).await;
+            let steno_value_handle = profile_zero_reports
+                .get(&0x50)
+                .map(|(_, value_handle)| *value_handle)
+                .expect("reconnected BLE GATT service has no Plover input report reference");
+            let observe_profile_zero = async {
+                set_ble_state(BleState::Connected);
+                loop {
+                    let packet = CONTROLLER_OUTPUT.receive().await;
+                    if let Some((value_handle, payload)) = notification(&packet) {
+                        assert_eq!(
+                            value_handle, steno_value_handle,
+                            "profile zero emitted an unsubscribed report"
+                        );
+                        if payload.as_slice() == held_steno {
+                            break;
+                        }
+                        assert!(
+                            payload.iter().all(|byte| *byte == 0),
+                            "profile zero restored the wrong Plover chord: {payload:?}"
+                        );
+                    }
+                }
+            };
+            let keyboard = run_ble_keyboard(
+                &server,
+                &profile_zero,
+                &stack,
+                Some(saved_profile),
+                &battery,
+                #[cfg(feature = "host")]
+                None,
+            );
+            match select(keyboard, with_timeout(HOST_PROBE_WATCHDOG, observe_profile_zero)).await {
+                Either::Second(Ok(())) => {}
+                Either::Second(Err(_)) => panic!("profile-zero Plover subscription was not restored"),
+                Either::First(()) => panic!("BLE keyboard task ended before profile-zero replay"),
+            }
+        };
+
+        match select4(rx.run(), control.run(), tx.run(), exercise).await {
+            Either4::Fourth(()) => {}
+            _ => panic!("scripted BLE runner ended during profile handoff"),
+        }
+    });
+}
