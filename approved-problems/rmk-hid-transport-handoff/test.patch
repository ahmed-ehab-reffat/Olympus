--- /dev/null
+++ b/test.sh
@@ -0,0 +1,203 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+output_path="results.xml"
+mode=""
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            output_path="${2:-results.xml}"
+            shift 2
+            ;;
+        --output_path=*)
+            output_path="${1#*=}"
+            shift
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+if [[ -z "$mode" ]]; then
+    echo "usage: $0 [--output_path PATH] {base|new}" >&2
+    exit 2
+fi
+
+case "$output_path" in
+    /*) ;;
+    *) output_path="$PWD/$output_path" ;;
+esac
+
+export CARGO_NET_OFFLINE=true
+
+runtime_root="$(mktemp -d "${TMPDIR:-/tmp}/rmk-handoff-tests.XXXXXX")"
+source_root="$runtime_root/source"
+mkdir "$source_root"
+tar --exclude='./rmk/target' --exclude='./rynk/target' -cf - . | tar -xf - -C "$source_root"
+cd "$source_root"
+
+# Register the host-probe modules in the isolated source copy used for this run.
+# The checked-out source tree remains untouched.
+cat >>rmk/src/ble/mod.rs <<'RUST'
+
+#[cfg(all(test, feature = "_ble", not(feature = "_no_usb")))]
+#[path = "handoff_ble_host_output_91c4e7.rs"]
+mod handoff_ble_host_output;
+RUST
+
+cat >>rmk/src/usb/mod.rs <<'RUST'
+
+#[cfg(all(test, feature = "_ble", feature = "steno"))]
+#[path = "handoff_host_probe_5e2a91.rs"]
+mod handoff_host_probe;
+
+#[cfg(all(test, feature = "_ble", not(feature = "steno")))]
+#[path = "handoff_no_steno_probe_c84d17.rs"]
+mod handoff_no_steno_probe;
+RUST
+
+trap 'rm -rf -- "$runtime_root"' EXIT
+nextest_config="$runtime_root/nextest.toml"
+{
+    printf '[store]\ndir = "%s/nextest"\n\n' "$runtime_root"
+    cat .ci-nextest.toml
+} >"$nextest_config"
+
+status=0
+junit_path="$runtime_root/nextest/default/junit.xml"
+junit_files=()
+
+base_expression=""
+while IFS= read -r test_name; do
+    [[ -n "$test_name" ]] || continue
+    if [[ -z "$base_expression" ]]; then
+        base_expression="test(=$test_name)"
+    else
+        base_expression="$base_expression or test(=$test_name)"
+    fi
+done <.ci-baseline-tests-6f2d9a.txt
+
+capture_junit() {
+    local lane="$1"
+    local lane_status="$2"
+    local lane_path="$runtime_root/junit-$lane.xml"
+    if [[ -f "$junit_path" ]]; then
+        cp "$junit_path" "$lane_path"
+    else
+        cat >"$lane_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="1">
+  <testsuite name="new.$lane" tests="1" failures="0" errors="1">
+    <testcase name="harness-startup-$lane" classname="new">
+      <error message="test runner exited before producing JUnit (exit $lane_status)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+        [[ $status -ne 0 ]] || status=97
+    fi
+    junit_files+=("$lane_path")
+}
+
+run_new_lane() {
+    local lane="$1"
+    local keyboard_config="$2"
+    local features="$3"
+    local expression="$4"
+    local lane_status=0
+    rm -f "$junit_path"
+    KEYBOARD_TOML_PATH="$PWD/$keyboard_config" \
+    cargo nextest run \
+        --manifest-path rmk/Cargo.toml \
+        --config-file "$nextest_config" \
+        --target-dir "$runtime_root/target" \
+        --no-default-features \
+        --features="$features" \
+        -E "$expression" \
+        --offline || lane_status=$?
+    if [[ $lane_status -ne 0 && $status -eq 0 ]]; then
+        status=$lane_status
+    fi
+    capture_junit "$lane" "$lane_status"
+}
+
+run_example_preflight() {
+    local lane_status=0
+    rm -f "$junit_path"
+    KEYBOARD_TOML_PATH="$PWD/examples/use_config/nrf52840_ble/keyboard.toml" \
+    cargo test \
+        --manifest-path rmk/Cargo.toml \
+        --target-dir "$runtime_root/target" \
+        --no-run \
+        --no-default-features \
+        --features=rynk,_ble,split,async_matrix,storage,steno \
+        --offline || lane_status=$?
+    if [[ $lane_status -ne 0 ]]; then
+        [[ $status -ne 0 ]] || status=$lane_status
+        capture_junit "full-example" "$lane_status"
+    fi
+}
+
+case "$mode" in
+    base)
+        cargo nextest run \
+            --manifest-path rmk/Cargo.toml \
+            --config-file "$nextest_config" \
+            --target-dir "$runtime_root/target" \
+            --no-default-features \
+            --features=rynk,_ble,split,async_matrix,storage \
+            --all-targets \
+            -E "$base_expression" \
+            --offline || status=$?
+        ;;
+    new)
+        run_example_preflight
+        run_new_lane \
+            "dual-steno" \
+            ".ci-small-channel.toml" \
+            "rynk,_ble,split,async_matrix,storage,steno" \
+            'test(/hid_handoff_/) and not test(/hid_handoff_multi_stale_/)'
+        run_new_lane \
+            "multi-stale" \
+            ".ci-stale-queue-7b3e19.toml" \
+            "rynk,_ble,split,async_matrix,storage,steno" \
+            'test(/hid_handoff_multi_stale_/)'
+        run_new_lane \
+            "dual-no-steno" \
+            ".ci-small-channel.toml" \
+            "rynk,_ble,split,async_matrix,storage" \
+            'test(/hid_handoff_no_steno_/)'
+        ;;
+esac
+
+mkdir -p "$(dirname "$output_path")"
+if [[ "$mode" == "new" && ${#junit_files[@]} -gt 0 ]]; then
+    {
+        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<testsuites>'
+        for lane_path in "${junit_files[@]}"; do
+            sed -n '/<testsuite /,/<\/testsuite>/p' "$lane_path"
+        done
+        printf '%s\n' '</testsuites>'
+    } >"$output_path"
+elif [[ -f "$junit_path" ]]; then
+    cp "$junit_path" "$output_path"
+else
+    escaped_mode=${mode//&/&amp;}
+    cat >"$output_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="1">
+  <testsuite name="$escaped_mode" tests="1" failures="0" errors="1">
+    <testcase name="harness-startup" classname="$escaped_mode">
+      <error message="test runner exited before producing JUnit (exit $status)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    [[ $status -ne 0 ]] || status=97
+fi
+exit "$status"
