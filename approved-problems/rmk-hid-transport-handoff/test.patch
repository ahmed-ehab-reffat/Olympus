+#[derive(Clone, Copy)]
+struct ExpectedBleSnapshot {
+    keyboard_modifier: u8,
+    keyboard_keycode: u8,
+    mouse_buttons: u8,
+    media_usage_id: u16,
+    system_usage_id: u8,
+    steno_keys: [u8; 8],
+}
+
+#[cfg(feature = "steno")]
+async fn collect_ble_snapshot(
+    value_handles: &BTreeMap<u8, u16>,
+    expected: ExpectedBleSnapshot,
+) -> BTreeMap<u8, Vec<u8, 16>> {
+    let keyboard = [expected.keyboard_modifier, 0, expected.keyboard_keycode, 0, 0, 0, 0, 0];
+    let mouse = [expected.mouse_buttons, 0, 0, 0, 0];
+    let media = expected.media_usage_id.to_le_bytes();
+    let system = [expected.system_usage_id];
+    let mut reports = BTreeMap::new();
+    while reports.len() < 5 {
+        let (report_id, payload) = next_hid_notification(value_handles).await;
+        let expected = match report_id {
+            1 => &keyboard[..],
+            2 => &mouse[..],
+            3 => &media[..],
+            4 => &system[..],
+            0x50 => &expected.steno_keys[..],
+            _ => continue,
+        };
+        if payload.as_slice() == expected {
+            reports.insert(report_id, payload);
+        } else {
+            assert!(
+                payload.iter().all(|byte| *byte == 0),
+                "BLE host received stale report id {report_id:#x} while awaiting current replay: {payload:?}"
+            );
+        }
+    }
+    reports
+}
+
+#[cfg(feature = "steno")]
+fn assert_ble_snapshot(reports: &BTreeMap<u8, Vec<u8, 16>>, expected: ExpectedBleSnapshot) {
+    let keyboard = [expected.keyboard_modifier, 0, expected.keyboard_keycode, 0, 0, 0, 0, 0];
+    assert_eq!(reports.get(&1).map(Vec::as_slice), Some(&keyboard[..]));
+    let mouse = [expected.mouse_buttons, 0, 0, 0, 0];
+    assert_eq!(reports.get(&2).map(Vec::as_slice), Some(&mouse[..]));
+    assert_eq!(
+        reports.get(&3).map(Vec::as_slice),
+        Some(&expected.media_usage_id.to_le_bytes()[..])
+    );
+    assert_eq!(
+        reports.get(&4).map(Vec::as_slice),
+        Some(&[expected.system_usage_id][..])
+    );
+    assert_eq!(reports.get(&0x50).map(Vec::as_slice), Some(&expected.steno_keys[..]));
+}
