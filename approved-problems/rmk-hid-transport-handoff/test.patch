+    }));
+    try_send_hid_report(Report::MouseReport(MouseReport {
+        buttons: 0,
+        x: 0,
+        y: 0,
+        wheel: 0,
+        pan: 0,
+    }));
+    try_send_hid_report(pressed_keyboard());
+    set_preferred_connection(ConnectionType::Usb);
+
+    run_writer_test(async {
+        loop {
+            let packet = HOST_PACKETS.receive().await;
+            if let Some((family, payload)) = family_payload(&packet) {
+                if family == 2 {
+                    assert!(
+                        payload.first() == Some(&0),
+                        "a dropped neutral mouse report left stale buttons held"
+                    );
+                }
+                if family == 1 && payload == [2, 0, 4, 0, 0, 0, 0, 0] {
+                    break;
+                }
+            }
+        }
+        send_hid_report(Report::SystemControlReport(SystemControlReport { usage_id: 0x84 })).await;
+        loop {
+            let packet = HOST_PACKETS.receive().await;
+            if let Some((2, payload)) = family_payload(&packet) {
+                assert!(
+                    payload.first() == Some(&0),
+                    "a dropped neutral mouse report left stale buttons held"
+                );
+            }
+            if family_payload(&packet) == Some((4, &[0x84])) {
+                break;
+            }
+        }
+    });
+}
diff --git a/rmk/src/usb/handoff_no_steno_probe_c84d17.rs b/rmk/src/usb/handoff_no_steno_probe_c84d17.rs
new file mode 100644
index 0000000..874dbd3
--- /dev/null
+++ b/rmk/src/usb/handoff_no_steno_probe_c84d17.rs
@@ -0,0 +1,346 @@
+use core::future::Future;
+use std::collections::BTreeMap;
+
+use embassy_futures::select::{Either, select};
+use embassy_sync::channel::Channel;
+use embassy_time::{Duration, with_timeout};
+use embassy_usb::Builder;
+use embassy_usb::class::hid::{Config as HidConfig, HidBootProtocol, HidSubclass, HidWriter, State};
+use embassy_usb::driver::{
+    Bus, ControlPipe, Direction, Driver, Endpoint, EndpointAddress, EndpointAllocError, EndpointError, EndpointIn,
+    EndpointInfo, EndpointOut, EndpointType, Event, Unsupported,
+};
+use heapless::Vec;
+use rmk_types::ble::BleState;
+use rmk_types::connection::{ConnectionType, UsbState};
+use usbd_hid::descriptor::{MediaKeyboardReport, MouseReport, SerializedDescriptor, SystemControlReport};
+
+use super::UsbKeyboardWriter;
+use crate::channel::{BLE_REPORT_CHANNEL, USB_REPORT_CHANNEL, send_hid_report, try_send_hid_report};
+use crate::hid::{CompositeReport, KeyboardReport, Report};
+use crate::state::{set_ble_state, set_preferred_connection, set_usb_state};
+use crate::test_support::{reset_connection_status, test_block_on as block_on};
+
+#[derive(Debug)]
+struct HostPacket {
+    endpoint: usize,
+    bytes: Vec<u8, 9>,
+}
+
+static HOST_PACKETS: Channel<crate::RawMutex, HostPacket, 32> = Channel::new();
+
+// Test-harness deadlock protection only; this is not a firmware latency requirement.
+const HOST_PROBE_WATCHDOG: Duration = Duration::from_secs(30);
+
+#[derive(Clone)]
+struct MockEndpoint {
+    info: EndpointInfo,
+}
+
+impl Endpoint for MockEndpoint {
+    fn info(&self) -> &EndpointInfo {
+        &self.info
+    }
+
+    async fn wait_enabled(&mut self) {}
+}
+
+impl EndpointIn for MockEndpoint {
+    async fn write(&mut self, bytes: &[u8]) -> Result<(), EndpointError> {
+        if !bytes.is_empty() {
+            HOST_PACKETS
+                .send(HostPacket {
+                    endpoint: self.info.addr.index(),
+                    bytes: Vec::from_slice(bytes).expect("test HID packet fits"),
+                })
+                .await;
+        }
+        Ok(())
+    }
+}
+
+impl EndpointOut for MockEndpoint {
+    async fn read(&mut self, _: &mut [u8]) -> Result<usize, EndpointError> {
+        core::future::pending().await
+    }
+}
+
+struct MockBus;
+
+impl Bus for MockBus {
+    async fn enable(&mut self) {}
+    async fn disable(&mut self) {}
+    async fn poll(&mut self) -> Event {
+        core::future::pending().await
+    }
+    fn endpoint_set_enabled(&mut self, _: EndpointAddress, _: bool) {}
+    fn endpoint_set_stalled(&mut self, _: EndpointAddress, _: bool) {}
+    fn endpoint_is_stalled(&mut self, _: EndpointAddress) -> bool {
+        false
+    }
+    async fn remote_wakeup(&mut self) -> Result<(), Unsupported> {
+        Ok(())
+    }
+}
+
+struct MockControlPipe;
+
+impl ControlPipe for MockControlPipe {
+    fn max_packet_size(&self) -> usize {
+        64
+    }
+    async fn setup(&mut self) -> [u8; 8] {
+        core::future::pending().await
+    }
+    async fn data_out(&mut self, _: &mut [u8], _: bool, _: bool) -> Result<usize, EndpointError> {
+        core::future::pending().await
+    }
+    async fn data_in(&mut self, _: &[u8], _: bool, _: bool) -> Result<(), EndpointError> {
+        core::future::pending().await
+    }
+    async fn accept(&mut self) {}
+    async fn reject(&mut self) {}
+    async fn accept_set_address(&mut self, _: u8) {}
+}
+
+struct MockDriver {
+    next_in: usize,
+    next_out: usize,
+}
+
+impl MockDriver {
+    fn new() -> Self {
+        Self {
+            next_in: 1,
+            next_out: 1,
+        }
+    }
+
+    fn endpoint(
+        next: &mut usize,
+        direction: Direction,
+        ep_type: EndpointType,
+        address: Option<EndpointAddress>,
+        max_packet_size: u16,
+        interval_ms: u8,
+    ) -> MockEndpoint {
+        let addr = address.unwrap_or_else(|| EndpointAddress::from_parts(*next, direction));
+        *next += 1;
+        MockEndpoint {
+            info: EndpointInfo {
+                addr,
+                ep_type,
+                max_packet_size,
+                interval_ms,
+            },
+        }
+    }
+}
+
+impl<'a> Driver<'a> for MockDriver {
+    type EndpointOut = MockEndpoint;
+    type EndpointIn = MockEndpoint;
+    type ControlPipe = MockControlPipe;
+    type Bus = MockBus;
+
+    fn alloc_endpoint_out(
+        &mut self,
+        ep_type: EndpointType,
+        address: Option<EndpointAddress>,
+        max_packet_size: u16,
+        interval_ms: u8,
+    ) -> Result<Self::EndpointOut, EndpointAllocError> {
+        Ok(Self::endpoint(
+            &mut self.next_out,
+            Direction::Out,
+            ep_type,
+            address,
+            max_packet_size,
+            interval_ms,
+        ))
+    }
+
+    fn alloc_endpoint_in(
+        &mut self,
+        ep_type: EndpointType,
+        address: Option<EndpointAddress>,
+        max_packet_size: u16,
+        interval_ms: u8,
+    ) -> Result<Self::EndpointIn, EndpointAllocError> {
+        Ok(Self::endpoint(
+            &mut self.next_in,
+            Direction::In,
+            ep_type,
+            address,
+            max_packet_size,
+            interval_ms,
+        ))
+    }
+
+    fn start(self, _: u16) -> (Self::Bus, Self::ControlPipe) {
+        (MockBus, MockControlPipe)
+    }
+}
+
+fn reset() {
+    HOST_PACKETS.clear();
+    reset_connection_status();
+    USB_REPORT_CHANNEL.clear();
+    BLE_REPORT_CHANNEL.clear();
+}
+
+fn family_payload(packet: &HostPacket) -> Option<(u8, &[u8])> {
+    match packet.endpoint {
+        1 => Some((1, packet.bytes.as_slice())),
+        2 if matches!(packet.bytes.first(), Some(2..=4)) => Some((packet.bytes[0], &packet.bytes[1..])),
+        _ => None,
+    }
+}
+
+async fn collect_snapshot() -> BTreeMap<u8, std::vec::Vec<u8>> {
+    let mut reports = BTreeMap::new();
+    while reports.len() < 4 {
+        let packet = HOST_PACKETS.receive().await;
+        if let Some((family, payload)) = family_payload(&packet) {
+            let expected = match family {
+                1 => &[4, 0, 6, 0, 0, 0, 0, 0][..],
+                2 => &[5, 0, 0, 0, 0][..],
+                3 => &[0xea, 0][..],
+                4 => &[0x82][..],
+                _ => continue,
+            };
+            if payload == expected {
+                reports.insert(family, payload.to_vec());
+            } else {
+                assert!(
+                    payload.iter().all(|byte| *byte == 0),
+                    "USB host received stale no-steno family {family:#x} before current replay: {payload:?}"
+                );
+            }
+        }
+    }
+    reports
+}
+
+fn run_writer_test(exercise: impl Future<Output = ()>) {
+    let mut keyboard_state = State::new();
+    let mut other_state = State::new();
+    let mut keyboard_handler = crate::usb::UsbRequestHandler {};
+    let mut other_handler = crate::usb::UsbRequestHandler {};
+    let mut config_descriptor = [0; 256];
+    let mut bos_descriptor = [0; 64];
+    let mut msos_descriptor = [0; 64];
+    let mut control = [0; 64];
+    let config = embassy_usb::Config::new(0x1209, 0x0001);
+    let mut builder = Builder::new(
+        MockDriver::new(),
+        config,
+        &mut config_descriptor,
+        &mut bos_descriptor,
+        &mut msos_descriptor,
+        &mut control,
+    );
+    let mut keyboard: HidWriter<'_, MockDriver, 8> = HidWriter::new(
+        &mut builder,
+        &mut keyboard_state,
+        HidConfig {
+            report_descriptor: KeyboardReport::desc(),
+            request_handler: Some(&mut keyboard_handler),
+            poll_ms: 1,
+            max_packet_size: 8,
+            hid_subclass: HidSubclass::No,
+            hid_boot_protocol: HidBootProtocol::None,
+        },
+    );
+    let mut other: HidWriter<'_, MockDriver, 9> = HidWriter::new(
+        &mut builder,
+        &mut other_state,
+        HidConfig {
+            report_descriptor: CompositeReport::desc(),
+            request_handler: Some(&mut other_handler),
+            poll_ms: 1,
+            max_packet_size: 16,
+            hid_subclass: HidSubclass::No,
+            hid_boot_protocol: HidBootProtocol::None,
+        },
+    );
+    let mut writer = UsbKeyboardWriter::new(&mut keyboard, &mut other);
+
+    block_on(async {
+        match select(with_timeout(HOST_PROBE_WATCHDOG, exercise), writer.run_writer()).await {
+            Either::First(Ok(())) => {}
+            Either::First(Err(_)) => panic!("USB writer did not emit the expected host reports"),
+            Either::Second(never) => match never {},
+        }
+    });
+}
+
+#[test]
+fn hid_handoff_no_steno_replays_every_family() {
+    reset();
+    assert_eq!(crate::REPORT_CHANNEL_SIZE, 1, "test requires the capacity-one lane");
+    set_preferred_connection(ConnectionType::Usb);
+    set_ble_state(BleState::Connected);
+    set_usb_state(UsbState::Configured);
+
+    for report in [
+        Report::KeyboardReport(KeyboardReport {
+            modifier: 0x02,
+            reserved: 0,
+            leds: 0,
+            keycodes: [4, 0, 0, 0, 0, 0],
+        }),
+        Report::MouseReport(MouseReport {
+            buttons: 3,
+            x: 9,
+            y: -8,
+            wheel: 7,
+            pan: -6,
+        }),
+        Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00e9 }),
+        Report::SystemControlReport(SystemControlReport { usage_id: 0x81 }),
+    ] {
+        block_on(send_hid_report(report));
+        USB_REPORT_CHANNEL.try_receive().expect("simulate live USB delivery");
+    }
+    USB_REPORT_CHANNEL
+        .try_send(Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x1234 }))
+        .expect("queue stale USB traffic");
+    set_preferred_connection(ConnectionType::Ble);
+
+    run_writer_test(async {
+        BLE_REPORT_CHANNEL.clear();
+        BLE_REPORT_CHANNEL
+            .try_send(Report::KeyboardReport(KeyboardReport::default()))
+            .expect("fill one-entry BLE queue");
+        for report in [
+            Report::KeyboardReport(KeyboardReport {
+                modifier: 0x04,
+                reserved: 0,
+                leds: 0,
+                keycodes: [6, 0, 0, 0, 0, 0],
+            }),
+            Report::MouseReport(MouseReport {
+                buttons: 5,
+                x: 12,
+                y: -11,
+                wheel: 10,
+                pan: -9,
+            }),
+            Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00ea }),
+            Report::SystemControlReport(SystemControlReport { usage_id: 0x82 }),
+        ] {
+            try_send_hid_report(report);
+        }
+        set_preferred_connection(ConnectionType::Usb);
+
+        let replay = collect_snapshot().await;
+        assert_eq!(
+            replay.get(&1).map(std::vec::Vec::as_slice),
+            Some(&[4, 0, 6, 0, 0, 0, 0, 0][..])
+        );
+        assert_eq!(replay.get(&2).map(std::vec::Vec::as_slice), Some(&[5, 0, 0, 0, 0][..]));
+        assert_eq!(replay.get(&3).map(std::vec::Vec::as_slice), Some(&[0xea, 0][..]));
+        assert_eq!(replay.get(&4).map(std::vec::Vec::as_slice), Some(&[0x82][..]));
+    });
+}
