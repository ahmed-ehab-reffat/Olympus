+            x: 12,
+            y: -11,
+            wheel: 10,
+            pan: -9,
+        }));
+        let mut blocked = pin!(blocked);
+        poll_fn(|cx| match blocked.as_mut().poll(cx) {
+            Poll::Pending => Poll::Ready(()),
+            Poll::Ready(()) => panic!("send did not block on the original USB activation"),
+        })
+        .await;
+
+        set_preferred_connection(ConnectionType::Ble);
+        set_preferred_connection(ConnectionType::Usb);
+
+        blocked.await;
