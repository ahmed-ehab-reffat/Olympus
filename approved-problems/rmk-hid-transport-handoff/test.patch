+#[test]
+fn hid_handoff_usb_writer_receives_state_from_send_blocked_at_ble_cutover() {
+    reset();
+    set_preferred_connection(ConnectionType::Ble);
+    set_usb_state(UsbState::Configured);
+    set_ble_state(BleState::Connected);
+    USB_REPORT_CHANNEL.clear();
+    BLE_REPORT_CHANNEL.clear();
+    BLE_REPORT_CHANNEL
+        .try_send(Report::KeyboardReport(KeyboardReport::default()))
+        .expect("fill one-entry BLE queue");
+
+    let steno = [0x84, 1, 3, 7, 15, 31, 63, 0x85];
+    run_writer_test(async move {
+        let [keyboard, mouse, media, system, steno_report] = held_reports(steno);
+        let mut keyboard = pin!(send_hid_report(keyboard));
+        let mut mouse = pin!(send_hid_report(mouse));
+        let mut media = pin!(send_hid_report(media));
+        let mut system = pin!(send_hid_report(system));
+        let mut steno_report = pin!(send_hid_report(steno_report));
+        poll_fn(|cx| {
+            assert!(keyboard.as_mut().poll(cx).is_pending(), "keyboard send did not block");
+            assert!(mouse.as_mut().poll(cx).is_pending(), "mouse send did not block");
+            assert!(media.as_mut().poll(cx).is_pending(), "media send did not block");
+            assert!(system.as_mut().poll(cx).is_pending(), "system send did not block");
+            assert!(steno_report.as_mut().poll(cx).is_pending(), "steno send did not block");
+            Poll::Ready(())
+        })
+        .await;
+        set_preferred_connection(ConnectionType::Usb);
+
+        // Free the route that was active when these sends first blocked, then
+        // drive every pending future to completion. None may enqueue after the
+        // cutover, even though the old route now has room again.
+        BLE_REPORT_CHANNEL.clear();
+        keyboard.await;
+        assert!(
+            BLE_REPORT_CHANNEL.try_receive().is_err(),
+            "blocked keyboard escaped onto old BLE route"
+        );
+        mouse.await;
+        assert!(
+            BLE_REPORT_CHANNEL.try_receive().is_err(),
+            "blocked mouse escaped onto old BLE route"
+        );
+        media.await;
+        assert!(
+            BLE_REPORT_CHANNEL.try_receive().is_err(),
+            "blocked media escaped onto old BLE route"
+        );
+        system.await;
+        assert!(
+            BLE_REPORT_CHANNEL.try_receive().is_err(),
+            "blocked system control escaped onto old BLE route"
+        );
+        steno_report.await;
+        assert!(
+            BLE_REPORT_CHANNEL.try_receive().is_err(),
+            "blocked steno escaped onto old BLE route"
+        );
+
+        assert_snapshot(&collect_snapshot(steno).await, steno);
+    });
+}
