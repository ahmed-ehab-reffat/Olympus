+struct HostOutputController;
+
+impl embedded_io_async::ErrorType for HostOutputController {
+    type Error = Infallible;
+}
+
+impl bt_hci::controller::Controller for HostOutputController {
+    async fn write_acl_data(&self, packet: &AclPacket<'_>) -> Result<(), Self::Error> {
+        let mut bytes = Vec::new();
+        bytes
+            .extend_from_slice(packet.data())
+            .expect("outgoing ACL test packet fits");
+        CONTROLLER_OUTPUT.send(bytes).await;
+        Ok(())
+    }
+
+    async fn write_sync_data(&self, _: &bt_hci::data::SyncPacket<'_>) -> Result<(), Self::Error> {
+        core::future::pending().await
+    }
+
+    async fn write_iso_data(&self, _: &bt_hci::data::IsoPacket<'_>) -> Result<(), Self::Error> {
+        core::future::pending().await
+    }
+
+    async fn read<'a>(&self, buf: &'a mut [u8]) -> Result<ControllerToHostPacket<'a>, Self::Error> {
+        Ok(match CONTROLLER_INPUT.receive().await {
+            ControllerInput::Event(bytes) => {
+                buf[..bytes.len()].copy_from_slice(&bytes);
+                ControllerToHostPacket::from_hci_bytes_with_kind(PacketKind::Event, &buf[..bytes.len()])
+                    .expect("valid scripted HCI event")
+                    .0
+            }
+            ControllerInput::Acl(bytes) => {
+                buf[..bytes.len()].copy_from_slice(&bytes);
+                ControllerToHostPacket::Acl(AclPacket::new(
+                    ConnHandle::new(1),
+                    AclPacketBoundary::FirstFlushable,
+                    AclBroadcastFlag::PointToPoint,
+                    &buf[..bytes.len()],
+                ))
+            }
+        })
+    }
+}
+
+impl<C: SyncCmd> ControllerCmdSync<C> for HostOutputController {
+    async fn exec(&self, _: &C) -> Result<C::Return, bt_hci::cmd::Error<Self::Error>> {
+        let mut bytes = C::ReturnBuf::new();
+        if C::OPCODE == LeReadBufferSize::OPCODE {
+            bytes.as_mut()[..3].copy_from_slice(&[0xff, 0x00, 0xff]);
+        }
+        Ok(C::Return::from_hci_bytes_complete(bytes.as_ref()).expect("scripted command return is valid"))
+    }
+}
+
+impl<C: AsyncCmd> ControllerCmdAsync<C> for HostOutputController {
+    async fn exec(&self, _: &C) -> Result<(), bt_hci::cmd::Error<Self::Error>> {
+        Ok(())
+    }
+}
