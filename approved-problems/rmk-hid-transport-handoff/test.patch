+fn pressed_keyboard() -> Report {
+    Report::KeyboardReport(KeyboardReport {
+        modifier: 0x02,
+        reserved: 0,
+        leds: 0,
+        keycodes: [4, 0, 0, 0, 0, 0],
+    })
+}
+
+fn held_reports(steno: [u8; 8]) -> [Report; 5] {
+    [
+        pressed_keyboard(),
+        Report::MouseReport(MouseReport {
+            buttons: 3,
+            x: 9,
+            y: -8,
+            wheel: 7,
+            pan: -6,
+        }),
+        Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00e9 }),
+        Report::SystemControlReport(SystemControlReport { usage_id: 0x81 }),
+        Report::StenoReport(StenoReport { keys: steno }),
+    ]
+}
+
+fn family_payload(packet: &HostPacket) -> Option<(u8, &[u8])> {
+    match packet.endpoint {
+        1 => Some((1, packet.bytes.as_slice())),
+        2 if matches!(packet.bytes.first(), Some(2..=4)) => Some((packet.bytes[0], &packet.bytes[1..])),
+        3 if packet.bytes.first() == Some(&0x50) => Some((0x50, &packet.bytes[1..])),
+        _ => None,
+    }
+}
+
+async fn collect_snapshot(steno: [u8; 8]) -> BTreeMap<u8, std::vec::Vec<u8>> {
+    let mut reports = BTreeMap::new();
+    while reports.len() < 5 {
+        let packet = HOST_PACKETS.receive().await;
+        if let Some((family, payload)) = family_payload(&packet) {
+            let expected = match family {
+                1 => &[2, 0, 4, 0, 0, 0, 0, 0][..],
+                2 => &[3, 0, 0, 0, 0][..],
+                3 => &[0xe9, 0][..],
+                4 => &[0x81][..],
+                0x50 => &steno[..],
+                _ => continue,
+            };
+            if payload == expected {
+                reports.insert(family, payload.to_vec());
+            } else {
+                assert!(
+                    payload.iter().all(|byte| *byte == 0),
+                    "USB host received stale family {family:#x} before the current snapshot: {payload:?}"
+                );
+            }
+        }
+    }
+    reports
+}
+
+fn assert_snapshot(reports: &BTreeMap<u8, std::vec::Vec<u8>>, steno: [u8; 8]) {
+    assert_eq!(
+        reports.get(&1).map(std::vec::Vec::as_slice),
+        Some(&[2, 0, 4, 0, 0, 0, 0, 0][..])
+    );
+    assert_eq!(reports.get(&2).map(std::vec::Vec::as_slice), Some(&[3, 0, 0, 0, 0][..]));
+    assert_eq!(reports.get(&3).map(std::vec::Vec::as_slice), Some(&[0xe9, 0][..]));
+    assert_eq!(reports.get(&4).map(std::vec::Vec::as_slice), Some(&[0x81][..]));
+    assert_eq!(reports.get(&0x50).map(std::vec::Vec::as_slice), Some(&steno[..]));
+}
