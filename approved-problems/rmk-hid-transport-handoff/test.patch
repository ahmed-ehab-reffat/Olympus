+
+        loop {
+            let packet = HOST_PACKETS.receive().await;
+            let Some((family, payload)) = family_payload(&packet) else {
+                continue;
+            };
+            if family == 2 {
+                assert_eq!(payload.len(), 5);
+                assert!(
+                    payload[1..].iter().all(|byte| *byte == 0),
+                    "a report blocked during an earlier USB activation escaped after an intervening handoff: {payload:?}"
+                );
+            }
+            if family == 4 && payload == [0x84] {
+                break;
+            }
+        }
+    });
