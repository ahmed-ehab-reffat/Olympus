+enum ControllerInput {
+    Event(Vec<u8, 32>),
+    Acl(Vec<u8, 64>),
+}
+
+static CONTROLLER_INPUT: Channel<crate::RawMutex, ControllerInput, 4> = Channel::new();
+static CONTROLLER_OUTPUT: Channel<crate::RawMutex, Vec<u8, 64>, 4> = Channel::new();
+
+// Test-harness deadlock protection only; this is not a firmware latency requirement.
+const HOST_PROBE_WATCHDOG: Duration = Duration::from_secs(30);
