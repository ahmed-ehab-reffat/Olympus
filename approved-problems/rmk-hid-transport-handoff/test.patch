+fn connection_complete_event() -> ControllerInput {
+    let bytes = Vec::from_slice(&[
+        0x3e, 0x13, 0x01, 0x00, 0x01, 0x00, 0x01, 0x00, 1, 2, 3, 4, 5, 6, 0x06, 0x00, 0x00, 0x00, 0x64, 0x00, 0x00,
+    ])
+    .unwrap();
+    ControllerInput::Event(bytes)
+}
