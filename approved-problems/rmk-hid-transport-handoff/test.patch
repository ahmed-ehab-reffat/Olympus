+#[cfg(feature = "steno")]
+fn assert_neutral_ble_state(report_id: u8, payload: &[u8]) {
+    if matches!(report_id, 1 | 3 | 4 | 0x50) {
+        assert!(
+            payload.iter().all(|byte| *byte == 0),
