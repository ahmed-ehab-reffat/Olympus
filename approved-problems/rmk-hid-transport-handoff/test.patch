+#[cfg(not(feature = "steno"))]
+fn run_no_steno_ble_host_probe() {
+    CONTROLLER_INPUT.clear();
+    CONTROLLER_OUTPUT.clear();
+    BLE_REPORT_CHANNEL.clear();
+    USB_REPORT_CHANNEL.clear();
+
+    let server = Server::new_with_config(GapConfig::Peripheral(PeripheralConfig {
+        name: "rmk-no-steno-test",
+        appearance: &appearance::human_interface_device::KEYBOARD,
+    }))
+    .expect("construct no-steno BLE HID server");
+    let mut resources: HostResources<DefaultPacketPool, 1, 4> = HostResources::new();
+    let stack = trouble_host::new(HostOutputController, &mut resources)
+        .set_random_address(Address::random([7, 6, 5, 4, 3, 2]))
+        .build();
+    let runner = stack.runner();
+    let (mut rx, mut control, mut tx) = runner.split();
+
+    block_on(async {
+        let exercise_host_output = async {
+            let mut peripheral = stack.peripheral();
+            let adv_data = [2, 1, LE_GENERAL_DISCOVERABLE | BR_EDR_NOT_SUPPORTED];
+            let acceptor = peripheral
+                .advertise(
+                    &Default::default(),
+                    Advertisement::ConnectableScannableUndirected {
+                        adv_data: &adv_data,
+                        scan_data: &[],
+                    },
+                )
+                .await
+                .expect("start scripted no-steno BLE advertising");
+            CONTROLLER_INPUT.send(connection_complete_event()).await;
+            let conn = with_timeout(HOST_PROBE_WATCHDOG, acceptor.accept())
+                .await
+                .expect("scripted controller did not establish the no-steno BLE connection")
+                .expect("scripted no-steno BLE connection was rejected")
+                .with_attribute_server(&server)
+                .expect("attach no-steno RMK GATT server");
+            let cccd_handles = enable_every_notification(&server, &conn);
+            let mut value_handles = BTreeMap::new();
+            for cccd_handle in cccd_handles {
+                let reference_handle = cccd_handle + 1;
+                CONTROLLER_INPUT
+                    .send(att_request(&[
+                        0x0a,
+                        reference_handle as u8,
+                        (reference_handle >> 8) as u8,
+                    ]))
+                    .await;
+                loop {
+                    if let GattConnectionEvent::Gatt { event } = conn.next().await {
+                        event.accept().expect("accept report-reference read").send().await;
+                        break;
+                    }
+                }
+                let response = CONTROLLER_OUTPUT.receive().await;
+                if response.len() == 7 && response[4] == 0x0b && response[6] == 0x01 {
+                    value_handles.insert(response[5], cccd_handle - 1);
+                }
+            }
+            for report_id in [1, 2, 3, 4] {
+                assert!(
+                    value_handles.contains_key(&report_id),
+                    "no-steno BLE GATT service has no input report reference for id {report_id:#x}"
+                );
+            }
+
+            let observe = async {
+                set_preferred_connection(ConnectionType::Usb);
+                set_ble_state(BleState::Connected);
+                set_usb_state(UsbState::Configured);
+                USB_REPORT_CHANNEL.clear();
+                BLE_REPORT_CHANNEL.clear();
+                for report in [
+                    Report::KeyboardReport(KeyboardReport {
+                        modifier: 2,
+                        reserved: 0,
+                        leds: 0,
+                        keycodes: [4, 0, 0, 0, 0, 0],
+                    }),
+                    Report::MouseReport(MouseReport {
+                        buttons: 3,
+                        x: 9,
+                        y: -8,
+                        wheel: 7,
+                        pan: -6,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0x00e9 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0x81 }),
+                ] {
+                    send_hid_report(report).await;
+                    USB_REPORT_CHANNEL
+                        .try_receive()
+                        .expect("simulate delivery to the active USB host");
+                }
+
+                set_preferred_connection(ConnectionType::Ble);
+                let replay = collect_no_steno_snapshot(&value_handles).await;
+                assert_eq!(replay.get(&1).map(Vec::as_slice), Some(&[2, 0, 4, 0, 0, 0, 0, 0][..]));
+                assert_eq!(replay.get(&2).map(Vec::as_slice), Some(&[3, 0, 0, 0, 0][..]));
+                assert_eq!(replay.get(&3).map(Vec::as_slice), Some(&[0xe9, 0][..]));
+                assert_eq!(replay.get(&4).map(Vec::as_slice), Some(&[0x81][..]));
+
+                set_preferred_connection(ConnectionType::Usb);
+                USB_REPORT_CHANNEL.clear();
+                for report in [
+                    Report::KeyboardReport(KeyboardReport::default()),
+                    Report::MouseReport(MouseReport {
+                        buttons: 0,
+                        x: 0,
+                        y: 0,
+                        wheel: 0,
+                        pan: 0,
+                    }),
+                    Report::MediaKeyboardReport(MediaKeyboardReport { usage_id: 0 }),
+                    Report::SystemControlReport(SystemControlReport { usage_id: 0 }),
+                ] {
+                    send_hid_report(report).await;
+                    USB_REPORT_CHANNEL
+                        .try_receive()
+                        .expect("simulate delivery of the no-steno neutral state to USB");
+                }
+
+                set_preferred_connection(ConnectionType::Ble);
+                send_hid_report(Report::SystemControlReport(SystemControlReport { usage_id: 0x84 })).await;
+                loop {
+                    let (report_id, payload) = next_hid_notification(&value_handles).await;
+                    if report_id == 4 && payload.as_slice() == [0x84] {
+                        break;
+                    }
+                    assert!(
+                        payload.iter().all(|byte| *byte == 0),
+                        "stale report id {report_id:#x} crossed the no-steno BLE writer before its progress marker: {payload:?}"
+                    );
+                }
+            };
+            let battery = BleBatteryConfig::disabled();
+            let keyboard = run_ble_keyboard(
+                &server,
+                &conn,
+                &stack,
+                None,
+                &battery,
+                #[cfg(feature = "host")]
