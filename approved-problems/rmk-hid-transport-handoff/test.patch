+#[cfg(not(feature = "steno"))]
+async fn collect_no_steno_snapshot(value_handles: &BTreeMap<u8, u16>) -> BTreeMap<u8, Vec<u8, 16>> {
+    let mut reports = BTreeMap::new();
+    while reports.len() < 4 {
+        let (report_id, payload) = next_hid_notification(value_handles).await;
+        let expected = match report_id {
+            1 => &[2, 0, 4, 0, 0, 0, 0, 0][..],
+            2 => &[3, 0, 0, 0, 0][..],
+            3 => &[0xe9, 0][..],
+            4 => &[0x81][..],
+            _ => continue,
+        };
+        if payload.as_slice() == expected {
+            reports.insert(report_id, payload);
+        } else {
+            assert!(
+                payload.iter().all(|byte| *byte == 0),
+                "no-steno BLE host received stale report id {report_id:#x} before current replay: {payload:?}"
+            );
+        }
+    }
+    reports
+}
