+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+package com.mojang.serialization.codecs;
+
+import com.mojang.datafixers.util.Pair;
+import com.mojang.serialization.Codec;
+import com.mojang.serialization.DataResult;
+import com.mojang.serialization.DynamicOps;
+import com.mojang.serialization.Lifecycle;
+
+import java.util.List;
+import java.util.Objects;
+
+public final class OrderedAlternativesCodec<A> implements Codec<A> {
+    private final List<? extends Codec<? extends A>> codecs;
+    private final List<String> labels;
+
+    public OrderedAlternativesCodec(final List<? extends Codec<? extends A>> codecs, final List<String> labels) {
+        OrderedAlternativesSupport.requireNonEmpty(codecs);
+        OrderedAlternativesSupport.requireNoDuplicateIdentity(codecs);
+        this.codecs = List.copyOf(codecs);
+        this.labels = labels == null ? null : OrderedAlternativesSupport.requireMatchingLabels(codecs, labels);
+    }
+
+    private static <A, B extends A, T> DataResult<Pair<A, T>> decodeAs(final Codec<B> codec, final DynamicOps<T> ops, final T input) {
+        return codec.decode(ops, input).map(pair -> Pair.<A, T>of(pair.getFirst(), pair.getSecond()));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <A, B extends A, T> DataResult<T> encodeAs(final Codec<B> codec, final A input, final DynamicOps<T> ops, final T prefix) {
+        try {
+            return codec.encode((B) input, ops, prefix);
+        } catch (final ClassCastException e) {
+            return DataResult.error(() -> "Value is not compatible with candidate codec: " + e.getMessage());
+        }
+    }
+
+    @Override
+    public <T> DataResult<Pair<A, T>> decode(final DynamicOps<T> ops, final T input) {
+        DataResult<Pair<A, T>> firstPartial = null;
+        Lifecycle combinedPartialLifecycle = Lifecycle.stable();
+        final StringBuilder messages = new StringBuilder();
+        for (int i = 0; i < codecs.size(); i++) {
+            final DataResult<Pair<A, T>> read = decodeAs(codecs.get(i), ops, input);
+            if (read.isSuccess()) {
+                return read;
+            }
+            combinedPartialLifecycle = OrderedAlternativesSupport.foldPartialLifecycle(combinedPartialLifecycle, read);
+            if (firstPartial == null && read.hasResultOrPartial()) {
+                firstPartial = read;
+            }
+            OrderedAlternativesSupport.appendAttempt(messages, OrderedAlternativesSupport.labelAt(labels, i), read.error().orElseThrow().message());
+        }
+        return OrderedAlternativesSupport.finish(firstPartial, combinedPartialLifecycle, messages);
+    }
+
+    @Override
+    public <T> DataResult<T> encode(final A input, final DynamicOps<T> ops, final T prefix) {
+        DataResult<T> firstPartial = null;
+        Lifecycle combinedPartialLifecycle = Lifecycle.stable();
+        final StringBuilder messages = new StringBuilder();
+        for (int i = 0; i < codecs.size(); i++) {
+            final DataResult<T> written = encodeAs(codecs.get(i), input, ops, prefix);
+            if (written.isSuccess()) {
+                return written;
+            }
+            combinedPartialLifecycle = OrderedAlternativesSupport.foldPartialLifecycle(combinedPartialLifecycle, written);
+            if (firstPartial == null && written.hasResultOrPartial()) {
+                firstPartial = written;
+            }
+            OrderedAlternativesSupport.appendAttempt(messages, OrderedAlternativesSupport.labelAt(labels, i), written.error().orElseThrow().message());
+        }
+        return OrderedAlternativesSupport.finish(firstPartial, combinedPartialLifecycle, messages);
+    }
+
+    @Override
+    public boolean equals(final Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (!(o instanceof final OrderedAlternativesCodec<?> that)) {
+            return false;
+        }
+        return OrderedAlternativesSupport.identityEquals(codecs, that.codecs) && Objects.equals(labels, that.labels);
+    }
+
+    @Override
+    public int hashCode() {
+        return 31 * OrderedAlternativesSupport.identityHash(codecs) + Objects.hashCode(labels);
+    }
+
+    @Override
+    public String toString() {
+        return OrderedAlternativesSupport.describe("OrderedAlternatives", codecs, labels);
+    }
+}
