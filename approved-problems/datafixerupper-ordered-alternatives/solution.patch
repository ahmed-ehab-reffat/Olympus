+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+package com.mojang.serialization.codecs;
+
+import com.mojang.serialization.DataResult;
+import com.mojang.serialization.DynamicOps;
+import com.mojang.serialization.Lifecycle;
+import com.mojang.serialization.MapCodec;
+import com.mojang.serialization.MapLike;
+import com.mojang.serialization.RecordBuilder;
+
+import java.util.List;
+import java.util.Objects;
+import java.util.function.UnaryOperator;
+import java.util.stream.Stream;
+
+public final class OrderedAlternativesMapCodec<A> extends MapCodec<A> {
+    private final List<? extends MapCodec<? extends A>> codecs;
+    private final List<String> labels;
+
+    public OrderedAlternativesMapCodec(final List<? extends MapCodec<? extends A>> codecs, final List<String> labels) {
+        OrderedAlternativesSupport.requireNonEmpty(codecs);
+        OrderedAlternativesSupport.requireNoDuplicateIdentity(codecs);
+        this.codecs = List.copyOf(codecs);
+        this.labels = labels == null ? null : OrderedAlternativesSupport.requireMatchingLabels(codecs, labels);
+    }
+
+    private static <A, B extends A, T> DataResult<A> decodeAs(final MapCodec<B> codec, final DynamicOps<T> ops, final MapLike<T> input) {
+        return codec.decode(ops, input).map(value -> value);
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <A, B extends A, T> RecordBuilder<T> encodeAs(final MapCodec<B> codec, final A input, final DynamicOps<T> ops, final RecordBuilder<T> prefix) {
+        try {
+            return codec.encode((B) input, ops, prefix);
+        } catch (final ClassCastException e) {
+            return prefix.withErrorsFrom(DataResult.error(() -> "Value is not compatible with candidate codec: " + e.getMessage()));
+        }
+    }
+
+    private static final class StableWhenNoPartialBuilder<T> implements RecordBuilder<T> {
+        private final RecordBuilder<T> delegate;
+
+        private StableWhenNoPartialBuilder(final RecordBuilder<T> delegate) {
+            this.delegate = delegate;
+        }
+
+        @Override
+        public DynamicOps<T> ops() {
+            return delegate.ops();
+        }
+
+        @Override
+        public RecordBuilder<T> add(final T key, final T value) {
+            return new StableWhenNoPartialBuilder<>(delegate.add(key, value));
+        }
+
+        @Override
+        public RecordBuilder<T> add(final T key, final DataResult<T> value) {
+            return new StableWhenNoPartialBuilder<>(delegate.add(key, value));
+        }
+
+        @Override
+        public RecordBuilder<T> add(final DataResult<T> key, final DataResult<T> value) {
+            return new StableWhenNoPartialBuilder<>(delegate.add(key, value));
+        }
+
+        @Override
+        public RecordBuilder<T> withErrorsFrom(final DataResult<?> result) {
+            return new StableWhenNoPartialBuilder<>(delegate.withErrorsFrom(result));
+        }
+
+        @Override
+        public RecordBuilder<T> setLifecycle(final Lifecycle lifecycle) {
+            return delegate.setLifecycle(lifecycle);
+        }
+
+        @Override
+        public RecordBuilder<T> mapError(final UnaryOperator<String> onError) {
+            return new StableWhenNoPartialBuilder<>(delegate.mapError(onError));
+        }
+
+        @Override
+        public DataResult<T> build(final T prefix) {
+            final DataResult<T> result = delegate.build(prefix);
+            if (result.hasResultOrPartial()) {
+                return result;
+            }
+            return result.setLifecycle(Lifecycle.stable());
+        }
+    }
+
+    @Override
+    public <T> DataResult<A> decode(final DynamicOps<T> ops, final MapLike<T> input) {
+        DataResult<A> firstPartial = null;
+        Lifecycle combinedPartialLifecycle = Lifecycle.stable();
+        final StringBuilder messages = new StringBuilder();
+        for (int i = 0; i < codecs.size(); i++) {
+            final DataResult<A> read = decodeAs(codecs.get(i), ops, input);
+            if (read.isSuccess()) {
+                return read;
+            }
+            combinedPartialLifecycle = OrderedAlternativesSupport.foldPartialLifecycle(combinedPartialLifecycle, read);
+            if (firstPartial == null && read.hasResultOrPartial()) {
+                firstPartial = read;
+            }
+            OrderedAlternativesSupport.appendAttempt(messages, OrderedAlternativesSupport.labelAt(labels, i), read.error().orElseThrow().message());
+        }
+        return OrderedAlternativesSupport.finish(firstPartial, combinedPartialLifecycle, messages);
+    }
+
+    @Override
+    public <T> RecordBuilder<T> encode(final A input, final DynamicOps<T> ops, final RecordBuilder<T> prefix) {
+        final String label = OrderedAlternativesSupport.labelAt(labels, 0);
+        final UnaryOperator<String> describe = message -> OrderedAlternativesSupport.describeAttempt(label, message);
+        final RecordBuilder<T> encoded = encodeAs(codecs.get(0), input, ops, prefix);
+        return new StableWhenNoPartialBuilder<>(encoded.mapError(describe));
+    }
+
+    @Override
+    public <T> Stream<T> keys(final DynamicOps<T> ops) {
+        return codecs.stream().flatMap(codec -> codec.keys(ops));
+    }
+
+    @Override
+    public boolean equals(final Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (!(o instanceof final OrderedAlternativesMapCodec<?> that)) {
+            return false;
+        }
+        return OrderedAlternativesSupport.identityEquals(codecs, that.codecs) && Objects.equals(labels, that.labels);
+    }
+
+    @Override
+    public int hashCode() {
+        return 31 * OrderedAlternativesSupport.identityHash(codecs) + Objects.hashCode(labels);
+    }
+
+    @Override
+    public String toString() {
+        return OrderedAlternativesSupport.describe("OrderedAlternativesMapCodec", codecs, labels);
+    }
+}
