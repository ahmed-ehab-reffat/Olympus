@@ -0,0 +1,130 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+package com.mojang.serialization.codecs;
+
+import com.mojang.serialization.DataResult;
+import com.mojang.serialization.Lifecycle;
+
+import java.util.List;
+
+final class OrderedAlternativesSupport {
+    private OrderedAlternativesSupport() {}
+
+    static void appendAttempt(final StringBuilder messages, final String label, final String message) {
+        if (messages.length() > 0) {
+            messages.append("; ");
+        }
+        messages.append(describeAttempt(label, message));
+    }
+
+    static String describeAttempt(final String label, final String message) {
+        return "Alternative " + label + ": " + message;
+    }
+
+    static <R> Lifecycle foldPartialLifecycle(final Lifecycle combined, final DataResult<R> attempt) {
+        if (attempt.hasResultOrPartial()) {
+            return combined.add(attempt.lifecycle());
+        }
+        return combined;
+    }
+
+    static <R> DataResult<R> finish(final DataResult<R> firstPartial, final Lifecycle combinedPartialLifecycle, final StringBuilder messages) {
+        if (firstPartial != null) {
+            return DataResult.error(messages::toString, firstPartial.resultOrPartial().orElseThrow(), combinedPartialLifecycle);
+        }
+        return DataResult.error(messages::toString, combinedPartialLifecycle);
+    }
+
+    static void requireNonEmpty(final List<?> codecs) {
+        if (codecs == null) {
+            throw new IllegalArgumentException("orderedAlternatives does not accept a null codec list");
+        }
+        if (codecs.isEmpty()) {
+            throw new IllegalArgumentException("orderedAlternatives requires at least one codec");
+        }
+    }
+
+    static List<String> requireMatchingLabels(final List<?> codecs, final List<String> labels) {
+        if (labels.size() != codecs.size()) {
+            throw new IllegalArgumentException("orderedAlternatives requires exactly one label per codec, got " + labels.size() + " labels for " + codecs.size() + " codecs");
+        }
+        requireNoBlankLabels(labels);
+        final List<String> duplicates = findDuplicateLabels(labels);
+        if (!duplicates.isEmpty()) {
+            throw new IllegalArgumentException("orderedAlternatives requires unique labels, found duplicate name(s): " + duplicates);
+        }
+        return List.copyOf(labels);
+    }
+
+    private static void requireNoBlankLabels(final List<String> labels) {
+        for (int i = 0; i < labels.size(); i++) {
+            if (labels.get(i).isBlank()) {
+                throw new IllegalArgumentException("orderedAlternatives requires non-blank labels, label at index " + i + " is blank");
+            }
+        }
+    }
+
+    private static List<String> findDuplicateLabels(final List<String> labels) {
+        final java.util.Set<String> seen = new java.util.HashSet<>();
+        final java.util.LinkedHashSet<String> duplicates = new java.util.LinkedHashSet<>();
+        for (final String label : labels) {
+            if (!seen.add(label)) {
+                duplicates.add(label);
+            }
+        }
+        return List.copyOf(duplicates);
+    }
+
+    static boolean identityEquals(final List<?> a, final List<?> b) {
+        if (a == b) {
+            return true;
+        }
+        if (a == null || b == null || a.size() != b.size()) {
+            return false;
+        }
+        for (int i = 0; i < a.size(); i++) {
+            if (a.get(i) != b.get(i)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static int identityHash(final List<?> list) {
+        int result = 1;
+        for (final Object candidate : list) {
+            result = 31 * result + System.identityHashCode(candidate);
+        }
+        return result;
+    }
+
+    static String labelAt(final List<String> labels, final int index) {
+        return labels == null ? String.valueOf(index) : labels.get(index);
+    }
+
+    static <C> String describe(final String name, final List<? extends C> codecs, final List<String> labels) {
+        final StringBuilder builder = new StringBuilder(name).append('[');
+        for (int i = 0; i < codecs.size(); i++) {
+            if (i > 0) {
+                builder.append(", ");
+            }
+            if (labels != null) {
+                builder.append(labels.get(i)).append('=');
+            }
+            builder.append(codecs.get(i));
+        }
+        return builder.append(']').toString();
+    }
+
+    static <C> void requireNoDuplicateIdentity(final List<? extends C> codecs) {
+        final java.util.Map<C, Integer> firstIndexOf = new java.util.IdentityHashMap<>();
+        for (int i = 0; i < codecs.size(); i++) {
+            final C codec = codecs.get(i);
+            java.util.Objects.requireNonNull(codec, "orderedAlternatives does not accept a null codec at index " + i);
+            final Integer earlierIndex = firstIndexOf.putIfAbsent(codec, i);
+            if (earlierIndex != null) {
+                throw new IllegalArgumentException("orderedAlternatives requires distinct codec instances, index " + i + " duplicates index " + earlierIndex + ": " + codec);
+            }
+        }
+    }
+}
