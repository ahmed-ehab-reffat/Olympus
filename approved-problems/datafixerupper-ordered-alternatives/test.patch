+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)         MODE="$1"; shift ;;
+    *)                shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+NEW_TEST_FILE="src/test/java/com/mojang/serialization/OrderedAlternativesCodecTests_a59e37.java"
+NEW_TEST_CLASS="com.mojang.serialization.OrderedAlternativesCodecTests_a59e37"
+
+LIB_DIR="${DFU_TEST_LIBS:-/opt/testlibs}"
+
+JAVA_BIN="java"
+JAVAC_BIN="javac"
+if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/javac" ]; then
+  JAVA_BIN="$JAVA_HOME/bin/java"
+  JAVAC_BIN="$JAVA_HOME/bin/javac"
+fi
+
+WORK=""
+for base_dir in "${TMPDIR:-/tmp}" "$PWD" "${HOME:-}"; do
+  [ -n "$base_dir" ] || continue
+  [ -d "$base_dir" ] || continue
+  candidate="$(mktemp -d "$base_dir/dfu-junit.XXXXXX" 2>/dev/null)" || continue
+  WORK="$candidate"
+  break
+done
+if [ -z "$WORK" ]; then
+  echo "test.sh: could not create a writable working directory" >&2
+  exit 1
+fi
+cleanup() { rm -rf "$WORK"; }
+trap cleanup EXIT
+
+CLASSPATH_LIBS=""
+if [ -d "$LIB_DIR" ]; then
+  CLASSPATH_LIBS="$(find "$LIB_DIR" -name '*.jar' | sort | tr '\n' ':')"
+fi
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+write_setup_failure() {
+  message="$1"
+  detail="$2"
+  echo "test.sh: $message" >&2
+  echo "$detail" >&2
+  if [ -n "$OUTPUT_PATH" ]; then
+    escaped_detail="$(printf '%s' "$detail" | xml_escape)"
+    escaped_message="$(printf '%s' "$message" | xml_escape)"
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo '<testsuite name="setup" tests="1" skipped="0" failures="1" errors="0">'
+      echo '<testcase name="test_environment" classname="setup">'
+      echo "<failure message=\"$escaped_message\">$escaped_detail</failure>"
+      echo '</testcase>'
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+}
+
+write_empty_base_suite() {
+  echo "test.sh: no pre-existing test sources under src/test/java, base mode has nothing to run" >&2
+  if [ -n "$OUTPUT_PATH" ]; then
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo '<testsuite name="base" tests="1" skipped="1" failures="0" errors="0">'
+      echo '<testcase name="no_preexisting_tests" classname="base">'
+      echo '<skipped/>'
+      echo '</testcase>'
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+}
+
+write_compile_failure() {
+  detail="$1"
+  if [ "$MODE" = "new" ] && [ -f "$NEW_TEST_FILE" ]; then
+    names="$(grep -oE 'public void [A-Za-z0-9_]+\(\)' "$NEW_TEST_FILE" | sed -E 's/public void ([A-Za-z0-9_]+)\(\)/\1/')"
+    count="$(printf '%s\n' "$names" | grep -c . || true)"
+    if [ -n "$OUTPUT_PATH" ] && [ "$count" -gt 0 ]; then
+      escaped_detail="$(printf '%s' "$detail" | xml_escape)"
+      {
+        echo '<?xml version="1.0" encoding="UTF-8"?>'
+        echo '<testsuites>'
+        echo "<testsuite name=\"$NEW_TEST_CLASS\" tests=\"$count\" skipped=\"0\" failures=\"$count\" errors=\"0\">"
+        while IFS= read -r name; do
+          [ -n "$name" ] || continue
+          echo "<testcase name=\"$name\" classname=\"$NEW_TEST_CLASS\">"
+          echo "<failure message=\"Compilation failed\">$escaped_detail</failure>"
+          echo '</testcase>'
+        done <<< "$names"
+        echo '</testsuite>'
+        echo '</testsuites>'
+      } > "$OUTPUT_PATH"
+      return
+    fi
+  fi
+  write_setup_failure "compilation failed" "$detail"
+}
+
+if ! command -v "$JAVAC_BIN" >/dev/null 2>&1 && [ ! -x "$JAVAC_BIN" ]; then
+  write_setup_failure "no Java compiler available" "javac was not found on PATH and JAVA_HOME was not usable."
+  exit 1
+fi
+if [ -z "$CLASSPATH_LIBS" ]; then
+  write_setup_failure "no dependency jars available" "Expected the project dependencies as jars under $LIB_DIR (override with DFU_TEST_LIBS)."
+  exit 1
+fi
+
+find src/main/java -name '*.java' > "$WORK/main-sources.txt"
+if ! "$JAVAC_BIN" -nowarn -encoding UTF-8 -d "$WORK/classes" -cp "$CLASSPATH_LIBS" "@$WORK/main-sources.txt" > "$WORK/main-compile.log" 2>&1; then
+  write_compile_failure "$(tail -n 40 "$WORK/main-compile.log")"
+  exit 1
+fi
+
+if [ "$MODE" = "new" ]; then
+  if [ ! -f "$NEW_TEST_FILE" ]; then
+    write_setup_failure "new tests are missing" "Expected $NEW_TEST_FILE to exist."
+    exit 1
+  fi
+  printf '%s\n' "$NEW_TEST_FILE" > "$WORK/test-sources.txt"
+  echo "$NEW_TEST_CLASS" > "$WORK/test-classes.txt"
+else
