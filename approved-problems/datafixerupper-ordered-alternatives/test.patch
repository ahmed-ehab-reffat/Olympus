+    public void mapCodecWithLifecycleStillNormalizesWhenNoOuterLifecycleIsApplied() {
+        final MapCodec<String> codec = MapCodec.orderedAlternatives(List.of(mapEncodeFailure("bad")));
+        final DataResult<Object> built = codec.encode("whatever", JavaOps.INSTANCE, JavaOps.INSTANCE.mapBuilder()).build(JavaOps.INSTANCE.empty());
+        assertEquals(Lifecycle.stable(), built.lifecycle());
+    }
+
+    @Test
+    public void labeledVariantEqualsUsesLabelValueNotLabelIdentity() {
+        final Codec<String> a = valueEqualCodec("a");
+        final Codec<String> b = valueEqualCodec("b");
+        final Codec<String> first = Codec.orderedAlternativesLabeled(List.of(Pair.of(new String("first"), a), Pair.of(new String("second"), b)));
+        final Codec<String> second = Codec.orderedAlternativesLabeled(List.of(Pair.of(new String("first"), a), Pair.of(new String("second"), b)));
+        assertTrue("expected value-equal labels to compare equal", first.equals(second));
+        assertEquals(first.hashCode(), second.hashCode());
+    }
+
+    @Test
+    public void mapCodecLabeledVariantEqualsUsesLabelValueNotLabelIdentity() {
+        final MapCodec<String> a = valueEqualMapCodec("a");
+        final MapCodec<String> b = valueEqualMapCodec("b");
+        final MapCodec<String> first = MapCodec.orderedAlternativesLabeled(List.of(Pair.of(new String("first"), a), Pair.of(new String("second"), b)));
+        final MapCodec<String> second = MapCodec.orderedAlternativesLabeled(List.of(Pair.of(new String("first"), a), Pair.of(new String("second"), b)));
+        assertTrue("expected value-equal labels to compare equal", first.equals(second));
+        assertEquals(first.hashCode(), second.hashCode());
+    }
+
+    @Test
+    public void labeledVariantEqualsIsFalseWhenLabelledCandidatesAreReordered() {
+        final Codec<String> a = valueEqualCodec("a");
+        final Codec<String> b = valueEqualCodec("b");
+        final Codec<String> first = Codec.orderedAlternativesLabeled(List.of(Pair.of("one", a), Pair.of("two", b)));
+        final Codec<String> second = Codec.orderedAlternativesLabeled(List.of(Pair.of("two", b), Pair.of("one", a)));
+        assertFalse("expected reordered labeled candidates to compare unequal", first.equals(second));
+    }
+
+    @Test
+    public void mapCodecLabeledVariantEqualsIsFalseWhenLabelledCandidatesAreReordered() {
+        final MapCodec<String> a = valueEqualMapCodec("a");
+        final MapCodec<String> b = valueEqualMapCodec("b");
+        final MapCodec<String> first = MapCodec.orderedAlternativesLabeled(List.of(Pair.of("one", a), Pair.of("two", b)));
+        final MapCodec<String> second = MapCodec.orderedAlternativesLabeled(List.of(Pair.of("two", b), Pair.of("one", a)));
+        assertFalse("expected reordered labeled candidates to compare unequal", first.equals(second));
+    }
+
+    @Test
+    public void mapCodecEncodeReturnedOnlyFailureLeavesTheSuppliedBuilderSuccessful() {
+        final MapCodec<String> codec = MapCodec.orderedAlternatives(List.of(mapEncodeReplacementError(DataResult.error(() -> "returned-bad", Lifecycle.experimental()))));
+        final RecordBuilder<Object> prefix = JavaOps.INSTANCE.mapBuilder();
+        final DataResult<Object> returned = codec.encode("whatever", JavaOps.INSTANCE, prefix).build(JavaOps.INSTANCE.empty());
+        assertFalse("expected the replacement failure on the returned builder, got: " + returned, returned.isSuccess());
+        assertTrue("expected position 0 identifier in: " + returned, returned.error().orElseThrow().message().contains("0"));
+        assertEquals(Lifecycle.stable(), returned.lifecycle());
+        final DataResult<Object> supplied = prefix.build(JavaOps.INSTANCE.empty());
+        assertTrue("expected the supplied builder to stay successful, got: " + supplied, supplied.isSuccess());
+        assertEquals(java.util.Map.of("ignored", "whatever"), supplied.result().orElseThrow());
+    }
+
+    @Test
+    public void labeledMapCodecEncodeReturnedOnlyFailureLeavesTheSuppliedBuilderSuccessful() {
+        final MapCodec<String> codec = MapCodec.orderedAlternativesLabeled(List.of(Pair.of("primary",
+            mapEncodeReplacementError(DataResult.error(() -> "returned-bad", Lifecycle.experimental())))));
+        final RecordBuilder<Object> prefix = JavaOps.INSTANCE.mapBuilder();
+        final DataResult<Object> returned = codec.encode("whatever", JavaOps.INSTANCE, prefix).build(JavaOps.INSTANCE.empty());
+        assertTrue("expected the label in: " + returned, returned.error().orElseThrow().message().contains("primary"));
+        final DataResult<Object> supplied = prefix.build(JavaOps.INSTANCE.empty());
+        assertTrue("expected the supplied builder to stay successful, got: " + supplied, supplied.isSuccess());
+    }
+}
