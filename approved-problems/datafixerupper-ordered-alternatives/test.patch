+    private static final class PersistentRecordBuilder implements RecordBuilder<Object> {
+        private final DataResult<java.util.Map<Object, Object>> state;
+
+        private PersistentRecordBuilder(final DataResult<java.util.Map<Object, Object>> state) {
+            this.state = state;
+        }
+
+        private static PersistentRecordBuilder empty() {
+            return new PersistentRecordBuilder(DataResult.success(java.util.Map.of(), Lifecycle.stable()));
+        }
+
+        private static java.util.Map<Object, Object> append(final java.util.Map<Object, Object> map, final Object key, final Object value) {
+            final java.util.Map<Object, Object> next = new java.util.LinkedHashMap<>(map);
+            next.put(key, value);
+            return next;
+        }
+
+        @Override
+        public DynamicOps<Object> ops() {
+            return JavaOps.INSTANCE;
+        }
+
+        @Override
+        public RecordBuilder<Object> add(final Object key, final Object value) {
+            return new PersistentRecordBuilder(state.map(map -> append(map, key, value)));
+        }
+
+        @Override
+        public RecordBuilder<Object> add(final Object key, final DataResult<Object> value) {
+            return new PersistentRecordBuilder(state.apply2stable((map, v) -> append(map, key, v), value));
+        }
+
+        @Override
+        public RecordBuilder<Object> add(final DataResult<Object> key, final DataResult<Object> value) {
+            return new PersistentRecordBuilder(state.ap(key.apply2stable((k, v) -> map -> append(map, k, v), value)));
+        }
+
+        @Override
+        public RecordBuilder<Object> withErrorsFrom(final DataResult<?> result) {
+            return new PersistentRecordBuilder(state.flatMap(map -> result.map(ignored -> map)));
+        }
+
+        @Override
+        public RecordBuilder<Object> setLifecycle(final Lifecycle lifecycle) {
+            return new PersistentRecordBuilder(state.setLifecycle(lifecycle));
+        }
+
+        @Override
+        public RecordBuilder<Object> mapError(final java.util.function.UnaryOperator<String> onError) {
+            return new PersistentRecordBuilder(state.mapError(onError));
+        }
+
+        @Override
+        public DataResult<Object> build(final Object prefix) {
+            return state.map(map -> map);
+        }
+    }
