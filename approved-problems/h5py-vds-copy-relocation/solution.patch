+    @classmethod
+    def from_dataset(cls, dataset):
+        """Build an independent layout from an existing virtual dataset.
+
+        Source datasets are opened only for mappings which select the entire
+        source and therefore do not store their own extent. The returned
+        layout can be extended or relocated after the source file is closed.
+        """
+        from .dataset import Dataset
+
+        if not isinstance(dataset, Dataset) or not dataset.is_virtual:
+            raise TypeError("dataset must be a virtual Dataset")
+
+        source_filename = dataset.file.filename
+        layout = cls(
+            dataset.shape,
+            dataset.dtype,
+            maxshape=dataset.maxshape,
+            filename=source_filename,
+        )
+        source_dcpl = dataset.id.get_create_plist()
+        try:
+            try:
+                _copy_creation_properties(
+                    source_dcpl, layout.dcpl, dataset.dtype
+                )
+
+                for mapping in dataset.virtual_sources():
+                    source_space = _mapping_source_space(dataset, mapping)
+                    try:
+                        layout.dcpl.set_virtual(
+                            mapping.vspace,
+                            filename_encode(mapping.file_name),
+                            filename_encode(mapping.dset_name),
+                            source_space,
+                        )
+                    finally:
+                        source_space.close()
+                        mapping.vspace.close()
+            except Exception:
+                layout.dcpl.close()
+                raise
+        finally:
+            source_dcpl.close()
+
+        return layout
+
+    def relocated(self, filename, *, source_filename=None):
+        """Return an independent layout targeted at *filename*.
+
+        Relative mapping names are rebased from this layout's current target
+        file to the new target. Absolute names retain their original spelling.
+        For a layout created without a target filename, *source_filename* must
+        establish the file from which its relative names should be resolved.
+        """
+        if self._filename is None:
+            if source_filename is None:
+                raise ValueError(
+                    "source_filename is required for a layout without a "
+                    "target filename"
+                )
+            current_filename = os.fspath(source_filename)
+        elif source_filename is not None:
+            raise TypeError(
+                "source_filename is only valid for a layout without a "
+                "target filename"
+            )
+        else:
+            current_filename = self._filename
+
+        filename = os.fspath(filename)
+        relocated = type(self)(
+            self.shape,
+            self.dtype,
+            maxshape=self.maxshape,
+            filename=filename,
+        )
+        try:
+            _copy_creation_properties(self.dcpl, relocated.dcpl, self.dtype)
+
+            for mapping in self._virtual_sources():
+                try:
+                    relocated_filename = _relocated_source_filename(
+                        mapping.file_name, current_filename, filename
+                    )
+                    relocated.dcpl.set_virtual(
+                        mapping.vspace,
+                        filename_encode(relocated_filename),
+                        filename_encode(mapping.dset_name),
+                        mapping.src_space,
+                    )
+                finally:
+                    mapping.src_space.close()
+                    mapping.vspace.close()
+        except Exception:
+            relocated.dcpl.close()
+            raise
+
+        return relocated
+
+    def _virtual_sources(self):
+        """Return independent mapping records for this layout."""
