+def _copy_dataset_attributes(source, destination):
+    """Copy attributes without publishing the destination dataset first."""
+    for name in source.attrs:
+        source_attr = h5a.open(source.id, source._e(name))
+        try:
+            source_space = source_attr.get_space()
+            source_type = source_attr.get_type()
+            try:
+                destination_attr = h5a.create(
+                    destination.id,
+                    destination._e(name),
+                    source_type,
+                    source_space,
+                )
+                try:
+                    if source_space.get_simple_extent_type() != h5s.NULL:
+                        data = numpy.empty(
+                            source_attr.shape, dtype=source_attr.dtype
+                        )
+                        source_attr.read(data)
+
+                        reference_type = h5t.check_dtype(
+                            ref=source_attr.dtype
+                        )
+                        if reference_type is not None:
+                            # Native cross-file copies leave references null
+                            # unless expand_refs is requested.
+                            data[...] = reference_type()
+
+                        destination_attr.write(data)
+                finally:
+                    destination_attr.close()
+            finally:
+                source_type.close()
+                source_space.close()
+        finally:
+            source_attr.close()
+
+
+def _copy_relocated_vds(source, destination, destination_path, without_attrs):
+    """Reconstruct and atomically publish a relocated virtual dataset."""
+    layout = VirtualLayout.from_dataset(source).relocated(
+        destination.file.filename
+    )
+    dataset_id = layout.make_dataset(destination, name=None)
+    relocated = dataset.Dataset(dataset_id)
+
+    try:
+        if not without_attrs:
+            _copy_dataset_attributes(source, relocated)
+        h5o.link(
+            relocated.id,
+            destination.id,
+            destination._e(destination_path),
+            lcpl=base.dlcpl,
+        )
+    finally:
+        relocated.id.close()
+
+
