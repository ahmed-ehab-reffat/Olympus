+def test_unlimited_mapping_tracks_growth_in_original_source(tmp_path):
+    source_path = tmp_path / "source" / "source.h5"
+    destination_path = tmp_path / "destination" / "copy.h5"
+    source_path.parent.mkdir()
+    destination_path.parent.mkdir()
+
+    initial = np.arange(6, dtype=np.int64).reshape(3, 2)
+    with h5py.File(source_path, "w") as source:
+        data = source.create_dataset(
+            "data",
+            data=initial,
+            maxshape=(None, 2),
+            chunks=(3, 2),
+        )
+        layout = h5py.VirtualLayout((3, 1), dtype=data.dtype, maxshape=(None, 1))
+        layout[:h5py.UNLIMITED, 0] = h5py.VirtualSource(data)[:h5py.UNLIMITED, 1]
+        source.create_virtual_dataset("view", layout, fillvalue=-1)
+
+    with h5py.File(source_path, "r") as source, h5py.File(destination_path, "w") as destination:
+        source.copy("view", destination, relocate_vds=True)
+
+    with h5py.File(source_path, "r+") as source:
+        source["data"].resize((6, 2))
+        source["data"][3:, 1] = [11, 12, 13]
+
+    with h5py.File(destination_path, "r") as destination:
+        copied = destination["view"]
+        assert copied.maxshape == (None, 1)
+        np.testing.assert_array_equal(copied[:, 0], [1, 3, 5, 11, 12, 13])
+
