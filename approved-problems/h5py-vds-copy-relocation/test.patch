+import inspect
+import os
+
+import numpy as np
+import pytest
+
+import h5py
+
+
+def _assert_relocation_option():
+    assert "relocate_vds" in inspect.signature(h5py.Group.copy).parameters
+
+
+def _assert_layout_api():
+    assert hasattr(h5py.VirtualLayout, "from_dataset")
+    assert hasattr(h5py.VirtualLayout, "relocated")
+
+
+def _write_dataset(path, values, name="data", **kwargs):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with h5py.File(path, "w") as h5file:
+        h5file.create_dataset(name, data=values, **kwargs)
+
+
+def _resolved_mapping(dataset, index=0):
+    stored = dataset.virtual_sources()[index].file_name
+    return os.path.realpath(os.path.join(os.path.dirname(dataset.file.filename), stored))
+
+
+def _mapping_selections(dataset):
+    return [
+        (
+            mapping.vspace.get_select_type(),
+            mapping.vspace.get_select_bounds(),
+            mapping.src_space.get_select_type(),
+            mapping.src_space.get_select_bounds(),
+        )
+        for mapping in dataset.virtual_sources()
+    ]
+
+
+def test_relative_mapping_preserves_source_and_public_copy_forms(tmp_path):
+    source_data = tmp_path / "original" / "data" / "chunks.h5"
+    source_vds = tmp_path / "original" / "views" / "catalog.h5"
+    destination_data = tmp_path / "relocated" / "data" / "chunks.h5"
+    destination_vds = tmp_path / "relocated" / "views" / "catalog.h5"
+
+    _write_dataset(source_data, [11, 12, 13], name="values")
+    _write_dataset(destination_data, [91, 92, 93], name="values")
+    source_vds.parent.mkdir(parents=True)
+    destination_vds.parent.mkdir(parents=True)
+
+    layout = h5py.VirtualLayout((3,), dtype="i8")
+    layout[:] = h5py.VirtualSource("../data/chunks.h5", "values", shape=(3,))
+    with h5py.File(source_vds, "w") as h5file:
+        h5file.create_virtual_dataset("virtual", layout)
+
+    with h5py.File(source_vds, "r") as source, h5py.File(destination_vds, "w") as destination:
+        target = destination.create_group("target")
+        source.copy(
+            "virtual",
+            target,
+            name="nested/relocated",
+            relocate_vds=True,
+        )
+
+    with h5py.File(destination_vds, "r") as destination:
+        relocated = destination["target/nested/relocated"]
+        np.testing.assert_array_equal(relocated[:], [11, 12, 13])
+        assert _resolved_mapping(relocated) == os.path.realpath(source_data)
+        assert relocated.virtual_sources()[0].file_name != "../data/chunks.h5"
+
+
+def test_same_file_dot_mapping_still_reads_original_file(tmp_path):
+    source_path = tmp_path / "original" / "source.h5"
+    destination_path = tmp_path / "relocated" / "copy.h5"
+    source_path.parent.mkdir(parents=True)
+    destination_path.parent.mkdir(parents=True)
+
+    with h5py.File(source_path, "w") as source:
+        data = source.create_dataset("data", data=[21, 22, 23])
+        layout = h5py.VirtualLayout((3,), dtype=data.dtype)
+        layout[:] = h5py.VirtualSource(data)
+        view = source.create_virtual_dataset("view", layout)
+        assert view.virtual_sources()[0].file_name == "."
+
+    with h5py.File(destination_path, "w") as destination:
+        destination.create_dataset("data", data=[31, 32, 33])
+
+    with h5py.File(source_path, "r") as source, h5py.File(destination_path, "r+") as destination:
+        source.copy(source["view"], destination, relocate_vds=True)
+
+    with h5py.File(destination_path, "r") as destination:
+        relocated = destination["view"]
+        np.testing.assert_array_equal(relocated[:], [21, 22, 23])
+        assert relocated.virtual_sources()[0].file_name != "."
+        assert _resolved_mapping(relocated) == os.path.realpath(source_path)
+
