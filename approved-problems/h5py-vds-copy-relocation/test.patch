+def test_dataset_metadata_selections_and_without_attrs(tmp_path):
+    source_data = (tmp_path / "data.h5").resolve()
+    source_vds = tmp_path / "source" / "view.h5"
+    destination_vds = tmp_path / "destination" / "copy.h5"
+    _write_dataset(source_data, np.arange(10, dtype=np.int32))
+    source_vds.parent.mkdir()
+    destination_vds.parent.mkdir()
+
+    layout = h5py.VirtualLayout((8,), dtype=np.int32, maxshape=(8,))
+    layout[0:3] = h5py.VirtualSource(str(source_data), "data", shape=(10,))[1:7:2]
+    layout[6:8] = h5py.VirtualSource(str(source_data), "data", shape=(10,))[8:10]
+    with h5py.File(source_vds, "w") as source:
+        view = source.create_virtual_dataset("view", layout, fillvalue=-7)
+        view.attrs["label"] = "mapped"
+        view.attrs["scale"] = np.int16(3)
+
+    with h5py.File(source_vds, "r") as source, h5py.File(destination_vds, "w") as destination:
+        source.copy("view", destination, name="with_attrs", relocate_vds=True)
+        source.copy(
+            "view",
+            destination,
+            name="without_attrs",
+            relocate_vds=True,
+            without_attrs=True,
+        )
+
+    with h5py.File(source_vds, "r") as source, h5py.File(destination_vds, "r") as destination:
+        expected = np.array([1, 3, 5, -7, -7, -7, 8, 9], dtype=np.int32)
+        copied = destination["with_attrs"]
+        np.testing.assert_array_equal(copied[:], expected)
+        assert copied.shape == source["view"].shape == (8,)
+        assert copied.maxshape == source["view"].maxshape == (8,)
+        assert copied.dtype == source["view"].dtype == np.dtype("int32")
+        assert copied.fillvalue == source["view"].fillvalue == -7
+        assert _mapping_selections(copied) == _mapping_selections(source["view"])
+        assert copied.attrs["label"] == "mapped"
+        assert copied.attrs["scale"] == 3
+        assert list(destination["without_attrs"].attrs) == []
+
