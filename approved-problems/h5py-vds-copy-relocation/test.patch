+    output_path="$2"
+    shift 2
+fi
+
+case "${1:-}" in
+    base)
+        tests=(
+            h5py/tests/test_group.py
+            h5py/tests/test_vds/test_highlevel_vds.py
+            h5py/tests/test_vds/test_lowlevel_vds.py
+        )
+        ;;
+    new)
+        tests=(h5py/tests/test_vds/test_copy_relocation_a31f0c.py)
+        ;;
+    *)
+        echo "usage: $0 [--output_path PATH] {base|new}" >&2
+        exit 2
+        ;;
