+def test_relocation_preserves_dataset_creation_properties(tmp_path):
+    source_path = tmp_path / "source.h5"
+    destination_path = tmp_path / "destination.h5"
+    flags = h5py.h5p.CRT_ORDER_TRACKED | h5py.h5p.CRT_ORDER_INDEXED
+
+    with h5py.File(source_path, "w") as source:
+        source.create_dataset("data", data=[7])
+        dcpl = h5py.h5p.create(h5py.h5p.DATASET_CREATE)
+        dcpl.set_layout(h5py.h5d.VIRTUAL)
+        dcpl.set_alloc_time(h5py.h5d.ALLOC_TIME_EARLY)
+        dcpl.set_fill_time(h5py.h5d.FILL_TIME_NEVER)
+        dcpl.set_obj_track_times(False)
+        dcpl.set_attr_creation_order(flags)
+        dcpl.set_attr_phase_change(2, 1)
+        vspace = h5py.h5s.create_simple((1,))
+        src_space = h5py.h5s.create_simple((1,))
+        dcpl.set_virtual(vspace, b".", b"/data", src_space)
+        dataset_id = h5py.h5d.create(
+            source.id,
+            b"view",
+            h5py.h5t.py_create(np.dtype("i8")),
+            h5py.h5s.create_simple((1,)),
+            dcpl=dcpl,
+        )
+        view = h5py.Dataset(dataset_id)
+        view.attrs["zeta"] = 1
+        view.attrs["alpha"] = 2
+        view.attrs["middle"] = 3
+
+    with h5py.File(source_path, "r") as source, h5py.File(destination_path, "w") as destination:
+        source.copy("view", destination, relocate_vds=True)
+
+    with h5py.File(source_path, "r") as source, h5py.File(destination_path, "r") as destination:
+        original = source["view"]
+        copied = destination["view"]
+        original_dcpl = original.id.get_create_plist()
+        copied_dcpl = copied.id.get_create_plist()
+        assert copied_dcpl.get_alloc_time() == original_dcpl.get_alloc_time()
+        assert copied_dcpl.get_fill_time() == original_dcpl.get_fill_time()
+        assert copied_dcpl.get_obj_track_times() == original_dcpl.get_obj_track_times()
+        assert copied_dcpl.get_attr_creation_order() == original_dcpl.get_attr_creation_order()
+        assert copied_dcpl.get_attr_phase_change() == original_dcpl.get_attr_phase_change()
+        assert list(copied.attrs) == list(original.attrs) == ["zeta", "alpha", "middle"]
