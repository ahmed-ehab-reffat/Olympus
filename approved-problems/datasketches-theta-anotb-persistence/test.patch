+  @Test
+  public void serializationIsCrossProducerCompatible() {
+    final MemorySegment segment = MemorySegment.ofArray(new byte[16384]);
+    final ThetaAnotB direct = buildDirect(segment);
+    direct.setA(sketch(128, 0, 90));
+    direct.notB(sketch(128, 30, 50));
+    final byte[] first = serialize(direct);
+
+    final ThetaAnotB heap = heapify(first, Util.DEFAULT_UPDATE_SEED);
+    final MemorySegment newSegment = MemorySegment.ofArray(new byte[16384]);
+    newSegment.asSlice(0, first.length).copyFrom(MemorySegment.ofArray(serialize(heap)));
+    final ThetaAnotB wrappedAgain = typedWrap(newSegment, Util.DEFAULT_UPDATE_SEED);
+    assertSameSketch(heap.getResult(false), wrappedAgain.getResult(false));
+  }
