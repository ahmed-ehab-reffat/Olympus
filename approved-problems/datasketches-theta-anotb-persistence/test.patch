+
+    final MemorySegment directSegment = MemorySegment.ofArray(new byte[4096]);
+    final ThetaAnotB direct = (ThetaAnotB) ThetaSetOperation.builder().setSeed(seed)
+        .build(Family.A_NOT_B, directSegment);
+    direct.setA(sketch(seed, 64, 50, 90));
+    assertSameSketch(direct.getResult(false), typedWrap(directSegment, seed).getResult(false));
+    assertThrows(SketchesArgumentException.class,
