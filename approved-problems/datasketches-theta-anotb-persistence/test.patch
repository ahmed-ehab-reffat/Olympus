+  @Test
+  public void virginEmptyAndExactEmptyStatesRemainReusable() {
+    final UpdatableThetaSketch empty = sketch(32, 0, 0);
+    final UpdatableThetaSketch data = sketch(32, 10, 20);
+    final ThetaAnotB virgin = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    final ThetaAnotB virginRestored = heapify(serialize(virgin), Util.DEFAULT_UPDATE_SEED);
+    assertSameSketch(virgin.getResult(false), virginRestored.getResult(false));
+    virginRestored.setA(data);
+    assertSameSketch(data.compact(), virginRestored.getResult(false));
+
+    final ThetaAnotB fromEmptyA = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    fromEmptyA.setA(empty);
+    assertSameSketch(fromEmptyA.getResult(false),
+        heapify(serialize(fromEmptyA), Util.DEFAULT_UPDATE_SEED).getResult(false));
+
+    final ThetaAnotB subtractedToEmpty = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    subtractedToEmpty.setA(data);
+    subtractedToEmpty.notB(data);
+    assertTrue(subtractedToEmpty.getResult(false).isEmpty());
+    assertSameSketch(subtractedToEmpty.getResult(false),
+        heapify(serialize(subtractedToEmpty), Util.DEFAULT_UPDATE_SEED).getResult(false));
+  }
