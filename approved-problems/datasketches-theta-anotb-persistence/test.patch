+  @Test
+  public void readOnlyWrapAllowsQueriesButRejectsStateMutations() {
+    final ThetaAnotB source = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    final UpdatableThetaSketch a = sketch(64, 0, 50);
+    final UpdatableThetaSketch b = sketch(64, 20, 30);
+    source.setA(a);
+    final MemorySegment readOnlyImage = MemorySegment.ofArray(serialize(source)).asReadOnly();
+    final ThetaAnotB heapifiedReadOnly = (ThetaAnotB) ThetaSetOperation.heapify(readOnlyImage);
+    assertFalse(heapifiedReadOnly.hasMemorySegment());
+    assertSameSketch(source.getResult(false), heapifiedReadOnly.getResult(false));
+    final ThetaAnotB[] readOnlyViews = {
+        typedWrap(readOnlyImage, Util.DEFAULT_UPDATE_SEED),
+        (ThetaAnotB) ThetaSetOperation.wrap(readOnlyImage)
+    };
+
+    for (final ThetaAnotB readOnly : readOnlyViews) {
+      assertSameSketch(source.getResult(false), readOnly.getResult(false));
+      assertSameSketch(readOnly.getResult(false),
+          heapify(serialize(readOnly), Util.DEFAULT_UPDATE_SEED).getResult(false));
+      assertSameSketch(source.aNotB(a, b), readOnly.aNotB(a, b));
+      assertThrows(SketchesReadOnlyException.class, () -> readOnly.setA(a));
+      assertThrows(SketchesReadOnlyException.class, () -> readOnly.notB(b));
+      assertThrows(SketchesReadOnlyException.class, () -> readOnly.getResult(true));
+    }
+  }
