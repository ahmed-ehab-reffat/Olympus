+  @Test
+  public void heapifyDetachesFromItsSourceImage() {
+    final ThetaAnotB original = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    original.setA(sketch(64, 0, 50));
+    original.notB(sketch(64, 10, 20));
+    final byte[] image = serialize(original);
+    final ThetaAnotB detached = heapify(image, Util.DEFAULT_UPDATE_SEED);
+    final CompactThetaSketch expected = detached.getResult(false);
+
+    Arrays.fill(image, (byte) 0);
+    assertSameSketch(expected, detached.getResult(false));
+    detached.notB(sketch(64, 40, 45));
+    assertNotEquals(detached.getResult(false).getRetainedEntries(), expected.getRetainedEntries());
+  }
