+    assertSameSketch(operation.getResult(false), heapify(image, seed).getResult(false));
+    assertSameSketch(operation.getResult(false),
+        typedWrap(MemorySegment.ofArray(image), seed).getResult(false));
+    assertThrows(SketchesArgumentException.class, () -> heapify(image, seed + 1));
+    assertThrows(SketchesArgumentException.class,
