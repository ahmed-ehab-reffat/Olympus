+  @Test
+  public void resetIsVisibleAcrossViewsAndSupportsASecondOperation() {
+    final MemorySegment segment = MemorySegment.ofArray(new byte[8192]);
+    final ThetaAnotB first = buildDirect(segment);
+    final ThetaAnotB second = (ThetaAnotB) ThetaSetOperation.wrap(segment);
