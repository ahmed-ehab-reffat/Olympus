+  @Test
+  public void estimationAndZeroRetainedNonemptyStatesRoundTrip() {
+    final UpdatableThetaSketch a = sketch(16, 0, 2000);
+    final UpdatableThetaSketch b = sketch(16, 500, 1500);
+    final ThetaAnotB estimation = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    estimation.setA(a);
+    estimation.notB(b);
+    assertTrue(estimation.getResult(false).getThetaLong() < Long.MAX_VALUE);
+
+    final ThetaAnotB restored = heapify(serialize(estimation), Util.DEFAULT_UPDATE_SEED);
+    assertSameSketch(estimation.getResult(false), restored.getResult(false));
+    final UpdatableThetaSketch c = sketch(16, 0, 500);
+    estimation.notB(c);
+    restored.notB(c);
+    assertSameSketch(estimation.getResult(false), restored.getResult(false));
+
+    final ThetaAnotB noEntries = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    noEntries.setA(a);
+    noEntries.notB(a);
+    assertEquals(noEntries.getResult(false).getRetainedEntries(), 0);
+    assertFalse(noEntries.getResult(false).isEmpty());
+    assertTrue(noEntries.getResult(false).getThetaLong() < Long.MAX_VALUE);
+    final ThetaAnotB noEntriesRestored = heapify(serialize(noEntries), Util.DEFAULT_UPDATE_SEED);
+    assertSameSketch(noEntries.getResult(false), noEntriesRestored.getResult(false));
+
+    final MemorySegment directSegment = MemorySegment.ofArray(
+        new byte[ThetaSetOperation.getMaxAnotBResultBytes(16)]);
+    final ThetaAnotB direct = buildDirect(directSegment);
+    direct.setA(a);
+    direct.notB(b);
+    final ThetaAnotB directView = typedWrap(directSegment, Util.DEFAULT_UPDATE_SEED);
+    final ThetaAnotB directExpected = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    directExpected.setA(a);
+    directExpected.notB(b);
+    assertSameSketch(directExpected.getResult(false), directView.getResult(false));
+    directView.notB(c);
+    directExpected.notB(c);
+    assertSameSketch(directExpected.getResult(false), direct.getResult(false));
+
+    direct.getResult(true);
+    direct.setA(a);
+    direct.notB(a);
+    assertEquals(directView.getResult(false).getRetainedEntries(), 0);
+    assertFalse(directView.getResult(false).isEmpty());
+    assertTrue(directView.getResult(false).getThetaLong() < Long.MAX_VALUE);
+    assertSameSketch(direct.getResult(false),
+        heapify(serialize(directView), Util.DEFAULT_UPDATE_SEED).getResult(false));
+
+    final UpdatableThetaSketch exact = sketch(16, 0, 10);
+    direct.getResult(true);
+    direct.setA(exact);
+    direct.notB(exact);
+    assertTrue(directView.getResult(false).isEmpty());
+    assertSameSketch(directView.getResult(false),
+        heapify(serialize(directView), Util.DEFAULT_UPDATE_SEED).getResult(false));
+  }
