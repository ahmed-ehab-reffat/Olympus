+  private static ThetaAnotB heapOperation(final long seed) {
+    return ThetaSetOperation.builder().setSeed(seed).buildANotB();
+  }
+
+  private static ThetaAnotB buildDirect(final MemorySegment segment) {
+    return (ThetaAnotB) invoke(method(ThetaSetOperationBuilder.class,
+        "buildANotB", MemorySegment.class), ThetaSetOperation.builder(), segment);
+  }
+
+  private static ThetaAnotB heapify(final byte[] image, final long seed) {
+    return (ThetaAnotB) ThetaSetOperation.heapify(MemorySegment.ofArray(image), seed);
+  }
+
+  private static ThetaAnotB typedWrap(final MemorySegment image, final long seed) {
+    return (ThetaAnotB) invoke(method(ThetaAnotB.class, "wrap", MemorySegment.class, long.class),
+        null, image, seed);
+  }
+
+  private static ThetaAnotB typedWrapDefault(final MemorySegment image) {
+    return (ThetaAnotB) invoke(method(ThetaAnotB.class, "wrap", MemorySegment.class), null, image);
+  }
+
+  private static byte[] serialize(final ThetaAnotB operation) {
+    return (byte[]) invoke(method(ThetaAnotB.class, "toByteArray"), operation);
+  }
+
+  private static void assertMalformedStateRejected(final byte[] image) {
+    final MemorySegment segment = MemorySegment.ofArray(image);
+    assertThrows(SketchesException.class, () -> ThetaSetOperation.heapify(segment));
+    assertThrows(SketchesException.class, () -> ThetaSetOperation.wrap(segment));
+    assertThrows(SketchesException.class,
+        () -> typedWrap(segment, Util.DEFAULT_UPDATE_SEED));
+  }
+
+  private static int findPayloadLongOffset(final byte[] image, final long value) {
+    final MemorySegment segment = MemorySegment.ofArray(image);
+    final int firstPayloadByte = ThetaSetOperation.CONST_PREAMBLE_LONGS << 3;
+    for (int offset = firstPayloadByte; offset + Long.BYTES <= image.length;
+        offset += Long.BYTES) {
+      if (segment.get(JAVA_LONG_UNALIGNED, offset) == value) {
+        return offset;
+      }
+    }
+    return -1;
+  }
+
+  private static Method method(final Class<?> type, final String name, final Class<?>... parameterTypes) {
+    try {
+      return type.getMethod(name, parameterTypes);
+    } catch (final NoSuchMethodException e) {
+      throw new AssertionError("Missing public API: " + type.getSimpleName() + "." + name, e);
+    }
+  }
+
+  private static Object invoke(final Method method, final Object receiver, final Object... arguments) {
+    try {
+      return method.invoke(receiver, arguments);
+    } catch (final IllegalAccessException e) {
+      throw new AssertionError(e);
+    } catch (final InvocationTargetException e) {
+      final Throwable cause = e.getCause();
+      if (cause instanceof RuntimeException runtimeException) { throw runtimeException; }
+      if (cause instanceof Error error) { throw error; }
+      throw new AssertionError(cause);
+    }
+  }
+
+  private static UpdatableThetaSketch sketch(final int k, final int from, final int to) {
+    return sketch(Util.DEFAULT_UPDATE_SEED, k, from, to);
+  }
+
+  private static UpdatableThetaSketch sketch(final long seed, final int k, final int from, final int to) {
+    final UpdatableThetaSketch sketch = UpdatableThetaSketch.builder()
+        .setNominalEntries(k).setSeed(seed).build();
+    for (int i = from; i < to; i++) { sketch.update(i); }
+    return sketch;
+  }
+
+  private static void assertSameSketch(final ThetaSketch expected, final ThetaSketch actual) {
+    assertEquals(actual.isEmpty(), expected.isEmpty());
+    assertEquals(actual.getThetaLong(), expected.getThetaLong());
+    assertEquals(actual.getSeedHash(), expected.getSeedHash());
+    final long[] expectedCache = hashes(expected);
+    final long[] actualCache = hashes(actual);
+    Arrays.sort(expectedCache);
+    Arrays.sort(actualCache);
+    assertEquals(actualCache, expectedCache);
+  }
+
+  private static long[] hashes(final ThetaSketch sketch) {
+    final long[] hashes = new long[sketch.getRetainedEntries()];
+    final HashIterator iterator = sketch.iterator();
+    int index = 0;
+    while (iterator.next()) { hashes[index++] = iterator.get(); }
+    assertEquals(index, hashes.length);
+    return hashes;
+  }
+}
