+  @Test
+  public void publicFactoriesAndBothBuilderRoutesAreAvailable() {
+    final MemorySegment genericSeg = MemorySegment.ofArray(new byte[4096]);
+    final ThetaAnotB generic = (ThetaAnotB) ThetaSetOperation.builder().build(Family.A_NOT_B, genericSeg);
+    assertTrue(generic.isSameResource(genericSeg));
+
+    final MemorySegment convenienceSeg = MemorySegment.ofArray(new byte[4096]);
+    final ThetaAnotB convenience = buildDirect(convenienceSeg);
+    assertTrue(convenience.isSameResource(convenienceSeg));
+    assertTrue(method(ThetaAnotB.class, "toByteArray").getReturnType() == byte[].class);
+    method(ThetaAnotB.class, "wrap", MemorySegment.class);
+    method(ThetaAnotB.class, "wrap", MemorySegment.class, long.class);
+    convenience.setA(sketch(32, 0, 12));
+    final ThetaAnotB defaultWrapped = typedWrapDefault(convenienceSeg);
+    assertTrue(defaultWrapped.isSameResource(convenienceSeg));
+    assertSameSketch(convenience.getResult(false), defaultWrapped.getResult(false));
+  }
