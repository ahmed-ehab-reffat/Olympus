+  @Test
+  public void wrappedViewsShareLiveSetAndSubtractState() {
+    final byte[] backing = new byte[ThetaSetOperation.getMaxAnotBResultBytes(512)];
+    final MemorySegment segment = MemorySegment.ofArray(backing);
+    final ThetaAnotB first = buildDirect(segment);
+    final ThetaAnotB second = typedWrap(segment, Util.DEFAULT_UPDATE_SEED);
+    final UpdatableThetaSketch a = sketch(512, 0, 300);
+    final UpdatableThetaSketch b = sketch(512, 100, 200);
+
+    final byte[] virginImage = serialize(first);
+    first.setA(a);
+    assertFalse(Arrays.equals(virginImage, serialize(second)));
+    second.notB(b);
+
+    final ThetaAnotB expected = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    expected.setA(a);
+    expected.notB(b);
+    assertTrue(first.isSameResource(segment));
+    assertTrue(second.isSameResource(segment));
+    assertSameSketch(expected.getResult(false), first.getResult(false));
+  }
