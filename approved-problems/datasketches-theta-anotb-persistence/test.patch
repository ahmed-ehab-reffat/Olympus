+  @Test
+  public void commonPreambleFamilyVersionAndEmptyConsistencyAreValidated() {
+    final ThetaAnotB operation = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    operation.setA(sketch(64, 0, 20));
+    final byte[] image = serialize(operation);
+
+    final byte[] wrongFamily = image.clone();
+    wrongFamily[2] = (byte) Family.QUANTILES.getID();
+    assertMalformedStateRejected(wrongFamily);
+
+    final byte[] wrongVersion = image.clone();
+    wrongVersion[1]++;
+    assertMalformedStateRejected(wrongVersion);
+
+    final byte[] inconsistentEmpty = image.clone();
+    inconsistentEmpty[5] |= 4;
+    assertMalformedStateRejected(inconsistentEmpty);
+
+    final UpdatableThetaSketch estimationSource = sketch(16, 0, 2000);
+    final ThetaAnotB zeroRetainedEstimation = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    zeroRetainedEstimation.setA(estimationSource);
+    zeroRetainedEstimation.notB(estimationSource);
+    assertEquals(zeroRetainedEstimation.getResult(false).getRetainedEntries(), 0);
+    assertFalse(zeroRetainedEstimation.getResult(false).isEmpty());
+    assertTrue(zeroRetainedEstimation.getResult(false).getThetaLong() < Long.MAX_VALUE);
+    final byte[] nonpositiveTheta = serialize(zeroRetainedEstimation);
+    MemorySegment.ofArray(nonpositiveTheta).set(JAVA_LONG_UNALIGNED, PreambleUtil.THETA_LONG, 0L);
+    assertMalformedStateRejected(nonpositiveTheta);
+
+    final CompactThetaSketch result = operation.getResult(false);
+    final long[] retainedHashes = hashes(result);
+    final int firstHashOffset = findPayloadLongOffset(image, retainedHashes[0]);
+    final int secondHashOffset = findPayloadLongOffset(image, retainedHashes[1]);
+    if (firstHashOffset >= 0) {
+      final byte[] zeroHash = image.clone();
+      MemorySegment.ofArray(zeroHash).set(JAVA_LONG_UNALIGNED, firstHashOffset, 0L);
+      assertMalformedStateRejected(zeroHash);
+
+      final byte[] hashAtTheta = image.clone();
+      MemorySegment.ofArray(hashAtTheta).set(
+          JAVA_LONG_UNALIGNED, firstHashOffset, result.getThetaLong());
+      assertMalformedStateRejected(hashAtTheta);
+    }
+    if (firstHashOffset >= 0 && secondHashOffset >= 0) {
+      final byte[] duplicateHash = image.clone();
+      MemorySegment.ofArray(duplicateHash).set(
+          JAVA_LONG_UNALIGNED, secondHashOffset, retainedHashes[0]);
+      assertMalformedStateRejected(duplicateHash);
+    }
+  }
