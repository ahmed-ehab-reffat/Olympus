+output_path=""
+mode=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            [[ $# -ge 2 ]] || { echo "--output_path requires a path" >&2; exit 2; }
+            output_path="$2"
+            shift 2
+            ;;
+        --output_path=*)
+            output_path="${1#*=}"
+            shift
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            echo "usage: $0 --output_path PATH {base|new}" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ -z "$output_path" || -z "$mode" ]]; then
+    echo "usage: $0 --output_path PATH {base|new}" >&2
+    exit 2
+fi
+
+case "$output_path" in
+    /*) ;;
+    *) output_path="$PWD/$output_path" ;;
+esac
+
+run_root="$(mktemp -d /tmp/datasketches-theta-tests.XXXXXX)" || exit 2
+repository_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 2
+cleanup() {
+    case "$run_root" in
+        /tmp/datasketches-theta-tests.*) rm -rf -- "$run_root" ;;
+    esac
+}
+trap cleanup EXIT
+
+cp -R "$repository_root/." "$run_root/source" || exit 2
+cd "$run_root/source" || exit 2
+
+export XDG_CONFIG_HOME="$run_root/config"
+run_user_home="$run_root/home"
+mkdir -p "$run_user_home" "$XDG_CONFIG_HOME" "$(dirname "$output_path")"
+java_home=/opt/java
+maven_bin=/opt/maven/bin/mvn
+maven_cache=/opt/maven-cache
+toolchains=/opt/maven-toolchains.xml
+export JAVA_HOME="$java_home"
+export PATH="$java_home/bin:/opt/maven/bin:/usr/local/bin:/usr/bin:/bin"
+
+if [[ "$mode" == "base" ]]; then
+    tests="AnotBimplTest,CornerCaseThetaSetOperationsTest,SetOpsCornerCasesTest,DirectIntersectionTest,HeapIntersectionTest"
+else
+    tests="ThetaAnotBMemoryLifecycle_7c91Test"
+fi
+
+"$maven_bin" --toolchains "$toolchains" -Dmaven.repo.local="$maven_cache" \
+    -o -B -Duser.home="$run_user_home" -Dmaven.gitcommitid.skip=true \
+    -Dstyle.color=never -Dtest="$tests" test \
+    2>&1 | tee "$run_root/maven-$mode.log"
+maven_status=${PIPESTATUS[0]}
+status=$maven_status
+
+reports=(target/test-output/*/TEST-*.xml)
+if [[ -e "${reports[0]}" ]]; then
+    {
+        printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>' '<testsuites>'
+        for report in "${reports[@]}"; do
+            sed -n '/<testsuite /,/<\/testsuite>/p' "$report"
+        done
+        if [[ $maven_status -ne 0 ]]; then
+            printf '%s\n' \
+                '  <testsuite name="test-harness-diagnostics" tests="0" failures="0" errors="0">' \
+                "    <system-err>Maven exited with status $maven_status after producing Surefire XML"
+            tail -n 200 "$run_root/maven-$mode.log" \
+                | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+            printf '%s\n' '    </system-err>' '  </testsuite>'
+        fi
+        printf '%s\n' '</testsuites>'
+    } >"$output_path"
+else
+    [[ $status -ne 0 ]] || status=1
+    {
+        printf '%s\n' \
+            '<?xml version="1.0" encoding="UTF-8"?>' \
+            '<testsuites tests="1" failures="1" errors="0">' \
+            '  <testsuite name="test-harness" tests="1" failures="1" errors="0">' \
+            "    <testcase name=\"maven-$mode\">" \
+            "      <failure message=\"Maven exited with status $maven_status without producing Surefire XML\">"
+        tail -n 200 "$run_root/maven-$mode.log" \
+            | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+        printf '%s\n' \
+            '      </failure>' \
+            '    </testcase>' \
+            '  </testsuite>' \
+            '</testsuites>'
+    } >"$output_path"
+fi
+
+exit "$status"
