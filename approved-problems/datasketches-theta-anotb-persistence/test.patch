+  @Test
+  public void exactHeapifiedStateContinuesLikeUninterruptedState() {
+    final UpdatableThetaSketch a = sketch(512, 0, 400);
+    final UpdatableThetaSketch b = sketch(512, 40, 160);
+    final UpdatableThetaSketch c = sketch(512, 240, 330);
+
+    final ThetaAnotB uninterrupted = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    uninterrupted.setA(a);
+    uninterrupted.notB(b);
+    uninterrupted.notB(c);
+
+    final ThetaAnotB checkpointed = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    checkpointed.setA(a);
+    checkpointed.notB(b);
+    final ThetaAnotB restored = heapify(serialize(checkpointed), Util.DEFAULT_UPDATE_SEED);
+    assertFalse(restored.hasMemorySegment());
+    restored.notB(c);
+
+    assertSameSketch(uninterrupted.getResult(false), restored.getResult(false));
+    assertSameSketch(restored.getResult(false), restored.getResult(false));
+  }
