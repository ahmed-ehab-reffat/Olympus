+  @Test
+  public void truncatedImagesFailThroughTheSetOperationExceptionFamily() {
+    final ThetaAnotB operation = heapOperation(Util.DEFAULT_UPDATE_SEED);
+    operation.setA(sketch(64, 0, 25));
+    final byte[] image = serialize(operation);
+    final int[] lengths = {0, 1, 2, 7, 8, 23, image.length - 1};
+    for (final int length : lengths) {
+      final MemorySegment truncated = MemorySegment.ofArray(Arrays.copyOf(image, length));
+      assertThrows(SketchesArgumentException.class, () -> ThetaSetOperation.heapify(truncated));
+      assertThrows(SketchesArgumentException.class, () -> ThetaSetOperation.wrap(truncated));
+      assertThrows(SketchesArgumentException.class,
