+/// Rewrite Unicode superscript exponents into the ASCII `^(...)` spelling.
+///
+/// `unit_name` prints exponents as superscripts, and the tokenizer only accepts single digits
+/// one through nine, so a printed unit like `m\u{b9}\u{2070}` cannot be read back without this step.
+fn normalize_superscripts(input: &str) -> String {
+    let mut out = String::with_capacity(input.len());
+    let mut run = String::new();
+
+    for c in input.chars() {
+        let digit = match c {
+            '\u{2070}' => Some('0'),
+            '\u{b9}' => Some('1'),
+            '\u{b2}' => Some('2'),
+            '\u{b3}' => Some('3'),
+            '\u{2074}'..='\u{2079}' => char::from_u32(c as u32 - 0x2074 + '4' as u32),
+            '\u{207b}' => Some('-'),
+            _ => None,
+        };
+
+        match digit {
+            Some(d) => run.push(d),
+            None => {
+                flush_superscript_run(&mut run, &mut out);
+                out.push(c);
+            }
+        }
+    }
+
+    flush_superscript_run(&mut run, &mut out);
+    out
+}
+
+fn flush_superscript_run(run: &mut String, out: &mut String) {
+    if !run.is_empty() {
+        out.push_str("^(");
+        out.push_str(run);
+        out.push(')');
+        run.clear();
+    }
+}
