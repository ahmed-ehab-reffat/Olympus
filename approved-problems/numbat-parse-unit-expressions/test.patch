+    expect_error(&value_in("5 m", "m *"));
+    expect_error(&value_in("5 m", "unknown_unit"));
+    expect_error(&value_in("2 m", "m + m"));
+    expect_error(&value_in("2 m", "sin(1)"));
+    expect_error(&value_in("2 m", "m^(1+1)"));
+}
+
+#[test]
+fn a_ratio_exponent_needs_its_parentheses() {
+    expect_output(&quantity("Length^(1/2)", "2 m^(1/2)"), "2 m^(1/2)");
+    expect_error(&quantity("Length^(1/2)", "2 m^1/2"));
+    expect_error(&quantity("Length^(-1/2)", "2 m^-1/2"));
+    expect_error(&unit("Length^(1/2)", "m^1/2"));
+}
+
+#[test]
+fn user_defined_derived_units_keep_their_scale_in_compound_expressions() {
+    expect_output(
+        "unit hop: Length = 3 m\nlet v: Velocity = parse(\"2 hop/s\")\nv -> m/s",
+        "6 m/s",
+    );
+    expect_output(
+        "unit hop: Length = 3 m\nlet u: Velocity = unit_from(\"hop/s\")\nu -> m/s",
+        "3 m/s",
+    );
+}
+
+#[test]
+fn parse_takes_the_chained_leading_reciprocal_that_unit_from_takes() {
+    expect_output(&converted("Frequency/Length", "2 /s/m", "1 / (m s)"), "2 m\u{207b}\u{b9}\u{b7}s\u{207b}\u{b9}");
+    expect_output(&unit_converted("Frequency/Length", "/s/m", "1 / (m s)"), "1 m\u{207b}\u{b9}\u{b7}s\u{207b}\u{b9}");
+}
+
+#[test]
+fn a_number_juxtaposed_with_a_grouped_expression_is_rejected() {
+    expect_output(&converted("Velocity", "2 * (m/s)", "m/s"), "2 m/s");
+    expect_error(&quantity("Velocity", "2 (m/s)"));
+    expect_error(&quantity("Force", "2 (kg m)/s^2"));
+    expect_error(&quantity("Length", "2 (3 m)"));
+}
+
+#[test]
+fn unit_from_reads_back_what_unit_name_prints() {
+    expect_output(
+        "let q: Length^10 = parse(\"2 m^10\")\nlet r: Length^10 = unit_from(unit_name(q))\nr",
+        "1 m\u{b9}\u{2070}",
+    );
+    expect_output(
+        "let q: 1/Length^16 = parse(\"2 m^-16\")\nlet r: 1/Length^16 = unit_from(unit_name(q))\nr",
+        "1 m\u{207b}\u{b9}\u{2076}",
+    );
+    expect_output(
+        "let q: Length/(Mass*Time^2) = parse(\"1 m/(kg s^2)\")\nlet r: Length/(Mass*Time^2) = unit_from(unit_name(q))\nr",
+        "1 m/(kg\u{b7}s\u{b2})",
+    );
+    expect_output(
+        "let q: 1/(Length*Time) = parse(\"1 /m/s\")\nlet r: 1/(Length*Time) = unit_from(unit_name(q))\nr",
+        "1 m\u{207b}\u{b9}\u{b7}s\u{207b}\u{b9}",
+    );
+}
+
+#[test]
+fn superscript_exponents_are_accepted_by_both_builtins() {
+    expect_output(&unit("Length^10", "m\u{b9}\u{2070}"), "1 m\u{b9}\u{2070}");
+    expect_output(&quantity("Length^10", "2 m\u{b9}\u{2070}"), "2 m\u{b9}\u{2070}");
+    expect_output(&unit_converted("Velocity^2", "m\u{b2}/s\u{b2}", "m^2/s^2"), "1 m\u{b2}/s\u{b2}");
+    expect_output(&converted("Area", "2 km\u{b2}", "m^2"), "2_000_000 m\u{b2}");
+}
+
+#[test]
+fn value_in_rejects_a_mismatched_dimension_even_for_zero() {
+    expect_output(&value_in("0 m", "km"), "0");
+    expect_error(&value_in("0 s", "m"));
+    expect_error(&value_in("0 m", "\u{b0}C"));
+}
+
+#[test]
+fn value_in_resolves_user_defined_units_from_the_live_context() {
+    expect_output("unit hop: Length = 3 m\nvalue_in(6 m, \"hop\")", "2");
+    expect_output("unit hop: Length = 3 m\nvalue_in(1 hop/s, \"m/s\")", "3");
+}
+
+#[test]
+fn existing_number_spellings_still_work_in_front_of_a_compound_unit() {
+    expect_output(&converted("Velocity", "1e3 km/h", "km/h"), "1000 km/h");
+    expect_output(&converted("Velocity", "1_000 m/s", "m/s"), "1000 m/s");
+    expect_output(&converted("Velocity", "0x10 m/s", "m/s"), "16 m/s");
+    expect_output(&converted("Force", "1.5e-3 kg m/s^2", "N"), "0.0015 N");
+    expect_output(&converted("Velocity", "0b101 m/s", "m/s"), "5 m/s");
+    expect_output(&quantity("Velocity", "inf m/s"), "inf m/s");
+    expect_output(&quantity("Velocity", "-inf m/s"), "-inf m/s");
+    expect_output(&quantity("Velocity", "NaN m/s"), "NaN m/s");
+}
+
+#[test]
+fn unit_from_round_trips_through_unit_name() {
+    expect_output(
+        &format!("let u: Area = unit_from(\"m^2\")\nunit_name(u)"),
+        "\"m²\"",
+    );
+    expect_output(
+        &format!("let u: Velocity = unit_from(\"km/h\")\nunit_name(u)"),
+        "\"km/h\"",
+    );
+}
+
+#[test]
+fn unit_from_takes_a_unit_expression_but_not_a_function_call() {
+    expect_output(&unit("Acceleration", "m/s^2"), "1 m/s²");
+    expect_error(&unit("Scalar", "sin(1)"));
+}
+
+#[test]
+fn user_defined_units_work_in_compound_expressions() {
+    let mut ctx = get_test_context();
+    let code = "unit jump: Length\nlet v: Velocity = parse(\"4 jump/s\")\nv -> jump/s";
+    match ctx.interpret(code, CodeSource::Internal) {
+        Ok((_, InterpreterResult::Value(val))) => {
+            let fmt = PlainTextFormatter {};
+            assert_eq!(fmt.format(&val.pretty_print(), false).trim(), "4 jump/s");
+        }
+        Ok(_) => panic!("did not receive a value"),
+        Err(e) => panic!("failed with: {e}"),
+    }
+}
