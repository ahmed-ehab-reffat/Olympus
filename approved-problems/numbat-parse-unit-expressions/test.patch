+mod common;
+
+use common::get_test_context;
+
+use numbat::markup::{Formatter, PlainTextFormatter};
+use numbat::resolver::CodeSource;
+use numbat::InterpreterResult;
+
+#[track_caller]
+fn expect_output(code: &str, expected_output: &str) {
+    let mut ctx = get_test_context();
+    match ctx.interpret(code, CodeSource::Internal) {
+        Ok((_, InterpreterResult::Value(val))) => {
+            let fmt = PlainTextFormatter {};
+            let actual = fmt.format(&val.pretty_print(), false);
+            assert_eq!(actual.trim(), expected_output);
+        }
+        Ok(_) => panic!("did not receive a value for code\n{code}"),
+        Err(e) => panic!("expected {expected_output:?} but failed for code\n{code}\nwith: {e}"),
+    }
+}
+
+#[track_caller]
+fn expect_failure(code: &str, msg_part: &str) {
+    let mut ctx = get_test_context();
+    match ctx.interpret(code, CodeSource::Internal) {
+        Err(e) => {
+            let message = e.to_string();
+            assert!(
+                message.contains(msg_part),
+                "expected {msg_part:?} but got {message:?}"
+            );
+        }
+        Ok(_) => panic!("expected an error but the code succeeded\n{code}"),
+    }
+}
+
+#[track_caller]
+fn expect_error(code: &str) {
+    let mut ctx = get_test_context();
+    if ctx.interpret(code, CodeSource::Internal).is_ok() {
+        panic!("expected an error but the code succeeded\n{code}");
+    }
+}
+
+fn quantity(annotation: &str, literal: &str) -> String {
+    format!("let value: {annotation} = parse(\"{literal}\")\nvalue")
+}
+
+fn converted(annotation: &str, literal: &str, target: &str) -> String {
+    format!("let value: {annotation} = parse(\"{literal}\")\nvalue -> {target}")
+}
+
+fn unit(annotation: &str, literal: &str) -> String {
+    format!("let value: {annotation} = unit_from(\"{literal}\")\nvalue")
+}
+
+fn value_in(literal: &str, target: &str) -> String {
+    format!("value_in({literal}, \"{target}\")")
+}
+
+fn unit_converted(annotation: &str, literal: &str, target: &str) -> String {
+    format!("let value: {annotation} = unit_from(\"{literal}\")\nvalue -> {target}")
+}
