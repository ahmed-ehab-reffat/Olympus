+/// The contract forbids mutation on a rejected preflight; it says nothing about
+/// how many read-only requests get there, or in what order. So the oracle is
+/// the absence of any setter, and the peer answers every read.
+#[cfg(feature = "snapshot-tests")]
+fn assert_no_mutation(case: &str, state: &StatefulSnapshotState) {
+    let mutations: Vec<_> = state
+        .commands
+        .iter()
+        .copied()
+        .filter(|command| snapshot_write_stage(*command).is_some())
+        .collect();
+    assert!(
+        mutations.is_empty(),
+        "{case}: a rejected preflight mutated the device: {mutations:?}"
+    );
+}
