+/// Both entry points must reject `snapshot` against the built target, and
+/// neither may write. `build_target` runs once per entry point because the peer
+/// records into the state it is given.
+#[cfg(feature = "snapshot-tests")]
+async fn assert_preflight_rejects_without_mutation(
+    case: &str,
+    snapshot: &ConfigurationSnapshot,
+    build_target: impl Fn() -> StatefulSnapshotState,
+) {
+    for direct_preflight in [true, false] {
+        let state = std::sync::Arc::new(std::sync::Mutex::new(build_target()));
+        let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+        timeout(
+            Duration::from_secs(5),
+            drive(&mut driver, &client, async {
+                if direct_preflight {
+                    assert!(
+                        client.preflight_restore(snapshot).await.is_err(),
+                        "{case}: direct preflight accepted an unusable target"
+                    );
+                } else {
+                    assert!(
+                        rejected_before_writing(&client.restore_configuration(snapshot).await),
+                        "{case}: restore did not report a preflight rejection"
+                    );
+                }
+            }),
+        )
+        .await
+        .unwrap_or_else(|_| panic!("{case}: preflight did not finish"));
+        assert_no_mutation(case, &state.lock().unwrap());
+    }
