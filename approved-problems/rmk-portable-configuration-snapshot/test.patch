+#[tokio::test]
+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restore_requires_a_target_that_can_hold_every_entry() {
+    let (source_capabilities, snapshot) = portable_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+    let info = snapshot.device_info.clone();
+    let dimensions: [(&str, fn(&mut DeviceCapabilities, i16)); 10] = [
+        ("num_layers", |caps, step| caps.num_layers = shift(caps.num_layers, step)),
+        ("num_rows", |caps, step| caps.num_rows = shift(caps.num_rows, step)),
+        ("num_cols", |caps, step| caps.num_cols = shift(caps.num_cols, step)),
+        ("num_encoders", |caps, step| caps.num_encoders = shift(caps.num_encoders, step)),
+        ("max_combos", |caps, step| caps.max_combos = shift(caps.max_combos, step)),
+        ("max_combo_keys", |caps, step| {
+            caps.max_combo_keys = shift(caps.max_combo_keys, step)
+        }),
+        ("macro_space_size", |caps, step| {
+            caps.macro_space_size = (caps.macro_space_size as i16 + step) as u16
+        }),
+        ("max_morse", |caps, step| caps.max_morse = shift(caps.max_morse, step)),
+        ("max_patterns_per_key", |caps, step| {
+            caps.max_patterns_per_key = shift(caps.max_patterns_per_key, step)
+        }),
+        ("max_forks", |caps, step| caps.max_forks = shift(caps.max_forks, step)),
+    ];
+
+    for (field, resize) in dimensions {
+        // One step smaller cannot hold the snapshot; one step larger keeps the
+        // spare capacity and stays compatible.
+        for (step, compatible) in [(-1i16, false), (1, true)] {
+            let mut target_capabilities = source_capabilities;
+            resize(&mut target_capabilities, step);
+            let case = format!("{field} at step {step}");
+
+            if !compatible {
+                assert_preflight_rejects_without_mutation(&case, &snapshot, || {
+                    blank_target_state(target_capabilities, info.clone())
+                })
+                .await;
+                continue;
+            }
+
+            let state = std::sync::Arc::new(std::sync::Mutex::new(blank_target_state(
+                target_capabilities,
+                info.clone(),
+            )));
+            let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+            timeout(
+                Duration::from_secs(5),
+                drive(&mut driver, &client, async {
+                    client
+                        .preflight_restore(&snapshot)
+                        .await
+                        .unwrap_or_else(|error| panic!("{case}: preflight rejected a larger target: {error}"));
+                }),
+            )
+            .await
+            .unwrap_or_else(|_| panic!("{case}: preflight did not finish"));
+            assert_no_mutation(&case, &state.lock().unwrap());
+        }
+    }
+}
