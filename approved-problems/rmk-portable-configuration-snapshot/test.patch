+    target.macro_data[1] = 0;
+    target.macro_data[6] = 0;
+    target.behavior = BehaviorConfig {
+        combo_timeout_ms: 0,
+        oneshot_timeout_ms: 0,
+        tap_interval_ms: 0,
+        tap_capslock_interval_ms: 0,
