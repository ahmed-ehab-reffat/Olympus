+    // A larger target's spare column and row split the keymap into three
+    // requests, so this stage can fail with some of it already applied. The
+    // retry re-reads the board and must plan afresh from what it now holds:
+    // the first request's keys are no longer differing, so the second attempt
+    // carries only what is missing. Replaying the first attempt's plan would
+    // rewrite keys 0 and 1.
+    let (source_capabilities, snapshot) = portable_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+    let capabilities = grown_target_caps(source_capabilities);
+    let restored = grown_target_state(capabilities, &snapshot);
+
+    let mut target = grown_target_state(capabilities, &snapshot);
+    for index in [0, 1, 4, 9, 10] {
+        target.keymap[index] = KeyAction::No;
+    }
+    target.reject_stage_request = Some((RestoreStage::Keymap, 2));
+    let state = std::sync::Arc::new(std::sync::Mutex::new(target));
+    let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+    drive(&mut driver, &client, async {
+        match client.restore_configuration(&snapshot).await {
+            Err(RestoreError::Write { completed, stage, .. }) => {
+                assert!(completed.is_empty(), "no stage precedes the keymap");
+                assert_eq!(stage, RestoreStage::Keymap);
+            }
+            other => panic!("unexpected first restore result: {other:?}"),
+        }
+    })
+    .await;
+    // Which of the three runs the peer refuses depends on the order they reach
+    // it, which the implementation chooses, so this counts rather than names:
+    // the refusal stopped the stage before all three landed.
+    assert!(
+        state.lock().unwrap().key_requests.len() < 3,
+        "the refused request did not stop the keymap stage"
+    );
+    state.lock().unwrap().reject_stage_request = None;
+
+    drive(&mut driver, &client, async {
+        client.restore_configuration(&snapshot).await.unwrap();
+    })
+    .await;
+
+    let state = state.lock().unwrap();
+    assert_eq!(state.keymap, restored.keymap, "the keymap was not restored");
+    // Whatever landed first, three runs carry this keymap and the retry replans
+    // from a fresh baseline, so three requests is the total across both attempts
+    // and every key is carried exactly once. Replaying the first attempt's plan
+    // would spend a fourth request and write a key twice.
+    assert_eq!(
+        state.key_requests.len(),
+        3,
+        "the retry spent a request on a run the first attempt had already applied"
+    );
+    assert_eq!(
+        touched(&state.key_writes),
+        [0, 1, 4, 9, 10],
+        "a key was carried twice across the two attempts"
+    );
+    assert_eq!(
+        touched(&state.key_requests),
+        [(0, 2), (4, 1), (9, 2)],
+        "the two attempts together did not carry the three runs the target's gaps require"
+    );
+}
