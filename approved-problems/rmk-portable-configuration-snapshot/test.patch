+                .iter()
+                .copied()
+                .filter_map(snapshot_write_stage)
+                .filter(|candidate| *candidate == stage)
+                .count();
+            if state.reject_stage_request == Some((stage, request_index)) {
+                self.responses
+                    .send(frame(header.cmd, header.seq, &Err::<(), RynkError>(RynkError::Invalid)))
+                    .unwrap();
+                return Ok(buf.len());
+            }
+        }
+
+        let response = match header.cmd {
+            Cmd::GetVersion => reply(header.cmd, header.seq, ProtocolVersion::CURRENT),
+            Cmd::GetCapabilities => reply(header.cmd, header.seq, state.capabilities),
+            Cmd::GetDeviceInfo => reply(header.cmd, header.seq, state.device_info.clone()),
+            Cmd::GetDefaultLayer => reply(header.cmd, header.seq, state.default_layer),
+            Cmd::GetKeyAction => {
+                let position: KeyPosition = postcard::from_bytes(payload).unwrap();
+                let index = keymap_request_index(state.capabilities, position.layer, position.row, position.col);
+                reply(header.cmd, header.seq, state.keymap[index])
+            }
+            Cmd::SetKeyAction => {
+                let request: SetKeyRequest = postcard::from_bytes(payload).unwrap();
+                let index = keymap_request_index(
+                    state.capabilities,
+                    request.position.layer,
+                    request.position.row,
+                    request.position.col,
+                );
+                state.key_writes.push(index);
+                state.key_requests.push((index, 1));
+                state.keymap[index] = request.action;
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetKeymapBulk => {
+                let request: GetKeymapBulkRequest = postcard::from_bytes(payload).unwrap();
+                let start =
+                    keymap_request_index(state.capabilities, request.layer, request.start_row, request.start_col);
+                assert!(start < state.keymap.len(), "keymap read starts outside the resource");
+                let end = (start + state.capabilities.max_bulk_keys as usize).min(state.keymap.len());
+                reply(
+                    header.cmd,
+                    header.seq,
+                    GetKeymapBulkResponse {
+                        actions: state.keymap[start..end].to_vec(),
+                    },
+                )
+            }
+            Cmd::SetKeymapBulk => {
+                let request: SetKeymapBulkRequest = postcard::from_bytes(payload).unwrap();
+                let start =
+                    keymap_request_index(state.capabilities, request.layer, request.start_row, request.start_col);
+                assert!(!request.actions.is_empty(), "keymap write page must not be empty");
+                assert!(
+                    start + request.actions.len() <= state.keymap.len(),
+                    "keymap write exceeds the resource"
+                );
+                state.key_writes.extend(start..start + request.actions.len());
+                state.key_requests.push((start, request.actions.len()));
+                state.keymap[start..start + request.actions.len()].copy_from_slice(&request.actions);
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetEncoderAction => {
+                let request: GetEncoderRequest = postcard::from_bytes(payload).unwrap();
+                state.encoder_reads.push((request.layer, request.encoder_id));
+                let index =
+                    request.layer as usize * state.capabilities.num_encoders as usize + request.encoder_id as usize;
+                reply(header.cmd, header.seq, state.encoders[index])
+            }
+            Cmd::SetEncoderAction => {
+                let request: SetEncoderRequest = postcard::from_bytes(payload).unwrap();
+                let index =
+                    request.layer as usize * state.capabilities.num_encoders as usize + request.encoder_id as usize;
+                state.encoder_writes.push((request.layer, request.encoder_id));
+                state.encoders[index] = request.action;
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetCombo => {
+                let index: u8 = postcard::from_bytes(payload).unwrap();
+                reply(header.cmd, header.seq, state.combos[index as usize].clone())
+            }
+            Cmd::SetCombo => {
+                let request: SetComboRequest = postcard::from_bytes(payload).unwrap();
+                state.combo_writes.push(request.index);
+                state.combo_requests.push((request.index as usize, 1));
+                state.combos[request.index as usize] = request.config;
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetComboBulk => {
+                let request: GetComboBulkRequest = postcard::from_bytes(payload).unwrap();
+                let start = request.start_index as usize;
+                assert!(start < state.combos.len(), "combo read starts outside the resource");
+                let end = (start + state.capabilities.max_bulk_items as usize).min(state.combos.len());
+                reply(
+                    header.cmd,
+                    header.seq,
+                    GetComboBulkResponse {
+                        configs: state.combos[start..end].to_vec(),
+                    },
+                )
+            }
+            Cmd::SetComboBulk => {
+                let request: SetComboBulkRequest = postcard::from_bytes(payload).unwrap();
+                let start = request.start_index as usize;
+                let end = start + request.configs.len();
+                assert!(!request.configs.is_empty(), "combo write page must not be empty");
+                assert!(start < state.combos.len(), "combo write starts outside the resource");
+                assert!(end <= state.combos.len(), "combo write exceeds the resource");
+                state
+                    .combo_writes
+                    .extend(request.start_index..request.start_index + request.configs.len() as u8);
+                state.combo_requests.push((start, request.configs.len()));
+                state.combos[start..end].clone_from_slice(&request.configs);
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetFork => {
+                let index: u8 = postcard::from_bytes(payload).unwrap();
+                reply(header.cmd, header.seq, state.forks[index as usize])
+            }
+            Cmd::SetFork => {
+                let request: SetForkRequest = postcard::from_bytes(payload).unwrap();
+                state.fork_writes.push(request.index);
+                state.forks[request.index as usize] = request.config;
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetMorse => {
+                let index: u8 = postcard::from_bytes(payload).unwrap();
+                reply(header.cmd, header.seq, state.morses[index as usize].clone())
+            }
+            Cmd::SetMorse => {
+                let request: SetMorseRequest = postcard::from_bytes(payload).unwrap();
+                state.morse_writes.push(request.index);
+                state.morse_requests.push((request.index as usize, 1));
+                state.morses[request.index as usize] = request.config;
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetMorseBulk => {
+                let request: GetMorseBulkRequest = postcard::from_bytes(payload).unwrap();
+                let start = request.start_index as usize;
+                assert!(start < state.morses.len(), "Morse read starts outside the resource");
+                let end = (start + state.capabilities.max_bulk_items as usize).min(state.morses.len());
+                reply(
+                    header.cmd,
+                    header.seq,
+                    GetMorseBulkResponse {
+                        configs: state.morses[start..end].to_vec(),
+                    },
+                )
+            }
+            Cmd::SetMorseBulk => {
+                let request: SetMorseBulkRequest = postcard::from_bytes(payload).unwrap();
+                let start = request.start_index as usize;
+                let end = start + request.configs.len();
+                assert!(!request.configs.is_empty(), "Morse write page must not be empty");
+                assert!(start < state.morses.len(), "Morse write starts outside the resource");
+                assert!(end <= state.morses.len(), "Morse write exceeds the resource");
+                state
+                    .morse_writes
+                    .extend(request.start_index..request.start_index + request.configs.len() as u8);
+                state.morse_requests.push((start, request.configs.len()));
+                state.morses[start..end].clone_from_slice(&request.configs);
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetMacro if state.capabilities.macro_chunk_size == 0 => {
+                // Real firmware cannot serve a zero-length chunk; answering
+                // instead of stalling keeps an unusable target a clean error.
+                frame(header.cmd, header.seq, &Err::<(), RynkError>(RynkError::Invalid))
+            }
+            Cmd::GetMacro => {
+                let request: GetMacroRequest = postcard::from_bytes(payload).unwrap();
+                state.macro_reads.push(request.offset);
+                assert!(
+                    (request.offset as usize) < state.macro_data.len(),
+                    "macro read starts outside the resource"
+                );
+                let mut data = heapless::Vec::new();
+                for index in 0..state.capabilities.macro_chunk_size as usize {
+                    data.push(*state.macro_data.get(request.offset as usize + index).unwrap_or(&0))
+                        .unwrap();
+                }
+                reply(header.cmd, header.seq, MacroData { data })
+            }
+            Cmd::SetMacro => {
+                let request: SetMacroRequest = postcard::from_bytes(payload).unwrap();
+                assert!(
+                    (request.offset as usize) < state.macro_data.len(),
+                    "macro write starts outside the resource"
+                );
+                assert!(!request.data.data.is_empty(), "macro write must not be empty");
+                assert!(
+                    request.data.data.len() <= state.capabilities.macro_chunk_size as usize,
+                    "macro write exceeds the advertised chunk size"
+                );
+                assert!(
+                    request.offset as usize + request.data.data.len() <= state.macro_data.len(),
+                    "macro write exceeds the advertised resource"
+                );
+                state
+                    .macro_writes
+                    .push((request.offset, request.data.data.as_slice().to_vec()));
+                for (index, byte) in request.data.data.into_iter().enumerate() {
+                    if let Some(target) = state.macro_data.get_mut(request.offset as usize + index) {
+                        *target = byte;
+                    }
+                }
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::GetBehaviorConfig => reply(header.cmd, header.seq, state.behavior),
+            Cmd::SetBehaviorConfig => {
+                state.behavior = postcard::from_bytes(payload).unwrap();
+                reply(header.cmd, header.seq, ())
+            }
+            Cmd::SetDefaultLayer => {
+                state.default_layer = postcard::from_bytes(payload).unwrap();
+                reply(header.cmd, header.seq, ())
+            }
+            command => panic!("unexpected command in stateful snapshot test: {command:?}"),
+        };
+        self.responses.send(response).unwrap();
+        Ok(buf.len())
+    }
+
+    async fn flush(&mut self) -> Result<(), ErrorKind> {
+        Ok(())
+    }
+}
