+#!/usr/bin/env bash
+set -uo pipefail
+
+output_path="results.xml"
+mode=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            output_path="${2:-results.xml}"
+            shift 2
+            ;;
+        --output_path=*)
+            output_path="${1#*=}"
+            shift
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+if [[ -z "$mode" ]]; then
+    echo "usage: $0 [--output_path PATH] {base|new}" >&2
+    exit 2
+fi
+
+export CARGO_NET_OFFLINE=true
+export RUSTUP_TOOLCHAIN="${RUSTUP_TOOLCHAIN:-1.95.0}"
+
+runtime_root="$(mktemp -d "${TMPDIR:-/tmp}/olympus-rmk-snapshot.XXXXXX")"
+trap 'rm -rf -- "$runtime_root"' EXIT
+nextest_config="$runtime_root/nextest.toml"
+{
+    printf '[store]\ndir = "%s/nextest"\n\n' "$runtime_root"
+    cat .olympus-nextest.toml
+} >"$nextest_config"
+target_dir="$runtime_root/target"
+status=0
+
+case "$mode" in
+    base)
+        cargo nextest run \
+            --manifest-path rynk/Cargo.toml \
+            --config-file "$nextest_config" \
+            --profile default \
+            --target-dir "$target_dir" \
+            --workspace \
+            --all-targets \
+            --locked \
+            --offline || status=$?
+        ;;
+    new)
+        cargo nextest run \
+            --manifest-path rynk/Cargo.toml \
+            --config-file "$nextest_config" \
+            --profile default \
+            --target-dir "$target_dir" \
+            -p rynk \
+            --features snapshot-tests \
+            -E 'test(/snapshot/) | test(/restore_identity_mismatch/) | test(/restore_reports_completed/)' \
+            --locked \
+            --offline || status=$?
+        ;;
+esac
+
+mkdir -p "$(dirname "$output_path")"
+junit_path="$runtime_root/nextest/default/junit.xml"
+if [[ -f "$junit_path" ]]; then
+    cp "$junit_path" "$output_path"
+elif [[ "$mode" == "new" && "$status" -eq 101 ]]; then
+    cat >"$output_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="0" skipped="1">
+  <testsuite name="$mode" tests="1" failures="0" errors="0" skipped="1">
+    <testcase name="compile-placeholder" classname="$mode">
+      <skipped message="expected pre-solution compilation failure (runner exit $status)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+elif [[ "$status" -ne 0 ]]; then
+    cat >"$output_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="1">
+  <testsuite name="$mode" tests="1" failures="0" errors="1">
+    <testcase name="harness-startup" classname="$mode">
+      <error message="test runner exited before producing JUnit (exit $status)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+else
+    cat >"$output_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="0">
+  <testsuite name="$mode" tests="1" failures="0" errors="0">
+    <testcase name="compile-or-run" classname="$mode"/>
+  </testsuite>
+</testsuites>
+XML
+fi
+
+exit "$status"
