+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restores_to_a_device_without_bulk_transfer() {
+    // Bulk transfer is a paging convenience, not a precondition. The protocol
+    // addresses every one of these resources per entry as well, so a board that
+    // does not advertise it is still fully restorable, and the crate's pagers
+    // simply are not usable to do it.
+    let (mut capabilities, snapshot) = multi_stage_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+    capabilities.bulk_transfer_supported = false;
+    let state = std::sync::Arc::new(std::sync::Mutex::new(dirty_restore_state(capabilities, &snapshot, None)));
+    let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+    drive(&mut driver, &client, async {
+        client
+            .restore_configuration(&snapshot)
+            .await
+            .expect("restore must not require bulk transfer");
+    })
+    .await;
+
+    let state = state.lock().unwrap();
+    assert_eq!(state.default_layer, snapshot.default_layer);
+    assert_eq!(state.keymap, snapshot.keymap);
+    assert_eq!(state.encoders, snapshot.encoders);
+    assert_eq!(state.combos, snapshot.combos);
+    assert_eq!(state.forks, snapshot.forks);
+    assert_eq!(state.morses, snapshot.morses);
+    assert_eq!(state.macro_data, snapshot.macro_data);
+    assert_eq!(state.behavior, snapshot.behavior);
+
+    // Sparse writes still hold: entry 1 of every resource already matched.
+    assert_eq!(touched(&state.key_writes), [0, 2]);
+    assert_eq!(touched(&state.combo_writes), [0, 2]);
+    assert_eq!(touched(&state.morse_writes), [0, 2]);
+    assert!(
+        state.commands.iter().all(|command| !matches!(
+            *command,
+            Cmd::GetKeymapBulk
+                | Cmd::GetComboBulk
+                | Cmd::GetMorseBulk
+                | Cmd::SetKeymapBulk
+                | Cmd::SetComboBulk
+                | Cmd::SetMorseBulk
+        )),
+        "a bulk endpoint the device does not advertise was used: {:?}",
+        state.commands
+    );
+
+    let mut mutation_stages: Vec<_> = state.commands.iter().copied().filter_map(snapshot_write_stage).collect();
+    mutation_stages.dedup();
+    assert_eq!(mutation_stages, restore_stages());
+}
