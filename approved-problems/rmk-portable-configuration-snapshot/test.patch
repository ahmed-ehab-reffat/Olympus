+/// What a stage touched, independent of the order it touched it in.
+///
+/// Writes inside a stage address disjoint entries, and the crate's own
+/// whole-resource writer keeps several pages in flight at once, so a serial
+/// ascending order is a scheduling choice rather than observable behaviour.
+/// The suite compares the set of entries a stage wrote, never their sequence.
+#[cfg(feature = "snapshot-tests")]
+fn touched<T: Ord + Clone>(writes: &[T]) -> Vec<T> {
+    let mut sorted = writes.to_vec();
+    sorted.sort();
+    sorted
+}
