+#[cfg(feature = "snapshot-tests")]
+fn assert_snapshot_command_contract(
+    commands: &[Cmd],
+    export_phases: &[Cmd],
+    baseline_reads: &[Cmd],
+    write_stages: &[RestoreStage],
+) {
+    let phases = commands
+        .iter()
+        .copied()
+        .filter(|command| !matches!(*command, Cmd::GetVersion | Cmd::GetCapabilities))
+        .map(snapshot_phase)
+        .fold(Vec::new(), |mut phases, command| {
+            if phases.last() != Some(&command) {
+                phases.push(command);
+            }
+            phases
+        });
+    assert!(
+        phases.starts_with(export_phases),
+        "wrong export phase prefix: {phases:?}"
+    );
+
+    let restore_phases = &phases[export_phases.len()..];
+    let first_write = restore_phases
+        .iter()
+        .position(|command| snapshot_write_stage(*command).is_some())
+        .expect("restore sent no mutating stage");
+    let observed_baseline = &restore_phases[..first_write];
+    for required in baseline_reads {
+        assert!(
+            observed_baseline.contains(required),
+            "restore did not read {required:?} before mutation: {restore_phases:?}"
+        );
+    }
+
+    let mut observed_writes: Vec<_> = restore_phases[first_write..]
+        .iter()
+        .filter_map(|command| snapshot_write_stage(*command))
+        .collect();
+    observed_writes.dedup();
+    assert_eq!(observed_writes, write_stages);
+}
