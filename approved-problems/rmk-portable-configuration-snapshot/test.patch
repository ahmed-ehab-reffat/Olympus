+
+    let mut target = grown_target_state(capabilities, &snapshot);
+    target.default_layer = 0;
+    // Snapshot keys (0,0,0) and (0,0,1) stay adjacent on the wider target;
+    // (0,1,1) is cut off by the target's spare column; (1,0,0) and (1,0,1) are
+    // adjacent again a layer up, where the spare row and layer have moved them.
+    for index in [0, 1, 4, 9, 10] {
+        target.keymap[index] = KeyAction::No;
+    }
+    target.encoders[4] = EncoderAction::default();
+    target.combos[0] = Combo::empty();
+    target.combos[1] = Combo::empty();
+    target.forks[1] = Fork::empty();
+    target.morses[0] = Morse::default();
+    target.morses[2] = Morse::default();
+    target.macro_data[3] = 0;
+    target.macro_data[4] = 0;
+    target.behavior = BehaviorConfig {
+        combo_timeout_ms: 0,
+        oneshot_timeout_ms: 0,
+        tap_interval_ms: 0,
+        tap_capslock_interval_ms: 0,
+    };
+    let state = std::sync::Arc::new(std::sync::Mutex::new(target));
+    let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+    drive(&mut driver, &client, async {
+        client.restore_configuration(&snapshot).await.unwrap();
+    })
+    .await;
+
+    let state = state.lock().unwrap();
+    assert_eq!(state.default_layer, restored.default_layer);
+    assert_eq!(state.keymap, restored.keymap, "restore disturbed the spare keys");
+    assert_eq!(state.encoders, restored.encoders, "restore disturbed the spare encoders");
+    assert_eq!(state.combos, restored.combos, "restore disturbed the spare combo");
+    assert_eq!(state.forks, restored.forks, "restore disturbed the spare fork");
+    assert_eq!(state.morses, restored.morses, "restore disturbed the spare Morse slot");
+    assert_eq!(
+        state.macro_data, restored.macro_data,
+        "restore disturbed the spare macro bytes"
+    );
+    assert_eq!(state.behavior, restored.behavior);
+
+    assert_eq!(touched(&state.key_writes), [0, 1, 4, 9, 10]);
+    assert_eq!(touched(&state.encoder_writes), [(1, 1)]);
+    assert_eq!(touched(&state.combo_writes), [0, 1]);
+    assert_eq!(touched(&state.fork_writes), [1]);
+    assert_eq!(touched(&state.morse_writes), [0, 1, 2]);
