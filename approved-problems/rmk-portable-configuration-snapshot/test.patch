diff --git a/.olympus-nextest.toml b/.olympus-nextest.toml
new file mode 100644
index 00000000..80ab18d0
--- /dev/null
+++ b/.olympus-nextest.toml
@@ -0,0 +1,16 @@
+[profile.default]
+fail-fast = false
+failure-output = "immediate-final"
+
+[profile.default.junit]
+path = "junit.xml"
+
+# The two tests that shell out to Cargo share the standalone workspace, so
+# running them at once makes each wait on the other's package-cache and
+# artifact-directory locks. One at a time is faster than contending.
+[test-groups.nested-cargo]
+max-threads = 1
+
+[[profile.default.overrides]]
+filter = 'test(/snapshot_surface_builds_with_alloc_without_std|snapshot_wasm_client_round_trips_under_node/)'
+test-group = 'nested-cargo'
