+/// A larger target already holding the snapshot's configuration at the
+/// coordinates it covers. Every slot outside that region carries a sentinel a
+/// correct restore never touches.
+#[cfg(feature = "snapshot-tests")]
+fn grown_target_state(capabilities: DeviceCapabilities, snapshot: &ConfigurationSnapshot) -> StatefulSnapshotState {
+    let source = &snapshot.geometry;
+    let (source_rows, source_cols) = (source.num_rows as usize, source.num_cols as usize);
+    let (rows, cols) = (capabilities.num_rows as usize, capabilities.num_cols as usize);
+
+    let mut keymap = vec![KeyAction::Morse(200); capabilities.num_layers as usize * rows * cols];
+    for layer in 0..source.num_layers as usize {
+        for row in 0..source_rows {
+            for col in 0..source_cols {
+                keymap[(layer * rows + row) * cols + col] =
+                    snapshot.keymap[(layer * source_rows + row) * source_cols + col];
+            }
+        }
+    }
+
+    let encoders_per_layer = capabilities.num_encoders as usize;
+    let mut encoders = vec![
+        EncoderAction::new(KeyAction::Morse(201), KeyAction::No);
+        capabilities.num_layers as usize * encoders_per_layer
+    ];
+    for layer in 0..source.num_layers as usize {
+        for encoder_id in 0..source.num_encoders as usize {
+            encoders[layer * encoders_per_layer + encoder_id] =
+                snapshot.encoders[layer * source.num_encoders as usize + encoder_id];
+        }
+    }
+
+    let mut combos = snapshot.combos.clone();
+    combos.resize(capabilities.max_combos as usize, sample_combo(202));
+    let mut forks = snapshot.forks.clone();
+    forks.resize(capabilities.max_forks as usize, sample_fork(204));
+    let mut morses = snapshot.morses.clone();
+    morses.resize(capabilities.max_morse as usize, sample_morse(208));
+    let mut macro_data = snapshot.macro_data.clone();
+    macro_data.resize(capabilities.macro_space_size as usize, 0xee);
+
+    StatefulSnapshotState {
+        default_layer: snapshot.default_layer,
+        keymap,
+        encoders,
+        combos,
+        forks,
+        morses,
+        macro_data,
+        behavior: snapshot.behavior,
+        ..blank_target_state(capabilities, snapshot.device_info.clone())
+    }
