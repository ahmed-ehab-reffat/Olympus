+/// The WASM round trip needs the wasm32 target, the wasm-bindgen runner, and
+/// Node. The problem's image provisions all three, so this normally returns
+/// `None` and the round trip runs for real. Somewhere that does not provision
+/// them, the check reports what is missing and stands down instead of failing a
+/// solution for its host's tooling.
+#[cfg(feature = "snapshot-tests")]
+fn missing_wasm_tooling() -> Option<String> {
+    let target_installed = std::process::Command::new(option_env!("RUSTC").unwrap_or("rustc"))
+        .args(["--print", "target-libdir", "--target", "wasm32-unknown-unknown"])
+        .output()
+        .is_ok_and(|probe| probe.status.success());
+    if !target_installed {
+        return Some("the wasm32-unknown-unknown target is not installed".into());
+    }
+    let on_path = |program: &str| {
+        std::env::var_os("PATH")
+            .is_some_and(|path| std::env::split_paths(&path).any(|dir| dir.join(program).is_file()))
+    };
+    ["wasm-bindgen-test-runner", "node"]
+        .into_iter()
+        .find(|program| !on_path(program))
+        .map(|program| format!("{program} is not on PATH"))
+}
