+#[tokio::test]
+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restore_bridges_a_matching_entry_only_when_the_frame_allows() {
+    // The same two differing keys with the same matching key between them, and
+    // one byte of frame deciding the plan. At 10 bytes the three-key request
+    // fits and replaces two, so carrying the matching key is what costs least.
+    // At 9 it does not fit, and the only legal plan is two single-key requests.
+    // An implementation that always bridges fails the tight frame; one that
+    // never bridges fails the roomy one.
+    for (budget, requests, written) in [
+        (9usize, &[(0usize, 1usize), (2, 1)][..], &[0usize, 2][..]),
+        (10, &[(0, 3)][..], &[0, 1, 2][..]),
+    ] {
+        let (mut capabilities, snapshot) = multi_stage_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+        capabilities.max_payload_size = budget as u16;
+        // Only the keymap differs, so no other stage's request has to fit.
+        let mut target = matching_restore_state(capabilities, &snapshot);
+        target.keymap[0] = KeyAction::No;
+        target.keymap[2] = KeyAction::No;
+        let state = std::sync::Arc::new(std::sync::Mutex::new(target));
+        let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+        drive(&mut driver, &client, async {
+            client
+                .restore_configuration(&snapshot)
+                .await
+                .unwrap_or_else(|error| panic!("frame {budget}: restore failed: {error:?}"));
+        })
+        .await;
+
+        let state = state.lock().unwrap();
+        assert_eq!(state.keymap, snapshot.keymap, "frame {budget}: the keymap was not restored");
+        assert_eq!(
+            touched(&state.key_requests),
+            requests,
+            "frame {budget}: the keymap plan is not the fewest requests this frame allows"
+        );
+        assert_eq!(
+            touched(&state.key_writes),
+            written,
+            "frame {budget}: the wrong keys were carried"
+        );
+    }
+}
