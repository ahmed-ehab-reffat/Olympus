+/// The browser wrapper has to drive the same snapshot implementation as the
+/// native client, so it is exercised for real under Node rather than merely
+/// compiled. Running it from here keeps its result in the same JUnit report as
+/// every other snapshot test instead of leaving it visible only in the runner's
+/// exit status.
+#[test]
+#[cfg(feature = "snapshot-tests")]
+fn snapshot_wasm_client_round_trips_under_node() {
+    if let Some(missing) = missing_wasm_tooling() {
+        eprintln!("skipping the WASM round trip: {missing}");
+        return;
+    }
+    if let Err(stderr) = run_standalone_cargo(
+        &[
+            "test",
+            "-p",
+            "snapshot-wasm-check-c84e2a",
+            "--target",
+            "wasm32-unknown-unknown",
+            "--locked",
+            "--offline",
+        ],
+        &[("CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER", "wasm-bindgen-test-runner")],
+    ) {
+        panic!("the WASM snapshot round trip failed:\n{stderr}");
+    }
+}
