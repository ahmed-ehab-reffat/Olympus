+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restore_retry_after_a_default_layer_failure_rewrites_nothing_else() {
+    // The default layer is written last and behaviour immediately before it, so
+    // a failure here is the one case where the whole configuration has already
+    // landed and only the final write is missing. Every earlier stage now
+    // matches, and a retry that trusts the first attempt's diff instead of
+    // reading the board again resends work that is already done.
+    let (capabilities, snapshot) = multi_stage_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+    let stages = restore_stages();
+    let state = std::sync::Arc::new(std::sync::Mutex::new(dirty_restore_state(
+        capabilities,
+        &snapshot,
+        Some((RestoreStage::DefaultLayer, 1)),
+    )));
+    let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+    drive(&mut driver, &client, async {
+        match client.restore_configuration(&snapshot).await {
+            Err(RestoreError::Write { completed, stage, .. }) => {
+                assert_eq!(completed, &stages[..stages.len() - 1]);
+                assert_eq!(stage, RestoreStage::DefaultLayer);
+            }
+            other => panic!("unexpected default-layer restore result: {other:?}"),
+        }
+    })
+    .await;
+    state.lock().unwrap().reject_stage_request = None;
+
+    drive(&mut driver, &client, async {
+        client.restore_configuration(&snapshot).await.unwrap();
+    })
+    .await;
+
+    let state = state.lock().unwrap();
+    assert_eq!(state.default_layer, snapshot.default_layer);
+    assert_eq!(state.behavior, snapshot.behavior);
+    assert_eq!(touched(&state.key_writes), [0, 1, 2], "the retry rewrote a key");
+    assert_eq!(touched(&state.encoder_writes), [(0, 0), (2, 0)], "the retry rewrote an encoder");
+    assert_eq!(touched(&state.combo_writes), [0, 1, 2], "the retry rewrote a combo");
+    assert_eq!(touched(&state.fork_writes), [0, 2], "the retry rewrote a fork");
+    assert_eq!(touched(&state.morse_writes), [0, 1, 2], "the retry rewrote a Morse slot");
+    // Each paged stage carried its matching middle entry once, on the first
+    // attempt. The retry re-read the baseline, found nothing left to do, and
+    // sent no request at all.
+    assert_eq!(
+        (
+            touched(&state.key_requests),
+            touched(&state.combo_requests),
+            touched(&state.morse_requests)
+        ),
+        (vec![(0, 3)], vec![(0, 3)], vec![(0, 3)]),
+        "a paged stage was written again after the retry re-read the baseline"
+    );
+    assert_eq!(
+        touched(&state.macro_writes),
+        [(0, vec![0x11]), (2, vec![0x33])],
+        "the retry rewrote a macro chunk"
+    );
+    assert_eq!(
+        state
+            .commands
+            .iter()
+            .filter(|command| **command == Cmd::SetBehaviorConfig)
+            .count(),
+        1,
+        "the retry rewrote a behaviour configuration that already matched"
+    );
+    assert_eq!(
+        state
+            .commands
+            .iter()
+            .filter(|command| **command == Cmd::SetDefaultLayer)
+            .count(),
+        2,
+        "the default layer should have been refused once and then applied once"
+    );
+}
