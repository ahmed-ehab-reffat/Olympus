+/// Run a Cargo command against the standalone snapshot workspace and return
+/// its stderr on failure. Nesting one Cargo inside another is safe here: the
+/// standalone workspace has its own target directory, so the two never contend
+/// for a build lock.
+#[cfg(feature = "snapshot-tests")]
+fn run_standalone_cargo(args: &[&str], env: &[(&str, &str)]) -> Result<(), String> {
+    let manifest = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .expect("the rynk package sits below the repository root")
+        .join(".olympus_wasm_c84e2a/Cargo.toml");
+    let cargo = option_env!("CARGO").unwrap_or("cargo");
+    let mut command = std::process::Command::new(cargo);
+    command.arg(args[0]).arg("--manifest-path").arg(&manifest).args(&args[1..]);
+    // Each nested build gets its own artifact directory. They target different
+    // architectures and share almost nothing, so splitting them costs little
+    // and keeps one from waiting on the other's directory lock. Keep that
+    // directory out of the root-owned checkout: evaluation runs as an
+    // arbitrary unprivileged UID.
+    let target_dir = std::env::temp_dir().join(format!(
+        "olympus-rmk-snapshot-{}-{}",
+        args.get(2).copied().unwrap_or("cargo"),
+        std::process::id()
+    ));
+    command.env("CARGO_TARGET_DIR", target_dir);
+    for (key, value) in env {
+        command.env(key, value);
+    }
+    let output = command.output().map_err(|error| {
+        format!(
+            "failed to launch nested Cargo `{cargo}` for `{}`: {error}",
+            manifest.display()
+        )
+    })?;
+    if output.status.success() {
+        Ok(())
+    } else {
+        Err(String::from_utf8_lossy(&output.stderr).into_owned())
+    }
+}
