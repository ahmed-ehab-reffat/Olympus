+#[tokio::test]
+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restore_addresses_a_larger_target_in_its_own_coordinates() {
+    let (source_capabilities, snapshot) = portable_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+    let capabilities = grown_target_caps(source_capabilities);
+    // The pristine larger target: the snapshot's values where it reaches, and
+    // untouchable sentinels everywhere else.
