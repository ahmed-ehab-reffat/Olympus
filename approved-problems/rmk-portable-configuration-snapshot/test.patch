+#[tokio::test]
+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restore_maps_each_grown_dimension_independently() {
+    // Growing every dimension at once lets one wrong stride hide behind
+    // another. Each of these grows a single dimension, so the keymap and
+    // encoder strides are exercised one at a time and a source-stride mistake
+    // has nowhere to hide.
+    let (source_capabilities, snapshot) = portable_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+    let source = &snapshot.geometry;
+    let dimensions: [(&str, fn(&mut DeviceCapabilities)); 4] = [
+        ("num_layers", |caps| caps.num_layers += 1),
+        ("num_rows", |caps| caps.num_rows += 1),
+        ("num_cols", |caps| caps.num_cols += 1),
+        ("num_encoders", |caps| caps.num_encoders += 1),
+    ];
+
+    for (field, grow) in dimensions {
+        let mut capabilities = source_capabilities;
+        grow(&mut capabilities);
+        let (rows, cols) = (capabilities.num_rows as usize, capabilities.num_cols as usize);
+        let encoders_per_layer = capabilities.num_encoders as usize;
+        let restored = grown_target_state(capabilities, &snapshot);
+
+        // Start from the pristine larger board and clear only what the snapshot
+        // covers, so every covered coordinate is dirty and every spare slot
+        // still carries its sentinel.
+        let mut target = grown_target_state(capabilities, &snapshot);
+        for layer in 0..source.num_layers as usize {
+            for row in 0..source.num_rows as usize {
+                for col in 0..source.num_cols as usize {
+                    target.keymap[(layer * rows + row) * cols + col] = KeyAction::No;
+                }
+            }
+            for encoder_id in 0..source.num_encoders as usize {
+                target.encoders[layer * encoders_per_layer + encoder_id] = EncoderAction::default();
+            }
+        }
+        target.default_layer = 0;
+        let state = std::sync::Arc::new(std::sync::Mutex::new(target));
+        let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+        drive(&mut driver, &client, async {
+            client
+                .restore_configuration(&snapshot)
+                .await
+                .unwrap_or_else(|error| panic!("{field} grown by one: {error}"));
+        })
+        .await;
+
+        let state = state.lock().unwrap();
+        assert_eq!(state.keymap, restored.keymap, "{field}: wrong key coordinates");
+        assert_eq!(state.encoders, restored.encoders, "{field}: wrong encoder coordinates");
+        assert_eq!(state.combos, restored.combos, "{field}: disturbed a combo");
+        assert_eq!(state.forks, restored.forks, "{field}: disturbed a fork");
+        assert_eq!(state.morses, restored.morses, "{field}: disturbed a Morse slot");
+        assert_eq!(state.macro_data, restored.macro_data, "{field}: disturbed macro bytes");
+        assert_eq!(state.default_layer, restored.default_layer, "{field}: wrong default layer");
+    }
+}
