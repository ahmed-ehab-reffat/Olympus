+/// Whether a restore rejected before touching the device.
+///
+/// `RestoreError::Preflight { .. }` is Rust's struct-pattern form, and Rust
+/// applies it to tuple variants too, whose fields are the positional names `0`,
+/// `1`, and so on. So this single arm accepts `Preflight(SnapshotError)` and
+/// `Preflight { source }` equally, and the tests never pin which one a solution
+/// chose. Only `Write`'s field names are prescribed, and the task states them.
+/// `snapshot_preflight_pattern_matches_either_variant_shape` proves the claim.
+#[cfg(feature = "snapshot-tests")]
+fn rejected_before_writing<T>(result: &Result<T, RestoreError>) -> bool {
+    matches!(result, Err(RestoreError::Preflight { .. }))
+}
+
+/// Guards the claim in [`rejected_before_writing`]: a pattern that silently
+/// admitted only one variant shape would fail a correct solution at compile
+/// time. The two local enums mirror the reasonable ways to declare `Preflight`,
+/// and the shared pattern must accept each.
+#[test]
+#[cfg(feature = "snapshot-tests")]
+fn snapshot_preflight_pattern_matches_either_variant_shape() {
+    #[allow(dead_code)]
+    enum TupleShaped {
+        Preflight(u8),
+    }
+    #[allow(dead_code)]
+    enum StructShaped {
+        Preflight { source: u8 },
+    }
+    assert!(matches!(TupleShaped::Preflight(7), TupleShaped::Preflight { .. }));
+    assert!(matches!(
+        StructShaped::Preflight { source: 7 },
+        StructShaped::Preflight { .. }
+    ));
+}
