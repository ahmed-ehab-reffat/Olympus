+            let entry = &mut s.morses[0];
+            entry.actions.clear();
+            for step in 0..=g.max_patterns_per_key {
+                let pattern = MorsePattern::from_u16(2 + step as u16);
+                entry.actions.insert(pattern, Action::User(step)).unwrap();
+            }
+        }),
+    ];
+    for (case, break_it) in invalid {
+        let mut broken = snapshot_fixture(snapshot_device_info("Snapshot Board"));
+        break_it(&mut broken, geometry);
+        assert!(broken.validate().is_err(), "{case} passed validation");
+        assert!(broken.to_bytes().is_err(), "{case} was encoded anyway");
+    }
+}
