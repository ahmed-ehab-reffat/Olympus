+#[cfg(feature = "snapshot-tests")]
+fn snapshot_write_stage(command: Cmd) -> Option<RestoreStage> {
+    match command {
+        Cmd::SetKeyAction | Cmd::SetKeymapBulk => Some(RestoreStage::Keymap),
+        Cmd::SetEncoderAction => Some(RestoreStage::Encoders),
+        Cmd::SetCombo | Cmd::SetComboBulk => Some(RestoreStage::Combos),
+        Cmd::SetFork => Some(RestoreStage::Forks),
+        Cmd::SetMorse | Cmd::SetMorseBulk => Some(RestoreStage::Morses),
+        Cmd::SetMacro => Some(RestoreStage::Macros),
+        Cmd::SetBehaviorConfig => Some(RestoreStage::Behavior),
+        Cmd::SetDefaultLayer => Some(RestoreStage::DefaultLayer),
+        _ => None,
+    }
+}
