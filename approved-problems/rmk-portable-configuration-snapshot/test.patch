+#[cfg(feature = "snapshot-tests")]
+async fn assert_restore_write_failure(
+    capabilities: DeviceCapabilities,
+    snapshot: &ConfigurationSnapshot,
+    failed_stage: RestoreStage,
+    failed_request_index: usize,
+    expected_completed: &[RestoreStage],
+) {
+    let state = std::sync::Arc::new(std::sync::Mutex::new(dirty_restore_state(
+        capabilities,
+        snapshot,
+        Some((failed_stage, failed_request_index)),
+    )));
+    let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+    drive(&mut driver, &client, async {
+        match client.restore_configuration(snapshot).await {
+            Err(RestoreError::Write {
+                completed,
+                stage,
+                source: RynkHostError::Rejected(RynkError::Invalid),
+            }) => {
+                assert_eq!(completed, expected_completed, "wrong prefix for {failed_stage:?}");
+                assert_eq!(stage, failed_stage);
+            }
+            other => panic!("unexpected {failed_stage:?} restore result: {other:?}"),
+        }
+    })
+    .await;
+
+    let mutation_stages: Vec<_> = state
+        .lock()
+        .unwrap()
+        .commands
+        .iter()
+        .copied()
+        .filter_map(snapshot_write_stage)
+        .collect();
+    // The stated rule is that no later stage is attempted. How many requests the
+    // failed stage already had in flight is not stated, and `write_all` keeps
+    // several pages in flight at once, so only the rejected request itself has
+    // to have been reached.
+    let stages = restore_stages();
+    let position = |stage: &RestoreStage| stages.iter().position(|candidate| candidate == stage).unwrap();
+    assert!(
+        mutation_stages.iter().filter(|stage| **stage == failed_stage).count() >= failed_request_index,
+        "{failed_stage:?} never reached the rejected write: {mutation_stages:?}"
+    );
+    assert!(
+        mutation_stages
+            .iter()
+            .all(|stage| position(stage) <= position(&failed_stage)),
+        "{failed_stage:?} failure did not stop later stages: {mutation_stages:?}"
+    );
+}
