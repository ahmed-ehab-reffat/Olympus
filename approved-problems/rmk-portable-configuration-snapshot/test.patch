+#[cfg(feature = "snapshot-tests")]
+fn keymap_request_index(capabilities: DeviceCapabilities, layer: u8, row: u8, col: u8) -> usize {
+    assert!(layer < capabilities.num_layers, "keymap layer is out of range");
+    assert!(row < capabilities.num_rows, "keymap row is out of range");
+    assert!(col < capabilities.num_cols, "keymap column is out of range");
+    layer as usize * capabilities.num_rows as usize * capabilities.num_cols as usize
+        + row as usize * capabilities.num_cols as usize
+        + col as usize
+}
