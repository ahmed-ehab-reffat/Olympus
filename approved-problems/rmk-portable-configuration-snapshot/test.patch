+//! Runtime assertions for the WASM snapshot methods.
+
+use js_sys::{Array, Function, Promise, Reflect, Uint8Array};
+use rynk::rmk_types::action::KeyAction;
+use rynk::rmk_types::protocol::rynk::{
+    BehaviorConfig, Cmd, DeviceCapabilities, DeviceInfo, FirmwareVersion, GetKeymapBulkRequest, GetKeymapBulkResponse,
+    KeyPosition, ProtocolVersion, RynkError, RynkHeader, SetKeyRequest, SetKeymapBulkRequest, encode_frame,
+};
+use rynk::{ConfigurationSnapshot, SNAPSHOT_VERSION};
+// Named by import alone; see the alloc surface crate for why.
+#[allow(unused_imports)]
+use rynk::SnapshotRead;
+use serde::Serialize;
+use wasm_bindgen::JsCast;
+use wasm_bindgen::prelude::*;
+use wasm_bindgen_futures::JsFuture;
+use wasm_bindgen_test::wasm_bindgen_test;
+
+use crate::client::connect;
+use crate::transport::JsByteLink;
+
+#[wasm_bindgen(inline_js = r#"
+export function makeSnapshotTestLink(responses, alternatives) {
+    const scripted = Array.from(responses, response => new Uint8Array(response));
+    const choices = Array.from(alternatives, pair => [
+        new Uint8Array(pair[0]),
+        new Uint8Array(pair[1]),
+    ]);
+    const ready = [];
+    const readers = [];
+    const writes = [];
+
+    return {
+        get label() { return "snapshot-test-link"; },
+        send(frame) {
+            const copy = new Uint8Array(frame);
+            if (copy.length === 1 && copy[0] === 0) return Promise.resolve();
+            writes.push(copy);
+            const choice = choices.find(([request]) =>
+                request.length === copy.length && request.every((byte, index) => byte === copy[index])
+            );
+            let response;
+            if (scripted.length > 0) {
+                const fallback = scripted.shift();
+                response = choice ? choice[1] : fallback;
+            } else if (choice) {
+                response = choice[1];
+            } else {
+                return Promise.reject(new Error("unexpected request"));
+            }
+            if (readers.length > 0) readers.shift()(response);
+            else ready.push(response);
+            return Promise.resolve();
+        },
+        recv() {
+            if (ready.length > 0) return Promise.resolve(ready.shift());
+            return new Promise(resolve => readers.push(resolve));
+        },
+        snapshotResponses: scripted,
+        snapshotWrites: writes,
+    };
+}
+
+export function snapshotResponsesLeft(link) {
+    return link.snapshotResponses.length;
+}
+
+export function snapshotRequestCount(link) {
+    return link.snapshotWrites.length;
+}
+
+export function snapshotSentFrame(link, frame) {
+    const want = new Uint8Array(frame);
+    return link.snapshotWrites.some(sent =>
+        sent.length === want.length && want.every((byte, index) => byte === sent[index])
+    );
+}
+"#)]
+extern "C" {
+    #[wasm_bindgen(js_name = makeSnapshotTestLink)]
+    fn make_snapshot_test_link(responses: &Array, alternatives: &Array) -> JsValue;
+
+    #[wasm_bindgen(js_name = snapshotResponsesLeft)]
+    fn snapshot_responses_left(link: &JsValue) -> u32;
+
+    #[wasm_bindgen(js_name = snapshotRequestCount)]
+    fn snapshot_request_count(link: &JsValue) -> u32;
+
+    #[wasm_bindgen(js_name = snapshotSentFrame)]
+    fn snapshot_sent_frame(link: &JsValue, frame: &[u8]) -> bool;
+}
+
+fn reply<T: Serialize>(cmd: Cmd, seq: u8, value: T) -> Vec<u8> {
+    let mut bytes = vec![0u8; 4096];
+    let written = encode_frame(&mut bytes, RynkHeader { cmd, seq }, &Ok::<T, RynkError>(value)).unwrap();
+    bytes.truncate(written);
+    bytes
+}
+
+fn request<T: Serialize>(cmd: Cmd, seq: u8, value: T) -> Vec<u8> {
+    let mut bytes = vec![0u8; 4096];
+    let written = encode_frame(&mut bytes, RynkHeader { cmd, seq }, &value).unwrap();
+    bytes.truncate(written);
+    bytes
+}
+
+fn push_alternative(alternatives: &Array, request: Vec<u8>, response: Vec<u8>) {
+    let pair = Array::new();
+    pair.push(Uint8Array::from(request.as_slice()).as_ref());
+    pair.push(Uint8Array::from(response.as_slice()).as_ref());
+    alternatives.push(pair.as_ref());
+}
+
+fn device_info() -> DeviceInfo {
+    DeviceInfo {
+        rmk_version: FirmwareVersion {
+            major: 0,
+            minor: 8,
+            patch: 2,
+        },
+        vendor_id: 0x4c4b,
+        product_id: 0x0001,
+        manufacturer: "RMK".try_into().unwrap(),
+        product_name: "Snapshot Board".try_into().unwrap(),
+        serial_number: "wasm-unit".try_into().unwrap(),
+    }
+}
+
+fn capabilities() -> DeviceCapabilities {
+    DeviceCapabilities {
+        num_layers: 1,
+        num_rows: 1,
+        num_cols: 1,
+        max_combo_keys: 4,
+        max_patterns_per_key: 4,
+        max_payload_size: 4096,
+        max_bulk_keys: 1,
+        max_bulk_items: 1,
+        bulk_transfer_supported: true,
+        ..Default::default()
+    }
+}
+
+/// The key action the restored record carries, differing from the board's.
+const APPLIED: KeyAction = KeyAction::Morse(7);
+
+#[wasm_bindgen_test(async)]
+async fn snapshot_methods_export_native_bytes_and_restore_them() {
+    assert_eq!(SNAPSHOT_VERSION, 1);
+
+    let info = device_info();
+    let caps = capabilities();
+    let behavior = BehaviorConfig {
+        combo_timeout_ms: 201,
+        oneshot_timeout_ms: 1001,
+        tap_interval_ms: 202,
+        tap_capslock_interval_ms: 203,
+    };
+    let keymap = vec![KeyAction::No];
+    let responses = [
+        reply(Cmd::GetVersion, 1, ProtocolVersion::CURRENT),
+        reply(Cmd::GetCapabilities, 2, caps),
+        reply(Cmd::GetDeviceInfo, 3, info.clone()),
+        reply(Cmd::GetDefaultLayer, 4, 0u8),
+        reply(
+            Cmd::GetKeymapBulk,
+            5,
+            GetKeymapBulkResponse {
+                actions: keymap.clone(),
+            },
+        ),
+        reply(Cmd::GetBehaviorConfig, 6, behavior),
+    ];
+    let response_array = Array::new();
+    for response in responses {
+        let response = Uint8Array::from(response.as_slice());
+        response_array.push(response.as_ref());
+    }
+    let alternatives = Array::new();
+    let position = KeyPosition {
+        layer: 0,
+        row: 0,
+        col: 0,
+    };
+    push_alternative(
+        &alternatives,
+        request(Cmd::GetKeyAction, 5, position),
+        reply(Cmd::GetKeyAction, 5, KeyAction::No),
+    );
+    for seq in 7..=20 {
+        push_alternative(
+            &alternatives,
+            request(Cmd::GetDeviceInfo, seq, ()),
+            reply(Cmd::GetDeviceInfo, seq, info.clone()),
+        );
+        push_alternative(
+            &alternatives,
+            request(Cmd::GetDefaultLayer, seq, ()),
+            reply(Cmd::GetDefaultLayer, seq, 0u8),
+        );
+        push_alternative(
+            &alternatives,
+            request(
+                Cmd::GetKeymapBulk,
+                seq,
+                GetKeymapBulkRequest {
+                    layer: 0,
+                    start_row: 0,
+                    start_col: 0,
+                },
+            ),
+            reply(
+                Cmd::GetKeymapBulk,
+                seq,
+                GetKeymapBulkResponse {
+                    actions: keymap.clone(),
+                },
+            ),
+        );
+        push_alternative(
+            &alternatives,
+            request(Cmd::GetKeyAction, seq, position),
+            reply(Cmd::GetKeyAction, seq, KeyAction::No),
+        );
+        push_alternative(
+            &alternatives,
+            request(Cmd::GetBehaviorConfig, seq, ()),
+            reply(Cmd::GetBehaviorConfig, seq, behavior),
+        );
+        // The restored record differs from the board, so a keymap write has to
+        // follow. Answer it through either endpoint; which one is the
+        // implementation's business.
+        push_alternative(
+            &alternatives,
+            request(
+                Cmd::SetKeyAction,
+                seq,
+                SetKeyRequest {
+                    position,
+                    action: APPLIED,
+                },
+            ),
+            reply(Cmd::SetKeyAction, seq, ()),
+        );
+        push_alternative(
+            &alternatives,
+            request(
+                Cmd::SetKeymapBulk,
+                seq,
+                SetKeymapBulkRequest {
+                    layer: 0,
+                    start_row: 0,
+                    start_col: 0,
+                    actions: vec![APPLIED],
+                },
+            ),
+            reply(Cmd::SetKeymapBulk, seq, ()),
+        );
+    }
+    let raw_link = make_snapshot_test_link(&response_array, &alternatives);
+    let link: JsByteLink = raw_link.clone().unchecked_into();
+
+    let client = JsValue::from(connect(link).await.unwrap());
+
+    // Both methods are called the way a browser would, through the exported
+    // JavaScript object. wasm-bindgen surfaces a Rust `Vec<u8>` and a
+    // `js_sys::Uint8Array` as the same JavaScript typed array, so going through
+    // JS keeps the test on the byte-oriented API the task asks for instead of
+    // pinning which of the two the wrapper happens to name in Rust.
+    let export = Reflect::get(&client, &JsValue::from_str("export_configuration_snapshot"))
+        .unwrap()
+        .dyn_into::<Function>()
+        .unwrap();
+    let exported = JsFuture::from(
+        export
+            .call0(&client)
+            .unwrap()
+            .dyn_into::<Promise>()
+            .expect("export_configuration_snapshot returns a promise"),
+    )
+    .await
+    .unwrap();
+    let bytes = exported
+        .dyn_into::<Uint8Array>()
+        .expect("export_configuration_snapshot resolves to a byte array")
+        .to_vec();
+
+    let snapshot = ConfigurationSnapshot::from_bytes(&bytes).unwrap();
+    assert_eq!(snapshot.device_info, info);
+    assert_eq!(snapshot.keymap, keymap);
+    assert_eq!(snapshot.behavior, behavior);
+    assert_eq!(snapshot.to_bytes().unwrap(), bytes);
+
+    let restore = Reflect::get(&client, &JsValue::from_str("restore_configuration_snapshot"))
+        .unwrap()
+        .dyn_into::<Function>()
+        .unwrap();
+    // Start from this implementation's complete snapshot, then add trailing
+    // input that the decoder must not ignore. This exercises the byte wrapper
+    // without assigning meaning to a foreign encoding.
+    let mut trailing_bytes = bytes.clone();
+    trailing_bytes.push(0xaa);
+    let rejected = restore
+        .call1(&client, Uint8Array::from(trailing_bytes.as_slice()).as_ref())
+        .unwrap()
+        .dyn_into::<Promise>()
+        .expect("restore_configuration_snapshot returns a promise");
+    assert!(
+        JsFuture::from(rejected).await.is_err(),
+        "restore_configuration_snapshot ignored trailing snapshot bytes"
+    );
+
+    // Valid bytes whose native restore must fail. This board reports "Snapshot
+    // Board", so a record naming another one is refused at preflight without a
+    // single write. Decoding it succeeds, so only a wrapper that propagates the
+    // native failure rejects here; one that swallows it resolves happily.
+    let mut foreign = ConfigurationSnapshot::from_bytes(&bytes).unwrap();
+    foreign.device_info.product_name = "Other Board".try_into().unwrap();
+    let foreign_bytes = foreign.to_bytes().unwrap();
+    let refused = restore
+        .call1(&client, Uint8Array::from(foreign_bytes.as_slice()).as_ref())
+        .unwrap()
+        .dyn_into::<Promise>()
+        .expect("restore_configuration_snapshot returns a promise");
+    assert!(
+        JsFuture::from(refused).await.is_err(),
+        "restore_configuration_snapshot hid a native preflight failure"
+    );
+
+    // Now restore a record that differs from the board, so the only way to
+    // satisfy it is to decode these bytes and write what they say. Passing the
+    // board's own bytes back, as this test used to, asks for no writes at all
+    // and so proves nothing about the argument.
+    let mut wanted = snapshot;
+    wanted.keymap[0] = APPLIED;
+    let wanted_bytes = wanted.to_bytes().unwrap();
+    assert_ne!(wanted_bytes, bytes, "the restored record must differ from the exported one");
+
+    let restore_result = restore
+        .call1(&client, Uint8Array::from(wanted_bytes.as_slice()).as_ref())
+        .unwrap()
+        .dyn_into::<Promise>()
+        .unwrap();
+    JsFuture::from(restore_result).await.unwrap();
+
+    let applied = (1u8..=40).any(|seq| {
+        snapshot_sent_frame(
+            &raw_link,
+            &request(
+                Cmd::SetKeyAction,
+                seq,
+                SetKeyRequest {
+                    position,
+                    action: APPLIED,
+                },
+            ),
+        ) || snapshot_sent_frame(
+            &raw_link,
+            &request(
+                Cmd::SetKeymapBulk,
+                seq,
+                SetKeymapBulkRequest {
+                    layer: 0,
+                    start_row: 0,
+                    start_col: 0,
+                    actions: vec![APPLIED],
+                },
+            ),
+        )
+    });
+    assert!(
+        applied,
+        "restore_configuration_snapshot never wrote the key action its bytes asked for"
+    );
+
+    assert_eq!(snapshot_responses_left(&raw_link), 0);
+    assert!(snapshot_request_count(&raw_link) >= 10);
+}
