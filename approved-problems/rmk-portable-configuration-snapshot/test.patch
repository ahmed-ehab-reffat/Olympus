+#[cfg(feature = "snapshot-tests")]
+fn snapshot_phase(command: Cmd) -> Cmd {
+    match command {
+        Cmd::GetKeyAction | Cmd::GetKeymapBulk => Cmd::GetKeymapBulk,
+        Cmd::SetKeyAction | Cmd::SetKeymapBulk => Cmd::SetKeymapBulk,
+        Cmd::GetCombo | Cmd::GetComboBulk => Cmd::GetComboBulk,
+        Cmd::SetCombo | Cmd::SetComboBulk => Cmd::SetComboBulk,
+        Cmd::GetMorse | Cmd::GetMorseBulk => Cmd::GetMorseBulk,
+        Cmd::SetMorse | Cmd::SetMorseBulk => Cmd::SetMorseBulk,
+        command => command,
+    }
+}
