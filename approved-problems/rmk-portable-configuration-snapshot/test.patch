+//! Deliberately shape-free: results are discarded rather than annotated, and
+//! types are borrowed rather than constructed or copied, so this asserts that
+//! the items exist and are reachable without `std` and nothing about which
+//! error type, return type, or derive a solution chooses.
+#![no_std]
+
+extern crate alloc;
+
+use rynk::{Client, ConfigurationSnapshot, SNAPSHOT_VERSION, SnapshotGeometry};
+// Named by import alone. A type expression such as `Option<SnapshotRead>` would
+// additionally demand the item be nongeneric and lifetime-free, which the task
+// never says; importing asserts only that the name is exported and reachable
+// with `alloc` on and `std` off, which is what the task does say.
+#[allow(unused_imports)]
+use rynk::{RestoreError, RestoreStage, SnapshotError, SnapshotRead};
+
+/// Serde support is part of `ConfigurationSnapshot`'s stated contract, so it is
+/// asserted as a bound rather than inferred from a working `to_bytes`: a
+/// hand-rolled encoder would satisfy the methods while leaving the record
+/// unusable to any other serde format. The bound names no format, and it is not
+/// applied to any type the task does not require it of.
+fn requires_serde<T: serde::Serialize + serde::de::DeserializeOwned>() {}
+
+/// Every public item the task requires, named in one place.
+pub async fn surface(client: &Client, snapshot: &ConfigurationSnapshot, bytes: &[u8]) {
+    requires_serde::<ConfigurationSnapshot>();
+    let _ = SNAPSHOT_VERSION;
+    let _: &SnapshotGeometry = &snapshot.geometry;
+
+    let _ = snapshot.to_bytes();
+    let _ = snapshot.validate();
+    let _ = ConfigurationSnapshot::from_bytes(bytes);
+    let _ = client.export_configuration().await;
+    let _ = client.preflight_restore(snapshot).await;
+    let _ = client.restore_configuration(snapshot).await;
+}
