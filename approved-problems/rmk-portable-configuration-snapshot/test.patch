+#[tokio::test]
+#[cfg(feature = "snapshot-tests")]
+async fn snapshot_restore_plans_every_write_before_touching_the_device() {
+    // This target's frame carries a keymap page (6 bytes) and an encoder write
+    // (5), but not a combo one (9). Nothing has to be sent to learn that: the
+    // host encodes against the advertised limit. A restore that streams stage
+    // by stage therefore writes the keymap and encoders, and only then finds it
+    // cannot encode the combos, leaving the device changed. The contract puts
+    // that shortfall before the first write, so it has to be found first.
+    // 8 bytes stops the paged combo write; 12 lets every paged stage through and
+    // stops the single-entry fork write, which no pager ever measures. Both are
+    // host-side verdicts, so neither may reach the device.
+    for (budget, case) in [(8u16, "unencodable combo page"), (12, "unencodable fork write")] {
+        let (mut capabilities, snapshot) = multi_stage_snapshot_fixture(snapshot_device_info("Snapshot Board"));
+        capabilities.max_payload_size = budget;
+        let state = std::sync::Arc::new(std::sync::Mutex::new(dirty_restore_state(capabilities, &snapshot, None)));
+        let (client, mut driver) = StatefulSnapshotDevice(state.clone()).connect().await.unwrap();
+
+        drive(&mut driver, &client, async {
+            assert!(
+                rejected_before_writing(&client.restore_configuration(&snapshot).await),
+                "{case}: a write the target's frame cannot carry is a preflight failure"
+            );
+        })
+        .await;
+
+        assert_no_mutation(case, &state.lock().unwrap());
+    }
+}
