+@pytest.mark.parametrize(
+    "invalid_kind", ["graphic", "foreign", "root", "unnamed", "orphan-branch"]
+)
+def test_reject_invalid_object_selection(invalid_kind):
+    source = ezdxf.new()
+    loader = xref.Loader(source, ezdxf.new())
+
+    if invalid_kind == "graphic":
+        invalid = source.modelspace().add_line((0, 0), (1, 0))
+    elif invalid_kind == "foreign":
+        foreign = ezdxf.new()
+        invalid = foreign.rootdict.add_xrecord("FOREIGN")
+    elif invalid_kind == "root":
+        invalid = source.rootdict
+    elif invalid_kind == "unnamed":
+        invalid = source.objects.add_xrecord(owner=source.rootdict.dxf.handle)
+    else:
+        owner = source.objects.add_dictionary(
+            owner=source.rootdict.dxf.handle, hard_owned=False
+        )
+        invalid = owner.add_xrecord("DETACHED")
+
+    with pytest.raises(xref.EntityError):
+        loader.load_objects([invalid])
+
