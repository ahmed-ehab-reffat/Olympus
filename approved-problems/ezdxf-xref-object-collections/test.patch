+def test_copy_dictionary_with_default_maps_default_and_survives_reload(tmp_path):
+    source = ezdxf.new()
+    source_dictionary = source.objects.add_dictionary_with_default(
+        owner=source.rootdict.dxf.handle,
+        hard_owned=False,
+    )
+    source.rootdict.add("CUSTOM-DEFAULT", source_dictionary)
+    source_default = source.objects.add_placeholder(
+        owner=source_dictionary.dxf.handle
+    )
+    source_dictionary.set_default(source_default)
+    source_dictionary.add_xrecord("ENTRY").reset([(1, "payload")])
+
+    target = load_objects(source, [source_dictionary])
+
+    copied_dictionary = target.rootdict["CUSTOM-DEFAULT"]
+    copied_default = copied_dictionary.get("MISSING")
+    assert isinstance(copied_dictionary, DictionaryWithDefault)
+    assert copied_default is not None
+    assert copied_default is not source_default
+    assert copied_default.doc is target
+    assert copied_default.dxf.owner == copied_dictionary.dxf.handle
+    assert copied_dictionary.dxf.default == copied_default.dxf.handle
+    assert copied_dictionary["ENTRY"].tags == [(1, "payload")]
+    assert not target.audit().has_errors
+
+    loaded = reload_document(target, tmp_path / "dictionary-default.dxf")
+    copied_dictionary = loaded.rootdict["CUSTOM-DEFAULT"]
+    copied_default = copied_dictionary.get("MISSING")
+    assert copied_default is not None
+    assert copied_dictionary.dxf.default == copied_default.dxf.handle
+    assert copied_default.dxf.owner == copied_dictionary.dxf.handle
+    assert copied_dictionary["ENTRY"].tags == [(1, "payload")]
+    assert not loaded.audit().has_errors
+
