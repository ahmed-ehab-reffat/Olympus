+def test_validation_does_not_queue_valid_prefix():
+    source = ezdxf.new()
+    valid = source.rootdict.add_xrecord("VALID")
+    invalid = source.objects.add_xrecord(owner=source.rootdict.dxf.handle)
+    target = ezdxf.new()
+    loader = xref.Loader(source, target)
+
+    with pytest.raises(xref.EntityError):
+        loader.load_objects([valid, invalid])
+    loader.execute()
+
+    assert "VALID" not in target.rootdict
