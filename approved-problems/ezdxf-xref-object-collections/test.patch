+def test_multiple_load_calls_append_to_command_queue():
+    source = ezdxf.new()
+    first = source.rootdict.add_xrecord("FIRST")
+    second = source.rootdict.add_dict_var("SECOND", "second value")
+    target = ezdxf.new()
+    loader = xref.Loader(source, target)
+
+    loader.load_objects([first])
+    loader.load_objects([second])
+    loader.execute()
+
+    assert target.rootdict["FIRST"] is not first
+    assert target.rootdict["SECOND"].dxf.value == "second value"
