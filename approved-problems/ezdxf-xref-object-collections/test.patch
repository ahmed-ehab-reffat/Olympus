+#!/usr/bin/env bash
+# Run the complete regression suite or focused named-object transfer tests.
+set -uo pipefail
+
+repo_root="$(cd "$(dirname "$0")" && pwd)"
+cd "$repo_root"
+
+output_path="results.xml"
+if [ "${1:-}" = "--output_path" ]; then
+    output_path="$2"
+    shift 2
+fi
+mode="${1:-new}"
+
+mkdir -p "$(dirname "$output_path")"
+export PYTHONPATH="$repo_root/src"
+
+case "$mode" in
+    base)
+        python -m pytest -q tests integration_tests \
+            --ignore=tests/test_05_tools/test_537_named_object_transfer.py \
+            --junitxml="$output_path"
+        ;;
+    new)
+        python -m pytest -q \
+            tests/test_05_tools/test_537_named_object_transfer.py \
+            --junitxml="$output_path"
+        ;;
+    *)
+        echo "unknown mode: $mode (expected base or new)" >&2
+        exit 2
+        ;;
+esac
