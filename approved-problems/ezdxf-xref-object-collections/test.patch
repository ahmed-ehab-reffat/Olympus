+    leaf = dictionary.add_xrecord("LEAF")
+    shared = source.objects.add_xrecord(owner=leaf.dxf.handle)
+    shared.reset([(1, "shared child")])
+    leaf.reset([(1, "source leaf"), (360, shared.dxf.handle)])
+    holder = dictionary.add_xrecord("HOLDER")
+    holder.reset([(340, shared.dxf.handle)])
+
+    target = ezdxf.new()
+    target_dictionary = target.rootdict.add_new_dict("VENDOR", hard_owned=False)
