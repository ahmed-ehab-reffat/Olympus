+@pytest.mark.parametrize(
+    "policy", [xref.ConflictPolicy.XREF_PREFIX, xref.ConflictPolicy.NUM_PREFIX]
+)
+def test_prefix_policy_retains_free_leaf_key(policy):
+    source = ezdxf.new()
+    source_dictionary = source.rootdict.add_new_dict("VENDOR", hard_owned=False)
+    record = source_dictionary.add_xrecord("LEAF")
