+def make_unknown_object(doc, owner, peer, embedded_peer, owned):
+    handle = doc.entitydb.next_handle()
+    entity = DXFTagStorage.from_text(
+        f"""0
+VENDOR_OBJECT
+5
+{handle}
+330
+{owner.dxf.handle}
+100
+AcDbVendorObject
+1
+opaque payload
+320
+ABCDEF
+340
+{peer.dxf.handle}
+350
+{peer.dxf.handle}
+390
+{peer.dxf.handle}
+480
+{peer.dxf.handle}
+360
+{owned.dxf.handle}
+101
+Embedded Object
+1
+embedded payload
+320
+FEDCBA
+340
+{embedded_peer.dxf.handle}
+390
+{embedded_peer.dxf.handle}
+480
+{embedded_peer.dxf.handle}
+"""
+    )
+    factory.bind(entity, doc)
+    doc.objects.add_object(entity)
+    owner.add("RAW", entity)
+    owned.dxf.owner = entity.dxf.handle
+    return entity
+
+
+def pointer_values(entity, code):
+    groups = list(entity.xtags.subclasses[1:])
+    groups.extend(entity.embedded_objects or [])
+    return [tag.value for tags in groups for tag in tags if tag.code == code]
+
+
+def test_unknown_object_preserves_and_maps_raw_tags(tmp_path):
+    source = ezdxf.new()
+    dictionary = source.rootdict.add_new_dict("VENDOR", hard_owned=False)
+    peer = dictionary.add_xrecord("PEER")
+    peer.reset([(1, "peer")])
+    embedded_peer = dictionary.add_xrecord("EMBEDDED-PEER")
+    embedded_peer.reset([(1, "embedded-peer")])
+    owned = source.objects.add_xrecord(owner="0")
+    owned.reset([(1, "owned")])
+    raw = make_unknown_object(source, dictionary, peer, embedded_peer, owned)
+    raw.set_xdata("VENDOR_APP", [(1005, peer.dxf.handle)])
+
+    target = load_objects(source, [raw], target=target_with_handle_offset())
+
+    copied = target.rootdict["VENDOR"]["RAW"]
+    copied_peer = target.rootdict["VENDOR"]["PEER"]
+    copied_embedded_peer = target.rootdict["VENDOR"]["EMBEDDED-PEER"]
+    assert isinstance(copied, DXFTagStorage)
+    assert copied is not raw
+    assert copied.dxftype() == "VENDOR_OBJECT"
+    assert pointer_values(copied, 320) == ["ABCDEF", "FEDCBA"]
+    assert pointer_values(copied, 340) == [
+        copied_peer.dxf.handle,
+        copied_embedded_peer.dxf.handle,
+    ]
+    assert pointer_values(copied, 350) == [copied_peer.dxf.handle]
+    assert copied_peer.dxf.owner == target.rootdict["VENDOR"].dxf.handle
+    assert pointer_values(copied, 390) == [
+        copied_peer.dxf.handle,
+        copied_embedded_peer.dxf.handle,
+    ]
+    assert pointer_values(copied, 480) == [
+        copied_peer.dxf.handle,
+        copied_embedded_peer.dxf.handle,
+    ]
+    assert copied.get_xdata("VENDOR_APP") == [
+        (1005, copied_peer.dxf.handle)
+    ]
+    copied_owned = target.entitydb[pointer_values(copied, 360)[0]]
+    assert copied_owned.dxf.owner == copied.dxf.handle
+    assert any(
+        DXFTag(1, "embedded payload") in tags
+        for tags in copied.embedded_objects or []
+    )
+    assert pointer_values(raw, 340) == [
+        peer.dxf.handle,
+        embedded_peer.dxf.handle,
+    ]
+    assert pointer_values(raw, 360) == [owned.dxf.handle]
+    assert raw.get_xdata("VENDOR_APP") == [(1005, peer.dxf.handle)]
+    assert not target.audit().has_errors
+
+    loaded = reload_document(target, tmp_path / "unknown-object.dxf")
+    copied = loaded.rootdict["VENDOR"]["RAW"]
+    copied_owned = loaded.entitydb[pointer_values(copied, 360)[0]]
+    assert copied_owned.dxf.owner == copied.dxf.handle
+    assert pointer_values(copied, 320) == ["ABCDEF", "FEDCBA"]
+    assert pointer_values(copied, 340) == [
+        loaded.rootdict["VENDOR"]["PEER"].dxf.handle,
+        loaded.rootdict["VENDOR"]["EMBEDDED-PEER"].dxf.handle,
+    ]
+    assert pointer_values(copied, 350) == [
+        loaded.rootdict["VENDOR"]["PEER"].dxf.handle
+    ]
+    assert (
+        loaded.rootdict["VENDOR"]["PEER"].dxf.owner
+        == loaded.rootdict["VENDOR"].dxf.handle
+    )
+    for code in (390, 480):
+        assert pointer_values(copied, code) == [
+            loaded.rootdict["VENDOR"]["PEER"].dxf.handle,
+            loaded.rootdict["VENDOR"]["EMBEDDED-PEER"].dxf.handle,
+        ]
+    assert copied.get_xdata("VENDOR_APP") == [
+        (1005, loaded.rootdict["VENDOR"]["PEER"].dxf.handle)
+    ]
+    assert pointer_values(raw, 340) == [
+        peer.dxf.handle,
+        embedded_peer.dxf.handle,
+    ]
+    assert pointer_values(raw, 360) == [owned.dxf.handle]
+    assert raw.get_xdata("VENDOR_APP") == [(1005, peer.dxf.handle)]
+    assert not loaded.audit().has_errors
+
