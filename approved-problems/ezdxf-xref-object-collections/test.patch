+def test_keep_reuses_matching_hard_owned_dictionary(tmp_path):
+    source = ezdxf.new()
+    source_dictionary = source.rootdict.add_new_dict("HARD", hard_owned=True)
+    incoming = source_dictionary.add_xrecord("INCOMING")
+    incoming.reset([(1, "source content")])
+
+    target = ezdxf.new()
+    target_dictionary = target.rootdict.add_new_dict("HARD", hard_owned=True)
+    resident = target_dictionary.add_xrecord("RESIDENT")
+    resident.reset([(1, "target content")])
+
+    load_objects(source, [source_dictionary], target=target)
+
+    assert target.rootdict["HARD"] is target_dictionary
+    assert target_dictionary["RESIDENT"] is resident
+    copied = target_dictionary["INCOMING"]
+    assert copied is not incoming
+    assert copied.tags == [(1, "source content")]
+    assert copied.dxf.owner == target_dictionary.dxf.handle
+    assert source_dictionary["INCOMING"] is incoming
+    assert not target.audit().has_errors
+
+    loaded = reload_document(target, tmp_path / "reused-hard-owned.dxf")
+    loaded_dictionary = loaded.rootdict["HARD"]
+    assert loaded_dictionary["RESIDENT"].tags == [(1, "target content")]
+    assert loaded_dictionary["INCOMING"].tags == [(1, "source content")]
+    assert (
+        loaded_dictionary["INCOMING"].dxf.owner
+        == loaded_dictionary.dxf.handle
+    )
+    assert not loaded.audit().has_errors
+
