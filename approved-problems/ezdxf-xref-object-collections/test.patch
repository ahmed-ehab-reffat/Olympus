+def test_keep_reused_dictionary_with_default_discards_source_default(tmp_path):
+    source = ezdxf.new()
+    source_dictionary = source.objects.add_dictionary_with_default(
+        owner=source.rootdict.dxf.handle,
+        hard_owned=True,
+    )
+    source.rootdict.add("CUSTOM-DEFAULT", source_dictionary)
+    source_default = source.objects.add_xrecord(
+        owner=source_dictionary.dxf.handle
+    )
+    source_default.reset([(1, "source default")])
+    source_dictionary.set_default(source_default)
+    source_dictionary.add_xrecord("INCOMING").reset([(1, "incoming")])
+
+    target = ezdxf.new()
+    target_dictionary = target.objects.add_dictionary_with_default(
+        owner=target.rootdict.dxf.handle,
+        hard_owned=True,
+    )
+    target.rootdict.add("CUSTOM-DEFAULT", target_dictionary)
+    target_default = target.objects.add_xrecord(
+        owner=target_dictionary.dxf.handle
+    )
+    target_default.reset([(1, "target default")])
+    target_dictionary.set_default(target_default)
+    target_dictionary.add_xrecord("RESIDENT").reset([(1, "resident")])
+
+    load_objects(source, [source_dictionary], target=target)
+
+    assert target.rootdict["CUSTOM-DEFAULT"] is target_dictionary
+    assert target_dictionary.get("MISSING") is target_default
+    assert target_dictionary.dxf.default == target_default.dxf.handle
+    assert target_dictionary["RESIDENT"].tags == [(1, "resident")]
+    assert target_dictionary["INCOMING"].tags == [(1, "incoming")]
+    assert find_xrecord_with_value(target, "source default") is None
+    assert source_dictionary.get("MISSING") is source_default
+    assert not target.audit().has_errors
+
+    loaded = reload_document(target, tmp_path / "reused-dictionary-default.dxf")
+    loaded_dictionary = loaded.rootdict["CUSTOM-DEFAULT"]
+    loaded_default = loaded_dictionary.get("MISSING")
+    assert loaded_default.tags == [(1, "target default")]
+    assert loaded_default.dxf.owner == loaded_dictionary.dxf.handle
+    assert loaded_dictionary["RESIDENT"].tags == [(1, "resident")]
+    assert loaded_dictionary["INCOMING"].tags == [(1, "incoming")]
+    assert find_xrecord_with_value(loaded, "source default") is None
+    assert not loaded.audit().has_errors
+
