+def test_copy_hard_owned_dictionary_content(tmp_path):
+    source = ezdxf.new()
+    dictionary = source.rootdict.add_new_dict("HARD", hard_owned=True)
+    child = dictionary.add_xrecord("CHILD")
+    resource = source.objects.add_xrecord(owner=child.dxf.handle)
+    resource.reset([(1, "nested resource")])
+    child.reset([(360, resource.dxf.handle)])
+    empty = dictionary.add_new_dict("EMPTY", hard_owned=True)
+
+    target = load_objects(source, [dictionary])
+
+    copied = target.rootdict["HARD"]
+    assert isinstance(copied, Dictionary)
+    assert copied.is_hard_owner
+    assert copied["CHILD"] is not child
+    assert copied["CHILD"].dxf.owner == copied.dxf.handle
+    copied_resource = target.entitydb[copied["CHILD"].tags[0].value]
+    assert copied_resource.tags == [(1, "nested resource")]
+    assert copied_resource.dxf.owner == copied["CHILD"].dxf.handle
+    assert copied["EMPTY"] is not empty
+    assert copied["EMPTY"].dxf.owner == copied.dxf.handle
+    assert len(copied["EMPTY"]) == 0
+    assert not target.audit().has_errors
+
+    loaded = reload_document(target, tmp_path / "hard-owned.dxf")
+    copied = loaded.rootdict["HARD"]
+    assert copied["CHILD"].dxf.owner == copied.dxf.handle
+    copied_resource = loaded.entitydb[copied["CHILD"].tags[0].value]
+    assert copied_resource.dxf.owner == copied["CHILD"].dxf.handle
+    assert copied["EMPTY"].dxf.owner == copied.dxf.handle
