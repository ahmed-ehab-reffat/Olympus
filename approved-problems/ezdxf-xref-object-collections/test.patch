+@pytest.mark.parametrize(
+    "policy", [xref.ConflictPolicy.XREF_PREFIX, xref.ConflictPolicy.NUM_PREFIX]
+)
+def test_prefix_policy_renames_leaf_conflict(policy):
+    target = ezdxf.new()
+    target_dictionary = target.rootdict.add_new_dict("VENDOR", hard_owned=False)
+    target_dictionary.add_xrecord("LEAF").reset([(1, "target")])
+
+    for payload in ("source one", "source two"):
+        source = ezdxf.new()
+        source_dictionary = source.rootdict.add_new_dict(
+            "VENDOR", hard_owned=False
+        )
+        record = source_dictionary.add_xrecord("LEAF")
+        record.reset([(1, payload)])
+        load_objects(source, [record], target=target, policy=policy)
+
+    matching = [
+        (key, entity)
+        for key, entity in target_dictionary.items()
+        if isinstance(entity, XRecord)
+        and any(
+            DXFTag(1, payload) in entity.tags
+            for payload in ("source one", "source two")
+        )
+    ]
+    assert len(matching) == 2
+    assert len({key for key, _ in matching}) == 2
+    assert all(key != "LEAF" for key, _ in matching)
+    assert target_dictionary["LEAF"].tags == [(1, "target")]
+
