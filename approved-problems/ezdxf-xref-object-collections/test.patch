+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+import ezdxf
+from ezdxf import xref
+from ezdxf.entities import (
+    Dictionary,
+    DictionaryVar,
+    DictionaryWithDefault,
+    DXFTagStorage,
+    XRecord,
+    factory,
+)
+from ezdxf.lldxf.const import DXFTypeError
+from ezdxf.lldxf.tags import Tags
+from ezdxf.lldxf.types import DXFTag
+
+
+def add_nested_record(
+    doc, *, root_key="VENDOR", branch_key="SETTINGS", leaf_key="LEAF"
+):
+    root = doc.rootdict.add_new_dict(root_key, hard_owned=False)
+    branch = root.add_new_dict(branch_key, hard_owned=False)
+    record = branch.add_xrecord(leaf_key)
+    return root, branch, record
+
+
+def load_objects(source, objects, *, target=None, policy=xref.ConflictPolicy.KEEP):
+    if target is None:
+        target = ezdxf.new()
+    loader = xref.Loader(source, target, conflict_policy=policy)
+    loader.load_objects(objects)
+    loader.execute(xref_prefix="SRC")
+    return target
+
+
+def reload_document(doc, path: Path):
+    doc.saveas(path)
+    return ezdxf.readfile(path)
+
+
+def target_with_handle_offset():
+    target = ezdxf.new()
+    for index in range(4):
+        target.rootdict.add_xrecord(f"TARGET-FILLER-{index}")
+    return target
+
+
+def find_xrecord_with_value(doc, value):
+    for entity in doc.objects:
+        if isinstance(entity, XRecord) and DXFTag(1, value) in entity.tags:
+            return entity
+    return None
+
+
+def test_load_nested_named_object_and_preserve_source_key(tmp_path):
+    source = ezdxf.new()
+    _, branch, record = add_nested_record(source, leaf_key="ENTRY-42")
+    record.reset([(1, "payload")])
+
+    target = load_objects(source, [record])
+
+    copied_branch = target.rootdict["VENDOR"]["SETTINGS"]
+    copied = copied_branch["ENTRY-42"]
+    assert copied.tags == [(1, "payload")]
+    assert copied.dxf.owner == copied_branch.dxf.handle
+    assert copied is not record
+    assert record.doc is source
+    assert branch["ENTRY-42"] is record
+    assert not target.audit().has_errors
+
+    loaded = reload_document(target, tmp_path / "nested.dxf")
+    copied = loaded.rootdict["VENDOR"]["SETTINGS"]["ENTRY-42"]
+    assert copied.tags == [(1, "payload")]
+    assert not loaded.audit().has_errors
+
+
+def test_load_root_dictionary_entry():
