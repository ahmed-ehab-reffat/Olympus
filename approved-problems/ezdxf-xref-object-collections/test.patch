+def test_keep_leaf_conflict_redirects_pointer_to_existing_object():
+    source = ezdxf.new()
+    dictionary = source.rootdict.add_new_dict("VENDOR", hard_owned=False)
+    leaf = dictionary.add_xrecord("LEAF")
+    owned = source.objects.add_xrecord(owner=leaf.dxf.handle)
+    owned.reset([(1, "source-owned")])
+    leaf.reset([(1, "source"), (360, owned.dxf.handle)])
+    holder = dictionary.add_xrecord("HOLDER")
+    holder.reset([(340, leaf.dxf.handle)])
+
+    target = ezdxf.new()
+    target_dictionary = target.rootdict.add_new_dict("VENDOR", hard_owned=False)
+    existing = target_dictionary.add_xrecord("LEAF")
+    existing.reset([(1, "target")])
+
+    load_objects(source, [holder], target=target)
+
+    copied_holder = target_dictionary["HOLDER"]
+    assert target_dictionary["LEAF"] is existing
+    assert copied_holder.tags == [(340, existing.dxf.handle)]
+    assert find_xrecord_with_value(target, "source") is None
+    assert find_xrecord_with_value(target, "source-owned") is None
