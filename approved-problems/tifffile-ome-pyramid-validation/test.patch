+def test_valid_compression_strip_and_rectangular_tile_choices(
+    tmp_path: Path,
+) -> None:
+    """Accept independent valid tile, strip, and compression choices."""
+    imagecodecs = pytest.importorskip('imagecodecs')
+    required = ('PACKBITS', 'LZW', 'ZSTD')
+    if not all(
+        getattr(getattr(imagecodecs, name, None), 'available', False)
+        for name in required
+    ):
+        pytest.skip('requires PackBits, LZW, and ZSTD encoders')
+    path = tmp_path / 'storage-choices.ome.tif'
+    with TiffWriter(path, ome=True) as tif:
+        tif.write(
+            numpy.zeros((64, 64), numpy.uint8),
+            subifds=2,
+            tile=(16, 32),
+            compression='packbits',
+        )
+        tif.write(
+            numpy.zeros((32, 32), numpy.uint8),
+            subfiletype=1,
+            rowsperstrip=7,
+            compression='lzw',
+        )
+        tif.write(
+            numpy.zeros((16, 16), numpy.uint8),
+            subfiletype=1,
+            tile=(16, 32),
+            compression='zstd',
+        )
+
+    with TiffFile(path) as tif:
+        pages = [tif.pages.first, *tif.pages.first.pages]
+        assert pages[0].tilelength != pages[0].tilewidth
+        assert pages[1].rowsperstrip == 7
+        assert pages[1].rowsperstrip != pages[1].imagelength
+        assert pages[2].tilelength != pages[2].tilewidth
+        assert len({page.compression for page in pages}) == 3
+        assert tif.validate_ome_pyramid(strict=True) is True
+
