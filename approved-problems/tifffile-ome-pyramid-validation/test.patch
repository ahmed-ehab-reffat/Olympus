+#!/usr/bin/env bash
+# Run deterministic offline regression or OME pyramid validation tests.
+set -uo pipefail
+
+cd /app
+
+output_path="results.xml"
+if [ "${1:-}" = "--output_path" ]; then
+    output_path="$2"
+    shift 2
+fi
+mode="${1:-new}"
+
+mkdir -p "$(dirname "$output_path")"
+
+export SKIP_LARGE=1
+export SKIP_SLOW=1
+export SKIP_EXTENDED=1
+export SKIP_FILE=1
+export SKIP_VALIDATE=1
+export SKIP_HTTP=1
+
+case "$mode" in
+    base)
+        python -m pytest tests -q \
+            --ignore=tests/test_ome_pyramid_validation_a0d7bb.py \
+            --junitxml="$output_path"
+        ;;
+    new)
+        python -m pytest tests/test_ome_pyramid_validation_a0d7bb.py -q \
+            --junitxml="$output_path"
+        ;;
+    *)
+        echo "unknown mode: $mode (expected base or new)" >&2
+        exit 2
+        ;;
+esac
