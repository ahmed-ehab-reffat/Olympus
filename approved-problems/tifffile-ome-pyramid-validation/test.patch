+"""Tests for OME-TIFF pyramid storage validation."""
+
+from __future__ import annotations
+
+import inspect
+from pathlib import Path
+
+import numpy
+import pytest
+
+from tifffile import OmeXml, TiffFile, TiffPage, TiffWriter
+
+
+def write_pyramid(
+    path: Path,
+    shapes: list[tuple[int, int]],
+    *,
+    planes: int = 2,
+    flags: list[int] | None = None,
+    ome: bool = True,
+) -> None:
+    """Write a small deterministic OME pyramid."""
+    if flags is None:
+        flags = [1] * (len(shapes) - 1)
+    with TiffWriter(path, ome=ome) as tif:
+        base = numpy.zeros((planes, *shapes[0]), numpy.uint8)
+        tif.write(
+            base,
+            subifds=len(shapes) - 1,
+            metadata={'axes': 'CYX'},
+        )
+        for index, shape in enumerate(shapes[1:]):
+            tif.write(
+                numpy.zeros((planes, *shape), numpy.uint8),
+                subfiletype=flags[index],
+            )
+
+
+def multifile_ome_xml(
+    root: Path, companion: Path, active_uuid: str
+) -> str:
+    """Return OME-XML mapping one plane from each of two TIFF files."""
+    root_uuid = 'urn:uuid:11111111-1111-1111-1111-111111111111'
+    companion_uuid = 'urn:uuid:22222222-2222-2222-2222-222222222222'
+    return (
+        '<?xml version="1.0" encoding="UTF-8"?>'
+        '<OME xmlns="http://www.openmicroscopy.org/Schemas/OME/2016-06" '
+        f'UUID="{active_uuid}">'
+        '<Image ID="Image:0"><Pixels ID="Pixels:0" '
+        'DimensionOrder="XYCZT" Type="uint8" SizeX="64" SizeY="64" '
+        'SizeC="2" SizeZ="1" SizeT="1">'
+        '<Channel ID="Channel:0:0" SamplesPerPixel="1"/>'
+        '<Channel ID="Channel:0:1" SamplesPerPixel="1"/>'
+        '<TiffData IFD="0" FirstC="0" PlaneCount="1">'
+        f'<UUID FileName="{root.name}">{root_uuid}</UUID></TiffData>'
+        '<TiffData IFD="0" FirstC="1" PlaneCount="1">'
+        f'<UUID FileName="{companion.name}">{companion_uuid}</UUID>'
+        '</TiffData></Pixels></Image></OME>'
+    )
+
+
+def write_multifile_pyramid(tmp_path: Path, stem: str) -> tuple[Path, Path]:
+    """Write one two-plane OME pyramid across companion TIFF files."""
+    root = tmp_path / f'{stem}-root.ome.tif'
+    companion = tmp_path / f'{stem}-companion.ome.tif'
+    uuids = (
+        'urn:uuid:11111111-1111-1111-1111-111111111111',
+        'urn:uuid:22222222-2222-2222-2222-222222222222',
+    )
+    for path, active_uuid in zip((root, companion), uuids, strict=True):
+        with TiffWriter(path) as tif:
+            tif.write(
+                numpy.zeros((64, 64), numpy.uint8),
+                description=multifile_ome_xml(root, companion, active_uuid),
+                metadata=None,
+                subifds=2,
+            )
+            tif.write(numpy.zeros((32, 32), numpy.uint8), subfiletype=1)
+            tif.write(numpy.zeros((16, 16), numpy.uint8), subfiletype=1)
+    return root, companion
+
+
+def overwrite_subifd(
+    path: Path, page_index: int, level: int, offset: int
+) -> None:
+    """Overwrite one SubIFD offset."""
+    with TiffFile(path, mode='r+') as tif:
+        page = tif.pages[page_index].aspage()
+        offsets = list(page.subifds or ())
+        offsets[level] = offset
+        page.tags[330].overwrite(tuple(offsets))
+
+
+def test_validate_ome_pyramid_signature() -> None:
+    """Expose the documented keyword-only validation API."""
+    signature = inspect.signature(TiffFile.validate_ome_pyramid)
+    assert list(signature.parameters) == ['self', 'strict', 'assert_']
+    assert (
+        signature.parameters['strict'].kind is inspect.Parameter.KEYWORD_ONLY
+    )
+    assert signature.parameters['strict'].default is False
+    assert (
+        signature.parameters['assert_'].kind is inspect.Parameter.KEYWORD_ONLY
+    )
+    assert signature.parameters['assert_'].default is True
+
+
+def test_valid_pyramid_and_assertion_mode(tmp_path: Path) -> None:
+    """Return booleans or raise AssertionError according to assert_."""
+    valid = tmp_path / 'valid.ome.tif'
+    invalid = tmp_path / 'invalid.ome.tif'
+    write_pyramid(valid, [(64, 64), (32, 32), (16, 16)])
+    write_pyramid(invalid, [(64, 64), (16, 16), (32, 32)])
+
+    with TiffFile(valid) as tif:
+        assert tif.validate_ome_pyramid() is True
+        assert tif.validate_ome_pyramid(strict=True) is True
+    with TiffFile(invalid) as tif:
+        assert tif.validate_ome_pyramid(assert_=False) is False
+        with pytest.raises(AssertionError):
+            tif.validate_ome_pyramid()
+
+
+def test_non_ome_fails_and_flat_ome_succeeds(tmp_path: Path) -> None:
+    """Distinguish non-OME data from a valid OME image without a pyramid."""
+    non_ome = tmp_path / 'plain.tif'
+    flat_ome = tmp_path / 'flat.ome.tif'
+    with TiffWriter(non_ome) as tif:
+        tif.write(numpy.zeros((8, 8), numpy.uint8))
+    with TiffWriter(flat_ome, ome=True) as tif:
+        tif.write(numpy.zeros((8, 8), numpy.uint8))
+
+    with TiffFile(non_ome) as tif:
+        assert tif.validate_ome_pyramid(assert_=False) is False
+        with pytest.raises(AssertionError):
+            tif.validate_ome_pyramid()
+    with TiffFile(flat_ome) as tif:
+        assert tif.validate_ome_pyramid() is True
+        assert tif.validate_ome_pyramid(strict=True) is True
+
+
+@pytest.mark.parametrize('owner', ['root', 'companion'])
+def test_mapped_ome_plane_missing_from_primary_chain(
+    tmp_path: Path, owner: str
+) -> None:
+    """Require every OME plane mapping to resolve to a primary IFD."""
+    if owner == 'root':
+        path = tmp_path / 'missing-root-ifd.ome.tif'
+        with TiffWriter(path, ome=True) as tif:
+            tif.write(
+                numpy.zeros((2, 8, 8), numpy.uint8),
+                metadata={'axes': 'CYX'},
+            )
+        old = 'IFD="0" PlaneCount="2"'
+        new = 'IFD="1" PlaneCount="2"'
+    else:
+        path, companion = write_multifile_pyramid(
+            tmp_path, 'missing-companion-ifd'
+        )
+        with TiffFile(companion) as tif:
+            assert len(tif.pages) == 1
+        old = '<TiffData IFD="0" FirstC="1" PlaneCount="1">'
+        new = '<TiffData IFD="1" FirstC="1" PlaneCount="1">'
+
+    with TiffFile(path, mode='r+') as tif:
+        tag = tif.pages.first.tags[270]
+        assert old in tag.value
+        tag.overwrite(tag.value.replace(old, new))
+
+    with TiffFile(path) as tif:
+        assert [page is None for page in tif.series[0]] == [False, True]
+        assert tif.validate_ome_pyramid(assert_=False) is False
+        with pytest.raises(AssertionError):
+            tif.validate_ome_pyramid()
+
+
+def test_subifd_cannot_alias_primary_chain(tmp_path: Path) -> None:
+    """Reject a tag-330 child that is also a primary-chain IFD."""
+    path = tmp_path / 'primary-alias.ome.tif'
+    write_pyramid(path, [(64, 64), (32, 32), (16, 16)])
+    with TiffFile(path) as tif:
+        primary_offset = tif.pages[1].offset
+    overwrite_subifd(path, 0, 0, primary_offset)
+
+    with TiffFile(path) as tif:
+        assert tif.validate_ome_pyramid(assert_=False) is False
+
+
+def test_subifd_has_one_full_resolution_owner(tmp_path: Path) -> None:
+    """Reject one child offset referenced by two base planes."""
+    path = tmp_path / 'duplicate-owner.ome.tif'
+    write_pyramid(path, [(64, 64), (32, 32), (16, 16)])
+    with TiffFile(path) as tif:
+        child_offset = tif.pages[0].subifds[0]
+    overwrite_subifd(path, 1, 0, child_offset)
+
+    with TiffFile(path) as tif:
+        assert tif.validate_ome_pyramid(assert_=False) is False
+
+
+def test_every_subresolution_is_listed_in_tag_330(tmp_path: Path) -> None:
+    """Reject a reduced IFD reachable only through a child NextIFD link."""
+    path = tmp_path / 'subifd-chain.ome.tif'
+    with TiffWriter(path, ome=True) as tif:
+        tif.write(numpy.zeros((64, 64), numpy.uint8), subifds=-2)
+        tif.write(numpy.zeros((32, 32), numpy.uint8), subfiletype=1)
+        tif.write(numpy.zeros((16, 16), numpy.uint8), subfiletype=1)
+
+    with TiffFile(path) as tif:
+        assert len(tif.pages.first.subifds) == 1
+        assert tif.validate_ome_pyramid(assert_=False) is False
+
+
+def test_all_base_planes_have_corresponding_levels(tmp_path: Path) -> None:
+    """Reject base or child shape disagreements across OME planes."""
+    missing = tmp_path / 'missing-level.ome.tif'
+    mismatch = tmp_path / 'mismatched-level.ome.tif'
+    base_mismatch = tmp_path / 'mismatched-base.ome.tif'
+    write_pyramid(missing, [(64, 64), (32, 32), (16, 16)])
+    write_pyramid(mismatch, [(64, 64), (32, 32), (16, 16)])
+    with TiffWriter(base_mismatch, ome=True) as tif:
+        tif.write(
+            numpy.zeros((2, 8, 8), numpy.uint8),
+            metadata={'axes': 'CYX'},
+        )
+    overwrite_subifd(missing, 1, 0, 0)
+
+    with TiffFile(mismatch, mode='r+') as tif:
+        offset = tif.pages[1].subifds[0]
+        tif.filehandle.seek(offset)
+        child = TiffPage(tif, (1, 1))
+        child.tags[257].overwrite(31)
+
+    with TiffFile(base_mismatch, mode='r+') as tif:
+        tif.pages[1].tags[256].overwrite(7)
+
+    for path in (missing, mismatch, base_mismatch):
+        with TiffFile(path) as tif:
+            assert tif.validate_ome_pyramid(assert_=False) is False
+
+
+def test_each_plane_has_same_number_of_subresolution_levels(
+    tmp_path: Path,
+) -> None:
+    """Do not ignore extra tag-330 levels on a later base plane."""
+    path = tmp_path / 'unequal-level-count.ome.tif'
+    write_pyramid(path, [(64, 64), (32, 32), (16, 16)])
+    with TiffFile(path, mode='r+') as tif:
+        page = tif.pages[0].aspage()
+        assert page.subifds is not None
+        page.tags[330].overwrite((page.subifds[0],))
+
+    with TiffFile(path) as tif:
+        assert [len(page.subifds or ()) for page in tif.pages] == [1, 2]
+        assert tif.validate_ome_pyramid(assert_=False) is False
+
+
+def test_unreadable_subifd_uses_validation_result(tmp_path: Path) -> None:
+    """Normalize parser errors from a nonzero child offset beyond EOF."""
+    path = tmp_path / 'unreadable-subifd.ome.tif'
+    write_pyramid(path, [(64, 64), (32, 32), (16, 16)])
+    overwrite_subifd(path, 0, 0, path.stat().st_size + 1024)
+
+    with TiffFile(path) as tif:
+        assert tif.validate_ome_pyramid(assert_=False) is False
+        with pytest.raises(AssertionError):
+            tif.validate_ome_pyramid()
+
+
+@pytest.mark.parametrize(
+    'initially_closed', [True, False], ids=['closed', 'open']
+)
+def test_multifile_pyramid_uses_each_owning_file(
+    tmp_path: Path, initially_closed: bool
+) -> None:
+    """Validate topology and preserve each companion's handle state."""
+    root, companion_path = write_multifile_pyramid(
+        tmp_path, 'valid-multifile'
+    )
+    before = {path: path.read_bytes() for path in (root, companion_path)}
+
+    with TiffFile(root) as tif:
+        series = tif.series[0]
+        assert series.is_multifile
+        parents = {page.parent for page in series if page is not None}
+        assert len(parents) == 2
+        companion_tif = next(
+            parent for parent in parents if parent is not tif
+        )
+        offsets = {
+            page.parent.pages.first.subifds[0]
+            for page in series
+            if page is not None
+        }
+        assert len(offsets) == 1
+        assert companion_tif.filehandle.closed
+        if not initially_closed:
+            companion_tif.filehandle.open()
+        assert companion_tif.filehandle.closed is initially_closed
+        assert tif.validate_ome_pyramid(strict=True) is True
+        assert companion_tif.filehandle.closed is initially_closed
+    assert {path: path.read_bytes() for path in before} == before
+
+
+@pytest.mark.parametrize('failure', ['missing-child', 'shape-mismatch'])
+def test_multifile_secondary_topology_is_validated(
+    tmp_path: Path, failure: str
+) -> None:
+    """Reject topology errors found only in a companion TIFF."""
+    root, companion = write_multifile_pyramid(tmp_path, failure)
+    if failure == 'missing-child':
+        overwrite_subifd(companion, 0, 0, 0)
+    else:
+        with TiffFile(companion, mode='r+') as tif:
+            offset = tif.pages.first.subifds[0]
+            tif.filehandle.seek(offset)
+            child = TiffPage(tif, (0, 1))
+            child.tags[257].overwrite(31)
+
+    with TiffFile(root) as tif:
+        assert tif.series[0].is_multifile
+        assert tif.validate_ome_pyramid(assert_=False) is False
+        with pytest.raises(AssertionError):
+            tif.validate_ome_pyramid()
+
+
+@pytest.mark.parametrize(
+    'initially_closed', [True, False], ids=['closed', 'open']
+)
+@pytest.mark.parametrize(
+    'assert_mode', [False, True], ids=['return', 'raise']
+)
+def test_failed_multifile_validation_restores_companion_state(
+    tmp_path: Path, initially_closed: bool, assert_mode: bool
+) -> None:
+    """Restore companion state when validation returns or raises."""
+    root, companion = write_multifile_pyramid(
+        tmp_path, f'failed-{initially_closed}-{assert_mode}'
+    )
+    overwrite_subifd(companion, 0, 0, 0)
+
+    with TiffFile(root) as tif:
+        series = tif.series[0]
+        companion_tif = next(
+            page.parent
+            for page in series
+            if page is not None and page.parent is not tif
+        )
+        assert companion_tif.filehandle.closed
+        if not initially_closed:
+            companion_tif.filehandle.open()
+        assert companion_tif.filehandle.closed is initially_closed
+        if assert_mode:
+            with pytest.raises(AssertionError):
+                tif.validate_ome_pyramid()
+        else:
+            assert tif.validate_ome_pyramid(assert_=False) is False
+        assert companion_tif.filehandle.closed is initially_closed
+
+
+@pytest.mark.parametrize('assert_mode', [False, True], ids=['return', 'raise'])
+def test_unreopenable_companion_uses_validation_result(
+    tmp_path: Path, assert_mode: bool
+) -> None:
+    """Normalize I/O errors while reopening a mapped companion."""
+    root, companion = write_multifile_pyramid(
+        tmp_path, f'unreopenable-{assert_mode}'
+    )
+
+    with TiffFile(root) as tif:
+        series = tif.series[0]
+        companion_tif = next(
+            page.parent
+            for page in series
+            if page is not None and page.parent is not tif
+        )
+        assert companion_tif.filehandle.closed
+        hidden = companion.with_suffix('.unavailable')
+        companion.rename(hidden)
+
+        if assert_mode:
+            with pytest.raises(AssertionError):
+                tif.validate_ome_pyramid()
+        else:
+            assert tif.validate_ome_pyramid(assert_=False) is False
+        assert companion_tif.filehandle.closed
+
