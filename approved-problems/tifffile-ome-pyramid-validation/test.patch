+@pytest.mark.parametrize('difference', ['axes', 'size'])
+def test_every_child_preserves_strict_page_shape(
+    tmp_path: Path, difference: str
+) -> None:
+    """Apply strict axes and nonspatial-size checks to later children."""
+    path = tmp_path / f'late-page-shape-{difference}.ome.tif'
+    if difference == 'axes':
+        late_child = numpy.zeros((3, 16, 16), numpy.uint8)
+        late_options = {'photometric': 'rgb', 'planarconfig': 'separate'}
+    else:
+        late_child = numpy.zeros((16, 16, 4), numpy.uint8)
+        late_options = {'photometric': 'rgb'}
+
+    with TiffWriter(path, ome=True) as tif:
+        tif.write(
+            numpy.zeros((64, 64, 3), numpy.uint8),
+            photometric='rgb',
+            subifds=2,
+        )
+        tif.write(
+            numpy.zeros((32, 32, 3), numpy.uint8),
+            photometric='rgb',
+            subfiletype=1,
+        )
+        tif.write(late_child, subfiletype=1, **late_options)
+
+    with TiffFile(path) as tif:
+        base = tif.pages.first
+        children = list(base.pages)
+        base_shape = dict(zip(base.axes, base.shape))
+        first_shape = dict(zip(children[0].axes, children[0].shape))
+        assert children[0].axes == base.axes == 'YXS'
+        assert first_shape['S'] == base_shape['S'] == 3
+        if difference == 'axes':
+            late_shape = dict(zip(children[1].axes, children[1].shape))
+            assert children[1].axes == 'SYX'
+            assert late_shape['S'] == 3
+        else:
+            late_shape = dict(zip(children[1].axes, children[1].shape))
+            assert children[1].axes == 'YXS'
+            assert late_shape['S'] == 4
+        assert tif.validate_ome_pyramid() is True
+        assert tif.validate_ome_pyramid(strict=True, assert_=False) is False
+
