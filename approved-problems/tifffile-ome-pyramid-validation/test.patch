+def test_strict_accepts_reduced_mask_subfiletype(tmp_path: Path) -> None:
+    """Accept reduced-image children that also set the mask bit."""
+    path = tmp_path / 'reduced-mask.ome.tif'
+    with TiffWriter(path, ome=True) as tif:
+        tif.write(numpy.zeros((64, 64), bool), subifds=2)
+        tif.write(numpy.zeros((32, 32), bool), subfiletype=5)
+        tif.write(numpy.zeros((16, 16), bool), subfiletype=5)
+
+    with TiffFile(path) as tif:
+        children = list(tif.pages.first.pages)
+        assert [child.subfiletype for child in children] == [5, 5]
+        assert tif.validate_ome_pyramid(strict=True) is True
