+@pytest.mark.parametrize('difference', ['axes', 'size'])
+def test_nonspatial_page_shape_is_strict_only(
+    tmp_path: Path, difference: str
+) -> None:
+    """Check page axes and nonspatial sizes independently in strict mode."""
+    path = tmp_path / f'samples-{difference}.ome.tif'
+    if difference == 'axes':
+        child = numpy.zeros((3, 32, 32), numpy.uint8)
+        child_options = {'photometric': 'rgb', 'planarconfig': 'separate'}
+    else:
+        child = numpy.zeros((32, 32, 4), numpy.uint8)
+        child_options = {'photometric': 'rgb'}
+
+    with TiffWriter(path, ome=True) as tif:
+        tif.write(
+            numpy.zeros((64, 64, 3), numpy.uint8),
+            photometric='rgb',
+            subifds=1,
+        )
+        tif.write(
+            child,
+            subfiletype=1,
+            **child_options,
+        )
+
+    with TiffFile(path) as tif:
+        base = tif.pages[0]
+        assert base.subifds is not None
+        tif.filehandle.seek(base.subifds[0])
+        level = TiffPage(tif, (0, 1))
+        base_shape = dict(zip(base.axes, base.shape))
+        level_shape = dict(zip(level.axes, level.shape))
+        if difference == 'axes':
+            assert (base.axes, level.axes) == ('YXS', 'SYX')
+            assert base_shape['S'] == level_shape['S'] == 3
+        else:
+            assert base.axes == level.axes == 'YXS'
