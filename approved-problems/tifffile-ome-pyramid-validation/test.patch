+def test_reduced_image_flag_is_strict_only(tmp_path: Path) -> None:
+    """Apply reduced-image bitmask semantics only in strict mode."""
+    path = tmp_path / 'missing-reduced.ome.tif'
+    combined = tmp_path / 'combined-subfiletype.ome.tif'
+    write_pyramid(
+        path,
+        [(64, 64), (32, 32), (16, 16)],
+        flags=[0, 1],
+    )
+    write_pyramid(
+        combined,
+        [(64, 64), (32, 32), (16, 16)],
+        flags=[3, 3],
+    )
+    with TiffFile(path) as tif:
+        assert tif.validate_ome_pyramid() is True
+        assert tif.validate_ome_pyramid(strict=True, assert_=False) is False
+    with TiffFile(combined) as tif:
+        assert tif.validate_ome_pyramid(strict=True) is True
+
