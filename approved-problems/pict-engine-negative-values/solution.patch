+//
+// generation consumes and rewrites the state of every model in the hierarchy,
+// so it is captured before the first phase and put back between phases
+//
+void Task::saveState( Model* model )
+{
+    m_savedModels.push_back( { model, model->GetParameters(), model->GetExclusions(), model->GetRowSeeds() } );
+    for( auto & param : model->GetParameters() )
+    {
+        m_savedOrders.push_back( std::make_pair( param, param->GetOrder() ) );
+    }
+    for( auto & submodel : model->GetSubmodels() )
+    {
+        saveState( submodel );
+    }
+}
+
+//
+//
+//
+void Task::restoreState()
+{
+    for( auto & state : m_savedModels )
+    {
+        state.model->GetParameters() = state.parameters;
+        state.model->GetExclusions() = state.exclusions;
+        state.model->GetRowSeeds()   = state.rowSeeds;
+    }
+    for( auto & order : m_savedOrders )
+    {
+        order.first->SetOrder( order.second );
+    }
+    m_exclusions = m_savedExclusions;
+    m_rowSeeds   = m_savedRowSeeds;
+}
+
+//
+//
+//
+void Task::generateModel( Model* model, std::map<Model*, ResultCollection>* partnerRows )
+{
+    for( auto & submodel : model->GetSubmodels() )
+    {
+        generateModel( submodel, partnerRows );
+    }
+
+    model->Generate();
+
+    // a row of a submodel that carries a negative value can only be combined
+    // with rows of its siblings that carry none; guarantee those exist
+    if( nullptr != partnerRows && model != m_rootModel )
+    {
+        ResultCollection& results = model->GetResults();
+        std::set<ResultRow> present( results.begin(), results.end() );
+        for( auto & row : ( *partnerRows )[ model ] )
+        {
+            if( present.insert( row ).second )
+            {
+                results.push_back( row );
+            }
+        }
+    }
+}
+
+//
+//
+//
+void Task::generatePhase( ExclusionCollection& phaseExclusions,
+                          std::map<Model*, ResultCollection>* partnerRows )
+{
+    restoreState();
+    __insert( m_exclusions, phaseExclusions.begin(), phaseExclusions.end() );
+    PrepareForGeneration();
+    if( entireParameterExcluded() )
+    {
+        throw GenerationError( __FILE__, __LINE__, ErrorType::GenerationFailure );
+    }
+    SeedRandom( static_cast<unsigned int>( m_rootModel->GetRandomSeed() ) );
+    generateModel( m_rootModel, partnerRows );
+}
+
+//
+// after derivation an empty exclusion, or one value-sized exclusion per value
+// of some parameter, means no test case can be built at all
+//
+bool Task::entireParameterExcluded()
+{
+    std::map<Parameter*, int> excludedValues;
+    for( auto & exclusion : m_exclusions )
+    {
+        if( exclusion.empty() ) return( true );
+        if( 1 == exclusion.size() )
+        {
+            Parameter* param = exclusion.begin()->first;
+            if( ++excludedValues[ param ] >= param->GetValueCount() ) return( true );
+        }
+    }
+    return( false );
+}
+
+//
+//
+//
+bool Task::rowHasNegativeValue( const ResultRow& row )
+{
+    ParamCollection& params = m_rootModel->GetParameters();
+    for( size_t col = 0; col < row.size() && col < params.size(); ++col )
+    {
+        if( Parameter::UndefinedValue != row[ col ] && params[ col ]->IsNegative( static_cast<int>( row[ col ] ) ) )
+        {
+            return( true );
+        }
+    }
+    return( false );
+}
+
+//
+// positive test cases come from the hierarchy with negative values excluded,
+// negative ones from a second pass where no two negative values meet
+//
+void Task::Generate()
+{
+    m_savedModels.clear();
+    m_savedOrders.clear();
+    m_resultParameters.clear();
+    saveState( m_rootModel );
+    m_savedExclusions = m_exclusions;
+    m_savedRowSeeds   = m_rowSeeds;
+
+    ParamCollection params;
+    m_rootModel->GetAllParameters( params );
+    std::sort( params.begin(), params.end() );
+    params.erase( std::unique( params.begin(), params.end() ), params.end() );
+
+    ExclusionCollection positiveExclusions;
+    ExclusionCollection maskingExclusions;
+    for( size_t p1 = 0; p1 < params.size(); ++p1 )
+    {
+        for( int v1 = 0; v1 < params[ p1 ]->GetValueCount(); ++v1 )
+        {
+            if( !params[ p1 ]->IsNegative( v1 ) ) continue;
+
+            Exclusion single;
+            single.insert( std::make_pair( params[ p1 ], v1 ) );
+            positiveExclusions.insert( single );
+
+            for( size_t p2 = p1 + 1; p2 < params.size(); ++p2 )
+            {
+                for( int v2 = 0; v2 < params[ p2 ]->GetValueCount(); ++v2 )
+                {
+                    if( !params[ p2 ]->IsNegative( v2 ) ) continue;
+
+                    Exclusion pair;
+                    pair.insert( std::make_pair( params[ p1 ], v1 ) );
+                    pair.insert( std::make_pair( params[ p2 ], v2 ) );
+                    maskingExclusions.insert( pair );
+                }
+            }
+        }
+    }
+
+    try
+    {
+        generatePhase( positiveExclusions, nullptr );
+
+        if( !positiveExclusions.empty() )
+        {
+            ResultCollection positiveRows = m_rootModel->GetResults();
+            std::map<Model*, ResultCollection> partnerRows;
+            for( auto & state : m_savedModels )
+            {
+                partnerRows[ state.model ] = state.model->GetResults();
+            }
+
+            generatePhase( maskingExclusions, &partnerRows );
+
+            ResultCollection& results = m_rootModel->GetResults();
+            for( auto & row : results )
+            {
+                if( rowHasNegativeValue( row ) )
+                {
+                    positiveRows.push_back( row );
+                }
+            }
+            results = positiveRows;
+        }
+    }
+    catch( ... )
+    {
+        restoreState();
+        throw;
+    }
+
+    m_resultParameters = m_rootModel->GetParameters();
+    restoreState();
+}
