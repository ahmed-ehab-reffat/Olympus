+//
+// a parameter must keep at least one value that is not negative
+//
+bool Parameter::SetNegative( int n )
+{
+    if( n < 0 || n >= m_valueCount ) return( false );
+    if( IsNegative( n ) ) return( true );
+
+    int negativeCount = 0;
+    for( int value = 0; value < m_valueCount; ++value )
+    {
+        if( IsNegative( value ) ) ++negativeCount;
+    }
+    if( negativeCount + 1 >= m_valueCount ) return( false );
+
+    m_negativeValues.resize( m_valueCount, false );
+    m_negativeValues[ n ] = true;
+    return( true );
+}
+
+//
+//
+//
+bool Parameter::IsNegative( int n ) const
+{
+    return( 0 <= n && n < static_cast<int>( m_negativeValues.size() ) && m_negativeValues[ n ] );
+}
