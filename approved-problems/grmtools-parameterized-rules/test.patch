+use cfgrammar::{
+    Spanned, Symbol,
+    yacc::{YaccGrammar, YaccKind, YaccOriginalActionKind, ast::ASTWithValidityInfo},
+};
+
+fn grmtools(body: &str) -> Result<YaccGrammar<u32>, Vec<String>> {
+    let src = format!("%grmtools{{yacckind: Grmtools}}\n{}", body);
+    YaccGrammar::new(YaccKind::Grmtools, &src)
+        .map_err(|es| es.iter().map(|e| e.to_string()).collect())
+}
+
+fn original(body: &str) -> Result<YaccGrammar<u32>, Vec<String>> {
+    let src = format!("%grmtools{{yacckind: Original(NoAction)}}\n{}", body);
+    YaccGrammar::new(YaccKind::Original(YaccOriginalActionKind::NoAction), &src)
+        .map_err(|es| es.iter().map(|e| e.to_string()).collect())
+}
+
+fn ok(body: &str) -> YaccGrammar<u32> {
+    grmtools(body).unwrap()
+}
+
+fn rejected(body: &str) -> bool {
+    grmtools(body).is_err()
+}
+
+fn rules(g: &YaccGrammar<u32>) -> Vec<String> {
+    g.iter_rules()
+        .map(|r| g.rule_name_str(r).to_string())
+        .filter(|n| !n.starts_with('^'))
+        .collect()
+}
+
+fn types(g: &YaccGrammar<u32>) -> Vec<String> {
+    g.iter_rules()
+        .filter(|r| !g.rule_name_str(*r).starts_with('^'))
+        .map(|r| {
+            format!(
+                "{} -> {}",
+                g.rule_name_str(r),
+                g.actiontype(r).clone().unwrap_or_default()
+            )
+        })
+        .collect()
+}
+
+fn prods(g: &YaccGrammar<u32>, rule: &str) -> Vec<String> {
+    let ridx = g.rule_idx(rule).unwrap();
+    g.rule_to_prods(ridx)
+        .iter()
+        .map(|pidx| {
+            g.prod(*pidx)
+                .iter()
+                .map(|sym| match sym {
+                    Symbol::Rule(r) => g.rule_name_str(*r).to_string(),
+                    Symbol::Token(t) => format!("'{}'", g.token_name(*t).unwrap()),
+                })
+                .collect::<Vec<_>>()
+                .join(" ")
+        })
+        .collect()
+}
+
+fn actions(g: &YaccGrammar<u32>, rule: &str) -> Vec<String> {
+    let ridx = g.rule_idx(rule).unwrap();
+    g.rule_to_prods(ridx)
+        .iter()
+        .map(|pidx| g.action(*pidx).clone().unwrap_or_default())
+        .collect()
+}
+
+fn warnings(body: &str) -> Vec<String> {
+    let src = format!("%grmtools{{yacckind: Grmtools}}\n{}", body);
+    ASTWithValidityInfo::new(YaccKind::Grmtools, &src)
+        .ast()
+        .warnings()
+        .iter()
+        .map(|w| w.to_string())
+        .collect()
+}
+
+fn warned_names(body: &str) -> Vec<String> {
+    let src = format!("%grmtools{{yacckind: Grmtools}}\n{}", body);
+    let mut names = ASTWithValidityInfo::new(YaccKind::Grmtools, &src)
+        .ast()
+        .warnings()
+        .iter()
+        .map(|w| src[w.spans()[0].start()..w.spans()[0].end()].to_string())
+        .collect::<Vec<_>>();
+    names.sort();
+    names
+}
