+    assert_eq!(
+        error_span("%start S\n%%\nS -> u8: Group { 0 };\nGroup<T> -> u8: T { 0 };\n"),
+        "Group"
+    );
+    assert_eq!(
+        error_span("%start Group\n%%\nGroup<T> -> u8: T { 0 };\nE -> u8: 'i' { 1 };\n"),
+        "Group"
+    );
+}
+
+#[test]
+fn a_prec_parameter_error_points_at_the_call() {
+    assert_eq!(
+        error_span(
+            "%left '+'\n%start S\n%%\nS -> u8: Bin<E> { 0 };\nBin<Op> -> u8: 'i' Op 'i' %prec Op { 0 };\nE -> u8: '+' { 1 };\n"
+        ),
+        "Bin<E>"
+    );
+}
+
+#[test]
+fn the_instantiation_limit_error_points_at_the_call_that_exceeded_it() {
+    let mut body = String::from("%start S\n%%\nS -> u8:");
+    for i in 0..129 {
+        body.push_str(&format!(" G<E{}>", i));
+    }
+    body.push_str(" { 0 };\nG<T> -> u8: T { 0 };\n");
+    for i in 0..129 {
+        body.push_str(&format!("E{} -> u8: 'i' {{ 1 }};\n", i));
+    }
+    assert_eq!(error_span(&body), "G<E128>");
+}
+
+#[test]
+fn a_bad_call_in_a_directive_points_at_the_call() {
+    assert_eq!(
+        error_span("%start Nope<E>\n%%\nE -> u8: 'i' { 1 };\n"),
+        "Nope<E>"
+    );
+    assert_eq!(
+        error_span(
+            "%expect-unused Nope<E>\n%start S\n%%\nS -> u8: 'i' { 0 };\nE -> u8: 'j' { 1 };\n"
+        ),
+        "Nope<E>"
+    );
+}
+
+#[test]
+fn a_prec_naming_a_parameter_given_a_declared_token_takes_its_precedence() {
+    let g = ok(
+        "%token PLUS\n%token STAR\n%left PLUS\n%left STAR\n%start S\n%%\nS -> u8: Bin<PLUS> Bin<STAR> { 0 };\nBin<Op> -> u8: 'i' Op 'i' %prec Op { 0 };\n",
+    );
+    let plus = g.token_precedence(g.token_idx("PLUS").unwrap()).unwrap();
+    let star = g.token_precedence(g.token_idx("STAR").unwrap()).unwrap();
+    assert_ne!(plus, star);
+    let p1 = g.rule_to_prods(g.rule_idx("Bin<'PLUS'>").unwrap())[0];
+    let p2 = g.rule_to_prods(g.rule_idx("Bin<'STAR'>").unwrap())[0];
+    assert_eq!(g.prod_precedence(p1), Some(plus));
+    assert_eq!(g.prod_precedence(p2), Some(star));
+}
+
+#[test]
+fn a_nested_call_in_the_start_declaration_builds_inner_first() {
+    let g = ok(
+        "%start Outer<Inner<E>>\n%%\nOuter<T> -> Vec<T>: T { vec![] };\nInner<T> -> Option<T>: T { None };\nE -> u8: 'i' { 1 };\n",
+    );
+    assert_eq!(rules(&g), vec!["E", "Inner<E>", "Outer<Inner<E>>"]);
+    assert_eq!(prods(&g, "Outer<Inner<E>>"), vec!["Inner<E>"]);
+    assert_eq!(
+        types(&g).last().unwrap(),
+        "Outer<Inner<E>> -> Vec<Option<u8>>"
+    );
+}
+
+#[test]
+fn a_nested_call_in_expect_unused_builds_inner_first() {
+    let g = ok(
+        "%expect-unused Outer<Inner<E>>\n%start S\n%%\nS -> u8: E { 0 };\nOuter<T> -> Vec<T>: T { vec![] };\nInner<T> -> Option<T>: T { None };\nE -> u8: 'i' { 1 };\n",
+    );
+    assert_eq!(rules(&g), vec!["S", "E", "Inner<E>", "Outer<Inner<E>>"]);
+    assert_eq!(prods(&g, "Outer<Inner<E>>"), vec!["Inner<E>"]);
+}
+
+#[test]
+fn a_token_argument_whose_name_holds_a_quote_keeps_both_arguments() {
+    let g = ok(
+        "%start S\n%%\nS -> u8: Sep<\"a'b\",E> { 0 };\nSep<T,D> -> u8: T D { 0 };\nE -> u8: 'i' { 1 };\n",
+    );
+    let built = rules(&g)
+        .into_iter()
+        .filter(|n| n.contains('<'))
+        .collect::<Vec<_>>();
+    assert_eq!(built.len(), 1);
+    assert_eq!(prods(&g, &built[0]), vec!["'a'b' E"]);
+}
+
+#[test]
+fn a_token_argument_whose_name_holds_a_comma_or_bracket_keeps_both_arguments() {
+    let g = ok(
+        "%start S\n%%\nS -> u8: Sep<\",\",E> Sep<\"<\",E> { 0 };\nSep<T,D> -> u8: T D { 0 };\nE -> u8: 'i' { 1 };\n",
+    );
+    assert_eq!(prods(&g, "Sep<',',E>"), vec!["',' E"]);
+    assert_eq!(prods(&g, "Sep<'<',E>"), vec!["'<' E"]);
+}
+
+#[test]
+fn a_leading_comma_in_a_list_is_an_error() {
+    assert_eq!(rules(&ok(ONE)), vec!["S", "E", "Group<E>"]);
+    assert!(rejected(
+        "%start S\n%%\nS -> u8: Pair<,E> { 0 };\nPair<A,B> -> u8: A B { 0 };\nE -> u8: 'i' { 1 };\n"
+    ));
+    assert!(rejected(
+        "%start S\n%%\nS -> u8: Pair<E,F> { 0 };\nPair<,T> -> u8: T { 0 };\nE -> u8: 'i' { 1 };\nF -> u8: 'j' { 1 };\n"
+    ));
+}
+
+#[test]
+fn a_doubled_comma_in_a_list_is_an_error() {
+    assert_eq!(
+        prods(
+            &ok(
+                "%start S\n%%\nS -> u8: Pair<E,F> { 0 };\nPair<A,B> -> u8: A B { 0 };\nE -> u8: 'i' { 1 };\nF -> u8: 'j' { 1 };\n"
+            ),
+            "Pair<E,F>"
+        ),
+        vec!["E F"]
+    );
+    assert!(rejected(
+        "%start S\n%%\nS -> u8: Pair<E,,F> { 0 };\nPair<A,B> -> u8: A B { 0 };\nE -> u8: 'i' { 1 };\nF -> u8: 'j' { 1 };\n"
+    ));
+    assert!(rejected(
+        "%start S\n%%\nS -> u8: Pair<E,F> { 0 };\nPair<T,,U> -> u8: T U { 0 };\nE -> u8: 'i' { 1 };\nF -> u8: 'j' { 1 };\n"
+    ));
+}
+
+#[test]
+fn a_token_argument_holding_a_closing_bracket_does_not_end_the_list() {
+    let g = ok("%start S\n%%\nS -> u8: Wrap<\">\"> { 0 };\nWrap<T> -> u8: T { 0 };\n");
+    assert_eq!(rules(&g), vec!["S", "Wrap<'>'>"]);
+    assert_eq!(prods(&g, "Wrap<'>'>"), vec!["'>'"]);
+    let g = ok(
+        "%start S\n%%\nS -> u8: Sep<\">\",E> { 0 };\nSep<T,D> -> u8: T D { 0 };\nE -> u8: 'i' { 1 };\n",
+    );
+    assert_eq!(prods(&g, "Sep<'>',E>"), vec!["'>' E"]);
+}
+
+#[test]
+fn inferred_precedence_uses_the_last_token_not_the_last_symbol() {
+    let g = ok(
+        "%left '+'\n%left '*'\n%start S\n%%\nS -> u8: Bin<'*'> Bin<'+'> { 0 };\nBin<Op> -> u8: 'i' Op E { 0 };\nE -> u8: 'i' { 1 };\n",
+    );
+    let plus = g.token_precedence(g.token_idx("+").unwrap()).unwrap();
+    let star = g.token_precedence(g.token_idx("*").unwrap()).unwrap();
+    assert_ne!(plus, star);
+    let star_prod = g.rule_to_prods(g.rule_idx("Bin<'*'>").unwrap())[0];
+    let plus_prod = g.rule_to_prods(g.rule_idx("Bin<'+'>").unwrap())[0];
+    assert_eq!(prods(&g, "Bin<'*'>"), vec!["'i' '*' E"]);
+    assert_eq!(g.prod_precedence(star_prod), Some(star));
+    assert_eq!(g.prod_precedence(plus_prod), Some(plus));
+}
+
+#[test]
+fn a_bad_arity_call_in_a_directive_points_at_the_call() {
+    assert_eq!(
+        error_span("%start Pair<E>\n%%\nPair<A,B> -> u8: A B { 0 };\nE -> u8: 'i' { 1 };\n"),
+        "Pair<E>"
+    );
+    assert_eq!(
+        error_span(
+            "%expect-unused Pair<E>\n%start S\n%%\nS -> u8: 'i' { 0 };\nPair<A,B> -> u8: A B { 0 };\nE -> u8: 'j' { 1 };\n"
+        ),
+        "Pair<E>"
+    );
+}
+
+#[test]
+fn arguments_on_an_ordinary_rule_in_a_directive_point_at_the_call() {
+    assert_eq!(error_span("%start E<E>\n%%\nE -> u8: 'i' { 1 };\n"), "E<E>");
+    assert_eq!(
+        error_span("%expect-unused E<E>\n%start S\n%%\nS -> u8: 'i' { 0 };\nE -> u8: 'j' { 1 };\n"),
+        "E<E>"
+    );
+}
