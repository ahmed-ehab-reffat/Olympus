+fn error_span(body: &str) -> String {
+    let src = format!("%grmtools{{yacckind: Grmtools}}\n{}", body);
+    let info = ASTWithValidityInfo::new(YaccKind::Grmtools, &src);
+    let e = &info.errors()[0];
+    src[e.spans()[0].start()..e.spans()[0].end()].to_string()
+}
