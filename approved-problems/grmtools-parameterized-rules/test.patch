@@ -0,0 +1,105 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+NEW_TARGETS="cfgrammar:params_d799b2:cfgrammar/tests/params_d799b2.rs lrlex:params_parse_d799b2:lrlex/tests/params_parse_d799b2.rs"
+
+RAW="$(mktemp)"
+MISSING="$(mktemp)"
+trap 'rm -f "$RAW" "$MISSING"' EXIT
+
+if [ "$MODE" = "base" ]; then
+  cargo test --workspace --lib --bins -- --test-threads=1 >"$RAW" 2>&1
+  EXIT_CODE=$?
+else
+  EXIT_CODE=0
+  for target in $NEW_TARGETS; do
+    crate="${target%%:*}"
+    rest="${target#*:}"
+    name="${rest%%:*}"
+    file="${rest#*:}"
+    ONE="$(mktemp)"
+    cargo test -p "$crate" --test "$name" -- --test-threads=1 >"$ONE" 2>&1
+    if [ $? -ne 0 ]; then EXIT_CODE=1; fi
+    cat "$ONE" >>"$RAW"
+    if ! grep -qE '^test [a-z0-9_]+ \.\.\. (ok|FAILED|ignored)' "$ONE"; then
+      awk '/^#\[test\]/ { want = 1; next } want && /^fn / { sub(/^fn /, ""); sub(/\(.*$/, ""); print; want = 0 }' "$file" >>"$MISSING"
+      EXIT_CODE=1
+    fi
+    rm -f "$ONE"
+  done
+fi
+
+cat "$RAW"
+
+if [ -z "$OUTPUT_PATH" ]; then
+  exit $EXIT_CODE
+fi
+
+xml_escape() {
+  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+CASES="$(mktemp)"
+TOTAL=0
+FAILED=0
+while IFS= read -r line; do
+  case "$line" in
+    "test "*" ... ok"|"test "*" ... ignored"*)
+      name="${line#test }"
+      name="${name%% ... *}"
+      TOTAL=$((TOTAL + 1))
+      printf '<testcase name="%s" classname="grmtools"/>\n' "$(xml_escape "$name")" >>"$CASES"
+      ;;
+    "test "*" ... FAILED")
+      name="${line#test }"
+      name="${name%% ... *}"
+      TOTAL=$((TOTAL + 1))
+      FAILED=$((FAILED + 1))
+      printf '<testcase name="%s" classname="grmtools"><failure message="assertion failed">test failed</failure></testcase>\n' "$(xml_escape "$name")" >>"$CASES"
+      ;;
+  esac
+done <"$RAW"
+
+if [ "$MODE" = "new" ]; then
+  while IFS= read -r name; do
+    [ -n "$name" ] || continue
+    TOTAL=$((TOTAL + 1))
+    FAILED=$((FAILED + 1))
+    printf '<testcase name="%s" classname="grmtools"><failure message="build failed">the crate did not build</failure></testcase>\n' "$(xml_escape "$name")" >>"$CASES"
+  done <"$MISSING"
+  if [ "$TOTAL" -eq 0 ]; then
+    TOTAL=1
+    FAILED=1
+    EXIT_CODE=1
+    printf '<testcase name="parameterised_rules_build" classname="grmtools"><failure message="build failed">the crate did not build</failure></testcase>\n' >>"$CASES"
+  fi
+fi
+
+{
+  printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+  printf '<testsuites name="grmtools" tests="%s" failures="%s" errors="0" time="0">\n' "$TOTAL" "$FAILED"
+  printf '<testsuite name="grmtools" tests="%s" failures="%s" errors="0" time="0">\n' "$TOTAL" "$FAILED"
+  cat "$CASES"
+  printf '</testsuite>\n</testsuites>\n'
+} >"$OUTPUT_PATH"
+
+rm -f "$CASES"
+exit $EXIT_CODE
