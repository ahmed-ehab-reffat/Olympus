diff --git a/lrlex/tests/params_parse_d799b2.rs b/lrlex/tests/params_parse_d799b2.rs
new file mode 100644
index 0000000..bbebe81
--- /dev/null
+++ b/lrlex/tests/params_parse_d799b2.rs
@@ -0,0 +1,272 @@
+#![allow(deprecated)]
+
+use std::collections::HashMap;
+
+use cfgrammar::yacc::{YaccGrammar, YaccKind, YaccOriginalActionKind};
+use lrlex::{DefaultLexerTypes, LRNonStreamingLexerDef, LexerDef};
+use lrpar::{Lexeme, Node, RTParserBuilder};
+use lrtable::{Minimiser, from_yacc};
+
+const LEXER: &str =
+    "%%\n[0-9]+ 'INT'\n\\+ '+'\n\\* '*'\n, ','\n; ';'\n\\( '('\n\\) ')'\n[ \\t\\n]+ ;\n";
+
+fn build(grm_src: &str) -> YaccGrammar<u32> {
+    let src = format!(
+        "%grmtools{{yacckind: Original(GenericParseTree)}}\n%token INT\n{}",
+        grm_src
+    );
+    YaccGrammar::new(
+        YaccKind::Original(YaccOriginalActionKind::GenericParseTree),
+        &src,
+    )
+    .unwrap()
+}
+
+fn flatten(grm: &YaccGrammar<u32>, node: &Node<lrlex::DefaultLexeme<u32>, u32>, out: &mut String) {
+    match node {
+        Node::Term { lexeme } => {
+            out.push(' ');
+            out.push_str(grm.token_name(cfgrammar::TIdx(lexeme.tok_id())).unwrap());
+        }
+        Node::Nonterm { ridx, nodes } => {
+            out.push_str(" [");
+            out.push_str(grm.rule_name_str(*ridx));
+            for n in nodes {
+                flatten(grm, n, out);
+            }
+            out.push(']');
+        }
+    }
+}
+
+fn parse(grm_src: &str, input: &str) -> Result<String, String> {
+    let grm = build(grm_src);
+    let (_, stable) = from_yacc(&grm, Minimiser::Pager).map_err(|e| e.to_string())?;
+    let mut lexerdef = LRNonStreamingLexerDef::<DefaultLexerTypes<u32>>::from_str(LEXER).unwrap();
+    let rule_ids = grm
+        .tokens_map()
+        .iter()
+        .map(|(&n, &i)| (n, u32::from(i)))
+        .collect::<HashMap<&str, u32>>();
+    lexerdef.set_rule_ids(&rule_ids);
+    let lexer = lexerdef.lexer(input);
+    let (node, errs) = RTParserBuilder::new(&grm, &stable).parse_generictree(&lexer);
+    if !errs.is_empty() {
+        return Err(errs
+            .iter()
+            .map(|e| e.to_string())
+            .collect::<Vec<_>>()
+            .join("; "));
+    }
+    let mut out = String::new();
+    flatten(&grm, &node.unwrap(), &mut out);
+    Ok(out.trim().to_string())
+}
+
+fn conflicts(grm_src: &str) -> (usize, usize) {
+    let grm = build(grm_src);
+    match from_yacc(&grm, Minimiser::Pager) {
+        Ok((_, stable)) => match stable.conflicts() {
+            Some(c) => (c.sr_len(), c.rr_len()),
+            None => (0, 0),
+        },
+        Err(_) => (usize::MAX, usize::MAX),
+    }
+}
+
+const LIST: &str = "%start S\n%%\nS: List<INT>;\nList<T>: T | List<T> ',' T;\n";
+
+#[test]
+fn a_parameterised_list_parses_one_element() {
+    assert_eq!(parse(LIST, "1").unwrap(), "[S [List<'INT'> INT]]");
+}
+
+#[test]
+fn a_parameterised_list_parses_three_elements() {
+    assert_eq!(
+        parse(LIST, "1, 2, 3").unwrap(),
+        "[S [List<'INT'> [List<'INT'> [List<'INT'> INT] , INT] , INT]]"
+    );
+}
+
+#[test]
+fn the_instantiated_rule_names_the_arguments() {
+    let out = parse(LIST, "1").unwrap();
+    assert!(out.contains("List<'INT'>"));
+}
+
+#[test]
+fn two_instantiations_parse_independently() {
+    let grm = "%start S\n%%\nS: List<INT> ';' List<A>;\nList<T>: T | List<T> ',' T;\nA: '+';\n";
+    assert_eq!(
+        parse(grm, "1 ; + , +").unwrap(),
+        "[S [List<'INT'> INT] ; [List<A> [List<A> [A +]] , [A +]]]"
+    );
+}
+
+#[test]
+fn a_nested_instantiation_parses() {
+    let grm = "%start S\n%%\nS: List<Opt<INT>>;\nList<T>: T | List<T> ',' T;\nOpt<T>: | T;\n";
+    assert_eq!(
+        parse(grm, "1, 2").unwrap(),
+        "[S [List<Opt<'INT'>> [List<Opt<'INT'>> [Opt<'INT'> INT]] , [Opt<'INT'> INT]]]"
+    );
+}
+
+#[test]
+fn an_empty_instantiated_production_parses() {
+    let grm = "%start S\n%%\nS: Opt<INT> ';';\nOpt<T>: | T;\n";
+    assert_eq!(parse(grm, ";").unwrap(), "[S [Opt<'INT'>] ;]");
+}
+
+#[test]
+fn a_token_argument_parses() {
+    let grm = "%start S\n%%\nS: Sep<INT,','>;\nSep<T,D>: T | Sep<T,D> D T;\n";
+    assert_eq!(
+        parse(grm, "1, 2").unwrap(),
+        "[S [Sep<'INT',','> [Sep<'INT',','> INT] , INT]]"
+    );
+}
+
+#[test]
+fn a_different_token_argument_makes_a_different_language() {
+    let grm = "%start S\n%%\nS: Sep<INT,'+'>;\nSep<T,D>: T | Sep<T,D> D T;\n";
+    assert_eq!(
+        parse(grm, "1 + 2").unwrap(),
+        "[S [Sep<'INT','+'> [Sep<'INT','+'> INT] + INT]]"
+    );
+    assert!(parse(grm, "1 , 2").is_err());
+}
+
+#[test]
+fn a_call_in_the_start_declaration_parses() {
+    let grm = "%start List<INT>\n%%\nList<T>: T | List<T> ',' T;\n";
+    assert_eq!(
+        parse(grm, "1, 2").unwrap(),
+        "[List<'INT'> [List<'INT'> INT] , INT]"
+    );
+}
+
+#[test]
+fn a_parameterised_rule_used_twice_with_one_argument_is_one_language() {
+    let grm = "%start S\n%%\nS: List<INT> ';' List<INT>;\nList<T>: T | List<T> ',' T;\n";
+    assert_eq!(
+        parse(grm, "1 ; 2, 3").unwrap(),
+        "[S [List<'INT'> INT] ; [List<'INT'> [List<'INT'> INT] , INT]]"
+    );
+}
+
+#[test]
+fn a_conflict_free_parameterised_grammar_has_no_conflicts() {
+    assert_eq!(conflicts(LIST), (0, 0));
+}
+
+#[test]
+fn an_instantiation_can_introduce_a_conflict() {
+    let grm = "%start S\n%%\nS: Opt<INT> Opt<INT>;\nOpt<T>: | T;\n";
+    let (sr, rr) = conflicts(grm);
+    assert!(sr + rr > 0);
+}
+
+#[test]
+fn sharing_one_instantiation_does_not_duplicate_the_conflict_count() {
+    let one = "%start S\n%%\nS: Opt<INT> Opt<INT>;\nOpt<T>: | T;\n";
+    let two = "%start S\n%%\nS: Opt<INT> Opt<INT> ';' Opt<INT>;\nOpt<T>: | T;\n";
+    let (sr, rr) = conflicts(one);
+    assert!(sr > 0);
+    assert_eq!(conflicts(two), (sr, rr));
+    assert_eq!(
+        conflicts(
+            "%start S
+%%
+S: Opt<INT>;
+Opt<T>: | T;
+"
+        ),
+        (0, 0)
+    );
+}
+
+#[test]
+fn recursion_through_a_parameterised_rule_parses_deeply() {
+    assert_eq!(
+        parse(LIST, "1, 2, 3, 4, 5").unwrap().matches(',').count(),
+        4
+    );
+}
+
+#[test]
+fn an_unparameterised_grammar_still_parses() {
+    let grm = "%start S\n%%\nS: INT | S ',' INT;\n";
+    assert_eq!(parse(grm, "1, 2").unwrap(), "[S [S INT] , INT]");
+    assert_eq!(
+        parse(LIST, "1, 2").unwrap(),
+        "[S [List<'INT'> [List<'INT'> INT] , INT]]"
+    );
+}
+
+#[test]
+fn error_recovery_reports_repairs_inside_an_instantiation() {
+    let grm = "%start S\n%%\nS: List<INT>;\nList<T>: T | List<T> ',' T;\n";
+    let err = parse(grm, "1, , 2").unwrap_err();
+    assert!(err.contains("Parse error"));
+}
+
+#[test]
+fn a_parameterised_rule_can_wrap_a_bracketed_group() {
+    let grm = "%start S\n%%\nS: Paren<INT>;\nParen<T>: '(' T ')';\n";
+    assert_eq!(parse(grm, "(1)").unwrap(), "[S [Paren<'INT'> ( INT )]]");
+}
+
+#[test]
+fn nested_wrapping_parses() {
+    let grm = "%start S\n%%\nS: Paren<Paren<INT>>;\nParen<T>: '(' T ')';\n";
+    assert_eq!(
+        parse(grm, "((1))").unwrap(),
+        "[S [Paren<Paren<'INT'>> ( [Paren<'INT'> ( INT )] )]]"
+    );
+}
+
+#[test]
+fn a_parameter_forwarded_through_two_rules_parses() {
+    let grm = "%start S\n%%\nS: Outer<INT>;\nOuter<T>: Inner<T>;\nInner<T>: T;\n";
+    assert_eq!(
+        parse(grm, "1").unwrap(),
+        "[S [Outer<'INT'> [Inner<'INT'> INT]]]"
+    );
+}
+
+#[test]
+fn a_forwarded_token_argument_parses() {
+    let grm = "%start S\n%%\nS: Outer<','>;\nOuter<T>: Inner<T>;\nInner<T>: T;\n";
+    assert_eq!(parse(grm, ",").unwrap(), "[S [Outer<','> [Inner<','> ,]]]");
+}
+
+const PREC: &str =
+    "%left '+'\n%left '*'\n%start E\n%%\nE: Bin<'+'> | Bin<'*'> | INT;\nBin<Op>: E Op E;\n";
+
+#[test]
+fn each_instantiation_takes_the_precedence_of_its_own_token() {
+    assert_eq!(conflicts(PREC), (0, 0));
+    assert_eq!(
+        parse(PREC, "1 + 2 * 3").unwrap(),
+        "[E [Bin<'+'> [E INT] + [E [Bin<'*'> [E INT] * [E INT]]]]]"
+    );
+}
+
+#[test]
+fn the_same_grammar_without_precedence_declarations_is_ambiguous() {
+    let no_prec = "%start E\n%%\nE: Bin<'+'> | Bin<'*'> | INT;\nBin<Op>: E Op E;\n";
+    let (sr, _) = conflicts(no_prec);
+    assert!(sr > 0);
+}
+
+#[test]
+fn a_prec_naming_a_parameter_drives_the_parse() {
+    let grm = "%left '+'\n%left '*'\n%start E\n%%\nE: Bin<'+'> | Bin<'*'> | INT;\nBin<Op>: E Op E %prec Op;\n";
+    assert_eq!(conflicts(grm), (0, 0));
+    assert_eq!(
+        parse(grm, "1 + 2 * 3").unwrap(),
+        "[E [Bin<'+'> [E INT] + [E [Bin<'*'> [E INT] * [E INT]]]]]"
+    );
+}
