diff --git a/cfgrammar/src/lib/yacc/expand.rs b/cfgrammar/src/lib/yacc/expand.rs
new file mode 100644
index 0000000..a5b32fa
--- /dev/null
+++ b/cfgrammar/src/lib/yacc/expand.rs
@@ -0,0 +1,567 @@
+use std::collections::{HashMap, HashSet};
+
+use indexmap::IndexMap;
+
+use super::{
+    ast::{GrammarAST, Production, Rule, Symbol},
+    parser::{YaccGrammarError, YaccGrammarErrorKind},
+};
+use crate::Span;
+
+const INSTANTIATION_LIMIT: usize = 128;
+
+enum Call {
+    Name(String),
+    Apply(String, Vec<Call>),
+}
+
+impl Call {
+    fn render(&self) -> String {
+        match self {
+            Call::Name(n) => n.clone(),
+            Call::Apply(base, args) => {
+                let args = args.iter().map(Call::render).collect::<Vec<_>>();
+                format!("{}<{}>", base, args.join(","))
+            }
+        }
+    }
+
+    fn substitute(&self, subst: &HashMap<String, String>) -> Call {
+        match self {
+            Call::Name(n) => match subst.get(n) {
+                Some(replacement) => Call::Name(replacement.clone()),
+                None => Call::Name(n.clone()),
+            },
+            Call::Apply(base, args) => Call::Apply(
+                base.clone(),
+                args.iter().map(|arg| arg.substitute(subst)).collect(),
+            ),
+        }
+    }
+}
+
+fn parse_call(s: &str) -> Call {
+    match call_open(s) {
+        None => Call::Name(s.to_string()),
+        Some(open) => {
+            let base = s[..open].to_string();
+            let inner = &s[open + 1..s.len() - 1];
+            let mut args = Vec::new();
+            let mut depth = 0;
+            let mut quote = None;
+            let mut escaped = false;
+            let mut start = 0;
+            for (i, c) in inner.char_indices() {
+                if escaped {
+                    escaped = false;
+                    continue;
+                }
+                match quote {
+                    Some(q) => match c {
+                        '\\' => escaped = true,
+                        _ if c == q => quote = None,
+                        _ => (),
+                    },
+                    None => match c {
+                        '\'' | '"' => quote = Some(c),
+                        '<' => depth += 1,
+                        '>' => depth -= 1,
+                        ',' if depth == 0 => {
+                            args.push(parse_call(&inner[start..i]));
+                            start = i + 1;
+                        }
+                        _ => (),
+                    },
+                }
+            }
+            args.push(parse_call(&inner[start..]));
+            Call::Apply(base, args)
+        }
+    }
+}
+
+/// The offset of the `<` which opens a call's argument list, ignoring any `<` inside a quoted
+/// token name.
+fn call_open(s: &str) -> Option<usize> {
+    let mut quote = None;
+    let mut escaped = false;
+    for (i, c) in s.char_indices() {
+        if escaped {
+            escaped = false;
+            continue;
+        }
+        match quote {
+            Some(q) => match c {
+                '\\' => escaped = true,
+                _ if c == q => quote = None,
+                _ => (),
+            },
+            None => match c {
+                '\'' | '"' => quote = Some(c),
+                '<' => return Some(i),
+                _ => (),
+            },
+        }
+    }
+    None
+}
+
+fn is_call(s: &str) -> bool {
+    call_open(s).is_some()
+}
+
+/// Write a token's name so that it can be read back out of an instantiated rule's name.
+pub(super) fn escape_token(name: &str) -> String {
+    let mut out = String::with_capacity(name.len());
+    for c in name.chars() {
+        if c == '\\' || c == '\'' {
+            out.push('\\');
+        }
+        out.push(c);
+    }
+    out
+}
+
+/// The name of the token an argument refers to, or `None` if it refers to a rule.
+fn quoted_token(arg: &str) -> Option<String> {
+    let mut cs = arg.chars();
+    let first = cs.next()?;
+    if (first != '\'' && first != '"') || arg.len() < 2 || !arg.ends_with(first) {
+        return None;
+    }
+    let inner = &arg[1..arg.len() - 1];
+    let mut out = String::with_capacity(inner.len());
+    let mut escaped = false;
+    for c in inner.chars() {
+        if escaped {
+            out.push(c);
+            escaped = false;
+        } else if c == '\\' {
+            escaped = true;
+        } else {
+            out.push(c);
+        }
+    }
+    Some(out)
+}
+
+/// Does `src` contain `ident` as a whole identifier?
+fn mentions_ident(src: &str, ident: &str) -> bool {
+    let mut run = String::new();
+    for c in src.chars().chain(std::iter::once(' ')) {
+        if c.is_alphanumeric() || c == '_' {
+            run.push(c);
+        } else {
+            if run == ident {
+                return true;
+            }
+            run.clear();
+        }
+    }
+    false
+}
+
+/// Replace every whole-identifier occurrence of a key of `subst` in `src` with its value.
+fn substitute_idents(src: &str, subst: &HashMap<String, String>) -> String {
+    let mut out = String::with_capacity(src.len());
+    let mut ident = String::new();
+    let flush = |ident: &mut String, out: &mut String| {
+        if !ident.is_empty() {
+            match subst.get(ident.as_str()) {
+                Some(replacement) => out.push_str(replacement),
+                None => out.push_str(ident),
+            }
+            ident.clear();
+        }
+    };
+    for c in src.chars() {
+        if c.is_alphanumeric() || c == '_' {
+            ident.push(c);
+        } else {
+            flush(&mut ident, &mut out);
+            out.push(c);
+        }
+    }
+    flush(&mut ident, &mut out);
+    out
+}
+
+struct Template {
+    params: Vec<String>,
+    pidxs: Vec<usize>,
+    actiont: Option<String>,
+    name_span: Span,
+}
+
+struct Instantiated {
+    actiont: Option<String>,
+    prods: Vec<Production>,
+}
+
+struct Expander<'a> {
+    ast: &'a GrammarAST,
+    templates: HashMap<String, Template>,
+    done: IndexMap<String, usize>,
+    instantiated: Vec<Instantiated>,
+    used: HashSet<String>,
+}
+
+impl Expander<'_> {
+    fn actiont_of(&self, rule_name: &str) -> Option<String> {
+        if let Some(idx) = self.done.get(rule_name) {
+            return self.instantiated[*idx].actiont.clone();
+        }
+        self.ast
+            .rules
+            .get(rule_name)
+            .and_then(|r| r.actiont.clone())
+    }
+
+    fn known_rule(&self, rule_name: &str) -> bool {
+        self.done.contains_key(rule_name)
+            || self
+                .ast
+                .rules
+                .get(rule_name)
+                .is_some_and(|r| r.params.is_empty())
+    }
+
+    /// The token an argument stands for: either one written between quotes, or a name introduced
+    /// by a `%token` directive.
+    fn token_arg(&self, arg: &str) -> Option<String> {
+        if let Some(name) = quoted_token(arg) {
+            return Some(name);
+        }
+        self.ast
+            .tokens
+            .get_index_of(arg)
+            .filter(|idx| self.ast.token_directives.contains(idx))
+            .map(|_| arg.to_string())
+    }
+
+    fn symbol_for(&self, name: &str, span: Span) -> Symbol {
+        match self.token_arg(name) {
+            Some(tok) => Symbol::Token(tok, span),
+            None => Symbol::Rule(name.to_string(), span),
+        }
+    }
+
+    fn resolve(&mut self, call: &Call, span: Span) -> Result<String, YaccGrammarError> {
+        let (base, args) = match call {
+            Call::Name(n) => {
+                if self.ast.rules.get(n).is_some_and(|r| !r.params.is_empty()) {
+                    return Err(err(
+                        YaccGrammarErrorKind::MacroWithoutArguments(n.clone()),
+                        span,
+                    ));
+                }
+                return Ok(n.clone());
+            }
+            Call::Apply(base, args) => (base, args),
+        };
+        let mut arg_names = Vec::with_capacity(args.len());
+        for arg in args {
+            let resolved = self.resolve(arg, span)?;
+            arg_names.push(match self.token_arg(&resolved) {
+                Some(tok) => format!("'{}'", escape_token(&tok)),
+                None => resolved,
+            });
+        }
+        let name = Call::Apply(
+            base.clone(),
+            arg_names.iter().map(|n| Call::Name(n.clone())).collect(),
+        )
+        .render();
+        if self.done.contains_key(&name) {
+            return Ok(name);
+        }
+        let template = match self.templates.get(base) {
+            Some(t) => t,
+            None => {
+                if self.ast.rules.contains_key(base) {
+                    return Err(err(
+                        YaccGrammarErrorKind::UnexpectedMacroArguments(base.clone()),
+                        span,
+                    ));
+                }
+                return Err(err(
+                    YaccGrammarErrorKind::UnknownMacroRef(base.clone()),
+                    span,
+                ));
+            }
+        };
+        if template.params.len() != arg_names.len() {
+            return Err(err(
+                YaccGrammarErrorKind::MacroArityMismatch(
+                    base.clone(),
+                    template.params.len(),
+                    arg_names.len(),
+                ),
+                span,
+            ));
+        }
+        for arg in &arg_names {
+            if self.token_arg(arg).is_none() && !self.known_rule(arg) {
+                return Err(err(YaccGrammarErrorKind::UnknownRuleRef(arg.clone()), span));
+            }
+        }
+        if self.instantiated.len() >= INSTANTIATION_LIMIT {
+            return Err(err(YaccGrammarErrorKind::MacroExpansionLimit, span));
+        }
+        self.used.insert(base.clone());
+        let mut sym_subst = HashMap::new();
+        let mut type_subst = HashMap::new();
+        for (param, arg) in template.params.iter().zip(arg_names.iter()) {
+            sym_subst.insert(param.clone(), arg.clone());
+            let arg_type = match self.token_arg(arg) {
+                Some(_) => None,
+                None => self.actiont_of(arg),
+            };
+            match arg_type {
+                Some(t) => {
+                    type_subst.insert(param.clone(), t);
+                }
+                None => {
+                    if template
+                        .actiont
+                        .as_ref()
+                        .is_some_and(|t| mentions_ident(t, param))
+                    {
+                        return Err(err(
+                            YaccGrammarErrorKind::MacroTokenArgumentType(param.clone()),
+                            span,
+                        ));
+                    }
+                }
+            }
+        }
+        let actiont = template
+            .actiont
+            .as_ref()
+            .map(|t| substitute_idents(t, &type_subst));
+        let pidxs = template.pidxs.clone();
+        let slot = self.instantiated.len();
+        self.done.insert(name.clone(), slot);
+        self.instantiated.push(Instantiated {
+            actiont,
+            prods: Vec::new(),
+        });
+        let mut prods = Vec::with_capacity(pidxs.len());
+        for pidx in pidxs {
+            let template_prod = &self.ast.prods[pidx];
+            let mut symbols = Vec::with_capacity(template_prod.symbols.len());
+            for sym in template_prod.symbols.clone() {
+                match sym {
+                    Symbol::Rule(n, sym_span) => {
+                        let call = parse_call(&n).substitute(&sym_subst);
+                        let resolved = self.resolve(&call, sym_span)?;
+                        symbols.push(self.symbol_for(&resolved, sym_span));
+                    }
+                    Symbol::Token(n, sym_span) => symbols.push(Symbol::Token(n, sym_span)),
+                }
+            }
+            let precedence = match &template_prod.precedence {
+                Some(name) => match sym_subst.get(name) {
+                    Some(arg) => match self.token_arg(arg) {
+                        Some(tok) => Some(tok),
+                        None => {
+                            return Err(err(
+                                YaccGrammarErrorKind::MacroPrecArgumentNotAToken(name.clone()),
+                                span,
+                            ));
+                        }
+                    },
+                    None => Some(name.clone()),
+                },
+                None => None,
+            };
+            prods.push(Production {
+                symbols,
+                precedence,
+                action: template_prod.action.clone(),
+                prod_span: template_prod.prod_span,
+            });
+        }
+        self.instantiated[slot].prods = prods;
+        Ok(name)
+    }
+}
+
+fn err(kind: YaccGrammarErrorKind, span: Span) -> YaccGrammarError {
+    YaccGrammarError {
+        kind,
+        spans: vec![span],
+    }
+}
+
+/// Replace every call to a parameterised rule with a rule instantiated for those arguments, and
+/// remove the parameterised rules themselves from `ast`.
+pub(crate) fn expand_params(ast: &mut GrammarAST) -> Result<(), YaccGrammarError> {
+    let mut templates = HashMap::new();
+    for (name, rule) in &ast.rules {
+        if rule.params.is_empty() {
+            continue;
+        }
+        templates.insert(
+            name.clone(),
+            Template {
+                params: rule.params.iter().map(|(p, _)| p.clone()).collect(),
+                pidxs: rule.pidxs.clone(),
+                actiont: rule.actiont.clone(),
+                name_span: rule.name.1,
+            },
+        );
+    }
+    let start_call = ast.start.as_ref().is_some_and(|(n, _)| is_call(n));
+    let has_calls = ast.prods.iter().any(|p| {
+        p.symbols
+            .iter()
+            .any(|s| matches!(s, Symbol::Rule(n, _) if is_call(n)))
+    });
+    let expected_call = ast
+        .expect_unused
+        .iter()
+        .any(|s| matches!(s, Symbol::Rule(n, _) if is_call(n)));
+    if templates.is_empty() && !has_calls && !start_call && !expected_call {
+        return Ok(());
+    }
+    if let Some((start, span)) = &ast.start
+        && templates.contains_key(start)
+    {
+        return Err(err(
+            YaccGrammarErrorKind::MacroStartRule(start.clone()),
+            *span,
+        ));
+    }
+
+    let mut expander = Expander {
+        ast,
+        templates,
+        done: IndexMap::new(),
+        instantiated: Vec::new(),
+        used: HashSet::new(),
+    };
+    let mut new_start = None;
+    if let Some((start, span)) = &ast.start
+        && is_call(start)
+    {
+        new_start = Some((expander.resolve(&parse_call(start), *span)?, *span));
+    }
+    let mut rewrites: Vec<(usize, usize, String)> = Vec::new();
+    for rule in ast.rules.values() {
+        if !rule.params.is_empty() {
+            continue;
+        }
+        for &pidx in &rule.pidxs {
+            for (sidx, sym) in ast.prods[pidx].symbols.iter().enumerate() {
+                if let Symbol::Rule(n, span) = sym {
+                    let call = parse_call(n);
+                    let resolved = expander.resolve(&call, *span)?;
+                    if &resolved != n {
+                        rewrites.push((pidx, sidx, resolved));
+                    }
+                }
+            }
+        }
+    }
+
+    let mut expected_rewrites: Vec<(usize, String)> = Vec::new();
+    for (eidx, sym) in ast.expect_unused.iter().enumerate() {
+        if let Symbol::Rule(n, span) = sym
+            && is_call(n)
+        {
+            expected_rewrites.push((eidx, expander.resolve(&parse_call(n), *span)?));
+        }
+    }
+
+    let Expander {
+        templates,
+        done,
+        instantiated,
+        used,
+        ..
+    } = expander;
+
+    for (eidx, name) in expected_rewrites {
+        if let Symbol::Rule(n, _) = &mut ast.expect_unused[eidx] {
+            *n = name;
+        }
+    }
+
+    for (pidx, sidx, name) in rewrites {
+        if let Symbol::Rule(n, _) = &mut ast.prods[pidx].symbols[sidx] {
+            *n = name;
+        }
+    }
+    if let Some(start) = new_start {
+        ast.start = Some(start);
+    }
+
+    let mut expected_unused: HashSet<String> = HashSet::new();
+    ast.expect_unused.retain(|sym| match sym {
+        Symbol::Rule(n, _) if templates.contains_key(n) => {
+            expected_unused.insert(n.clone());
+            false
+        }
+        _ => true,
+    });
+    for (name, template) in &templates {
+        if !used.contains(name) && !expected_unused.contains(name) {
+            ast.uninstantiated_params.push(template.name_span);
+        }
+    }
+
+    let mut prods: Vec<Production> = Vec::with_capacity(ast.prods.len());
+    let mut rules: IndexMap<String, Rule> = IndexMap::with_capacity(ast.rules.len());
+    for (name, rule) in ast.rules.iter() {
+        if !rule.params.is_empty() {
+            continue;
+        }
+        let mut pidxs = Vec::with_capacity(rule.pidxs.len());
+        for &pidx in &rule.pidxs {
+            pidxs.push(prods.len());
+            prods.push(ast.prods[pidx].clone());
+        }
+        rules.insert(
+            name.clone(),
+            Rule {
+                name: rule.name.clone(),
+                pidxs,
+                actiont: rule.actiont.clone(),
+                params: Vec::new(),
+            },
+        );
+    }
+    for (name, slot) in &done {
+        let inst = &instantiated[*slot];
+        let mut pidxs = Vec::with_capacity(inst.prods.len());
+        for prod in &inst.prods {
+            pidxs.push(prods.len());
+            prods.push(prod.clone());
+        }
+        let span = ast
+            .rules
+            .get(base_of(name))
+            .map(|r| r.name.1)
+            .unwrap_or_else(|| Span::new(0, 0));
+        rules.insert(
+            name.clone(),
+            Rule {
+                name: (name.clone(), span),
+                pidxs,
+                actiont: inst.actiont.clone(),
+                params: Vec::new(),
+            },
+        );
+    }
+    ast.rules = rules;
+    ast.prods = prods;
+    Ok(())
+}
+
+fn base_of(name: &str) -> &str {
+    match name.find('<') {
+        Some(i) => &name[..i],
+        None => name,
+    }
+}
