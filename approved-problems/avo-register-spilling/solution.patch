@@ -0,0 +1,357 @@
+package pass
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+
+	"github.com/mmcloughlin/avo/ir"
+	"github.com/mmcloughlin/avo/operand"
+	"github.com/mmcloughlin/avo/reg"
+)
+
+// pressure reports that a kind of register ran out of physical registers
+// during allocation. Such a failure may be resolved by spilling.
+type pressure struct {
+	Kind reg.Kind
+	Err  error
+}
+
+func (p *pressure) Error() string {
+	return fmt.Sprintf("register kind %v: %s", p.Kind, p.Err)
+}
+
+func (p *pressure) Unwrap() error { return p.Err }
+
+// spiller rewrites a function so that selected virtual registers live in stack
+// slots, reloaded into short-lived temporaries around every reference.
+type spiller struct {
+	fn    *ir.Function
+	slots map[reg.ID]operand.Mem
+	pool  []*slot
+	next  map[reg.Kind]reg.Index
+	temps map[reg.ID]bool
+}
+
+// slot is one stack slot and the instructions over which the values held there
+// are live. A slot may serve several values as long as no two of them are live
+// at the same instruction.
+type slot struct {
+	mem  operand.Mem
+	size uint
+	live map[*ir.Instruction]bool
+}
+
+// newSpiller builds a spiller for the function. Virtual register indexes are
+// scanned so that temporaries introduced later cannot collide with them.
+func newSpiller(fn *ir.Function) *spiller {
+	s := &spiller{
+		fn:    fn,
+		slots: map[reg.ID]operand.Mem{},
+		next:  map[reg.Kind]reg.Index{},
+		temps: map[reg.ID]bool{},
+	}
+	for _, i := range fn.Instructions() {
+		for _, r := range i.Registers() {
+			v := reg.ToVirtual(r)
+			if v == nil {
+				continue
+			}
+			if idx := v.VirtualIndex(); idx >= s.next[v.Kind()] {
+				s.next[v.Kind()] = idx + 1
+			}
+		}
+	}
+	return s
+}
+
+// Spill moves one virtual register of the given kind out of registers and into
+// a stack slot. Reports whether a register was spilled.
+func (s *spiller) Spill(k reg.Kind) (bool, error) {
+	id, found := s.candidate(k)
+	if !found {
+		return false, nil
+	}
+
+	slot := s.slot(id)
+
+	var nodes []ir.Node
+	for _, node := range s.fn.Nodes {
+		i, ok := node.(*ir.Instruction)
+		if !ok {
+			nodes = append(nodes, node)
+			continue
+		}
+
+		before, after, err := s.rewrite(i, id, slot)
+		if err != nil {
+			return false, err
+		}
+
+		nodes = append(nodes, before...)
+		nodes = append(nodes, i)
+		nodes = append(nodes, after...)
+	}
+	s.fn.Nodes = nodes
+
+	return true, nil
+}
+
+// candidate selects the virtual register of the given kind with the longest
+// live range, preferring the lowest identifier on a tie for determinism.
+// Pinned registers, and the temporaries introduced by spilling, are never
+// candidates; excluding the latter guarantees that repeated spilling
+// terminates.
+func (s *spiller) candidate(k reg.Kind) (reg.ID, bool) {
+	pinned := map[reg.ID]bool{}
+	for _, p := range s.fn.Pinned {
+		pinned[p.Virtual.ID()] = true
+	}
+
+	live := map[reg.ID]int{}
+	for _, i := range s.fn.Instructions() {
+		for id := range i.LiveIn {
+			if id.IsVirtual() && id.Kind() == k && !s.temps[id] && !pinned[id] {
+				live[id]++
+			}
+		}
+	}
+
+	best, n := reg.ID(0), 0
+	for id, l := range live {
+		if _, spilled := s.slots[id]; spilled {
+			continue
+		}
+		if l > n || (l == n && id < best) {
+			best, n = id, l
+		}
+	}
+
+	return best, n > 0
+}
+
+// slot returns the stack slot assigned to the given virtual register. A slot
+// already holding values that are dead wherever this one is live is reused, so
+// the frame grows with the number of values spilled at once rather than with
+// the number spilled overall. Otherwise a slot is added, sized to the widest
+// reference to the register and placed on a multiple of its own size, which
+// keeps it clear of whatever the function has already allocated and leaves the
+// frame a whole number of slots.
+func (s *spiller) slot(id reg.ID) operand.Mem {
+	if m, found := s.slots[id]; found {
+		return m
+	}
+
+	size := uint(8)
+	for _, i := range s.fn.Instructions() {
+		for _, r := range i.Registers() {
+			if r.ID() == id && r.Size() > size {
+				size = r.Size()
+			}
+		}
+	}
+
+	live := s.liveRange(id)
+
+	for _, p := range s.pool {
+		if p.size != size || p.overlaps(live) {
+			continue
+		}
+		for i := range live {
+			p.live[i] = true
+		}
+		s.slots[id] = p.mem
+		return p.mem
+	}
+
+	if pad := s.fn.LocalSize % int(size); pad != 0 {
+		s.fn.AllocLocal(int(size) - pad)
+	}
+
+	p := &slot{mem: s.fn.AllocLocal(int(size)), size: size, live: live}
+	s.pool = append(s.pool, p)
+	s.slots[id] = p.mem
+
+	return p.mem
+}
+
+// liveRange collects the instructions where the given register is live, which
+// is what decides whether two values can share a slot.
+func (s *spiller) liveRange(id reg.ID) map[*ir.Instruction]bool {
+	live := map[*ir.Instruction]bool{}
+	for _, i := range s.fn.Instructions() {
+		if _, in := i.LiveIn[id]; in {
+			live[i] = true
+			continue
+		}
+		if _, out := i.LiveOut[id]; out {
+			live[i] = true
+			continue
+		}
+		for _, r := range i.Registers() {
+			if r.ID() == id {
+				live[i] = true
+				break
+			}
+		}
+	}
+	return live
+}
+
+// overlaps reports whether any value already in the slot is live where the
+// given value is.
+func (p *slot) overlaps(live map[*ir.Instruction]bool) bool {
+	for i := range live {
+		if p.live[i] {
+			return true
+		}
+	}
+	return false
+}
+
+// rewrite replaces references to the spilled register in the instruction with a
+// fresh temporary, returning the reload and store instructions that must be
+// placed before and after it.
+func (s *spiller) rewrite(i *ir.Instruction, id reg.ID, slot operand.Mem) (before, after []ir.Node, err error) {
+	reads := specs(i.InputRegisters(), id)
+	writes := specs(i.OutputRegisters(), id)
+	if len(reads) == 0 && len(writes) == 0 {
+		return nil, nil, nil
+	}
+
+	idx := s.next[id.Kind()]
+	s.next[id.Kind()]++
+	s.temps[reg.NewVirtual(idx, id.Kind(), reg.S64).ID()] = true
+
+	for _, spec := range reads {
+		t := reg.NewVirtual(idx, id.Kind(), spec)
+		mov, err := move(at(slot, spec), t, spec)
+		if err != nil {
+			return nil, nil, err
+		}
+		before = append(before, mov)
+	}
+
+	for _, spec := range writes {
+		t := reg.NewVirtual(idx, id.Kind(), spec)
+		mov, err := move(t, at(slot, spec), spec)
+		if err != nil {
+			return nil, nil, err
+		}
+		after = append(after, mov)
+	}
+
+	replace(i.Operands, id, idx)
+	replace(i.Inputs, id, idx)
+	replace(i.Outputs, id, idx)
+
+	return before, after, nil
+}
+
+// specs returns the distinct widths at which the given register appears in the
+// register list, in ascending order.
+func specs(rs []reg.Register, id reg.ID) []reg.Spec {
+	seen := map[reg.Spec]bool{}
+	for _, r := range rs {
+		if r.ID() == id {
+			seen[reg.Spec(r.Mask())] = true
+		}
+	}
+
+	var ss []reg.Spec
+	for spec := range seen {
+		ss = append(ss, spec)
+	}
+	sort.Slice(ss, func(a, b int) bool { return ss[a] < ss[b] })
+
+	return ss
+}
+
+// replace substitutes references to the given register in the operand list with
+// the temporary of the given index, preserving the width of each reference.
+func replace(ops []operand.Op, id reg.ID, idx reg.Index) {
+	for n, op := range ops {
+		switch op := op.(type) {
+		case reg.Register:
+			ops[n] = substitute(op, id, idx)
+		case operand.Mem:
+			op.Base = substitute(op.Base, id, idx)
+			op.Index = substitute(op.Index, id, idx)
+			ops[n] = op
+		}
+	}
+}
+
+func substitute(r reg.Register, id reg.ID, idx reg.Index) reg.Register {
+	if r == nil || r.ID() != id {
+		return r
+	}
+	return reg.NewVirtual(idx, id.Kind(), reg.Spec(r.Mask()))
+}
+
+// at returns the part of the stack slot occupied by a register of the given
+// width. High-byte registers live in the second byte of their slot.
+func at(slot operand.Mem, spec reg.Spec) operand.Mem {
+	if spec == reg.S8H {
+		return slot.Offset(1)
+	}
+	return slot
+}
+
+// move builds an instruction copying between a stack slot and a register of the
+// given width. Unaligned forms are used so that spill slots need no alignment.
+func move(src, dst operand.Op, spec reg.Spec) (*ir.Instruction, error) {
+	var opcode string
+	var isa []string
+
+	switch kindOf(src, dst) {
+	case reg.KindGP:
+		switch spec.Size() {
+		case 1:
+			opcode = "MOVB"
+		case 2:
+			opcode = "MOVW"
+		case 4:
+			opcode = "MOVL"
+		case 8:
+			opcode = "MOVQ"
+		}
+	case reg.KindVector:
+		switch spec.Size() {
+		case 16:
+			opcode = "MOVOU"
+			isa = []string{"SSE2"}
+		case 32:
+			opcode = "VMOVDQU"
+			isa = []string{"AVX"}
+		case 64:
+			opcode = "VMOVDQU64"
+			isa = []string{"AVX512F"}
+		}
+	case reg.KindOpmask:
+		opcode = "KMOVQ"
+		isa = []string{"AVX512BW"}
+	}
+
+	if opcode == "" {
+		return nil, errors.New("no spill instruction for register")
+	}
+
+	return &ir.Instruction{
+		Opcode:   opcode,
+		Operands: []operand.Op{src, dst},
+		Inputs:   []operand.Op{src},
+		Outputs:  []operand.Op{dst},
+		ISA:      isa,
+	}, nil
+}
+
+// kindOf returns the register kind involved in a spill move.
+func kindOf(ops ...operand.Op) reg.Kind {
+	for _, op := range ops {
+		if r, ok := op.(reg.Register); ok {
+			return r.Kind()
+		}
+	}
+	return reg.Kind(0)
+}
