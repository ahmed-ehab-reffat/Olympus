diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..800c6c9
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      shift
+      ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="/tmp/report.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+export GOFLAGS="-mod=mod -buildvcs=false"
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+mkdir -p "$GOCACHE"
+export PATH="$PATH:$(go env GOPATH)/bin"
+
+NEW_PKG="github.com/mmcloughlin/avo/tests/spill5f34af"
+TEST_FILE="tests/spill5f34af/spill5f34af_test.go"
+
+# Packages whose tests skip themselves depending on the host: md5x16 and
+# zeroing require AVX-512, internal/github and thirdparty require network
+# access. None of them is deterministic here, so base mode leaves them out.
+if [ "$MODE" = "new" ]; then
+  PACKAGES="$NEW_PKG"
+else
+  PACKAGES="$(go list ./... \
+    | grep -vxF -e "$NEW_PKG" \
+      -e "github.com/mmcloughlin/avo/examples/md5x16" \
+      -e "github.com/mmcloughlin/avo/tests/alloc/zeroing" \
+      -e "github.com/mmcloughlin/avo/internal/github" \
+      -e "github.com/mmcloughlin/avo/tests/thirdparty")"
+fi
+
+LOG="$(mktemp)"
+# shellcheck disable=SC2086
+go test -count=1 -v $PACKAGES >"$LOG" 2>&1
+STATUS=$?
+
+if command -v go-junit-report >/dev/null 2>&1; then
+  go-junit-report -set-exit-code <"$LOG" >"$OUTPUT_PATH" 2>/dev/null
+fi
+
+# A report without per-test nodes means either the package did not build, so no
+# test ran, or the report tool is unavailable. Write the nodes directly in that
+# case, following the go test exit status rather than overriding it.
+if ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  if [ "$MODE" = "new" ]; then
+    SUITE="$NEW_PKG"
+    NAMES="$(grep -oE '^func (Test[A-Za-z0-9_]+)\(' "$TEST_FILE" 2>/dev/null | sed -E 's/^func (Test[A-Za-z0-9_]+)\(/\1/')"
+  else
+    SUITE="base"
+    NAMES="base suite"
+  fi
+  COUNT="$(printf '%s\n' "$NAMES" | grep -c .)"
+  REASON="$(tail -c 4000 "$LOG")"
+  if [ "$STATUS" -eq 0 ]; then
+    FAILURES=0
+  else
+    FAILURES="$COUNT"
+  fi
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo "<testsuites><testsuite name=\"$SUITE\" tests=\"$COUNT\" failures=\"$FAILURES\">"
+    printf '%s\n' "$NAMES" | while IFS= read -r n; do
+      [ -z "$n" ] && continue
+      if [ "$STATUS" -eq 0 ]; then
+        echo "  <testcase classname=\"$SUITE\" name=\"$n\"></testcase>"
+      else
+        echo "  <testcase classname=\"$SUITE\" name=\"$n\"><failure message=\"test run failed\"><![CDATA[${REASON}]]></failure></testcase>"
+      fi
+    done
+    echo '</testsuite></testsuites>'
+  } >"$OUTPUT_PATH"
+fi
+
+cat "$LOG"
+exit $STATUS
diff --git a/tests/spill5f34af/ctxgen5f34af.go b/tests/spill5f34af/ctxgen5f34af.go
new file mode 100644
index 0000000..9637010
--- /dev/null
+++ b/tests/spill5f34af/ctxgen5f34af.go
@@ -0,0 +1,215 @@
+//go:build ignore
+
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+
+	"github.com/mmcloughlin/avo/build"
+	"github.com/mmcloughlin/avo/operand"
+	"github.com/mmcloughlin/avo/reg"
+)
+
+// scenarios maps the name of a generated function to its builder. Every one of
+// them drives a build.Context directly rather than the package level helpers.
+var scenarios = map[string]func(*build.Context){
+	"CtxControls":   ctxControls,
+	"CtxLate":       ctxLate,
+	"CtxPinnedBase": ctxPinnedBase,
+	"CtxRestricted": ctxRestricted,
+	"CtxPseudo":     ctxPseudo,
+	"CtxConflict":   ctxConflict,
+	"CtxRepin":      ctxRepin,
+}
+
+func main() {
+	name := os.Getenv("SCENARIO")
+	scenario, found := scenarios[name]
+	if !found {
+		fmt.Fprintf(os.Stderr, "unknown scenario %q\n", name)
+		os.Exit(1)
+	}
+
+	fs := flag.NewFlagSet("ctxgen", flag.ExitOnError)
+	flags := build.NewFlags(fs)
+	if err := fs.Parse(os.Args[1:]); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+
+	ctx := build.NewContext()
+	scenario(ctx)
+
+	os.Exit(build.Main(flags.Config(), ctx))
+}
+
+// ctxControls reserves and pins through the context methods.
+func ctxControls(ctx *build.Context) {
+	ctx.Function("CtxControls")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+	ctx.Reserve(reg.RBX, reg.R12)
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+
+	keep := ctx.GP64()
+	ctx.Pin(keep, reg.R14)
+	ctx.MOVQ(x, keep)
+	ctx.ADDQ(operand.U32(5), keep)
+
+	const n = 22
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = ctx.GP64()
+		ctx.MOVQ(x, vs[i])
+		ctx.ADDQ(operand.U32(uint32(i+1)), vs[i])
+	}
+
+	acc := ctx.GP64()
+	ctx.XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ctx.ADDQ(vs[i], acc)
+	}
+	ctx.ADDQ(keep, acc)
+
+	ctx.Store(acc, ctx.ReturnIndex(0))
+	ctx.RET()
+}
+
+// ctxLate records both controls after the instructions they govern.
+func ctxLate(ctx *build.Context) {
+	ctx.Function("CtxLate")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+
+	keep := ctx.GP64()
+	ctx.MOVQ(x, keep)
+	ctx.ADDQ(operand.U32(6), keep)
+
+	const n = 22
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = ctx.GP64()
+		ctx.MOVQ(x, vs[i])
+		ctx.ADDQ(operand.U32(uint32(i+1)), vs[i])
+	}
+
+	acc := ctx.GP64()
+	ctx.XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ctx.ADDQ(vs[i], acc)
+	}
+	ctx.ADDQ(keep, acc)
+
+	ctx.Store(acc, ctx.ReturnIndex(0))
+	ctx.RET()
+
+	ctx.Reserve(reg.RBX, reg.R12)
+	ctx.Pin(keep, reg.R14)
+}
+
+// ctxPinnedBase pins a value to the base pointer, which the allocator may
+// assign but the function must still leave callee saved.
+func ctxPinnedBase(ctx *build.Context) {
+	ctx.Function("CtxPinnedBase")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+
+	keep := ctx.GP64()
+	ctx.Pin(keep, reg.RBP)
+	ctx.MOVQ(x, keep)
+	ctx.ADDQ(operand.U32(4), keep)
+
+	const n = 24
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = ctx.GP64()
+		ctx.MOVQ(x, vs[i])
+		ctx.ADDQ(operand.U32(uint32(i+1)), vs[i])
+	}
+
+	acc := ctx.GP64()
+	ctx.XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ctx.ADDQ(vs[i], acc)
+	}
+	ctx.ADDQ(keep, acc)
+
+	ctx.Store(acc, ctx.ReturnIndex(0))
+	ctx.RET()
+}
+
+// ctxRestricted pins to a register the allocator never assigns.
+func ctxRestricted(ctx *build.Context) {
+	ctx.Function("CtxRestricted")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+	a := ctx.GP64()
+	ctx.Pin(a, reg.RSP)
+	ctx.MOVQ(x, a)
+
+	ctx.Store(a, ctx.ReturnIndex(0))
+	ctx.RET()
+}
+
+// ctxPseudo reserves a pseudo register.
+func ctxPseudo(ctx *build.Context) {
+	ctx.Function("CtxPseudo")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+	ctx.Reserve(reg.StackPointer)
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+	a := ctx.GP64()
+	ctx.MOVQ(x, a)
+	ctx.ADDQ(operand.U32(1), a)
+
+	ctx.Store(a, ctx.ReturnIndex(0))
+	ctx.RET()
+}
+
+// ctxConflict pins two values that are live together to one register.
+func ctxConflict(ctx *build.Context) {
+	ctx.Function("CtxConflict")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+
+	a := ctx.GP64()
+	ctx.Pin(a, reg.R14)
+	ctx.MOVQ(x, a)
+
+	b := ctx.GP64()
+	ctx.Pin(b, reg.R14)
+	ctx.MOVQ(operand.U32(3), b)
+
+	ctx.ADDQ(a, b)
+	ctx.Store(b, ctx.ReturnIndex(0))
+	ctx.RET()
+}
+
+// ctxRepin pins one value to a second register.
+func ctxRepin(ctx *build.Context) {
+	ctx.Function("CtxRepin")
+	ctx.Attributes(build.NOSPLIT)
+	ctx.SignatureExpr("func(x uint64) uint64")
+
+	x := ctx.Load(ctx.Param("x"), ctx.GP64())
+
+	a := ctx.GP64()
+	ctx.Pin(a, reg.R14)
+	ctx.Pin(a, reg.R13)
+	ctx.MOVQ(x, a)
+
+	ctx.Store(a, ctx.ReturnIndex(0))
+	ctx.RET()
+}
diff --git a/tests/spill5f34af/pingen5f34af.go b/tests/spill5f34af/pingen5f34af.go
new file mode 100644
index 0000000..e1ddf4b
--- /dev/null
+++ b/tests/spill5f34af/pingen5f34af.go
@@ -0,0 +1,944 @@
+//go:build ignore
+
+package main
+
+import (
+	"fmt"
+	"os"
+
+	. "github.com/mmcloughlin/avo/build"
+	. "github.com/mmcloughlin/avo/operand"
+	"github.com/mmcloughlin/avo/reg"
+)
+
+// scenarios maps the name of a generated function to its builder. The
+// SCENARIO environment variable selects which one to generate.
+var scenarios = map[string]func(){
+	"Pinned":               pinned,
+	"PinnedVector":         pinnedVector,
+	"PinConflict":          pinConflict,
+	"PinnedAlias":          pinnedAlias,
+	"PinAcrossKinds":       pinAcrossKinds,
+	"PinReused":            pinReused,
+	"PinnedYMM":            pinnedYMM,
+	"PinnedZMM":            pinnedZMM,
+	"OpmaskControls":       opmaskControls,
+	"Scope":                scope,
+	"PinAliasGP":           pinAliasGP,
+	"PinAliasVector":       pinAliasVector,
+	"PinnedControl":        pinnedControl,
+	"PinAliasDisjoint":     pinAliasDisjoint,
+	"PinToPseudo":          pinToPseudo,
+	"PinToRestricted":      pinToRestricted,
+	"PinNoHighByte":        pinNoHighByte,
+	"PinNarrowForm":        pinNarrowForm,
+	"PinRepeatAlias":       pinRepeatAlias,
+	"PinnedMemBase":        pinnedMemBase,
+	"PinnedHighByte":       pinnedHighByte,
+	"PinnedVersusExplicit": pinnedVersusExplicit,
+	"PinnedByteDisjoint":   pinnedByteDisjoint,
+	"PinnedByteOverlap":    pinnedByteOverlap,
+	"PinnedExclusive":      pinnedExclusive,
+	"LateGlobal":           lateGlobal,
+	"PinBranchApart":       pinBranchApart,
+	"PinBranchJoin":        pinBranchJoin,
+	"ScopeInvalid":         scopeInvalid,
+	"PinAliasBytes":        pinAliasBytes,
+	"PinRepeatSame":        pinRepeatSame,
+	"PinRepeatOther":       pinRepeatOther,
+	"PinVectorToGP":        pinVectorToGP,
+	"PinOpmaskToGP":        pinOpmaskToGP,
+	"PinOpmaskToVector":    pinOpmaskToVector,
+}
+
+func main() {
+	name := os.Getenv("SCENARIO")
+	build, found := scenarios[name]
+	if !found {
+		fmt.Fprintf(os.Stderr, "unknown scenario %q\n", name)
+		os.Exit(1)
+	}
+	build()
+	Generate()
+}
+
+// reserveUpperVectors withholds the vector registers only reachable with an
+// AVX-512 encoding, which keeps the generated code executable everywhere.
+func reserveUpperVectors() {
+	Reserve(reg.X16, reg.X17, reg.X18, reg.X19, reg.X20, reg.X21, reg.X22, reg.X23,
+		reg.X24, reg.X25, reg.X26, reg.X27, reg.X28, reg.X29, reg.X30, reg.X31)
+}
+
+// pinned holds a pinned value across heavy pressure on the same kind.
+func pinned() {
+	TEXT("Pinned", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	keep := GP64()
+	Pin(keep, reg.R14)
+	MOVQ(x, keep)
+	ADDQ(keep, keep)
+
+	const n = 30
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+	ADDQ(keep, acc)
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// pinnedVector holds a pinned vector value across heavy vector pressure.
+func pinnedVector() {
+	TEXT("PinnedVector", NOSPLIT, "func(x uint64) uint64")
+	reserveUpperVectors()
+	x := Load(Param("x"), GP64())
+
+	acc := XMM()
+	Pin(acc, reg.X3)
+	PXOR(acc, acc)
+
+	const n = 18
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(x, t)
+		ADDQ(U32(i+1), t)
+		vs[i] = XMM()
+		MOVQ(t, vs[i])
+	}
+
+	for i := 0; i < n; i++ {
+		PADDQ(vs[i], acc)
+	}
+
+	out := GP64()
+	MOVQ(acc, out)
+	Store(out, ReturnIndex(0))
+	RET()
+}
+
+// pinnedAlias pins a value that is then referenced at three widths.
+func pinnedAlias() {
+	TEXT("PinnedAlias", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	keep := GP64()
+	Pin(keep, reg.RBX)
+	MOVQ(x, keep)
+	ADDB(U8(1), keep.As8())
+	ADDL(U32(2), keep.As32())
+
+	const n = 30
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+	ADDQ(keep, acc)
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// pinAcrossKinds asks to pin a value to a register of another kind.
+func pinAcrossKinds() {
+	TEXT("PinAcrossKinds", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	a := GP64()
+	Pin(a, reg.X3)
+	MOVQ(x, a)
+	ADDQ(U32(1), a)
+
+	Store(a, ReturnIndex(0))
+	RET()
+}
+
+// pinReused pins two values that are never live at the same time to one
+// register.
+func pinReused() {
+	TEXT("PinReused", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	a := GP64()
+	Pin(a, reg.R14)
+	MOVQ(x, a)
+	ADDQ(U32(1), a)
+
+	acc := GP64()
+	MOVQ(a, acc)
+
+	b := GP64()
+	Pin(b, reg.R14)
+	MOVQ(x, b)
+	ADDQ(U32(2), b)
+	ADDQ(b, acc)
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// pinnedYMM pins a 256-bit value under vector pressure.
+func pinnedYMM() {
+	TEXT("PinnedYMM", NOSPLIT, "func(x uint64) uint64")
+	reserveUpperVectors()
+	x := Load(Param("x"), GP64())
+
+	seed := XMM()
+	MOVQ(x, seed)
+
+	acc := YMM()
+	Pin(acc, reg.Y5)
+	VPXOR(acc, acc, acc)
+
+	const n = 20
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = YMM()
+		VPBROADCASTQ(seed, vs[i])
+	}
+
+	for i := 0; i < n; i++ {
+		VPADDQ(vs[i], acc, acc)
+	}
+
+	out := GP64()
+	VMOVQ(acc.AsX(), out)
+	Store(out, ReturnIndex(0))
+	RET()
+}
+
+// pinnedZMM pins a 512-bit value under vector pressure.
+func pinnedZMM() {
+	TEXT("PinnedZMM", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	acc := ZMM()
+	Pin(acc, reg.Z6)
+	VPXORQ(acc, acc, acc)
+
+	const n = 40
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = ZMM()
+		VPBROADCASTQ(x, vs[i])
+	}
+
+	for i := 0; i < n; i++ {
+		VPADDQ(vs[i], acc, acc)
+	}
+
+	out := GP64()
+	VMOVQ(acc.AsX(), out)
+	Store(out, ReturnIndex(0))
+	RET()
+
+	TEXT("PinnedZMMRef", NOSPLIT, "func(x uint64) uint64")
+	y := Load(Param("x"), GP64())
+
+	t := ZMM()
+	VPBROADCASTQ(y, t)
+	ref := ZMM()
+	VPXORQ(ref, ref, ref)
+	for i := 0; i < n; i++ {
+		VPADDQ(t, ref, ref)
+	}
+
+	res := GP64()
+	VMOVQ(ref.AsX(), res)
+	Store(res, ReturnIndex(0))
+	RET()
+}
+
+// opmaskControls reserves and pins mask registers under pressure.
+func opmaskControls() {
+	TEXT("OpmaskControls", NOSPLIT, "func(x uint64) uint64")
+	Reserve(reg.K5, reg.K6, reg.K7)
+	x := Load(Param("x"), GP64())
+
+	acc := K()
+	Pin(acc, reg.K1)
+	KXORQ(acc, acc, acc)
+
+	const n = 8
+	ks := make([]reg.OpmaskVirtual, n)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(x, t)
+		ADDQ(U32(i+1), t)
+		ks[i] = K()
+		KMOVQ(t, ks[i])
+	}
+
+	for i := 0; i < n; i++ {
+		KORQ(ks[i], acc, acc)
+	}
+
+	out := GP64()
+	KMOVQ(acc, out)
+	Store(out, ReturnIndex(0))
+	RET()
+
+	TEXT("OpmaskControlsRef", NOSPLIT, "func(x uint64) uint64")
+	y := Load(Param("x"), GP64())
+
+	ref := K()
+	KXORQ(ref, ref, ref)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(y, t)
+		ADDQ(U32(i+1), t)
+		k := K()
+		KMOVQ(t, k)
+		KORQ(k, ref, ref)
+	}
+
+	res := GP64()
+	KMOVQ(ref, res)
+	Store(res, ReturnIndex(0))
+	RET()
+}
+
+// scope builds two functions, the first of which reserves and pins registers.
+func scope() {
+	TEXT("ScopeFirst", NOSPLIT, "func(x uint64) uint64")
+	Reserve(reg.R12, reg.R13, reg.R15)
+	x := Load(Param("x"), GP64())
+
+	keep := GP64()
+	Pin(keep, reg.R14)
+	MOVQ(x, keep)
+	ADDQ(U32(1), keep)
+
+	Store(keep, ReturnIndex(0))
+	RET()
+
+	TEXT("ScopeSecond", NOSPLIT, "func(x uint64) uint64")
+	y := Load(Param("x"), GP64())
+
+	const n = 14
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(y, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// pinnedControl keeps a pinned value live across a loop back edge and both
+// sides of a branch, under pressure from other values.
+func pinnedControl() {
+	TEXT("PinnedControl", NOSPLIT, "func(n uint64) uint64")
+	n := Load(Param("n"), GP64())
+
+	keep := GP64()
+	Pin(keep, reg.R14)
+	XORQ(keep, keep)
+
+	const m = 25
+	vs := make([]reg.GPVirtual, m)
+	for i := 0; i < m; i++ {
+		vs[i] = GP64()
+		MOVQ(n, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	i := GP64()
+	XORQ(i, i)
+
+	Label("ptop")
