+// evictedToStack reports whether the function spills the given register: it
+// stores the register to a stack slot and later reads that same slot back into
+// it. Copies out of the register, or reads of slots it never wrote, are not
+// eviction and are left alone.
+func evictedToStack(code, register string) bool {
+	named := regexp.MustCompile(`\b` + register + `\b`)
+	offset := regexp.MustCompile(`(\d*)\(SP\)`)
+	stored := map[string]bool{}
+	for _, line := range strings.Split(code, "\n") {
+		if strings.Contains(line, "LEAQ") {
+			continue
+		}
+		if !strings.Contains(line, "(SP)") || !named.MatchString(line) {
+			continue
+		}
+		m := offset.FindStringSubmatch(line)
+		if m == nil {
+			continue
+		}
+		at := m[1]
+		if at == "" {
+			at = "0"
+		}
+		if i := strings.LastIndex(line, ","); i >= 0 && strings.Contains(line[i:], "(SP)") {
+			stored[at] = true
+		} else if stored[at] {
+			return true
+		}
+	}
+	return false
+}
