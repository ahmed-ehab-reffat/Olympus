+
+// outcome records the result of generating, assembling and running one
+// scenario.
+type outcome struct {
+	values []uint64
+	asm    string
+	err    error
+}
+
+var (
+	mu    sync.Mutex
+	cache = map[string]outcome{}
+)
+
+// build generates the named function with the avo package under test, compiles
+// it into a throwaway module and runs it.
+func build(name string) outcome {
+	s, found := scenarios[name]
+	if !found {
+		return outcome{err: errors.New("unknown scenario " + name)}
+	}
+
+	_, self, ok := caller()
+	if !ok {
+		return outcome{err: errors.New("cannot determine test location")}
+	}
+	root := filepath.Dir(filepath.Dir(filepath.Dir(self)))
+
+	dir, err := os.MkdirTemp("", "avospill")
+	if err != nil {
+		return outcome{err: err}
+	}
+
+	asm := filepath.Join(dir, "gen.s")
+	gen := exec.Command("go", "run", filepath.Join("tests", "spill5f34af", s.gen), "-out", asm, "-stubs", filepath.Join(dir, "stub.go"), "-pkg", "main")
+	gen.Dir = root
+	gen.Env = append(os.Environ(), "SCENARIO="+name)
+	if out, err := gen.CombinedOutput(); err != nil {
+		return outcome{err: errors.New("generate " + name + ": " + err.Error() + ": " + string(out))}
+	}
+
+	source, err := os.ReadFile(asm)
+	if err != nil {
+		return outcome{err: err}
+	}
+
+	call := s.call
+	if call == "" || !supported(s.needs) {
+		call = `"skipped"`
+	}
+	files := map[string]string{
+		"go.mod":  "module avospill\n\ngo 1.21\n",
+		"main.go": strings.Replace(runnerTemplate, "%CALL%", call, 1),
+	}
+	for file, content := range files {
+		if err := os.WriteFile(filepath.Join(dir, file), []byte(content), 0o644); err != nil {
+			return outcome{err: err}
+		}
+	}
+
+	exe := exec.Command("go", "run", ".")
+	exe.Dir = dir
+	out, err := exe.Output()
+	if err != nil {
+		detail := err.Error()
+		var exit *exec.ExitError
+		if errors.As(err, &exit) {
+			detail += ": " + string(exit.Stderr)
+		}
+		return outcome{err: errors.New("run " + name + ": " + detail)}
+	}
+
+	res := outcome{asm: string(source)}
+	if s.call != "" && supported(s.needs) {
+		for _, field := range strings.Fields(string(out)) {
+			v, err := strconv.ParseUint(field, 10, 64)
+			if err != nil {
+				return outcome{err: err}
+			}
+			res.values = append(res.values, v)
+		}
+	}
+
+	return res
+}
+
+func caller() (uintptr, string, bool) {
+	pc, file, _, ok := runtime.Caller(0)
+	return pc, file, ok
+}
+
+// result returns the outcome for a scenario, building it at most once.
+func result(t *testing.T, name string) outcome {
+	t.Helper()
+
+	mu.Lock()
+	o, found := cache[name]
+	if !found {
+		o = build(name)
+		cache[name] = o
+	}
+	mu.Unlock()
+
+	if o.err != nil && !scenarios[name].wantErr {
+		t.Fatalf("%v", o.err)
+	}
+
+	return o
+}
+
+// expectMatchesReference checks a spilling function against a reference
+// function computing the same thing without needing to spill. It runs only
+// where the host can execute the code.
+func expectMatchesReference(t *testing.T, name string) {
+	t.Helper()
+	if !supported(scenarios[name].needs) {
+		return
+	}
+	values := result(t, name).values
+	if len(values) != 2 {
+		t.Fatalf("%s returned %d values; expect 2", name, len(values))
+	}
+	if values[0] != values[1] {
+		t.Fatalf("%s = %d; the same computation without spilling gives %d", name, values[0], values[1])
+	}
+}
+
+// expectOnHost checks the computed values when the host can run them.
+func expectOnHost(t *testing.T, name string, want ...uint64) {
+	t.Helper()
+	if !supported(scenarios[name].needs) {
+		return
+	}
+	expect(t, name, want...)
+}
+
+// requireGenerateError checks that a scenario fails while its assembly is
+// being generated, rather than later while it is compiled or run.
+func requireGenerateError(t *testing.T, name string) {
+	t.Helper()
+	err := result(t, name).err
+	if err == nil {
+		t.Fatalf("%s was accepted", name)
+	}
+	if !strings.HasPrefix(err.Error(), "generate ") {
+		t.Fatalf("%s failed after generation: %v", name, err)
+	}
+}
+
+func expect(t *testing.T, name string, want ...uint64) {
+	t.Helper()
+	got := result(t, name).values
+	if len(got) != len(want) {
+		t.Fatalf("%s returned %d values; expect %d", name, len(got), len(want))
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("%s call %d = %d; expect %d", name, i, got[i], want[i])
+		}
+	}
+}
+
+// asm returns the generated assembly for a scenario.
+func asm(t *testing.T, name string) string {
+	t.Helper()
+	return result(t, name).asm
+}
+
+// function returns the part of a scenario's assembly belonging to one
+// generated function.
+func function(t *testing.T, scenario, name string) string {
+	t.Helper()
+	code := asm(t, scenario)
+	start := strings.Index(code, "TEXT ·"+name+"(SB)")
+	if start < 0 {
+		t.Fatalf("function %s not found in %s", name, scenario)
+	}
+	code = code[start:]
+	if end := strings.Index(code[1:], "\nTEXT "); end >= 0 {
+		code = code[:end+1]
+	}
+	return code
+}
+
+const (
+	x    = uint64(1000003)
+	wide = uint64(0x1122334455667788)
+	sub  = uint64(17)
+)
+
+func addB(v uint64, imm uint8) uint64  { return v&^0xff | uint64(uint8(v)+imm) }
+func addW(v uint64, imm uint16) uint64 { return v&^0xffff | uint64(uint16(v)+imm) }
+func addL(v uint64, imm uint32) uint64 { return uint64(uint32(v) + imm) }
+
+func TestSumGP(t *testing.T) {
+	expect(t, "SumGP", 40*x+820)
+}
+
+func TestMixedWidth(t *testing.T) {
+	const n = 24
+	vs := make([]uint64, n)
+	for i := 0; i < n; i++ {
+		switch i % 4 {
+		case 0:
+			vs[i] = addB(wide, uint8(i+1))
+		case 1:
+			vs[i] = addW(wide, uint16(i+1))
+		case 2:
+			vs[i] = addL(wide, uint32(i+1))
+		case 3:
+			vs[i] = wide + uint64(i+1)
+		}
+	}
+
+	acc := uint64(0)
+	for i := 0; i < n; i++ {
+		switch i % 4 {
+		case 0:
+			acc = addB(acc, uint8(vs[i]))
+		case 1:
+			acc = addW(acc, uint16(vs[i]))
+		case 2:
+			acc = addL(acc, uint32(vs[i]))
+		default:
+			acc += vs[i]
+		}
+	}
+
+	expect(t, "MixedWidth", acc)
+}
+
+func TestByteWidth(t *testing.T) {
+	acc := uint64(0)
+	for i := 0; i < 14; i++ {
+		acc = addB(acc, uint8(addB(wide, uint8(i+1))))
+		acc = addW(acc, uint16(addW(wide, uint16(256*(i+1)))))
+	}
+	expect(t, "ByteWidth", acc)
+}
+
+func TestNarrowSites(t *testing.T) {
+	v := addW(addB(wide, 3), 0x0100)
+	want := wide ^ v
+	for i := uint64(1); i <= 24; i++ {
+		want += wide + i
+	}
+	expect(t, "NarrowSites", want)
+}
+
+func TestUpper32(t *testing.T) {
+	acc := uint64(0)
+	for i := 1; i <= 20; i++ {
+		acc += addL(wide, uint32(i))
+	}
+	expect(t, "Upper32", acc)
+}
+
+func TestLoop(t *testing.T) {
+	expect(t, "Loop", 9*210)
+}
+
+func TestMemBase(t *testing.T) {
+	expect(t, "MemBase", wide+300)
+}
+
+func TestPair(t *testing.T) {
+	acc := uint64(0)
+	for i := uint64(1); i <= 20; i++ {
+		acc += x*i - sub
+	}
+	expect(t, "Pair", acc)
+}
