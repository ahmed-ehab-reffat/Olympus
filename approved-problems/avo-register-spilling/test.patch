+	}
+
+	seed := XMM()
+	MOVQ(x, seed)
+
+	ys := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		ys[i] = YMM()
+		VPBROADCASTQ(seed, ys[i])
+	}
+
+	ks := make([]reg.OpmaskVirtual, n)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(U32(i+1), t)
+		ks[i] = K()
+		KMOVQ(t, ks[i])
+	}
+
+	vacc := YMM()
+	VPXOR(vacc, vacc, vacc)
+	for i := 0; i < n; i++ {
+		VPADDQ(ys[i], vacc, vacc)
+	}
+
+	kacc := K()
+	KXORQ(kacc, kacc, kacc)
+	for i := 0; i < n; i++ {
+		KXORQ(ks[i], kacc, kacc)
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(gs[i], acc)
+	}
+
+	vout := GP64()
+	VMOVQ(vacc.AsX(), vout)
+	ADDQ(vout, acc)
+
+	kout := GP64()
+	KMOVQ(kacc, kout)
+	ADDQ(kout, acc)
+
+	sentinel := GP64()
+	MOVBQZX(buf, sentinel)
+	ADDQ(sentinel, acc)
+
+	Store(acc, ReturnIndex(0))
+	RET()
+
+	TEXT("MixedLocalsRef", NOSPLIT, "func(x uint64) uint64")
+
+	rbuf := AllocLocal(8)
+	rx := Load(Param("x"), GP64())
+	MOVB(U8(0x5a), rbuf)
+
+	rtotal := GP64()
+	XORQ(rtotal, rtotal)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(rx, t)
+		ADDQ(U32(i+1), t)
+		ADDQ(t, rtotal)
+	}
+
+	rseed := XMM()
+	MOVQ(rx, rseed)
+	rvec := YMM()
+	VPXOR(rvec, rvec, rvec)
+	for i := 0; i < n; i++ {
+		w := YMM()
+		VPBROADCASTQ(rseed, w)
+		VPADDQ(w, rvec, rvec)
+	}
+	rvout := GP64()
+	VMOVQ(rvec.AsX(), rvout)
+	ADDQ(rvout, rtotal)
+
+	rk := K()
+	KXORQ(rk, rk, rk)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(U32(i+1), t)
+		w := K()
+		KMOVQ(t, w)
+		KXORQ(w, rk, rk)
+	}
+	rkout := GP64()
+	KMOVQ(rk, rkout)
+	ADDQ(rkout, rtotal)
+
+	rsent := GP64()
+	MOVBQZX(rbuf, rsent)
+	ADDQ(rsent, rtotal)
+
+	Store(rtotal, ReturnIndex(0))
+	RET()
+}
+
+// ymmLocals keeps a sentinel in an oddly sized local while wide values spill
+// around it, so a spill slot that overlaps the local corrupts the result.
+func ymmLocals() {
+	TEXT("YMMLocals", NOSPLIT, "func(x uint64) uint64")
+	reserveUpperVectors()
+
+	buf := AllocLocal(3)
+	x := Load(Param("x"), GP64())
+	MOVB(U8(0xa5), buf)
+
+	seed := XMM()
+	MOVQ(x, seed)
+
+	const n = 20
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = YMM()
+		VPBROADCASTQ(seed, vs[i])
+	}
+
+	acc := YMM()
+	VPXOR(acc, acc, acc)
+	for i := 0; i < n; i++ {
+		VPADDQ(vs[i], acc, acc)
+	}
+
+	out := GP64()
+	VMOVQ(acc.AsX(), out)
+
+	sentinel := GP64()
+	MOVBQZX(buf, sentinel)
+	ADDQ(sentinel, out)
+
+	Store(out, ReturnIndex(0))
+	RET()
+}
+
+func ymm() {
+	TEXT("YMM", NOSPLIT, "func(x uint64) uint64")
+	reserveUpperVectors()
+	x := Load(Param("x"), GP64())
+	seed := XMM()
+	MOVQ(x, seed)
+
+	const n = 20
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = YMM()
+		VPBROADCASTQ(seed, vs[i])
+	}
+
+	acc := YMM()
+	VPXOR(acc, acc, acc)
+	for i := 0; i < n; i++ {
+		VPADDQ(vs[i], acc, acc)
+	}
+
+	out := GP64()
+	VMOVQ(acc.AsX(), out)
+	Store(out, ReturnIndex(0))
+	RET()
+}
