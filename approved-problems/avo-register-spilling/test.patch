+// reserveUpperVectors withholds the vector registers only reachable with an
+// AVX-512 encoding, which keeps the generated code executable everywhere.
+func reserveUpperVectors() {
+	Reserve(reg.X16, reg.X17, reg.X18, reg.X19, reg.X20, reg.X21, reg.X22, reg.X23,
+		reg.X24, reg.X25, reg.X26, reg.X27, reg.X28, reg.X29, reg.X30, reg.X31)
+}
+
+// reservedAliasGP reserves one 64-bit register and then leans on the byte
+// registers, including more high byte values than there are high byte
+// registers left.
+func reservedAliasGP() {
+	TEXT("ReservedAliasGP", NOSPLIT, "func(x uint8) uint64")
+	Reserve(reg.RBX)
+	Load(Param("x"), reg.AL)
+
+	const n = 14
+	los := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		los[i] = GP8L()
+		MOVB(reg.AL, los[i])
+		ADDB(U8(i+1), los[i])
+	}
+
+	const m = 4
+	his := make([]reg.GPVirtual, m)
+	for i := 0; i < m; i++ {
+		his[i] = GP8H()
+		MOVB(reg.AL, his[i])
+		ADDB(U8(10*(i+1)), his[i])
+	}
+
+	XORB(reg.CL, reg.CL)
+	for i := 0; i < n; i++ {
+		ADDB(los[i], reg.CL)
+	}
+	for i := 0; i < m; i++ {
+		ADDB(his[i], reg.CL)
+	}
+
+	out := GP64()
+	MOVBQZX(reg.CL, out)
+	Store(out, ReturnIndex(0))
+	RET()
+}
+
+// reservedAliasVector reserves a 128-bit register and then uses 256-bit ones.
+func reservedAliasVector() {
+	TEXT("ReservedAliasVector", NOSPLIT, "func(x uint64) uint64")
+	reserveUpperVectors()
+	Reserve(reg.X4)
+	x := Load(Param("x"), GP64())
+	seed := XMM()
+	MOVQ(x, seed)
+
+	const n = 16
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = YMM()
+		VPBROADCASTQ(seed, vs[i])
+	}
+
+	acc := YMM()
+	VPXOR(acc, acc, acc)
+	for i := 0; i < n; i++ {
+		VPADDQ(vs[i], acc, acc)
+	}
+
+	out := GP64()
+	VMOVQ(acc.AsX(), out)
+	Store(out, ReturnIndex(0))
+	RET()
+}
