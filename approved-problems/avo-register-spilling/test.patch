+	ADDQ(U32(5), keep)
+	JMP(LabelRef("pend"))
+
+	Label("psmall")
+	ADDQ(U32(7), keep)
+
+	Label("pend")
+	acc := GP64()
+	XORQ(acc, acc)
+	for j := 0; j < m; j++ {
