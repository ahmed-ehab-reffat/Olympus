+// copyChain moves values between spilled registers.
+func copyChain() {
+	TEXT("CopyChain", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 24
+	vs := make([]reg.GPVirtual, n)
+	vs[0] = GP64()
+	MOVQ(x, vs[0])
+	for i := 1; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(vs[i-1], vs[i])
+		ADDQ(U32(i), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
