+// slots returns the stack slot offsets a function loads from and stores to,
+// ignoring the frame pointer housekeeping the assembler adds.
+func slots(code string) (loads, stores map[string]bool) {
+	loads, stores = map[string]bool{}, map[string]bool{}
+	slot := regexp.MustCompile(`(\d+)\(SP\)`)
+	for _, line := range strings.Split(code, "\n") {
+		if !strings.Contains(line, "(SP)") || strings.Contains(line, "LEAQ") {
+			continue
+		}
+		m := slot.FindStringSubmatch(line)
+		if m == nil {
+			continue
+		}
+		if i := strings.LastIndex(line, ","); i >= 0 && strings.Contains(line[i:], "(SP)") {
+			stores[m[1]] = true
+		} else {
+			loads[m[1]] = true
+		}
+	}
+	return loads, stores
+}
+
+// requireSlotsPreserved checks that every reload reads a slot the function
+// wrote, which holds whatever instructions an implementation picks and needs no
+// instruction set extension to verify.
+func requireSlotsPreserved(t *testing.T, name string) {
+	t.Helper()
+	code := asm(t, name)
+	loads, stores := slots(code)
+	if len(stores) == 0 || len(loads) == 0 {
+		t.Fatalf("%s has %d stores and %d reloads; expect both", name, len(stores), len(loads))
+	}
+	for off := range loads {
+		if !stores[off] {
+			t.Fatalf("%s reloads %s(SP), which it never wrote", name, off)
+		}
+	}
+	requireSlotWidths(t, name, code)
+}
+
+var moveWidth = map[string]int{
+	"MOVB": 1, "MOVW": 2, "MOVL": 4, "MOVQ": 8,
+	"MOVOU": 16, "MOVO": 16, "MOVUPS": 16, "MOVAPS": 16,
+	"KMOVB": 1, "KMOVW": 2, "KMOVD": 4, "KMOVQ": 8,
+}
+
+// requireSlotWidths checks that no reload reads more bytes out of a slot than
+// the widest store to that slot writes, so a reload never picks up bytes the
+// function never places there. Reading back narrower is left alone, and so is
+// ordering: a value zeroed by an idiom like XOR of a register with itself is
+// legitimately reloaded before anything is written to its slot.
+func requireSlotWidths(t *testing.T, name, code string) {
+	t.Helper()
+	offset := regexp.MustCompile(`(\d*)\(SP\)`)
+	type ref struct {
+		at    string
+		width int
+		store bool
+	}
+	var refs []ref
+	written := map[string]int{}
+	for _, line := range strings.Split(code, "\n") {
+		if !strings.Contains(line, "(SP)") || strings.Contains(line, "LEAQ") {
+			continue
+		}
+		m := offset.FindStringSubmatch(line)
+		if m == nil {
+			continue
+		}
+		at := m[1]
+		if at == "" {
+			at = "0"
+		}
+		width := widthOf(line)
+		if width == 0 {
+			continue
+		}
+		store := false
+		if i := strings.LastIndex(line, ","); i >= 0 && strings.Contains(line[i:], "(SP)") {
+			store = true
+			if width > written[at] {
+				written[at] = width
+			}
+		}
+		refs = append(refs, ref{at: at, width: width, store: store})
+	}
+	for _, r := range refs {
+		if r.store {
+			continue
+		}
+		if r.width > written[r.at] {
+			t.Fatalf("%s reads %d bytes from %s(SP) but never writes more than %d there", name, r.width, r.at, written[r.at])
+		}
+	}
+}
+
+func widthOf(line string) int {
+	fields := strings.Fields(line)
+	if len(fields) == 0 {
+		return 0
+	}
+	if w, found := moveWidth[fields[0]]; found {
+		return w
+	}
+	if m := regexp.MustCompile(`\b([XYZ])\d+\b`).FindStringSubmatch(line); m != nil {
+		return map[string]int{"X": 16, "Y": 32, "Z": 64}[m[1]]
+	}
+	return 0
+}
+
+var alignedMove = regexp.MustCompile(`\b(MOVO|MOVAP[SD]|VMOVDQA(32|64)?|VMOVAP[SD])\b`)
+
+// requireAlignedSlots checks that a spill slot reached by an aligned move sits
+// on a multiple of the moved register's width. Implementations that use the
+// unaligned forms are unconstrained.
+func requireAlignedSlots(t *testing.T, name string) {
+	t.Helper()
+	widths := map[string]int{"X": 16, "Y": 32, "Z": 64}
+	offset := regexp.MustCompile(`(\d+)\(SP\)`)
+	wide := regexp.MustCompile(`\b([XYZ])\d+\b`)
+	for _, line := range strings.Split(asm(t, name), "\n") {
+		if !strings.Contains(line, "(SP)") || !alignedMove.MatchString(line) {
+			continue
+		}
+		off, reg := offset.FindStringSubmatch(line), wide.FindStringSubmatch(line)
+		if off == nil || reg == nil {
+			continue
+		}
+		at, err := strconv.Atoi(off[1])
+		if err != nil {
+			t.Fatal(err)
+		}
+		if width := widths[reg[1]]; at%width != 0 {
+			t.Fatalf("%s moves %d bytes to and from %d(SP) with an aligned instruction", name, width, at)
+		}
+	}
+}
+
+func TestWideSpillSlotsPreserved(t *testing.T) {
+	for _, name := range []string{"ZMM", "Opmask", "YMM", "Vector"} {
+		requireSlotsPreserved(t, name)
+		requireAlignedSlots(t, name)
+	}
+}
+
+func TestControlsRecordedLateThroughGlobals(t *testing.T) {
+	want := uint64(x + 8)
+	for i := uint64(1); i <= 22; i++ {
+		want += x + i
+	}
+	expect(t, "LateGlobal", want)
+
+	code := asm(t, "LateGlobal")
+	if !strings.Contains(code, "R14") {
+		t.Fatal("pinned register R14 not used")
+	}
+	if evictedToStack(code, "R14") {
+		t.Fatal("pinned register R14 spilled")
+	}
+	if m := regexp.MustCompile(`\b(BX|R12)\b`).FindString(code); m != "" {
+		t.Fatalf("reserved register %s used in LateGlobal", m)
+	}
+}
+
+func TestControlsRecordedLate(t *testing.T) {
+	want := uint64(x + 6)
+	for i := uint64(1); i <= 22; i++ {
+		want += x + i
+	}
+	expect(t, "CtxLate", want)
+
+	code := asm(t, "CtxLate")
+	if !strings.Contains(code, "R14") {
+		t.Fatal("pinned register R14 not used")
+	}
+	if evictedToStack(code, "R14") {
+		t.Fatal("pinned register R14 spilled")
+	}
+	if m := regexp.MustCompile(`\b(BX|R12)\b`).FindString(code); m != "" {
+		t.Fatalf("reserved register %s used in CtxLate", m)
+	}
+}
+
+func TestBasePointerControls(t *testing.T) {
+	want := uint64(x + 4)
+	for i := uint64(1); i <= 24; i++ {
+		want += x + i
+	}
+	expect(t, "CtxPinnedBase", want)
+	if !strings.Contains(asm(t, "CtxPinnedBase"), "BP") {
+		t.Fatal("pinned register BP not used")
+	}
+
+	base := uint64(0)
+	for i := uint64(1); i <= 22; i++ {
+		base += x + i
+	}
+	expect(t, "ReservedBase", base)
+	if m := regexp.MustCompile(`\bBP\b`).FindString(asm(t, "ReservedBase")); m != "" {
+		t.Fatal("reserved base pointer used in ReservedBase")
+	}
+}
+
+func TestPinToFormlessRegisterReported(t *testing.T) {
+	expect(t, "Pinned", 32*x+465)
+	requireGenerateError(t, "PinNoHighByte")
+}
+
+func TestPinnedHighByte(t *testing.T) {
+	acc := uint8(0)
+	for i := 1; i <= 14; i++ {
+		acc += 200 + uint8(i)
+	}
+	for j := 1; j <= 3; j++ {
+		acc += 200 + uint8(10*j)
+	}
+	acc += 200 + 5
+	expect(t, "PinnedHighByte", uint64(acc))
+
+	code := asm(t, "PinnedHighByte")
+	if !strings.Contains(code, "BH") {
+		t.Fatal("pinned register BH not used")
+	}
+	if evictedToStack(code, "BH") {
+		t.Fatal("pinned register BH spilled")
+	}
+}
+
+func TestPinDisjointValuesThroughTwoForms(t *testing.T) {
+	expect(t, "PinAliasDisjoint", x+14)
+	if !strings.Contains(asm(t, "PinAliasDisjoint"), "R14") {
+		t.Fatal("pinned register R14 not used")
+	}
+}
+
+func TestReserveRejectsUnassignable(t *testing.T) {
+	expect(t, "Reserved", 8*x+36)
+	requireGenerateError(t, "ReservePseudo")
+}
+
+func TestPinRejectsBadTargets(t *testing.T) {
+	expect(t, "Pinned", 32*x+465)
+	for _, name := range []string{"PinAcrossKinds", "PinToPseudo", "PinToRestricted", "PinVectorToGP", "PinOpmaskToGP", "PinOpmaskToVector"} {
+		requireGenerateError(t, name)
+	}
+}
+
+// frameSize returns the stack frame the generated function declares.
+func frameSize(t *testing.T, name string) int {
+	t.Helper()
+	m := regexp.MustCompile(`TEXT ·` + name + `\(SB\),(?: NOSPLIT,)? \$(\d+)-`).FindStringSubmatch(asm(t, name))
+	if m == nil {
+		t.Fatalf("no frame declaration for %s", name)
+	}
+	size, err := strconv.Atoi(m[1])
+	if err != nil {
+		t.Fatal(err)
+	}
+	return size
+}
+
+// requireFrame checks that a scenario spilled, and that its frame is wide
+// enough to hold a value of the kind it spilled.
+func requireFrame(t *testing.T, name string, width int) {
+	t.Helper()
+	if size := frameSize(t, name); size < width {
+		t.Fatalf("%s allocated %d bytes of stack, too little to hold a %d byte register", name, size, width)
+	}
+}
diff --git a/tests/spill5f34af/spillgen5f34af.go b/tests/spill5f34af/spillgen5f34af.go
new file mode 100644
index 0000000..35c02d4
--- /dev/null
+++ b/tests/spill5f34af/spillgen5f34af.go
@@ -0,0 +1,643 @@
+//go:build ignore
+
+package main
+
+import (
+	"fmt"
+	"os"
+
+	. "github.com/mmcloughlin/avo/build"
+	. "github.com/mmcloughlin/avo/operand"
+	"github.com/mmcloughlin/avo/reg"
+)
+
+// scenarios maps the name of a generated function to its builder. The
+// SCENARIO environment variable selects which one to generate.
+var scenarios = map[string]func(){
+	"SumGP":            sumGP,
+	"MixedWidth":       mixedWidth,
+	"ByteWidth":        byteWidth,
+	"HighByte":         highByte,
+	"Upper32":          upper32,
+	"NarrowSites":      narrowSites,
+	"Loop":             loop,
+	"MemBase":          memBase,
+	"Pair":             pair,
+	"SlotChurn":        slotChurn,
+	"SlotWall":         slotWall,
+	"RepeatOperand":    repeatOperand,
+	"Branchy":          branchy,
+	"CopyChain":        copyChain,
+	"NoSpill":          noSpill,
+	"NoSpillPlain":     noSpillPlain,
+	"SpillPlain":       spillPlain,
+	"NoSpillWideKinds": noSpillWideKinds,
+	"ZMM":              zmm,
+	"Opmask":           opmask,
+}
+
+func main() {
+	name := os.Getenv("SCENARIO")
+	build, found := scenarios[name]
+	if !found {
+		fmt.Fprintf(os.Stderr, "unknown scenario %q\n", name)
+		os.Exit(1)
+	}
+	build()
+	Generate()
+}
+
+// sumGP holds forty independent 64-bit values live at once.
+func sumGP() {
+	TEXT("SumGP", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 40
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// mixedWidth references the same values at four different widths.
+func mixedWidth() {
+	TEXT("MixedWidth", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 24
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		switch i % 4 {
+		case 0:
+			ADDB(U8(i+1), vs[i].As8())
+		case 1:
+			ADDW(U16(i+1), vs[i].As16())
+		case 2:
+			ADDL(U32(i+1), vs[i].As32())
+		case 3:
+			ADDQ(U32(i+1), vs[i])
+		}
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		switch i % 4 {
+		case 0:
+			ADDB(vs[i].As8(), acc.As8())
+		case 1:
+			ADDW(vs[i].As16(), acc.As16())
+		case 2:
+			ADDL(vs[i].As32(), acc.As32())
+		default:
+			ADDQ(vs[i], acc)
+		}
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// byteWidth keeps many 8-bit and 16-bit values live at once.
+func byteWidth() {
+	TEXT("ByteWidth", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 14
+	bs := make([]reg.GPVirtual, n)
+	ws := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		bs[i] = GP64()
+		MOVQ(x, bs[i])
+		ADDB(U8(i+1), bs[i].As8())
+
+		ws[i] = GP64()
+		MOVQ(x, ws[i])
+		ADDW(U16(256*(i+1)), ws[i].As16())
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDB(bs[i].As8(), acc.As8())
+		ADDW(ws[i].As16(), acc.As16())
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// highByte keeps low and high byte registers live simultaneously. The source
+// and the accumulator are legacy registers, so that no instruction pairs a
+// high byte register with one that needs a REX prefix.
+func highByte() {
+	TEXT("HighByte", NOSPLIT, "func(x uint8) uint64")
+	Load(Param("x"), reg.AL)
+
+	const n = 10
+	los := make([]reg.GPVirtual, n)
+	his := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		los[i] = GP8L()
+		MOVB(reg.AL, los[i])
+		ADDB(U8(i+1), los[i])
+
+		his[i] = GP8H()
+		MOVB(reg.AL, his[i])
+		ADDB(U8(2*(i+1)), his[i])
+	}
+
+	XORB(reg.CL, reg.CL)
+	for i := 0; i < n; i++ {
+		ADDB(los[i], reg.CL)
+		ADDB(his[i], reg.CL)
+	}
+
+	out := GP64()
+	MOVBQZX(reg.CL, out)
+	Store(out, ReturnIndex(0))
+	RET()
+}
+
+// noSpillWideKinds builds functions of the wide kinds that fit in registers.
+func noSpillWideKinds() {
+	TEXT("NoSpillYMM", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+	seed := XMM()
+	MOVQ(x, seed)
+	a := YMM()
+	VPBROADCASTQ(seed, a)
+	b := YMM()
+	VPADDQ(a, a, b)
+	out := GP64()
+	VMOVQ(b.AsX(), out)
+	Store(out, ReturnIndex(0))
+	RET()
+
+	TEXT("NoSpillZMM", NOSPLIT, "func(x uint64) uint64")
+	y := Load(Param("x"), GP64())
+	c := ZMM()
+	VPBROADCASTQ(y, c)
+	d := ZMM()
+	VPADDQ(c, c, d)
+	res := GP64()
+	VMOVQ(d.AsX(), res)
+	Store(res, ReturnIndex(0))
+	RET()
+
+	TEXT("NoSpillOpmask", NOSPLIT, "func(x uint64) uint64")
+	z := Load(Param("x"), GP64())
+	k1 := K()
+	KMOVQ(z, k1)
+	k2 := K()
+	KORQ(k1, k1, k2)
+	last := GP64()
+	KMOVQ(k2, last)
+	Store(last, ReturnIndex(0))
+	RET()
+}
+
+// upper32 writes spilled values through 32-bit operations, which zero the
+// upper half of the destination.
+func upper32() {
+	TEXT("Upper32", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 20
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDL(U32(i+1), vs[i].As32())
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// narrowSites touches one spilled value at three widths and then reads all of
+// it, so every byte the narrow references did not write has to survive.
+func narrowSites() {
+	TEXT("NarrowSites", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	v := GP64()
+	MOVQ(x, v)
+	ADDB(U8(3), v.As8())
+	ADDW(U16(0x0100), v.As16())
+
+	const n = 24
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	MOVQ(x, acc)
+	XORQ(v, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// loop carries spilled values across a back edge.
+func loop() {
+	TEXT("Loop", NOSPLIT, "func(n uint64) uint64")
+	n := Load(Param("n"), GP64())
+
+	const m = 20
+	vs := make([]reg.GPVirtual, m)
+	for i := 0; i < m; i++ {
+		vs[i] = GP64()
+		MOVQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	i := GP64()
+	XORQ(i, i)
+
+	Label("top")
+	CMPQ(i, n)
+	JGE(LabelRef("done"))
+	for j := 0; j < m; j++ {
+		ADDQ(vs[j], acc)
+	}
+	INCQ(i)
+	JMP(LabelRef("top"))
+
+	Label("done")
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// memBase uses spilled values as the base and index of a memory reference.
+func memBase() {
+	TEXT("MemBase", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	buf := AllocLocal(64)
+	base := GP64()
+	LEAQ(buf, base)
+
+	idx := GP64()
+	MOVQ(U32(3), idx)
+	MOVQ(x, Mem{Base: base, Index: idx, Scale: 8})
+
+	const n = 24
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	MOVQ(Mem{Base: base, Index: idx, Scale: 8}, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// pair subtracts one spilled value from another, so single instructions
+// reference two spilled registers in a fixed order.
+// repeatOperand names one spilled value in more than one operand role of the
+// same instruction, so a reload has to serve every role and the writeback has
+// to land once.
+func repeatOperand() {
+	TEXT("RepeatOperand", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 22
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	self := GP64()
+	MOVQ(x, self)
+	ADDQ(U32(7), self)
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	ADDQ(self, self)
+	IMUL3Q(U32(3), self, self)
+	ADDQ(self, acc)
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// slotChurn runs three waves of pressure whose values do not outlive their
+// wave, so the frame is governed by how many values are spilled at once rather
+// than by how many are spilled overall.
+func slotChurn() {
+	TEXT("SlotChurn", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	acc := GP64()
+	XORQ(acc, acc)
+
+	const waves, n = 3, 20
+	for w := 0; w < waves; w++ {
+		vs := make([]reg.GPVirtual, n)
+		for i := 0; i < n; i++ {
+			vs[i] = GP64()
+			MOVQ(x, vs[i])
+			ADDQ(U32(w*n+i+1), vs[i])
+		}
+		for i := 0; i < n; i++ {
+			ADDQ(vs[i], acc)
+		}
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+// slotWall holds the same sixty values slotChurn does, but all at once, so it
+// needs a slot for each one that spills rather than a slot per wave.
+func slotWall() {
+	TEXT("SlotWall", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 60
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
+
+func pair() {
+	TEXT("Pair", NOSPLIT, "func(x uint64, y uint64) uint64")
+	x := Load(Param("x"), GP64())
+	y := Load(Param("y"), GP64())
+
+	const n = 20
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		IMUL3Q(U32(i+1), vs[i], vs[i])
+	}
+
+	ws := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		ws[i] = GP64()
+		MOVQ(y, ws[i])
+	}
+
+	for i := 0; i < n; i++ {
+		SUBQ(ws[i], vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+
+	Store(acc, ReturnIndex(0))
+	RET()
+}
