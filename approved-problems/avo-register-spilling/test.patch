+// branchy spills values that are live along both sides of a conditional.
+func branchy() {
+	TEXT("Branchy", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 22
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(U32(i+1), vs[i])
+	}
+
+	acc := GP64()
+	XORQ(acc, acc)
+	CMPQ(x, U32(10))
+	JLT(LabelRef("small"))
+	for i := 0; i < n; i += 2 {
+		ADDQ(vs[i], acc)
+	}
+	JMP(LabelRef("end"))
+
+	Label("small")
+	for i := 1; i < n; i += 2 {
+		ADDQ(vs[i], acc)
+	}
+
+	Label("end")
+	for i := 0; i < n; i++ {
+		ADDQ(vs[i], acc)
+	}
+	Store(acc, ReturnIndex(0))
+	RET()
+}
