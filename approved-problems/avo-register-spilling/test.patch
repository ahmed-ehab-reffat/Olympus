+// opmask keeps twelve mask registers live at once.
+func opmask() {
+	TEXT("Opmask", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 12
+	ks := make([]reg.OpmaskVirtual, n)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(x, t)
+		ADDQ(U32(i+1), t)
+		ks[i] = K()
+		KMOVQ(t, ks[i])
+	}
+
+	acc := K()
+	KXORQ(acc, acc, acc)
+	for i := 0; i < n; i++ {
+		KORQ(ks[i], acc, acc)
+	}
+
+	out := GP64()
+	KMOVQ(acc, out)
+	Store(out, ReturnIndex(0))
+	RET()
+
+	TEXT("OpmaskRef", NOSPLIT, "func(x uint64) uint64")
+	y := Load(Param("x"), GP64())
+
+	ref := K()
+	KXORQ(ref, ref, ref)
+	for i := 0; i < n; i++ {
+		t := GP64()
+		MOVQ(y, t)
+		ADDQ(U32(i+1), t)
+		k := K()
+		KMOVQ(t, k)
+		KORQ(k, ref, ref)
+	}
+
+	res := GP64()
+	KMOVQ(ref, res)
+	Store(res, ReturnIndex(0))
+	RET()
+}
