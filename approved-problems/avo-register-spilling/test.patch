+// reserveNarrowGP reserves a byte register, which reserves the whole of it.
+func reserveNarrowGP() {
+	TEXT("ReserveNarrowGP", NOSPLIT, "func(x uint64) uint64")
+	Reserve(reg.BL)
+	x := Load(Param("x"), GP64())
+
+	const n = 20
+	vs := make([]reg.GPVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = GP64()
+		MOVQ(x, vs[i])
+		ADDQ(U32(i+1), vs[i])
+	}
