+// noSpill fits comfortably in registers.
+func noSpill() {
+	TEXT("NoSpill", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+	y := GP64()
+	MOVQ(x, y)
+	ADDQ(U32(3), y)
+	z := GP64()
+	MOVQ(y, z)
+	IMUL3Q(U32(2), z, z)
+	Store(z, ReturnIndex(0))
+	RET()
+}
