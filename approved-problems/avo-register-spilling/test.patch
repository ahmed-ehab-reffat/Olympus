+func TestPinnedValueNeverSpilled(t *testing.T) {
+	for _, c := range []struct{ scenario, register string }{
+		{"Pinned", "R14"},
+		{"PinnedVector", "X3"},
+	} {
+		code := asm(t, c.scenario)
+		if !strings.Contains(code, "(SP)") {
+			t.Fatalf("%s did not spill anything, so the pinned register is not under pressure", c.scenario)
+		}
+		if evictedToStack(code, c.register) {
+			t.Fatalf("pinned register %s spilled in %s", c.register, c.scenario)
+		}
+	}
+}
