+// zmm keeps forty 512-bit values live at once.
+func zmm() {
+	TEXT("ZMM", NOSPLIT, "func(x uint64) uint64")
+	x := Load(Param("x"), GP64())
+
+	const n = 40
+	vs := make([]reg.VecVirtual, n)
+	for i := 0; i < n; i++ {
+		vs[i] = ZMM()
+		VPBROADCASTQ(x, vs[i])
+	}
+
+	acc := ZMM()
+	VPXORQ(acc, acc, acc)
+	for i := 0; i < n; i++ {
+		VPADDQ(vs[i], acc, acc)
+	}
+
+	out := GP64()
+	VMOVQ(acc.AsX(), out)
+	Store(out, ReturnIndex(0))
+	RET()
+
+	TEXT("ZMMRef", NOSPLIT, "func(x uint64) uint64")
+	y := Load(Param("x"), GP64())
+
+	t := ZMM()
+	VPBROADCASTQ(y, t)
+	ref := ZMM()
+	VPXORQ(ref, ref, ref)
+	for i := 0; i < n; i++ {
+		VPADDQ(t, ref, ref)
+	}
+
+	res := GP64()
+	VMOVQ(ref.AsX(), res)
+	Store(res, ReturnIndex(0))
+	RET()
+}
