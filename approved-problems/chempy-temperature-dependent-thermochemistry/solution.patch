+# -*- coding: utf-8 -*-
+"""
+Temperature dependent models for the molar heat capacity of a substance and
+for the enthalpy and entropy which follow from integrating it.
+"""
+
+import math
+
+import numpy as np
+
+molar_gas_constant = 8.314462618
+reference_temperature = 298.15
+
+
+def _check_range(T_min, T_max):
+    if T_min > T_max:
+        raise ValueError("T_min %s exceeds T_max %s" % (T_min, T_max))
+
+
+class _HeatCapacityModel(object):
+    """Baseclass for models valid on a temperature interval"""
+
+    T_min = None
+    T_max = None
+
+    def _check_temperature(self, T):
+        if T < self.T_min or T > self.T_max:
+            raise ValueError(
+                "temperature %s is outside the validity range %s to %s"
+                % (T, self.T_min, self.T_max)
+            )
+
+    def heat_capacity(self, T):
+        raise NotImplementedError
+
+    def enthalpy(self, T):
+        raise NotImplementedError
+
+    def entropy(self, T):
+        raise NotImplementedError
+
+
+class Shomate(_HeatCapacityModel):
+    """Shomate equation as tabulated by NIST
+
+    The heat capacity is given in J/(mol K) whereas the tabulated enthalpy
+    polynomial is expressed in kJ/mol.
+
+    Parameters
+    ----------
+    A, B, C, D, E, F, G, H : float
+        Shomate coefficients.
+    T_min, T_max : float
+        Validity range in kelvin.
+
+    Examples
+    --------
+    >>> N2 = Shomate(28.98641, 1.853978, -9.647459, 16.63537, 0.000117,
+    ...              -8.671914, 226.4168, 0.0, 100.0, 500.0)
+    >>> '%.3f' % N2.heat_capacity(298.15)
+    '29.124'
+
+    """
+
+    def __init__(self, A, B, C, D, E, F, G, H, T_min=298.15, T_max=6000.0):
+        _check_range(T_min, T_max)
+        self.A = A
+        self.B = B
+        self.C = C
+        self.D = D
+        self.E = E
+        self.F = F
+        self.G = G
+        self.H = H
+        self.T_min = T_min
+        self.T_max = T_max
+
+    def heat_capacity(self, T):
+        self._check_temperature(T)
+        t = T / 1000
+        return self.A + self.B * t + self.C * t**2 + self.D * t**3 + self.E / t**2
+
+    def enthalpy(self, T):
+        self._check_temperature(T)
+        t = T / 1000
+        kilo_joule = (
+            self.A * t
+            + self.B * t**2 / 2
+            + self.C * t**3 / 3
+            + self.D * t**4 / 4
+            - self.E / t
+            + self.F
+            - self.H
+        )
+        return 1000 * kilo_joule
+
+    def entropy(self, T):
+        self._check_temperature(T)
+        t = T / 1000
+        return (
+            self.A * math.log(t)
+            + self.B * t
+            + self.C * t**2 / 2
+            + self.D * t**3 / 3
+            - self.E / (2 * t**2)
+            + self.G
+        )
+
+    @classmethod
+    def fit(
+        cls,
+        temperatures,
+        heat_capacities,
+        enthalpy,
+        entropy,
+        T_ref=reference_temperature,
+        T_min=None,
+        T_max=None,
+    ):
+        """Fit the heat capacity coefficients and anchor the rest at ``T_ref``
+
+        Parameters
+        ----------
+        temperatures : sequence of float
+        heat_capacities : sequence of float
+        enthalpy : float
+            Value the fitted model returns from :meth:`enthalpy` at ``T_ref``.
+        entropy : float
+            Value the fitted model returns from :meth:`entropy` at ``T_ref``.
+        T_ref : float
+        T_min, T_max : float, optional
+            Default to the extremes of ``temperatures``.
+
+        """
+        temperatures = [float(T) for T in temperatures]
+        heat_capacities = [float(c) for c in heat_capacities]
+        if len(temperatures) != len(heat_capacities):
+            raise ValueError("temperatures and heat_capacities differ in length")
+        if len(temperatures) < 5:
+            raise ValueError("at least five data points are required for a fit")
+        design = []
+        for T in temperatures:
+            t = T / 1000
+            design.append([1.0, t, t**2, t**3, t**-2])
+        A, B, C, D, E = np.linalg.lstsq(
+            np.array(design), np.array(heat_capacities), rcond=None
+        )[0]
+        t_ref = T_ref / 1000
+        G = entropy - (
+            A * math.log(t_ref)
+            + B * t_ref
+            + C * t_ref**2 / 2
+            + D * t_ref**3 / 3
+            - E / (2 * t_ref**2)
+        )
+        F = enthalpy / 1000 - (
+            A * t_ref
+            + B * t_ref**2 / 2
+            + C * t_ref**3 / 3
+            + D * t_ref**4 / 4
+            - E / t_ref
+        )
+        return cls(
+            A,
+            B,
+            C,
+            D,
+            E,
+            F,
+            G,
+            0.0,
+            T_min=min(temperatures) if T_min is None else T_min,
+            T_max=max(temperatures) if T_max is None else T_max,
+        )
+
+
+class NASA7(_HeatCapacityModel):
+    """Seven term NASA polynomial
+
+    The polynomial gives an absolute enthalpy; :meth:`enthalpy` shifts it to the
+    same reference as :class:`Shomate` by subtracting the value at 298.15 K.
+
+    Parameters
+    ----------
+    coefficients : sequence of 7 floats
+        a1 to a7.
+    T_min, T_max : float
+        Validity range in kelvin.
+
+    """
+
+    def __init__(self, coefficients, T_min, T_max):
+        _check_range(T_min, T_max)
+        coefficients = tuple(float(a) for a in coefficients)
+        if len(coefficients) != 7:
+            raise ValueError("seven coefficients are required")
+        self.coefficients = coefficients
+        self.T_min = T_min
+        self.T_max = T_max
+
+    def _reduced_heat_capacity(self, T):
+        a1, a2, a3, a4, a5 = self.coefficients[:5]
+        return a1 + a2 * T + a3 * T**2 + a4 * T**3 + a5 * T**4
+
+    def _reduced_enthalpy(self, T):
+        a1, a2, a3, a4, a5, a6, _ = self.coefficients
+        return (
+            a1 * T + a2 * T**2 / 2 + a3 * T**3 / 3 + a4 * T**4 / 4 + a5 * T**5 / 5 + a6
+        )
+
+    def heat_capacity(self, T):
+        self._check_temperature(T)
+        return molar_gas_constant * self._reduced_heat_capacity(T)
+
+    def enthalpy(self, T):
+        self._check_temperature(T)
+        shifted = self._reduced_enthalpy(T) - self._reduced_enthalpy(
+            reference_temperature
+        )
+        return molar_gas_constant * shifted
+
+    def entropy(self, T):
+        self._check_temperature(T)
+        a1, a2, a3, a4, a5, _, a7 = self.coefficients
+        return molar_gas_constant * (
+            a1 * math.log(T)
+            + a2 * T
+            + a3 * T**2 / 2
+            + a4 * T**3 / 3
+            + a5 * T**4 / 4
+            + a7
+        )
+
+
+class PiecewiseThermo(_HeatCapacityModel):
+    """Several models covering adjacent temperature intervals
+
+    Parameters
+    ----------
+    segments : iterable of models
+        Looked up in the given order.
+
+    """
+
+    def __init__(self, segments):
+        segments = list(segments)
+        if len(segments) == 0:
+            raise ValueError("at least one segment is required")
+        self.segments = segments
+        self.T_min = min(segment.T_min for segment in segments)
+        self.T_max = max(segment.T_max for segment in segments)
+        self.reference_segment = self._reference_index()
+        self._enthalpy_offsets = self._offsets("enthalpy")
+        self._entropy_offsets = self._offsets("entropy")
+
+    def _reference_index(self):
+        for index, segment in enumerate(self.segments):
+            if segment.T_min <= reference_temperature <= segment.T_max:
+                return index
+        lowest = min(segment.T_min for segment in self.segments)
+        for index, segment in enumerate(self.segments):
+            if segment.T_min == lowest:
+                return index
+
+    def _offsets(self, attr):
+        offsets = [0.0 for _ in self.segments]
+        anchor = self.reference_segment
+        for index in range(anchor + 1, len(self.segments)):
+            lower = self.segments[index - 1]
+            upper = self.segments[index]
+            if lower.T_max != upper.T_min:
+                break
+            T = lower.T_max
+            jump = getattr(upper, attr)(T) - getattr(lower, attr)(T)
+            offsets[index] = offsets[index - 1] - jump
+        for index in range(anchor - 1, -1, -1):
+            lower = self.segments[index]
+            upper = self.segments[index + 1]
+            if lower.T_max != upper.T_min:
+                break
+            T = lower.T_max
+            jump = getattr(upper, attr)(T) - getattr(lower, attr)(T)
+            offsets[index] = offsets[index + 1] + jump
+        return offsets
+
+    def _index_at(self, T):
+        for index, segment in enumerate(self.segments):
+            if segment.T_min <= T <= segment.T_max:
+                return index
+        raise ValueError(
+            "temperature %s is outside the validity range %s to %s"
+            % (T, self.T_min, self.T_max)
+        )
+
+    def segment_at(self, T):
+        """The first segment whose interval contains ``T``"""
+        return self.segments[self._index_at(T)]
+
+    def heat_capacity(self, T):
+        return self.segment_at(T).heat_capacity(T)
+
+    def enthalpy(self, T):
+        index = self._index_at(T)
+        return self.segments[index].enthalpy(T) + self._enthalpy_offsets[index]
+
+    def entropy(self, T):
+        index = self._index_at(T)
+        return self.segments[index].entropy(T) + self._entropy_offsets[index]
+
+    def discontinuities(self):
+        """Jumps in the three properties at every shared interval boundary
+
+        Returns
+        -------
+        list of tuples
+            ``(T, delta_heat_capacity, delta_enthalpy, delta_entropy)`` for each
+            pair of consecutive segments which share a boundary, where every
+            delta is the value of the later segment minus the value of the
+            earlier one.
+
+        """
+        result = []
+        for lower, upper in zip(self.segments[:-1], self.segments[1:]):
+            if lower.T_max != upper.T_min:
+                continue
+            T = lower.T_max
+            result.append(
+                (
+                    T,
+                    upper.heat_capacity(T) - lower.heat_capacity(T),
+                    upper.enthalpy(T) - lower.enthalpy(T),
+                    upper.entropy(T) - lower.entropy(T),
+                )
+            )
+        return result
+
+
+class SubstanceThermo(object):
+    """A heat capacity model together with an enthalpy of formation
+
+    Parameters
+    ----------
+    model : heat capacity model
+    enthalpy_of_formation : float
+        Standard enthalpy of formation at 298.15 K in J/mol.
+
+    """
+
+    def __init__(self, model, enthalpy_of_formation=0.0):
+        self.model = model
+        self.enthalpy_of_formation = enthalpy_of_formation
+
+    @property
+    def T_min(self):
+        return self.model.T_min
+
+    @property
+    def T_max(self):
+        return self.model.T_max
+
+    def heat_capacity(self, T):
+        return self.model.heat_capacity(T)
+
+    def enthalpy(self, T):
+        return self.enthalpy_of_formation + self.model.enthalpy(T)
+
+    def entropy(self, T):
+        return self.model.entropy(T)
+
+    def gibbs_energy(self, T):
+        return self.enthalpy(T) - T * self.entropy(T)
