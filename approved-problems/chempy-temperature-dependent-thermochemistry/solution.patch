@@ -0,0 +1,526 @@
+# -*- coding: utf-8 -*-
+"""
+Reaction and mixture level thermochemistry: the standard properties of a
+reaction at an arbitrary temperature, the equilibrium constant which follows
+from them, and the temperatures at which an energy balance or an equilibrium
+condition is met.
+"""
+
+import math
+
+from ..chemistry import Equilibrium
+from .models import molar_gas_constant
+
+standard_pressure = 1e5
+
+
+def _check_tolerance(tolerance):
+    if tolerance <= 0:
+        raise ValueError("the tolerance must be positive")
+
+
+def _lookup(thermo, key):
+    try:
+        return thermo[key]
+    except KeyError:
+        raise ValueError("no thermochemistry given for %s" % key)
+
+
+def _weighted_sum(reaction, thermo, T, attr):
+    keys = sorted(reaction.keys())
+    total = 0.0
+    for key, coefficient in zip(keys, reaction.net_stoich(keys)):
+        if coefficient == 0:
+            continue
+        total += coefficient * getattr(_lookup(thermo, key), attr)(T)
+    return total
+
+
+def reaction_heat_capacity(reaction, thermo, T):
+    """Standard heat capacity of reaction in J/(mol K)"""
+    return _weighted_sum(reaction, thermo, T, "heat_capacity")
+
+
+def reaction_enthalpy(reaction, thermo, T):
+    """Standard enthalpy of reaction in J/mol"""
+    return _weighted_sum(reaction, thermo, T, "enthalpy")
+
+
+def reaction_entropy(reaction, thermo, T):
+    """Standard entropy of reaction in J/(mol K)"""
+    return _weighted_sum(reaction, thermo, T, "entropy")
+
+
+def reaction_gibbs_energy(reaction, thermo, T):
+    """Standard Gibbs energy of reaction in J/mol"""
+    return reaction_enthalpy(reaction, thermo, T) - T * reaction_entropy(
+        reaction, thermo, T
+    )
+
+
+def equilibrium_constant(reaction, thermo, T):
+    """Thermodynamic equilibrium constant of a reaction"""
+    return math.exp(
+        -reaction_gibbs_energy(reaction, thermo, T) / (molar_gas_constant * T)
+    )
+
+
+def as_equilibrium(reaction, thermo, T):
+    """An :class:`~chempy.chemistry.Equilibrium` with the constant at ``T``"""
+    return Equilibrium(
+        reaction.reac,
+        reaction.prod,
+        equilibrium_constant(reaction, thermo, T),
+        name=reaction.name,
+    )
+
+
+def _mixture_sum(amounts, thermo, T, attr):
+    total = 0.0
+    for key, amount in sorted(amounts.items()):
+        if amount < 0:
+            raise ValueError("negative amount of %s" % key)
+        if amount == 0:
+            continue
+        total += amount * getattr(_lookup(thermo, key), attr)(T)
+    return total
+
+
+def mixture_enthalpy(amounts, thermo, T):
+    """Enthalpy in J of a mixture given as a mapping of species to moles"""
+    return _mixture_sum(amounts, thermo, T, "enthalpy")
+
+
+def mixture_heat_capacity(amounts, thermo, T):
+    """Heat capacity in J/K of a mixture given as a mapping to moles"""
+    return _mixture_sum(amounts, thermo, T, "heat_capacity")
+
+
+def mixture_entropy(amounts, thermo, T):
+    """Entropy in J/K of a mixture given as a mapping of species to moles"""
+    return _mixture_sum(amounts, thermo, T, "entropy")
+
+
+def _bisect(residual, lower, upper, tolerance):
+    low_value = residual(lower)
+    high_value = residual(upper)
+    if low_value == 0:
+        return lower
+    if high_value == 0:
+        return upper
+    if (low_value > 0) == (high_value > 0):
+        raise ValueError("the residual does not change sign over the bracket")
+    while upper - lower > tolerance:
+        middle = (lower + upper) / 2
+        middle_value = residual(middle)
+        if middle_value == 0:
+            return middle
+        if (middle_value > 0) == (low_value > 0):
+            lower = middle
+            low_value = middle_value
+        else:
+            upper = middle
+    return (lower + upper) / 2
+
+
+def _advanced(amounts, reaction, extent):
+    result = dict(amounts)
+    keys = sorted(reaction.keys())
+    for key, coefficient in zip(keys, reaction.net_stoich(keys)):
+        result[key] = result.get(key, 0.0) + coefficient * extent
+        if result[key] < 0:
+            raise ValueError("the extent consumes more %s than is present" % key)
+    return result
+
+
+def _common_range(amounts, thermo):
+    lower = None
+    upper = None
+    for key, amount in sorted(amounts.items()):
+        if amount == 0:
+            continue
+        entry = _lookup(thermo, key)
+        lower = entry.T_min if lower is None else max(lower, entry.T_min)
+        upper = entry.T_max if upper is None else min(upper, entry.T_max)
+    if lower is None or upper is None or lower >= upper:
+        raise ValueError("the species do not share a temperature range")
+    return lower, upper
+
+
+def adiabatic_temperature(amounts, reaction, thermo, T, extent=1.0, tolerance=1e-9):
+    """Temperature reached when a reaction runs without exchanging heat
+
+    Parameters
+    ----------
+    amounts : dict
+        Moles of every species present before the reaction, including any
+        species which does not take part in it.
+    reaction : Reaction
+    thermo : dict
+        Maps species to :class:`~chempy.thermochemistry.models.SubstanceThermo`.
+    T : float
+        Temperature of the mixture before the reaction.
+    extent : float
+        Moles of reaction turnover.
+    tolerance : float
+        Width in kelvin at which the search stops.
+
+    """
+    _check_tolerance(tolerance)
+    products = _advanced(amounts, reaction, extent)
+    initial = mixture_enthalpy(amounts, thermo, T)
+    lower, upper = _common_range(products, thermo)
+
+    def residual(candidate):
+        return mixture_enthalpy(products, thermo, candidate) - initial
+
+    return _bisect(residual, lower, upper, tolerance)
+
+
+def equilibrium_temperature(reaction, thermo, K, T_min, T_max, tolerance=1e-9):
+    """Temperature at which the equilibrium constant takes the value ``K``
+
+    Parameters
+    ----------
+    reaction : Reaction
+    thermo : dict
+    K : float
+        Must be positive.
+    T_min, T_max : float
+        Bracket to search in.
+    tolerance : float
+        Width in kelvin at which the search stops.
+
+    """
+    _check_tolerance(tolerance)
+    if K <= 0:
+        raise ValueError("the equilibrium constant must be positive")
+
+    def residual(candidate):
+        return math.log(equilibrium_constant(reaction, thermo, candidate)) - math.log(K)
+
+    return _bisect(residual, T_min, T_max, tolerance)
+
+
+def equilibrium_composition(
+    amounts, reaction, thermo, T, pressure=standard_pressure, tolerance=1e-9
+):
+    """Amounts of an ideal gas mixture which satisfy the equilibrium condition
+
+    The activity of a species is its mole fraction times the ratio of the
+    pressure to the standard pressure of 1e5 Pa.
+
+    Parameters
+    ----------
+    amounts : dict
+        Moles of every species present before equilibration.
+    reaction : Reaction
+    thermo : dict
+    T : float
+    pressure : float
+        Total pressure in Pa.
+    tolerance : float
+        Fraction of the width of the extent bracket at which the search stops.
+
+    """
+    _check_tolerance(tolerance)
+    if pressure <= 0:
+        raise ValueError("the pressure must be positive")
+    keys = sorted(reaction.keys())
+    coefficients = list(reaction.net_stoich(keys))
+    initial = {key: float(amounts.get(key, 0.0)) for key in sorted(amounts)}
+    for key in keys:
+        initial.setdefault(key, 0.0)
+    for key, amount in initial.items():
+        if amount < 0:
+            raise ValueError("negative amount of %s" % key)
+    lowest = None
+    highest = None
+    for key, coefficient in zip(keys, coefficients):
+        if coefficient < 0:
+            limit = initial[key] / -coefficient
+            highest = limit if highest is None else min(highest, limit)
+        elif coefficient > 0:
+            limit = -initial[key] / coefficient
+            lowest = limit if lowest is None else max(lowest, limit)
+    if lowest is None or highest is None:
+        raise ValueError("the reaction has no species on one of its sides")
+    if highest <= lowest:
+        raise ValueError("no extent leaves every amount non negative")
+    K = equilibrium_constant(reaction, thermo, T)
+    delta = sum(coefficients)
+    total_initial = sum(initial.values())
+
+    def residual(extent):
+        total = total_initial + delta * extent
+        if total <= 0:
+            raise ValueError("the mixture is empty at this extent")
+        accumulated = 0.0
+        for key, coefficient in zip(keys, coefficients):
+            if coefficient == 0:
+                continue
+            fraction = (initial[key] + coefficient * extent) / total
+            accumulated += coefficient * math.log(fraction)
+        return (
+            accumulated + delta * math.log(pressure / standard_pressure) - math.log(K)
+        )
+
+    span = highest - lowest
+    inset = span * 1e-12
+    extent = _bisect(residual, lowest + inset, highest - inset, span * tolerance)
+    return _advanced(initial, reaction, extent)
+
+
+def reaction_quotient(amounts, reaction, pressure=standard_pressure):
+    """Activity quotient of an ideal gas mixture at the given amounts
+
+    Parameters
+    ----------
+    amounts : dict
+    reaction : Reaction
+    pressure : float
+        Total pressure in Pa.
+
+    """
+    if pressure <= 0:
+        raise ValueError("the pressure must be positive")
+    total = 0.0
+    for key, amount in sorted(amounts.items()):
+        if amount < 0:
+            raise ValueError("negative amount of %s" % key)
+        total += amount
+    if total <= 0:
+        raise ValueError("the mixture is empty")
+    keys = sorted(reaction.keys())
+    quotient = 1.0
+    for key, coefficient in zip(keys, reaction.net_stoich(keys)):
+        if coefficient == 0:
+            continue
+        amount = amounts.get(key, 0.0)
+        if amount <= 0:
+            raise ValueError("%s is absent from the mixture" % key)
+        activity = amount / total * pressure / standard_pressure
+        quotient *= activity**coefficient
+    return quotient
+
+
+def gibbs_energy_at_composition(
+    amounts, reaction, thermo, T, pressure=standard_pressure
+):
+    """Gibbs energy of reaction away from the standard state"""
+    quotient = reaction_quotient(amounts, reaction, pressure)
+    return reaction_gibbs_energy(
+        reaction, thermo, T
+    ) + molar_gas_constant * T * math.log(quotient)
+
+
+def entropy_of_mixing(amounts):
+    """Ideal entropy of mixing in J/K"""
+    total = 0.0
+    for key, amount in sorted(amounts.items()):
+        if amount < 0:
+            raise ValueError("negative amount of %s" % key)
+        total += amount
+    if total <= 0:
+        raise ValueError("the mixture is empty")
+    result = 0.0
+    for key, amount in sorted(amounts.items()):
+        if amount == 0:
+            continue
+        result -= molar_gas_constant * amount * math.log(amount / total)
+    return result
+
+
+def total_entropy(amounts, thermo, T, pressure=standard_pressure):
+    """Entropy in J/K of an ideal gas mixture at a pressure"""
+    if pressure <= 0:
+        raise ValueError("the pressure must be positive")
+    total = sum(amounts.values())
+    return (
+        mixture_entropy(amounts, thermo, T)
+        + entropy_of_mixing(amounts)
+        - molar_gas_constant * total * math.log(pressure / standard_pressure)
+    )
+
+
+def isentropic_temperature(
+    amounts, thermo, T, pressure, final_pressure, tolerance=1e-9
+):
+    """Temperature reached when a mixture is compressed without entropy change
+
+    Parameters
+    ----------
+    amounts : dict
+    thermo : dict
+    T : float
+        Temperature before the change.
+    pressure, final_pressure : float
+        Pressures in Pa before and after the change.
+    tolerance : float
+        Width in kelvin at which the search stops.
+
+    """
+    _check_tolerance(tolerance)
+    initial = total_entropy(amounts, thermo, T, pressure)
+    lower, upper = _common_range(amounts, thermo)
+
+    def residual(candidate):
+        return total_entropy(amounts, thermo, candidate, final_pressure) - initial
+
+    return _bisect(residual, lower, upper, tolerance)
+
+
+def adiabatic_equilibrium(
+    amounts, reaction, thermo, T, pressure=standard_pressure, tolerance=1e-9
+):
+    """Temperature and composition of an adiabatic mixture at equilibrium
+
+    Parameters
+    ----------
+    amounts : dict
+    reaction : Reaction
+    thermo : dict
+    T : float
+        Temperature of the mixture before it reacts.
+    pressure : float
+    tolerance : float
+        Width in kelvin at which the search stops.
+
+    Returns
+    -------
+    tuple
+        The temperature and the mapping of species to amounts.
+
+    """
+    _check_tolerance(tolerance)
+    initial = mixture_enthalpy(amounts, thermo, T)
+    tracked = {key: 1.0 for key in reaction.keys()}
+    for key, amount in sorted(amounts.items()):
+        if amount > 0:
+            tracked[key] = amount
+    lower, upper = _common_range(tracked, thermo)
+
+    def residual(candidate):
+        composition = equilibrium_composition(
+            amounts, reaction, thermo, candidate, pressure
+        )
+        return mixture_enthalpy(composition, thermo, candidate) - initial
+
+    reached = _bisect(residual, lower, upper, tolerance)
+    return reached, equilibrium_composition(
+        amounts, reaction, thermo, reached, pressure
+    )
+
+
+def simultaneous_equilibrium(
+    amounts,
+    reactions,
+    thermo,
+    T,
+    pressure=standard_pressure,
+    tolerance=1e-9,
+    max_iterations=200,
+):
+    """Composition satisfying several equilibria at once
+
+    Each reaction is equilibrated in turn and the sweep is repeated until no
+    amount changes by more than ``tolerance`` times the total amount.
+
+    Parameters
+    ----------
+    amounts : dict
+    reactions : iterable of Reaction
+    thermo : dict
+    T : float
+    pressure : float
+    tolerance : float
+    max_iterations : int
+        Number of sweeps after which a :class:`ValueError` is raised.
+
+    """
+    _check_tolerance(tolerance)
+    reactions = list(reactions)
+    if len(reactions) == 0:
+        raise ValueError("at least one reaction is required")
+    composition = dict(amounts)
+    for reaction in reactions:
+        for key in reaction.keys():
+            composition.setdefault(key, 0.0)
+    for _ in range(max_iterations):
+        largest = 0.0
+        scale = sum(composition.values())
+        for reaction in reactions:
+            updated = equilibrium_composition(
+                composition, reaction, thermo, T, pressure
+            )
+            for key, amount in updated.items():
+                largest = max(largest, abs(amount - composition[key]))
+            composition = updated
+        if largest <= tolerance * scale:
+            return composition
+    raise ValueError("the sweeps did not converge")
+
+
+def adiabatic_simultaneous_equilibrium(
+    amounts,
+    reactions,
+    thermo,
+    T,
+    pressure=standard_pressure,
+    tolerance=1e-9,
+    max_iterations=200,
+):
+    """Temperature and composition of an adiabatic mixture at several equilibria
+
+    The composition is re-equilibrated at every candidate temperature, so the
+    enthalpy balance is taken against a composition which moves with it.
+
+    Parameters
+    ----------
+    amounts : dict
+    reactions : iterable of Reaction
+    thermo : dict
+    T : float
+        Temperature of the mixture before it reacts.
+    pressure : float
+    tolerance : float
+        Width in kelvin at which the outer search stops.
+    max_iterations : int
+        Sweeps allowed to each inner equilibration.
+
+    Returns
+    -------
+    tuple
+        The temperature and the mapping of species to amounts.
+
+    """
+    _check_tolerance(tolerance)
+    reactions = list(reactions)
+    if len(reactions) == 0:
+        raise ValueError("at least one reaction is required")
+    initial = mixture_enthalpy(amounts, thermo, T)
+    tracked = {}
+    for reaction in reactions:
+        for key in reaction.keys():
+            tracked[key] = 1.0
+    for key, amount in sorted(amounts.items()):
+        if amount > 0:
+            tracked[key] = amount
+    lower, upper = _common_range(tracked, thermo)
+
+    def equilibrated(candidate):
+        return simultaneous_equilibrium(
+            amounts,
+            reactions,
+            thermo,
+            candidate,
+            pressure,
+            tolerance,
+            max_iterations,
+        )
+
+    def residual(candidate):
+        return mixture_enthalpy(equilibrated(candidate), thermo, candidate) - initial
+
+    reached = _bisect(residual, lower, upper, tolerance)
+    return reached, equilibrated(reached)
