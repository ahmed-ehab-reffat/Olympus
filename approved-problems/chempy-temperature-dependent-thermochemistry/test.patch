+    with pytest.raises(ValueError):
+        model.heat_capacity(501.0)
+
+
+def test_piecewise_lowest_anchor_is_not_the_first_listed():
+    tc = _mod()
+    middle = tc.Shomate(30.0, 0, 0, 0, 0, 0, 120.0, 0, 2000.0, 3000.0)
+    upper = tc.Shomate(35.0, 0, 0, 0, 0, 0, 130.0, 0, 3000.0, 4000.0)
+    lowest = tc.Shomate(20.0, 0, 0, 0, 0, 0, 100.0, 0, 500.0, 1000.0)
+    combined = tc.PiecewiseThermo([middle, upper, lowest])
+    records = list(combined.discontinuities())
+    assert [record[0] for record in records] == [3000.0]
+    assert records[0][2] != 0.0
+    assert combined.enthalpy(700.0) == lowest.enthalpy(700.0)
+    assert combined.entropy(700.0) == lowest.entropy(700.0)
+    assert combined.enthalpy(2500.0) == middle.enthalpy(2500.0)
+    assert combined.enthalpy(3500.0) == upper.enthalpy(3500.0)
+
+
+def test_equilibrium_temperature_accepts_a_degenerate_bracket_holding_the_root():
+    tc = _mod()
+    reaction, thermo = _isomerisation()
+    target = tc.equilibrium_constant(reaction, thermo, 600.0)
+    assert tc.equilibrium_temperature(
+        reaction, thermo, target, 600.0, 600.0, tolerance=1e-9
+    ) == pytest.approx(600.0, abs=1e-9)
