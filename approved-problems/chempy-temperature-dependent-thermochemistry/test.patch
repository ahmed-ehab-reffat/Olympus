+def _carbon_monoxide():
+    tc = _mod()
+    return tc.Shomate(
+        25.56759,
+        6.096130,
+        4.054656,
+        -2.671301,
+        0.131021,
+        -118.0089,
+        227.3665,
+        -110.5271,
+        298.0,
+        1300.0,
+    )
+
+
+def _carbon_dioxide():
+    tc = _mod()
+    return tc.Shomate(
+        24.99735,
+        55.18696,
+        -33.69137,
+        7.948387,
