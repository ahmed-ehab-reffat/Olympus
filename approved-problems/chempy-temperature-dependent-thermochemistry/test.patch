+
+def _nitrogen_nasa():
+    tc = _mod()
+    return tc.NASA7(
+        [
+            3.298677,
+            1.4082404e-3,
+            -3.963222e-6,
+            5.641515e-9,
+            -2.444854e-12,
+            -1020.8999,
+            3.950372,
+        ],
+        298.15,
+        1000.0,
+    )
+
+
+def _constant(heat_capacity, enthalpy_of_formation, entropy, T_min=200.0, T_max=4000.0):
+    tc = _mod()
+    reference = tc.reference_temperature
+    model = tc.Shomate(
+        heat_capacity,
+        0.0,
+        0.0,
+        0.0,
+        0.0,
+        -heat_capacity * reference / 1000,
+        entropy - heat_capacity * math.log(reference / 1000),
+        0.0,
+        T_min,
+        T_max,
+    )
+    return tc.SubstanceThermo(model, enthalpy_of_formation)
+
+
+ISOMERISATION = {"A": (30.0, 0.0, 200.0), "B": (30.0, -5000.0, 190.0)}
+DIMERISATION = {"A": (25.0, 0.0, 150.0), "B": (45.0, -20000.0, 220.0)}
+
+
+def _from_parameters(parameters):
+    return {key: _constant(*values) for key, values in parameters.items()}
+
+
+def _isomerisation():
+    return Reaction({"A": 1}, {"B": 1}), _from_parameters(ISOMERISATION)
+
+
+def _dimerisation():
+    return Reaction({"A": 2}, {"B": 1}), _from_parameters(DIMERISATION)
+
+
+def _combustion():
+    tc = _mod()
+    oxygen = tc.PiecewiseThermo([_oxygen_low(), _oxygen_high()])
+    nitrogen = tc.PiecewiseThermo([_nitrogen_low(), _nitrogen_high()])
+    thermo = {
+        "CO": tc.SubstanceThermo(_carbon_monoxide(), -110527.1),
+        "O2": tc.SubstanceThermo(oxygen, 0.0),
+        "CO2": tc.SubstanceThermo(_carbon_dioxide(), -393522.4),
+        "N2": tc.SubstanceThermo(nitrogen, 0.0),
+    }
+    return Reaction({"CO": 2, "O2": 1}, {"CO2": 2}), thermo
+
+
+def _derivative(function, T, step=1e-4):
+    return (function(T + step) - function(T - step)) / (2 * step)
+
+
+def _simpson(function, lower, upper, steps=512):
+    width = (upper - lower) / steps
+    total = function(lower) + function(upper)
+    for index in range(1, steps):
+        total += (4 if index % 2 else 2) * function(lower + index * width)
+    return total * width / 3
+
+
+def _analytic_gibbs(reaction, parameters, T):
+    reference = 298.15
+    keys = sorted(reaction.keys())
+    enthalpy = 0.0
+    entropy = 0.0
+    for key, nu in zip(keys, reaction.net_stoich(keys)):
+        cp, formation, absolute = parameters[key]
+        enthalpy += nu * (formation + cp * (T - reference))
+        entropy += nu * (absolute + cp * math.log(T / reference))
+    return enthalpy - T * entropy
+
