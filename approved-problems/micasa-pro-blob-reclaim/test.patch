+func TestProReclaimWaitsForADeviceThatNeverSynced(t *testing.T) {
+	eachRelayF908dd(t, func(hh *reclaimHouseholdF908dd) {
+		t := hh.t
+		laptop := hh.join("laptop")
+		hh.join("tablet")
+		doc := laptop.attach(laptop.vendor("Acme Plumbing"), "quote", "quote draft")
+		laptop.sync()
+		laptop.uploadOrphan("quote nobody kept")
+		laptop.replace(doc, "quote final")
+		laptop.sync()
+
+		out := laptop.reclaim()
+		assert.Contains(t, out, "tablet")
+		assertNothingRemovedF908dd(t, out)
+		assert.True(t, hh.stored("quote draft"))
+		assert.True(t, hh.stored("quote nobody kept"))
+	})
+}
