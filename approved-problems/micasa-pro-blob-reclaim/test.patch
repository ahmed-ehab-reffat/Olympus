+func assertNothingRemovedF908dd(t *testing.T, out string) {
+	t.Helper()
+	if m := reclaimLineF908dd.FindStringSubmatch(out); m != nil {
+		assert.Equal(t, "0", m[1], "files removed while waiting: %q", out)
+	}
+}
+
+func largeFileF908dd(fill string) string {
+	return strings.Repeat(fill, 600<<10)
+}
+
+func parseReclaimF908dd(t *testing.T, out string) (int, string) {
+	t.Helper()
+	m := reclaimLineF908dd.FindStringSubmatch(out)
+	require.NotNil(t, m, "no removal line in output: %q", out)
+	n, err := strconv.Atoi(m[1])
+	require.NoError(t, err)
+	return n, strings.TrimSpace(m[2])
+}
