+func (d *reclaimDeviceF908dd) run(args ...string) string {
+	d.t.Helper()
+	bin, err := reclaimBinF908dd()
+	require.NoError(d.t, err, "building micasa")
+	cmd := exec.CommandContext(d.t.Context(), bin, args...)
+	home := d.t.TempDir()
+	cmd.Env = append(os.Environ(),
+		"HOME="+home,
+		"XDG_CONFIG_HOME="+filepath.Join(home, "config"),
+		"XDG_STATE_HOME="+filepath.Join(home, "state"),
+		"XDG_CACHE_HOME="+filepath.Join(home, "cache"),
+		"XDG_DATA_HOME="+d.dataDir,
+		"MICASA_DB_PATH=",
+	)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	require.NoError(d.t, cmd.Run(), "stderr: %s", stderr.String())
+	return stdout.String()
+}
