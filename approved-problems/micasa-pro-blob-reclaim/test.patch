+var reclaimTestKeyF908dd = []byte("test-encryption-key-exactly-32b!")
+
+var reclaimPgStoreF908dd = gosync.OnceValues(func() (*relay.PgStore, error) {
+	pg, err := relay.OpenPgStore(os.Getenv("RELAY_POSTGRES_DSN"))
+	if err != nil {
+		return nil, err
+	}
+	if err := pg.AutoMigrate(); err != nil {
+		return nil, err
+	}
+	pg.SetEncryptionKey(reclaimTestKeyF908dd)
+	return pg, nil
+})
+
+var reclaimBinF908dd = gosync.OnceValues(func() (string, error) {
+	dir, err := os.MkdirTemp("", "micasa-reclaim-*")
+	if err != nil {
+		return "", fmt.Errorf("create temp dir: %w", err)
+	}
+	bin := filepath.Join(dir, "micasa")
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Minute)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "go", "build", "-o", bin, ".")
+	cmd.Env = append(os.Environ(), "CGO_ENABLED=0")
+	if out, err := cmd.CombinedOutput(); err != nil {
+		_ = os.RemoveAll(dir)
+		return "", fmt.Errorf("build: %w\n%s", err, out)
+	}
+	testBinPath.CompareAndSwap(nil, &bin)
+	return bin, nil
+})
