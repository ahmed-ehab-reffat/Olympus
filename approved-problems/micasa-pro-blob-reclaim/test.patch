+func (d *reclaimDeviceF908dd) attach(vendorID, title, content string) string {
+	d.t.Helper()
+	doc := &data.Document{
+		Title:          title,
+		FileName:       title + ".txt",
+		EntityKind:     data.DocumentEntityVendor,
+		EntityID:       vendorID,
+		MIMEType:       "text/plain",
+		SizeBytes:      int64(len(content)),
+		ChecksumSHA256: checksumF908dd(content),
+		Data:           []byte(content),
+	}
+	require.NoError(d.t, d.store.CreateDocument(doc))
+	return doc.ID
+}
+
+func (d *reclaimDeviceF908dd) replace(docID, content string) {
+	d.t.Helper()
+	doc, err := d.store.GetDocument(docID)
+	require.NoError(d.t, err)
+	doc.Data = []byte(content)
+	doc.SizeBytes = int64(len(content))
+	doc.ChecksumSHA256 = checksumF908dd(content)
+	require.NoError(d.t, d.store.UpdateDocument(doc))
+}
+
+func (d *reclaimDeviceF908dd) content(docID string) string {
+	d.t.Helper()
+	var doc data.Document
+	require.NoError(d.t, d.store.GormDB().Unscoped().First(&doc, "id = ?", docID).Error)
+	return string(doc.Data)
+}
+
+func (d *reclaimDeviceF908dd) createDeletedDocuments(vendorID string, first, n int) {
+	d.t.Helper()
+	deletedAt := gorm.DeletedAt{Time: time.Now(), Valid: true}
+	docs := make([]data.Document, 0, n)
+	for i := first; i < first+n; i++ {
+		content := fmt.Sprintf("receipt %05d", i)
+		docs = append(docs, data.Document{
+			Title:          fmt.Sprintf("receipt %05d", i),
+			FileName:       fmt.Sprintf("receipt-%05d.txt", i),
+			EntityKind:     data.DocumentEntityVendor,
+			EntityID:       vendorID,
+			MIMEType:       "text/plain",
+			SizeBytes:      int64(len(content)),
+			ChecksumSHA256: checksumF908dd(content),
+			DeletedAt:      deletedAt,
+		})
+	}
+	require.NoError(d.t, d.store.GormDB().CreateInBatches(docs, 500).Error)
+}
+
+func (d *reclaimDeviceF908dd) addDeletedDocuments(vendorID string, n int) {
+	d.t.Helper()
+	d.createDeletedDocuments(vendorID, 0, n)
+	unsynced, err := d.store.UnsyncedOps()
+	require.NoError(d.t, err)
+	ids := make([]string, 0, len(unsynced))
+	for _, e := range unsynced {
+		ids = append(ids, e.ID)
+	}
+	require.NoError(d.t, d.store.MarkSynced(ids))
+}
+
+func (d *reclaimDeviceF908dd) uploadOrphan(content string) {
+	d.t.Helper()
+	require.NoError(d.t, sync.NewClient(d.hh.url, d.token, d.hh.key).
+		UploadBlob(d.t.Context(), d.hh.householdID, checksumF908dd(content), []byte(content)))
+}
