+func TestProReclaimIgnoresARevokedDevice(t *testing.T) {
+	eachRelayF908dd(t, func(hh *reclaimHouseholdF908dd) {
+		t := hh.t
+		laptop := hh.join("laptop")
+		tablet := hh.join("tablet")
+		doc := laptop.attach(laptop.vendor("Acme Plumbing"), "quote", "quote draft")
+		laptop.sync()
+		laptop.replace(doc, "quote final")
+		laptop.sync()
+		hh.revoke(tablet)
+
+		removed, _ := parseReclaimF908dd(t, laptop.reclaim())
+		assert.Equal(t, 1, removed)
+		assert.False(t, hh.stored("quote draft"))
+	})
+}
