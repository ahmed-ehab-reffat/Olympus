+func newReclaimHouseholdF908dd(t *testing.T, store relay.Store) *reclaimHouseholdF908dd {
+	t.Helper()
+	hh := &reclaimHouseholdF908dd{t: t, relay: store}
+	handler := relay.NewHandler(
+		store,
+		slog.Default(),
+		relay.WithSelfHosted(),
+		relay.WithBlobQuota(1<<20),
+	)
+	srv := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if hh.failGets.Load() && r.Method == http.MethodGet &&
+			strings.HasPrefix(r.URL.Path, "/blobs/") {
+			http.Error(w, "blob store unavailable", http.StatusServiceUnavailable)
+			return
+		}
+		body, err := io.ReadAll(r.Body)
+		if err != nil {
+			http.Error(w, "read body", http.StatusBadRequest)
+			return
+		}
+		if c := hh.cutOff.Load(); c != nil && r.Header.Get("Authorization") == "Bearer "+c.token {
+			if c.sent.Add(int64(len(body)))-int64(len(body)) >= c.after {
+				http.Error(w, "connection lost", http.StatusServiceUnavailable)
+				return
+			}
+		}
+		for n := int64(len(body)); ; {
+			if cur := hh.maxBody.Load(); n <= cur || hh.maxBody.CompareAndSwap(cur, n) {
+				break
+			}
+		}
+		r.Body = io.NopCloser(bytes.NewReader(body))
+		if tok := hh.lostReplies.Load(); tok != nil && len(body) > 0 &&
+			r.Header.Get("Authorization") == "Bearer "+*tok {
+			handler.ServeHTTP(httptest.NewRecorder(), r)
+			panic(http.ErrAbortHandler)
+		}
+		handler.ServeHTTP(w, r)
+	}))
+	srv.Listener = countingListenerF908dd{Listener: srv.Listener, n: &hh.traffic}
+	srv.Start()
+	t.Cleanup(srv.Close)
+	key, err := crypto.GenerateHouseholdKey()
+	require.NoError(t, err)
+	hh.url, hh.key = srv.URL, key
+	return hh
+}
