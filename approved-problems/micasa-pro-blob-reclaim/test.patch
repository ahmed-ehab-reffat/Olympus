+func TestProReclaimWaitsForADeviceThatPushedAfterItsReport(t *testing.T) {
+	eachRelayF908dd(t, func(hh *reclaimHouseholdF908dd) {
+		t := hh.t
+		laptop := hh.join("laptop")
+		phone := hh.join("phone")
+		doc := laptop.attach(laptop.vendor("Acme Plumbing"), "warranty", "warranty scan")
+		laptop.sync()
+		phone.sync()
+		laptop.replace(doc, "warranty scan, both pages")
+		laptop.sync()
+		phone.sync()
+
+		phone.vendor("Bolt Electric")
+		unsynced, err := phone.store.UnsyncedOps()
+		require.NoError(t, err)
+		ops := make([]sync.OpPayload, 0, len(unsynced))
+		for _, e := range unsynced {
+			ops = append(ops, sync.OpPayload{
+				ID:        e.ID,
+				TableName: e.TableName,
+				RowID:     e.RowID,
+				OpType:    e.OpType,
+				Payload:   e.Payload,
+				DeviceID:  e.DeviceID,
+				CreatedAt: e.CreatedAt,
+			})
+		}
+		pushed, err := sync.NewClient(hh.url, phone.token, hh.key).Push(t.Context(), ops)
+		require.NoError(t, err)
+		ids := make([]string, 0, len(pushed.Confirmed))
+		for _, c := range pushed.Confirmed {
+			ids = append(ids, c.ID)
+		}
+		require.NoError(t, phone.store.MarkSynced(ids))
+
+		out := laptop.reclaim()
+		assert.Contains(t, out, "phone")
+		assert.True(t, hh.stored("warranty scan"))
+
+		phone.sync()
+		removed, _ := parseReclaimF908dd(t, laptop.reclaim())
+		assert.Equal(t, 1, removed)
+		assert.False(t, hh.stored("warranty scan"))
+	})
+}
