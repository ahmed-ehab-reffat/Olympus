+func TestProReclaimReplacedFileReachesTheOtherDevice(t *testing.T) {
+	eachRelayF908dd(t, func(hh *reclaimHouseholdF908dd) {
+		t := hh.t
+		laptop := hh.join("laptop")
+		phone := hh.join("phone")
+		doc := laptop.attach(laptop.vendor("Acme Plumbing"), "manual", "manual first edition")
+		laptop.sync()
+		phone.sync()
+		require.Equal(t, "manual first edition", phone.content(doc))
+
+		laptop.replace(doc, "manual second edition")
+		laptop.sync()
+		phone.sync()
+		assert.Equal(t, "manual second edition", phone.content(doc))
+	})
+}
