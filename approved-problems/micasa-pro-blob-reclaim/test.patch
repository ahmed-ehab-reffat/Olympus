+func eachRelayF908dd(t *testing.T, body func(hh *reclaimHouseholdF908dd)) {
+	t.Helper()
+	t.Run("memory", func(t *testing.T) {
+		ms := relay.NewMemStore()
+		ms.SetEncryptionKey(reclaimTestKeyF908dd)
+		body(newReclaimHouseholdF908dd(t, ms))
+	})
+	t.Run("postgres", func(t *testing.T) {
+		if os.Getenv("RELAY_POSTGRES_DSN") == "" {
+			t.Skip("RELAY_POSTGRES_DSN not set, skipping Postgres relay")
+		}
+		pg, err := reclaimPgStoreF908dd()
+		require.NoError(t, err)
+		body(newReclaimHouseholdF908dd(t, pg))
+	})
+}
