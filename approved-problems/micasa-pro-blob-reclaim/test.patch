+func (h *reclaimHouseholdF908dd) join(name string) *reclaimDeviceF908dd {
+	h.t.Helper()
+	kp, err := crypto.GenerateDeviceKeyPair()
+	require.NoError(h.t, err)
+	var id, token string
+	if h.householdID == "" {
+		created, err := h.relay.CreateHousehold(h.t.Context(), sync.CreateHouseholdRequest{
+			DeviceName: name,
+			PublicKey:  kp.PublicKey[:],
+		})
+		require.NoError(h.t, err)
+		h.householdID = created.HouseholdID
+		id, token = created.DeviceID, created.DeviceToken
+	} else {
+		joined, err := h.relay.RegisterDevice(h.t.Context(), sync.RegisterDeviceRequest{
+			HouseholdID: h.householdID,
+			Name:        name,
+			PublicKey:   kp.PublicKey[:],
+		})
+		require.NoError(h.t, err)
+		id, token = joined.DeviceID, joined.DeviceToken
+	}
+
+	dataDir := h.t.TempDir()
+	secrets := filepath.Join(dataDir, "micasa", "secrets")
+	require.NoError(h.t, os.MkdirAll(secrets, 0o700))
+	require.NoError(h.t, crypto.SaveDeviceToken(secrets, token))
+	require.NoError(h.t, crypto.SaveHouseholdKey(secrets, h.key))
+	require.NoError(h.t, crypto.SaveDeviceKeyPair(secrets, kp))
+
+	dbPath := filepath.Join(h.t.TempDir(), "micasa.db")
+	store, err := openAndMigrate(dbPath)
+	require.NoError(h.t, err)
+	h.t.Cleanup(func() { _ = store.Close() })
+	require.NoError(h.t, store.SetMaxDocumentSize(1<<20))
+	require.NoError(h.t, store.GormDB().Create(&data.SyncDevice{
+		ID:          id,
+		Name:        name,
+		HouseholdID: h.householdID,
+		RelayURL:    h.url,
+	}).Error)
+	store.SetDeviceID(id)
+
+	return &reclaimDeviceF908dd{
+		t:       h.t,
+		hh:      h,
+		name:    name,
+		id:      id,
+		token:   token,
+		dataDir: dataDir,
+		dbPath:  dbPath,
+		store:   store,
+		engine:  sync.NewEngine(store, sync.NewClient(h.url, token, h.key), h.householdID),
+	}
+}
