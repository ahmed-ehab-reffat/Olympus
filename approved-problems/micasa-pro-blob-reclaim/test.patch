+func TestProReclaimRemovesAReplacedFileOnceEveryDeviceSynced(t *testing.T) {
+	eachRelayF908dd(t, func(hh *reclaimHouseholdF908dd) {
+		t := hh.t
+		laptop := hh.join("laptop")
+		phone := hh.join("phone")
+		doc := laptop.attach(laptop.vendor("Acme Plumbing"), "invoice", "invoice v1")
+		laptop.sync()
+		phone.sync()
+		laptop.replace(doc, "invoice v2, corrected")
+		laptop.sync()
+		phone.sync()
+
+		before := hh.usage()
+		out := laptop.reclaim()
+		removed, freed := parseReclaimF908dd(t, out)
+		assert.Equal(t, 1, removed)
+		assert.Equal(t, formatBytes(before-hh.usage()), freed)
+		assert.Contains(t, out, laptop.storage())
+		assert.False(t, hh.stored("invoice v1"))
+		assert.True(t, hh.stored("invoice v2, corrected"))
+	})
+}
