diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..dab72fa
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,130 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/test-results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+export GOFLAGS="${GOFLAGS:--buildvcs=false}"
+if [ ! -w "${HOME:-/}" ]; then
+  HOME="$(mktemp -d)"
+  export HOME
+fi
+
+NEW_TESTS='^TestProReclaim'
+NEW_FILES="cmd/micasa/pro_reclaim_f908dd_test.go"
+LOG="$(mktemp)"
+
+start_postgres() {
+  local bindir pgroot run_as=()
+  bindir="$(ls -d /usr/lib/postgresql/*/bin 2>/dev/null | sort -V | tail -n 1)"
+  [ -x "$bindir/initdb" ] || return 1
+  pgroot="$(mktemp -d)"
+  PG_STOP=("$bindir/pg_ctl" -D "$pgroot/data" -m immediate stop)
+  if [ "$(id -u)" = 0 ]; then
+    chown postgres "$pgroot"
+    run_as=(runuser -u postgres --)
+    PG_STOP=(runuser -u postgres -- "${PG_STOP[@]}")
+  elif ! id -un >/dev/null 2>&1; then
+    printf 'micasa:x:%s:%s::%s:/bin/sh\n' "$(id -u)" "$(id -g)" "$pgroot" >"$pgroot/passwd"
+    printf 'micasa:x:%s:\n' "$(id -g)" >"$pgroot/group"
+    run_as=(env LD_PRELOAD=libnss_wrapper.so NSS_WRAPPER_PASSWD="$pgroot/passwd" \
+      NSS_WRAPPER_GROUP="$pgroot/group")
+    PG_STOP=("${run_as[@]}" "${PG_STOP[@]}")
+  fi
+  "${run_as[@]}" "$bindir/initdb" -D "$pgroot/data" -U micasa -A trust -E UTF8 >>"$LOG" 2>&1 || return 1
+  "${run_as[@]}" "$bindir/pg_ctl" -D "$pgroot/data" -l "$pgroot/server.log" -w \
+    -o "-k $pgroot -c listen_addresses= -c fsync=off -c synchronous_commit=off -c full_page_writes=off" \
+    start >>"$LOG" 2>&1 || return 1
+  export RELAY_POSTGRES_DSN="host=$pgroot user=micasa dbname=postgres sslmode=disable"
+}
+
+PG_STOP=()
+CGO_ENABLED=0 go build -o /dev/null ./cmd/micasa >>"$LOG" 2>&1
+if [ "$MODE" = "new" ]; then
+  if ! start_postgres; then
+    echo "test.sh: could not start a local Postgres server" >>"$LOG"
+    export RELAY_POSTGRES_DSN="host=/nonexistent user=micasa dbname=postgres sslmode=disable"
+  fi
+  go test -count=1 -timeout 30m -v -run "$NEW_TESTS" ./cmd/micasa >>"$LOG" 2>&1
+else
+  OVERLAY="$(mktemp)"
+  {
+    printf '{"Replace":{'
+    SEP=""
+    for f in $NEW_FILES; do
+      printf '%s"%s":""' "$SEP" "$PWD/$f"
+      SEP=","
+    done
+    printf '}}'
+  } >"$OVERLAY"
+  go test -count=1 -v -overlay "$OVERLAY" \
+    ./internal/data/... ./internal/sync/... ./internal/relay/... ./cmd/micasa/... >>"$LOG" 2>&1
+fi
+STATUS=$?
+if [ "${#PG_STOP[@]}" -gt 0 ]; then
+  "${PG_STOP[@]}" >/dev/null 2>&1
+fi
+
+go-junit-report -set-exit-code <"$LOG" >"$OUTPUT_PATH"
+sed -i -e ':a' -e 's/::/:/g' -e 'ta' "$OUTPUT_PATH"
+
+DIAG="$(tail -c 4000 "$LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+
+MISSING=""
+if [ "$MODE" = "new" ]; then
+  for f in $NEW_FILES; do
+    pkg="github.com/micasa-dev/micasa/$(dirname "$f")"
+    for name in $(sed -n 's/^func \(Test[A-Za-z0-9_]*\)(t \*testing.T) {$/\1/p' "$f" 2>/dev/null); do
+      grep -q "name=\"$name\"" "$OUTPUT_PATH" || MISSING="$MISSING $pkg:$name"
+    done
+  done
+fi
+
+if [ -n "$MISSING" ] && grep -q '<testcase' "$OUTPUT_PATH" && grep -q '</testsuites>' "$OUTPUT_PATH"; then
+  REPORT="$(mktemp)"
+  {
+    sed '/<\/testsuites>/d' "$OUTPUT_PATH"
+    echo '<testsuite name="micasa-unreported">'
+    for entry in $MISSING; do
+      echo "<testcase classname=\"${entry%%:*}\" name=\"${entry#*:}\"><failure message=\"go test did not report this test\">$DIAG</failure></testcase>"
+    done
+    echo '</testsuite>'
+    echo '</testsuites>'
+  } >"$REPORT"
+  mv "$REPORT" "$OUTPUT_PATH"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+elif [ -n "$MISSING" ] || ! grep -q '<testcase' "$OUTPUT_PATH" || { [ "$STATUS" -ne 0 ] && ! grep -qE '<failure|<error' "$OUTPUT_PATH"; }; then
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    echo "<testsuite name=\"micasa-$MODE\">"
+    if [ "$MODE" = "new" ]; then
+      for f in $NEW_FILES; do
+        pkg="github.com/micasa-dev/micasa/$(dirname "$f")"
+        for name in $(sed -n 's/^func \(Test[A-Za-z0-9_]*\)(t \*testing.T) {$/\1/p' "$f" 2>/dev/null); do
+          echo "<testcase classname=\"$pkg\" name=\"$name\"><failure message=\"go test did not report this test\">$DIAG</failure></testcase>"
+        done
+      done
+    else
+      echo "<testcase classname=\"micasa\" name=\"go test\"><failure message=\"go test produced no results\">$DIAG</failure></testcase>"
+    fi
+    echo '</testsuite>'
+    echo '</testsuites>'
+  } >"$OUTPUT_PATH"
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -f "$LOG" "${OVERLAY:-}"
+exit "$STATUS"
