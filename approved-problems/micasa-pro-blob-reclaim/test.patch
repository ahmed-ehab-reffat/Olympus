+type reclaimRelayF908dd interface {
+	CreateHousehold(
+		ctx context.Context,
+		req sync.CreateHouseholdRequest,
+	) (sync.CreateHouseholdResponse, error)
+	RegisterDevice(
+		ctx context.Context,
+		req sync.RegisterDeviceRequest,
+	) (sync.RegisterDeviceResponse, error)
+	HasBlob(ctx context.Context, householdID, hash string) (bool, error)
+	BlobUsage(ctx context.Context, householdID string) (int64, error)
+	RevokeDevice(ctx context.Context, householdID, deviceID string) error
+}
+
+type reclaimHouseholdF908dd struct {
+	t           *testing.T
+	relay       reclaimRelayF908dd
+	url         string
+	householdID string
+	key         crypto.HouseholdKey
+	failGets    atomic.Bool
+	maxBody     atomic.Int64
+	traffic     atomic.Int64
+	cutOff      atomic.Pointer[cutOffF908dd]
+	lostReplies atomic.Pointer[string]
+}
+
+type cutOffF908dd struct {
+	token string
+	after int64
+	sent  atomic.Int64
+}
+
+type countingListenerF908dd struct {
+	net.Listener
+
+	n *atomic.Int64
+}
+
+func (l countingListenerF908dd) Accept() (net.Conn, error) {
+	conn, err := l.Listener.Accept()
+	if err != nil {
+		return nil, err //nolint:wrapcheck // http.Server inspects accept errors as returned
+	}
+	return countingConnF908dd{Conn: conn, n: l.n}, nil
+}
+
+type countingConnF908dd struct {
+	net.Conn
+
+	n *atomic.Int64
+}
+
+func (c countingConnF908dd) Read(p []byte) (int, error) {
+	n, err := c.Conn.Read(p)
+	c.n.Add(int64(n))
+	return n, err //nolint:wrapcheck // http.Server compares read errors with io.EOF
+}
+
+func (c countingConnF908dd) Write(p []byte) (int, error) {
+	n, err := c.Conn.Write(p)
+	c.n.Add(int64(n))
+	return n, err //nolint:wrapcheck // passed through to http.Server unchanged
+}
