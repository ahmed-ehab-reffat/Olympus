+// DocumentChecksums returns the distinct file checksums of every document,
+// including soft-deleted ones and ones whose file has not been downloaded.
+func (s *Store) DocumentChecksums() ([]string, error) {
+	var sums []string
+	err := s.db.Unscoped().Model(&Document{}).
+		Where(ColChecksumSHA256+" != ''").
+		Distinct(ColChecksumSHA256).
+		Order(ColChecksumSHA256).
+		Pluck(ColChecksumSHA256, &sums).Error
+	return sums, err
+}
+
+// StoredBlobDocuments returns documents whose file bytes are stored
+// locally, without loading the bytes. Soft-deleted documents are included
+// because they can be restored.
+func (s *Store) StoredBlobDocuments() ([]Document, error) {
+	var docs []Document
+	err := s.db.Unscoped().Select(listDocumentColumns).
+		Where("sha256 != '' AND data IS NOT NULL").
+		Order("updated_at DESC, id DESC").
+		Find(&docs).Error
+	return docs, err
+}
+
+// DocumentData returns the file bytes of a document, including a
+// soft-deleted one. It returns nil when the bytes are not stored locally.
+func (s *Store) DocumentData(id string) ([]byte, error) {
+	var doc Document
+	err := s.db.Unscoped().Select(ColData).Where(ColID+" = ?", id).First(&doc).Error
+	return doc.Data, err
+}
