+		report := pgBlobReport{
+			DeviceID:    deviceID,
+			HouseholdID: householdID,
+			Seq:         hh.SeqCounter,
+			Version:     version,
+			Hashes:      slices.Sorted(maps.Keys(set)),
+		}
+		return tx.Clauses(clause.OnConflict{
+			Columns: []clause.Column{{Name: "device_id"}},
+			DoUpdates: clause.AssignmentColumns(
+				[]string{"seq", "version", "hashes", "updated_at"},
+			),
+		}).Create(&report).Error
