+func (s *PgStore) ReclaimBlobs(
+	ctx context.Context,
+	householdID string,
+) (sync.ReclaimResult, error) {
+	var result sync.ReclaimResult
+	err := s.rls.Tx(ctx, householdID, func(tx *gorm.DB) error {
+		// Lock the household row so no push, upload or device registration
+		// interleaves with the freshness check and the sweep.
+		if err := tx.Model(&pgHousehold{}).
+			Clauses(clause.Locking{Strength: lockStrengthUpdate}).
+			Where("id = ?", householdID).
+			First(&pgHousehold{}).Error; err != nil {
+			return fmt.Errorf("lock household for reclaim: %w", err)
+		}
+
+		var devices []pgDevice
+		if err := tx.Where("household_id = ? AND revoked = false", householdID).
+			Find(&devices).Error; err != nil {
+			return fmt.Errorf("list devices: %w", err)
+		}
+		var pushes []struct {
+			DeviceID string
+			Seq      int64
+		}
+		if err := tx.Model(&pgOp{}).
+			Select("device_id, MAX(seq) AS seq").
+			Where("household_id = ?", householdID).
+			Group("device_id").
+			Scan(&pushes).Error; err != nil {
+			return fmt.Errorf("last pushes: %w", err)
+		}
+		lastPush := make(map[string]int64, len(pushes))
+		for _, p := range pushes {
+			lastPush[p.DeviceID] = p.Seq
+		}
+		var reports []pgBlobReport
+		if err := tx.Where("household_id = ?", householdID).Find(&reports).Error; err != nil {
+			return fmt.Errorf("list blob reports: %w", err)
+		}
+		byDevice := make(map[string]pgBlobReport, len(reports))
+		for _, r := range reports {
+			byDevice[r.DeviceID] = r
+		}
+
+		inUse := make(map[string]struct{})
+		for _, d := range devices {
+			report, ok := byDevice[d.ID]
+			if !ok || report.Seq < lastPush[d.ID] {
+				result.Waiting = append(result.Waiting, pgDeviceToSync(d))
+				continue
+			}
+			for _, h := range report.Hashes {
+				inUse[h] = struct{}{}
+			}
+		}
+		sortDevicesByName(result.Waiting)
+
+		if len(result.Waiting) == 0 {
+			var stored []pgBlob
+			if err := tx.Select("hash, size_bytes").
+				Where("household_id = ?", householdID).
+				Find(&stored).Error; err != nil {
+				return fmt.Errorf("list blobs: %w", err)
+			}
+			var unused []string
+			for _, b := range stored {
+				if _, ok := inUse[b.Hash]; ok {
+					continue
+				}
+				unused = append(unused, b.Hash)
+				result.FreedBytes += b.SizeBytes
+			}
+			if len(unused) > 0 {
+				if err := tx.Where("household_id = ? AND hash IN ?", householdID, unused).
+					Delete(&pgBlob{}).Error; err != nil {
+					return fmt.Errorf("delete blobs: %w", err)
+				}
+			}
+			result.Removed = len(unused)
+		}
+
+		return tx.Model(&pgBlob{}).
+			Where("household_id = ?", householdID).
+			Select("COALESCE(SUM(size_bytes), 0)").
+			Scan(&result.UsedBytes).Error
+	})
+	if err != nil {
+		return sync.ReclaimResult{}, fmt.Errorf("reclaim blobs: %w", err)
+	}
+	return result, nil
+}
+
