+				return fmt.Errorf("device %s not found", deviceID)
+			}
+			return fmt.Errorf("find device: %w", err)
+		}
+		pending, err := accumulateReportParts(tx, householdID, deviceID, part)
+		if err != nil {
+			return err
+		}
+		if !part.Final {
+			return nil
