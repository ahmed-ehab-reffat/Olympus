+func runProStorageReclaim(dbPath string) error {
+	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt)
+	defer stop()
+
+	deps, err := resolveProDeps(dbPath)
+	if err != nil {
+		return err
+	}
+	defer func() { _ = deps.store.Close() }()
+
+	client := sync.NewClient(deps.device.RelayURL, deps.token, deps.key)
+	engine := sync.NewEngine(deps.store, client, deps.device.HouseholdID)
+	result, synced, err := engine.Reclaim(ctx)
+	if err != nil {
+		return err
+	}
+	if synced.BlobErrs > 0 {
+		fmt.Fprintf(os.Stderr, "warning: %d blob operation(s) failed\n", synced.BlobErrs)
+	}
+
+	if len(result.Waiting) > 0 {
+		names := make([]string, 0, len(result.Waiting))
+		for _, d := range result.Waiting {
+			names = append(names, d.Name)
+		}
+		fmt.Printf("waiting for: %s\n", strings.Join(names, ", "))
+		return nil
+	}
+
+	status, err := client.Status(ctx)
+	if err != nil {
+		return fmt.Errorf("fetch status: %w", err)
+	}
+	fmt.Printf(
+		"removed %d files, freed %s\n",
+		result.Removed,
+		formatBytes(result.FreedBytes),
+	)
+	fmt.Printf(
+		"storage:   %s\n",
+		formatStorageUsage(result.UsedBytes, status.BlobStorage.QuotaBytes),
+	)
+	return nil
+}
