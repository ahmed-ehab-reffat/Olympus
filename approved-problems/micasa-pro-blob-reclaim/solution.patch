+func (h *Handler) handleReportBlobsInUse(
+	w http.ResponseWriter,
+	r *http.Request,
+	dev sync.Device,
+) {
+	hhID := r.PathValue("id")
+	if dev.HouseholdID != hhID {
+		writeError(w, http.StatusForbidden, "device does not belong to this household")
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, maxRequestBody)
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		if _, ok := errors.AsType[*http.MaxBytesError](err); ok {
+			writeError(w, http.StatusRequestEntityTooLarge, "report body exceeds maximum size")
+		} else {
+			writeError(w, http.StatusBadRequest, "read body failed")
+		}
+		return
+	}
+	var req sync.BlobReportRequest
+	if err := json.Unmarshal(body, &req); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid request body")
+		return
+	}
+	if req.ReportID == "" || len(req.ReportID) > maxReportIDLen {
+		writeError(w, http.StatusBadRequest, "report_id is required")
+		return
+	}
+	for _, hash := range slices.Concat(req.Hashes, req.Removed) {
+		if !validSHA256Hash(hash) {
+			writeError(
+				w,
+				http.StatusBadRequest,
+				"invalid hash: must be 64 lowercase hex characters",
+			)
+			return
+		}
+	}
+	version, err := h.store.ReportBlobsInUse(r.Context(), hhID, dev.ID, req)
+	if errors.Is(err, ErrStaleReportBase) {
+		writeError(w, http.StatusConflict, "report base is out of date; send the full report")
+		return
+	}
+	if err != nil {
+		h.log.Error("report blobs in use", "error", err, "device_id", dev.ID)
+		writeError(w, http.StatusInternalServerError, "report blobs failed")
+		return
+	}
+	writeJSON(w, http.StatusOK, sync.BlobReportResponse{Version: version})
+}
+
+func (h *Handler) handleReclaimBlobs(
+	w http.ResponseWriter,
+	r *http.Request,
+	dev sync.Device,
+) {
+	hhID := r.PathValue("id")
+	if dev.HouseholdID != hhID {
+		writeError(w, http.StatusForbidden, "device does not belong to this household")
+		return
+	}
+	result, err := h.store.ReclaimBlobs(r.Context(), hhID)
+	if err != nil {
+		h.log.Error("reclaim blobs", "error", err)
+		writeError(w, http.StatusInternalServerError, "reclaim blobs failed")
+		return
+	}
+	if result.Waiting == nil {
+		result.Waiting = []sync.Device{}
+	}
+	writeJSON(w, http.StatusOK, result)
+}
