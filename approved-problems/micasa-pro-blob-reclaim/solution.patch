+// BlobReport is the in-use report the relay last confirmed for this
+// device: its version and its sorted hashes. Version 0 means none.
+type BlobReport struct {
+	Version int64
+	Hashes  []string
+}
+
+// ReportBlobsInUse tells the relay which blobs this device's documents
+// still use, in as many parts as needed. When prev holds a confirmed
+// report, only the hashes added and removed since then are sent, falling
+// back to the full list if the relay holds another version. The relay
