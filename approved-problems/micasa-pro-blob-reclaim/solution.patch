+	endpoint, err := url.JoinPath(c.baseURL, "households", householdID, "blobs", action)
+	if err != nil {
+		return fmt.Errorf("construct blobs %s URL: %w", action, err)
+	}
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return fmt.Errorf("marshal blobs %s request: %w", action, err)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(payload))
+	if err != nil {
+		return fmt.Errorf("create blobs %s request: %w", action, err)
+	}
+	req.Header.Set("Authorization", "Bearer "+c.token)
+	req.Header.Set("Content-Type", "application/json")
+
+	resp, err := c.http.Do(req)
+	if err != nil {
+		return fmt.Errorf("blobs %s request: %w", action, err)
+	}
+	defer func() { _ = resp.Body.Close() }()
+
+	if resp.StatusCode == http.StatusConflict {
+		return errStaleReportBase
+	}
+	if resp.StatusCode != http.StatusOK {
+		respBody := readErrorBody(resp.Body)
+		return fmt.Errorf("blobs %s failed (status %d): %s", action, resp.StatusCode, respBody)
+	}
+	if out == nil {
+		return nil
+	}
+	if err := json.NewDecoder(resp.Body).Decode(out); err != nil {
+		return fmt.Errorf("decode blobs %s response: %w", action, err)
+	}
+	return nil
+}
