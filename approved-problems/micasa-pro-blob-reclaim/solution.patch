+// arrived. hashes must be sorted; the confirmed report is returned.
+func (c *Client) ReportBlobsInUse(
+	ctx context.Context,
+	householdID string,
+	hashes []string,
+	prev BlobReport,
+) (BlobReport, error) {
+	if prev.Version > 0 {
+		added, removed := diffSortedHashes(prev.Hashes, hashes)
+		version, err := c.sendBlobReport(ctx, householdID, prev.Version, added, removed)
+		if err == nil {
+			return BlobReport{Version: version, Hashes: hashes}, nil
+		}
+		if !errors.Is(err, errStaleReportBase) {
+			return BlobReport{}, err
