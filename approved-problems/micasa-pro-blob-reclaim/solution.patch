+		return false, fmt.Errorf("check blob on relay: %w", err)
+	}
+	if exists {
+		return false, nil
+	}
+	content, err := e.store.DocumentData(docID)
+	if err != nil {
+		return false, fmt.Errorf("load document %s: %w", docID, err)
+	}
+	if content == nil {
+		return false, nil
+	}
+	if err := e.client.UploadBlob(ctx, e.householdID, hash, content); err != nil {
+		return false, err
+	}
+	return true, nil
+}
