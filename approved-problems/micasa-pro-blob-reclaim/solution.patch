+// accumulateReportParts adds part to the device's unfinished report and
+// returns everything collected so far. A final part removes the unfinished
+// report; other parts store it for the next request.
+func accumulateReportParts(
+	tx *gorm.DB,
+	householdID, deviceID string,
+	part sync.BlobReportRequest,
+) (pgBlobReportPart, error) {
+	var stored pgBlobReportPart
+	if err := tx.Where("device_id = ?", deviceID).Limit(1).Find(&stored).Error; err != nil {
+		return pgBlobReportPart{}, fmt.Errorf("read report parts: %w", err)
+	}
+	pending := pgBlobReportPart{
+		DeviceID:    deviceID,
+		HouseholdID: householdID,
+		ReportID:    part.ReportID,
+		Hashes:      []string{},
+	}
+	if stored.ReportID == part.ReportID {
+		pending.Hashes = append(pending.Hashes, stored.Hashes...)
+		pending.Removed = append(pending.Removed, stored.Removed...)
+	}
+	pending.Hashes = append(pending.Hashes, part.Hashes...)
+	pending.Removed = append(pending.Removed, part.Removed...)
+
+	if part.Final {
+		if err := tx.Where("device_id = ?", deviceID).
+			Delete(&pgBlobReportPart{}).Error; err != nil {
+			return pgBlobReportPart{}, fmt.Errorf("clear report parts: %w", err)
+		}
+		return pending, nil
+	}
+	if err := tx.Clauses(clause.OnConflict{
+		Columns:   []clause.Column{{Name: "device_id"}},
+		DoUpdates: clause.AssignmentColumns([]string{"report_id", "hashes", "removed"}),
+	}).Create(&pending).Error; err != nil {
+		return pgBlobReportPart{}, fmt.Errorf("store report parts: %w", err)
+	}
