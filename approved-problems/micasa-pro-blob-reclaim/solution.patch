+func (c *Client) sendBlobReport(
+	ctx context.Context,
+	householdID string,
+	base int64,
+	added, removed []string,
+) (int64, error) {
+	reportID := uid.New()
+	for {
+		n := min(len(added), blobReportPartSize)
+		m := min(len(removed), blobReportPartSize-n)
+		part := BlobReportRequest{
+			ReportID: reportID,
+			Base:     base,
+			Hashes:   slices.Clip(added[:n]),
+			Removed:  slices.Clip(removed[:m]),
+			Final:    n == len(added) && m == len(removed),
+		}
+		if part.Hashes == nil {
+			part.Hashes = []string{}
+		}
+		added, removed = added[n:], removed[m:]
+		var resp BlobReportResponse
+		if err := c.postBlobs(ctx, householdID, "in-use", part, &resp); err != nil {
+			return 0, err
+		}
+		if part.Final {
+			return resp.Version, nil
+		}
+	}
