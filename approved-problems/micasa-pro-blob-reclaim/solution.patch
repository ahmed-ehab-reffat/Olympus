+func (m *MemStore) ReportBlobsInUse(
+	_ context.Context,
+	householdID, deviceID string,
+	part sync.BlobReportRequest,
+) (int64, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	rec, ok := m.devices[deviceID]
+	if !ok || rec.revoked || rec.device.HouseholdID != householdID {
+		return 0, fmt.Errorf("device %s not found", deviceID)
+	}
+	pending := m.reportParts[deviceID]
+	if pending.id != part.ReportID {
+		pending = blobReportParts{id: part.ReportID}
+	}
+	pending.hashes = append(pending.hashes, part.Hashes...)
+	pending.removed = append(pending.removed, part.Removed...)
+	if !part.Final {
+		m.reportParts[deviceID] = pending
+		return 0, nil
+	}
+	delete(m.reportParts, deviceID)
+	prev := m.reports[deviceID]
+	set := make(map[string]struct{}, len(pending.hashes))
+	if part.Base != 0 {
+		if prev.version != part.Base {
+			return 0, ErrStaleReportBase
+		}
+		maps.Copy(set, prev.hashes)
+		for _, h := range pending.removed {
+			delete(set, h)
+		}
+	}
+	for _, h := range pending.hashes {
+		set[h] = struct{}{}
+	}
+	version := prev.version + 1
+	m.reports[deviceID] = blobReport{seq: m.seqs[householdID], version: version, hashes: set}
+	return version, nil
+}
+
+func (m *MemStore) ReclaimBlobs(
+	_ context.Context,
+	householdID string,
+) (sync.ReclaimResult, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+
+	if _, ok := m.households[householdID]; !ok {
+		return sync.ReclaimResult{}, fmt.Errorf("household %s not found", householdID)
+	}
+
+	var result sync.ReclaimResult
+	inUse := make(map[string]struct{})
+	for _, rec := range m.devices {
+		if rec.revoked || rec.device.HouseholdID != householdID {
+			continue
+		}
+		report, ok := m.reports[rec.device.ID]
+		if !ok || report.seq < m.pushSeqs[rec.device.ID] {
+			result.Waiting = append(result.Waiting, rec.device)
+			continue
+		}
+		for h := range report.hashes {
+			inUse[h] = struct{}{}
+		}
+	}
+	sortDevicesByName(result.Waiting)
+
+	blobs := m.blobs[householdID]
+	if len(result.Waiting) == 0 {
+		for hash, data := range blobs {
+			if _, ok := inUse[hash]; ok {
+				continue
+			}
+			result.Removed++
+			result.FreedBytes += int64(len(data))
+			delete(blobs, hash)
+		}
+	}
+	for _, data := range blobs {
+		result.UsedBytes += int64(len(data))
+	}
+	return result, nil
+}
+
+func sortDevicesByName(devices []sync.Device) {
+	slices.SortFunc(devices, func(a, b sync.Device) int {
+		return cmp.Or(cmp.Compare(a.Name, b.Name), cmp.Compare(a.ID, b.ID))
+	})
+}
