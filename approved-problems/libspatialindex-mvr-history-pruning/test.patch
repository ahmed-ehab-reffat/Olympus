+void loadDiskWorkload(SpatialIndex::ISpatialIndex& tree) {
+    for (int i = 0; i < 200; ++i) {
+        Box b = {(i % 20) * 0.05, (i / 20) * 0.05, (i % 20) * 0.05 + 0.01, (i / 20) * 0.05 + 0.01};
+        std::string data = Scene::payload(i, i + 1.0);
+        tree.insertData(static_cast<uint32_t>(data.size()), reinterpret_cast<const uint8_t*>(data.data()), timeRegion(b, i + 1.0, i + 1.0), i);
+    }
+    for (int i = 0; i < 100; ++i) {
+        Box b = {(i % 20) * 0.05, (i / 20) * 0.05, (i % 20) * 0.05 + 0.01, (i / 20) * 0.05 + 0.01};
+        ASSERT_TRUE(tree.deleteData(timeRegion(b, i + 1.0, 201.0 + i), i));
+    }
+}
+
+std::set<id_type> queryIds(SpatialIndex::ISpatialIndex& tree, double from, double to) {
+    Box everywhere = {-1.0, -1.0, 2.0, 2.0};
+    IdCollector c;
+    tree.intersectsWithQuery(timeRegion(everywhere, from, to), c);
+    return c.m_ids;
+}
