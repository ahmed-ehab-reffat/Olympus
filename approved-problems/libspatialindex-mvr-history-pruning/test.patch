index 0000000..763f60c
--- /dev/null
+++ b/test/gtest/MVRTreeHistory_d82da1.cpp
@@ -0,0 +1,1398 @@
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <map>
+#include <memory>
+#include <set>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+#include <spatialindex/SpatialIndex.h>
+
+#include "test.h"
+
+namespace {
+
+using SpatialIndex::id_type;
+
+const double kOpen = std::numeric_limits<double>::max();
+const double kNoHorizon = -std::numeric_limits<double>::max();
+
+struct Box {
+    double xmin;
+    double ymin;
+    double xmax;
+    double ymax;
+
+    bool intersects(const Box& o) const {
+        return !(xmin > o.xmax || xmax < o.xmin || ymin > o.ymax || ymax < o.ymin);
+    }
+
+    bool contains(const Box& o) const {
+        return xmin <= o.xmin && ymin <= o.ymin && xmax >= o.xmax && ymax >= o.ymax;
+    }
+
+    bool operator==(const Box& o) const {
+        return xmin == o.xmin && ymin == o.ymin && xmax == o.xmax && ymax == o.ymax;
+    }
+};
+
+struct Version {
+    id_type id;
+    Box box;
+    double start;
+    double end;
+    std::string data;
+};
+
+typedef std::tuple<id_type, double, double, double, double, double, double, std::string> ArchivedVersion;
+
+class RecordingStorage : public SpatialIndex::IStorageManager {
+public:
+    explicit RecordingStorage(SpatialIndex::IStorageManager* inner) : m_slack(false), m_inner(inner) {}
+
+    void loadByteArray(const id_type id, uint32_t& len, uint8_t** data) override {
+        m_inner->loadByteArray(id, len, data);
+        if (!m_slack) return;
+        uint8_t* padded = new uint8_t[len + 32];
+        std::memcpy(padded, *data, len);
+        std::memset(padded + len, 0x41, 32);
+        delete[] *data;
+        *data = padded;
+    }
+
+    void storeByteArray(id_type& id, const uint32_t len, const uint8_t* const data) override {
+        m_inner->storeByteArray(id, len, data);
+        m_pages.insert(id);
+        m_written.push_back(id);
+    }
+
+    void deleteByteArray(const id_type id) override {
+        m_inner->deleteByteArray(id);
+        m_pages.erase(id);
+        m_deleted.insert(id);
+    }
+
+    void flush() override {
+        m_inner->flush();
+    }
+
+    std::set<id_type> m_pages;
+    std::set<id_type> m_deleted;
+    std::vector<id_type> m_written;
+    bool m_slack;
+
+private:
+    std::unique_ptr<SpatialIndex::IStorageManager> m_inner;
+};
+
+struct ChildRef {
+    id_type id;
+    double start;
+    double end;
+    Box box;
+};
+
+struct PageInfo {
+    uint32_t level;
+    double start;
+    double end;
+    Box box;
+    std::vector<ChildRef> children;
+};
+
+class PageReader : public SpatialIndex::IQueryStrategy {
+public:
+    explicit PageReader(const std::vector<id_type>& ids) : m_ids(ids), m_next(0) {}
+
+    void getNextEntry(const SpatialIndex::IEntry& entry, id_type& next, bool& hasNext) override {
+        const SpatialIndex::INode* node = dynamic_cast<const SpatialIndex::INode*>(&entry);
+        if (node != nullptr) {
+            PageInfo info;
+            info.level = node->getLevel();
+            SpatialIndex::IShape* shape;
+            node->getShape(&shape);
+            const SpatialIndex::TimeRegion* region = dynamic_cast<const SpatialIndex::TimeRegion*>(shape);
+            info.start = region->m_startTime;
+            info.end = region->m_endTime;
+            Box box = {region->m_pLow[0], region->m_pLow[1], region->m_pHigh[0], region->m_pHigh[1]};
+            info.box = box;
+            delete shape;
+            for (uint32_t i = 0; i < node->getChildrenCount(); ++i) {
+                SpatialIndex::IShape* childShape;
+                node->getChildShape(i, &childShape);
+                const SpatialIndex::TimeRegion* child = dynamic_cast<const SpatialIndex::TimeRegion*>(childShape);
+                Box childBox = {child->m_pLow[0], child->m_pLow[1], child->m_pHigh[0], child->m_pHigh[1]};
+                ChildRef ref = {node->getChildIdentifier(i), child->m_startTime, child->m_endTime, childBox};
+                info.children.push_back(ref);
+                delete childShape;
+            }
+            m_pages[node->getIdentifier()] = info;
+        }
+        hasNext = m_next < m_ids.size();
+        if (hasNext) next = m_ids[m_next++];
+    }
+
+    std::map<id_type, PageInfo> m_pages;
+
+private:
+    std::vector<id_type> m_ids;
+    size_t m_next;
+};
+
+class ArchiveVisitor : public SpatialIndex::IVisitor {
+public:
+    void visitNode(const SpatialIndex::INode&) override {}
+
+    void visitData(const SpatialIndex::IData& d) override {
+        SpatialIndex::IShape* shape;
+        d.getShape(&shape);
+        const SpatialIndex::TimeRegion* r = dynamic_cast<const SpatialIndex::TimeRegion*>(shape);
+        uint32_t len;
+        uint8_t* bytes;
+        d.getData(len, &bytes);
+        std::string data(reinterpret_cast<char*>(bytes), len);
+        delete[] bytes;
+        m_versions.push_back(ArchivedVersion(
+            d.getIdentifier(), r->m_pLow[0], r->m_pLow[1], r->m_pHigh[0], r->m_pHigh[1],
+            r->m_startTime, r->m_endTime, data));
+        delete shape;
+    }
+
+    void visitData(std::vector<const SpatialIndex::IData*>&) override {}
+
+    std::vector<ArchivedVersion> m_versions;
+};
+
+class RegionArchive : public SpatialIndex::IVisitor {
+public:
+    void visitNode(const SpatialIndex::INode&) override {}
+
+    void visitData(const SpatialIndex::IData& d) override {
+        SpatialIndex::IShape* shape;
+        d.getShape(&shape);
+        const SpatialIndex::TimeRegion* r = dynamic_cast<const SpatialIndex::TimeRegion*>(shape);
+        std::vector<double> coords(r->m_pLow, r->m_pLow + r->m_dimension);
+        coords.insert(coords.end(), r->m_pHigh, r->m_pHigh + r->m_dimension);
+        m_versions.push_back(std::make_tuple(d.getIdentifier(), coords, r->m_startTime, r->m_endTime));
+        delete shape;
+    }
+
+    void visitData(std::vector<const SpatialIndex::IData*>&) override {}
+
+    std::vector<std::tuple<id_type, std::vector<double>, double, double> > m_versions;
+};
+
+class IdCollector : public SpatialIndex::IVisitor {
+public:
+    void visitNode(const SpatialIndex::INode&) override {}
+
+    void visitData(const SpatialIndex::IData& d) override {
+        m_ids.insert(d.getIdentifier());
+    }
+
+    void visitData(std::vector<const SpatialIndex::IData*>&) override {}
+
+    std::set<id_type> m_ids;
+};
+
+class Random {
+public:
+    explicit Random(uint32_t seed) : m_state(seed * 2654435761u + 12345u) {}
+
+    uint32_t next() {
+        m_state = m_state * 1103515245u + 12345u;
+        return (m_state >> 8) & 0xffffffu;
+    }
+
+    double unit() {
+        return static_cast<double>(next() % 1000000u) / 1000000.0;
+    }
+
+private:
+    uint32_t m_state;
+};
+
+SpatialIndex::TimeRegion timeRegion(const Box& b, double start, double end) {
+    double low[2] = {b.xmin, b.ymin};
+    double high[2] = {b.xmax, b.ymax};
+    return SpatialIndex::TimeRegion(low, high, start, end, 2);
+}
+
+class Scene {
+public:
+    Scene(uint32_t seed, uint32_t capacity)
+        : m_storage(new RecordingStorage(SpatialIndex::StorageManager::createNewMemoryStorageManager())),
+          m_random(seed), m_time(0.0), m_nextId(1) {
+        m_tree.reset(SpatialIndex::MVRTree::createNewMVRTree(
+            *m_storage, 0.7, capacity, capacity, 2, SpatialIndex::MVRTree::RV_RSTAR, m_header));
+    }
+
+    Scene(uint32_t seed, uint32_t indexCapacity, uint32_t leafCapacity, SpatialIndex::MVRTree::MVRTreeVariant variant)
+        : m_storage(new RecordingStorage(SpatialIndex::StorageManager::createNewMemoryStorageManager())),
+          m_random(seed), m_time(0.0), m_nextId(1) {
+        m_tree.reset(SpatialIndex::MVRTree::createNewMVRTree(
+            *m_storage, 0.7, indexCapacity, leafCapacity, 2, variant, m_header));
+    }
+
+    void reopen(Tools::PropertySet ps) {
+        m_tree.reset();
+        Tools::Variant id;
+        id.m_varType = Tools::VT_LONGLONG;
+        id.m_val.llVal = m_header;
+        ps.setProperty("IndexIdentifier", id);
+        m_tree.reset(SpatialIndex::MVRTree::returnMVRTree(*m_storage, ps));
+    }
+
+    static Tools::Variant ulongValue(uint32_t value) {
+        Tools::Variant var;
+        var.m_varType = Tools::VT_ULONG;
+        var.m_val.ulVal = value;
+        return var;
+    }
+
+    void insert(id_type id, const Box& b) {
+        insert(id, b, payload(id, m_time + 1.0));
+    }
+
+    void insert(id_type id, const Box& b, const std::string& data) {
+        m_time += 1.0;
+        Version v = {id, b, m_time, kOpen, data};
+        m_tree->insertData(static_cast<uint32_t>(v.data.size()), reinterpret_cast<const uint8_t*>(v.data.data()),
+                           timeRegion(b, m_time, m_time), id);
+        m_live[id] = m_history.size();
+        m_history.push_back(v);
+    }
+
+    void insertAtCurrentTime(id_type id, const Box& b) {
+        m_time -= 1.0;
+        insert(id, b);
+    }
+
+    void remove(id_type id) {
+        m_time += 1.0;
+        Version& v = m_history[m_live[id]];
+        ASSERT_TRUE(m_tree->deleteData(timeRegion(v.box, v.start, m_time), id));
+        v.end = m_time;
+        m_live.erase(id);
+    }
+
+    void reinsert(id_type id) {
+        m_time += 1.0;
+        Version previous = m_history[m_live[id]];
+        ASSERT_TRUE(m_tree->deleteData(timeRegion(previous.box, previous.start, m_time), id));
+        m_history[m_live[id]].end = m_time;
+        Version v = {id, previous.box, m_time, kOpen, previous.data};
+        m_tree->insertData(static_cast<uint32_t>(v.data.size()), reinterpret_cast<const uint8_t*>(v.data.data()),
+                           timeRegion(v.box, m_time, m_time), id);
+        m_live[id] = m_history.size();
+        m_history.push_back(v);
+    }
+
+    void run(uint32_t steps) {
+        for (uint32_t i = 0; i < steps; ++i) {
+            if (m_live.size() > 6 && m_random.unit() < 0.45) {
+                std::map<id_type, size_t>::iterator it = m_live.begin();
+                std::advance(it, m_random.next() % m_live.size());
+                if (m_pinned.count(it->first)) continue;
+                remove(it->first);
+            } else if (m_reuse > 0.0 && m_random.unit() < m_reuse) {
+                std::set<id_type> open;
+                for (size_t v = 0; v < m_history.size(); ++v) {
+                    if (m_history[v].end == kOpen) open.insert(m_history[v].id);
+                }
+                std::vector<size_t> dead;
+                for (size_t v = 0; v < m_history.size(); ++v) {
+                    if (open.count(m_history[v].id) == 0) dead.push_back(v);
+                }
+                if (dead.empty()) continue;
+                Version old = m_history[dead[m_random.next() % dead.size()]];
+                insert(old.id, old.box, old.data);
+            } else {
+                double x = m_random.unit() * 0.95;
+                double y = m_random.unit() * 0.95;
+                double w = m_random.unit() * 0.05;
+                Box b = {x, y, x + w, y + w};
+                insert(m_nextId++, b);
+            }
+        }
+    }
+
+    std::map<id_type, PageInfo> walk() {
+        m_tree->flush();
+        std::vector<id_type> ids;
+        for (std::set<id_type>::const_iterator it = m_storage->m_pages.begin(); it != m_storage->m_pages.end(); ++it) {
+            if (*it != m_header) ids.push_back(*it);
+        }
+        PageReader reader(ids);
+        m_tree->queryStrategy(reader);
+        return reader.m_pages;
+    }
+
+    std::set<id_type> pages() const {
+        std::set<id_type> result = m_storage->m_pages;
+        result.erase(m_header);
+        return result;
+    }
+
+    uint32_t nodeCount() {
+        SpatialIndex::IStatistics* stats;
+        m_tree->getStatistics(&stats);
+        uint32_t count = stats->getNumberOfNodes();
+        delete stats;
+        return count;
+    }
+
+    std::set<id_type> query(const Box& b, double start, double end) {
+        IdCollector collector;
+        m_tree->intersectsWithQuery(timeRegion(b, start, end), collector);
+        return collector.m_ids;
+    }
+
+    std::set<id_type> expected(const Box& b, double start, double end, double horizon) const {
+        std::set<id_type> result;
+        if (end <= horizon) return result;
+        double from = std::max(start, horizon);
+        for (size_t i = 0; i < m_history.size(); ++i) {
+            const Version& v = m_history[i];
+            if (v.start < end && v.end > from && b.intersects(v.box)) result.insert(v.id);
+        }
+        return result;
+    }
+
+    std::vector<ArchivedVersion> ended(double horizon, double previous) const {
+        std::vector<ArchivedVersion> result;
+        for (size_t i = 0; i < m_history.size(); ++i) {
+            const Version& v = m_history[i];
+            if (v.end > horizon || v.end <= previous) continue;
+            result.push_back(ArchivedVersion(v.id, v.box.xmin, v.box.ymin, v.box.xmax, v.box.ymax,
+                                             std::max(v.start, previous), v.end, v.data));
+        }
+        std::sort(result.begin(), result.end());
+        return result;
+    }
+
+    static std::string payload(id_type id, double time) {
+        std::ostringstream s;
+        s << "v" << id << "@" << time;
+        return s.str();
+    }
+
+    std::unique_ptr<RecordingStorage> m_storage;
+    std::unique_ptr<SpatialIndex::ISpatialIndex> m_tree;
+    id_type m_header;
+    Random m_random;
+    double m_time;
+    id_type m_nextId;
+    std::vector<Version> m_history;
+    std::map<id_type, size_t> m_live;
+    std::set<id_type> m_pinned;
+    double m_reuse = 0.0;
+};
+
+std::set<id_type> keptPages(const std::map<id_type, PageInfo>& graph, double horizon) {
+    std::set<id_type> referenced;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        if (it->second.level == 0) continue;
+        for (size_t i = 0; i < it->second.children.size(); ++i) referenced.insert(it->second.children[i].id);
+    }
+    std::vector<id_type> stack;
+    std::set<id_type> kept;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        if (referenced.count(it->first) == 0 && it->second.end > horizon) {
+            kept.insert(it->first);
+            stack.push_back(it->first);
+        }
+    }
+    while (!stack.empty()) {
+        const PageInfo& page = graph.at(stack.back());
+        stack.pop_back();
+        if (page.level == 0) continue;
+        for (size_t i = 0; i < page.children.size(); ++i) {
+            const ChildRef& c = page.children[i];
+            if (c.end > horizon && kept.insert(c.id).second) stack.push_back(c.id);
+        }
+    }
+    return kept;
+}
+
+template <typename T>
+void append(std::string& out, T value) {
+    out.append(reinterpret_cast<const char*>(&value), sizeof(T));
+}
+
+std::string legacyPage(const Scene& scene, const PageInfo& page) {
+    std::string out;
+    append<uint32_t>(out, page.level == 0 ? SpatialIndex::MVRTree::PersistentLeaf : SpatialIndex::MVRTree::PersistentIndex);
+    append<uint32_t>(out, page.level);
+    append<uint32_t>(out, static_cast<uint32_t>(page.children.size()));
+    append<double>(out, page.start);
+    append<double>(out, page.end);
+    for (size_t i = 0; i < page.children.size(); ++i) {
+        const ChildRef& c = page.children[i];
+        append<double>(out, c.box.xmin);
+        append<double>(out, c.box.ymin);
+        append<double>(out, c.box.xmax);
+        append<double>(out, c.box.ymax);
+        append<id_type>(out, c.id);
+        append<double>(out, c.start);
+        append<double>(out, c.end);
+        std::string data;
+        if (page.level == 0) {
+            for (size_t v = 0; v < scene.m_history.size(); ++v) {
+                const Version& version = scene.m_history[v];
+                if (version.id == c.id && version.box == c.box && version.start <= c.start && c.start <= version.end) data = version.data;
+            }
+        }
+        append<uint32_t>(out, static_cast<uint32_t>(data.size()));
+        out += data;
+    }
+    append<double>(out, page.box.xmin);
+    append<double>(out, page.box.ymin);
+    append<double>(out, page.box.xmax);
+    append<double>(out, page.box.ymax);
+    return out;
+}
+
+std::string legacyHeader(Scene& scene);
+
+void writeLegacyIndex(Scene& scene) {
+    std::map<id_type, PageInfo> graph = scene.walk();
+    std::string header = legacyHeader(scene);
+    scene.m_tree.reset();
+    scene.m_storage->m_slack = true;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        std::string bytes = legacyPage(scene, it->second);
+        id_type page = it->first;
+        scene.m_storage->storeByteArray(page, static_cast<uint32_t>(bytes.size()), reinterpret_cast<const uint8_t*>(bytes.data()));
+    }
+    id_type page = scene.m_header;
+    scene.m_storage->storeByteArray(page, static_cast<uint32_t>(header.size()), reinterpret_cast<const uint8_t*>(header.data()));
+}
+
+std::string legacyHeader(Scene& scene) {
+    std::map<id_type, PageInfo> graph = scene.walk();
+    std::set<id_type> referenced;
+    std::map<uint32_t, uint32_t> perLevel;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        ++perLevel[it->second.level];
+        if (it->second.level == 0) continue;
+        for (size_t i = 0; i < it->second.children.size(); ++i) referenced.insert(it->second.children[i].id);
+    }
+    std::vector<std::pair<double, id_type> > roots;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        if (referenced.count(it->first) == 0) roots.push_back(std::make_pair(it->second.start, it->first));
+    }
+    std::sort(roots.begin(), roots.end());
+
+    Tools::PropertySet ps;
+    scene.m_tree->getIndexProperties(ps);
+    std::string out;
+    append<uint32_t>(out, static_cast<uint32_t>(roots.size()));
+    for (size_t i = 0; i < roots.size(); ++i) {
+        append<id_type>(out, roots[i].second);
+        append<double>(out, graph[roots[i].second].start);
+        append<double>(out, graph[roots[i].second].end);
+    }
+    append<int32_t>(out, static_cast<int32_t>(ps.getProperty("TreeVariant").m_val.lVal));
+    append<double>(out, ps.getProperty("FillFactor").m_val.dblVal);
+    append<uint32_t>(out, ps.getProperty("IndexCapacity").m_val.ulVal);
+    append<uint32_t>(out, ps.getProperty("LeafCapacity").m_val.ulVal);
+    append<uint32_t>(out, ps.getProperty("NearMinimumOverlapFactor").m_val.ulVal);
+    append<double>(out, ps.getProperty("SplitDistributionFactor").m_val.dblVal);
+    append<double>(out, ps.getProperty("ReinsertFactor").m_val.dblVal);
+    append<uint32_t>(out, ps.getProperty("Dimension").m_val.ulVal);
+    append<uint8_t>(out, ps.getProperty("EnsureTightMBRs").m_val.blVal ? 1 : 0);
+    std::set<id_type> live = keptPages(graph, 1e300);
+    uint32_t deadIndexes = 0;
+    uint32_t deadLeaves = 0;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        if (live.count(it->first) > 0) continue;
+        if (it->second.level == 0) ++deadLeaves; else ++deadIndexes;
+    }
+    append<uint32_t>(out, static_cast<uint32_t>(graph.size()));
+    append<uint64_t>(out, scene.m_history.size());
+    append<uint32_t>(out, deadIndexes);
+    append<uint32_t>(out, deadLeaves);
+    append<uint64_t>(out, scene.m_live.size());
+    append<uint32_t>(out, static_cast<uint32_t>(roots.size()));
+    for (size_t i = 0; i < roots.size(); ++i) append<uint32_t>(out, graph[roots[i].second].level + 1);
+    append<double>(out, ps.getProperty("StrongVersionOverflow").m_val.dblVal);
+    append<double>(out, ps.getProperty("VersionUnderflow").m_val.dblVal);
+    append<double>(out, scene.m_time);
+    append<uint32_t>(out, static_cast<uint32_t>(perLevel.size()));
+    for (std::map<uint32_t, uint32_t>::const_iterator it = perLevel.begin(); it != perLevel.end(); ++it) {
+        append<uint32_t>(out, it->second);
+    }
+    return out;
+}
+
+template <typename T>
+std::vector<T> sorted(std::vector<T> v) {
+    std::sort(v.begin(), v.end());
+    return v;
+}
+
+void expectQueriesMatch(Scene& scene, double horizon, uint32_t seed) {
+    Random r(seed);
+    for (int i = 0; i < 80; ++i) {
+        double x = r.unit() * 0.8;
+        double y = r.unit() * 0.8;
+        double w = 0.05 + r.unit() * 0.3;
+        Box b = {x, y, x + w, y + w};
+        double a = r.unit() * scene.m_time;
+        double e = std::min(scene.m_time, a + r.unit() * scene.m_time * 0.3);
+        if (i % 7 == 0) e = a;
+        EXPECT_EQ(scene.expected(b, a, e, horizon), scene.query(b, a, e)) << "query [" << a << ", " << e << "]";
+    }
+}
+
+uint64_t printedStatistic(const std::string& text, const std::string& label) {
+    size_t at = text.find(label);
+    if (at == std::string::npos) return std::numeric_limits<uint64_t>::max();
+    return std::strtoull(text.c_str() + at + label.size(), nullptr, 10);
+}
+
+void expectStatisticsCountStoredPages(Scene& scene, const std::string& label) {
+    std::map<id_type, PageInfo> graph = scene.walk();
+    std::set<id_type> live = keptPages(graph, 1e300);
+    uint64_t deadLeaves = 0;
+    uint64_t deadIndexes = 0;
+    std::map<uint32_t, uint64_t> perLevel;
+    for (std::map<id_type, PageInfo>::const_iterator it = graph.begin(); it != graph.end(); ++it) {
+        ++perLevel[it->second.level];
+        if (live.count(it->first) > 0) continue;
+        if (it->second.level == 0) ++deadLeaves; else ++deadIndexes;
+    }
+    std::ostringstream printed;
+    printed << *scene.m_tree;
+    std::string text = printed.str();
+    EXPECT_EQ(deadLeaves, printedStatistic(text, "Number of dead leaf nodes: ")) << label;
+    EXPECT_EQ(deadIndexes, printedStatistic(text, "Number of dead index nodes: ")) << label;
+    for (uint32_t level = 0; level < perLevel.size() + 2; ++level) {
+        std::ostringstream key;
+        key << "Level " << level << " pages: ";
+        uint64_t expected = perLevel.count(level) ? perLevel[level] : 0;
+        uint64_t reported = printedStatistic(text, key.str());
+        if (expected == 0 && reported == std::numeric_limits<uint64_t>::max()) continue;
+        EXPECT_EQ(expected, reported) << label << " level " << level;
+    }
+}
