+std::set<id_type> aliveBetween(int from, int to) {
+    std::set<id_type> ids;
+    for (int i = 0; i < 200; ++i) {
+        double start = i + 1.0;
+        double end = i < 100 ? 201.0 + i : kOpen;
+        if (start < to && end > from) ids.insert(i);
+    }
+    return ids;
+}
