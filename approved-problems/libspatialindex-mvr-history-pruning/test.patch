+void expectPruneMatches(Scene& scene, double horizon, double previous, const std::string& label) {
+    std::set<id_type> expectedPages = keptPages(scene.walk(), horizon);
+    ArchiveVisitor archive;
+    SpatialIndex::MVRTree::pruneHistory(*scene.m_tree, horizon, archive);
+    EXPECT_EQ(expectedPages, scene.pages()) << label;
+    EXPECT_EQ(sorted(scene.ended(horizon, previous)), sorted(archive.m_versions)) << label;
+    EXPECT_EQ(scene.pages().size(), scene.nodeCount()) << label;
+    EXPECT_TRUE(scene.m_tree->isIndexValid()) << label;
+    expectStatisticsCountStoredPages(scene, label);
+}
