+void removeDuplicate(Scene& scene, size_t index) {
+    scene.m_time += 1.0;
+    Version& v = scene.m_history[index];
+    ASSERT_TRUE(scene.m_tree->deleteData(timeRegion(v.box, v.start, scene.m_time), v.id));
+    v.end = scene.m_time;
+}
