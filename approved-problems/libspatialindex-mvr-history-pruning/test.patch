+        if (reopen == 1) {
+            tree.reset();
+            tree.reset(SpatialIndex::MVRTree::loadMVRTree(*storage, header));
+        }
+        ArchiveVisitor archive;
+        SpatialIndex::MVRTree::pruneHistory(*tree, 2.0, archive);
+        std::vector<ArchivedVersion> expected;
+        expected.push_back(ArchivedVersion(7, p.xmin, p.ymin, p.xmax, p.ymax, 1.0, 2.0, bytes));
+        EXPECT_EQ(sorted(expected), sorted(archive.m_versions)) << "reopened " << reopen;
+        IdCollector found;
+        tree->intersectsWithQuery(timeRegion(q, 1.0, 3.0), found);
+        EXPECT_EQ(1u, found.m_ids.count(7)) << "reopened " << reopen;
+        EXPECT_TRUE(tree->isIndexValid()) << "reopened " << reopen;
+    }
+}
+
+TEST(MVRTreeHistoryTest, ThreeDimensionalRecordsArchiveAndQueryOnEveryAxis) {
+    std::unique_ptr<SpatialIndex::IStorageManager> storage(SpatialIndex::StorageManager::createNewMemoryStorageManager());
+    id_type header;
+    std::unique_ptr<SpatialIndex::ISpatialIndex> tree(SpatialIndex::MVRTree::createNewMVRTree(
+        *storage, 0.7, 10, 10, 3, SpatialIndex::MVRTree::RV_RSTAR, header));
+    std::vector<std::vector<double> > boxes;
+    std::vector<double> starts;
+    std::vector<double> ends;
+    std::string bytes = "cube";
+    double time = 0.0;
+    for (id_type id = 0; id < 90; ++id) {
+        double x = (id % 9) * 0.1;
+        double y = ((id / 9) % 3) * 0.3;
+        double z = id * 0.01;
+        double low[3] = {x, y, z};
+        double high[3] = {x + 0.05, y + 0.05, z + 0.005};
+        time += 1.0;
+        tree->insertData(static_cast<uint32_t>(bytes.size()), reinterpret_cast<const uint8_t*>(bytes.data()),
+                         SpatialIndex::TimeRegion(low, high, time, time, 3), id);
+        boxes.push_back(std::vector<double>({low[0], low[1], low[2], high[0], high[1], high[2]}));
+        starts.push_back(time);
+        ends.push_back(kOpen);
+        if (id % 3 == 2) {
+            id_type gone = id - 2;
+            const std::vector<double>& g = boxes[gone];
+            time += 1.0;
+            ASSERT_TRUE(tree->deleteData(SpatialIndex::TimeRegion(g.data(), g.data() + 3, starts[gone], time, 3), gone));
+            ends[gone] = time;
+        }
+    }
+    double horizon = std::floor(time * 0.6);
+    RegionArchive archive;
+    SpatialIndex::MVRTree::pruneHistory(*tree, horizon, archive);
+    std::vector<std::tuple<id_type, std::vector<double>, double, double> > expected;
+    for (id_type id = 0; id < 90; ++id) {
+        if (ends[id] <= horizon) expected.push_back(std::make_tuple(id, boxes[id], starts[id], ends[id]));
+    }
+    EXPECT_EQ(sorted(expected), sorted(archive.m_versions));
+    for (id_type id = 0; id < 90; ++id) {
+        IdCollector found;
+        const std::vector<double>& b = boxes[id];
+        double low[3] = {b[0] + 0.01, b[1] + 0.01, b[2] + 0.001};
+        double high[3] = {b[3] - 0.01, b[4] - 0.01, b[5] - 0.001};
+        tree->intersectsWithQuery(SpatialIndex::TimeRegion(low, high, 0.0, time + 1.0, 3), found);
+        std::set<id_type> wanted;
+        if (ends[id] > horizon) wanted.insert(id);
+        EXPECT_EQ(wanted, found.m_ids) << "record " << id;
+    }
+    EXPECT_TRUE(tree->isIndexValid());
+}
