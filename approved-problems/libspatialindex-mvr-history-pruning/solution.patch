+void SpatialIndex::MVRTree::MVRTree::pruneHistory(double horizon, IVisitor* archive)
+{
+	if (! std::isfinite(horizon)) throw Tools::IllegalArgumentException("pruneHistory: The horizon must be a finite number.");
+	if (horizon > m_currentTime) throw Tools::IllegalArgumentException("pruneHistory: The horizon is later than the tree current time.");
+	if (horizon <= m_horizon) return;
+
+	if (archive != nullptr) archiveEndedVersions(horizon, *archive);
+
+	std::set<id_type> kept;
+	std::vector<id_type> pruned;
+	collectPrunedNodes(horizon, kept, pruned);
+
+	for (id_type id : pruned)
+	{
+		NodePtr n = readNode(id);
+		m_stats.m_nodesInLevel.at(n->m_level) = m_stats.m_nodesInLevel[n->m_level] - 1;
+		uint32_t& dead = (n->m_level > 0) ? m_stats.m_u32DeadIndexNodes : m_stats.m_u32DeadLeafNodes;
+		if (dead > 0) --dead;
+		deleteNode(n.get());
+	}
+	while (m_stats.m_nodesInLevel.size() > 1 && m_stats.m_nodesInLevel.back() == 0) m_stats.m_nodesInLevel.pop_back();
+
+	for (id_type id : kept) compactNode(id, horizon);
+
+	std::vector<RootEntry> roots;
+	std::vector<uint32_t> heights;
+	for (size_t cRoot = 0; cRoot < m_roots.size(); ++cRoot)
+	{
+		if (! endsAfter(m_roots[cRoot].m_endTime, horizon)) continue;
+		roots.push_back(m_roots[cRoot]);
+		heights.push_back(m_stats.m_treeHeight[cRoot]);
+	}
+	m_roots.swap(roots);
+	m_stats.m_treeHeight.swap(heights);
+
+	refreshLiveBounds(m_roots.back().m_id);
+
+	for (std::set<ErasedVersion>::iterator it = m_erasedVersions.begin(); it != m_erasedVersions.end();)
+	{
+		if (endsAfter(std::get<1>(*it), horizon)) ++it;
+		else it = m_erasedVersions.erase(it);
+	}
+
+	m_horizon = horizon;
+	storeHeader();
+}
+
+bool SpatialIndex::MVRTree::MVRTree::endsAfter(double endTime, double horizon) const
+{
+	return endTime > horizon || endTime == std::numeric_limits<double>::max();
+}
+
+SpatialIndex::MVRTree::ErasedVersion SpatialIndex::MVRTree::MVRTree::erasedVersion(id_type id, double time, const Region& box)
+{
+	std::vector<double> coords(box.m_pLow, box.m_pLow + box.m_dimension);
+	coords.insert(coords.end(), box.m_pHigh, box.m_pHigh + box.m_dimension);
+	return ErasedVersion(id, time, coords);
+}
+
+void SpatialIndex::MVRTree::MVRTree::collectPrunedNodes(double horizon, std::set<id_type>& kept, std::vector<id_type>& pruned)
+{
+	std::stack<id_type> st;
+
+	for (const RootEntry& e : m_roots)
+	{
+		if (endsAfter(e.m_endTime, horizon) && kept.insert(e.m_id).second) st.push(e.m_id);
+	}
+
+	while (! st.empty())
+	{
+		NodePtr n = readNode(st.top()); st.pop();
+		if (n->m_level == 0) continue;
+
+		for (uint32_t cChild = 0; cChild < n->m_children; ++cChild)
+		{
+			if (endsAfter(n->m_ptrMBR[cChild]->m_endTime, horizon) && kept.insert(n->m_pIdentifier[cChild]).second)
+				st.push(n->m_pIdentifier[cChild]);
+		}
+	}
+
+	std::set<id_type> visited;
+
+	for (const RootEntry& e : m_roots)
+	{
+		if (visited.insert(e.m_id).second) st.push(e.m_id);
+	}
+
+	while (! st.empty())
+	{
+		id_type id = st.top(); st.pop();
+		if (kept.find(id) == kept.end()) pruned.push_back(id);
+
+		NodePtr n = readNode(id);
+		if (n->m_level == 0) continue;
+
+		for (uint32_t cChild = 0; cChild < n->m_children; ++cChild)
+		{
+			if (visited.insert(n->m_pIdentifier[cChild]).second) st.push(n->m_pIdentifier[cChild]);
+		}
+	}
+}
+
+void SpatialIndex::MVRTree::MVRTree::archiveEndedVersions(double horizon, IVisitor& archive)
+{
+	std::map<id_type, double> lifetimeEnd;
+	std::stack<id_type> st;
+
+	for (const RootEntry& e : m_roots)
+	{
+		std::map<id_type, double>::iterator it = lifetimeEnd.find(e.m_id);
+		if (it != lifetimeEnd.end() && it->second >= e.m_endTime) continue;
+		lifetimeEnd[e.m_id] = e.m_endTime;
+		st.push(e.m_id);
+	}
+
+	while (! st.empty())
+	{
+		id_type id = st.top(); st.pop();
+		double end = lifetimeEnd[id];
+		NodePtr n = readNode(id);
+		if (n->m_level == 0) continue;
+
+		for (uint32_t cChild = 0; cChild < n->m_children; ++cChild)
+		{
+			double childEnd = std::min(end, n->m_ptrMBR[cChild]->m_endTime);
+			std::map<id_type, double>::iterator it = lifetimeEnd.find(n->m_pIdentifier[cChild]);
+			if (it != lifetimeEnd.end() && it->second >= childEnd) continue;
+			lifetimeEnd[n->m_pIdentifier[cChild]] = childEnd;
+			st.push(n->m_pIdentifier[cChild]);
+		}
+	}
+
+	std::vector<VersionFragment> fragments;
+
+	for (const std::pair<const id_type, double>& node : lifetimeEnd)
+	{
+		NodePtr n = readNode(node.first);
+		if (n->m_level != 0) continue;
+
+		for (uint32_t cChild = 0; cChild < n->m_children; ++cChild)
+		{
+			VersionFragment f;
+			f.m_id = n->m_pIdentifier[cChild];
+			f.m_region = *(n->m_ptrMBR[cChild]);
+			f.m_deleted = f.m_region.m_endTime <= node.second;
+			f.m_region.m_endTime = std::min(node.second, f.m_region.m_endTime);
+			if (m_erasedVersions.count(erasedVersion(f.m_id, f.m_region.m_endTime, f.m_region)) > 0) f.m_deleted = true;
+			if (f.m_region.m_endTime <= f.m_region.m_startTime) continue;
+			if (n->m_pDataLength[cChild] > 0) f.m_data.assign(n->m_pData[cChild], n->m_pData[cChild] + n->m_pDataLength[cChild]);
+			fragments.push_back(f);
+		}
+	}
+
+	std::sort(fragments.begin(), fragments.end(),
+		[](const VersionFragment& a, const VersionFragment& b)
+		{
+			if (a.m_region.m_startTime != b.m_region.m_startTime) return a.m_region.m_startTime < b.m_region.m_startTime;
+			return a.m_region.m_endTime < b.m_region.m_endTime;
+		});
+
+	std::vector<bool> continued(fragments.size(), false);
+
+	for (size_t cFragment = 0; cFragment < fragments.size(); ++cFragment)
+	{
+		if (continued[cFragment]) continue;
+		VersionFragment version = fragments[cFragment];
+
+		for (size_t cNext = cFragment + 1; cNext < fragments.size() && ! version.m_deleted; ++cNext)
+		{
+			const VersionFragment& next = fragments[cNext];
+			if (continued[cNext] || next.m_region.m_startTime != version.m_region.m_endTime) continue;
+			if (next.m_id != version.m_id || next.m_data != version.m_data) continue;
+			if (! (static_cast<Region>(next.m_region) == static_cast<Region>(version.m_region))) continue;
+			version.m_region.m_endTime = next.m_region.m_endTime;
+			version.m_deleted = next.m_deleted;
+			continued[cNext] = true;
+		}
+
+		if (endsAfter(version.m_region.m_endTime, horizon)) continue;
+		version.m_region.m_startTime = std::max(version.m_region.m_startTime, m_horizon);
+		Data data(static_cast<uint32_t>(version.m_data.size()), version.m_data.data(), version.m_region, version.m_id);
+		archive.visitData(data);
+	}
+}
+
+void SpatialIndex::MVRTree::MVRTree::compactNode(id_type id, double horizon)
+{
+	NodePtr n = readNode(id);
+	double startTime = n->m_nodeMBR.m_startTime;
+	double endTime = n->m_nodeMBR.m_endTime;
+	bool changed = false;
+
+	for (uint32_t cChild = n->m_children; cChild > 0; --cChild)
+	{
+		if (endsAfter(n->m_ptrMBR[cChild - 1]->m_endTime, horizon)) continue;
+		n->deleteEntry(cChild - 1);
+		changed = true;
+	}
+
+	if (! changed) return;
+
+	n->m_nodeMBR.m_startTime = startTime;
+	n->m_nodeMBR.m_endTime = endTime;
+	writeNode(n.get());
+}
+
+void SpatialIndex::MVRTree::MVRTree::refreshLiveBounds(id_type id)
+{
+	NodePtr n = readNode(id);
+	if (n->m_level == 0) return;
+
+	bool changed = false;
+
+	for (uint32_t cChild = 0; cChild < n->m_children; ++cChild)
+	{
+		if (n->m_ptrMBR[cChild]->m_endTime < std::numeric_limits<double>::max()) continue;
+
+		refreshLiveBounds(n->m_pIdentifier[cChild]);
+		NodePtr child = readNode(n->m_pIdentifier[cChild]);
+		if (static_cast<Region>(*(n->m_ptrMBR[cChild])) == static_cast<Region>(child->m_nodeMBR)) continue;
+
+		memcpy(n->m_ptrMBR[cChild]->m_pLow, child->m_nodeMBR.m_pLow, m_dimension * sizeof(double));
+		memcpy(n->m_ptrMBR[cChild]->m_pHigh, child->m_nodeMBR.m_pHigh, m_dimension * sizeof(double));
+		changed = true;
+	}
+
+	if (! changed) return;
+
+	if (m_bTightMBRs)
+	{
+		for (uint32_t cDim = 0; cDim < m_dimension; ++cDim)
+		{
+			n->m_nodeMBR.m_pLow[cDim] = std::numeric_limits<double>::max();
+			n->m_nodeMBR.m_pHigh[cDim] = -std::numeric_limits<double>::max();
+
+			for (uint32_t cChild = 0; cChild < n->m_children; ++cChild)
+			{
+				n->m_nodeMBR.m_pLow[cDim] = std::min(n->m_nodeMBR.m_pLow[cDim], n->m_ptrMBR[cChild]->m_pLow[cDim]);
+				n->m_nodeMBR.m_pHigh[cDim] = std::max(n->m_nodeMBR.m_pHigh[cDim], n->m_ptrMBR[cChild]->m_pHigh[cDim]);
+			}
+		}
+	}
+
+	writeNode(n.get());
+}
