@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/report.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+
+export GOFLAGS="${GOFLAGS:--buildvcs=false}"
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+export HOME="${HOME:-/tmp}"
+
+NEW_DIR="analyzercheck"
+NEW_FILE="${NEW_DIR}/analyzer_abff52_test.go"
+LOG=$(mktemp)
+
+synthesize() {
+  suite="$1"
+  detail=$(head -c 4000 "$LOG" | sed 's/]]>/]] >/g')
+  shift
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites>\n'
+    printf '<testsuite name="%s" tests="%s" failures="%s" errors="0" time="0">\n' "$suite" "$#" "$#"
+    for n in "$@"; do
+      printf '<testcase name="%s" classname="%s" time="0"><failure message="the %s suite did not build or produced no test results"><![CDATA[%s]]></failure></testcase>\n' \
+        "$n" "$suite" "$MODE" "$detail"
+    done
+    printf '</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+}
+
+if [ "$MODE" = "base" ]; then
+  PKGS=$(go list ./... 2>>"$LOG" | grep -v "/${NEW_DIR}")
+  if [ -z "$PKGS" ]; then
+    PKGS="."
+  fi
+  go test -v -count=1 $PKGS >>"$LOG" 2>&1
+  EXIT=$?
+  go-junit-report -set-exit-code < "$LOG" > "$OUTPUT_PATH"
+  if [ $EXIT -ne 0 ] && ! grep -q '<failure' "$OUTPUT_PATH" 2>/dev/null; then
+    synthesize "github.com/asticode/go-astits" "TestBaseSuite"
+    EXIT=1
+  fi
+  rm -f "$LOG"
+  exit $EXIT
+fi
+
+go test -v -count=1 "./${NEW_DIR}/..." > "$LOG" 2>&1
+EXIT=$?
+go-junit-report -set-exit-code < "$LOG" > "$OUTPUT_PATH"
+
+NAMES=$(grep -oE '^func Test[A-Za-z0-9_]*' "$NEW_FILE" 2>/dev/null | awk '{print $2}')
+FIRST=$(printf '%s\n' "$NAMES" | head -n 1)
+
+if ! grep -q "name=\"${FIRST}\"" "$OUTPUT_PATH" 2>/dev/null; then
+  synthesize "github.com/asticode/go-astits/analyzercheck" $NAMES
+  EXIT=1
+elif [ $EXIT -ne 0 ] && ! grep -q '<failure' "$OUTPUT_PATH" 2>/dev/null; then
+  synthesize "github.com/asticode/go-astits/analyzercheck" $NAMES
+  EXIT=1
+fi
+
+rm -f "$LOG"
+exit $EXIT
