+func anzPESStream(t *testing.T, ptsValues ...int64) []byte {
+	t.Helper()
+	buf := &bytes.Buffer{}
+	mux := astits.NewMuxer(context.Background(), buf)
+	assert.NoError(t, mux.AddElementaryStream(astits.PMTElementaryStream{ElementaryPID: anzESPID, StreamType: astits.StreamTypeH264Video}))
+	mux.SetPCRPID(anzESPID)
+	for _, pts := range ptsValues {
+		_, err := mux.WriteData(&astits.MuxerData{
+			PID: anzESPID,
+			PES: &astits.PESData{
+				Header: &astits.PESHeader{
+					StreamID:       0xe0,
+					OptionalHeader: &astits.PESOptionalHeader{PTSDTSIndicator: astits.PTSDTSIndicatorOnlyPTS, PTS: &astits.ClockReference{Base: pts}},
+				},
+				Data: make([]byte, 100),
+			},
+		})
+		assert.NoError(t, err)
+	}
+	return buf.Bytes()
+}
