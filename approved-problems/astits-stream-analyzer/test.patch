+		anzPacket(anzESPID, 14),
+		anzPCR(anzRefPID, 4, 100*anzMs),
+	)
+	kinds := anzKinds(r)
+	for _, k := range []astits.AnalyzerEventKind{
+		astits.AnalyzerEventKindTransportError,
+		astits.AnalyzerEventKindUnreferencedPID,
+		astits.AnalyzerEventKindScramblingError,
+		astits.AnalyzerEventKindContinuityError,
