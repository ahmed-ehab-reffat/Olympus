+func TestAnalyzerNonContinuityEventsLeaveExpectedAndActualZero(t *testing.T) {
+	r := anzRun(astits.AnalyzerOptions{},
+		anzPCR(anzRefPID, 4, 0),
+		anzBroken(anzPacket(anzPID, 3)),
+		anzScrambled(anzPacket(astits.PIDPAT, 7), 2),
