+type anzEndingReader struct{ remaining []byte }
+
+func (r *anzEndingReader) Read(p []byte) (int, error) {
+	n := copy(p, r.remaining)
+	r.remaining = r.remaining[n:]
+	return n, io.EOF
+}
+
+type anzWrappedEOFReader struct{}
+
+func (r *anzWrappedEOFReader) Read(p []byte) (int, error) {
+	return 0, fmt.Errorf("astits analyzer check: exhausted: %w", io.EOF)
+}
+
+func TestAnalyzerAnalyzeStreamOnAReaderWrappingItsEOF(t *testing.T) {
+	r, err := astits.AnalyzeStream(context.Background(), &anzWrappedEOFReader{}, astits.AnalyzerOptions{})
+	assert.NoError(t, err)
+	assert.Equal(t, 0, anzOK(t, r).Packets)
