+type anzCappedWriter struct{ budget int }
+
+func (w *anzCappedWriter) Write(p []byte) (int, error) {
+	if w.budget < 0 {
+		return len(p), nil
+	}
+	if len(p) > w.budget {
+		return 0, errors.New("astits analyzer check: writer is full")
+	}
+	w.budget -= len(p)
+	return len(p), nil
+}
