+			assert.Equal(t, uint8(10), e.Expected)
+			assert.Equal(t, uint8(14), e.Actual)
+			continue
+		}
+		assert.Equal(t, uint8(0), e.Expected)
+		assert.Equal(t, uint8(0), e.Actual)
