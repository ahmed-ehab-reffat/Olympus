+
+func anzClock(ticks int64) *astits.ClockReference {
+	return &astits.ClockReference{Base: ticks / 300, Extension: ticks % 300}
+}
+
+func anzPacket(pid uint16, cc uint8) *astits.Packet {
+	return &astits.Packet{
+		Header:  astits.PacketHeader{ContinuityCounter: cc, HasPayload: true, PID: pid},
+		Payload: make([]byte, 184),
+	}
+}
+
+func anzStart(pid uint16, cc uint8) *astits.Packet {
+	p := anzPacket(pid, cc)
+	p.Header.PayloadUnitStartIndicator = true
+	return p
+}
+
+func anzEmpty(pid uint16, cc uint8) *astits.Packet {
+	return &astits.Packet{
+		AdaptationField: &astits.PacketAdaptationField{Length: 183},
+		Header:          astits.PacketHeader{ContinuityCounter: cc, HasAdaptationField: true, PID: pid},
+	}
+}
+
+func anzPCR(pid uint16, cc uint8, ticks int64) *astits.Packet {
+	p := anzEmpty(pid, cc)
+	p.AdaptationField.HasPCR = true
+	p.AdaptationField.PCR = anzClock(ticks)
+	return p
+}
+
+func anzPCRStart(pid uint16, cc uint8, ticks int64) *astits.Packet {
+	p := anzStart(pid, cc)
+	p.Header.HasAdaptationField = true
+	p.AdaptationField = &astits.PacketAdaptationField{HasPCR: true, PCR: anzClock(ticks)}
+	return p
+}
+
+func anzBroken(p *astits.Packet) *astits.Packet {
+	p.Header.TransportErrorIndicator = true
+	return p
+}
+
+func anzJumped(p *astits.Packet) *astits.Packet {
+	if p.AdaptationField == nil {
+		p.AdaptationField = &astits.PacketAdaptationField{}
+		p.Header.HasAdaptationField = true
+	}
+	p.AdaptationField.DiscontinuityIndicator = true
+	return p
+}
+
+func anzScrambled(p *astits.Packet, control uint8) *astits.Packet {
+	p.Header.TransportScramblingControl = control
+	return p
+}
+
+func anzRun(o astits.AnalyzerOptions, ps ...*astits.Packet) *astits.AnalyzerReport {
+	a := astits.NewAnalyzer(o)
+	for _, p := range ps {
+		a.Packet(p)
+	}
+	return a.Report()
+}
+
+func anzOK(t *testing.T, r *astits.AnalyzerReport) *astits.AnalyzerReport {
+	t.Helper()
+	if r == nil {
+		t.Fatalf("want a report, got nil")
+		return &astits.AnalyzerReport{}
+	}
+	return r
+}
+
+func anzKinds(r *astits.AnalyzerReport) (out []astits.AnalyzerEventKind) {
+	if r == nil {
+		return
+	}
+	for _, e := range r.Events {
+		out = append(out, e.Kind)
+	}
+	return
+}
+
+func anzTimes(r *astits.AnalyzerReport) (out []int64) {
+	if r == nil {
+		return
+	}
+	for _, e := range r.Events {
+		out = append(out, e.Time)
+	}
+	return
+}
+
+func anzEvent(t *testing.T, r *astits.AnalyzerReport, i int) astits.AnalyzerEvent {
+	t.Helper()
+	r = anzOK(t, r)
+	if i >= len(r.Events) {
+		t.Fatalf("want at least %d events, got %d", i+1, len(r.Events))
+		return astits.AnalyzerEvent{}
+	}
+	return r.Events[i]
+}
+
+func anzProgram(t *testing.T, r *astits.AnalyzerReport, i int) astits.AnalyzerProgram {
+	t.Helper()
+	r = anzOK(t, r)
+	if i >= len(r.Programs) {
+		t.Fatalf("want at least %d programs, got %d", i+1, len(r.Programs))
+		return astits.AnalyzerProgram{}
+	}
+	return r.Programs[i]
+}
+
+func anzStat(t *testing.T, r *astits.AnalyzerReport, pid uint16) astits.AnalyzerPIDStat {
+	t.Helper()
+	r = anzOK(t, r)
+	for _, s := range r.PIDs {
+		if s.PID == pid {
+			return s
+		}
+	}
+	t.Fatalf("no stat for pid %d", pid)
+	return astits.AnalyzerPIDStat{}
+}
+
+func anzPAT(programs ...uint16) *astits.DemuxerData {
+	d := &astits.DemuxerData{PAT: &astits.PATData{}, PID: astits.PIDPAT}
+	for i := 0; i < len(programs); i += 2 {
+		d.PAT.Programs = append(d.PAT.Programs, &astits.PATProgram{ProgramNumber: programs[i], ProgramMapID: programs[i+1]})
+	}
+	return d
+}
+
+func anzPMT(pid, number, pcrPID uint16, es ...uint16) *astits.DemuxerData {
+	d := &astits.DemuxerData{PID: pid, PMT: &astits.PMTData{PCRPID: pcrPID, ProgramNumber: number}}
+	for _, e := range es {
+		d.PMT.ElementaryStreams = append(d.PMT.ElementaryStreams, &astits.PMTElementaryStream{ElementaryPID: e, StreamType: astits.StreamTypeH264Video})
+	}
+	return d
+}
+
+func anzPES(pid uint16, pts, dts int64) *astits.DemuxerData {
+	o := &astits.PESOptionalHeader{}
+	if pts >= 0 {
+		o.PTS = &astits.ClockReference{Base: pts}
+	}
+	if dts >= 0 {
+		o.DTS = &astits.ClockReference{Base: dts}
+	}
+	return &astits.DemuxerData{PID: pid, PES: &astits.PESData{Header: &astits.PESHeader{OptionalHeader: o}}}
+}
+
+func anzStream(t *testing.T, ps ...*astits.Packet) []byte {
+	t.Helper()
+	buf := &bytes.Buffer{}
+	for _, p := range ps {
+		b := make([]byte, astits.MpegTsPacketSize)
+		b[0] = 0x47
+		b[1] = byte(p.Header.PID>>8) & 0x1f
+		if p.Header.TransportErrorIndicator {
+			b[1] |= 0x80
+		}
+		if p.Header.PayloadUnitStartIndicator {
+			b[1] |= 0x40
+		}
+		b[2] = byte(p.Header.PID)
+		b[3] = p.Header.TransportScramblingControl<<6 | p.Header.ContinuityCounter&0xf
+		if p.Header.HasPayload {
+			b[3] |= 0x10
+		}
+		copy(b[4:], p.Payload)
+		buf.Write(b)
+	}
+	return buf.Bytes()
+}
+
+func anzTimesOf(r *astits.AnalyzerReport, k astits.AnalyzerEventKind) (out []int64) {
+	if r == nil {
+		return
+	}
+	for _, e := range r.Events {
+		if e.Kind == k {
+			out = append(out, e.Time)
+		}
+	}
+	return
+}
