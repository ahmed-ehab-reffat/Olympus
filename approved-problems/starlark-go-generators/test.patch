+tail = list(it)
+`)
+		genWant1b35e6(t, g, "head", `1`)
+		genWant1b35e6(t, g, "tail", `[2, 3]`)
+	})
+
+	t.Run("from_a_non_iterable", func(t *testing.T) {
+		genErr1b35e6(t, `
+def gen():
+    yield from 3
+
+out = list(gen())
