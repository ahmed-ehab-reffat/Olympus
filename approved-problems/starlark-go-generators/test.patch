+func genExec1b35e6(t *testing.T, src string) (starlark.StringDict, *starlark.Thread, error) {
+	t.Helper()
+	thread := &starlark.Thread{Name: "gen", Print: func(_ *starlark.Thread, msg string) { t.Log(msg) }}
+	globals, err := starlark.ExecFileOptions(genOptions1b35e6(), thread, "gen.star", src, nil)
+	return globals, thread, err
+}
+
+func genGlobals1b35e6(t *testing.T, src string) starlark.StringDict {
+	t.Helper()
+	globals, _, err := genExec1b35e6(t, src)
+	if err != nil {
+		t.Fatalf("exec failed: %v", err)
+	}
+	return globals
+}
+
+func genWant1b35e6(t *testing.T, globals starlark.StringDict, name, want string) {
+	t.Helper()
+	v, ok := globals[name]
+	if !ok {
+		t.Fatalf("global %s is undefined", name)
+	}
+	if got := v.String(); got != want {
+		t.Errorf("%s = %s, want %s", name, got, want)
+	}
+}
+
+func genErr1b35e6(t *testing.T, src string) string {
+	t.Helper()
+	_, _, err := genExec1b35e6(t, src)
+	if err == nil {
+		t.Fatalf("execution succeeded, want an error")
+	}
+	return err.Error()
+}
+
+func genErrHas1b35e6(t *testing.T, src, want string) {
+	t.Helper()
+	if msg := genErr1b35e6(t, src); !strings.Contains(msg, want) {
+		t.Errorf("error = %q, want it to contain %q", msg, want)
+	}
+}
