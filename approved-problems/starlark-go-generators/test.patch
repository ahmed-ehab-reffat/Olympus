+func TestGenBuild1b35e6(t *testing.T) {
+	t.Run("call_runs_no_body", func(t *testing.T) {
+		g := genGlobals1b35e6(t, `
+log = []
+def trace(x):
+    log.append("entered")
+    yield x
+    log.append("resumed")
+
+it = trace(1)
+before = list(log)
+first = [v for v in it]
+after = list(log)
+`)
+		genWant1b35e6(t, g, "before", `[]`)
+		genWant1b35e6(t, g, "first", `[1]`)
+		genWant1b35e6(t, g, "after", `["entered", "resumed"]`)
+	})
+
+	t.Run("arguments_bound_at_call", func(t *testing.T) {
+		g := genGlobals1b35e6(t, `
+def gen(x):
+    yield x
+
+n = 1
+it = gen(n)
+n = 2
+out = list(it)
+`)
+		genWant1b35e6(t, g, "out", `[1]`)
+	})
+
+	t.Run("argument_error_at_call", func(t *testing.T) {
+		genErr1b35e6(t, `
+def gen(x):
+    yield x
+
+it = gen()
+`)
+	})
+
+	t.Run("type_and_print", func(t *testing.T) {
+		g := genGlobals1b35e6(t, genCounter1b35e6+`
+kind = type(counter(1))
+text = str(counter(1))
+truth = bool(counter(0))
+`)
+		genWant1b35e6(t, g, "kind", `"generator"`)
+		genWant1b35e6(t, g, "text", `"<generator counter>"`)
+		genWant1b35e6(t, g, "truth", `True`)
