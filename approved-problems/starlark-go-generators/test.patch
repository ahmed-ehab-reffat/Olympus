+func TestGenErrors1b35e6(t *testing.T) {
+	const boom = `
+def boom():
+    yield 1
+    fail("boom in body")
+
+`
+	for _, tc := range []struct{ name, expr string }{
+		{"list", "list(boom())"},
+		{"sorted", "sorted(boom())"},
+		{"tuple", "tuple(boom())"},
+		{"max", "max(boom())"},
+		{"all", "all(boom())"},
+		{"set", "set(boom())"},
+		{"zip", "zip(boom(), boom())"},
+		{"enumerate", "enumerate(boom())"},
+		{"reversed", "reversed(boom())"},
+		{"dict", "dict([(v, v) for v in boom()])"},
+		{"comprehension", "[v for v in boom()]"},
+		{"join", `",".join([str(v) for v in boom()])`},
+	} {
+		t.Run("propagates_through_"+tc.name, func(t *testing.T) {
+			genErrHas1b35e6(t, boom+"out = "+tc.expr+"\n", "boom in body")
+		})
+	}
+
+	t.Run("propagates_through_for_loop", func(t *testing.T) {
+		genErrHas1b35e6(t, boom+`
+for v in boom():
+    pass
+`, "boom in body")
+	})
+
+	t.Run("propagates_through_sequence_assignment", func(t *testing.T) {
+		genErrHas1b35e6(t, boom+`
+a, b = boom()
+`, "boom in body")
+	})
+
+	t.Run("propagates_through_star_args", func(t *testing.T) {
+		genErrHas1b35e6(t, boom+`
+def collect(*args):
+    return args
+
+out = collect(*boom())
+`, "boom in body")
+	})
+
+	t.Run("propagates_through_extend", func(t *testing.T) {
+		genErrHas1b35e6(t, boom+`
+def build():
+    acc = []
+    acc += boom()
+    return acc
+
+out = build()
+`, "boom in body")
+	})
+
+	t.Run("consumer_reports_failure_and_unlocks", func(t *testing.T) {
+		const helpers = `
+def walk(xs):
+    for x in xs:
+        yield x
+    fail("boom in body")
+
+def pairs(xs):
+    for x in xs:
+        yield (x, x)
+    fail("boom in body")
+
+def strs(xs):
+    for x in xs:
+        yield str(x)
+    fail("boom in body")
+
+def zeros(xs):
+    for x in xs:
+        yield 0
+    fail("boom in body")
+
+def keyed(v):
+    return v
+
+def collect(*args):
+    return args
+
+`
+		for _, tc := range []struct{ name, code string }{
+			{"sorted_with_key", "out = sorted(walk(shared), key=keyed)"},
+			{"sorted_reversed", "out = sorted(walk(shared), reverse=True)"},
+			{"min_with_key", "out = min(walk(shared), key=keyed)"},
+			{"max_with_key", "out = max(walk(shared), key=keyed)"},
+			{"dict_from_pairs", "out = dict(pairs(shared))"},
+			{"dict_comprehension", "out = {v: v for v in walk(shared)}"},
+			{"set_builtin", "out = set(walk(shared))"},
+			{"zip_with_a_list", "out = zip(walk(shared), [9, 9, 9])"},
+			{"enumerate_builtin", "out = enumerate(walk(shared))"},
+			{"reversed_builtin", "out = reversed(walk(shared))"},
+			{"join_direct", `out = "-".join(strs(shared))`},
+			{"unpack_three", "a, b, c = walk(shared)"},
+			{"loop_tuple_target", "out = []\nfor a, b in pairs(shared):\n    out.append(a)"},
+			{"star_args_builtin", "out = max(*walk(shared))"},
+			{"star_args_function", "out = collect(*walk(shared))"},
+			{"augmented_assign", "acc = []\nacc += walk(shared)"},
+			{"extend_method", "acc = []\nacc.extend(walk(shared))"},
+			{"any_builtin", "out = any(zeros(shared))"},
+			{"all_builtin", "out = all(walk(shared))"},
+			{"tuple_builtin", "out = tuple(walk(shared))"},
+		} {
+			t.Run(tc.name, func(t *testing.T) {
+				shared := starlark.NewList([]starlark.Value{starlark.MakeInt(1), starlark.MakeInt(2)})
+				thread := &starlark.Thread{Name: "gen"}
+				_, err := starlark.ExecFileOptions(genOptions1b35e6(), thread, "gen.star", helpers+tc.code+"\n", starlark.StringDict{"shared": shared})
+				if err == nil {
+					t.Fatal("execution succeeded, want the generator body to fail")
