+		thread := &starlark.Thread{Name: "gen"}
+		globals, err := starlark.ExecFileOptions(genOptions1b35e6(), thread, "gen.star", `
+def gen():
+    yield from range(3)
+    yield from "ab".elems()
+    yield from provided
+
+out = list(gen())
+`, starlark.StringDict{"provided": shared})
+		if err != nil {
+			t.Fatalf("exec failed: %v", err)
+		}
+		genWant1b35e6(t, globals, "out", `[0, 1, 2, "a", "b", 7, 8]`)
+	})
+
+	t.Run("from_empty", func(t *testing.T) {
+		g := genGlobals1b35e6(t, `
+def gen():
+    yield from []
+    yield 1
+
+out = list(gen())
+`)
+		genWant1b35e6(t, g, "out", `[1]`)
+	})
+
+	t.Run("delegation_is_resumable", func(t *testing.T) {
+		g := genGlobals1b35e6(t, `
+def gen():
+    yield from [1, 2, 3]
+
