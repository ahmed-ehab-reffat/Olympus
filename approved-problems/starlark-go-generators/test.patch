+	})
+
+	t.Run("delegate_failure_makes_the_outer_terminal", func(t *testing.T) {
+		const src = `
+log = []
+
+def inner():
+    yield 1
+    fail("inner boom")
+
+def outer():
+    yield from inner()
+    log.append("after delegation")
+    yield 2
+
+def drain(g):
+    return list(g)
+
+def after(g):
+    g.close()
+    return [list(g), next(g, "done"), log]
+`
+		_, prog, err := starlark.SourceProgramOptions(genOptions1b35e6(), "gen.star", src, func(string) bool { return false })
+		if err != nil {
+			t.Fatalf("compile failed: %v", err)
+		}
+		thread := &starlark.Thread{Name: "gen"}
+		globals, err := prog.Init(thread, nil)
+		if err != nil {
+			t.Fatalf("init failed: %v", err)
+		}
+		gen, err := starlark.Call(thread, globals["outer"], nil, nil)
+		if err != nil {
+			t.Fatalf("creating the generator failed: %v", err)
+		}
+		if _, err := starlark.Call(thread, globals["drain"], starlark.Tuple{gen}, nil); err == nil {
+			t.Fatal("draining succeeded, want the delegated body to fail")
+		}
+		got, err := starlark.Call(thread, globals["after"], starlark.Tuple{gen}, nil)
+		if err != nil {
+			t.Fatalf("probing the failed generator: %v", err)
+		}
+		if want := `[[], "done", []]`; got.String() != want {
+			t.Errorf("after delegated failure = %s, want %s", got, want)
+		}
+	})
+
+	t.Run("error_inside_delegate", func(t *testing.T) {
+		genErrHas1b35e6(t, `
