+// across a suspension so that the body continues where its yield left off.
+type frameState struct {
+	space     []Value    // backing array of locals and stack
+	locals    []Value    // local variables, parameters first
+	stack     []Value    // operand stack
+	iterstack []Iterator // stack of active iterators
+	sp        int        // operand stack pointer
