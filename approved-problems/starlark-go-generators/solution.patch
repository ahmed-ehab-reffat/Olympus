new file mode 100644
index 0000000..f0904d8
--- /dev/null
+++ b/starlark/generator.go
@@ -0,0 +1,175 @@
+// Copyright 2026 The Bazel Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package starlark
+
+import "fmt"
+
+// A Generator is the suspended activation of a generator function, that is, of
+// a function whose body contains a yield statement.
+//
+// Calling a generator function binds its arguments and returns a Generator
+// without executing any of the body. Iterating the Generator runs the body
+// until the next yield, whose operand is the element; the sequence ends when
+// the body returns. A Generator is consumed as it is iterated: iterating it
+// again continues from the point at which the previous iteration stopped.
+type Generator struct {
+	fn      *Function
+	thread  *Thread
+	state   *frameState
+	running bool // an iterator is currently inside the body
+	done    bool // the body has returned or failed
+	frozen  bool
+}
+
+var (
+	_ Value    = (*Generator)(nil)
+	_ Iterable = (*Generator)(nil)
+	_ HasAttrs = (*Generator)(nil)
+)
+
+// Function returns the generator function of which g is an activation.
+func (g *Generator) Function() *Function { return g.fn }
+
+func (g *Generator) Name() string   { return g.fn.Name() }
+func (g *Generator) String() string { return fmt.Sprintf("<generator %s>", g.fn.Name()) }
+func (g *Generator) Type() string   { return "generator" }
+func (g *Generator) Truth() Bool    { return True }
+
+func (g *Generator) Hash() (uint32, error) {
+	return 0, fmt.Errorf("unhashable type: generator")
+}
+
+// Freeze makes g, and every value held by its suspended activation, immutable.
+// A frozen generator cannot be advanced, since running the body would mutate
+// the activation.
+func (g *Generator) Freeze() {
+	if g.frozen {
+		return
+	}
+	g.frozen = true
+	g.fn.Freeze()
+	if g.state != nil {
+		for _, v := range g.state.space {
+			if v != nil {
+				v.Freeze()
+			}
+		}
+	}
+}
+
+func (g *Generator) Attr(name string) (Value, error) {
+	return builtinAttr(g, name, generatorMethods)
+}
+
+func (g *Generator) AttrNames() []string { return builtinAttrNames(generatorMethods) }
+
+// close abandons a suspended activation: the body is not resumed again, and
+// every container the body was iterating is released.
+func (g *Generator) close() error {
+	if g.running {
+		return fmt.Errorf("generator %s is already running", g.fn.Name())
+	}
+	if g.frozen {
+		return fmt.Errorf("cannot close frozen generator %s", g.fn.Name())
+	}
+	if !g.done {
+		g.done = true
+		state := g.state
+		g.state = nil
+		if state != nil {
+			for _, iter := range state.iterstack {
+				if sub, ok := iter.(*generatorIterator); ok {
+					if err := sub.g.close(); err != nil {
+						return err
+					}
+					continue
+				}
+				iter.Done()
+			}
+		}
+	}
+	return nil
+}
+
+func (g *Generator) Iterate() Iterator { return &generatorIterator{g: g} }
+
+// next advances the body to its next yield.
+// It reports whether a value was produced; a false result with a nil error
+// means the body has finished.
+func (g *Generator) next() (Value, bool, error) {
+	if g.done {
+		return nil, false, nil
+	}
+	if g.running {
+		return nil, false, fmt.Errorf("generator %s is already running", g.fn.Name())
+	}
+	if g.frozen {
+		return nil, false, fmt.Errorf("cannot advance frozen generator %s", g.fn.Name())
+	}
+
+	g.running = true
+	fr := g.thread.pushFrame(g.fn)
+	defer func() {
+		g.thread.popFrame(fr)
+		g.running = false
+	}()
+
+	v, yielded, err := g.fn.run(g.thread, g.state)
+	if err != nil {
+		g.done = true
+		g.state = nil
+		if !is[*EvalError](err) {
+			err = g.thread.evalError(err)
+		}
+		return nil, false, err
+	}
+	if !yielded {
+		g.done = true
+		g.state = nil
+		return nil, false, nil
+	}
+	return v, true, nil
+}
+
+// A generatorIterator iterates the elements a generator produces.
+// Unlike the iterators of the built-in sequences it can fail, since advancing
+// it runs Starlark code; Err reports the failure to the consumer.
+type generatorIterator struct {
+	g   *Generator
+	err error
+}
+
+var _ Iterator = (*generatorIterator)(nil)
+
+func (it *generatorIterator) Next(p *Value) bool {
+	if it.err != nil {
+		return false
+	}
+	v, ok, err := it.g.next()
+	if err != nil {
+		it.err = err
+		return false
+	}
+	if !ok {
+		return false
+	}
+	*p = v
+	return true
+}
+
+func (it *generatorIterator) Done() {}
+
+func (it *generatorIterator) Err() error { return it.err }
+
+// iterErr reports the error, if any, that stopped an iterator.
+// The iterators of the built-in sequences never fail, but advancing a
+// generator runs arbitrary Starlark code, so every consumer of an iterator
+// must report the failure instead of treating it as the end of the sequence.
+func iterErr(iter Iterator) error {
+	if e, ok := iter.(interface{ Err() error }); ok {
+		return e.Err()
+	}
+	return nil
+}
