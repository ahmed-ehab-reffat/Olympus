+
+export function getRangesSize(ranges: Range[]): Percentage {
+  return ranges.reduce((sum, [start, end]) => sum + (end - start), 0);
+}
+
+export function sortRanges(ranges: Range[]): Range[] {
+  return ranges
+    .filter(([start, end]) => end > start)
+    .map(([start, end]) => [start, end] as Range)
+    .sort((a, b) => a[0] - b[0]);
+}
+
+export function intersectRanges(ranges: Range[], region: Range[]): Range[] {
+  const result: Range[] = [];
+
+  for (const [start, end] of sortRanges(ranges)) {
+    for (const [regionStart, regionEnd] of sortRanges(region)) {
+      const from = Math.max(start, regionStart);
+      const to = Math.min(end, regionEnd);
+
+      if (to > from) {
+        result.push([from, to]);
+      }
+    }
+  }
+
+  return sortRanges(result);
+}
+
+export function subtractRanges(ranges: Range[], taken: Range[]): Range[] {
+  let result = sortRanges(ranges);
+
+  for (const [takenStart, takenEnd] of sortRanges(taken)) {
+    const next: Range[] = [];
+
+    for (const [start, end] of result) {
+      if (takenEnd <= start || takenStart >= end) {
+        next.push([start, end]);
+        continue;
+      }
+
+      if (takenStart > start) {
+        next.push([start, takenStart]);
+      }
+
+      if (takenEnd < end) {
+        next.push([takenEnd, end]);
+      }
+    }
+
+    result = next;
+  }
+
+  return result;
+}
+
+export function normalizeAllocation(allocation: Allocation[]): Allocation[] {
+  const sorted = allocation
+    .filter((a) => a.range && a.range[1] > a.range[0])
+    .map((a) => ({ variation: a.variation, range: [a.range[0], a.range[1]] as Range }))
+    .sort((a, b) => a.range[0] - b.range[0]);
+
+  const result: Allocation[] = [];
+
+  for (const current of sorted) {
+    const last = result[result.length - 1];
+
+    if (last && last.variation === current.variation && last.range[1] === current.range[0]) {
+      last.range = [last.range[0], current.range[1]];
+    } else {
+      result.push(current);
+    }
+  }
+
+  return result;
+}
+
+export interface VariationTarget {
+  variation: VariationValue;
+  size: Percentage;
+}
+
+export function reallocate(
+  existingAllocation: Allocation[] | undefined,
+  targets: VariationTarget[],
+  region: Range[],
+): Allocation[] {
+  const allocation: Allocation[] = [];
+  const kept: Range[] = [];
+  const deficits = new Map<VariationValue, Percentage>();
+
+  for (const { variation, size } of targets) {
+    const previousRanges = (existingAllocation || [])
+      .filter((a) => a.variation === variation)
+      .map((a) => a.range);
+
+    const keepable = getAllocation(intersectRanges(previousRanges, region), size);
+
+    keepable.forEach((range) => {
+      allocation.push({ variation, range });
+      kept.push(range);
+    });
+
+    deficits.set(variation, size - getRangesSize(keepable));
+  }
+
+  let free = subtractRanges(region, kept);
+
+  for (const { variation } of targets) {
+    const deficit = deficits.get(variation) || 0;
+
+    if (deficit <= 0) {
+      continue;
+    }
+
+    const filled = getAllocation(free, deficit);
+
+    filled.forEach((range) => {
+      allocation.push({ variation, range });
+    });
+
+    free = subtractRanges(free, filled);
+  }
+
+  return normalizeAllocation(allocation);
+}
+
+export interface AllocationChanges {
+  kept: Percentage;
+  moved: Percentage;
+  added: Percentage;
+  removed: Percentage;
+  variations: {
+    [variation: VariationValue]: {
+      kept: Percentage;
+      gained: Percentage;
+      lost: Percentage;
+    };
+  };
+}
+
+export function getAllocationChanges(
+  previous: Allocation[] | undefined,
+  next: Allocation[] | undefined,
+): AllocationChanges {
+  const previousAllocation = normalizeAllocation(previous || []);
+  const nextAllocation = normalizeAllocation(next || []);
+
+  const result: AllocationChanges = {
+    kept: 0,
+    moved: 0,
+    added: 0,
+    removed: 0,
+    variations: Object.create(null),
+  };
+
+  const variations: VariationValue[] = [];
+  [...previousAllocation, ...nextAllocation].forEach((a) => {
+    if (variations.indexOf(a.variation) === -1) {
+      variations.push(a.variation);
+    }
+  });
+
+  const rangesOf = (list: Allocation[], variation: VariationValue) =>
+    list.filter((a) => a.variation === variation).map((a) => a.range);
+
+  const previousRanges = previousAllocation.map((a) => a.range);
+  const nextRanges = nextAllocation.map((a) => a.range);
+
+  for (const variation of variations) {
+    const before = rangesOf(previousAllocation, variation);
+    const after = rangesOf(nextAllocation, variation);
+    const kept = getRangesSize(intersectRanges(before, after));
+
+    result.variations[variation] = {
+      kept,
+      gained: getRangesSize(after) - kept,
+      lost: getRangesSize(before) - kept,
+    };
+
+    result.kept += kept;
+    result.moved += getRangesSize(intersectRanges(subtractRanges(after, before), previousRanges));
+  }
+
+  result.added = getRangesSize(subtractRanges(nextRanges, previousRanges));
+  result.removed = getRangesSize(subtractRanges(previousRanges, nextRanges));
+
+  return result;
+}
