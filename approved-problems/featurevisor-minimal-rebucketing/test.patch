+import type { ProjectConfig } from "../config";
+import { getAllocationChanges } from "./allocator";
+import { buildDatafile, type RebucketingChange } from "./buildDatafile";
+import { buildProject, formatRebucketing } from "./buildProject";
+import { getTraffic } from "./traffic";
+
+function variations(weights: { [value: string]: number }): Variation[] {
+  return Object.keys(weights).map((value) => ({ value, weight: weights[value] }));
+}
+
+function rule(percentage: number, variationWeights?: { [value: string]: number }) {
+  return [{ key: "1", segments: "*", percentage, variationWeights }];
+}
+
+function existing(allocation: Allocation[], percentage = 100000): ExistingFeature {
+  return {
+    variations: [],
+    traffic: [{ key: "1", percentage, allocation }],
+  };
+}
+
+function build(
+  weights: { [value: string]: number },
+  percentage: number,
+  previous?: Allocation[],
+  variationWeights?: { [value: string]: number },
+  ranges?: Range[],
+): Allocation[] {
+  const [traffic] = getTraffic(
+    variations(weights),
+    rule(percentage, variationWeights),
+    previous ? existing(previous) : undefined,
+    ranges,
+  );
+
+  return (traffic as Traffic).allocation || [];
+}
+
+function match(allocation: Allocation[], bucketValue: number) {
+  return allocation.find((a) => a.range[0] <= bucketValue && a.range[1] >= bucketValue);
+}
+
+function renderLines(changes: RebucketingChange[]): string[] {
+  const format = formatRebucketing as (input: unknown) => unknown;
+  const flatten = (value: unknown): string =>
+    Array.isArray(value) ? value.map(String).join("\n") : String(value);
+
+  let text = "";
+  try {
+    text = flatten(format(changes));
+  } catch {
+    text = "";
+  }
+
+  if (!changes.every((change) => text.includes(change.feature))) {
+    text = changes.map((change) => flatten(format(change))).join("\n");
+  }
+
+  return text.split("\n").filter((line) => line.trim() !== "");
+}
+
+function massOf(allocation: Allocation[], variation: string) {
+  return allocation
+    .filter((a) => a.variation === variation)
+    .reduce((sum, a) => sum + (a.range[1] - a.range[0]), 0);
+}
