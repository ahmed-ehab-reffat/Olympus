index 0000000..75caf80
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+
+mode=""
+output_path=""
+
+while (($# > 0)); do
+    case "$1" in
+        --output_path=*)
+            output_path="${1#--output_path=}"
+            shift
+            ;;
+        --output_path)
+            output_path="$2"
+            shift 2
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+mode="${mode:-base}"
+output_path="${output_path:-test-results.xml}"
+
+cd "$(dirname "$0")"
+mkdir -p "$(dirname "$output_path")"
+rm -f "$output_path"
+
+new_tests=(
+    src/builder/rebucketing_a0018f.spec.ts
+)
+
+junit_file="$(realpath -m "$output_path")"
+
+cd packages/core
+
+if [[ "$mode" == "new" ]]; then
+    selection=("${new_tests[@]}")
+else
+    selection=(--testPathIgnorePatterns "${new_tests[@]}")
+fi
+
+log_file="$(mktemp)"
+
+JEST_JUNIT_OUTPUT_FILE="$junit_file" \
+    npx jest "${selection[@]}" --config jest.config.js --bail=0 --ci \
+    --reporters=default --reporters=jest-junit 2>&1 | tee "$log_file"
+status=${PIPESTATUS[0]}
+
+cd - >/dev/null
+if [[ -s "$output_path" ]]; then
+    sed -i 's/ *:: */ - /g' "$output_path"
+fi
+
+if [[ ! -s "$output_path" ]]; then
+    if [[ "$status" -eq 0 ]]; then
+        status=1
+    fi
+    diagnostic="$(tail -n 200 "$log_file" | sed -e 's/\x1b\[[0-9;]*m//g' \
+        -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+    cat >"$output_path" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="jest tests" tests="1" failures="1" errors="0">
+  <testsuite name="test.sh" tests="1" failures="1" errors="0">
+    <testcase classname="test.sh" name="jest produced no test results ($mode mode)">
+      <failure message="jest exited with status $status before writing JUnit output">$diagnostic</failure>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+fi
+
+rm -f "$log_file"
+
+exit "$status"
