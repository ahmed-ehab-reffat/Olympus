+
+      expect(traffic[0].allocation).toEqual([
+        { variation: "a", range: [0, 20000] },
+        { variation: "b", range: [20000, 40000] },
+        { variation: "a", range: [40000, 65000] },
+        { variation: "b", range: [65000, 90000] },
+      ]);
+      expect(changes).toEqual([]);
+      expect(getAllocationChanges(undefined, traffic[0].allocation).added).toEqual(90000);
+    });
+
+    it("reports nothing when a build is repeated without changes", async function () {
+      const state: ExistingState = { features: {} };
+      await run(feature({ a: 50, b: 50 }, 100), state);
+
+      const first: RebucketingChange[] = [];
+      const before = await run(feature({ a: 30, b: 70 }, 60), state, first);
+
+      const changes: RebucketingChange[] = [];
+      const after = await run(feature({ a: 30, b: 70 }, 60), state, changes);
+
+      expect(first.map((c) => c.rule)).toEqual(["everyone", "beta"]);
+      expect(after).toEqual(before);
+      expect(changes).toEqual([]);
+    });
+
+    it("prints each environment's changes once, after that environment's targets", async function () {
+      const states: { [environment: string]: ExistingState } = {
+        staging: { features: {} },
+        production: { features: {} },
+      };
+      await run(feature({ a: 50, b: 50 }, 100), states.staging, undefined, "staging");
+      await run(feature({ a: 25, b: 75 }, 100), states.production);
+
+      const events: string[] = [];
+      const project = {
+        ...datasource(feature({ a: 100 }, 100)),
+        listTargets: async () => ["web", "mobile"],
+        readTarget: async () => ({}),
+        readRevision: async () => "1",
+        readState: async (environment: string) => states[environment],
+        writeDatafile: async (
+          _content: unknown,
+          options: { environment: string; target: string },
+        ) => {
+          events.push(`datafile ${options.environment} ${options.target}`);
+        },
+        writeState: async () => {
+          events.push("state");
+        },
+        writeRevision: async () => {
+          events.push("revision");
+        },
+      };
+
+      const log = jest.spyOn(console, "log").mockImplementation((...args: unknown[]) => {
+        args
+          .map(String)
+          .join(" ")
+          .split("\n")
+          .forEach((line) => events.push(line));
+      });
+
+      try {
+        await buildProject({
+          rootDirectoryPath: root,
+          projectConfig: { ...config, environments: ["staging", "production"] },
+          datasource: project,
+          options: {},
+        } as any);
+      } finally {
+        log.mockRestore();
+      }
+
+      const summaries = events
+        .map((event, index) => ({ event, index }))
+        .filter(({ event }) => /checkout\b.*kept \d/.test(event));
+      const staging = summaries.filter(({ event }) => event.includes("kept 50%"));
+      const production = summaries.filter(({ event }) => event.includes("kept 25%"));
+
+      expect(summaries).toHaveLength(4);
+      expect(staging.map(({ event }) => /\((?:rule )?everyone\)/.test(event))).toEqual([
+        true,
+        false,
+      ]);
+      expect(production.map(({ event }) => /\((?:rule )?beta\)/.test(event))).toEqual([
+        false,
+        true,
+      ]);
+      staging.forEach(({ index }) => {
+        expect(index).toBeGreaterThan(events.indexOf("datafile staging mobile"));
+        expect(index).toBeLessThan(events.indexOf("datafile production web"));
+      });
+      production.forEach(({ index }) => {
+        expect(index).toBeGreaterThan(events.indexOf("datafile production mobile"));
+      });
+    });
+
+    it("formats one summary line per rebucketed rule", function () {
