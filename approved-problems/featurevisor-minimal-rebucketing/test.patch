+
+  describe("builds", function () {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), "featurevisor-rebucketing-"));
+
+    beforeAll(function () {
+      fs.mkdirSync(path.join(root, "features"), { recursive: true });
+    });
+
+    afterAll(function () {
+      fs.rmSync(root, { recursive: true, force: true });
+    });
+
+    const config = {
+      featuresDirectoryPath: path.join(root, "features"),
+      segmentsDirectoryPath: path.join(root, "segments"),
+      attributesDirectoryPath: path.join(root, "attributes"),
+      groupsDirectoryPath: path.join(root, "groups-missing"),
+      schemasDirectoryPath: path.join(root, "schemas"),
+      targetsDirectoryPath: path.join(root, "targets"),
+      variablesDirectoryPath: path.join(root, "variables"),
+      testsDirectoryPath: path.join(root, "tests"),
+      stateDirectoryPath: path.join(root, ".featurevisor"),
+      datafilesDirectoryPath: path.join(root, "datafiles"),
+      datafileNamePattern: "featurevisor-%s.json",
+      revisionFileName: "REVISION",
+      catalogDirectoryPath: path.join(root, "catalog"),
+      setsDirectoryPath: path.join(root, "sets"),
+      environments: ["production"],
+      sets: false,
+      namespaceCharacter: ".",
+      tags: ["all"],
+      adapter: {},
+      plugins: [],
+      defaultBucketBy: "userId",
+      parser: parsers.yml,
+      prettyState: true,
+      prettyDatafile: false,
+      stringify: false,
+      enforceCatchAllRule: false,
+    } as unknown as ProjectConfig;
+
+    function feature(
+      weights: { [value: string]: number },
+      percentage: number,
+      key = "checkout",
+    ): ParsedFeature {
+      return {
+        key,
+        description: "checkout",
+        tags: ["all"],
+        bucketBy: "userId",
+        variations: variations(weights),
+        rules: {
+          staging: [
+            { key: "everyone", segments: "*", percentage },
+            { key: "beta", segments: "*", percentage: 100 },
+          ],
+          production: [
+            { key: "everyone", segments: "*", percentage },
+            { key: "beta", segments: "*", percentage: 100 },
+          ],
+        },
+      } as unknown as ParsedFeature;
+    }
+
+    function datasource(parsed: ParsedFeature | ParsedFeature[]) {
+      const list = Array.isArray(parsed) ? parsed : [parsed];
+
+      return {
+        listSchemas: async () => [],
+        listFeatures: async () => list.map((f) => f.key),
+        readFeature: async (key: string) => list.find((f) => f.key === key),
+        listSegments: async () => [],
+        listAttributes: async () => [],
+        listVariables: async () => [],
+        getRequiredFeaturesChain: async (key: string) => new Set([key]),
+        getRequiredFeaturesChainForVariable: async () => new Set<string>(),
+      } as any;
+    }
+
+    async function run(
+      parsed: ParsedFeature | ParsedFeature[],
+      state: ExistingState,
+      rebucketing?: RebucketingChange[],
+      environment = "production",
+    ) {
+      const content = (await buildDatafile(
+        config,
+        datasource(parsed),
+        { revision: "1", environment, rebucketing },
+        state,
+      )) as DatafileContent;
+
+      return content.features.checkout.traffic;
+    }
+
+    it("keeps assignments across builds sharing state and reports the impact", async function () {
+      const state: ExistingState = { features: {} };
+      const first: RebucketingChange[] = [];
+      await run(feature({ a: 25, b: 25, c: 25, d: 25 }, 100), state, first);
+
+      expect(first).toEqual([]);
+
+      const second: RebucketingChange[] = [];
+      const traffic = await run(feature({ a: 50, b: 50 }, 80), state, second);
+
+      expect(traffic[0].allocation).toEqual([
+        { variation: "a", range: [0, 25000] },
+        { variation: "b", range: [25000, 50000] },
+        { variation: "a", range: [50000, 65000] },
+        { variation: "b", range: [65000, 80000] },
+      ]);
+      expect(state.features.checkout.traffic[0].allocation).toEqual(traffic[0].allocation);
+      expect(
+        second.map((c) => [c.environment, c.feature, c.rule, c.kept, c.moved, c.removed]),
+      ).toEqual([
+        ["production", "checkout", "everyone", 50000, 30000, 20000],
+        ["production", "checkout", "beta", 50000, 50000, 0],
+      ]);
+    });
+
+    it("reports one change per affected rule, in feature and rule order", async function () {
+      const state: ExistingState = { features: {} };
+      await run([feature({ a: 50, b: 50 }, 100), feature({ a: 50, b: 50 }, 100, "search")], state);
+
+      const changes: RebucketingChange[] = [];
+      await run([feature({ b: 100 }, 100, "search"), feature({ a: 100 }, 100)], state, changes);
+
+      expect(changes.map((c) => [c.feature, c.rule])).toEqual([
+        ["search", "everyone"],
+        ["search", "beta"],
+        ["checkout", "everyone"],
+        ["checkout", "beta"],
+      ]);
+      expect(changes[2]).toEqual({
+        environment: "production",
+        feature: "checkout",
+        rule: "everyone",
+        kept: 50000,
+        moved: 50000,
+        added: 0,
+        removed: 0,
+        variations: {
+          a: { kept: 50000, gained: 50000, lost: 0 },
+          b: { kept: 0, gained: 0, lost: 50000 },
+        },
+      });
+    });
+
+    it("appends to changes already in the collector", async function () {
+      const state: ExistingState = { features: {} };
+      await run(feature({ a: 50, b: 50 }, 100), state);
+
+      const sentinel = {
+        environment: "staging",
+        feature: "earlier",
+        rule: "earlier",
+        kept: 0,
+        moved: 0,
+        added: 0,
+        removed: 0,
+        variations: {},
+      } as RebucketingChange;
+      const changes: RebucketingChange[] = [sentinel];
+      await run(feature({ a: 100 }, 100), state, changes);
+
+      expect(changes[0]).toBe(sentinel);
+      expect(changes.slice(1).map((c) => c.rule)).toEqual(["everyone", "beta"]);
+    });
+
+    it("carries added mass on a collected change", async function () {
+      const state: ExistingState = { features: {} };
+      await run(feature({ a: 50, b: 50 }, 50), state);
+
+      const changes: RebucketingChange[] = [];
+      await run(feature({ a: 100 }, 100), state, changes);
+
+      expect(changes[0]).toEqual({
+        environment: "production",
+        feature: "checkout",
+        rule: "everyone",
+        kept: 25000,
+        moved: 25000,
+        added: 50000,
+        removed: 0,
+        variations: {
+          a: { kept: 25000, gained: 75000, lost: 0 },
+          b: { kept: 0, gained: 0, lost: 25000 },
+        },
+      });
+    });
+
+    it("reports nothing when a rollout only grows", async function () {
