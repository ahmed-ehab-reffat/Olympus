+class ReflectiveEnvironment(Environment):
+    """
+    An acoustic environment with specularly reflecting panels.
+
+    Sound reaches a receiver on the direct path and on every path that bounces off the panels in
+    :attr:`planes` up to :attr:`max_order` times. Each such path is described by the sequence of
+    panels the ray meets, and the pressure contributed by it follows from the length of the folded
+    ray and the reflection factors collected along it.
+
+    See Also
+    --------
+    :class:`~acoular.environments.ReflectingPlane` : A single reflecting panel.
+    :class:`~acoular.environments.Environment` : Propagation without reflections.
+
+    Notes
+    -----
+    - :meth:`~acoular.environments.Environment.apparent_r` is inherited unchanged and always reports
+      the direct distance.
+    - The image of the emitting point for a path is built by mirroring it about the panels of the
+      sequence one after another, in the order the ray meets them.
+    """
+
+    #: The reflecting panels present in the medium. Default is an empty list.
+    planes = List(Instance(ReflectingPlane))
+
+    #: The largest number of reflections a path may contain. Default is ``1``.
+    max_order = Int(1)
+
+    #: A unique identifier for the current set of panels. (read-only)
+    plane_digest = Str()
+
+    #: A unique identifier based on the environment properties. (read-only)
+    digest = Property(depends_on=['c', 'plane_digest', 'max_order'])
+
+    @cached_property
+    def _get_digest(self):
+        return digest(self)
+
+    @observe('planes.items.digest')
+    def _set_planesdigest(self, event):  # noqa: ARG002
+        self.plane_digest = ldigest(self.planes)
+
+    _sequence_cache = Property(depends_on=['plane_digest', 'max_order'])
+
+    @cached_property
+    def _get__sequence_cache(self):
+        sequences = [()]
+        current = [()]
+        for _ in range(max(self.max_order, 0)):
+            longer = [
+                (*sequence, index)
+                for sequence in current
+                for index in range(len(self.planes))
+                if not sequence or sequence[-1] != index
+            ]
+            sequences.extend(longer)
+            current = longer
+        return sequences, {sequence: position for position, sequence in enumerate(sequences)}
+
+    def _sequence_position(self, sequence):
+        position = self._sequence_cache[1].get(tuple(sequence))
+        if position is None:
+            msg = 'sequence is not one of the environment paths'
+            raise IndexError(msg)
+        return position
+
+    def path_sequences(self):
+        """Return every panel sequence a path may follow.
+
+        A sequence lists the indices into :attr:`planes` in the order the ray meets them. Two
+        consecutive reflections off the same panel are impossible, so no sequence repeats an index
+        next to itself. Sequences are grouped by increasing length and ordered lexicographically
+        within a group, which puts the empty tuple of the direct path first.
+
+        Returns
+        -------
+        :class:`list` of :class:`tuple`
+            The panel sequences.
+        """
+        if self.max_order < 0:
+            msg = 'max_order must not be negative'
+            raise ValueError(msg)
+        return list(self._sequence_cache[0])
+
+    def image(self, sequence, pos):
+        """Mirror positions about the panels of a path sequence, in the order they are met."""
+        _check_sequence(sequence)
+        _check_points(np.asarray(pos))
+        self._sequence_position(sequence)
+
+        pos = np.asarray(pos, dtype=np.float64)
+        for plane_index in sequence:
+            pos = self.planes[plane_index]._mirror(pos)
+        return pos
+
+    def image_velocity(self, sequence, vec):
+        """Mirror direction vectors about the panels of a path sequence, in the order they are met."""
+        _check_sequence(sequence)
+        _check_points(np.asarray(vec))
+        self._sequence_position(sequence)
+
+        vec = np.asarray(vec, dtype=np.float64)
+        for plane_index in sequence:
