+class ReflectingPlane(HasStrictTraits):
+    """
+    A flat rectangular panel that reflects sound specularly.
+
+    The panel is spanned by two perpendicular edges starting at a common corner. It reflects on both
+    of its faces and it is opaque, so it can also block a path that would otherwise cross it.
+
+    See Also
+    --------
+    :class:`~acoular.environments.ReflectiveEnvironment` : Propagation in the presence of panels.
+
+    Examples
+    --------
+    A one by one metre panel in the ground plane, mirroring a point one metre above it:
+
+    >>> import acoular as ac
+    >>> plane = ac.ReflectingPlane(corner=(-0.5, -0.5, 0.0), edge1=(1.0, 0.0, 0.0), edge2=(0.0, 1.0, 0.0))
+    >>> plane.normal
+    array([0., 0., 1.])
+    >>> plane.mirror([[0.0], [0.0], [1.0]])
+    array([[ 0.],
+           [ 0.],
+           [-1.]])
+    """
+
+    #: Coordinates ``(x, y, z)`` of one corner of the panel. Default is ``(0.0, 0.0, 0.0)``.
+    corner = CArray(dtype=np.float64, shape=(3,), value=np.array((0.0, 0.0, 0.0)))
+
+    #: First edge of the panel, starting at :attr:`corner`. Default is ``(1.0, 0.0, 0.0)``.
+    edge1 = CArray(dtype=np.float64, shape=(3,), value=np.array((1.0, 0.0, 0.0)))
+
+    #: Second edge of the panel, starting at :attr:`corner` and perpendicular to :attr:`edge1`.
+    #: Default is ``(0.0, 1.0, 0.0)``.
+    edge2 = CArray(dtype=np.float64, shape=(3,), value=np.array((0.0, 1.0, 0.0)))
+
+    #: Amplitude factor applied to the sound pressure on every reflection off this panel. Ignored
+    #: when :attr:`impedance` is set. Default is ``1.0``.
+    reflection_factor = Float(1.0)
+
+    #: Normalized surface impedance of the panel. When set, the amplitude factor of a reflection
+    #: depends on the angle at which the ray meets the panel. Default is :obj:`None`, which makes
+    #: the panel use :attr:`reflection_factor` at every angle.
+    impedance = Union(None, Float)
+
+    #: Unit normal of the panel, along the cross product of :attr:`edge1` and :attr:`edge2`.
+    #: (read-only)
+    normal = Property(depends_on=['edge1', 'edge2'])
+
+    #: A unique identifier based on the panel properties. (read-only)
+    digest = Property(depends_on=['corner', 'edge1', 'edge2', 'reflection_factor', 'impedance'])
+
+    @cached_property
+    def _get_digest(self):
+        return digest(self)
+
+    @cached_property
+    def _get_normal(self):
+        len1 = np.sqrt(np.dot(self.edge1, self.edge1))
+        len2 = np.sqrt(np.dot(self.edge2, self.edge2))
+        if len1 == 0.0 or len2 == 0.0:
+            msg = 'edge1 and edge2 must have non-zero length'
+            raise ValueError(msg)
+        if abs(np.dot(self.edge1, self.edge2)) > _REFLECTION_TOL * len1 * len2:
+            msg = 'edge1 and edge2 must be perpendicular'
+            raise ValueError(msg)
+        vec = np.cross(self.edge1, self.edge2)
+        return vec / np.sqrt(np.dot(vec, vec))
+
+    def signed_distance(self, pos):
+        """Compute the distance of points from the panel plane, signed along :attr:`normal`.
+
+        Parameters
+        ----------
+        pos : :class:`numpy.ndarray` of :class:`floats<float>`
+            The coordinates of the points, shape ``(3, N)``.
+
+        Returns
+        -------
+        :class:`numpy.ndarray` of :class:`floats<float>`
+            The signed distances, shape ``(N,)``. Positive values lie on the side
+            :attr:`normal` points to.
+        """
+        pos = np.asarray(pos, dtype=np.float64)
+        _check_points(pos)
+        return self._signed_distance(pos)
+
+    def _signed_distance(self, pos):
+        return np.einsum('i...,i->...', self._relative(pos), self.normal)
+
+    def mirror(self, pos):
+        """Reflect points about the panel plane.
+
+        Parameters
+        ----------
+        pos : :class:`numpy.ndarray` of :class:`floats<float>`
+            The coordinates of the points, shape ``(3, N)``.
+
+        Returns
+        -------
+        :class:`numpy.ndarray` of :class:`floats<float>`
+            The mirrored coordinates, shape ``(3, N)``.
+        """
+        pos = np.asarray(pos, dtype=np.float64)
+        _check_points(pos)
+        return self._mirror(pos)
+
+    def _mirror(self, pos):
+        offset = self._signed_distance(pos)[np.newaxis] * self._aligned(self.normal, pos.ndim)
+        return pos - 2.0 * offset
+
+    def mirror_direction(self, vec):
+        """Reflect direction vectors about the panel plane.
+
+        The panel position plays no role here, so the vectors keep their length and only turn.
+
+        Parameters
+        ----------
+        vec : :class:`numpy.ndarray` of :class:`floats<float>`
+            The vectors to reflect, shape ``(3, N)``.
+
+        Returns
+        -------
+        :class:`numpy.ndarray` of :class:`floats<float>`
+            The reflected vectors, shape ``(3, N)``.
+        """
+        vec = np.asarray(vec, dtype=np.float64)
+        _check_points(vec)
+        return self._mirror_direction(vec)
+
+    def _mirror_direction(self, vec):
+        projection = np.einsum('i...,i->...', vec, self.normal)
+        return vec - 2.0 * projection[np.newaxis] * self._aligned(self.normal, vec.ndim)
+
+    def contains(self, pos):
+        """Test whether points lie on the panel plane and within its rectangle.
+
+        Parameters
+        ----------
+        pos : :class:`numpy.ndarray` of :class:`floats<float>`
+            The coordinates of the points, shape ``(3, N)``.
+
+        Returns
+        -------
+        :class:`numpy.ndarray` of :class:`bool`
+            :obj:`True` where the point lies on the panel, shape ``(N,)``.
+        """
+        pos = np.asarray(pos, dtype=np.float64)
+        _check_points(pos)
+        return self._contains(pos)
+
+    def _contains(self, pos):
+        rel = self._relative(pos)
+        on_plane = np.abs(np.einsum('i...,i->...', rel, self.normal)) <= _REFLECTION_TOL
+        first = np.einsum('i...,i->...', rel, self.edge1) / np.dot(self.edge1, self.edge1)
+        second = np.einsum('i...,i->...', rel, self.edge2) / np.dot(self.edge2, self.edge2)
+        within = (
+            (first >= -_REFLECTION_TOL)
+            & (first <= 1.0 + _REFLECTION_TOL)
+            & (second >= -_REFLECTION_TOL)
+            & (second <= 1.0 + _REFLECTION_TOL)
+        )
+        return on_plane & within
+
+    def factor_at(self, cosine):
+        """Compute the amplitude factor of a reflection at a given angle of incidence.
+
+        Without an :attr:`impedance` the panel applies :attr:`reflection_factor` at every angle.
+        With one, the factor follows the plane wave reflection coefficient of a locally reacting
+        surface, which requires a positive impedance.
+
+        Parameters
+        ----------
+        cosine : :class:`numpy.ndarray` of :class:`floats<float>`
+            Cosine of the angle between the incoming ray and the panel normal, shape ``(N,)``.
+
+        Returns
+        -------
+        :class:`numpy.ndarray` of :class:`floats<float>`
+            The amplitude factors, shape ``(N,)``.
+
+        Raises
+        ------
+        :obj:`ValueError`
+            If :attr:`impedance` is set to a value that is not positive.
+        """
+        cosine = np.asarray(cosine, dtype=np.float64)
+        if self.impedance is None:
+            return np.full(cosine.shape, self.reflection_factor, dtype=np.float64)
+        if self.impedance <= 0.0:
+            msg = 'impedance must be positive'
+            raise ValueError(msg)
+        scaled = self.impedance * cosine
+        return (scaled - 1.0) / (scaled + 1.0)
+
+    def crossing(self, start, end):
+        """Compute where a segment crosses the panel plane, strictly between its endpoints.
+
+        Parameters
+        ----------
+        start : :class:`numpy.ndarray` of :class:`floats<float>`
+            The coordinates of the segment starts, shape ``(3, N)``.
+
+        end : :class:`numpy.ndarray` of :class:`floats<float>`
+            The coordinates of the segment ends, shape ``(3, N)``.
+
+        Returns
+        -------
+        :class:`tuple` of :class:`numpy.ndarray`
+            The crossing coordinates of shape ``(3, N)``, :obj:`nan` where the segment does not
+            cross the plane between its endpoints, and a boolean array of shape ``(N,)`` marking
+            the segments that do.
+        """
+        start = np.asarray(start, dtype=np.float64)
+        end = np.asarray(end, dtype=np.float64)
+        _check_points(start, end)
+        if start.shape != end.shape:
+            msg = 'crossing needs matching start and end arrays'
+            raise ValueError(msg)
+        return self._crossing(start, end)
+
+    def _crossing(self, start, end):
+        near = self._signed_distance(start)
+        far = self._signed_distance(end)
+        denominator = near - far
+        with np.errstate(divide='ignore', invalid='ignore'):
+            share = np.where(denominator != 0.0, near / denominator, np.nan)
+        crosses = (share > _REFLECTION_TOL) & (share < 1.0 - _REFLECTION_TOL)
+        point = start + share[np.newaxis] * (end - start)
+        return np.where(crosses[np.newaxis], point, np.nan), crosses
+
+    def _relative(self, pos):
+        pos = np.asarray(pos, dtype=np.float64)
+        return pos - self._aligned(self.corner, pos.ndim)
+
+    @staticmethod
+    def _aligned(vec, ndim):
+        return vec.reshape((3, *([1] * (ndim - 1))))
+
