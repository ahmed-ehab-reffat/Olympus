+def test_time_beamformer_sq_autopower_of_unequal_microphones():
+    env = ac.environments.ReflectiveEnvironment(planes=[floor()], max_order=1)
+    steer = ac.SteeringVector(
+        grid=grid((0.0, 0.0, 1.0)),
+        mics=mics((1.0, 0.0, 1.0), (-0.5, 0.0, 1.4)),
+        env=env,
+        steer_type='classic',
+    )
+    steps = np.arange(64)
+    first = np.sin(0.7 * steps) + 0.5
+    second = np.cos(0.4 * steps) + 0.3
+    silent = np.zeros(64)
+
+    def run(columns, factory, **kw):
+        source = ac.TimeSamples(sample_freq=343.0, data=np.stack(columns, axis=1))
+        return np.concatenate([block.copy() for block in factory(source=source, steer=steer, **kw).result(32)])[:, 0]
+
+    alone_first = run((first, silent), ac.BeamformerTime)
+    alone_second = run((silent, second), ac.BeamformerTime)
+    removed = run((first, second), ac.BeamformerTimeSq, r_diag=True)
+    assert np.abs(removed).max() > 1e-6
+    np.testing.assert_allclose(removed, np.clip(2.0 * alone_first * alone_second, 0.0, None), atol=1e-12)
