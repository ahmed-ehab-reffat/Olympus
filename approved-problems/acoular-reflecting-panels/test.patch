+def rotated(vector, angle=0.37):
+    cos, sin = np.cos(angle), np.sin(angle)
+    matrix = np.array([[cos, 0.0, -sin], [0.0, 1.0, 0.0], [sin, 0.0, cos]])
+    return matrix @ np.asarray(vector, dtype=float)
