+def moving(env, start, stop, speed=20.0, num_samples=4096, receiver=(0.0, 0.0, 1.0), block=512, conv_amp=False):
+    duration = np.linalg.norm(np.array(stop) - np.array(start)) / speed
+    signal = ac.WNoiseGenerator(sample_freq=48000.0, num_samples=num_samples, seed=11)
+    trajectory = ac.Trajectory(points={0.0: tuple(start), duration: tuple(stop)})
+    source = ac.MovingPointSource(signal=signal, mics=mics(receiver), env=env, trajectory=trajectory, start_t=0.0, conv_amp=conv_amp)
+    return np.concatenate([data.copy() for data in source.result(block)])[:, 0]
