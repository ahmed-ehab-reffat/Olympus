+def dipole(env, loc, receiver, direction=(1.0, 0.0, 0.0), num_samples=8192, block=512):
+    signal = ac.SineGenerator(freq=800.0, sample_freq=48000.0, num_samples=num_samples)
+    source = ac.PointSourceDipole(signal=signal, loc=loc, mics=mics(receiver), env=env, direction=direction)
+    return np.concatenate([block_data.copy() for block_data in source.result(block)])[:, 0]
+
