+def test_time_beamformer_keeps_grid_points_separate():
+    env = ac.environments.ReflectiveEnvironment(planes=[floor(half=0.4)], max_order=1)
+    sources = ((0.0, 0.0, 1.0), (2.5, 0.0, 1.0))
+    receiver = (0.0, 0.0, 1.0)
+    _, _, valid = env.paths(points(*sources), points(receiver))
+    assert valid[1, 0, 0] != valid[1, 1, 0]
+    steer = ac.SteeringVector(grid=grid(*sources), mics=mics(receiver), env=env, steer_type='classic')
+    full = np.concatenate([b.copy() for b in ac.BeamformerTime(source=impulse_data(), steer=steer).result(32)])
+    for index, source in enumerate(sources):
+        one = ac.SteeringVector(grid=grid(source), mics=mics(receiver), env=env, steer_type='classic')
+        alone = np.concatenate([b.copy() for b in ac.BeamformerTime(source=impulse_data(), steer=one).result(32)])
+        # the buffer length follows the largest delay in the grid, so compare the shared span
+        shared = min(full.shape[0], alone.shape[0])
+        np.testing.assert_allclose(full[:shared, index], alone[:shared, 0], atol=1e-12)
