+def beamform(env, source, receiver, steer_type='classic'):
+    steer = ac.SteeringVector(grid=grid(source), mics=mics(receiver), env=env, steer_type=steer_type)
+    beamformer = ac.BeamformerTime(source=impulse_data(), steer=steer)
+    return np.concatenate([block.copy() for block in beamformer.result(32)])[:, 0]
