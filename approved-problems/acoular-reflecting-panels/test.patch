+def continuous_data(length=64, channels=1):
+    steps = np.arange(length)
+    samples = np.sin(0.7 * steps)[:, np.newaxis] + 0.5
+    return ac.TimeSamples(sample_freq=343.0, data=np.repeat(samples, channels, axis=1))
