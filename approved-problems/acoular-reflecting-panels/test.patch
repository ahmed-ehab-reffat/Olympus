+def test_dipole_second_order_equals_the_scaled_twice_mirrored_dipoles():
+    receiver = (1.0, 0.0, 1.5)
+    loc = (0.0, 0.0, 0.5)
+    residual = dipole(opposed_wide_panels(2), loc, receiver) - dipole(opposed_wide_panels(1), loc, receiver)
+    direct = np.linalg.norm(np.array(receiver) - np.array(loc))
+    lower_then_upper = np.linalg.norm(np.array(receiver) - np.array([0.0, 0.0, 4.5]))
+    upper_then_lower = np.linalg.norm(np.array(receiver) - np.array([0.0, 0.0, -3.5]))
+    expected = direct / lower_then_upper * dipole(ac.Environment(), (0.0, 0.0, 4.5), receiver)
+    expected = expected + direct / upper_then_lower * dipole(ac.Environment(), (0.0, 0.0, -3.5), receiver)
+    assert np.abs(residual).max() > 1e-6
+    np.testing.assert_allclose(residual, expected, atol=1e-7)
