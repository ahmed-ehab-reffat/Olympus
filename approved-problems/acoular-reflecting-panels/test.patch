+def line_channels(env, loc, receivers, num_sources=3, num_samples=8192, block=512):
+    signal = ac.WNoiseGenerator(sample_freq=48000.0, num_samples=num_samples, seed=7)
+    source = ac.LineSource(
+        signal=signal,
+        loc=loc,
+        mics=mics(*receivers),
+        env=env,
+        direction=(1.0, 0.0, 0.0),
+        length=0.4,
+        num_sources=num_sources,
+        source_strength=np.ones(num_sources),
+    )
+    return np.concatenate([block_data.copy() for block_data in source.result(block)])
+
+
+def line(env, loc, receiver, num_samples=8192, block=512):
+    return line_channels(env, loc, (receiver,), num_samples=num_samples, block=block)[:, 0]
