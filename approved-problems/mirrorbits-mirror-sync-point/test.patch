+func expectSync6075cf(t *testing.T, res *ScanResult, gen, source int64) {
+	t.Helper()
+	if res.SyncGeneration != gen || res.SourceGeneration != source {
+		t.Fatalf("sync generation %d of %d, want %d of %d", res.SyncGeneration, res.SourceGeneration, gen, source)
+	}
+}
+
+func expectStored6075cf(t *testing.T, m mirrors.Mirror, res *ScanResult) {
+	t.Helper()
+	if m.SyncGeneration != res.SyncGeneration || m.SourceGeneration != res.SourceGeneration {
+		t.Fatalf("stored mirror at %d of %d, scan result %d of %d", m.SyncGeneration, m.SourceGeneration, res.SyncGeneration, res.SourceGeneration)
+	}
+}
