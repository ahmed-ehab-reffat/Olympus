+type syncEnv6075cf struct {
+	t      *testing.T
+	r      *database.Redis
+	repo   string
+	fake   string
+	stamp  time.Time
+	config Configuration
+}
+
+func newSyncEnv6075cf(t *testing.T) *syncEnv6075cf {
+	addr := os.Getenv("MIRRORBITS_TEST_REDIS")
+	if addr == "" {
+		addr = "127.0.0.1:6379"
+	}
+	e := &syncEnv6075cf{
+		t:     t,
+		repo:  t.TempDir(),
+		fake:  t.TempDir(),
+		stamp: time.Date(2026, 3, 1, 10, 0, 0, 250000000, time.UTC),
+		config: Configuration{
+			RedisAddress:  addr,
+			SourceHistory: 10,
+		},
+	}
+	e.config.Repository = e.repo
+	SetConfiguration(&e.config)
+
+	raw, err := redis.Dial("tcp", addr)
+	if err != nil {
+		t.Fatalf("redis: %s", err)
+	}
+	_, err = raw.Do("FLUSHALL")
+	if err == nil {
+		_, err = raw.Do("SCRIPT", "FLUSH")
+	}
+	raw.Close()
+	if err != nil {
+		t.Fatalf("redis: %s", err)
+	}
+
+	e.r = database.NewRedis()
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		conn := e.r.Get()
+		_, err := conn.Do("PING")
+		conn.Close()
+		if err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("redis not ready: %s", err)
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	e.r.ConnectPubsub()
+	t.Cleanup(e.r.Close)
+
+	script := fmt.Sprintf("#!/bin/sh\n/bin/cat %[1]s/stdout\n/bin/cat %[1]s/stderr >&2\nexit $(/bin/cat %[1]s/status)\n", e.fake)
+	if err := os.WriteFile(filepath.Join(e.fake, "rsync"), []byte(script), 0755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", e.fake+":"+os.Getenv("PATH"))
+	return e
+}
+
+func (e *syncEnv6075cf) setHistory(n int) {
+	e.config.SourceHistory = n
+	SetConfiguration(&e.config)
+}
+
+func (e *syncEnv6075cf) write(path, content string) {
+	e.stamp = e.stamp.Add(time.Minute)
+	full := filepath.Join(e.repo, path)
+	if err := os.MkdirAll(filepath.Dir(full), 0755); err != nil {
+		e.t.Fatal(err)
+	}
+	if err := os.WriteFile(full, []byte(content), 0644); err != nil {
+		e.t.Fatal(err)
+	}
+	if err := os.Chtimes(full, e.stamp, e.stamp); err != nil {
+		e.t.Fatal(err)
+	}
+}
+
+func (e *syncEnv6075cf) remove(path string) {
+	if err := os.Remove(filepath.Join(e.repo, path)); err != nil {
+		e.t.Fatal(err)
+	}
+}
+
+func (e *syncEnv6075cf) scanSource(rehash bool) {
+	if err := ScanSource(e.r, rehash, nil); err != nil {
+		e.t.Fatalf("source scan: %s", err)
+	}
+}
+
+func (e *syncEnv6075cf) snapshot(paths ...string) []listedFile6075cf {
+	var out []listedFile6075cf
+	for _, p := range paths {
+		fi, err := os.Stat(filepath.Join(e.repo, p))
+		if err != nil {
+			e.t.Fatal(err)
+		}
+		out = append(out, listedFile6075cf{path: p, size: fi.Size(), modTime: fi.ModTime()})
+	}
+	return out
+}
+
+func (e *syncEnv6075cf) addMirror(id int) {
+	conn := e.r.Get()
+	defer conn.Close()
+	name := fmt.Sprintf("mirror%d", id)
+	if _, err := conn.Do("HSET", "MIRRORS", id, name); err != nil {
+		e.t.Fatal(err)
+	}
+	if _, err := conn.Do("HSET", fmt.Sprintf("MIRROR_%d", id), "ID", id, "name", name, "http", "http://127.0.0.1:1/", "enabled", true); err != nil {
+		e.t.Fatal(err)
+	}
+}
+
+func rsyncListing6075cf(files []listedFile6075cf, shift time.Duration) string {
+	var b strings.Builder
+	b.WriteString("drwxr-xr-x          4,096 2026/01/01 00:00:00 .\n")
+	for _, f := range files {
+		fmt.Fprintf(&b, "-rw-r--r-- %14d %s %s\n", f.size, f.modTime.Add(shift).UTC().Format("2006/01/02 15:04:05"), strings.TrimPrefix(f.path, "/"))
+	}
+	return b.String()
+}
+
+func (e *syncEnv6075cf) scanMirror(id int, stdout, stderr string, status int) *ScanResult {
+	url := "rsync://mirror.example/pub/"
+	for name, content := range map[string]string{"stdout": stdout, "stderr": stderr, "status": fmt.Sprint(status)} {
+		if err := os.WriteFile(filepath.Join(e.fake, name), []byte(content), 0644); err != nil {
+			e.t.Fatal(err)
+		}
+	}
+	res, err := Scan(core.RSYNC, e.r, mirrors.NewCache(e.r), url, id, nil)
+	for i := 0; err == ErrScanInProgress && i < 500; i++ {
+		time.Sleep(10 * time.Millisecond)
+		res, err = Scan(core.RSYNC, e.r, mirrors.NewCache(e.r), url, id, nil)
+	}
+	if err != nil {
+		e.t.Fatalf("mirror scan: %s", err)
+	}
+	return res
+}
+
+func (e *syncEnv6075cf) storedMirror(id int) mirrors.Mirror {
+	m, err := mirrors.NewCache(e.r).GetMirror(id)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	return m
+}
