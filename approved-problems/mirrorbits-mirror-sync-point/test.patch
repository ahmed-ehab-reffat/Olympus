+	stderr := "rsync: [sender] readlink_stat(\"/pool/x.iso\" (in pub)) failed: Permission denied (13)\n" +
+		"rsync: readlink_stat(\"pool/sub\" (in pub)) failed: Permission denied (13)\n" +
+		"rsync error: some files/attrs were not transferred (see previous errors) (code 23) at main.c(1338) [generator=3.2.7]\n"
+	res := e.scanMirror(1, rsyncListing6075cf(e.snapshot("/a.iso", "/pool/y.iso"), 0), stderr, 23)
