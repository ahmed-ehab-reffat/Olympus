diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..56c915c
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,128 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/mirrorbits-test-results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+export GOFLAGS="${GOFLAGS:--buildvcs=false}"
+if [ ! -w "$(go env GOCACHE)" ]; then
+  export GOCACHE="$(mktemp -d)"
+fi
+
+VERSION="$(git describe --always --tags 2>/dev/null || echo dev)"
+LDFLAGS="-X github.com/etix/mirrorbits/core.VERSION=$VERSION"
+
+WORK="$(mktemp -d)"
+RAW="$WORK/go-test.txt"
+NEW_TAG="syncpoint"
+NEW_FILES=$(grep -l "^//go:build $NEW_TAG" $(find . -name '*_test.go' -not -path './.git/*') 2>/dev/null)
+NEW_NAMES=$(for f in $NEW_FILES; do grep -oE '^func (Test[A-Za-z0-9_]+)' "$f" | awk '{print $2}'; done)
+
+REDIS_PORT=6390
+start_redis() {
+  redis-server --port "$REDIS_PORT" --bind 127.0.0.1 --save "" --appendonly no \
+    --dir "$WORK" --pidfile "$WORK/redis.pid" --logfile "$WORK/redis.log" --daemonize yes
+  for _ in $(seq 1 100); do
+    if redis-cli -p "$REDIS_PORT" ping 2>/dev/null | grep -q PONG; then
+      return 0
+    fi
+    sleep 0.1
+  done
+  return 1
+}
+stop_redis() {
+  redis-cli -p "$REDIS_PORT" shutdown nosave >/dev/null 2>&1 || true
+}
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+drop_build_failures() {
+  [ -f "$OUTPUT_PATH" ] || return 0
+  awk '
+    /<testsuite[ >]/ { buf = $0 "\n"; insuite = 1; failed = 0; next }
+    insuite { buf = buf $0 "\n"; if (index($0, "[build failed]")) failed = 1
+              if (index($0, "</testsuite>")) { if (!failed) printf "%s", buf; insuite = 0 }
+              next }
+    { print }
+  ' "$OUTPUT_PATH" > "$WORK/filtered.xml" && mv "$WORK/filtered.xml" "$OUTPUT_PATH"
+}
+
+write_missing() {
+  local detail
+  detail=$(tail -c 20000 "$RAW" | xml_escape)
+  local names=() pkgs=()
+  for f in $NEW_FILES; do
+    local pkg="github.com/etix/mirrorbits/$(dirname "${f#./}")"
+    for name in $(grep -oE '^func (Test[A-Za-z0-9_]+)' "$f" | awk '{print $2}'); do
+      if ! grep -q "name=\"$name\"" "$OUTPUT_PATH" 2>/dev/null; then
+        names+=("$name")
+        pkgs+=("$pkg")
+      fi
+    done
+  done
+  [ "${#names[@]}" -eq 0 ] && return 0
+  local body="$WORK/missing.xml"
+  {
+    echo "<testsuite name=\"missing\" tests=\"${#names[@]}\" failures=\"${#names[@]}\" errors=\"0\">"
+    for i in "${!names[@]}"; do
+      echo "<testcase name=\"${names[$i]}\" classname=\"${pkgs[$i]}\"><failure message=\"no result reported\">$detail</failure></testcase>"
+    done
+    echo "</testsuite>"
+  } > "$body"
+  if [ -s "$OUTPUT_PATH" ] && grep -q "</testsuites>" "$OUTPUT_PATH"; then
+    sed -i "s#</testsuites>##" "$OUTPUT_PATH"
+    cat "$body" >> "$OUTPUT_PATH"
+    echo "</testsuites>" >> "$OUTPUT_PATH"
+  else
+    { echo '<?xml version="1.0" encoding="UTF-8"?>'; echo "<testsuites>"; cat "$body"; echo "</testsuites>"; } > "$OUTPUT_PATH"
+  fi
+  return 1
+}
+
+STATUS=0
+case "$MODE" in
+  base)
+    go test -v -count=1 -timeout 600s -ldflags "$LDFLAGS" -skip '^TestRefreshNodeList$' ./... > "$RAW" 2>&1
+    STATUS=$?
+    go-junit-report -set-exit-code < "$RAW" > "$OUTPUT_PATH" || STATUS=1
+    ;;
+  new)
+    if ! start_redis; then
+      echo "redis-server did not start" >> "$RAW"
+      cat "$WORK/redis.log" >> "$RAW" 2>/dev/null
+      STATUS=1
+    else
+      export MIRRORBITS_TEST_REDIS="127.0.0.1:$REDIS_PORT"
+      PKGS=$(for f in $NEW_FILES; do echo "./$(dirname "${f#./}")"; done | sort -u)
+      PATTERN="^($(echo $NEW_NAMES | tr ' ' '|'))\$"
+      go test -v -count=1 -p 1 -timeout 600s -ldflags "$LDFLAGS" -tags "$NEW_TAG" -run "$PATTERN" $PKGS > "$RAW" 2>&1
+      STATUS=$?
+      stop_redis
+    fi
+    go-junit-report -set-exit-code < "$RAW" > "$OUTPUT_PATH" || STATUS=1
+    drop_build_failures
+    write_missing || STATUS=1
+    ;;
+  *)
+    echo "usage: ./test.sh [--output_path <file>] base|new"
+    exit 2
+    ;;
+esac
+
+cat "$RAW"
+rm -rf "$WORK"
+exit "$STATUS"
