+func (e *syncEnv6075cf) serves(path string, id int) bool {
+	serving, err := mirrors.NewCache(e.r).GetMirrors(path, network.GeoIPRecord{})
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	for _, m := range serving {
+		if m.ID == id {
+			return true
+		}
+	}
+	return false
+}
