+func (s *scan) locateSyncPoint(tzoffset int64, precision core.Precision) (*syncPoint, error) {
+	if precision == 0 {
+		precision = core.Precision(time.Second)
+	}
+	history, err := loadSourceHistory(s.conn)
+	if err != nil {
+		return nil, err
+	}
+	if err := history.keepFloor(s.conn); err != nil {
+		return nil, err
+	}
+	sp := history.solve(s.listed, s.unreadable, time.Duration(tzoffset)*time.Millisecond, precision.Duration())
+	if err := storeSyncPoint(s.conn, s.mirrorid, sp); err != nil {
+		return nil, err
+	}
+	return sp, nil
+}
