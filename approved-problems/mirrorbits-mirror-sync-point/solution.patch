@@ -0,0 +1,296 @@
+// Copyright (c) 2014-2019 Ludovic Fauvet
+// Licensed under the MIT license
+
+package scan
+
+import (
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+
+	. "github.com/etix/mirrorbits/config"
+	"github.com/etix/mirrorbits/database"
+	"github.com/gomodule/redigo/redis"
+)
+
+const (
+	sourceGenerationKey = "SOURCE_GENERATION"
+	sourceHistoryKey    = "SOURCE_HISTORY"
+	sourceFloorKey      = "SOURCE_HISTORY_FLOOR"
+)
+
+var raiseFloor = redis.NewScript(1, `
+local floor = tonumber(redis.call("GET", KEYS[1]) or "0")
+if tonumber(ARGV[1]) > floor then
+	redis.call("SET", KEYS[1], ARGV[1])
+end
+return floor
+`)
+
+type fileVersion struct {
+	Size    int64
+	ModTime time.Time
+	From    int64
+	Until   int64
+}
+
+type sourceHistory struct {
+	generation int64
+	floor      int64
+	paths      map[string][]fileVersion
+}
+
+type syncPoint struct {
+	Generation       int64
+	SourceGeneration int64
+}
+
+func historyDepth() int64 {
+	depth := int64(GetConfig().SourceHistory)
+	if depth < 1 {
+		depth = 1
+	}
+	return depth
+}
+
+func (h *sourceHistory) oldest() int64 {
+	oldest := h.generation - historyDepth() + 1
+	if oldest < h.floor {
+		oldest = h.floor
+	}
+	if oldest < 1 {
+		oldest = 1
+	}
+	return oldest
+}
+
+func (v fileVersion) covers(generation int64) bool {
+	return generation >= v.From && (v.Until == 0 || generation < v.Until)
+}
+
+func anyCovers(versions []fileVersion, generation int64) bool {
+	for _, v := range versions {
+		if v.covers(generation) {
+			return true
+		}
+	}
+	return false
+}
+
+func currentVersion(versions []fileVersion) *fileVersion {
+	if n := len(versions); n > 0 && versions[n-1].Until == 0 {
+		return &versions[n-1]
+	}
+	return nil
+}
+
+func loadSourceHistory(conn redis.Conn) (*sourceHistory, error) {
+	conn.Send("MULTI")
+	conn.Send("GET", sourceGenerationKey)
+	conn.Send("GET", sourceFloorKey)
+	conn.Send("HGETALL", sourceHistoryKey)
+	reply, err := redis.Values(conn.Do("EXEC"))
+	if err != nil {
+		return nil, err
+	}
+	gen, err := redis.Int64(reply[0], nil)
+	if err == redis.ErrNil {
+		gen, err = 0, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	floor, err := redis.Int64(reply[1], nil)
+	if err == redis.ErrNil {
+		floor, err = 0, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	raw, err := redis.StringMap(reply[2], nil)
+	if err != nil {
+		return nil, err
+	}
+	h := &sourceHistory{
+		generation: gen,
+		floor:      floor,
+		paths:      make(map[string][]fileVersion, len(raw)),
+	}
+	for path, value := range raw {
+		var versions []fileVersion
+		if err := json.Unmarshal([]byte(value), &versions); err != nil {
+			return nil, fmt.Errorf("invalid history for %s: %w", path, err)
+		}
+		h.paths[path] = versions
+	}
+	return h, nil
+}
+
+func (h *sourceHistory) advance(files []*filedata) map[string][]fileVersion {
+	next := h.generation + 1
+	updated := make(map[string][]fileVersion)
+	seen := make(map[string]bool, len(files))
+
+	for _, f := range files {
+		seen[f.path] = true
+		versions := append([]fileVersion(nil), h.paths[f.path]...)
+		cur := currentVersion(versions)
+		if cur != nil && cur.Size == f.size && cur.ModTime.Equal(f.modTime) {
+			continue
+		}
+		if cur != nil {
+			cur.Until = next
+		}
+		updated[f.path] = append(versions, fileVersion{
+			Size:    f.size,
+			ModTime: f.modTime,
+			From:    next,
+		})
+	}
+
+	for path, versions := range h.paths {
+		if currentVersion(versions) != nil && !seen[path] {
+			versions = append([]fileVersion(nil), versions...)
+			versions[len(versions)-1].Until = next
+			updated[path] = versions
+		}
+	}
+
+	if len(updated) > 0 || h.generation == 0 {
+		h.generation = next
+	}
+	oldest := h.oldest()
+	moved := oldest != h.floor
+	h.floor = oldest
+	for path, versions := range h.paths {
+		if _, ok := updated[path]; !ok {
+			if kept := forget(versions, oldest); len(kept) != len(versions) {
+				updated[path] = kept
+			}
+		}
+	}
+	for path, versions := range updated {
+		updated[path] = forget(versions, oldest)
+		h.paths[path] = updated[path]
+	}
+	if len(updated) == 0 && h.generation != next && !moved {
+		return nil
+	}
+	return updated
+}
+
+func forget(versions []fileVersion, oldest int64) []fileVersion {
+	kept := make([]fileVersion, 0, len(versions))
+	for _, v := range versions {
+		if v.Until == 0 || v.Until > oldest {
+			kept = append(kept, v)
+		}
+	}
+	return kept
+}
+
+func (h *sourceHistory) queue(conn redis.Conn, updated map[string][]fileVersion) error {
+	for path, versions := range updated {
+		if len(versions) == 0 {
+			conn.Send("HDEL", sourceHistoryKey, path)
+			continue
+		}
+		value, err := json.Marshal(versions)
+		if err != nil {
+			return err
+		}
+		conn.Send("HSET", sourceHistoryKey, path, value)
+	}
+	conn.Send("SET", sourceGenerationKey, h.generation)
+	raiseFloor.Send(conn, sourceFloorKey, h.floor)
+	return nil
+}
+
+func (h *sourceHistory) keepFloor(conn redis.Conn) error {
+	oldest := h.oldest()
+	if oldest <= h.floor {
+		return nil
+	}
+	if _, err := raiseFloor.Do(conn, sourceFloorKey, oldest); err != nil {
+		return err
+	}
+	h.floor = oldest
+	return nil
+}
+
+func underDirectory(path string, dirs []string) bool {
+	for _, dir := range dirs {
+		dir = strings.TrimSuffix(dir, "/")
+		if dir == "" || path == dir || strings.HasPrefix(path, dir+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+func sameContent(v fileVersion, f filedata, offset, precision time.Duration) bool {
+	if v.Size != f.size || f.modTime.IsZero() {
+		return false
+	}
+	return f.modTime.Add(offset).Truncate(precision).Equal(v.ModTime.Truncate(precision))
+}
+
+func (h *sourceHistory) solve(listed map[string]filedata, unreadable []string, offset, precision time.Duration) *syncPoint {
+	sp := &syncPoint{SourceGeneration: h.generation}
+
+	oldest := h.oldest()
+	possible := make([]bool, 0, h.generation-oldest+1)
+	for g := oldest; g <= h.generation; g++ {
+		possible = append(possible, true)
+	}
+	restrict := func(versions []fileVersion, held bool) {
+		for i := range possible {
+			if anyCovers(versions, oldest+int64(i)) != held {
+				possible[i] = false
+			}
+		}
+	}
+
+	for path, versions := range h.paths {
+		if versions = forget(versions, oldest); len(versions) == 0 {
+			continue
+		}
+		f, ok := listed[path]
+		switch {
+		case underDirectory(path, unreadable):
+		case ok:
+			var matched []fileVersion
+			for _, v := range versions {
+				if sameContent(v, f, offset, precision) {
+					matched = append(matched, v)
+				}
+			}
+			if len(matched) > 0 {
+				restrict(matched, true)
+			}
+		default:
+			restrict(versions, false)
+		}
+	}
+
+	for i := len(possible) - 1; i >= 0; i-- {
+		if possible[i] {
+			sp.Generation = oldest + int64(i)
+			break
+		}
+	}
+	return sp
+}
+
+func storeSyncPoint(conn redis.Conn, id int, sp *syncPoint) error {
+	_, err := conn.Do("HSET", fmt.Sprintf("MIRROR_%d", id),
+		"syncGeneration", sp.Generation,
+		"sourceGeneration", sp.SourceGeneration)
+	if err != nil {
+		return err
+	}
+	database.Publish(conn, database.MIRROR_UPDATE, strconv.Itoa(id))
+	return nil
+}
