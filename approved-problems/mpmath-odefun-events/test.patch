+import pytest
+
+import mpmath
+from mpmath import cos, exp, log, mp, mpf, pi, sin, sinh, sqrt
+
+
+@pytest.fixture(autouse=True)
+def restore_precision():
+    dps = mp.dps
+    yield
+    mp.dps = dps
+
+
+def event(g, **kwargs):
+    return mpmath.ODEEvent(g, **kwargs)
+
+
+def exponential(**kwargs):
+    return mpmath.odefun(lambda x, y: y, 0, 1, **kwargs)
+
+
+def circular(**kwargs):
+    return mpmath.odefun(lambda x, y: [-y[1], y[0]], 0, [1, 0], **kwargs)
+
+
+def gravity():
+    return mpf('9.8')
+
+
+def restitution():
+    return mpf(1)/2
+
+
+def bouncing(height=2, **kwargs):
+    weight = gravity()
+    bounce = restitution()
+    ball = event(lambda x, y: y[0], direction=-1,
+                 reset=lambda x, y: [mpf(0), -bounce*y[1]], **kwargs)
+    return mpmath.odefun(lambda x, y: [y[1], -weight], 0, [height, 0],
+                         events=[ball])
+
+
+def bounce_times(height=2, n=3):
+    first = sqrt(2*mpf(height)/gravity())
+    out = [first]
+    for k in range(1, n):
+        out.append(out[-1] + 2*restitution()**k*first)
+    return out
+
+
+def impact_speed(height=2):
+    return -sqrt(2*gravity()*height)
+
+
+def oscillator(rate):
+    return mpmath.odefun(lambda x, y: [y[1], -rate**2*y[0]], 0, [1, 0])
+
+
+def cubic():
+    return mpmath.odefun(lambda x, u: [u[1], 6*(x-1)], 0, [-1, 3])
+
+
+def ramp():
+    peak = event(lambda x, u: x - 1, switch=lambda x, u: -mpf(1))
+    return mpmath.odefun(lambda x, u: mpf(1), 0, 0, events=[peak])
+
+
+def sawtooth():
+    drop = event(lambda x, u: u - 4, reset=lambda x, u: u/4)
+    return mpmath.odefun(lambda x, u: u, 0, 1, events=[drop])
+
+
+def projectile():
+    return lambda t, u: [u[1], 0, u[3], -mpf(10)]
+
+
+def close(got, want, digits=20):
+    got = mp.convert(got)
+    want = mp.convert(want)
+    scale = abs(want) if want else mpf(1)
+    return abs(got - want) <= scale*mpf(10)**(-digits)
+
+
+def assert_close(got, want, digits=20):
+    assert close(got, want, digits), (mp.nstr(got, 25), mp.nstr(want, 25))
+
+
+def assert_vector(got, want, digits=20):
+    assert len(got) == len(want)
+    for a, b in zip(got, want):
+        assert_close(a, b, digits)
+
+
+def positions(records):
+    return [r[0] for r in records]
+
+
+def test_backward_scalar_matches_exp():
+    mp.dps = 25
+    y = exponential()
+    assert_close(y(-1), exp(-1), 21)
+    assert_close(y(-4), exp(-4), 21)
+
+
+def test_backward_and_forward_share_one_solution():
+    mp.dps = 25
+    y = exponential()
+    assert_close(y(2), exp(2), 21)
+    assert_close(y(-2), exp(-2), 21)
+    assert_close(y(1), exp(1), 21)
+
+
+def test_backward_before_forward_gives_same_values():
+    mp.dps = 25
+    y = exponential()
+    assert_close(y(-3), exp(-3), 21)
+    assert_close(y(3), exp(3), 21)
+
+
+def test_backward_vector_matches_trigonometric_solution():
+    mp.dps = 25
+    y = circular()
+    value = y(-4)
+    assert_close(value[0], cos(-4), 21)
+    assert_close(value[1], sin(-4), 21)
+
+
+def test_backward_at_initial_point_returns_initial_value():
+    mp.dps = 20
+    y = circular()
+    assert_vector(y(mpf(-1)/1000), [cos(mpf(-1)/1000), sin(mpf(-1)/1000)], 16)
+    assert_vector(y(0), [mpf(1), mpf(0)], 16)
+
+
+def test_backward_high_precision_stays_accurate():
+    mp.dps = 40
+    y = exponential()
+    assert_close(y(-2), exp(-2), 36)
+
+
+def test_backward_nonlinear_matches_rational_solution():
+    mp.dps = 25
+    y = mpmath.odefun(lambda x, y: [-2*x*y[0]**2], 0, [1])
+    assert_close(y(-2)[0], mpf(1)/5, 20)
+
+
+def test_backward_repeated_queries_are_consistent():
+    mp.dps = 20
+    y = exponential()
+    first = y(-2)
+    y(-5)
+    assert_close(y(-2), first, 16)
+
+
+def test_solution_without_events_reports_empty_records():
+    mp.dps = 15
+    y = exponential()
+    y(1)
+    assert y.events == []
+
+
+def test_domain_is_unbounded_without_terminal_events():
+    mp.dps = 15
+    y = exponential()
+    y(1)
+    left, right = y.domain
+    assert left == mp.ninf
+    assert right == mp.inf
+
+
+def test_event_locates_threshold_to_working_precision():
+    mp.dps = 30
+    y = exponential(events=[event(lambda x, u: u - 10)])
+    y(4)
+    assert_close(positions(y.events[0])[0], log(10), 25)
+
+
+def test_event_record_holds_state_at_crossing():
+    mp.dps = 25
+    y = exponential(events=[event(lambda x, u: u - 10)])
+    y(4)
+    assert_close(y.events[0][0][1], mpf(10), 20)
+
+
+def test_event_records_are_empty_before_integration():
+    mp.dps = 15
+    y = exponential(events=[event(lambda x, u: u - 10)])
+    assert y.events[0] == []
+
+
+def test_asking_for_the_starting_point_does_not_extend():
+    mp.dps = 20
+    soon = event(lambda x, u: u - mpf(11)/10, terminal=True)
+    y = exponential(events=[soon])
+    assert_close(y(0), mpf(1), 16)
+    assert y.events[0] == []
+    assert y.domain[1] == mp.inf
+
+
+def test_event_records_grow_as_solution_advances():
+    mp.dps = 20
+    y = circular(events=[event(lambda x, u: u[0])])
+    y(2)
+    assert len(y.events[0]) == 1
+    y(5)
+    assert len(y.events[0]) == 2
+
+
+def test_event_positions_are_sorted_ascending():
+    mp.dps = 20
+    y = circular(events=[event(lambda x, u: u[0])])
+    y(9)
+    found = positions(y.events[0])
+    assert found == sorted(found)
+
+
+def test_event_finds_every_crossing_in_range():
+    mp.dps = 20
+    y = circular(events=[event(lambda x, u: u[0])])
+    y(9)
+    expected = [pi/2, 3*pi/2, 5*pi/2]
+    assert len(y.events[0]) == 3
+    for got, want in zip(positions(y.events[0]), expected):
+        assert_close(got, want, 16)
+
+
+def test_event_functions_keep_their_own_record_lists():
+    mp.dps = 20
+    first = event(lambda x, u: u[0])
+    second = event(lambda x, u: u[1])
+    y = circular(events=[first, second])
+    y(4)
+    assert_close(positions(y.events[0])[0], pi/2, 16)
+    assert_close(positions(y.events[1])[0], pi, 16)
+
+
+def test_two_events_at_the_same_point_are_both_recorded():
+    mp.dps = 20
+    marker = event(lambda x, u: u - 2)
+    jump = event(lambda x, u: u - 2, reset=lambda x, u: u + 1)
+    y = exponential(events=[marker, jump])
+    y(2)
+    assert len(y.events[0]) == 1
+    assert len(y.events[1]) == 1
+    assert_close(y.events[0][0][0], log(2), 16)
+    assert_close(y.events[1][0][0], log(2), 16)
+    assert_close(y.events[0][0][1], mpf(2), 16)
+    assert_close(y.events[1][0][1], mpf(2), 16)
+
+
+def test_a_terminal_event_records_alongside_one_at_the_same_point():
+    mp.dps = 20
+    marker = event(lambda x, u: u - 2)
+    halt = event(lambda x, u: u - 2, terminal=True)
+    y = exponential(events=[marker, halt])
+    with pytest.raises(ValueError):
+        y(2)
+    assert_close(y.domain[1], log(2), 16)
+    assert len(y.events[0]) == 1
+    assert len(y.events[1]) == 1
+
+
+def test_two_crossings_in_one_step_are_taken_in_order():
+    mp.dps = 20
+    early = event(lambda x, u: u[0] - mpf(1)/1000)
+    late = event(lambda x, u: u[0])
+    y = circular(events=[late, early])
+    y(2)
+    assert len(y.events[0]) == 1
+    assert len(y.events[1]) == 1
+    assert_close(y.events[1][0][0], mpmath.acos(mpf(1)/1000), 16)
+    assert_close(y.events[0][0][0], pi/2, 16)
+    assert y.events[1][0][0] < y.events[0][0][0]
+
+
+def test_event_options_default_to_watching_without_acting():
