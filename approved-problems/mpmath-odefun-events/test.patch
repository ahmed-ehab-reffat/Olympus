+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd /app
+
+NEW_TESTS="mpmath/tests/test_ode_da6e5c.py"
+BASE_TESTS="mpmath/tests/test_ode.py mpmath/tests/test_calculus.py \
+mpmath/tests/test_diff.py mpmath/tests/test_summation.py \
+mpmath/tests/test_quad.py mpmath/tests/test_basic_ops.py \
+mpmath/tests/test_convert.py"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT_ARG="--junitxml=$OUTPUT_PATH"
+else
+  JUNIT_ARG=""
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest $NEW_TESTS -p no:cacheprovider -o addopts="" $JUNIT_ARG
+else
+  python -m pytest $BASE_TESTS -p no:cacheprovider -o addopts="" $JUNIT_ARG
+fi
+EXIT_CODE=$?
+
+if [ -n "$OUTPUT_PATH" ] && ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="1" failures="0" tests="1" time="0">
+<testcase classname="test_ode_da6e5c" name="collection" time="0">
+<error message="pytest produced no results">The test run did not start.</error>
+</testcase></testsuite></testsuites>
+XMLEOF
+fi
+
+exit $EXIT_CODE
