@@ -0,0 +1,523 @@
+from bisect import bisect, bisect_left
+
+
+class ODEEvent:
+    """
+    Describes a condition to be located while an ODE is integrated by
+    :func:`~mpmath.odefun`.
+    """
+
+    def __init__(self, g, direction=0, terminal=False, reset=None, switch=None):
+        if direction not in (-1, 0, 1):
+            raise ValueError("direction must be -1, 0 or 1")
+        if terminal is not True and terminal is not False:
+            try:
+                count = int(terminal)
+            except (TypeError, ValueError):
+                raise ValueError("terminal must be a boolean or a positive integer")
+            if count != terminal or count < 1:
+                raise ValueError("terminal must be a boolean or a positive integer")
+            terminal = count
+        self.g = g
+        self.direction = direction
+        self.terminal = terminal
+        self.reset = reset
+        self.switch = switch
+
+    @property
+    def stop_after(self):
+        if self.terminal is False:
+            return None
+        if self.terminal is True:
+            return 1
+        return self.terminal
+
+
+class ODESolution:
+    """
+    Callable numerical solution of an ODE system, as returned by
+    :func:`~mpmath.odefun`.  Taylor series are generated on demand in
+    both directions away from the initial point.
+    """
+
+    def __init__(self, ctx, F, x0, y0, tol_prec, degree, workprec,
+                 return_vector, events, verbose, stepper, maxevents):
+        self.ctx = ctx
+        self.stepper = stepper
+        self.F = F
+        self.x0 = x0
+        self.tol_prec = tol_prec
+        self.degree = degree
+        self.workprec = workprec
+        self.return_vector = return_vector
+        self.verbose = verbose
+        self._ev = events
+        self.events = [[] for e in events]
+        self._counts = {1: [0]*len(events), -1: [0]*len(events)}
+        self._stop = {1: None, -1: None}
+        self._data = {1: [], -1: []}
+        self._keys = {1: [x0], -1: [-x0]}
+        self._tip = {1: (x0, y0), -1: (x0, y0)}
+        self._deriv = {1: F, -1: F}
+        self._seed = None
+        self.maxevents = maxevents
+        self.dim = len(y0)
+
+    @property
+    def domain(self):
+        left = self._stop[-1]
+        right = self._stop[1]
+        ctx = self.ctx
+        return (ctx.ninf if left is None else left,
+                ctx.inf if right is None else right)
+
+    def _mpolyval(self, ser, a):
+        return [self.ctx.polyval(s, a) for s in ser]
+
+    def _derivative(self, s, n):
+        c = list(s)
+        for k in range(n):
+            c = [j*c[j] for j in range(1, len(c))]
+        return c
+
+    def _defect(self, deriv, ser, xa, t):
+        ctx = self.ctx
+        y = self._mpolyval(ser, t)
+        slope = [ctx.polyval(self._derivative(s, 1), t) for s in ser]
+        f = deriv(xa+t, y)
+        return max(abs(slope[k]-f[k]) for k in range(self.dim))
+
+    def _trim(self, deriv, ser, xa, xb):
+        ctx = self.ctx
+        tol = ctx.ldexp(1, 10-self.tol_prec)
+        for k in range(self.degree):
+            if abs(xb-xa) < tol or self._defect(deriv, ser, xa, xb-xa) < tol:
+                break
+            xb = xa + (xb-xa)/2
+        return xb
+
+    def _public(self, y):
+        if self.return_vector:
+            return [+yk for yk in y]
+        return +y[0]
+
+    def _order(self, n):
+        try:
+            count = int(n)
+        except (TypeError, ValueError):
+            raise ValueError("n must be a nonnegative whole number")
+        if count != n or count < 0:
+            raise ValueError("n must be a nonnegative whole number")
+        return count
+
+    def _real(self, raw):
+        try:
+            out = self.ctx.convert(raw)
+        except (TypeError, ValueError):
+            raise ValueError("an event function must take real values")
+        if hasattr(out, 'imag') and out.imag:
+            raise ValueError("an event function must take real values")
+        return out
+
+    def _call_g(self, ev, x, y):
+        if self.return_vector:
+            return self._real(ev.g(x, [+yk for yk in y]))
+        return self._real(ev.g(x, +y[0]))
+
+    def _reset_state(self, ev, x, y):
+        out = ev.reset(x, self._public(y))
+        if self.return_vector:
+            return [self.ctx.convert(yk) for yk in out]
+        return [self.ctx.convert(out)]
+
+    def _samples(self, width):
+        m = max(8, self.degree)
+        return [width*k/m for k in range(m+1)]
+
+    def _crossing(self, ev, d, ser, xa, width):
+        ctx = self.ctx
+        phi = lambda t: self._call_g(ev, xa+t, self._mpolyval(ser, t))
+        prev = None
+        zero = None
+        for t in self._samples(width):
+            cur = phi(t)
+            if not cur:
+                if zero is None:
+                    zero = t
+                continue
+            if prev is not None and (prev[1] > 0) != (cur > 0):
+                if not self._wanted(ev, d, prev[1]):
+                    return None
+                if zero:
+                    return zero
+                return ctx.findroot(phi, (prev[0], t), solver='anderson')
+            prev = (t, cur)
+            zero = None
+        if zero and prev is not None and self._wanted(ev, d, prev[1]):
+            return zero
+        return None
+
+    def _wanted(self, ev, d, before):
+        rising = (before < 0) if d > 0 else (before > 0)
+        return not ev.direction or (ev.direction > 0) == rising
+
+    def _locate(self, d, ser, xa, width):
+        found = []
+        for i, ev in enumerate(self._ev):
+            t = self._crossing(ev, d, ser, xa, width)
+            if t is not None:
+                found.append((t, i))
+        if not found:
+            return None
+        first = min(abs(t) for t, i in found)
+        near = abs(width)*self.ctx.ldexp(1, -self.ctx.prec//2)
+        return [(t, i) for t, i in found if abs(t) <= first + near]
+
+    def _wrap(self, f):
+        if self.return_vector:
+            return f
+        return lambda x, y: [f(x, y[0])]
+
+    def _step(self, d):
+        ctx = self.ctx
+        xa, ya = self._tip[d]
+        ser, xb = self.stepper(ctx, self._deriv[d], xa, ya, self.tol_prec,
+                               self.degree, d)
+        xb = self._trim(self._deriv[d], ser, xa, xb)
+        if self.verbose:
+            print("Computing Taylor series for [%f, %f]" % (xa, xb))
+        yb = self._mpolyval(ser, xb-xa)
+        found = self._locate(d, ser, xa, xb-xa)
+        if found is None:
+            self._data[d].append((ser, xa, xb))
+            self._keys[d].append(d*xb)
+            self._tip[d] = (xb, yb)
+            return
+        for t, i in found:
+            if self.maxevents is not None and self._counts[d][i] >= self.maxevents:
+                raise ValueError("more than %s events in one direction"
+                                 % self.maxevents)
+        t = found[0][0]
+        xe = xa + t
+        ye = self._mpolyval(ser, t)
+        self._data[d].append((ser, xa, xe))
+        self._keys[d].append(d*xe)
+        arrived = self._public(ye)
+        stop = False
+        for t, i in found:
+            self.events[i].append((+xe, arrived))
+            if d < 0:
+                self.events[i].sort(key=lambda rec: rec[0])
+            self._counts[d][i] += 1
+            limit = self._ev[i].stop_after
+            if limit is not None and self._counts[d][i] >= limit:
+                stop = True
+        if stop:
+            self._stop[d] = xe
+            self._tip[d] = (xe, ye)
+            return
+        for t, i in found:
+            ev = self._ev[i]
+            if ev.switch is not None:
+                self._deriv[d] = self._wrap(ev.switch)
+            if ev.reset is not None:
+                ye = self._reset_state(ev, xe, ye)
+        self._tip[d] = (xe, ye)
+
+    def _series(self, x, upward=False):
+        d = 1 if x >= self.x0 else -1
+        keys = self._keys[d]
+        right = upward and d > 0
+        if x == self.x0 and not self._data[d] and not right:
+            if self._seed is None:
+                ser, xb = self.stepper(self.ctx, self.F, self.x0, self._tip[d][1],
+                                       self.tol_prec, self.degree, 1)
+                self._seed = (ser, self.x0, self.x0)
+            return self._seed
+        while (d*x > keys[-1] or not self._data[d] or
+               (right and d*x == keys[-1])):
+            if self._stop[d] is not None:
+                raise ValueError("the solution ends at x = %s" % self._stop[d])
+            self._step(d)
+        idx = bisect(keys, d*x) if right else bisect_left(keys, d*x)
+        return self._data[d][max(idx, 1)-1]
+
+    def __call__(self, x):
+        ctx = self.ctx
+        x = ctx.convert(x)
+        orig = ctx.prec
+        try:
+            ctx.prec = self.workprec
+            ser, xa, xb = self._series(x)
+            y = self._mpolyval(ser, x-xa)
+        finally:
+            ctx.prec = orig
+        return self._public(y)
+
+    def _index(self, index):
+        if index < 0 or index >= self.dim:
+            raise ValueError("index out of range")
+        return index
+
+    def _range(self, a, b):
+        a = self.ctx.convert(a)
+        b = self.ctx.convert(b)
+        if not b > a:
+            raise ValueError("b must be greater than a")
+        return a, b
+
+    def _nodes(self, a, b):
+        nodes = [a]
+        x = a
+        while x < b:
+            ser, xa, xb = self._series(x, upward=True)
+            x = min(max(xa, xb), b)
+            nodes.append(x)
+        return nodes
+
+    def _grid(self, a, b):
+        nodes = [a]
+        x = a
+        while x < b:
+            ser, xa, xb = self._series(x, upward=True)
+            end = min(max(xa, xb), b)
+            nodes += [x+t for t in self._samples(end-x)[1:]]
+            x = end
+        return nodes
+
+    def _touch(self, f, xs, ys):
+        """A zero the function reaches without changing sign shows up as a
+        least value between two samples of equal sign; the parabola through
+        three samples locates it, and repeating that polishes it."""
+        ctx = self.ctx
+        if (ys[0] > 0) != (ys[2] > 0):
+            return None
+        if not (abs(ys[1]) < abs(ys[0]) and abs(ys[1]) < abs(ys[2])):
+            return None
+        lo, hi = xs[0], xs[2]
+        x, v = xs[1], ys[1]
+        for k in range(self.degree):
+            step = (hi - lo)/4
+            left, right = f(x-step), f(x+step)
+            bend = left - 2*v + right
+            if not bend:
+                break
+            shift = step*(left - right)/(2*bend)
+            if abs(shift) > (hi - lo):
+                break
+            x = x + shift
+            v = f(x)
+            lo, hi = x - step, x + step
+            if abs(step) < abs(hi - lo)*ctx.eps:
+                break
+        scale = max(abs(ys[0]), abs(ys[2]), ctx.one)
+        return x if abs(v) <= scale*ctx.ldexp(1, 10-self.tol_prec) else None
+
+    def _bracket(self, f, lo, hi):
+        """Samples of opposite sign do not always straddle a zero: the value
+        or its slope can jump at an event, and then the sign change is the
+        jump itself, so the point solved for has to be checked."""
+        ctx = self.ctx
+        try:
+            x = ctx.findroot(f, (lo, hi), solver='anderson')
+        except ValueError:
+            return None
+        if not lo <= x <= hi:
+            return None
+        scale = max(abs(f(lo)), abs(f(hi)), ctx.one)
+        return x if abs(f(x)) <= scale*ctx.ldexp(1, 10-self.tol_prec) else None
+
+    def _scan(self, f, a, b):
+        ctx = self.ctx
+        nodes = self._grid(a, b)
+        vals = [f(x) for x in nodes]
+        roots = []
+        if not vals[0]:
+            roots.append(nodes[0])
+        for k in range(1, len(nodes)):
+            prev, cur = vals[k-1], vals[k]
+            if not cur:
+                roots.append(nodes[k])
+            elif prev and (prev > 0) != (cur > 0):
+                x = self._bracket(f, nodes[k-1], nodes[k])
+                if x is not None:
+                    roots.append(x)
+        for k in range(1, len(nodes)-1):
+            if not (vals[k-1] and vals[k] and vals[k+1]):
+                continue
+            x = self._touch(f, nodes[k-1:k+2], vals[k-1:k+2])
+            if x is not None and a <= x <= b:
+                roots.append(x)
+        roots.sort()
+        return [r for j, r in enumerate(roots)
+                if j == 0 or r - roots[j-1] > abs(r)*ctx.eps*1024]
+
+    def _value(self, x, index):
+        out = self(x)
+        return out[index] if self.return_vector else out
+
+    def _slope(self, x, index):
+        out = self.diff(x)
+        return out[index] if self.return_vector else out
+
+    def roots(self, g, a, b):
+        ctx = self.ctx
+        a, b = self._range(a, b)
+        orig = ctx.prec
+        try:
+            ctx.prec = self.workprec
+            out = self._scan(lambda x: self._real(g(x, self(x))), a, b)
+        finally:
+            ctx.prec = orig
+        return [+r for r in out]
+
+    def crossings(self, level, a, b, index=0):
+        ctx = self.ctx
+        self._index(index)
+        a, b = self._range(a, b)
+        level = ctx.convert(level)
+        orig = ctx.prec
+        try:
+            ctx.prec = self.workprec
+            out = self._scan(lambda x: self._value(x, index)-level, a, b)
+        finally:
+            ctx.prec = orig
+        return [+r for r in out]
+
+    def extrema(self, a, b, index=0):
+        ctx = self.ctx
+        self._index(index)
+        a, b = self._range(a, b)
+        orig = ctx.prec
+        try:
+            ctx.prec = self.workprec
+            out = self._scan(lambda x: self._slope(x, index), a, b)
+            out = [r for r in out if a < r < b]
+        finally:
+            ctx.prec = orig
+        return [+r for r in out]
+
+    def _breaks(self, a, b):
+        """Where one local series hands over to the next the slope can jump,
+        so those points are candidates for a largest or smallest value even
+        though the derivative never vanishes there."""
+        out = []
+        for d in (1, -1):
+            for ser, xa, xb in self._data[d]:
+                for x in (xa, xb):
+                    if a < x < b:
+                        out.append(+x)
+        return out
+
+    def _optimum(self, a, b, index, sign):
+        a, b = self._range(a, b)
+        points = [a, b] + self.extrema(a, b, index) + self._breaks(a, b)
+        best = None
+        for x in points:
+            v = self._value(x, index)
+            if best is None or sign*v > sign*best[1]:
+                best = (+x, +v)
+        return best
+
+    def maximum(self, a, b, index=0):
+        return self._optimum(a, b, self._index(index), 1)
+
+    def minimum(self, a, b, index=0):
+        return self._optimum(a, b, self._index(index), -1)
+
+    def taylor(self, x, n):
+        ctx = self.ctx
+        x = ctx.convert(x)
+        n = self._order(n)
+        orig = ctx.prec
+        try:
+            ctx.prec = self.workprec
+            ser, xa, xb = self._series(x)
+            t = x - xa
+            out = []
+            for s in ser:
+                c = list(s)
+                row = []
+                for k in range(n+1):
+                    if not c:
+                        row.append(ctx.zero)
+                        continue
+                    b = [ctx.zero]*(len(c)-1)
+                    for j in range(len(c)-2, -1, -1):
+                        b[j] = c[j+1] + (t*b[j+1] if j+1 < len(b) else ctx.zero)
+                    row.append(c[0] + t*b[0] if b else c[0])
+                    c = b
+                out.append(row)
+        finally:
+            ctx.prec = orig
+        if self.return_vector:
+            return [[+v for v in row] for row in out]
+        return [+v for v in out[0]]
+
+    def _piece(self, a, b):
+        ser, xa, xb = self._series(a, upward=True)
+        hi = max(xa, xb)
+        end = min(b, hi)
+        anti = []
+        for s in ser:
+            c = [self.ctx.zero]
+            c += [s[j]/(j+1) for j in range(len(s))]
+            anti.append(c)
+        val = [self.ctx.polyval(c, end-xa) - self.ctx.polyval(c, a-xa)
+               for c in anti]
+        return end, val
+
+    def integral(self, a, b, f=None):
+        ctx = self.ctx
+        a = ctx.convert(a)
+        b = ctx.convert(b)
+        if a == b:
+            orig = ctx.prec
+            try:
+                ctx.prec = self.workprec
+                self._series(a)
+            finally:
+                ctx.prec = orig
+            if f is not None:
+                return ctx.zero
+            return self._public([ctx.zero]*self.dim)
+        if b < a:
+            out = self.integral(b, a, f)
+            if f is None and self.return_vector:
+                return [-v for v in out]
+            return -out
+        if f is not None:
+            total = ctx.zero
+            nodes = self._nodes(a, b)
+            for k in range(1, len(nodes)):
+                total += ctx.quad(lambda x: ctx.convert(f(x, self(x))),
+                                  [nodes[k-1], nodes[k]])
+            return total
+        orig = ctx.prec
+        total = None
+        try:
+            ctx.prec = self.workprec
+            total = [ctx.zero]*self.dim
+            x = a
+            while x < b:
+                x, part = self._piece(x, b)
+                total = [total[k]+part[k] for k in range(self.dim)]
+        finally:
+            ctx.prec = orig
+        return self._public(total)
+
+    def diff(self, x, n=1):
+        ctx = self.ctx
+        x = ctx.convert(x)
+        n = self._order(n)
+        orig = ctx.prec
+        try:
+            ctx.prec = self.workprec
+            ser, xa, xb = self._series(x)
+            der = []
+            for s in ser:
+                c = self._derivative(s, n)
+                der.append(ctx.polyval(c, x-xa) if c else ctx.zero)
+        finally:
+            ctx.prec = orig
+        return self._public(der)
