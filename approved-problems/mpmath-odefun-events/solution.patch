+def odebvp(ctx, F, x0, y0, x1, y1, guess=None, stop=None, tol=None,
+           degree=None, verbose=False):
+    r"""
+    Solves a two-point boundary value problem for the first-order system
+    described by *F* (see :func:`~mpmath.odefun`) by shooting from *x0*.
+
+    The vectors *y0* and *y1* give the value of every component at *x0*
+    and at *x1*, using ``None`` for a component that is not prescribed
+    there.  The number of unknown components of *y0* must equal the
+    number of prescribed components of *y1*.  Starting values for the
+    unknowns are taken from *guess*, defaulting to zeros.
+
+    The return value is the solution of the initial value problem with
+    the missing initial values filled in, so it can be evaluated and
+    differentiated like any solution returned by :func:`~mpmath.odefun`.
+
+        >>> from mpmath import mp, odebvp, sin, pi
+        >>> mp.dps = 15
+        >>> y = odebvp(lambda x, u: [u[1], -u[0]], 0, [0, None], pi/2, [1, None])
+        >>> y(pi/6)[0]
+        mpf('0.49999999999999994')
+
+    """
+    y0 = list(y0)
+    y1 = list(y1)
+    if len(y0) != len(y1):
+        raise ValueError("y0 and y1 must have the same length")
+    unknown = [k for k in range(len(y0)) if y0[k] is None]
+    given = [k for k in range(len(y1)) if y1[k] is not None]
+    if not unknown or len(unknown) != len(given):
+        raise ValueError("the number of unknown starting values must equal "
+                         "the number of conditions given at x1")
+    if guess is None:
+        guess = [ctx.zero]*len(unknown)
+    elif len(guess) != len(unknown):
+        raise ValueError("guess must supply one value per unknown")
+    x1 = ctx.convert(x1)
+
+    def start_from(u):
+        start = list(y0)
+        for k, v in zip(unknown, u):
+            start[k] = ctx.convert(v)
+        return start
+
+    def solve_from(u):
+        events = None if stop is None else [ODEEvent(stop.g, stop.direction,
+                                                     True)]
+        return odefun(ctx, F, x0, start_from(u), tol=tol, degree=degree,
+                      verbose=verbose, events=events)
+
+    def endpoint(y):
+        if stop is None:
+            return y(x1)
+        try:
+            y(x1)
+        except ValueError:
+            if not y.events[0]:
+                raise
+        if not y.events[0]:
+            raise ValueError("the stopping event was not reached before x1")
+        return y.events[0][0][1]
+
+    def shoot(*u):
+        end = endpoint(solve_from(u))
+        return [end[k] - y1[k] for k in given]
+
+    root_tol = None if tol is None else ctx.convert(tol)**2
+    if len(unknown) == 1:
+        root = [ctx.findroot(lambda u: shoot(u)[0], guess[0], tol=root_tol)]
+    else:
+        found = ctx.findroot(shoot, tuple(guess), tol=root_tol)
+        root = [found[k] for k in range(len(unknown))]
+    solution = solve_from(root)
+    endpoint(solution)
+    return solution
 
 ODEMethods.odefun = odefun
+ODEMethods.odebvp = odebvp
