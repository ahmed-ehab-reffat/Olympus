+import unittest
+
+import pyparsing as pp
+from pyparsing import (
+    Combine,
+    DelimitedList,
+    FollowedBy,
+    Forward,
+    Group,
+    Literal,
+    NotAny,
+    Opt,
+    ParseFatalException,
+    SkipTo,
+    Suppress,
+    Word,
+    alphas,
+    nums,
+)
+
+
+def parses(expr, text, **kwargs):
+    return [
+        (tokens.as_list(), start, end)
+        for tokens, start, end in expr.enumerate_parses(text, **kwargs)
+    ]
+
+
+def token_lists(expr, text, **kwargs):
+    return [tokens.as_list() for tokens, _, _ in expr.enumerate_parses(text, **kwargs)]
+
+
+def ends(expr, text, **kwargs):
+    return [end for _, _, end in expr.enumerate_parses(text, **kwargs)]
+
+
+def scanned(expr, text, **kwargs):
+    return [
+        (tokens.as_list(), start, end)
+        for tokens, start, end in expr.enumerate_scan(text, **kwargs)
+    ]
+
+
+def word():
+    return Word(alphas)
+
+
+class TestEnumerationOrder(unittest.TestCase):
+    def test_repetition_yields_more_repetitions_first(self):
+        self.assertEqual(
+            [["spam", "ham", "eggs"], ["spam", "ham"], ["spam"]],
+            token_lists(word()[1, ...], "spam ham eggs"),
+        )
+
+    def test_repetition_end_locations_follow_the_tokens(self):
+        self.assertEqual([13, 8, 4], ends(word()[1, ...], "spam ham eggs"))
+
+    def test_zero_or_more_yields_the_empty_parse_last(self):
+        self.assertEqual([["a", "b"], ["a"], []], token_lists(word()[...], "a b"))
+
+    def test_zero_or_more_empty_parse_consumes_nothing(self):
+        self.assertEqual([3, 1, 0], ends(word()[...], "a b"))
+
+    def test_one_or_more_has_no_parse_of_empty_input(self):
+        self.assertEqual([], parses(word()[1, ...], ""))
+
+    def test_zero_or_more_of_empty_input_yields_one_empty_parse(self):
+        self.assertEqual([([], 0, 0)], parses(word()[...], ""))
+
+    def test_sequence_varies_the_last_element_fastest(self):
+        expr = Group(word()[1, ...]) + Group(word()[1, ...])
+        self.assertEqual(
+            [
+                [["a", "b"], ["c"]],
+                [["a"], ["b", "c"]],
+                [["a"], ["b"]],
+            ],
+            token_lists(expr, "a b c"),
+        )
+
+    def test_match_first_keeps_alternative_order(self):
+        self.assertEqual(
+            [["ab"], ["abc"]], token_lists(Literal("ab") | Literal("abc"), "abcd")
+        )
+
+    def test_or_yields_the_longest_match_first(self):
+        self.assertEqual(
+            [["abc"], ["ab"]], token_lists(Literal("ab") ^ Literal("abc"), "abcd")
+        )
+
+    def test_or_breaks_ties_in_operand_order(self):
+        expr = Group(Literal("ab")) ^ Group(Literal("a") + Literal("b"))
+        self.assertEqual([[["ab"]], [["a", "b"]]], token_lists(expr, "ab"))
+
+    def test_or_orders_across_operands_not_within_them(self):
+        expr = Literal("a") ^ (Literal("a") + Opt(Literal("bc")))
+        self.assertEqual([["a", "bc"], ["a"], ["a"]], token_lists(expr, "abc"))
+
+    def test_optional_element_is_present_before_absent(self):
+        expr = Opt(Literal("a")) + Literal("a")
+        self.assertEqual([["a", "a"], ["a"]], token_lists(expr, "aa"))
+
+    def test_optional_default_value_appears_in_the_absent_parse(self):
+        expr = Word(nums) + Opt(Literal("!"), default="none")
+        self.assertEqual([["1", "!"], ["1", "none"]], token_lists(expr, "1!"))
+
+    def test_delimited_list_yields_shorter_lists_after_longer(self):
+        self.assertEqual(
+            [["a", "b", "c"], ["a", "b"], ["a"]],
+            token_lists(DelimitedList(word()), "a,b,c"),
+        )
+
+    def test_nested_repetition_inside_alternation_full_order(self):
+        letters = Group(Word(alphas, exact=1)[1, ...])
+        expr = letters ^ Group(Literal("ab"))
+        self.assertEqual(
+            [
+                [["a", "b", "c"]],
+                [["a", "b"]],
+                [["ab"]],
+                [["a"]],
+            ],
+            token_lists(expr, "abc"),
+        )
+
+    def test_repetition_follows_its_body_preference_not_the_repetition_count(self):
+        body = Word(alphas, exact=2) | Word(alphas, exact=1)
+        expr = body[1, ...]
+        found = token_lists(expr, "abcd")
+        self.assertEqual(expr.parse_string("abcd").as_list(), found[0])
+        self.assertEqual(
+            [
+                ["ab", "cd"],
+                ["ab", "c", "d"],
+                ["ab", "c"],
+                ["ab"],
+                ["a", "bc", "d"],
+                ["a", "bc"],
+                ["a", "b", "cd"],
+                ["a", "b", "c", "d"],
+                ["a", "b", "c"],
+                ["a", "b"],
+                ["a"],
+            ],
+            found,
+        )
+
+    def test_repetition_stop_on_limits_the_longest_parse(self):
+        expr = Word(alphas, exact=1)[1, ...].stop_on(Literal("c"))
+        self.assertEqual([["a", "b"], ["a"]], token_lists(expr, "abc"))
+
+    def test_bounded_repetition_respects_its_bounds(self):
+        expr = Word(alphas, exact=1)[2, 3]
+        self.assertEqual([["a", "b", "c"], ["a", "b"]], token_lists(expr, "abcd"))
+
+
+class TestEachEnumeration(unittest.TestCase):
+    def test_each_enumerates_the_orderings_that_match(self):
+        expr = (Literal("ab") | Literal("a")) & (
+            Literal("bc") | Literal("b") | Literal("c")
+        )
+        self.assertEqual(
+            [["ab", "c"], ["a", "bc"], ["a", "b"]], token_lists(expr, "abc")
+        )
+
+    def test_each_first_parse_matches_parse_string(self):
+        expr = Literal("a") & Literal("b") & Literal("c")
+        self.assertEqual(
+            expr.parse_string("bca").as_list(), token_lists(expr, "bca")[0]
+        )
+
+    def test_each_with_an_optional_member_yields_the_ordinary_parse(self):
+        expr = Literal("a") & Opt(Literal("b"))
+        self.assertEqual([["a", "b"]], token_lists(expr, "a b"))
+
+
+    def test_each_with_a_repeated_member_yields_the_ordinary_parse(self):
+        expr = Literal("a") & Literal("b")[1, ...]
+        self.assertEqual([["a", "b", "b"]], token_lists(expr, "a b b"))
+
+
+class TestParseActions(unittest.TestCase):
+    def test_action_runs_once_for_each_yielded_parse(self):
+        calls = []
+        expr = Group(word()[1, ...]).add_parse_action(lambda toks: calls.append(1))
+        self.assertEqual(3, len(parses(expr, "a b c")))
+        self.assertEqual(3, len(calls))
+
+    def test_no_action_runs_for_parses_that_are_not_yielded(self):
+        calls = []
+        tail = Group(word()[1, ...]).add_parse_action(lambda toks: calls.append(1))
+        expr = Group(word()[1, ...]) + tail
+        list(expr.enumerate_parses("a b c", max_parses=1))
+        self.assertEqual(1, len(calls))
+        calls.clear()
+        list(expr.enumerate_parses("a b c"))
+        self.assertEqual(3, len(calls))
+
+    def test_abandoning_the_iterator_stops_further_actions(self):
+        calls = []
+        expr = Group(word()[1, ...]).add_parse_action(lambda toks: calls.append(1))
+        for _ in expr.enumerate_parses("a b c"):
+            break
+        self.assertEqual(1, len(calls))
+
+    def test_or_orders_its_alternatives_without_running_actions(self):
+        calls = []
+
+        def alternative(literal, tag):
+            return Group(literal).add_parse_action(lambda toks: calls.append(tag))
+
+        expr = alternative(Literal("ab"), "short") ^ alternative(Literal("abc"), "long")
+        self.assertEqual([[["abc"]]], token_lists(expr, "abcd", max_parses=1))
+        self.assertEqual(["long"], calls)
+        calls.clear()
+        self.assertEqual([[["abc"]], [["ab"]]], token_lists(expr, "abcd"))
+        self.assertEqual(["long", "short"], calls)
+
+    def test_action_return_value_replaces_the_tokens_of_each_parse(self):
+        expr = Word(alphas).add_parse_action(lambda toks: toks[0].upper())[1, ...]
+        self.assertEqual([["A", "B"], ["A"]], token_lists(expr, "a b"))
+
+    def test_condition_removes_only_the_parses_it_rejects(self):
+        expr = Group(word()[1, ...]).add_condition(lambda toks: len(toks[0]) != 2)
+        self.assertEqual([[["a", "b", "c"]], [["a"]]], token_lists(expr, "a b c"))
+
+    def test_condition_on_every_parse_yields_nothing(self):
+        expr = Group(word()[1, ...]).add_condition(lambda toks: False)
+        self.assertEqual([], parses(expr, "a b c"))
+
+    def test_multiple_actions_run_in_declaration_order_for_each_parse(self):
+        order = []
+        expr = Group(word()[1, ...])
+        expr.add_parse_action(lambda toks: order.append("first"))
+        expr.add_parse_action(lambda toks: order.append("second"))
+        self.assertEqual(3, len(parses(expr, "a b c")))
+        self.assertEqual(["first", "second"] * 3, order)
+
+    def test_action_raising_parse_exception_discards_only_that_parse(self):
+        def reject_pairs(toks):
+            if len(toks[0]) == 2:
+                raise pp.ParseException("not this one")
+
+        expr = Group(word()[1, ...]).add_parse_action(reject_pairs)
+        self.assertEqual([[["a", "b", "c"]], [["a"]]], token_lists(expr, "a b c"))
+
+    def test_error_stop_commits_in_every_enumerator(self):
+        expr = Literal("a") - Literal("b")
+        self.assertEqual([(["a", "b"], 0, 2)], parses(expr, "ab"))
+        with self.assertRaises(ParseFatalException):
+            parses(expr, "ax")
+        with self.assertRaises(ParseFatalException):
+            scanned(expr, "ax")
+        with self.assertRaises(ParseFatalException):
+            list(expr.enumerate_transforms("ax"))
+
+    def test_fatal_exception_from_an_action_propagates(self):
+        def boom(toks):
+            raise ParseFatalException("stop here")
+
+        expr = Word(alphas).add_parse_action(boom)[1, ...]
+        with self.assertRaises(ParseFatalException):
+            parses(expr, "a b")
+
+
+class TestParseAll(unittest.TestCase):
+    def test_parse_all_keeps_only_parses_reaching_the_end(self):
+        self.assertEqual(
+            [["a", "b", "c"]], token_lists(word()[1, ...], "a b c", parse_all=True)
+        )
+
+    def test_parse_all_finds_a_parse_that_parse_string_does_not(self):
+        expr = word()[1, ...] + Literal("x")
+        with self.assertRaises(pp.ParseException):
+            expr.parse_string("a b x", parse_all=True)
+        self.assertEqual([(["a", "b", "x"], 0, 5)], parses(expr, "a b x", parse_all=True))
+
+    def test_parse_all_tolerates_trailing_whitespace(self):
+        self.assertEqual([["a"]], token_lists(word(), "a  ", parse_all=True))
+
+    def test_parse_all_reaches_the_end_over_ignored_trailing_text(self):
+        expr = word()[1, ...].ignore(pp.python_style_comment)
+        self.assertEqual(
+            [(["a", "b"], 0, 3)], parses(expr, "a b # trailing", parse_all=True)
+        )
+
+    def test_parse_all_spans_leading_and_trailing_ignored_text(self):
+        expr = word()[1, ...]
+        expr.ignore(pp.python_style_comment)
+        text = "# lead\n a b # tail"
+        self.assertEqual([(["a", "b"], 8, 11)], parses(expr, text, parse_all=True))
+        self.assertEqual(
+            expr.parse_string(text, parse_all=True).as_list(),
+            token_lists(expr, text, parse_all=True)[0],
+        )
+
+    def test_parse_all_yields_nothing_when_no_parse_reaches_the_end(self):
+        expr = word()[1, ...] + Literal("x")
+        self.assertEqual([], parses(expr, "a b", parse_all=True))
+
+    def test_parse_all_keeps_every_parse_that_reaches_the_end(self):
+        expr = Group(Word(alphas, exact=1)[1, ...]) | Group(Word(alphas))
+        self.assertEqual([[["a", "b"]], [["a"]], [["ab"]]], token_lists(expr, "ab"))
+        self.assertEqual([[["a", "b"]], [["ab"]]], token_lists(expr, "ab", parse_all=True))
+        self.assertEqual([[["a", "b"]]], token_lists(expr, "ab", parse_all=True, max_parses=1))
+
+    def test_parse_all_survivors_can_be_deduplicated(self):
+        expr = Group(Word(alphas)) | Group(Word(alphas))
+        self.assertEqual([[["ab"]], [["ab"]]], token_lists(expr, "ab", parse_all=True))
+        self.assertEqual([[["ab"]]], token_lists(expr, "ab", parse_all=True, unique=True))
+
+    def test_first_parse_equals_parse_string_for_a_repetition(self):
+        expr = word()[1, ...]
+        self.assertEqual(expr.parse_string("a b c").as_list(), token_lists(expr, "a b c")[0])
+
+    def test_first_parse_equals_parse_string_for_an_alternation(self):
+        expr = Literal("ab") ^ Literal("abc")
+        self.assertEqual(expr.parse_string("abcd").as_list(), token_lists(expr, "abcd")[0])
+
+    def test_max_parses_stops_the_enumeration(self):
+        self.assertEqual(
+            [["a", "b", "c"], ["a", "b"]], token_lists(word()[1, ...], "a b c", max_parses=2)
+        )
+
+    def test_max_parses_applies_after_parse_all_filtering(self):
+        expr = word()[1, ...]
+        self.assertEqual(
+            [["a", "b"]], token_lists(expr, "a b", parse_all=True, max_parses=2)
+        )
+
+    def test_zero_max_parses_yields_nothing_and_runs_no_actions(self):
+        calls = []
+        expr = Group(word()[1, ...]).add_parse_action(lambda toks: calls.append(1))
+        self.assertEqual([], parses(expr, "a b c", max_parses=0))
+        self.assertEqual([], scanned(expr, "a b c", max_parses=0))
+        self.assertEqual([], list(expr.enumerate_transforms("a b c", max_parses=0)))
+        self.assertEqual(0, len(calls))
+
+    def test_expression_that_cannot_match_yields_nothing(self):
+        self.assertEqual([], parses(Literal("z"), "a"))
+
+
+class TestWrappers(unittest.TestCase):
+    def test_group_nests_the_tokens_of_every_parse(self):
+        self.assertEqual(
+            [[["a", "b"]], [["a"]]], token_lists(Group(word()[1, ...]), "a b")
+        )
+
+    def test_suppress_removes_the_tokens_of_every_parse(self):
+        expr = word() + Suppress(Opt(Literal("!")))
+        self.assertEqual([["a"], ["a"]], token_lists(expr, "a!"))
+        self.assertEqual([2, 1], ends(expr, "a!"))
+
+    def test_combine_rejects_the_parses_whose_tokens_are_not_adjacent(self):
+        expr = Combine(Word(nums) + Opt(Literal(".") + Word(nums)))
+        self.assertEqual([["1.5"], ["1"]], token_lists(expr, "1.5"))
+
+    def test_results_names_are_set_on_every_parse(self):
+        expr = word()("head") + Opt(word())("tail")
+        found = [tokens.as_dict() for tokens, _, _ in expr.enumerate_parses("ab cd")]
+        self.assertEqual([{"head": "ab", "tail": "cd"}, {"head": "ab"}], found)
+
+    def test_list_all_matches_names_collect_per_parse(self):
+        expr = word()("w*")[1, ...]
+        found = [list(tokens["w"]) for tokens, _, _ in expr.enumerate_parses("a b")]
+        self.assertEqual([["a", "b"], ["a"]], found)
+
+    def test_positional_wrappers_enumerate_every_contained_parse(self):
+        inner = Word(alphas, exact=1)[1, ...]
+        at_start = pp.AtStringStart(inner)
+        self.assertEqual(
+            [(["a", "b", "c"], 0, 3), (["a", "b"], 0, 2), (["a"], 0, 1)],
+            parses(at_start, "abc"),
+        )
+        self.assertEqual(
+            at_start.parse_string("abc").as_list(), token_lists(at_start, "abc")[0]
+        )
+
+    def test_positional_wrappers_still_refuse_the_wrong_position(self):
+        self.assertEqual([], scanned(pp.AtStringStart(Word(alphas)), " abc"))
+
+    def test_located_enumerates_every_parse_of_its_expression(self):
+        expr = pp.Located(Word(alphas, exact=1)[1, ...])
+        self.assertEqual(
+            [
+                ([0, ["a", "b", "c"], 3], 0, 3),
+                ([0, ["a", "b"], 2], 0, 2),
+                ([0, ["a"], 1], 0, 1),
+            ],
+            parses(expr, "abc"),
+        )
+        self.assertEqual(expr.parse_string("abc").as_list(), token_lists(expr, "abc")[0])
+
+    def test_located_reports_the_span_of_each_parse(self):
+        expr = pp.Located(Word(alphas, exact=1)[1, ...])
+        spans = [(t["locn_start"], t["locn_end"]) for t, _, _ in expr.enumerate_parses("abc")]
+        self.assertEqual([(0, 3), (0, 2), (0, 1)], spans)
+
+    def test_forward_recursion_enumerates_the_nested_parses(self):
+        expr = Forward()
+        atom = Word(alphas, exact=1)
+        expr <<= Group(atom + expr) | atom
+        self.assertEqual(
+            [[["a", ["b", "c"]]], [["a", "b"]], ["a"]], token_lists(expr, "abc")
+        )
+
+    def test_left_recursive_grammar_terminates(self):
+        expr = Forward()
+        expr <<= Group(expr + Literal("+") + expr) | Word(nums)
+        found = token_lists(expr, "1+2")
+        self.assertIn(["1"], found)
+        self.assertEqual(found, token_lists(expr, "1+2"))
+
+    def test_recursion_state_is_released_after_a_partial_enumeration(self):
+        expr = Forward()
+        atom = Word(alphas, exact=1)
+        expr <<= Group(atom + expr) | atom
+        list(expr.enumerate_parses("abc", max_parses=1))
+        self.assertEqual(3, len(parses(expr, "abc")))
+
+    def test_mutually_recursive_grammar_terminates_and_resets(self):
+        first = Forward()
+        second = Forward()
+        atom = Word(alphas, exact=1)
+        first <<= Group(second) | atom
+        second <<= Group(first + Literal("!")) | atom
+
+        found = token_lists(first, "a!")
+        self.assertIn(["a"], found)
+
+        list(first.enumerate_parses("a!", max_parses=1))
+        self.assertEqual(found, token_lists(first, "a!"))
+
+        for _ in first.enumerate_parses("a!"):
+            break
+        self.assertEqual(found, token_lists(first, "a!"))
+
+    def test_actions_on_recursive_nodes_run_once_for_each_yielded_parse(self):
+        calls = []
+        expr = Forward()
+        atom = Word(alphas, exact=1)
+        expr <<= Group(atom + expr) | atom
+        top = Group(expr).add_parse_action(lambda toks: calls.append(1))
+        self.assertEqual(3, len(parses(top, "abc")))
+        self.assertEqual(3, len(calls))
+
+    def test_a_rejecting_action_on_a_recursive_node_leaves_the_other_parses(self):
+        def reject_pairs(toks):
+            if len(toks[0]) == 2:
+                raise pp.ParseException("not this one")
+
+        expr = Forward()
+        atom = Word(alphas, exact=1)
+        expr <<= Group(atom + expr).add_parse_action(reject_pairs) | atom
+        self.assertEqual([["a"]], token_lists(expr, "abc"))
+        list(expr.enumerate_parses("abc", max_parses=1))
+        self.assertEqual([["a"]], token_lists(expr, "abc"))
+
+    def test_repetition_of_a_possibly_empty_expression_terminates(self):
+        expr = Group(Opt(Literal("a")))[1, ...]
+        self.assertEqual([[["a"], []], [["a"]], [[]]], token_lists(expr, "a"))
+
+    def test_zero_or_more_of_a_possibly_empty_expression_terminates(self):
+        expr = Group(Opt(Literal("a")))[...]
+        self.assertEqual([[["a"], []], [["a"]], [[]], []], token_lists(expr, "a"))
+
+
+class TestLookahead(unittest.TestCase):
+    def test_followed_by_is_zero_width_and_yields_one_parse(self):
+        expr = word() + FollowedBy(Literal(":"))
+        self.assertEqual([(["a"], 0, 1)], parses(expr, "a:"))
+
+    def test_followed_by_keeps_named_results_from_its_expression(self):
+        expr = word() + FollowedBy(Literal(":")("colon"))
+        tokens = next(iter(expr.enumerate_parses("a:")))[0]
+        self.assertEqual(":", tokens["colon"])
+
+    def test_followed_by_with_no_match_yields_nothing(self):
+        expr = word() + FollowedBy(Literal(":"))
