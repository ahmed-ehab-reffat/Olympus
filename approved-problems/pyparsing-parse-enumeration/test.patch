+
+    def test_ignored_expressions_are_skipped_between_repetitions(self):
+        expr = word()[1, ...].ignore(pp.python_style_comment)
+        self.assertEqual([["a", "b"], ["a"]], token_lists(expr, "a # note\n b"))
+
+    def test_enumeration_is_unaffected_by_packrat(self):
+        expr = Group(word()[1, ...]) + Group(word()[1, ...])
+        without_packrat = parses(expr, "a b c")
+        pp.ParserElement.enable_packrat()
+        try:
+            with_packrat = parses(expr, "a b c")
+        finally:
+            pp.ParserElement.disable_memoization()
+        self.assertEqual(without_packrat, with_packrat)
+
+    def test_packrat_does_not_change_how_often_actions_run(self):
+        def build(calls):
+            return Group(word()[1, ...]).add_parse_action(lambda toks: calls.append(1))
+
+        plain: list = []
+        parses(build(plain), "a b c")
+        memoized: list = []
+        pp.ParserElement.enable_packrat()
+        try:
+            parses(build(memoized), "a b c")
+        finally:
+            pp.ParserElement.disable_memoization()
+        self.assertEqual(len(plain), len(memoized))
+
+    def test_recursive_grammar_behaves_the_same_under_packrat(self):
+        def recursive():
+            expr = Forward()
+            atom = Word(alphas, exact=1)
+            expr <<= Group(atom + expr) | atom
+            return expr
+
+        plain = token_lists(recursive(), "abc")
+        pp.ParserElement.enable_packrat()
+        try:
+            memoized = recursive()
+            self.assertEqual(plain, token_lists(memoized, "abc"))
+            list(memoized.enumerate_parses("abc", max_parses=1))
+            self.assertEqual(plain, token_lists(memoized, "abc"))
+        finally:
+            pp.ParserElement.disable_memoization()
+
+    def test_scan_and_transforms_are_unaffected_by_packrat(self):
