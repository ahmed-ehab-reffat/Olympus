+class TestUnique(unittest.TestCase):
+    def test_unique_collapses_parses_with_the_same_tokens_and_end(self):
+        expr = (Literal("a") + Opt(Literal("b"))) | Literal("a")
+        self.assertEqual([["a"], ["a"]], token_lists(expr, "a"))
+        self.assertEqual([["a"]], token_lists(expr, "a", unique=True))
+
+    def test_unique_keeps_parses_that_differ_in_structure(self):
+        expr = Group(Literal("a") + Literal("b")) | (Group(Literal("a")) + Literal("b"))
+        self.assertEqual(
+            [[["a", "b"]], [["a"], "b"]], token_lists(expr, "ab", unique=True)
+        )
+
+    def test_unique_keeps_parses_that_differ_only_in_end_location(self):
+        self.assertEqual(
+            [["a", "b"], ["a"]], token_lists(word()[1, ...], "a b", unique=True)
+        )
+
+    def test_unique_counts_only_the_results_it_yields(self):
+        expr = Literal("a") | Literal("a") | (Literal("a") + Opt(Literal("b")))
+        self.assertEqual([["a"], ["a"], ["a", "b"], ["a"]], token_lists(expr, "ab"))
+        self.assertEqual([["a"], ["a", "b"]], token_lists(expr, "ab", unique=True))
+        self.assertEqual(
+            [["a"], ["a", "b"]], token_lists(expr, "ab", unique=True, max_parses=2)
+        )
+        self.assertEqual([["a"]], token_lists(expr, "ab", unique=True, max_parses=1))
+
+    def test_scan_unique_continues_past_skipped_duplicates(self):
