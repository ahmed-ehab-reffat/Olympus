+            [(["a"], 0, 1), (["a", "b"], 0, 2)], scanned(expr, "ab", unique=True)
+        )
+
+    def test_unique_distinguishes_parses_by_their_named_results(self):
+        letter = Word(alphas, exact=1)
+        expr = (letter("first") + Literal("b")) | (letter("second") + Literal("b"))
+        found = [
+            tokens.as_dict() for tokens, _, _ in expr.enumerate_parses("ab", unique=True)
+        ]
