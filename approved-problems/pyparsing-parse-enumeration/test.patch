+            return (Word(alphas, exact=1) | Word(alphas, exact=2)).add_parse_action(
+                lambda toks: f"<{toks[0]}>"
+            )
+
+        plain_scan = scanned(tagger(), "abc")
+        plain_transforms = list(tagger().enumerate_transforms("abc"))
+        pp.ParserElement.enable_packrat()
+        try:
+            memoized_scan = scanned(tagger(), "abc")
+            memoized_transforms = list(tagger().enumerate_transforms("abc"))
+        finally:
+            pp.ParserElement.disable_memoization()
+        self.assertEqual(plain_scan, memoized_scan)
+        self.assertEqual(plain_transforms, memoized_transforms)
