+# enumeration.py
+"""
+Drivers for enumerating every parse of an expression.
+
+An expression built from alternations, repetitions and optional elements can
+often match the same text in more than one way.  Ordinary parsing commits to
+the first of those matches; the drivers here walk all of them, most-preferred
+first, using the ``_enumerate`` protocol implemented by the expression classes
+in :mod:`pyparsing.core`.
+"""
+
+from __future__ import annotations
+
+import typing
+
+from .exceptions import ParseBaseException
+from .results import ParseResults
+
+if typing.TYPE_CHECKING:
+    from .core import ParserElement
+
+EnumeratedParse = typing.Tuple[ParseResults, int, int]
+
+
+def _streamlined(expr: ParserElement, instring: str) -> str:
+    if not expr.streamlined:
+        expr.streamline()
+    for e in expr.ignoreExprs:
+        e.streamline()
+    if not expr.keepTabs:
+        instring = str(instring).expandtabs()
+    return instring
+
+
+def _signature(tokens) -> typing.Any:
+    """
+    Build a hashable structural key for one parse: its token values, nested
+    structure and named results, so that two parses producing the same tokens
+    compare equal however they were derived.
+    """
+    if not isinstance(tokens, ParseResults):
+        return repr(tokens)
+
+    values = tuple(_signature(tok) for tok in tokens)
+    named = tuple(
+        sorted((name, _signature(value)) for name, value in tokens.as_dict().items())
+    )
+    return values, named
+
+
+def _reaches_end(expr: ParserElement, instring: str, loc: int) -> bool:
+    from .core import Empty, StringEnd
+
+    end_of_text = Empty() + StringEnd().set_debug(False)
+    try:
+        end_of_text._parse(instring, expr.preParse(instring, loc))
+    except ParseBaseException:
+        return False
+    return True
+
+
+def enumerate_parses(
+    expr: ParserElement,
+    instring: str,
+    *,
+    parse_all: bool = False,
+    max_parses: typing.Optional[int] = None,
+    unique: bool = False,
+) -> typing.Generator[EnumeratedParse, None, None]:
+    """
+    Yield ``(tokens, start, end)`` for every parse of ``expr`` at the start of
+    ``instring``, most-preferred parse first.
+    """
+    from .core import ParserElement as PE, _ParseActionIndexError
+
+    if max_parses is not None and max_parses <= 0:
+        return
+
+    instring = _streamlined(expr, instring)
+    PE.reset_cache()
+    produced = 0
+    seen: set = set()
+    try:
+        for start, end, tokens in expr._enumerate(instring, 0, True):
+            if parse_all and not _reaches_end(expr, instring, end):
+                continue
+            if unique:
+                signature = (end, _signature(tokens))
+                if signature in seen:
+                    continue
+                seen.add(signature)
+            yield tokens, start, end
+            produced += 1
+            if max_parses is not None and produced >= max_parses:
+                return
+    except _ParseActionIndexError as pa_exc:
+        raise pa_exc.exc
+    except ParseBaseException as exc:
+        if PE.verbose_stacktrace:
+            raise
+        raise exc.with_traceback(None)
+
+
+def enumerate_transforms(
+    expr: ParserElement,
+    instring: str,
+    *,
+    max_parses: typing.Optional[int] = None,
+) -> typing.Generator[str, None, None]:
+    """
+    Yield every distinct string that :class:`transform_string` could produce, one
+    per combination of parses chosen at the locations where ``expr`` matches.
+    """
+    from .core import Empty, ParserElement as PE, _ParseActionIndexError
+    from .util import _flatten
+
+    if max_parses is not None and max_parses <= 0:
+        return
+
+    expr.keepTabs = True
+    instring = _streamlined(expr, instring)
+    preparser = Empty()
+    preparser.ignoreExprs = expr.ignoreExprs
+    preparser.whiteChars = expr.whiteChars
+    instrlen = len(instring)
+
+    def replacement(tokens) -> str:
+        if isinstance(tokens, ParseResults):
+            parts: list = tokens.as_list()
+        elif isinstance(tokens, str):
+            parts = [tokens]
+        else:
+            parts = list(tokens)
+        return "".join(str(part) for part in _flatten(parts))
+
+    def transforms_from(loc, parts):
+        search_loc = loc
+        while search_loc <= instrlen:
+            pre_loc = preparser.preParse(instring, search_loc)
+            matched = False
+            for _, end, tokens in expr._enumerate(
+                instring, pre_loc, True, callPreParse=False
+            ):
+                if end <= search_loc:
+                    continue
+                matched = True
+                yield from transforms_from(
+                    end, parts + [instring[loc:pre_loc], replacement(tokens)]
+                )
+            if matched:
+                return
+            search_loc = pre_loc + 1
+
+        yield "".join(part for part in parts + [instring[loc:]] if part)
+
+    produced = 0
+    seen: set = set()
+    try:
+        for transformed in transforms_from(0, []):
+            if transformed in seen:
+                continue
+            seen.add(transformed)
+            yield transformed
+            produced += 1
+            if max_parses is not None and produced >= max_parses:
+                return
+    except _ParseActionIndexError as pa_exc:
+        raise pa_exc.exc
+    except ParseBaseException as exc:
+        if PE.verbose_stacktrace:
+            raise
+        raise exc.with_traceback(None)
+
+
+def enumerate_scan(
+    expr: ParserElement,
+    instring: str,
+    *,
+    max_parses: typing.Optional[int] = None,
+    overlap: bool = False,
+    unique: bool = False,
+) -> typing.Generator[EnumeratedParse, None, None]:
+    """
+    Yield ``(tokens, start, end)`` for every parse of ``expr`` at every location
+    in ``instring`` where it matches, scanning from left to right.
+    """
+    from .core import Empty, ParserElement as PE, _ParseActionIndexError
+
+    instring = _streamlined(expr, instring)
+    preparser = Empty()
+    preparser.ignoreExprs = expr.ignoreExprs
+    preparser.whiteChars = expr.whiteChars
+    instrlen = len(instring)
+    loc = 0
+    produced = 0
+    PE.reset_cache()
+    try:
+        while loc <= instrlen and (max_parses is None or produced < max_parses):
+            pre_loc = preparser.preParse(instring, loc)
+            first_end: typing.Optional[int] = None
+            seen: set = set()
+            for start, end, tokens in expr._enumerate(
+                instring, pre_loc, True, callPreParse=False
+            ):
+                if end <= loc:
+                    continue
+                if first_end is None:
+                    first_end = end
+                if unique:
+                    signature = (end, _signature(tokens))
+                    if signature in seen:
+                        continue
+                    seen.add(signature)
+                yield tokens, start, end
+                produced += 1
+                if max_parses is not None and produced >= max_parses:
+                    return
+            if first_end is None or overlap:
+                loc = pre_loc + 1
+            else:
+                loc = first_end
+    except _ParseActionIndexError as pa_exc:
+        raise pa_exc.exc
+    except ParseBaseException as exc:
+        if PE.verbose_stacktrace:
+            raise
+        raise exc.with_traceback(None)
