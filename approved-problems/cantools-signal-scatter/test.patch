+
+    def test_unneeded_multiplexer_takes_the_smallest_value(self):
+        db = load('dbc/issue_184_extended_mux_independent_multiplexors.dbc')
+        frames = db.encode_signals({'muxed_A_0': 1})
+
+        self.assertEqual(hexes(frames), ['0001010000000000'])
+
+    def test_unneeded_multiplexer_takes_the_value_it_was_given(self):
+        db = load('dbc/issue_184_extended_mux_independent_multiplexors.dbc')
+        frames = db.encode_signals({'muxed_A_0': 1, 'MUX_B': 2})
+
+        self.assertEqual(hexes(frames), ['0001020000000000'])
+
+    def test_multiplexer_value_which_selects_nothing_is_an_error(self):
+        db = load('dbc/issue_184_extended_mux_independent_multiplexors.dbc')
+        self.assert_error(EncodeError, ['MUX_B'],
+                          db.encode_signals, {'muxed_A_0': 1, 'MUX_B': 7})
+
+    def test_named_child_decides_over_a_named_multiplexer(self):
+        db = load('dbc/issue_184_extended_mux_independent_multiplexors.dbc')
+        frames = db.encode_signals({'muxed_B_2': 1, 'MUX_B': 1})
+
+        self.assertEqual(hexes(frames), ['0000020100000000'])
+
+    def test_nested_multiplexer_selects_the_whole_path(self):
+        db = load('dbc/issue_184_extended_mux_cascaded.dbc')
+        frames = db.encode_signals({'muxed_B_1': 1})
+
+        self.assertEqual(hexes(frames), ['0201000100000000'])
+
+    def test_nested_and_outer_values_give_a_frame_each(self):
+        db = load('dbc/issue_184_extended_mux_cascaded.dbc')
+        frames = db.encode_signals({'muxed_A_1': 1, 'muxed_B_0': 1})
+
+        self.assertEqual(hexes(frames), ['0101000000000000',
