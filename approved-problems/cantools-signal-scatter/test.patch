+
+    def test_signal_outside_the_multiplexed_part_repeats_on_every_frame(self):
+        db = load('dbc/multiplex.dbc')
+        frames = db.encode_signals({'BIT_J': 1})
+
+        self.assertEqual(len(frames), 3)
+
+        for frame in frames:
