+
+    def test_multiplexer_values_come_back_ascending(self):
+        db = load('dbc/issue_184_extended_mux_multiple_values.dbc')
+        frames = db.encode_signals({'muxed_0_3_4_5': 1})
+
+        self.assertEqual(hexes(frames), ['0001000000000000',
