+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+        --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+        base|new)        MODE="$1"; shift ;;
+        *)               shift ;;
+    esac
+done
+
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+else
+    OUTPUT_PATH="/tmp/cantools-results.xml"
+fi
+
+NEW_TESTS="tests/test_signal_scatter_fa303b.py"
+
+if [ "$MODE" = "new" ]; then
+    python -m pytest "$NEW_TESTS" -p no:cacheprovider \
+        --junitxml="$OUTPUT_PATH"
+else
+    python -m pytest tests/ -p no:cacheprovider \
+        --ignore="$NEW_TESTS" --junitxml="$OUTPUT_PATH"
+fi
+
+EXIT_CODE=$?
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="1" failures="0" tests="1" time="0">
+<testcase classname="test_signal_scatter" name="collection" time="0">
+<error message="collection failed">The test suite could not be collected.</error>
+</testcase></testsuite></testsuites>
+XMLEOF
+    exit 1
+fi
+
+exit $EXIT_CODE
