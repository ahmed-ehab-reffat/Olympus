+import io
+import unittest
+from unittest.mock import patch
+
+import cantools
+from cantools.database.can import Database, Message, Signal
+from cantools.database.conversion import BaseConversion
+from cantools.database.errors import DecodeError, EncodeError
+
+EncodedFrame = getattr(cantools.database, 'EncodedFrame', None)
+
+
+def signal(name, start, length, scale=1, offset=0, choices=None, **kwargs):
+    conversion = BaseConversion.factory(scale=scale,
+                                        offset=offset,
+                                        choices=choices)
+
+    return Signal(name=name,
+                  start=start,
+                  length=length,
+                  conversion=conversion,
+                  **kwargs)
+
+
+def message(name, frame_id, length, signals, **kwargs):
+    return Message(frame_id=frame_id,
+                   name=name,
+                   length=length,
+                   signals=signals,
+                   strict=False,
+                   **kwargs)
+
+
+def database(*messages):
+    return Database(messages=list(messages))
+
+
+def load(filename):
+    return cantools.database.load_file(f'tests/files/{filename}')
+
+
+def status_database():
+    status = message('Status', 0x100, 2, [
+        signal('Level', 0, 8, scale=2, offset=10, minimum=10, maximum=520),
+        signal('Mode', 8, 8, choices={0: 'Off', 1: 'On', 2: 'Auto'},
+               raw_initial=2),
+    ])
+    other = message('Other', 0x200, 1, [signal('Level', 0, 8)])
+
+    return database(status, other)
+
+
+def container_database(part_a_length=5, box_length=16, part_b_length=8):
+    part_a = message('PartA', 1, part_a_length, [signal('A0', 0, 8)],
+                     header_id=0x11)
+    part_b = message('PartB', 2, part_b_length, [signal('B0', 0, 8)],
+                     header_id=0x22)
+    box = message('Box', 0x300, box_length, [],
+                  contained_messages=[part_a, part_b],
+                  unused_bit_pattern=0xaa)
+
+    return database(box)
+
+
+def wide_container_database(box_length=32):
+    selector = signal('Sel', 0, 8, is_multiplexer=True)
+    low = signal('Lo', 8, 8, multiplexer_ids=[0], multiplexer_signal='Sel')
+    high = signal('Hi', 8, 8, multiplexer_ids=[1], multiplexer_signal='Sel')
+    muxed = message('Muxed', 3, 10, [selector, low, high], header_id=0x33)
+    plain = message('Plain', 4, 10, [signal('P0', 0, 8)], header_id=0x44)
+    box = message('WideBox', 0x500, box_length, [],
+                  contained_messages=[muxed, plain], unused_bit_pattern=0x55)
+
+    return database(box)
+
+
+def shared_container_database():
+    part_a = message('PartA', 1, 2, [
+        signal('Shared', 0, 8),
+        signal('Only', 8, 8, scale=2, offset=10),
+    ], header_id=0x11)
+    part_b = message('PartB', 2, 1, [
+        signal('Shared', 0, 8, choices={0: 'Zero', 7: 'Seven'}),
+    ], header_id=0x22)
+
+    return database(message('Box', 0x700, 32, [],
+                            contained_messages=[part_a, part_b]))
+
+
+def twin_container_database():
+    part_a = message('PartA', 1, 2, [signal('Shared', 0, 8),
+                                     signal('Tag', 8, 8)], header_id=0x11)
+    part_b = message('PartB', 2, 2, [signal('Shared', 0, 8),
+                                     signal('Mark', 8, 8)], header_id=0x22)
+
+    return database(message('Box', 0x300, 32, [],
+                            contained_messages=[part_a, part_b]))
+
+
+def muxed_container_database(box_length=16):
+    selector = signal('Sel', 0, 8, is_multiplexer=True)
+    low = signal('Lo', 8, 8, multiplexer_ids=[0], multiplexer_signal='Sel')
+    high = signal('Hi', 8, 8, multiplexer_ids=[1], multiplexer_signal='Sel')
+    muxed = message('Muxed', 3, 2, [selector, low, high], header_id=0x33)
+    plain = message('Plain', 4, 2, [signal('P0', 0, 8)], header_id=0x44)
+    box = message('MuxBox', 0x400, box_length, [],
+                  contained_messages=[muxed, plain], unused_bit_pattern=0x55)
+    echo = message('Echo', 0x401, 1, [signal('P0', 0, 8)])
+
+    return database(box, echo)
+
+
+def wide_message_database(length, pattern=0x00):
+    return database(message('Wide', 0x20, length, [signal('W0', 0, 8)],
+                            unused_bit_pattern=pattern))
+
+
+def hexes(frames):
+    return [frame.data.hex() for frame in frames]
+
+
+def named(frames):
+    return [(frame.message.name, frame.frame_id) for frame in frames]
+
+
+class SignalScatterTest(unittest.TestCase):
+
+    def assert_error(self, kind, fragments, callback, *args, **kwargs):
+        with self.assertRaises(kind) as cm:
+            callback(*args, **kwargs)
+
+        for fragment in fragments:
+            self.assertIn(fragment, str(cm.exception))
+
+    def test_single_message_gives_one_frame(self):
+        db = status_database()
+        frames = db.encode_signals({'Mode': 'On'})
+
+        self.assertEqual(named(frames), [('Status', 0x100)])
+        self.assertEqual(hexes(frames), ['0001'])
+
+    def test_encoded_frame_holds_message_identifier_and_data(self):
+        db = status_database()
+        frame = db.encode_signals({'Mode': 'On'})[0]
+
+        self.assertIs(frame.message, db.get_message_by_name('Status'))
+        self.assertEqual(frame.frame_id, 0x100)
+        self.assertEqual(frame.data, b'\x00\x01')
+
+    def test_encoded_frame_is_exported_with_its_fields(self):
+        db = status_database()
+        frame = db.encode_signals({'Mode': 'On'})[0]
+
+        self.assertIsInstance(frame, EncodedFrame)
+        self.assertEqual(EncodedFrame._fields, ('message', 'frame_id', 'data'))
+
+    def test_encoded_frame_is_named_in_the_package_exports(self):
+        self.assertIn('EncodedFrame', cantools.database.__all__)
+        self.assertIs(cantools.database.EncodedFrame, EncodedFrame)
+
+    def test_encoded_frame_unpacks_as_a_tuple(self):
+        db = status_database()
+        message_, frame_id, data = db.encode_signals({'Mode': 'On'})[0]
+
+        self.assertEqual(message_.name, 'Status')
+        self.assertEqual(frame_id, 0x100)
+        self.assertEqual(data, b'\x00\x01')
+
+    def test_message_without_a_named_signal_is_left_out(self):
+        db = status_database()
+
+        self.assertEqual(named(db.encode_signals({'Mode': 'Off'})),
+                         [('Status', 0x100)])
+
+    def test_empty_mapping_gives_no_frames(self):
+        self.assertEqual(status_database().encode_signals({}), [])
+
+    def test_shared_name_goes_into_every_message(self):
+        db = status_database()
+        frames = db.encode_signals({'Level': 100})
+
+        self.assertEqual(named(frames), [('Status', 0x100), ('Other', 0x200)])
+        self.assertEqual(hexes(frames), ['2d02', '64'])
+
+    def test_joined_key_reaches_only_its_message(self):
+        db = status_database()
+        frames = db.encode_signals({'Status.Level': 100})
+
+        self.assertEqual(named(frames), [('Status', 0x100)])
+        self.assertEqual(hexes(frames), ['2d02'])
+
+    def test_joined_key_wins_over_the_plain_one(self):
+        db = status_database()
+        frames = db.encode_signals({'Level': 100, 'Other.Level': 7})
+
+        self.assertEqual(hexes(frames), ['2d02', '07'])
+
+    def test_unknown_name_is_an_error(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Missing'],
+                          db.encode_signals, {'Missing': 1})
+
+    def test_every_unknown_name_is_named(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Alpha', 'Beta'],
+                          db.encode_signals, {'Beta': 1, 'Alpha': 2})
+
+    def test_joined_key_of_an_unknown_message_is_an_error(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Nothing.Level'],
+                          db.encode_signals, {'Nothing.Level': 1})
+
+    def test_joined_key_of_a_signal_the_message_lacks_is_an_error(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Other.Mode'],
+                          db.encode_signals, {'Other.Mode': 1})
+
+    def test_unknown_plain_and_joined_keys_are_listed_together(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Ghost.Level', 'Missing', 'Status.Gone'],
+                          db.encode_signals,
+                          {'Missing': 1, 'Status.Gone': 2, 'Ghost.Level': 3})
+
+    def test_no_frame_comes_back_when_a_key_is_unknown(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Ghost.Level', 'Missing'],
+                          db.encode_signals,
+                          {'Level': 100, 'Missing': 1, 'Ghost.Level': 2})
+
+    def test_signal_without_an_initial_value_falls_back_to_raw_zero(self):
+        db = status_database()
+        frames = db.encode_signals({'Mode': 'Auto'})
+
+        self.assertEqual(hexes(frames), ['0002'])
+
+    def test_signal_with_an_initial_value_uses_it(self):
+        db = status_database()
+        frames = db.encode_signals({'Status.Level': 10})
+
+        self.assertEqual(hexes(frames), ['0002'])
+
+    def test_signed_signal_falls_back_to_raw_zero(self):
+        db = database(message('Signed', 0x10, 2, [
+            signal('Wanted', 0, 8),
+            signal('Filled', 8, 8, scale=1, offset=-40, is_signed=True),
+        ]))
+
+        self.assertEqual(hexes(db.encode_signals({'Wanted': 3})), ['0300'])
+
+    def test_filled_in_value_below_the_minimum_is_kept(self):
+        db = database(message('Bounded', 0x10, 2, [
+            signal('Wanted', 0, 8),
+            signal('Filled', 8, 8, minimum=40, maximum=60),
+        ]))
+
+        self.assertEqual(hexes(db.encode_signals({'Wanted': 3})), ['0300'])
+
+    def test_value_above_the_maximum_is_an_error(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Level'],
+                          db.encode_signals, {'Status.Level': 1000})
+
+    def test_value_below_the_minimum_is_an_error(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Level'],
+                          db.encode_signals, {'Status.Level': 0})
+
+    def test_choice_string_the_signal_lacks_is_an_error(self):
+        db = status_database()
+        self.assert_error(EncodeError, ['Mode'],
+                          db.encode_signals, {'Mode': 'Nope'})
+
+    def test_choice_string_is_encoded_as_its_number(self):
+        db = status_database()
+
+        self.assertEqual(hexes(db.encode_signals({'Mode': 'Auto'})), ['0002'])
+
+    def test_scaling_off_takes_raw_values(self):
+        db = status_database()
+        frames = db.encode_signals({'Status.Level': 45}, scaling=False)
+
+        self.assertEqual(hexes(frames), ['2d02'])
+
+    def test_padding_writes_the_unused_bit_pattern(self):
+        db = database(message('Sparse', 0x10, 2, [signal('Wanted', 0, 4)],
+                              unused_bit_pattern=0xff))
+
+        self.assertEqual(hexes(db.encode_signals({'Wanted': 3})), ['0300'])
+        self.assertEqual(hexes(db.encode_signals({'Wanted': 3}, padding=True)),
+                         ['f3ff'])
+
+    def test_plain_frame_is_filled_to_a_can_data_length(self):
+        db = database(message('Wide', 0x20, 9, [signal('W0', 0, 8)],
+                              unused_bit_pattern=0xcc))
+
+        self.assertEqual(hexes(db.encode_signals({'W0': 3})),
+                         ['030000000000000000'])
+        padded = db.encode_signals({'W0': 3}, padding=True)
+
+        self.assertEqual(hexes(padded), ['03cccccccccccccccc000000'])
+        self.assertEqual(db.decode_frames(padded), {'W0': 3})
+
+    def test_frames_come_back_ordered_by_identifier(self):
+        low = message('Low', 0x10, 1, [signal('L', 0, 8)])
+        high = message('High', 0x20, 1, [signal('H', 0, 8)])
+        db = database(high, low)
+
+        self.assertEqual(named(db.encode_signals({'L': 1, 'H': 2})),
+                         [('Low', 0x10), ('High', 0x20)])
+
+    def test_messages_with_one_identifier_keep_database_order(self):
+        first = message('First', 0x30, 1, [signal('F0', 0, 8)])
+        second = message('Second', 0x30, 1, [signal('S0', 0, 8)])
+        db = database(second, first)
+
+        self.assertEqual(named(db.encode_signals({'F0': 1, 'S0': 2})),
+                         [('Second', 0x30), ('First', 0x30)])
+
+    def test_identifier_then_database_order_then_combinations(self):
+        selector = signal('Sel', 0, 8, is_multiplexer=True)
+        low = signal('Lo', 8, 8, multiplexer_ids=[0], multiplexer_signal='Sel')
+        high = signal('Hi', 8, 8, multiplexer_ids=[1], multiplexer_signal='Sel')
+        db = database(message('Bee', 0x50, 2, [selector, low, high]),
+                      message('Ay', 0x50, 1, [signal('A1', 0, 8)]),
+                      message('Cee', 0x40, 1, [signal('C1', 0, 8)]))
+        frames = db.encode_signals({'Lo': 1, 'Hi': 2, 'A1': 3, 'C1': 4})
+
+        self.assertEqual(named(frames), [('Cee', 0x40), ('Bee', 0x50),
+                                         ('Bee', 0x50), ('Ay', 0x50)])
+        self.assertEqual(hexes(frames), ['04', '0001', '0102', '03'])
+
+    def test_multiplexed_signal_selects_its_value(self):
+        db = load('dbc/multiplex.dbc')
+        frames = db.encode_signals({'BIT_A': 1})
+
+        self.assertEqual(len(frames), 1)
+        self.assertEqual(frames[0].data.hex(), '6000000400000000')
+
+    def test_two_multiplexer_values_give_two_frames(self):
+        db = load('dbc/multiplex_2.dbc')
+        frames = db.encode_signals({'Normal.S1': 1, 'Normal.S2': 1})
+
+        self.assertEqual(hexes(frames), ['1000000000000000',
