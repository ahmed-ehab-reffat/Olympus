@@ -0,0 +1,284 @@
+# Scattering flat signal dictionaries over the frames which carry them.
+
+from collections.abc import Mapping, Sequence
+from typing import TYPE_CHECKING, NamedTuple, Optional, Union, cast
+
+from ...typechecking import (
+    Codec,
+    SignalDictType,
+    SignalMappingType,
+    SignalValueType,
+)
+from ..errors import DecodeError, EncodeError
+
+if TYPE_CHECKING:
+    from .message import Message
+    from .signal import Signal
+
+
+class EncodedFrame(NamedTuple):
+    """A CAN frame produced by :meth:`can.Database.encode_signals`."""
+
+    message: "Message"
+    frame_id: int
+    data: bytes
+
+
+FrameSpecType = EncodedFrame | tuple[int, bytes]
+SelectionType = dict[str, int]
+
+CONTAINED_HEADER_SIZE = 4
+CAN_DATA_LENGTHS = (0, 1, 2, 3, 4, 5, 6, 7, 8, 12, 16, 20, 24, 32, 48, 64)
+
+
+def split_key(key: str) -> tuple[str | None, str]:
+    """The message a key names, if it names one, and the signal it names."""
+
+    message_name, dot, signal_name = key.partition('.')
+
+    if not dot:
+        return None, key
+
+    return message_name, signal_name
+
+
+def message_values(message_name: str,
+                   signal_values: SignalMappingType) -> SignalDictType:
+    """The part of `signal_values` which applies to the named message, with
+    the keys naming a message stripped of it."""
+
+    values: SignalDictType = {}
+    qualified: SignalDictType = {}
+
+    for key, value in signal_values.items():
+        owner, signal_name = split_key(key)
+
+        if owner is None:
+            values[signal_name] = value
+        elif owner == message_name:
+            qualified[signal_name] = value
+
+    values.update(qualified)
+
+    return values
+
+
+def codec_signal_names(codec: Codec | None) -> set[str]:
+    """The names of every signal at or below the given codec node."""
+
+    if codec is None:
+        return set()
+
+    names = {signal.name for signal in codec['signals']}
+
+    for mux_nodes in codec['multiplexers'].values():
+        for mux_codec in mux_nodes.values():
+            names |= codec_signal_names(cast('Codec', mux_codec))
+
+    return names
+
+
+def multiplexer_value(message: "Message",
+                      mux_name: str,
+                      mux_nodes: Mapping[int, Codec],
+                      signal_values: SignalMappingType,
+                      scaling: bool) -> int:
+    """The value a multiplexer was explicitly given, as a raw number."""
+
+    signal = message.get_signal_by_name(mux_name)
+    value = signal_values[mux_name]
+
+    if isinstance(value, (int, float)):
+        if scaling:
+            value = signal.conversion.numeric_scaled_to_raw(value)
+
+        number = int(value)
+    else:
+        number = signal.conversion.choice_to_number(str(value))
+
+    if number not in mux_nodes:
+        raise EncodeError(f'The multiplexer "{mux_name}" of message '
+                          f'"{message.name}" cannot take the value {number}.')
+
+    return number
+
+
+def required_selections(message: "Message",
+                        codec: Codec,
+                        signal_values: SignalMappingType,
+                        scaling: bool) -> list[SelectionType]:
+    """The multiplexer selections needed to carry every named signal below the
+    given codec node.
+
+    One selection is produced per combination of the values the named signals
+    ask for. Multiplexers are taken in the order their signals appear in the
+    message, so the first one varies the slowest.
+    """
+
+    selections: list[SelectionType] = [{}]
+
+    for mux_name, mux_nodes in codec['multiplexers'].items():
+        nodes = cast('Mapping[int, Codec]', mux_nodes)
+        wanted = sorted(
+            mux_value
+            for mux_value, mux_codec in nodes.items()
+            if codec_signal_names(mux_codec) & signal_values.keys()
+        )
+
+        if not wanted:
+            if mux_name in signal_values:
+                wanted = [multiplexer_value(message,
+                                            mux_name,
+                                            nodes,
+                                            signal_values,
+                                            scaling)]
+            else:
+                wanted = [min(nodes)]
+
+        combined: list[SelectionType] = []
+
+        for selection in selections:
+            for mux_value in wanted:
+                for nested in required_selections(message,
+                                                  nodes[mux_value],
+                                                  signal_values,
+                                                  scaling):
+                    combined.append({**selection,
+                                     mux_name: mux_value,
+                                     **nested})
+
+        selections = combined
+
+    return selections
+
+
+def selected_signals(codec: Codec,
+                     selection: SelectionType) -> list["Signal"]:
+    """Every signal a frame using the given selection carries."""
+
+    signals = list(codec['signals'])
+
+    for mux_name, mux_nodes in codec['multiplexers'].items():
+        mux_codec = cast('Codec', mux_nodes[selection[mux_name]])
+        signals += selected_signals(mux_codec, selection)
+
+    return signals
+
+
+def default_value(signal: "Signal", scaling: bool) -> SignalValueType:
+    """The value an unnamed signal is written with."""
+
+    raw = signal.raw_initial if signal.raw_initial is not None else 0
+
+    if not scaling:
+        return raw
+
+    return signal.conversion.raw_to_scaled(raw, decode_choices=False)
+
+
+def selection_values(message: "Message",
+                     codec: Codec,
+                     selection: SelectionType,
+                     signal_values: SignalMappingType,
+                     scaling: bool,
+                     fallback: SignalMappingType | None = None,
+                     ) -> tuple[SignalDictType, SignalDictType]:
+    """The complete signal dictionary of one frame, and the part of it which
+    the caller supplied."""
+
+    values: SignalDictType = {}
+    named: SignalDictType = {}
+
+    for signal in selected_signals(codec, selection):
+        name = signal.name
+
+        if name in selection:
+            raw = selection[name]
+            values[name] = (
+                signal.conversion.raw_to_scaled(raw, decode_choices=False)
+                if scaling
+                else raw
+            )
+        elif name in signal_values:
+            values[name] = signal_values[name]
+            named[name] = signal_values[name]
+        elif fallback is not None and name in fallback:
+            values[name] = fallback[name]
+        else:
+            values[name] = default_value(signal, scaling)
+
+    return values, named
+
+
+def pad_frame_data(data: bytes) -> bytes:
+    """Fill a frame with zeros up to the smallest CAN data length which holds
+    it."""
+
+    for length in CAN_DATA_LENGTHS:
+        if length >= len(data):
+            return data.ljust(length, b'\x00')
+
+    return data
+
+
+ContainedEntryType = tuple[Union["Message", int], "SignalDictType | bytes", int]
+
+
+def entry_size(contained: Union["Message", int],
+               value: "SignalDictType | bytes") -> int:
+    """The room a contained message takes in a container frame."""
+
+    if isinstance(value, bytes):
+        return CONTAINED_HEADER_SIZE + len(value)
+
+    return CONTAINED_HEADER_SIZE + cast('Message', contained).length
+
+
+def pack_container(container: "Message",
+                   entries: Sequence[ContainedEntryType]) \
+    -> list[list[tuple[Union["Message", int], "SignalDictType | bytes"]]]:
+    """Split contained messages into as few container frames as their order
+    allows."""
+
+    groups: list[list[tuple[Message | int, SignalDictType | bytes]]] = []
+    group: list[tuple[Message | int, SignalDictType | bytes]] = []
+    used = 0
+
+    for contained, value, size in entries:
+        if size > container.length:
+            name = f'0x{contained:x}' if isinstance(value, bytes) \
+                else cast('Message', contained).name
+
+            raise EncodeError(f'The contained message "{name}" does '
+                              f'not fit into the container message '
+                              f'"{container.name}".')
+
+        if group and used + size > container.length:
+            groups.append(group)
+            group = []
+            used = 0
+
+        group.append((contained, value))
+        used += size
+
+    if group:
+        groups.append(group)
+
+    return groups
+
+
+def split_frame(frame: FrameSpecType) \
+    -> tuple[Optional["Message"], int, bytes]:
+    """The message, identifier and data of a frame given as either an
+    :class:`EncodedFrame` or a pair. A pair names no message."""
+
+    try:
+        if isinstance(frame, EncodedFrame):
+            return frame.message, frame.frame_id, bytes(frame.data)
+
+        frame_id, data = frame
+
+        return None, int(frame_id), bytes(data)
+    except (TypeError, ValueError):
+        raise DecodeError(f'Expected a frame or an identifier and data pair, '
+                          f'but got {frame!r}.') from None
