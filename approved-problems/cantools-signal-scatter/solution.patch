+import argparse
+import logging
+import re
+import sys
+
+from argparse_addons import Integer  # type: ignore
+
+from .. import database, logreader
+from ..database.errors import EncodeError
+from ..typechecking import SignalValueType
+
+logging.basicConfig(level=logging.WARNING)
+
+
+def _parse_value(text: str) -> SignalValueType:
+    try:
+        return int(text, 0)
+    except ValueError:
+        pass
+
+    try:
+        return float(text)
+    except ValueError:
+        pass
+
+    return text
+
+
+_FRAME_RE = re.compile(r'\s*(?P<frame_id>[0-9A-Fa-f]{3,8})#'
+                       r'(?P<data>([0-9A-Fa-f]{2})*)\s*')
+
+
+def _parse_frame(line: str) -> tuple[int, bytes] | None:
+    match = _FRAME_RE.fullmatch(line)
+
+    if match is None:
+        return None
+
+    return (int(match.group('frame_id'), 16),
+            bytes.fromhex(match.group('data')))
+
+
+def _parse_line(line: str) -> dict[str, SignalValueType]:
+    signal_values: dict[str, SignalValueType] = {}
+
+    for item in line.split():
+        name, separator, value = item.partition('=')
+
+        if not separator or not name or not value or '=' in value:
+            raise EncodeError(f'Expected a "Name=Value" pair, but got '
+                              f'"{item}".')
+
+        signal_values[name] = _parse_value(value)
+
+    return signal_values
+
+
+def _format_frame(frame: database.EncodedFrame) -> str:
+    if frame.message.is_extended_frame:
+        frame_id = f'{frame.frame_id:08X}'
+    else:
+        frame_id = f'{frame.frame_id:03X}'
+
+    return f'{frame_id}#{frame.data.hex().upper()}'
+
+
+def _update_frames(dbase, args):
+    signal_values: dict[str, SignalValueType] = {}
+
+    for item in args.set:
+        signal_values.update(_parse_line(item))
+
+    parser = logreader.Parser(sys.stdin)
+    frames = []
+
+    for line, frame in parser.iterlines(keep_unknowns=True):
+        if frame is not None:
+            frames.append((frame.frame_id, frame.data))
+            continue
+
+        printed = _parse_frame(line)
+
+        if printed is not None:
+            frames.append(printed)
+        elif line.strip():
+            raise EncodeError(f'Expected a CAN frame, but got "{line}".')
+
+    return dbase.reencode_frames(frames,
+                                 signal_values,
+                                 padding=args.padding)
+
+
+def _do_encode(args):
+    dbase = database.load_file(args.database,
+                               encoding=args.encoding,
+                               frame_id_mask=args.frame_id_mask,
+                               prune_choices=args.prune,
+                               strict=not args.no_strict)
+
+    if args.update:
+        for frame in _update_frames(dbase, args):
+            print(_format_frame(frame))
+
+        return
+
+    for line in sys.stdin:
+        signal_values = _parse_line(line)
+
+        if not signal_values:
+            continue
+
+        for frame in dbase.encode_signals(signal_values,
+                                          padding=args.padding):
+            print(_format_frame(frame))
+
+
+def add_subparser(subparsers):
+    encode_parser = subparsers.add_parser(
+        'encode',
+        description=('Encode "Name=Value" signal pairs read from standard '
+                     'input and print the resulting CAN frames in the '
+                     '"candump" format.'),
+        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
+    encode_parser.add_argument(
+        '-p', '--padding',
+        action='store_true',
+        help='Encode unused bits with the unused bit pattern of their message.')
+    encode_parser.add_argument(
+        '-u', '--update',
+        action='store_true',
+        help=('Read "candump" CAN frames from standard input and encode them '
+              'again with the signals given by --set changed.'))
+    encode_parser.add_argument(
+        '-s', '--set',
+        action='append',
+        default=[],
+        metavar='NAME=VALUE',
+        help='A signal to change when --update is given.')
+    encode_parser.add_argument(
+        '-e', '--encoding',
+        help='File encoding.')
+    encode_parser.add_argument(
+        '--prune',
+        action='store_true',
+        help='Try to shorten the names of named signal choices.')
+    encode_parser.add_argument(
+        '--no-strict',
+        action='store_true',
+        help='Skip database consistency checks.')
+    encode_parser.add_argument(
+        '-m', '--frame-id-mask',
+        type=Integer(0),
+        help=('Only compare selected frame id bits to find the message in the '
+              'database. By default the candump and database frame ids must '
+              'be equal for a match.'))
+    encode_parser.add_argument(
+        'database',
+        help='Database file.')
+    encode_parser.set_defaults(func=_do_encode)
