+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+export HOME="${HOME:-/tmp}"
+export MPLBACKEND=Agg
+export MPLCONFIGDIR="${MPLCONFIGDIR:-/tmp/mpl}"
+mkdir -p "$MPLCONFIGDIR"
+
+NEW_TESTS="tests/test_mec_147685.py"
+BASE_TESTS="tests/TestGeneralGraphMethods.py tests/TestDagMethods.py tests/TestMECCHECK.py tests/TestSkeletonDiscovery.py tests/TestGST.py"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT="--junitxml=$OUTPUT_PATH"
+else
+  JUNIT=""
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest $NEW_TESTS -p no:cacheprovider $JUNIT
+  EXIT_CODE=$?
+else
+  python -m pytest $BASE_TESTS -p no:cacheprovider $JUNIT
+  EXIT_CODE=$?
+fi
+
+if [ -n "$OUTPUT_PATH" ] && [ $EXIT_CODE -ne 0 ]; then
+  if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+<testsuite name="pytest" tests="1" failures="1" errors="0" time="0">
+<testcase name="collection" classname="tests">
+<failure message="collection failed">The test suite could not be collected.</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+  fi
+fi
+
+exit $EXIT_CODE
