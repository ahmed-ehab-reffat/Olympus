+class TestMECEnumeration(unittest.TestCase):
+
+    def test_a_chain_has_three_members(self):
+        E = _enumeration()
+        S = _structure()
+        members = [S.directed_edges(member) for member in E.mec_dags(chain())]
+        self.assertEqual(members, [[('A', 'B'), ('B', 'C')],
+                                   [('B', 'A'), ('B', 'C')],
+                                   [('B', 'A'), ('C', 'B')]])
+
+    def test_the_collider_orientation_is_excluded(self):
+        E = _enumeration()
