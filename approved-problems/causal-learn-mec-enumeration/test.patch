+import unittest
+
+from causallearn.graph.Edge import Edge
+from causallearn.graph.Endpoint import Endpoint
+from causallearn.graph.GeneralGraph import GeneralGraph
+from causallearn.graph.GraphNode import GraphNode
+
+
+def _structure():
+    from causallearn.utils import MECStructure
+    return MECStructure
+
+
+def _enumeration():
+    from causallearn.utils import MECEnumeration
+    return MECEnumeration
+
+
+def _traversal():
+    from causallearn.utils import MECTraversal
+    return MECTraversal
+
+
+def _exception():
+    from causallearn.utils.MECStructure import MECException
+    return MECException
+
+
+def build(names, directed=(), undirected=()):
+    nodes = [GraphNode(name) for name in names]
+    graph = GeneralGraph(nodes)
+    lookup = dict(zip(names, nodes))
+    for tail, head in directed:
+        graph.add_edge(Edge(lookup[tail], lookup[head], Endpoint.TAIL, Endpoint.ARROW))
+    for one, other in undirected:
+        graph.add_edge(Edge(lookup[one], lookup[other], Endpoint.TAIL, Endpoint.TAIL))
+    return graph
+
+
+def chain():
+    return build(['A', 'B', 'C'], undirected=[('A', 'B'), ('B', 'C')])
+
+
+def collider():
+    return build(['A', 'B', 'C'], directed=[('A', 'B'), ('C', 'B')])
+
+
+def triangle():
+    return build(['A', 'B', 'C'], undirected=[('A', 'B'), ('B', 'C'), ('A', 'C')])
+
+
+class TestMECStructure(unittest.TestCase):
+
+    def test_directed_edges_are_parent_then_child(self):
+        S = _structure()
+        graph = build(['A', 'B'], directed=[('A', 'B')])
+        self.assertEqual(S.directed_edges(graph), [('A', 'B')])
+
+    def test_directed_edges_keep_the_written_direction(self):
+        S = _structure()
+        graph = build(['A', 'B'], directed=[('B', 'A')])
+        self.assertEqual(S.directed_edges(graph), [('B', 'A')])
+
+    def test_directed_edges_are_sorted(self):
+        S = _structure()
+        graph = build(['C', 'B', 'A'], directed=[('C', 'B'), ('B', 'A')])
+        self.assertEqual(S.directed_edges(graph), [('B', 'A'), ('C', 'B')])
+
+    def test_directed_edges_skip_undirected_ones(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B')], undirected=[('B', 'C')])
+        self.assertEqual(S.directed_edges(graph), [('A', 'B')])
+
+    def test_undirected_edges_put_the_smaller_name_first(self):
+        S = _structure()
+        graph = build(['B', 'A'], undirected=[('B', 'A')])
+        self.assertEqual(S.undirected_edges(graph), [('A', 'B')])
+
+    def test_undirected_edges_are_sorted(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], undirected=[('B', 'C'), ('A', 'B')])
+        self.assertEqual(S.undirected_edges(graph), [('A', 'B'), ('B', 'C')])
+
+    def test_undirected_edges_skip_directed_ones(self):
+        S = _structure()
+        self.assertEqual(S.undirected_edges(collider()), [])
+
+    def test_empty_graph_has_no_edges(self):
+        S = _structure()
+        graph = build(['A', 'B'])
+        self.assertEqual(S.directed_edges(graph), [])
+        self.assertEqual(S.undirected_edges(graph), [])
+
+    def test_chain_components_join_undirected_neighbours(self):
+        S = _structure()
+        self.assertEqual(S.chain_components(chain()), [('A', 'B', 'C')])
+
+    def test_chain_components_hold_every_node(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], undirected=[('A', 'B')])
+        self.assertEqual(S.chain_components(graph), [('A', 'B'), ('C',)])
+
+    def test_chain_components_ignore_directed_edges(self):
+        S = _structure()
+        self.assertEqual(S.chain_components(collider()), [('A',), ('B',), ('C',)])
+
+    def test_chain_components_are_ordered_by_their_smallest_name(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C', 'D'], undirected=[('C', 'D'), ('A', 'B')])
+        self.assertEqual(S.chain_components(graph), [('A', 'B'), ('C', 'D')])
+
+    def test_chain_components_of_an_empty_graph(self):
+        S = _structure()
+        self.assertEqual(S.chain_components(build(['B', 'A'])), [('A',), ('B',)])
+
+    def test_v_structures_of_a_collider(self):
+        S = _structure()
+        self.assertEqual(S.v_structures(collider()), [('A', 'B', 'C')])
+
+    def test_v_structures_put_the_smaller_parent_first(self):
+        S = _structure()
+        graph = build(['C', 'A', 'B'], directed=[('C', 'B'), ('A', 'B')])
+        self.assertEqual(S.v_structures(graph), [('A', 'B', 'C')])
+
+    def test_adjacent_parents_are_not_a_collider(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B'), ('C', 'B'), ('A', 'C')])
+        self.assertEqual(S.v_structures(graph), [])
+
+    def test_parents_joined_by_an_undirected_edge_are_not_a_collider(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B'), ('C', 'B')],
+                      undirected=[('A', 'C')])
+        self.assertEqual(S.v_structures(graph), [])
+
+    def test_a_chain_has_no_collider(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B'), ('B', 'C')])
+        self.assertEqual(S.v_structures(graph), [])
+
+    def test_v_structures_are_sorted(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C', 'D', 'E'],
+                      directed=[('D', 'E'), ('C', 'E'), ('A', 'B'), ('C', 'B')])
+        self.assertEqual(S.v_structures(graph), [('A', 'B', 'C'), ('C', 'E', 'D')])
+
+    def test_three_parents_give_three_colliders(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C', 'D'], directed=[('A', 'D'), ('B', 'D'), ('C', 'D')])
+        self.assertEqual(S.v_structures(graph),
+                         [('A', 'D', 'B'), ('A', 'D', 'C'), ('B', 'D', 'C')])
+
+    def test_is_acyclic_accepts_a_chain(self):
+        S = _structure()
+        self.assertTrue(S.is_acyclic(build(['A', 'B', 'C'], directed=[('A', 'B'), ('B', 'C')])))
+
+    def test_is_acyclic_rejects_a_cycle(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B'), ('B', 'C'), ('C', 'A')])
+        self.assertFalse(S.is_acyclic(graph))
+
+    def test_is_acyclic_ignores_undirected_edges(self):
+        S = _structure()
+        self.assertTrue(S.is_acyclic(triangle()))
+
+    def test_is_dag_wants_no_undirected_edge(self):
+        S = _structure()
+        self.assertFalse(S.is_dag(chain()))
+        self.assertTrue(S.is_dag(collider()))
+
+    def test_is_dag_rejects_a_cycle(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B'), ('B', 'C'), ('C', 'A')])
+        self.assertFalse(S.is_dag(graph))
+
+    def test_meek_rule_one_orients_away_from_a_collider(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B')], undirected=[('B', 'C')])
+        self.assertEqual(S.directed_edges(S.meek_closure(graph)), [('A', 'B'), ('B', 'C')])
+
+    def test_meek_rule_one_needs_non_adjacent_ends(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B')],
+                      undirected=[('B', 'C'), ('A', 'C')])
+        self.assertEqual(S.undirected_edges(S.meek_closure(graph)), [('A', 'C'), ('B', 'C')])
+
+    def test_meek_rule_two_avoids_a_cycle(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'C'), ('C', 'B')],
+                      undirected=[('A', 'B')])
+        self.assertEqual(S.directed_edges(S.meek_closure(graph)),
+                         [('A', 'B'), ('A', 'C'), ('C', 'B')])
+
+    def test_meek_rule_three(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C', 'D'],
+                      directed=[('C', 'B'), ('D', 'B')],
+                      undirected=[('A', 'B'), ('A', 'C'), ('A', 'D')])
+        closed = S.meek_closure(graph)
+        self.assertEqual(S.directed_edges(closed),
+                         [('A', 'B'), ('C', 'B'), ('D', 'B')])
+        self.assertEqual(S.undirected_edges(closed), [('A', 'C'), ('A', 'D')])
+
+    def test_meek_rule_four(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C', 'D'],
+                      directed=[('D', 'C'), ('C', 'B')],
+                      undirected=[('A', 'B'), ('A', 'C'), ('A', 'D')])
+        closed = S.meek_closure(graph)
+        self.assertEqual(S.directed_edges(closed),
+                         [('A', 'B'), ('C', 'B'), ('D', 'C')])
+        self.assertEqual(S.undirected_edges(closed), [('A', 'C'), ('A', 'D')])
+
+    def test_meek_closure_runs_to_a_fixed_point(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C', 'D'], directed=[('A', 'B')],
+                      undirected=[('B', 'C'), ('C', 'D')])
+        self.assertEqual(S.directed_edges(S.meek_closure(graph)),
+                         [('A', 'B'), ('B', 'C'), ('C', 'D')])
+
+    def test_meek_closure_keeps_the_skeleton(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B')], undirected=[('B', 'C')])
+        closed = S.meek_closure(graph)
+        before = set(S.directed_edges(graph)) | set(S.undirected_edges(graph))
+        after = set(S.directed_edges(closed)) | set(S.undirected_edges(closed))
+        self.assertEqual({tuple(sorted(pair)) for pair in before},
+                         {tuple(sorted(pair)) for pair in after})
+
+    def test_meek_closure_leaves_a_bare_chain_alone(self):
+        S = _structure()
+        self.assertEqual(S.directed_edges(S.meek_closure(chain())), [])
+
+    def test_meek_closure_does_not_touch_the_original(self):
+        S = _structure()
+        graph = build(['A', 'B', 'C'], directed=[('A', 'B')], undirected=[('B', 'C')])
+        S.meek_closure(graph)
+        self.assertEqual(S.undirected_edges(graph), [('B', 'C')])
+
+    def test_a_bidirected_edge_is_refused(self):
+        S = _structure()
+        nodes = [GraphNode('A'), GraphNode('B')]
+        graph = GeneralGraph(nodes)
+        graph.add_edge(Edge(nodes[0], nodes[1], Endpoint.ARROW, Endpoint.ARROW))
+        with self.assertRaises(_exception()):
+            S.directed_edges(graph)
+
+    def test_a_repeated_node_name_is_refused(self):
+        S = _structure()
+        graph = GeneralGraph([GraphNode('A'), GraphNode('A')])
+        with self.assertRaises(_exception()):
+            S.chain_components(graph)
+
+    def test_something_other_than_a_graph_is_refused(self):
+        S = _structure()
+        with self.assertRaises(_exception()):
+            S.directed_edges('not a graph')
+        with self.assertRaises(_exception()):
+            S.v_structures(17)
+
+    def test_names_are_compared_as_text_not_as_numbers(self):
+        S = _structure()
+        graph = build(['X2', 'X10'], undirected=[('X2', 'X10')])
+        self.assertEqual(S.undirected_edges(graph), [('X10', 'X2')])
+
+    def test_edges_are_sorted_as_text(self):
+        S = _structure()
+        graph = build(['X2', 'X10', 'X9'], directed=[('X2', 'X10'), ('X9', 'X2')])
+        self.assertEqual(S.directed_edges(graph), [('X2', 'X10'), ('X9', 'X2')])
+
+    def test_components_are_ordered_as_text(self):
+        S = _structure()
+        graph = build(['X2', 'X10', 'X9'], undirected=[('X2', 'X9')])
+        self.assertEqual(S.chain_components(graph), [('X10',), ('X2', 'X9')])
+
+    def test_reverse_insertion_does_not_change_the_order(self):
+        S = _structure()
+        graph = build(['C', 'B', 'A'], undirected=[('C', 'B'), ('B', 'A')])
+        self.assertEqual(S.undirected_edges(graph), [('A', 'B'), ('B', 'C')])
+        self.assertEqual(S.chain_components(graph), [('A', 'B', 'C')])
+
+    def test_colliders_are_named_as_text(self):
+        S = _structure()
+        graph = build(['X2', 'X10', 'X9'], directed=[('X2', 'X9'), ('X10', 'X9')])
+        self.assertEqual(S.v_structures(graph), [('X10', 'X9', 'X2')])
+
+    def test_an_arrow_written_first_is_still_a_directed_edge(self):
+        S = _structure()
+        nodes = [GraphNode('A'), GraphNode('B')]
+        graph = GeneralGraph(nodes)
+        graph.add_edge(Edge(nodes[0], nodes[1], Endpoint.ARROW, Endpoint.TAIL))
+        self.assertEqual(S.directed_edges(graph), [('B', 'A')])
+        self.assertEqual(S.undirected_edges(graph), [])
+
+    def test_both_written_orders_give_the_same_edge(self):
+        S = _structure()
+        nodes = [GraphNode('A'), GraphNode('B')]
+        one = GeneralGraph(nodes)
+        one.add_edge(Edge(nodes[0], nodes[1], Endpoint.ARROW, Endpoint.TAIL))
+        other = build(['A', 'B'], directed=[('B', 'A')])
+        self.assertEqual(S.directed_edges(one), S.directed_edges(other))
+
+    def test_meek_closure_keeps_the_node_order(self):
+        S = _structure()
+        graph = build(['C', 'B', 'A'], directed=[('C', 'B')], undirected=[('B', 'A')])
+        closed = S.meek_closure(graph)
+        self.assertEqual([node.get_name() for node in closed.get_nodes()], ['C', 'B', 'A'])
+
+    def test_meek_closure_refuses_a_bad_endpoint(self):
+        S = _structure()
+        nodes = [GraphNode('A'), GraphNode('B')]
