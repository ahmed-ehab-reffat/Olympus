@@ -0,0 +1,186 @@
+from __future__ import annotations
+
+from collections import deque
+from typing import Dict, List, Set, Tuple
+
+from causallearn.graph.GeneralGraph import GeneralGraph
+from causallearn.utils.MECStructure import (
+    Arc,
+    MECException,
+    _acyclic,
+    _adjacency,
+    _check_graph,
+    _rebuild,
+)
+
+
+def _as_dag(G: GeneralGraph) -> Tuple[List[str], Set[Arc]]:
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    if undirected:
+        raise MECException('a directed acyclic graph carries no undirected edge')
+    if not _acyclic(len(names), directed):
+        raise MECException('a directed acyclic graph carries no directed cycle')
+    return names, directed
+
+
+def _parents(directed: Set[Arc]) -> Dict[int, Set[int]]:
+    post: Dict[int, Set[int]] = {}
+    for parent, child in directed:
+        post.setdefault(child, set()).add(parent)
+        post.setdefault(parent, set())
+    return post
+
+
+def _covered(directed: Set[Arc]) -> Set[Arc]:
+    parents = _parents(directed)
+    post = set()
+    for parent, child in directed:
+        if parents.get(child, set()) - {parent} == parents.get(parent, set()):
+            post.add((parent, child))
+    return post
+
+
+def covered_edges(dag: GeneralGraph) -> List[Tuple[str, str]]:
+    """
+    Every covered edge of a directed acyclic graph, meaning every edge whose
+    child has exactly the parents of its parent besides that parent itself, as a
+    parent name then a child name, sorted.
+    """
+    names, directed = _as_dag(dag)
+    return sorted((names[i], names[j]) for i, j in _covered(directed))
+
+
+def reverse_covered_edge(dag: GeneralGraph, parent: str, child: str) -> GeneralGraph:
+    """
+    A copy of a directed acyclic graph with one covered edge turned round.
+    """
+    names, directed = _as_dag(dag)
+    if parent not in names or child not in names:
+        raise MECException('%r and %r are not both nodes of the graph' % (parent, child))
+    tail, head = names.index(parent), names.index(child)
+    if (tail, head) not in directed:
+        raise MECException('%s -> %s is not an edge of the graph' % (parent, child))
+    if (tail, head) not in _covered(directed):
+        raise MECException('%s -> %s is not covered' % (parent, child))
+    turned = set(directed)
+    turned.discard((tail, head))
+    turned.add((head, tail))
+    return _rebuild(dag, turned, set())
+
+
+def _named(names: List[str], member: Tuple[Arc, ...]) -> List[Tuple[str, str]]:
+    return sorted((names[i], names[j]) for i, j in member)
+
+
+def mec_neighbours(dag: GeneralGraph) -> List[GeneralGraph]:
+    """
+    Every graph one covered edge reversal away from a directed acyclic graph,
+    ordered by their lists of directed edges.
+    """
+    names, directed = _as_dag(dag)
+    found = set()
+    for tail, head in _covered(directed):
+        turned = set(directed)
+        turned.discard((tail, head))
+        turned.add((head, tail))
+        found.add(tuple(sorted(turned)))
+    ordered = sorted(found, key=lambda member: _named(names, member))
+    return [_rebuild(dag, set(member), set()) for member in ordered]
+
+
+def _reachable(start: Set[Arc]) -> Set[Tuple[Arc, ...]]:
+    origin = tuple(sorted(start))
+    seen = {origin}
+    queue = deque([origin])
+    while queue:
+        arcs = set(queue.popleft())
+        for tail, head in sorted(_covered(arcs)):
+            turned = set(arcs)
+            turned.discard((tail, head))
+            turned.add((head, tail))
+            key = tuple(sorted(turned))
+            if key not in seen:
+                seen.add(key)
+                queue.append(key)
+    return seen
+
+
+def _steps(state: Tuple[Arc, ...]) -> List[Tuple[Arc, ...]]:
+    arcs = set(state)
+    post = []
+    for tail, head in sorted(_covered(arcs)):
+        turned = set(arcs)
+        turned.discard((tail, head))
+        turned.add((head, tail))
+        post.append(tuple(sorted(turned)))
+    return sorted(set(post))
+
+
+def _distances(target: Tuple[Arc, ...]) -> Dict[Tuple[Arc, ...], int]:
+    depth = {target: 0}
+    queue = deque([target])
+    while queue:
+        current = queue.popleft()
+        for other in _steps(current):
+            if other not in depth:
+                depth[other] = depth[current] + 1
+                queue.append(other)
+    return depth
+
+
+def mec_from_traversal(dag: GeneralGraph) -> List[GeneralGraph]:
+    """
+    Every graph reachable from a directed acyclic graph by turning covered edges
+    round over and over, ordered by their lists of directed edges.
+    """
+    names, directed = _as_dag(dag)
+    ordered = sorted(_reachable(directed), key=lambda member: _named(names, member))
+    return [_rebuild(dag, set(member), set()) for member in ordered]
+
+
+def reversal_distance(first: GeneralGraph, second: GeneralGraph) -> int:
+    """
+    The fewest covered edge reversals turning one directed acyclic graph into
+    another, which is 0 for a graph and itself.
+    """
+    return len(reversal_path(first, second)) - 1
+
+
+def reversal_path(first: GeneralGraph, second: GeneralGraph) -> List[GeneralGraph]:
+    """
+    A shortest run of directed acyclic graphs from one to another, each one
+    covered edge reversal after the one before, starting at the first graph and
+    ending at the second.  Among the shortest, the run whose lists of directed
+    edges come first is chosen.
+    """
+    left_names, left = _as_dag(first)
+    right_names, right = _as_dag(second)
+    if left_names != right_names:
+        raise MECException('the two graphs carry different nodes')
+    origin = tuple(sorted(left))
+    target = tuple(sorted(right))
+    depth = _distances(target)
+    if origin not in depth:
+        raise MECException('the two graphs do not belong to one class')
+    chain = [origin]
+    current = origin
+    while current != target:
+        remaining = depth[current] - 1
+        current = min((other for other in _steps(current)
+                       if depth.get(other, -1) == remaining),
+                      key=lambda member: _named(left_names, member))
+        chain.append(current)
+    return [_rebuild(first, set(member), set()) for member in chain]
+
+
+def is_reachable(first: GeneralGraph, second: GeneralGraph) -> bool:
+    """
+    Whether covered edge reversals lead from one directed acyclic graph to
+    another, refusing two graphs whose node names differ.
+    """
+    left_names, left = _as_dag(first)
+    right_names, right = _as_dag(second)
+    if left_names != right_names:
+        raise MECException('the two graphs carry different nodes')
+    return tuple(sorted(right)) in _reachable(left)
