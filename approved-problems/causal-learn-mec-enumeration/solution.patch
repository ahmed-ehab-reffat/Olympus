+++ b/causallearn/utils/MECEnumeration.py
@@ -0,0 +1,252 @@
+from __future__ import annotations
+
+from typing import Dict, List, Set, Tuple
+
+from causallearn.graph.GeneralGraph import GeneralGraph
+from causallearn.utils.MECStructure import (
+    Arc,
+    MECException,
+    _acyclic,
+    _adjacency,
+    _adjacent_pairs,
+    _check_graph,
+    _closure,
+    _rebuild,
+    directed_edges,
+)
+
+
+def _new_collider(directed: Set[Arc], adjacent: Set[Arc], parent: int, child: int) -> bool:
+    for other in {source for source, target in directed if target == child}:
+        if other != parent and (other, parent) not in adjacent:
+            return True
+    return False
+
+
+def _extensions(size: int, directed: Set[Arc], undirected: Set[Arc]) -> List[Tuple[Arc, ...]]:
+    adjacent = _adjacent_pairs(directed, undirected)
+    pending = sorted(undirected)
+    found: List[Tuple[Arc, ...]] = []
+
+    def walk(index: int, chosen: Set[Arc]) -> None:
+        if index == len(pending):
+            if _acyclic(size, chosen):
+                found.append(tuple(sorted(chosen)))
+            return
+        a, b = pending[index]
+        for parent, child in ((a, b), (b, a)):
+            if _new_collider(chosen, adjacent, parent, child):
+                continue
+            chosen.add((parent, child))
+            if _acyclic(size, chosen):
+                walk(index + 1, chosen)
+            chosen.discard((parent, child))
+
+    walk(0, set(directed))
+    return sorted(found)
+
+
+def _named(names: List[str], member: Tuple[Arc, ...]) -> List[Tuple[str, str]]:
+    return sorted((names[i], names[j]) for i, j in member)
+
+
+def _has_extension(size: int, directed: Set[Arc], undirected: Set[Arc]) -> bool:
+    arcs = set(directed)
+    loose = {tuple(sorted(pair)) for pair in undirected}
+    left = set(range(size))
+    while left:
+        for node in sorted(left):
+            if any(parent == node and child in left for parent, child in arcs):
+                continue
+            neighbours = {other for pair in loose for other in pair
+                          if node in pair and other != node and other in left}
+            adjacent = {child for parent, child in arcs if parent == node and child in left}
+            adjacent |= {parent for parent, child in arcs if child == node and parent in left}
+            adjacent |= neighbours
+            if all(all(other == mate or (other, mate) in _pairs(arcs, loose)
+                       for mate in adjacent - {other})
+                   for other in neighbours):
+                left.discard(node)
+                arcs = {(p, c) for p, c in arcs if p != node and c != node}
+                loose = {pair for pair in loose if node not in pair}
+                break
+        else:
+            return False
+    return True
+
+
+def _pairs(directed: Set[Arc], undirected: Set[Arc]) -> Set[Arc]:
+    post = set()
+    for i, j in directed | undirected:
+        post.add((i, j))
+        post.add((j, i))
+    return post
+
+
+def mec_dags(G: GeneralGraph) -> List[GeneralGraph]:
+    """
+    Every acyclic orientation of a partially directed graph that keeps its
+    directed edges and adds no collider the graph does not already carry.
+
+    The members come back ordered by their lists of directed edges.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    if not _acyclic(len(names), directed):
+        raise MECException('a partially directed graph with a directed cycle has no extension')
+    members = sorted(_extensions(len(names), directed, undirected),
+                     key=lambda member: _named(names, member))
+    return [_rebuild(G, set(member), set()) for member in members]
+
+
+def is_consistent_extension(dag: GeneralGraph, G: GeneralGraph) -> bool:
+    """
+    Whether a directed acyclic graph orients every undirected edge of a partially
+    directed graph, keeps its directed edges, and carries the same colliders.
+    """
+    _check_graph(dag)
+    _check_graph(G)
+    dag_names, dag_directed, dag_undirected = _adjacency(dag)
+    names, directed, undirected = _adjacency(G)
+    if dag_names != names:
+        raise MECException('the two graphs carry different nodes')
+    if dag_undirected:
+        return False
+    if not _acyclic(len(names), dag_directed):
+        return False
+    skeleton = {tuple(sorted(pair)) for pair in directed | undirected}
+    if {tuple(sorted(pair)) for pair in dag_directed} != skeleton:
+        return False
+    if not directed <= dag_directed:
+        return False
+    return tuple(sorted(dag_directed)) in set(_extensions(len(names), directed, undirected))
+
+
+def mec_size(G: GeneralGraph) -> int:
+    """
+    How many members the class holds.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    if not _acyclic(len(names), directed):
+        raise MECException('a partially directed graph with a directed cycle has no extension')
+    return len(_extensions(len(names), directed, undirected))
+
+
+def canonical_dag(G: GeneralGraph) -> GeneralGraph:
+    """
+    The member of the class whose list of directed edges comes first.
+    """
+    members = mec_dags(G)
+    if not members:
+        raise MECException('the class is empty')
+    return members[0]
+
+
+def edge_orientation_counts(G: GeneralGraph) -> List[Tuple[str, str, int, int]]:
+    """
+    For every undirected edge, its two names with the smaller first and how many
+    members of the class orient it each way, that count first for the smaller
+    name as the parent.  Sorted by the pair of names.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    members = _extensions(len(names), directed, undirected)
+    if not members:
+        raise MECException('the class is empty')
+    counts: Dict[Arc, List[int]] = {}
+    for pair in sorted(undirected):
+        counts[pair] = [0, 0]
+    for member in members:
+        arcs = set(member)
+        for i, j in counts:
+            if (i, j) in arcs:
+                counts[(i, j)][0] += 1
+            else:
+                counts[(i, j)][1] += 1
+    post = []
+    for (i, j), (forward, backward) in counts.items():
+        first, second = names[i], names[j]
+        if first <= second:
+            post.append((first, second, forward, backward))
+        else:
+            post.append((second, first, backward, forward))
+    return sorted(post, key=lambda entry: (entry[0], entry[1]))
+
+
+def compelled_edges(G: GeneralGraph) -> List[Tuple[str, str]]:
+    """
+    The directed edges every member shares, as a parent name then a child name,
+    sorted.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    if not _acyclic(len(names), directed) or not _has_extension(len(names), directed, undirected):
+        raise MECException('a graph with no member has no compelled edge')
+    closed, unused = _closure(len(names), directed, undirected)
+    return sorted((names[i], names[j]) for i, j in closed)
+
+
+def essential_graph(G: GeneralGraph) -> GeneralGraph:
+    """
+    The graph carrying the same skeleton, every edge the whole class agrees on
+    directed and every other edge left undirected.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    if not _acyclic(len(names), directed) or not _has_extension(len(names), directed, undirected):
+        raise MECException('a graph with no member has no essential graph')
+    closed, loose = _closure(len(names), directed, undirected)
+    return _rebuild(G, closed, loose)
+
+
+def is_cpdag(G: GeneralGraph) -> bool:
+    """
+    Whether a graph already leaves undirected exactly those edges its class
+    disagrees on, so that it is its own essential graph.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    if not _acyclic(len(names), directed):
+        return False
+    if not _has_extension(len(names), directed, undirected):
+        return False
+    closed, unused = _closure(len(names), directed, undirected)
+    return closed == directed
+
+
+def mec_of_dag(dag: GeneralGraph) -> GeneralGraph:
+    """
+    The essential graph of a directed acyclic graph, which is the class it
+    belongs to.
+    """
+    _check_graph(dag)
+    names, directed, undirected = _adjacency(dag)
+    if undirected:
+        raise MECException('a directed acyclic graph carries no undirected edge')
+    if not _acyclic(len(names), directed):
+        raise MECException('a directed acyclic graph carries no directed cycle')
+    skeleton = {tuple(sorted(pair)) for pair in directed}
+    colliders = set()
+    adjacent = _adjacent_pairs(directed, set())
+    for child in range(len(names)):
+        parents = sorted(source for source, target in directed if target == child)
+        for position, first in enumerate(parents):
+            for second in parents[position + 1:]:
+                if (first, second) not in adjacent:
+                    colliders.add((first, child))
+                    colliders.add((second, child))
+    return essential_graph(_rebuild(dag, colliders, skeleton - {tuple(sorted(pair)) for pair in colliders}))
+
+
+def same_class(first: GeneralGraph, second: GeneralGraph) -> bool:
+    """
+    Whether two directed acyclic graphs belong to one class, meaning they share a
+    skeleton and their colliders.
+    """
+    left = mec_of_dag(first)
+    right = mec_of_dag(second)
+    if [node.get_name() for node in left.get_nodes()] != [node.get_name() for node in right.get_nodes()]:
+        raise MECException('the two graphs carry different nodes')
+    return directed_edges(left) == directed_edges(right) \
+        and _adjacency(left)[2] == _adjacency(right)[2]
