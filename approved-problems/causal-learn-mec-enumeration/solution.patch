+++ b/causallearn/utils/MECStructure.py
@@ -0,0 +1,261 @@
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Dict, List, Set, Tuple
+
+from causallearn.graph.Edge import Edge
+from causallearn.graph.Endpoint import Endpoint
+from causallearn.graph.GeneralGraph import GeneralGraph
+
+Arc = Tuple[int, int]
+
+
+class MECException(Exception):
+    pass
+
+
+def _node_names(G: GeneralGraph) -> List[str]:
+    return [node.get_name() for node in G.get_nodes()]
+
+
+def _check_graph(G) -> None:
+    if not isinstance(G, GeneralGraph):
+        raise MECException('a partially directed graph is required, not %r' % (G,))
+    names = _node_names(G)
+    if len(set(names)) != len(names):
+        raise MECException('node names must be unique, not %r' % (names,))
+    for i in range(G.num_vars):
+        for j in range(i + 1, G.num_vars):
+            pair = (G.graph[j, i], G.graph[i, j])
+            if pair not in ((0, 0), (-1, -1), (1, -1), (-1, 1)):
+                raise MECException(
+                    'the edge between %s and %s is neither directed nor undirected'
+                    % (names[i], names[j])
+                )
+
+
+def _adjacency(G: GeneralGraph) -> Tuple[List[str], Set[Arc], Set[Arc]]:
+    names = _node_names(G)
+    directed: Set[Arc] = set()
+    undirected: Set[Arc] = set()
+    for i in range(G.num_vars):
+        for j in range(i + 1, G.num_vars):
+            pair = (G.graph[j, i], G.graph[i, j])
+            if pair == (-1, -1):
+                undirected.add((i, j))
+            elif pair == (1, -1):
+                directed.add((i, j))
+            elif pair == (-1, 1):
+                directed.add((j, i))
+    return names, directed, undirected
+
+
+def _neighbours(size: int, undirected: Set[Arc]) -> Dict[int, Set[int]]:
+    post: Dict[int, Set[int]] = {i: set() for i in range(size)}
+    for i, j in undirected:
+        post[i].add(j)
+        post[j].add(i)
+    return post
+
+
+def _adjacent_pairs(directed: Set[Arc], undirected: Set[Arc]) -> Set[Arc]:
+    post = set()
+    for i, j in directed | undirected:
+        post.add((i, j))
+        post.add((j, i))
+    return post
+
+
+def directed_edges(G: GeneralGraph) -> List[Tuple[str, str]]:
+    """
+    Every directed edge of a graph as a parent name then a child name, sorted.
+    """
+    _check_graph(G)
+    names, directed, _ = _adjacency(G)
+    return sorted((names[i], names[j]) for i, j in directed)
+
+
+def undirected_edges(G: GeneralGraph) -> List[Tuple[str, str]]:
+    """
+    Every undirected edge of a graph as a pair of names, smaller name first, sorted.
+    """
+    _check_graph(G)
+    names, _, undirected = _adjacency(G)
+    return sorted(tuple(sorted((names[i], names[j]))) for i, j in undirected)
+
+
+def chain_components(G: GeneralGraph) -> List[Tuple[str, ...]]:
+    """
+    The connected components of the undirected part of a graph, each a sorted
+    tuple of names, the components ordered by their smallest name.
+    """
+    _check_graph(G)
+    names, _, undirected = _adjacency(G)
+    neighbours = _neighbours(len(names), undirected)
+    seen: Set[int] = set()
+    components: List[Tuple[str, ...]] = []
+    for start in range(len(names)):
+        if start in seen:
+            continue
+        stack, found = [start], []
+        seen.add(start)
+        while stack:
+            current = stack.pop()
+            found.append(current)
+            for other in neighbours[current]:
+                if other not in seen:
+                    seen.add(other)
+                    stack.append(other)
+        components.append(tuple(sorted(names[i] for i in found)))
+    return sorted(components, key=lambda component: component[0])
+
+
+def v_structures(G: GeneralGraph) -> List[Tuple[str, str, str]]:
+    """
+    Every collider of a graph, as its two parents with the smaller name first and
+    the collider between them, sorted.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    adjacent = _adjacent_pairs(directed, undirected)
+    parents: Dict[int, Set[int]] = {i: set() for i in range(len(names))}
+    for i, j in directed:
+        parents[j].add(i)
+
+    found = []
+    for collider in range(len(names)):
+        ordered = sorted(parents[collider])
+        for position, first in enumerate(ordered):
+            for second in ordered[position + 1:]:
+                if (first, second) in adjacent:
+                    continue
+                left, right = sorted((names[first], names[second]))
+                found.append((left, names[collider], right))
+    return sorted(found)
+
+
+def _apply_meek(size: int, directed: Set[Arc], undirected: Set[Arc]) -> None:
+    adjacent = _adjacent_pairs(directed, undirected)
+    changed = True
+    while changed:
+        changed = False
+        for a, b in sorted(undirected):
+            for tail, head in ((a, b), (b, a)):
+                if _rule_one(directed, adjacent, tail, head) \
+                        or _rule_two(directed, tail, head) \
+                        or _rule_three(size, directed, undirected, adjacent, tail, head) \
+                        or _rule_four(size, directed, undirected, adjacent, tail, head):
+                    undirected.discard((a, b))
+                    directed.add((tail, head))
+                    changed = True
+                    break
+            if changed:
+                break
+
+
+def _rule_one(directed: Set[Arc], adjacent: Set[Arc], tail: int, head: int) -> bool:
+    for parent, child in directed:
+        if child == tail and parent != head and (parent, head) not in adjacent:
+            return True
+    return False
+
+
+def _rule_two(directed: Set[Arc], tail: int, head: int) -> bool:
+    for middle in {child for parent, child in directed if parent == tail}:
+        if (middle, head) in directed:
+            return True
+    return False
+
+
+def _rule_three(size: int, directed: Set[Arc], undirected: Set[Arc],
+                adjacent: Set[Arc], tail: int, head: int) -> bool:
+    neighbours = _neighbours(size, undirected)
+    witnesses = sorted(
+        middle for middle in neighbours[tail]
+        if middle != head and (middle, head) in directed
+    )
+    for position, first in enumerate(witnesses):
+        for second in witnesses[position + 1:]:
+            if (first, second) not in adjacent:
+                return True
+    return False
+
+
+def _rule_four(size: int, directed: Set[Arc], undirected: Set[Arc],
+               adjacent: Set[Arc], tail: int, head: int) -> bool:
+    neighbours = _neighbours(size, undirected)
+    for middle in neighbours[tail]:
+        if middle == head or (middle, head) not in directed:
+            continue
+        for grand in neighbours[tail]:
+            if grand in (head, middle):
+                continue
+            if (grand, middle) in directed and (grand, head) not in adjacent:
+                return True
+    return False
+
+
+def _closure(size: int, directed: Set[Arc], undirected: Set[Arc]) -> Tuple[Set[Arc], Set[Arc]]:
+    directed = set(directed)
+    undirected = {tuple(sorted(pair)) for pair in undirected}
+    _apply_meek(size, directed, undirected)
+    return directed, undirected
+
+
+def _rebuild(G: GeneralGraph, directed: Set[Arc], undirected: Set[Arc]) -> GeneralGraph:
+    nodes = G.get_nodes()
+    post = deepcopy(G)
+    for edge in post.get_graph_edges():
+        post.remove_edge(edge)
+    for i, j in sorted(directed):
+        post.add_edge(Edge(nodes[i], nodes[j], Endpoint.TAIL, Endpoint.ARROW))
+    for i, j in sorted(undirected):
+        post.add_edge(Edge(nodes[i], nodes[j], Endpoint.TAIL, Endpoint.TAIL))
+    return post
+
+
+def meek_closure(G: GeneralGraph) -> GeneralGraph:
+    """
+    A copy of a partially directed graph with the four orientation rules of Meek
+    applied over and over until no further undirected edge can be oriented.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    directed, undirected = _closure(len(names), directed, undirected)
+    return _rebuild(G, directed, undirected)
+
+
+def _acyclic(size: int, directed: Set[Arc]) -> bool:
+    children: Dict[int, Set[int]] = {i: set() for i in range(size)}
+    indegree = {i: 0 for i in range(size)}
+    for parent, child in directed:
+        children[parent].add(child)
+        indegree[child] += 1
+    ready = [i for i in range(size) if indegree[i] == 0]
+    seen = 0
+    while ready:
+        current = ready.pop()
+        seen += 1
+        for child in children[current]:
+            indegree[child] -= 1
+            if indegree[child] == 0:
+                ready.append(child)
+    return seen == size
+
+
+def is_acyclic(G: GeneralGraph) -> bool:
+    """
+    Whether the directed part of a graph carries no directed cycle.
+    """
+    _check_graph(G)
+    names, directed, _ = _adjacency(G)
+    return _acyclic(len(names), directed)
+
+
+def is_dag(G: GeneralGraph) -> bool:
+    """
+    Whether a graph is acyclic and carries no undirected edge.
+    """
+    _check_graph(G)
+    names, directed, undirected = _adjacency(G)
+    return not undirected and _acyclic(len(names), directed)
