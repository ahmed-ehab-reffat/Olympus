@@ -0,0 +1,314 @@
+# sourcetree.py
+"""
+A tree of the source text a parse consumed, including the text it skipped.
+"""
+
+from __future__ import annotations
+
+import typing
+
+_Part = typing.Union[str, "SourceNode"]
+
+
+class SourceNode:
+    """
+    One expression's share of the source text.
+
+    A node covers the text its expression matched, and carries the whitespace and
+    ignored text that was skipped just before it. Putting a node's own text back
+    together with the text of the nodes below it gives that part of the input back
+    exactly as it arrived.
+    """
+
+    __slots__ = (
+        "name",
+        "start",
+        "end",
+        "_trivia_parts",
+        "skipped",
+        "tokens",
+        "parent",
+        "_source",
+        "_parts",
+        "_replacement",
+        "_before",
+        "_after",
+        "_removed",
+    )
+
+    def __init__(
+        self,
+        name: str,
+        start: int,
+        end: int,
+        trivia: typing.Union[str, tuple[_Part, ...]],
+        parts: tuple[_Part, ...],
+        source: str = "",
+        tokens: typing.Any = None,
+        skipped: tuple["SourceNode", ...] = (),
+    ) -> None:
+        self.name = name
+        self.start = start
+        self.end = end
+        self._trivia_parts = (trivia,) if isinstance(trivia, str) else tuple(trivia)
+        self.skipped = skipped
+        self.tokens = tokens.copy() if hasattr(tokens, "copy") else tokens
+        self.parent: typing.Optional[SourceNode] = None
+        self._source = source
+        self._parts = parts
+        self._replacement: typing.Optional[str] = None
+        self._before = ""
+        self._after = ""
+        self._removed = False
+        for part in parts + self._trivia_parts:
+            if isinstance(part, SourceNode):
+                part.parent = self
+
+    @property
+    def trivia(self) -> str:
+        """
+        The text skipped just before this node, with any rewriting of the ignored
+        expressions inside it applied.
+        """
+        return "".join(
+            part if isinstance(part, str) else part.source()
+            for part in self._trivia_parts
+        )
+
+    @property
+    def children(self) -> tuple[SourceNode, ...]:
+        """
+        The nodes of the expressions this one is built from, in source order.
+        """
+        return tuple(part for part in self._parts if isinstance(part, SourceNode))
+
+    @property
+    def text(self) -> str:
+        """
+        The source text this node stands for, without the text skipped before it,
+        and with any replacement applied.
+        """
+        if self._replacement is not None:
+            return self._replacement
+        return "".join(
+            part if isinstance(part, str) else part.source() for part in self._parts
+        )
+
+    def source(self) -> str:
+        """
+        The source text this node accounts for, skipped text included, with any
+        rewriting applied.
+        """
+        if self._removed:
+            return ""
+        return self.trivia + self._before + self.text + self._after
+
+    def replace(self, text: str) -> None:
+        """
+        Put ``text`` where this node matched. Every other character of the input is
+        left as it was, the text skipped before this node included.
+        """
+        self._replacement = text
+
+    def remove(self) -> None:
+        """
+        Take this node out, along with the text skipped before it.
+        """
+        self._removed = True
+
+    def insert_before(self, text: str) -> None:
+        """
+        Put ``text`` between the text skipped before this node and its own text.
+        """
+        self._before += text
+
+    def insert_after(self, text: str) -> None:
+        """
+        Put ``text`` straight after this node's own text.
+        """
+        self._after += text
+
+    def find(self, name: str) -> typing.Optional[SourceNode]:
+        """
+        The first node of this name, this one included, in source order.
+        """
+        for node in self.walk():
+            if node.name == name:
+                return node
+        return None
+
+    def find_all(self, name: str) -> list[SourceNode]:
+        """
+        Every node of this name, in source order.
+        """
+        return [node for node in self.walk() if node.name == name]
+
+    @property
+    def line_number(self) -> int:
+        """
+        The line of the input this node starts on, counting from one.
+        """
+        return self._source.count("\n", 0, self.start) + 1
+
+    @property
+    def column(self) -> int:
+        """
+        The column of the input this node starts at, counting from one.
+        """
+        return self.start - self._source.rfind("\n", 0, self.start)
+
+    def dump(self, indent: str = "") -> str:
+        """
+        This node and the ones below it, one per line, for reading.
+        """
+        # an expression can be named after the characters it matches, newlines
+        # included, and a node still takes one line
+        name = self.name.replace("\r", "\\r").replace("\n", "\\n")
+        head = f"{indent}{name} [{self.start}:{self.end}] {self.text!r}"
+        return "\n".join(
+            [head] + [node.dump(indent + "  ") for node in self._below()]
+        )
+
+    def _below(self) -> list[SourceNode]:
+        """
+        Everything this node holds, the ignored expressions it skipped included,
+        in source order.
+        """
+        return sorted(self.skipped + self.children, key=lambda node: node.start)
+
+    def walk(self) -> typing.Iterator[SourceNode]:
+        """
+        This node and every node below it, in source order.
+        """
+        yield self
+        for node in self._below():
+            yield from node.walk()
+
+    def __repr__(self) -> str:
+        return f"SourceNode({self.name!r}, {self.start}, {self.end})"
+
+
+class _TreeBuilder:
+    """
+    Collects nodes while a parse runs.
+
+    One frame per attempt: an attempt that fails, or one made only to see whether it
+    could match, drops its frame and leaves nothing behind. A memoized attempt does
+    not run again, so the node it built the first time is reused.
+    """
+
+    __slots__ = ("instring", "frames", "starts", "memo")
+
+    def __init__(self, instring: str) -> None:
+        self.instring = instring
+        self.frames: list[list[SourceNode]] = [[]]
+        self.starts: list[int] = []
+        self.memo: dict[tuple[typing.Any, int, bool, int], tuple[typing.Any, int, tuple]] = {}
+
+    def enter(self) -> None:
+        self.frames.append([])
+
+    def abandon(self) -> None:
+        self.frames.pop()
+
+    def keep(self, element, loc: int, mark: int, end: int, call_pre_parse: bool, tokens=None):
+        children = self.frames.pop()
+        # an attempt that really ran reports where its match began; one the parser
+        # answered from its own memo reports nothing, so the first build stands in
+        start = self.starts[-1] if len(self.starts) > mark else -1
+        del self.starts[mark:]
+        # the element itself keys the memo, so a short-lived one cannot have its
+        # identity handed to another element while the tree is being built, and the
+        # end is part of the key, so a growing left recursion cannot be handed the
+        # nodes of a shorter expansion
+        key = (element, loc, call_pre_parse, end)
+        remembered = self.memo.get(key)
+        if start < 0 or (not children and remembered is not None):
+            if remembered is None:
+                start, parts, skipped = loc, (self.instring[loc:end],), ()
+            else:
+                parts, start, skipped = remembered
+        else:
+            # an ignored expression is matched while skipping ahead: before the
+            # match it belongs to the text skipped, and past the end it belongs to
+            # whatever comes next, never to this node
+            skipped = tuple(
+                child
+                for child in children
+                if child.end <= start and child.start < start
+            )
+            inside = [
+                child for child in children if child.start >= start and child.end <= end
+            ]
+            parts = self._cover(inside, start, end)
+            self.memo[key] = (parts, start, skipped)
+        node = SourceNode(
+            self._name(element),
+            start,
+            end,
+            self._cover(skipped, loc, start),
+            parts,
+            self.instring,
+            tokens,
+            skipped,
+        )
+        self.frames[-1].append(node)
+        return node
+
+    def rooted(self, name: str, end: typing.Optional[int] = None) -> SourceNode:
+        if not self.frames[0]:
+            # the whole grammar only looked at the text, so nothing was kept and
+            # there is no match to stand for
+            stop = end if end is not None else 0
+            return SourceNode(name, 0, stop, "", (self.instring[:stop],), self.instring)
+        node = self.frames[0][0]
+        if end is not None and end > node.end:
+            # parse_all also consumes the trailing whitespace, and a lossless tree
+            # has to account for it
+            node = SourceNode(
+                node.name,
+                node.start,
+                end,
+                node._trivia_parts,
+                node._parts + (self.instring[node.end : end],),
+                self.instring,
+                node.tokens,
+                node.skipped,
+            )
+        return node
+
+    def document(self, matches: typing.Sequence[SourceNode]) -> SourceNode:
+        """
+        A node covering the whole text, made of the matches and the text between them.
+        """
+        return SourceNode(
+            "source",
+            0,
+            len(self.instring),
+            "",
+            self._cover(matches, 0, len(self.instring)),
+            self.instring,
+        )
+
+    def taken(self) -> list[SourceNode]:
+        found, self.frames[0] = self.frames[0], []
+        return found
+
+    def _cover(
+        self, children: typing.Sequence[SourceNode], start: int, end: int
+    ) -> tuple[_Part, ...]:
+        parts: list[_Part] = []
+        pos = start
+        for child in children:
+            skipped = child.start - len(child.trivia)
+            if skipped > pos:
+                parts.append(self.instring[pos:skipped])
+            parts.append(child)
+            pos = child.end
+        if pos < end:
+            parts.append(self.instring[pos:end])
+        return tuple(parts)
+
+    @staticmethod
+    def _name(element) -> str:
+        return element.resultsName or element.name
