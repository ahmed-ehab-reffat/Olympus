+#!/bin/sh
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH=/tmp/results.xml
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+NEW_TESTS=tests/test_source_tree_be9b9d.py
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -q --junitxml="$OUTPUT_PATH"
+else
+  python -m pytest tests/ -q --ignore="$NEW_TESTS" --junitxml="$OUTPUT_PATH"
+fi
+EXIT_CODE=$?
+
+exit $EXIT_CODE
