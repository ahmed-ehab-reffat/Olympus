+        self.assertEqual(["aa", "bb"], [node.text for node in root.find_all("w")])
+        self.assertEqual("x", root.find("head").text)
+
+    def test_an_expression_that_only_marks_a_position_gives_an_empty_node(self):
+        root = (pp.StringStart() + pp.Word(pp.alphas)("w")).parse_source("ab")
+        self.assertEqual("ab", root.source())
+        self.assertEqual(0, root.children[0].end)
+        self.assertEqual("", root.children[0].text)
+
+    def test_scanning_an_empty_string_gives_an_empty_result(self):
