+class TestScanRollback(TreeTestCase):
+    def test_a_candidate_that_fails_partway_leaves_nothing_in_a_scan(self):
+        pair = pp.Group(
+            pp.Word(pp.alphas)("key") + pp.Suppress("=") + pp.Word(pp.nums)("value")
+        )
+        text = "aa = xx  bb = 22"
+        root = pair.scan_source(text)
+        self.assertEqual(text, root.source())
+        self.assertEqual(["bb = 22"], [c.text for c in root.children])
+        self.assertEqual(["bb"], [n.text for n in root.find_all("key")])
+        self.assertEqual(["22"], [n.text for n in root.find_all("value")])
+        for node in root.walk():
+            if node is not root:
+                self.assertGreaterEqual(node.start, 9)
+
+    def test_a_match_a_condition_rejects_leaves_nothing_in_a_scan(self):
+        pair = pp.Group(
+            pp.Word(pp.alphas)("key") + pp.Suppress("=") + pp.Word(pp.nums)("value")
+        )
+        guarded = pair.copy().add_condition(lambda t: t[0][1] != "13")
+        text = "a = 13 b = 7"
+        root = guarded.scan_source(text)
+        self.assertEqual(text, root.source())
+        self.assertEqual(["b = 7"], [c.text for c in root.children])
+        self.assertEqual(["7"], [n.text for n in root.find_all("value")])
+        self.assertEqual(["b"], [n.text for n in root.find_all("key")])
+        self.assertEqual(1, len(list(root.walk())) - len(list(root.children[0].walk())))
+
