+    def test_a_parse_action_that_parses_the_same_text_adds_nothing_here(self):
+        other = pp.Word(pp.alphas)("junk")
+        text = "abc 45"
+        seen = []
+
+        def peek(tokens):
+            seen.append(other.parse_string(text)[0])
+            return tokens
+
+        expr = pp.Word(pp.alphas)("w").add_parse_action(peek) + pp.Word(pp.nums)("n")
+        root = expr.parse_source(text)
+        self.assertEqual(["abc"], seen)
+        self.assertEqual(text, root.source())
+        self.assertEqual([], root.find_all("junk"))
+        self.assertEqual(["w", "n"], [node.name for node in root.children])
