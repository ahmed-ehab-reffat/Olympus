+import unittest
+
+import pyparsing as pp
+
+
+class TreeTestCase(unittest.TestCase):
+    def setUp(self):
+        # other suites in this repo leave pyparsing's defaults changed
+        pp.ParserElement.set_default_whitespace_chars(" \n\t\r")
+        pp.ParserElement.disable_memoization()
+
+
+def kv_grammar():
+    return pp.Group(
+        pp.Word(pp.alphas)("key") + pp.Suppress("=") + pp.Word(pp.nums)("value")
+    )
+
+
+def names(nodes):
+    return [node.name for node in nodes]
+
+
+def shape(node):
+    return (node.name, [shape(child) for child in node.children])
+
+
+class TestTreeShape(TreeTestCase):
+    def test_the_root_stands_for_the_whole_expression(self):
+        root = pp.Word(pp.alphas).parse_source("abc")
+        self.assertEqual(0, root.start)
+        self.assertEqual(3, root.end)
+        self.assertEqual("abc", root.text)
+
+    def test_a_sequence_has_a_node_for_each_of_its_parts(self):
+        expr = pp.Word(pp.alphas)("word") + pp.Word(pp.nums)("count")
+        root = pp.Group(expr).parse_source("ab 12")
+        self.assertEqual(["word", "count"], names(root.children[0].children))
+
+    def test_a_node_carries_the_span_of_the_text_it_matched(self):
+        root = kv_grammar().parse_source("a = 1")
+        value = root.find("value")
+        self.assertEqual((4, 5), (value.start, value.end))
+        self.assertEqual("1", value.text)
+
+    def test_a_node_knows_the_expressions_name_when_it_has_no_results_name(self):
+        expr = pp.Word(pp.alphas).set_name("identifier")
+        self.assertEqual("identifier", expr.parse_source("ab").name)
+
+    def test_a_results_name_becomes_the_node_name(self):
+        expr = pp.Word(pp.alphas)("word")
+        self.assertEqual("word", expr.parse_source("ab").name)
+
+    def test_children_come_in_source_order(self):
+        expr = pp.Word(pp.alphas)("a") + pp.Word(pp.nums)("b") + pp.Word(pp.alphas)("c")
+        root = pp.Group(expr).parse_source("x 1 y")
+        starts = [child.start for child in root.find("a").parent.children]
+        self.assertEqual(sorted(starts), starts)
+
+    def test_a_node_points_back_at_the_one_above_it(self):
+        root = kv_grammar().parse_source("a = 1")
+        value = root.find("value")
+        self.assertIsNotNone(value.parent)
+        self.assertIs(root, value.parent.parent)
+        self.assertIsNone(root.parent)
+
+    def test_walk_reaches_every_node_in_source_order(self):
+        root = kv_grammar().parse_source("a = 1")
+        walked = list(root.walk())
+        self.assertIs(root, walked[0])
+        self.assertEqual(
+            sorted(node.start for node in walked), [node.start for node in walked]
+        )
+
+    def test_find_returns_the_first_node_of_a_name(self):
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("word"))
+        root = expr.parse_source("aa bb cc")
+        self.assertEqual("aa", root.find("word").text)
+        self.assertEqual(["aa", "bb", "cc"], [n.text for n in root.find_all("word")])
+
+    def test_a_node_comes_before_the_one_under_it_when_both_start_together(self):
+        inner = pp.Word(pp.alphas)("item")
+        expr = pp.Group(inner + pp.Suppress(","))("item") + pp.Word(pp.nums)("item")
+        root = expr.parse_source("ab, 12")
+        self.assertEqual(
+            [(0, 3), (0, 2), (4, 6)],
+            [(node.start, node.end) for node in root.find_all("item")],
+        )
+        self.assertEqual((0, 3), (root.find("item").start, root.find("item").end))
+        walked = [node for node in root.walk() if node.name == "item"]
+        self.assertEqual(
+            [(node.start, node.end) for node in walked],
+            [(node.start, node.end) for node in root.find_all("item")],
+        )
+
+    def test_find_gives_nothing_for_a_name_that_is_not_there(self):
+        root = pp.Word(pp.alphas).parse_source("ab")
+        self.assertIsNone(root.find("nope"))
+        self.assertEqual([], root.find_all("nope"))
+
+    def test_a_node_reports_the_line_and_column_it_starts_at(self):
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("word"))
+        root = expr.parse_source("ab\n  cd")
+        second = root.find_all("word")[1]
+        self.assertEqual(2, second.line_number)
+        self.assertEqual(3, second.column)
+
+    def test_coordinates_count_an_unexpanded_tab_as_one_character(self):
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("word"))
+        root = expr.parse_source("ab\n\t\tcd")
+        second = root.find_all("word")[1]
+        self.assertEqual(2, second.line_number)
+        self.assertEqual(3, second.column)
+        self.assertEqual(5, second.start)
+
+    def test_dump_shows_one_line_for_each_node_in_walk_order(self):
+        root = kv_grammar().parse_source("a = 1")
+        lines = root.dump().splitlines()
+        walked = list(root.walk())
+        self.assertEqual(len(walked), len(lines))
+        for node, line in zip(walked, lines):
+            self.assertIn(node.name, line)
+            self.assertIn(str(node.start), line)
+            self.assertIn(str(node.end), line)
+
+    def test_dump_still_reports_what_was_parsed_after_a_rewrite(self):
+        root = kv_grammar().parse_source("a = 1")
+        value = root.find("value")
+        spans = [(node.name, node.start, node.end) for node in root.walk()]
+        value.replace("999")
+        root.find("key").insert_before("[")
+        lines = root.dump().splitlines()
+        walked = list(root.walk())
+        self.assertEqual(len(walked), len(lines))
+        self.assertEqual(spans, [(node.name, node.start, node.end) for node in walked])
+        for (name, start, end), line in zip(spans, lines):
+            self.assertIn(name, line)
+            self.assertIn(str(start), line)
+            self.assertIn(str(end), line)
+        self.assertEqual("[a = 999", root.source())
+
+    def test_a_wrapper_expression_has_a_node_of_its_own(self):
+        suppressed = pp.Suppress("(")
+        optional = pp.Opt(pp.Word(pp.nums)("n"))
+        expr = suppressed + pp.Word(pp.alphas)("w") + optional
+        root = expr.parse_source("(ab 12")
+        self.assertEqual(
+            [suppressed.name, "w", optional.name], names(root.children)
+        )
+        self.assertEqual(["'('"], [node.name for node in root.children[0].children])
+        self.assertEqual(["n"], names(root.children[2].children))
+        self.assertEqual("(ab 12", root.source())
+
+    def test_no_node_is_reached_twice_from_the_one_above_it(self):
+        shapes = (
+            (pp.LineStart() + pp.Word(pp.alphas)("w"), "ab"),
+            (pp.StringStart() + pp.Word(pp.alphas)("w"), "ab"),
+            (pp.Empty()("e") + pp.Word(pp.alphas)("w"), "ab"),
+            (pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(pp.python_style_comment),
+             "# c\naa bb"),
+        )
+        for expr, text in shapes:
+            root = expr.parse_source(text)
+            walked = [id(node) for node in root.walk()]
+            self.assertEqual(len(walked), len(set(walked)))
+            for node in root.walk():
+                held = [id(child) for child in node.children]
+                held += [id(skipped) for skipped in node.skipped]
+                self.assertEqual(len(held), len(set(held)))
+
+    def test_a_node_carries_the_tokens_its_expression_produced(self):
+        root = kv_grammar().parse_source("a = 1")
+        self.assertEqual(["a", "1"], root.children[0].tokens.as_list())
+        self.assertEqual(["1"], root.find("value").tokens.as_list())
+
+
+class TestPublicSurface(TreeTestCase):
+    def test_the_node_type_is_exported_by_the_package(self):
+        self.assertTrue(hasattr(pp, "SourceNode"))
+        self.assertIn("SourceNode", pp.__all__)
+
+    def test_both_entry_points_return_that_type(self):
+        expr = pp.Word(pp.alphas)
+        self.assertIsInstance(expr.parse_source("ab"), pp.SourceNode)
+        self.assertIsInstance(expr.scan_source("ab cd"), pp.SourceNode)
+
+
+class TestRoundTrip(TreeTestCase):
+    def test_the_root_gives_back_the_text_the_parse_consumed(self):
+        text = "  a = 1"
+        self.assertEqual(text, kv_grammar().parse_source(text).source())
+
+    def test_text_after_the_match_is_not_part_of_the_tree(self):
+        root = kv_grammar().parse_source("a = 1  and more")
+        self.assertEqual("a = 1", root.source())
+
+    def test_parsing_the_whole_text_accounts_for_the_trailing_whitespace(self):
+        text = "  a = 1  \n"
+        root = kv_grammar().parse_source(text, parse_all=True)
+        self.assertEqual(text, root.source())
+
+    def test_parsing_the_whole_text_accounts_for_a_trailing_ignored_comment(self):
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(pp.python_style_comment)
+        for text in ("ab  # tail\n", "ab # one\n  # two\n  ", "  # lead\nab  # tail"):
+            root = expr.parse_source(text, parse_all=True)
+            self.assertEqual(text, root.source())
+
+    def test_parsing_the_whole_text_keeps_the_ignored_expressions_it_skipped(self):
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(pp.python_style_comment)
+        text = "# lead\nab cd  # tail\n  "
+        root = expr.parse_source(text, parse_all=True)
+        self.assertEqual(text, root.source())
+        lead = [node for node in root.skipped if node.text == "# lead"]
+        self.assertEqual(1, len(lead))
+        self.assertIn("# lead", root.trivia)
+        lead[0].replace("# gone")
+        self.assertEqual("# gone\nab cd  # tail\n  ", root.source())
+        self.assertIn("# gone", root.trivia)
+
+    def test_the_ignored_expressions_come_back_in_source_order(self):
+        note = pp.python_style_comment("note")
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(note)
+        text = "# a\nx # b\ny # c\nz"
+        for root in (expr.parse_source(text), expr.scan_source(text)):
+            spans = [(node.start, node.end) for node in root.find_all("note")]
+            self.assertEqual(spans, sorted(spans))
+            self.assertEqual(spans, sorted(set(spans)))
+            self.assertEqual(spans[0], (root.find("note").start, root.find("note").end))
+
+    def test_an_ignored_expression_is_never_listed_twice(self):
+        note = pp.python_style_comment("note")
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(note)
+        text = "# lead\nab cd  # tail\n  "
+        root = expr.parse_source(text, parse_all=True)
+        self.assertEqual(text, root.source())
+        spans = [(node.start, node.end) for node in root.find_all("note")]
+        self.assertEqual(spans, sorted(set(spans)))
+        for index in range(len(spans)):
+            again = expr.parse_source(text, parse_all=True)
+            again.find_all("note")[index].replace("@@@")
+            self.assertNotEqual(text, again.source())
+            self.assertIn("@@@", again.source())
+
+    def test_the_walk_parse_all_makes_leaves_no_node_behind(self):
+        note = pp.python_style_comment("note")
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(note)
+        text = "ab cd  # tail\n  "
+        root = expr.parse_source(text, parse_all=True)
+        self.assertEqual(text, root.source())
+        self.assertEqual([], list(root.skipped))
+        self.assertEqual([], root.find_all("note"))
+        self.assertEqual([], [n for n in root.walk() if n.text == "# tail"])
+
+    def test_asking_the_same_question_again_leaves_nothing_behind(self):
+        target = pp.Word(pp.alphas)("t")
+
+        def probe(s, l, tokens):
+            for _ in range(3):
+                target.try_parse(s, l)
+            return tokens
+
+        expr = pp.Word(pp.alphas)("w").add_parse_action(probe) + pp.Word(pp.nums)("n")
+        root = expr.parse_source("ab 12")
+        self.assertEqual("ab 12", root.source())
+        self.assertEqual(["w", "n"], [node.name for node in root.children])
+        self.assertEqual([], root.find_all("t"))
+
+    def test_a_left_recursive_grammar_keeps_the_ignored_rules_too(self):
+        pp.ParserElement.disable_memoization()
+        pp.ParserElement.enable_left_recursion()
+        note = pp.python_style_comment("note")
+        expr = pp.Forward()
+        term = pp.Word(pp.nums)("n")
+        expr <<= (expr + pp.Suppress("+") + term) | term
+        expr.ignore(note)
+        text = "1 + 2  # c\n + 3"
+        root = expr.parse_source(text)
+        self.assertEqual(text, root.source())
+        spans = [(node.start, node.end) for node in root.find_all("note")]
+        self.assertEqual(spans, sorted(set(spans)))
+        for node in root.walk():
+            held = [id(c) for c in node.children] + [id(s) for s in node.skipped]
+            self.assertEqual(len(held), len(set(held)))
+
+    def test_scanning_gives_back_the_whole_text(self):
+        text = "# start\na = 1\n\nbb = 22   # end\n"
+        self.assertEqual(text, kv_grammar().scan_source(text).source())
+
+    def test_scanning_gives_back_text_an_ignored_expression_opens(self):
+        pair = pp.Group(
+            pp.Word(pp.alphas)("k") + pp.Suppress("=") + pp.Word(pp.nums)("v")
+        ).ignore(pp.python_style_comment)
+        for text in ("# lead\na = 1\nb = 2\n", "# c\nx = 1", "  # c\n x = 1"):
+            doc = pair.scan_source(text)
+            self.assertEqual(text, doc.source())
+            self.assertEqual("", doc.trivia)
+            self.assertEqual(1, doc.source().count("# "))
+        boxed = pp.Group(
+            pp.Word(pp.alphas)("k") + pp.Suppress("=") + pp.Word(pp.nums)("v")
+        ).ignore(pp.c_style_comment)
+        self.assertEqual("/*a*/ x = 1", boxed.scan_source("/*a*/ x = 1").source())
+
+    def test_scanning_reports_a_node_for_each_match(self):
+        doc = kv_grammar().scan_source("a = 1\nbb = 22\n")
+        self.assertEqual(["a = 1", "bb = 22"], [n.text for n in doc.children])
+        self.assertEqual("source", doc.name)
+
+    def test_a_match_found_by_scanning_carries_the_usual_information(self):
+        text = "# lead\na = 1\nbb = 22\n"
+        doc = kv_grammar().scan_source(text)
+        second = doc.children[1]
+        self.assertEqual((13, 20), (second.start, second.end))
+        self.assertEqual("bb = 22", second.text)
+        self.assertEqual("bb = 22", second.source())
+        self.assertEqual("", second.trivia)
+        self.assertIs(doc, second.parent)
+        self.assertEqual("22", second.find("value").text)
+
+    def test_text_passed_over_by_a_scan_belongs_to_the_source_node(self):
+        text = "  a = 1\n  bb = 22  "
+        doc = kv_grammar().scan_source(text)
+        self.assertEqual(["", ""], [child.trivia for child in doc.children])
+        self.assertEqual(
+            ["a = 1", "bb = 22"], [child.source() for child in doc.children]
+        )
+        self.assertEqual(text, doc.source())
+        doc.children[0].remove()
+        doc.children[1].remove()
+        self.assertEqual("  \n    ", doc.source())
+
+    def test_scanning_text_with_no_match_gives_the_text_back_unchanged(self):
+        text = "nothing to see here"
+        doc = pp.Word(pp.nums).scan_source(text)
+        self.assertEqual(text, doc.source())
+        self.assertEqual([], list(doc.children))
+
+    def test_an_expression_that_takes_no_text_gives_an_empty_node(self):
+        root = pp.Empty().parse_source("abc")
+        self.assertEqual((0, 0), (root.start, root.end))
+        self.assertEqual("", root.text)
+        self.assertEqual("", root.source())
+        self.assertEqual([], list(root.children))
+
+    def test_scanning_for_an_expression_that_takes_no_text_still_ends(self):
+        text = "abc"
+        doc = pp.Empty().scan_source(text)
+        self.assertEqual(text, doc.source())
+        self.assertEqual([], list(doc.children))
+
+    def test_scanning_for_a_lookahead_gives_the_whole_text_and_no_nodes(self):
+        text = "a b"
+        doc = pp.FollowedBy(pp.Literal("a")).scan_source(text)
+        self.assertEqual("source", doc.name)
+        self.assertEqual((0, len(text)), (doc.start, doc.end))
+        self.assertEqual(text, doc.source())
+        self.assertEqual([], list(doc.children))
+
+    def test_scanning_for_a_negative_lookahead_gives_the_whole_text_and_no_nodes(self):
+        text = "a b"
+        doc = (~pp.Literal("z")).scan_source(text)
+        self.assertEqual("source", doc.name)
+        self.assertEqual(text, doc.source())
+        self.assertEqual([], list(doc.children))
+
+    def test_scanning_for_a_lookbehind_gives_the_whole_text_and_no_nodes(self):
+        text = "a b"
+        doc = pp.PrecededBy(pp.Literal("a")).scan_source(text)
+        self.assertEqual("source", doc.name)
+        self.assertEqual(text, doc.source())
+        self.assertEqual([], list(doc.children))
+
+    def test_scanning_keeps_the_matches_that_follow_a_lookahead(self):
+        text = "a1 b2"
+        expr = pp.FollowedBy(pp.Word(pp.alphas)) + pp.Word(pp.alphanums)("w")
+        doc = expr.scan_source(text)
+        self.assertEqual(text, doc.source())
+        self.assertEqual(2, len(doc.children))
+        self.assertEqual(
+            [("a1", 0, 2), ("b2", 3, 5)],
+            [(node.text, node.start, node.end) for node in doc.find_all("w")],
+        )
+
+    def test_scanning_for_an_expression_that_only_looks_gives_the_text_back(self):
+        for expr in (
+            pp.FollowedBy(pp.Literal("a")),
+            ~pp.Literal("z"),
+            pp.PrecededBy(pp.Literal("a")),
+        ):
+            root = expr.scan_source("abc")
+            self.assertEqual("source", root.name)
+            self.assertEqual((0, 3), (root.start, root.end))
+            self.assertEqual("abc", root.source())
+            self.assertEqual([], list(root.children))
+
+    def test_a_grammar_anchored_at_the_end_of_the_text_gives_the_text_back(self):
+        for tail in (pp.StringEnd(), pp.string_end, pp.LineEnd()):
+            expr = pp.Word(pp.alphas)("w") + tail
+            root = expr.parse_source("ab")
+            self.assertEqual("ab", root.source())
+            self.assertEqual("ab", root.text)
+            self.assertEqual(["ab"], [node.text for node in root.find_all("w")])
+            self.assertEqual("ab", expr.parse_source("ab", parse_all=True).source())
+            self.assertEqual("ab", expr.scan_source("ab").source())
+
+    def test_a_block_held_together_by_indentation_gives_the_text_back(self):
+        block = pp.IndentedBlock(pp.Word(pp.alphas)("w"))
