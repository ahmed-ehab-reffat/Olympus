+class TestMemoizedParsing(TreeTestCase):
+    def setUp(self):
+        super().setUp()
+        pp.ParserElement.enable_packrat()
+        self.addCleanup(pp.ParserElement.disable_memoization)
+
+    def test_the_tree_is_the_same_with_memoized_parsing(self):
+        expr = pp.OneOrMore(kv_grammar())
+        text = "a = 1\nbb = 22\n"
+        with_memo = expr.parse_source(text)
+        pp.ParserElement.disable_memoization()
+        without = expr.parse_source(text)
+        self.assertEqual(shape(without), shape(with_memo))
+        self.assertEqual(without.source(), with_memo.source())
+
+    def test_memoized_parsing_agrees_on_every_part_of_a_node(self):
+        expr = pp.OneOrMore(kv_grammar()).ignore(pp.python_style_comment)
+        text = "a = 1  # note\nbb = 22\n"
+        with_memo = list(expr.parse_source(text).walk())
+        pp.ParserElement.disable_memoization()
+        without = list(expr.parse_source(text).walk())
+        self.assertEqual(len(without), len(with_memo))
+        for left, right in zip(without, with_memo):
+            self.assertEqual(
+                (left.name, left.start, left.end, left.trivia, left.text),
+                (right.name, right.start, right.end, right.trivia, right.text),
+            )
+            self.assertEqual(
+                [node.text for node in left.skipped],
+                [node.text for node in right.skipped],
+            )
+            self.assertEqual(left.tokens.as_list(), right.tokens.as_list())
+            self.assertEqual(
+                (left.line_number, left.column), (right.line_number, right.column)
+            )
+            self.assertEqual(self.ancestry(left), self.ancestry(right))
+            self.assertEqual(
+                [(c.name, c.start, c.end) for c in left.children],
+                [(c.name, c.start, c.end) for c in right.children],
+            )
+
+    @staticmethod
+    def ancestry(node):
+        names_up = []
+        while node is not None:
+            names_up.append(node.name)
+            node = node.parent
+        return names_up
+
+    def test_a_left_recursive_grammar_gives_the_text_back(self):
+        pp.ParserElement.disable_memoization()
+        pp.ParserElement.enable_left_recursion()
+        total = pp.Forward()
+        total <<= (total + pp.Literal("+") + pp.Word(pp.nums)("n")) | pp.Word(
+            pp.nums
+        )("n")
+        for text in ("7", "1+2", "10+20+30"):
+            root = total.parse_source(text)
+            self.assertEqual(text, root.source())
+            self.assertEqual(
+                total.parse_string(text).as_list(), root.tokens.as_list()
+            )
+            for node in root.walk():
+                self.assertEqual(node.text, text[node.start : node.end])
+
+    def test_a_left_recursive_grammar_agrees_on_every_part_of_a_node(self):
+        pp.ParserElement.disable_memoization()
+        pp.ParserElement.enable_left_recursion()
+        expr = pp.Forward()
+        term = pp.Word(pp.nums)("n")
+        expr <<= (expr + pp.Suppress("+") + term) | term
+        expr.ignore(pp.python_style_comment)
+        text = "1 + 2  # note\n + 3"
+        root = expr.parse_source(text)
+        self.assertEqual(text, root.source())
+        for node in root.walk():
+            self.assertEqual(node.text, text[node.start : node.end])
+            self.assertEqual(
+                node.trivia, text[node.start - len(node.trivia) : node.start]
+            )
+            for child in node.children:
+                self.assertIs(node, child.parent)
+            for skipped in node.skipped:
+                self.assertIs(node, skipped.parent)
+            self.assertEqual(
+                node.line_number, text.count("\n", 0, node.start) + 1
+            )
+            self.assertEqual(node.column, node.start - text.rfind("\n", 0, node.start))
+        self.assertEqual(["1", "2", "3"], root.tokens.as_list())
+        self.assertEqual(root.source(), root.trivia + root.text)
+
