+class TestNamedIgnoredExpressions(TreeTestCase):
+    def test_an_ignored_expression_is_found_from_the_node_holding_it(self):
+        note = pp.python_style_comment("note")
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(note)
+        root = expr.parse_source("# one\naa  # two\nbb")
+        self.assertEqual("# one\naa  # two\nbb", root.source())
+        walked = list(root.walk())
+        for node in root.skipped:
+            self.assertIn(node, walked)
+        found = root.find_all("note")
+        self.assertEqual(["# one", "# two"], [node.text for node in found])
+        self.assertEqual("# one", root.find("note").text)
+        self.assertEqual(
+            [(node.start, node.end) for node in found],
+            sorted((node.start, node.end) for node in found),
+        )
+
+    def test_an_ignored_expression_between_two_parts_is_kept_once(self):
+        note = pp.python_style_comment("note")
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("w")).ignore(note)
+        root = expr.parse_source("aa # one\nbb")
+        self.assertEqual("aa # one\nbb", root.source())
+        self.assertEqual(1, root.source().count("# one"))
+        self.assertEqual(["aa", "bb"], [n.text for n in root.find_all("w")])
+        self.assertEqual([], [n.text for n in root.find_all("w") if "#" in n.text])
+
+    def test_an_ignored_expression_in_the_trivia_is_listed_by_the_node_holding_it(self):
+        note = pp.python_style_comment("note")
+        expr = pp.Word(pp.alphas)("w").ignore(note)
+        root = expr.parse_source("# one\nab")
+        self.assertEqual(1, len(root.skipped))
+        inner = root.skipped[0]
+        self.assertEqual("# one", inner.text)
+        self.assertIs(root, inner.parent)
+        self.assertIn("note", [node.name for node in inner.walk()])
+        self.assertEqual("# one\nab", root.source())
+
