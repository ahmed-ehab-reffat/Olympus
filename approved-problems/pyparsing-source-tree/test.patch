+class TestSkippedText(TreeTestCase):
+    def test_a_node_carries_the_whitespace_skipped_before_it(self):
+        root = kv_grammar().parse_source("a  =   1")
+        self.assertEqual("   ", root.find("value").trivia)
+
+    def test_the_root_carries_the_whitespace_at_the_start_of_the_text(self):
+        root = kv_grammar().parse_source("   a = 1")
+        self.assertEqual("   ", root.trivia)
+
+    def test_an_ignored_comment_is_in_the_tree_once(self):
+        expr = pp.OneOrMore(pp.Word(pp.alphas)("word")).ignore(pp.python_style_comment)
+        root = expr.parse_source("aa # note\nbb")
+        self.assertEqual("aa # note\nbb", root.source())
+        self.assertEqual(1, root.source().count("# note"))
