+class TestFailures(TreeTestCase):
+    def test_an_expression_that_cannot_match_raises(self):
+        with self.assertRaises(pp.ParseException):
+            pp.Word(pp.nums).parse_source("ab")
+
+    def test_leftover_text_raises_when_the_whole_text_is_required(self):
+        with self.assertRaises(pp.ParseException):
+            pp.Word(pp.alphas).parse_source("ab 12", parse_all=True)
+
+    def test_a_failed_parse_leaves_nothing_behind_for_the_next_one(self):
+        expr = kv_grammar()
+        for memoized in (False, True):
+            if memoized:
+                pp.ParserElement.enable_packrat()
+            with self.assertRaises(pp.ParseException):
+                expr.parse_source("nothing here")
+            root = expr.parse_source("a = 1")
+            self.assertEqual("a = 1", root.source())
+            self.assertEqual(1, len(root.children))
+            self.assertEqual("", root.trivia)
+        pp.ParserElement.disable_memoization()
+
+    def test_leftover_text_leaves_nothing_behind_for_the_next_parse(self):
+        expr = pp.Word(pp.alphas)("w")
+        for memoize in (False, True):
+            pp.ParserElement.disable_memoization()
+            if memoize:
+                pp.ParserElement.enable_packrat()
+            with self.assertRaises(pp.ParseException):
+                expr.parse_source("ab cd", parse_all=True)
+            root = expr.parse_source("ab")
+            self.assertEqual("ab", root.source())
+            self.assertEqual("w", root.name)
+            self.assertEqual((0, 2), (root.start, root.end))
+            self.assertEqual([], list(root.children))
+            self.assertEqual(["ab"], expr.parse_string("ab").as_list())
+
+    def test_a_parse_action_that_raises_leaves_nothing_behind(self):
+        def refuse_thirteen(toks):
+            if toks[0] == "13":
+                raise pp.ParseException("unlucky")
+            return toks
+
+        value = pp.Word(pp.nums)("value").add_parse_action(refuse_thirteen)
+        expr = pp.Group(pp.Word(pp.alphas)("key") + pp.Suppress("=") + value)
+        for memoized in (False, True):
+            if memoized:
+                pp.ParserElement.enable_packrat()
+            with self.assertRaises(pp.ParseException):
+                expr.parse_source("a = 13")
+            root = expr.parse_source("a = 7")
+            self.assertEqual("a = 7", root.source())
+            self.assertEqual(1, len(root.children))
+            self.assertEqual("7", root.find("value").text)
+        pp.ParserElement.disable_memoization()
+
+    def test_a_condition_that_rejects_a_branch_leaves_nothing_behind(self):
+        counted = pp.Group(pp.Word(pp.alphas)("w") + pp.Word(pp.nums)("n"))
+        counted.add_condition(lambda t: t[0][1] != "13")
+        expr = counted | pp.Word(pp.alphas)("fallback")
+        for memoized in (False, True):
+            if memoized:
+                pp.ParserElement.enable_packrat()
+            root = expr.parse_source("a 13")
+            self.assertEqual("a", root.source())
+            self.assertEqual(["fallback"], names(root.children))
+            self.assertEqual([], root.find_all("w"))
+        pp.ParserElement.disable_memoization()
+
+    def test_a_grammar_that_names_its_parts_while_parsing_still_does(self):
+        expr = pp.OneOrMore(pp.Word(pp.nums))("nums") & pp.Word(pp.alphas)("word")
+        root = expr.parse_source("1 2 abc")
+        self.assertEqual("1 2 abc", root.source())
+        self.assertTrue(root.find_all("nums"))
+        self.assertTrue(root.find_all("word"))
+        self.assertEqual(
+            {"nums": ["1", "2"], "word": "abc"},
+            expr.parse_string("1 2 abc").as_dict(),
+        )
+        self.assertEqual(
+            {"nums": ["1", "2"], "word": "abc"},
+            expr.parse_string("1 2 abc").as_dict(),
+        )
