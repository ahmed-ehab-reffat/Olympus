+fn a_custom_builder_receives_the_vertex_ids_it_returned() {
+    for orientation in ORIENTATIONS {
+        for path in [
+            two_overlapping_squares(),
+            three_overlapping_squares(),
+            squares_sharing_an_edge(),
+            overlap_with_hole(),
+        ] {
+            let mut output = SparseIdBuilder::new(None);
+            let mut tess = FillTessellator::new();
+            tess.tessellate_path(
+                &path,
+                &options(FillRule::NonZero, orientation, true),
+                &mut output,
+            )
+            .unwrap();
+
+            assert!(!output.triangles.is_empty());
+            for (a, b, c) in &output.triangles {
+                for id in [a, b, c] {
+                    assert!(
+                        output.issued.contains(id),
+                        "triangle references {:?} which the builder never returned; issued {:?}",
+                        id,
+                        output.issued
+                    );
+                }
+            }
+
+            let mut referenced: Vec<VertexId> = output
+                .triangles
+                .iter()
+                .flat_map(|(a, b, c)| [*a, *b, *c])
+                .collect();
+            referenced.sort_by_key(|id| id.0);
+            referenced.dedup();
+            let mut issued = output.issued.clone();
+            issued.sort_by_key(|id| id.0);
+            assert_eq!(referenced, issued);
+
+            let (expected_vertices, expected_indices) = eliminated(&path, orientation);
+            assert_eq!(output.issued.len(), expected_vertices.len());
+            assert_eq!(output.triangles.len() * 3, expected_indices.len());
+            assert_eq!(output.positions, expected_vertices);
+        }
+    }
+}
