+fn rectangle(builder: &mut Builder, x0: f32, y0: f32, x1: f32, y1: f32, positive: bool) {
+    let corners = [
+        point(x0, y0),
+        point(x1, y0),
+        point(x1, y1),
+        point(x0, y1),
+    ];
+    let order: [usize; 4] = if positive { [0, 1, 2, 3] } else { [3, 2, 1, 0] };
+    builder.begin(corners[order[0]]);
+    for index in &order[1..] {
+        builder.line_to(corners[*index]);
+    }
+    builder.end(true);
