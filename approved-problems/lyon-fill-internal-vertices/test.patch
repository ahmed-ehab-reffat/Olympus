+fn attributed_overlapping_squares() -> (Path, Vec<(Point, f32)>) {
+    let mut builder = Path::builder_with_attributes(1);
+    let mut endpoints = Vec::new();
+    for (x, y, first) in [(0.0f32, 0.0f32, 10.0f32), (20.0, 20.0, 100.0)] {
+        let corners = [
+            (point(x, y), first),
+            (point(x + 40.0, y), first + 1.0),
+            (point(x + 40.0, y + 40.0), first + 2.0),
+            (point(x, y + 40.0), first + 3.0),
+        ];
+        builder.begin(corners[0].0, &[corners[0].1]);
+        for (p, a) in &corners[1..] {
+            builder.line_to(*p, &[*a]);
+        }
+        builder.end(true);
+        endpoints.extend_from_slice(&corners);
+    }
+    (builder.build(), endpoints)
+}
