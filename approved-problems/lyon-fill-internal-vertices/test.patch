+use lyon_tessellation::geometry_builder::{simple_builder, BuffersBuilder, VertexBuffers};
+use lyon_tessellation::{
+    FillGeometryBuilder, GeometryBuilder, GeometryBuilderError, TessellationError, VertexId,
+};
+use lyon_tessellation::math::{point, Point};
+use lyon_tessellation::path::{path::Builder, FillRule, Path, Winding};
+use lyon_tessellation::{FillOptions, FillTessellator, FillVertex, Orientation};
+
+fn tessellate(path: &Path, options: &FillOptions) -> (Vec<Point>, Vec<u16>) {
+    let mut buffers: VertexBuffers<Point, u16> = VertexBuffers::new();
+    let mut tess = FillTessellator::new();
+    tess.tessellate_path(path, options, &mut simple_builder(&mut buffers))
+        .unwrap();
+    (buffers.vertices, buffers.indices)
+}
+
+fn options(rule: FillRule, orientation: Orientation, eliminate: bool) -> FillOptions {
+    FillOptions::default()
+        .with_fill_rule(rule)
+        .with_sweep_orientation(orientation)
+        .with_interior_vertex_elimination(eliminate)
+}
+
+fn base(path: &Path, orientation: Orientation) -> (Vec<Point>, Vec<u16>) {
+    tessellate(path, &options(FillRule::NonZero, orientation, false))
+}
+
+fn eliminated(path: &Path, orientation: Orientation) -> (Vec<Point>, Vec<u16>) {
+    tessellate(path, &options(FillRule::NonZero, orientation, true))
+}
+
+fn square(builder: &mut Builder, x: f32, y: f32, size: f32, positive: bool) {
+    let corners = [
+        point(x, y),
+        point(x + size, y),
+        point(x + size, y + size),
+        point(x, y + size),
+    ];
+    let order: [usize; 4] = if positive { [0, 1, 2, 3] } else { [3, 2, 1, 0] };
+    builder.begin(corners[order[0]]);
+    for index in &order[1..] {
+        builder.line_to(corners[*index]);
+    }
+    builder.end(true);
+}
+
+fn polygon(points: &[Point]) -> Path {
+    let mut builder = Path::builder();
+    builder.begin(points[0]);
+    for p in &points[1..] {
+        builder.line_to(*p);
+    }
+    builder.end(true);
+    builder.build()
+}
+
+fn two_overlapping_squares() -> Path {
+    let mut builder = Path::builder();
+    square(&mut builder, 0.0, 0.0, 40.0, true);
+    square(&mut builder, 20.0, 20.0, 40.0, true);
+    builder.build()
+}
+
+fn three_overlapping_squares() -> Path {
+    let mut builder = Path::builder();
+    for step in 0..3 {
+        let offset = step as f32 * 15.0;
+        square(&mut builder, offset, offset, 40.0, true);
+    }
+    builder.build()
+}
+
+fn squares_sharing_an_edge() -> Path {
