+struct SparseIdBuilder {
+    issued: Vec<VertexId>,
+    positions: Vec<Point>,
+    triangles: Vec<(VertexId, VertexId, VertexId)>,
+    fail_after: Option<usize>,
+    aborted: bool,
+}
+
+impl SparseIdBuilder {
+    fn new(fail_after: Option<usize>) -> Self {
+        SparseIdBuilder {
+            issued: Vec::new(),
+            positions: Vec::new(),
+            triangles: Vec::new(),
+            fail_after,
+            aborted: false,
+        }
+    }
+}
+
+impl GeometryBuilder for SparseIdBuilder {
+    fn begin_geometry(&mut self) {
+        self.issued.clear();
+        self.positions.clear();
+        self.triangles.clear();
+        self.aborted = false;
+    }
+
+    fn add_triangle(&mut self, a: VertexId, b: VertexId, c: VertexId) {
+        self.triangles.push((a, b, c));
+    }
+
+    fn abort_geometry(&mut self) {
+        self.aborted = true;
+    }
+}
+
+impl FillGeometryBuilder for SparseIdBuilder {
+    fn add_fill_vertex(&mut self, vertex: FillVertex) -> Result<VertexId, GeometryBuilderError> {
+        if let Some(limit) = self.fail_after {
+            if self.issued.len() >= limit {
+                return Err(GeometryBuilderError::TooManyVertices);
+            }
+        }
+        let id = VertexId(1000 + self.issued.len() as u32 * 7);
+        self.issued.push(id);
+        self.positions.push(vertex.position());
+
+        Ok(id)
+    }
+}
