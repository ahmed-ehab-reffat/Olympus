+        assert!(straight_run_vertex_count(&before, &before_indices) > 0);
+        assert_fully_simplified(&path, orientation);
+        assert_region_preserved(&path, orientation);
+    }
+}
+
+fn windmill_of_rotated_rectangles() -> Path {
+    let mut builder = Path::builder();
+    for step in 0..4 {
+        let angle = core::f32::consts::PI * (step as f32) / 4.0 + 0.3;
+        let (c, s) = (angle.cos(), angle.sin());
+        let corners: Vec<Point> = [(-25.0f32, -8.0f32), (25.0, -8.0), (25.0, 8.0), (-25.0, 8.0)]
+            .iter()
+            .map(|(x, y)| point(50.0 + x * c - y * s, 50.0 + x * s + y * c))
+            .collect();
+        builder.begin(corners[0]);
+        for p in &corners[1..] {
+            builder.line_to(*p);
+        }
+        builder.end(true);
+    }
+    builder.build()
+}
+
+fn self_crossing_contours() -> Path {
+    let mut builder = Path::builder();
+    for contour in [
+        vec![
+            point(10.0, 10.0),
+            point(70.0, 30.0),
+            point(10.0, 50.0),
+            point(70.0, 10.0),
+            point(40.0, 60.0),
+        ],
+        vec![
+            point(30.0, 5.0),
+            point(80.0, 45.0),
+            point(20.0, 45.0),
+            point(75.0, 15.0),
+        ],
+        vec![
+            point(15.0, 35.0),
+            point(85.0, 25.0),
+            point(35.0, 65.0),
+            point(55.0, 5.0),
+        ],
+    ] {
+        builder.begin(contour[0]);
+        for p in &contour[1..] {
+            builder.line_to(*p);
+        }
+        builder.end(true);
+    }
+    builder.build()
+}
+
+fn rectangles_meeting_at_a_pinch() -> Path {
+    let mut builder = Path::builder();
+    for (x0, y0, x1, y1) in [
+        (1.0f32, 1.0f32, 5.0f32, 5.0f32),
+        (3.0, -1.0, 7.0, 7.0),
+        (-1.0, 3.0, 7.0, 7.0),
+    ] {
+        builder.begin(point(x0, y0));
+        builder.line_to(point(x1, y0));
+        builder.line_to(point(x1, y1));
+        builder.line_to(point(x0, y1));
+        builder.end(true);
+    }
+    builder.build()
+}
+
+#[test]
+fn rotated_overlaps_leave_no_interior_vertex() {
+    for orientation in ORIENTATIONS {
+        let path = windmill_of_rotated_rectangles();
+        let (before, before_indices) = base(&path, orientation);
+        assert!(interior_vertex_count(&before, &before_indices) > 0);
+        assert_fully_simplified(&path, orientation);
+        assert_region_preserved(&path, orientation);
+    }
+}
+
+#[test]
+fn self_crossing_contours_leave_no_interior_vertex() {
+    for orientation in ORIENTATIONS {
+        let path = self_crossing_contours();
+        let (before, before_indices) = base(&path, orientation);
+        assert!(interior_vertex_count(&before, &before_indices) > 0);
+        assert_fully_simplified(&path, orientation);
+        assert_region_preserved(&path, orientation);
+    }
+}
+
+#[test]
+fn no_emitted_vertex_has_a_fully_filled_neighborhood() {
+    for orientation in ORIENTATIONS {
+        for path in [
+            rectangles_meeting_at_a_pinch(),
+            windmill_of_rotated_rectangles(),
+            self_crossing_contours(),
+            three_overlapping_squares(),
+            three_overlapping_rectangles(),
+            overlap_with_hole_and_extra_subpath(),
+            grid_of_overlapping_circles(),
+        ] {
+            let (before, before_indices) = base(&path, orientation);
+            let (after, after_indices) = eliminated(&path, orientation);
+            let enclosed = vertices_with_a_filled_neighborhood(
+                &before,
+                &before_indices,
+                &after,
+                &after_indices,
+                0.01,
+            );
+            assert!(
+                enclosed.is_empty(),
+                "emitted vertices whose neighborhood is entirely filled: {:?}",
+                enclosed
+            );
+        }
+    }
+}
+
+#[test]
+fn a_degenerate_only_path_emits_no_geometry() {
+    for orientation in ORIENTATIONS {
+        for points in [
+            vec![point(10.0, 10.0), point(30.0, 10.0), point(50.0, 10.0)],
+            vec![point(10.0, 10.0), point(10.0, 10.0), point(10.0, 10.0)],
+        ] {
+            let mut builder = Path::builder();
+            builder.begin(points[0]);
+            for p in &points[1..] {
+                builder.line_to(*p);
+            }
+            builder.end(true);
+            let path = builder.build();
+
+            let (vertices, indices) = eliminated(&path, orientation);
+            assert!(indices.is_empty());
+            assert!(vertices.is_empty());
+        }
+    }
+}
