+fn pentagram() -> Path {
+    let mut points = Vec::new();
+    for step in 0..5 {
+        let angle = core::f32::consts::PI * 2.0 * (step as f32 * 2.0) / 5.0
+            - core::f32::consts::FRAC_PI_2;
+        points.push(point(50.0 + 40.0 * angle.cos(), 50.0 + 40.0 * angle.sin()));
+    }
+    polygon(&points)
+}
+
+fn self_overlapping_outline() -> Path {
+    polygon(&[
+        point(0.0, 0.0),
+        point(100.0, 0.0),
+        point(100.0, 100.0),
+        point(20.0, 100.0),
+        point(20.0, 20.0),
+        point(80.0, 20.0),
+        point(80.0, 80.0),
+        point(0.0, 80.0),
+    ])
+}
+
+fn overlapping_circles() -> Path {
+    let mut builder = Path::builder();
+    for step in 0..6 {
+        let angle = step as f32;
+        builder.add_circle(
+            point(50.0 + 20.0 * angle.cos(), 50.0 + 20.0 * angle.sin()),
+            22.0,
+            Winding::Positive,
+        );
+    }
+    builder.build()
+}
+
+fn cross_product(a: Point, b: Point, c: Point) -> f32 {
+    (b.x - a.x) * (c.y - a.y) - (b.y - a.y) * (c.x - a.x)
+}
+
+fn triangles(indices: &[u16]) -> Vec<[u32; 3]> {
+    indices
+        .chunks_exact(3)
+        .map(|t| [t[0] as u32, t[1] as u32, t[2] as u32])
+        .collect()
+}
+
+fn total_area(vertices: &[Point], indices: &[u16]) -> f32 {
+    triangles(indices)
+        .iter()
+        .map(|t| {
+            cross_product(
+                vertices[t[0] as usize],
+                vertices[t[1] as usize],
+                vertices[t[2] as usize],
+            )
+            .abs()
+                * 0.5
+        })
+        .sum()
+}
+
+fn boundary_edges(indices: &[u16]) -> Vec<(u32, u32)> {
+    let mut directed = Vec::new();
+    for t in triangles(indices) {
+        directed.push((t[0], t[1]));
+        directed.push((t[1], t[2]));
+        directed.push((t[2], t[0]));
+    }
+    directed
+        .iter()
+        .filter(|(a, b)| !directed.contains(&(*b, *a)))
+        .cloned()
+        .collect()
+}
+
+fn interior_vertex_count(vertices: &[Point], indices: &[u16]) -> usize {
+    let mut on_boundary = vec![false; vertices.len()];
+    for (a, b) in boundary_edges(indices) {
+        on_boundary[a as usize] = true;
+        on_boundary[b as usize] = true;
+    }
+    let mut used = vec![false; vertices.len()];
+    for index in indices {
+        used[*index as usize] = true;
+    }
+    (0..vertices.len())
+        .filter(|k| used[*k] && !on_boundary[*k])
+        .count()
+}
+
+fn straight_run_vertex_count(vertices: &[Point], indices: &[u16]) -> usize {
+    let boundary = boundary_edges(indices);
+    let mut count = 0;
+    for k in 0..vertices.len() as u32 {
+        let incoming: Vec<u32> = boundary
+            .iter()
+            .filter(|(_, b)| *b == k)
+            .map(|(a, _)| *a)
+            .collect();
+        let outgoing: Vec<u32> = boundary
+            .iter()
+            .filter(|(a, _)| *a == k)
+            .map(|(_, b)| *b)
+            .collect();
+        if incoming.len() != 1 || outgoing.len() != 1 {
+            continue;
+        }
+        let previous = vertices[incoming[0] as usize];
+        let vertex = vertices[k as usize];
+        let next = vertices[outgoing[0] as usize];
+        if cross_product(previous, vertex, next) != 0.0 {
+            continue;
+        }
+        let along = (vertex.x - previous.x) * (next.x - vertex.x)
+            + (vertex.y - previous.y) * (next.y - vertex.y);
+        if along > 0.0 {
+            count += 1;
+        }
+    }
+    count
+}
+
+fn vertices_with_a_filled_neighborhood(
+    base_vertices: &[Point],
+    base_indices: &[u16],
+    vertices: &[Point],
+    indices: &[u16],
+    radius: f32,
+) -> Vec<Point> {
+    let mut used = vec![false; vertices.len()];
+    for index in indices {
+        used[*index as usize] = true;
+    }
+    let mut enclosed = Vec::new();
+    for k in 0..vertices.len() {
+        if !used[k] {
+            continue;
+        }
+        let p = vertices[k];
+        let mut surrounded = true;
+        for step in 0..16 {
+            let angle = core::f32::consts::PI * 2.0 * (step as f32) / 16.0;
+            let probe = point(p.x + radius * angle.cos(), p.y + radius * angle.sin());
+            if !filled(base_vertices, base_indices, probe) {
+                surrounded = false;
+                break;
+            }
+        }
+        if surrounded {
+            enclosed.push(p);
+        }
+    }
+    enclosed
+}
+
+fn unreferenced_vertex_count(vertices: &[Point], indices: &[u16]) -> usize {
+    let mut used = vec![false; vertices.len()];
+    for index in indices {
+        used[*index as usize] = true;
+    }
+    used.iter().filter(|u| !**u).count()
+}
+
+fn point_in_triangle(p: Point, a: Point, b: Point, c: Point) -> bool {
+    let d1 = cross_product(a, b, p);
+    let d2 = cross_product(b, c, p);
+    let d3 = cross_product(c, a, p);
+    let has_negative = d1 < 0.0 || d2 < 0.0 || d3 < 0.0;
+    let has_positive = d1 > 0.0 || d2 > 0.0 || d3 > 0.0;
+    !(has_negative && has_positive)
+}
+
+fn filled(vertices: &[Point], indices: &[u16], p: Point) -> bool {
+    triangles(indices).iter().any(|t| {
+        point_in_triangle(
+            p,
+            vertices[t[0] as usize],
+            vertices[t[1] as usize],
+            vertices[t[2] as usize],
+        )
+    })
+}
+
+fn winding_signs(vertices: &[Point], indices: &[u16]) -> (usize, usize) {
+    let mut positive = 0;
+    let mut negative = 0;
+    for t in triangles(indices) {
+        let area = cross_product(
+            vertices[t[0] as usize],
+            vertices[t[1] as usize],
+            vertices[t[2] as usize],
+        );
+        if area > 0.0 {
+            positive += 1;
+        } else if area < 0.0 {
+            negative += 1;
+        }
+    }
+    (positive, negative)
+}
+
+fn is_subsequence(short: &[Point], long: &[Point]) -> bool {
+    let mut cursor = 0;
+    for p in short {
+        let mut found = false;
+        while cursor < long.len() {
+            let candidate = long[cursor];
+            cursor += 1;
+            if candidate == *p {
+                found = true;
+                break;
+            }
+        }
+        if !found {
+            return false;
+        }
+    }
+    true
+}
+
+fn assert_region_preserved(path: &Path, orientation: Orientation) {
+    let (base_vertices, base_indices) = base(path, orientation);
+    let (kept_vertices, kept_indices) = eliminated(path, orientation);
+
+    let base_area = total_area(&base_vertices, &base_indices);
+    let kept_area = total_area(&kept_vertices, &kept_indices);
+    assert!(
+        (kept_area - base_area).abs() <= base_area * 1e-4,
+        "area changed from {} to {}",
+        base_area,
+        kept_area
+    );
+
+    for gx in 0..60 {
+        for gy in 0..60 {
+            let probe = point(-12.0 + gx as f32 * 2.7183, -12.0 + gy as f32 * 2.3141);
+            assert_eq!(
+                filled(&base_vertices, &base_indices, probe),
+                filled(&kept_vertices, &kept_indices, probe),
+                "coverage changed at {:?}",
+                probe
+            );
+        }
+    }
+}
+
+fn assert_fully_simplified(path: &Path, orientation: Orientation) {
+    let (vertices, indices) = eliminated(path, orientation);
+    assert_eq!(interior_vertex_count(&vertices, &indices), 0);
+    assert_eq!(straight_run_vertex_count(&vertices, &indices), 0);
+    assert_eq!(unreferenced_vertex_count(&vertices, &indices), 0);
+}
+
+fn assert_matches_outline(path: &Path, outline: &Path, orientation: Orientation) {
+    let (kept_vertices, kept_indices) = eliminated(path, orientation);
+    let (outline_vertices, outline_indices) = base(outline, orientation);
+    assert_eq!(kept_vertices.len(), outline_vertices.len());
+    assert_eq!(kept_indices.len(), outline_indices.len());
+    let kept_area = total_area(&kept_vertices, &kept_indices);
+    let outline_area = total_area(&outline_vertices, &outline_indices);
+    assert!((kept_area - outline_area).abs() <= outline_area * 1e-4);
+}
+
+fn assert_every_vertex_kept(path: &Path, orientation: Orientation) {
+    let (base_vertices, _) = base(path, orientation);
+    let (kept_vertices, kept_indices) = eliminated(path, orientation);
+    assert_eq!(base_vertices, kept_vertices);
+    assert_eq!(interior_vertex_count(&kept_vertices, &kept_indices), 0);
+    assert_eq!(straight_run_vertex_count(&kept_vertices, &kept_indices), 0);
+    assert_eq!(unreferenced_vertex_count(&kept_vertices, &kept_indices), 0);
+    assert_consistent_winding(path, orientation);
+    assert_region_preserved(path, orientation);
+}
+
+fn assert_consistent_winding(path: &Path, orientation: Orientation) {
+    let (base_vertices, base_indices) = base(path, orientation);
+    let (kept_vertices, kept_indices) = eliminated(path, orientation);
+    let (base_positive, base_negative) = winding_signs(&base_vertices, &base_indices);
+    let (kept_positive, kept_negative) = winding_signs(&kept_vertices, &kept_indices);
+    assert_eq!(base_positive > 0, kept_positive > 0);
+    assert_eq!(base_negative > 0, kept_negative > 0);
+    assert!(kept_positive == 0 || kept_negative == 0);
+}
+
+const ORIENTATIONS: [Orientation; 2] = [Orientation::Vertical, Orientation::Horizontal];
