+#[test]
+fn attributes_survive_on_intersection_generated_vertices() {
+    for orientation in ORIENTATIONS {
+        let (path, endpoints) = attributed_overlapping_squares();
+        let before = attributed_vertices(&path, orientation, false);
+        let after = attributed_vertices(&path, orientation, true);
+
+        assert!(after.len() < before.len());
+
+        for (position, attribute) in &after {
+            let expected = before
+                .iter()
+                .find(|(p, _)| p == position)
+                .unwrap_or_else(|| panic!("surviving vertex {:?} absent from the base mesh", position))
+                .1;
+            assert_eq!(*attribute, expected);
+        }
+
+        let generated: Vec<&(Point, f32)> = after
+            .iter()
+            .filter(|(p, _)| !endpoints.iter().any(|(e, _)| e == p))
+            .collect();
+        assert!(
+            !generated.is_empty(),
+            "expected at least one surviving vertex created at an edge intersection"
+        );
+        for (position, attribute) in generated {
+            let expected = before.iter().find(|(p, _)| p == position).unwrap().1;
+            assert_eq!(*attribute, expected);
+        }
+    }
+}
