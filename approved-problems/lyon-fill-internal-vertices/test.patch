+fn attributed_vertices(path: &Path, orientation: Orientation, eliminate: bool) -> Vec<(Point, f32)> {
+    let mut buffers: VertexBuffers<(Point, f32), u16> = VertexBuffers::new();
+    let mut tess = FillTessellator::new();
+    tess.tessellate_path(
+        path,
+        &options(FillRule::NonZero, orientation, eliminate),
+        &mut BuffersBuilder::new(&mut buffers, |mut vertex: FillVertex| {
+            (vertex.position(), vertex.interpolated_attributes()[0])
+        }),
+    )
+    .unwrap();
+    buffers.vertices
+}
