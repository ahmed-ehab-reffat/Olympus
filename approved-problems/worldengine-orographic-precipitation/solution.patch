diff --git a/worldengine/simulations/wind.py b/worldengine/simulations/wind.py
new file mode 100644
index 0000000..a7eeec3
--- /dev/null
+++ b/worldengine/simulations/wind.py
@@ -0,0 +1,36 @@
+import numpy
+
+BAND_DIRECTIONS = (-1, 1, -1)
+BAND_CENTRES = (1, 3, 5)
+
+
+class WindSimulation:
+    @staticmethod
+    def is_applicable(world):
+        return not world.has_wind()
+
+    def execute(self, world, seed):
+        if world.has_wind():
+            return
+        direction, strength = self.prevailing(world)
+        world.wind = (direction, strength)
+
+    @staticmethod
+    def prevailing(world):
+        """Direction (1 eastward, -1 westward) from the row's latitude band and
+        strength in [0, 1], one at the band centre, halved over mountains."""
+        height = world.height
+        width = world.width
+        direction = numpy.zeros((height, width), dtype=int)
+        strength = numpy.zeros((height, width), dtype=float)
+        for y in range(height):
+            equator_distance = abs(2 * y + 1 - height)
+            band = min(equator_distance * 3 // height, 2)
+            direction[y, :] = BAND_DIRECTIONS[band]
+            strength[y, :] = (height - abs(6 * equator_distance - BAND_CENTRES[band] * height)) / height
+        mountains = numpy.logical_and(
+            numpy.logical_not(world.layers["ocean"].data),
+            world.layers["elevation"].data >= world.start_mountain_th(),
+        )
+        strength[mountains] *= 0.5
+        return direction, strength
