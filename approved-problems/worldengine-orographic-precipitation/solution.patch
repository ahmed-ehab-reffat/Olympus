--- /dev/null
+++ b/worldengine/simulations/moisture.py
@@ -0,0 +1,49 @@
+import numpy
+
+from worldengine.simulations.basic import unit_scaled
+
+BASE_RAIN = 0.25
+
+
+def transport_moisture(world):
+    """Rain in [0, 1] dropped on every cell by a parcel travelling along each
+    row in the row's wind direction, wrapping around the world. Warm seas
+    give up more moisture than cold ones."""
+    elevation = world.layers["elevation"].data
+    ocean = world.layers["ocean"].data
+    warmth = unit_scaled(world.layers["temperature"].data)
+    direction = world.wind_direction
+    strength = world.wind_strength
+    span = world.start_mountain_th() - world.sea_level()
+    width = world.width
+    rain = numpy.zeros((world.height, width), dtype=float)
+    for y in range(world.height):
+        d = int(direction[y, 0])
+        order = [(d * step) % width for step in range(width)]
+        uptake = numpy.zeros(width, dtype=float)
+        share = numpy.zeros(width, dtype=float)
+        for x in order:
+            s = float(strength[y, x])
+            if ocean[y, x]:
+                uptake[x] = s * warmth[y, x]
+            else:
+                climb = max(0.0, elevation[y, x] - elevation[y, (x - d) % width]) / span
+                share[x] = s * min(1.0, BASE_RAIN + climb)
+        carried = _steady_moisture(uptake[order], share[order])
+        for x in order:
+            rain[y, x] = carried * share[x]
+            carried += (1.0 - carried) * uptake[x] - carried * share[x]
+    return rain
+
+
+def _steady_moisture(uptake, share):
+    """Moisture entering the first cell of a looped row once further laps no
+    longer change it. One lap maps the entering moisture m to kept * m + gained."""
+    kept = 1.0
+    gained = 0.0
+    for u, s in zip(uptake, share):
+        kept *= (1.0 - u) * (1.0 - s)
+        gained = (gained * (1.0 - u) + u) * (1.0 - s)
+    if kept >= 1.0:
+        return 0.0
+    return min(1.0, gained / (1.0 - kept))
