+def draw_rainfall(world, target):
+    rainfall = world.rainfall
+    for y in range(world.height):
+        for x in range(world.width):
+            value = int(numpy.rint(255 * rainfall[y, x]))
+            target.set_pixel(x, y, (value, value, value, 255))
+
+
+def draw_wind(world, target, black_and_white=False):
+    direction = world.wind_direction
+    strength = world.wind_strength
+    for y in range(world.height):
+        for x in range(world.width):
+            value = int(numpy.rint(255 * strength[y, x]))
+            if black_and_white:
+                target.set_pixel(x, y, (value, value, value, 255))
+            elif direction[y, x] > 0:
+                target.set_pixel(x, y, (value, 0, 0, 255))
+            else:
+                target.set_pixel(x, y, (0, 0, value, 255))
+
+
