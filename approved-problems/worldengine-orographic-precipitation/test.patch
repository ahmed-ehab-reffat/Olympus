+class TestSerialization(unittest.TestCase):
+    def wind_world(self):
+        w = make_world([[OCEAN, LOW, RIDGE, LOW], [LOW, RIDGE, LOW, OCEAN]] * 3)
+        w.wind = (numpy.array([[1, 1, 1, 1], [-1, -1, -1, -1]] * 3), numpy.array([[0.25, 0.5, 0.75, 1.0]] * 6))
