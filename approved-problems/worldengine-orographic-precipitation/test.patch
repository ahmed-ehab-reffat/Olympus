+            (1, 3): -0.7809833432429005,
+            (3, 8): 0.9926089039796335,
+            (4, 1): -0.3912529688243147,
+            (6, 5): -0.6699005431773916,
+            (7, 9): -1.0,
+        }
+        for (y, x), value in expected.items():
