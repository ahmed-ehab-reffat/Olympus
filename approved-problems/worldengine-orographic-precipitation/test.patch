+    def test_protobuf_round_trip_keeps_direction_and_strength(self):
+        w = self.wind_world()
+        back = World.protobuf_unserialize(w.protobuf_serialize())
+        self.assertTrue(back.has_wind())
+        assert_rows(self, back.wind_direction, w.wind_direction)
+        assert_rows(self, back.wind_strength, w.wind_strength)
+        assert_wind_at(self, back, (3, 1), -1, 1.0)
+        self.assertEqual(set(w.layers.keys()), set(back.layers.keys()))
+        self.assertEqual(w.layers["wind"], back.layers["wind"])
+        self.assertTrue(back.has_rainfall())
+        assert_rows(self, back.rainfall, w.rainfall)
+        self.assertEqual(back.rainfall_at((2, 5)), 0.25)
+        self.assertEqual(w, back)
+
+    def test_hdf5_round_trip_keeps_direction_and_strength(self):
+        w = self.wind_world()
+        handle, filename = tempfile.mkstemp(suffix=".world")
+        os.close(handle)
+        try:
+            save_world_to_hdf5(w, filename)
+            back = load_world_to_hdf5(filename)
+        finally:
+            os.remove(filename)
+        self.assertTrue(back.has_wind())
+        assert_rows(self, back.wind_direction, w.wind_direction)
+        assert_rows(self, back.wind_strength, w.wind_strength)
+        self.assertEqual(set(w.layers.keys()), set(back.layers.keys()))
+        self.assertEqual(w.layers["wind"], back.layers["wind"])
+        assert_wind_at(self, back, (0, 0), 1, 0.25)
+        self.assertTrue(back.has_rainfall())
+        assert_rows(self, back.rainfall, w.rainfall)
+        self.assertEqual(w.layers["rainfall"], back.layers["rainfall"])
+
