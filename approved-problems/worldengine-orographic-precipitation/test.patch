+def make_world(rows, name="orographic", seed=7, step=None, warmth=None):
+    height = len(rows)
+    width = len(rows[0])
+    elevation = numpy.full((height, width), LOW, dtype=float)
+    ocean = numpy.zeros((height, width), dtype=bool)
+    for y, row in enumerate(rows):
+        for x, cell in enumerate(row):
+            if cell == OCEAN:
+                ocean[y, x] = True
+            elif isinstance(cell, tuple):
+                ocean[y, x] = True
+                elevation[y, x] = cell[0]
+            else:
+                elevation[y, x] = cell
+    w = World(name, Size(width, height), seed, GenerationParameters(0, SEA, step or Step.full()))
+    w.elevation = (elevation, [("sea", SEA), ("plain", 2.0), ("hill", MOUNTAIN), ("mountain", None)])
+    w.ocean = ocean
+    w.plates = numpy.zeros((height, width), dtype=int)
+    w.sea_depth = numpy.zeros((height, width), dtype=float)
+    if warmth is None:
+        warmth = numpy.where(ocean, 1.0, 0.0)
+        if warmth.min() == warmth.max():
+            warmth[0, 0] = 1.0 - warmth[0, 0]
+    w.temperature = (
+        numpy.asarray(warmth, dtype=float),
+        [
+            ("polar", 0.1),
+            ("alpine", 0.2),
+            ("boreal", 0.3),
+            ("cool", 0.4),
+            ("warm", 0.5),
+            ("subtropical", 0.6),
+            ("tropical", None),
+        ],
+    )
+    return w
+
+
+def band_world(height, width):
+    return make_world([[OCEAN] + [LOW] * (width - 1)] * height)
+
+
+def uniform_wind(world, direction, strength):
+    d = numpy.full((world.height, world.width), direction, dtype=int)
+    s = numpy.full((world.height, world.width), strength, dtype=float)
+    return d, s
+
+
+def east(world, strength=1.0):
+    return uniform_wind(world, 1, strength)
+
+
+def west(world, strength=1.0):
+    return uniform_wind(world, -1, strength)
+
+
+def calm(world):
+    return uniform_wind(world, 1, 0.0)
+
+
+def rescale(field):
+    low = field.min()
+    high = field.max()
+    return ((field - low) / (high - low)) * 2 - 1
+
+
+def rain_for(rows, wind):
+    w = make_world(rows)
+    w.wind = wind(w)
+    return transport_moisture(w)
+
+
+def with_temperature(w, seed=7):
+    TemperatureSimulation().execute(w, seed)
+    return w
+
+
+def assert_rows(test, actual, expected):
+    numpy.testing.assert_allclose(actual, numpy.asarray(expected, dtype=float), rtol=0, atol=1e-9)
+
+
+def assert_wind_at(test, world, pos, direction, strength):
+    actual_direction, actual_strength = world.wind_at(pos)
+    test.assertEqual(actual_direction, direction)
+    test.assertAlmostEqual(actual_strength, strength, places=9)
+
