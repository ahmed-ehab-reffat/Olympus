+#!/bin/bash
+set -uo pipefail
+cd "$(dirname "$0")"
+[ -f .venv/bin/activate ] && source .venv/bin/activate
+
+OUTPUT_PATH=""
+MODE=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+JUNIT_FLAG=""
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT_FLAG="--junitxml=$OUTPUT_PATH"
+fi
+
+case "$MODE" in
+  base)
+    python -m pytest tests --ignore=tests/orographic_0d1f9c_test.py -v -p no:cacheprovider $JUNIT_FLAG
+    ;;
+  new)
+    python -m pytest tests/orographic_0d1f9c_test.py -v -p no:cacheprovider $JUNIT_FLAG
+    ;;
+esac
