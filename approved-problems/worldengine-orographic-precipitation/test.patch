+class TestPrecipitation(unittest.TestCase):
+    def ridge_world(self, seed=7):
+        w = make_world([[OCEAN, LOW, RIDGE, LOW], [LOW, RIDGE, LOW, OCEAN]] * 3, seed=seed)
+        return with_temperature(w, seed)
+
+    def test_base_field_lies_within_the_unit_interval(self):
+        w = self.ridge_world()
+        field = PrecipitationSimulation.base_field(7, w)
+        self.assertEqual(field.shape, (6, 4))
+        self.assertTrue(numpy.all(field >= 0.0))
+        self.assertTrue(numpy.all(field <= 1.0))
+        self.assertGreater(field.max() - field.min(), 0.0)
+
+    def test_base_field_with_one_temperature_everywhere_is_finite_plain_noise(self):
+        w = make_world([[OCEAN, LOW, RIDGE, LOW, LOW, OCEAN]] * 6, warmth=numpy.full((6, 6), 0.3))
+        field = PrecipitationSimulation.base_field(3, w)
+        self.assertTrue(numpy.all(numpy.isfinite(field)))
+        self.assertAlmostEqual(field.min(), 0.0, places=12)
+        self.assertAlmostEqual(field.max(), 1.0, places=12)
+        w.wind = east(w, 0.5)
+        PrecipitationSimulation().execute(w, 3)
+        self.assertTrue(numpy.all(numpy.isfinite(w.rainfall)))
+        self.assertTrue(numpy.all(numpy.isfinite(w.precipitation)))
+
+    def test_one_cell_world_stays_finite(self):
+        for cell in (LOW, OCEAN):
+            w = make_world([[cell]])
+            field = PrecipitationSimulation.base_field(3, w)
+            self.assertTrue(numpy.all(numpy.isfinite(field)))
+            self.assertTrue(numpy.all((field >= 0.0) & (field <= 1.0)))
+            w.wind = east(w)
+            PrecipitationSimulation().execute(w, 3)
+            self.assertTrue(numpy.all(numpy.isfinite(w.precipitation)))
+            self.assertTrue(numpy.all((w.precipitation >= -1.0) & (w.precipitation <= 1.0)))
+            self.assertTrue(numpy.all(numpy.isfinite(w.rainfall)))
+
+    def test_calm_wind_gives_the_precipitation_from_before_winds(self):
