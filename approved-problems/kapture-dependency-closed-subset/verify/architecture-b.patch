+#!/usr/bin/env python3
+# Copyright 2020-present NAVER Corp. Under BSD 3-clause license
+
+import argparse
+
+from kapture.algo.subset import subset_kapture_from_dir
+
+
+def subset_command_line() -> None:
+    parser = argparse.ArgumentParser(description='create a self-contained subset of a kapture dataset')
+    parser.add_argument('-i', '--input', required=True)
+    parser.add_argument('-o', '--output', required=True)
+    parser.add_argument('--start-timestamp', type=int)
+    parser.add_argument('--end-timestamp', type=int)
+    parser.add_argument('--sensor', dest='sensors', action='append')
+    parser.add_argument('--image', dest='images', action='append')
+    parser.add_argument('-f', '-y', '--force', action='store_true')
+    arguments = parser.parse_args()
+    subset_kapture_from_dir(
+        arguments.input, arguments.output,
+        arguments.start_timestamp, arguments.end_timestamp,
+        arguments.sensors, arguments.images, arguments.force,
+    )
+
+
+if __name__ == '__main__':
+    subset_command_line()

