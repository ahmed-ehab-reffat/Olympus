+    def test_directory_materialization_is_transactional(self):
+        self.require_api()
+        with tempfile.TemporaryDirectory() as tempdir:
+            source_path = path.join(tempdir, 'source')
+            fresh_output = path.join(tempdir, 'fresh-output')
+            existing_output = path.join(tempdir, 'existing-output')
+            _write_source(source_path)
+
+            missing_record = get_record_fullpath(source_path, 'lidar/20.bin')
+            os.remove(missing_record)
+            with self.assertRaises(FileNotFoundError):
+                subset_kapture_from_dir(
+                    source_path, fresh_output, 20, 20, image_ids=[IMAGES[1]])
+            self.assertFalse(path.lexists(fresh_output))
+
+            with open(missing_record, 'wb') as payload:
+                payload.write(b'payload:lidar/20.bin')
+            _write_source(existing_output, {(kapture.Keypoints, 'SIFT')})
+            sentinels = {
+                path.join(existing_output, 'keep.me'): b'unrelated-destination-data',
+                get_record_fullpath(existing_output, 'operator/record-note.keep'): b'record-sidecar',
+                path.join(existing_output, 'reconstruction', 'keypoints', 'SIFT',
+                          'operator', 'tar-note.keep'): b'tar-sidecar',
+                path.join(existing_output, 'reconstruction', 'descriptors', 'SIFT',
+                          'operator', 'descriptor-note.keep'): b'descriptor-sidecar',
+                path.join(existing_output, 'reconstruction', 'matches', 'SIFT',
+                          'operator', 'match-note.keep'): b'match-sidecar',
+            }
+            for sentinel_path, contents in sentinels.items():
+                os.makedirs(path.dirname(sentinel_path), exist_ok=True)
+                with open(sentinel_path, 'wb') as sentinel:
+                    sentinel.write(contents)
+            stale_payloads = {
+                get_record_fullpath(existing_output, IMAGES[0]),
+                kapture.io.features.get_features_fullpath(
+                    kapture.Descriptors, 'SIFT', existing_output, IMAGES[0], None),
+                kapture.io.features.get_matches_fullpath(
+                    (IMAGES[0], IMAGES[1]), 'SIFT', existing_output, None),
+                get_feature_tar_fullpath(kapture.Keypoints, 'SIFT', existing_output),
+            }
+            self.assertTrue(all(path.isfile(payload) for payload in stale_payloads))
+            output_hash = _tree_hash(existing_output)
+
+            descriptor_path = kapture.io.features.get_features_fullpath(
+                kapture.Descriptors, 'SIFT', source_path, IMAGES[1], None)
+            os.remove(descriptor_path)
+            os.mkdir(descriptor_path)
+            try:
+                subset_kapture_from_dir(
+                    source_path, existing_output, 20, 20,
+                    image_ids=[IMAGES[1]], force=True)
+            except Exception:
+                pass
+            else:
+                self.fail('a retained payload cannot be copied when its source file is absent')
+            self.assertEqual(output_hash, _tree_hash(existing_output))
+
+            os.rmdir(descriptor_path)
+            os.makedirs(path.dirname(descriptor_path), exist_ok=True)
+            _arrays()[kapture.Descriptors, 'SIFT', IMAGES[1]].tofile(descriptor_path)
+            subset_kapture_from_dir(
+                source_path, existing_output, 20, 20,
+                image_ids=[IMAGES[1]], force=True)
+            for sentinel_path, expected in sentinels.items():
+                with open(sentinel_path, 'rb') as sentinel:
+                    self.assertEqual(expected, sentinel.read(), sentinel_path)
+            for stale_payload in stale_payloads:
+                self.assertFalse(path.lexists(stale_payload), stale_payload)
+            reopened = kapture_from_dir(existing_output)
+            self.assertEqual({(20, 'left')}, set(reopened.records_camera.key_pairs()))
