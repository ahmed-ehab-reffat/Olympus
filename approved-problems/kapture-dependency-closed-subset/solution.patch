+#!/usr/bin/env python3
+# Copyright 2020-present NAVER Corp. Under BSD 3-clause license
+
+"""Command-line entry point for dependency-closed dataset subsetting."""
+
+import argparse
+
+from kapture.algo.subset import subset_kapture_from_dir
+
+
+def subset_command_line() -> None:
+    parser = argparse.ArgumentParser(description='create a self-contained subset of a kapture dataset')
+    parser.add_argument('-i', '--input', required=True, help='input kapture dataset')
+    parser.add_argument('-o', '--output', required=True, help='output kapture dataset')
+    parser.add_argument('--start-timestamp', type=int, help='inclusive lower timestamp bound')
+    parser.add_argument('--end-timestamp', type=int, help='inclusive upper timestamp bound')
+    parser.add_argument('--sensor', dest='sensors', action='append',
+                        help='physical sensor identifier to retain (repeatable)')
+    parser.add_argument('--image', dest='images', action='append',
+                        help='camera image identifier to retain (repeatable)')
+    parser.add_argument('-f', '-y', '--force', action='store_true',
+                        help='replace existing kapture data at the output path')
+    args = parser.parse_args()
+    subset_kapture_from_dir(args.input, args.output, args.start_timestamp,
+                            args.end_timestamp, args.sensors, args.images, args.force)
+
+
+if __name__ == '__main__':
+    subset_command_line()

