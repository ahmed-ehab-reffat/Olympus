+# Copyright 2020-present NAVER Corp. Under BSD 3-clause license
+
+"""Create dependency-closed subsets of kapture datasets."""
+
+import copy
+import os
+import os.path as path
+import shutil
+import tempfile
+from typing import Dict, Iterable, Optional, Set, Tuple, Type
+
+import numpy as np
+
+import kapture
+import kapture.io.features
+from kapture.io.csv import (CSV_FILENAMES, FEATURES_CSV_FILENAMES,
+                            get_all_tar_handlers, get_feature_csv_fullpath,
+                            kapture_from_dir, kapture_to_dir)
+from kapture.io.binary import TransferAction
+from kapture.io.records import get_record_fullpath, import_record_data_from_dir_auto
+from kapture.io.tar import (TarCollection, TarHandler, get_feature_tar_fullpath,
+                            retrieve_tar_handler_from_collection)
+
+
+RECORD_ATTRIBUTES = (
+    'records_camera', 'records_depth', 'records_lidar', 'records_wifi',
+    'records_bluetooth', 'records_gnss', 'records_accelerometer',
+    'records_gyroscope', 'records_magnetic',
+)
+FILE_RECORD_ATTRIBUTES = ('records_camera', 'records_depth', 'records_lidar')
+FEATURE_ATTRIBUTES = {
+    kapture.Keypoints: 'keypoints',
+    kapture.Descriptors: 'descriptors',
+    kapture.GlobalFeatures: 'global_features',
+    kapture.Matches: 'matches',
+}
+
+
+def _tar_handlers_for(data_type: Type, handlers: TarCollection):
+    return {
+        kapture.Keypoints: handlers.keypoints,
+        kapture.Descriptors: handlers.descriptors,
+        kapture.GlobalFeatures: handlers.global_features,
+        kapture.Matches: handlers.matches,
+    }[data_type]
+
+
+def _selected(timestamp: int,
+              sensor_id: str,
+              start_timestamp: Optional[int],
+              end_timestamp: Optional[int],
+              sensor_ids: Optional[Set[str]]) -> bool:
+    return ((start_timestamp is None or timestamp >= start_timestamp)
+            and (end_timestamp is None or timestamp <= end_timestamp)
+            and (sensor_ids is None or sensor_id in sensor_ids))
+
+
+def _filter_records(records,
+                    start_timestamp: Optional[int],
+                    end_timestamp: Optional[int],
+                    sensor_ids: Optional[Set[str]],
+                    allowed_timestamps: Optional[Set[int]] = None,
+                    retained_values: Optional[Set[str]] = None):
+    if records is None:
+        return None
+    result = type(records)()
+    for timestamp, per_sensor in records.items():
+        for sensor_id, value in per_sensor.items():
+            if (_selected(timestamp, sensor_id, start_timestamp, end_timestamp, sensor_ids)
+                    and (allowed_timestamps is None or timestamp in allowed_timestamps)
+                    and (retained_values is None or value in retained_values)):
+                result[timestamp, sensor_id] = copy.deepcopy(value)
+    return result or None
+
+
+def _filter_feature_collection(collection: Optional[Dict], retained_images: Set[str]):
+    if collection is None:
+        return None
+    result = {}
+    for feature_type, features in collection.items():
+        retained = copy.deepcopy(features)
+        retained.intersection_update(retained_images)
+        if retained:
+            result[feature_type] = retained
+    return result or None
+
+
+def subset_kapture(kapture_data: kapture.Kapture,
+                   start_timestamp: Optional[int] = None,
+                   end_timestamp: Optional[int] = None,
+                   sensor_ids: Optional[Iterable[str]] = None,
+                   image_ids: Optional[Iterable[str]] = None) -> kapture.Kapture:
+    """Return an independent dependency-closed in-memory subset.
+
+    Timestamp endpoints are inclusive. ``sensor_ids`` names physical sensors;
+    rig identifiers are retained automatically when a selected sensor belongs
+    to that rig. The input object is never modified.
+    """
+    if start_timestamp is not None and end_timestamp is not None and start_timestamp > end_timestamp:
+        raise ValueError('start_timestamp must not exceed end_timestamp')
+    selected_sensors = (None if sensor_ids is None else
+                        ({sensor_ids} if isinstance(sensor_ids, str) else set(sensor_ids)))
+    selected_images = (None if image_ids is None else
+                       ({image_ids} if isinstance(image_ids, str) else set(image_ids)))
+    available_sensors = set(kapture_data.sensors or {})
+    if selected_sensors is not None:
+        unknown = selected_sensors - available_sensors
+        if unknown:
+            raise ValueError(f'unknown sensor identifiers: {sorted(unknown)}')
+
+    available_images = set(kapture_data.records_camera.data_list()) if kapture_data.records_camera else set()
+    if selected_images is not None:
+        unknown = selected_images - available_images
+        if unknown:
+            raise ValueError(f'unknown image identifiers: {sorted(unknown)}')
+
+    if (start_timestamp is None and end_timestamp is None
+            and selected_sensors is None and selected_images is None):
+        return copy.deepcopy(kapture_data)
+
+    result = kapture.Kapture()
+    result.__version__ = kapture_data.format_version
+
+    retained_sensor_ids: Set[str] = set()
+    retained_timestamps: Set[int] = set()
+    image_timestamps = None
+    if selected_images is not None:
+        image_timestamps = set()
+        if kapture_data.records_camera is not None:
+            for timestamp, per_sensor in kapture_data.records_camera.items():
+                for sensor_id, image_id in per_sensor.items():
+                    if (image_id in selected_images
+                            and _selected(timestamp, sensor_id, start_timestamp,
+                                          end_timestamp, selected_sensors)):
+                        image_timestamps.add(timestamp)
+    for attribute in RECORD_ATTRIBUTES:
+        records = _filter_records(getattr(kapture_data, attribute),
+                                  start_timestamp, end_timestamp, selected_sensors,
+                                  image_timestamps,
+                                  selected_images if attribute == 'records_camera' else None)
+        setattr(result, attribute, records)
+        if records is not None:
+            retained_sensor_ids.update(records.sensors_ids)
+            retained_timestamps.update(records.keys())
+
+    if kapture_data.sensors is not None:
+        result.sensors = kapture.Sensors({
+            sensor_id: copy.deepcopy(kapture_data.sensors[sensor_id])
+            for sensor_id in kapture_data.sensors
+            if sensor_id in retained_sensor_ids
+        })
+
+    retained_rig_ids: Set[str] = set()
+    if kapture_data.rigs is not None:
+        required_nodes = set(retained_sensor_ids)
+        changed = True
+        while changed:
+            changed = False
+            for rig_id, rig in kapture_data.rigs.items():
+                if rig_id not in required_nodes and any(member_id in required_nodes for member_id in rig):
+                    required_nodes.add(rig_id)
+                    retained_rig_ids.add(rig_id)
+                    changed = True
+        rigs = kapture.Rigs()
+        for rig_id, rig in kapture_data.rigs.items():
+            if rig_id not in retained_rig_ids:
+                continue
+            for member_id, pose in rig.items():
+                if member_id in required_nodes:
+                    rigs[rig_id, member_id] = copy.deepcopy(pose)
+        result.rigs = rigs or None
+
+    if kapture_data.trajectories is not None:
+        trajectory_ids = retained_sensor_ids | retained_rig_ids
+        trajectories = kapture.Trajectories()
+        for timestamp, sensor_or_rig_id, pose in kapture.flatten(kapture_data.trajectories):
+            if timestamp in retained_timestamps and sensor_or_rig_id in trajectory_ids:
+                trajectories[timestamp, sensor_or_rig_id] = copy.deepcopy(pose)
+        result.trajectories = trajectories or None
+
+    retained_images = set(result.records_camera.data_list()) if result.records_camera is not None else set()
+    result.keypoints = _filter_feature_collection(kapture_data.keypoints, retained_images)
+    result.descriptors = _filter_feature_collection(kapture_data.descriptors, retained_images)
+    result.global_features = _filter_feature_collection(kapture_data.global_features, retained_images)
+
+    if kapture_data.matches is not None:
+        matches_collection = {}
+        for feature_type, matches in kapture_data.matches.items():
+            retained_matches = kapture.Matches()
+            for image1, image2 in matches:
+                if image1 in retained_images and image2 in retained_images:
+                    retained_matches.add(image1, image2)
+            if retained_matches:
+                matches_collection[feature_type] = retained_matches
+        result.matches = matches_collection or None
+
+    if kapture_data.points3d is not None and kapture_data.observations is not None:
+        kept_observations = []
+        available_keypoints = set(result.keypoints or {})
+        for point_id in range(len(kapture_data.points3d)):
+            per_type = kapture_data.observations.get(point_id, {})
+            filtered = {
+                feature_type: [(image_id, keypoint_id) for image_id, keypoint_id in observations
+                               if image_id in retained_images]
+                for feature_type, observations in per_type.items()
+                if feature_type in available_keypoints
+            }
+            filtered = {feature_type: values for feature_type, values in filtered.items() if values}
+            if filtered:
+                kept_observations.append((point_id, filtered))
+
+        if kept_observations:
+            point_ids = [point_id for point_id, _ in kept_observations]
+            result.points3d = kapture.Points3d(np.array(kapture_data.points3d[point_ids], copy=True))
+            observations = kapture.Observations()
+            for new_point_id, (_, per_type) in enumerate(kept_observations):
+                for feature_type, values in per_type.items():
+                    for image_id, keypoint_id in values:
+                        observations.add(new_point_id, feature_type, image_id, keypoint_id)
+            result.observations = observations
+
+    return result
+
+
+def _copy_record_payloads(source_path: str, output_path: str, result: kapture.Kapture) -> None:
+    filenames = set()
+    for attribute in FILE_RECORD_ATTRIBUTES:
+        records = getattr(result, attribute)
+        if records is not None:
+            filenames.update(records.data_list())
+    if filenames:
+        import_record_data_from_dir_auto(get_record_fullpath(source_path), output_path,
+                                         sorted(filenames), TransferAction.copy)
+
+
+def _output_tar_handler(data_type: Type,
+                        feature_type: str,
+                        output_path: str,
+                        input_handler: Optional[TarHandler]) -> Optional[TarHandler]:
+    if input_handler is None:
+        return None
+    tar_path = get_feature_tar_fullpath(data_type, feature_type, output_path)
+    os.makedirs(path.dirname(tar_path), exist_ok=True)
+    return TarHandler(tar_path, mode='a')
+
+
+def _copy_reconstruction_payloads(source_path: str,
+                                  output_path: str,
+                                  result: kapture.Kapture,
+                                  source_tars: TarCollection) -> None:
+    for data_type, attribute in FEATURE_ATTRIBUTES.items():
+        collection = getattr(result, attribute)
+        if collection is None:
+            continue
+        for feature_type, entries in collection.items():
+            input_handler = retrieve_tar_handler_from_collection(data_type, feature_type, source_tars)
+            output_handler = _output_tar_handler(data_type, feature_type, output_path, input_handler)
+            try:
+                if data_type == kapture.Matches:
+                    for pair in entries:
+                        source_file = kapture.io.features.get_matches_fullpath(
+                            pair, feature_type, source_path, input_handler)
+                        output_file = kapture.io.features.get_matches_fullpath(
+                            pair, feature_type, output_path, output_handler)
+                        values = kapture.io.features.image_matches_from_file(source_file)
+                        kapture.io.features.image_matches_to_file(output_file, values)
+                else:
+                    for image_id in entries:
+                        source_file = kapture.io.features.get_features_fullpath(
+                            data_type, feature_type, source_path, image_id, input_handler)
+                        output_file = kapture.io.features.get_features_fullpath(
+                            data_type, feature_type, output_path, image_id, output_handler)
+                        if input_handler is None:
+                            values = np.fromfile(source_file, dtype=entries.dtype).reshape((-1, entries.dsize))
+                        else:
+                            values = input_handler.get_array_from_tar(source_file[0], entries.dtype, entries.dsize)
+                        if output_handler is None:
+                            os.makedirs(path.dirname(output_file), exist_ok=True)
+                            values.tofile(output_file)
+                        else:
+                            output_handler.add_array_to_tar(output_file[0], values)
+            finally:
+                if output_handler is not None:
+                    output_handler.close()
+
+
+def _existing_managed_files(output_path: str) -> Set[str]:
+    """Return paths owned by the kapture dataset currently at ``output_path``."""
+    managed = {
+        path.normpath(filename)
+        for filename in CSV_FILENAMES.values()
+        if path.lexists(path.join(output_path, filename))
+    }
+
+    with get_all_tar_handlers(output_path) as old_tars:
+        old_data = kapture_from_dir(output_path, tar_handlers=old_tars)
+
+        for attribute in FILE_RECORD_ATTRIBUTES:
+            records = getattr(old_data, attribute)
+            if records is None:
+                continue
+            for filename in records.data_list():
+                payload = get_record_fullpath('', filename)
+                if path.lexists(path.join(output_path, payload)):
+                    managed.add(path.normpath(payload))
+
+        for data_type, attribute in FEATURE_ATTRIBUTES.items():
+            collection = getattr(old_data, attribute) or {}
+            tar_handlers = _tar_handlers_for(data_type, old_tars)
+            feature_types = set(collection) | set(tar_handlers)
+            for feature_type in feature_types:
+                if data_type in FEATURES_CSV_FILENAMES:
+                    config = get_feature_csv_fullpath(data_type, feature_type)
+                    if path.lexists(path.join(output_path, config)):
+                        managed.add(path.normpath(config))
+
+                if feature_type in tar_handlers:
+                    archive = get_feature_tar_fullpath(data_type, feature_type)
+                    if path.lexists(path.join(output_path, archive)):
+                        managed.add(path.normpath(archive))
+                    continue
+
+                entries = collection.get(feature_type)
+                if entries is None:
+                    continue
+                for entry in entries:
+                    if data_type == kapture.Matches:
+                        payload = kapture.io.features.get_matches_fullpath(
+                            entry, feature_type)
+                    else:
+                        payload = kapture.io.features.get_features_fullpath(
+                            data_type, feature_type, image_filename=entry)
+                    if path.lexists(path.join(output_path, payload)):
+                        managed.add(path.normpath(payload))
+
+    return managed
+
+
+def _remove_managed_files(root: str, relative_paths: Iterable[str]) -> None:
+    for relative_path in sorted(relative_paths, key=lambda value: (-value.count(path.sep), value)):
+        target = path.join(root, relative_path)
+        if path.islink(target) or path.isfile(target):
+            os.remove(target)
+        elif path.isdir(target):
+            shutil.rmtree(target)
+
+
+def subset_kapture_from_dir(source_path: str,
+                            output_path: str,
+                            start_timestamp: Optional[int] = None,
+                            end_timestamp: Optional[int] = None,
+                            sensor_ids: Optional[Iterable[str]] = None,
+                            image_ids: Optional[Iterable[str]] = None,
+                            force: bool = False) -> kapture.Kapture:
+    """Create, save, and return a self-contained dataset subset.
+
+    Reconstruction payloads preserve each source feature collection's ordinary
+    directory or tar-backed storage mode.
+    """
+    source_path = path.realpath(path.abspath(source_path))
+    output_path = path.realpath(path.abspath(output_path))
+    if source_path == output_path:
+        raise ValueError('source and output paths must be different')
+    if path.lexists(output_path) and not path.isdir(output_path):
+        raise ValueError('output path must be a directory')
+
+    output_parent = path.dirname(output_path)
+    os.makedirs(output_parent, exist_ok=True)
+    transaction_root = tempfile.mkdtemp(prefix='.kapture-subset-', dir=output_parent)
+    staged_path = path.join(transaction_root, 'staged')
+    candidate_path = path.join(transaction_root, 'candidate')
+    backup_path = path.join(transaction_root, 'backup')
+    output_existed = path.isdir(output_path)
+    try:
+        managed_files = _existing_managed_files(output_path) if output_existed else set()
+        if managed_files and not force:
+            raise ValueError('output already contains kapture data; use force to replace it')
+
+        with get_all_tar_handlers(source_path) as source_tars:
+            source = kapture_from_dir(source_path, tar_handlers=source_tars)
+            result = subset_kapture(source, start_timestamp, end_timestamp,
+                                    sensor_ids, image_ids)
+            kapture_to_dir(staged_path, result)
+            _copy_record_payloads(source_path, staged_path, result)
+            _copy_reconstruction_payloads(source_path, staged_path, result, source_tars)
+
+        if not output_existed:
+            os.replace(staged_path, output_path)
+            return result
+
+        shutil.copytree(output_path, candidate_path, symlinks=True)
+        _remove_managed_files(candidate_path, managed_files)
+        shutil.copytree(staged_path, candidate_path, dirs_exist_ok=True)
+
+        os.replace(output_path, backup_path)
+        try:
+            os.replace(candidate_path, output_path)
+        except Exception:
+            os.replace(backup_path, output_path)
+            raise
+        shutil.rmtree(backup_path, ignore_errors=True)
+        return result
+    finally:
+        shutil.rmtree(transaction_root, ignore_errors=True)
