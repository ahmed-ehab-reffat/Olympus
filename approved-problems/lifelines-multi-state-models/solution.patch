@@ -0,0 +1,425 @@
+# -*- coding: utf-8 -*-
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+from lifelines.fitters import BaseFitter
+from lifelines.fitters.kaplan_meier_fitter import KaplanMeierFitter
+from lifelines.utils import coalesce, inv_normal_cdf, median_survival_times
+from lifelines.utils.multi_state import (
+    check_transitions_frame,
+    hazard_increments,
+    occupants_at,
+    product_integral,
+    risk_and_transition_counts,
+    sojourn_durations,
+    state_space,
+    transition_label,
+    transition_times,
+)
+
+
+class MultiStateFitter(BaseFitter):
+    """
+    Class for fitting the Aalen-Johansen estimate of a multi state model, where subjects move
+    between an arbitrary set of states rather than between alive and dead only.
+
+    The data is given as one row per interval a subject was observed to occupy a state for, so
+    a subject that moved twice and was then censored contributes three rows. Delayed entry,
+    interruptions in observation and returns to a state already visited are all expressed by
+    the intervals themselves.
+
+    Parameters
+    ----------
+    alpha: float, optional (default=0.05)
+        The alpha value associated with the confidence intervals.
+    label: string, optional
+        Provide a new label for the estimate.
+
+    Examples
+    --------
+
+    .. code:: python
+
+        from lifelines import MultiStateFitter
+
+        msf = MultiStateFitter()
+        msf.fit(transitions)
+        msf.state_occupation_
+        msf.transition_matrix(10.0)
+
+    Attributes
+    ----------
+    states_: list
+        every state seen in the data, in increasing order.
+    transitions_: list
+        every ordered pair of states an observed transition moved between, in increasing order.
+    absorbing_states_: list
+        the states that are never left, in increasing order.
+    timeline: ndarray
+        zero followed by the times a transition was observed at.
+    state_occupation_: DataFrame
+        the probability of occupying each state, over the timeline.
+    cumulative_hazard_: DataFrame
+        the cumulative transition hazard of each transition, over the timeline.
+    at_risk_: DataFrame
+        the size of the risk set of each state, over the transition times.
+    transition_counts_: DataFrame
+        the number of observed transitions of each kind, over the transition times.
+    initial_distribution_: Series
+        the probability of occupying each state at time zero.
+    """
+
+    def fit(self, transitions: pd.DataFrame, initial_state=None, timeline=None, label: str = None) -> MultiStateFitter:
+        """
+        Parameters
+        ----------
+        transitions: DataFrame
+            one row per interval a subject was observed to occupy a state for, with columns
+            ``id``, ``start``, ``stop``, ``from_state``, ``to_state`` and ``observed``. The
+            row describes the half open interval ``(start, stop]``; ``observed`` is truthy
+            when the subject moved to ``to_state`` at ``stop`` and falsy when it was right
+            censored there, in which case ``to_state`` is ignored.
+        initial_state: optional
+            the state every subject is taken to occupy at time zero. If not given, the
+            distribution at time zero is the share of subjects whose earliest interval starts
+            in each state.
+        timeline: iterable, optional
+            report the estimates at these times rather than at the transition times.
+        label: string, optional
+            a string to name this fit.
+
+        Returns
+        -------
+        self: MultiStateFitter
+        """
+        df = check_transitions_frame(transitions)
+        self._transitions_frame = df
+        self._label = coalesce(label, self._label, "MS_estimate")
+
+        self.states_, self.transitions_, self.absorbing_states_ = state_space(df)
+        self._labels = [transition_label(origin, target) for origin, target in self.transitions_]
+        self._event_times = transition_times(df)
+        self._timeline = np.concatenate([[0.0], self._event_times])
+        self.timeline = self._requested_timeline(timeline)
+
+        at_risk, counts = risk_and_transition_counts(df, self.states_, self._event_times)
+        self._increments = hazard_increments(at_risk, counts)
+        self._matrices = product_integral(self._increments)
+
+        self.at_risk_ = pd.DataFrame(at_risk, index=self._event_times, columns=self.states_)
+        self.at_risk_.index.name = "timeline"
+        self.transition_counts_ = pd.DataFrame(
+            np.column_stack(
+                [counts[:, self.states_.index(origin), self.states_.index(target)] for origin, target in self.transitions_]
+            )
+            if self.transitions_
+            else np.zeros((self._event_times.shape[0], 0)),
+            index=self._event_times,
+            columns=self._labels,
+        )
+        self.transition_counts_.index.name = "timeline"
+
+        self._build_cumulative_hazard(at_risk, counts)
+        self.initial_distribution_ = self._build_initial_distribution(df, initial_state)
+        self._occupation = np.einsum("j,ijk->ik", self.initial_distribution_.values, self._matrices)
+        self.state_occupation_ = self._report(self._occupation, self.states_)
+        return self
+
+    def _requested_timeline(self, timeline) -> np.ndarray:
+        if timeline is None:
+            return self._timeline
+        requested = np.asarray(timeline, dtype=float)
+        if requested.ndim != 1 or requested.shape[0] == 0:
+            raise ValueError("The timeline must be a non-empty one dimensional sequence.")
+        if not np.isfinite(requested).all():
+            raise ValueError("Every time on the timeline must be finite.")
+        if (requested < 0).any():
+            raise ValueError("Every time on the timeline must be non-negative.")
+        if (np.diff(requested) <= 0).any():
+            raise ValueError("The timeline must be strictly increasing.")
+        return requested
+
+    def _report(self, values: np.ndarray, columns) -> pd.DataFrame:
+        rows = np.searchsorted(self._timeline, self.timeline, side="right") - 1
+        frame = pd.DataFrame(values[rows], index=self.timeline, columns=columns)
+        frame.index.name = "timeline"
+        return frame
+
+    def _build_cumulative_hazard(self, at_risk: np.ndarray, counts: np.ndarray) -> None:
+        hazards, variances = [], []
+        for origin, target in self.transitions_:
+            row, column = self.states_.index(origin), self.states_.index(target)
+            leaving = at_risk[:, row]
+            taken = counts[:, row, column]
+            increments = self._increments[:, row, column]
+            with np.errstate(divide="ignore", invalid="ignore"):
+                terms = np.where(leaving > 0, taken * (leaving - taken) / leaving**3, 0.0)
+            hazards.append(np.concatenate([[0.0], np.cumsum(increments)]))
+            variances.append(np.concatenate([[0.0], np.cumsum(terms)]))
+
+        shape = (self._timeline.shape[0], 0)
+        self.cumulative_hazard_ = self._report(np.column_stack(hazards) if hazards else np.zeros(shape), self._labels)
+        self.variance_ = self._report(np.column_stack(variances) if variances else np.zeros(shape), self._labels)
+        self.confidence_interval_cumulative_hazard_ = self._bounds()
+        self.confidence_interval_ = self.confidence_interval_cumulative_hazard_
+
+    def _bounds(self) -> pd.DataFrame:
+        z = inv_normal_cdf(1 - self.alpha / 2)
+        frame = pd.DataFrame(index=self.timeline)
+        for label in self._labels:
+            hazard = self.cumulative_hazard_[label].values
+            spread = z * np.sqrt(self.variance_[label].values) / np.where(hazard == 0, 1, hazard)
+            frame["%s_lower_%g" % (label, 1 - self.alpha)] = hazard * np.exp(-spread)
+            frame["%s_upper_%g" % (label, 1 - self.alpha)] = hazard * np.exp(spread)
+        frame.index.name = "timeline"
+        return frame
+
+    def _build_initial_distribution(self, df: pd.DataFrame, initial_state) -> pd.Series:
+        distribution = pd.Series(0.0, index=self.states_)
+        if initial_state is not None:
+            if initial_state not in self.states_:
+                raise ValueError("The initial state %s does not appear in the data." % initial_state)
+            distribution.loc[initial_state] = 1.0
+            return distribution
+        first = df.groupby("id", sort=False).head(1)
+        shares = first.groupby("from_state", sort=False)["weights"].sum() / first["weights"].sum()
+        distribution.loc[shares.index] = shares.values
+        return distribution
+
+    def transition_matrix(self, t: float, since: float = 0.0, markov: bool = True) -> pd.DataFrame:
+        """
+        The matrix of transition probabilities over the half open interval ``(since, t]``.
+
+        The entry in row ``j`` and column ``k`` is the probability that a subject occupying
+        ``j`` at ``since`` occupies ``k`` at ``t``.
+
+        Parameters
+        ----------
+        t: float
+            the end of the interval.
+        since: float, optional (default=0.0)
+            the start of the interval.
+        markov: bool, optional (default=True)
+            when False, each row is estimated from the subjects that were occupying that row's
+            state at ``since`` rather than from the whole sample. A row whose state nobody was
+            occupying at ``since`` is all null.
+        """
+        if since < 0:
+            raise ValueError("The since argument must be non-negative.")
+        if t < since:
+            raise ValueError("The t argument must not be smaller than the since argument.")
+        if markov:
+            window = (self._event_times > since) & (self._event_times <= t)
+            matrix = product_integral(self._increments[window])[-1]
+            return pd.DataFrame(matrix, index=self.states_, columns=self.states_)
+        return self._landmark_transition_matrix(t, since)
+
+    def _landmark_transition_matrix(self, t: float, since: float) -> pd.DataFrame:
+        occupants = occupants_at(self._transitions_frame, since)
+        matrix = np.full((len(self.states_), len(self.states_)), np.nan)
+        for row, state in enumerate(self.states_):
+            identifiers = occupants.get(state)
+            if not identifiers:
+                continue
+            subset = self._transitions_frame.loc[self._transitions_frame["id"].isin(set(identifiers))]
+            times = transition_times(subset)
+            times = times[(times > since) & (times <= t)]
+            if times.shape[0] == 0:
+                matrix[row, row] = 1.0
+                matrix[row, [column for column in range(len(self.states_)) if column != row]] = 0.0
+                continue
+            at_risk, counts = risk_and_transition_counts(subset, self.states_, times)
+            matrix[row] = product_integral(hazard_increments(at_risk, counts))[-1][row]
+        return pd.DataFrame(matrix, index=self.states_, columns=self.states_)
+
+    def probability_of_ever_reaching(self, state, from_state=None) -> pd.Series:
+        """
+        The probability that a subject has occupied ``state`` at or before each time on the
+        timeline. A subject that starts in ``state`` has already reached it.
+
+        Parameters
+        ----------
+        state:
+            the state to follow.
+        from_state: optional
+            condition on occupying this state at time zero rather than on the fitted
+            distribution at time zero.
+        """
+        if state not in self.states_:
+            raise ValueError("The state %s does not appear in the data." % state)
+        if from_state is not None and from_state not in self.states_:
+            raise ValueError("The state %s does not appear in the data." % from_state)
+        row = self.states_.index(state)
+        increments = self._increments.copy()
+        increments[:, row, :] = 0.0
+        matrices = product_integral(increments)
+        if from_state is None:
+            start = self.initial_distribution_.values
+        else:
+            start = np.eye(len(self.states_))[self.states_.index(from_state)]
+        reached = np.einsum("j,ijk->ik", start, matrices)[:, row]
+        return self._report(reached[:, np.newaxis], [state])[state]
+
+    def expected_number_of_visits(self, t: float, from_state=None) -> pd.Series:
+        """
+        The expected number of times each state has been entered by time ``t``, counting the
+        state a subject starts in as one visit to it.
+
+        Parameters
+        ----------
+        t: float
+            the end of the window to count over.
+        from_state: optional
+            condition on occupying this state at time zero rather than on the fitted
+            distribution at time zero.
+        """
+        if t < 0:
+            raise ValueError("The t argument must be non-negative.")
+        occupation = self._occupation_path(from_state)
+        visits = occupation[0].astype(float).copy()
+        for index, time in enumerate(self._event_times):
+            if time > t:
+                break
+            entering = occupation[index] @ np.clip(self._increments[index], 0.0, None)
+            visits = visits + entering
+        return pd.Series(visits, index=self.states_)
+
+    def sojourn_survival(self, state) -> pd.Series:
+        """
+        The survival function of the time a single stay in ``state`` lasts, with a stay that
+        did not end in an observed transition treated as right censored.
+
+        Parameters
+        ----------
+        state:
+            the state to measure stays in.
+        """
+        if state not in self.states_:
+            raise ValueError("The state %s does not appear in the data." % state)
+        durations, observed, weights = sojourn_durations(self._transitions_frame, state)
+        if durations.shape[0] == 0:
+            raise ValueError("No subject was ever observed in the state %s." % state)
+        fitter = KaplanMeierFitter().fit(durations, observed, weights=weights, label="sojourn")
+        return fitter.survival_function_["sojourn"]
+
+    def mean_sojourn_time(self, state, t: float) -> float:
+        """
+        The mean length of a single stay in ``state``, counting a stay that runs past ``t`` as
+        lasting exactly ``t``.
+
+        Parameters
+        ----------
+        state:
+            the state to measure stays in.
+        t: float
+            the time to restrict the mean at.
+        """
+        if t < 0:
+            raise ValueError("The t argument must be non-negative.")
+        survival = self.sojourn_survival(state)
+        times = np.concatenate([survival.index.values, [t]])
+        values = survival.values
+        total = 0.0
+        for index in range(values.shape[0]):
+            lower = min(times[index], t)
+            upper = min(times[index + 1], t)
+            total += values[index] * (upper - lower)
+        return total
+
+    def state_occupation_at(self, t: float) -> pd.Series:
+        """
+        The probability of occupying each state at time ``t``, counting every transition
+        observed at ``t`` itself.
+
+        Parameters
+        ----------
+        t: float
+            the time to report the occupation probabilities at.
+        """
+        if t < 0:
+            raise ValueError("The t argument must be non-negative.")
+        row = np.searchsorted(self._timeline, t, side="right") - 1
+        return pd.Series(self._occupation[row], index=self.states_)
+
+    def predict(self, times) -> pd.DataFrame:
+        """
+        The probability of occupying each state at every time in ``times``.
+
+        Parameters
+        ----------
+        times: iterable
+            the times to report the occupation probabilities at.
+        """
+        requested = np.atleast_1d(np.asarray(times, dtype=float))
+        if (requested < 0).any():
+            raise ValueError("Every requested time must be non-negative.")
+        rows = np.searchsorted(self._timeline, requested, side="right") - 1
+        return pd.DataFrame(self._occupation[rows], index=requested, columns=self.states_)
+
+    def expected_length_of_stay(self, t: float, from_state=None, since: float = 0.0) -> pd.Series:
+        """
+        The expected time spent in each state between ``since`` and ``t``.
+
+        Parameters
+        ----------
+        t: float
+            the end of the window to integrate over.
+        from_state: optional
+            condition on occupying this state at time zero rather than on the fitted
+            distribution at time zero.
+        since: float, optional (default=0.0)
+            the start of the window to integrate over.
+        """
+        if since < 0:
+            raise ValueError("The since argument must be non-negative.")
+        if t < since:
+            raise ValueError("The t argument must not be smaller than the since argument.")
+        occupation = self._occupation_path(from_state)
+
+        total = np.zeros(len(self.states_))
+        for index in range(self._timeline.shape[0]):
+            lower = max(self._timeline[index], since)
+            upper = min(self._timeline[index + 1] if index + 1 < self._timeline.shape[0] else t, t)
+            if upper <= lower:
+                continue
+            total = total + occupation[index] * (upper - lower)
+        return pd.Series(total, index=self.states_)
+
+    def _occupation_path(self, from_state) -> np.ndarray:
+        if from_state is None:
+            return self._occupation
+        if from_state not in self.states_:
+            raise ValueError("The state %s does not appear in the data." % from_state)
+        return self._matrices[:, self.states_.index(from_state), :]
+
+    def median_sojourn_time(self, state) -> float:
+        """
+        The median length of a single stay in ``state``, or infinity when fewer than half of
+        the stays were observed to end.
+
+        Parameters
+        ----------
+        state:
+            the state to measure stays in.
+        """
+        return median_survival_times(self.sojourn_survival(state).to_frame())
+
+    @property
+    def summary(self) -> pd.DataFrame:
+        """
+        A DataFrame with one row per observed transition, holding the number of times it was
+        taken and its cumulative hazard at the end of the timeline.
+        """
+        totals = [
+            self._increments[:, self.states_.index(origin), self.states_.index(target)].sum()
+            for origin, target in self.transitions_
+        ]
+        return pd.DataFrame(
+            {
+                "n_transitions": self.transition_counts_.sum(),
+                "cumulative_hazard": pd.Series(totals, index=self._labels),
+            },
+            index=self._labels,
+        )
