@@ -0,0 +1,373 @@
+# -*- coding: utf-8 -*-
+from __future__ import annotations
+
+import numpy as np
+import pandas as pd
+
+
+TRANSITION_COLUMNS = ["id", "start", "stop", "from_state", "to_state", "observed"]
+WEIGHT_COLUMN = "weights"
+
+
+def transition_label(from_state, to_state) -> str:
+    """
+    The canonical name of a transition, used as a column name in the tables produced by
+    :class:`~lifelines.fitters.multi_state_fitter.MultiStateFitter`.
+    """
+    return "%s->%s" % (from_state, to_state)
+
+
+def check_transitions_frame(transitions: pd.DataFrame) -> pd.DataFrame:
+    """
+    Validate a frame of observed state occupancies and return a normalized copy of it.
+
+    The returned frame holds the six required columns and a weight, has ``start`` and ``stop``
+    cast to floats and ``observed`` cast to a boolean, and is sorted by subject and then by
+    ``start``. A frame that carries no ``weights`` column is given a weight of one per row.
+
+    Parameters
+    ----------
+    transitions: DataFrame
+        one row per interval a subject was observed to occupy a state for. Required columns
+        are ``id``, ``start``, ``stop``, ``from_state``, ``to_state`` and ``observed``.
+    """
+    missing = [column for column in TRANSITION_COLUMNS if column not in transitions.columns]
+    if missing:
+        raise ValueError("The transitions DataFrame is missing the column(s): %s." % ", ".join(map(str, missing)))
+
+    columns = list(TRANSITION_COLUMNS)
+    if WEIGHT_COLUMN in transitions.columns:
+        columns.append(WEIGHT_COLUMN)
+    df = transitions.loc[:, columns].copy()
+    if df.shape[0] == 0:
+        raise ValueError("The transitions DataFrame is empty.")
+    if df.isnull().values.any():
+        raise ValueError("The transitions DataFrame contains null values.")
+
+    df["start"] = df["start"].astype(float)
+    df["stop"] = df["stop"].astype(float)
+    df["observed"] = df["observed"].astype(bool)
+    if WEIGHT_COLUMN in df.columns:
+        df[WEIGHT_COLUMN] = df[WEIGHT_COLUMN].astype(float)
+        if (df[WEIGHT_COLUMN] <= 0).any():
+            raise ValueError("Every weight must be strictly positive.")
+    else:
+        df[WEIGHT_COLUMN] = 1.0
+
+    if not np.isfinite(df[["start", "stop"]].values).all():
+        raise ValueError("The start and stop columns must be finite.")
+    if (df["start"] < 0).any():
+        raise ValueError("The start column must be non-negative.")
+    if (df["stop"] <= df["start"]).any():
+        raise ValueError("Every interval must have a stop strictly greater than its start.")
+
+    observed = df.loc[df["observed"]]
+    if (observed["from_state"].values == observed["to_state"].values).any():
+        raise ValueError("An observed transition must enter a different state than the one it leaves.")
+
+    df = df.sort_values(["id", "start"], kind="stable").reset_index(drop=True)
+    _check_for_overlapping_occupancies(df)
+    return df
+
+
+def _check_for_overlapping_occupancies(df: pd.DataFrame) -> None:
+    for subject, rows in df.groupby("id", sort=False):
+        starts = rows["start"].values
+        stops = rows["stop"].values
+        if (starts[1:] < stops[:-1]).any():
+            raise ValueError("Subject %s has overlapping intervals in the transitions DataFrame." % subject)
+
+        origins = rows["from_state"].values
+        targets = rows["to_state"].values
+        observed = rows["observed"].values
+        adjacent = starts[1:] == stops[:-1]
+        broken = adjacent & observed[:-1] & (origins[1:] != targets[:-1])
+        if broken.any():
+            raise ValueError(
+                "Subject %s leaves an interval for one state and picks up immediately in another." % subject
+            )
+
+
+def state_space(df: pd.DataFrame):
+    """
+    Return the sorted states, the sorted observed transitions and the sorted absorbing states
+    of a validated transitions frame.
+    """
+    observed = df.loc[df["observed"]]
+    states = sorted(set(df["from_state"]) | set(observed["to_state"]))
+    transitions = sorted({(origin, target) for origin, target in zip(observed["from_state"], observed["to_state"])})
+    absorbing = sorted(set(states) - set(df["from_state"]))
+    return states, transitions, absorbing
+
+
+def transition_times(df: pd.DataFrame) -> np.ndarray:
+    """
+    The distinct times at which a transition was observed, in increasing order.
+    """
+    return np.unique(df.loc[df["observed"], "stop"].values.astype(float))
+
+
+def risk_and_transition_counts(df: pd.DataFrame, states, times: np.ndarray):
+    """
+    Count, at every transition time, how many subjects are at risk in each state and how many
+    moved along each ordered pair of states.
+
+    A subject is at risk in the state of an interval over the half open interval that the row
+    describes, so an interval ``(start, stop]`` contributes to the risk set at every time
+    strictly after ``start`` and up to and including ``stop``.
+    """
+    position = {state: index for index, state in enumerate(states)}
+    starts = df["start"].values
+    stops = df["stop"].values
+    weights = df[WEIGHT_COLUMN].values
+    origins = np.array([position[state] for state in df["from_state"]], dtype=int)
+
+    occupied = (starts[np.newaxis, :] < times[:, np.newaxis]) & (times[:, np.newaxis] <= stops[np.newaxis, :])
+    at_risk = np.zeros((times.shape[0], len(states)))
+    for index in range(len(states)):
+        at_risk[:, index] = (occupied[:, origins == index] * weights[origins == index]).sum(axis=1)
+
+    counts = np.zeros((times.shape[0], len(states), len(states)))
+    observed = df.loc[df["observed"]]
+    row_of_time = {time: index for index, time in enumerate(times)}
+    for stop, origin, target, weight in zip(
+        observed["stop"], observed["from_state"], observed["to_state"], observed[WEIGHT_COLUMN]
+    ):
+        row = row_of_time.get(float(stop))
+        if row is not None:
+            counts[row, position[origin], position[target]] += weight
+
+    return at_risk, counts
+
+
+def hazard_increments(at_risk: np.ndarray, counts: np.ndarray) -> np.ndarray:
+    """
+    The Nelson-Aalen increments of the transition intensity matrix at every transition time.
+
+    Off the diagonal an entry is the number of observed transitions divided by the size of the
+    risk set of the state being left; a row whose risk set is empty contributes nothing. The
+    diagonal is minus the total of the rest of its row.
+    """
+    denominator = at_risk[:, :, np.newaxis]
+    increments = np.divide(counts, denominator, out=np.zeros_like(counts), where=denominator > 0)
+    leaving = increments.sum(axis=2)
+    diagonal = np.arange(increments.shape[1])
+    increments[:, diagonal, diagonal] = -leaving
+    return increments
+
+
+def product_integral(increments: np.ndarray) -> np.ndarray:
+    """
+    The running matrix product of ``I + dA`` over the increments, in increasing time order,
+    with each new factor applied on the right.
+
+    The returned array has one more entry than ``increments``: the identity, followed by the
+    product accumulated up to and including each increment.
+    """
+    n_states = increments.shape[1]
+    identity = np.eye(n_states)
+    matrices = np.empty((increments.shape[0] + 1, n_states, n_states))
+    running = identity
+    matrices[0] = running
+    for index in range(increments.shape[0]):
+        running = running @ (identity + increments[index])
+        matrices[index + 1] = running
+    return matrices
+
+
+def transitions_from_events(durations, event_observed, initial_state, event_states=None, entry=None) -> pd.DataFrame:
+    """
+    Build a transitions frame from the duration and event arrays the other fitters take.
+
+    Every subject starts in ``initial_state`` and either leaves it once, for the state named by
+    its event code, or is right censored in it. This is the competing risks shape of a multi
+    state model, so the state occupation of the fitted model reproduces the cumulative
+    incidence of each cause.
+
+    Parameters
+    ----------
+    durations: iterable
+        the time each subject was last seen at.
+    event_observed: iterable
+        the event code of each subject, where 0 means the subject was censored.
+    initial_state:
+        the state every subject starts in.
+    event_states: dict, optional
+        maps each non-zero event code to the state it moves the subject into. If not given, the
+        state is the event code itself.
+    entry: iterable, optional
+        the time each subject came under observation. Defaults to zero for everybody.
+    """
+    durations = np.asarray(durations, dtype=float)
+    codes = np.asarray(event_observed)
+    if durations.shape[0] != codes.shape[0]:
+        raise ValueError("durations and event_observed must have the same length.")
+    starts = np.zeros_like(durations) if entry is None else np.asarray(entry, dtype=float)
+    if starts.shape[0] != durations.shape[0]:
+        raise ValueError("entry must have the same length as durations.")
+
+    rows = []
+    for position in range(durations.shape[0]):
+        code = codes[position]
+        moved = bool(code != 0)
+        target = initial_state
+        if moved:
+            target = code if event_states is None else event_states.get(code)
+            if target is None:
+                raise ValueError("The event code %s has no state in event_states." % code)
+        rows.append((position, starts[position], durations[position], initial_state, target, int(moved)))
+    return pd.DataFrame(rows, columns=TRANSITION_COLUMNS)
+
+
+def occupants_at(df: pd.DataFrame, time: float):
+    """
+    Map each state to the identifiers of the subjects occupying it at ``time``.
+
+    A subject occupies the state of the interval that contains ``time`` when the interval is
+    read as closed on the left and open on the right, so a subject that moves at ``time``
+    is counted in the state it moves into.
+    """
+    occupants = {}
+    inside = (df["start"].values <= time) & (time < df["stop"].values)
+    for state, identifier in zip(df.loc[inside, "from_state"], df.loc[inside, "id"]):
+        occupants.setdefault(state, []).append(identifier)
+    return occupants
+
+
+def sojourn_durations(df: pd.DataFrame, state):
+    """
+    The lengths of the stays in ``state``, whether each of them ended in an observed transition
+    and the weight of each of them, in the order the stays appear in the frame.
+    """
+    stays = df.loc[df["from_state"] == state]
+    return (
+        stays["stop"].values - stays["start"].values,
+        stays["observed"].values.astype(int),
+        stays[WEIGHT_COLUMN].values,
+    )
+
+
+def state_matrix_from_transitions(
+    df: pd.DataFrame, initial_state, censoring_col: str = "censoring_time", visit: str = "first"
+) -> pd.DataFrame:
+    """
+    Collapse a transitions frame back into a wide frame holding one row per subject.
+
+    The frame has an ``id`` column, one column per state other than ``initial_state`` holding
+    the first time the subject entered that state, and a column named by ``censoring_col``
+    holding the last time the subject was under observation. Subjects appear in increasing
+    order of identifier and the state columns are in increasing order.
+
+    Parameters
+    ----------
+    df: DataFrame
+        a transitions frame, as accepted by :func:`check_transitions_frame`.
+    initial_state:
+        the state that is dropped from the columns of the result.
+    censoring_col: string, optional (default="censoring_time")
+        the name to give the column holding the last observation time.
+    visit: string, optional (default="first")
+        whether a state a subject entered more than once is reported at the first or at the
+        last of those times.
+    """
+    if visit not in ("first", "last"):
+        raise ValueError("The visit argument must be either first or last.")
+    df = check_transitions_frame(df)
+    states, _, _ = state_space(df)
+    if initial_state not in states:
+        raise ValueError("The initial state %s does not appear in the data." % initial_state)
+    if censoring_col in ("id", initial_state):
+        raise ValueError("The censoring column %s collides with another column of the result." % censoring_col)
+
+    columns = [state for state in states if state != initial_state]
+    entries = {}
+    last_seen = {}
+    for identifier, start, stop, origin, target, observed in zip(
+        df["id"], df["start"], df["stop"], df["from_state"], df["to_state"], df["observed"]
+    ):
+        record = entries.setdefault(identifier, {})
+        keep = visit == "last"
+        if observed and target != initial_state and (keep or target not in record):
+            record[target] = stop
+        if origin != initial_state and (keep or origin not in record):
+            record[origin] = start
+        last_seen[identifier] = max(last_seen.get(identifier, stop), stop)
+
+    rows = []
+    for identifier in sorted(entries):
+        record = entries[identifier]
+        rows.append([identifier] + [record.get(state, np.nan) for state in columns] + [last_seen[identifier]])
+    return pd.DataFrame(rows, columns=["id"] + columns + [censoring_col])
+
+
+def transitions_from_state_matrix(
+    df: pd.DataFrame, id_col: str, censoring_col: str, initial_state, entry_col: str = None
+) -> pd.DataFrame:
+    """
+    Build a transitions frame from a wide frame holding one row per subject.
+
+    Every column other than ``id_col`` and ``censoring_col`` is read as a state, and the value
+    in it is the time the subject entered that state, or null if the subject never did. Each
+    subject starts in ``initial_state`` at time zero, moves through the states it entered in
+    increasing time order, and is right censored in the state it was last seen in at the time
+    in ``censoring_col``.
+
+    Parameters
+    ----------
+    df: DataFrame
+        one row per subject.
+    id_col: string
+        the column holding the subject identifier.
+    censoring_col: string
+        the column holding the time the subject was last under observation.
+    initial_state:
+        the state every subject occupies at time zero.
+    entry_col: string, optional
+        the column holding the time the subject came under observation. Defaults to zero for
+        everybody.
+    """
+    reserved = [id_col, censoring_col] + ([entry_col] if entry_col is not None else [])
+    for column in reserved:
+        if column not in df.columns:
+            raise ValueError("The DataFrame is missing the column %s." % column)
+
+    state_columns = [column for column in df.columns if column not in reserved]
+    if initial_state in state_columns:
+        raise ValueError("The initial state %s must not also be a column of the DataFrame." % initial_state)
+
+    identifiers = df[id_col].tolist()
+    censoring_times = df[censoring_col].tolist()
+    starts = [0.0] * df.shape[0] if entry_col is None else df[entry_col].tolist()
+    entry_times = {column: df[column].tolist() for column in state_columns}
+
+    rows = []
+    for position in range(df.shape[0]):
+        identifier = identifiers[position]
+        censoring_time = float(censoring_times[position])
+        origin_time = float(starts[position])
+        if origin_time < 0:
+            raise ValueError("Subject %s comes under observation at a negative time." % identifier)
+        if censoring_time <= origin_time:
+            raise ValueError("Subject %s is censored before it comes under observation." % identifier)
+
+        entries = sorted(
+            (float(entry_times[column][position]), column)
+            for column in state_columns
+            if pd.notnull(entry_times[column][position])
+        )
+        times = [time for time, _ in entries]
+        if any(time <= origin_time for time in times):
+            raise ValueError("Subject %s enters a state before it comes under observation." % identifier)
+        if any(time > censoring_time for time in times):
+            raise ValueError("Subject %s enters a state after its censoring time." % identifier)
+        if len(set(times)) != len(times):
+            raise ValueError("Subject %s enters two states at the same time." % identifier)
+
+        current_state, current_time = initial_state, origin_time
+        for entry_time, state in entries:
+            rows.append((identifier, current_time, entry_time, current_state, state, 1))
+            current_state, current_time = state, entry_time
+        if censoring_time > current_time:
+            rows.append((identifier, current_time, censoring_time, current_state, current_state, 0))
+
+    return pd.DataFrame(rows, columns=TRANSITION_COLUMNS)
