+def transition_logrank_test(
+    transitions_A, transitions_B, from_state=None, to_state=None, t_0=-1, **kwargs
+) -> StatisticalResult:
+    r"""
+    Compare the intensity of a transition between two groups of subjects moving through a
+    multi state model.
+
+    The null hypothesis is that the groups leave ``from_state`` for ``to_state`` at the same
+    rate. At every time any group was seen taking the transition, the count observed in a group
+    is compared to the count expected from the pooled risk sets, and the standardized total of
+    those differences is referred to a chi squared distribution. When the model has a single
+    transition this is the ordinary log rank test.
+
+    Parameters
+    ----------
+    transitions_A: DataFrame
+        the transitions frame of the first group, as accepted by ``MultiStateFitter.fit``.
+    transitions_B: DataFrame
+        the transitions frame of the second group.
+    from_state: optional
+        the state the transition leaves. If not given, every transition seen in any group is
+        tested and the result holds one row per transition.
+    to_state: optional
+        the state the transition enters, required whenever ``from_state`` is given.
+    t_0: float, optional (default=-1)
+        transitions after this time are ignored. Specify -1 to use all time.
+
+    Returns
+    -------
+    StatisticalResult
+
+    """
+    return _transition_logrank([transitions_A, transitions_B], from_state, to_state, t_0, kwargs)
+
+
+def multivariate_transition_logrank_test(
+    transitions, groups, from_state=None, to_state=None, t_0=-1, **kwargs
+) -> StatisticalResult:
+    r"""
+    Compare the intensity of a transition across any number of groups of subjects moving
+    through a multi state model.
+
+    Parameters
+    ----------
+    transitions: DataFrame
+        one transitions frame holding every group, as accepted by ``MultiStateFitter.fit``.
+    groups: iterable
+        a label per row of ``transitions`` saying which group the row belongs to.
+    from_state: optional
+        the state the transition leaves. If not given, every transition seen in any group is
+        tested and the result holds one row per transition.
+    to_state: optional
+        the state the transition enters, required whenever ``from_state`` is given.
+    t_0: float, optional (default=-1)
+        transitions after this time are ignored. Specify -1 to use all time.
+
+    Returns
+    -------
+    StatisticalResult
+
+    """
+    labels = pd.Series(np.asarray(groups), index=transitions.index)
+    if labels.nunique() < 2:
+        raise ValueError("At least two groups are needed to compare.")
+    frames = [transitions.loc[labels == label] for label in sorted(labels.unique())]
+    return _transition_logrank(frames, from_state, to_state, t_0, kwargs)
+
+
+def _transition_logrank(frames, from_state, to_state, t_0, kwargs) -> StatisticalResult:
+    if (from_state is None) != (to_state is None):
+        raise ValueError("Specify both from_state and to_state, or neither of them.")
+
+    frames = [check_transitions_frame(frame) for frame in frames]
+    spaces = [state_space(frame) for frame in frames]
+    states = sorted(set().union(*[set(space[0]) for space in spaces]))
+    if from_state is None:
+        pairs = sorted(set().union(*[set(space[1]) for space in spaces]))
+    else:
+        pairs = [(from_state, to_state)]
+    if not pairs:
+        raise ValueError("No group has an observed transition to test.")
+
+    degrees_of_freedom = len(frames) - 1
+    statistics, p_values, names = [], [], []
+    for origin, target in pairs:
+        statistic = _transition_logrank_statistic(frames, states, origin, target, t_0)
+        statistics.append(statistic)
+        p_values.append(_chisq_test_p_value(statistic, degrees_of_freedom))
+        names.append(transition_label(origin, target))
+
+    common = dict(t_0=t_0, null_distribution="chi squared", degrees_of_freedom=degrees_of_freedom, **kwargs)
+    if from_state is not None:
+        return StatisticalResult(p_values[0], statistics[0], **common)
+    return StatisticalResult(p_values, statistics, name=names, **common)
+
+
+def _transition_logrank_statistic(frames, states, origin, target, t_0) -> float:
+    if origin not in states or target not in states:
+        raise ValueError("The transition %s does not appear in any group." % transition_label(origin, target))
+
+    taken = np.concatenate(
+        [
+            frame[(frame["observed"]) & (frame["from_state"] == origin) & (frame["to_state"] == target)]["stop"].values
+            for frame in frames
+        ]
+    )
+    times = np.unique(taken)
+    if t_0 > 0:
+        times = times[times <= t_0]
+    if times.shape[0] == 0:
+        return 0.0
+
+    row, column = states.index(origin), states.index(target)
+    at_risk, observed = [], []
+    for frame in frames:
+        risk, counts = risk_and_transition_counts(frame, states, times)
+        at_risk.append(risk[:, row])
+        observed.append(counts[:, row, column])
+    at_risk = np.column_stack(at_risk)
+    observed = np.column_stack(observed)
+
+    total_risk = at_risk.sum(axis=1)
+    total_observed = observed.sum(axis=1)
+    usable = total_risk > 1
+    share = np.divide(at_risk, total_risk[:, np.newaxis], out=np.zeros_like(at_risk), where=total_risk[:, np.newaxis] > 0)
+    deviation = (observed - share * total_observed[:, np.newaxis]).sum(axis=0)
+
+    factor = np.where(usable, total_observed * (total_risk - total_observed) / np.where(usable, total_risk - 1, 1), 0.0)
+    covariance = np.zeros((len(frames), len(frames)))
+    for index in range(times.shape[0]):
+        weights = share[index]
+        covariance += factor[index] * (np.diag(weights) - np.outer(weights, weights))
+
+    reduced = covariance[:-1, :-1]
+    if not np.any(reduced):
+        return 0.0
+    return float(deviation[:-1] @ np.linalg.pinv(reduced) @ deviation[:-1])
