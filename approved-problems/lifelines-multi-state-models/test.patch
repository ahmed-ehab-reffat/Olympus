+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+export MPLBACKEND=Agg
+export HOME="${HOME:-/tmp}"
+export PYTHONDONTWRITEBYTECODE=1
+
+NEW_TESTS="lifelines/tests/test_state_transition_models_2ca149.py"
+FLAKY_TEST="lifelines/tests/test_estimation.py::TestGeneralizedGammaFitter::test_weibull_data_inference"
+
+ARGS=(-q -p no:cacheprovider)
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  ARGS+=(--junitxml="$OUTPUT_PATH")
+fi
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "${ARGS[@]}" "$NEW_TESTS"
+else
+  python -m pytest "${ARGS[@]}" lifelines/tests --ignore="$NEW_TESTS" --deselect "$FLAKY_TEST"
+fi
+EXIT_CODE=$?
+
+if [ -n "$OUTPUT_PATH" ] && [ ! -f "$OUTPUT_PATH" ]; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="1" failures="0" tests="1" time="0">
+<testcase classname="lifelines.tests" name="collection"><error message="collection failed">The test session produced no report.</error></testcase>
+</testsuite></testsuites>
+XMLEOF
+fi
+
+exit $EXIT_CODE
