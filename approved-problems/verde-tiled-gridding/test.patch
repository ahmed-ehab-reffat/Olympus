+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      shift
+      ;;
+  esac
+done
+
+if [ -z "$MODE" ] || [ -z "$OUTPUT_PATH" ]; then
+  echo "usage: test.sh --output_path <path> base|new" >&2
+  exit 2
+fi
+
+cd "$(dirname "$0")"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+export PYTHONDONTWRITEBYTECODE=1
+export MPLBACKEND=agg
+export VERDE_DATA_DIR="${VERDE_DATA_DIR:-$(pwd)/.verde-data}"
+
+NEW_TESTS="verde/tests/test_tiling_38d43d.py"
+
+if [ "$MODE" = "new" ]; then
+  python3 -m pytest "$NEW_TESTS" -v \
+    -p no:cacheprovider \
+    --junitxml="$OUTPUT_PATH"
+else
+  python3 -m pytest verde -v \
+    --ignore="$NEW_TESTS" \
+    -p no:cacheprovider \
+    --junitxml="$OUTPUT_PATH"
+fi
+
+exit $?
