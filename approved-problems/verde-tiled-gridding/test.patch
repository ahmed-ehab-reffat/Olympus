+"""
+Test the tiled gridding and the merging of overlapping grids.
+"""
+import numpy as np
+import numpy.testing as npt
+import pandas as pd
+import pytest
+import xarray as xr
+
+import verde
+
+from ..base import BaseGridder
+from ..coordinates import grid_coordinates, scatter_points
+from ..trend import Trend
+from ..vector import Vector
+
+
+def tiled_scatter(region, size, seed=42):
+    "Random points inside a region"
+    return scatter_points(region, size, random_state=seed)
+
+
+def tiled_linear(coordinates, intercept=3, east_slope=-2, north_slope=0.5):
+    "A field that a degree 1 trend fits exactly"
+    return intercept + east_slope * coordinates[0] + north_slope * coordinates[1]
+
+
+def tiled_quadratic(coordinates):
+    "A field that a degree 1 trend cannot fit exactly"
+    return 1 + coordinates[0] ** 2 - 0.5 * coordinates[1] ** 2 + coordinates[0]
+
+
+def tiled_points(eastings, northings):
+    "Build coordinate arrays out of two sequences"
+    return (np.array(eastings, dtype="float64"), np.array(northings, dtype="float64"))
+
+
+def tiled_grid(west, east, south, north, spacing, value):
+    "A constant grid on the given lattice"
+    easting = np.arange(west, east + 0.5 * spacing, spacing)
+    northing = np.arange(south, north + 0.5 * spacing, spacing)
+    values = np.full((northing.size, easting.size), float(value))
+    return xr.DataArray(
+        values,
+        coords={"northing": northing, "easting": easting},
+        dims=("northing", "easting"),
+        name="scalars",
+    )
+
+
+class TiledRecorder(BaseGridder):
+    "Gridder that records every fit it is given"
+
+    calls = []
+
+    def __init__(self, offset=0):
+        super().__init__()
+        self.offset = offset
+
+    def fit(self, coordinates, data, weights=None):
+        "Record the arrays of this fit and remember the data mean"
+        recorded = [
+            np.ravel(coordinates[0]).copy(),
+            np.ravel(coordinates[1]).copy(),
+            np.ravel(data).copy(),
+            None if weights is None else np.ravel(weights).copy(),
+        ]
+        type(self).calls.append(recorded)
+        self.mean_ = float(np.mean(data)) + self.offset
+        return self
+
+    def predict(self, coordinates):
+        "Return the recorded mean everywhere"
+        shape = np.broadcast(*coordinates[:2]).shape
+        return np.full(shape, self.mean_)
+
+
+def expect_error(function, *args, **kwargs):
+    "Check that the call is refused"
+    with pytest.raises(ValueError):
+        function(*args, **kwargs)
+
+
+def test_tile_regions_single_tile():
+    "A single tile covers the whole region"
+    assert verde.tile_regions((0, 10, -5, 5), shape=(1, 1)) == [[0.0, 10.0, -5.0, 5.0]]
+
+
+def test_tile_regions_two_by_two():
+    "Four tiles of the same size"
+    tiles = verde.tile_regions((0, 10, 0, 10), shape=(2, 2))
+    assert tiles == [
+        [0.0, 5.0, 0.0, 5.0],
+        [5.0, 10.0, 0.0, 5.0],
+        [0.0, 5.0, 5.0, 10.0],
+        [5.0, 10.0, 5.0, 10.0],
+    ]
+
+
+def test_tile_regions_order_is_south_then_west():
+    "Tiles are sorted by their south edge and then by their west edge"
+    tiles = verde.tile_regions((0, 9, 0, 4), shape=(2, 3))
+    souths = [tile[2] for tile in tiles]
+    wests = [tile[0] for tile in tiles]
+    assert souths == [0.0, 0.0, 0.0, 2.0, 2.0, 2.0]
+    assert wests == [0.0, 3.0, 6.0, 0.0, 3.0, 6.0]
+
+
+def test_tile_regions_rectangular_shape():
+    "The shape is given as the number of tiles in north and east"
+    tiles = verde.tile_regions((0, 4, 0, 9), shape=(3, 2))
+    assert len(tiles) == 6
+    assert tiles[0] == [0.0, 2.0, 0.0, 3.0]
+    assert tiles[-1] == [2.0, 4.0, 6.0, 9.0]
+
+
+def test_tile_regions_spacing_exact_division():
+    "A spacing that divides the region exactly"
+    tiles = verde.tile_regions((0, 10, 0, 10), spacing=5)
+    assert len(tiles) == 4
+    assert tiles[0] == [0.0, 5.0, 0.0, 5.0]
+
+
+def test_tile_regions_spacing_rounds_up():
+    "The number of tiles is rounded up so tiles are smaller than the spacing"
+    tiles = verde.tile_regions((0, 10, 0, 10), spacing=6)
+    assert len(tiles) == 4
+    npt.assert_allclose(tiles[0], [0.0, 5.0, 0.0, 5.0])
+
+
+def test_tile_regions_spacing_pair():
+    "Different spacings for north and east"
+    tiles = verde.tile_regions((0, 10, 0, 4), spacing=(2, 5))
+    assert len(tiles) == 4
+    npt.assert_allclose(tiles[0], [0.0, 5.0, 0.0, 2.0])
+    npt.assert_allclose(tiles[-1], [5.0, 10.0, 2.0, 4.0])
+
+
+def test_tile_regions_spacing_larger_than_region():
+    "A spacing larger than the region gives a single tile"
+    assert verde.tile_regions((0, 3, 0, 3), spacing=10) == [[0.0, 3.0, 0.0, 3.0]]
+
+
+def test_tile_regions_adjust_region():
+    "Keeping the spacing grows the region on both sides"
+    tiles = verde.tile_regions((0, 10, 0, 10), spacing=6, adjust="region")
+    npt.assert_allclose(tiles[0], [-1.0, 5.0, -1.0, 5.0])
+    npt.assert_allclose(tiles[-1], [5.0, 11.0, 5.0, 11.0])
+
+
+def test_tile_regions_adjust_spacing_is_the_default():
+    "Adjusting the spacing keeps the region"
+    default = verde.tile_regions((0, 10, 0, 10), spacing=6)
+    adjusted = verde.tile_regions((0, 10, 0, 10), spacing=6, adjust="spacing")
+    assert default == adjusted
+
+
+def test_tile_regions_adjust_ignored_for_shape():
+    "The adjust option has no effect when the shape is given"
+    tiles = verde.tile_regions((0, 10, 0, 10), shape=(2, 2), adjust="region")
+    assert tiles[0] == [0.0, 5.0, 0.0, 5.0]
+
+
+def test_tile_regions_overlap_only_shared_edges():
+    "Only the edge shared with the neighbour is extended"
+    tiles = verde.tile_regions((0, 10, 0, 10), shape=(1, 2), overlap=0.1)
+    npt.assert_allclose(tiles[0], [0.0, 5.5, 0.0, 10.0])
+    npt.assert_allclose(tiles[1], [4.5, 10.0, 0.0, 10.0])
+
+
+def test_tile_regions_overlap_corner_tile():
+    "A corner tile is extended on the two edges that it shares"
+    tiles = verde.tile_regions((0, 10, 0, 10), shape=(2, 2), overlap=0.2)
+    npt.assert_allclose(tiles[0], [0.0, 6.0, 0.0, 6.0])
+    npt.assert_allclose(tiles[3], [4.0, 10.0, 4.0, 10.0])
+
+
+def test_tile_regions_overlap_middle_tile():
+    "A middle tile is extended on both sides of a direction"
+    tiles = verde.tile_regions((0, 9, 0, 3), shape=(1, 3), overlap=0.5)
+    npt.assert_allclose(tiles[1], [1.5, 7.5, 0.0, 3.0])
+
+
+def test_tile_regions_overlap_zero_by_default():
+    "Without an overlap the tiles only touch"
+    tiles = verde.tile_regions((0, 8, 0, 8), shape=(2, 2))
+    assert tiles[0][1] == tiles[1][0]
+
+
+def test_tile_regions_cover_the_region():
+    "The union of the tiles is the given region"
+    region = (-3, 7, 12, 20)
+    tiles = verde.tile_regions(region, shape=(3, 4), overlap=0.3)
+    assert min(tile[0] for tile in tiles) == region[0]
+    assert max(tile[1] for tile in tiles) == region[1]
+    assert min(tile[2] for tile in tiles) == region[2]
+    assert max(tile[3] for tile in tiles) == region[3]
+
+
+def test_tile_regions_shape_and_spacing_error():
+    "Giving both a shape and a spacing is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1), shape=(2, 2), spacing=0.5
+    )
+
+
+def test_tile_regions_no_shape_or_spacing_error():
+    "Giving neither a shape nor a spacing is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1))
+
+
+def test_tile_regions_invalid_adjust_error():
+    "An unknown adjust value is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1), spacing=0.5, adjust="nothing"
+    )
+
+
+def test_tile_regions_negative_overlap_error():
+    "A negative overlap is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1), shape=(1, 1), overlap=-0.1)
+
+
+def test_tile_regions_large_overlap_error():
+    "An overlap of one or more is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1), shape=(1, 2), overlap=1)
+
+
+def test_tile_regions_zero_spacing_error():
+    "A spacing of zero is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1), spacing=0)
+
+
+def test_tile_regions_zero_shape_error():
+    "A shape with no tiles is an error"
+    expect_error(verde.tile_regions, (0, 1, 0, 1), shape=(0, 2))
+
+
+def test_taper_weights_linear_ramp():
+    "Weights ramp up linearly from the tapered edges"
+    coordinates = tiled_points([0, 1, 2, 3, 4, 5], [5, 5, 5, 5, 5, 5])
+    weights = verde.taper_weights(coordinates, [0, 4, 0, 10], margin=2)
+    npt.assert_allclose(weights, [0, 0.5, 1, 0.5, 0, 0])
+
+
+def test_taper_weights_region_suppresses_taper():
+    "Edges on the region boundary keep a weight of one"
+    coordinates = tiled_points([0, 1, 2, 3, 4, 5], [5, 5, 5, 5, 5, 5])
+    weights = verde.taper_weights(
+        coordinates, [0, 4, 0, 10], margin=2, region=[0, 10, 0, 10]
+    )
+    npt.assert_allclose(weights, [1, 1, 1, 0.5, 0, 0])
+
+
+def test_taper_weights_multiply_across_directions():
+    "The weight is the product of the factor of each direction"
+    coordinates = tiled_points([1, 2], [1, 2])
+    weights = verde.taper_weights(coordinates, [0, 10, 0, 10], margin=4)
+    npt.assert_allclose(weights, [0.25 * 0.25, 0.5 * 0.5])
+
+
+def test_taper_weights_zero_margin():
+    "A margin of zero disables the taper"
+    coordinates = tiled_points([0, 2, 4, 5], [5, 5, 5, 5])
+    weights = verde.taper_weights(coordinates, [0, 4, 0, 10], margin=0)
+    npt.assert_allclose(weights, [1, 1, 1, 0])
+
+
+def test_taper_weights_negative_margin():
+    "A negative margin also disables the taper"
+    coordinates = tiled_points([0, 2, 4], [5, 5, 5])
+    weights = verde.taper_weights(coordinates, [0, 4, 0, 10], margin=-3)
+    npt.assert_allclose(weights, [1, 1, 1])
+
+
+def test_taper_weights_margin_pair():
+    "The margin can be different for north and east"
+    coordinates = tiled_points([1], [1])
+    weights = verde.taper_weights(coordinates, [0, 10, 0, 10], margin=(2, 4))
+    npt.assert_allclose(weights, [0.5 * 0.25])
+
+
+def test_taper_weights_outside_the_tile():
+    "Points outside of the tile have zero weight"
+    coordinates = tiled_points([-1, 11, 5], [5, 5, -2])
+    weights = verde.taper_weights(coordinates, [0, 10, 0, 10], margin=1)
+    npt.assert_allclose(weights, [0, 0, 0])
+
+
+def test_taper_weights_keeps_the_shape():
+    "The weights have the same shape as the coordinates"
+    coordinates = grid_coordinates((0, 10, 0, 10), shape=(7, 5))
+    weights = verde.taper_weights(coordinates, [0, 10, 0, 10], margin=2)
+    assert weights.shape == (7, 5)
+
+
+def test_taper_weights_are_bounded():
+    "The weights are never outside of the zero to one range"
+    coordinates = tiled_scatter((-5, 15, -5, 15), 500)
+    weights = verde.taper_weights(coordinates, [0, 10, 0, 10], margin=3)
+    assert weights.min() >= 0
+    assert weights.max() <= 1
+
+
+def test_taper_weights_partition_of_unity():
+    "The weights of a full tiling add up to one everywhere"
+    region = (0, 10, -5, 5)
+    coordinates = tiled_scatter(region, 2000, seed=7)
+    total = np.zeros(coordinates[0].shape)
+    band = (2 * 0.25 * (region[3] - region[2]) / 3, 2 * 0.25 * (region[1] - region[0]) / 4)
+    for tile in verde.tile_regions(region, shape=(3, 4), overlap=0.25):
+        total += verde.taper_weights(coordinates, tile, band, region=region)
+    npt.assert_allclose(total, np.ones_like(total))
+
+
+def test_taper_weights_invalid_tile():
+    "An invalid tile is an error"
+    coordinates = tiled_points([1], [1])
+    expect_error(verde.taper_weights, coordinates, [4, 0, 0, 1], 1)
+
+
+def test_tiled_gridder_recovers_a_linear_field():
+    "Blending exact local fits reproduces the field"
+    coordinates = grid_coordinates((0, 10, -5, 5), spacing=0.25)
+    data = tiled_linear(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(3, 3)).fit(coordinates, data)
+    npt.assert_allclose(gridder.predict(coordinates), data, atol=1e-8)
+
+
+def test_tiled_gridder_recovers_a_linear_field_with_spacing():
+    "Tiles defined by their size also reproduce the field"
+    coordinates = grid_coordinates((0, 10, -5, 5), spacing=0.25)
+    data = tiled_linear(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), spacing=4).fit(coordinates, data)
+    npt.assert_allclose(gridder.predict(coordinates), data, atol=1e-8)
+
+
+def test_tiled_gridder_tiles_are_extended():
+    "The stored tiles are already extended by the overlap"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(1, 2)).fit(
+        coordinates, tiled_linear(coordinates)
+    )
+    npt.assert_allclose(gridder.tiles_[0], [0.0, 6.25, 0.0, 10.0])
+    npt.assert_allclose(gridder.tiles_[1], [3.75, 10.0, 0.0, 10.0])
+
+
+def test_tiled_gridder_blend_of_two_tiles():
+    "The prediction is the tapered average of the two tiles"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(1, 2)).fit(coordinates, data)
+    east, north = coordinates
+    west_tile = np.logical_and(east >= 0, east <= 6.25)
+    east_tile = np.logical_and(east >= 3.75, east <= 10)
+    west_fit = Trend(degree=1).fit(
+        (east[west_tile], north[west_tile]), data[west_tile]
+    )
+    east_fit = Trend(degree=1).fit(
+        (east[east_tile], north[east_tile]), data[east_tile]
+    )
+    point = tiled_points([5.0], [5.0])
+    expected = 0.5 * west_fit.predict(point) + 0.5 * east_fit.predict(point)
+    npt.assert_allclose(gridder.predict(point), expected, atol=1e-8)
+
+
+def test_tiled_gridder_blend_is_not_a_plain_average():
+    "Points away from the middle of the band favour their own tile"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(1, 2)).fit(coordinates, data)
+    east, north = coordinates
+    west_tile = np.logical_and(east >= 0, east <= 6.25)
+    east_tile = np.logical_and(east >= 3.75, east <= 10)
+    west_fit = Trend(degree=1).fit(
+        (east[west_tile], north[west_tile]), data[west_tile]
+    )
+    east_fit = Trend(degree=1).fit(
+        (east[east_tile], north[east_tile]), data[east_tile]
+    )
+    point = tiled_points([4.375], [5.0])
+    weight_west = (6.25 - 4.375) / 2.5
+    weight_east = (4.375 - 3.75) / 2.5
+    expected = (
+        weight_west * west_fit.predict(point) + weight_east * east_fit.predict(point)
+    ) / (weight_west + weight_east)
+    npt.assert_allclose(gridder.predict(point), expected, atol=1e-8)
+
+
+def test_tiled_gridder_no_overlap_uses_a_single_tile():
+    "Without an overlap each point is predicted by its own tile alone"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(1, 2), overlap=0).fit(
+        coordinates, data
+    )
+    east, north = coordinates
+    west_tile = east <= 5
+    west_fit = Trend(degree=1).fit(
+        (east[west_tile], north[west_tile]), data[west_tile]
+    )
+    point = tiled_points([2.5], [5.0])
+    npt.assert_allclose(gridder.predict(point), west_fit.predict(point), atol=1e-8)
+
+
+def test_tiled_gridder_region_edges_are_not_tapered():
+    "Predictions at the corners of the region come from a single tile"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(2, 2)).fit(coordinates, data)
+    east, north = coordinates
+    corner = np.logical_and(
+        np.logical_and(east >= 0, east <= 6.25),
+        np.logical_and(north >= 0, north <= 6.25),
+    )
+    corner_fit = Trend(degree=1).fit((east[corner], north[corner]), data[corner])
+    point = tiled_points([0.0], [0.0])
+    npt.assert_allclose(gridder.predict(point), corner_fit.predict(point), atol=1e-8)
+
+
+def test_tiled_gridder_blends_along_the_whole_band():
+    "Every point of the shared band is the weighted average of both tiles"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.25)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(1, 2)).fit(coordinates, data)
+    east, north = coordinates
+    west_tile = np.logical_and(east >= 0, east <= 6.25)
+    east_tile = np.logical_and(east >= 3.75, east <= 10)
+    west_fit = Trend(degree=1).fit((east[west_tile], north[west_tile]), data[west_tile])
+    east_fit = Trend(degree=1).fit((east[east_tile], north[east_tile]), data[east_tile])
+    line = (np.linspace(3.75, 6.25, 21), np.full(21, 2.0))
+    west_weight = np.clip((6.25 - line[0]) / 2.5, 0, 1)
+    east_weight = np.clip((line[0] - 3.75) / 2.5, 0, 1)
+    expected = (
+        west_weight * west_fit.predict(line) + east_weight * east_fit.predict(line)
+    ) / (west_weight + east_weight)
+    npt.assert_allclose(gridder.predict(line), expected, atol=1e-8)
+
+
+def test_tiled_gridder_nearest_differs_from_taper():
+    "The two blending modes disagree inside the shared band"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    data = tiled_quadratic(coordinates)
+    tapered = verde.TiledGridder(Trend(degree=1), shape=(1, 2)).fit(coordinates, data)
+    nearest = verde.TiledGridder(Trend(degree=1), shape=(1, 2), blend="nearest").fit(
+        coordinates, data
+    )
+    point = tiled_points([5.5], [5.0])
+    assert not np.allclose(tapered.predict(point), nearest.predict(point))
+
+
+def test_tiled_gridder_nearest_picks_the_closest_centre():
+    "The nearest mode uses the tile whose centre is closest"
+    coordinates = grid_coordinates((0, 10, 0, 10), spacing=0.5)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(Trend(degree=1), shape=(1, 2), blend="nearest").fit(
+        coordinates, data
+    )
+    east, north = coordinates
+    east_tile = np.logical_and(east >= 3.75, east <= 10)
+    east_fit = Trend(degree=1).fit(
+        (east[east_tile], north[east_tile]), data[east_tile]
