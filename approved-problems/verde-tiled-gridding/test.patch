+    point = tiled_points([6.0], [5.0])
+    covered = [
+        (tile, estimator)
+        for tile, estimator in zip(gridder.tiles_, gridder.estimators_)
+        if estimator is not None and tile[0] <= 6.0 <= tile[1]
+    ]
+    weights = [
+        verde.taper_weights(point, tile, (0.0, 10.0 / 3), region=gridder.region_)[0]
+        for tile, _ in covered
+    ]
+    expected = sum(
+        weight * estimator.predict(point)[0]
+        for weight, (_, estimator) in zip(weights, covered)
+    ) / sum(weights)
+    assert sum(weights) < 1
+    npt.assert_allclose(gridder.predict(point), [expected], atol=1e-8)
