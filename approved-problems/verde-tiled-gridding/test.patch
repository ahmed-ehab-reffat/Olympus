+def test_tiled_gridder_blends_tiles_of_different_sizes():
+    "Neighbouring tiles of different sizes each taper over their own band"
+    rng = np.random.default_rng(3)
+    east = np.concatenate([rng.uniform(0, 5, 400), rng.uniform(5, 10, 30)])
+    north = np.concatenate([rng.uniform(0, 10, 400), rng.uniform(0, 10, 30)])
+    coordinates = (east, north)
+    data = tiled_quadratic(coordinates)
+    gridder = verde.TiledGridder(
+        Trend(degree=1), shape=(1, 2), overlap=0.2, max_data=200, max_depth=1,
+        min_data=5, region=[0, 10, 0, 10],
+    ).fit(coordinates, data)
+    assert any(np.allclose(tile, [2.0, 5.5, 0.0, 6.0]) for tile in gridder.tiles_)
+    assert any(np.allclose(tile, [4.0, 10.0, 0.0, 10.0]) for tile in gridder.tiles_)
+    small = np.logical_and(
+        np.logical_and(east >= 2.0, east <= 5.5), np.logical_and(north >= 0, north <= 6)
+    )
+    large = np.logical_and(east >= 4.0, east <= 10.0)
+    small_fit = Trend(degree=1).fit((east[small], north[small]), data[small])
+    large_fit = Trend(degree=1).fit((east[large], north[large]), data[large])
+    point = tiled_points([4.5], [2.0])
+    small_weight = min(np.clip((4.5 - 2.0) / 1.0, 0, 1), np.clip((5.5 - 4.5) / 1.0, 0, 1))
+    large_weight = np.clip((4.5 - 4.0) / 2.0, 0, 1)
+    expected = (
+        small_weight * small_fit.predict(point) + large_weight * large_fit.predict(point)
+    ) / (small_weight + large_weight)
+    npt.assert_allclose(gridder.predict(point), expected, atol=1e-8)
