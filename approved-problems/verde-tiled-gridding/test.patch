+            np.logical_and(east >= tile[0], east <= tile[1]),
+            np.logical_and(north >= tile[2], north <= tile[3]),
+        )
+        expected.append(sorted(zip(east[held], north[held], data[held], weights[held])))
+    recorded = [sorted(zip(*call)) for call in TiledRecorder.calls]
+    assert sorted(recorded) == sorted(expected)
