+def test_merge_grids_different_spacing_per_direction():
+    "Grids may have a different spacing along each direction"
+    def anisotropic(west, east, value):
+        easting = np.arange(west, east + 0.25, 0.5)
+        northing = np.arange(0.0, 6.1, 2.0)
+        return xr.DataArray(
+            np.full((northing.size, easting.size), float(value)),
+            coords={"northing": northing, "easting": easting},
+            dims=("northing", "easting"),
+            name="scalars",
+        )
+
+    merged = verde.merge_grids([anisotropic(0, 4, 1), anisotropic(3, 7, 3)])
+    npt.assert_allclose(merged.northing.values, [0, 2, 4, 6])
+    npt.assert_allclose(merged.easting.values, np.arange(0.0, 7.1, 0.5))
+    west_weight = (4 - 3.5) / 2
+    east_weight = (3.5 - 3) / 2
+    expected = (west_weight * 1 + east_weight * 3) / (west_weight + east_weight)
+    npt.assert_allclose(merged.sel(easting=3.5, northing=2).values, expected, atol=1e-8)
+    npt.assert_allclose(merged.sel(easting=0.5, northing=4).values, 1)
