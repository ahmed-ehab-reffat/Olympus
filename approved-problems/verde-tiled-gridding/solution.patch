+def tile_regions(region, shape=None, spacing=None, overlap=0.0, adjust="spacing"):
+    """
+    Divide a region into equal tiles that can be made to overlap.
+
+    The region is first divided into ``shape[0] x shape[1]`` tiles of the same
+    size. Each tile is then extended by *overlap* times its own size on every
+    edge that it shares with a neighbouring tile. Edges that fall on the
+    boundary of *region* are never extended, so the tiles always cover exactly
+    the given region.
+
+    Parameters
+    ----------
+    region : list = [W, E, S, N]
+        The boundaries of the region that will be divided.
+    shape : None or tuple = (n_north, n_east)
+        The number of tiles in the north and east directions.
+    spacing : None or float or tuple = (s_north, s_east)
+        The size of the tiles in the north and east directions. The number of
+        tiles along a direction is the size of the region divided by this
+        value, rounded up to the next integer. Either *shape* or *spacing* must
+        be given, not both.
+    overlap : float
+        The fraction of its own size by which a tile is extended on every edge
+        that it shares with a neighbour. Must be equal to or greater than zero
+        and smaller than one.
+    adjust : str
+        Either ``"spacing"`` (the default) or ``"region"``. Only has an effect
+        if *spacing* is given and is not a whole division of the region. If
+        ``"spacing"``, the tiles are shrunk so that they fit the region
+        exactly. If ``"region"``, the tiles keep the given spacing and the
+        region is grown by the same amount on both sides of each direction.
+
+    Returns
+    -------
+    tiles : list of lists
+        The boundaries (``[W, E, S, N]``) of every tile, ordered by the south
+        edge of the tile and then by its west edge.
+
+    Examples
+    --------
+
+    >>> for tile in tile_regions((0, 10, -6, 6), shape=(2, 2)):
+    ...     print(tile)
+    [0.0, 5.0, -6.0, 0.0]
+    [5.0, 10.0, -6.0, 0.0]
+    [0.0, 5.0, 0.0, 6.0]
+    [5.0, 10.0, 0.0, 6.0]
+
+    The spacing is only an upper bound on the size of the tiles:
+
+    >>> for tile in tile_regions((0, 10, 0, 10), spacing=6):
+    ...     print(tile)
+    [0.0, 5.0, 0.0, 5.0]
+    [5.0, 10.0, 0.0, 5.0]
+    [0.0, 5.0, 5.0, 10.0]
+    [5.0, 10.0, 5.0, 10.0]
+
+    Keep the spacing and grow the region instead:
+
+    >>> for tile in tile_regions((0, 10, 0, 10), spacing=6, adjust="region"):
+    ...     print(tile)
+    [-1.0, 5.0, -1.0, 5.0]
+    [5.0, 11.0, -1.0, 5.0]
+    [-1.0, 5.0, 5.0, 11.0]
+    [5.0, 11.0, 5.0, 11.0]
+
+    Only the shared edges are extended by the overlap:
+
+    >>> for tile in tile_regions((0, 10, 0, 10), shape=(1, 2), overlap=0.1):
+    ...     print(tile)
+    [0.0, 5.5, 0.0, 10.0]
+    [4.5, 10.0, 0.0, 10.0]
+
+    """
+    check_region(region)
+    if (shape is None) == (spacing is None):
+        raise ValueError("Either a tile shape or a tile spacing must be given, not both.")
+    if adjust not in ("spacing", "region"):
+        raise ValueError(f"Invalid tile adjust '{adjust}'. Should be 'spacing' or 'region'")
+    west, east, south, north = (float(i) for i in region)
+    if shape is None:
+        spacing_north, spacing_east = _tile_pair(spacing, "spacing")
+        if spacing_north <= 0 or spacing_east <= 0:
+            raise ValueError(f"Invalid tile spacing '{spacing}'. Must be positive.")
+        shape = (
+            max(1, int(np.ceil((north - south) / spacing_north))),
+            max(1, int(np.ceil((east - west) / spacing_east))),
+        )
+        if adjust == "region":
+            pad_north = 0.5 * (shape[0] * spacing_north - (north - south))
+            pad_east = 0.5 * (shape[1] * spacing_east - (east - west))
+            west, east = west - pad_east, east + pad_east
+            south, north = south - pad_north, north + pad_north
+            region = [west, east, south, north]
+    n_north, n_east = (int(i) for i in shape)
+    if n_north < 1 or n_east < 1:
+        raise ValueError(f"Invalid tile shape '{shape}'. Must be 1 or greater.")
+    tiles = []
+    for i in range(n_north):
+        bottom = south if i == 0 else south + i * (north - south) / n_north
+        top = north if i == n_north - 1 else south + (i + 1) * (north - south) / n_north
+        for j in range(n_east):
+            left = west if j == 0 else west + j * (east - west) / n_east
+            right = east if j == n_east - 1 else west + (j + 1) * (east - west) / n_east
+            tiles.append(grow_tile([left, right, bottom, top], region, overlap)[0])
+    tiles.sort(key=lambda tile: (tile[2], tile[0]))
+    return tiles
+
+
+def grow_tile(tile, region, overlap):
+    """
+    Extend a tile on every edge that does not fall on the boundary of a region.
+
+    Parameters
+    ----------
+    tile : list = [W, E, S, N]
+        The boundaries of the tile before it is extended.
+    region : None or list = [W, E, S, N]
+        The boundaries of the region that contains the tile. Edges of the tile
+        that fall on the boundaries of the region are not extended.
+    overlap : float
+        The fraction of the size of the tile that is added to each extended
+        edge. Must be equal to or greater than zero and smaller than one.
+
+    Returns
+    -------
+    grown : list = [W, E, S, N]
+        The boundaries of the extended tile.
+    band : tuple = (b_north, b_east)
+        The width of the band that the extended tile shares with a neighbour
+        along each direction, which is twice the added amount.
+
+    Examples
+    --------
+
+    >>> grown, band = grow_tile([2, 4, 2, 8], [0, 10, 0, 10], overlap=0.25)
+    >>> print(grown)
+    [1.5, 4.5, 0.5, 9.5]
+    >>> print(band)
+    (3.0, 1.0)
+    >>> grown, band = grow_tile([0, 4, 2, 8], [0, 10, 0, 10], overlap=0.25)
+    >>> print(grown)
+    [0.0, 5.0, 0.5, 9.5]
+
+    """
+    check_region(tile)
+    if overlap < 0 or overlap >= 1:
+        raise ValueError(
+            f"Invalid overlap '{overlap}'. Must be equal to or greater than 0 "
+            "and smaller than 1."
+        )
+    west, east, south, north = (float(i) for i in tile)
+    margin_east = overlap * (east - west)
+    margin_north = overlap * (north - south)
+    shares_west, shares_east = shared_edges(west, east, region, axis=0)
+    shares_south, shares_north = shared_edges(south, north, region, axis=1)
+    grown = [
+        west - margin_east if shares_west else west,
+        east + margin_east if shares_east else east,
+        south - margin_north if shares_south else south,
+        north + margin_north if shares_north else north,
+    ]
+    return grown, (2 * margin_north, 2 * margin_east)
+
+
+def shared_edges(low, high, region, axis):
+    """
+    Check which of the two edges of a tile fall inside a region.
+
+    Parameters
+    ----------
+    low, high : float
+        The lower and upper boundaries of the tile along the given axis.
+    region : None or list = [W, E, S, N]
+        The boundaries of the region. If None, both edges are considered to be
+        inside of it.
+    axis : int
+        Zero for the east direction and one for the north direction.
+
+    Returns
+    -------
+    shared : tuple = (low_is_shared, high_is_shared)
+
+    Examples
+    --------
+
+    >>> print(shared_edges(2, 4, [0, 10, 0, 10], axis=0))
+    (True, True)
+    >>> print(shared_edges(0, 4, [0, 10, 0, 10], axis=0))
+    (False, True)
+    >>> print(shared_edges(0, 10, None, axis=1))
+    (True, True)
+
+    """
+    if region is None:
+        return True, True
+    return low > region[2 * axis], high < region[2 * axis + 1]
+
+
+def _tile_pair(value, name):
+    """
+    Convert a scalar or a 2-element sequence into a (north, east) tuple.
+    """
+    if np.isscalar(value):
+        return float(value), float(value)
+    values = tuple(float(i) for i in value)
+    if len(values) != 2:
+        raise ValueError(
+            f"Invalid {name} '{value}'. Must be a single value or a pair of values."
+        )
+    return values
+
+
