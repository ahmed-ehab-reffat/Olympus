+def merge_grids(grids):
+    """
+    Merge overlapping grids into a single grid, blending the overlaps.
+
+    All grids must have the same two dimensions, coordinates that increase
+    along each of them with the same spacing, and they must fall on a common
+    lattice (their origins can only differ by a whole number of grid
+    intervals). The merged grid spans every coordinate covered by at least one
+    of the given grids.
+
+    Values are the weighted average of the grids that have a value at that
+    point. The weight of a grid grows linearly from zero at its edges to one at
+    its centre (see :func:`verde.taper_weights`), except at the edges that fall
+    on the boundary of the merged grid, which are not tapered. Points where all
+    of the weights are zero take the plain average of the available values.
+    Points that no grid covers are NaN.
+
+    Parameters
+    ----------
+    grids : list of :class:`xarray.DataArray`
+        The grids that will be merged.
+
+    Returns
+    -------
+    merged : :class:`xarray.DataArray`
+        The merged grid, with the dimensions and name of the first given grid.
+
+    Examples
+    --------
+
+    >>> import numpy as np
+    >>> import xarray as xr
+    >>> def make_grid(west, values):
+    ...     return xr.DataArray(
+    ...         np.array(values, dtype="float64"),
+    ...         coords={"northing": [0.0, 1.0], "easting": np.arange(west, west + 3.0)},
+    ...         dims=("northing", "easting"),
+    ...     )
+    >>> merged = merge_grids([make_grid(0, [[1, 1, 1], [1, 1, 1]])])
+    >>> print(merged.values)
+    [[1. 1. 1.]
+     [1. 1. 1.]]
+    >>> merged = merge_grids(
+    ...     [make_grid(0, [[1, 1, 1], [1, 1, 1]]), make_grid(2, [[3, 3, 3], [3, 3, 3]])]
+    ... )
+    >>> print(merged.easting.values)
+    [0. 1. 2. 3. 4.]
+    >>> print(merged.values)
+    [[1. 1. 2. 3. 3.]
+     [1. 1. 2. 3. 3.]]
+
+    """
+    if not grids:
+        raise ValueError("Need at least one grid to merge.")
+    dims = grids[0].dims
+    if any(grid.dims != dims for grid in grids):
+        raise ValueError(f"Grids must all have the dimensions '{dims}'.")
+    spacing = tuple(_grid_spacing(grids[0], dim) for dim in dims)
+    for grid in grids[1:]:
+        for dim, step in zip(dims, spacing):
+            if abs(_grid_spacing(grid, dim) - step) > 1e-6 * abs(step):
+                raise ValueError(
+                    f"Grids must all have the same spacing along '{dim}'."
+                )
+            offset = (grid[dim].values[0] - grids[0][dim].values[0]) / step
+            if abs(offset - round(offset)) > 1e-6:
+                raise ValueError(
+                    f"Grids must fall on a common lattice along '{dim}'."
+                )
+    coords = {
+        dim: _merged_coordinates(grids, dim, step) for dim, step in zip(dims, spacing)
+    }
+    north, east = np.meshgrid(coords[dims[0]], coords[dims[1]], indexing="ij")
+    region = [east.min(), east.max(), north.min(), north.max()]
+    total = np.zeros(north.shape, dtype="float64")
+    norm = np.zeros(north.shape, dtype="float64")
+    available = np.zeros(north.shape, dtype="float64")
+    count = np.zeros(north.shape, dtype="float64")
+    for grid in grids:
+        tile = [
+            grid[dims[1]].values.min(),
+            grid[dims[1]].values.max(),
+            grid[dims[0]].values.min(),
+            grid[dims[0]].values.max(),
+        ]
+        margin = (0.5 * (tile[3] - tile[2]), 0.5 * (tile[1] - tile[0]))
+        values = grid.reindex(
+            {dims[0]: coords[dims[0]], dims[1]: coords[dims[1]]}, method="nearest",
+            tolerance=1e-6 * min(abs(i) for i in spacing),
+        ).values
+        valid = np.isfinite(values)
+        weights = taper_weights((east, north), tile, margin, region=region)
+        weights[~valid] = 0
+        total += weights * np.where(valid, values, 0)
+        norm += weights
+        available += np.where(valid, values, 0)
+        count += valid
+    merged = np.full(north.shape, np.nan, dtype="float64")
+    blended = norm > 0
+    merged[blended] = total[blended] / norm[blended]
+    plain = np.logical_and(~blended, count > 0)
+    merged[plain] = available[plain] / count[plain]
+    return xr.DataArray(merged, coords=coords, dims=dims, name=grids[0].name)
+
+
+def _grid_spacing(grid, dim):
+    """
+    The interval between the coordinates of a grid along a dimension.
+    """
+    values = grid[dim].values
+    if values.size < 2:
+        raise ValueError(f"Grids must have at least 2 points along '{dim}'.")
+    steps = np.diff(values)
+    if np.abs(steps - steps[0]).max() > 1e-6 * abs(steps[0]):
+        raise ValueError(f"Grid coordinates along '{dim}' must be evenly spaced.")
+    if steps[0] <= 0:
+        raise ValueError(f"Grid coordinates along '{dim}' must increase.")
+    return float(steps[0])
+
+
+def _merged_coordinates(grids, dim, spacing):
+    """
+    The coordinates that span every given grid along a dimension.
+    """
+    start = min(grid[dim].values.min() for grid in grids)
+    stop = max(grid[dim].values.max() for grid in grids)
+    size = int(round((stop - start) / spacing)) + 1
+    return start + spacing * np.arange(size)
+
+
+def _unpack(values):
+    """
+    Return the single element of a 1-element tuple, otherwise the tuple.
+    """
+    if len(values) == 1:
+        return values[0]
+    return values
+
+
+def _quadrants(tile):
+    """
+    Split a tile into 4 parts of the same size.
+    """
+    west, east, south, north = tile
+    middle_east = 0.5 * (west + east)
+    middle_north = 0.5 * (south + north)
+    return [
+        [west, middle_east, south, middle_north],
+        [middle_east, east, south, middle_north],
+        [west, middle_east, middle_north, north],
+        [middle_east, east, middle_north, north],
+    ]
+
+
+def _refine_tiles(coordinates, tiles, max_data, max_depth):
+    """
+    Split tiles that hold too many data points into quadrants, recursively.
+
+    Points are counted inside the tile before it is extended by the overlap.
+    """
+    if max_data is None:
+        return list(tiles)
+    if max_data < 1:
+        raise ValueError(f"Invalid max_data '{max_data}'. Must be 1 or greater.")
+    if max_depth < 0:
+        raise ValueError(f"Invalid max_depth '{max_depth}'. Must be 0 or greater.")
+    refined = []
+    queue = [(tile, 0) for tile in tiles]
+    while queue:
+        tile, depth = queue.pop(0)
+        if depth < max_depth and inside(coordinates, tile).sum() > max_data:
+            queue.extend((quadrant, depth + 1) for quadrant in _quadrants(tile))
+        else:
+            refined.append(tile)
+    return refined
+
+
+class TiledGridder(BaseGridder):
+    """
+    Grid data by fitting a copy of an estimator on each tile of the region.
+
+    The data region is divided into tiles and a separate copy of *estimator* is
+    fitted on the data of each one. Tiles are extended so that neighbours
+    overlap and predictions are the weighted average of the predictions of
+    every fitted tile that contains the point. The weight of a tile falls off
+    linearly from one to zero across the whole band that it shares with a
+    neighbour (see :func:`verde.taper_weights`), which keeps the predictions
+    continuous across the tile boundaries.
+
+    Fitting on tiles is useful for estimators that scale poorly with the number
+    of data points, like :class:`verde.Spline`.
+
+    Parameters
+    ----------
+    estimator : verde gridder
+        Any verde gridder, like :class:`verde.Spline` or :class:`verde.Trend`.
+        The given estimator is not modified. An independent copy of it is
+        fitted on each tile.
+    shape : None or tuple = (n_north, n_east)
+        The number of tiles in the north and east directions.
+    spacing : None or float or tuple = (s_north, s_east)
+        The size of the tiles in the north and east directions. The number of
+        tiles along a direction is the size of the region divided by this
+        value, rounded up. Either *shape* or *spacing* must be given, not both.
+    overlap : float
+        The fraction of its own size by which a tile is extended on every edge
+        that it shares with a neighbour. Must be equal to or greater than zero
+        and smaller than one.
+    min_data : int
+        Tiles that contain fewer than this many data points are not fitted and
+        take no part in the predictions.
+    max_data : None or int
+        If given, tiles that contain more than this many data points are split
+        into 4 tiles of the same size, recursively.
+    max_depth : int
+        The maximum number of times that a tile can be split.
+    region : None or list = [W, E, S, N]
+        The region that is divided into tiles. If None, the bounding region of
+        the data is used instead. Data points outside of it are ignored.
+    blend : str
+        Either ``"taper"`` (the default) or ``"nearest"``. With ``"taper"``,
+        predictions are the weighted average of every fitted tile that contains
+        the point. With ``"nearest"``, the prediction of the fitted tile whose
+        centre is closest to the point is used instead, with ties broken by the
+        order of the tiles.
+
+    Attributes
+    ----------
+    region_ : tuple
+        The boundaries (``[W, E, S, N]``) of the data used to fit the gridder.
+    tiles_ : list of lists
+        The boundaries of every tile, already extended by the overlap, ordered
+        by the south edge of the tile and then by its west edge.
+    estimators_ : list
+        The estimator fitted on each tile, in the same order as ``tiles_``.
+        Tiles that hold too few data points have ``None`` in their place.
+
+    Examples
+    --------
+
+    >>> from verde import grid_coordinates, Trend
+    >>> coordinates = grid_coordinates((0, 10, -5, 5), spacing=0.5)
+    >>> data = 3 - 2*coordinates[0] + 0.5*coordinates[1]
+    >>> tiled = TiledGridder(Trend(degree=1), shape=(2, 2)).fit(coordinates, data)
+    >>> print(len(tiled.tiles_))
+    4
+    >>> print(tiled.tiles_[0])
+    [0.0, 6.25, -5.0, 1.25]
+    >>> np.allclose(tiled.predict(coordinates), data)
+    True
+
+    """
+
+    def __init__(
+        self,
+        estimator,
+        shape=None,
+        spacing=None,
+        overlap=0.25,
+        min_data=10,
+        max_data=None,
+        max_depth=3,
+        region=None,
+        blend="taper",
+    ):
+        super().__init__()
+        self.estimator = estimator
+        self.shape = shape
+        self.spacing = spacing
+        self.overlap = overlap
+        self.min_data = min_data
+        self.max_data = max_data
+        self.max_depth = max_depth
+        self.region = region
+        self.blend = blend
+
+    def fit(self, coordinates, data, weights=None):
+        """
+        Fit a copy of the estimator to the data of every tile.
+
+        The data region is captured and used as default for the
+        :meth:`~verde.TiledGridder.grid` and
+        :meth:`~verde.TiledGridder.scatter` methods.
+
+        All input arrays must have the same shape.
+
+        Parameters
+        ----------
+        coordinates : tuple of arrays
+            Arrays with the coordinates of each data point. Should be in the
+            following order: (easting, northing, vertical, ...). Only easting
+            and northing will be used, all subsequent coordinates will be
+            ignored.
+        data : array
+            The data values of each data point.
+        weights : None or array
+            If not None, then the weights assigned to each data point. The
+            weights of the points of a tile are passed on to its estimator.
+
+        Returns
+        -------
+        self
+            Returns this estimator instance for chaining operations.
+
+        """
+        if self.blend not in ("taper", "nearest"):
+            raise ValueError(
+                f"Invalid blend '{self.blend}'. Should be 'taper' or 'nearest'"
+            )
+        coordinates, data, weights = check_fit_input(
+            coordinates, data, weights, unpack=False
+        )
+        easting, northing = n_1d_arrays(coordinates, 2)
+        values = n_1d_arrays(data, len(data))
+        self.n_components_ = len(values)
+        if any(i is None for i in weights):
+            weights = None
+        if self.region is None:
+            self.region_ = get_region((easting, northing))
+        else:
+            check_region(self.region)
+            self.region_ = tuple(float(i) for i in self.region)
+        base = tile_regions(self.region_, shape=self.shape, spacing=self.spacing)
+        base = _refine_tiles((easting, northing), base, self.max_data, self.max_depth)
+        grown = [grow_tile(tile, self.region_, self.overlap) for tile in base]
+        grown.sort(key=lambda item: (item[0][2], item[0][0]))
+        self.tiles_ = [tile for tile, _ in grown]
+        self.bands_ = [band for _, band in grown]
+        self.estimators_ = []
+        self.counts_ = []
+        for tile in self.tiles_:
+            in_tile = inside((easting, northing), tile)
+            count = int(in_tile.sum())
+            self.counts_.append(count)
+            if count < self.min_data:
+                self.estimators_.append(None)
+                continue
+            tile_data = _unpack(tuple(i[in_tile] for i in values))
+            tile_weights = None
+            if weights is not None:
+                tile_weights = _unpack(tuple(np.ravel(i)[in_tile] for i in weights))
+            estimator = clone(self.estimator)
+            estimator.fit(
+                (easting[in_tile], northing[in_tile]), tile_data, tile_weights
+            )
+            self.estimators_.append(estimator)
+        if all(estimator is None for estimator in self.estimators_):
+            raise ValueError(
+                "Every tile contains fewer than min_data '{}' data points. "
+                "Use fewer tiles or a smaller min_data.".format(self.min_data)
+            )
+        return self
+
+    def predict(self, coordinates):
+        """
+        Blend the predictions of every fitted tile that contains each point.
+
+        Requires a fitted estimator (see :meth:`~verde.TiledGridder.fit`).
+
+        Points that fall outside of every fitted tile are given a value of NaN.
+
+        Parameters
+        ----------
+        coordinates : tuple of arrays
+            Arrays with the coordinates of each data point. Should be in the
+            following order: (easting, northing, vertical, ...). Only easting
+            and northing will be used, all subsequent coordinates will be
+            ignored.
+
+        Returns
+        -------
+        data : array or tuple of arrays
+            The blended predictions. A tuple is returned if the gridder was
+            fitted on data with more than one component.
+
+        """
+        check_is_fitted(self, ["estimators_"])
+        easting, northing = n_1d_arrays(coordinates, 2)
+        shape = np.broadcast(*coordinates[:2]).shape
+        if self.blend == "nearest":
+            return self._predict_nearest(easting, northing, shape)
+        total = [np.zeros(easting.size, dtype="float64") for i in range(self.n_components_)]
+        norm = np.zeros(easting.size, dtype="float64")
+        for tile, band, estimator in zip(self.tiles_, self.bands_, self.estimators_):
+            if estimator is None:
+                continue
+            weights = taper_weights(
+                (easting, northing), tile, band, region=self.region_
+            )
+            contributes = weights > 0
+            if not contributes.any():
+                continue
+            predicted = estimator.predict((easting[contributes], northing[contributes]))
+            if self.n_components_ == 1:
+                predicted = (predicted,)
+            for component, values in zip(total, predicted):
+                component[contributes] += weights[contributes] * np.ravel(values)
+            norm[contributes] += weights[contributes]
+        covered = norm > 0
+        blended = []
+        for component in total:
+            values = np.full(easting.size, np.nan, dtype="float64")
+            values[covered] = component[covered] / norm[covered]
+            blended.append(values.reshape(shape))
+        return _unpack(tuple(blended))
+
+    def _predict_nearest(self, easting, northing, shape):
+        """
+        Predict with the fitted tile whose centre is closest to each point.
+        """
+        chosen = np.full(easting.size, -1, dtype="int64")
+        closest = np.full(easting.size, np.inf, dtype="float64")
+        for index, (tile, estimator) in enumerate(zip(self.tiles_, self.estimators_)):
+            if estimator is None:
+                continue
+            distance = np.hypot(
+                easting - 0.5 * (tile[0] + tile[1]),
+                northing - 0.5 * (tile[2] + tile[3]),
+            )
+            wins = np.logical_and(inside((easting, northing), tile), distance < closest)
+            chosen[wins] = index
+            closest[wins] = distance[wins]
+        predictions = [
+            np.full(easting.size, np.nan, dtype="float64")
+            for i in range(self.n_components_)
+        ]
+        for index in np.unique(chosen[chosen >= 0]):
+            selected = chosen == index
+            predicted = self.estimators_[index].predict(
+                (easting[selected], northing[selected])
+            )
+            if self.n_components_ == 1:
+                predicted = (predicted,)
+            for component, values in zip(predictions, predicted):
+                component[selected] = np.ravel(values)
+        return _unpack(tuple(i.reshape(shape) for i in predictions))
+
+    def tile_report(self):
+        """
+        Table with the boundaries and the data count of every tile.
+
+        Requires a fitted estimator (see :meth:`~verde.TiledGridder.fit`).
+
+        Returns
+        -------
+        report : :class:`pandas.DataFrame`
+            Table with one row per tile, in the same order as ``tiles_``, and
+            the columns ``"west"``, ``"east"``, ``"south"``, ``"north"``,
+            ``"n_data"``, and ``"fitted"``.
+
+        """
+        check_is_fitted(self, ["estimators_"])
+        tiles = np.atleast_2d(self.tiles_)
+        return pd.DataFrame(
+            {
+                "west": tiles[:, 0],
+                "east": tiles[:, 1],
+                "south": tiles[:, 2],
+                "north": tiles[:, 3],
+                "n_data": self.counts_,
+                "fitted": [estimator is not None for estimator in self.estimators_],
+            }
+        )
