+def taper_weights(coordinates, tile, margin, region=None):
+    """
+    Weights that fall off linearly towards the shared edges of a tile.
+
+    The weight of a point is the product of one factor per direction. Along
+    each direction, the factor grows linearly from zero at a shared edge of the
+    tile to one at a distance of *margin* from that edge. Only the edges that
+    fall inside *region* are tapered, so a tile that reaches the boundary of
+    *region* keeps a weight of one there. Points outside of the tile have a
+    weight of zero.
+
+    Parameters
+    ----------
+    coordinates : tuple of arrays
+        Arrays with the coordinates of each point. Should be in the following
+        order: (easting, northing, vertical, ...). Only easting and northing
+        will be used, all subsequent coordinates will be ignored.
+    tile : list = [W, E, S, N]
+        The boundaries of the tile.
+    margin : float or tuple = (m_north, m_east)
+        The distance over which the weights go from zero to one. A single value
+        is used for both directions. Values equal to or smaller than zero
+        disable the taper along that direction.
+    region : None or list = [W, E, S, N]
+        If given, edges of the tile that fall on the boundaries of this region
+        are not tapered.
+
+    Returns
+    -------
+    weights : array
+        Array with the same shape as the coordinates and values between zero
+        and one.
+
+    Examples
+    --------
+
+    >>> import numpy as np
+    >>> easting = np.array([0, 1, 2, 3, 4, 5])
+    >>> northing = np.full(easting.shape, 5)
+    >>> print(taper_weights((easting, northing), [0, 4, 0, 10], margin=2))
+    [0.  0.5 1.  0.5 0.  0. ]
+
+    Edges on the boundary of the region are not tapered:
+
+    >>> print(
+    ...     taper_weights(
+    ...         (easting, northing), [0, 4, 0, 10], margin=2, region=[0, 10, 0, 10],
+    ...     )
+    ... )
+    [1.  1.  1.  0.5 0.  0. ]
+
+    """
+    check_region(tile)
+    if region is not None:
+        check_region(region)
+    margin_north, margin_east = _tile_pair(margin, "margin")
+    easting, northing = coordinates[:2]
+    west, east, south, north = tile
+    shares_west, shares_east = shared_edges(west, east, region, axis=0)
+    shares_south, shares_north = shared_edges(south, north, region, axis=1)
+    factor_east = _axis_factor(easting, west, east, margin_east, shares_west, shares_east)
+    factor_north = _axis_factor(
+        northing, south, north, margin_north, shares_south, shares_north
+    )
+    return factor_east * factor_north
+
+
+def _axis_factor(coordinate, low, high, margin, taper_low, taper_high):
+    """
+    The linear taper factor along a single direction.
+    """
+    values = np.asarray(coordinate, dtype="float64")
+    factor = np.ones(values.shape, dtype="float64")
+    if margin > 0:
+        if taper_low:
+            factor = np.minimum(factor, np.clip((values - low) / margin, 0, 1))
+        if taper_high:
+            factor = np.minimum(factor, np.clip((high - values) / margin, 0, 1))
+    factor[np.logical_or(values < low, values > high)] = 0
+    return factor
+
