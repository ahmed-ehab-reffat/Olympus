+"""Neighbourhood bookkeeping shared by the region analysis routines."""
+
+import itertools
+import operator
+
+import numba
+
+import numpy as np
+
+from .._coo.common import _validate_coo_input
+from .._utils import check_zero_fill_value
+
+
+def require_axes(ndim):
+    """
+    Reject an array that has no axes to have regions along.
+
+    Parameters
+    ----------
+    ndim : int
+        Rank of the array.
+
+    Raises
+    ------
+    ValueError
+        If the rank is zero.
+    """
+    if ndim < 1:
+        raise ValueError("Region analysis needs an array with at least one axis.")
+
+
+def normalize_connectivity(connectivity, ndim):
+    """
+    Validate a connectivity value against an array rank.
+
+    Parameters
+    ----------
+    connectivity : int
+        Number of axes along which two neighbouring indices may differ.
+    ndim : int
+        Rank of the array the connectivity applies to.
+
+    Returns
+    -------
+    int
+        The validated connectivity.
+
+    Raises
+    ------
+    ValueError
+        If the rank is zero or the connectivity is out of range.
+    """
+    require_axes(ndim)
+
+    try:
+        connectivity = operator.index(connectivity)
+    except TypeError as e:
+        raise ValueError(f"connectivity must be an integer, but is {connectivity!r}.") from e
+
+    if not 1 <= connectivity <= ndim:
+        raise ValueError(f"connectivity must be between 1 and {ndim}, but is {connectivity}.")
+
+    return connectivity
+
+
+def normalize_count(value, name):
+    """
+    Validate a non-negative count.
+
+    Parameters
+    ----------
+    value : int
+        Count to validate.
+    name : str
+        Name of the argument the count came from.
+
+    Returns
+    -------
+    int
+        The validated count.
+
+    Raises
+    ------
+    ValueError
+        If the count is not a non-negative integer.
+    """
+    try:
+        value = operator.index(value)
+    except TypeError as e:
+        raise ValueError(f"{name} must be an integer, but is {value!r}.") from e
+
+    if value < 0:
+        raise ValueError(f"{name} must not be negative, but is {value}.")
+
+    return value
+
+
+def normalize_wrap(wrap, ndim):
+    """
+    Turn a wrap specification into a per-axis boolean array.
+
+    Parameters
+    ----------
+    wrap : bool or Iterable[bool]
+        Either one flag for every axis, or one flag per axis.
+    ndim : int
+        Rank of the array the specification applies to.
+
+    Returns
+    -------
+    numpy.ndarray
+        Boolean array of length ``ndim``.
+
+    Raises
+    ------
+    ValueError
+        If a per-axis specification has the wrong length or holds non-booleans.
+    """
+    if isinstance(wrap, bool | np.bool_):
+        return np.full(ndim, bool(wrap), dtype=np.bool_)
+
+    flags = np.asarray(wrap)
+    if flags.ndim != 1 or flags.shape[0] != ndim:
+        raise ValueError(f"wrap must be a boolean or a sequence of {ndim} booleans, but has shape {flags.shape}.")
+    if flags.dtype != np.bool_:
+        raise ValueError(f"wrap must hold booleans, but has dtype {flags.dtype}.")
+
+    return flags.astype(np.bool_, copy=True)
+
+
+def offsets_for(connectivity, ndim):
+    """
+    Build the steps reaching the neighbours of an index.
+
+    Only the steps whose first non-zero entry is positive are returned, since
+    neighbourhood is symmetric and every pair is then reached once.
+
+    Parameters
+    ----------
+    connectivity : int
+        Number of axes along which a step may be non-zero.
+    ndim : int
+        Rank of the array.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of shape ``(n_steps, ndim)``.
+    """
+    steps = []
+    for step in itertools.product((-1, 0, 1), repeat=ndim):
+        moves = [value for value in step if value != 0]
+        if not moves or len(moves) > connectivity or moves[0] < 0:
+            continue
+        steps.append(step)
+
+    return np.array(sorted(steps), dtype=np.intp).reshape(len(steps), ndim)
+
+
+def linear_index(coords, shape):
+    """
+    Row major position of every coordinate column.
+
+    Parameters
+    ----------
+    coords : numpy.ndarray
+        Array of shape ``(ndim, n)``.
+    shape : tuple[int, ...]
+        Shape the coordinates index into.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of ``n`` positions.
+    """
+    out = np.zeros(coords.shape[1], dtype=np.int64)
+    for axis, length in enumerate(shape):
+        out *= length
+        out += coords[axis].astype(np.int64, copy=False)
+
+    return out
+
+
+def row_major_order(coords):
+    """
+    Permutation putting coordinate columns into row major order.
+
+    Parameters
+    ----------
+    coords : numpy.ndarray
+        Array of shape ``(ndim, n)``.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of ``n`` indices.
+    """
+    if coords.shape[1] == 0:
+        return np.empty(0, dtype=np.intp)
+
+    return np.lexsort(coords[::-1])
+
+
+def cells_of(x):
+    """
+    Coordinates of the positions of ``x`` that do not hold zero.
+
+    A stored position whose value is zero is not a cell, so the coordinates have
+    to be filtered by the data before they are usable.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array to read.
+
+    Returns
+    -------
+    x : COO
+        The validated input.
+    coords : numpy.ndarray
+        Cell coordinates of shape ``(ndim, n)``, in row major order.
+    codes : numpy.ndarray
+        Row major position of every cell, ascending.
+    values : numpy.ndarray
+        Value held by every cell.
+
+    Raises
+    ------
+    ValueError
+        If the array does not have a zero fill value.
+    """
+    x = _validate_coo_input(x)
+    require_axes(x.ndim)
+    check_zero_fill_value(x)
+
+    keep = x.data != 0
+    coords = x.coords[:, keep]
+    order = row_major_order(coords)
+    coords = np.ascontiguousarray(coords[:, order])
+
+    return x, coords, linear_index(coords, x.shape), x.data[keep][order]
+
+
+def step_to(coords, step, shape, wrap):
+    """
+    Apply one neighbour step to every coordinate column.
+
+    Parameters
+    ----------
+    coords : numpy.ndarray
+        Array of shape ``(ndim, n)``.
+    step : numpy.ndarray
+        One step of length ``ndim``.
+    shape : tuple[int, ...]
+        Shape the coordinates index into.
+    wrap : numpy.ndarray
+        Per-axis flags telling which axes are periodic.
+
+    Returns
+    -------
+    moved : numpy.ndarray
+        The stepped coordinates, of shape ``(ndim, n)``.
+    inside : numpy.ndarray
+        Mask of the columns that stayed inside the array.
+    """
+    moved = coords + step[:, None]
+    inside = np.ones(coords.shape[1], dtype=np.bool_)
+    for axis, length in enumerate(shape):
+        if wrap[axis]:
+            moved[axis] %= length
+        else:
+            inside &= (moved[axis] >= 0) & (moved[axis] < length)
+
+    return moved, inside
+
+
+def members_of(codes, sorted_codes):
+    """
+    Locate row major positions inside an ascending set of positions.
+
+    Parameters
+    ----------
+    codes : numpy.ndarray
+        Positions to look up.
+    sorted_codes : numpy.ndarray
+        Ascending positions to look up in.
+
+    Returns
+    -------
+    found : numpy.ndarray
+        Mask of the positions that are present.
+    where : numpy.ndarray
+        Index into ``sorted_codes`` of every position, meaningless where
+        ``found`` is False.
+    """
+    where = np.searchsorted(sorted_codes, codes)
+    if sorted_codes.shape[0] == 0:
+        return np.zeros(codes.shape[0], dtype=np.bool_), where
+
+    np.clip(where, 0, sorted_codes.shape[0] - 1, out=where)
+
+    return sorted_codes[where] == codes, where
+
+
+def neighbour_pairs(coords, codes, shape, steps, wrap):
+    """
+    Every pair of cells that are neighbours of each other.
+
+    Parameters
+    ----------
+    coords : numpy.ndarray
+        Cell coordinates of shape ``(ndim, n)``, in row major order.
+    codes : numpy.ndarray
+        Row major position of every cell, ascending.
+    shape : tuple[int, ...]
+        Shape the coordinates index into.
+    steps : numpy.ndarray
+        Steps of shape ``(n_steps, ndim)``.
+    wrap : numpy.ndarray
+        Per-axis flags telling which axes are periodic.
+
+    Returns
+    -------
+    left : numpy.ndarray
+        Index of the first cell of every pair.
+    right : numpy.ndarray
+        Index of the second cell of every pair.
+    """
+    lefts = []
+    rights = []
+    for step in steps:
+        moved, inside = step_to(coords, step, shape, wrap)
+        found, where = members_of(linear_index(moved, shape), codes)
+        hit = np.flatnonzero(found & inside)
+        if hit.shape[0]:
+            lefts.append(hit)
+            rights.append(where[hit])
+
+    if not lefts:
+        empty = np.empty(0, dtype=np.intp)
+        return empty, empty.copy()
+
+    left = np.concatenate(lefts).astype(np.intp, copy=False)
+    right = np.concatenate(rights).astype(np.intp, copy=False)
+    keep = left != right
+
+    return left[keep], right[keep]
+
+
+def components_of(count, left, right):
+    """
+    Group indices into connected components.
+
+    Parameters
+    ----------
+    count : int
+        Number of indices.
+    left, right : numpy.ndarray
+        Endpoints of the edges joining the indices.
+
+    Returns
+    -------
+    numpy.ndarray
+        Smallest index of the component of every index.
+    """
+    parent = np.arange(count, dtype=np.intp)
+    _join_all(parent, left.astype(np.intp, copy=False), right.astype(np.intp, copy=False))
+
+    return parent
+
+
+@numba.jit(nopython=True, nogil=True)
+def _join_all(parent, left, right):  # pragma: no cover
+    for edge in range(left.shape[0]):
+        root_a = _root_of(parent, left[edge])
+        root_b = _root_of(parent, right[edge])
+        if root_a < root_b:
+            parent[root_b] = root_a
+        elif root_b < root_a:
+            parent[root_a] = root_b
+
+    for node in range(parent.shape[0]):
+        parent[node] = _root_of(parent, node)
+
+
+@numba.jit(nopython=True, nogil=True)
+def _root_of(parent, node):  # pragma: no cover
+    root = node
+    while parent[root] != root:
+        root = parent[root]
+    while parent[node] != root:
+        parent[node], node = root, parent[node]
+    return root
+
+
+def number_by_first_cell(roots):
+    """
+    Number components by the position of their first member.
+
+    Parameters
+    ----------
+    roots : numpy.ndarray
+        Component of every cell, with the cells in row major order.
+
+    Returns
+    -------
+    numbers : numpy.ndarray
+        Number from one upwards of the component of every cell.
+    count : int
+        Number of components.
+    """
+    if roots.shape[0] == 0:
+        return np.zeros(0, dtype=np.intp), 0
+
+    _, first, inverse = np.unique(roots, return_index=True, return_inverse=True)
+    numbers = np.empty(first.shape[0], dtype=np.intp)
+    numbers[np.argsort(first)] = np.arange(1, first.shape[0] + 1, dtype=np.intp)
+
+    return numbers[inverse.reshape(-1)], first.shape[0]
+
+
+def unique_columns(coords):
+    """
+    Drop repeated coordinate columns and return them in row major order.
+
+    Parameters
+    ----------
+    coords : numpy.ndarray
+        Array of shape ``(ndim, n)``.
+
+    Returns
+    -------
+    numpy.ndarray
+        The distinct columns of ``coords``.
+    """
+    if coords.shape[1] == 0:
+        return np.ascontiguousarray(coords)
+
+    coords = np.ascontiguousarray(coords[:, row_major_order(coords)])
+    keep = np.ones(coords.shape[1], dtype=np.bool_)
+    keep[1:] = (coords[:, 1:] != coords[:, :-1]).any(axis=0)
+
+    return np.ascontiguousarray(coords[:, keep])
+
+
+def label_cells(labels):
+    """
+    Read a label array back into cells and their region numbers.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+
+    Returns
+    -------
+    labels : COO
+        The validated input.
+    coords : numpy.ndarray
+        Cell coordinates of shape ``(ndim, n)``, in row major order.
+    ids : numpy.ndarray
+        Region number of every cell.
+    count : int
+        Number of regions.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling: its values have to run over the whole
+        range of region numbers from one upwards.
+    """
+    labels = _validate_coo_input(labels)
+    require_axes(labels.ndim)
+    check_zero_fill_value(labels)
+
+    if labels.dtype.kind not in "iu":
+        raise ValueError(f"labels must hold integers, but has dtype {labels.dtype}.")
+
+    keep = labels.data != 0
+    coords = labels.coords[:, keep]
+    ids = labels.data[keep].astype(np.intp, copy=False)
+    count = int(ids.max()) if ids.shape[0] else 0
+    if count and np.unique(ids).shape[0] != count:
+        raise ValueError(f"labels must use every region number from 1 to {count}.")
+
+    order = row_major_order(coords)
+
+    return labels, np.ascontiguousarray(coords[:, order]), ids[order], count
+
+
+def unique_reach(coords, ids, shape):
+    """
+    Drop repeated position and region pairs from a spreading front.
+
+    A position may be reached by several regions at once and every one of them
+    has to survive, so the pairs are made unique together rather than the
+    positions alone.
+
+    Parameters
+    ----------
+    coords : numpy.ndarray
+        Reached coordinates of shape ``(ndim, n)``.
+    ids : numpy.ndarray
+        Region that reached every coordinate.
+    shape : tuple[int, ...]
+        Shape the coordinates index into.
+
+    Returns
+    -------
+    coords : numpy.ndarray
+        The distinct coordinates.
+    ids : numpy.ndarray
+        The region of every distinct pair.
+    """
+    if coords.shape[1] == 0:
+        return coords, ids
+
+    codes = linear_index(coords, shape)
+    order = np.lexsort((ids, codes))
+    codes, ids, coords = codes[order], ids[order], np.ascontiguousarray(coords[:, order])
+    keep = np.ones(codes.shape[0], dtype=np.bool_)
+    keep[1:] = (codes[1:] != codes[:-1]) | (ids[1:] != ids[:-1])
+
+    return np.ascontiguousarray(coords[:, keep]), ids[keep]
