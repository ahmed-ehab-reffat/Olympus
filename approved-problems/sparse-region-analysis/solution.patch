+"""Region analysis for sparse arrays."""
+
+import numpy as np
+
+from .._coo.core import COO
+from ._neighbors import (
+    cells_of,
+    components_of,
+    label_cells,
+    linear_index,
+    members_of,
+    neighbour_pairs,
+    normalize_connectivity,
+    normalize_count,
+    normalize_wrap,
+    number_by_first_cell,
+    offsets_for,
+    row_major_order,
+    step_to,
+    unique_columns,
+    unique_reach,
+)
+
+
+def label(x, /, *, connectivity=1, wrap=False, equal_values=False):
+    """
+    Number the regions of an array.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array to analyse. Its fill value must be zero.
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring cells may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+    equal_values : bool, optional
+        Whether two neighbouring cells join only when they hold the same value.
+        Default: ``False``.
+
+    Returns
+    -------
+    labels : COO
+        Array of the shape of ``x`` holding the region number of every cell.
+    count : int
+        Number of regions.
+
+    Raises
+    ------
+    ValueError
+        If the fill value is not zero, or the connectivity is out of range.
+
+    Examples
+    --------
+    >>> import sparse
+    >>> x = sparse.COO.from_numpy(np.array([1, 1, 0, 0, 2, 0]))
+    >>> labels, count = sparse.regions.label(x)
+    >>> count
+    2
+    >>> labels.todense()
+    array([1, 1, 0, 0, 2, 0])
+    """
+    x, coords, codes, values = cells_of(x)
+    connectivity = normalize_connectivity(connectivity, x.ndim)
+    wrap = normalize_wrap(wrap, x.ndim)
+
+    steps = offsets_for(connectivity, x.ndim)
+    left, right = neighbour_pairs(coords, codes, x.shape, steps, wrap)
+    if equal_values:
+        joined = values[left] == values[right]
+        left, right = left[joined], right[joined]
+
+    roots = components_of(coords.shape[1], left, right)
+    numbers, count = number_by_first_cell(roots)
+
+    labels = COO(
+        coords,
+        numbers,
+        shape=x.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.intp(0),
+    )
+
+    return labels, count
+
+
+def dilate(x, /, *, connectivity=1, wrap=False, iterations=1):
+    """
+    Grow the cells of an array outwards.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array to analyse. Its fill value must be zero.
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring positions may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+    iterations : int, optional
+        Number of neighbour steps to grow by. Default: ``1``.
+
+    Returns
+    -------
+    COO
+        Boolean array holding True at every position within ``iterations``
+        neighbour steps of a cell.
+
+    Raises
+    ------
+    ValueError
+        If the fill value is not zero, the connectivity is out of range, or the
+        iteration count is negative.
+    """
+    x, coords, _, _ = cells_of(x)
+    connectivity = normalize_connectivity(connectivity, x.ndim)
+    wrap = normalize_wrap(wrap, x.ndim)
+    iterations = normalize_count(iterations, "iterations")
+
+    steps = offsets_for(connectivity, x.ndim)
+    steps = np.concatenate([steps, -steps]) if steps.shape[0] else steps
+
+    for _ in range(iterations):
+        if coords.shape[1] == 0:
+            break
+        grown = [coords]
+        for step in steps:
+            moved, inside = step_to(coords, step, x.shape, wrap)
+            grown.append(moved[:, inside])
+        coords = unique_columns(np.concatenate(grown, axis=1))
+
+    return COO(
+        coords,
+        np.ones(coords.shape[1], dtype=np.bool_),
+        shape=x.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.bool_(False),
+    )
+
+
+def erode(x, /, *, connectivity=1, wrap=False, iterations=1):
+    """
+    Shrink the cells of an array inwards.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array to analyse. Its fill value must be zero.
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring positions may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+    iterations : int, optional
+        Number of neighbour steps to shrink by. Default: ``1``.
+
+    Returns
+    -------
+    COO
+        Boolean array holding True at every cell all of whose neighbours are
+        themselves cells, after ``iterations`` rounds.
+
+    Raises
+    ------
+    ValueError
+        If the fill value is not zero, the connectivity is out of range, or the
+        iteration count is negative.
+    """
+    x, coords, codes, _ = cells_of(x)
+    connectivity = normalize_connectivity(connectivity, x.ndim)
+    wrap = normalize_wrap(wrap, x.ndim)
+    iterations = normalize_count(iterations, "iterations")
+
+    steps = offsets_for(connectivity, x.ndim)
+    steps = np.concatenate([steps, -steps]) if steps.shape[0] else steps
+
+    for _ in range(iterations):
+        if coords.shape[1] == 0:
+            break
+        keep = np.ones(coords.shape[1], dtype=np.bool_)
+        for step in steps:
+            moved, inside = step_to(coords, step, x.shape, wrap)
+            found, _ = members_of(linear_index(moved, x.shape), codes)
+            keep &= found & inside
+        coords = np.ascontiguousarray(coords[:, keep])
+        codes = linear_index(coords, x.shape)
+
+    return COO(
+        coords,
+        np.ones(coords.shape[1], dtype=np.bool_),
+        shape=x.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.bool_(False),
+    )
+
+
+def border_distance(x, /, *, connectivity=1, wrap=False):
+    """
+    Number of neighbour steps from every cell to the nearest position that is
+    not a cell.
+
+    A cell that touches a position holding zero is one step away, and so is a
+    cell on the edge of the array along an axis that does not wrap.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array to analyse. Its fill value must be zero.
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring positions may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+
+    Returns
+    -------
+    COO
+        Array of the shape of ``x`` holding the distance of every cell.
+
+    Raises
+    ------
+    ValueError
+        If the fill value is not zero, the connectivity is out of range, or
+        every position of a wrapped array is a cell, which leaves no position
+        for a cell to be a distance from.
+    """
+    x, coords, codes, _ = cells_of(x)
+    connectivity = normalize_connectivity(connectivity, x.ndim)
+    wrap = normalize_wrap(wrap, x.ndim)
+
+    steps = offsets_for(connectivity, x.ndim)
+    steps = np.concatenate([steps, -steps]) if steps.shape[0] else steps
+
+    distance = np.zeros(coords.shape[1], dtype=np.intp)
+    alive = np.arange(coords.shape[1], dtype=np.intp)
+    inner, inner_codes = coords, codes
+    rounds = 0
+
+    while alive.shape[0]:
+        rounds += 1
+        distance[alive] = rounds
+        keep = np.ones(alive.shape[0], dtype=np.bool_)
+        for step in steps:
+            moved, inside = step_to(inner, step, x.shape, wrap)
+            found, _ = members_of(linear_index(moved, x.shape), inner_codes)
+            keep &= found & inside
+        if keep.all():
+            raise ValueError("Every position is a cell and every axis wraps, so no cell has a border.")
+        alive = alive[keep]
+        inner = np.ascontiguousarray(inner[:, keep])
+        inner_codes = linear_index(inner, x.shape)
+
+    return COO(
+        coords,
+        distance,
+        shape=x.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.intp(0),
+    )
+
+
+def region_bounds(labels, /, *, wrap=False):
+    """
+    Smallest index window holding every cell of each region.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    wrap : bool or Iterable[bool], optional
+        Whether a window may run off the end of an axis and continue at its
+        start, either for every axis or one flag per axis. Default: ``False``.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of shape ``(count, ndim, 2)`` holding the first index and the
+        length of the window of every region along every axis.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    wrap = normalize_wrap(wrap, labels.ndim)
+
+    out = np.zeros((count, labels.ndim, 2), dtype=np.intp)
+    if count == 0:
+        return out
+
+    sizes = np.bincount(ids, minlength=count + 1)[1:]
+    group_starts = np.zeros(count, dtype=np.intp)
+    group_starts[1:] = np.cumsum(sizes[:-1])
+
+    for axis, length in enumerate(labels.shape):
+        order = np.lexsort((coords[axis], ids))
+        values = coords[axis][order].astype(np.int64, copy=False)
+        if not wrap[axis]:
+            first = np.minimum.reduceat(values, group_starts)
+            last = np.maximum.reduceat(values, group_starts)
+            out[:, axis, 0] = first
+            out[:, axis, 1] = last - first + 1
+            continue
+
+        gaps = np.empty(values.shape[0], dtype=np.int64)
+        gaps[1:] = values[1:] - values[:-1] - 1
+        gaps[group_starts] = length - 1 - values[group_starts + sizes - 1] + values[group_starts]
+
+        widest = np.maximum.reduceat(gaps, group_starts)
+        candidates = np.where(gaps == np.repeat(widest, sizes), values, np.iinfo(np.int64).max)
+        out[:, axis, 0] = np.minimum.reduceat(candidates, group_starts)
+        out[:, axis, 1] = length - widest
+
+    return out
+
+
+def region_perimeters(labels, /, *, connectivity=1, wrap=False):
+    """
+    Number of exposed sides of every region.
+
+    A side is one pair of a cell of the region and a neighbouring position that
+    is not a cell of the labelling, counting a position off the end of an axis
+    that does not wrap as one of those. A short wrapped axis can send two steps
+    of a cell to the same position, which is one pair and is counted once.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring positions may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of ``count`` side counts.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, or the connectivity is out of range.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    connectivity = normalize_connectivity(connectivity, labels.ndim)
+    wrap = normalize_wrap(wrap, labels.ndim)
+
+    steps = offsets_for(connectivity, labels.ndim)
+    steps = np.concatenate([steps, -steps]) if steps.shape[0] else steps
+    codes = linear_index(coords, labels.shape)
+
+    out = np.zeros(count, dtype=np.intp)
+    owners = []
+    targets = []
+    for step in steps:
+        moved, inside = step_to(coords, step, labels.shape, wrap)
+        found, _ = members_of(linear_index(moved, labels.shape), codes)
+        beyond = np.flatnonzero(~inside)
+        np.add.at(out, ids[beyond] - 1, 1)
+        empty = np.flatnonzero(inside & ~found)
+        if empty.shape[0]:
+            owners.append(empty)
+            targets.append(linear_index(moved[:, empty], labels.shape))
+
+    if not owners:
+        return out
+
+    owner = np.concatenate(owners)
+    target = np.concatenate(targets)
+    order = np.lexsort((target, owner))
+    owner, target = owner[order], target[order]
+    first = np.ones(owner.shape[0], dtype=np.bool_)
+    first[1:] = (owner[1:] != owner[:-1]) | (target[1:] != target[:-1])
+    np.add.at(out, ids[owner[first]] - 1, 1)
+
+    return out
+
+
+def region_counts(labels, /):
+    """
+    Number of cells in every region.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of ``count`` cell counts.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling.
+    """
+    _, _, ids, count = label_cells(labels)
+
+    return np.bincount(ids, minlength=count + 1)[1:].astype(np.intp, copy=False)
+
+
+def region_sums(x, labels, /):
+    """
+    Sum of the values of every region.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array holding the values. Its cells must be the cells of ``labels``.
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of ``count`` sums, of the dtype numpy sums ``x`` in.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, or the two arrays disagree on shape or
+        on which positions are cells.
+    """
+    coords, ids, count, values, dtype = aligned_cells(x, labels)
+    out = np.zeros(count, dtype=dtype)
+    np.add.at(out, ids - 1, values)
+
+    return out
+
+
+def aligned_cells(x, labels):
+    """
+    Read a value array and a label array that have to agree on their cells.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array holding the values.
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+
+    Returns
+    -------
+    coords : numpy.ndarray
+        Cell coordinates of shape ``(ndim, n)``, in row major order.
+    ids : numpy.ndarray
+        Region number of every cell.
+    count : int
+        Number of regions.
+    values : numpy.ndarray
+        Value held by every cell.
+    dtype : numpy.dtype
+        The dtype numpy accumulates ``x`` in.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, or the two arrays disagree on shape or
+        on which positions are cells.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    x, _, codes, values = cells_of(x)
+
+    if x.shape != labels.shape:
+        raise ValueError(f"x has shape {x.shape} but labels has shape {labels.shape}.")
+    if not np.array_equal(codes, linear_index(coords, labels.shape)):
+        raise ValueError("x and labels must hold their cells at the same positions.")
+
+    return coords, ids, count, values, np.zeros(0, dtype=x.dtype).sum().dtype
+
+
+def region_maxima(x, labels, /):
+    """
+    Largest value of every region and where it sits.
+
+    Parameters
+    ----------
+    x : SparseArray
+        Array holding the values. Its cells must be the cells of ``labels``.
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+
+    Returns
+    -------
+    values : numpy.ndarray
+        Array of ``count`` largest values, of the dtype of ``x``.
+    coords : numpy.ndarray
+        Array of shape ``(count, ndim)`` holding, for every region, the first
+        position in row major order that holds its largest value.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, or the two arrays disagree on shape or
+        on which positions are cells.
+    """
+    coords, ids, count, values, _ = aligned_cells(x, labels)
+    if count == 0:
+        return np.zeros(0, dtype=values.dtype), np.zeros((0, coords.shape[0]), dtype=np.intp)
+
+    order = np.argsort(ids, kind="stable")
+    ids, values, coords = ids[order], values[order], coords[:, order]
+    sizes = np.bincount(ids, minlength=count + 1)[1:]
+    group_starts = np.zeros(count, dtype=np.intp)
+    group_starts[1:] = np.cumsum(sizes[:-1])
+
+    largest = np.maximum.reduceat(values, group_starts)
+    holds = values == np.repeat(largest, sizes)
+    positions = np.where(holds, np.arange(values.shape[0]), values.shape[0])
+    first = np.minimum.reduceat(positions, group_starts)
+
+    return largest, np.ascontiguousarray(coords[:, first].T)
+
+
+def region_centroids(labels, /, *, wrap=False):
+    """
+    Mean position of the cells of every region.
+
+    On a wrapped axis the positions are measured from the start of the window
+    reported by [`sparse.regions.region_bounds`][], and the mean is brought back
+    into the axis.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of shape ``(count, ndim)`` holding the mean position of every
+        region along every axis.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    flags = normalize_wrap(wrap, labels.ndim)
+
+    out = np.zeros((count, labels.ndim), dtype=np.float64)
+    if count == 0:
+        return out
+
+    windows = region_bounds(labels, wrap=wrap)
+    sizes = np.bincount(ids, minlength=count + 1)[1:]
+    for axis, length in enumerate(labels.shape):
+        values = coords[axis].astype(np.float64)
+        if flags[axis]:
+            starts = windows[:, axis, 0][ids - 1]
+            values = (values - starts) % length
+        totals = np.zeros(count, dtype=np.float64)
+        np.add.at(totals, ids - 1, values)
+        means = totals / sizes
+        out[:, axis] = (means + windows[:, axis, 0]) % length if flags[axis] else means
+
+    return out
+
+
+def grow_labels(labels, /, *, connectivity=1, wrap=False, iterations=1):
+    """
+    Hand the positions around the regions to their nearest region.
+
+    Every position that is not yet a cell but sits within ``iterations``
+    neighbour steps of one takes the number of the region it can reach in the
+    fewest steps, and the smallest of those numbers when several regions are
+    equally close. Cells keep the number they already carry.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring positions may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+    iterations : int, optional
+        Number of neighbour steps to hand out positions over. Default: ``1``.
+
+    Returns
+    -------
+    labels : COO
+        Array of the shape of the input holding the widened region numbers.
+    count : int
+        Number of regions, which the widening leaves alone.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, the connectivity is out of range, or
+        the iteration count is negative.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    connectivity = normalize_connectivity(connectivity, labels.ndim)
+    wrap = normalize_wrap(wrap, labels.ndim)
+    iterations = normalize_count(iterations, "iterations")
+
+    steps = offsets_for(connectivity, labels.ndim)
+    steps = np.concatenate([steps, -steps]) if steps.shape[0] else steps
+    taken = linear_index(coords, labels.shape)
+    front = coords
+    front_ids = ids
+
+    for _ in range(iterations):
+        if front.shape[1] == 0:
+            break
+        reached = []
+        claims = []
+        for step in steps:
+            moved, inside = step_to(front, step, labels.shape, wrap)
+            moved_codes = linear_index(moved, labels.shape)
+            free, _ = members_of(moved_codes, taken)
+            keep = inside & ~free
+            reached.append(moved[:, keep])
+            claims.append(front_ids[keep])
+        reached = np.concatenate(reached, axis=1)
+        claims = np.concatenate(claims)
+        if reached.shape[1] == 0:
+            break
+
+        reached_codes = linear_index(reached, labels.shape)
+        order = np.lexsort((claims, reached_codes))
+        reached, claims, reached_codes = reached[:, order], claims[order], reached_codes[order]
+        first = np.ones(reached_codes.shape[0], dtype=np.bool_)
+        first[1:] = reached_codes[1:] != reached_codes[:-1]
+
+        front, front_ids = np.ascontiguousarray(reached[:, first]), claims[first]
+        coords = np.concatenate([coords, front], axis=1)
+        ids = np.concatenate([ids, front_ids])
+        taken = np.sort(np.concatenate([taken, reached_codes[first]]))
+
+    order = row_major_order(coords)
+    grown = COO(
+        np.ascontiguousarray(coords[:, order]),
+        ids[order],
+        shape=labels.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.intp(0),
+    )
+
+    return grown, count
+
+
+def merge_within(labels, distance, /, *, connectivity=1, wrap=False):
+    """
+    Put regions that lie close to each other into one region.
+
+    Two regions join when a cell of each lies within ``distance`` neighbour
+    steps of the other, and joining carries through a chain of regions. The
+    result is numbered again from one, in the order of the first cell of every
+    surviving region.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    distance : int
+        Largest number of neighbour steps that still joins two regions.
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring positions may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+
+    Returns
+    -------
+    labels : COO
+        Array of the shape of the input holding the merged region numbers.
+    count : int
+        Number of regions that remain.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, the connectivity is out of range, or
+        the distance is negative.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    connectivity = normalize_connectivity(connectivity, labels.ndim)
+    wrap = normalize_wrap(wrap, labels.ndim)
+    distance = normalize_count(distance, "distance")
+
+    joins_left = []
+    joins_right = []
+    if count and distance:
+        steps = offsets_for(connectivity, labels.ndim)
+        steps = np.concatenate([steps, -steps])
+        codes = linear_index(coords, labels.shape)
+        reach = coords
+        reach_ids = ids
+        for _ in range(distance):
+            grown = []
+            grown_ids = []
+            for step in steps:
+                moved, inside = step_to(reach, step, labels.shape, wrap)
+                grown.append(moved[:, inside])
+                grown_ids.append(reach_ids[inside])
+            reach = np.concatenate(grown, axis=1)
+            reach_ids = np.concatenate(grown_ids)
+            reach, reach_ids = unique_reach(reach, reach_ids, labels.shape)
+            found, where = members_of(linear_index(reach, labels.shape), codes)
+            hit = np.flatnonzero(found)
+            if hit.shape[0]:
+                joins_left.append(reach_ids[hit])
+                joins_right.append(ids[where[hit]])
+
+    if joins_left:
+        left = np.concatenate(joins_left) - 1
+        right = np.concatenate(joins_right) - 1
+    else:
+        left = right = np.empty(0, dtype=np.intp)
+
+    groups = components_of(count, left, right)
+    numbers, merged = number_by_first_cell(groups[ids - 1]) if count else (ids, 0)
+
+    return COO(
+        coords,
+        numbers,
+        shape=labels.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.intp(0),
+    ), merged
+
+
+def filter_regions(labels, /, *, min_count=1):
+    """
+    Drop the regions that hold too few cells.
+
+    The regions that survive are numbered again from one upwards, in the order
+    of the first cell of each of them.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    min_count : int, optional
+        Smallest number of cells a region may hold to survive. Default: ``1``.
+
+    Returns
+    -------
+    labels : COO
+        Array of the shape of the input holding the new region numbers.
+    count : int
+        Number of regions that survived.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, or the count is negative.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    min_count = normalize_count(min_count, "min_count")
+
+    sizes = np.bincount(ids, minlength=count + 1)[1:]
+    keep = (sizes >= min_count)[ids - 1] if count else np.zeros(0, dtype=np.bool_)
+    coords = np.ascontiguousarray(coords[:, keep])
+    numbers, survivors = number_by_first_cell(ids[keep])
+
+    filtered = COO(
+        coords,
+        numbers,
+        shape=labels.shape,
+        has_duplicates=False,
+        sorted=True,
+        fill_value=np.intp(0),
+    )
+
+    return filtered, survivors
+
+
+def region_adjacency(labels, /, *, connectivity=1, wrap=False):
+    """
+    Pairs of regions that hold neighbouring cells.
+
+    Parameters
+    ----------
+    labels : SparseArray
+        Array produced by [`sparse.regions.label`][].
+    connectivity : int, optional
+        Number of axes along which the indices of two neighbouring cells may
+        differ. Default: ``1``.
+    wrap : bool or Iterable[bool], optional
+        Whether the first and last index of an axis are neighbours, either for
+        every axis or one flag per axis. Default: ``False``.
+
+    Returns
+    -------
+    numpy.ndarray
+        Array of shape ``(n_pairs, 2)`` holding the region numbers of every
+        touching pair, smaller number first, sorted.
+
+    Raises
+    ------
+    ValueError
+        If the array is not a labelling, or the connectivity is out of range.
+    """
+    labels, coords, ids, count = label_cells(labels)
+    connectivity = normalize_connectivity(connectivity, labels.ndim)
+    wrap = normalize_wrap(wrap, labels.ndim)
+
+    steps = offsets_for(connectivity, labels.ndim)
+    codes = linear_index(coords, labels.shape)
+    left, right = neighbour_pairs(coords, codes, labels.shape, steps, wrap)
+
+    pairs = np.stack([ids[left], ids[right]])
+    pairs = pairs[:, pairs[0] != pairs[1]]
+    pairs = np.stack([pairs.min(axis=0), pairs.max(axis=0)]) if pairs.shape[1] else pairs
+
+    return np.ascontiguousarray(unique_columns(pairs).T.astype(np.intp, copy=False)).reshape(-1, 2)
