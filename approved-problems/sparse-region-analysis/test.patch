+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  REPORT="--junitxml=$OUTPUT_PATH"
+else
+  REPORT=""
+fi
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TESTS="sparse/numba_backend/tests/test_regions_1d0920.py"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -q --no-cov -p no:cacheprovider $REPORT
+else
+  # test_reductions_float16 is marked xfail by the repo and draws unseeded random
+  # data, so it flips between xfail and xpass from run to run. It never fails, but
+  # dropping it keeps the baseline report identical across runs.
+  PARALLEL=""
+  if python -c "import xdist" >/dev/null 2>&1; then
+    PARALLEL="-n 4"
+  fi
+  python -m pytest sparse -q --no-cov -p no:cacheprovider $PARALLEL --ignore="$NEW_TESTS" \
+    --deselect sparse/numba_backend/tests/test_coo.py::test_reductions_float16 \
+    --deselect sparse/numba_backend/tests/test_compressed.py::test_reductions_float16 \
+    $REPORT
+fi
