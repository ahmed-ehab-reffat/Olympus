+import sparse
+
+import pytest
+
+import numpy as np
+from numpy.testing import assert_array_equal
+
+LINE = np.array([1, 1, 0, 0, 2, 0])
+DIAGONAL = np.array([[1, 0, 0], [0, 2, 0], [0, 0, 3]])
+BLOCK = np.array([[1, 1, 0], [1, 1, 0], [0, 0, 5]])
+RING = np.array([[1, 1, 1], [1, 0, 1], [1, 1, 1]])
+SEAM = np.array([[1, 0, 0, 1], [0, 0, 0, 0]])
+PLATEAU = np.array([1, 1, 2, 2, 1])
+SOLID = np.ones((5, 5), dtype=np.int64)
+CROSS = np.array([[1, 0, 1], [0, 1, 0], [1, 0, 1]])
+
+
+def coo(dense):
+    return sparse.COO.from_numpy(np.asarray(dense))
+
+
+def live(result):
+    return int((result != result.fill_value).sum())
+
+
+def labels_of(dense, **kwargs):
+    return sparse.regions.label(coo(dense), **kwargs)
+
+
+def test_label_one_dimensional_splits_on_gap():
+    labels, count = labels_of(LINE)
+    assert count == 2
+    assert_array_equal(labels.todense(), [1, 1, 0, 0, 2, 0])
+
+
+def test_label_returns_zero_at_positions_that_are_not_cells():
+    labels, _ = labels_of(LINE)
+    assert labels.fill_value == 0
+    assert live(labels) == 3
+
+
+def test_label_dtype_is_integer():
+    labels, _ = labels_of(LINE)
+    assert labels.dtype.kind in "iu"
+
+
+def test_label_shape_follows_the_input():
+    labels, _ = labels_of(BLOCK)
+    assert labels.shape == (3, 3)
+
+
+def test_label_diagonal_is_three_regions_at_connectivity_one():
+    labels, count = labels_of(DIAGONAL)
+    assert count == 3
+    assert_array_equal(labels.todense(), [[1, 0, 0], [0, 2, 0], [0, 0, 3]])
+
+
+def test_label_diagonal_is_one_region_at_connectivity_two():
+    labels, count = labels_of(DIAGONAL, connectivity=2)
+    assert count == 1
+    assert_array_equal(labels.todense(), [[1, 0, 0], [0, 1, 0], [0, 0, 1]])
+
+
+def test_label_block_and_corner_stay_apart_at_connectivity_one():
+    labels, count = labels_of(BLOCK)
+    assert count == 2
+    assert_array_equal(labels.todense(), [[1, 1, 0], [1, 1, 0], [0, 0, 2]])
+
+
+def test_label_numbers_regions_by_their_first_cell_in_row_major_order():
+    dense = np.array([[0, 0, 9], [7, 0, 9], [7, 0, 0]])
+    labels, count = labels_of(dense)
+    assert count == 2
+    assert_array_equal(labels.todense(), [[0, 0, 1], [2, 0, 1], [2, 0, 0]])
+
+
+def test_label_numbering_follows_position_not_discovery_order():
+    dense = np.array([[0, 5, 0, 0], [4, 5, 0, 6], [4, 0, 0, 6]])
+    labels, count = labels_of(dense)
+    assert count == 2
+    assert_array_equal(labels.todense(), [[0, 1, 0, 0], [1, 1, 0, 2], [1, 0, 0, 2]])
+
+
+def test_label_numbers_an_enclosing_region_before_the_one_it_encloses():
+    dense = np.zeros((5, 5), dtype=np.int64)
+    dense[0, :] = 1
+    dense[4, :] = 1
+    dense[:, 0] = 1
+    dense[:, 4] = 1
+    dense[2, 2] = 1
+    labels, count = labels_of(dense)
+    assert count == 2
+    assert labels.todense()[0, 0] == 1
+    assert labels.todense()[2, 2] == 2
+
+
+def test_label_three_dimensional_faces_join_at_connectivity_one():
+    dense = np.zeros((2, 2, 2), dtype=np.int64)
+    dense[0, 0, 0] = 1
+    dense[1, 0, 0] = 1
+    dense[1, 1, 1] = 1
+    labels, count = labels_of(dense)
+    assert count == 2
+    assert_array_equal(labels.todense()[:, 0, 0], [1, 1])
+    assert labels.todense()[1, 1, 1] == 2
+
+
+def test_label_three_dimensional_body_diagonal_joins_at_connectivity_three():
+    dense = np.zeros((2, 2, 2), dtype=np.int64)
+    dense[0, 0, 0] = 1
+    dense[1, 1, 1] = 1
+    assert labels_of(dense, connectivity=3)[1] == 1
+    assert labels_of(dense, connectivity=2)[1] == 2
+
+
+def test_label_ignores_a_stored_zero():
+    x = sparse.COO(np.array([[0, 1, 2]]), np.array([5, 0, 7]), shape=(3,), fill_value=0)
+    labels, count = sparse.regions.label(x)
+    assert count == 2
+    assert_array_equal(labels.todense(), [1, 0, 2])
+
+
+def test_label_of_an_array_without_cells_finds_nothing():
+    labels, count = labels_of(np.zeros((3, 3), dtype=np.int64))
+    assert count == 0
+    assert live(labels) == 0
+
+
+def test_label_accepts_a_compressed_array():
+    x = sparse.GCXS.from_numpy(BLOCK)
+    labels, count = sparse.regions.label(x)
+    assert count == 2
+    assert_array_equal(labels.todense(), [[1, 1, 0], [1, 1, 0], [0, 0, 2]])
+
+
+def test_label_accepts_a_dok_array():
+    x = sparse.DOK.from_numpy(BLOCK)
+    assert sparse.regions.label(x)[1] == 2
+
+
+def test_label_rejects_a_non_zero_fill_value():
+    assert labels_of(BLOCK)[1] == 2
+    with pytest.raises(ValueError):
+        sparse.regions.label(sparse.full((3, 3), 1.0))
+
+
+def test_label_rejects_connectivity_below_one():
+    assert labels_of(BLOCK, connectivity=1)[1] == 2
+    with pytest.raises(ValueError):
+        labels_of(BLOCK, connectivity=0)
+
+
+def test_label_rejects_connectivity_above_the_rank():
+    assert labels_of(BLOCK, connectivity=2)[1] == 1
+    with pytest.raises(ValueError):
+        labels_of(BLOCK, connectivity=3)
+
+
+def test_label_rejects_a_connectivity_that_is_not_an_integer():
+    assert labels_of(BLOCK, connectivity=1)[1] == 2
+    with pytest.raises(ValueError):
+        labels_of(BLOCK, connectivity=1.5)
+
+
+def test_label_rejects_a_wrap_sequence_of_the_wrong_length():
+    assert labels_of(BLOCK, wrap=[True, True])[1] == 2
+    with pytest.raises(ValueError):
+        labels_of(BLOCK, wrap=[True])
+
+
+def test_label_rejects_a_wrap_sequence_that_is_not_boolean():
+    assert labels_of(BLOCK, wrap=[False, False])[1] == 2
+    with pytest.raises(ValueError):
+        labels_of(BLOCK, wrap=[1, 0])
+
+
+def test_label_joins_across_the_seam_when_the_axis_wraps():
+    labels, count = labels_of(SEAM, wrap=True)
+    assert count == 1
+    assert_array_equal(labels.todense(), [[1, 0, 0, 1], [0, 0, 0, 0]])
+
+
+def test_label_keeps_the_seam_apart_without_wrap():
+    assert labels_of(SEAM)[1] == 2
+
+
+def test_label_wraps_only_the_axes_that_are_flagged():
+    assert labels_of(SEAM, wrap=[True, False])[1] == 2
+    assert labels_of(SEAM, wrap=[False, True])[1] == 1
+
+
+def test_label_on_a_length_two_wrapped_axis_joins_once():
+    dense = np.array([1, 1])
+    labels, count = labels_of(dense, wrap=True)
+    assert count == 1
+    assert_array_equal(labels.todense(), [1, 1])
+
+
+def test_label_with_equal_values_splits_a_plateau():
+    labels, count = labels_of(PLATEAU, equal_values=True)
+    assert count == 3
+    assert_array_equal(labels.todense(), [1, 1, 2, 2, 3])
+
+
+def test_label_without_equal_values_keeps_a_plateau_together():
+    assert labels_of(PLATEAU)[1] == 1
+
+
+def test_label_with_equal_values_and_wrap_joins_matching_ends():
+    labels, count = labels_of(PLATEAU, equal_values=True, wrap=True)
+    assert count == 2
+    assert_array_equal(labels.todense(), [1, 1, 2, 2, 1])
+
+
+def test_region_counts_reports_cells_per_region():
+    labels, _ = labels_of(BLOCK)
+    assert_array_equal(sparse.regions.region_counts(labels), [4, 1])
+
+
+def test_region_counts_of_an_empty_labelling_is_empty():
+    labels, _ = labels_of(np.zeros((2, 2), dtype=np.int64))
+    assert sparse.regions.region_counts(labels).shape == (0,)
+
+
+def test_region_sums_adds_the_values_of_each_region():
+    x = coo(BLOCK)
+    labels, _ = sparse.regions.label(x)
+    assert_array_equal(sparse.regions.region_sums(x, labels), [4, 5])
+
+
+def test_region_sums_of_a_float_array_keeps_the_float_dtype():
+    x = coo(np.array([[1.5, 2.5, 0.0]], dtype=np.float32))
+    labels, _ = sparse.regions.label(x)
+    sums = sparse.regions.region_sums(x, labels)
+    assert sums.dtype == np.float32
+    assert_array_equal(sums, np.array([4.0], dtype=np.float32))
+
+
+def test_region_sums_of_a_boolean_array_counts_in_the_numpy_sum_dtype():
+    x = coo(np.array([True, True, False]))
+    labels, _ = sparse.regions.label(x)
+    sums = sparse.regions.region_sums(x, labels)
+    assert sums.dtype == np.zeros(0, dtype=np.bool_).sum().dtype
+    assert_array_equal(sums, [2])
+
+
+def test_region_sums_ignores_a_stored_zero_in_both_arrays():
+    x = sparse.COO(np.array([[0, 1, 2]]), np.array([5, 0, 7]), shape=(3,), fill_value=0)
+    labels, _ = sparse.regions.label(x)
+    assert_array_equal(sparse.regions.region_sums(x, labels), [5, 7])
+
+
+def test_region_sums_rejects_a_shape_mismatch():
+    labels, _ = labels_of(BLOCK)
+    assert_array_equal(sparse.regions.region_sums(coo(BLOCK), labels), [4, 5])
+    with pytest.raises(ValueError):
+        sparse.regions.region_sums(coo(np.ones((2, 2), dtype=np.int64)), labels)
+
+
+def test_region_sums_rejects_cells_at_other_positions():
+    labels, _ = labels_of(BLOCK)
+    assert_array_equal(sparse.regions.region_sums(coo(BLOCK), labels), [4, 5])
+    other = np.zeros((3, 3), dtype=np.int64)
+    other[0, 0] = 1
+    with pytest.raises(ValueError):
+        sparse.regions.region_sums(coo(other), labels)
+
+
+def test_region_maxima_returns_the_largest_value_of_each_region():
+    x = coo(np.array([[3, 7, 0], [0, 4, 0], [0, 0, 9]]))
+    labels, _ = sparse.regions.label(x)
+    values, positions = sparse.regions.region_maxima(x, labels)
+    assert_array_equal(values, [7, 9])
+    assert_array_equal(positions, [[0, 1], [2, 2]])
+
+
+def test_region_maxima_breaks_a_tie_by_row_major_order():
+    x = coo(np.array([[0, 5, 0], [5, 5, 0], [0, 0, 0]]))
+    labels, _ = sparse.regions.label(x)
+    values, positions = sparse.regions.region_maxima(x, labels)
+    assert_array_equal(values, [5])
+    assert_array_equal(positions, [[0, 1]])
+
+
+def test_region_maxima_keeps_the_dtype_of_the_values():
+    x = coo(np.array([1.5, 0.0, 2.5], dtype=np.float32))
+    labels, _ = sparse.regions.label(x)
+    values, _ = sparse.regions.region_maxima(x, labels)
+    assert values.dtype == np.float32
+
+
+def test_region_maxima_of_an_empty_labelling_is_empty():
+    x = coo(np.zeros((2, 3), dtype=np.int64))
+    labels, _ = sparse.regions.label(x)
+    values, positions = sparse.regions.region_maxima(x, labels)
+    assert values.shape == (0,)
+    assert positions.shape == (0, 2)
+
+
+def test_region_bounds_covers_each_region():
+    labels, _ = labels_of(BLOCK)
+    assert_array_equal(sparse.regions.region_bounds(labels), [[[0, 2], [0, 2]], [[2, 1], [2, 1]]])
+
+
+def test_region_bounds_shape_is_regions_by_axes_by_two():
+    labels, _ = labels_of(DIAGONAL)
+    assert sparse.regions.region_bounds(labels).shape == (3, 2, 2)
+
+
+def test_region_bounds_of_a_spread_region_spans_the_gap():
+    labels, _ = labels_of(RING)
+    assert_array_equal(sparse.regions.region_bounds(labels), [[[0, 3], [0, 3]]])
+
+
+def test_region_bounds_wraps_a_region_that_crosses_the_seam():
+    labels, count = labels_of(SEAM, wrap=True)
+    assert count == 1
+    assert_array_equal(sparse.regions.region_bounds(labels, wrap=True)[0, 1], [3, 2])
+
+
+def test_region_bounds_without_wrap_measures_the_long_way_round():
+    labels, _ = labels_of(SEAM, wrap=True)
+    assert_array_equal(sparse.regions.region_bounds(labels)[0, 1], [0, 4])
+
+
+def test_region_bounds_covering_a_whole_wrapped_axis_starts_at_zero():
+    labels, _ = labels_of(np.array([1, 1, 1, 1]), wrap=True)
+    assert_array_equal(sparse.regions.region_bounds(labels, wrap=True)[0, 0], [0, 4])
+
+
+def test_region_bounds_breaks_a_tie_by_the_smallest_first_index():
+    labels = sparse.COO(np.array([[0, 0], [0, 2]]), np.array([1, 1]), shape=(1, 4), fill_value=0)
+    assert_array_equal(sparse.regions.region_bounds(labels, wrap=True)[0, 1], [0, 3])
+
+
+def test_region_bounds_wraps_only_the_flagged_axis():
+    labels, _ = labels_of(SEAM, wrap=True)
+    assert_array_equal(sparse.regions.region_bounds(labels, wrap=[True, False])[0, 1], [0, 4])
+
+
+def test_region_centroids_average_the_positions():
+    labels, _ = labels_of(BLOCK)
+    assert_array_equal(sparse.regions.region_centroids(labels), [[0.5, 0.5], [2.0, 2.0]])
+
+
+def test_region_centroids_of_a_wrapped_region_sit_on_the_seam():
+    labels, _ = labels_of(SEAM, wrap=True)
+    centroids = sparse.regions.region_centroids(labels, wrap=True)
+    assert_array_equal(centroids, [[0.0, 3.5]])
+
+
+def test_region_centroids_without_wrap_average_the_raw_indices():
+    labels, _ = labels_of(SEAM, wrap=True)
+    assert_array_equal(sparse.regions.region_centroids(labels), [[0.0, 1.5]])
+
+
+def test_region_centroids_of_an_empty_labelling_is_empty():
+    labels, _ = labels_of(np.zeros((2, 2), dtype=np.int64))
+    assert sparse.regions.region_centroids(labels).shape == (0, 2)
+
+
+def test_region_perimeters_counts_the_exposed_sides():
+    labels, _ = labels_of(BLOCK)
+    assert_array_equal(sparse.regions.region_perimeters(labels), [8, 4])
+
+
+def test_region_perimeters_counts_diagonal_sides_at_connectivity_two():
+    labels, _ = labels_of(np.array([[0, 0, 0], [0, 1, 0], [0, 0, 0]]))
+    assert_array_equal(sparse.regions.region_perimeters(labels, connectivity=2), [8])
+
+
+def test_region_perimeters_drop_when_an_axis_wraps():
