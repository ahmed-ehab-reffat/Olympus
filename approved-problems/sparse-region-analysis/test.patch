+def many_cells(pairs=100000):
+    k = np.arange(pairs, dtype=np.int64)
+    first = np.stack([(k // 10000) * 3 + 1, ((k % 10000) // 100) * 3 + 1, (k % 100) * 7 + 1])
+    coords = np.empty((3, 2 * pairs), dtype=np.int64)
+    coords[:, 0::2] = first
+    coords[:, 1::2] = first + np.array([[0], [0], [1]])
+    return sparse.COO(coords, np.ones(2 * pairs, dtype=np.int64), shape=(100000, 100000, 100000), fill_value=0)
+
