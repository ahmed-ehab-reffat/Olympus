+def test_dilate_grows_by_one_step():
+    result = sparse.regions.dilate(coo(np.array([0, 1, 0, 0, 0])))
+    assert_array_equal(result.todense(), [True, True, True, False, False])
+
+
+def test_dilate_returns_a_boolean_array():
+    result = sparse.regions.dilate(coo(LINE))
+    assert result.dtype == np.bool_
+    assert result.fill_value == np.bool_(False)
+
+
+def test_dilate_with_zero_iterations_keeps_the_cells():
+    result = sparse.regions.dilate(coo(LINE), iterations=0)
+    assert_array_equal(result.todense(), LINE != 0)
+
+
+def test_dilate_twice_reaches_two_steps():
+    result = sparse.regions.dilate(coo(np.array([0, 0, 1, 0, 0])), iterations=2)
+    assert_array_equal(result.todense(), [True] * 5)
+
+
+def test_dilate_twice_at_connectivity_one_makes_a_diamond_not_a_square():
+    dense = np.zeros((5, 5), dtype=np.int64)
+    dense[2, 2] = 1
+    result = sparse.regions.dilate(coo(dense), iterations=2).todense()
+    assert result[0, 2]
+    assert result[1, 1]
+    assert not result[0, 1]
+    assert not result[0, 0]
+
+
+def test_dilate_at_connectivity_two_fills_the_square():
+    dense = np.zeros((5, 5), dtype=np.int64)
+    dense[2, 2] = 1
+    result = sparse.regions.dilate(coo(dense), connectivity=2).todense()
+    assert result[1, 1]
+    assert result[3, 3]
+    assert not result[0, 0]
+
+
+def test_dilate_stops_at_the_edge_without_wrap():
+    result = sparse.regions.dilate(coo(np.array([1, 0, 0, 0])))
+    assert_array_equal(result.todense(), [True, True, False, False])
+
+
+def test_dilate_crosses_the_seam_with_wrap():
+    result = sparse.regions.dilate(coo(np.array([1, 0, 0, 0])), wrap=True)
+    assert_array_equal(result.todense(), [True, True, False, True])
+
+
+def test_dilate_of_an_array_without_cells_stays_empty():
+    result = sparse.regions.dilate(coo(np.zeros((3, 3), dtype=np.int64)), iterations=3)
+    assert live(result) == 0
+
+
+def test_dilate_rejects_a_negative_iteration_count():
+    assert live(sparse.regions.dilate(coo(LINE), iterations=0)) == 3
+    with pytest.raises(ValueError):
+        sparse.regions.dilate(coo(LINE), iterations=-1)
