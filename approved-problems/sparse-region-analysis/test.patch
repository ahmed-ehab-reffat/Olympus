+    assert int(sparse.regions.region_perimeters(labels).sum()) == 1000000
+    assert live(sparse.regions.dilate(x)) == 1200000
+    distance = sparse.regions.border_distance(x)
+    assert live(distance) == 200000
+    assert int(distance.sum()) == 200000
+    assert sparse.regions.merge_within(labels, 1)[1] == 100000
