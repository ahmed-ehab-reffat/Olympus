+def test_hundreds_of_thousands_of_cells_are_labelled():
+    x = many_cells()
+    labels, count = sparse.regions.label(x)
+    assert count == 100000
+    counts = sparse.regions.region_counts(labels)
+    assert counts.shape == (100000,)
+    assert int(counts.sum()) == 200000
+    assert int(counts.min()) == 2
+    assert int(counts.max()) == 2
