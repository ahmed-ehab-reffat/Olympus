+def test_border_distance_counts_steps_to_the_nearest_empty_position():
+    result = sparse.regions.border_distance(coo(SOLID)).todense()
+    assert_array_equal(result[0], [1, 1, 1, 1, 1])
+    assert_array_equal(result[2], [1, 2, 3, 2, 1])
+
+
+def test_border_distance_is_one_beside_a_hole():
+    result = sparse.regions.border_distance(coo(RING)).todense()
+    assert_array_equal(result, [[1, 1, 1], [1, 0, 1], [1, 1, 1]])
