+
+def test_border_distance_agrees_with_repeated_erosion():
+    x = coo(SOLID)
+    distance = sparse.regions.border_distance(x).todense()
+    for rounds in (1, 2, 3):
+        assert_array_equal(sparse.regions.erode(x, iterations=rounds).todense(), distance > rounds)
