+class WidthDownConverter(wiring.Component):
+    """Converts a stream of wide payloads into a stream of narrow payloads.
+
+    Each input payload of ``width`` bits is split into ``factor`` output payloads of
+    ``width // factor`` bits each, least-significant slice first. The bit sequence carried by the
+    stream is preserved exactly: concatenating every output payload (in order, each in its own bit
+    positions) reproduces the concatenation of every input payload. No payload is ever dropped or
+    duplicated regardless of when the sink deasserts ``ready`` or the source deasserts ``valid``,
+    and the converter sustains one output transfer per cycle when both peers keep the stream moving.
+
+    Parameters
+    ----------
+    width : int
+        Bit width of the input payload. Must be a positive multiple of ``factor``.
+    factor : int
+        Number of output payloads produced per input payload. Must be at least 1.
+    """
+    def __init__(self, width, factor):
+        if factor < 1:
+            raise ValueError(f"Conversion factor must be a positive integer, not {factor!r}")
+        if width < 1 or width % factor != 0:
+            raise ValueError(f"Input width must be a positive multiple of the conversion factor "
+                             f"{factor}, not {width!r}")
+        self._width = width
+        self._factor = factor
+        self._part = width // factor
+        super().__init__({
+            "i_stream": In(Signature(width)),
+            "o_stream": Out(Signature(width // factor)),
+        })
+
+    @property
+    def width(self):
+        return self._width
+
+    @property
+    def factor(self):
+        return self._factor
+
+    def elaborate(self, platform):
+        m = Module()
+
+        shreg = Signal(self._width)
+        count = Signal(range(self._factor + 1))
+
+        do_recv = Signal()
+        do_send = Signal()
+        m.d.comb += [
+            do_send.eq(self.o_stream.valid & self.o_stream.ready),
+            do_recv.eq(self.i_stream.valid & self.i_stream.ready),
+        ]
+
+        m.d.comb += [
+            self.o_stream.valid.eq(count != 0),
+            self.o_stream.payload.eq(shreg[:self._part]),
+            # Accept a new word when the shift register is empty, or on the very cycle its last
+            # slice is being taken, so back-to-back words flow without a bubble.
+            self.i_stream.ready.eq((count == 0) | ((count == 1) & self.o_stream.ready)),
+        ]
+
+        with m.If(do_recv):
+            m.d.sync += shreg.eq(self.i_stream.payload)
+            m.d.sync += count.eq(self._factor)
+        with m.Elif(do_send):
+            m.d.sync += shreg.eq(shreg[self._part:])
+            m.d.sync += count.eq(count - 1)
+
+        return m
+
+
+class WidthUpConverter(wiring.Component):
+    """Converts a stream of narrow payloads into a stream of wide payloads.
+
+    Each group of ``factor`` input payloads of ``width // factor`` bits is packed into one output
+    payload of ``width`` bits, least-significant slice first. The bit sequence carried by the stream
+    is preserved exactly: concatenating every output payload reproduces the concatenation of every
+    input payload. No payload is ever dropped or duplicated regardless of the ``valid``/``ready``
+    timing, and the converter sustains one input transfer per cycle when the stream keeps moving.
+
+    Parameters
+    ----------
+    width : int
+        Bit width of the output payload. Must be a positive multiple of ``factor``.
+    factor : int
+        Number of input payloads consumed per output payload. Must be at least 1.
+    """
+    def __init__(self, width, factor):
+        if factor < 1:
+            raise ValueError(f"Conversion factor must be a positive integer, not {factor!r}")
+        if width < 1 or width % factor != 0:
+            raise ValueError(f"Output width must be a positive multiple of the conversion factor "
+                             f"{factor}, not {width!r}")
+        self._width = width
+        self._factor = factor
+        self._part = width // factor
+        super().__init__({
+            "i_stream": In(Signature(width // factor)),
+            "o_stream": Out(Signature(width)),
+        })
+
+    @property
+    def width(self):
+        return self._width
+
+    @property
+    def factor(self):
+        return self._factor
+
+    def elaborate(self, platform):
+        m = Module()
+
+        shreg = Signal(self._width)
+        count = Signal(range(self._factor + 1))
+
+        do_recv = Signal()
+        do_send = Signal()
+        m.d.comb += [
+            do_send.eq(self.o_stream.valid & self.o_stream.ready),
+            do_recv.eq(self.i_stream.valid & self.i_stream.ready),
+        ]
+
+        m.d.comb += [
+            self.o_stream.valid.eq(count == self._factor),
+            self.o_stream.payload.eq(shreg),
+            # Accept a new word while the accumulator is not full, or on the very cycle the full
+            # word is being taken, so back-to-back groups flow without a bubble.
+            self.i_stream.ready.eq((count != self._factor) | self.o_stream.ready),
+        ]
+
+        # Latch the just-emitted state so that a receive coinciding with a send starts a fresh group.
+        emitted = Signal()
+        m.d.comb += emitted.eq(do_send)
+
+        with m.If(do_recv):
+            with m.If(emitted):
+                m.d.sync += shreg.eq(self.i_stream.payload)
+                m.d.sync += count.eq(1)
+            with m.Else():
+                m.d.sync += shreg.eq(shreg | (self.i_stream.payload.as_unsigned() << (count * self._part)))
+                m.d.sync += count.eq(count + 1)
+        with m.Elif(do_send):
+            m.d.sync += shreg.eq(0)
+            m.d.sync += count.eq(0)
+
+        return m
+
+
+class Gearbox(wiring.Component):
+    """Converts between arbitrary payload widths while preserving the bit stream.
+
+    The concatenation of every input payload (least-significant bit first) equals the concatenation
+    of every output payload. Input words of ``i_width`` bits are buffered and repacked into output
+    words of ``o_width`` bits; the two widths need not divide one another. No bit is ever dropped or
+    duplicated regardless of the ``valid``/``ready`` timing, and the gearbox sustains full throughput
+    on whichever side is narrower.
+
+    Parameters
+    ----------
+    i_width : int
+        Bit width of the input payload. Must be at least 1.
+    o_width : int
+        Bit width of the output payload. Must be at least 1.
+    """
+    def __init__(self, i_width, o_width):
+        if i_width < 1 or o_width < 1:
+            raise ValueError(f"Widths must be positive integers, not {i_width!r} and {o_width!r}")
+        self._iw = i_width
+        self._ow = o_width
+        self._cap = i_width + o_width
+        super().__init__({
+            "i_stream": In(Signature(i_width)),
+            "o_stream": Out(Signature(o_width)),
+        })
+
+    @property
+    def i_width(self):
+        return self._iw
+
+    @property
+    def o_width(self):
+        return self._ow
+
+    def elaborate(self, platform):
+        m = Module()
+        cap = self._cap
+
+        buf = Signal(cap)
+        level = Signal(range(cap + 1))
+
+        do_send = Signal()
+        do_recv = Signal()
+        m.d.comb += [
+            self.o_stream.valid.eq(level >= self._ow),
+            self.o_stream.payload.eq(buf[:self._ow]),
+            do_send.eq(self.o_stream.valid & self.o_stream.ready),
+        ]
+        # Room to accept, accounting for a slice leaving this same cycle.
+        level_after_send = Signal(range(cap + 1))
+        m.d.comb += level_after_send.eq(level - Mux(do_send, self._ow, 0))
+        m.d.comb += self.i_stream.ready.eq(level_after_send <= cap - self._iw)
+        m.d.comb += do_recv.eq(self.i_stream.valid & self.i_stream.ready)
+
+        shifted = Signal(cap)
+        m.d.comb += shifted.eq(Mux(do_send, buf >> self._ow, buf))
+        with m.If(do_recv):
+            m.d.sync += buf.eq(shifted | (self.i_stream.payload.as_unsigned() << level_after_send))
+            m.d.sync += level.eq(level_after_send + self._iw)
+        with m.Elif(do_send):
+            m.d.sync += buf.eq(shifted)
+            m.d.sync += level.eq(level_after_send)
+
+        return m
+
+
+def _check_payload_shape(payload_shape):
+    if isinstance(payload_shape, int) and payload_shape < 1:
+        raise ValueError(f"Payload width must be a positive integer, not {payload_shape!r}")
+
