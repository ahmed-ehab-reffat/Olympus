+class SkidBuffer(wiring.Component):
+    """A two-slot elastic buffer that registers its outputs without losing throughput.
+
+    Every payload arriving on the input stream appears, in order, on the output stream. The output
+    ``payload``, ``valid`` and input ``ready`` are all driven from registers, breaking the
+    combinational path between the two peers, yet the buffer still accepts and emits one payload per
+    cycle when the stream keeps moving. When the sink deasserts ``ready`` while a payload is already
+    latched, the next arriving payload is captured in the skid slot instead of being lost.
+
+    Parameters
+    ----------
+    payload_shape : :class:`~.hdl.ShapeLike`
+        Shape of the payload member.
+    """
+    def __init__(self, payload_shape):
+        _check_payload_shape(payload_shape)
+        self._payload_shape = payload_shape
+        super().__init__({
+            "i_stream": In(Signature(payload_shape)),
+            "o_stream": Out(Signature(payload_shape)),
+        })
+
+    def elaborate(self, platform):
+        m = Module()
+
+        skid = Signal.like(self.o_stream.payload)
+        skid_valid = Signal()
+
+        m.d.comb += self.i_stream.ready.eq(~skid_valid)
+        do_recv = Signal()
+        m.d.comb += do_recv.eq(self.i_stream.valid & self.i_stream.ready)
+
+        with m.If(self.o_stream.ready | ~self.o_stream.valid):
+            with m.If(skid_valid):
+                m.d.sync += self.o_stream.payload.eq(skid)
+                m.d.sync += self.o_stream.valid.eq(1)
+                m.d.sync += skid_valid.eq(0)
+            with m.Elif(do_recv):
+                m.d.sync += self.o_stream.payload.eq(self.i_stream.payload)
+                m.d.sync += self.o_stream.valid.eq(1)
+            with m.Else():
+                m.d.sync += self.o_stream.valid.eq(0)
+        with m.Elif(do_recv):
+            m.d.sync += skid.eq(self.i_stream.payload)
+            m.d.sync += skid_valid.eq(1)
+
+        return m
+
+
+class Arbiter(wiring.Component):
+    """Merges several input streams into one output stream using round-robin arbitration.
+
+    Every cycle the arbiter serves one input whose payload is available, starting the search from
+    the input just after the one served last so that no input is starved (work-conserving round
+    robin). The payloads of each input appear on the output in that input's original order, every
+    input payload appears exactly once, and none is dropped or duplicated regardless of the
+    ``valid``/``ready`` timing.
+
+    Parameters
+    ----------
+    payload_shape : :class:`~.hdl.ShapeLike`
+        Shape of the payload member.
+    count : int
+        Number of input streams. Must be at least 1.
+    """
+    def __init__(self, payload_shape, count):
+        _check_payload_shape(payload_shape)
+        if count < 1:
+            raise ValueError(f"Input count must be a positive integer, not {count!r}")
+        self._payload_shape = payload_shape
+        self._count = count
+        super().__init__({
+            "i_streams": In(Signature(payload_shape)).array(count),
+            "o_stream": Out(Signature(payload_shape)),
+        })
+
+    @property
+    def count(self):
+        return self._count
+
+    def elaborate(self, platform):
+        m = Module()
+        count = self._count
+
+        grant = Signal(range(count))
+        valids = Array([s.valid for s in self.i_streams])
+        payloads = Array([Value.cast(s.payload) for s in self.i_streams])
+
+        sel = Signal(range(count))
+        any_valid = Signal()
+        m.d.comb += [sel.eq(grant), any_valid.eq(0)]
+        # Assign in decreasing offset order so the smallest offset from `grant` wins.
+        for offset in reversed(range(count)):
+            cand = Signal(range(count), name=f"cand{offset}")
+            raw = grant + offset
+            m.d.comb += cand.eq(Mux(raw >= count, raw - count, raw))
+            with m.If(valids[cand]):
+                m.d.comb += sel.eq(cand)
+                m.d.comb += any_valid.eq(1)
+
+        m.d.comb += [
+            self.o_stream.valid.eq(any_valid),
+            Value.cast(self.o_stream.payload).eq(payloads[sel]),
+        ]
+        for k in range(count):
+            m.d.comb += self.i_streams[k].ready.eq((sel == k) & any_valid & self.o_stream.ready)
+
+        with m.If(any_valid & self.o_stream.ready):
+            m.d.sync += grant.eq(Mux(sel == count - 1, 0, sel + 1))
+
+        return m
+
+
+class Demux(wiring.Component):
+    """Routes one input stream to one of several output streams selected by ``select``.
+
+    Each input payload is delivered to the output stream indicated by ``select`` at the time the
+    payload is accepted, and to no other output. Backpressure comes only from the selected output:
+    the input is accepted exactly when the selected output is ready. Payloads routed to a given
+    output appear there in the order they were accepted, and none is dropped or duplicated.
+
+    Parameters
+    ----------
+    payload_shape : :class:`~.hdl.ShapeLike`
+        Shape of the payload member.
+    count : int
+        Number of output streams. Must be at least 1.
+    """
+    def __init__(self, payload_shape, count):
+        _check_payload_shape(payload_shape)
+        if count < 1:
+            raise ValueError(f"Output count must be a positive integer, not {count!r}")
+        self._payload_shape = payload_shape
+        self._count = count
+        super().__init__({
+            "i_stream": In(Signature(payload_shape)),
+            "select": In(range(count)),
+            "o_streams": Out(Signature(payload_shape)).array(count),
+        })
+
+    @property
+    def count(self):
+        return self._count
+
+    def elaborate(self, platform):
+        m = Module()
+
+        readies = Array([s.ready for s in self.o_streams])
+        for k in range(self._count):
+            m.d.comb += [
+                self.o_streams[k].payload.eq(self.i_stream.payload),
+                self.o_streams[k].valid.eq(self.i_stream.valid & (self.select == k)),
+            ]
+        m.d.comb += self.i_stream.ready.eq(readies[self.select])
+
+        return m
+
+
+class Fork(wiring.Component):
+    """Broadcasts one input stream to several output streams.
+
+    Every input payload is delivered to all outputs. Each output applies backpressure
+    independently: an output that is ready accepts the current payload immediately, while the input
+    is not accepted (and the payload not advanced) until every output has accepted it. An output
+    already served does not receive the payload again while slower outputs catch up. Every output
+    therefore observes exactly the input sequence, in order, with no payload dropped or duplicated.
+
+    Parameters
+    ----------
+    payload_shape : :class:`~.hdl.ShapeLike`
+        Shape of the payload member.
+    count : int
+        Number of output streams. Must be at least 1.
+    """
+    def __init__(self, payload_shape, count):
+        _check_payload_shape(payload_shape)
+        if count < 1:
+            raise ValueError(f"Output count must be a positive integer, not {count!r}")
+        self._payload_shape = payload_shape
+        self._count = count
+        super().__init__({
+            "i_stream": In(Signature(payload_shape)),
+            "o_streams": Out(Signature(payload_shape)).array(count),
+        })
+
+    @property
+    def count(self):
+        return self._count
+
+    def elaborate(self, platform):
+        m = Module()
+        count = self._count
+
+        sent = Signal(count)
+        accept_now = Signal(count)
+        for k in range(count):
+            m.d.comb += [
+                self.o_streams[k].payload.eq(self.i_stream.payload),
+                self.o_streams[k].valid.eq(self.i_stream.valid & ~sent[k]),
+                accept_now[k].eq(self.o_streams[k].valid & self.o_streams[k].ready),
+            ]
+
+        served = Signal(count)
+        m.d.comb += served.eq(sent | accept_now)
+        m.d.comb += self.i_stream.ready.eq(served.all())
+
+        with m.If(self.i_stream.valid & self.i_stream.ready):
+            m.d.sync += sent.eq(0)
+        with m.Else():
+            m.d.sync += sent.eq(served)
+
+        return m
+
+
+class Join(wiring.Component):
+    """Combines several input streams into one output stream carrying all their payloads.
+
+    Each output payload is the concatenation of one payload taken from every input, the first input
+    occupying the least-significant bits. Each input is accepted independently as soon as it is
+    available; once an input has been gathered it is not accepted again until the combined payload
+    has been emitted. The output becomes available only when every input has contributed. Every
+    input's payloads are consumed in order, one per output, with none dropped or duplicated.
+
+    Parameters
+    ----------
+    payload_shape : :class:`~.hdl.ShapeLike`
+        Shape of each input payload.
+    count : int
+        Number of input streams. Must be at least 1.
+    """
+    def __init__(self, payload_shape, count):
+        _check_payload_shape(payload_shape)
+        if count < 1:
+            raise ValueError(f"Input count must be a positive integer, not {count!r}")
+        self._payload_shape = payload_shape
+        self._width = Shape.cast(payload_shape).width
+        self._count = count
+        super().__init__({
+            "i_streams": In(Signature(payload_shape)).array(count),
+            "o_stream": Out(Signature(unsigned(self._width * count))),
+        })
+
+    @property
+    def count(self):
+        return self._count
+
+    def elaborate(self, platform):
+        m = Module()
+        count = self._count
+        width = self._width
+
+        got = Signal(count)
+        data = [Signal(width, name=f"data{k}") for k in range(count)]
+
+        gather_now = Signal(count)
+        slots = []
+        for k in range(count):
+            m.d.comb += [
+                self.i_streams[k].ready.eq(~got[k]),
+                gather_now[k].eq(self.i_streams[k].valid & self.i_streams[k].ready),
+            ]
+            slots.append(Mux(got[k], data[k], Value.cast(self.i_streams[k].payload)))
+
+        have = Signal(count)
+        m.d.comb += have.eq(got | gather_now)
+        m.d.comb += [
+            self.o_stream.valid.eq(have.all()),
+            self.o_stream.payload.eq(Cat(*slots)),
+        ]
+
+        with m.If(self.o_stream.valid & self.o_stream.ready):
+            m.d.sync += got.eq(0)
+        with m.Else():
+            m.d.sync += got.eq(have)
+            for k in range(count):
+                with m.If(gather_now[k]):
+                    m.d.sync += data[k].eq(Value.cast(self.i_streams[k].payload))
+
+        return m
+
+
+class FramedGearbox(wiring.Component):
+    """Converts a stream of packet-framed words between arbitrary bit widths.
+
+    The input stream carries payloads of :func:`framed_input_layout` (a ``data`` word of `i_width`
+    bits and a ``last`` flag marking the final word of a packet). Within a packet, the concatenated
+    bits of its input words (least-significant word first, least-significant bit first) are repacked
+    into output words of `o_width` bits, and the output stream carries payloads of
+    :func:`framed_output_layout`. Every output word before the final one of a packet has
+    ``valid == o_width``; the final output word of each packet has ``last`` set and ``valid`` equal
+    to the number of remaining bits, between 1 and `o_width`. The bit stream of one packet never
+    shares an output word with another: a partial final word is flushed at the packet boundary, and
+    the next packet begins in a fresh output word. No bit is dropped, duplicated, or reordered, and
+    ``last``/``valid`` are placed exactly, for any sequence of ``valid`` and ``ready``.
+
+    Parameters
+    ----------
+    i_width : int
+        Bit width of the input ``data``. Must be at least 1.
+    o_width : int
+        Bit width of the output ``data``. Must be at least 1.
+    """
+    def __init__(self, i_width, o_width):
+        if i_width < 1 or o_width < 1:
+            raise ValueError(f"Widths must be positive integers, not {i_width!r} and {o_width!r}")
+        self._iw = i_width
+        self._ow = o_width
+        self._cap = i_width + 2 * o_width
+        super().__init__({
+            "i_stream": In(Signature(framed_input_layout(i_width))),
+            "o_stream": Out(Signature(framed_output_layout(o_width))),
+        })
+
+    @property
+    def i_width(self):
+        return self._iw
+
+    @property
+    def o_width(self):
+        return self._ow
+
+    def elaborate(self, platform):
+        m = Module()
+        iw, ow, cap = self._iw, self._ow, self._cap
+
+        # Two independent packet lanes form a depth-2 pipeline: while one lane drains the bits of a
+        # closing packet (whose partial final word must not merge with the next packet), the other
+        # lane already accepts the next packet's words, so a boundary adds no idle input cycle on the
+        # narrower side. Lanes are used first-in-first-out; when only one packet is in flight the same
+        # lane both fills and drains.
+        buf = [Signal(cap, name=f"buf{i}") for i in range(2)]
+        level = [Signal(range(cap + 1), name=f"level{i}") for i in range(2)]
+        occ = [Signal(name=f"occ{i}") for i in range(2)]
+        closed = [Signal(name=f"closed{i}") for i in range(2)]
+        head = Signal()
+        tail = Signal()
+
+        open_lane = [Signal(name=f"open{i}") for i in range(2)]
+        for i in range(2):
+            m.d.comb += open_lane[i].eq(occ[i] & ~closed[i])
+        any_open = Signal()
+        open_idx = Signal()
+        m.d.comb += [any_open.eq(open_lane[0] | open_lane[1]), open_idx.eq(open_lane[1])]
+
+        def pick(sigs, idx):
+            return Mux(idx, sigs[1], sigs[0])
+
+        dl_level = pick(level, head)
+        dl_buf = pick(buf, head)
+        is_last = Signal()
+        m.d.comb += is_last.eq(pick(occ, head) & pick(closed, head) & (dl_level > 0) & (dl_level <= ow))
+        m.d.comb += [
+            self.o_stream.valid.eq(pick(occ, head) & ((dl_level >= ow) | (pick(closed, head) & (dl_level > 0)))),
+            self.o_stream.payload.data.eq(dl_buf[:ow]),
+            self.o_stream.payload.last.eq(is_last),
+            self.o_stream.payload.valid.eq(Mux(is_last, dl_level, ow)),
+        ]
+        do_send = Signal()
+        emit = Signal(range(cap + 1))
+        m.d.comb += do_send.eq(self.o_stream.valid & self.o_stream.ready)
+        m.d.comb += emit.eq(Mux(is_last, dl_level, ow))
+
+        fill = Signal()
+        m.d.comb += fill.eq(Mux(any_open, open_idx, tail))
+        fl_level = pick(level, fill)
+        fl_after = Signal(range(cap + 1))
+        m.d.comb += fl_after.eq(fl_level - Mux(do_send & (head == fill), emit, 0))
+        has_room = Signal()
+        m.d.comb += has_room.eq(fl_after + iw <= cap)
+        m.d.comb += self.i_stream.ready.eq(has_room & Mux(any_open, 1, ~pick(occ, fill)))
+        do_recv = Signal()
+        recv_last = Signal()
+        m.d.comb += do_recv.eq(self.i_stream.valid & self.i_stream.ready)
+        m.d.comb += recv_last.eq(do_recv & self.i_stream.payload.last)
+
+        for i in range(2):
+            sending = Signal(name=f"send{i}")
+            m.d.comb += sending.eq(do_send & (head == i))
+            after = Signal(range(cap + 1), name=f"after{i}")
+            m.d.comb += after.eq(level[i] - Mux(sending, emit, 0))
+            shifted = Signal(cap, name=f"shift{i}")
+            m.d.comb += shifted.eq(Mux(sending, buf[i] >> emit, buf[i]))
+            recv_i = Signal(name=f"recv{i}")
+            m.d.comb += recv_i.eq(do_recv & (fill == i))
+            with m.If(recv_i):
+                m.d.sync += buf[i].eq(shifted | (self.i_stream.payload.data.as_unsigned() << after))
+                m.d.sync += level[i].eq(after + iw)
+                m.d.sync += occ[i].eq(1)
+                m.d.sync += closed[i].eq(self.i_stream.payload.last)
+            with m.Elif(sending):
+                m.d.sync += buf[i].eq(shifted)
+                m.d.sync += level[i].eq(after)
+                with m.If(is_last):
+                    m.d.sync += occ[i].eq(0)
+                    m.d.sync += closed[i].eq(0)
+
+        with m.If(recv_last):
+            m.d.sync += tail.eq(~tail)
+        with m.If(do_send & is_last):
+            m.d.sync += head.eq(~head)
+
+        return m
