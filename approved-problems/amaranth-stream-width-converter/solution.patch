+def framed_input_layout(width):
+    """The input payload layout of a :class:`FramedGearbox`: a `width`-bit ``data`` field and a
+    one-bit ``last`` field marking the final word of a packet."""
+    return data.StructLayout({"data": unsigned(width), "last": unsigned(1)})
+
+
+def framed_output_layout(width):
+    """The output payload layout of a :class:`FramedGearbox`: a `width`-bit ``data`` field, a
+    one-bit ``last`` field, and a ``valid`` field giving the number of valid low-order bits of
+    ``data`` (always `width` except on the final, possibly partial, word of a packet)."""
+    return data.StructLayout({
+        "data": unsigned(width),
+        "last": unsigned(1),
+        "valid": unsigned(max(1, width.bit_length())),
+    })
+
