+import random
+import unittest
+
+from amaranth.hdl import *
+from amaranth.hdl import Period
+from amaranth.sim import Simulator
+from amaranth.lib import stream, data
+
+
+def _run_single(dut, inputs, *, p_valid, p_ready, seed):
+    """Drive a 1-in/1-out stream element with a randomised valid/ready waveform, returning the
+    exact sequence of accepted output payloads. Draining is done with ``ready`` held high."""
+    rng = random.Random(seed)
+    outputs = []
+
+    async def testbench(ctx):
+        idx = empty = cyc = 0
+        presenting = False
+        while cyc < 40000:
+            cyc += 1
+            draining = idx >= len(inputs)
+            if not draining and not presenting and rng.random() < p_valid:
+                presenting = True
+            want_send = presenting and not draining
+            want_recv = True if draining else (rng.random() < p_ready)
+            ctx.set(dut.i_stream.valid, 1 if want_send else 0)
+            if want_send:
+                ctx.set(dut.i_stream.payload, inputs[idx])
+            ctx.set(dut.o_stream.ready, 1 if want_recv else 0)
+            i_ready = ctx.get(dut.i_stream.ready)
+            o_valid = ctx.get(dut.o_stream.valid)
+            o_payload = ctx.get(dut.o_stream.payload)
+            recv_now = want_send and i_ready
+            send_now = o_valid and want_recv
+            await ctx.tick()
+            if recv_now:
+                idx += 1
+                presenting = False
+            if send_now:
+                outputs.append(o_payload)
+            if draining:
+                empty = empty + 1 if not o_valid else 0
+                if empty >= 3:
+                    break
+
+    sim = Simulator(dut)
+    sim.add_clock(Period(MHz=1))
+    sim.add_testbench(testbench)
+    sim.run()
+    return outputs
+
+
+def _ref_down(inputs, width, factor):
+    part = width // factor
+    out = []
+    for w in inputs:
+        for i in range(factor):
+            out.append((w >> (i * part)) & ((1 << part) - 1))
+    return out
+
+
+def _ref_up(inputs, width, factor):
+    part = width // factor
+    out = []
+    for g in range(0, len(inputs), factor):
+        val = 0
+        for i in range(factor):
+            val |= (inputs[g + i] & ((1 << part) - 1)) << (i * part)
+        out.append(val)
+    return out
+
+
+def _ref_gearbox(inputs, i_width, o_width):
+    bits = nbits = 0
+    for w in inputs:
+        bits |= (w & ((1 << i_width) - 1)) << nbits
+        nbits += i_width
+    return [(bits >> (g * o_width)) & ((1 << o_width) - 1) for g in range(nbits // o_width)]
+
+
+class WidthDownConverterTestCase(unittest.TestCase):
+    def test_basic(self):
+        dut = stream.WidthDownConverter(8, 2)
+        got = _run_single(dut, [0x21, 0x43], p_valid=1.0, p_ready=1.0, seed=0)
+        self.assertEqual(got, [0x1, 0x2, 0x3, 0x4])
+
+    def test_empty(self):
+        self.assertEqual(_run_single(stream.WidthDownConverter(4, 4), [], p_valid=1.0, p_ready=1.0, seed=1), [])
+
+    def test_factor_one_is_identity(self):
+        got = _run_single(stream.WidthDownConverter(6, 1), [5, 9, 2], p_valid=0.6, p_ready=0.6, seed=2)
+        self.assertEqual(got, [5, 9, 2])
+
+    def test_fuzz_backpressure(self):
+        for seed in range(60):
+            rng = random.Random(seed)
+            factor = rng.choice([1, 2, 3, 4, 5])
+            part = rng.choice([1, 2, 3, 4])
+            width = part * factor
+            inputs = [rng.randrange(1 << width) for _ in range(rng.randint(0, 14))]
+            got = _run_single(stream.WidthDownConverter(width, factor), inputs,
+                              p_valid=rng.uniform(0.2, 1.0), p_ready=rng.uniform(0.2, 1.0), seed=seed)
+            self.assertEqual(got, _ref_down(inputs, width, factor), msg=f"seed={seed}")
+
+    def test_rejects_bad_arguments(self):
+        with self.assertRaises(ValueError):
+            stream.WidthDownConverter(7, 2)
+        with self.assertRaises(ValueError):
+            stream.WidthDownConverter(8, 0)
+
+
+class WidthUpConverterTestCase(unittest.TestCase):
+    def test_basic(self):
+        got = _run_single(stream.WidthUpConverter(8, 2), [0x1, 0x2, 0x3, 0x4], p_valid=1.0, p_ready=1.0, seed=0)
+        self.assertEqual(got, [0x21, 0x43])
+
+    def test_partial_group_is_not_emitted(self):
+        # three inputs, factor 2: only one full group is produced, the trailing word is held.
+        got = _run_single(stream.WidthUpConverter(8, 2), [0x1, 0x2, 0x3], p_valid=1.0, p_ready=1.0, seed=0)
+        self.assertEqual(got, [0x21])
+
+    def test_fuzz_backpressure(self):
+        for seed in range(60):
+            rng = random.Random(seed)
+            factor = rng.choice([1, 2, 3, 4])
+            part = rng.choice([1, 2, 3, 4])
+            width = part * factor
+            n = rng.randint(0, 5) * factor
+            inputs = [rng.randrange(1 << part) for _ in range(n)]
+            got = _run_single(stream.WidthUpConverter(width, factor), inputs,
+                              p_valid=rng.uniform(0.2, 1.0), p_ready=rng.uniform(0.2, 1.0), seed=seed + 500)
+            self.assertEqual(got, _ref_up(inputs, width, factor), msg=f"seed={seed}")
+
+    def test_partial_group_retained_across_gap(self):
+        # A lone first word must be retained internally through an input gap and completed by a later
+        # word, not dropped: with a pause after the first of a factor-2 pair the packed word still
+        # combines the two.
+        dut = stream.WidthUpConverter(8, 2)
+        out = []
+        plan = [0x1, None, None, None, 0x2, 0x3, 0x4]
+
+        async def tb(ctx):
+            ctx.set(dut.o_stream.ready, 1)
+            pi = empty = 0
+            for _ in range(300):
+                word = plan[pi] if pi < len(plan) else None
+                ctx.set(dut.i_stream.valid, 1 if word is not None else 0)
+                if word is not None:
+                    ctx.set(dut.i_stream.payload, word)
+                i_ready = ctx.get(dut.i_stream.ready)
+                o_valid = ctx.get(dut.o_stream.valid)
+                o_payload = ctx.get(dut.o_stream.payload)
+                await ctx.tick()
+                if pi < len(plan) and (word is None or i_ready):
+                    pi += 1
+                if o_valid:
+                    out.append(o_payload)
+                if pi >= len(plan):
+                    empty = empty + 1 if not o_valid else 0
+                    if empty >= 3:
+                        break
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(out, [0x21, 0x43])
+
