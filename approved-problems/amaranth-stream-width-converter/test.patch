+    def test_demux_and_fork_preserve_struct_payload_contents(self):
+        layout = data.StructLayout({"a": unsigned(4), "b": unsigned(4)})
+        items = [(1, 2), (15, 0), (7, 9)]
+
+        demux = stream.Demux(layout, 2)
+        routed = {0: [], 1: []}
+
+        async def demux_tb(ctx):
+            for a, b in items:
+                for sel in (0, 1):
+                    ctx.set(demux.i_stream.valid, 1)
+                    ctx.set(demux.i_stream.payload.a, a)
+                    ctx.set(demux.i_stream.payload.b, b)
+                    ctx.set(demux.select, sel)
+                    ctx.set(demux.o_streams[0].ready, 1)
+                    ctx.set(demux.o_streams[1].ready, 1)
+                    await ctx.delay(Period(ns=100))
+                    for k in (0, 1):
+                        if ctx.get(demux.o_streams[k].valid):
+                            routed[k].append((ctx.get(demux.o_streams[k].payload.a),
+                                              ctx.get(demux.o_streams[k].payload.b)))
+
+        sim = Simulator(demux)
+        sim.add_testbench(demux_tb)
+        sim.run()
+        self.assertEqual(routed[0], items)
+        self.assertEqual(routed[1], items)
+
+        fork = stream.Fork(layout, 2)
+        got = {0: [], 1: []}
+
+        async def fork_tb(ctx):
+            idx = cyc = empty = 0
+            while cyc < 500:
+                cyc += 1
+                has = idx < len(items)
+                ctx.set(fork.i_stream.valid, 1 if has else 0)
+                if has:
+                    ctx.set(fork.i_stream.payload.a, items[idx][0])
+                    ctx.set(fork.i_stream.payload.b, items[idx][1])
+                for k in (0, 1):
+                    ctx.set(fork.o_streams[k].ready, 1)
+                i_ready = ctx.get(fork.i_stream.ready)
+                ovs = [ctx.get(fork.o_streams[k].valid) for k in (0, 1)]
+                pays = [(ctx.get(fork.o_streams[k].payload.a), ctx.get(fork.o_streams[k].payload.b)) for k in (0, 1)]
+                await ctx.tick()
+                if has and i_ready:
+                    idx += 1
+                for k in (0, 1):
+                    if ovs[k]:
+                        got[k].append(pays[k])
+                if idx >= len(items):
+                    empty = empty + 1 if not any(ovs) else 0
+                    if empty >= 3:
+                        break
+
+        sim = Simulator(fork)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(fork_tb)
+        sim.run()
+        self.assertEqual(got[0], items)
+        self.assertEqual(got[1], items)
+
+
+if __name__ == "__main__":
+    unittest.main()
