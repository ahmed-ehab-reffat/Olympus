+class SkidBufferTestCase(unittest.TestCase):
+    def test_is_order_preserving_identity(self):
+        for seed in range(60):
+            rng = random.Random(seed)
+            width = rng.randint(1, 8)
+            inputs = [rng.randrange(1 << width) for _ in range(rng.randint(0, 16))]
+            got = _run_single(stream.SkidBuffer(width), inputs,
+                              p_valid=rng.uniform(0.15, 1.0), p_ready=rng.uniform(0.15, 1.0), seed=seed + 1300)
+            self.assertEqual(got, inputs, msg=f"seed={seed}")
+
+    def test_output_is_registered(self):
+        # A payload presented on the input is not combinationally forwarded within the same cycle.
+        dut = stream.SkidBuffer(8)
+        seen = []
+
+        async def tb(ctx):
+            ctx.set(dut.i_stream.valid, 1)
+            ctx.set(dut.i_stream.payload, 0xAB)
+            ctx.set(dut.o_stream.ready, 1)
+            seen.append(ctx.get(dut.o_stream.valid))
+            await ctx.tick()
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(seen, [0])
+
+    def test_input_ready_is_registered(self):
+        # Input `ready` is driven from a register: within a cycle it must not respond
+        # combinationally to the output `ready`.
+        dut = stream.SkidBuffer(8)
+        diffs = []
+
+        async def tb(ctx):
+            for _ in range(6):
+                ctx.set(dut.i_stream.valid, 1)
+                ctx.set(dut.i_stream.payload, 0)
+                ctx.set(dut.o_stream.ready, 0)
+                r0 = ctx.get(dut.i_stream.ready)
+                ctx.set(dut.o_stream.ready, 1)
+                r1 = ctx.get(dut.i_stream.ready)
+                if r0 != r1:
+                    diffs.append((r0, r1))
+                await ctx.tick()
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(diffs, [])
+
+    def test_accepts_struct_payload_shape(self):
+        # Constructors take a payload shape, not only a bit width: a struct payload round-trips.
+        layout = data.StructLayout({"a": unsigned(4), "b": unsigned(4)})
+        dut = stream.SkidBuffer(layout)
+        items = [(1, 2), (3, 4), (15, 0), (7, 9)]
+        out = []
+
+        async def tb(ctx):
+            idx = cyc = empty = 0
+            while cyc < 500:
+                cyc += 1
+                draining = idx >= len(items)
+                wv = not draining
+                ctx.set(dut.i_stream.valid, 1 if wv else 0)
+                if wv:
+                    ctx.set(dut.i_stream.payload.a, items[idx][0])
+                    ctx.set(dut.i_stream.payload.b, items[idx][1])
+                ctx.set(dut.o_stream.ready, 1)
+                i_ready = ctx.get(dut.i_stream.ready)
+                o_valid = ctx.get(dut.o_stream.valid)
+                oa = ctx.get(dut.o_stream.payload.a)
+                ob = ctx.get(dut.o_stream.payload.b)
+                await ctx.tick()
+                if wv and i_ready:
+                    idx += 1
+                if o_valid:
+                    out.append((oa, ob))
+                if draining:
+                    empty = empty + 1 if not o_valid else 0
+                    if empty >= 3:
+                        break
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(out, items)
+
+    def test_payload_is_registered_not_forwarded(self):
+        # The output payload itself, not only `valid`, is registered: a word presented on the input
+        # is not combinationally visible on `o_stream.payload` in the same cycle.
+        dut = stream.SkidBuffer(8)
+        first = []
+
+        async def tb(ctx):
+            ctx.set(dut.i_stream.valid, 1)
+            ctx.set(dut.i_stream.payload, 0xAB)
+            ctx.set(dut.o_stream.ready, 1)
+            first.append((ctx.get(dut.o_stream.valid), ctx.get(dut.o_stream.payload)))
+            await ctx.tick()
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        valid, payload = first[0]
+        self.assertEqual(valid, 0)
+        self.assertNotEqual(payload, 0xAB)
+
+
+def _clocked(dut):
+    # Wrap a DUT so a `sync` domain always exists, letting the clocked harness drive a component
+    # whether its handshake is registered or purely combinational (both are valid).
+    m = Module()
+    m.submodules.dut = dut
+    keep = Signal()
+    m.d.sync += keep.eq(~keep)
+    return m
+
+
+def _run_many_in(dut, per_input, *, count, seed, tag_bits, group=False, o_width=None):
+    rng = random.Random(seed)
+    out = []
+
+    async def tb(ctx):
+        idx = [0] * count
+        presenting = [False] * count
+        cyc = empty = 0
+        while cyc < 40000:
+            cyc += 1
+            drained = all(idx[k] >= len(per_input[k]) for k in range(count))
+            sending = []
+            for k in range(count):
+                has = idx[k] < len(per_input[k])
+                if has and not presenting[k] and rng.random() < 0.6:
+                    presenting[k] = True
+                wv = has and presenting[k]
+                ctx.set(dut.i_streams[k].valid, 1 if wv else 0)
+                if wv:
+                    ctx.set(dut.i_streams[k].payload, per_input[k][idx[k]])
+                sending.append(wv)
+            want_recv = True if drained else (rng.random() < 0.7)
+            ctx.set(dut.o_stream.ready, 1 if want_recv else 0)
+            i_readies = [ctx.get(dut.i_streams[k].ready) for k in range(count)]
+            o_valid = ctx.get(dut.o_stream.valid)
+            o_payload = ctx.get(dut.o_stream.payload)
+            recvs = [k for k in range(count) if sending[k] and i_readies[k]]
+            send_now = o_valid and want_recv
+            await ctx.tick()
+            for k in recvs:
+                idx[k] += 1
+                presenting[k] = False
+            if send_now:
+                out.append(o_payload)
+            if drained:
+                empty = empty + 1 if not o_valid else 0
+                if empty >= 3:
+                    break
+
+    sim = Simulator(_clocked(dut))
+    sim.add_clock(Period(MHz=1))
+    sim.add_testbench(tb)
+    sim.run()
+    return out
+
+
+class ArbiterTestCase(unittest.TestCase):
+    def test_merge_preserves_per_input_order(self):
+        for seed in range(80):
+            rng = random.Random(seed)
+            count = rng.randint(1, 4)
+            seq_bits = 5
+            width = seq_bits + max(1, (count - 1).bit_length())
+            lens = [rng.randint(0, 8) for _ in range(count)]
+            per_input = [[(k << seq_bits) | i for i in range(lens[k])] for k in range(count)]
+            out = _run_many_in(stream.Arbiter(width, count), per_input, count=count, seed=seed, tag_bits=seq_bits)
+            by_tag = {k: [] for k in range(count)}
+            for p in out:
+                by_tag[p >> seq_bits].append(p & ((1 << seq_bits) - 1))
+            for k in range(count):
+                self.assertEqual(by_tag[k], list(range(lens[k])), msg=f"seed={seed} input={k}")
+
+    def test_round_robin_is_fair(self):
+        # Two inputs always valid; grants must alternate, never starving either.
+        dut = stream.Arbiter(8, 2)
+        order = []
+        steady = [0]
+
+        async def tb(ctx):
+            for k in range(2):
+                ctx.set(dut.i_streams[k].valid, 1)
+                ctx.set(dut.i_streams[k].payload, k)
+            ctx.set(dut.o_stream.ready, 1)
+            warmup, window = 6, 12
+            for cyc in range(warmup + window):
+                if ctx.get(dut.o_stream.valid):
+                    order.append(ctx.get(dut.o_stream.payload))
+                    if cyc >= warmup:
+                        steady[0] += 1
+                await ctx.tick()
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        # Work-conserving round robin under constant contention: in steady state (after any initial
+        # fill) it produces an output every cycle, grants alternate, and neither input starves. The
+        # initial grant may be either input, so only alternation and coverage of both are pinned.
+        self.assertEqual(steady[0], 12, msg=f"persistent bubble under contention: {order}")
+        self.assertTrue(all(order[i] != order[i + 1] for i in range(len(order) - 1)),
+                        msg=f"grants not alternating: {order}")
+        self.assertEqual(set(order), {0, 1}, msg=f"an input starved: {order}")
+
+    def test_skips_empty_inputs_without_bubbles(self):
+        # Inputs 0 and 2 are always valid; input 1 is never valid. With the output always ready the
+        # arbiter skips the empty input without wasting steady-state service (near-full throughput,
+        # allowing only an initial fill) and serves both live inputs, resuming round robin over just
+        # the non-empty ones.
+        dut = stream.Arbiter(6, 3)
+        outs = []
+        steady = [0]
+
+        async def tb(ctx):
+            ctx.set(dut.o_stream.ready, 1)
+            ctx.set(dut.i_streams[0].valid, 1)
+            ctx.set(dut.i_streams[0].payload, 0)
+            ctx.set(dut.i_streams[1].valid, 0)
+            ctx.set(dut.i_streams[2].valid, 1)
+            ctx.set(dut.i_streams[2].payload, 2)
+            warmup, window = 6, 16
+            for cyc in range(warmup + window):
+                if ctx.get(dut.o_stream.valid):
+                    outs.append(ctx.get(dut.o_stream.payload))
+                    if cyc >= warmup:
+                        steady[0] += 1
+                await ctx.tick()
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(steady[0], 16, msg=f"persistent bubble while skipping empty input: {outs}")
+        self.assertEqual(set(outs), {0, 2}, msg=f"a live input starved: {outs}")
+
+    def test_grant_does_not_advance_while_output_blocked(self):
+        # The round-robin pointer advances only on a completed output handshake. While the output is
+        # not ready, no input's turn is consumed, so once ready resumes the same set of inputs is
+        # served in order with no input skipped.
+        dut = stream.Arbiter(8, 3)
+        seen = []
+
+        async def tb(ctx):
+            for k in range(3):
+                ctx.set(dut.i_streams[k].valid, 1)
+                ctx.set(dut.i_streams[k].payload, k)
+            ctx.set(dut.o_stream.ready, 0)
+            for _ in range(5):
+                await ctx.tick()
+            ctx.set(dut.o_stream.ready, 1)
+            for _ in range(9):
+                if ctx.get(dut.o_stream.valid):
+                    seen.append(ctx.get(dut.o_stream.payload))
+                await ctx.tick()
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        for k in range(3):
+            self.assertEqual(seen.count(k), 3, msg=f"input {k} served {seen.count(k)} times, not 3: {seen}")
+        self.assertTrue(all(seen[i] != seen[i + 1] for i in range(len(seen) - 1)),
+                        msg=f"grants not alternating after backpressure: {seen}")
+
+
+class JoinTestCase(unittest.TestCase):
+    def test_gather_concatenates(self):
+        for seed in range(80):
+            rng = random.Random(seed)
+            count = rng.randint(1, 4)
+            width = 5
+            n = rng.randint(0, 10)
+            per_input = [[rng.randrange(1 << width) for _ in range(n)] for _ in range(count)]
+            out = _run_many_in(stream.Join(width, count), per_input, count=count, seed=seed + 3000, tag_bits=0)
+            exp = [sum(per_input[k][g] << (k * width) for k in range(count)) for g in range(n)]
+            self.assertEqual(out, exp, msg=f"seed={seed}")
+
+    def test_waits_for_all_inputs_then_consumes_each_once(self):
+        # Input 0 is available immediately, input 1 only after a few cycles; the output is always
+        # ready. Join must present no output while input 1 is missing, then emit the concatenation
+        # (input 0 in the low bits) once both are present. Emission latency is not constrained (the
+        # output may be combinational or registered) and the ready waveform is not probed here:
+        # per-input single-consumption and ordering are covered by test_gather_concatenates over
+        # full randomized sequences.
+        dut = stream.Join(5, 2)
+        waited = []
+        first_payload = []
+
+        async def tb(ctx):
+            ctx.set(dut.o_stream.ready, 1)
+            ctx.set(dut.i_streams[0].valid, 1)
+            ctx.set(dut.i_streams[0].payload, 0b10101)
+            ctx.set(dut.i_streams[1].valid, 0)
+            ctx.set(dut.i_streams[1].payload, 0b01110)
+            for _ in range(3):
+                waited.append(ctx.get(dut.o_stream.valid))
+                await ctx.tick()
+            ctx.set(dut.i_streams[1].valid, 1)
