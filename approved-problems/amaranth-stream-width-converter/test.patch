+            got, window = _steady_transfers(stream.WidthUpConverter(width, factor), "in")
+            self.assertEqual(got, window, msg=f"{width}/{factor}")
+
+    def test_gearbox_narrow_side_full_rate(self):
+        got, window = _steady_transfers(stream.Gearbox(8, 3), "out")
+        self.assertEqual(got, window)
