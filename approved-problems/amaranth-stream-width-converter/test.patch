+            self.assertEqual(got, window, msg=side)
+
+    def test_framed_gearbox_no_boundary_bubble(self):
+        # Back-to-back packets on the narrower (input) side must incur no per-boundary idle cycle in
+        # steady state. A single-buffer converter that holds the input off while draining each
+        # packet's final word stalls once per boundary (a nonzero steady-state stall count);
+        # sustaining the rate requires accepting the next packet while the current one still flushes.
+        for iw, ow in [(1, 8), (2, 5), (3, 7), (1, 4), (2, 6), (4, 4)]:
+            rng = random.Random(iw * 31 + ow)
+            packets = [[rng.randrange(1 << iw) for _ in range(rng.randint(2, 4))] for _ in range(60)]
+            stalls = _framed_input_stalls(stream.FramedGearbox(iw, ow), packets)
+            self.assertEqual(stalls, 0, msg=f"iw={iw} ow={ow} steady-state stalls={stalls}")
+
+    def test_framed_gearbox_output_side_full_rate(self):
+        # When the output is the narrower side (o_width < i_width), the output transfers once per
+        # cycle in steady state under a moving stream. Measured only after a warmup, so any initial
+        # fill is ignored and only a persistent output bubble is rejected.
+        warmup, window = 20, 100
+        for iw, ow in [(8, 3), (5, 2), (6, 1), (7, 3)]:
+            rng = random.Random(iw * 17 + ow)
+            packets = [[rng.randrange(1 << iw) for _ in range(rng.randint(2, 4))] for _ in range(80)]
+            flat = [(w, 1 if i == len(words) - 1 else 0) for words in packets for i, w in enumerate(words)]
+            dut = stream.FramedGearbox(iw, ow)
+            sends = [0]
+
+            def make_tb(dut, flat, sends, warmup, window):
+                async def tb(ctx):
+                    idx = 0
+                    for cyc in range(warmup + window):
+                        offered = idx < len(flat)
+                        ctx.set(dut.i_stream.valid, 1 if offered else 0)
+                        if offered:
+                            ctx.set(dut.i_stream.payload.data, flat[idx][0])
+                            ctx.set(dut.i_stream.payload.last, flat[idx][1])
+                        ctx.set(dut.o_stream.ready, 1)
+                        i_ready = ctx.get(dut.i_stream.ready)
+                        o_valid = ctx.get(dut.o_stream.valid)
+                        if cyc >= warmup and o_valid:
+                            sends[0] += 1
+                        await ctx.tick()
+                        if offered and i_ready:
+                            idx += 1
+                return tb
+
+            sim = Simulator(dut)
+            sim.add_clock(Period(MHz=1))
+            sim.add_testbench(make_tb(dut, flat, sends, warmup, window))
+            sim.run()
+            self.assertEqual(sends[0], window, msg=f"iw={iw} ow={ow} output bubble: {sends[0]}/{window}")
+
