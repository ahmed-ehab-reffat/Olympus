+#!/usr/bin/env bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+export PYTHONPATH="$(pwd):${PYTHONPATH:-}"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+        --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+        base|new) MODE="$1"; shift ;;
+        *) shift ;;
+    esac
+done
+MODE="${MODE:-base}"
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/report.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+PY="$(command -v python3 || command -v python)"
+
+# Amaranth's simulator is pure Python. The `*Formal` cases (confined to the FIFO suite) drive an
+# external SymbiYosys formal-verification toolchain that is not present offline, so they are
+# deselected here; they are unrelated to this feature, which is verified entirely by simulation.
+BASE_TESTS="tests/test_lib_stream.py tests/test_lib_fifo.py tests/test_lib_data.py \
+tests/test_lib_memory.py tests/test_lib_cdc.py tests/test_lib_crc.py tests/test_lib_wiring.py \
+tests/test_hdl_dsl.py tests/test_sim.py"
+
+case "$MODE" in
+    base)
+        $PY -m pytest $BASE_TESTS -k "not Formal" \
+            --junit-xml="$OUTPUT_PATH" -p no:cacheprovider -q
+        ;;
+    new)
+        $PY -m pytest tests/test_stream_ops_04a981.py \
+            --junit-xml="$OUTPUT_PATH" -p no:cacheprovider -q
+        ;;
+esac
