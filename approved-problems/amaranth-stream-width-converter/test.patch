+def _steady_transfers(dut, side, warmup=40, window=80):
+    """Drive input ``valid`` and output ``ready`` high every cycle and count transfers on ``side``
+    ("in" or "out") only during the steady-state window after an initial warmup. Any initial fill
+    latency (of whatever length) is ignored; only a persistent per-cycle bubble reduces the count
+    below ``window``."""
+    count = [0]
+
+    async def tb(ctx):
+        for cyc in range(warmup + window):
+            ctx.set(dut.i_stream.valid, 1)
+            ctx.set(dut.i_stream.payload, 0)
+            ctx.set(dut.o_stream.ready, 1)
+            hit = ctx.get(dut.i_stream.ready) if side == "in" else ctx.get(dut.o_stream.valid)
+            if cyc >= warmup and hit:
+                count[0] += 1
+            await ctx.tick()
+
+    sim = Simulator(dut)
+    sim.add_clock(Period(MHz=1))
+    sim.add_testbench(tb)
+    sim.run()
+    return count[0], window
+
+
+def _framed_input_stalls(dut, packets, warmup=20, window=100):
+    """Offer packet words back to back with the output always ready, counting cycles in the steady
+    state window (after warmup) where an input word is offered but not accepted. Any initial fill is
+    ignored; a per-packet-boundary bubble shows up as a nonzero steady-state stall count."""
+    flat = [(w, 1 if i == len(words) - 1 else 0) for words in packets for i, w in enumerate(words)]
+    stalls = [0]
+
+    async def tb(ctx):
+        idx = 0
+        for cyc in range(warmup + window):
+            offered = idx < len(flat)
+            ctx.set(dut.i_stream.valid, 1 if offered else 0)
+            if offered:
+                ctx.set(dut.i_stream.payload.data, flat[idx][0])
+                ctx.set(dut.i_stream.payload.last, flat[idx][1])
+            ctx.set(dut.o_stream.ready, 1)
+            i_ready = ctx.get(dut.i_stream.ready)
+            if cyc >= warmup and offered and not i_ready:
+                stalls[0] += 1
+            await ctx.tick()
+            if offered and i_ready:
+                idx += 1
+
+    sim = Simulator(dut)
+    sim.add_clock(Period(MHz=1))
+    sim.add_testbench(tb)
+    sim.run()
+    return stalls[0]
+
+
+class ThroughputTestCase(unittest.TestCase):
+    # The narrower side of each converter must transfer once per cycle under a moving stream once
+    # past the initial fill. These tests measure the steady-state window only (after a generous
+    # warmup), so any fill latency is ignored and only a persistent bubble is rejected.
+    def test_down_converter_output_full_rate(self):
+        for width, factor in [(8, 2), (8, 4), (9, 3), (6, 1)]:
+            got, window = _steady_transfers(stream.WidthDownConverter(width, factor), "out")
