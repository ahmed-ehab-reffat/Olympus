+def _run_framed(dut, packets, *, p_valid, p_ready, seed):
+    """Drive a FramedGearbox with a randomised valid/ready waveform, returning the exact sequence
+    of ``(data, last, valid)`` output triples (data masked to its ``valid`` low bits)."""
+    rng = random.Random(seed)
+    flat = [(w, 1 if i == len(words) - 1 else 0) for words in packets for i, w in enumerate(words)]
+    out = []
+
+    async def tb(ctx):
+        idx = cyc = empty = 0
+        presenting = False
+        while cyc < 60000:
+            cyc += 1
+            draining = idx >= len(flat)
+            if not draining and not presenting and rng.random() < p_valid:
+                presenting = True
+            want_send = presenting and not draining
+            want_recv = True if draining else (rng.random() < p_ready)
+            ctx.set(dut.i_stream.valid, 1 if want_send else 0)
+            if want_send:
+                ctx.set(dut.i_stream.payload.data, flat[idx][0])
+                ctx.set(dut.i_stream.payload.last, flat[idx][1])
+            ctx.set(dut.o_stream.ready, 1 if want_recv else 0)
+            i_ready = ctx.get(dut.i_stream.ready)
+            o_valid = ctx.get(dut.o_stream.valid)
+            o_data = ctx.get(dut.o_stream.payload.data)
+            o_last = ctx.get(dut.o_stream.payload.last)
+            o_vbits = ctx.get(dut.o_stream.payload.valid)
+            recv_now = want_send and i_ready
+            send_now = o_valid and want_recv
+            await ctx.tick()
+            if recv_now:
+                idx += 1
+                presenting = False
+            if send_now:
+                out.append((o_data & ((1 << o_vbits) - 1), o_last, o_vbits))
+            if draining:
+                empty = empty + 1 if not o_valid else 0
+                if empty >= 3:
+                    break
+
+    sim = Simulator(dut)
+    sim.add_clock(Period(MHz=1))
+    sim.add_testbench(tb)
+    sim.run()
+    return out
+
+
+def _ref_framed(packets, i_width, o_width):
+    out = []
+    for words in packets:
+        bits = nbits = 0
+        for w in words:
+            bits |= (w & ((1 << i_width) - 1)) << nbits
+            nbits += i_width
+        n_out = (nbits + o_width - 1) // o_width
+        for j in range(n_out):
+            valid = min(o_width, nbits - j * o_width)
+            out.append(((bits >> (j * o_width)) & ((1 << valid) - 1), 1 if j == n_out - 1 else 0, valid))
+    return out
+
