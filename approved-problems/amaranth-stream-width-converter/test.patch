+class GearboxTestCase(unittest.TestCase):
+    def test_narrow_to_wide(self):
+        got = _run_single(stream.Gearbox(3, 6), [0b101, 0b011, 0b110, 0b001], p_valid=1.0, p_ready=1.0, seed=0)
+        self.assertEqual(got, [0b011101, 0b001110])
+
+    def test_fuzz_non_dividing_widths(self):
+        for seed in range(120):
+            rng = random.Random(seed)
+            i_width = rng.randint(1, 8)
+            o_width = rng.randint(1, 8)
+            inputs = [rng.randrange(1 << i_width) for _ in range(rng.randint(0, 16))]
+            got = _run_single(stream.Gearbox(i_width, o_width), inputs,
+                              p_valid=rng.uniform(0.15, 1.0), p_ready=rng.uniform(0.15, 1.0), seed=seed + 900)
+            self.assertEqual(got, _ref_gearbox(inputs, i_width, o_width),
+                             msg=f"seed={seed} iw={i_width} ow={o_width}")
