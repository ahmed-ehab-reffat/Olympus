+            while cyc < 4000:
+                cyc += 1
+                draining = idx >= len(inputs)
+                wv = (not draining)
+                ctx.set(dut.i_stream.valid, 1 if wv else 0)
+                if wv:
+                    ctx.set(dut.i_stream.payload, inputs[idx])
+                ctx.set(dut.o_streams[0].ready, 1)
+                ctx.set(dut.o_streams[1].ready, 1 if (draining or cyc % 3 == 0) else 0)
+                i_ready = ctx.get(dut.i_stream.ready)
+                ovs = [ctx.get(dut.o_streams[k].valid) for k in range(2)]
+                ops = [ctx.get(dut.o_streams[k].payload) for k in range(2)]
+                ords = [ctx.get(dut.o_streams[k].ready) for k in range(2)]
+                recv = wv and i_ready
+                sends = [k for k in range(2) if ovs[k] and ords[k]]
+                await ctx.tick()
+                if recv:
+                    idx += 1
+                for k in sends:
+                    got[k].append(ops[k])
+                if draining:
+                    empty = empty + 1 if not any(ovs) else 0
+                    if empty >= 3:
+                        break
+
+        sim = Simulator(dut)
+        sim.add_clock(Period(MHz=1))
