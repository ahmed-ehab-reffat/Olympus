+    def test_join_concatenates_struct_payloads(self):
+        layout = data.StructLayout({"a": unsigned(4), "b": unsigned(4)})
+        dut = stream.Join(layout, 2)
+        ins = [[(1, 2), (3, 4)], [(5, 6), (7, 8)]]
+        out = []
+
+        async def tb(ctx):
+            idx = [0, 0]
+            cyc = empty = 0
+            while cyc < 2000:
+                cyc += 1
+                drained = all(idx[k] >= 2 for k in range(2))
+                sending = []
+                for k in range(2):
+                    has = idx[k] < 2
+                    ctx.set(dut.i_streams[k].valid, 1 if has else 0)
+                    if has:
+                        ctx.set(dut.i_streams[k].payload.a, ins[k][idx[k]][0])
+                        ctx.set(dut.i_streams[k].payload.b, ins[k][idx[k]][1])
+                    sending.append(has)
+                ctx.set(dut.o_stream.ready, 1)
+                i_readies = [ctx.get(dut.i_streams[k].ready) for k in range(2)]
+                o_valid = ctx.get(dut.o_stream.valid)
+                o_payload = ctx.get(dut.o_stream.payload)
+                recvs = [k for k in range(2) if sending[k] and i_readies[k]]
+                await ctx.tick()
+                for k in recvs:
+                    idx[k] += 1
+                if o_valid:
+                    out.append(o_payload)
+                if drained:
+                    empty = empty + 1 if not o_valid else 0
+                    if empty >= 3:
+                        break
+
+        sim = Simulator(_clocked(dut))
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        raw = lambda t: t[0] | (t[1] << 4)
+        exp = [raw(ins[0][g]) | (raw(ins[1][g]) << 8) for g in range(2)]
+        self.assertEqual(out, exp)
+
+    def test_arbiter_preserves_struct_payload_contents(self):
+        layout = data.StructLayout({"a": unsigned(4), "b": unsigned(4)})
+        items = [(1, 2), (15, 0), (7, 9)]
+        dut = stream.Arbiter(layout, 1)
+        got = []
+
+        async def tb(ctx):
+            idx = cyc = empty = 0
+            while cyc < 500:
+                cyc += 1
+                has = idx < len(items)
+                ctx.set(dut.i_streams[0].valid, 1 if has else 0)
+                if has:
+                    ctx.set(dut.i_streams[0].payload.a, items[idx][0])
+                    ctx.set(dut.i_streams[0].payload.b, items[idx][1])
+                ctx.set(dut.o_stream.ready, 1)
+                i_ready = ctx.get(dut.i_streams[0].ready)
+                o_valid = ctx.get(dut.o_stream.valid)
+                oa = ctx.get(dut.o_stream.payload.a)
+                ob = ctx.get(dut.o_stream.payload.b)
+                await ctx.tick()
+                if has and i_ready:
+                    idx += 1
+                if o_valid:
+                    got.append((oa, ob))
+                if idx >= len(items):
+                    empty = empty + 1 if not o_valid else 0
+                    if empty >= 3:
+                        break
+
+        sim = Simulator(_clocked(dut))
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(got, items)
