+                    ctx.set(dut.i_streams[0].valid, 0)
+                    ctx.set(dut.i_streams[1].valid, 0)
+                await ctx.tick()
+
+        sim = Simulator(_clocked(dut))
+        sim.add_clock(Period(MHz=1))
+        sim.add_testbench(tb)
+        sim.run()
+        self.assertEqual(waited, [0, 0, 0], msg="output valid before every input contributed")
+        self.assertEqual(first_payload, [0b10101 | (0b01110 << 5)])
