+class DemuxTestCase(unittest.TestCase):
+    # The demux is combinational: it routes the input to exactly the selected output and takes
+    # backpressure only from that output. This is checked directly against the routing invariant
+    # over randomised combinational vectors.
+    def test_routes_by_select(self):
+        for seed in range(200):
+            rng = random.Random(seed)
+            count = rng.randint(1, 5)
+            width = 6
+            dut = stream.Demux(width, count)
+            bad = []
+
+            def make_tb(rng, count, width, dut, bad):
+                async def tb(ctx):
+                    for _ in range(50):
+                        i_valid = rng.randrange(2)
+                        payload = rng.randrange(1 << width)
+                        select = rng.randrange(count)
+                        readies = [rng.randrange(2) for _ in range(count)]
+                        ctx.set(dut.i_stream.valid, i_valid)
+                        ctx.set(dut.i_stream.payload, payload)
+                        ctx.set(dut.select, select)
+                        for k in range(count):
+                            ctx.set(dut.o_streams[k].ready, readies[k])
+                        await ctx.delay(Period(ns=100))
+                        if ctx.get(dut.i_stream.ready) != readies[select]:
+                            bad.append("i_ready")
+                        for k in range(count):
+                            expect_valid = i_valid & (1 if select == k else 0)
+                            o_valid = ctx.get(dut.o_streams[k].valid)
+                            if o_valid != expect_valid:
+                                bad.append(("o_valid", k))
+                            # Payload is only meaningful when the output presents it (valid == 1);
+                            # unselected outputs may drive an arbitrary payload.
+                            if o_valid and ctx.get(dut.o_streams[k].payload) != payload:
+                                bad.append(("o_payload", k))
+                return tb
+
+            sim = Simulator(dut)
+            sim.add_testbench(make_tb(rng, count, width, dut, bad))
+            sim.run()
+            self.assertEqual(bad, [], msg=f"seed={seed}")
+
