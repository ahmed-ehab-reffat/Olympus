+            count = rng.randint(1, 4)
+            width = 6
+            inputs = [rng.randrange(1 << width) for _ in range(rng.randint(0, 12))]
+            got = {k: [] for k in range(count)}
+            dut = stream.Fork(width, count)
+
+            def make_tb(rng, inputs, count, got, dut):
+                async def tb(ctx):
+                    idx = cyc = empty = 0
+                    presenting = False
+                    while cyc < 40000:
+                        cyc += 1
+                        draining = idx >= len(inputs)
+                        if not draining and not presenting and rng.random() < 0.6:
+                            presenting = True
+                        wv = presenting and not draining
+                        ctx.set(dut.i_stream.valid, 1 if wv else 0)
+                        if wv:
+                            ctx.set(dut.i_stream.payload, inputs[idx])
+                        for k in range(count):
+                            ctx.set(dut.o_streams[k].ready, 1 if (True if draining else rng.random() < 0.5) else 0)
+                        i_ready = ctx.get(dut.i_stream.ready)
+                        ovs = [ctx.get(dut.o_streams[k].valid) for k in range(count)]
+                        ops = [ctx.get(dut.o_streams[k].payload) for k in range(count)]
+                        ords = [ctx.get(dut.o_streams[k].ready) for k in range(count)]
+                        recv_now = wv and i_ready
+                        sends = [k for k in range(count) if ovs[k] and ords[k]]
+                        await ctx.tick()
+                        if recv_now:
+                            idx += 1
+                            presenting = False
+                        for k in sends:
+                            got[k].append(ops[k])
+                        if draining:
+                            empty = empty + 1 if not any(ovs) else 0
+                            if empty >= 3:
+                                break
+                return tb
+
+            sim = Simulator(dut)
+            sim.add_clock(Period(MHz=1))
+            sim.add_testbench(make_tb(rng, inputs, count, got, dut))
+            sim.run()
+            for k in range(count):
+                self.assertEqual(got[k], inputs, msg=f"seed={seed} out={k}")
