+from pyocd.core import exceptions
+from pyocd.commands import commands
+from pyocd.commands.execution_context import CommandExecutionContext
+from pyocd.core.target import Target
+from pyocd.coresight.cortex_m import CortexM
+from pyocd.coresight.cortex_m_core_registers import (
+    CoreRegisterGroups,
+    index_for_reg,
+)
+from pyocd.coresight.dwt import (DWT, DWTv2)
+from pyocd.debug.context import DebugContext
+from pyocd.debug.elf.decoder import SymbolInfo
+from pyocd.gdbserver.context_facade import GDBDebugContextFacade
+from pyocd.utility.graph import GraphNode
+from pyocd.utility.notification import Notifier
+
+WRITE = Target.WatchpointType.WRITE
+READ = Target.WatchpointType.READ
+ACCESS = Target.WatchpointType.READ_WRITE
+
+DHCSR = 0xE000EDF0
+DCRSR = 0xE000EDF4
+DCRDR = 0xE000EDF8
+DEMCR = 0xE000EDFC
+DFSR = 0xE000ED30
+DWT_BASE = 0xE0001000
+
+C_DEBUGEN = 1 << 0
+C_HALT = 1 << 1
+C_STEP = 1 << 2
+S_REGRDY = 1 << 16
+S_HALT = 1 << 17
+
+DFSR_HALTED = 1 << 0
+DFSR_BKPT = 1 << 1
+DFSR_DWTTRAP = 1 << 2
+
+MATCHED = 1 << 24
+
+
+class FakeDP:
+    def flush(self):
+        pass
+
+
+class FakeDebugAP:
+    def __init__(self, version=1, comparators=4, max_mask=15, pair_flag="base"):
+        self.version = version
+        self.count = comparators
+        if isinstance(max_mask, int):
+            max_mask = [max_mask] * comparators
+        self.max_mask = max_mask
+        self.pair_flag = pair_flag
+        self.comp = [0] * comparators
+        self.mask = [0] * comparators
+        self.mask_writes = [[] for _ in range(comparators)]
+        self.function = [0] * comparators
+        self.matched = [False] * comparators
+        self.halted = True
+        self.dfsr = 0
+        self.demcr = 0
+        self.dcrdr = 0
+        self.regs = {}
+        self.step_accesses = []
+        self.run_accesses = []
+        self.steps = 0
+        self.fail_enable_at = None
+        self.enables = 0
+        self.fail_register = None
+        self.fail_register_at = None
+        self.register_writes = 0
+        self.dp = FakeDP()
+
+    def _comparator(self, addr):
+        offset = addr - DWT_BASE - 0x20
+        if offset < 0 or offset >= 0x10 * self.count:
+            return None, None
+        return offset // 0x10, offset % 0x10
+
+    def _read(self, addr):
+        if addr == DHCSR:
+            value = C_DEBUGEN | S_REGRDY
+            if self.halted:
+                value |= C_HALT | S_HALT
+            return value
+        if addr == DFSR:
+            return self.dfsr
+        if addr == DEMCR:
+            return self.demcr
+        if addr == DCRDR:
+            return self.dcrdr
+        if addr == DWT_BASE:
+            return self.count << 28
+        n, reg = self._comparator(addr)
+        if n is None:
+            return 0
+        if reg == 0:
+            return self.comp[n]
+        if reg == 4:
+            return self.mask[n] if self.version == 1 else 0
+        if reg == 8:
+            value = self.function[n] | (MATCHED if self.matched[n] else 0)
+            self.matched[n] = False
+            return value
+        return 0
+
+    def _write(self, addr, value):
+        value &= 0xFFFFFFFF
+        if addr == DHCSR:
+            if value & C_HALT:
+                if not self.halted:
+                    self.dfsr |= DFSR_HALTED
+                self.halted = True
+            elif value & C_STEP:
+                self.halted = False
+                self.steps += 1
+                if self.step_accesses:
+                    step_access = self.step_accesses.pop(0)
+                    if step_access is not None:
+                        self.access(*step_access)
+                self.halted = True
+                self.dfsr |= DFSR_HALTED
+            else:
+                self.halted = False
+                if self.run_accesses:
+                    self.access(*self.run_accesses.pop(0))
+        elif addr == DFSR:
+            self.dfsr &= ~value
+        elif addr == DEMCR:
+            self.demcr = value
+        elif addr == DCRDR:
+            self.dcrdr = value
+        elif addr == DCRSR:
+            reg = value & 0x7F
+            if value & (1 << 16):
+                self.regs[reg] = self.dcrdr
+            else:
+                self.dcrdr = self.regs.get(reg, 0)
+        else:
+            n, reg = self._comparator(addr)
+            if n is None:
+                return
+            if reg == self.fail_register:
+                self.register_writes += 1
+                if self.register_writes == self.fail_register_at:
+                    raise exceptions.TransferError("fault writing comparator register")
+            if reg == 0:
+                self.comp[n] = value
+            elif reg == 4 and self.version == 1:
+                self.mask_writes[n].append(value & 0x1F)
+                self.mask[n] = min(value & 0x1F, self.max_mask[n])
+            elif reg == 8:
+                if value & 0xF:
+                    self.enables += 1
+                    if self.enables == self.fail_enable_at:
+                        raise exceptions.TransferError("fault writing FUNCTION")
+                self.function[n] = value & ~MATCHED
+
+    def read_memory(self, addr, transfer_size=32, now=True):
+        value = self._read(addr)
+        if now:
+            return value
+        return lambda: value
+
+    def write_memory(self, addr, value, transfer_size=32):
+        self._write(addr, value)
+
+    def read32(self, addr, now=True):
+        return self.read_memory(addr, 32, now)
+
+    def write32(self, addr, value):
+        self.write_memory(addr, value)
+
+    V1_KINDS = {5: "r", 6: "w", 7: "rw"}
+    V2_KINDS = {4: "rw", 5: "w", 6: "r"}
+
+    def _hits_v1(self, addr, kind):
+        hits = []
+        for n in range(self.count):
+            code = self.function[n] & 0xF
+            if kind not in self.V1_KINDS.get(code, ""):
+                continue
+            m = self.mask[n]
+            if (addr >> m) == (self.comp[n] >> m):
+                hits.append(n)
+        return hits
+
+    def _hits_v2(self, addr, kind):
+        hits = []
+        n = 0
+        while n < self.count:
+            code = self.function[n] & 0xF
+            action = (self.function[n] >> 4) & 0x3
+            linked = (n % 2 == 0 and n + 1 < self.count
+                      and (self.function[n + 1] & 0xF) == 0b0111)
+            if action == 1 and kind in self.V2_KINDS.get(code, ""):
+                if linked:
+                    if self.comp[n] <= addr <= self.comp[n + 1]:
+                        if self.pair_flag in ("base", "both"):
+                            hits.append(n)
+                        if self.pair_flag in ("limit", "both"):
+                            hits.append(n + 1)
+                else:
+                    size = 1 << ((self.function[n] >> 10) & 0x3)
+                    low = self.comp[n] & ~(size - 1)
+                    if low <= addr < low + size:
+                        hits.append(n)
+            n += 2 if linked else 1
+        return hits
+
+    def hits(self, addr, kind):
+        if self.version == 1:
+            return self._hits_v1(addr, kind)
+        return self._hits_v2(addr, kind)
+
+    def access(self, addr, kind):
+        hits = self.hits(addr, kind)
+        for n in hits:
+            self.matched[n] = True
+        if hits:
+            self.dfsr |= DFSR_DWTTRAP
+            self.halted = True
+        return bool(hits)
+
+    def watched(self, low, high, kind):
+        return [a for a in range(low, high) if self.hits(a, kind)]
+
+    def enabled(self):
+        return [n for n in range(self.count) if self.function[n] & 0xF]
+
+
+class FakeOptions(dict):
+    def get(self, key, default=None):
+        return super().get(key, default)
+
+
+class FakePrintProxy:
+    def push_target(self, target):
+        return contextlib.nullcontext()
+
+
+class FakeSymbols:
+    def __init__(self, symbols):
+        self.symbols = {sym.name: sym for sym in symbols}
+
+    def get_symbol_for_name(self, name):
+        return self.symbols.get(name)
+
+
+class FakeElf:
+    def __init__(self, *symbols):
+        self.symbol_decoder = FakeSymbols(symbols)
+
+
+class FakeTarget:
+    def __init__(self):
+        self.selected_core = None
+        self.svd_device = None
+        self.elf = None
+        self.cores = {}
+
+    def is_locked(self):
+        return False
+
+    def add_target_command_groups(self, command_set):
+        pass
+
+
+class FakeBoard:
+    def __init__(self):
+        self.target = FakeTarget()
+
+
+class FakeSession(Notifier):
+    def __init__(self):
+        super().__init__()
+        self.options = FakeOptions()
+        self.probe = None
+        self.is_open = True
+        self.board = FakeBoard()
+        self.target = self.board.target
+        self.user_script_print_proxy = FakePrintProxy()
+
+
+class FakeRoot(GraphNode):
+    def flush(self):
+        pass
+
+
+def make_core(version=1, comparators=4, max_mask=15, pair_flag="base"):
+    ap = FakeDebugAP(version, comparators, max_mask, pair_flag)
+    core = CortexM(FakeSession(), ap)
+    core.core_registers.add_group(CoreRegisterGroups.M_PROFILE_COMMON)
+    FakeRoot().add_child(core)
+    unit = DWT(ap, None, DWT_BASE) if version == 1 else DWTv2(ap, None, DWT_BASE)
+    core.add_child(unit)
+    ap.regs[index_for_reg('pc')] = 0x00000400
+    ap.regs[index_for_reg('sp')] = 0x20001000
+    return core, ap
+
+
+def run_and_hit(core, ap, addr, kind):
+    core.resume()
+    assert ap.access(addr, kind)
+
+
+def stop_reply(core):
+    return GDBDebugContextFacade(DebugContext(core)).get_t_response()
+
+
+def watch_fields(reply):
+    fields = {}
+    for key, value in re.findall(rb"(rwatch|awatch|watch):([0-9a-fA-F]+);", reply):
+        fields.setdefault(key.decode(), []).append(int(value, 16))
+    assert len(re.findall(rb"watch:", reply)) == sum(len(values) for values in fields.values())
+    return fields
+
+
+class ResetHandledElsewhere:
+    def will_reset(self, core, reset_type):
+        return True
+
+
+def run_command(ctx, out, line):
+    out.truncate(0)
+    out.seek(0)
+    ctx.process_command_line(line)
+    return out.getvalue()
+
+
+def commander(core):
+    out = io.StringIO()
+    ctx = CommandExecutionContext(no_init=True, output_stream=out)
+    core.session.board.target.selected_core = core
+    core.session.board.target.cores = {0: core}
+    ctx.attach_session(core.session)
+    ctx.selected_core = core
+    return ctx, out
+
+
+class TestWatchCoverage:
+    def test_v1_unaligned_word_watches_exactly_its_bytes(self):
+        core, ap = make_core()
+        assert core.set_watchpoint(0x20000012, 4, ACCESS)
+        expected = list(range(0x20000012, 0x20000016))
+        assert ap.watched(0x20000000, 0x20000030, "w") == expected
+        assert ap.watched(0x20000000, 0x20000030, "r") == expected
+
+    def test_v1_odd_length_watches_exactly_its_bytes(self):
+        core, ap = make_core()
+        assert core.set_watchpoint(0x20000003, 6, READ)
+        assert ap.watched(0x20000000, 0x20000020, "r") == list(range(0x20000003, 0x20000009))
+        assert ap.watched(0x20000000, 0x20000020, "w") == []
+
+    def test_one_byte_watches_and_zero_length_is_refused(self):
+        core, ap = make_core(comparators=2)
+        assert core.set_watchpoint(0x20000010, 0, WRITE) is False
+        assert ap.enabled() == []
+        assert core.set_watchpoint(0x20000013, 1, WRITE)
+        assert core.set_watchpoint(0x20000021, 1, READ)
+        assert ap.watched(0x20000000, 0x20000030, "w") == [0x20000013]
+        assert ap.watched(0x20000000, 0x20000030, "r") == [0x20000021]
+
+    def test_range_past_the_top_of_memory_watches_no_low_address(self):
+        core, ap = make_core()
+        core.set_watchpoint(0xFFFFFFFE, 4, WRITE)
+        assert ap.watched(0, 0x10, "w") == []
+        assert core.set_watchpoint(0x20000011, 6, WRITE)
+        assert ap.watched(0x20000000, 0x20000020, "w") == list(range(0x20000011, 0x20000017))
+
+    @pytest.mark.parametrize("version", [1, 2])
+    def test_lengths_below_one_write_no_comparator(self, version):
+        core, ap = make_core(version=version)
+        assert core.set_watchpoint(0x20000010, 0, WRITE) is False
+        assert core.set_watchpoint(0x20000010, -1, WRITE) is False
+        assert core.set_watchpoint(0x20000010, -16, READ) is False
+        assert ap.enabled() == []
+        assert core.set_watchpoint(0x20000011, 2, WRITE)
+        before = (list(ap.comp), list(ap.mask), list(ap.function))
+        assert core.set_watchpoint(0x20000040, -4, ACCESS) is False
+        assert (list(ap.comp), list(ap.mask), list(ap.function)) == before
+        assert ap.watched(0x20000000, 0x20000050, "w") == [0x20000011, 0x20000012]
+
+    def test_v2_one_byte_at_an_odd_address_uses_one_comparator(self):
+        core, ap = make_core(version=2, comparators=2)
+        assert core.set_watchpoint(0x20000013, 0, READ) is False
+        assert core.set_watchpoint(0x20000013, 1, READ)
+        assert core.set_watchpoint(0x20000021, 2, WRITE) is False
+        assert ap.watched(0x20000000, 0x20000030, "w") == []
+        assert ap.watched(0x20000000, 0x20000030, "r") == [0x20000013]
+        assert len(ap.enabled()) == 1
+
+    def test_v1_block_larger_than_max_mask_is_split(self):
+        core, ap = make_core(max_mask=4)
+        assert core.set_watchpoint(0x20000100, 64, WRITE)
+        assert ap.watched(0x200000F0, 0x20000150, "w") == list(range(0x20000100, 0x20000140))
+
+    def test_v2_unaligned_halfword_uses_a_pair(self):
+        core, ap = make_core(version=2)
+        assert core.set_watchpoint(0x20000022, 2, WRITE)
+        assert core.set_watchpoint(0x20000031, 2, WRITE)
+        assert ap.watched(0x20000000, 0x20000040, "w") == [0x20000022, 0x20000023, 0x20000031, 0x20000032]
+        assert len(ap.enabled()) == 3
+        limits = [n for n in ap.enabled() if ap.function[n] & 0xF == 0b0111]
+        assert len(limits) == 1
+        limit = limits[0]
+        assert limit % 2 == 1
+        assert (ap.comp[limit - 1], ap.comp[limit]) == (0x20000031, 0x20000032)
+
+    def test_v2_range_uses_a_linked_pair(self):
+        core, ap = make_core(version=2)
+        assert core.set_watchpoint(0x20000005, 11, ACCESS)
+        assert ap.watched(0x20000000, 0x20000020, "r") == list(range(0x20000005, 0x20000010))
+        assert len(ap.enabled()) == 2
+
+
+class TestComparatorLimits:
+    def test_large_block_goes_to_the_comparator_that_can_hold_it(self):
+        core, ap = make_core(max_mask=[2, 6, 2, 2])
+        assert core.set_watchpoint(0x20000100, 64, WRITE)
+        assert ap.watched(0x200000C0, 0x20000180, "w") == list(range(0x20000100, 0x20000140))
+        assert len(ap.enabled()) == 1
+
+    def test_a_comparator_limit_is_probed_with_31_before_it_is_used(self):
+        core, ap = make_core(max_mask=[3, 6, 2, 9])
+        assert core.set_watchpoint(0x20000200, 0x200, READ)
+        assert ap.enabled()
+        assert all(31 in ap.mask_writes[n] for n in ap.enabled())
+        assert ap.watched(0x200001F0, 0x20000410, "r") == list(range(0x20000200, 0x20000400))
+        assert len(ap.enabled()) == 1
+
+    def test_block_too_large_for_the_rest_is_split(self):
+        core, ap = make_core(max_mask=[2, 4, 2, 2])
+        assert core.set_watchpoint(0x20000200, 24, WRITE)
+        assert ap.watched(0x200001F0, 0x20000230, "w") == list(range(0x20000200, 0x20000218))
+        assert len(ap.enabled()) == 3
+
+    def test_request_needing_more_large_comparators_than_exist_is_refused(self):
+        core, ap = make_core(max_mask=[4, 2, 2, 2])
+        assert core.set_watchpoint(0x20000200, 32, WRITE) is False
+        assert ap.enabled() == []
+        assert core.set_watchpoint(0x20000200, 24, WRITE)
+        assert ap.watched(0x200001F0, 0x20000230, "w") == list(range(0x20000200, 0x20000218))
+
+    def test_used_large_comparator_is_not_counted(self):
+        core, ap = make_core(max_mask=[2, 6, 2, 2])
+        assert core.set_watchpoint(0x20000400, 64, READ)
+        assert core.set_watchpoint(0x20000100, 16, WRITE) is False
+        assert core.set_watchpoint(0x20000100, 12, WRITE)
+        assert ap.watched(0x200000F0, 0x20000120, "w") == list(range(0x20000100, 0x2000010C))
+        assert ap.watched(0x200003F0, 0x20000450, "r") == list(range(0x20000400, 0x20000440))
+        assert len(ap.enabled()) == 4
+
+
+class TestV2Singles:
+    def test_range_without_a_free_pair_uses_single_comparators(self):
+        core, ap = make_core(version=2, comparators=3)
+        assert core.set_watchpoint(0x20000100, 4, READ)
+        assert core.set_watchpoint(0x20000002, 6, WRITE)
+        assert ap.watched(0x20000000, 0x20000010, "w") == list(range(0x20000002, 0x20000008))
+        assert ap.watched(0x20000100, 0x20000104, "r") == list(range(0x20000100, 0x20000104))
+        assert len(ap.enabled()) == 3
+
+    def test_odd_range_without_a_free_pair_uses_one_two_and_four_byte_pieces(self):
+        core, ap = make_core(version=2, comparators=6)
+        for n in range(6):
+            assert core.set_watchpoint(0x20000100 + 4 * n, 4, READ)
+        for n in (1, 3, 5):
+            core.remove_watchpoint(0x20000100 + 4 * n, 4, READ)
+        assert core.set_watchpoint(0x20000001, 7, WRITE)
+        assert ap.watched(0x20000000, 0x20000010, "w") == list(range(0x20000001, 0x20000008))
+        assert len(ap.enabled()) == 6
+
+    def test_range_without_a_free_pair_that_needs_too_many_singles_is_refused(self):
+        core, ap = make_core(version=2, comparators=3)
+        assert core.set_watchpoint(0x20000100, 4, READ)
+        before = (list(ap.comp), list(ap.function))
+        assert core.set_watchpoint(0x20000001, 7, WRITE) is False
+        assert (list(ap.comp), list(ap.function)) == before
+        assert core.set_watchpoint(0x20000002, 6, WRITE)
+        assert ap.watched(0x20000000, 0x20000010, "w") == list(range(0x20000002, 0x20000008))
+
+    def test_hit_on_a_later_single_names_the_request(self):
+        core, ap = make_core(version=2, comparators=3)
+        assert core.set_watchpoint(0x20000100, 4, READ)
