+describe('inlining a single instance', () => {
+  it('keeps an equation whose parameter has a very small value', () => {
+    expectPreserved(tinyScene('`th`', ['th=-1:0.01:1:0'], { th: 1e-7 }), (s) => s.inlineModuleInstance('Rig', 0));
+  });
+
+  it('keeps the inlined module and its other instances', () => {
+    const data = readModuleScene('CoatedLens');
+    const scene = expectPreserved(data, (s) => s.inlineModuleInstance('CoatedLens', 2));
+    expect(scene.modules.ArcCoating).toBeDefined();
+    expect(moduleRows(scene, 'CoatedLens').filter((row) => row.module === 'ArcCoating')).toHaveLength(1);
+  });
+
+  it('merges the loops and conditions of the inlined row', () => {
+    const scene = expectPreserved({
+      modules: {
+        Arm: ARM,
+        Rig: { numPoints: 1, params: ['m=0:1:10:5'], objs: [{ type: 'ModuleObj', module: 'Arm', for: 'i=1:1:3', if: 'i < 3', points: [{ x: '`x_1 + 10*i`', y: '`y_1`' }], params: { a: '`i`', b: '`i + m`' } }] },
+      },
+      objs: [{ type: 'ModuleObj', module: 'Rig', points: [{ x: 0, y: 0 }], params: { m: 5 } }],
+    }, (s) => s.inlineModuleInstance('Rig', 0));
+    expect(scene.modules.Arm).toBeDefined();
+    expect(moduleRows(scene, 'Rig').some((row) => row.module === 'Arm')).toBe(false);
+  });
+});
+
+describe('renaming a module parameter', () => {
+  it('renames a parameter used inside functions of the coating module', () => {
+    const scene = expectPreserved(readModuleScene('CoatedLens'), (s) => s.renameModuleParam('ArcCoating', 'A', 'Q'));
+    expect(paramNames(scene, 'ArcCoating')).toEqual(['B', 'Q', 'd']);
+    for (const row of moduleRows(scene, 'CoatedLens').filter((r) => r.module === 'ArcCoating')) {
+      expect(Object.keys(row.params).sort()).toEqual(['B', 'Q', 'd']);
+    }
+  });
+
+  it('leaves a function argument with the same name alone', () => {
+    const scene = expectPreserved({
+      modules: {
+        Arm: ARM,
+        Rig: { numPoints: 1, params: ['a=0:1:9:2'], vars: ['g(a) = a*3', 'h = a + 1'], objs: [{ type: 'ModuleObj', module: 'Arm', points: [{ x: '`x_1 + a`', y: '`y_1`' }], params: { a: '`g(2) + a`', b: '`h`' } }] },
+      },
+      objs: [{ type: 'ModuleObj', module: 'Rig', points: [{ x: 1, y: 2 }], params: { a: 4 } }],
+    }, (s) => s.renameModuleParam('Rig', 'a', 'k'));
+    expect(paramNames(scene, 'Rig')).toEqual(['k']);
+    expect(scene.objs[0].params).toEqual({ k: 4 });
+  });
+
+  it('leaves uses of a row loop variable that shares the parameter name alone', () => {
+    const scene = expectPreserved({
+      modules: { Comb: COMB },
+      objs: [{ type: 'ModuleObj', module: 'Comb', points: [{ x: 0, y: 0 }], params: { i: 5, c: 2 } }],
+    }, (s) => s.renameModuleParam('Comb', 'i', 'r'));
+    expect(paramNames(scene, 'Comb')).toEqual(['c', 'r']);
+  });
+
+  it('leaves uses of a nested loop variable that shares the parameter name alone', () => {
+    expectPreserved({
+      modules: {
+        Mir: {
+          numPoints: 0,
+          params: ['n=1:1:9:3'],
+          objs: [{ type: 'ParamMirror', pieces: [
+            { for: 'n=1:1:2', eqnX: '``t``', eqnY: '``t``', tMin: '`n`', tMax: '`n + 1`', tStep: 0.5 },
+            { eqnX: '``t``', eqnY: '``2*t``', tMin: '`n`', tMax: '`n + 1`', tStep: 0.5 },
+          ] }],
+        },
+      },
+      objs: [{ type: 'ModuleObj', module: 'Mir', params: { n: 5 } }],
+    }, (s) => s.renameModuleParam('Mir', 'n', 'm'));
+  });
+
+  it('keeps the instance row loop of the same name when renaming a containing module parameter', () => {
+    const scene = expectPreserved({
+      modules: { Arm: ARM, Rig: shadowedRig() },
+      objs: [{ type: 'ModuleObj', module: 'Rig', points: [{ x: 0, y: 0 }], params: { i: 6 } }],
+    }, (s) => s.renameModuleParam('Rig', 'i', 'k'));
+    expect(scene.objs[0].params).toEqual({ k: 6 });
+  });
+
+  it('renames while an unrelated instance fails to expand', () => {
+    expectPreserved({
+      modules: { Arm: ARM, Tick: BROKEN_TICK },
+      objs: [{ type: 'ModuleObj', module: 'Arm', points: [{ x: 1, y: 2 }], params: { a: 1, b: 2 } }, { type: 'ModuleObj', module: 'Tick', params: { n: 2000 } }],
+    }, (s) => s.renameModuleParam('Arm', 'a', 'q'));
+  });
+
+  it('refuses a name that is already used or not a plain name', () => {
+    for (const name of ['B', 'lambda', 'x_1', 'random', '2a', 'a b']) {
+      expectRefused(readModuleScene('CoatedLens'), (s) => s.renameModuleParam('ArcCoating', 'A', name));
+    }
+  });
+});
+
+describe('refusing an invalid target', () => {
+  it('refuses to remove a module that does not exist', () => {
+    expectRefused(readModuleScene('CoatedLens'), (s) => s.removeModule('Missing'));
+  });
+
+  it('refuses to inline an instance in a module that does not exist', () => {
+    expectRefused(readModuleScene('CoatedLens'), (s) => s.inlineModuleInstance('Missing', 1));
+  });
+
+  it('refuses to inline at an index outside the objects of the module', () => {
+    expectRefused(readModuleScene('CoatedLens'), (s) => s.inlineModuleInstance('CoatedLens', 3));
+    expectRefused(readModuleScene('CoatedLens'), (s) => s.inlineModuleInstance('CoatedLens', -1));
+  });
+
+  it('refuses to inline a row that is not a module instance', () => {
+    expectRefused(readModuleScene('CoatedLens'), (s) => s.inlineModuleInstance('CoatedLens', 0));
+  });
+
+  it('refuses to rename a parameter of a module that does not exist', () => {
+    expectRefused(armScene(), (s) => s.renameModuleParam('Missing', 'a', 'q'));
+  });
+
+  it('refuses to rename a name that is not a parameter of the module', () => {
+    expectRefused(armScene(), (s) => s.renameModuleParam('Arm', 'missing', 'q'));
+    expectRefused(armScene(), (s) => s.renameModuleParam('Arm', 'w', 'q'));
+  });
+});
