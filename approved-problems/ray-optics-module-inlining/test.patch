+import Scene from '../../src/core/Scene';
+import fs from 'fs';
+import path from 'path';
+
+const RAY_VARIABLES = [
+  { theta0: 0.3, theta1: 0.2, P0: 1, P1: 0.25, lambda: 550, n0: 1, n1: 1.5, p: 0.5 },
+  { theta0: -1.1, theta1: 0.7, P0: 0.6, P1: 0.1, lambda: 420, n0: 1.33, n1: 1, p: 0 },
+  { theta0: 0.9, theta1: -0.4, P0: 2, P1: 1.5, lambda: 700, n0: 1.7, n1: 1.2, p: 1 },
+];
+
+function readModuleScene(name) {
+  return JSON.parse(fs.readFileSync(path.join(__dirname, '../../data/moduleScenes', name + '.json'), 'utf8'));
+}
+
+function load(json) {
+  const scene = new Scene();
+  scene.loadJSON(JSON.stringify({ version: 5, ...json }), () => {});
+  return scene;
+}
+
+function canonical(obj) {
+  const data = obj.serialize();
+  if (Array.isArray(data.outRays)) {
+    obj.initOutRayFns();
+    data.outRays = obj.fns.map((fn) => RAY_VARIABLES.map((vars) => [fn.angleFn(vars), fn.brightnessFn(vars)]));
+  }
+  return JSON.stringify(data, (key, value) => (typeof value === 'number' ? Number(value.toPrecision(10)) : value));
+}
+
+function leaves(objs) {
+  const out = [];
+  for (const obj of objs) {
+    if (obj.constructor.type === 'ModuleObj') {
+      out.push(...leaves(obj.objs));
+    } else {
+      out.push(canonical(obj));
+    }
+  }
+  return out;
+}
+
+function expansion(scene) {
+  return leaves(scene.objs).sort();
+}
+
+function expectPreserved(json, operation) {
+  const scene = load(json);
+  expect(scene.error).toBeNull();
+  const before = expansion(scene);
+  expect(before.length).toBeGreaterThan(0);
+  expect(operation(scene)).toBe(true);
+  expect(scene.error).toBeNull();
+  expect(expansion(scene)).toEqual(before);
+  return scene;
+}
+
+function expectRefused(json, operation) {
+  const scene = load(json);
+  const modules = JSON.stringify(scene.modules);
+  const objs = JSON.stringify(scene.objs.map((obj) => obj.serialize()));
+  expect(operation(scene)).toBe(false);
+  expect(JSON.stringify(scene.modules)).toBe(modules);
+  expect(JSON.stringify(scene.objs.map((obj) => obj.serialize()))).toBe(objs);
+  return scene;
+}
+
+function moduleRows(scene, name) {
+  return scene.modules[name].objs;
+}
+
+function paramNames(scene, name) {
+  return scene.modules[name].params.map((spec) => spec.split('=')[0].trim()).sort();
+}
+
+function dependentRangeScene() {
+  return {
+    modules: {
+      Tick: { numPoints: 0, params: ['n=1:1:10:3'], objs: [{ type: 'TextLabel', for: 'j=1:1:n', x: '`j`', y: '0', text: 't' }] },
+      Grid: { numPoints: 0, params: [], objs: [{ type: 'ModuleObj', module: 'Tick', for: 'i=1:1:4', params: { n: '`i`' } }] },
+    },
+    objs: [{ type: 'ModuleObj', module: 'Grid' }, { type: 'ModuleObj', module: 'Tick', params: { n: 2 } }],
+  };
+}
+
+function dependentTickScene(tickRow) {
+  return {
+    modules: {
+      Tick: { numPoints: 0, params: ['n=1:1:10:3'], objs: [tickRow] },
+      Grid: { numPoints: 0, params: [], objs: [{ type: 'ModuleObj', module: 'Tick', for: 'i=1:1:4', params: { n: '`i`' } }] },
+    },
