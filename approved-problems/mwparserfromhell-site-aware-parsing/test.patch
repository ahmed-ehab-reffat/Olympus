+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+BUILD_LOG="$(mktemp)"
+if ! WITH_EXTENSION=1 python setup.py build_ext --inplace > "$BUILD_LOG" 2>&1; then
+  cat "$BUILD_LOG"
+  if [ -n "$OUTPUT_PATH" ]; then
+    python - "$OUTPUT_PATH" "$BUILD_LOG" <<'XMLPY'
+import sys
+from xml.sax.saxutils import escape
+output_path, log_path = sys.argv[1:3]
+with open(log_path, encoding="utf-8", errors="replace") as fh:
+    log = fh.read()
+with open(output_path, "w", encoding="utf-8") as fh:
+    fh.write('<?xml version="1.0" encoding="UTF-8"?>\n')
+    fh.write('<testsuites name="pytest" tests="1" failures="1" errors="0" time="0">\n')
+    fh.write('<testsuite name="build_ext" tests="1" failures="1" errors="0" time="0">\n')
+    fh.write('<testcase name="c_tokenizer_extension_builds" classname="build_ext">\n')
+    fh.write('<failure message="building the C tokenizer extension failed">' + escape(log) + "</failure>\n")
+    fh.write("</testcase>\n</testsuite>\n</testsuites>\n")
+XMLPY
+  fi
+  rm -f "$BUILD_LOG"
+  exit 1
+fi
+rm -f "$BUILD_LOG"
+
+NEW_TESTS="tests/test_siteinfo_ea9bb1.py"
+if [ "$MODE" = "new" ]; then
+  TARGETS=("$NEW_TESTS")
+else
+  TARGETS=(tests --ignore="$NEW_TESTS")
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  python -m pytest -q -p no:cacheprovider --junitxml="$OUTPUT_PATH" "${TARGETS[@]}"
+else
+  python -m pytest -q -p no:cacheprovider "${TARGETS[@]}"
+fi
