+def test_both_tokenizers_agree():
+    """test the C and Python tokenizers build the same trees"""
+    assert C_AVAILABLE, "the C tokenizer failed to build or import"
+    restore = parser.use_c
+    try:
+        profiles = [
+            en(),
+            ru(),
+            site(tags=["ref"]),
+            site(tags=[]),
+            site(namespaces=EN_NAMESPACES),
+            site(linktrail="a-b"),
+            site(linktrail="-"),
+            site(linktrail="\U0001F600\U0001F601"),
+        ]
+        for profile in profiles:
+            for text in PARITY_CORPUS:
+                parser.use_c = True
+                with_c = parse(text, profile)
+                parser.use_c = False
+                without_c = parse(text, profile)
+                assert shape(with_c) == shape(without_c)
+                assert with_c.get_tree() == without_c.get_tree()
+                assert [n.trail for n in with_c.filter_wikilinks()] == [
+                    n.trail for n in without_c.filter_wikilinks()
+                ]
+                assert [n.namespace for n in with_c.filter_wikilinks()] == [
+                    n.namespace for n in without_c.filter_wikilinks()
+                ]
+    finally:
+        parser.use_c = restore
+
+
+FRAGMENTS = [
+    "[[foo]]", "[[File:x.png]]", "[[:File:x.png]]", "[[Category:c]]", "[[Talk:x|t]]",
+    "[[a|b]]", "[[a|]]", "[[foo:bar]]", "[[ File : x ]]", "[[File_talk:x]]",
+    "bar", "s", "Baz", "2", " ", "\n", "\u0439", "\U0001F600",
+    "<ref>", "</ref>", "<foo>", "</foo>", "<FOO>", "<br/>", "<foo/>", "<span a=b>",
+    "<nowiki>", "</nowiki>", "<REF>", "</REF>", "<", ">", "</",
+    "{{t|", "}}", "{{{a|", "}}}", "''", "'''", "== ", " ==", "* ", "----", "{|", "|}",
+    "[[", "]]", "|", "[", "]", "<!--", "-->", "&amp;", "http://x.y/z", "\u0424\u0430\u0439\u043b:",
+]
+
+
+def generated_corpus(count, seed):
+    rng = random.Random(seed)
+    for _ in range(count):
+        yield "".join(rng.choice(FRAGMENTS) for _ in range(rng.randint(2, 9)))
+
+
+def test_generated_corpus_tokenizer_parity():
+    """test both tokenizers agree on seeded random compositions"""
+    assert C_AVAILABLE, "the C tokenizer failed to build or import"
+    restore = parser.use_c
+    try:
+        for profile in [en(), ru(), site(tags=[]), site(linktrail="a-b")]:
+            for text in generated_corpus(150, 20260915):
+                parser.use_c = True
+                with_c = parse(text, profile)
+                parser.use_c = False
+                without_c = parse(text, profile)
+                assert shape(with_c) == shape(without_c), text
+                assert with_c.get_tree() == without_c.get_tree(), text
+                assert str(with_c) == text
+    finally:
+        parser.use_c = restore
+
