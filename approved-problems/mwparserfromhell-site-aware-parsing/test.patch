+"""
+Test cases for site-aware parsing: link trails, namespaces and recognized tags.
+"""
+
+from __future__ import annotations
+
+from string import ascii_lowercase
+
+import io
+import random
+
+import pytest
+
+import mwparserfromhell
+from mwparserfromhell import parser
+from mwparserfromhell.nodes import Heading, Tag, Text, Wikilink
+from mwparserfromhell.parser import Parser
+
+SiteInfo = getattr(mwparserfromhell, "SiteInfo", None)
+C_AVAILABLE = parser.use_c
+
+EN_NAMESPACES = {
+    "Talk": 1,
+    "File": 6,
+    "Image": 6,
+    "File talk": 7,
+    "Category": 14,
+}
+EN_TAGS = ["ref", "nowiki", "pre", "math", "b", "i", "span", "div", "br", "hr"]
+CYRILLIC = "абвгдежзийклмнопрстуфхцчшщъыьэюяё"
+
+
+def site(**fields):
+    assert SiteInfo is not None, "mwparserfromhell.SiteInfo is missing"
+    return SiteInfo(**fields)
+
+
+def en(**overrides):
+    fields = dict(linktrail=ascii_lowercase, namespaces=EN_NAMESPACES, tags=EN_TAGS)
+    fields.update(overrides)
+    return site(**fields)
+
+
+def ru():
+    return site(linktrail=CYRILLIC, namespaces={"Файл": 6, "Категория": 14})
+
+
+def parse(text, site=None):
+    return mwparserfromhell.parse(text, site=site)
+
+
+def shape(code):
+    return [(type(node).__name__, str(node)) for node in code.nodes]
+
+
+def link(text, site=None):
+    code = parse(text, site)
+    links = code.filter_wikilinks(recursive=False)
+    assert len(links) == 1
+    return links[0]
+
+
+def tag_names(code):
+    return [str(node.tag) for node in code.filter_tags(recursive=False)]
+
+
+@pytest.fixture(params=["c", "py"])
+def tokenizer(request):
+    restore = parser.use_c
+    if request.param == "c":
+        assert C_AVAILABLE, "the C tokenizer failed to build or import"
+        parser.use_c = True
+    else:
+        parser.use_c = False
+    yield request.param
+    parser.use_c = restore
+
+
+def test_siteinfo_defaults():
+    """test site() with no settings"""
+    profile = site()
+    assert profile.linktrail == ""
+    assert profile.namespaces is None
+    assert profile.tags is None
+
+
+def test_siteinfo_fields_are_exposed():
+    """test the SiteInfo attributes"""
+    profile = en()
+    assert profile.linktrail == ascii_lowercase
+    assert profile.namespaces is not None
+    assert profile.tags is not None
+    assert "ref" in profile.tags
+
+
+def test_trail_attaches_to_link(tokenizer):
+    """test [[foo]]bar attaches bar to the link"""
+    code = parse("[[foo]]bar", en())
+    assert shape(code) == [("Wikilink", "[[foo]]bar")]
+    assert code.nodes[0].trail == "bar"
+
+
+def test_trail_is_longest_run(tokenizer):
+    """test only the leading run of trail characters is absorbed"""
+    code = parse("[[foo]]bar baz", en())
+    assert shape(code) == [("Wikilink", "[[foo]]bar"), ("Text", " baz")]
+
+
+def test_trail_stops_at_newline(tokenizer):
+    """test a newline ends the trail"""
+    code = parse("[[foo]]bar\nbaz", en())
+    assert shape(code) == [("Wikilink", "[[foo]]bar"), ("Text", "\nbaz")]
+
+
+def test_trail_stops_at_character_outside_set(tokenizer):
+    """test uppercase letters and digits outside the set end the trail"""
+    code = parse("[[foo]]barBaz [[foo]]bar2", en())
+    assert shape(code) == [
+        ("Wikilink", "[[foo]]bar"),
+        ("Text", "Baz "),
+        ("Wikilink", "[[foo]]bar"),
+        ("Text", "2"),
+    ]
+
+
+def test_trail_stops_at_style_markup(tokenizer):
+    """test italics after a trail are still parsed"""
+    code = parse("[[foo]]bar''baz''", en())
+    assert shape(code) == [("Wikilink", "[[foo]]bar"), ("Tag", "''baz''")]
+
+
+def test_trail_stops_at_template(tokenizer):
+    """test a template following a trail stays a template"""
+    code = parse("[[foo]]bar{{baz}}", en())
+    assert shape(code) == [("Wikilink", "[[foo]]bar"), ("Template", "{{baz}}")]
+
+
+def test_trail_stops_at_next_link(tokenizer):
+    """test consecutive links each take their own trail"""
+    code = parse("[[a]]b[[c]]d", en())
+    assert shape(code) == [("Wikilink", "[[a]]b"), ("Wikilink", "[[c]]d")]
+
+
+def test_trail_stops_at_recognized_tag(tokenizer):
+    """test a recognized tag after a trail is parsed as a tag"""
+    code = parse("[[a]]b<ref>c</ref>", en())
+    assert shape(code) == [("Wikilink", "[[a]]b"), ("Tag", "<ref>c</ref>")]
+
+
+def test_no_trail_when_link_ends_input(tokenizer):
+    """test a link at the very end of the text has no trail"""
+    code = parse("[[foo]]", en())
+    assert shape(code) == [("Wikilink", "[[foo]]")]
+    assert code.nodes[0].trail == ""
+
+
+def test_no_trail_when_next_character_is_outside_set(tokenizer):
+    """test a link followed by a space has no trail"""
+    code = parse("[[foo]] bar", en())
+    assert shape(code) == [("Wikilink", "[[foo]]"), ("Text", " bar")]
+
+
+def test_no_trail_with_empty_linktrail(tokenizer):
+    """test an empty linktrail never absorbs characters"""
+    code = parse("[[foo]]bar", en(linktrail=""))
+    assert shape(code) == [("Wikilink", "[[foo]]"), ("Text", "bar")]
+
+
+def test_no_trail_without_site(tokenizer):
+    """test parsing without a site keeps the trail as text"""
+    code = parse("[[foo]]bar")
+    assert shape(code) == [("Wikilink", "[[foo]]"), ("Text", "bar")]
+    assert code.nodes[0].trail == ""
+
+
+def test_trail_on_piped_link(tokenizer):
+    """test a trail follows a link with display text"""
+    node = link("[[foo|bar]]s", en())
+    assert str(node) == "[[foo|bar]]s"
+    assert str(node.text) == "bar"
+    assert node.trail == "s"
+
+
+def test_trail_on_pipe_trick_link(tokenizer):
+    """test a trail follows a link with an empty display text"""
+    node = link("[[foo|]]s", en())
+    assert str(node) == "[[foo|]]s"
+    assert node.text is not None
+    assert str(node.text) == ""
+    assert node.trail == "s"
+
+
+def test_trail_on_link_with_markup_in_text(tokenizer):
+    """test a trail follows a link whose text holds a template"""
+    node = link("[[foo|{{x}}]]s", en())
+    assert str(node) == "[[foo|{{x}}]]s"
+    assert node.trail == "s"
+
+
+def test_trail_inside_template_parameter(tokenizer):
+    """test a trail inside a template parameter"""
+    code = parse("{{t|[[foo]]bar baz}}", en())
+    template = code.nodes[0]
+    assert shape(template.get(1).value) == [
+        ("Wikilink", "[[foo]]bar"),
+        ("Text", " baz"),
+    ]
+
+
+def test_trail_inside_heading(tokenizer):
+    """test a trail inside a heading"""
+    code = parse("== [[foo]]bar ==", en())
+    heading = code.nodes[0]
+    assert isinstance(heading, Heading)
+    assert shape(heading.title) == [
+        ("Text", " "),
+        ("Wikilink", "[[foo]]bar"),
+        ("Text", " "),
+    ]
+
+
+def test_trail_inside_tag_body(tokenizer):
+    """test a trail inside a recognized tag"""
+    code = parse("<ref>[[foo]]bar</ref>", en())
+    assert shape(code.nodes[0].contents) == [("Wikilink", "[[foo]]bar")]
+
+
+def test_trail_inside_link_text(tokenizer):
+    """test a link nested in another link's text takes its own trail"""
+    code = parse("[[File:x.png|thumb|[[foo]]bar]]", en())
+    outer = code.nodes[0]
+    assert str(outer) == "[[File:x.png|thumb|[[foo]]bar]]"
+    assert outer.trail == ""
+    inner = outer.text.filter_wikilinks()[0]
+    assert str(inner) == "[[foo]]bar"
+
+
+def test_trail_survives_unclosed_template_reparse(tokenizer):
+    """test a link parsed twice by backtracking keeps its trail once"""
+    code = parse("{{a|[[b]]cd", en())
+    assert shape(code) == [("Text", "{{a|"), ("Wikilink", "[[b]]cd")]
+
+
+def test_file_link_takes_no_trail(tokenizer):
+    """test a file link leaves the following letters as text"""
+    code = parse("[[File:x.png|thumb]]s", en())
+    assert shape(code) == [("Wikilink", "[[File:x.png|thumb]]"), ("Text", "s")]
+    assert code.nodes[0].trail == ""
+
+
+def test_category_link_takes_no_trail(tokenizer):
+    """test a category link leaves the following letters as text"""
+    code = parse("[[Category:Foo]]s", en())
+    assert shape(code) == [("Wikilink", "[[Category:Foo]]"), ("Text", "s")]
+
+
+def test_colon_file_link_takes_trail(tokenizer):
+    """test a leading colon makes a file link ordinary"""
+    code = parse("[[:File:x.png]]s", en())
+    assert shape(code) == [("Wikilink", "[[:File:x.png]]s")]
+    assert code.nodes[0].trail == "s"
+
+
+def test_colon_category_link_takes_trail(tokenizer):
+    """test a leading colon makes a category link ordinary"""
+    code = parse("[[:Category:Foo|cats]]s", en())
+    assert shape(code) == [("Wikilink", "[[:Category:Foo|cats]]s")]
+
+
+def test_alias_namespace_takes_no_trail(tokenizer):
+    """test an alias of the file namespace behaves like it"""
+    code = parse("[[Image:x.png]]s", en())
+    assert shape(code) == [("Wikilink", "[[Image:x.png]]"), ("Text", "s")]
+
+
+def test_lowercase_namespace_takes_no_trail(tokenizer):
+    """test namespace names match regardless of case"""
+    code = parse("[[category:Foo]]s [[FILE:x.png]]s", en())
+    assert shape(code) == [
+        ("Wikilink", "[[category:Foo]]"),
+        ("Text", "s "),
+        ("Wikilink", "[[FILE:x.png]]"),
+        ("Text", "s"),
+    ]
+
+
+def test_namespace_folds_unicode_case(tokenizer):
+    """test namespace prefixes compare caselessly beyond ASCII"""
+    profile = site(linktrail="s", namespaces={"\u03a3": 6, "\u0422\u0435\u043c\u0430": 1})
+    code = parse("[[\u03c2:x]]s [[\u0422\u0415\u041c\u0410:y]]s", profile)
+    assert shape(code) == [
+        ("Wikilink", "[[\u03c2:x]]"),
+        ("Text", "s "),
+        ("Wikilink", "[[\u0422\u0415\u041c\u0410:y]]s"),
+    ]
+    assert [n.namespace for n in code.filter_wikilinks()] == [6, 1]
+
+
+def test_underscored_namespace_matches_spaced_name(tokenizer):
+    """test underscores in a namespace prefix match spaces in its name"""
+    node = link("[[File_talk:x.png]]s", en())
+    assert node.namespace == 7
+    assert node.trail == "s"
+
+
+def test_padded_namespace_takes_no_trail(tokenizer):
+    """test whitespace around the namespace prefix is ignored"""
+    code = parse("[[ File : x.png]]s", en())
+    assert shape(code) == [("Wikilink", "[[ File : x.png]]"), ("Text", "s")]
+    assert code.nodes[0].namespace == 6
+
+
+def test_unknown_prefix_takes_trail(tokenizer):
+    """test an unknown prefix is an ordinary title"""
+    node = link("[[Foo:Bar]]s", en())
+    assert str(node) == "[[Foo:Bar]]s"
+    assert node.namespace == 0
+
+
+def test_other_namespace_takes_trail(tokenizer):
+    """test a talk link takes a trail"""
+    node = link("[[Talk:Foo]]s", en())
+    assert str(node) == "[[Talk:Foo]]s"
+    assert node.namespace == 1
+
+
+def test_file_link_takes_trail_without_namespaces(tokenizer):
+    """test File: is not special when no namespaces are given"""
+    node = link("[[File:x.png]]s", en(namespaces=None))
+    assert str(node) == "[[File:x.png]]s"
+    assert node.namespace is None
+
+
+def test_first_colon_decides_namespace(tokenizer):
+    """test only the first colon separates the namespace"""
+    node = link("[[File:a:b]]s", en())
+    assert node.namespace == 6
+    assert node.trail == ""
+
+
+def test_namespace_prefix_with_markup_is_main(tokenizer):
+    """test a prefix produced by a template is not a namespace"""
+    node = link("[[{{ns}}:Foo]]s", en())
+    assert node.namespace == 0
+    assert str(node) == "[[{{ns}}:Foo]]s"
+
+
+def test_file_title_with_template_page_name(tokenizer):
+    """test the namespace is read even when the page name is a template"""
+    code = parse("[[File:{{x}}]]s", en())
+    assert shape(code) == [("Wikilink", "[[File:{{x}}]]"), ("Text", "s")]
+    assert code.nodes[0].namespace == 6
+
+
+def test_namespace_without_site_is_none(tokenizer):
+    """test namespace is unknown without a site"""
+    assert link("[[File:x.png]]").namespace is None
+
+
+def test_namespace_of_plain_title_is_main(tokenizer):
+    """test a title without a prefix is in the main namespace"""
+    assert link("[[Foo]]", en()).namespace == 0
+
+
+def test_colon_link_keeps_namespace(tokenizer):
+    """test the namespace is reported even with a leading colon"""
+    assert link("[[:Category:Foo]]", en()).namespace == 14
+
+
+def test_cyrillic_trail(tokenizer):
+    """test a non-Latin trail set"""
+    code = parse("[[Москва]]ой. [[Файл:x.png]]ы [[:Файл:x.png]]ы", ru())
+    assert shape(code) == [
+        ("Wikilink", "[[Москва]]ой"),
+        ("Text", ". "),
+        ("Wikilink", "[[Файл:x.png]]"),
+        ("Text", "ы "),
+        ("Wikilink", "[[:Файл:x.png]]ы"),
+    ]
+    assert code.nodes[0].trail == "ой"
+    assert code.nodes[2].namespace == 6
+
+
+def test_cyrillic_trail_ignores_latin_letters(tokenizer):
+    """test letters outside a non-Latin set stay text"""
+    code = parse("[[Москва]]bar", ru())
+    assert shape(code) == [("Wikilink", "[[Москва]]"), ("Text", "bar")]
+
+
+def test_latin_trail_ignores_cyrillic_letters(tokenizer):
+    """test letters outside a Latin set stay text in mixed input"""
+    code = parse("[[foo]]bar [[foo]]ой", en())
+    assert shape(code) == [
+        ("Wikilink", "[[foo]]bar"),
+        ("Text", " "),
+        ("Wikilink", "[[foo]]"),
+        ("Text", "ой"),
+    ]
+
+
+def test_astral_trail_characters(tokenizer):
+    """test trail characters outside the basic multilingual plane"""
+    profile = site(linktrail="\U0001F600\U0001F601")
+    code = parse("[[foo]]\U0001F600\U0001F601x", profile)
+    assert shape(code) == [("Wikilink", "[[foo]]\U0001F600\U0001F601"), ("Text", "x")]
+
+
+def test_trail_characters_with_markup_meaning(tokenizer):
+    """test trail characters that double as markup are absorbed"""
+    code = parse("[[x]]a-b-a c", site(linktrail="a-b"))
+    assert shape(code) == [("Wikilink", "[[x]]a-b-a"), ("Text", " c")]
+    assert code.nodes[0].trail == "a-b-a"
+
+
+def test_trail_of_only_markup_characters(tokenizer):
+    """test a trail made of markup characters alone"""
+    code = parse("[[x]]--y", site(linktrail="-"))
+    assert shape(code) == [("Wikilink", "[[x]]--"), ("Text", "y")]
+
+
+def test_trail_run_ends_inside_a_word(tokenizer):
+    """test the run ends mid-word at the first character outside the set"""
+    code = parse("[[x]]a-bc", site(linktrail="a-b"))
+    assert shape(code) == [("Wikilink", "[[x]]a-b"), ("Text", "c")]
+
+
+def test_nul_trail_character(tokenizer):
+    """test a NUL character in the linktrail is absorbed like any other"""
+    code = parse("[[x]]\0z", site(linktrail="\0"))
+    assert shape(code) == [("Wikilink", "[[x]]\0"), ("Text", "z")]
+
+
+def test_unknown_tag_is_text(tokenizer):
+    """test an unrecognized tag pair is plain text"""
+    code = parse("<quetsch>a</quetsch>", en())
+    assert shape(code) == [("Text", "<quetsch>a</quetsch>")]
+
+
+def test_recognized_tag_is_parsed(tokenizer):
+    """test a recognized tag is still a tag"""
+    code = parse("<ref>a</ref>", en())
+    assert shape(code) == [("Tag", "<ref>a</ref>")]
+
+
+def test_tag_recognition_ignores_case(tokenizer):
+    """test tag names match regardless of case"""
+    code = parse("<REF>a</REF>", en())
+    assert shape(code) == [("Tag", "<REF>a</REF>")]
+
+
+def test_tag_recognition_folds_unicode_case(tokenizer):
+    """test tag names compare caselessly beyond ASCII"""
+    code = parse("<\u03c2/> <\u03a3/>", site(tags=["\u03a3"]))
+    assert shape(code) == [("Tag", "<\u03c2/>"), ("Text", " "), ("Tag", "<\u03a3/>")]
+    assert shape(parse("<\u03c2/>", site(tags=["x"]))) == [("Text", "<\u03c2/>")]
+
+
+def test_recognized_tag_with_attributes_is_parsed(tokenizer):
+    """test a recognized tag keeps its attributes"""
+    code = parse('<ref name="x">a</ref>', en())
+    assert shape(code) == [("Tag", '<ref name="x">a</ref>')]
+    assert str(code.nodes[0].tag) == "ref"
+    assert str(code.nodes[0].attributes[0]) == ' name="x"'
+    assert shape(code.nodes[0].contents) == [("Text", "a")]
+
+
+def test_recognized_self_closing_tag_with_attributes_is_parsed(tokenizer):
+    """test a recognized self-closing tag keeps its attributes"""
+    code = parse("<ref name=foo/> <span id=a>b</span>", en())
+    assert shape(code) == [
+        ("Tag", "<ref name=foo/>"),
+        ("Text", " "),
+        ("Tag", "<span id=a>b</span>"),
+    ]
+    assert tag_names(code) == ["ref", "span"]
+
+
+def test_unknown_self_closing_tag_is_text(tokenizer):
+    """test an unrecognized self-closing tag is plain text"""
+    code = parse("a<foo/>b", en())
+    assert shape(code) == [("Text", "a<foo/>b")]
+
+
+def test_unknown_tag_with_attributes_is_text(tokenizer):
+    """test attributes do not make an unrecognized tag a tag"""
+    code = parse('<foo class="x">a</foo>', en())
+    assert shape(code) == [("Text", '<foo class="x">a</foo>')]
+
+
+def test_unknown_tag_inside_recognized_tag_is_text(tokenizer):
+    """test an unrecognized tag inside a recognized one is text"""
+    code = parse("<span><foo>a</foo></span>", en())
+    assert shape(code) == [("Tag", "<span><foo>a</foo></span>")]
+    assert shape(code.nodes[0].contents) == [("Text", "<foo>a</foo>")]
+
+
+def test_unknown_tag_inside_template_parameter_is_text(tokenizer):
+    """test an unrecognized tag inside a template parameter is text"""
+    code = parse("{{t|<foo>a</foo>}}", en())
+    assert shape(code) == [("Template", "{{t|<foo>a</foo>}}")]
+    assert shape(code.nodes[0].params[0].value) == [("Text", "<foo>a</foo>")]
+
+
+def test_unknown_tag_inside_heading_is_text(tokenizer):
+    """test an unrecognized tag inside a heading is text"""
+    code = parse("== <foo>a</foo> ==", en())
