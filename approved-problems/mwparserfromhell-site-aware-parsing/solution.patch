+"""
+Wiki-specific settings that the parser cannot know on its own: the linktrail
+characters, the namespace names, and the set of recognized tags.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping
+from typing import Any
+
+__all__ = ["SiteInfo"]
+
+
+class SiteInfo:
+    """Describes the settings of the wiki whose text is being parsed.
+
+    *linktrail* is a string holding every character that may form a link
+    trail. *namespaces* maps namespace names (canonical names and aliases
+    alike) to their numeric IDs; ``6`` is the file namespace and ``14`` the
+    category namespace, as in MediaWiki. *tags* lists the tag names the wiki
+    recognizes, both extension tags and HTML tags; ``None`` means every tag.
+    """
+
+    FILE_NAMESPACE = 6
+    CATEGORY_NAMESPACE = 14
+
+    def __init__(
+        self,
+        linktrail: str = "",
+        namespaces: Mapping[str, int] | None = None,
+        tags: Iterable[str] | None = None,
+    ):
+        self._linktrail = str(linktrail or "")
+        if namespaces is None:
+            self._namespaces: dict[str, int] | None = None
+        else:
+            self._namespaces = {
+                self._normalize(name): int(nsid) for name, nsid in namespaces.items()
+            }
+        if tags is None:
+            self._tags: frozenset[str] | None = None
+        else:
+            self._tags = frozenset(str(tag).casefold() for tag in tags)
+
+    def __repr__(self) -> str:
+        return "SiteInfo(linktrail={!r}, namespaces={!r}, tags={!r})".format(
+            self._linktrail, self._namespaces, self._tags
+        )
+
+    @staticmethod
+    def _normalize(name: Any) -> str:
+        """Return the comparison form of a namespace name."""
+        return " ".join(str(name).replace("_", " ").split()).casefold()
+
+    @staticmethod
+    def _strip_colon(title: Any) -> tuple[str, bool]:
+        """Return the title without its leading colon, and whether it had one."""
+        text = str(title).lstrip()
+        if text.startswith(":"):
+            return text[1:], True
+        return text, False
+
+    @property
+    def linktrail(self) -> str:
+        """The characters that may follow a link as part of it."""
+        return self._linktrail
+
+    @property
+    def namespaces(self) -> dict[str, int] | None:
+        """The normalized namespace names mapped to their IDs."""
+        if self._namespaces is None:
+            return None
+        return dict(self._namespaces)
+
+    @property
+    def tags(self) -> frozenset[str] | None:
+        """The lowercase names of the recognized tags, or ``None`` for all."""
+        return self._tags
+
+    def is_tag(self, name: Any) -> bool:
+        """Return whether *name* is a tag the wiki recognizes."""
+        if self._tags is None:
+            return True
+        return str(name).strip().casefold() in self._tags
+
+    def namespace_of(self, title: Any) -> int | None:
+        """Return the namespace ID of a link title.
+
+        The namespace is the plain-text prefix before the first colon; a
+        leading colon is ignored. Unknown prefixes belong to the main
+        namespace (``0``). ``None`` is returned when no namespaces are known.
+        """
+        if self._namespaces is None:
+            return None
+        text, _ = self._strip_colon(title)
+        prefix, sep, _ = text.partition(":")
+        if not sep:
+            return 0
+        return self._namespaces.get(self._normalize(prefix), 0)
+
+    def link_takes_trail(self, title: Any) -> bool:
+        """Return whether a link with *title* may absorb a trail."""
+        if not self._linktrail:
+            return False
+        if self._namespaces is None:
+            return True
+        text, colon = self._strip_colon(title)
+        if colon:
+            return True
+        return self.namespace_of(text) not in (
+            self.FILE_NAMESPACE,
+            self.CATEGORY_NAMESPACE,
+        )
+
+    def trail_length(self, text: str, start: int = 0) -> int:
+        """Return how many characters of *text* from *start* form a trail."""
+        index = start
+        while index < len(text) and text[index] in self._linktrail:
+            index += 1
+        return index - start
