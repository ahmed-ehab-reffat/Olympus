+/*
+    Return whether the wiki recognizes the given tag name (1), does not (0),
+    or whether an error occurred (-1). Every tag is recognized without a site.
+*/
+static int
+Tokenizer_site_is_tag(Tokenizer *self, PyObject *name)
+{
+    PyObject *result;
+    int truth;
+
+    if (!self->site) {
+        return 1;
+    }
+    result = PyObject_CallMethod(self->site, "is_tag", "O", name);
+    if (!result) {
+        return -1;
+    }
+    truth = PyObject_IsTrue(result);
+    Py_DECREF(result);
+    return truth;
+}
+
+/*
+    Return the leading plain text of a wikilink's title tokens as a new
+    string, or NULL on error.
+*/
+static PyObject *
+Tokenizer_wikilink_title_text(PyObject *stack)
+{
+    PyObject *title = PyUnicode_New(0, 0), *token, *text, *joined;
+    Py_ssize_t i;
+    int is_text;
+
+    if (!title) {
+        return NULL;
+    }
+    for (i = 0; i < PyList_GET_SIZE(stack); i++) {
+        token = PyList_GET_ITEM(stack, i);
+        is_text = PyObject_IsInstance(token, Text);
+        if (is_text < 0) {
+            Py_DECREF(title);
+            return NULL;
+        }
+        if (!is_text) {
+            break;
+        }
+        text = PyObject_GetAttrString(token, "text");
+        if (!text) {
+            Py_DECREF(title);
+            return NULL;
+        }
+        joined = PyUnicode_Concat(title, text);
+        Py_DECREF(text);
+        Py_DECREF(title);
+        if (!joined) {
+            return NULL;
+        }
+        title = joined;
+    }
+    return title;
+}
+
+/*
+    Emit the closing token of a wikilink, absorbing the word-ending characters
+    that follow it if the site defines a linktrail and the link may take one.
+*/
+static int
+Tokenizer_emit_wikilink_close(Tokenizer *self, PyObject *title)
+{
+    PyObject *result, *trail, *kwargs;
+    Py_ssize_t length, count = 0;
+    Py_UCS4 this;
+    int truth;
+
+    if (self->site) {
+        result = PyObject_CallMethod(self->site, "link_takes_trail", "O", title);
+        if (!result) {
+            return -1;
+        }
+        truth = PyObject_IsTrue(result);
+        Py_DECREF(result);
+        if (truth < 0) {
+            return -1;
+        }
+        if (truth) {
+            length = PyUnicode_GET_LENGTH(self->linktrail);
+            while (1) {
+                this = Tokenizer_read(self, 1 + count);
+                if (this == END_OF_TEXT ||
+                    PyUnicode_FindChar(self->linktrail, this, 0, length, 1) < 0) {
+                    break;
+                }
+                count++;
+            }
+        }
+    }
+    if (!count) {
+        return Tokenizer_emit(self, WikilinkClose);
+    }
+    trail =
+        PyUnicode_Substring(self->text.object, self->head + 1, self->head + 1 + count);
+    if (!trail) {
+        return -1;
+    }
+    kwargs = PyDict_New();
+    if (!kwargs) {
+        Py_DECREF(trail);
+        return -1;
+    }
+    PyDict_SetItemString(kwargs, "trail", trail);
+    Py_DECREF(trail);
+    if (Tokenizer_emit_kwargs(self, WikilinkClose, kwargs)) {
+        return -1;
+    }
+    self->head += count;
+    return 0;
+}
