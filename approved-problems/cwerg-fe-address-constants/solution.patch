+Const AddOffset(Const addr, int64_t delta) {
+  if (addr.kind() != BASE_TYPE_KIND::GLOBAL_ADDR) return kConstInvalid;
+  EvalGlobalAddr a = ConstGetGlobalAddrWithOffset(addr);
+  return ConstNewGlobalAddr(a.sym, a.offset + delta);
+}
+
+Const SpanAddress(Const span) {
+  if (span.kind() != BASE_TYPE_KIND::SPAN) return kConstInvalid;
+  EvalSpan es = ConstGetSpan(span);
+  if (es.pointer.isnull()) return kConstInvalid;
+  if (es.pointer.kind() == NT::DefGlobal) {
+    return ConstNewGlobalAddr(es.pointer, es.offset);
+  }
+  return es.offset == 0 ? ConstNewVarAddr(es.pointer) : kConstInvalid;
+}
+
+Const EvalFront(Node cont) {
+  if (CanonType_is_vec(Node_x_type(cont))) return AddressOfPlace(cont);
+  return SpanAddress(Node_x_eval(cont));
+}
+
+SizeOrDim ElementStride(CanonType ct) {
+  return CanonType_aligned_size(CanonType_underlying_type(ct));
+}
+
+Const GetValAtOffset(Const val, CanonType val_ct, SizeOrDim offset,
+                     CanonType ct) {
+  if (val.isnull()) return kConstInvalid;
+  if (offset == 0 && val_ct == ct) return val;
+  if (CanonType_is_vec(val_ct)) {
+    CanonType et = CanonType_underlying_type(val_ct);
+    SizeOrDim stride = CanonType_aligned_size(et);
+    SizeOrDim index = offset / stride;
+    if (index >= CanonType_vec_dim(val_ct)) return kConstInvalid;
+    return GetValAtOffset(GetValForVecAtPos(val, index, et), et,
+                          offset % stride, ct);
+  }
+  if (CanonType_is_rec(val_ct)) {
+    for (Node field = Node_fields(CanonType_ast_node(val_ct)); !field.isnull();
+         field = Node_next(field)) {
+      SizeOrDim start = Node_x_offset(field);
+      CanonType field_ct = Node_x_type(field);
+      if (start <= offset && offset < start + CanonType_size(field_ct)) {
+        return GetValAtOffset(GetValForRecAtField(val, field), field_ct,
+                              offset - start, ct);
+      }
+    }
+  }
+  return kConstInvalid;
+}
+
+Const EvalDeref(Const addr, CanonType ct) {
+  if (addr.kind() != BASE_TYPE_KIND::GLOBAL_ADDR) return kConstInvalid;
+  EvalGlobalAddr a = ConstGetGlobalAddrWithOffset(addr);
+  return GetValAtOffset(Node_x_eval(a.sym),
+                        Node_x_type(Node_type_or_auto(a.sym)), a.offset, ct);
+}
