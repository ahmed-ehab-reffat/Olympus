diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..eff08a71
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,170 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT"
+export PYTHONPATH="$ROOT"
+PYTHON="${PYTHON:-python3}"
+QEMU_A32="${QEMU_A32:-qemu-armhf}"
+QEMU_A64="${QEMU_A64:-qemu-aarch64}"
+QEMU_X64="${QEMU_X64:-qemu-x86_64}"
+
+WORK=""
+for d in "${TMPDIR:-}" /tmp "$ROOT"; do
+  if [ -n "$d" ] && [ -d "$d" ] && [ -w "$d" ]; then
+    WORK="$(mktemp -d "$d/cwerg_fe.XXXXXX")" && break
+  fi
+done
+CASES=()
+FAILED=0
+TOTAL=0
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' | tr -d '\000-\010\013\014\016-\037'
+}
+
+record() {
+  local suite="$1" name="$2" status="$3" log="$4"
+  TOTAL=$((TOTAL + 1))
+  if [ "$status" != "0" ]; then
+    FAILED=$((FAILED + 1))
+    CASES+=("<testcase classname=\"$suite\" name=\"$name\"><failure message=\"exit status $status\">$(tail -c 12000 "$log" 2>/dev/null | xml_escape)</failure></testcase>")
+  else
+    CASES+=("<testcase classname=\"$suite\" name=\"$name\"/>")
+  fi
+}
+
+write_xml() {
+  if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo "<testsuites name=\"cwerg-fe\" tests=\"$TOTAL\" failures=\"$FAILED\">"
+      echo "<testsuite name=\"cwerg-fe-$MODE\" tests=\"$TOTAL\" failures=\"$FAILED\">"
+      for c in "${CASES[@]}"; do echo "$c"; done
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+  [ -n "$WORK" ] && rm -rf "$WORK"
+}
+trap 'write_xml' EXIT
+
+TOOL_LOG="$WORK/tools.log"
+build_tools() {
+  : > "$TOOL_LOG"
+  if [ ! -f build/Makefile ]; then
+    make cmake_setup CWERG_FLAGS="-include bit -Wno-error" >> "$TOOL_LOG" 2>&1
+  fi
+  local tool
+  for tool in compiler.exe x64_codegen_tool.exe a64_codegen_tool.exe a32_codegen_tool.exe; do
+    if ! make -C build -j4 "$tool" >> "$TOOL_LOG" 2>&1; then
+      echo "build of $tool failed" >> "$TOOL_LOG"
+      rm -f "build/$tool"
+    fi
+  done
+}
+
+qemu_for() { case "$1" in a32) echo "$QEMU_A32" ;; a64) echo "$QEMU_A64" ;; x64) echo "$QEMU_X64" ;; esac; }
+
+ir_path() { echo "$WORK/ir/$(echo "$1" | tr '/' '_').$2.$3.ir"; }
+
+exe_path() { echo "$WORK/ir/$(echo "$1" | tr '/' '_').$2.$3.exe"; }
+
+emit_ir() {
+  local fe="$1" target="$2" prog="$3" out
+  out="$(ir_path "$prog" "$fe" "$target")"
+  mkdir -p "$WORK/ir"
+  if [ "$fe" = py ]; then
+    timeout 300 "$PYTHON" FE/compiler.py -arch "$target" -stdlib FE/Lib "$prog" "$out" && return 0
+  else
+    [ -x build/compiler.exe ] || { cat "$TOOL_LOG"; return 1; }
+    timeout 300 build/compiler.exe -arch "$target" -stdlib FE/Lib "$prog" "$out" && return 0
+  fi
+  rm -f "$out"
+  return 1
+}
+
+run_program() {
+  local fe="$1" target="$2" prog="$3" ir exe
+  emit_ir "$fe" "$target" "$prog" || return 1
+  ir="$(ir_path "$prog" "$fe" "$target")"
+  exe="$(exe_path "$prog" "$fe" "$target")"
+  [ -x "build/${target}_codegen_tool.exe" ] || { cat "$TOOL_LOG"; return 1; }
+  cat "BE/StdLib/startup.$target.asm" "BE/StdLib/syscall.$target.asm" "$ir" |
+    "build/${target}_codegen_tool.exe" -mode binary - "$exe" > "$exe.log" 2>&1 || { tail -n 40 "$exe.log"; return 1; }
+  chmod a+rx "$exe"
+  timeout 60 "$(qemu_for "$target")" "$exe" > "$exe.out" 2>&1
+  local rc=$?
+  cat "$exe.out"
+  echo "$rc" > "$exe.rc"
+  return "$rc"
+}
+
+check_output() {
+  local target="$1" prog="$2" fe exe
+  for fe in py cc; do
+    exe="$(exe_path "$prog" "$fe" "$target")"
+    [ -f "$exe.rc" ] || run_program "$fe" "$target" "$prog" > /dev/null
+    [ "$(cat "$exe.rc" 2>/dev/null)" = 0 ] || { echo "$fe build did not run successfully"; return 1; }
+  done
+  diff "$(exe_path "$prog" py "$target").out" "$(exe_path "$prog" cc "$target").out" | head -n 80
+  return "${PIPESTATUS[0]}"
+}
+
+run_case() {
+  local suite="$1" name="$2"; shift 2
+  local log="$WORK/case.$TOTAL.log"
+  ( "$@" ) > "$log" 2>&1
+  record "$suite" "$name" "$?" "$log"
+}
+
+A32_PROGRAMS="FE/LangTest/consts_test.cw FE/LangTest/array_test.cw FE/LangTest/cast_test.cw
+FE/LangTest/defer_test.cw FE/LangTest/enum_test.cw FE/LangTest/expr_test.cw FE/LangTest/fun_test.cw
+FE/LangTest/linked_list_gen_test.cw FE/LangTest/sizeof_test.cw FE/LangTest/types_test.cw
+FE/TestData/binary_tree_gen_test.cw FE/TestData/edit_distance_test.cw FE/TestData/fibonacci_test.cw
+FE/TestData/fizzbuzz_test.cw FE/TestData/hello_world_test.cw FE/TestData/nqueens_test.cw
+FE/TestData/sieve_test.cw FE/TestData/tower_test.cw FE/Lib/bitstream_test.cw FE/Lib/bytestream_test.cw
+FE/Lib/checksum_test.cw FE/Lib/huffman_test.cw FE/Lib/string_test.cw"
+
+build_tools
+
+if [ "$MODE" = base ]; then
+  for prog in $(ls FE/LangTest/*_test.cw FE/TestData/*_test.cw FE/Lib/*_test.cw | grep -v 'thread_test'); do
+    for target in x64 a64; do
+      case "$target.$prog" in
+        x64.FE/LangTest/expr_test.cw|x64.FE/LangTest/expr_sint_test.cw) continue ;;
+      esac
+      for fe in py cc; do
+        run_case "$prog" "$fe.$target" run_program "$fe" "$target" "$prog"
+      done
+    done
+  done
+  for prog in $A32_PROGRAMS; do
+    for fe in py cc; do
+      run_case "$prog" "$fe.a32" run_program "$fe" a32 "$prog"
+    done
+  done
+else
+  for prog in FE/AddrTest/*_test.cw; do
+    for target in x64 a64 a32; do
+      for fe in py cc; do
+        run_case "$prog" "$fe.$target" run_program "$fe" "$target" "$prog"
+      done
+      run_case "$prog" "output.$target" check_output "$target" "$prog"
+    done
+  done
+fi
+
+[ "$FAILED" = 0 ]
