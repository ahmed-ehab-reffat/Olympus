index 00000000..01b89964
--- /dev/null
+++ b/FE/AddrTest/indexexpr_2c16e3_test.cw
@@ -0,0 +1,89 @@
+module:
+
+import test
+
+pub enum slot u8:
+    first 1
+    second auto_val
+    third auto_val
+
+global arr = {[8]u32: 10, 20, 30, 40, 50, 60, 70, 80}
+
+global ONE uint = 1
+
+global TWO uint = ONE << 1
+
+global p_shift = @arr[ONE << 2]
+
+global p_bits = @arr[(TWO | ONE) & 7]
+
+global p_chain = @arr[TWO * TWO + ONE]
+
+global SEVEN uint = 7
+
+global p_div = @arr[SEVEN / 2]
+
+global p_mod = @arr[SEVEN % 4]
+
+global SMALL u8 = 2
+
+global p_sub = @arr[SEVEN - 4]
+
+global p_shr = @arr[16_uint >> 2]
+
+global p_xor = @arr[SEVEN ~ 1]
+
+global p_neg = @arr[as(-(-2_s32), uint)]
+
+global p_last = @arr[len(arr) - 1]
+
+global p_cast = @arr[as(SMALL, uint)]
+
+global p_enum = @arr[as(unwrap(slot.third), uint)]
+
+static_assert p_shift == @arr[4]
+
+static_assert p_bits == @arr[3]
+
+static_assert p_chain == @arr[5]
+
+static_assert p_shift^ == 50
+
+static_assert p_div == @arr[3]
+
+static_assert p_mod == p_bits
+
+static_assert p_div^ == 40
+
+static_assert p_cast == @arr[2]
+
+static_assert p_enum == p_bits
+
+static_assert p_enum^ == 40
+
+static_assert p_sub == @arr[3]
+
+static_assert p_shr == p_shift
+
+static_assert p_xor == @arr[6]
+
+static_assert p_neg == p_cast
+
+static_assert p_xor^ == 70
+
+static_assert p_last == @arr[7]
+
+static_assert p_last^ == 80
+
+fun main(argc s32, argv ^^u8) s32:
+    test\AssertEq#(50_u32, p_shift^)
+    test\AssertEq#(40_u32, p_bits^)
+    test\AssertEq#(60_u32, p_chain^)
+    test\AssertEq#(40_u32, p_mod^)
+    test\AssertEq#(30_u32, p_cast^)
+    test\AssertEq#(40_u32, p_enum^)
+    test\AssertEq#(70_u32, p_xor^)
+    test\AssertEq#(30_u32, p_neg^)
+    test\AssertEq#(80_u32, p_last^)
+    test\Success#()
+    return 0
