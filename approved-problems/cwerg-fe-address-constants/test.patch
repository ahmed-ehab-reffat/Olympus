index 00000000..a941a25d
--- /dev/null
+++ b/FE/AddrTest/eqfield_2c16e3_test.cw
@@ -0,0 +1,47 @@
+module:
+
+import test
+
+rec pair:
+    a u32
+    b u16
+    v [3]u16
+
+global pr = {pair: 5, 6, {[3]u16: 7, 8, 9}}
+
+global pr2 = {pair: 5, 6, {[3]u16: 7, 8, 9}}
+
+global spv span(u16) = pr.v
+
+global ppr = @pr
+
+static_assert @pr.a == @pr.a
+
+static_assert @pr.a != @pr2.a
+
+static_assert @pr.b != @pr2.b
+
+static_assert @pr.v[0] != @pr2.v[0]
+
+static_assert @pr.v[2] != @pr.v[1]
+
+static_assert ptr_inc(front(spv), 2) == @pr.v[2]
+
+static_assert ptr_inc(front(spv), 2) != @pr2.v[2]
+
+static_assert @ppr^.b == @pr.b
+
+static_assert @ppr^.v[1] == ptr_inc(@pr.v[0], 1)
+
+fun main(argc s32, argv ^^u8) s32:
+    let a = @pr.b
+    let b = @pr2.b
+    if a == b:
+        test\AssertEq#(1_u32, 2_u32)
+    let c = ptr_inc(front(spv), 1)
+    if c != @pr.v[1]:
+        test\AssertEq#(1_u32, 3_u32)
+    if c == @pr2.v[1]:
+        test\AssertEq#(1_u32, 4_u32)
+    test\Success#()
+    return 0
