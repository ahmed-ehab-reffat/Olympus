new file mode 100644
index 00000000..21f9112a
--- /dev/null
+++ b/FE/AddrTest/runtime_2c16e3_test.cw
@@ -0,0 +1,50 @@
+module:
+
+import test
+
+global! counters = {[3]u32: 1, 2, 3}
+
+global p_counter = @counters[1]
+
+global counter_view span!(u32) = make_span(ptr_inc(front!(counters), 1), 2)
+
+global arr = {[4]u32: 10, 20, 30, 40}
+
+global other = {[4]u32: 10, 20, 30, 40}
+
+global p2 = @arr[2]
+
+global e1 = {[0]u8:}
+
+global e2 = {[0]u8:}
+
+global pe1 = @e1
+
+global pe2 = @e2
+
+fun main(argc s32, argv ^^u8) s32:
+    let a = @arr[1]
+    let b = @arr[2]
+    if a == b:
+        test\AssertEq#(1_u32, 2_u32)
+    let c = ptr_inc(front(arr), 2)
+    let d = @other[2]
+    if b != c:
+        test\AssertEq#(1_u32, 3_u32)
+    if b != p2:
+        test\AssertEq#(1_u32, 4_u32)
+    if b == d:
+        test\AssertEq#(1_u32, 5_u32)
+    if pe1 == pe2:
+        test\AssertEq#(1_u32, 6_u32)
+    if front(e1) == front(e2):
+        test\AssertEq#(1_u32, 7_u32)
+    test\AssertEq#(2_u32, p_counter^)
+    test\AssertEq#(3_u32, counter_view[1])
+    set counters[1] = 99
+    set counters[2] = 77
+    test\AssertEq#(99_u32, p_counter^)
+    test\AssertEq#(99_u32, counter_view[0])
+    test\AssertEq#(77_u32, counter_view[1])
+    test\Success#()
+    return 0
