+global pb = @pr.b
+
+global sub span(u32) = make_span(ptr_inc(front(arr), 1), 2)
+
+global ONE u32 = 1
+
+global STEP uint = 2
+
+global halves = {[4]u16: 100, 200, 300, 400}
+
+global p_computed = @arr[ONE + 1]
+
+global q_computed = ptr_inc(front(arr), STEP + 1)
+
+global p_sized = @halves[size_of(u16)]
+
+global p_picked = @arr[ONE > 0 ? 2_uint : 0_uint]
+
+global p_offset = @arr[offset_of(pair, b) / 2]
+
+static_assert @arr[1] != @arr[2]
+
+static_assert @arr[2] == p2
+
+static_assert ptr_inc(p2, 1) == q
+
+static_assert p2^ == 30
+
+static_assert q^ == 40
+
+static_assert p9^ == 9
+
+static_assert pb^ == 6
+
+static_assert sub[0] == 20
+
+static_assert sub[1] == 30
+
+static_assert front(sub) == @arr[1]
+
+static_assert p_computed == p2
+
+static_assert q_computed == q
+
+static_assert p_sized^ == 300
+
+static_assert p_sized == @halves[2]
+
+static_assert p_picked == p2
+
+static_assert p_offset == p2
+
+static_assert @arr[size_of(u16) + 1] == q
+
+static_assert @arr[ONE == 1 ? 3_uint : 1_uint] == q
+
+fun main(argc s32, argv ^^u8) s32:
+    test\Success#()
+    return 0
