+    private static void invokeDynamicBefore(Program program, Variable receiver) {
+        var insn = new InvokeDynamicInstruction();
+        insn.setMethod(new MethodDescriptor("get", OBJECT));
+        insn.setBootstrapMethod(MethodHandle.staticCaller("Bootstrap", "link", ValueType.object(
+                "java.lang.invoke.CallSite")));
+        insn.setReceiver(receiver);
+        program.basicBlockAt(0).getFirstInstruction().insertPrevious(insn);
+    }
