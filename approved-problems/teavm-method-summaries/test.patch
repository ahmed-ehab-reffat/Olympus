+        assertEquals(fields("Counter.value", "Config.mode"),
+                copy(summaries.getWrittenFields(InvocationType.SPECIAL, ref("Util", "useConfig", ValueType.VOID))));
+        assertEquals(fields("Counter.value", "Config.mode"), copy(summaries.getInitializerWrittenFields("Config")));
+        assertEquals(fields(), copy(summaries.getInitializerWrittenFields("Plain")));
+        assertNull(summaries.getInitializerWrittenFields("Missing"));
