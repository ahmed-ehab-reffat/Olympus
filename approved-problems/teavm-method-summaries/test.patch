+
+CP="$(find "$LIBS" -maxdepth 1 -name '*.jar' | sort | tr '\n' ':')"
+MAIN_ROOTS=(interop/core extension/apis extension/spi-util extension/spi metaprogramming/api core)
+: > "$WORK/main-sources.txt"
+RESOURCES=""
+for module in "${MAIN_ROOTS[@]}"; do
+  find "$ROOT/$module/src/main/java" -name '*.java' >> "$WORK/main-sources.txt"
+  if [ -d "$ROOT/$module/src/main/resources" ]; then
+    RESOURCES="$RESOURCES$ROOT/$module/src/main/resources:"
+  fi
+done
+mkdir -p "$WORK/main" "$WORK/test" "$WORK/runner"
+if ! javac --release 17 -nowarn -encoding UTF-8 -proc:none -d "$WORK/main" -cp "$CP" \
+    @"$WORK/main-sources.txt" > "$WORK/main.log" 2>&1; then
+  fail_xml "compile_main_sources" "$WORK/main.log"
+fi
+
+: > "$WORK/test-sources.txt"
+if [ "$MODE" = "new" ]; then
+  for file in "${NEW_TESTS[@]}"; do
+    echo "$ROOT/$file" >> "$WORK/test-sources.txt"
+  done
+else
+  find "$ROOT/core/src/test/java" -name '*.java' | sort > "$WORK/all-tests.txt"
+  for file in "${NEW_TESTS[@]}"; do
+    grep -vxF "$ROOT/$file" "$WORK/all-tests.txt" > "$WORK/filtered.txt"
+    mv "$WORK/filtered.txt" "$WORK/all-tests.txt"
+  done
+  cp "$WORK/all-tests.txt" "$WORK/test-sources.txt"
+fi
+if ! javac --release 17 -nowarn -encoding UTF-8 -proc:none -d "$WORK/test" -cp "$WORK/main:$CP" \
+    @"$WORK/test-sources.txt" > "$WORK/test.log" 2>&1; then
+  if [ "$MODE" = "new" ]; then
+    fail_new_tests "$WORK/test.log"
+  fi
+  fail_xml "compile_test_sources" "$WORK/test.log"
+fi
+
+CLASSES=()
+while IFS= read -r file; do
+  if grep -q '@Test' "$file"; then
+    rel="${file#$ROOT/core/src/test/java/}"
+    rel="${rel%.java}"
+    CLASSES+=("${rel//\//.}")
+  fi
+done < "$WORK/test-sources.txt"
+
+cat > "$WORK/runner/XmlRunner.java" <<'JAVA'
+import java.io.PrintWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.runner.Description;
+import org.junit.runner.JUnitCore;
+import org.junit.runner.notification.Failure;
+import org.junit.runner.notification.RunListener;
+
+public class XmlRunner {
+    static final class Case {
+        String className;
+        String name;
+        double time;
+        String kind;
+        String message;
+        String trace;
+    }
+
+    public static void main(String[] args) throws Exception {
+        List<Class<?>> classes = new ArrayList<>();
+        for (int i = 1; i < args.length; i++) {
+            classes.add(Class.forName(args[i]));
+        }
+        List<Case> cases = new ArrayList<>();
+        Map<Description, Long> started = new HashMap<>();
+        Map<Description, Failure> failures = new HashMap<>();
+        JUnitCore core = new JUnitCore();
+        core.addListener(new RunListener() {
+            @Override
+            public void testStarted(Description d) {
+                started.put(d, System.nanoTime());
+            }
+
+            @Override
+            public void testFailure(Failure f) {
+                if (!started.containsKey(f.getDescription())) {
+                    Case c = new Case();
+                    c.className = f.getDescription().getClassName();
+                    c.name = f.getDescription().getMethodName() != null
+                            ? f.getDescription().getMethodName() : "classSetup";
+                    c.kind = "error";
+                    c.message = String.valueOf(f.getMessage());
+                    c.trace = f.getTrace();
+                    cases.add(c);
+                } else {
+                    failures.put(f.getDescription(), f);
+                }
+            }
+
+            @Override
+            public void testAssumptionFailure(Failure f) {
+                failures.put(f.getDescription(), f);
+            }
+
+            @Override
+            public void testIgnored(Description d) {
+                Case c = new Case();
+                c.className = d.getClassName();
+                c.name = d.getMethodName();
+                c.kind = "skipped";
+                cases.add(c);
+            }
+
+            @Override
+            public void testFinished(Description d) {
+                Case c = new Case();
+                c.className = d.getClassName();
+                c.name = d.getMethodName();
+                Long start = started.get(d);
+                c.time = start != null ? (System.nanoTime() - start) / 1e9 : 0;
+                Failure f = failures.get(d);
+                if (f != null) {
+                    c.kind = f.getException() instanceof AssertionError ? "failure" : "error";
+                    c.message = String.valueOf(f.getMessage());
+                    c.trace = f.getTrace();
+                }
+                cases.add(c);
+            }
+        });
+        core.run(classes.toArray(new Class<?>[0]));
+        int failed = 0;
+        int errors = 0;
+        int skipped = 0;
+        StringBuilder body = new StringBuilder();
+        for (Case c : cases) {
+            body.append("<testcase classname=\"").append(esc(c.className)).append("\" name=\"")
+                    .append(esc(c.name)).append("\" time=\"").append(String.format("%.3f", c.time)).append("\"");
+            if (c.kind == null) {
+                body.append("/>\n");
+                continue;
+            }
+            body.append(">");
+            if (c.kind.equals("skipped")) {
+                skipped++;
+                body.append("<skipped/>");
+            } else {
+                if (c.kind.equals("failure")) {
+                    failed++;
+                } else {
+                    errors++;
+                }
+                body.append("<").append(c.kind).append(" message=\"").append(esc(c.message)).append("\">")
+                        .append(esc(c.trace)).append("</").append(c.kind).append(">");
+            }
+            body.append("</testcase>\n");
+        }
+        try (PrintWriter out = new PrintWriter(Files.newBufferedWriter(Paths.get(args[0]), StandardCharsets.UTF_8))) {
+            out.println("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
+            out.println("<testsuites tests=\"" + cases.size() + "\" failures=\"" + failed + "\" errors=\""
+                    + errors + "\">");
+            out.println("<testsuite name=\"teavm-core\" tests=\"" + cases.size() + "\" failures=\"" + failed
+                    + "\" errors=\"" + errors + "\" skipped=\"" + skipped + "\">");
+            out.print(body);
+            out.println("</testsuite>");
+            out.println("</testsuites>");
+        }
+        System.out.println("tests=" + cases.size() + " failures=" + failed + " errors=" + errors
+                + " skipped=" + skipped);
+        System.exit(failed + errors == 0 && !cases.isEmpty() ? 0 : 1);
+    }
+
+    static String esc(String s) {
+        if (s == null) {
+            return "";
+        }
+        StringBuilder sb = new StringBuilder();
+        for (char ch : s.toCharArray()) {
+            switch (ch) {
+                case '&': sb.append("&amp;"); break;
+                case '<': sb.append("&lt;"); break;
+                case '>': sb.append("&gt;"); break;
+                case '"': sb.append("&quot;"); break;
+                default:
+                    if (ch >= 0x20 || ch == '\n' || ch == '\t' || ch == '\r') {
+                        sb.append(ch);
+                    }
+            }
+        }
+        return sb.toString();
+    }
+}
+JAVA
+if ! javac -nowarn -d "$WORK/runner" -cp "$CP" "$WORK/runner/XmlRunner.java" > "$WORK/runner.log" 2>&1; then
+  fail_xml "compile_runner" "$WORK/runner.log"
+fi
+
+RUN_CP="$WORK/test:$ROOT/core/src/test/resources:$WORK/main:$RESOURCES$WORK/runner:$CP"
+(cd "$WORK" && java -cp "$RUN_CP" XmlRunner "$OUTPUT_PATH" "${CLASSES[@]}") > "$WORK/run.log" 2>&1
+STATUS=$?
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH"; then
+  fail_xml "test_runner" "$WORK/run.log"
+fi
+tail -n 1 "$WORK/run.log"
+exit $STATUS
