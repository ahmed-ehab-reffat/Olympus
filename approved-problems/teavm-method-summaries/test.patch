+        method(util, true, "useConfig", ValueType.VOID,
+                "initClass Config",
+                "return");
+        var config = cls("Config", null);
+        method(config, true, "<clinit>", ValueType.VOID,
+                "invokeStatic `Util.bump()V`",
+                "@w := 2",
+                "field Config.mode := @w as I",
+                "return");
+        cls("Plain", null);
