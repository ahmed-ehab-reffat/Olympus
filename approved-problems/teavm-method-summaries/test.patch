+    @Test
+    public void aCallToAMethodReturningANewObjectNeverReturnsNull() {
+        var factory = cls("Factory", null);
+        method(factory, true, "make", OBJECT,
+                "@o := new java.lang.Object",
+                "return @o");
+        method(factory, true, "nothing", OBJECT,
+                "@n := null",
+                "return @n");
+        method(factory, true, "echo", new ValueType[] { OBJECT, OBJECT }, "var @x as x",
+                "@y := @x",
+                "return @y");
+        var summaries = MethodSummaries.build(classes);
+
+        assertTrue(summaries.neverReturnsNull(InvocationType.SPECIAL, ref("Factory", "make", OBJECT)));
+        assertFalse(summaries.neverReturnsNull(InvocationType.SPECIAL, ref("Factory", "nothing", OBJECT)));
+        assertFalse(summaries.neverReturnsNull(InvocationType.SPECIAL, ref("Factory", "echo", OBJECT, OBJECT)));
+    }
