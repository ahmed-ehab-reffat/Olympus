+    echo "<testsuite name=\"teavm-core-$MODE\" tests=\"1\" failures=\"1\" errors=\"0\" skipped=\"0\">"
+    echo "<testcase classname=\"teavm-core-$MODE\" name=\"$name\">"
+    echo "<failure message=\"$name\">"
+    tail -c 60000 "$log" | xml_escape
+    echo "</failure></testcase></testsuite></testsuites>"
+  } > "$OUTPUT_PATH"
+  cat "$log" >&2
+  exit 1
+}
