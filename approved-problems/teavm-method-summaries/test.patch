+    private ClassHolder cls(String name, String parent, String... interfaces) {
+        var cls = new ClassHolder(name);
+        cls.setLevel(AccessLevel.PUBLIC);
+        cls.setParent(parent != null ? parent : "java.lang.Object");
+        for (var itf : interfaces) {
+            cls.getInterfaces().add(itf);
+        }
+        classes.putClassHolder(cls);
+        return cls;
+    }
+
+    private void field(ClassHolder cls, String name, ValueType type, boolean isStatic) {
+        var field = new FieldHolder(name);
+        field.setLevel(AccessLevel.PUBLIC);
+        field.setType(type);
+        if (isStatic) {
+            field.getModifiers().add(ElementModifier.STATIC);
+        }
+        cls.addField(field);
+    }
+
+    private MethodHolder method(ClassHolder cls, boolean isStatic, String name, ValueType returnType,
+            String... body) {
+        return method(cls, isStatic, name, new ValueType[] { returnType }, null, body);
+    }
+
+    private MethodHolder method(ClassHolder cls, boolean isStatic, String name, ValueType[] signature,
+            String parameters, String... body) {
+        var method = new MethodHolder(name, signature);
+        if (isStatic) {
+            method.getModifiers().add(ElementModifier.STATIC);
+        }
+        var lines = new String[body.length + 1];
+        lines[0] = parameters != null ? parameters : "";
+        System.arraycopy(body, 0, lines, 1, body.length);
+        method.setProgram(program(lines));
+        cls.addMethod(method);
+        return method;
+    }
+
+    private static Program program(String... lines) {
+        var text = new StringBuilder("var @this as this\n");
+        var index = 0;
+        while (index < lines.length && lines[index].startsWith("var ")) {
+            text.append(lines[index++]).append("\n");
+        }
+        if (index < lines.length && lines[index].isEmpty()) {
+            index++;
+        }
+        text.append("$start\n");
+        for (; index < lines.length; ++index) {
+            text.append(lines[index].startsWith("$") ? "" : "  ").append(lines[index]).append("\n");
+        }
+        try {
+            return new ListingParser().parse(new StringReader(text.toString()));
+        } catch (IOException | ListingParseException e) {
+            throw new AssertionError(text.toString(), e);
+        }
+    }
+
+    private static MethodReference ref(String className, String name, ValueType... signature) {
+        return new MethodReference(className, name, signature);
+    }
+
+    private static Set<FieldReference> fields(String... names) {
+        var result = new HashSet<FieldReference>();
+        for (var name : names) {
+            var dot = name.lastIndexOf('.');
+            result.add(new FieldReference(name.substring(0, dot), name.substring(dot + 1)));
+        }
+        return result;
+    }
+
+    private static Set<FieldReference> copy(Set<FieldReference> fields) {
+        return fields != null ? new HashSet<>(fields) : null;
+    }
+}
