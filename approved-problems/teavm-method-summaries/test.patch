+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+OUTPUT_PATH="${OUTPUT_PATH:-$ROOT/test-results-$MODE.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+LIBS="${TEAVM_TEST_LIBS:-/opt/testlibs}"
