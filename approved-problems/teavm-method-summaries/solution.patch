+package org.teavm.model.analysis;
+
+import java.util.ArrayDeque;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import org.teavm.model.BasicBlock;
+import org.teavm.model.ClassHierarchy;
+import org.teavm.model.ClassReader;
+import org.teavm.model.ElementModifier;
+import org.teavm.model.FieldReference;
+import org.teavm.model.Instruction;
+import org.teavm.model.InvokeDynamicInstruction;
+import org.teavm.model.ListableClassReaderSource;
+import org.teavm.model.MethodDescriptor;
+import org.teavm.model.MethodReader;
+import org.teavm.model.MethodReference;
+import org.teavm.model.Program;
+import org.teavm.model.ValueType;
+import org.teavm.model.instructions.ExitInstruction;
+import org.teavm.model.instructions.InitClassInstruction;
+import org.teavm.model.instructions.InvocationType;
+import org.teavm.model.instructions.InvokeInstruction;
+import org.teavm.model.instructions.PutFieldInstruction;
+import org.teavm.model.util.ProgramUtils;
+
+public class MethodSummaries {
+    private static final MethodDescriptor CLINIT = new MethodDescriptor("<clinit>", ValueType.VOID);
+    private final ListableClassReaderSource classes;
+    private final ClassHierarchy hierarchy;
+    private final Map<MethodReference, Summary> summaries = new LinkedHashMap<>();
+    private final Map<CallKey, List<MethodReference>> targetCache = new HashMap<>();
+    private final Map<MethodReference, Set<MethodReference>> callers = new HashMap<>();
+
+    private MethodSummaries(ListableClassReaderSource classes) {
+        this.classes = classes;
+        hierarchy = new ClassHierarchy(classes);
+    }
+
+    public static MethodSummaries build(ListableClassReaderSource classes) {
+        var result = new MethodSummaries(classes);
+        result.collectMethods();
+        result.collectCallers();
+        result.propagate();
+        return result;
+    }
+
+    public boolean neverReturnsNull(InvocationType type, MethodReference method) {
+        var targets = targets(type, method);
+        if (targets == null) {
+            return false;
+        }
+        for (var target : targets) {
+            if (!summaries.get(target).neverNull) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    public Set<FieldReference> getWrittenFields(InvocationType type, MethodReference method) {
+        var targets = targets(type, method);
+        if (targets == null) {
+            return null;
+        }
+        var result = new LinkedHashSet<FieldReference>();
+        for (var target : targets) {
+            var written = summaries.get(target).writtenFields;
+            if (written == null) {
+                return null;
+            }
+            result.addAll(written);
+        }
+        return Collections.unmodifiableSet(result);
+    }
+
+    public Set<FieldReference> getInitializerWrittenFields(String className) {
+        var cls = classes.get(className);
+        if (cls == null) {
+            return null;
+        }
+        var initializer = cls.getMethod(CLINIT);
+        if (initializer == null) {
+            return Collections.emptySet();
+        }
+        return getWrittenFields(InvocationType.SPECIAL, initializer.getReference());
+    }
+
+    private void collectMethods() {
+        for (var className : classes.getClassNames()) {
+            var cls = classes.get(className);
+            for (var method : cls.getMethods()) {
+                if (method.getProgram() != null) {
+                    summaries.put(method.getReference(), new Summary(method));
+                }
+            }
+        }
+    }
+
+    private void collectCallers() {
+        for (var summary : summaries.values()) {
+            var caller = summary.method.getReference();
+            for (BasicBlock block : summary.program.getBasicBlocks()) {
+                for (Instruction instruction : block) {
+                    List<MethodReference> callees = null;
+                    if (instruction instanceof InvokeInstruction) {
+                        var invoke = (InvokeInstruction) instruction;
+                        callees = targets(invoke.getType(), invoke.getMethod());
+                    } else if (instruction instanceof InitClassInstruction) {
+                        callees = initializerTargets(((InitClassInstruction) instruction).getClassName());
+                    }
+                    if (callees != null) {
+                        for (var callee : callees) {
+                            callers.computeIfAbsent(callee, k -> new LinkedHashSet<>()).add(caller);
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private void propagate() {
+        Deque<MethodReference> queue = new ArrayDeque<>(summaries.keySet());
+        Set<MethodReference> queued = new LinkedHashSet<>(summaries.keySet());
+        while (!queue.isEmpty()) {
+            var method = queue.removeFirst();
+            queued.remove(method);
+            var summary = summaries.get(method);
+            if (updateWrittenFields(summary) | updateNeverNull(summary)) {
+                for (var caller : callers.getOrDefault(method, Collections.emptySet())) {
+                    if (queued.add(caller)) {
+                        queue.addLast(caller);
+                    }
+                }
+            }
+        }
+    }
+
+    private boolean updateWrittenFields(Summary summary) {
+        if (summary.writtenFields == null) {
+            return false;
+        }
+        var written = computeWrittenFields(summary.program);
+        if (written == null) {
+            summary.writtenFields = null;
+            return true;
+        }
+        return summary.writtenFields.addAll(written);
+    }
+
+    private Set<FieldReference> computeWrittenFields(Program program) {
+        var result = new LinkedHashSet<FieldReference>();
+        for (BasicBlock block : program.getBasicBlocks()) {
+            for (Instruction instruction : block) {
+                Set<FieldReference> written;
+                if (instruction instanceof PutFieldInstruction) {
+                    written = Set.of(((PutFieldInstruction) instruction).getField());
+                } else if (instruction instanceof InvokeInstruction) {
+                    var invoke = (InvokeInstruction) instruction;
+                    written = getWrittenFields(invoke.getType(), invoke.getMethod());
+                } else if (instruction instanceof InitClassInstruction) {
+                    written = getInitializerWrittenFields(((InitClassInstruction) instruction).getClassName());
+                } else if (instruction instanceof InvokeDynamicInstruction) {
+                    written = null;
+                } else {
+                    continue;
+                }
+                if (written == null) {
+                    return null;
+                }
+                result.addAll(written);
+            }
+        }
+        return result;
+    }
+
+    private boolean updateNeverNull(Summary summary) {
+        if (!summary.neverNull || provesNonNullResult(summary)) {
+            return false;
+        }
+        summary.neverNull = false;
+        return true;
+    }
+
+    private boolean provesNonNullResult(Summary summary) {
+        var program = ProgramUtils.copy(summary.program);
+        var nullness = NullnessInformation.build(program, summary.method.getDescriptor(), this);
+        for (BasicBlock block : program.getBasicBlocks()) {
+            var last = block.getLastInstruction();
+            if (last instanceof ExitInstruction) {
+                var value = ((ExitInstruction) last).getValueToReturn();
+                if (value != null && !nullness.isNotNull(value)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private List<MethodReference> initializerTargets(String className) {
+        var cls = classes.get(className);
+        if (cls == null) {
+            return null;
+        }
+        var initializer = cls.getMethod(CLINIT);
+        return initializer != null ? targets(InvocationType.SPECIAL, initializer.getReference()) : List.of();
+    }
+
+    private List<MethodReference> targets(InvocationType type, MethodReference method) {
+        var key = new CallKey(type, method);
+        if (targetCache.containsKey(key)) {
+            return targetCache.get(key);
+        }
+        var result = type == InvocationType.VIRTUAL ? virtualTargets(method) : specialTargets(method);
+        targetCache.put(key, result);
+        return result;
+    }
+
+    private List<MethodReference> specialTargets(MethodReference method) {
+        var resolved = classes.resolve(method);
+        if (resolved == null || !summaries.containsKey(resolved.getReference())) {
+            return null;
+        }
+        return List.of(resolved.getReference());
+    }
+
+    private List<MethodReference> virtualTargets(MethodReference method) {
+        if (classes.resolve(method) == null) {
+            return null;
+        }
+        var result = new LinkedHashSet<MethodReference>();
+        for (var className : classes.getClassNames()) {
+            ClassReader cls = classes.get(className);
+            if (cls.hasModifier(ElementModifier.ABSTRACT) || cls.hasModifier(ElementModifier.INTERFACE)
+                    || !hierarchy.isSuperType(method.getClassName(), className, false)) {
+                continue;
+            }
+            MethodReader implementation = classes.resolveImplementation(className, method.getDescriptor());
+            if (implementation == null || !summaries.containsKey(implementation.getReference())) {
+                return null;
+            }
+            result.add(implementation.getReference());
+        }
+        return List.copyOf(result);
+    }
+
+    private static boolean returnsReference(MethodReader method) {
+        var type = method.getResultType();
+        return type instanceof ValueType.Object || type instanceof ValueType.Array;
+    }
+
+    static class Summary {
+        final MethodReader method;
+        final Program program;
+        boolean neverNull;
+        Set<FieldReference> writtenFields = new LinkedHashSet<>();
+
+        Summary(MethodReader method) {
+            this.method = method;
+            program = ProgramUtils.copy(method.getProgram());
+            neverNull = returnsReference(method);
+        }
+    }
+
+    static class CallKey {
+        final InvocationType type;
+        final MethodReference method;
+
+        CallKey(InvocationType type, MethodReference method) {
+            this.type = type;
+            this.method = method;
+        }
+
+        @Override
+        public boolean equals(Object o) {
+            if (this == o) {
+                return true;
+            }
+            if (!(o instanceof CallKey)) {
+                return false;
+            }
+            var that = (CallKey) o;
+            return type == that.type && method.equals(that.method);
+        }
+
+        @Override
+        public int hashCode() {
+            return type.hashCode() * 31 + method.hashCode();
+        }
+    }
+}
