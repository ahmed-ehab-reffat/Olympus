+from __future__ import annotations
+
+import pytest
+
+from textual.app import App, ComposeResult
+from textual.color import Color
+from textual.containers import Vertical
+from textual.css.query import InvalidQueryFormat
+from textual.css.tokenizer import TokenError
+from textual.widgets import Button, Input, Label
+
+RED = Color(255, 0, 0)
+GREEN = Color(0, 128, 0)
+BLUE = Color(0, 0, 255)
+
+WIDGET_TYPES = {"L": Label, "B": Button, "I": Input}
+
+
+def build_app(css: str, spec: str) -> App[None]:
+    class SelectorApp(App[None]):
+        CSS = css
+
+        def compose(self) -> ComposeResult:
+            with Vertical(id="box"):
+                for index, item in enumerate(spec.split(), 1):
+                    code, _, classes = item.partition(".")
+                    yield WIDGET_TYPES[code](
+                        id=f"c{index}", classes=classes.replace(".", " ")
+                    )
+
+    return SelectorApp()
+
+
+def query_ids(app: App[None], selector: str) -> list[str | None]:
+    return [widget.id for widget in app.query_one("#box").query(selector)]
+
+
+async def test_nth_child_odd():
+    app = build_app("", "L L L L L L")
+    async with app.run_test():
+        assert query_ids(app, "Label:nth-child(odd)") == ["c1", "c3", "c5"]
+
+
