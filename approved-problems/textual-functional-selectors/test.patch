+    async with app.run_test() as pilot:
+        last = app.query_one("#c2")
+        assert last.styles.color == RED
+        await app.query_one("#box").mount(Label(id="c3"))
+        await pilot.pause()
+        assert last.styles.color != RED
+        assert app.query_one("#c3").styles.color == RED
