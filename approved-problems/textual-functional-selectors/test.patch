+#!/usr/bin/env bash
+set -uo pipefail
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      echo "Usage: ./test.sh [--output_path <path>] {base|new}"
+      exit 1
+      ;;
+  esac
+done
+
+if [ -z "$MODE" ]; then
+  echo "Usage: ./test.sh [--output_path <path>] {base|new}"
+  exit 1
+fi
+
+JUNIT_ARGS=()
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT_ARGS=(--junitxml="$OUTPUT_PATH")
+fi
+
+case "$MODE" in
+  base)
+    python -m pytest tests/ -p no:cacheprovider \
+      --ignore=tests/css/test_selector_engine_3f8b.py "${JUNIT_ARGS[@]}"
+    ;;
+  new)
+    python -m pytest tests/css/test_selector_engine_3f8b.py -p no:cacheprovider \
+      "${JUNIT_ARGS[@]}"
+    ;;
+esac
