+from __future__ import annotations
+
+import re
+
+RE_NTH = re.compile(
+    r"odd|even|(?P<coefficient>[+-]?\d*)n(?:\s*(?P<sign>[+-])\s*(?P<offset>\d+))?|(?P<integer>[+-]?\d+)"
+)
+
+
+def parse_nth(value: str) -> tuple[int, int]:
+    """Parse the an+b microsyntax used by positional pseudo-classes.
+
+    Args:
+        value: The argument of a positional pseudo-class, e.g. "2n+1" or "odd".
+
+    Returns:
+        A pair (a, b) such that the expression selects positions a*n + b.
+
+    Raises:
+        ValueError: If the value is not a valid an+b expression.
+    """
+    value = value.strip()
+    match = RE_NTH.fullmatch(value)
+    if match is None:
+        raise ValueError(f"invalid nth expression {value!r}")
+    if value == "odd":
+        return (2, 1)
+    if value == "even":
+        return (2, 0)
+    integer = match.group("integer")
+    if integer is not None:
+        return (0, int(integer))
+    coefficient = match.group("coefficient")
+    if coefficient in ("", "+"):
+        a = 1
+    elif coefficient == "-":
+        a = -1
+    else:
+        a = int(coefficient)
+    offset = match.group("offset")
+    if offset is None:
+        b = 0
+    else:
+        b = -int(offset) if match.group("sign") == "-" else int(offset)
+    return (a, b)
+
+
+def nth_matches(a: int, b: int, position: int) -> bool:
+    """Check if a 1-based position is selected by an an+b expression.
+
+    Args:
+        a: The step of the expression.
+        b: The offset of the expression.
+        position: A 1-based position.
+
+    Returns:
+        `True` if the position equals a*n + b for some n >= 0.
+    """
+    if a == 0:
+        return position == b
+    multiple, remainder = divmod(position - b, a)
+    return remainder == 0 and multiple >= 0
+
+
+def format_nth(a: int, b: int) -> str:
+    """Format an (a, b) pair back to canonical an+b form.
+
+    Args:
+        a: The step of the expression.
+        b: The offset of the expression.
+
+    Returns:
+        The expression in canonical an+b form.
+    """
+    if a == 0:
+        return str(b)
+    return f"{a}n{b:+d}" if b else f"{a}n"
