@@ -0,0 +1,122 @@
+//! Pipeline aggregations, computed in a post-finalization pass over the assembled bucket tree.
+//!
+//! Unlike metric and bucket aggregations, pipeline aggregations read no fast field. They consume the
+//! output of other aggregations addressed by a `buckets_path`. There are three families:
+//!
+//! - sibling pipelines (`avg_bucket`, `sum_bucket`, `min_bucket`, `max_bucket`, `stats_bucket`)
+//!   reduce the buckets of a sibling multi-bucket aggregation into a single metric placed beside it;
+//! - serial pipelines (`cumulative_sum`, `derivative`, `moving_avg`) walk the buckets of their parent
+//!   multi-bucket aggregation in order, writing a value into each bucket;
+//! - calculated pipelines (`bucket_script`, `bucket_selector`) evaluate a script over named values in
+//!   each parent bucket, either writing the result or dropping the bucket.
+
+mod compute;
+mod expr;
+
+use compute::SiblingOp;
+use crate::aggregation::agg_req::{AggregationVariants, Aggregations};
+use crate::aggregation::agg_result::{AggregationResult, AggregationResults};
+use crate::aggregation::AggregationError;
+use crate::TantivyError;
+
+fn err(msg: impl Into<String>) -> TantivyError {
+    TantivyError::AggregationError(AggregationError::InvalidRequest(msg.into()))
+}
+
+fn is_sibling(agg: &AggregationVariants) -> bool {
+    matches!(
+        agg,
+        AggregationVariants::AvgBucket(_)
+            | AggregationVariants::SumBucket(_)
+            | AggregationVariants::MinBucket(_)
+            | AggregationVariants::MaxBucket(_)
+            | AggregationVariants::StatsBucket(_)
+    )
+}
+
+fn is_per_bucket(agg: &AggregationVariants) -> bool {
+    matches!(
+        agg,
+        AggregationVariants::CumulativeSum(_)
+            | AggregationVariants::Derivative(_)
+            | AggregationVariants::MovingAvg(_)
+            | AggregationVariants::BucketScript(_)
+            | AggregationVariants::BucketSelector(_)
+    )
+}
+
+fn has_per_bucket_pipeline(sub_req: &Aggregations) -> bool {
+    sub_req.values().any(|agg| is_per_bucket(&agg.agg))
+}
+
+/// A per-bucket pipeline (`cumulative_sum`, `derivative`, `moving_avg`, `bucket_script`,
+/// `bucket_selector`) must be declared inside a multi-bucket aggregation whose buckets it walks. One
+/// placed at the request root, where there is no such parent, is a request error rather than a
+/// silent no-op. Called for each level entered through the public `into_final_result`.
+pub(crate) fn reject_root_pipelines(req: &Aggregations) -> crate::Result<()> {
+    for (name, agg) in req.iter() {
+        if is_per_bucket(&agg.agg) {
+            return Err(err(format!(
+                "pipeline aggregation {name:?} requires a multi-bucket parent (histogram, \
+                 date_histogram, range, or terms); it cannot be declared without one"
+            )));
+        }
+    }
+    Ok(())
+}
+
+/// Runs the pipeline aggregations declared at one level of the result tree, after that level and all
+/// of its sub-aggregations have been finalized.
+///
+/// Per-bucket pipelines are computed first so that a sibling pipeline may reduce a per-bucket
+/// pipeline's output.
+pub(crate) fn apply_level_pipelines(
+    results: &mut AggregationResults,
+    req: &Aggregations,
+) -> crate::Result<()> {
+    for (name, agg) in req.iter() {
+        if agg.agg.is_pipeline() || !has_per_bucket_pipeline(agg.sub_aggregation()) {
+            continue;
+        }
+        match results.0.get_mut(name) {
+            Some(AggregationResult::BucketResult(bucket_result)) => {
+                compute::apply_per_bucket(bucket_result, agg.sub_aggregation())?;
+            }
+            _ => {
+                return Err(err(format!(
+                    "per-bucket pipeline under {name:?} requires a multi-bucket parent, but \
+                     {name:?} is not a bucket aggregation"
+                )));
+            }
+        }
+    }
+
+    let mut siblings: Vec<String> = req
+        .iter()
+        .filter(|(_, agg)| is_sibling(&agg.agg))
+        .map(|(name, _)| name.clone())
+        .collect();
+    siblings.sort();
+    for name in siblings {
+        let metric = match &req[&name].agg {
+            AggregationVariants::AvgBucket(sib) => {
+                compute::compute_sibling(SiblingOp::Avg, sib, results, req)?
+            }
+            AggregationVariants::SumBucket(sib) => {
+                compute::compute_sibling(SiblingOp::Sum, sib, results, req)?
+            }
+            AggregationVariants::MinBucket(sib) => {
+                compute::compute_sibling(SiblingOp::Min, sib, results, req)?
+            }
+            AggregationVariants::MaxBucket(sib) => {
+                compute::compute_sibling(SiblingOp::Max, sib, results, req)?
+            }
+            AggregationVariants::StatsBucket(sib) => {
+                compute::compute_sibling(SiblingOp::Stats, sib, results, req)?
+            }
+            _ => continue,
+        };
+        results.0.insert(name, AggregationResult::MetricResult(metric));
+    }
+    Ok(())
+}
