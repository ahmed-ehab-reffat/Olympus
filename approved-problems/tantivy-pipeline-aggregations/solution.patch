@@ -0,0 +1,284 @@
+//! A small arithmetic expression language used by the `bucket_script` and `bucket_selector`
+//! pipeline aggregations.
+//!
+//! The grammar supports decimal numeric literals, variable identifiers (the keys of the
+//! `buckets_path` map), the binary operators `+ - * / %`, unary minus, parentheses, the comparison
+//! operators `== != < <= > >=`, and the boolean operators `&&` and `||`. Comparisons and boolean
+//! operators evaluate to `1.0` (true) or `0.0` (false). Precedence, from tightest to loosest:
+//! unary minus, then `* / %`, then `+ -`, then comparisons, then `&&`, then `||`.
+
+use rustc_hash::FxHashMap;
+
+use crate::aggregation::AggregationError;
+use crate::TantivyError;
+
+fn err(msg: impl Into<String>) -> TantivyError {
+    TantivyError::AggregationError(AggregationError::InvalidRequest(msg.into()))
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum BinOp {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Rem,
+    Eq,
+    Ne,
+    Lt,
+    Le,
+    Gt,
+    Ge,
+    And,
+    Or,
+}
+
+#[derive(Clone, Debug)]
+pub(crate) enum Expr {
+    Num(f64),
+    Var(String),
+    Neg(Box<Expr>),
+    Bin(BinOp, Box<Expr>, Box<Expr>),
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum Tok {
+    Num(f64),
+    Ident(String),
+    Plus,
+    Minus,
+    Star,
+    Slash,
+    Percent,
+    LParen,
+    RParen,
+    EqEq,
+    Ne,
+    Lt,
+    Le,
+    Gt,
+    Ge,
+    And,
+    Or,
+}
+
+fn tokenize(src: &str) -> crate::Result<Vec<Tok>> {
+    let chars: Vec<char> = src.chars().collect();
+    let mut toks = Vec::new();
+    let mut i = 0;
+    while i < chars.len() {
+        let c = chars[i];
+        if c.is_whitespace() {
+            i += 1;
+        } else if c.is_ascii_digit() || c == '.' {
+            let start = i;
+            while i < chars.len() && (chars[i].is_ascii_digit() || chars[i] == '.') {
+                i += 1;
+            }
+            let text: String = chars[start..i].iter().collect();
+            let value = text
+                .parse::<f64>()
+                .map_err(|_| err(format!("invalid number {text:?} in script")))?;
+            toks.push(Tok::Num(value));
+        } else if c.is_alphabetic() || c == '_' {
+            let start = i;
+            while i < chars.len() && (chars[i].is_alphanumeric() || chars[i] == '_') {
+                i += 1;
+            }
+            toks.push(Tok::Ident(chars[start..i].iter().collect()));
+        } else {
+            let two = |a: char| i + 1 < chars.len() && chars[i + 1] == a;
+            let tok = match c {
+                '+' => Tok::Plus,
+                '-' => Tok::Minus,
+                '*' => Tok::Star,
+                '/' => Tok::Slash,
+                '%' => Tok::Percent,
+                '(' => Tok::LParen,
+                ')' => Tok::RParen,
+                '=' if two('=') => {
+                    i += 1;
+                    Tok::EqEq
+                }
+                '!' if two('=') => {
+                    i += 1;
+                    Tok::Ne
+                }
+                '<' if two('=') => {
+                    i += 1;
+                    Tok::Le
+                }
+                '>' if two('=') => {
+                    i += 1;
+                    Tok::Ge
+                }
+                '<' => Tok::Lt,
+                '>' => Tok::Gt,
+                '&' if two('&') => {
+                    i += 1;
+                    Tok::And
+                }
+                '|' if two('|') => {
+                    i += 1;
+                    Tok::Or
+                }
+                other => return Err(err(format!("unexpected character {other:?} in script"))),
+            };
+            toks.push(tok);
+            i += 1;
+        }
+    }
+    Ok(toks)
+}
+
+struct Parser {
+    toks: Vec<Tok>,
+    pos: usize,
+}
+
+impl Parser {
+    fn peek(&self) -> Option<&Tok> {
+        self.toks.get(self.pos)
+    }
+
+    fn bump(&mut self) -> Option<Tok> {
+        let tok = self.toks.get(self.pos).cloned();
+        self.pos += 1;
+        tok
+    }
+
+    fn parse_or(&mut self) -> crate::Result<Expr> {
+        let mut left = self.parse_and()?;
+        while matches!(self.peek(), Some(Tok::Or)) {
+            self.bump();
+            let right = self.parse_and()?;
+            left = Expr::Bin(BinOp::Or, Box::new(left), Box::new(right));
+        }
+        Ok(left)
+    }
+
+    fn parse_and(&mut self) -> crate::Result<Expr> {
+        let mut left = self.parse_cmp()?;
+        while matches!(self.peek(), Some(Tok::And)) {
+            self.bump();
+            let right = self.parse_cmp()?;
+            left = Expr::Bin(BinOp::And, Box::new(left), Box::new(right));
+        }
+        Ok(left)
+    }
+
+    fn parse_cmp(&mut self) -> crate::Result<Expr> {
+        let mut left = self.parse_add()?;
+        loop {
+            let op = match self.peek() {
+                Some(Tok::EqEq) => BinOp::Eq,
+                Some(Tok::Ne) => BinOp::Ne,
+                Some(Tok::Lt) => BinOp::Lt,
+                Some(Tok::Le) => BinOp::Le,
+                Some(Tok::Gt) => BinOp::Gt,
+                Some(Tok::Ge) => BinOp::Ge,
+                _ => break,
+            };
+            self.bump();
+            let right = self.parse_add()?;
+            left = Expr::Bin(op, Box::new(left), Box::new(right));
+        }
+        Ok(left)
+    }
+
+    fn parse_add(&mut self) -> crate::Result<Expr> {
+        let mut left = self.parse_mul()?;
+        loop {
+            let op = match self.peek() {
+                Some(Tok::Plus) => BinOp::Add,
+                Some(Tok::Minus) => BinOp::Sub,
+                _ => break,
+            };
+            self.bump();
+            let right = self.parse_mul()?;
+            left = Expr::Bin(op, Box::new(left), Box::new(right));
+        }
+        Ok(left)
+    }
+
+    fn parse_mul(&mut self) -> crate::Result<Expr> {
+        let mut left = self.parse_unary()?;
+        loop {
+            let op = match self.peek() {
+                Some(Tok::Star) => BinOp::Mul,
+                Some(Tok::Slash) => BinOp::Div,
+                Some(Tok::Percent) => BinOp::Rem,
+                _ => break,
+            };
+            self.bump();
+            let right = self.parse_unary()?;
+            left = Expr::Bin(op, Box::new(left), Box::new(right));
+        }
+        Ok(left)
+    }
+
+    fn parse_unary(&mut self) -> crate::Result<Expr> {
+        if matches!(self.peek(), Some(Tok::Minus)) {
+            self.bump();
+            return Ok(Expr::Neg(Box::new(self.parse_unary()?)));
+        }
+        self.parse_primary()
+    }
+
+    fn parse_primary(&mut self) -> crate::Result<Expr> {
+        match self.bump() {
+            Some(Tok::Num(n)) => Ok(Expr::Num(n)),
+            Some(Tok::Ident(name)) => Ok(Expr::Var(name)),
+            Some(Tok::LParen) => {
+                let inner = self.parse_or()?;
+                match self.bump() {
+                    Some(Tok::RParen) => Ok(inner),
+                    _ => Err(err("missing closing parenthesis in script")),
+                }
+            }
+            other => Err(err(format!("unexpected token {other:?} in script"))),
+        }
+    }
+}
+
+impl Expr {
+    pub(crate) fn parse(src: &str) -> crate::Result<Expr> {
+        let toks = tokenize(src)?;
+        let mut parser = Parser { toks, pos: 0 };
+        let expr = parser.parse_or()?;
+        if parser.pos != parser.toks.len() {
+            return Err(err("trailing tokens in script"));
+        }
+        Ok(expr)
+    }
+
+    pub(crate) fn eval(&self, vars: &FxHashMap<String, f64>) -> crate::Result<f64> {
+        let bool_to_f = |t: bool| if t { 1.0 } else { 0.0 };
+        Ok(match self {
+            Expr::Num(n) => *n,
+            Expr::Var(name) => *vars
+                .get(name)
+                .ok_or_else(|| err(format!("unknown script variable {name:?}")))?,
+            Expr::Neg(inner) => -inner.eval(vars)?,
+            Expr::Bin(op, lhs, rhs) => {
+                let left = lhs.eval(vars)?;
+                let right = rhs.eval(vars)?;
+                match op {
+                    BinOp::Add => left + right,
+                    BinOp::Sub => left - right,
+                    BinOp::Mul => left * right,
+                    BinOp::Div => left / right,
+                    BinOp::Rem => left % right,
+                    BinOp::Eq => bool_to_f(left == right),
+                    BinOp::Ne => bool_to_f(left != right),
+                    BinOp::Lt => bool_to_f(left < right),
+                    BinOp::Le => bool_to_f(left <= right),
+                    BinOp::Gt => bool_to_f(left > right),
+                    BinOp::Ge => bool_to_f(left >= right),
+                    BinOp::And => bool_to_f(left != 0.0 && right != 0.0),
+                    BinOp::Or => bool_to_f(left != 0.0 || right != 0.0),
+                }
+            }
+        })
+    }
+}
