+//! Computation primitives for pipeline aggregations: resolving `buckets_path` values out of the
+//! assembled bucket tree, applying the gap policy, the sibling reductions, the serial transforms,
+//! and the script drivers.
+
+use rustc_hash::{FxHashMap, FxHashSet};
+
+use super::expr::Expr;
+use crate::aggregation::agg_req::{
+    AggregationVariants, Aggregations, GapPolicy, ScriptPipelineAggregation,
+    SiblingPipelineAggregation,
+};
+use crate::aggregation::agg_result::{
+    AggregationResult, AggregationResults, BucketEntries, BucketEntry, BucketResult, MetricResult,
+    PipelineMetricResult, RangeBucketEntry,
+};
+use crate::aggregation::metric::Stats;
+use crate::aggregation::{AggregationError, Key};
+use crate::TantivyError;
+
+fn err(msg: impl Into<String>) -> TantivyError {
+    TantivyError::AggregationError(AggregationError::InvalidRequest(msg.into()))
+}
+
+/// Which reduction a sibling pipeline performs over a sibling aggregation's bucket values.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum SiblingOp {
+    Avg,
+    Sum,
+    Min,
+    Max,
+    Stats,
+}
+
+/// A bucket entry whose value a pipeline can read or into which it can write a result.
+pub(crate) trait PipelineBucket {
+    fn key_as_f64(&self) -> Option<f64>;
+    fn doc_count(&self) -> u64;
+    fn sub(&self) -> &AggregationResults;
+    fn sub_mut(&mut self) -> &mut AggregationResults;
+}
+
+fn key_to_f64(key: &Key) -> Option<f64> {
+    match key {
+        Key::F64(value) => Some(*value),
+        Key::U64(value) => Some(*value as f64),
+        Key::I64(value) => Some(*value as f64),
+        Key::Str(_) => None,
+    }
+}
+
+impl PipelineBucket for BucketEntry {
+    fn key_as_f64(&self) -> Option<f64> {
+        key_to_f64(&self.key)
+    }
+    fn doc_count(&self) -> u64 {
+        self.doc_count
+    }
+    fn sub(&self) -> &AggregationResults {
+        &self.sub_aggregation
+    }
+    fn sub_mut(&mut self) -> &mut AggregationResults {
+        &mut self.sub_aggregation
+    }
+}
+
+impl PipelineBucket for RangeBucketEntry {
+    fn key_as_f64(&self) -> Option<f64> {
+        key_to_f64(&self.key)
+    }
+    fn doc_count(&self) -> u64 {
+        self.doc_count
+    }
+    fn sub(&self) -> &AggregationResults {
+        &self.sub_aggregation
+    }
+    fn sub_mut(&mut self) -> &mut AggregationResults {
+        &mut self.sub_aggregation
+    }
+}
+
+/// The leading name of a `buckets_path` value reference, or `None` for the `_count`/`_key` specials.
+fn ref_name(value_ref: &str) -> Option<&str> {
+    if value_ref == "_count" || value_ref == "_key" {
+        return None;
+    }
+    Some(value_ref.split('.').next().unwrap_or(value_ref))
+}
+
+fn validate_ref(value_ref: &str, sub_req: &Aggregations) -> crate::Result<()> {
+    match ref_name(value_ref) {
+        None => Ok(()),
+        Some(name) if sub_req.contains_key(name) => Ok(()),
+        Some(_) => Err(err(format!(
+            "buckets_path {value_ref:?} does not match a sub-aggregation"
+        ))),
+    }
+}
+
+/// Reads the value named by `value_ref` from a single bucket. Returns `Ok(None)` when the value is
+/// absent in this bucket (a gap).
+fn resolve_value<B: PipelineBucket + ?Sized>(
+    bucket: &B,
+    value_ref: &str,
+) -> crate::Result<Option<f64>> {
+    if value_ref == "_count" {
+        return Ok(Some(bucket.doc_count() as f64));
+    }
+    if value_ref == "_key" {
+        return Ok(bucket.key_as_f64());
+    }
+    let (name, property) = match value_ref.split_once('.') {
+        Some((name, property)) => (name, property),
+        None => (value_ref, "value"),
+    };
+    match bucket.sub().0.get(name) {
+        Some(agg_res) => agg_res.get_value_from_aggregation(name, property),
+        None => Ok(None),
+    }
+}
+
+fn apply_gap(value: Option<f64>, gap_policy: GapPolicy) -> Option<f64> {
+    match (value, gap_policy) {
+        (Some(value), _) => Some(value),
+        (None, GapPolicy::InsertZeros) => Some(0.0),
+        (None, GapPolicy::Skip) => None,
+    }
+}
+
+fn mean(values: &[f64]) -> Option<f64> {
+    if values.is_empty() {
+        None
+    } else {
+        Some(values.iter().sum::<f64>() / values.len() as f64)
+    }
+}
+
+fn min_value(values: &[f64]) -> Option<f64> {
+    values.iter().copied().reduce(f64::min)
+}
+
+fn max_value(values: &[f64]) -> Option<f64> {
+    values.iter().copied().reduce(f64::max)
+}
+
+fn reduce_sibling(op: SiblingOp, values: &[f64]) -> MetricResult {
+    match op {
+        SiblingOp::Avg => MetricResult::Pipeline(PipelineMetricResult { value: mean(values) }),
+        SiblingOp::Sum => MetricResult::Pipeline(PipelineMetricResult {
+            value: Some(values.iter().sum()),
+        }),
+        SiblingOp::Min => MetricResult::Pipeline(PipelineMetricResult {
+            value: min_value(values),
+        }),
+        SiblingOp::Max => MetricResult::Pipeline(PipelineMetricResult {
+            value: max_value(values),
+        }),
+        SiblingOp::Stats => MetricResult::Stats(Stats {
+            count: values.len() as u64,
+            sum: values.iter().sum(),
+            min: min_value(values),
+            max: max_value(values),
+            avg: mean(values),
+        }),
+    }
+}
+
+fn push_value<B: PipelineBucket>(
+    bucket: &B,
+    value_ref: &str,
+    gap_policy: GapPolicy,
+    out: &mut Vec<f64>,
+) -> crate::Result<()> {
+    if let Some(value) = apply_gap(resolve_value(bucket, value_ref)?, gap_policy) {
+        out.push(value);
+    }
+    Ok(())
+}
+
+/// Collects, in any order, the leaf values of a sibling bucket aggregation for a sibling pipeline.
+fn collect_sibling_values(
+    bucket_result: &BucketResult,
+    leaf: &str,
+    gap_policy: GapPolicy,
+) -> crate::Result<Vec<f64>> {
+    let mut values = Vec::new();
+    match bucket_result {
+        BucketResult::Histogram { buckets } => {
+            for bucket in buckets.iter() {
+                push_value(bucket, leaf, gap_policy, &mut values)?;
+            }
+        }
+        BucketResult::Range { buckets } => {
+            for bucket in buckets.iter() {
+                push_value(bucket, leaf, gap_policy, &mut values)?;
+            }
+        }
+        BucketResult::Terms { buckets, .. } => {
+            for bucket in buckets {
+                push_value(bucket, leaf, gap_policy, &mut values)?;
+            }
+        }
+        _ => {
+            return Err(err(
+                "sibling buckets_path must reference a histogram, date_histogram, range, or terms \
+                 aggregation",
+            ))
+        }
+    }
+    Ok(values)
+}
+
+pub(crate) fn compute_sibling(
+    op: SiblingOp,
+    req: &SiblingPipelineAggregation,
+    level_results: &AggregationResults,
+    level_req: &Aggregations,
+) -> crate::Result<MetricResult> {
+    let (head, leaf) = req.buckets_path.split_once('>').ok_or_else(|| {
+        err(format!(
+            "sibling buckets_path {:?} must have the form \"aggregation>value\"",
+            req.buckets_path
+        ))
+    })?;
+    let head_req = level_req
+        .get(head)
+        .ok_or_else(|| err(format!("buckets_path head {head:?} not found")))?;
+    validate_ref(leaf, head_req.sub_aggregation())?;
+    let head_res = level_results
+        .0
+        .get(head)
+        .ok_or_else(|| err(format!("buckets_path head {head:?} not found")))?;
+    let bucket_result = match head_res {
+        AggregationResult::BucketResult(bucket_result) => bucket_result,
+        AggregationResult::MetricResult(_) => {
+            return Err(err(format!(
+                "buckets_path head {head:?} is not a bucket aggregation"
+            )))
+        }
+    };
+    let values = collect_sibling_values(bucket_result, leaf, req.gap_policy)?;
+    Ok(reduce_sibling(op, &values))
+}
+
+fn cumulative_sum(values: &[Option<f64>]) -> Vec<Option<f64>> {
+    let mut running = 0.0;
+    values
+        .iter()
+        .map(|value| {
+            running += value.unwrap_or(0.0);
+            Some(running)
+        })
+        .collect()
+}
+
+fn derivative(values: &[Option<f64>], gap_policy: GapPolicy) -> Vec<Option<f64>> {
+    let mut out = Vec::with_capacity(values.len());
+    for index in 0..values.len() {
+        if index == 0 {
+            out.push(None);
+            continue;
+        }
+        let current = apply_gap(values[index], gap_policy);
+        let previous = apply_gap(values[index - 1], gap_policy);
+        match (current, previous) {
+            (Some(current), Some(previous)) => out.push(Some(current - previous)),
+            _ => out.push(None),
+        }
+    }
+    out
+}
+
+fn moving_avg(values: &[Option<f64>], window: usize, gap_policy: GapPolicy) -> Vec<Option<f64>> {
+    let mut out = Vec::with_capacity(values.len());
+    for index in 0..values.len() {
+        let start = index + 1 - window.min(index + 1);
+        let mut sum = 0.0;
+        let mut count = 0u64;
+        for value in &values[start..=index] {
+            if let Some(value) = apply_gap(*value, gap_policy) {
+                sum += value;
+                count += 1;
+            }
+        }
+        out.push(if count == 0 {
+            None
+        } else {
+            Some(sum / count as f64)
+        });
+    }
+    out
+}
+
+fn collect_inputs<B: PipelineBucket>(
+    buckets: &[B],
+    value_ref: &str,
+    sub_req: &Aggregations,
+) -> crate::Result<Vec<Option<f64>>> {
+    validate_ref(value_ref, sub_req)?;
+    buckets
+        .iter()
+        .map(|bucket| resolve_value(bucket, value_ref))
+        .collect()
+}
+
+fn write_outputs<B: PipelineBucket>(buckets: &mut [B], name: &str, outputs: &[Option<f64>]) {
+    for (bucket, output) in buckets.iter_mut().zip(outputs) {
+        if let Some(value) = output {
+            bucket.sub_mut().0.insert(
+                name.to_string(),
+                AggregationResult::MetricResult(MetricResult::Pipeline(PipelineMetricResult {
+                    value: Some(*value),
+                })),
+            );
+        }
+    }
+}
+
+fn build_vars<B: PipelineBucket>(
+    bucket: &B,
+    req: &ScriptPipelineAggregation,
+) -> crate::Result<Option<FxHashMap<String, f64>>> {
+    let mut vars = FxHashMap::default();
+    for (variable, value_ref) in &req.buckets_path {
+        match apply_gap(resolve_value(bucket, value_ref)?, req.gap_policy) {
+            Some(value) => {
+                vars.insert(variable.clone(), value);
+            }
+            None => return Ok(None),
+        }
+    }
+    Ok(Some(vars))
+}
+
+fn eval_script<B: PipelineBucket>(
+    buckets: &[B],
+    req: &ScriptPipelineAggregation,
+    sub_req: &Aggregations,
+) -> crate::Result<Vec<Option<f64>>> {
+    let expr = Expr::parse(&req.script)?;
+    for value_ref in req.buckets_path.values() {
+        validate_ref(value_ref, sub_req)?;
+    }
+    let mut out = Vec::with_capacity(buckets.len());
+    for bucket in buckets {
+        match build_vars(bucket, req)? {
+            Some(vars) => out.push(Some(expr.eval(&vars)?)),
+            None => out.push(None),
+        }
+    }
+    Ok(out)
+}
+
+fn eval_selector<B: PipelineBucket>(
+    buckets: &[B],
+    req: &ScriptPipelineAggregation,
+    sub_req: &Aggregations,
+) -> crate::Result<Vec<bool>> {
+    let expr = Expr::parse(&req.script)?;
+    for value_ref in req.buckets_path.values() {
+        validate_ref(value_ref, sub_req)?;
+    }
+    let mut keep = Vec::with_capacity(buckets.len());
+    for bucket in buckets {
+        match build_vars(bucket, req)? {
+            Some(vars) => {
+                let value = expr.eval(&vars)?;
+                keep.push(value != 0.0 && !value.is_nan());
+            }
+            None => keep.push(false),
+        }
+    }
+    Ok(keep)
+}
+
+fn process_vec<B: PipelineBucket>(
+    buckets: &mut Vec<B>,
+    sub_req: &Aggregations,
+    ordered: &[String],
+) -> crate::Result<()> {
+    for name in ordered {
+        match &sub_req[name].agg {
+            AggregationVariants::CumulativeSum(req) => {
+                let inputs = collect_inputs(buckets, &req.buckets_path, sub_req)?;
+                let outputs = cumulative_sum(&inputs);
+                write_outputs(buckets, name, &outputs);
+            }
+            AggregationVariants::Derivative(req) => {
+                let inputs = collect_inputs(buckets, &req.buckets_path, sub_req)?;
+                let outputs = derivative(&inputs, req.gap_policy);
+                write_outputs(buckets, name, &outputs);
+            }
+            AggregationVariants::MovingAvg(req) => {
+                let inputs = collect_inputs(buckets, &req.buckets_path, sub_req)?;
+                let outputs = moving_avg(&inputs, req.window, req.gap_policy);
+                write_outputs(buckets, name, &outputs);
+            }
+            AggregationVariants::BucketScript(req) => {
+                let outputs = eval_script(buckets, req, sub_req)?;
+                write_outputs(buckets, name, &outputs);
+            }
+            AggregationVariants::BucketSelector(req) => {
+                let keep = eval_selector(buckets, req, sub_req)?;
+                let mut keep = keep.into_iter();
+                buckets.retain(|_| keep.next().unwrap_or(true));
+            }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+fn buckets_vec_mut<T>(buckets: &mut BucketEntries<T>) -> crate::Result<&mut Vec<T>> {
+    match buckets {
+        BucketEntries::Vec(vec) => Ok(vec),
+        BucketEntries::HashMap(_) => Err(err(
+            "per-bucket pipelines (serial, moving_avg, bucket_script, bucket_selector) require a \
+             non-keyed parent",
+        )),
+    }
+}
+
+/// Computes every per-bucket pipeline declared in `sub_req` over the parent's buckets, in
+/// dependency order.
+pub(crate) fn apply_per_bucket(
+    bucket_result: &mut BucketResult,
+    sub_req: &Aggregations,
+) -> crate::Result<()> {
+    let ordered = order_per_bucket(sub_req)?;
+    if ordered.is_empty() {
+        return Ok(());
+    }
+    match bucket_result {
+        BucketResult::Histogram { buckets } => {
+            process_vec(buckets_vec_mut(buckets)?, sub_req, &ordered)
+        }
+        BucketResult::Range { buckets } => {
+            process_vec(buckets_vec_mut(buckets)?, sub_req, &ordered)
+        }
+        BucketResult::Terms { buckets, .. } => process_vec(buckets, sub_req, &ordered),
+        _ => Err(err(
+            "per-bucket pipelines require a histogram, date_histogram, range, or terms parent",
+        )),
+    }
+}
+
+fn value_refs(agg: &AggregationVariants) -> Vec<&str> {
+    match agg {
+        AggregationVariants::CumulativeSum(req) => vec![req.buckets_path.as_str()],
+        AggregationVariants::Derivative(req) => vec![req.buckets_path.as_str()],
+        AggregationVariants::MovingAvg(req) => vec![req.buckets_path.as_str()],
+        AggregationVariants::BucketScript(req) | AggregationVariants::BucketSelector(req) => {
+            req.buckets_path.values().map(|s| s.as_str()).collect()
+        }
+        _ => vec![],
+    }
+}
+
+fn is_per_bucket(agg: &AggregationVariants) -> bool {
+    matches!(
+        agg,
+        AggregationVariants::CumulativeSum(_)
+            | AggregationVariants::Derivative(_)
+            | AggregationVariants::MovingAvg(_)
+            | AggregationVariants::BucketScript(_)
+            | AggregationVariants::BucketSelector(_)
+    )
+}
+
+/// Returns the per-bucket pipeline names of `sub_req` ordered so that a pipeline reading another
+/// pipeline's output is computed after it. Uses an iterative worklist (Kahn's algorithm) rather than
+/// host-stack recursion, so a long pipeline chain cannot overflow the stack. Errors on a cycle.
+fn order_per_bucket(sub_req: &Aggregations) -> crate::Result<Vec<String>> {
+    let mut names: Vec<String> = sub_req
+        .iter()
+        .filter(|(_, agg)| is_per_bucket(&agg.agg))
+        .map(|(name, _)| name.clone())
+        .collect();
+    names.sort();
+    let name_set: FxHashSet<&str> = names.iter().map(|name| name.as_str()).collect();
+    let mut in_degree: FxHashMap<&str, usize> =
+        names.iter().map(|name| (name.as_str(), 0usize)).collect();
+    let mut dependents: FxHashMap<&str, Vec<&str>> = FxHashMap::default();
+    for name in &names {
+        for value_ref in value_refs(&sub_req[name].agg) {
+            if let Some(target) = ref_name(value_ref) {
+                if target != name.as_str() && name_set.contains(target) {
+                    *in_degree.get_mut(name.as_str()).unwrap() += 1;
+                    dependents.entry(target).or_default().push(name.as_str());
+                }
+            }
+        }
+    }
+    let mut queue: Vec<&str> = names
+        .iter()
+        .map(|name| name.as_str())
+        .filter(|name| in_degree[name] == 0)
+        .collect();
+    let mut ordered: Vec<String> = Vec::with_capacity(names.len());
+    let mut head = 0;
+    while head < queue.len() {
+        let node = queue[head];
+        head += 1;
+        ordered.push(node.to_string());
+        if let Some(node_dependents) = dependents.get(node) {
+            for &dependent in node_dependents {
+                let degree = in_degree.get_mut(dependent).unwrap();
+                *degree -= 1;
+                if *degree == 0 {
+                    queue.push(dependent);
+                }
+            }
+        }
+    }
+    if ordered.len() != names.len() {
+        return Err(err("pipeline buckets_path forms a dependency cycle"));
+    }
+    // A bucket_selector removes buckets, so it runs after every value-producing per-bucket pipeline.
+    // The stable sort keeps the dependency order among the value producers.
+    ordered.sort_by_key(|name| matches!(sub_req[name].agg, AggregationVariants::BucketSelector(_)));
+    Ok(ordered)
+}
