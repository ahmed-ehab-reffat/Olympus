+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/usr/local/bin:${PATH}"
+export CARGO_NET_OFFLINE=true
+
+# Position-independent argument parsing. The platform invokes:
+#   ./test.sh --output_path <path> base|new
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "Usage: $0 --output_path <path> base|new" >&2
+            exit 1
+            ;;
+    esac
+done
+
+if [ -z "$MODE" ] || [ -z "$OUTPUT_PATH" ]; then
+    echo "Usage: $0 --output_path <path> base|new" >&2
+    exit 1
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+# cargo-nextest emits native JUnit (one <testcase> per test, build failures reported as process
+# errors) per the [profile.ci.junit] section in .config/nextest.toml -- no stdout regex parsing.
+# base = pass-to-pass regression suite (the aggregation subsystem the feature lives in).
+# new  = fail-to-pass feature suite (the new pipeline-aggregation integration test).
+JUNIT_SRC="target/nextest/ci/junit.xml"
+rm -f "$JUNIT_SRC"
+
+run_cell() {
+    local exit_code=0
+    # --no-fail-fast so every test runs (and is recorded) even when earlier ones fail; otherwise the
+    # base run, where every feature test fails, would cancel the remainder and emit a partial JUnit.
+    cargo nextest run --profile ci --no-fail-fast "$@" || exit_code=$?
+    if [ -f "$JUNIT_SRC" ]; then
+        cp "$JUNIT_SRC" "$OUTPUT_PATH"
+    fi
+    return "$exit_code"
+}
+
+case "$MODE" in
+    base)
+        run_cell -p tantivy --lib aggregation
+        ;;
+    new)
+        run_cell -p tantivy --test agg_postfinalize_pipeline_checks
+        ;;
+esac
