+fn selector_keys(script: &str) -> Vec<Value> {
+    let res = ok(json!({
+        "histo": {
+            "histogram": { "field": "price", "interval": 10.0, "min_doc_count": 1 },
+            "aggs": { "keep": { "bucket_selector": { "buckets_path": { "c": "_count" }, "script": script } } }
+        }
+    }));
+    res["histo"]["buckets"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|bucket| bucket["key"].clone())
+        .collect()
+}
