+)
+
+func (d *mergeDeviceF30884) maintenance(id string) data.MaintenanceItem {
+	d.t.Helper()
+	m, err := d.store.GetMaintenance(id)
+	require.NoError(d.t, err)
+	return m
+}
+
+func (d *mergeDeviceF30884) incident(id string) data.Incident {
+	d.t.Helper()
+	i, err := d.store.GetIncident(id)
+	require.NoError(d.t, err)
+	return i
+}
+
+func (d *mergeDeviceF30884) document(id string) data.Document {
+	d.t.Helper()
+	doc, err := d.store.GetDocument(id)
+	require.NoError(d.t, err)
+	return doc
+}
+
+func setupPair86029a(
+	t *testing.T,
+	create func(*data.Store) string,
+) (*mergeDeviceF30884, *mergeDeviceF30884, string) {
+	t.Helper()
+	h, a := newMergeHouseholdF30884(t)
+	id := create(a.store)
+	a.sync()
+	b := h.join()
+	b.sync()
+	return a, b, id
+}
+
+func setupMaintenancePair86029a(
+	t *testing.T,
+	item data.MaintenanceItem,
+) (*mergeDeviceF30884, *mergeDeviceF30884, string) {
+	t.Helper()
+	h, a := newMergeHouseholdF30884(t)
+	cats, err := a.store.MaintenanceCategories()
+	require.NoError(t, err)
+	require.NotEmpty(t, cats)
+	item.CategoryID = cats[0].ID
+	require.NoError(t, a.store.CreateMaintenance(&item))
+	a.sync()
+	b := h.join()
+	b.sync()
+	return a, b, item.ID
+}
+
+func updateMaintenance86029a(
+	id string,
+	change func(*data.MaintenanceItem),
+) func(*data.Store) error {
+	return func(s *data.Store) error {
+		m, err := s.GetMaintenance(id)
+		if err != nil {
+			return err
+		}
+		change(&m)
+		return s.UpdateMaintenance(m)
+	}
+}
+
+func dateUTC86029a(m time.Month, d int) time.Time {
+	return time.Date(2026, m, d, 0, 0, 0, 0, time.UTC)
+}
+
+func assertSameInstant86029a(t *testing.T, want time.Time, got *time.Time, msg string) {
+	t.Helper()
+	require.NotNil(t, got, msg)
+	assert.True(t, want.Equal(*got), "%s: want %s, got %s", msg, want, *got)
+}
+
+func TestFieldMergeDisjointVendorEditsConvergePullFirst(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupVendorPairF30884(t)
+
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Phone = "555-0101" }))
+	a.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from A" }))
+
+	a.sync()
+	b.sync()
+	a.sync()
+
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		v := d.vendor(id)
+		assert.Equal(t, "from A", v.Notes, "device %s notes", name)
+		assert.Equal(t, "555-0101", v.Phone, "device %s phone", name)
+	}
+}
+
+func TestFieldMergeDisjointVendorEditsConvergePushFirst(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupVendorPairF30884(t)
+
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Phone = "555-0101" }))
+	a.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from A" }))
+
+	b.sync()
+	a.sync()
+	b.sync()
+
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		v := d.vendor(id)
+		assert.Equal(t, "from A", v.Notes, "device %s notes", name)
+		assert.Equal(t, "555-0101", v.Phone, "device %s phone", name)
+	}
+}
+
+func TestFieldMergeSameFieldKeepsTheLaterEditAndCountsOneConflict(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupVendorPairF30884(t)
+
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from B" }))
+	a.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from A" }))
+
+	a.sync()
+	merged := b.sync()
+	a.sync()
+
+	assert.Equal(t, 1, merged.Conflicts)
+	assert.Equal(t, "from A", a.vendor(id).Notes)
+	assert.Equal(t, "from A", b.vendor(id).Notes)
+}
+
+func TestFieldMergeLaterLocalEditWinsOverIncomingEdit(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupVendorPairF30884(t)
+
+	a.edit(updateVendorF30884(id, func(v *data.Vendor) {
+		v.Notes = "from A"
+		v.Website = "https://a.example"
+	}))
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from B" }))
+
+	a.sync()
+	merged := b.sync()
+	a.sync()
+
+	assert.Equal(t, 1, merged.Conflicts)
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		v := d.vendor(id)
+		assert.Equal(t, "from B", v.Notes, "device %s notes", name)
+		assert.Equal(t, "https://a.example", v.Website, "device %s website", name)
+	}
+}
+
+func TestFieldMergeSameValueOnBothSidesIsNotAConflict(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupVendorPairF30884(t)
+
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) {
+		v.Notes = "agreed"
+		v.Email = "b@example.com"
+	}))
+	a.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "agreed" }))
+
+	a.sync()
+	merged := b.sync()
+	a.sync()
+
+	assert.Zero(t, merged.Conflicts)
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		v := d.vendor(id)
+		assert.Equal(t, "agreed", v.Notes, "device %s notes", name)
+		assert.Equal(t, "b@example.com", v.Email, "device %s email", name)
+	}
+}
+
+func TestFieldMergeEachFieldUsesItsOwnLastEditTime(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupVendorPairF30884(t)
+
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from B" }))
+	a.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from A" }))
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Phone = "555-0199" }))
+
+	a.sync()
+	b.sync()
+	a.sync()
+
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		v := d.vendor(id)
+		assert.Equal(t, "from A", v.Notes, "device %s notes", name)
+		assert.Equal(t, "555-0199", v.Phone, "device %s phone", name)
+	}
+}
+
+func TestFieldMergeServiceLoggedOnOneDeviceUpdatesLastServicedOnTheOther(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupMaintenancePair86029a(
+		t,
+		data.MaintenanceItem{Name: "Furnace filter", IntervalMonths: 3},
+	)
+	serviced := dateUTC86029a(3, 1)
+
+	a.edit(func(s *data.Store) error {
+		return s.CreateServiceLog(
+			&data.ServiceLogEntry{MaintenanceItemID: id, ServicedAt: serviced},
+			data.Vendor{},
+		)
+	})
+	a.sync()
+	b.sync()
+
+	assertSameInstant86029a(t, serviced, b.maintenance(id).LastServicedAt, "device B last serviced")
+}
+
+func TestFieldMergeServicedItemEditedOnBothDevicesKeepsEverything(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupMaintenancePair86029a(t, data.MaintenanceItem{
+		Name: "Gutter cleaning", IntervalMonths: 6, Notes: "orig",
+	})
+	serviced := dateUTC86029a(3, 1)
+
+	a.edit(func(s *data.Store) error {
+		return s.CreateServiceLog(
+			&data.ServiceLogEntry{MaintenanceItemID: id, ServicedAt: serviced},
+			data.Vendor{},
+		)
+	})
+	a.edit(updateMaintenance86029a(id, func(m *data.MaintenanceItem) { m.Notes = "from A" }))
