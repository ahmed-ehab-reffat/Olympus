+	a.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Phone = "555-0150" }))
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Website = "https://b.example" }))
+	a.sync()
+	b.sync()
+	a.sync()
+
+	a.edit(func(s *data.Store) error { return s.DeleteVendor(id) })
+	a.edit(func(s *data.Store) error { return s.RestoreVendor(id) })
+	b.edit(updateVendorF30884(id, func(v *data.Vendor) { v.Notes = "from B" }))
+
+	a.sync()
+	merged := b.sync()
+	a.sync()
+
+	assert.Equal(t, 2, merged.Conflicts)
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		v := d.vendor(id)
+		assert.Equal(t, "from B", v.Notes, "device %s notes", name)
+		assert.Equal(t, "555-0150", v.Phone, "device %s phone", name)
+		assert.Equal(t, "https://b.example", v.Website, "device %s website", name)
+	}
+}
