+// Copyright 2026 Phillip Cloud
+// Licensed under the Apache License, Version 2.0
+
+package sync_test
+
+import (
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	gosync "sync"
+	"testing"
+	"time"
+
+	"github.com/micasa-dev/micasa/internal/crypto"
+	"github.com/micasa-dev/micasa/internal/data"
+	"github.com/micasa-dev/micasa/internal/relay"
+	"github.com/micasa-dev/micasa/internal/sync"
+	"github.com/stretchr/testify/require"
+)
+
+type mergeHouseholdF30884 struct {
+	t    *testing.T
+	ms   *relay.MemStore
+	srv  *httptest.Server
+	id   string
+	key  crypto.HouseholdKey
+	mu   gosync.Mutex
+	gate *pushGateF30884
+}
+
+type pushGateF30884 struct {
+	auth    string
+	reached chan struct{}
+	release chan struct{}
+}
+
+type mergeDeviceF30884 struct {
+	t      *testing.T
+	h      *mergeHouseholdF30884
+	token  string
+	store  *data.Store
+	engine *sync.Engine
+}
+
+func newMergeHouseholdF30884(t *testing.T) (*mergeHouseholdF30884, *mergeDeviceF30884) {
+	t.Helper()
+	ms := relay.NewMemStore()
+	ms.SetEncryptionKey([]byte("test-encryption-key-exactly-32b!"))
+	h := &mergeHouseholdF30884{t: t, ms: ms}
+	relayHandler := relay.NewHandler(ms, slog.Default(), relay.WithSelfHosted())
+	h.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost && r.URL.Path == "/sync/push" {
+			h.holdPush(r.Header.Get("Authorization"))
+		}
+		relayHandler.ServeHTTP(w, r)
+	}))
+	t.Cleanup(h.srv.Close)
+
+	key, err := crypto.GenerateHouseholdKey()
+	require.NoError(t, err)
+	kp, err := crypto.GenerateDeviceKeyPair()
+	require.NoError(t, err)
+	resp, err := ms.CreateHousehold(t.Context(), sync.CreateHouseholdRequest{
+		DeviceName: "device-a",
+		PublicKey:  kp.PublicKey[:],
+	})
+	require.NoError(t, err)
+
+	h.id = resp.HouseholdID
+	h.key = key
+	a := h.device(resp.DeviceID, resp.DeviceToken)
+	require.NoError(t, a.store.SeedDefaults())
+	return h, a
+}
+
+func (h *mergeHouseholdF30884) join() *mergeDeviceF30884 {
+	h.t.Helper()
+	kp, err := crypto.GenerateDeviceKeyPair()
+	require.NoError(h.t, err)
+	resp, err := h.ms.RegisterDevice(h.t.Context(), sync.RegisterDeviceRequest{
+		HouseholdID: h.id,
+		Name:        "device-b",
+		PublicKey:   kp.PublicKey[:],
+	})
+	require.NoError(h.t, err)
+	return h.device(resp.DeviceID, resp.DeviceToken)
+}
+
+func (h *mergeHouseholdF30884) device(deviceID, token string) *mergeDeviceF30884 {
+	h.t.Helper()
+	store, err := data.Open(filepath.Join(h.t.TempDir(), "micasa.db"))
+	require.NoError(h.t, err)
+	require.NoError(h.t, store.AutoMigrate())
+	h.t.Cleanup(func() { _ = store.Close() })
+	require.NoError(h.t, store.GormDB().Create(&data.SyncDevice{
+		ID:          deviceID,
+		Name:        deviceID,
+		HouseholdID: h.id,
+		RelayURL:    h.srv.URL,
+	}).Error)
+	store.SetDeviceID(deviceID)
+	client := sync.NewClient(h.srv.URL, token, h.key)
+	return &mergeDeviceF30884{
+		t:      h.t,
+		h:      h,
+		token:  token,
+		store:  store,
+		engine: sync.NewEngine(store, client, h.id),
+	}
+}
+
+func (h *mergeHouseholdF30884) holdPush(auth string) {
+	h.mu.Lock()
+	gate := h.gate
+	if gate == nil || gate.auth != auth {
+		h.mu.Unlock()
+		return
+	}
+	h.gate = nil
+	h.mu.Unlock()
+	close(gate.reached)
+	<-gate.release
+}
+
+func (d *mergeDeviceF30884) syncAround(other *mergeDeviceF30884) {
+	d.t.Helper()
+	gate := &pushGateF30884{
+		auth:    "Bearer " + d.token,
+		reached: make(chan struct{}),
+		release: make(chan struct{}),
+	}
+	d.h.mu.Lock()
+	d.h.gate = gate
+	d.h.mu.Unlock()
+	done := make(chan error, 1)
+	go func() {
+		_, err := d.engine.Sync(d.t.Context())
+		done <- err
+	}()
+	select {
+	case <-gate.reached:
+	case err := <-done:
+		require.NoError(d.t, err)
+		require.FailNow(d.t, "sync finished without pushing")
+	}
+	func() {
+		defer close(gate.release)
+		other.sync()
+	}()
+	require.NoError(d.t, <-done)
+}
+
+func (d *mergeDeviceF30884) sync() sync.SyncResult {
+	d.t.Helper()
+	result, err := d.engine.Sync(d.t.Context())
+	require.NoError(d.t, err)
+	return result
+}
+
+func (d *mergeDeviceF30884) edit(change func(*data.Store) error) {
+	d.t.Helper()
+	time.Sleep(2 * time.Millisecond)
+	require.NoError(d.t, change(d.store))
+}
+
+func (d *mergeDeviceF30884) vendor(id string) data.Vendor {
+	d.t.Helper()
+	v, err := d.store.GetVendor(id)
+	require.NoError(d.t, err)
+	return v
+}
+
+func (d *mergeDeviceF30884) vendorGone(id string) bool {
+	d.t.Helper()
+	_, err := d.store.GetVendor(id)
+	return err != nil
+}
+
+func setupVendorPairF30884(t *testing.T) (*mergeDeviceF30884, *mergeDeviceF30884, string) {
+	t.Helper()
+	h, a := newMergeHouseholdF30884(t)
+	v := &data.Vendor{Name: "Acme Plumbing", Notes: "orig"}
+	require.NoError(t, a.store.CreateVendor(v))
+	a.sync()
+	b := h.join()
+	b.sync()
+	return a, b, v.ID
+}
+
+func updateVendorF30884(id string, change func(*data.Vendor)) func(*data.Store) error {
+	return func(s *data.Store) error {
+		v, err := s.GetVendor(id)
+		if err != nil {
+			return err
+		}
+		change(&v)
+		return s.UpdateVendor(v)
+	}
+}
