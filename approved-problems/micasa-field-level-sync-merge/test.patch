+	}
+}
+
+func TestFieldMergeScheduleFieldsMoveAsOneUnit(t *testing.T) {
+	t.Parallel()
+	a, b, id := setupMaintenancePair86029a(
+		t,
+		data.MaintenanceItem{Name: "Chimney sweep", IntervalMonths: 6},
+	)
+	due := dateUTC86029a(10, 15)
+
+	a.edit(updateMaintenance86029a(id, func(m *data.MaintenanceItem) {
+		m.IntervalMonths = 0
+		m.DueDate = &due
+		m.Notes = "call the sweep in spring"
+	}))
+	b.edit(
+		updateMaintenance86029a(id, func(m *data.MaintenanceItem) { m.IntervalMonths = 12 }),
+	)
+
+	a.sync()
+	merged := b.sync()
+	a.sync()
+
+	assert.Equal(t, 1, merged.Conflicts)
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		m := d.maintenance(id)
+		assert.Equal(t, 12, m.IntervalMonths, "device %s interval", name)
+		assert.Nil(t, m.DueDate, "device %s due date", name)
+		assert.Equal(t, "call the sweep in spring", m.Notes, "device %s notes", name)
+	}
+}
+
+func TestFieldMergeIncidentStatusFieldsMoveAsOneUnit(t *testing.T) {
+	t.Parallel()
+	h, a := newMergeHouseholdF30884(t)
+	inc := &data.Incident{
+		Title: "Leaking faucet", Status: data.IncidentStatusOpen,
+		Severity: data.IncidentSeveritySoon, DateNoticed: dateUTC86029a(2, 1),
+	}
+	require.NoError(t, a.store.CreateIncident(inc))
+	a.sync()
+	b := h.join()
+	b.sync()
+	resolved := dateUTC86029a(2, 10)
+
+	a.edit(func(s *data.Store) error {
+		i, err := s.GetIncident(inc.ID)
+		if err != nil {
+			return err
+		}
+		i.Status = data.IncidentStatusResolved
+		i.DateResolved = &resolved
+		i.Description = "washer replaced"
+		return s.UpdateIncident(i)
+	})
+	b.edit(func(s *data.Store) error {
+		i, err := s.GetIncident(inc.ID)
+		if err != nil {
+			return err
+		}
+		i.Status = data.IncidentStatusInProgress
+		i.Location = "Kitchen"
+		return s.UpdateIncident(i)
+	})
+
+	a.sync()
+	merged := b.sync()
+	a.sync()
+
+	assert.Equal(t, 1, merged.Conflicts)
+
+	for name, d := range map[string]*mergeDeviceF30884{"A": a, "B": b} {
+		i := d.incident(inc.ID)
+		assert.Equal(t, data.IncidentStatusInProgress, i.Status, "device %s status", name)
+		assert.Nil(t, i.DateResolved, "device %s resolved date", name)
+		assert.Equal(t, "Kitchen", i.Location, "device %s location", name)
+		assert.Equal(t, "washer replaced", i.Description, "device %s description", name)
+	}
+}
+
+func TestFieldMergeClearedDocumentNotesReachThePeer(t *testing.T) {
+	t.Parallel()
+	h, a := newMergeHouseholdF30884(t)
+	doc := &data.Document{
+		Title:    "Water heater manual",
+		FileName: "manual.pdf",
+		Notes:    "keep in garage",
+	}
+	require.NoError(t, a.store.CreateDocument(doc))
+	a.sync()
+	b := h.join()
+	b.sync()
+	require.Equal(t, "keep in garage", b.document(doc.ID).Notes)
+
+	a.edit(func(s *data.Store) error {
+		d, err := s.GetDocument(doc.ID)
+		if err != nil {
+			return err
+		}
+		d.Notes = ""
+		return s.UpdateDocument(d)
+	})
+	a.sync()
