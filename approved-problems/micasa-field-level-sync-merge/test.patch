@@ -0,0 +1,257 @@
+// Copyright 2026 Phillip Cloud
+// Licensed under the Apache License, Version 2.0
+
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"log/slog"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/micasa-dev/micasa/internal/crypto"
+	"github.com/micasa-dev/micasa/internal/data"
+	"github.com/micasa-dev/micasa/internal/relay"
+	"github.com/micasa-dev/micasa/internal/sync"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+type conflictDevice5dd57a struct {
+	t      *testing.T
+	dbPath string
+	store  *data.Store
+	engine *sync.Engine
+}
+
+func newConflictPair5dd57a(t *testing.T) (*conflictDevice5dd57a, *conflictDevice5dd57a, string) {
+	t.Helper()
+	ms := relay.NewMemStore()
+	ms.SetEncryptionKey([]byte("test-encryption-key-exactly-32b!"))
+	srv := httptest.NewServer(relay.NewHandler(ms, slog.Default(), relay.WithSelfHosted()))
+	t.Cleanup(srv.Close)
+
+	key, err := crypto.GenerateHouseholdKey()
+	require.NoError(t, err)
+	kpA, err := crypto.GenerateDeviceKeyPair()
+	require.NoError(t, err)
+	created, err := ms.CreateHousehold(t.Context(), sync.CreateHouseholdRequest{
+		DeviceName: "device-a",
+		PublicKey:  kpA.PublicKey[:],
+	})
+	require.NoError(t, err)
+	kpB, err := crypto.GenerateDeviceKeyPair()
+	require.NoError(t, err)
+	joined, err := ms.RegisterDevice(t.Context(), sync.RegisterDeviceRequest{
+		HouseholdID: created.HouseholdID,
+		Name:        "device-b",
+		PublicKey:   kpB.PublicKey[:],
+	})
+	require.NoError(t, err)
+
+	a := newConflictDevice5dd57a(
+		t,
+		srv.URL,
+		created.HouseholdID,
+		created.DeviceID,
+		created.DeviceToken,
+		key,
+	)
+	v := &data.Vendor{Name: "Acme Plumbing", Notes: "orig"}
+	require.NoError(t, a.store.CreateVendor(v))
+	a.sync()
+	b := newConflictDevice5dd57a(
+		t,
+		srv.URL,
+		created.HouseholdID,
+		joined.DeviceID,
+		joined.DeviceToken,
+		key,
+	)
+	b.sync()
+	return a, b, v.ID
+}
+
+func newConflictDevice5dd57a(
+	t *testing.T,
+	url, householdID, deviceID, token string,
+	key crypto.HouseholdKey,
+) *conflictDevice5dd57a {
+	t.Helper()
+	dbPath := filepath.Join(t.TempDir(), "micasa.db")
+	store, err := openAndMigrate(dbPath)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = store.Close() })
+	require.NoError(t, store.GormDB().Create(&data.SyncDevice{
+		ID:          deviceID,
+		Name:        deviceID,
+		HouseholdID: householdID,
+		RelayURL:    url,
+	}).Error)
+	store.SetDeviceID(deviceID)
+	client := sync.NewClient(url, token, key)
+	return &conflictDevice5dd57a{
+		t:      t,
+		dbPath: dbPath,
+		store:  store,
+		engine: sync.NewEngine(store, client, householdID),
+	}
+}
+
+func (d *conflictDevice5dd57a) sync() sync.SyncResult {
+	d.t.Helper()
+	result, err := d.engine.Sync(d.t.Context())
+	require.NoError(d.t, err)
+	return result
+}
+
+func (d *conflictDevice5dd57a) edit(change func(*data.Store) error) {
+	d.t.Helper()
+	time.Sleep(2 * time.Millisecond)
+	require.NoError(d.t, change(d.store))
+}
+
+func (d *conflictDevice5dd57a) lastOpID(rowID string) string {
+	d.t.Helper()
+	entries, err := d.store.OplogEntries(data.TableVendors, rowID)
+	require.NoError(d.t, err)
+	require.NotEmpty(d.t, entries)
+	return entries[len(entries)-1].ID
+}
+
+func (d *conflictDevice5dd57a) conflictsOutput() string {
+	d.t.Helper()
+	var buf bytes.Buffer
+	require.NoError(d.t, runProConflicts(&buf, d.dbPath))
+	return buf.String()
+}
+
+func hasLineWith5dd57a(out string, parts ...string) bool {
+	scanner := bufio.NewScanner(strings.NewReader(out))
+	for scanner.Scan() {
+		line := scanner.Text()
+		matched := true
+		for _, part := range parts {
+			matched = matched && strings.Contains(line, part)
+		}
+		if matched {
+			return true
+		}
+	}
+	return false
+}
+
+func editVendor5dd57a(id string, change func(*data.Vendor)) func(*data.Store) error {
+	return func(s *data.Store) error {
+		v, err := s.GetVendor(id)
+		if err != nil {
+			return err
+		}
+		change(&v)
+		return s.UpdateVendor(v)
+	}
+}
+
+func TestRunProConflictsListsEachDiscardedFieldEdit(t *testing.T) {
+	t.Parallel()
+	a, b, id := newConflictPair5dd57a(t)
+
+	b.edit(editVendor5dd57a(id, func(v *data.Vendor) {
+		v.Notes = "remote notes"
+		v.Phone = "555-0142"
+	}))
+	a.edit(editVendor5dd57a(id, func(v *data.Vendor) { v.Notes = "local notes" }))
+
+	b.sync()
+	result := a.sync()
+	assert.Equal(t, 1, result.Conflicts)
+
+	got, err := a.store.GetVendor(id)
+	require.NoError(t, err)
+	assert.Equal(t, "local notes", got.Notes)
+	assert.Equal(t, "555-0142", got.Phone)
+
+	out := a.conflictsOutput()
+	assert.Contains(t, out, b.lastOpID(id))
+	assert.True(t, hasLineWith5dd57a(out, "notes", "remote notes"), out)
+}
+
+func TestRunProConflictsListsARemoteDeleteThatLostTheRow(t *testing.T) {
+	t.Parallel()
+	a, b, id := newConflictPair5dd57a(t)
+
+	b.edit(func(s *data.Store) error { return s.DeleteVendor(id) })
+	a.edit(editVendor5dd57a(id, func(v *data.Vendor) { v.Notes = "local notes" }))
+
+	b.sync()
+	result := a.sync()
+	assert.Equal(t, 1, result.Conflicts)
+
+	got, err := a.store.GetVendor(id)
+	require.NoError(t, err)
+	assert.Equal(t, "local notes", got.Notes)
+	assert.Contains(t, a.conflictsOutput(), b.lastOpID(id))
+}
+
+func TestRunProConflictsListsEveryLostFieldOfOneEdit(t *testing.T) {
+	t.Parallel()
+	a, b, id := newConflictPair5dd57a(t)
+
+	b.edit(editVendor5dd57a(id, func(v *data.Vendor) {
+		v.Notes = "remote notes"
+		v.Email = "remote@example.com"
+	}))
+	a.edit(editVendor5dd57a(id, func(v *data.Vendor) {
+		v.Notes = "local notes"
+		v.Email = "local@example.com"
+	}))
+
+	b.sync()
+	result := a.sync()
+	assert.Equal(t, 2, result.Conflicts)
+
+	got, err := a.store.GetVendor(id)
+	require.NoError(t, err)
+	assert.Equal(t, "local notes", got.Notes)
+	assert.Equal(t, "local@example.com", got.Email)
+
+	out := a.conflictsOutput()
+	assert.True(t, hasLineWith5dd57a(out, "notes", "remote notes"), out)
+	assert.True(t, hasLineWith5dd57a(out, "email", "remote@example.com"), out)
+	assert.False(t, hasLineWith5dd57a(out, "remote notes", "remote@example.com"), out)
+}
+
+func TestRunProConflictsListsADeleteThatLostToANewerDelete(t *testing.T) {
+	t.Parallel()
+	a, b, id := newConflictPair5dd57a(t)
+
+	b.edit(func(s *data.Store) error { return s.DeleteVendor(id) })
+	a.edit(func(s *data.Store) error { return s.DeleteVendor(id) })
+
+	b.sync()
+	result := a.sync()
+	assert.Equal(t, 1, result.Conflicts)
+	assert.Contains(t, a.conflictsOutput(), b.lastOpID(id))
+}
+
+func TestRunProConflictsListsAPendingEditANewerDeleteDiscarded(t *testing.T) {
+	t.Parallel()
+	a, b, id := newConflictPair5dd57a(t)
+
+	b.edit(editVendor5dd57a(id, func(v *data.Vendor) { v.Notes = "local notes" }))
+	edit := b.lastOpID(id)
+	a.edit(func(s *data.Store) error { return s.DeleteVendor(id) })
+
+	a.sync()
+	result := b.sync()
+	assert.Equal(t, 1, result.Conflicts)
+
+	_, err := b.store.GetVendor(id)
+	require.Error(t, err)
+	out := b.conflictsOutput()
+	assert.True(t, hasLineWith5dd57a(out, edit, "notes", "local notes"), out)
+}
