+++ b/internal/sync/merge.go
@@ -0,0 +1,507 @@
+// Copyright 2026 Phillip Cloud
+// Licensed under the Apache License, Version 2.0
+
+package sync
+
+import (
+	"fmt"
+	"maps"
+	"slices"
+	"sort"
+
+	"github.com/micasa-dev/micasa/internal/data"
+	"gorm.io/gorm"
+)
+
+// coupledFields lists, per table, the groups of fields that only make
+// sense together and therefore merge as a single unit.
+var coupledFields = map[string][][]string{
+	data.TableMaintenanceItems: {
+		{data.ColIntervalMonths, data.ColDueDate},
+	},
+	data.TableIncidents: {
+		{data.ColStatus, data.ColPreviousStatus, data.ColDateResolved},
+	},
+}
+
+// mergeUnits splits a row's fields into the units a merge decides on:
+// each coupled group, then every remaining field alone.
+func mergeUnits(tableName string, rows ...map[string]any) [][]string {
+	seen := make(map[string]bool)
+	var units [][]string
+	for _, group := range coupledFields[tableName] {
+		units = append(units, group)
+		for _, f := range group {
+			seen[f] = true
+		}
+	}
+	var singles []string
+	for _, row := range rows {
+		for key := range row {
+			if !seen[key] && !data.MergeExempt(key) {
+				seen[key] = true
+				singles = append(singles, key)
+			}
+		}
+	}
+	sort.Strings(singles)
+	for _, f := range singles {
+		units = append(units, []string{f})
+	}
+	return units
+}
+
+type localLoss struct {
+	stamp data.FieldStamp
+	units [][]string
+}
+
+// localLosses groups the local units a merge discards by the entry that
+// wrote them.
+type localLosses map[string]*localLoss
+
+func (l localLosses) add(stamp data.FieldStamp, unit []string) {
+	if stamp.OpID == "" {
+		return
+	}
+	loss, ok := l[stamp.OpID]
+	if !ok {
+		loss = &localLoss{stamp: stamp}
+		l[stamp.OpID] = loss
+	}
+	loss.units = append(loss.units, unit)
+}
+
+type fieldMerge struct {
+	updates    map[string]any
+	applied    map[string]string
+	remoteLost [][]string
+	localLost  localLosses
+}
+
+// mergeFields decides, unit by unit, which fields an incoming update
+// changed win last-writer-wins against the row as this device has it.
+func mergeFields(
+	tableName string,
+	hist data.RowHistory,
+	remote map[string]any,
+	op OpPayload,
+) fieldMerge {
+	incoming := data.FieldStamp{OpID: op.ID, At: op.CreatedAt, DeviceID: op.DeviceID}
+	m := fieldMerge{
+		updates:   make(map[string]any),
+		applied:   make(map[string]string),
+		localLost: make(localLosses),
+	}
+	for _, unit := range mergeUnits(tableName, remote, hist.State) {
+		if !slices.ContainsFunc(unit, func(f string) bool {
+			_, changed := op.ChangedFields[f]
+			return changed
+		}) {
+			continue
+		}
+		same := sameUnit(tableName, unit, remote, hist.State)
+		local := unitStamp(unit, hist.Stamps)
+		if !incoming.Beats(local) {
+			if !same {
+				m.remoteLost = append(m.remoteLost, unit)
+			}
+			continue
+		}
+		for _, f := range unit {
+			m.updates[f] = remote[f]
+			m.applied[f] = hist.Stamps[f].OpID
+		}
+		if same || !overwritesUnseen(tableName, unit, remote, hist, op.ChangedFields) {
+			continue
+		}
+		m.localLost.add(local, unit)
+	}
+	if len(m.updates) > 0 && data.LaterTimestamp(remote[data.ColUpdatedAt], hist.UpdatedAt) {
+		m.updates[data.ColUpdatedAt] = remote[data.ColUpdatedAt]
+	}
+	return m
+}
+
+func sameUnit(tableName string, unit []string, a, b map[string]any) bool {
+	return !slices.ContainsFunc(unit, func(f string) bool {
+		return !data.SameFieldValue(tableName, f, a[f], b[f])
+	})
+}
+
+func unitStamp(unit []string, stamps map[string]data.FieldStamp) data.FieldStamp {
+	var latest data.FieldStamp
+	for _, f := range unit {
+		if s, ok := stamps[f]; ok && s.Beats(latest) {
+			latest = s
+		}
+	}
+	return latest
+}
+
+// displacedLocal lists the local units that writing a whole row from an op
+// replaces with a different value the op's author never saw.
+func displacedLocal(
+	tableName string,
+	hist data.RowHistory,
+	row map[string]any,
+	changed map[string]string,
+) localLosses {
+	lost := make(localLosses)
+	for _, unit := range mergeUnits(tableName, row, hist.State) {
+		if sameUnit(tableName, unit, row, hist.State) ||
+			!overwritesUnseen(tableName, unit, row, hist, changed) {
+			continue
+		}
+		lost.add(unitStamp(unit, hist.Stamps), unit)
+	}
+	return lost
+}
+
+// overwritesUnseen reports whether winning a unit discards a value the
+// incoming op's author never saw: a changed member replaced an entry that
+// did not lead to the value held here, or an unchanged member differs.
+func overwritesUnseen(
+	tableName string,
+	unit []string,
+	remote map[string]any,
+	hist data.RowHistory,
+	changed map[string]string,
+) bool {
+	return slices.ContainsFunc(unit, func(f string) bool {
+		if prev, ok := changed[f]; ok {
+			return !hist.Saw(f, prev)
+		}
+		return !data.SameFieldValue(tableName, f, remote[f], hist.State[f])
+	})
+}
+
+// applyFieldwise applies a remote op that lists the fields it changed.
+// Updates merge field by field; deletes and restores, and updates meeting a
+// deleted row, are decided for the whole row by last-writer-wins. The
+// result is the same on every device whatever order the ops arrive in.
+func applyFieldwise(tx *gorm.DB, op OpPayload) ([]data.FieldConflict, bool, error) {
+	if op.OpType == data.OpInsert {
+		return nil, false, applyAndRecord(tx, op)
+	}
+	hist, err := data.LoadRowHistory(tx, op.TableName, op.RowID)
+	if err != nil {
+		return nil, false, err
+	}
+	incoming := data.FieldStamp{OpID: op.ID, At: op.CreatedAt, DeviceID: op.DeviceID}
+	switch op.OpType {
+	case data.OpDelete:
+		return deleteFieldwise(tx, op, hist, incoming)
+	case data.OpRestore:
+		if hist.IsDeleted() {
+			if !incoming.Beats(*hist.Deleted) {
+				return nil, true, recordLoss(tx, op)
+			}
+			conflicts, err := reviveWholeRow(tx, op, hist)
+			return conflicts, false, err
+		}
+		if !incoming.Beats(hist.Alive) {
+			return nil, true, recordLoss(tx, op)
+		}
+		conflicts, err := writeWholeRow(tx, op, hist)
+		return conflicts, false, err
+	case data.OpUpdate:
+		return updateFieldwise(tx, op, hist, incoming)
+	}
+	return nil, false, applyAndRecord(tx, op)
+}
+
+// deleteFieldwise applies a delete when it is later than every other
+// change to the row, deletes included; a losing delete changes nothing. A
+// winning delete first writes the deleting device's copy of the row, so
+// every device keeps the same deleted row, and local edits it discards
+// unseen are reported as conflicts.
+func deleteFieldwise(
+	tx *gorm.DB,
+	op OpPayload,
+	hist data.RowHistory,
+	incoming data.FieldStamp,
+) ([]data.FieldConflict, bool, error) {
+	if !incoming.Beats(hist.Alive) || (hist.Deleted != nil && hist.Deleted.Beats(incoming)) {
+		return nil, true, recordLoss(tx, op)
+	}
+	snapshot, err := data.DecodeOplogPayload(op.TableName, op.Payload)
+	if err != nil {
+		return nil, false, fmt.Errorf("unmarshal delete payload: %w", err)
+	}
+	updates, changed := wholeRow(hist, snapshot)
+	applied := op
+	applied.ChangedFields = changed
+	exists, err := rowExists(tx, op.TableName, op.RowID)
+	if err != nil {
+		return nil, false, err
+	}
+	if exists {
+		if err := writeFields(tx, op, updates); err != nil {
+			return nil, false, err
+		}
+		if err := applyDelete(tx, op); err != nil {
+			return nil, false, err
+		}
+	}
+	if err := recordAppliedOp(tx, applied); err != nil {
+		return nil, false, err
+	}
+	lost := displacedLocal(op.TableName, hist, snapshot, op.ChangedFields)
+	conflicts, err := recordLocalLosses(tx, op, hist, lost)
+	return conflicts, false, err
+}
+
+// wholeRow takes every field of a payload as its op wrote it, each mapped
+// to the entry whose value it replaces here.
+func wholeRow(hist data.RowHistory, row map[string]any) (map[string]any, map[string]string) {
+	updates := make(map[string]any)
+	changed := make(map[string]string)
+	for key, value := range row {
+		if data.MergeExempt(key) {
+			continue
+		}
+		updates[key] = value
+		changed[key] = hist.Stamps[key].OpID
+	}
+	return updates, changed
+}
+
+// reviveWholeRow brings back a deleted row for an update or restore made
+// after the delete. Last-writer-wins decides the whole row here, so the
+// op's full row becomes the row, not only the fields it changed.
+func reviveWholeRow(
+	tx *gorm.DB,
+	op OpPayload,
+	hist data.RowHistory,
+) ([]data.FieldConflict, error) {
+	if err := reviveRow(tx, op, hist); err != nil {
+		return nil, err
+	}
+	return writeWholeRow(tx, op, hist)
+}
+
+// writeWholeRow makes an op's full row the row and reports the local edits
+// it discards unseen as conflicts.
+func writeWholeRow(
+	tx *gorm.DB,
+	op OpPayload,
+	hist data.RowHistory,
+) ([]data.FieldConflict, error) {
+	remote, err := data.DecodeOplogPayload(op.TableName, op.Payload)
+	if err != nil {
+		return nil, fmt.Errorf("unmarshal %s payload: %w", op.OpType, err)
+	}
+	updates, changed := wholeRow(hist, remote)
+	if data.LaterTimestamp(remote[data.ColUpdatedAt], hist.UpdatedAt) {
+		updates[data.ColUpdatedAt] = remote[data.ColUpdatedAt]
+	}
+	if err := writeFields(tx, op, updates); err != nil {
+		return nil, err
+	}
+	applied := op
+	applied.ChangedFields = changed
+	if err := recordAppliedOp(tx, applied); err != nil {
+		return nil, err
+	}
+	lost := displacedLocal(op.TableName, hist, remote, op.ChangedFields)
+	return recordLocalLosses(tx, op, hist, lost)
+}
+
+// reviveRow brings back a deleted row before a newer change applies to it:
+// a soft-deleted row is restored, and a permanently deleted one is rebuilt
+// from the values its history last gave it.
+func reviveRow(tx *gorm.DB, op OpPayload, hist data.RowHistory) error {
+	exists, err := rowExists(tx, op.TableName, op.RowID)
+	if err != nil {
+		return err
+	}
+	if exists {
+		return applyRestore(tx, op)
+	}
+	row := maps.Clone(hist.State)
+	row[data.ColID] = op.RowID
+	row[data.ColCreatedAt] = hist.CreatedAt
+	row[data.ColUpdatedAt] = hist.UpdatedAt
+	stripNonColumnKeys(op.TableName, row)
+	if err := tx.Table(op.TableName).Create(row).Error; err != nil {
+		return fmt.Errorf("recreate %s/%s: %w", op.TableName, op.RowID, err)
+	}
+	return nil
+}
+
+func rowExists(tx *gorm.DB, tableName, rowID string) (bool, error) {
+	var n int64
+	if err := tx.Table(tableName).Where(sqlWhereID, rowID).Count(&n).Error; err != nil {
+		return false, fmt.Errorf("check %s/%s: %w", tableName, rowID, err)
+	}
+	return n > 0, nil
+}
+
+func updateFieldwise(
+	tx *gorm.DB,
+	op OpPayload,
+	hist data.RowHistory,
+	incoming data.FieldStamp,
+) ([]data.FieldConflict, bool, error) {
+	if hist.IsDeleted() {
+		if !incoming.Beats(*hist.Deleted) {
+			return nil, true, recordLoss(tx, op)
+		}
+		conflicts, err := reviveWholeRow(tx, op, hist)
+		return conflicts, false, err
+	}
+	remote, err := data.DecodeOplogPayload(op.TableName, op.Payload)
+	if err != nil {
+		return nil, false, fmt.Errorf("unmarshal update payload: %w", err)
+	}
+	m := mergeFields(op.TableName, hist, remote, op)
+	if err := writeFields(tx, op, m.updates); err != nil {
+		return nil, false, err
+	}
+	applied := op
+	applied.ChangedFields = m.applied
+	if err := recordAppliedOp(tx, applied); err != nil {
+		return nil, false, err
+	}
+	if err := data.AddLostFields(tx, op.ID, m.remoteLost); err != nil {
+		return nil, false, err
+	}
+	conflicts := make([]data.FieldConflict, 0, len(m.remoteLost))
+	for _, unit := range m.remoteLost {
+		conflicts = append(conflicts, data.FieldConflict{
+			OpID: op.ID, TableName: op.TableName, RowID: op.RowID,
+			Field: data.LostUnitName(unit), Value: data.LostUnitValue(remote, unit),
+			DeviceID: op.DeviceID, CreatedAt: op.CreatedAt,
+		})
+	}
+	local, err := recordLocalLosses(tx, op, hist, m.localLost)
+	if err != nil {
+		return nil, false, err
+	}
+	return append(conflicts, local...), false, nil
+}
+
+// settleDisplacedLocal settles the pending local ops on a row that a newer
+// op sent without field tracking replaces whole. A local update that lists
+// its changed fields keeps them as lost fields wherever the incoming row
+// overwrites its value; every other pending op is marked unapplied so the
+// row state stays consistent, as before field tracking.
+func settleDisplacedLocal(tx *gorm.DB, op OpPayload) ([]data.FieldConflict, error) {
+	var pending []data.SyncOplogEntry
+	if err := tx.Where(data.ColTableName+" = ? AND "+data.ColRowID+" = ?", op.TableName, op.RowID).
+		Where(data.ColSyncedAt + " IS NULL").
+		Order("rowid ASC").
+		Find(&pending).Error; err != nil {
+		return nil, fmt.Errorf("load pending ops of %s/%s: %w", op.TableName, op.RowID, err)
+	}
+	remote, err := data.DecodeOplogPayload(op.TableName, op.Payload)
+	if err != nil {
+		return nil, fmt.Errorf("unmarshal %s payload: %w", op.OpType, err)
+	}
+	var conflicts []data.FieldConflict
+	var unapplied []string
+	for _, entry := range pending {
+		changed, known, err := data.DecodeChangedFields(entry.ChangedFields)
+		if err != nil {
+			return nil, err
+		}
+		if entry.OpType != data.OpUpdate || !known {
+			unapplied = append(unapplied, entry.ID)
+			continue
+		}
+		local, err := data.DecodeOplogPayload(op.TableName, entry.Payload)
+		if err != nil {
+			return nil, err
+		}
+		var lost [][]string
+		for _, unit := range mergeUnits(op.TableName, local) {
+			if slices.ContainsFunc(unit, func(f string) bool {
+				_, ok := changed[f]
+				return ok
+			}) && replacesUnit(op, unit, remote, local) {
+				lost = append(lost, unit)
+			}
+		}
+		if err := data.AddLostFields(tx, entry.ID, lost); err != nil {
+			return nil, err
+		}
+		for _, unit := range lost {
+			conflicts = append(conflicts, data.FieldConflict{
+				OpID: entry.ID, TableName: op.TableName, RowID: op.RowID,
+				Field: data.LostUnitName(unit), Value: data.LostUnitValue(local, unit),
+				DeviceID: entry.DeviceID, CreatedAt: entry.CreatedAt,
+			})
+		}
+	}
+	if len(unapplied) > 0 {
+		if err := tx.Model(&data.SyncOplogEntry{}).
+			Where(data.ColID+" IN ?", unapplied).
+			Update(data.ColAppliedAt, nil).Error; err != nil {
+			return nil, fmt.Errorf("clear local applied_at: %w", err)
+		}
+	}
+	return conflicts, nil
+}
+
+// replacesUnit reports whether a whole-row op discards a unit's local
+// value: a delete discards every unit, any other op one whose value it
+// writes differently.
+func replacesUnit(op OpPayload, unit []string, remote, local map[string]any) bool {
+	if op.OpType == data.OpDelete {
+		return true
+	}
+	return slices.ContainsFunc(unit, func(f string) bool {
+		value, ok := remote[f]
+		return ok && !data.SameFieldValue(op.TableName, f, value, local[f])
+	})
+}
+
+// recordLocalLosses marks the units each local entry lost and returns them
+// as conflicts.
+func recordLocalLosses(
+	tx *gorm.DB,
+	op OpPayload,
+	hist data.RowHistory,
+	lost localLosses,
+) ([]data.FieldConflict, error) {
+	var conflicts []data.FieldConflict
+	for _, id := range slices.Sorted(maps.Keys(lost)) {
+		loss := lost[id]
+		if err := data.AddLostFields(tx, id, loss.units); err != nil {
+			return nil, err
+		}
+		for _, unit := range loss.units {
+			conflicts = append(conflicts, data.FieldConflict{
+				OpID: id, TableName: op.TableName, RowID: op.RowID,
+				Field: data.LostUnitName(unit), Value: data.LostUnitValue(hist.State, unit),
+				DeviceID: loss.stamp.DeviceID, CreatedAt: loss.stamp.At,
+			})
+		}
+	}
+	return conflicts, nil
+}
+
+func writeFields(tx *gorm.DB, op OpPayload, updates map[string]any) error {
+	stripNonColumnKeys(op.TableName, updates)
+	if len(updates) == 0 {
+		return nil
+	}
+	result := tx.Table(op.TableName).Where(sqlWhereID, op.RowID).Updates(updates)
+	if result.Error != nil {
+		return fmt.Errorf("merge %s/%s: %w", op.TableName, op.RowID, result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("merge %s/%s: row not found", op.TableName, op.RowID)
+	}
+	return nil
+}
+
+// recordLoss records a remote op that lost its whole row so it is listed
+// as a conflict, and lets the caller report the loss after commit.
+func recordLoss(tx *gorm.DB, op OpPayload) error {
+	if err := recordUnappliedOp(tx, op); !isConflictLoss(err) {
+		return err
+	}
+	return nil
+}
