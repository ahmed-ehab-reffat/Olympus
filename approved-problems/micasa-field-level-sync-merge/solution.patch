diff --git a/internal/data/oplog_merge.go b/internal/data/oplog_merge.go
new file mode 100644
index 0000000..76dd49a
--- /dev/null
+++ b/internal/data/oplog_merge.go
@@ -0,0 +1,469 @@
+// Copyright 2026 Phillip Cloud
+// Licensed under the Apache License, Version 2.0
+
+package data
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"maps"
+	"reflect"
+	"slices"
+	"strings"
+	"time"
+
+	"gorm.io/gorm"
+)
+
+// FieldConflict describes one field edit that was discarded when two
+// devices changed the same row between syncs. A coupled unit is reported
+// once, with its member fields joined by "+".
+type FieldConflict struct {
+	OpID      string
+	TableName string
+	RowID     string
+	Field     string
+	Value     any
+	DeviceID  string
+	CreatedAt time.Time
+}
+
+// FieldStamp identifies the oplog entry that last wrote a field of a row.
+type FieldStamp struct {
+	OpID     string
+	At       time.Time
+	DeviceID string
+}
+
+// Beats reports whether an edit stamped s wins last-writer-wins against one
+// stamped o: the later edit wins, equal times go to the larger device id,
+// and anything beats a field nothing has written yet.
+func (s FieldStamp) Beats(o FieldStamp) bool {
+	if o.OpID == "" {
+		return true
+	}
+	if s.At.Equal(o.At) {
+		return s.DeviceID >= o.DeviceID
+	}
+	return s.At.After(o.At)
+}
+
+// RowHistory is a row as this device's oplog has built it: the value each
+// field was last given and the entry that wrote it, the latest insert,
+// update or restore, and the latest delete. A delete writes the deleting
+// device's copy of the row, so every device keeps the same deleted row.
+// Lost keeps, for each entry that lost here, the entries its changed fields
+// replaced.
+type RowHistory struct {
+	State     map[string]any
+	Stamps    map[string]FieldStamp
+	Alive     FieldStamp
+	Deleted   *FieldStamp
+	CreatedAt any
+	UpdatedAt any
+	Lost      map[string]map[string]string
+}
+
+// Saw reports whether an op that replaced the entry prev in a field had
+// seen the value the field holds here: prev wrote it, or prev lost here
+// after replacing an entry the op saw in turn.
+func (h *RowHistory) Saw(field, prev string) bool {
+	for range len(h.Lost) + 1 {
+		if prev == h.Stamps[field].OpID {
+			return true
+		}
+		next, ok := h.Lost[prev][field]
+		if !ok {
+			return false
+		}
+		prev = next
+	}
+	return false
+}
+
+// IsDeleted reports whether the row's latest delete is later than its
+// latest insert, update and restore.
+func (h *RowHistory) IsDeleted() bool {
+	return h.Deleted != nil && h.Deleted.Beats(h.Alive)
+}
+
+func (h *RowHistory) latest() time.Time {
+	latest := h.Alive.At
+	for _, stamp := range h.Stamps {
+		if stamp.At.After(latest) {
+			latest = stamp.At
+		}
+	}
+	if h.Deleted != nil && h.Deleted.At.After(latest) {
+		latest = h.Deleted.At
+	}
+	return latest
+}
+
+// LoadRowHistory replays the applied oplog entries of a row in the order
+// this device applied them.
+func LoadRowHistory(tx *gorm.DB, tableName, rowID string) (RowHistory, error) {
+	hist := RowHistory{
+		State:  make(map[string]any),
+		Stamps: make(map[string]FieldStamp),
+		Lost:   make(map[string]map[string]string),
+	}
+	var entries []SyncOplogEntry
+	if err := tx.Where(ColTableName+" = ? AND "+ColRowID+" = ?", tableName, rowID).
+		Order("rowid ASC").
+		Find(&entries).Error; err != nil {
+		return hist, fmt.Errorf("load history of %s/%s: %w", tableName, rowID, err)
+	}
+	for _, entry := range entries {
+		if entry.AppliedAt == nil {
+			changed, _, err := DecodeChangedFields(entry.ChangedFields)
+			if err != nil {
+				return hist, err
+			}
+			hist.Lost[entry.ID] = changed
+			continue
+		}
+		stamp := FieldStamp{OpID: entry.ID, At: entry.CreatedAt, DeviceID: entry.DeviceID}
+		switch entry.OpType {
+		case OpDelete:
+			if hist.Deleted == nil || stamp.Beats(*hist.Deleted) {
+				hist.Deleted = &stamp
+			}
+		case OpInsert, OpUpdate, OpRestore:
+			if stamp.Beats(hist.Alive) {
+				hist.Alive = stamp
+			}
+		}
+		if err := hist.replay(tableName, entry, stamp); err != nil {
+			return hist, err
+		}
+	}
+	return hist, nil
+}
+
+func (h *RowHistory) replay(tableName string, entry SyncOplogEntry, stamp FieldStamp) error {
+	row, err := DecodeOplogPayload(tableName, entry.Payload)
+	if err != nil {
+		return err
+	}
+	changed, known, err := DecodeChangedFields(entry.ChangedFields)
+	if err != nil {
+		return err
+	}
+	for key, value := range row {
+		if _, ok := changed[key]; MergeExempt(key) || (known && !ok) {
+			continue
+		}
+		h.State[key] = value
+		h.Stamps[key] = stamp
+	}
+	if value, ok := row[ColCreatedAt]; ok && h.CreatedAt == nil {
+		h.CreatedAt = value
+	}
+	if value, ok := row[ColUpdatedAt]; ok && LaterTimestamp(value, h.UpdatedAt) {
+		h.UpdatedAt = value
+	}
+	return nil
+}
+
+// LaterTimestamp reports whether a decoded payload timestamp a is later
+// than b, treating a missing or unparsable b as earlier than anything.
+func LaterTimestamp(a, b any) bool {
+	as, _ := a.(string)
+	bs, _ := b.(string)
+	at, aerr := time.Parse(time.RFC3339Nano, as)
+	bt, berr := time.Parse(time.RFC3339Nano, bs)
+	if aerr != nil {
+		return false
+	}
+	return berr != nil || at.After(bt)
+}
+
+// localChanges works out which fields a local op changes, each mapped to
+// the entry whose value it replaces, and when the row was last written so
+// the new entry can be stamped after it. A delete or restore carries the
+// row as stored at that moment as its payload and changes every field of it.
+func localChanges(
+	tx *gorm.DB,
+	tableName, rowID, opType, payload string,
+) (string, string, time.Time, error) {
+	hist, err := LoadRowHistory(tx, tableName, rowID)
+	if err != nil {
+		return "", "", time.Time{}, err
+	}
+	changed := make(map[string]string)
+	switch opType {
+	case OpInsert, OpUpdate:
+		row, err := DecodeOplogPayload(tableName, payload)
+		if err != nil {
+			return "", "", time.Time{}, err
+		}
+		for key, value := range row {
+			prev, seen := hist.State[key]
+			if MergeExempt(key) || (seen && SameFieldValue(tableName, key, value, prev)) {
+				continue
+			}
+			changed[key] = hist.Stamps[key].OpID
+		}
+	case OpDelete, OpRestore:
+		row, found, err := storedRow(tx, tableName, rowID)
+		if err != nil {
+			return "", "", time.Time{}, err
+		}
+		if !found {
+			row = maps.Clone(hist.State)
+		}
+		row[ColID] = rowID
+		raw, err := json.Marshal(row)
+		if err != nil {
+			return "", "", time.Time{}, fmt.Errorf("encode %s/%s: %w", tableName, rowID, err)
+		}
+		payload = string(raw)
+		for key := range row {
+			if !MergeExempt(key) {
+				changed[key] = hist.Stamps[key].OpID
+			}
+		}
+	}
+	encoded, err := EncodeChangedFields(changed)
+	return payload, encoded, hist.latest(), err
+}
+
+// EncodeChangedFields serializes the fields an op changed, each mapped to
+// the entry whose value it replaced. A nil map encodes as empty: the op
+// predates field tracking and stands for its whole row.
+func EncodeChangedFields(fields map[string]string) (string, error) {
+	if fields == nil {
+		return "", nil
+	}
+	raw, err := json.Marshal(fields)
+	if err != nil {
+		return "", fmt.Errorf("encode changed fields: %w", err)
+	}
+	return string(raw), nil
+}
+
+// DecodeChangedFields reverses EncodeChangedFields; known is false for an
+// entry written before field tracking.
+func DecodeChangedFields(raw string) (map[string]string, bool, error) {
+	if raw == "" {
+		return nil, false, nil
+	}
+	fields := make(map[string]string)
+	if err := json.Unmarshal([]byte(raw), &fields); err != nil {
+		return nil, false, fmt.Errorf("decode changed fields: %w", err)
+	}
+	return fields, true, nil
+}
+
+var mergeExemptFields = []string{ColID, ColCreatedAt, ColUpdatedAt, ColDeletedAt, "blob_ref"}
+
+// MergeExempt reports whether a payload key is bookkeeping that is never
+// tracked or merged as a field.
+func MergeExempt(field string) bool {
+	return slices.Contains(mergeExemptFields, field)
+}
+
+// SameFieldValue compares two decoded payload values of one field by
+// meaning: numbers by value, timestamp columns by instant whatever offset
+// or precision they were written with, and any other text byte for byte.
+func SameFieldValue(tableName, field string, a, b any) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+	as, aok := a.(string)
+	bs, bok := b.(string)
+	if aok != bok {
+		return false
+	}
+	if !aok {
+		return fmt.Sprint(a) == fmt.Sprint(b)
+	}
+	if as == bs || !IsTimeColumn(tableName, field) {
+		return as == bs
+	}
+	at, aerr := time.Parse(time.RFC3339Nano, as)
+	bt, berr := time.Parse(time.RFC3339Nano, bs)
+	return aerr == nil && berr == nil && at.Equal(bt)
+}
+
+// AddLostFields notes on an oplog entry which of its merge units a merge
+// discarded, keeping any it lost before.
+func AddLostFields(tx *gorm.DB, opID string, units [][]string) error {
+	if len(units) == 0 {
+		return nil
+	}
+	var entry SyncOplogEntry
+	if err := tx.Select(ColLostFields).Where(ColID+" = ?", opID).Take(&entry).Error; err != nil {
+		return fmt.Errorf("load lost fields of %s: %w", opID, err)
+	}
+	lost := make(map[string]bool)
+	for name := range strings.SplitSeq(entry.LostFields, ",") {
+		if name != "" {
+			lost[name] = true
+		}
+	}
+	for _, unit := range units {
+		lost[LostUnitName(unit)] = true
+	}
+	return tx.Model(&SyncOplogEntry{}).
+		Where(ColID+" = ?", opID).
+		Update(ColLostFields, strings.Join(slices.Sorted(maps.Keys(lost)), ",")).Error
+}
+
+const lostUnitSep = "+"
+
+// LostWholeRow is the field name conflict reports give an op that lost its
+// whole row.
+const LostWholeRow = "*"
+
+// LostUnitName names a discarded unit in conflict reports: the field
+// itself, or the members of a coupled unit joined by "+".
+func LostUnitName(unit []string) string {
+	return strings.Join(unit, lostUnitSep)
+}
+
+// LostUnitValue returns the value a conflict reports for a discarded
+// unit: the field's own value, or one value per member of a coupled unit.
+func LostUnitValue(row map[string]any, unit []string) any {
+	if len(unit) == 1 {
+		return row[unit[0]]
+	}
+	values := make([]any, 0, len(unit))
+	for _, f := range unit {
+		values = append(values, row[f])
+	}
+	return values
+}
+
+// DecodeOplogPayload decodes an insert or update payload into a full row.
+// Document payloads leave out empty values, so every omitted key is
+// restored as the zero value it stands for.
+func DecodeOplogPayload(tableName, payload string) (map[string]any, error) {
+	row := make(map[string]any)
+	if err := json.Unmarshal([]byte(payload), &row); err != nil {
+		return nil, fmt.Errorf("decode %s payload: %w", tableName, err)
+	}
+	if tableName == TableDocuments {
+		for key, zero := range documentPayloadZeroes {
+			if _, ok := row[key]; !ok {
+				row[key] = zero
+			}
+		}
+	}
+	return row, nil
+}
+
+var documentPayloadZeroes = func() map[string]any {
+	kindZeroes := map[reflect.Kind]any{
+		reflect.String: "",
+		reflect.Int64:  float64(0),
+	}
+	zeroes := make(map[string]any)
+	typ := reflect.TypeFor[documentOplogPayload]()
+	for field := range typ.Fields() {
+		name, opts, _ := strings.Cut(field.Tag.Get("json"), ",")
+		if opts != "omitempty" || name == ColDeletedAt {
+			continue
+		}
+		zeroes[name] = kindZeroes[field.Type.Kind()]
+	}
+	return zeroes
+}()
+
+// IsTimeColumn reports whether a column of a syncable table holds a
+// timestamp, so its values compare by instant rather than by text.
+func IsTimeColumn(tableName, column string) bool {
+	return timeColumns[tableName][column]
+}
+
+var syncModels = map[string]reflect.Type{
+	TableAppliances:            reflect.TypeFor[Appliance](),
+	TableDocuments:             reflect.TypeFor[Document](),
+	TableHouseProfiles:         reflect.TypeFor[HouseProfile](),
+	TableIncidents:             reflect.TypeFor[Incident](),
+	TableMaintenanceCategories: reflect.TypeFor[MaintenanceCategory](),
+	TableMaintenanceItems:      reflect.TypeFor[MaintenanceItem](),
+	TableProjectTypes:          reflect.TypeFor[ProjectType](),
+	TableProjects:              reflect.TypeFor[Project](),
+	TableQuotes:                reflect.TypeFor[Quote](),
+	TableServiceLogEntries:     reflect.TypeFor[ServiceLogEntry](),
+	TableVendors:               reflect.TypeFor[Vendor](),
+}
+
+// storedRow reads a row as it is stored right now, deleted or not, encoded
+// like the payload of an update to it, and reports whether it was found.
+func storedRow(tx *gorm.DB, tableName, rowID string) (map[string]any, bool, error) {
+	typ, ok := syncModels[tableName]
+	if !ok {
+		return nil, false, nil
+	}
+	ptr := reflect.New(typ).Interface()
+	err := tx.Unscoped().Where(ColID+" = ?", rowID).Take(ptr).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, false, nil
+	}
+	if err != nil {
+		return nil, false, fmt.Errorf("read %s/%s: %w", tableName, rowID, err)
+	}
