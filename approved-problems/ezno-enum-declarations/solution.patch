diff --git a/checker/src/features/enums.rs b/checker/src/features/enums.rs
new file mode 100644
index 0000000..26985df
--- /dev/null
+++ b/checker/src/features/enums.rs
@@ -0,0 +1,223 @@
+//! Enum declarations. Members are held here rather than only as properties of the value, because
+//! the type of a member is nominal and assignability needs the set of values
+
+use std::collections::HashMap;
+
+use crate::{
+	Constant, TypeId,
+	types::{Type, TypeStore, get_constraint},
+};
+
+/// Declarations of the current check. Not saved with the rest of [`TypeStore`], as definition
+/// files do not carry them
+#[derive(Debug, Default)]
+pub struct EnumRegistry {
+	/// Keyed by the type the declaration introduces
+	pub(crate) declarations: HashMap<TypeId, EnumInfo>,
+	/// Member type to the enum it was declared in
+	pub(crate) members: HashMap<TypeId, TypeId>,
+	/// The object a declaration introduces to the enum it was declared in
+	pub(crate) values: HashMap<TypeId, TypeId>,
+}
+
+impl crate::utilities::serialization::BinarySerializable for EnumRegistry {
+	fn serialize(self, _buf: &mut Vec<u8>) {}
+
+	fn deserialize<I: Iterator<Item = u8>>(_iter: &mut I, _source: source_map::SourceId) -> Self {
+		Self::default()
+	}
+}
+
+/// The value of a member. `Unknown` is for initialisers that are not constant expressions
+#[derive(Clone, Debug, binary_serialize_derive::BinarySerializable)]
+pub enum EnumMemberValue {
+	Number(f64),
+	String(String),
+	Unknown,
+}
+
+impl EnumMemberValue {
+	#[must_use]
+	pub fn as_number(&self) -> Option<f64> {
+		if let Self::Number(value) = self { Some(*value) } else { None }
+	}
+
+	#[must_use]
+	pub fn to_constant(&self) -> Option<Constant> {
+		match self {
+			Self::Number(value) => Some(Constant::Number(*value)),
+			Self::String(value) => Some(Constant::String(value.clone())),
+			Self::Unknown => None,
+		}
+	}
+}
+
+#[derive(Clone, Debug, binary_serialize_derive::BinarySerializable)]
+pub struct EnumMember {
+	pub name: String,
+	/// The nominal type of the member, an alias over the constant
+	pub ty: TypeId,
+	pub value: EnumMemberValue,
+}
+
+#[derive(Clone, Debug, binary_serialize_derive::BinarySerializable)]
+pub struct EnumInfo {
+	pub name: String,
+	/// From `const enum`
+	pub is_constant: bool,
+	pub members: Vec<EnumMember>,
+	/// Where the value is held. The first declaration owns it when several merge
+	pub variable: crate::VariableId,
+}
+
+impl EnumInfo {
+	#[must_use]
+	pub fn get_member(&self, name: &str) -> Option<&EnumMember> {
+		self.members.iter().find(|member| member.name == name)
+	}
+
+	/// For the reverse entries of the value
+	#[must_use]
+	pub fn name_of_value(&self, value: f64) -> Option<&str> {
+		self.members
+			.iter()
+			.find(|member| member.value.as_number().is_some_and(|other| other == value))
+			.map(|member| member.name.as_str())
+	}
+
+	#[must_use]
+	pub fn has_numeric_member(&self) -> bool {
+		self.members.iter().any(|member| matches!(member.value, EnumMemberValue::Number(_)))
+	}
+
+	/// Whether some member has an initialiser that could not be evaluated
+	#[must_use]
+	pub fn has_unknown_member(&self) -> bool {
+		self.members.iter().any(|member| matches!(member.value, EnumMemberValue::Unknown))
+	}
+
+	/// Whether every member has a value. Otherwise the declaration stands for numbers in general
+	#[must_use]
+	pub fn is_literal(&self) -> bool {
+		!self.members.is_empty() && !self.has_unknown_member()
+	}
+
+	/// `NaN` counts as itself here, as it does for [`crate::Constant::equals`]
+	#[allow(clippy::float_cmp)]
+	fn holds_number(&self, value: f64) -> bool {
+		self.members.iter().any(|member| {
+			member
+				.value
+				.as_number()
+				.is_some_and(|held| held == value || (held.is_nan() && value.is_nan()))
+		})
+	}
+}
+
+/// The last member with a value, ignoring ones that failed to evaluate
+#[must_use]
+pub fn next_value(members: &[EnumMember]) -> Option<f64> {
+	match members.last() {
+		None => Some(0f64),
+		Some(member) => member.value.as_number().map(|value| value + 1f64),
+	}
+}
+
+/// Whether `argument` can be assigned to the enum `on`.
+///
+/// Numbers go by value, members of other enums are rejected even when the values line up and
+/// strings are always rejected
+#[must_use]
+pub fn enum_accepts(on: TypeId, info: &EnumInfo, argument: TypeId, types: &TypeStore) -> bool {
+	if argument == TypeId::ERROR_TYPE || argument == TypeId::ANY_TYPE {
+		return true;
+	}
+
+	if let Some(owner) = types.get_owner_of_enum_member(argument) {
+		return owner == on;
+	}
+
+	match types.get_type_by_id(argument) {
+		Type::Constant(Constant::Number(value)) => {
+			!info.is_literal() || info.holds_number(*value)
+		}
+		Type::Constant(_) => false,
+		Type::Or(left, right) => {
+			enum_accepts(on, info, *left, types) && enum_accepts(on, info, *right, types)
+		}
+		Type::AliasTo { to, .. } => enum_accepts(on, info, *to, types),
+		// Narrowing only ever shrinks, so what it came from carries the answer when the narrowed
+		// form does not (`Not<E.A>` is still a member of `E`)
+		Type::Narrowed { from, narrowed_to } => {
+			enum_accepts(on, info, *narrowed_to, types) || enum_accepts(on, info, *from, types)
+		}
+		_ => {
+			if argument == TypeId::NUMBER_TYPE {
+				!info.is_literal() || info.has_numeric_member()
+			} else if let Some(constraint) = get_constraint(argument, types) {
+				enum_accepts(on, info, constraint, types)
+			} else {
+				false
+			}
+		}
+	}
+}
+
+/// Whether `argument` can be assigned to the single member `on` of `info`.
+///
+/// The same rules as the declaration, over the one value the member holds
+#[must_use]
+pub fn member_accepts(on: TypeId, info: &EnumInfo, argument: TypeId, types: &TypeStore) -> bool {
+	if argument == TypeId::ERROR_TYPE || argument == TypeId::ANY_TYPE {
+		return true;
+	}
+
+	if types.get_owner_of_enum_member(argument).is_some() {
+		return argument == on;
+	}
+
+	let Some(member) = info.members.iter().find(|member| member.ty == on) else {
+		return false;
+	};
+
+	match types.get_type_by_id(argument) {
+		Type::Constant(Constant::Number(value)) => member
+			.value
+			.as_number()
+			.is_some_and(|held| held == *value || (held.is_nan() && value.is_nan())),
+		Type::Constant(_) => false,
+		Type::Or(left, right) => {
+			member_accepts(on, info, *left, types) && member_accepts(on, info, *right, types)
+		}
+		Type::AliasTo { to, .. } => member_accepts(on, info, *to, types),
+		Type::Narrowed { from, narrowed_to } => {
+			member_accepts(on, info, *narrowed_to, types)
+				|| member_accepts(on, info, *from, types)
+		}
+		_ => {
+			if argument == TypeId::NUMBER_TYPE {
+				member.value.as_number().is_some()
+			} else if let Some(constraint) = get_constraint(argument, types) {
+				member_accepts(on, info, constraint, types)
+			} else {
+				false
+			}
+		}
+	}
+}
+
+/// The key a numeric member is reachable under on the value
+#[must_use]
+pub fn reverse_key(value: f64) -> String {
+	if value == value.trunc() && value.is_finite() {
+		format!("{}", value as i64)
+	} else {
+		value.to_string()
+	}
+}
+
+/// Whether `on` is the value a `const enum` declaration introduces
+#[must_use]
+pub fn is_const_enum_value(on: TypeId, types: &TypeStore) -> bool {
+	types.get_enum_of_value(on).is_some_and(|(_, info)| info.is_constant)
+}
