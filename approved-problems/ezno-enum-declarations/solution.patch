+/// The reference a property or index access reads from. Only here is a `const enum` allowed, as it
+/// has no value of its own
+pub(super) fn synthesise_access_target<T: crate::ReadFromFS>(
+	expression: &Expression,
+	environment: &mut Environment,
+	checking_data: &mut CheckingData<T, super::EznoParser>,
+) -> TypeId {
+	if let Expression::VariableReference(..) = expression {
+		let existing = std::mem::replace(&mut checking_data.reading_access_target, true);
+		let result = synthesise_expression(expression, environment, checking_data, TypeId::ANY_TYPE);
+		checking_data.reading_access_target = existing;
+		result
+	} else {
+		synthesise_expression(expression, environment, checking_data, TypeId::ANY_TYPE)
+	}
+}
