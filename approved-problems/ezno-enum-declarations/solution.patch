+/// Members are evaluated in order. Each one gets a nominal type over its value, the declaration
+/// gets the union of those and (unless `const`) a value holding them under their name and, for the
+/// numeric ones, under their value
+pub(super) fn synthesise_enum_declaration<T: crate::ReadFromFS>(
+	r#enum: &parser::ast::EnumDeclaration,
+	environment: &mut Environment,
+	checking_data: &mut CheckingData<T, EznoParser>,
+) {
+	use crate::{
+		Constant,
+		features::{
+			enums::{EnumInfo, EnumMember, EnumMemberValue, next_value, reverse_key},
+			objects::ObjectBuilder,
+		},
+		types::{
+			Type,
+			properties::{PropertyKey, PropertyValue, Publicity},
+		},
+	};
+
+	let source = environment.get_source();
+	let Some(on) = environment.get_type_from_name(&r#enum.name) else {
+		return;
+	};
+
+	// A declaration can add to one that came before it. Members carry over for lookups, but the
+	// count starts again, so `declared` marks where this one begins
+	let existing = checking_data.types.get_enum(on).cloned();
+	let variable = existing.as_ref().map_or_else(
+		|| crate::VariableId(source, r#enum.get_position().start),
+		|existing| existing.variable,
+	);
+	if existing.as_ref().is_some_and(|existing| existing.is_constant != r#enum.is_constant) {
+		checking_data.diagnostics_container.add_error(
+			TypeCheckError::EnumDeclarationKindMismatch {
+				position: r#enum.get_position().with_source(source),
+			},
+		);
+	}
+
+	let mut members = existing.map(|existing| existing.members).unwrap_or_default();
+	let declared = members.len();
+
+	for member in &r#enum.members {
+		let position = member.get_position().with_source(source);
+
+		if members.iter().any(|existing| existing.name == member.name) {
+			checking_data.diagnostics_container.add_error(TypeCheckError::DuplicateEnumMember {
+				name: member.name.clone(),
+				position,
+			});
+			continue;
+		}
+
+		let value = match &member.value {
+			parser::ast::EnumMemberValue::ClassMembers(_) => {
+				checking_data.raise_unimplemented_error("class enums", position);
+				EnumMemberValue::Unknown
+			}
+			parser::ast::EnumMemberValue::Value(expression) => {
+				let value = evaluate_enum_member_value(
+					expression,
+					&r#enum.name,
+					&members,
+					environment,
+					&checking_data.types,
+				);
+
+				if value.is_none() && r#enum.is_constant {
+					checking_data.diagnostics_container.add_error(
+						TypeCheckError::ConstEnumMemberIsNotConstant { position },
+					);
+				}
+
+				value.unwrap_or(EnumMemberValue::Unknown)
+			}
+			// Ambient members are only known by their annotation
+			parser::ast::EnumMemberValue::None if r#enum.is_ambient => EnumMemberValue::Unknown,
+			parser::ast::EnumMemberValue::None => match next_value(&members[declared..]) {
+				Some(value) => EnumMemberValue::Number(value),
+				None => {
+					checking_data
+						.diagnostics_container
+						.add_error(TypeCheckError::EnumMemberWithoutInitialiser { position });
+					EnumMemberValue::Unknown
+				}
+			},
+		};
+
+		let to = match value.to_constant() {
+			Some(constant) => checking_data.types.new_constant_type(constant),
+			None => TypeId::NUMBER_TYPE,
+		};
+
+		let ty = checking_data.types.register_type(Type::AliasTo {
+			name: format!("{}.{}", r#enum.name, member.name),
+			parameters: None,
+			to,
+		});
+
+		members.push(EnumMember { name: member.name.clone(), ty, value });
+	}
+
+	let union = checking_data
+		.types
+		.new_or_type_from_iterator(members.iter().map(|member| member.ty).collect::<Vec<_>>());
+
+	checking_data.types.update_alias(on, union);
+
+	let position = r#enum.get_position().with_source(source);
+	let mut basis =
+		ObjectBuilder::new(None, &mut checking_data.types, position, &mut environment.info);
+
+	for member in &members {
+		basis.append(
+			Publicity::Public,
+			PropertyKey::from(member.name.clone()),
+			PropertyValue::Value(member.ty),
+			position,
+			&mut environment.info,
+		);
+	}
+
+	if !r#enum.is_constant {
+		for member in &members {
+			if let Some(value) = member.value.as_number() {
+				let name =
+					checking_data.types.new_constant_type(Constant::String(member.name.clone()));
+
+				basis.append(
+					Publicity::Public,
+					PropertyKey::from(reverse_key(value)),
+					PropertyValue::Value(name),
+					position,
+					&mut environment.info,
+				);
+			}
+		}
+	}
+
+	let object = basis.build_object();
+
+	checking_data.types.register_enum(
+		on,
+		EnumInfo { name: r#enum.name.clone(), is_constant: r#enum.is_constant, members, variable },
+	);
+	checking_data.types.set_enum_value(object, on);
+
+	environment.info.variable_current_value.insert(variable, object);
+}
+
+/// Only constant expressions produce a value. Anything else leaves the member without one, which
+/// stops the members after it from counting up
+fn evaluate_enum_member_value(
+	expression: &parser::Expression,
+	own: &str,
+	members: &[crate::features::enums::EnumMember],
+	environment: &Environment,
+	types: &crate::types::TypeStore,
+) -> Option<crate::features::enums::EnumMemberValue> {
+	use crate::features::enums::EnumMemberValue;
+	use parser::expressions::operators::{BinaryOperator, UnaryOperator};
+
+	match expression {
+		parser::Expression::NumberLiteral(value, ..) => Some(EnumMemberValue::Number(*value)),
+		parser::Expression::StringLiteral(value, ..) => {
+			Some(EnumMemberValue::String(value.clone()))
+		}
+		parser::Expression::Parenthesised(inner, ..) => {
+			evaluate_enum_member_value(&inner.0, own, members, environment, types)
+		}
+		parser::Expression::VariableReference(name, ..) => members
+			.iter()
+			.find(|member| member.name == *name)
+			.map(|member| member.value.clone()),
+		parser::Expression::PropertyAccess { parent, property, .. } => {
+			let parser::Expression::VariableReference(name, ..) = &**parent else {
+				return None;
+			};
+			let parser::PropertyReference::Standard { property, is_private: false } = property
+			else {
+				return None;
+			};
+			// The declaration being evaluated is not registered yet, so its own members are only
+			// in `members`
+			if let Some(member) = members.iter().find(|member| {
+				member.ty != TypeId::ERROR_TYPE && member.name == *property && own == name
+			}) {
+				return Some(member.value.clone());
+			}
+
+			let on = environment.get_type_from_name(name)?;
+			let member = types.get_enum(on)?.get_member(property)?;
+			Some(member.value.clone())
+		}
+		parser::Expression::UnaryOperation { operator, operand, .. } => {
+			let value =
+				evaluate_enum_member_value(operand, own, members, environment, types)?.as_number()?;
+
+			match operator {
+				UnaryOperator::Plus => Some(EnumMemberValue::Number(value)),
+				UnaryOperator::Negation => Some(EnumMemberValue::Number(-value)),
+				UnaryOperator::BitwiseNot => {
+					Some(EnumMemberValue::Number(f64::from(!(value as i32))))
+				}
+				_ => None,
+			}
+		}
+		parser::Expression::BinaryOperation { lhs, operator, rhs, .. } => {
+			let lhs =
+				evaluate_enum_member_value(lhs, own, members, environment, types)?.as_number()?;
+			let rhs =
+				evaluate_enum_member_value(rhs, own, members, environment, types)?.as_number()?;
+
+			let value = match operator {
+				BinaryOperator::Add => lhs + rhs,
+				BinaryOperator::Subtract => lhs - rhs,
+				BinaryOperator::Multiply => lhs * rhs,
+				BinaryOperator::Divide => lhs / rhs,
+				BinaryOperator::Remainder => lhs % rhs,
+				BinaryOperator::Exponent => lhs.powf(rhs),
+				BinaryOperator::BitwiseShiftLeft => {
+					f64::from((lhs as i32).wrapping_shl(rhs as u32))
+				}
+				BinaryOperator::BitwiseShiftRight => {
+					f64::from((lhs as i32).wrapping_shr(rhs as u32))
+				}
+				BinaryOperator::BitwiseShiftRightUnsigned => {
+					f64::from(((lhs as i32) as u32).wrapping_shr(rhs as u32))
+				}
+				BinaryOperator::BitwiseAnd => f64::from((lhs as i32) & (rhs as i32)),
+				BinaryOperator::BitwiseXOr => f64::from((lhs as i32) ^ (rhs as i32)),
+				BinaryOperator::BitwiseOr => f64::from((lhs as i32) | (rhs as i32)),
+				_ => return None,
+			};
+
+			Some(EnumMemberValue::Number(value))
+		}
+		_ => None,
+	}
+}
