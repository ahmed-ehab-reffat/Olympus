+#![cfg(feature = "ezno-parser")]
+
+use ezno_checker::{DiagnosticKind, TypeCheckOptions, check_project, synthesis};
+
+fn check(source: &str) -> Vec<String> {
+	let root = "index.ts";
+	let definition_file = ezno_checker::INTERNAL_DEFINITION_FILE_PATH.into();
+	let result = check_project::<_, synthesis::EznoParser>(
+		vec![root.into()],
+		vec![definition_file],
+		&|_path: &std::path::Path| Some(source.to_owned()),
+		TypeCheckOptions::default(),
+		None,
+	);
+
+	result
+		.diagnostics
+		.into_iter()
+		.filter(|diagnostic| matches!(diagnostic.kind(), DiagnosticKind::Error))
+		.map(|diagnostic| diagnostic.reason().to_owned())
+		.collect()
+}
+
+#[track_caller]
+fn assert_clean(source: &str) {
+	let diagnostics = check(source);
+	assert!(diagnostics.is_empty(), "expected no errors, got {diagnostics:?}");
+}
+
+#[track_caller]
+fn expect_errors(source: &str, expected: &[&str]) {
+	let diagnostics = check(source);
+	assert_eq!(
+		diagnostics.len(),
+		expected.len(),
+		"expected {} errors, got {diagnostics:?}",
+		expected.len()
+	);
+	for (diagnostic, expected) in diagnostics.iter().zip(expected) {
+		assert!(
+			diagnostic.contains(expected),
+			"expected a diagnostic containing {expected:?}, got {diagnostic:?}"
+		);
+	}
+}
+
+fn check_with_module(source: &str, module: &str) -> Vec<String> {
+	let result = check_project::<_, synthesis::EznoParser>(
+		vec!["main.ts".into()],
+		vec![ezno_checker::INTERNAL_DEFINITION_FILE_PATH.into()],
+		&|path: &std::path::Path| {
+			let path = path.to_string_lossy().to_string();
+			if path.ends_with("lib.ts") { Some(module.to_owned()) } else { Some(source.to_owned()) }
+		},
+		TypeCheckOptions::default(),
+		None,
+	);
+
+	result
+		.diagnostics
+		.into_iter()
+		.filter(|diagnostic| matches!(diagnostic.kind(), DiagnosticKind::Error))
+		.map(|diagnostic| diagnostic.reason().to_owned())
+		.collect()
+}
+
+#[track_caller]
+fn expect_errors_from_module(source: &str, module: &str, expected: &[&str]) {
+	let diagnostics = check_with_module(source, module);
+	assert_eq!(
+		diagnostics.len(),
+		expected.len(),
+		"expected {} errors, got {diagnostics:?}",
+		expected.len()
+	);
+	for (diagnostic, expected) in diagnostics.iter().zip(expected) {
+		assert!(
+			diagnostic.contains(expected),
+			"expected a diagnostic containing {expected:?}, got {diagnostic:?}"
+		);
+	}
+}
+
+/// The write is what has to be rejected, so the same source without it must be clean and adding it
+/// must contribute exactly one error. The wording is pinned only for the plain assignment form
+#[track_caller]
+fn expect_write_rejected(source: &str, write: &str) {
+	let before = check(source);
+	assert!(before.is_empty(), "expected the source without the write to be clean, got {before:?}");
+
+	let after = check(&format!("{source}\n{write}"));
+	assert_eq!(after.len(), 1, "expected exactly one error from the write, got {after:?}");
+}
+
+#[track_caller]
+fn expect_errors_in_any_order(source: &str, expected: &[&str]) {
+	let diagnostics = check(source);
+	assert_eq!(
+		diagnostics.len(),
+		expected.len(),
+		"expected {} errors, got {diagnostics:?}",
+		expected.len()
+	);
+
+	let mut remaining = diagnostics.iter().collect::<Vec<_>>();
+	for expected in expected {
+		match remaining.iter().position(|diagnostic| diagnostic.contains(expected)) {
+			Some(at) => {
+				remaining.remove(at);
+			}
+			None => panic!("expected an error containing {expected:?}, got {diagnostics:?}"),
+		}
+	}
+}
