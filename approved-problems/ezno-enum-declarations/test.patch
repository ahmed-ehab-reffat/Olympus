+	);
+}
+
+#[test]
+fn an_imported_declaration_keeps_its_counted_up_values() {
+	expect_errors_from_module(
+		"import { Colour } from \"./lib.ts\"\nconst counted: Colour = 2\nconst bad: Colour = 3",
+		"export enum Colour { Red = 1, Blue }",
+		&["Type 3 is not assignable to type Colour"],
+	);
+}
+
+#[test]
+fn an_imported_member_type_can_be_named() {
+	expect_errors_from_module(
+		"import { Colour } from \"./lib.ts\"\nconst held: Colour.Red = 1\nconst bad: Colour.Red = 2",
+		"export enum Colour { Red = 1, Blue }",
+		&["Type 2 is not assignable to type Colour.Red"],
+	);
+}
+
+#[test]
+fn comparing_a_value_to_a_member_narrows_it() {
+	assert_clean("enum E { A = 1, B = 2 }\ndeclare let e: E;\nif (e === E.A) { e satisfies 1 }");
+}
+
+#[test]
+fn comparing_a_value_to_a_number_narrows_it() {
+	assert_clean("enum E { A = 1, B = 2 }\nE.B satisfies 2\ndeclare let e: E;\nif (e === 2) { e satisfies 2 }");
+}
+
+#[test]
+fn comparing_a_value_to_a_string_member_narrows_it() {
+	assert_clean("enum S { A = \"a\", B = \"b\" }\nS.B satisfies \"b\"\ndeclare let s: S;\nif (s === S.A) { s satisfies \"a\" }");
+}
+
+#[test]
+fn comparing_a_value_to_a_zero_member_narrows_it() {
+	assert_clean("enum E { A = 0, B = 7 }\nE.B satisfies 7\ndeclare let e: E;\nif (e === E.A) { e satisfies 0 }");
+}
+
+#[test]
+fn comparing_a_value_to_a_negative_member_narrows_it() {
+	assert_clean("enum E { A = -1, B = 7 }\nE.B satisfies 7\ndeclare let e: E;\nif (e === E.A) { e satisfies -1 }");
+}
+
+#[test]
+fn comparing_a_value_to_one_of_two_members_sharing_a_value_narrows_it() {
+	assert_clean("enum E { A = 1, B = 1 }\nE[1] satisfies \"B\"\ndeclare let e: E;\nif (e === E.A) { e satisfies 1 }\nif (e === E.B) { e satisfies 1 }");
+}
+
+#[test]
+fn a_narrowed_string_value_stays_assignable_to_its_declaration() {
+	assert_clean("enum S { A = \"a\", B = \"b\" }\nS.B satisfies \"b\"\ndeclare let s: S;\nif (s === S.A) { const held: S = s }");
+}
+
+#[test]
+fn a_narrowed_value_stays_assignable_to_its_declaration() {
+	assert_clean("enum E { A = 1, B = 2 }\nE.B satisfies 2\ndeclare let e: E;\nif (e === E.A) { const same: E = e }");
+}
+
+#[test]
+fn a_value_narrowed_away_from_a_member_stays_assignable_to_its_declaration() {
+	assert_clean("enum E { A = 1, B = 2 }\nE.B satisfies 2\ndeclare let e: E;\nif (e !== E.A) { const other: E = e }");
+}
+
+#[test]
+fn a_value_narrowed_away_from_a_member_is_not_that_member() {
+	expect_errors(
+		"enum E { A = 1, B = 2 }\nE.B satisfies 2\ndeclare let e: E;\nif (e !== E.A) { const same: E.A = e }",
+		&["is not assignable to type E.A"],
+	);
+}
+
+#[test]
+fn declaration_inside_a_block() {
+	assert_clean("{ enum E { A = 1, B }\nE.B satisfies 2\nconst e: E = E.B }");
+}
+
+#[test]
+fn a_declaration_does_not_escape_its_block() {
+	expect_errors(
+		"{ enum E { A = 1, B }\nE.B satisfies 2 }\nE.A",
+		&["Could not find variable 'E' in scope"],
+	);
+}
+
+#[test]
+fn member_holding_a_unicode_string() {
+	assert_clean("enum E { A = \"\\u00e9t\\u00e9\" }\nconst s: string = E.A");
+}
+
+#[test]
+fn member_holding_zero_is_assignable() {
+	assert_clean("enum E { A = 0, B = 9 }\nE.B satisfies 9\nconst e: E = 0");
+}
+
+#[test]
+fn single_member_declaration_rejects_other_numbers() {
+	expect_errors("enum E { A = 1 }\nconst e: E = 0", &["Type 0 is not assignable to type E"]);
+}
