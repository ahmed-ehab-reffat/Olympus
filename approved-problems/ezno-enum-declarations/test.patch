@@ -0,0 +1,99 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="/opt/cargo/bin:/root/.cargo/bin:${PATH}"
+[ -d /opt/cargo ] && export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"
+export CARGO_NET_OFFLINE=true
+
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1 ;;
+  esac
+done
+[ -z "$MODE" ] && { echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1; }
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/report.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+CLASSNAME="cargo-test"
+
+TESTCASES=""
+PASSED=0
+FAILED=0
+STATUS=0
+
+write_junit() {
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="ezno" tests="$((PASSED + FAILED))" failures="${FAILED}" errors="0">
+${TESTCASES}  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+collect() {
+  local line
+  while IFS= read -r line; do
+    if [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ \.\.\.\ ok ]]; then
+      TESTCASES+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\" />"$'\n'
+      PASSED=$((PASSED + 1))
+    elif [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ \.\.\.\ FAILED ]]; then
+      TESTCASES+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\"><failure message=\"test failed\"/></testcase>"$'\n'
+      FAILED=$((FAILED + 1))
+    fi
+  done <<< "$1"
+}
+
+synthesize_failures() {
+  local file="$1" sanitized fn
+  sanitized=$(printf '%s' "$2" | tail -c 3000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/]]>/]] >/g')
+  while IFS= read -r fn; do
+    [ -z "$fn" ] && continue
+    TESTCASES+="    <testcase name=\"${fn}\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+    FAILED=$((FAILED + 1))
+  done < <(awk '/^#\[test\]/{t=1;next} t&&/^fn /{s=$0;sub(/^fn /,"",s);sub(/\(.*/,"",s);print s;t=0}' "$file")
+}
+
+run_suite() {
+  local out
+  out=$(eval "$1" 2>&1)
+  [ $? -ne 0 ] && STATUS=1
+  echo "$out"
+  collect "$out"
+}
+
+run_new_suite() {
+  local before=$((PASSED + FAILED)) out
+  out=$(eval "$1" 2>&1)
+  [ $? -ne 0 ] && STATUS=1
+  echo "$out"
+  collect "$out"
+  if [ $((PASSED + FAILED)) -eq "$before" ]; then
+    synthesize_failures "$2" "$out"
+    STATUS=1
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_suite "cargo test -p ezno-parser"
+    run_suite "cargo test -p ezno-ast-generator"
+    run_suite "cargo test -p ezno-checker --lib --test partial_source --test suggestions --test type_mappings"
+    run_suite "cargo test -p ezno --lib --bins"
+    write_junit
+    exit $STATUS
+    ;;
+  new)
+    run_new_suite "cargo test -p ezno-checker --test enum_declarations_20286b" \
+      "checker/tests/enum_declarations_20286b.rs"
+    write_junit
+    exit $STATUS
+    ;;
+esac
