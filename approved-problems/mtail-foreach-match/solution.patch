+// performed no iterations, mirroring the otherwise construct.
+func (c *codegen) emitElse(n ast.Node, elseNode ast.Node) {
+	if elseNode == nil {
+		return
+	}
+	lAfter := c.newLabel()
+	c.emit(n, code.Otherwise, nil)
+	c.emit(n, code.Jnm, lAfter)
+	ast.Walk(c, elseNode)
+	// The else block only runs when the loop had no iterations, so the foreach
+	// stays unmatched regardless of anything the else block matched.
+	c.emit(n, code.Setmatched, false)
+	c.setLabel(lAfter)
+}
