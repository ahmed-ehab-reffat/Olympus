+// metricValueType returns the value type of a metric symbol type, which is the
+// last argument of a dimensioned metric, or the type itself for a scalar.
+func metricValueType(t types.Type) types.Type {
+	if types.IsDimension(t) {
+		args := t.(*types.Operator).Args
+		return args[len(args)-1]
+	}
+	return t
+}
+
+// isSingleDimension reports whether a metric symbol type has exactly one key
+// dimension, i.e. it is a dimension type of one key plus one value.
+func isSingleDimension(t types.Type) bool {
+	if !types.IsDimension(t) {
+		return false
+	}
+	return len(t.(*types.Operator).Args) == 2
+}
+
+// newLoopvar allocates a loop variable symbol with a unique storage slot so
+// that a name reused in a nested foreach does not alias the outer binding.
+func (c *checker) newLoopvar(name string, typ types.Type, pos *position.Position) *symbol.Symbol {
+	sym := symbol.NewSymbol(name, symbol.LoopvarSymbol, pos)
+	sym.Type = typ
+	sym.Addr = c.loopvarSlots
+	c.loopvarSlots++
+	return sym
+}
