+// ForeachStmt iterates its body once per non-overlapping match of Pattern.
+type ForeachStmt struct {
+	P        position.Position
+	Pattern  Node          // *PatternExpr matched each iteration
+	Haystack Node          // optional `in <expr>` string source; nil means the whole input line
+	Body     Node          // the block executed per match
+	Else     Node          // optional block executed when there were no matches
+	Scope    *symbol.Scope // captures of Pattern live in this scope
+}
+
+func (n *ForeachStmt) Pos() *position.Position {
+	return position.Merge(&n.P, n.Body.Pos())
+}
+
+func (n *ForeachStmt) Type() types.Type {
+	return types.None
+}
+
+// MetricForeachStmt iterates its body once per stored entry of a metric.
+type MetricForeachStmt struct {
+	P          position.Position
+	VarName    string         // loop variable bound to each entry key
+	ValName    string         // optional loop variable bound to each entry value
+	Limit      int64          // if > 0, iterate only the top Limit entries by value
+	MetricName string         // the metric whose entries are iterated
+	VarSymbol  *symbol.Symbol // the key loop variable symbol
+	ValSymbol  *symbol.Symbol // the value loop variable symbol
+	Symbol     *symbol.Symbol // the metric symbol
+	Body       Node
+	Else       Node // optional block executed when the metric has no entries
+	Scope      *symbol.Scope
+}
+
+func (n *MetricForeachStmt) Pos() *position.Position {
+	return position.Merge(&n.P, n.Body.Pos())
+}
+
+func (n *MetricForeachStmt) Type() types.Type {
+	return types.None
+}
+
+// FieldsForeachStmt iterates its body once per field of Source split on Sep.
+type FieldsForeachStmt struct {
+	P         position.Position
+	VarName   string         // loop variable bound to each field
+	Source    Node           // the string expression to split
+	Sep       Node           // *PatternLit separator pattern
+	VarSymbol *symbol.Symbol // the loop variable symbol
+	Body      Node
+	Else      Node // optional block executed when there are no fields
+	Scope     *symbol.Scope
+}
+
+func (n *FieldsForeachStmt) Pos() *position.Position {
+	return position.Merge(&n.P, n.Body.Pos())
+}
+
+func (n *FieldsForeachStmt) Type() types.Type {
+	return types.None
+}
