+func labelsMatchFe7c80(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func runForeachFe7c80(t *testing.T, prog, log string) *metrics.Store {
+	t.Helper()
+	store := metrics.NewStore()
+	lines := make(chan *logline.LogLine, 1)
+	var wg sync.WaitGroup
+	r, err := New(lines, &wg, "", store, ErrorsAbort())
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	if cerr := r.CompileAndRun("test", strings.NewReader(prog)); cerr != nil {
+		t.Fatalf("compile/run failed: %v", cerr)
+	}
+	scanner := bufio.NewScanner(strings.NewReader(log))
+	for scanner.Scan() {
+		lines <- logline.New(context.Background(), "test", scanner.Text())
+	}
+	close(lines)
+	wg.Wait()
+	return store
+}
+
+func metricByNameFe7c80(t *testing.T, store *metrics.Store, name string) *metrics.Metric {
+	t.Helper()
+	var found *metrics.Metric
+	store.Range(func(m *metrics.Metric) error {
+		if m.Name == name {
+			found = m
+		}
+		return nil
+	})
+	if found == nil {
+		t.Fatalf("metric %q not found", name)
+	}
+	return found
+}
+
+func wantIntFe7c80(t *testing.T, store *metrics.Store, name string, labels []string, want int64) {
+	t.Helper()
+	m := metricByNameFe7c80(t, store, name)
+	for _, lv := range m.LabelValues {
+		if labelsMatchFe7c80(lv.Labels, labels) {
+			if got := datum.GetInt(lv.Value); got != want {
+				t.Errorf("%s%v = %d, want %d", name, labels, got, want)
+			}
+			return
+		}
+	}
+	if want != 0 {
+		t.Errorf("%s%v not present, want %d", name, labels, want)
+	}
+}
+
+func wantStringFe7c80(t *testing.T, store *metrics.Store, name string, labels []string, want string) {
+	t.Helper()
+	m := metricByNameFe7c80(t, store, name)
+	for _, lv := range m.LabelValues {
+		if labelsMatchFe7c80(lv.Labels, labels) {
+			if got := datum.GetString(lv.Value); got != want {
+				t.Errorf("%s%v = %q, want %q", name, labels, got, want)
+			}
+			return
+		}
+	}
+	t.Errorf("%s%v not present, want %q", name, labels, want)
+}
+
+func wantFloatFe7c80(t *testing.T, store *metrics.Store, name string, labels []string, want float64) {
+	t.Helper()
+	m := metricByNameFe7c80(t, store, name)
+	for _, lv := range m.LabelValues {
+		if labelsMatchFe7c80(lv.Labels, labels) {
+			if got := datum.GetFloat(lv.Value); got != want {
+				t.Errorf("%s%v = %g, want %g", name, labels, got, want)
+			}
+			return
+		}
+	}
+	t.Errorf("%s%v not present, want %g", name, labels, want)
+}
+
+func noneFe7c80() []string { return []string{} }
+
+func compileErrFe7c80(t *testing.T, prog string) error {
+	t.Helper()
+	store := metrics.NewStore()
+	lines := make(chan *logline.LogLine, 1)
+	var wg sync.WaitGroup
+	r, err := New(lines, &wg, "", store, ErrorsAbort())
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	cerr := r.CompileAndRun("p", strings.NewReader(prog))
+	close(lines)
+	wg.Wait()
+	return cerr
+}
