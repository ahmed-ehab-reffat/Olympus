diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..19037a1d
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+
+export GOFLAGS=-buildvcs=false
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+mkdir -p "$GOCACHE"
+
+FOREACH='^(TestForeach|TestMatchindex|TestMatchcount|TestNestedForeach|TestMetricForeach|TestFieldsForeach)'
+EXISTING='^(TestCompileAndRun|TestLoadProg|TestNewRuntime|TestNewRuntimeErrors|TestRuntimeEndToEnd)$'
+
+run_new() {
+  go test ./internal/runtime/ -run "$FOREACH" -v -count=1
+}
+
+run_base() {
+  local rc=0
+  local subpkgs
+  subpkgs=$(go list ./internal/runtime/... | grep -v '/internal/runtime$')
+  go test $subpkgs -v -count=1 || rc=1
+  go test ./internal/runtime/ -run "$EXISTING" -v -count=1 || rc=1
+  return $rc
+}
+
+if [ "$MODE" = "new" ]; then
+  RUN=run_new
+else
+  RUN=run_base
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  "$RUN" 2>&1 | go-junit-report -set-exit-code > "$OUTPUT_PATH"
+  exit ${PIPESTATUS[0]}
+fi
+"$RUN"
