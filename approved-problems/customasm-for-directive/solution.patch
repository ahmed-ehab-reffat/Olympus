diff --git a/src/asm/resolver/directive_for.rs b/src/asm/resolver/directive_for.rs
new file mode 100644
index 0000000..3b67be8
--- /dev/null
+++ b/src/asm/resolver/directive_for.rs
@@ -0,0 +1,593 @@
+use crate::*;
+
+
+pub fn resolve_fors(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    fileserver: &mut dyn util::FileServer,
+    ast: &mut asm::AstTopLevel,
+    decls: &asm::ItemDecls,
+    defs: &asm::ItemDefs,
+    scope_counter: &mut usize,
+    use_addresses: bool)
+    -> Result<usize, ()>
+{
+    let mut resolved_count = 0;
+
+    let zero = util::BigInt::new(0, None);
+    let one = util::BigInt::new(1, None);
+
+
+    for n in (0..ast.nodes.len()).rev()
+    {
+        let asm::AstAny::DirectiveFor(node) = &ast.nodes[n]
+            else { continue };
+
+        let start = match eval_bound(report, opts, decls, defs, &node.start_expr, use_addresses)?
+        {
+            Some(value) => value,
+            None => continue,
+        };
+
+        let end = match eval_bound(report, opts, decls, defs, &node.end_expr, use_addresses)?
+        {
+            Some(value) => value,
+            None => continue,
+        };
+
+        let step = match &node.step_expr
+        {
+            None => one.clone(),
+            Some(step_expr) =>
+            {
+                match eval_bound(report, opts, decls, defs, step_expr, use_addresses)?
+                {
+                    Some(value) => value,
+                    None => continue,
+                }
+            }
+        };
+
+        if step == zero
+        {
+            report.error_span(
+                "`#for` step must be nonzero",
+                node.header_span);
+
+            return Err(());
+        }
+
+        if opts.debug_iterations
+        {
+            println!("  #for: {} in {}, {}, {}",
+                fileserver.get_excerpt(node.var_span),
+                start.as_string(),
+                end.as_string(),
+                step.as_string());
+        }
+
+        let asm::AstAny::DirectiveFor(node) = ast.nodes.remove(n)
+            else { unreachable!() };
+
+        let mut expansion = Vec::new();
+
+        let mut cur = start;
+        while (step > zero && cur < end) || (step < zero && cur > end)
+        {
+            expansion.push(asm::AstAny::Symbol(asm::parser::AstSymbol {
+                decl_span: node.header_span,
+                hierarchy_level: 0,
+                name: format!("#for_scope_{}", scope_counter),
+                kind: asm::parser::AstSymbolKind::Label,
+                no_emit: true,
+                item_ref: None,
+            }));
+
+            *scope_counter += 1;
+
+            for body_node in &node.body.nodes
+            {
+                expansion.push(substitute_in_node(
+                    body_node,
+                    &node.var_name,
+                    &cur));
+            }
+
+            cur = cur.checked_add(report, node.header_span, &step)?;
+        }
+
+        ast.nodes.splice(n..n, expansion);
+
+        resolved_count += 1;
+    }
+
+    Ok(resolved_count)
+}
+
+
+fn eval_bound(
+    report: &mut diagn::Report,
+    opts: &asm::AssemblyOptions,
+    decls: &asm::ItemDecls,
+    defs: &asm::ItemDefs,
+    expr: &expr::Expr,
+    use_addresses: bool)
+    -> Result<Option<util::BigInt>, ()>
+{
+    if use_addresses
+    {
+        let mut probe = diagn::Report::new();
+
+        let value = asm::resolver::eval_certain(
+            &mut probe,
+            opts,
+            decls,
+            defs,
+            expr);
+
+        return match value
+        {
+            Ok(expr::Value::Integer(_, bigint)) => Ok(Some(bigint)),
+            _ => Ok(None),
+        };
+    }
+
+    let value = asm::resolver::eval_simple(
+        report,
+        opts,
+        decls,
+        defs,
+        expr)?;
+
+    match value
+    {
+        expr::Value::Integer(_, bigint) => Ok(Some(bigint)),
+        _ => Ok(None),
+    }
+}
+
+
+pub fn count_leftover_fors(ast: &asm::AstTopLevel) -> usize
+{
+    let mut count = 0;
+
+    for node in &ast.nodes
+    {
+        match node
+        {
+            asm::AstAny::DirectiveFor(..) => count += 1,
+
+            asm::AstAny::DirectiveIf(node) =>
+            {
+                count += count_leftover_fors(&node.true_arm);
+
+                if let Some(false_arm) = &node.false_arm
+                {
+                    count += count_leftover_fors(false_arm);
+                }
+            }
+
+            _ => {}
+        }
+    }
+
+    count
+}
+
+
+pub fn reset_item_refs(ast: &mut asm::AstTopLevel)
+{
+    for node in &mut ast.nodes
+    {
+        match node
+        {
+            asm::AstAny::Symbol(n) => n.item_ref = None,
+            asm::AstAny::Instruction(n) => n.item_ref = None,
+            asm::AstAny::DirectiveData(n) => n.item_refs = Vec::new(),
+            asm::AstAny::DirectiveRes(n) => n.item_ref = None,
+            asm::AstAny::DirectiveAddr(n) => n.item_ref = None,
+            asm::AstAny::DirectiveAlign(n) => n.item_ref = None,
+            asm::AstAny::DirectiveFn(n) => n.item_ref = None,
+            asm::AstAny::DirectiveRuledef(n) => n.item_ref = None,
+            asm::AstAny::DirectiveBank(n) => n.item_ref = None,
+            asm::AstAny::DirectiveBankdef(n) => n.item_ref = None,
+
+            asm::AstAny::DirectiveIf(n) =>
+            {
+                reset_item_refs(&mut n.true_arm);
+
+                if let Some(false_arm) = &mut n.false_arm
+                {
+                    reset_item_refs(false_arm);
+                }
+            }
+
+            asm::AstAny::DirectiveFor(n) => reset_item_refs(&mut n.body),
+
+            _ => {}
+        }
+    }
+}
+
+
+pub fn check_leftover_fors(
+    report: &mut diagn::Report,
+    ast: &asm::AstTopLevel)
+    -> Result<(), ()>
+{
+    for node in &ast.nodes
+    {
+        match node
+        {
+            asm::AstAny::DirectiveFor(node) =>
+            {
+                report.error_span(
+                    "unresolved `#for` range; bounds must resolve to integer values",
+                    node.header_span);
+
+                return Err(());
+            }
+
+            asm::AstAny::DirectiveIf(node) =>
+            {
+                check_leftover_fors(report, &node.true_arm)?;
+
+                if let Some(false_arm) = &node.false_arm
+                {
+                    check_leftover_fors(report, false_arm)?;
+                }
+            }
+
+            _ => {}
+        }
+    }
+
+    Ok(())
+}
+
+
+fn substitute_in_node(
+    node: &asm::AstAny,
+    name: &str,
+    value: &util::BigInt)
+    -> asm::AstAny
+{
+    match node
+    {
+        asm::AstAny::Instruction(instr) =>
+            asm::AstAny::Instruction(
+                substitute_in_instruction(instr, name, value)),
+
+        asm::AstAny::Symbol(sym) =>
+            asm::AstAny::Symbol(substitute_in_symbol(sym, name, value)),
+
+        asm::AstAny::DirectiveData(d) =>
+            asm::AstAny::DirectiveData(asm::parser::AstDirectiveData {
+                elems: d.elems.iter()
+                    .map(|e| substitute_in_expr(e, name, value))
+                    .collect(),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveRes(d) =>
+            asm::AstAny::DirectiveRes(asm::parser::AstDirectiveRes {
+                expr: substitute_in_expr(&d.expr, name, value),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveAddr(d) =>
+            asm::AstAny::DirectiveAddr(asm::parser::AstDirectiveAddr {
+                expr: substitute_in_expr(&d.expr, name, value),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveAlign(d) =>
+            asm::AstAny::DirectiveAlign(asm::parser::AstDirectiveAlign {
+                expr: substitute_in_expr(&d.expr, name, value),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveBits(d) =>
+            asm::AstAny::DirectiveBits(asm::parser::AstDirectiveBits {
+                expr: substitute_in_expr(&d.expr, name, value),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveAssert(d) =>
+            asm::AstAny::DirectiveAssert(asm::parser::AstDirectiveAssert {
+                condition_expr: substitute_in_expr(&d.condition_expr, name, value),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveIf(d) =>
+            asm::AstAny::DirectiveIf(asm::parser::AstDirectiveIf {
+                condition_expr: substitute_in_expr(&d.condition_expr, name, value),
+                true_arm: substitute_in_block(&d.true_arm, name, value),
+                false_arm: d.false_arm.as_ref()
+                    .map(|arm| substitute_in_block(arm, name, value)),
+                ..d.clone()
+            }),
+
+        asm::AstAny::DirectiveFor(d) =>
+        {
+            let body = if d.var_name == name
+            {
+                d.body.clone()
+            }
+            else
+            {
+                substitute_in_block(&d.body, name, value)
+            };
+
+            asm::AstAny::DirectiveFor(asm::parser::AstDirectiveFor {
+                start_expr: substitute_in_expr(&d.start_expr, name, value),
+                end_expr: substitute_in_expr(&d.end_expr, name, value),
+                step_expr: d.step_expr.as_ref()
+                    .map(|e| substitute_in_expr(e, name, value)),
+                body,
+                ..d.clone()
+            })
+        }
+
+        asm::AstAny::DirectiveFn(d) =>
+        {
+            let body = if d.params.iter().any(|p| p.name == name)
+            {
+                d.body.clone()
+            }
+            else
+            {
+                substitute_in_expr(&d.body, name, value)
+            };
+
+            asm::AstAny::DirectiveFn(asm::parser::AstDirectiveFn {
+                body,
+                item_ref: None,
+                ..d.clone()
+            })
+        }
+
+        asm::AstAny::DirectiveRuledef(d) =>
+        {
+            let rules = d.rules.iter()
+                .map(|rule| substitute_in_rule(rule, name, value))
+                .collect();
+
+            asm::AstAny::DirectiveRuledef(asm::parser::AstDirectiveRuledef {
+                rules,
+                item_ref: None,
+                ..d.clone()
+            })
+        }
+
+        asm::AstAny::DirectiveBankdef(d) =>
+        {
+            let subst = |e: &Option<expr::Expr>|
+                e.as_ref().map(|e| substitute_in_expr(e, name, value));
+
+            asm::AstAny::DirectiveBankdef(asm::parser::AstDirectiveBankdef {
+                addr_unit: subst(&d.addr_unit),
+                label_align: subst(&d.label_align),
+                addr_start: subst(&d.addr_start),
+                addr_end: subst(&d.addr_end),
+                addr_size: subst(&d.addr_size),
+                output_offset: subst(&d.output_offset),
+                userdata: subst(&d.userdata),
+                item_ref: None,
+                ..d.clone()
+            })
+        }
+
+        other => other.clone(),
+    }
+}
+
+
+fn substitute_in_rule(
+    rule: &asm::parser::AstRule,
+    name: &str,
+    value: &util::BigInt)
+    -> asm::parser::AstRule
+{
+    let shadowed = rule.pattern.iter().any(|part| {
+        matches!(
+            part,
+            asm::parser::AstRulePatternPart::Parameter(param)
+                if param.name == name)
+    });
+
+    let expr = if shadowed
+    {
+        rule.expr.clone()
+    }
+    else
+    {
+        substitute_in_expr(&rule.expr, name, value)
+    };
+
+    asm::parser::AstRule {
+        expr,
+        ..rule.clone()
+    }
+}
+
+
+fn substitute_in_symbol(
+    sym: &asm::parser::AstSymbol,
+    name: &str,
+    value: &util::BigInt)
+    -> asm::parser::AstSymbol
+{
+    let kind = match &sym.kind
+    {
+        asm::parser::AstSymbolKind::Constant(constant) =>
+            asm::parser::AstSymbolKind::Constant(asm::parser::AstSymbolConstant {
+                expr: substitute_in_expr(&constant.expr, name, value),
+            }),
+
+        asm::parser::AstSymbolKind::Label =>
+            asm::parser::AstSymbolKind::Label,
+    };
+
+    asm::parser::AstSymbol {
+        kind,
+        item_ref: None,
+        ..sym.clone()
+    }
+}
+
+
+fn substitute_in_instruction(
+    instr: &asm::parser::AstInstruction,
+    name: &str,
+    value: &util::BigInt)
+    -> asm::parser::AstInstruction
+{
+    let mut walker = syntax::Walker::new(&instr.src, instr.span.file_handle, 0);
+
+    let mut ranges = Vec::new();
+
+    while !walker.is_over()
+    {
+        let token = walker.next_token();
+        let before = walker.get_cursor_index();
+
+        if token.kind == syntax::TokenKind::Identifier &&
+            walker.get_span_excerpt(token.span) == name
+        {
+            ranges.push(token.span.location().unwrap());
+        }
+
+        walker.advance_to_token_end(&token);
+
+        if walker.get_cursor_index() <= before
+        {
+            break;
+        }
+    }
+
+    let value_str = value.to_str_radix(10);
+    let mut src = instr.src.clone();
+
+    for (start, end) in ranges.into_iter().rev()
+    {
+        src.replace_range(start..end, &value_str);
+    }
+
+    asm::parser::AstInstruction {
+        span: instr.span,
+        src,
+        item_ref: None,
+    }
+}
+
+
+fn substitute_in_block(
+    block: &asm::AstTopLevel,
+    name: &str,
+    value: &util::BigInt)
+    -> asm::AstTopLevel
+{
+    asm::AstTopLevel {
+        nodes: block.nodes.iter()
+            .map(|node| substitute_in_node(node, name, value))
+            .collect(),
+    }
+}
+
+
+fn substitute_in_expr(
+    e: &expr::Expr,
+    name: &str,
+    value: &util::BigInt)
+    -> expr::Expr
+{
+    match e
+    {
+        expr::Expr::Variable(span, n) if n == name =>
+            expr::Expr::Literal(
+                *span,
+                expr::Value::make_integer(value.clone()).statically_known()),
+
+        expr::Expr::Literal(..) |
+        expr::Expr::Variable(..) |
+        expr::Expr::NestingLevel { .. } =>
+            e.clone(),
+
+        expr::Expr::StructInit { span, members_init } =>
+            expr::Expr::StructInit {
+                span: *span,
+                members_init: members_init.iter()
+                    .map(|m| expr::ExprStructMemberInit {
+                        span: m.span,
+                        name: m.name.clone(),
+                        value: substitute_in_expr(&m.value, name, value),
+                    })
+                    .collect(),
+            },
+
+        expr::Expr::MemberAccess { span, lhs, member_name } =>
+            expr::Expr::MemberAccess {
+                span: *span,
+                lhs: Box::new(substitute_in_expr(lhs, name, value)),
+                member_name: member_name.clone(),
+            },
+
+        expr::Expr::UnaryOp(s1, s2, op, inner) =>
+            expr::Expr::UnaryOp(
+                *s1,
+                *s2,
+                *op,
+                Box::new(substitute_in_expr(inner, name, value))),
+
+        expr::Expr::BinaryOp(s1, s2, op, lhs, rhs) =>
+            expr::Expr::BinaryOp(
+                *s1,
+                *s2,
+                *op,
+                Box::new(substitute_in_expr(lhs, name, value)),
+                Box::new(substitute_in_expr(rhs, name, value))),
+
+        expr::Expr::TernaryOp(span, cond, t, f) =>
+            expr::Expr::TernaryOp(
+                *span,
+                Box::new(substitute_in_expr(cond, name, value)),
+                Box::new(substitute_in_expr(t, name, value)),
+                Box::new(substitute_in_expr(f, name, value))),
+
+        expr::Expr::Slice(s1, s2, inner, lo, hi) =>
+            expr::Expr::Slice(
+                *s1,
+                *s2,
+                Box::new(substitute_in_expr(inner, name, value)),
+                Box::new(substitute_in_expr(lo, name, value)),
+                Box::new(substitute_in_expr(hi, name, value))),
+
+        expr::Expr::SliceShort(s1, s2, inner, idx) =>
+            expr::Expr::SliceShort(
+                *s1,
+                *s2,
+                Box::new(substitute_in_expr(inner, name, value)),
+                Box::new(substitute_in_expr(idx, name, value))),
+
+        expr::Expr::Block(span, exprs) =>
+            expr::Expr::Block(
+                *span,
+                exprs.iter()
+                    .map(|x| substitute_in_expr(x, name, value))
+                    .collect()),
+
+        expr::Expr::Call(span, func, args) =>
+            expr::Expr::Call(
+                *span,
+                Box::new(substitute_in_expr(func, name, value)),
+                args.iter()
+                    .map(|a| substitute_in_expr(a, name, value))
+                    .collect()),
+
+        expr::Expr::Asm(span, block) =>
+            expr::Expr::Asm(
+                *span,
+                substitute_in_block(block, name, value)),
+    }
+}
