diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..f08004f
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+        base|new) MODE="$1"; shift ;;
+        *) shift ;;
+    esac
+done
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+xml_escape() {
+    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+write_junit() {
+    local tests="$1" failures="$2" body="$3"
+    cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="gitql-json" tests="${tests}" failures="${failures}" errors="0">
+${body}  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+build_binary() {
+    cargo build -q 2>/tmp/build.log
+}
+
+strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }
+
+run_query() {
+    ./target/debug/gitql -r "$TESTREPO" -q "SELECT $1 AS v" -o csv </dev/null 2>/dev/null \
+        | strip_ansi \
+        | awk 'p{print;exit} /^v,?$/{p=1}' \
+        | sed 's/^"//;s/"$//;s/""/"/g'
+}
+
+if [ "$MODE" = "new" ]; then
+    if ! build_binary; then
+        msg=$(tail -c 3000 /tmp/build.log | xml_escape)
+        write_junit 1 1 "    <testcase name=\"build\" classname=\"gitql-json\"><failure message=\"build failed\"><![CDATA[${msg}]]></failure></testcase>"$'\n'
+        exit 1
+    fi
+    TESTREPO="$(mktemp -d)"
+    git -C "$TESTREPO" init -q
+    git -C "$TESTREPO" -c user.email=t@t -c user.name=t commit --allow-empty -q -m init
+
+    passed=0; failed=0; body=""
+    while IFS=$'\t' read -r name query expected <&3; do
+        [ -z "$name" ] && continue
+        got="$(run_query "$query")"
+        if [ "$got" = "$expected" ]; then
+            body+="    <testcase name=\"${name}\" classname=\"gitql-json\" />"$'\n'
+            passed=$((passed + 1))
+        else
+            emsg=$(printf 'query: %s\nexpected: %s\ngot: %s' "$query" "$expected" "$got" | xml_escape)
+            body+="    <testcase name=\"${name}\" classname=\"gitql-json\"><failure message=\"mismatch\"><![CDATA[${emsg}]]></failure></testcase>"$'\n'
+            failed=$((failed + 1))
+        fi
+    done 3< tests/json_functions_cases.tsv
+    write_junit $((passed + failed)) "$failed" "$body"
+    [ "$failed" -gt 0 ] && exit 1
+    exit 0
+fi
+
+# base mode: run the repository's existing test suite for regressions.
+test_output=$(cargo test --workspace 2>&1)
+cargo_status=$?
+passed=0; failed=0; body=""
+while IFS= read -r line; do
+    if [[ "$line" =~ ^test\ ([^\ ]+)\ \.\.\.\ ok ]]; then
+        body+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"gitql-base\" />"$'\n'
+        passed=$((passed + 1))
+    elif [[ "$line" =~ ^test\ ([^\ ]+)\ \.\.\.\ FAILED ]]; then
+        body+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"gitql-base\"><failure message=\"test failed\"/></testcase>"$'\n'
+        failed=$((failed + 1))
+    fi
+done <<< "$test_output"
+# A nonzero cargo exit (compile error, doctest failure, or runner error) must
+# fail the run even when no `test ... FAILED` line was printed.
+if [ "$cargo_status" -ne 0 ]; then
+    msg=$(printf '%s' "$test_output" | tail -c 3000 | xml_escape)
+    body+="    <testcase name=\"workspace_regression\" classname=\"gitql-base\"><failure message=\"cargo test exited ${cargo_status}\"><![CDATA[${msg}]]></failure></testcase>"$'\n'
+    failed=$((failed + 1))
+elif [ $((passed + failed)) -eq 0 ]; then
+    body="    <testcase name=\"workspace_tests\" classname=\"gitql-base\" />"$'\n'
+    passed=1
+fi
+write_junit $((passed + failed)) "$failed" "$body"
+[ "$failed" -gt 0 ] && exit 1
+exit 0
