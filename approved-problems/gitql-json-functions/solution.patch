+/// The `->` and `->>` JSON access operators. `as_text` selects `->>`, which
+/// returns the referenced value as a typed value; `->` returns it as JSON text.
+#[derive(Clone)]
+pub struct JsonAccessExpr {
+    pub left: Box<dyn Expr>,
+    pub right: Box<dyn Expr>,
+    pub as_text: bool,
+}
+
+impl Expr for JsonAccessExpr {
+    fn kind(&self) -> ExprKind {
+        ExprKind::JsonAccess
+    }
+
+    fn expr_type(&self) -> Box<dyn DataType> {
+        // `->` always yields JSON text; `->>` yields the referenced value as its
+        // own type. Exposing that as a variant of the concrete scalar types (plus
+        // JSON text for containers) lets it compose in arithmetic and comparisons
+        // on either side rather than as an inert `Any`.
+        if self.as_text {
+            Box::new(VariantType::new(vec![
+                Box::new(IntType),
+                Box::new(FloatType),
+                Box::new(TextType),
+                Box::new(BoolType),
+            ]))
+        } else {
+            Box::new(TextType)
+        }
+    }
+
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
