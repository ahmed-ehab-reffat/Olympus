+    /// The result type of an operator: every member that can perform it with
+    /// `other` contributes its own result, so the possibilities are preserved as
+    /// a variant rather than collapsed to the first match.
+    #[allow(clippy::borrowed_box)]
+    fn delegated_result(
+        &self,
+        other: &Box<dyn DataType>,
+        capability: CapabilityFunction,
+        result: ResultFunction,
+    ) -> Box<dyn DataType> {
+        let mut results: Vec<Box<dyn DataType>> = Vec::new();
+        for variant in self.variants.iter() {
+            if capability(variant).iter().any(|t| t.equals(other)) {
+                results.push(result(variant, other));
+            }
+        }
