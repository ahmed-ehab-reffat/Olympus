+/// A single component of a JSON path expression.
+enum PathSegment {
+    Key(String),
+    Index(usize),
+    /// `#-N`, the element N places from the end (`#-0` is the past-the-end index).
+    FromEnd(usize),
+    /// `#`, the literal past-the-last-element position; the only appending target.
+    Append,
+}
+
+/// Resolves a `FromEnd` offset against a known array length. Returns `None`
+/// when the offset points past the front of the array.
+fn end_index(offset: usize, len: usize) -> Option<usize> {
+    len.checked_sub(offset)
+}
+
+fn null() -> Box<dyn Value> {
+    Box::new(NullValue)
+}
+
+fn text(value: String) -> Box<dyn Value> {
+    Box::new(TextValue::new(value))
+}
+
+/// Parses a SQLite-style JSON path (`$`, `$.key`, `$."quoted key"`, `$[0]`,
+/// and chains such as `$.a[1].b`). Returns `None` for malformed paths.
+fn parse_path(path: &str) -> Option<Vec<PathSegment>> {
+    let bytes = path.as_bytes();
+    if bytes.first() != Some(&b'$') {
+        return None;
+    }
+    let mut segments = Vec::new();
+    let mut i = 1;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'.' => {
+                i += 1;
+                if i < bytes.len() && bytes[i] == b'"' {
+                    i += 1;
+                    let start = i;
+                    while i < bytes.len() && bytes[i] != b'"' {
+                        i += 1;
+                    }
+                    if i >= bytes.len() {
+                        return None;
+                    }
+                    segments.push(PathSegment::Key(path[start..i].to_string()));
+                    i += 1;
+                } else {
+                    let start = i;
+                    while i < bytes.len() && bytes[i] != b'.' && bytes[i] != b'[' {
+                        i += 1;
+                    }
+                    if start == i {
+                        return None;
+                    }
+                    segments.push(PathSegment::Key(path[start..i].to_string()));
+                }
+            }
+            b'[' => {
+                i += 1;
+                let start = i;
+                while i < bytes.len() && bytes[i] != b']' {
+                    i += 1;
+                }
+                if i >= bytes.len() {
+                    return None;
+                }
+                let inner = &path[start..i];
+                if let Some(rest) = inner.strip_prefix('#') {
+                    if rest.is_empty() {
+                        segments.push(PathSegment::Append);
+                    } else {
+                        let offset = rest.strip_prefix('-')?.parse::<usize>().ok()?;
+                        segments.push(PathSegment::FromEnd(offset));
+                    }
+                } else {
+                    segments.push(PathSegment::Index(inner.parse::<usize>().ok()?));
+                }
+                i += 1;
+            }
+            _ => return None,
+        }
+    }
+    Some(segments)
+}
+
+/// Follows `path` through `root`, returning the referenced value if present.
+fn resolve<'a>(root: &'a Json, path: &[PathSegment]) -> Option<&'a Json> {
+    let mut current = root;
+    for segment in path {
+        current = match (segment, current) {
+            (PathSegment::Key(key), Json::Object(map)) => map.get(key)?,
+            (PathSegment::Index(index), Json::Array(items)) => items.get(*index)?,
+            (PathSegment::FromEnd(offset), Json::Array(items)) => {
+                items.get(end_index(*offset, items.len())?)?
+            }
+            _ => return None,
+        };
+    }
+    Some(current)
+}
+
+/// A single component of an extended path query (`json_query`). Unlike the
+/// single-target segments, a step here can expand one node into many.
+enum QueryStep {
+    Key(String),
+    Index(usize),
+    /// `.*`: every object member value and every array element.
+    Wildcard,
+    /// `[*]`: every array element.
+    ArrayWildcard,
+    /// `..key`: every member named `key` at any depth; `..*` (None) every value.
+    Descend(Option<String>),
+}
+
+/// Parses an extended query pattern for `json_query`. Accepts the object/array
+/// steps a single-target path does (but not the `#` forms), plus `.*`, `[*]`,
+/// `..key` and `..*`. Returns `None` for a malformed pattern.
+fn parse_query(pattern: &str) -> Option<Vec<QueryStep>> {
+    let bytes = pattern.as_bytes();
+    if bytes.first() != Some(&b'$') {
+        return None;
+    }
+    let mut steps = Vec::new();
+    let mut i = 1;
+    while i < bytes.len() {
+        match bytes[i] {
+            b'.' => {
+                i += 1;
+                if i < bytes.len() && bytes[i] == b'.' {
+                    i += 1;
+                    if i < bytes.len() && bytes[i] == b'*' {
+                        steps.push(QueryStep::Descend(None));
+                        i += 1;
+                    } else {
+                        let (key, next) = read_query_key(pattern, i)?;
+                        steps.push(QueryStep::Descend(Some(key)));
+                        i = next;
+                    }
+                } else if i < bytes.len() && bytes[i] == b'*' {
+                    steps.push(QueryStep::Wildcard);
+                    i += 1;
+                } else {
+                    let (key, next) = read_query_key(pattern, i)?;
+                    steps.push(QueryStep::Key(key));
+                    i = next;
+                }
+            }
+            b'[' => {
+                i += 1;
+                let start = i;
+                while i < bytes.len() && bytes[i] != b']' {
+                    i += 1;
+                }
+                if i >= bytes.len() {
+                    return None;
+                }
+                let inner = &pattern[start..i];
+                if inner == "*" {
+                    steps.push(QueryStep::ArrayWildcard);
+                } else {
+                    steps.push(QueryStep::Index(inner.parse::<usize>().ok()?));
+                }
+                i += 1;
+            }
+            _ => return None,
+        }
+    }
+    Some(steps)
+}
+
+/// Reads a bare or `"quoted"` key at `start`, returning it and the next index.
+/// Returns `None` for an empty key or an unterminated quote.
+fn read_query_key(pattern: &str, start: usize) -> Option<(String, usize)> {
+    let bytes = pattern.as_bytes();
+    if bytes.get(start) == Some(&b'"') {
+        let mut i = start + 1;
+        while i < bytes.len() && bytes[i] != b'"' {
+            i += 1;
+        }
+        if i >= bytes.len() {
+            return None;
+        }
+        return Some((pattern[start + 1..i].to_string(), i + 1));
+    }
+    let mut i = start;
+    while i < bytes.len() && bytes[i] != b'.' && bytes[i] != b'[' {
+        i += 1;
+    }
+    if i == start {
+        return None;
+    }
+    Some((pattern[start..i].to_string(), i))
+}
+
+/// Collects descendants of `node` in document pre-order. With `key` set only
+/// members of that name are collected; otherwise every nested value is.
+fn descend<'a>(node: &'a Json, key: Option<&str>, out: &mut Vec<&'a Json>) {
+    match node {
+        Json::Object(map) => {
+            for (member, child) in map {
+                if key.is_none_or(|k| k == member) {
+                    out.push(child);
+                }
+                descend(child, key, out);
+            }
+        }
+        Json::Array(items) => {
+            for child in items {
+                if key.is_none() {
+                    out.push(child);
+                }
+                descend(child, key, out);
+            }
+        }
+        _ => {}
+    }
+}
+
+/// Applies one query step to a node, appending each produced match to `out`.
+fn apply_step<'a>(node: &'a Json, step: &QueryStep, out: &mut Vec<&'a Json>) {
+    match (step, node) {
+        (QueryStep::Key(key), Json::Object(map)) => {
+            if let Some(child) = map.get(key) {
+                out.push(child);
+            }
+        }
+        (QueryStep::Index(index), Json::Array(items)) => {
+            if let Some(child) = items.get(*index) {
+                out.push(child);
+            }
+        }
+        (QueryStep::Wildcard, Json::Object(map)) => out.extend(map.values()),
+        (QueryStep::Wildcard, Json::Array(items)) => out.extend(items.iter()),
+        (QueryStep::ArrayWildcard, Json::Array(items)) => out.extend(items.iter()),
+        (QueryStep::Descend(key), _) => descend(node, key.as_deref(), out),
+        _ => {}
+    }
+}
+
+/// Evaluates a parsed query, returning every matched node in document order.
+fn query_collect<'a>(root: &'a Json, steps: &[QueryStep]) -> Vec<&'a Json> {
+    let mut current = vec![root];
+    for step in steps {
+        let mut next = Vec::new();
+        for node in &current {
+            apply_step(node, step, &mut next);
+        }
+        current = next;
+    }
+    current
+}
+
+/// The SQLite `json_type` name of a JSON value.
+fn type_name(value: &Json) -> &'static str {
+    match value {
+        Json::Object(_) => "object",
+        Json::Array(_) => "array",
+        Json::String(_) => "text",
+        Json::Bool(true) => "true",
+        Json::Bool(false) => "false",
+        Json::Null => "null",
+        Json::Number(n) => {
+            if n.is_f64() {
+                "real"
+            } else {
+                "integer"
+            }
+        }
+    }
+}
+
+/// Converts a JSON value to a GitQL value: scalars become typed values while
+/// objects and arrays become their minified textual form.
+fn json_to_value(value: &Json) -> Box<dyn Value> {
+    match value {
+        Json::Null => null(),
+        Json::Bool(b) => Box::new(BoolValue::new(*b)),
+        Json::String(s) => text(s.clone()),
+        Json::Number(n) => {
+            if let Some(i) = n.as_i64() {
+                Box::new(IntValue::new(i))
+            } else {
+                Box::new(FloatValue::new(n.as_f64().unwrap_or(0.0)))
+            }
+        }
+        Json::Array(_) | Json::Object(_) => text(value.to_string()),
+    }
+}
+
+/// Converts a GitQL value to the JSON value used when building documents.
+/// Text is stored as a JSON string, mirroring SQLite's literal treatment.
+#[allow(clippy::borrowed_box)]
+fn value_to_json(value: &Box<dyn Value>) -> Json {
+    if value.is_null() {
+        Json::Null
+    } else if let Some(b) = value.as_bool() {
+        Json::Bool(b)
+    } else if let Some(i) = value.as_int() {
+        json!(i)
+    } else if let Some(f) = value.as_float() {
+        json!(f)
+    } else if let Some(s) = value.as_text() {
+        Json::String(s)
+    } else {
+        Json::Null
+    }
+}
+
+#[allow(clippy::borrowed_box)]
+fn parse_doc(value: &Box<dyn Value>) -> Option<Json> {
+    let raw = value.as_text()?;
+    serde_json::from_str(&raw).ok()
+}
+
+/// Evaluates the `->` and `->>` JSON access operators. The accessor selects an
+/// object member (text), an array element (integer), or a full path (text
+/// beginning with `$`). With `as_text` the referenced value is returned as a
+/// typed GitQL value (the `->>` operator); otherwise it is returned as JSON text
+/// (the `->` operator). A missing target or an invalid document yields null.
+#[allow(clippy::borrowed_box)]
+pub fn evaluate_json_access(
+    document: &Box<dyn Value>,
+    accessor: &Box<dyn Value>,
+    as_text: bool,
+) -> Box<dyn Value> {
+    let Some(doc) = parse_doc(document) else {
+        return null();
+    };
+    let path = if let Some(key) = accessor.as_text() {
+        if key.starts_with('$') {
+            match parse_path(&key) {
+                Some(path) => path,
+                None => return null(),
+            }
+        } else {
+            vec![PathSegment::Key(key)]
+        }
+    } else if let Some(index) = accessor.as_int() {
+        match usize::try_from(index) {
+            Ok(index) => vec![PathSegment::Index(index)],
+            Err(_) => return null(),
+        }
+    } else {
+        return null();
+    };
+    match resolve(&doc, &path) {
+        Some(value) if as_text => json_to_value(value),
+        Some(value) => text(value.to_string()),
+        None => null(),
+    }
+}
+
+pub fn register_std_json_functions(map: &mut HashMap<&'static str, StandardFunction>) {
+    map.insert("json", json_minify);
+    map.insert("json_valid", json_valid);
+    map.insert("json_type", json_type);
+    map.insert("json_extract", json_extract);
+    map.insert("json_query", json_query);
+    map.insert("json_array", json_array);
+    map.insert("json_object", json_object);
+    map.insert("json_array_length", json_array_length);
+    map.insert("json_quote", json_quote);
+    map.insert("json_set", json_set);
+    map.insert("json_insert", json_insert);
+    map.insert("json_replace", json_replace);
+    map.insert("json_remove", json_remove);
+    map.insert("json_patch", json_patch);
+    map.insert("json_keys", json_keys);
+    map.insert("json_contains", json_contains);
+    map.insert("json_depth", json_depth);
+    map.insert("json_pretty", json_pretty);
+}
+
