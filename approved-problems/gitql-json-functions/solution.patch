+
+fn json_minify(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    match parse_doc(&inputs[0]) {
+        Some(doc) => text(doc.to_string()),
+        None => null(),
+    }
+}
+
+/// `json_pretty(X)`: re-serialises the document with two-space indentation.
+fn json_pretty(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    match parse_doc(&inputs[0]).and_then(|doc| serde_json::to_string_pretty(&doc).ok()) {
+        Some(pretty) => text(pretty),
+        None => null(),
+    }
+}
+
+fn json_valid(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let valid = inputs[0]
+        .as_text()
+        .is_some_and(|raw| serde_json::from_str::<Json>(&raw).is_ok());
+    Box::new(BoolValue::new(valid))
+}
+
+fn json_type(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let Some(doc) = parse_doc(&inputs[0]) else {
+        return null();
+    };
+    let resolved = if let Some(path_text) = inputs.get(1).and_then(|v| v.as_text()) {
+        match parse_path(&path_text) {
+            Some(path) => resolve(&doc, &path),
+            None => return null(),
+        }
+    } else {
+        Some(&doc)
+    };
+    match resolved {
+        Some(value) => text(type_name(value).to_string()),
+        None => null(),
+    }
+}
+
+/// Resolves `json_extract`'s return type: several paths always yield a JSON array
+/// (text), while one path yields the referenced value typed (a scalar) or as JSON
+/// text (a container), so it composes in arithmetic and comparisons.
+fn json_extract_return_type(types: &[Box<dyn DataType>]) -> Box<dyn DataType> {
+    let has_varargs = types.iter().any(|t| t.as_any().is::<VarargsType>());
+    if !has_varargs && types.len() > 2 {
+        Box::new(TextType)
+    } else {
+        Box::new(VariantType::new(vec![
+            Box::new(IntType),
+            Box::new(FloatType),
+            Box::new(TextType),
+            Box::new(BoolType),
+        ]))
+    }
+}
+
+fn json_extract(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let Some(doc) = parse_doc(&inputs[0]) else {
+        return null();
+    };
+    let paths = &inputs[1..];
+    if paths.len() == 1 {
+        let Some(path_text) = paths[0].as_text() else {
+            return null();
+        };
+        let Some(path) = parse_path(&path_text) else {
+            return null();
+        };
+        return match resolve(&doc, &path) {
+            Some(value) => json_to_value(value),
+            None => null(),
+        };
+    }
+    let mut collected = Vec::with_capacity(paths.len());
+    for path_value in paths {
+        let resolved = path_value
+            .as_text()
+            .and_then(|p| parse_path(&p))
+            .and_then(|p| resolve(&doc, &p).cloned());
+        collected.push(resolved.unwrap_or(Json::Null));
+    }
+    text(Json::Array(collected).to_string())
+}
+
+/// `json_query(X, PATTERN)`: an extended path query supporting `.*`, `[*]`,
+/// `..key` and `..*`. Always returns a JSON array of the matches in document
+/// pre-order, keeping duplicates; an invalid document or malformed pattern is
+/// null.
+fn json_query(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let Some(doc) = parse_doc(&inputs[0]) else {
+        return null();
+    };
+    let Some(pattern) = inputs[1].as_text() else {
+        return null();
+    };
+    let Some(steps) = parse_query(&pattern) else {
+        return null();
+    };
+    let matches: Vec<Json> = query_collect(&doc, &steps).into_iter().cloned().collect();
+    text(Json::Array(matches).to_string())
+}
+
+fn json_array(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let items: Vec<Json> = inputs.iter().map(value_to_json).collect();
+    text(Json::Array(items).to_string())
+}
+
+fn json_object(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let mut object = serde_json::Map::new();
+    for pair in inputs.chunks(2) {
+        if pair.len() != 2 {
+            return null();
+        }
+        let Some(key) = pair[0].as_text() else {
+            return null();
+        };
+        object.insert(key, value_to_json(&pair[1]));
+    }
+    text(Json::Object(object).to_string())
+}
+
+fn json_array_length(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let Some(doc) = parse_doc(&inputs[0]) else {
+        return null();
+    };
+    let resolved = if let Some(path_text) = inputs.get(1).and_then(|v| v.as_text()) {
+        match parse_path(&path_text) {
+            Some(path) => resolve(&doc, &path),
+            None => return null(),
+        }
+    } else {
+        Some(&doc)
+    };
+    let length = match resolved {
+        Some(Json::Array(items)) => items.len() as i64,
+        Some(_) => 0,
+        None => return null(),
+    };
+    Box::new(IntValue::new(length))
+}
+
+fn json_quote(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    text(value_to_json(&inputs[0]).to_string())
+}
+
+/// Applies a `set`/`insert`/`replace` edit at the parent of the final path
+/// segment. `overwrite` and `create` select the three SQLite variants.
+fn edit_at(root: &mut Json, path: &[PathSegment], new_value: Json, overwrite: bool, create: bool) {
+    let Some((last, parents)) = path.split_last() else {
+        // The root path `$` always exists, so only overwriting edits apply.
+        if overwrite {
+            *root = new_value;
+        }
+        return;
+    };
+    let Some(current) = resolve_mut(root, parents) else {
+        return;
+    };
+    match (last, current) {
+        (PathSegment::Key(key), Json::Object(map)) => {
+            let exists = map.contains_key(key);
+            if (exists && overwrite) || (!exists && create) {
+                map.insert(key.clone(), new_value);
+            }
+        }
+        (PathSegment::Index(index), Json::Array(items)) => {
+            // A numeric index only overwrites an existing element; one past the
+            // end or beyond is not the append position and leaves the array as is.
+            if *index < items.len() && overwrite {
+                items[*index] = new_value;
+            }
+        }
+        (PathSegment::Append, Json::Array(items)) => {
+            // `[#]` is the only appending target.
+            if create {
+                items.push(new_value);
+            }
+        }
+        (PathSegment::FromEnd(offset), Json::Array(items)) => {
+            // `[#-n]` addresses an existing element; overwrite only. `[#-0]`
+            // resolves to the length (out of range) and never appends.
+            if let Some(index) = end_index(*offset, items.len()) {
+                if index < items.len() && overwrite {
+                    items[index] = new_value;
+                }
+            }
+        }
+        _ => {}
+    }
+}
+
+fn edit_document(inputs: &[Box<dyn Value>], overwrite: bool, create: bool) -> Box<dyn Value> {
+    let Some(mut doc) = parse_doc(&inputs[0]) else {
+        return null();
+    };
+    let mut rest = &inputs[1..];
+    while !rest.is_empty() {
+        if rest.len() < 2 {
+            return null();
+        }
+        let Some(path_text) = rest[0].as_text() else {
+            return null();
+        };
+        let Some(path) = parse_path(&path_text) else {
+            return null();
+        };
+        edit_at(&mut doc, &path, value_to_json(&rest[1]), overwrite, create);
+        rest = &rest[2..];
+    }
+    text(doc.to_string())
+}
+
+fn json_set(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    edit_document(inputs, true, true)
+}
+
+fn json_insert(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    edit_document(inputs, false, true)
+}
+
+fn json_replace(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    edit_document(inputs, true, false)
+}
+
+fn json_remove(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let Some(mut doc) = parse_doc(&inputs[0]) else {
+        return null();
+    };
+    for path_value in &inputs[1..] {
+        let Some(path_text) = path_value.as_text() else {
+            return null();
+        };
+        let Some(path) = parse_path(&path_text) else {
+            return null();
+        };
+        let Some((last, parents)) = path.split_last() else {
+            // Removing the root discards the whole document.
+            return null();
+        };
+        if let Some(parent) = resolve_mut(&mut doc, parents) {
+            match (last, parent) {
+                (PathSegment::Key(key), Json::Object(map)) => {
+                    map.remove(key);
+                }
+                (PathSegment::Index(index), Json::Array(items)) => {
+                    if *index < items.len() {
+                        items.remove(*index);
+                    }
+                }
+                (PathSegment::FromEnd(offset), Json::Array(items)) => {
+                    if let Some(index) = end_index(*offset, items.len()) {
+                        if index < items.len() {
+                            items.remove(index);
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    text(doc.to_string())
+}
+
+/// RFC 7396 recursive merge used by `json_patch`.
+fn merge_patch(target: &mut Json, patch: &Json) {
+    let Json::Object(patch_map) = patch else {
+        *target = patch.clone();
+        return;
+    };
+    if !target.is_object() {
+        *target = Json::Object(serde_json::Map::new());
+    }
+    let target_map = target.as_object_mut().expect("target is an object");
+    for (key, value) in patch_map {
+        if value.is_null() {
+            target_map.remove(key);
+        } else {
+            merge_patch(target_map.entry(key.clone()).or_insert(Json::Null), value);
+        }
+    }
+}
+
+fn json_patch(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let (Some(mut target), Some(patch)) = (parse_doc(&inputs[0]), parse_doc(&inputs[1])) else {
+        return null();
+    };
+    merge_patch(&mut target, &patch);
+    text(target.to_string())
+}
+
+/// Recursive containment used by `json_contains`: a candidate is contained in a
+/// target when scalars are equal, every candidate array element is contained in
+/// some target array element, and every candidate object member is contained in
+/// the matching target member.
+fn contains(target: &Json, candidate: &Json) -> bool {
+    match (target, candidate) {
+        (Json::Object(t), Json::Object(c)) => c
+            .iter()
+            .all(|(key, value)| t.get(key).is_some_and(|found| contains(found, value))),
+        (Json::Array(t), Json::Array(c)) => c
+            .iter()
+            .all(|candidate| t.iter().any(|target| contains(target, candidate))),
+        (Json::Array(t), candidate) => t.iter().any(|target| contains(target, candidate)),
+        (target, candidate) => target == candidate,
+    }
+}
+
+fn json_contains(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    let (Some(document), Some(candidate)) = (parse_doc(&inputs[0]), parse_doc(&inputs[1])) else {
+        return null();
+    };
+    Box::new(BoolValue::new(contains(&document, &candidate)))
+}
+
+/// The maximum nesting depth of a JSON value: scalars and empty containers have
+/// depth 1, and a non-empty container is one deeper than its deepest child.
+fn depth(value: &Json) -> i64 {
+    match value {
+        Json::Array(items) if !items.is_empty() => 1 + items.iter().map(depth).max().unwrap_or(0),
+        Json::Object(map) if !map.is_empty() => 1 + map.values().map(depth).max().unwrap_or(0),
+        _ => 1,
+    }
+}
+
+fn json_depth(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    match parse_doc(&inputs[0]) {
+        Some(document) => Box::new(IntValue::new(depth(&document))),
+        None => null(),
+    }
+}
+
+/// `json_keys(X)`: the member names of an object as a JSON array, in document
+/// order. Returns NULL when the value is not an object.
+fn json_keys(inputs: &[Box<dyn Value>]) -> Box<dyn Value> {
+    match parse_doc(&inputs[0]) {
+        Some(Json::Object(map)) => {
+            let keys: Vec<Json> = map.keys().map(|k| Json::String(k.clone())).collect();
+            text(Json::Array(keys).to_string())
+        }
+        _ => null(),
+    }
+}
+
+fn resolve_mut<'a>(root: &'a mut Json, path: &[PathSegment]) -> Option<&'a mut Json> {
+    let mut current = root;
+    for segment in path {
+        current = match (segment, current) {
+            (PathSegment::Key(key), Json::Object(map)) => map.get_mut(key)?,
+            (PathSegment::Index(index), Json::Array(items)) => items.get_mut(*index)?,
+            (PathSegment::FromEnd(offset), Json::Array(items)) => {
+                let index = end_index(*offset, items.len())?;
+                items.get_mut(index)?
+            }
+            _ => return None,
+        };
+    }
+    Some(current)
+}
