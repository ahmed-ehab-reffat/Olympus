+        "json_array",
+        Signature::new(vec![Box::new(varargs_any())], Box::new(TextType)),
+    );
+    map.insert(
+        "json_object",
+        Signature::new(vec![Box::new(varargs_any())], Box::new(TextType)),
+    );
+    map.insert(
+        "json_array_length",
+        Signature::new(
+            vec![Box::new(TextType), Box::new(optional_text())],
+            Box::new(IntType),
+        ),
+    );
+    map.insert(
+        "json_quote",
+        Signature::new(vec![Box::new(AnyType)], Box::new(TextType)),
+    );
+    for name in ["json_set", "json_insert", "json_replace"] {
+        map.insert(
+            name,
+            Signature::new(
+                vec![
+                    Box::new(TextType),
+                    Box::new(TextType),
+                    Box::new(AnyType),
+                    Box::new(varargs_any()),
