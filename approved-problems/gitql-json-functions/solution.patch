+            Box::new(DynamicType::new(json_extract_return_type)),
+        ),
+    );
+    map.insert(
+        "json_query",
+        Signature::new(
+            vec![Box::new(TextType), Box::new(TextType)],
+            Box::new(TextType),
+        ),
+    );
