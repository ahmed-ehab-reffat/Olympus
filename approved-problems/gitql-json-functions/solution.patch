+/// Parses the left-associative JSON access operators `->` and `->>`.
+fn parse_json_access_expression(
+    context: &mut ParserContext,
+    env: &mut Environment,
+    tokens: &[Token],
+    position: &mut usize,
+) -> Result<Box<dyn Expr>, Box<Diagnostic>> {
+    let mut lhs = parse_like_expression(context, env, tokens, position)?;
+
+    while is_current_token(tokens, position, TokenKind::Arrow)
+        || is_current_token(tokens, position, TokenKind::LongArrow)
+    {
+        let as_text = tokens[*position].kind == TokenKind::LongArrow;
+        *position += 1;
+        let rhs = parse_like_expression(context, env, tokens, position)?;
+        lhs = Box::new(JsonAccessExpr {
+            left: lhs,
+            right: rhs,
+            as_text,
+        });
+    }
+
+    Ok(lhs)
+}
