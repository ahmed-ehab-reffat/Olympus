+    /// The union of a per-variant capability list, so the variant can act as an
+    /// operand whenever any of its members can.
+    fn union_capability(&self, capability: CapabilityFunction) -> Vec<Box<dyn DataType>> {
+        let mut types: Vec<Box<dyn DataType>> = Vec::new();
+        for variant in self.variants.iter() {
+            types.extend(capability(variant));
+        }
