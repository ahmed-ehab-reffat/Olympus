+/// Creates transport (fleet index) from a precomputed (TSPLIB `EXPLICIT`) distance matrix.
+/// Values are used exactly as given: no rounding is applied.
+pub(crate) fn create_transport_from_matrix(
+    values: Vec<Float>,
+    logger: &InfoLogger,
+) -> Result<Arc<dyn TransportCost>, GenericError> {
+    Timer::measure_duration_with_callback(
+        || {
+            let transport: Arc<dyn TransportCost> = Arc::new(SingleDataTransportCost::new(values)?);
+            Ok(transport)
+        },
+        |duration| (logger)(format!("fleet index created in {}ms", duration.as_millis()).as_str()),
+    )
+}
+
+/// TSPLIB edge weight types computed from full-precision `(Float, Float)` coordinate pairs.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FloatEdgeWeight {
+    /// Euclidean distance rounded up.
+    Ceiling2D,
+    /// The pseudo-Euclidean formula TSPLIB defines for its ATT-class instances.
+    PseudoEuclidean,
+    /// Great-circle distance between two geographic (degrees-and-minutes) coordinates.
+    Geographic,
+}
+
+/// Earth radius (km) used by the TSPLIB GEO distance formula.
+const GEO_EARTH_RADIUS: Float = 6378.388;
+
+/// Converts a TSPLIB geographic coordinate (encoded as `DDD.MM`, i.e. whole degrees in the
+/// integer part and minutes in the fractional part) to radians.
+pub(crate) fn to_geo_radians(coord: Float) -> Float {
+    let degrees = coord.trunc();
+    let minutes = coord - degrees;
+
+    std::f64::consts::PI * (degrees + 5.0 * minutes / 3.0) / 180.0
+}
+
+/// Computes the great-circle distance between two points, each given as (latitude, longitude)
+/// in radians.
+fn geo_distance(lat1: Float, lon1: Float, lat2: Float, lon2: Float) -> Float {
+    let q1 = (lon1 - lon2).cos();
+    let q2 = (lat1 - lat2).cos();
+    let q3 = (lat1 + lat2).cos();
+
+    (GEO_EARTH_RADIUS * (0.5 * ((1.0 + q1) * q2 - (1.0 - q1) * q3)).acos() + 1.0).floor()
+}
+
+/// Computes the edge weight between two full-precision coordinate pairs.
+fn compute_float_edge_weight(edge_type: FloatEdgeWeight, x1: Float, y1: Float, x2: Float, y2: Float) -> Float {
+    match edge_type {
+        FloatEdgeWeight::Ceiling2D => {
+            let (dx, dy) = (x1 - x2, y1 - y2);
+            (dx * dx + dy * dy).sqrt().ceil()
+        }
+        FloatEdgeWeight::PseudoEuclidean => {
+            let (dx, dy) = (x1 - x2, y1 - y2);
+            let rij = ((dx * dx + dy * dy) / 10.0).sqrt();
+            let tij = rij.round();
+            if tij < rij { tij + 1.0 } else { tij }
+        }
+        FloatEdgeWeight::Geographic => {
+            let (lat1, lon1) = (to_geo_radians(x1), to_geo_radians(y1));
+            let (lat2, lon2) = (to_geo_radians(x2), to_geo_radians(y2));
+            geo_distance(lat1, lon1, lat2, lon2)
+        }
+    }
+}
+
+/// Creates transport (fleet index) for TSPLIB `CEIL_2D`, `ATT`, and `GEO` instances from
+/// full-precision coordinate pairs, independent of `CoordIndex`'s `(i32, i32)` locations.
+pub(crate) fn create_transport_from_float_coords(
+    edge_type: FloatEdgeWeight,
+    coordinates: &[(Float, Float)],
+    logger: &InfoLogger,
+) -> Result<Arc<dyn TransportCost>, GenericError> {
+    Timer::measure_duration_with_callback(
+        || {
+            let mut matrix_values = coordinates
+                .iter()
+                .flat_map(|&(x1, y1)| {
+                    coordinates.iter().map(move |&(x2, y2)| compute_float_edge_weight(edge_type, x1, y1, x2, y2))
+                })
+                .collect::<Vec<Float>>();
+
+            matrix_values.shrink_to_fit();
+
+            let transport: Arc<dyn TransportCost> = Arc::new(SingleDataTransportCost::new(matrix_values)?);
+
+            Ok(transport)
+        },
+        |duration| (logger)(format!("fleet index created in {}ms", duration.as_millis()).as_str()),
+    )
+}
