+/// Reads exactly `count` whitespace-separated numeric tokens, consuming as many lines as needed.
+/// Unlike `read_line`, a single logical section can be wrapped across an arbitrary number of
+/// physical lines, so tokens are accumulated until the target count is reached.
+pub(crate) fn read_n_values<R: Read>(
+    count: usize,
+    reader: &mut BufReader<R>,
+    buffer: &mut String,
+) -> Result<Vec<Float>, GenericError> {
+    let mut values = Vec::with_capacity(count);
+
+    while values.len() < count {
+        let bytes_read = read_line(reader, buffer)?;
+
+        if bytes_read == 0 {
+            return Err(format!("unexpected end of data: expected {count} values, got {}", values.len()).into());
+        }
+
+        for token in buffer.split_whitespace() {
+            values.push(token.parse::<Float>().map_err(|err| format!("cannot parse value '{token}': {err}"))?);
+        }
+    }
+
+    if values.len() != count {
+        return Err(format!("expected {count} values, got {}", values.len()).into());
+    }
+
+    Ok(values)
+}
