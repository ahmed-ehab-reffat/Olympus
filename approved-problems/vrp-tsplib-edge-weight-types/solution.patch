+/// A trait to recover a TSPLIB `EXPLICIT` instance's `DISPLAY_DATA_SECTION` locations.
+pub trait TsplibLocations {
+    /// Gets `(id, x, y)` triples for every declared location, or `None` if there are none.
+    fn get_tsplib_locations(&self) -> Option<Vec<(String, Float, Float)>>;
+}
+
+impl TsplibLocations for Problem {
+    fn get_tsplib_locations(&self) -> Option<Vec<(String, Float, Float)>> {
+        self.extras.get_display_coordinates().map(|coordinates| {
+            let mut locations = coordinates.iter().map(|(id, (x, y))| (id.clone(), *x, *y)).collect::<Vec<_>>();
+            locations.sort_by_key(|(id, _, _)| id.parse::<i32>().unwrap_or(i32::MAX));
+            locations
+        })
+    }
+}
