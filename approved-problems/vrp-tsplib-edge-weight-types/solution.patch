+/// Number of numeric tokens an `EDGE_WEIGHT_SECTION` carries for the given format and dimension.
+fn edge_weight_section_len(format: EdgeWeightFormat, dimension: usize) -> usize {
+    match format {
+        EdgeWeightFormat::FullMatrix => dimension * dimension,
+        EdgeWeightFormat::UpperRow | EdgeWeightFormat::LowerRow => dimension * dimension.saturating_sub(1) / 2,
+        EdgeWeightFormat::UpperDiagRow | EdgeWeightFormat::LowerDiagRow => dimension * (dimension + 1) / 2,
+    }
+}
+
+/// Writes one parsed value into both `(i, j)` and its mirror `(j, i)`, keeping the expanded
+/// matrix symmetric regardless of which half the source format stored.
+fn set_symmetric(matrix: &mut [Float], dimension: usize, values: &mut std::slice::Iter<Float>, i: usize, j: usize) {
+    let value = *values.next().expect("edge weight section value count already validated by read_n_values");
+    matrix[i * dimension + j] = value;
+    matrix[j * dimension + i] = value;
+}
+
+/// Expands a triangular or full `EDGE_WEIGHT_SECTION` token stream into a full, symmetric
+/// `dimension x dimension` row-major matrix.
+fn expand_edge_weight_matrix(format: EdgeWeightFormat, dimension: usize, values: &[Float]) -> Vec<Float> {
+    let mut matrix = vec![0.; dimension * dimension];
+    let mut values = values.iter();
+
+    match format {
+        EdgeWeightFormat::FullMatrix => {
+            for i in 0..dimension {
+                for j in 0..dimension {
+                    matrix[i * dimension + j] =
+                        *values.next().expect("edge weight section value count already validated by read_n_values");
+                }
+            }
+        }
+        EdgeWeightFormat::UpperRow => {
+            for i in 0..dimension {
+                for j in (i + 1)..dimension {
+                    set_symmetric(&mut matrix, dimension, &mut values, i, j);
+                }
+            }
+        }
+        EdgeWeightFormat::LowerRow => {
+            for i in 0..dimension {
+                for j in 0..i {
+                    set_symmetric(&mut matrix, dimension, &mut values, i, j);
+                }
+            }
+        }
+        EdgeWeightFormat::UpperDiagRow => {
+            for i in 0..dimension {
+                for j in i..dimension {
+                    set_symmetric(&mut matrix, dimension, &mut values, i, j);
+                }
+            }
+        }
+        EdgeWeightFormat::LowerDiagRow => {
+            for i in 0..dimension {
+                for j in 0..=i {
+                    set_symmetric(&mut matrix, dimension, &mut values, i, j);
+                }
+            }
+        }
+    }
+
+    matrix
+}
