+++ b/test.sh
@@ -0,0 +1,211 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)         MODE="$1"; shift ;;
+    *)                shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+READER_TARGET="tsplib_formats_92215a_test"
+
+# Reader tests for the TSPLIB CEIL_2D/ATT/GEO/EXPLICIT edge weight types and their
+# DISPLAY_DATA_SECTION handling. All live in the standalone integration target above.
+NEW_READER_TESTS=(
+  can_read_ceil_2d
+  can_read_ceil_2d_preserves_fractional_coordinates
+  can_read_att
+  can_read_att_preserves_fractional_coordinates
+  can_read_att_at_tij_equals_rij_boundary
+  can_read_geo
+  can_read_geo_preserves_minutes_precision
+  can_read_geo_with_southern_and_western_coordinates
+  can_read_ceil_2d_across_quadrants_and_integral_distances
+  can_read_att_on_both_sides_of_the_rounding_threshold
+  can_read_geo_with_both_axes_changing
+  can_read_explicit_full_matrix
+  can_read_explicit_metadata_keys_in_any_order
+  can_read_explicit_display_data_with_permuted_metadata_keys
+  can_read_explicit_full_matrix_is_not_forced_symmetric
+  can_read_explicit_format_parity
+  can_read_explicit_independent_of_demand_line_order
+  can_read_explicit_with_depot_in_the_middle
+  can_read_explicit_full_matrix_asymmetric_with_depot_in_the_middle
+  can_read_explicit_with_display_data_section_and_depot_in_the_middle
+  can_read_explicit_with_non_integer_value
+  can_read_explicit_with_display_data_section_ignored_for_cost
+  can_read_explicit_preserves_nonzero_diagonal
+  can_read_explicit_dimension_one_has_no_jobs
+  is_rounded_only_affects_euc_2d
+)
+
+# TSPLIB metadata rejection guards, run alongside the vrp-scientific unit tests.
+METADATA_TARGET="tsplib_metadata_8f2d49_test"
+METADATA_REJECTION_TESTS=(
+  cannot_read_invalid_problem_type
+  cannot_read_malformed_dimension
+  cannot_read_malformed_capacity
+  cannot_read_unsupported_edge_weight_type
+  cannot_read_unsupported_edge_weight_format
+  cannot_read_unsupported_display_data_type
+  cannot_read_explicit_without_display_data_type
+  cannot_read_display_data_type_on_non_explicit_type
+  cannot_read_display_data_section_after_demand_section
+  cannot_read_display_data_section_with_too_few_lines
+  cannot_read_display_data_section_with_too_many_lines
+  cannot_read_display_data_section_under_no_display
+  cannot_read_explicit_without_edge_weight_format
+)
+
+# Location-export tests. Each target is run in full; the names are listed so a compilation failure
+# still reports one testcase per expected test rather than a single opaque entry.
+SCI_LOCATION_TARGET="locations_8533de_test"
+SCI_LOCATION_TESTS=(
+  can_export_display_data_section_locations
+  can_export_display_data_section_locations_with_depot_in_the_middle
+  cannot_export_locations_without_display_data_section
+  cannot_export_locations_for_euc_2d
+  can_export_display_data_section_locations_in_ascending_node_order
+)
+
+CLI_LOCATION_TARGET="locations_f80db2_test"
+CLI_LOCATION_TESTS=(
+  can_get_tsplib_locations_serialized
+  cannot_get_tsplib_locations_serialized_without_display_data
+  can_get_tsplib_locations_via_cli_with_pure_json_stdout
+  can_get_tsplib_locations_via_get_locations_flag
+  cannot_get_tsplib_locations_via_get_locations_flag_without_display_data
+)
+
+WORK_DIR="$(mktemp -d)"
+STATUS=0
+
+run_cargo_json() {
+  local out_json="$1"; local out_err="$2"; local cargo_args="$3"; shift 3
+  # shellcheck disable=SC2086
+  cargo test $cargo_args -- "$@" -Z unstable-options --format json --report-time > "$out_json" 2> "$out_err"
+  return $?
+}
+
+# Converts one cargo --format json stream to a JUnit XML file, falling back to a synthetic
+# failure testcase per expected name when the invocation failed to produce any testcase at all
+# (typically a compilation failure before any test ran).
+to_junit_or_fallback() {
+  local json_file="$1"; local err_file="$2"; local xml_file="$3"; shift 3
+  local names=("$@")
+
+  cargo2junit < "$json_file" > "$xml_file" 2>/dev/null || true
+
+  if ! grep -q '<testcase' "$xml_file" 2>/dev/null; then
+    local sanitized
+    sanitized=$( { cat "$err_file"; cat "$json_file"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    local testcases=""
+    for name in "${names[@]}"; do
+      testcases+="    <testcase name=\"${name}\" classname=\"\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+    done
+    cat > "$xml_file" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="cargo-test" tests="${#names[@]}" failures="${#names[@]}" errors="0">
+${testcases}  </testsuite>
+</testsuites>
+XMLEOF
+    return 1
+  fi
+
+  return 0
+}
+
+merge_junit() {
+  local out_path="$1"; shift
+  mkdir -p "$(dirname "$out_path")" || return 1
+  python3 - "$out_path" "$@" <<'PYEOF'
+import sys
+import xml.etree.ElementTree as ET
+
+out_path = sys.argv[1]
+root = ET.Element("testsuites")
+for path in sys.argv[2:]:
+    tree = ET.parse(path)
+    for suite in tree.getroot().findall("testsuite"):
+        root.append(suite)
+
+ET.ElementTree(root).write(out_path, encoding="UTF-8", xml_declaration=True)
+PYEOF
+}
+
+case "$MODE" in
+  base)
+    # vrp-scientific unit tests.
+    run_cargo_json "$WORK_DIR/lib.json" "$WORK_DIR/lib.err" "-p vrp-scientific --lib"
+    lib_status=$?
+    to_junit_or_fallback "$WORK_DIR/lib.json" "$WORK_DIR/lib.err" "$WORK_DIR/lib.xml" compilation
+    lib_fallback_status=$?
+
+    run_cargo_json "$WORK_DIR/cli_lib.json" "$WORK_DIR/cli_lib.err" "-p vrp-cli --lib"
+    cli_lib_status=$?
+    to_junit_or_fallback "$WORK_DIR/cli_lib.json" "$WORK_DIR/cli_lib.err" "$WORK_DIR/cli_lib.xml" compilation
+    cli_lib_fallback_status=$?
+
+    run_cargo_json "$WORK_DIR/reject.json" "$WORK_DIR/reject.err" \
+      "-p vrp-scientific --test $METADATA_TARGET"
+    reject_status=$?
+    to_junit_or_fallback "$WORK_DIR/reject.json" "$WORK_DIR/reject.err" "$WORK_DIR/reject.xml" \
+      "${METADATA_REJECTION_TESTS[@]}"
+    reject_fallback_status=$?
+
+    STATUS=$(( lib_status != 0 || lib_fallback_status != 0 || cli_lib_status != 0 \
+      || cli_lib_fallback_status != 0 || reject_status != 0 || reject_fallback_status != 0 ))
+
+    if [ -n "$OUTPUT_PATH" ]; then
+      merge_junit "$OUTPUT_PATH" "$WORK_DIR/lib.xml" "$WORK_DIR/cli_lib.xml" "$WORK_DIR/reject.xml"
+      merge_status=$?
+      STATUS=$(( STATUS != 0 || merge_status != 0 ))
+    fi
+    ;;
+  new)
+    run_cargo_json "$WORK_DIR/reader.json" "$WORK_DIR/reader.err" \
+      "-p vrp-scientific --test $READER_TARGET" "${NEW_READER_TESTS[@]}"
+    reader_status=$?
+    to_junit_or_fallback "$WORK_DIR/reader.json" "$WORK_DIR/reader.err" "$WORK_DIR/reader.xml" \
+      "${NEW_READER_TESTS[@]}"
+    reader_fallback_status=$?
+
+    STATUS=$(( reader_status != 0 || reader_fallback_status != 0 ))
+
+    run_cargo_json "$WORK_DIR/sci_loc.json" "$WORK_DIR/sci_loc.err" \
+      "-p vrp-scientific --test $SCI_LOCATION_TARGET"
+    sci_loc_status=$?
+    to_junit_or_fallback "$WORK_DIR/sci_loc.json" "$WORK_DIR/sci_loc.err" "$WORK_DIR/sci_loc.xml" \
+      "${SCI_LOCATION_TESTS[@]}"
+    sci_loc_fallback_status=$?
+
+    run_cargo_json "$WORK_DIR/cli_loc.json" "$WORK_DIR/cli_loc.err" \
+      "-p vrp-cli --test $CLI_LOCATION_TARGET"
+    cli_loc_status=$?
+    to_junit_or_fallback "$WORK_DIR/cli_loc.json" "$WORK_DIR/cli_loc.err" "$WORK_DIR/cli_loc.xml" \
+      "${CLI_LOCATION_TESTS[@]}"
+    cli_loc_fallback_status=$?
+
+    STATUS=$(( STATUS != 0 || sci_loc_status != 0 || sci_loc_fallback_status != 0 \
+      || cli_loc_status != 0 || cli_loc_fallback_status != 0 ))
+
+    xml_files=("$WORK_DIR/reader.xml" "$WORK_DIR/sci_loc.xml" "$WORK_DIR/cli_loc.xml")
+
+    if [ -n "$OUTPUT_PATH" ]; then
+      merge_junit "$OUTPUT_PATH" "${xml_files[@]}"
+      merge_status=$?
+      STATUS=$(( STATUS != 0 || merge_status != 0 ))
+    fi
+    ;;
+esac
+
+exit $STATUS
diff --git a/vrp-cli/tests/locations_f80db2_test.rs b/vrp-cli/tests/locations_f80db2_test.rs
new file mode 100644
index 0000000..aefe610
--- /dev/null
+++ b/vrp-cli/tests/locations_f80db2_test.rs
@@ -0,0 +1,105 @@
+use serde_json::Value;
+use std::collections::HashMap;
+use vrp_cli::get_tsplib_locations_serialized;
+use vrp_scientific::tsplib::TsplibProblem;
+
+fn in_order(serialized: &str) -> Vec<(String, f64, f64)> {
+    let parsed: Vec<Value> = serde_json::from_str(serialized).expect("invalid json");
+    parsed
+        .into_iter()
+        .map(|entry| {
+            let id = entry["id"].as_str().expect("id must be a string").to_string();
+            let x = entry["x"].as_f64().expect("x must be a number");
+            let y = entry["y"].as_f64().expect("y must be a number");
+            (id, x, y)
+        })
+        .collect()
+}
+
+fn expected_ordered_locations() -> Vec<(String, f64, f64)> {
+    (1..=12).map(|node| ((node - 1).to_string(), node as f64, (node * 2) as f64)).collect()
+}
+
+fn by_id(serialized: &str) -> HashMap<String, (f64, f64)> {
+    let parsed: Vec<Value> = serde_json::from_str(serialized).expect("invalid json");
+    parsed
+        .into_iter()
+        .map(|entry| {
+            let id = entry["id"].as_str().expect("id must be a string").to_string();
+            let x = entry["x"].as_f64().expect("x must be a number");
+            let y = entry["y"].as_f64().expect("y must be a number");
+            (id, (x, y))
+        })
+        .collect()
+}
+
+#[test]
+fn can_get_tsplib_locations_serialized() {
+    let content = "NAME : test.vrp\nCOMMENT : test instance\nTYPE : CVRP\nDIMENSION : 3\nEDGE_WEIGHT_TYPE : EXPLICIT\nEDGE_WEIGHT_FORMAT : FULL_MATRIX\nDISPLAY_DATA_TYPE : TWOD_DISPLAY\nCAPACITY : 100\nEDGE_WEIGHT_SECTION\n0 5 8\n5 0 6\n8 6 0\nDISPLAY_DATA_SECTION\n1 0.0 0.0\n2 1.0 2.0\n3 3.0 1.0\nDEMAND_SECTION\n1 0\n2 5\n3 7\nDEPOT_SECTION\n1\n-1\nEOF\n"
+        .to_string();
+
+    let problem = content.read_tsplib(false).unwrap();
+
+    let locations = get_tsplib_locations_serialized(&problem).unwrap();
+
+    assert_eq!(
+        by_id(&locations),
+        HashMap::from([("0".to_string(), (0.0, 0.0)), ("1".to_string(), (1.0, 2.0)), ("2".to_string(), (3.0, 1.0)),])
+    );
+}
+
+#[test]
+fn cannot_get_tsplib_locations_serialized_without_display_data() {
+    let content = "NAME : test.vrp\nCOMMENT : test instance\nTYPE : CVRP\nDIMENSION : 3\nEDGE_WEIGHT_TYPE : EXPLICIT\nEDGE_WEIGHT_FORMAT : FULL_MATRIX\nDISPLAY_DATA_TYPE : NO_DISPLAY\nCAPACITY : 100\nEDGE_WEIGHT_SECTION\n0 5 8\n5 0 6\n8 6 0\nDEMAND_SECTION\n1 0\n2 5\n3 7\nDEPOT_SECTION\n1\n-1\nEOF\n"
+        .to_string();
+
+    let problem = content.read_tsplib(false).unwrap();
+
+    assert!(get_tsplib_locations_serialized(&problem).is_err());
+}
+
+#[test]
+fn can_get_tsplib_locations_via_cli_with_pure_json_stdout() {
+    let output = std::process::Command::new(env!("CARGO_BIN_EXE_vrp-cli"))
+        .args(["solve", "tsplib", "../examples/data/scientific/tsplib/explicit-display.vrp", "--get-locations"])
+        .output()
+        .expect("failed to run vrp-cli");
+
+    assert!(output.status.success());
+
+    let stdout = String::from_utf8(output.stdout).expect("stdout must be valid utf8");
+
+    assert_eq!(in_order(&stdout), expected_ordered_locations());
+}
+
+#[test]
+fn can_get_tsplib_locations_via_get_locations_flag() {
+    let tmpfile = tempfile::NamedTempFile::new().unwrap();
+    let output = std::process::Command::new(env!("CARGO_BIN_EXE_vrp-cli"))
+        .args([
+            "solve",
+            "tsplib",
+            "../examples/data/scientific/tsplib/explicit-display.vrp",
+            "--get-locations",
+            "--out-result",
+            tmpfile.path().to_str().unwrap(),
+        ])
+        .output()
+        .expect("failed to run vrp-cli");
+
+    assert!(output.status.success());
+
+    let written = std::fs::read_to_string(tmpfile.path()).unwrap();
+
+    assert_eq!(in_order(&written), expected_ordered_locations());
+}
+
+#[test]
+fn cannot_get_tsplib_locations_via_get_locations_flag_without_display_data() {
+    let output = std::process::Command::new(env!("CARGO_BIN_EXE_vrp-cli"))
+        .args(["solve", "tsplib", "../examples/data/scientific/tsplib/example.txt", "--get-locations"])
+        .output()
+        .expect("failed to run vrp-cli");
+
+    assert!(!output.status.success());
+}
