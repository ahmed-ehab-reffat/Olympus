+
+    let problem = content.read_tsplib(false).expect("cannot read explicit problem with permuted display data");
+
+    let locations = problem.get_tsplib_locations().expect("expected display data locations");
+
+    assert_eq!(
+        locations,
+        vec![
+            ("0".to_string(), 1.0, 2.0),
+            ("1".to_string(), 2.0, 4.0),
+            ("2".to_string(), 3.0, 6.0),
+            ("3".to_string(), 4.0, 8.0),
