+use std::collections::HashMap;
+use vrp_scientific::tsplib::{TsplibLocations, TsplibProblem};
+
+fn by_id(locations: Vec<(String, f64, f64)>) -> HashMap<String, (f64, f64)> {
+    locations.into_iter().map(|(id, x, y)| (id, (x, y))).collect()
+}
+
+#[test]
+fn can_export_display_data_section_locations() {
+    let content = "NAME : test.vrp\nCOMMENT : test instance\nTYPE : CVRP\nDIMENSION : 5\nEDGE_WEIGHT_TYPE : EXPLICIT\nEDGE_WEIGHT_FORMAT : FULL_MATRIX\nDISPLAY_DATA_TYPE : TWOD_DISPLAY\nCAPACITY : 100\nEDGE_WEIGHT_SECTION\n0 10 20 30 40\n10 0 11 21 31\n20 11 0 12 22\n30 21 12 0 13\n40 31 22 13 0\nDISPLAY_DATA_SECTION\n1 0.0 0.0\n2 1.5 2.5\n3 2.0 0.0\n4 3.0 1.0\n5 4.0 4.0\nDEMAND_SECTION\n1 0\n2 5\n3 7\n4 3\n5 9\nDEPOT_SECTION\n1\n-1\nEOF\n"
