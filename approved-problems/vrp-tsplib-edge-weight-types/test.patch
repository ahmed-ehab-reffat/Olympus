+use std::collections::HashMap;
+use vrp_core::models::Problem;
+use vrp_core::models::common::Profile;
+use vrp_core::models::problem::{Job, JobIdDimension};
+use vrp_scientific::tsplib::{TsplibLocations, TsplibProblem};
+
+fn locations_by_id(problem: &Problem) -> HashMap<String, (f64, f64)> {
+    problem
+        .get_tsplib_locations()
+        .expect("expected display locations")
+        .into_iter()
+        .map(|(id, x, y)| (id, (x, y)))
+        .collect()
+}
+
+fn job_location(problem: &Problem, job_id: &str) -> usize {
+    problem
+        .jobs
+        .all()
+        .iter()
+        .find_map(|job| match job {
+            Job::Single(single) if single.dimens.get_job_id().map(String::as_str) == Some(job_id) => {
+                single.places[0].location
+            }
+            _ => None,
+        })
+        .unwrap_or_else(|| panic!("job '{job_id}' not found"))
+}
+
+fn job_distance(problem: &Problem, job_id_a: &str, job_id_b: &str) -> f64 {
+    let from = job_location(problem, job_id_a);
+    let to = job_location(problem, job_id_b);
+    problem.transport.distance_approx(&Profile::default(), from, to)
+}
+
+fn depot_location(problem: &Problem) -> usize {
+    problem.fleet.vehicles[0].details[0].start.as_ref().expect("vehicle must have a start").location
+}
+
+fn depot_distance(problem: &Problem, job_id: &str) -> f64 {
+    let from = depot_location(problem);
+    let to = job_location(problem, job_id);
+    problem.transport.distance_approx(&Profile::default(), from, to)
+}
+
+fn distance_to_depot(problem: &Problem, job_id: &str) -> f64 {
+    let from = job_location(problem, job_id);
+    let to = depot_location(problem);
+    problem.transport.distance_approx(&Profile::default(), from, to)
+}
+
+fn tsplib_header(
+    dimension: usize,
+    edge_weight_type: &str,
+    edge_weight_format: Option<&str>,
+    capacity: usize,
+) -> String {
+    let is_explicit = edge_weight_type == "EXPLICIT";
+    let format_line = edge_weight_format.map(|format| format!("EDGE_WEIGHT_FORMAT : {format}\n")).unwrap_or_default();
+    let display_line = if is_explicit { "DISPLAY_DATA_TYPE : NO_DISPLAY\n" } else { "" };
+
+    format!(
+        "NAME : test.vrp\nCOMMENT : test instance\nTYPE : CVRP\nDIMENSION : {dimension}\nEDGE_WEIGHT_TYPE : {edge_weight_type}\n{format_line}{display_line}CAPACITY : {capacity}\n"
+    )
+}
+
+fn demand_and_depot_section(demand_lines: &[(i32, i32)], depot_id: i32) -> String {
+    let demands = demand_lines.iter().map(|(id, demand)| format!("{id} {demand}\n")).collect::<String>();
+    format!("DEMAND_SECTION\n{demands}DEPOT_SECTION\n{depot_id}\n-1\nEOF\n")
+}
+
+const EXPLICIT_MATRIX_5X5: [[i32; 5]; 5] =
+    [[0, 10, 20, 30, 40], [10, 0, 11, 21, 31], [20, 11, 0, 12, 22], [30, 21, 12, 0, 13], [40, 31, 22, 13, 0]];
+
+fn explicit_section_full_matrix(matrix: &[[i32; 5]; 5]) -> String {
+    let body = matrix
+        .iter()
+        .map(|row| row.iter().map(|v| v.to_string()).collect::<Vec<_>>().join(" "))
+        .collect::<Vec<_>>()
+        .join("\n");
+    format!("EDGE_WEIGHT_SECTION\n{body}\n")
+}
+
+#[allow(clippy::needless_range_loop)]
+fn explicit_section_upper_row(matrix: &[[i32; 5]; 5]) -> String {
+    let dimension = matrix.len();
+    let mut values = Vec::new();
+    for i in 0..dimension {
+        for j in (i + 1)..dimension {
+            values.push(matrix[i][j].to_string());
+        }
+    }
+    format!("EDGE_WEIGHT_SECTION\n{}\n", values.join(" "))
+}
+
+#[allow(clippy::needless_range_loop)]
+fn explicit_section_lower_row(matrix: &[[i32; 5]; 5]) -> String {
+    let dimension = matrix.len();
+    let mut values = Vec::new();
+    for i in 0..dimension {
+        for j in 0..i {
+            values.push(matrix[i][j].to_string());
+        }
+    }
+    format!("EDGE_WEIGHT_SECTION\n{}\n", values.join(" "))
+}
+
+#[allow(clippy::needless_range_loop)]
+fn explicit_section_upper_diag_row(matrix: &[[i32; 5]; 5]) -> String {
+    let dimension = matrix.len();
+    let mut values = Vec::new();
+    for i in 0..dimension {
+        for j in i..dimension {
+            values.push(matrix[i][j].to_string());
+        }
+    }
+    format!("EDGE_WEIGHT_SECTION\n{}\n", values.join(" "))
+}
+
+#[allow(clippy::needless_range_loop)]
+fn explicit_section_lower_diag_row(matrix: &[[i32; 5]; 5]) -> String {
+    let dimension = matrix.len();
+    let mut values = Vec::new();
+    for i in 0..dimension {
+        for j in 0..=i {
+            values.push(matrix[i][j].to_string());
+        }
+    }
+    format!("EDGE_WEIGHT_SECTION\n{}\n", values.join(" "))
+}
