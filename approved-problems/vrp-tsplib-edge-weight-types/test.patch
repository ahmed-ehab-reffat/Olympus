+
+    let problem = content.read_tsplib(false).expect("cannot read explicit problem");
+
+    let locations = problem.get_tsplib_locations().expect("expected display data locations");
+
+    assert_eq!(locations.len(), 5);
+    assert_eq!(
+        by_id(locations),
+        HashMap::from([
