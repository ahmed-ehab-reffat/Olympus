+// readRawHeaderBlock consumes the header block, terminated by a blank line or the end of input, and
+// returns it exactly as it arrived.
+func readRawHeaderBlock(r *bufio.Reader) ([]byte, error) {
+	var raw []byte
+	for {
+		line, err := r.ReadBytes('\n')
+		raw = append(raw, line...)
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				return raw, nil
+			}
+			return nil, errors.WithStack(err)
+		}
+		trimmed := bytes.TrimRight(line, "\r\n")
+		if len(trimmed) == 0 {
+			return raw, nil
+		}
+	}
+}
