+package enmime
+
+import (
+	"bytes"
+	"regexp"
+	"strings"
+
+	inttp "github.com/jhillyerd/enmime/v2/internal/textproto"
+	"github.com/jhillyerd/enmime/v2/mediatype"
+	"github.com/pkg/errors"
+)
+
+// Replace swaps this part's decoded content. The part is encoded afresh on the way out, everything
+// else in the message is left as it arrived.
+func (p *Part) Replace(content []byte) error {
+	if p == nil {
+		return errors.New("cannot replace content of a nil part")
+	}
+	if p.Boundary != "" {
+		return errors.New("cannot replace content of a multipart part")
+	}
+	named := strings.ToLower(inttp.MIMEHeader(p.Header).Get(hnContentEncoding))
+	switch named {
+	case "", cte7Bit, cte8Bit, cteBinary, cteQuotedPrintable, cteBase64:
+	default:
+		return errors.New("cannot re-encode a part whose header names transfer encoding " + named)
+	}
+	p.Content = append([]byte(nil), content...)
+	p.ContentReader = nil
+	p.markEdited()
+	return nil
+}
+
+// Remove detaches this part from its parent. Removing the last child of a multipart leaves that
+// multipart in place with nothing between its boundary markers.
+func (p *Part) Remove() error {
+	if p == nil {
+		return errors.New("cannot remove a nil part")
+	}
+	if p.Parent == nil {
+		return errors.New("cannot remove the root part")
+	}
+	parent := p.Parent
+	if parent.FirstChild == p {
+		parent.FirstChild = p.NextSibling
+	} else {
+		prev := parent.FirstChild
+		for prev != nil && prev.NextSibling != p {
+			prev = prev.NextSibling
+		}
+		if prev == nil {
+			return errors.New("part is not a child of its parent")
+		}
+		prev.NextSibling = p.NextSibling
+	}
+	p.Parent = nil
+	p.NextSibling = nil
+	parent.markEdited()
+	return nil
+}
+
+// AppendChild adds a part after this part's existing children.
+func (p *Part) AppendChild(child *Part) error {
+	if p == nil || child == nil {
+		return errors.New("cannot append a nil part")
+	}
+	if p.Boundary == "" {
+		return errors.New("cannot add a part to a part that is not multipart")
+	}
+	if p == child {
+		return errors.New("cannot add a part to itself")
+	}
+	child.Parent = p
+	child.NextSibling = nil
+	if p.FirstChild == nil {
+		p.FirstChild = child
+	} else {
+		last := p.FirstChild
+		for last.NextSibling != nil {
+			last = last.NextSibling
+		}
+		last.NextSibling = child
+	}
+	p.markEdited()
+	return nil
+}
+
+// InsertBefore adds a part immediately ahead of sibling, which must already be a child of this part.
+func (p *Part) InsertBefore(sibling, child *Part) error {
+	if p == nil || child == nil || sibling == nil {
+		return errors.New("cannot insert a nil part")
+	}
+	if p.Boundary == "" {
+		return errors.New("cannot add a part to a part that is not multipart")
+	}
+	if p.FirstChild == sibling {
+		child.Parent = p
+		child.NextSibling = sibling
+		p.FirstChild = child
+		p.markEdited()
+		return nil
+	}
+	prev := p.FirstChild
+	for prev != nil && prev.NextSibling != sibling {
+		prev = prev.NextSibling
+	}
+	if prev == nil {
+		return errors.New("sibling is not a child of this part")
+	}
+	child.Parent = p
+	child.NextSibling = sibling
+	prev.NextSibling = child
+	p.markEdited()
+	return nil
+}
+
+// SetHeader replaces a header field, or adds it at the end of the block when it was not present.
+// Every other header field keeps the place, the case and the folding it arrived with.
+func (p *Part) SetHeader(name, value string) error {
+	if p == nil {
+		return errors.New("cannot set a header on a nil part")
+	}
+	if err := checkHeaderName(name); err != nil {
+		return err
+	}
+	if err := checkHeaderValue(value); err != nil {
+		return err
+	}
+	if strings.EqualFold(name, hnContentType) {
+		framed, err := p.applyContentType(value)
+		if err != nil {
+			return err
+		}
+		value = framed
+	}
+	p.Header.Set(name, value)
+	p.markHeaderEdited()
+	return p.setRawHeader(name, value)
+}
+
+// DeleteHeader drops a header field. Every other header field is left as it arrived.
+func (p *Part) DeleteHeader(name string) error {
+	if p == nil {
+		return errors.New("cannot delete a header on a nil part")
+	}
+	if err := checkHeaderName(name); err != nil {
+		return err
+	}
+	if p.rawHeader == nil {
+		// A part that was built rather than parsed has no raw block to edit, only its header map.
+		if inttp.MIMEHeader(p.Header).Get(name) == "" {
+			return nil
+		}
+		p.Header.Del(name)
+		p.markHeaderEdited()
+		return nil
+	}
+	if !p.deleteRawHeader(name) {
+		return nil
+	}
+	p.Header.Del(name)
+	p.markHeaderEdited()
+	return nil
+}
+
+// checkHeaderName refuses a name that cannot be written as a header field.
+func checkHeaderName(name string) error {
+	if name == "" {
+		return errors.New("provide non-empty header name")
+	}
+	for _, c := range []byte(name) {
+		if !inttp.ValidEmailHeaderFieldByte(c) {
+			return errors.New("invalid header name " + name)
+		}
+	}
+	return nil
+}
+
+// applyContentType re-reads what a part reports from a Content-Type its caller wrote, so a
+// multipart is framed with the boundary its own header now names.
+func (p *Part) applyContentType(value string) (string, error) {
+	mtype, mparams, _, err := p.readMediaType(value)
+	if err != nil {
+		return "", errors.WithStack(err)
+	}
+	if kind, sub, ok := strings.Cut(mtype, "/"); !ok || kind == "" || sub == "" {
+		return "", errors.New("cannot read " + value + " as a content type")
+	}
+	frames := strings.HasPrefix(strings.ToLower(mtype), "multipart/")
+	if frames != (p.Boundary != "") {
+		// Turning a multipart into a leaf would strand its children, and the other way round would
+		// leave a body with no part to hold it.
+		return "", errors.New("cannot change whether a part is a multipart through " + hnContentType)
+	}
+	boundary := mparams[hpBoundary]
+	if frames && boundary == "" {
+		// A multipart still has to frame its parts, so it keeps the marker it is framed with and
+		// says so.
+		boundary = p.Boundary
+		mparams[hpBoundary] = boundary
+		value = value + "; " + hpBoundary + "=" + quoteParam(boundary)
+	}
+	p.ContentType = mtype
+	p.Charset = mparams[hpCharset]
+	p.Boundary = boundary
+	if p.ContentTypeParams != nil {
+		params := make(map[string]string, len(mparams))
+		for name, param := range mparams {
+			params[name] = param
+		}
+		p.ContentTypeParams = params
+	}
+	return value, nil
+}
+
+// quoteParam writes a parameter value the way this package writes one, quoted when it has to be.
+func quoteParam(value string) string {
+	if strings.ContainsAny(value, " \t;\"()<>@,:/[]?=") {
+		return `"` + value + `"`
+	}
+	return value
+}
+
+// readMediaType parses a media type with whatever parser this part was read by, or the package
+// default when it was built rather than parsed.
+func (p *Part) readMediaType(ctype string) (string, map[string]string, []string, error) {
+	if p.parser == nil {
+		return mediatype.Parse(ctype)
+	}
+	return p.parseMediaType(ctype)
+}
+
+// checkHeaderValue refuses a value that would not stay on the field line it is written to.
+func checkHeaderValue(value string) error {
+	if strings.ContainsAny(value, "\r\n") {
+		return errors.New("header value cannot be written on one line")
+	}
+	return nil
+}
+
+// markHeaderEdited records that this part's header block changed, and that every multipart above it
+// must be rebuilt. The part's own content is left alone.
+func (p *Part) markHeaderEdited() {
+	p.headerEdited = true
+	for parent := p.Parent; parent != nil; parent = parent.Parent {
+		parent.edited = true
+	}
+}
+
+// markEdited records that this part must be encoded afresh, and that every multipart above it must
+// be rebuilt.
+func (p *Part) markEdited() {
+	p.edited = true
+	for parent := p.Parent; parent != nil; parent = parent.Parent {
+		parent.edited = true
+	}
+}
+
+////////////////////////////////////////////////////////////////
+
+// headerFields splits a raw header block into its fields, each field holding its own continuation
+// lines, followed by the blank line that closes the block.
+func headerFields(raw []byte) (fields [][]byte, terminator []byte) {
+	lines := splitAfterNewline(raw)
+	for _, line := range lines {
+		trimmed := bytes.TrimRight(line, "\r\n")
+		if len(trimmed) == 0 {
+			terminator = append(terminator, line...)
+			continue
+		}
+		if 0 < len(fields) && (line[0] == ' ' || line[0] == '\t') {
+			fields[len(fields)-1] = append(fields[len(fields)-1], line...)
+			continue
+		}
+		fields = append(fields, append([]byte(nil), line...))
+	}
+	return fields, terminator
+}
+
+func splitAfterNewline(raw []byte) [][]byte {
+	var out [][]byte
+	for 0 < len(raw) {
+		i := bytes.IndexByte(raw, '\n')
+		if i < 0 {
+			out = append(out, raw)
+			break
+		}
+		out = append(out, raw[:i+1])
+		raw = raw[i+1:]
+	}
+	return out
+}
+
+func fieldName(field []byte) string {
+	i := bytes.IndexByte(field, ':')
+	if i < 0 {
+		return ""
+	}
+	return strings.ToLower(strings.TrimSpace(string(field[:i])))
+}
+
+func (p *Part) lineEnding() []byte {
+	if 0 < len(p.lineEnd) {
+		return p.lineEnd
+	}
+	return []byte("\r\n")
+}
+
+// setRawHeader edits the stored header block in place, so untouched fields keep their bytes.
+func (p *Part) setRawHeader(name, value string) error {
+	if p.rawHeader == nil {
+		return nil
+	}
+	fields, terminator := headerFields(p.rawHeader)
+	replacement := append([]byte(inttp.CanonicalEmailMIMEHeaderKey(name)+": "+value), p.lineEnding()...)
+	want := strings.ToLower(name)
+	found := false
+	var out []byte
+	for _, field := range fields {
+		if fieldName(field) == want {
+			if found {
+				continue
+			}
+			found = true
+			out = append(out, replacement...)
+			continue
+		}
+		out = append(out, field...)
+	}
+	if !found {
+		out = append(out, replacement...)
+	}
+	p.rawHeader = append(out, terminator...)
+	p.Header.Set(name, value)
+	return nil
+}
+
+// deleteRawHeader drops a field and its continuation lines from the stored header block. It reports
+// whether the block held that field at all.
+func (p *Part) deleteRawHeader(name string) bool {
+	if p.rawHeader == nil {
+		return false
+	}
+	fields, terminator := headerFields(p.rawHeader)
+	want := strings.ToLower(name)
+	found := false
+	var out []byte
+	for _, field := range fields {
+		if fieldName(field) == want {
+			found = true
+			continue
+		}
+		out = append(out, field...)
+	}
+	if !found {
+		return false
+	}
+	p.rawHeader = append(out, terminator...)
+	return true
+}
+
+// setRawBoundary points this multipart's Content-Type header at a new boundary, leaving the rest of
+// that header, and every other header, untouched.
+func (p *Part) setRawBoundary(boundary string) error {
+	old := p.Boundary
+	p.Boundary = boundary
+	if p.ContentTypeParams == nil {
+		p.ContentTypeParams = map[string]string{}
+	}
+	p.ContentTypeParams[hpBoundary] = boundary
+	if p.rawHeader == nil || old == "" {
+		return nil
+	}
+
+	p.setRawContentTypeParam(hpBoundary, boundary)
+	return nil
+}
+
+// paramPattern matches one named Content-Type parameter and its value, quoted or bare.
+func paramPattern(name string) *regexp.Regexp {
+	return regexp.MustCompile(`(?i)(^|[;\s])(` + regexp.QuoteMeta(name) + `[ \t]*=[ \t]*)("[^"]*"|[^;\s]+)`)
+}
+
+// replaceParam swaps the value of one parameter and nothing else, so a value that happens to appear
+// inside another parameter is left alone.
+func replaceParam(field []byte, name, next string) []byte {
+	re := paramPattern(name)
+	return re.ReplaceAllFunc(field, func(match []byte) []byte {
+		parts := re.FindSubmatch(match)
+		value := []byte(next)
+		if 0 < len(parts[3]) && parts[3][0] == '"' {
+			value = []byte(`"` + next + `"`)
+		}
+		out := append([]byte(nil), parts[1]...)
+		out = append(out, parts[2]...)
+		return append(out, value...)
+	})
+}
+
+// setRawContentTypeParam points one parameter of this part's Content-Type at a new value, leaving
+// the rest of that header, and every other header, untouched.
+func (p *Part) setRawContentTypeParam(name, value string) {
+	if p.rawHeader == nil {
+		return
+	}
+	fields, terminator := headerFields(p.rawHeader)
+	var out []byte
+	for _, field := range fields {
+		if fieldName(field) == strings.ToLower(hnContentType) {
+			field = replaceParam(field, name, value)
+			p.Header.Set(hnContentType, fieldValue(field))
+		}
+		out = append(out, field...)
+	}
+	p.rawHeader = append(out, terminator...)
+}
+
+// fieldValue reads back what a header field says, with the lines continuing it folded into one.
+func fieldValue(field []byte) string {
+	i := bytes.IndexByte(field, ':')
+	if i < 0 {
+		return ""
+	}
+	var parts []string
+	for _, line := range splitAfterNewline(field[i+1:]) {
+		if trimmed := strings.TrimSpace(string(line)); trimmed != "" {
+			parts = append(parts, trimmed)
+		}
+	}
+	return strings.Join(parts, " ")
+}
