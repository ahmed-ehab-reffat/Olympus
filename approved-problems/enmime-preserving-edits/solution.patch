--- /dev/null
+++ b/rewrite.go
@@ -0,0 +1,282 @@
+package enmime
+
+import (
+	"bufio"
+	"bytes"
+	"fmt"
+	"io"
+	"strings"
+
+	inttp "github.com/jhillyerd/enmime/v2/internal/textproto"
+	"github.com/pkg/errors"
+)
+
+// Rewrite writes this part and everything below it back out. Every part and every header that was
+// not changed since parsing is written exactly as it arrived; only what was changed is encoded
+// afresh.
+func (p *Part) Rewrite(w io.Writer) error {
+	if p == nil {
+		return errors.New("cannot rewrite a nil part")
+	}
+	buf, err := p.rewriteBytes()
+	if err != nil {
+		return err
+	}
+	n, err := w.Write(buf)
+	if err != nil {
+		return errors.WithStack(err)
+	}
+	if n < len(buf) {
+		// A writer that takes less than it was given without saying so still lost bytes.
+		return errors.WithStack(io.ErrShortWrite)
+	}
+	return nil
+}
+
+// Rewrite writes the envelope's message back out, preserving everything that was not changed.
+func (e *Envelope) Rewrite(w io.Writer) error {
+	if e == nil || e.Root == nil {
+		return errors.New("cannot rewrite a nil envelope")
+	}
+	return e.Root.Rewrite(w)
+}
+
+// rewriteBytes renders one part, header and body, into a buffer.
+func (p *Part) rewriteBytes() ([]byte, error) {
+	if p.rawHeader == nil {
+		// This part was built rather than parsed, so there is nothing to preserve. Building writes
+		// carriage returns whatever the message around it does, so its lines are retargeted.
+		var buf bytes.Buffer
+		if err := p.Encode(&buf); err != nil {
+			return nil, err
+		}
+		return retargetLineEndings(buf.Bytes(), p.messageLineEnding()), nil
+	}
+
+	if p.rawMessage != nil && !p.edited && !p.headerEdited {
+		return p.rawMessage, nil
+	}
+
+	body, err := p.rewriteBody()
+	if err != nil {
+		return nil, err
+	}
+	out := make([]byte, 0, len(p.rawHeader)+len(body))
+	out = append(out, p.rawHeader...)
+	return append(out, body...), nil
+}
+
+// rewriteBody renders a part's body: verbatim when nothing below it changed, rebuilt otherwise.
+func (p *Part) rewriteBody() ([]byte, error) {
+	if p.Boundary == "" {
+		if !p.edited && p.rawBody != nil {
+			return p.rawBody, nil
+		}
+		return p.freshContent()
+	}
+	return p.rewriteMultipart()
+}
+
+// freshContent encodes edited content using the transfer encoding this part's header names, or the
+// one the builder would pick when it names none.
+func (p *Part) freshContent() ([]byte, error) {
+	cte := te7Bit
+	named := strings.ToLower(inttp.MIMEHeader(p.Header).Get(hnContentEncoding))
+	switch named {
+	case cteBase64:
+		cte = teBase64
+	case cteQuotedPrintable:
+		cte = teQuoted
+	case cte8Bit:
+		cte = te8Bit
+	case cte7Bit:
+		cte = te7Bit
+	case cteBinary:
+		cte = teRaw
+	default:
+		cte = p.builderTransferEncoding()
+		if err := p.setRawHeader(hnContentEncoding, cteName(cte)); err != nil {
+			return nil, err
+		}
+	}
+
+	// The parser hands back content already decoded out of the part's character set, so the bytes
+	// written here are that decoding and the part has to say so.
+	if cs := p.Charset; cs != "" && !strings.EqualFold(cs, utf8) {
+		p.Charset = utf8
+		if p.ContentTypeParams != nil {
+			p.ContentTypeParams[hpCharset] = utf8
+		}
+		p.setRawContentTypeParam(hpCharset, utf8)
+	}
+
+	var buf bytes.Buffer
+	b := bufio.NewWriter(&buf)
+	if err := p.encodeContent(b, cte); err != nil {
+		return nil, err
+	}
+	if err := b.Flush(); err != nil {
+		return nil, errors.WithStack(err)
+	}
+	if cte == teBase64 || cte == teQuoted {
+		// The breaks these two put in are lines this rewrite is writing, not content.
+		return retargetLineEndings(buf.Bytes(), p.messageLineEnding()), nil
+	}
+	return buf.Bytes(), nil
+}
+
+// messageLineEnding reports the line ending the message holding this part arrived with.
+func (p *Part) messageLineEnding() []byte {
+	for at := p; at != nil; at = at.Parent {
+		if 0 < len(at.lineEnd) {
+			return at.lineEnd
+		}
+	}
+	return crnl
+}
+
+// retargetLineEndings moves freshly written lines onto the line ending the message uses.
+func retargetLineEndings(raw, le []byte) []byte {
+	if bytes.Equal(le, crnl) {
+		return raw
+	}
+	return bytes.ReplaceAll(raw, crnl, le)
+}
+
+// builderTransferEncoding picks the encoding building a message would pick for this content.
+func (p *Part) builderTransferEncoding() transferEncoding {
+	if len(p.Content) == 0 {
+		return te7Bit
+	}
+	if strings.HasPrefix(strings.ToLower(p.ContentType), "message/") {
+		return te8Bit
+	}
+	if p.TextContent() && p.ContentReader == nil {
+		return p.selectTransferEncoding(p.Content, false)
+	}
+	return teBase64
+}
+
+func cteName(cte transferEncoding) string {
+	switch cte {
+	case teBase64:
+		return cteBase64
+	case teQuoted:
+		return cteQuotedPrintable
+	case te8Bit:
+		return cte8Bit
+	}
+	return cte7Bit
+}
+
+// rewriteMultipart rebuilds a multipart body from its children, keeping the preamble, the epilogue
+// and the boundary it arrived with unless some child now contains that boundary.
+func (p *Part) rewriteMultipart() ([]byte, error) {
+	var children [][]byte
+	for c := p.FirstChild; c != nil; c = c.NextSibling {
+		b, err := c.rewriteBytes()
+		if err != nil {
+			return nil, err
+		}
+		children = append(children, b)
+	}
+
+	original := p.Boundary
+	// The markers on the wire carry the boundary this multipart was parsed with, which is not the
+	// one it names any more once a header edit has renamed it.
+	arrived := p.arrived
+	if arrived == "" {
+		arrived = original
+	}
+	// Everything this rebuild is about to emit: the parts themselves, this multipart's own header
+	// block, the bytes ahead of the first marker and the bytes after the closing one.
+	regions := append(append([][]byte{}, children...), p.rawHeader, p.preamble, p.Epilogue)
+
+	boundary := original
+	if boundaryCollides(boundary, regions) {
+		next, err := p.freeBoundary(regions)
+		if err != nil {
+			return nil, err
+		}
+		if err := p.setRawBoundary(next); err != nil {
+			return nil, err
+		}
+		boundary = next
+	}
+
+	// The separator is the one the markers themselves arrived with, which is not always the one the
+	// enclosing header used.
+	le := markerLineEnding(p.delimiter)
+	if len(le) == 0 {
+		le = p.lineEnd
+	}
+	if len(le) == 0 {
+		le = []byte("\r\n")
+	}
+	delim := append([]byte("--"), boundary...)
+
+	var out bytes.Buffer
+	out.Write(p.preamble)
+	for _, child := range children {
+		out.Write(delim)
+		out.Write(le)
+		out.Write(child)
+		// The reader takes exactly one line ending off a part when it reaches the next marker, so
+		// exactly one goes back.
+		out.Write(le)
+	}
+	if len(children) == 0 {
+		out.Write(delim)
+		out.Write(le)
+	}
+	out.Write(delim)
+	out.WriteString("--")
+	out.Write(closingTail(p.closeLine, arrived))
+	out.Write(p.Epilogue)
+	return out.Bytes(), nil
+}
+
+// markerLineEnding reports the line ending a captured marker line arrived with.
+func markerLineEnding(line []byte) []byte {
+	if bytes.HasSuffix(line, []byte("\r\n")) {
+		return []byte("\r\n")
+	}
+	if bytes.HasSuffix(line, []byte("\n")) {
+		return []byte("\n")
+	}
+	return nil
+}
+
+// closingTail returns whatever followed the closing marker on its own line, so the line ending it
+// arrived with is not lost when the marker itself has to change.
+func closingTail(closeLine []byte, boundary string) []byte {
+	marker := []byte("--" + boundary + "--")
+	if i := bytes.Index(closeLine, marker); 0 <= i {
+		return closeLine[i+len(marker):]
+	}
+	return nil
+}
+
+// boundaryCollides reports whether any region the rewrite emits opens a line with the boundary
+// marker, which is the only position a reader would take for a delimiter.
+func boundaryCollides(boundary string, regions [][]byte) bool {
+	marker := []byte("--" + boundary)
+	nlMarker := append([]byte("\n"), marker...)
+	for _, region := range regions {
+		if bytes.HasPrefix(region, marker) || bytes.Contains(region, nlMarker) {
+			return true
+		}
+	}
+	return false
+}
+
+// freeBoundary picks a marker that appears in none of the regions the rewrite is about to emit.
+func (p *Part) freeBoundary(regions [][]byte) (string, error) {
+	for i := 0; i < 1000; i++ {
+		candidate := fmt.Sprintf("%s_%d", p.Boundary, i)
+		if !boundaryCollides(candidate, regions) {
+			return candidate, nil
+		}
+	}
+	return "", errors.New("unable to find an unused boundary")
+}
