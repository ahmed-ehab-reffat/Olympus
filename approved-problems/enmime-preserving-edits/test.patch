+// rwEnvelope reads an envelope, and rwOutEnvelope writes one back out.
+func rwEnvelope(t *testing.T, raw string) *enmime.Envelope {
+	t.Helper()
+	e, err := enmime.ReadEnvelope(strings.NewReader(raw))
+	if err != nil {
+		t.Fatalf("envelope: %v", err)
+	}
+	return e
+}
+
+func rwOutEnvelope(t *testing.T, e *enmime.Envelope) string {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := e.Rewrite(&buf); err != nil {
+		t.Fatalf("rewrite: %v", err)
+	}
+	return buf.String()
+}
