+// truncatingWriter takes fewer bytes than it was handed and says nothing about it.
+type truncatingWriter struct {
+	limit int
+}
+
+func (w *truncatingWriter) Write(b []byte) (int, error) {
+	if w.limit < len(b) {
+		return w.limit, nil
+	}
+	return len(b), nil
+}
+
+// Coverage: a writer that quietly takes less than it was given may be reported either way, but the
+// message it was writing has to survive it, edited or not.
+func TestRewriteShortWriteWithoutAnErrorStillFails(t *testing.T) {
+	p := rwParse(t, rwCRLFMixed)
+	_ = p.Rewrite(&truncatingWriter{limit: 12})
+	rwRequireIdentical(t, rwOut(t, p), rwCRLFMixed)
+
+	edited := rwParse(t, rwCRLFMixed)
+	control := rwParse(t, rwCRLFMixed)
+	for _, at := range []*enmime.Part{edited, control} {
+		if err := rwChildren(at)[0].Replace([]byte("swapped")); err != nil {
+			t.Fatalf("replace: %v", err)
+		}
+	}
+	_ = edited.Rewrite(&truncatingWriter{limit: 30})
+	rwRequireIdentical(t, rwOut(t, edited), rwOut(t, control))
+
+	e := rwEnvelope(t, rwCRLFMixed)
+	_ = e.Rewrite(&truncatingWriter{limit: 12})
+	rwRequireIdentical(t, rwOutEnvelope(t, e), rwCRLFMixed)
+}
+
+// Coverage: a Content-Type that would turn a multipart into a leaf, or a leaf into a multipart, is
+// refused rather than stranding the children or the body, and refusing it changes nothing.
+func TestRewriteSetHeaderRefusesAKindChangingContentType(t *testing.T) {
+	p := rwParse(t, rwCRLFMixed)
+	before := rwOut(t, p)
+	kids := rwChildren(p)
+	for _, value := range []string{"text/plain", "text/plain; charset=utf-8", "message/rfc822"} {
+		if err := p.SetHeader("Content-Type", value); err == nil {
+			t.Errorf("a multipart accepted %q", value)
+		}
+	}
+	if p.Boundary != "BOUND" || p.ContentType != "multipart/mixed" {
+		t.Errorf("the multipart now reports %q with boundary %q", p.ContentType, p.Boundary)
+	}
+	if now := rwChildren(p); len(now) != len(kids) || now[0] != kids[0] {
+		t.Error("the children moved under a refused Content-Type")
+	}
+	rwRequireIdentical(t, rwOut(t, p), before)
+
+	leaf := kids[1]
+	leafBefore := rwOut(t, leaf)
+	for _, value := range []string{"multipart/mixed; boundary=\"NEW\"", "multipart/alternative; boundary=X"} {
+		if err := leaf.SetHeader("Content-Type", value); err == nil {
+			t.Errorf("a leaf accepted %q", value)
+		}
+	}
+	if leaf.Boundary != "" || leaf.ContentType != "text/plain" {
+		t.Errorf("the leaf now reports %q with boundary %q", leaf.ContentType, leaf.Boundary)
+	}
+	rwRequireIdentical(t, rwOut(t, leaf), leafBefore)
+	rwRequireIdentical(t, rwOut(t, p), before)
+	if err := leaf.SetHeader("Content-Type", "text/html"); err != nil {
+		t.Fatalf("a leaf refused a leaf type: %v", err)
+	}
+	rwRequireContains(t, rwOut(t, p), "Content-Type: text/html\r\n\r\nsecond\r\n")
+}
+
+// Coverage: a multipart handed a Content-Type of its own kind that names no boundary still has parts
+// to frame, so it keeps the marker it has and the header it writes says so.
+func TestRewriteSetHeaderMultipartWithoutABoundaryKeepsItsFraming(t *testing.T) {
+	p := rwParse(t, rwCRLFMixed)
+	kids := rwChildren(p)
+	if err := p.SetHeader("Content-Type", "multipart/digest"); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	if p.Boundary != "BOUND" {
+		t.Errorf("part reports boundary %q", p.Boundary)
+	}
+	if p.ContentType != "multipart/digest" {
+		t.Errorf("part reports content type %q", p.ContentType)
+	}
+	got := rwOut(t, p)
+	if n := countMarkerLines(got, "BOUND"); n != 3 {
+		t.Errorf("marker opens %d lines, want the 3 structural ones\n%q", n, got)
+	}
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+	if again.Boundary != "BOUND" {
+		t.Errorf("the header names boundary %q", again.Boundary)
+	}
+	if mt, _ := rwMediaType(t, again); mt != "multipart/digest" {
+		t.Errorf("content type came back as %q", mt)
+	}
+	now := rwChildren(again)
+	if len(now) != len(kids) {
+		t.Fatalf("want %d parts, got %d\n%q", len(kids), len(now), got)
+	}
+	if s := string(now[0].Content); s != "first" {
+		t.Errorf("first body is %q", s)
+	}
+	rwRequireContains(t, got, "preamble text\r\n")
+	rwRequireContains(t, got, "--BOUND--\r\nepilogue text\r\n")
+}
+
+// emittedRegions splits a serialized message into the regions a reader scans for delimiters: the
+// header block, the preamble, each part as it appears on the wire, and the epilogue.
+func emittedRegions(message, boundary string) []string {
+	var out []string
+	if at := strings.Index(message, "\r\n\r\n"); 0 <= at {
+		out = append(out, message[:at+4])
+		message = message[at+4:]
+	}
+	for _, region := range strings.Split(message, "--"+boundary) {
+		out = append(out, strings.TrimPrefix(strings.TrimPrefix(region, "--"), "\r\n"))
+	}
+	return out
+}
+
+// Coverage: a write that fails after the rebuild has already had to pick a new marker. Whatever it
+// settled on, the next write matches a message edited the same way and never written to a broken
+// writer, and the header names the marker the framing uses.
+func TestRewriteBoundaryRegenerationSurvivesAWriterFailure(t *testing.T) {
+	edited := rwParse(t, rwCRLFMixed)
+	if err := rwChildren(edited)[0].Replace([]byte("oops\r\n--BOUND\r\nstill mine")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	if err := edited.Rewrite(&shortWriter{limit: 40}); err == nil {
+		t.Fatal("a failing writer reported no error")
+	}
+	got := rwOut(t, edited)
+	rwRequireIdentical(t, rwOut(t, edited), got)
+
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+	if again.Boundary == "BOUND" {
+		t.Errorf("the colliding marker was kept\n%q", got)
+	}
+	if _, params := rwMediaType(t, again); params["boundary"] != again.Boundary {
+		t.Errorf("the header names boundary %q while the framing uses %q", params["boundary"], again.Boundary)
+	}
+	if n := countMarkerLines(got, again.Boundary); n != 3 {
+		t.Errorf("marker opens %d lines, want the 3 structural ones\n%q", n, got)
+	}
+	kids := rwChildren(again)
+	if len(kids) != 2 {
+		t.Fatalf("want 2 parts, got %d\n%q", len(kids), got)
+	}
+	if s := string(kids[0].Content); s != "oops\r\n--BOUND\r\nstill mine" {
+		t.Errorf("the replaced content came back as %q", s)
+	}
+}
+
+const rwDupContentType = "From: a@b.c\r\nX-Keep: one\r\n" +
+	"Content-Type: text/plain;\r\n charset=us-ascii\r\n" +
+	"Subject: folded\r\n neighbour\r\n" +
+	"Content-TYPE: text/html;\r\n\tcharset=iso-8859-1\r\n" +
+	"\r\nbody\r\n"
+
+// Coverage: a repeated Content-Type that folds obeys the ordinary repeat and continuation rules while
+// the fields the part reports follow the one value that is written, and a refused value moves neither.
+func TestRewriteRepeatedFoldedContentTypeFieldsCollapseAtomically(t *testing.T) {
+	p := rwParse(t, rwDupContentType)
+	before := rwOut(t, p)
+	for _, refused := range []string{"multipart/mixed; boundary=X", "not a media type", "text/plain\r\nX-Smuggled: yes"} {
+		if err := p.SetHeader("Content-Type", refused); err == nil {
+			t.Errorf("SetHeader accepted %q", refused)
+		}
+	}
+	if p.ContentType != "text/plain" || !strings.EqualFold(p.Charset, "us-ascii") {
+		t.Errorf("a refused value moved the reported fields to %q and %q", p.ContentType, p.Charset)
+	}
+	rwRequireIdentical(t, rwOut(t, p), before)
+
+	if err := p.SetHeader("content-type", "text/html; charset=utf-8"); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	if p.ContentType != "text/html" || !strings.EqualFold(p.Charset, "utf-8") {
+		t.Errorf("the part reports %q and %q", p.ContentType, p.Charset)
+	}
+	want := "From: a@b.c\r\nX-Keep: one\r\n" +
+		"Content-Type: text/html; charset=utf-8\r\n" +
+		"Subject: folded\r\n neighbour\r\n" +
+		"\r\nbody\r\n"
+	rwRequireIdentical(t, rwOut(t, p), want)
+
+	gone := rwParse(t, rwDupContentType)
+	if err := gone.DeleteHeader("CONTENT-type"); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+	wantGone := "From: a@b.c\r\nX-Keep: one\r\n" +
+		"Subject: folded\r\n neighbour\r\n" +
+		"\r\nbody\r\n"
+	rwRequireIdentical(t, rwOut(t, gone), wantGone)
+	if v := gone.Header.Get("Content-Type"); v != "" {
+		t.Errorf("the part still reports the field as %q", v)
+	}
+}
+
+// This corpus sweep is last on purpose: it feeds every fixture in the repository through Rewrite,
+// so an implementation that panics on one of them loses only this result rather than the whole run.
+func TestRewriteUntouchedIsIdenticalAcrossCorpus(t *testing.T) {
+	files, err := filepath.Glob("../testdata/mail/*.raw")
+	if err != nil {
+		t.Fatalf("glob: %v", err)
+	}
+	if len(files) == 0 {
+		t.Skip("no mail corpus to walk")
+	}
+	checked := 0
+	for _, f := range files {
+		raw, err := os.ReadFile(f)
+		if err != nil {
+			t.Fatalf("read %s: %v", f, err)
+		}
+		p, err := enmime.ReadParts(bytes.NewReader(raw))
+		if err != nil {
+			continue
+		}
+		var buf bytes.Buffer
+		if err := p.Rewrite(&buf); err != nil {
+			t.Errorf("%s: rewrite: %v", filepath.Base(f), err)
+			continue
+		}
+		if !bytes.Equal(buf.Bytes(), raw) {
+			t.Errorf("%s: not byte identical, in=%d out=%d", filepath.Base(f), len(raw), buf.Len())
+		}
+		checked++
+	}
+	if checked == 0 {
+		t.Fatal("no fixture in the mail corpus parsed")
+	}
+}
+
+const rwToleratedLines = "X-Edit: old\n" +
+	": bare colon\n" +
+	"Bad Name: spaced\n" +
+	"X-Keep:  two spaces after the colon\n" +
+	"\nbody\n"
+
+// A header block can hold lines the parser tolerates without reading them as fields. They were not
+// edited, so they are written back exactly where they were, whichever field the edit touched.
+func TestRewriteHeaderEditKeepsToleratedLines(t *testing.T) {
+	p := rwParse(t, rwToleratedLines)
+	rwRequireIdentical(t, rwOut(t, p), rwToleratedLines)
+
+	if err := p.SetHeader("X-Edit", "new"); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	want := "X-Edit: new\n" +
+		": bare colon\n" +
+		"Bad Name: spaced\n" +
+		"X-Keep:  two spaces after the colon\n" +
+		"\nbody\n"
+	rwRequireIdentical(t, rwOut(t, p), want)
+
+	added := rwParse(t, rwToleratedLines)
+	if err := added.SetHeader("X-New", "yes"); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	wantAdded := "X-Edit: old\n" +
+		": bare colon\n" +
+		"Bad Name: spaced\n" +
+		"X-Keep:  two spaces after the colon\n" +
+		"X-New: yes\n" +
+		"\nbody\n"
+	rwRequireIdentical(t, rwOut(t, added), wantAdded)
+
+	dropped := rwParse(t, rwToleratedLines)
+	if err := dropped.DeleteHeader("X-Keep"); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+	wantDropped := "X-Edit: old\n" +
+		": bare colon\n" +
+		"Bad Name: spaced\n" +
+		"\nbody\n"
+	rwRequireIdentical(t, rwOut(t, dropped), wantDropped)
+}
+
+// A parsed part carries the framing it arrived in. Moved into another multipart it belongs to its new
+// parent, so it is written between that parent's markers and leaves the old ones behind.
+func TestRewriteMovedPartIsFramedByItsNewParent(t *testing.T) {
+	source := rwParse(t, "Content-Type: multipart/mixed; boundary=\"a\"\r\n\r\n"+
+		"--a\r\nContent-Type: text/plain\r\n\r\nstay\r\n"+
+		"--a\r\nContent-Type: text/plain\r\n\r\nmove\r\n"+
+		"--a--\r\n")
+	destination := rwParse(t, "Content-Type: multipart/mixed; boundary=\"b\"\r\n\r\n"+
+		"--b\r\nContent-Type: text/plain\r\n\r\nhome\r\n"+
+		"--b--\r\n")
+
+	moving := rwChildren(source)[1]
+	if err := moving.Remove(); err != nil {
+		t.Fatalf("remove: %v", err)
+	}
+	if err := destination.AppendChild(moving); err != nil {
+		t.Fatalf("append: %v", err)
+	}
+
+	got := rwOut(t, destination)
+	if strings.Contains(got, "--a") {
+		t.Errorf("the moved part kept a marker from where it came\n%q", got)
+	}
+	if n := countMarkerLines(got, "b"); n != 3 {
+		t.Errorf("marker opens %d lines, want the 3 structural ones\n%q", n, got)
+	}
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("the message it joined no longer parses: %v\n%q", err, got)
+	}
+	kids := rwChildren(again)
+	if len(kids) != 2 {
+		t.Fatalf("want 2 parts, got %d\n%q", len(kids), got)
+	}
+	if s := string(kids[0].Content); s != "home" {
+		t.Errorf("first body is %q", s)
+	}
+	if s := string(kids[1].Content); s != "move" {
+		t.Errorf("the moved body is %q", s)
+	}
+
+	left := rwOut(t, source)
+	if strings.Contains(left, "move") {
+		t.Errorf("the moved part is still in the message it left\n%q", left)
+	}
+	back, err := enmime.ReadParts(strings.NewReader(left))
+	if err != nil {
+		t.Fatalf("the message it left no longer parses: %v\n%q", err, left)
+	}
+	if n := len(rwChildren(back)); n != 1 {
+		t.Errorf("want 1 part left behind, got %d\n%q", n, left)
+	}
+}
