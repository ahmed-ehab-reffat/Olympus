+	}
+	if err := e.Rewrite(&shortWriter{limit: 10}); err == nil {
+		t.Error("Envelope.Rewrite reported success on a writer that failed")
+	}
+	var envelope bytes.Buffer
+	if err := e.Rewrite(&envelope); err != nil {
+		t.Errorf("Envelope.Rewrite still failing after a bad writer: %v", err)
+	}
+	rwRequireIdentical(t, envelope.String(), rwCRLFMixed)
+}
