+// Coverage: a part taken out of the middle of a chain keeps no pointer to what it sat between, and
+// the two it sat between find each other.
+func TestRewriteRemovedPartKeepsNoLinkToItsOldChain(t *testing.T) {
+	p := rwParse(t, rwThreeDeep)
+	kids := rwChildren(p)
+	middle := kids[1]
+	if err := middle.Remove(); err != nil {
+		t.Fatalf("remove: %v", err)
+	}
+	if middle.Parent != nil {
+		t.Error("the removed part still points at its old parent")
+	}
+	if middle.NextSibling != nil {
+		t.Error("the removed part still points at its old sibling")
+	}
+	if kids[0].NextSibling != kids[2] {
+		t.Error("the parts it sat between did not find each other")
+	}
+	left := rwChildren(p)
+	if len(left) != 2 || left[0] != kids[0] || left[1] != kids[2] {
+		t.Fatalf("the chain walks to %d children", len(left))
+	}
+	got := rwOut(t, p)
+	if strings.Contains(got, "nested one") || strings.Contains(got, "nested two") {
+		t.Errorf("the removed part is still on the wire\n%q", got)
+	}
+	if err := p.AppendChild(middle); err != nil {
+		t.Fatalf("append back: %v", err)
+	}
+	if middle.Parent != p || middle.NextSibling != nil {
+		t.Error("the part did not link back in cleanly")
+	}
+	if n := len(rwChildren(rwParse(t, rwOut(t, p)))); n != 3 {
+		t.Errorf("want 3 parts on the wire after adding it back, got %d", n)
+	}
+}
