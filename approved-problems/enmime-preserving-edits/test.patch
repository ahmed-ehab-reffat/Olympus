+// An edit anywhere must not send the parts that were not edited back through the encoder: their
+// soft line breaks and their base64 line lengths are theirs to keep.
+func TestRewriteEditDoesNotReflowEncodedSiblings(t *testing.T) {
+	p := rwParse(t, rwEncodedSiblings)
+	if err := rwChildren(p)[0].Replace([]byte("edited")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	got := rwOut(t, p)
+	rwRequireContains(t, got, "soft=\r\nbreak and a=3Dsign")
+	rwRequireContains(t, got, "aGVs\r\nbG8g\r\nd29ybGQ=")
+	rwRequireContains(t, got, "X-Odd-CASE: kept\r\nContent-Transfer-Encoding: quoted-printable\r\n")
+}
+
+// Editing a part's content is not licence to rewrite that part's header block.
+func TestRewriteEditedPartKeepsItsOwnHeaderBytes(t *testing.T) {
