+		t.Fatalf("insert: %v", err)
+	}
+	linked := rwChildren(p)
+	if len(linked) != 4 || linked[1] != child {
+		t.Fatalf("in-memory chain is wrong: %d children, index 1 is not the new part", len(linked))
+	}
+	if child.Parent != p || child.NextSibling != kids[1] || linked[0].NextSibling != child {
+		t.Error("Parent/NextSibling links were not repaired")
+	}
+	again := rwChildren(rwParse(t, rwOut(t, p)))
+	if len(again) != 4 {
+		t.Fatalf("want 4 parts on the wire, got %d", len(again))
+	}
