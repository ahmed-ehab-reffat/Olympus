+// Coverage: a Content-Type that cannot be read is refused, and refusing it leaves what the part
+// reports, the parts under it and every byte it writes exactly as they were.
+func TestRewriteSetHeaderRefusesAContentTypeItCannotRead(t *testing.T) {
+	for _, value := range []string{"not a media type", "nonsense", "text plain"} {
+		{
+			p := rwParse(t, rwCRLFMixed)
+			before := rwOut(t, p)
+			kids := rwChildren(p)
+			if err := p.SetHeader("Content-Type", value); err == nil {
+				t.Errorf("SetHeader accepted %q", value)
+			}
+			if p.ContentType != "multipart/mixed" {
+				t.Errorf("part reports content type %q after refusing %q", p.ContentType, value)
+			}
+			if p.Boundary != "BOUND" {
+				t.Errorf("part reports boundary %q after refusing %q", p.Boundary, value)
+			}
+			if now := rwChildren(p); len(now) != len(kids) || now[0] != kids[0] {
+				t.Errorf("the tree changed under a refused Content-Type %q", value)
+			}
+			got := rwOut(t, p)
+			if got != before || got != rwCRLFMixed {
+				t.Errorf("a refused Content-Type changed the message for %q:\n%q", value, got)
+			}
+			if _, err := enmime.ReadParts(strings.NewReader(got)); err != nil {
+				t.Fatalf("message no longer parses: %v", err)
+			}
+		}
+	}
+}
