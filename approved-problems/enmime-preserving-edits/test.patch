+		"--BOUND\r\nContent-Type: text/plain\r\n\r\ninnocent\r\n--BOUND_0 bystander\r\n" +
+		"--BOUND--\r\n"
+	p := rwParse(t, raw)
+	if err := rwChildren(p)[0].Replace([]byte("oops\r\n--BOUND\r\nstill mine")); err != nil {
