+// openLinesWith reports whether the marker begins any line of the region, which is the only place a
+// reader takes it for a delimiter.
+func openLinesWith(region []byte, boundary string) bool {
+	marker := []byte("--" + boundary)
+	return bytes.HasPrefix(region, marker) || bytes.Contains(region, append([]byte("\n"), marker...))
+}
+
+// rwMediaType parses a part's Content-Type into its media type and parameters.
+func rwMediaType(t *testing.T, p *enmime.Part) (string, map[string]string) {
+	t.Helper()
+	mt, params, err := mime.ParseMediaType(p.Header.Get("Content-Type"))
+	if err != nil {
+		t.Fatalf("Content-Type did not parse: %v", err)
+	}
+	return mt, params
+}
+
+// countMarkerLines counts the lines of the serialized message that open with the marker.
+func countMarkerLines(message, boundary string) int {
+	n := 0
+	for _, line := range strings.Split(message, "\n") {
+		if strings.HasPrefix(strings.TrimSuffix(line, "\r"), "--"+boundary) {
+			n++
+		}
+	}
+	return n
+}
