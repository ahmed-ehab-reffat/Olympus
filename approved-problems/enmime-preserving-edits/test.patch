+// shortWriter fails once more than limit bytes have been offered.
+type shortWriter struct {
+	limit   int
+	written int
+}
+
+func (w *shortWriter) Write(b []byte) (int, error) {
+	if w.limit <= w.written {
+		return 0, errWriterFull
+	}
+	n := len(b)
+	if room := w.limit - w.written; room < n {
+		n = room
+	}
+	w.written += n
+	if n < len(b) {
+		return n, errWriterFull
+	}
+	return n, nil
+}
