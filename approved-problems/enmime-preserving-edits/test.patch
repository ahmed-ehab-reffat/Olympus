+	close := strings.Index(got, "--BOUND--")
+	if open < 0 || close < open {
+		t.Fatalf("markers are missing or out of order: %q", got)
+	}
+	if between := got[open+len("--BOUND\r\n") : close]; between != "" {
+		t.Errorf("bytes appeared between the markers: %q", between)
