+	if err := p.Rewrite(&shortWriter{limit: 10}); err == nil {
+		t.Error("Part.Rewrite reported success on a writer that failed")
+	}
+	// A failed write is not sticky: the next one over a working writer succeeds and writes the same
+	// message it would have written all along.
+	var buf bytes.Buffer
+	if err := p.Rewrite(&buf); err != nil {
