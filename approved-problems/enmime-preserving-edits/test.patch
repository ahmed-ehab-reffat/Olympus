+// Coverage: an envelope whose write fails part way is left alone too, so the next write over a
+// working writer matches an envelope edited the same way and never written to a broken one.
+func TestRewriteEnvelopeAfterAWriterFailureIsUnchanged(t *testing.T) {
+	e := rwEnvelope(t, rwCRLFMixed)
+	if err := e.Rewrite(&shortWriter{limit: 10}); err == nil {
+		t.Fatal("a failing writer reported no error")
+	}
+	rwRequireIdentical(t, rwOutEnvelope(t, e), rwCRLFMixed)
+
+	edited := rwEnvelope(t, rwCRLFMixed)
+	control := rwEnvelope(t, rwCRLFMixed)
+	for _, at := range []*enmime.Envelope{edited, control} {
+		if err := rwChildren(at.Root)[1].Replace([]byte("envelope swapped")); err != nil {
+			t.Fatalf("replace: %v", err)
+		}
+		if err := at.Root.SetHeader("X-Envelope", "yes"); err != nil {
+			t.Fatalf("set: %v", err)
+		}
+	}
+	if err := edited.Rewrite(&shortWriter{limit: 24}); err == nil {
+		t.Fatal("a failing writer reported no error after an edit")
+	}
+	got := rwOutEnvelope(t, edited)
+	rwRequireIdentical(t, got, rwOutEnvelope(t, control))
+	rwRequireContains(t, got, "X-Envelope: yes\r\n")
+	rwRequireContains(t, got, "\r\n\r\nenvelope swapped\r\n")
+	if n := len(rwChildren(rwParse(t, got))); n != 2 {
+		t.Errorf("want 2 parts on the wire, got %d\n%q", n, got)
+	}
+}
