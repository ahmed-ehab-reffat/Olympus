+// Coverage: the breaks an encoder puts into a replaced body are lines the rewrite writes, so they
+// follow the message too.
+func TestRewriteEncodedReplacementFollowsTheMessageLineEnding(t *testing.T) {
+	raw := "MIME-Version: 1.0\nContent-Type: multipart/mixed; boundary=\"LF\"\n\n" +
+		"--LF\nContent-Type: text/plain\nContent-Transfer-Encoding: base64\n\nZmlyc3Q=\n" +
+		"--LF\nContent-Type: text/plain\nContent-Transfer-Encoding: quoted-printable\n\nsecond\n" +
+		"--LF--\n"
+	for _, at := range []int{0, 1} {
+		{
+			p := rwParse(t, raw)
+			body := []byte(strings.Repeat("wide enough to wrap ", 12))
+			if err := rwChildren(p)[at].Replace(body); err != nil {
+				t.Fatalf("replace %d: %v", at, err)
+			}
+			got := rwOut(t, p)
+			if strings.Contains(got, "\r") {
+				t.Errorf("a carriage return reached an LF only message at %d\n%q", at, got)
+			}
+			again, err := enmime.ReadParts(strings.NewReader(got))
+			if err != nil {
+				t.Fatalf("rewritten message no longer parses at %d: %v\n%q", at, err, got)
+			}
+			kids := rwChildren(again)
+			if len(kids) != 2 {
+				t.Fatalf("want 2 parts, got %d\n%q", len(kids), got)
+			}
+			if !bytes.Equal(kids[at].Content, body) {
+				t.Errorf("replaced body at %d came back as %q", at, kids[at].Content)
+			}
+		}
+	}
+}
