+	if firstMarker < 0 {
+		t.Fatalf("no opening marker in %q", got)
+	}
+	headerEnd := strings.Index(got, "\r\n\r\n") + len("\r\n\r\n")
+	gotPreamble := got[headerEnd:firstMarker]
+	gotPreamble = strings.TrimSuffix(strings.TrimSuffix(gotPreamble, "\r\n"), "\n")
+	if gotPreamble != "  preamble with trailing spaces   \n\n\tand a tab line" {
+		t.Errorf("preamble whitespace was not preserved: %q", gotPreamble)
+	}
+
+	closing := strings.LastIndex(got, "--ODD--")
+	if closing < 0 {
+		t.Fatalf("no closing marker in %q", got)
+	}
+	tail := got[closing+len("--ODD--"):]
+	tail = strings.TrimPrefix(strings.TrimPrefix(tail, "\r\n"), "\n")
+	if tail != "   epilogue with spaces   \n\n" {
+		t.Errorf("epilogue was not preserved byte for byte: %q", tail)
+	}
+}
