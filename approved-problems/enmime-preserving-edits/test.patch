+// Coverage: an insert in the middle of the sibling chain, checked in memory and on the wire.
+func TestRewriteInsertBeforeAMiddleSiblingRelinksAndReorders(t *testing.T) {
+	p := rwParse(t, rwThreeDeep)
+	kids := rwChildren(p)
+	if len(kids) != 3 {
+		t.Fatalf("fixture has %d children", len(kids))
+	}
+	child := enmime.NewPart("text/plain")
+	if err := child.Replace([]byte("wedged")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
