+// The only lines that may open with the chosen marker are the structural ones. A mid-line
+// occurrence is covered separately by the whole-wire-image test below.
+func TestRewriteChosenBoundaryAppearsOnlyOnStructuralLines(t *testing.T) {
+	raw := "From: a@b.c\r\nMIME-Version: 1.0\r\n" +
+		"Content-Type: multipart/mixed; boundary=\"BOUND\"\r\n\r\n" +
+		"preamble\r\n--BOUND_0 here\r\n" +
+		"--BOUND\r\nContent-Type: text/plain\r\n\r\nedit me\r\n" +
+		"--BOUND\r\nX-Note: --BOUND_1 in a header\r\nContent-Transfer-Encoding: base64\r\n" +
+		"Content-Type: text/plain\r\n\r\nLS1CT1VORF8yIGluIGEgYm9keQ==\r\n" +
+		"--BOUND--\r\nepilogue\r\n--BOUND_3 here\r\n"
+	p := rwParse(t, raw)
+	if err := rwChildren(p)[0].Replace([]byte("oops\r\n--BOUND\r\nstill mine")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	got := rwOut(t, p)
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+	if n := len(rwChildren(again)); n != 2 {
+		t.Fatalf("want 2 parts, got %d\n%q", n, got)
+	}
+	// Two delimiters and one terminator, and nothing else may open with the marker.
+	if n := countMarkerLines(got, again.Boundary); n != 3 {
+		t.Errorf("marker %q opens %d lines, want exactly 3 structural ones\n%q", again.Boundary, n, got)
+	}
