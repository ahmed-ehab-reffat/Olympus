+	again, err := enmime.ReadParts(strings.NewReader(first))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, first)
+	}
+	if v := again.Header.Get("X-Empty"); v != "" {
+		t.Errorf("reparsed field reads %q", v)
+	}
+	if v := again.Header.Get("Subject"); v != "a very long subject that wraps here" {
+		t.Errorf("the folded neighbour reads %q", v)
+	}
+}
+
+// Coverage: a boundary the caller names through Content-Type is subject to the same collision rule
+// as one the message arrived with.
+func TestRewriteSetHeaderBoundaryThatCollidesIsRegenerated(t *testing.T) {
+	raw := "From: a@b.c\r\nContent-Type: multipart/mixed; boundary=\"START\"\r\n\r\n" +
+		"--START\r\nContent-Type: text/plain\r\n\r\nfirst\r\n" +
+		"--START\r\nContent-Type: text/plain\r\n\r\nquoting\r\n--COLLIDE\r\nin a body\r\n" +
+		"--START--\r\n"
+	p := rwParse(t, raw)
+	if err := p.SetHeader("Content-Type", "multipart/mixed; boundary=\"COLLIDE\"; type=\"X-Keep\""); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	if p.Boundary != "COLLIDE" {
+		t.Fatalf("part reports boundary %q before the rewrite", p.Boundary)
+	}
+	got := rwOut(t, p)
+	if p.Boundary == "COLLIDE" {
+		t.Error("the part still reports the colliding boundary after the rewrite")
+	}
+	if strings.Contains(got, "--START") {
+		t.Errorf("output is still framed with the old marker\n%q", got)
+	}
+	if n := countMarkerLines(got, p.Boundary); n != 3 {
+		t.Errorf("marker %q opens %d lines, want the 3 structural ones\n%q", p.Boundary, n, got)
+	}
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+	if again.Boundary != p.Boundary {
+		t.Errorf("the header names %q while the part reports %q", again.Boundary, p.Boundary)
+	}
+	mt, params := rwMediaType(t, again)
+	if mt != "multipart/mixed" || params["type"] != "X-Keep" {
+		t.Errorf("content type came back as %q %v", mt, params)
+	}
+	kids := rwChildren(again)
+	if len(kids) != 2 {
+		t.Fatalf("want 2 parts, got %d\n%q", len(kids), got)
+	}
+	if s := string(kids[1].Content); s != "quoting\r\n--COLLIDE\r\nin a body" {
+		t.Errorf("the quoting body came back as %q", s)
+	}
+}
