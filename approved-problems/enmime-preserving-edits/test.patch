+	got := rwOut(t, inner)
+	rwSubtree(t, got, want)
+	if strings.Contains(got, "nested two") {
+		t.Errorf("the removed child is still in the subtree\n%q", got)
+	}
+
+	whole := rwOut(t, p)
+	rwRequireContains(t, whole, "--OUT\r\nContent-Type: text/plain\r\n\r\nalpha\r\n")
+	tail := whole[strings.Index(whole, "--INNER--")+len("--INNER--"):]
+	tail = strings.TrimPrefix(strings.TrimPrefix(tail, "\r\n"), "\r\n")
+	rwRequireContains(t, tail, "--OUT\r\nContent-Type: text/plain\r\n\r\nomega\r\n--OUT--\r\n")
+	again, err := enmime.ReadParts(strings.NewReader(whole))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, whole)
+	}
+	if n := len(rwChildren(again)); n != 3 {
+		t.Errorf("want 3 outer parts, got %d\n%q", n, whole)
+	}
+	if n := len(rwChildren(rwChildren(again)[1])); n != 1 {
+		t.Errorf("want 1 inner part, got %d\n%q", n, whole)
+	}
+}
