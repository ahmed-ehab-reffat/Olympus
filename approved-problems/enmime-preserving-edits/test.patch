+// Coverage: asked of a child that was itself edited, Rewrite still writes that child alone and
+// still leaves the line ending ahead of the next marker to that marker.
+func TestRewriteOnAnEditedChildSerializesThatChildAlone(t *testing.T) {
+	raw := "Content-Type: multipart/mixed; boundary=\"BOUND\"\r\n\r\n" +
+		"--BOUND\r\nContent-Type: text/plain\r\n\r\nfirst\r\n" +
+		"--BOUND\r\nContent-Type: text/plain\r\nX-Gone: bye\r\n\r\nsecond\r\n" +
+		"--BOUND--\r\n"
+	p := rwParse(t, raw)
+	kids := rwChildren(p)
+	if err := kids[0].Replace([]byte("swapped")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	if err := kids[1].SetHeader("X-Tag", "on"); err != nil {
+		t.Fatalf("set: %v", err)
+	}
+	if err := kids[1].DeleteHeader("X-Gone"); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+
+	added := rwOut(t, kids[0])
+	block, body, ok := strings.Cut(added, "\r\n\r\n")
+	if !ok {
+		t.Fatalf("the replaced child alone has no header block: %q", added)
+	}
+	if got := strings.TrimSuffix(strings.TrimSuffix(body, "\r\n"), "\n"); got != "swapped" {
+		t.Errorf("replaced child body is %q", got)
+	}
+	fields := strings.Split(block, "\r\n")
+	sort.Strings(fields)
+	if len(fields) != 2 || fields[1] != "Content-Type: text/plain" {
+		t.Errorf("the replaced child alone carries %q", fields)
+	}
+	cte, _, _ := strings.Cut(fields[0], ": ")
+	if cte != "Content-Transfer-Encoding" {
+		t.Errorf("the added field is %q", fields[0])
+	}
+	if !strings.Contains("7bit 8bit binary quoted-printable base64", strings.TrimPrefix(fields[0], "Content-Transfer-Encoding: ")) {
+		t.Errorf("the added encoding is not one this package writes: %q", fields[0])
+	}
+	rwSubtree(t, rwOut(t, kids[1]), "Content-Type: text/plain\r\nX-Tag: on\r\n\r\nsecond")
+}
