+// Coverage: a header dropped from a part that was built rather than parsed is gone from what that
+// part writes, the same as it would be for a parsed one.
+func TestRewriteDeleteHeaderOnABuiltPartDropsIt(t *testing.T) {
+	p := rwParse(t, rwCRLFMixed)
+	fresh := enmime.NewPart("text/plain")
+	if err := fresh.Replace([]byte("fresh body")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	fresh.Header.Set("X-Gone", "bye")
+	if err := p.AppendChild(fresh); err != nil {
+		t.Fatalf("append: %v", err)
+	}
+	if err := fresh.DeleteHeader("x-GONE"); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+	if v := fresh.Header.Get("X-Gone"); v != "" {
+		t.Errorf("the part still reports the field as %q", v)
+	}
+	got := rwOut(t, p)
+	if strings.Contains(got, "X-Gone") || strings.Contains(got, "bye") {
+		t.Errorf("the deleted field is still on the wire\n%q", got)
+	}
+	rwRequireContains(t, got, "fresh body")
+	if _, err := enmime.ReadParts(strings.NewReader(got)); err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+}
