+// Coverage: a multipart emptied of every child and then given one back has to leave the two-marker
+// empty form behind and frame the new child normally.
+func TestRewriteEmptiedMultipartRecoversWhenAChildIsAddedBack(t *testing.T) {
+	for _, how := range []string{"append", "insert"} {
+		{
+			p := rwParse(t, rwCRLFMixed)
+			kept := rwChildren(p)[0]
+			for _, c := range rwChildren(p) {
+				if err := c.Remove(); err != nil {
+					t.Fatalf("%s: remove: %v", how, err)
+				}
+			}
+			if n := len(rwChildren(p)); n != 0 {
+				t.Fatalf("%s: multipart still holds %d children", how, n)
+			}
+			fresh := enmime.NewPart("text/plain")
+			if err := fresh.Replace([]byte("returned")); err != nil {
+				t.Fatalf("replace: %v", err)
+			}
+			var err error
+			if how == "append" {
+				err = p.AppendChild(fresh)
+			} else {
+				// Nothing to insert before once emptied, so append then insert ahead of it.
+				if err = p.AppendChild(kept); err != nil {
+					t.Fatalf("%s: seed: %v", how, err)
+				}
+				err = p.InsertBefore(kept, fresh)
+			}
+			if err != nil {
+				t.Fatalf("%s: add: %v", how, err)
+			}
+
+			got := rwOut(t, p)
+			if strings.Contains(got, "--BOUND\r\n--BOUND--") {
+				t.Errorf("%s: the empty marker pair survived the new child\n%q", how, got)
+			}
+			again, err := enmime.ReadParts(strings.NewReader(got))
+			if err != nil {
+				t.Fatalf("%s: rewritten message no longer parses: %v\n%q", how, err, got)
+			}
+			kids := rwChildren(again)
+			want := 1
+			if how == "insert" {
+				want = 2
+			}
+			if len(kids) != want {
+				t.Fatalf("%s: want %d parts, got %d\n%q", how, want, len(kids), got)
+			}
+			if !strings.Contains(string(kids[0].Content), "returned") {
+				t.Errorf("%s: the new child landed wrong: %q", how, string(kids[0].Content))
+			}
+			if n := countMarkerLines(got, "BOUND"); n != want+1 {
+				t.Errorf("%s: marker opens %d lines, want %d\n%q", how, n, want+1, got)
+			}
+		}
+	}
+}
