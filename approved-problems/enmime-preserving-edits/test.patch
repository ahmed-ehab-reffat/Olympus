+// rwSubtree compares a part-scoped rewrite, allowing the trailing separator that follows the part to be
+// present or absent: it belongs to the marker, and either choice describes the same part.
+func rwSubtree(t *testing.T, got, want string) {
+	t.Helper()
+	trimmed := strings.TrimSuffix(strings.TrimSuffix(got, "\r\n"), "\n")
+	if trimmed != want {
+		t.Errorf("part-scoped rewrite:\n got: %q\nwant: %q", got, want)
+	}
+}
+
+func rwParse(t *testing.T, raw string) *enmime.Part {
+	t.Helper()
+	p, err := enmime.ReadParts(strings.NewReader(raw))
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	return p
+}
+
+func rwOut(t *testing.T, p *enmime.Part) string {
+	t.Helper()
+	var buf bytes.Buffer
+	if err := p.Rewrite(&buf); err != nil {
+		t.Fatalf("rewrite: %v", err)
+	}
+	return buf.String()
+}
+
+func rwChildren(p *enmime.Part) []*enmime.Part {
+	var out []*enmime.Part
+	for c := p.FirstChild; c != nil; c = c.NextSibling {
+		out = append(out, c)
+	}
+	return out
+}
+
+func rwRequireIdentical(t *testing.T, got, want string) {
+	t.Helper()
+	if got != want {
+		t.Errorf("not byte identical\n got: %q\nwant: %q", got, want)
+	}
+}
+
+func rwRequireContains(t *testing.T, got, want string) {
+	t.Helper()
+	if !strings.Contains(got, want) {
+		t.Errorf("missing %q in %q", want, got)
+	}
+}
