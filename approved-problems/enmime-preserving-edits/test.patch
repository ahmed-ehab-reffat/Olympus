+// Coverage: a collision at a deep leaf must be resolved at the inner multipart, and if the rebuilt
+// inner image then collides with the outer marker, at the outer one too.
+func TestRewriteCollisionPropagatesThroughEveryRebuiltAncestor(t *testing.T) {
+	raw := "From: a@b.c\r\nMIME-Version: 1.0\r\n" +
+		"Content-Type: multipart/mixed; boundary=\"OUT\"\r\n\r\n" +
+		"--OUT\r\nContent-Type: text/plain\r\n\r\nalpha\r\n" +
+		"--OUT\r\nContent-Type: multipart/alternative; boundary=\"IN\"\r\n\r\n" +
+		"--IN\r\nContent-Type: text/plain\r\n\r\ndeep leaf\r\n" +
+		"--IN\r\nContent-Type: text/plain\r\n\r\nsecond leaf\r\n" +
+		"--IN--\r\n" +
+		"--OUT--\r\n"
+	p := rwParse(t, raw)
+	inner := rwChildren(p)[1]
+	// Collides with the inner marker, and with the outer marker the inner rebuild will sit inside.
+	if err := rwChildren(inner)[0].Replace([]byte("boom\r\n--IN\r\nand\r\n--OUT\r\nboth")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	got := rwOut(t, p)
+
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+	outer := rwChildren(again)
+	if len(outer) != 2 {
+		t.Fatalf("want 2 outer parts, got %d\n%q", len(outer), got)
+	}
+	rebuiltInner := outer[1]
+	if n := len(rwChildren(rebuiltInner)); n != 2 {
+		t.Fatalf("want 2 inner parts, got %d\n%q", n, got)
+	}
+	if again.Boundary == "OUT" {
+		t.Error("the outer boundary was not regenerated")
+	}
+	if rebuiltInner.Boundary == "IN" {
+		t.Error("the inner boundary was not regenerated")
+	}
+	// Each rebuilt ancestor must have had its own Content-Type pointed at its own new marker.
+	if _, params := rwMediaType(t, again); params["boundary"] != again.Boundary {
+		t.Errorf("outer Content-Type names %q but the message uses %q", params["boundary"], again.Boundary)
+	}
+	if _, params := rwMediaType(t, rebuiltInner); params["boundary"] != rebuiltInner.Boundary {
+		t.Errorf("inner Content-Type names %q but the message uses %q", params["boundary"], rebuiltInner.Boundary)
+	}
+	if n := countMarkerLines(got, again.Boundary); n != 3 {
+		t.Errorf("outer marker opens %d lines, want the 3 structural ones\n%q", n, got)
+	}
+	if n := countMarkerLines(got, rebuiltInner.Boundary); n != 3 {
+		t.Errorf("inner marker opens %d lines, want the 3 structural ones\n%q", n, got)
+	}
+	if !strings.Contains(string(rwChildren(rebuiltInner)[0].Content), "both") {
+		t.Errorf("edited leaf was cut short: %q", string(rwChildren(rebuiltInner)[0].Content))
+	}
+}
