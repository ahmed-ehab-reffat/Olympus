+func TestRewriteReplaceAddsTransferEncodingWhenHeaderNamesNone(t *testing.T) {
+	p := rwParse(t, rwCRLFMixed)
+	if err := rwChildren(p)[0].Replace([]byte("plain ascii")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	got := rwOut(t, p)
+	rwRequireContains(t, strings.ToLower(got), "content-transfer-encoding")
+	// Plain ASCII needs no encoding, so the encoding building a message would choose leaves it
+	// readable on the wire rather than wrapping it in base64 or escaping every byte.
+	rwRequireContains(t, got, "\r\n\r\nplain ascii\r\n")
+	if strings.Contains(got, "cGxhaW4") {
+		t.Errorf("plain ascii was wrapped in base64\n%q", got)
+	}
+	if strings.Contains(got, "=70=6C") {
+		t.Errorf("plain ascii was escaped byte by byte\n%q", got)
+	}
+}
