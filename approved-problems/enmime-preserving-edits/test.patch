+// Coverage: appending links the new part into the chain, so the tail it lands behind points at it
+// and it points at nothing.
+func TestRewriteAppendChildLinksTheNewTailIntoTheChain(t *testing.T) {
+	p := rwParse(t, rwThreeDeep)
+	before := rwChildren(p)
+	tail := before[len(before)-1]
+	fresh := enmime.NewPart("text/plain")
+	if err := fresh.Replace([]byte("appended")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	if err := p.AppendChild(fresh); err != nil {
+		t.Fatalf("append: %v", err)
+	}
+	if fresh.Parent != p {
+		t.Error("the appended part does not point at the multipart it joined")
+	}
+	if tail.NextSibling != fresh {
+		t.Error("the former tail does not point at the appended part")
+	}
+	if fresh.NextSibling != nil {
+		t.Error("the appended part points past the end of the chain")
+	}
+	now := rwChildren(p)
+	if len(now) != len(before)+1 || now[len(now)-1] != fresh {
+		t.Fatalf("the chain walks to %d children ending elsewhere", len(now))
+	}
+	for at, child := range before {
+		if now[at] != child {
+			t.Errorf("child %d changed identity", at)
+		}
+	}
+	got := rwOut(t, p)
+	if at, end := strings.Index(got, "omega"), strings.Index(got, "appended"); end < at {
+		t.Errorf("the appended part was written ahead of the old tail\n%q", got)
+	}
+	if n := len(rwChildren(rwParse(t, got))); n != len(before)+1 {
+		t.Errorf("want %d parts on the wire, got %d", len(before)+1, n)
+	}
+}
