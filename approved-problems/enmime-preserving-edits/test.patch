+// Coverage: which transfer encoding gets chosen when the header names none, and that the body it
+// writes decodes back to what was put in.
+func TestRewriteReplacementWithoutCTEPicksAnEncodingThatRoundTrips(t *testing.T) {
+	tests := []struct {
+		name    string
+		content []byte
+	}{
+		{"ascii", []byte("plain ascii text")},
+		{"non-ascii", []byte(strings.Repeat("a", 100) + "caf\xc3\xa9")},
+		{"binary", []byte{0x00, 0x01, 0x02, 0xff, 0xfe}},
+	}
+	for _, tc := range tests {
+		{
+			p := rwParse(t, rwCRLFMixed)
+			if err := rwChildren(p)[0].Replace(tc.content); err != nil {
+				t.Fatalf("%s: replace: %v", tc.name, err)
+			}
