+// Coverage: a part built rather than parsed is still written with the line ending the message it
+// joins arrived with, not the one building a message would use.
+func TestRewriteAddedPartFollowsTheMessageLineEnding(t *testing.T) {
+	p := rwParse(t, rwLFOnly)
+	fresh := enmime.NewPart("text/plain")
+	if err := fresh.Replace([]byte("added part")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	if err := p.AppendChild(fresh); err != nil {
+		t.Fatalf("append: %v", err)
+	}
+	got := rwOut(t, p)
+	// The markers around the added part are lines this rewrite writes, so they follow the message.
+	// What a freshly built part puts inside its own block is its own business.
+	if strings.Contains(got, "\r\n--LF") {
+		t.Errorf("a marker line gained a carriage return in an LF only message\n%q", got)
+	}
+	if n := strings.Count(got, "\n--LF"); n != 4 {
+		t.Errorf("marker opens %d lines, want the 4 structural ones\n%q", n, got)
+	}
+	rwRequireContains(t, got, "added part")
+	again, err := enmime.ReadParts(strings.NewReader(got))
+	if err != nil {
+		t.Fatalf("rewritten message no longer parses: %v\n%q", err, got)
+	}
+	kids := rwChildren(again)
+	if len(kids) != 3 {
+		t.Fatalf("want 3 parts, got %d\n%q", len(kids), got)
+	}
+	if s := strings.TrimSpace(string(kids[2].Content)); s != "added part" {
+		t.Errorf("added body came back as %q", s)
+	}
+}
