+// Coverage: a write that fails part way through leaves the message alone, so the next one over a
+// working writer produces what it would have produced anyway.
+func TestRewriteAfterAWriterFailureIsUnchanged(t *testing.T) {
+	p := rwParse(t, rwCRLFMixed)
+	if err := p.Rewrite(&shortWriter{limit: 10}); err == nil {
+		t.Fatal("a failing writer reported no error")
+	}
+	rwRequireIdentical(t, rwOut(t, p), rwCRLFMixed)
+
+	edited := rwParse(t, rwCRLFMixed)
+	control := rwParse(t, rwCRLFMixed)
+	for _, at := range []*enmime.Part{edited, control} {
+		kids := rwChildren(at)
+		if err := kids[0].Replace([]byte("swapped")); err != nil {
+			t.Fatalf("replace: %v", err)
+		}
+		if err := at.SetHeader("X-Added", "yes"); err != nil {
+			t.Fatalf("set: %v", err)
+		}
+	}
+	if err := edited.Rewrite(&shortWriter{limit: 10}); err == nil {
+		t.Fatal("a failing writer reported no error after an edit")
+	}
+	rwRequireIdentical(t, rwOut(t, edited), rwOut(t, control))
+	if n := len(rwChildren(edited)); n != len(rwChildren(control)) {
+		t.Errorf("the tree lost parts: %d", n)
+	}
+}
