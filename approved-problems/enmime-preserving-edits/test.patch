+// Coverage: the collision scan looks at what is written, not at the decoded content. base64 hides a
+// line-opening marker, so no new one is needed; quoted-printable leaves it standing, so one is.
+func TestRewriteCollisionLooksAtTheEncodedBytesNotTheContent(t *testing.T) {
+	for _, tc := range []struct {
+		cte string
+	}{
+		{"base64"},
+		{"quoted-printable"},
+	} {
+		{
+			raw := "From: a@b.c\r\nMIME-Version: 1.0\r\n" +
+				"Content-Type: multipart/mixed; boundary=\"ENC\"\r\n\r\n" +
+				"--ENC\r\nContent-Transfer-Encoding: " + tc.cte + "\r\nContent-Type: text/plain\r\n\r\ncGxhaW4=\r\n" +
+				"--ENC\r\nContent-Type: text/plain\r\n\r\nsecond\r\n" +
+				"--ENC--\r\n"
+			p := rwParse(t, raw)
+			content := []byte("safe\r\n--ENC\r\nafter")
+			if err := rwChildren(p)[0].Replace(content); err != nil {
+				t.Fatalf("%s: replace: %v", tc.cte, err)
+			}
+			got := rwOut(t, p)
+			again, err := enmime.ReadParts(strings.NewReader(got))
+			if err != nil {
+				t.Fatalf("%s: rewritten message no longer parses: %v\n%q", tc.cte, err, got)
+			}
+			emitted := emittedRegions(got, again.Boundary)
+			wantNewMark := false
+			for _, region := range emitted {
+				if openLinesWith([]byte(region), "ENC") {
+					wantNewMark = true
+				}
+			}
+			if newMark := again.Boundary != "ENC"; newMark != wantNewMark {
+				t.Errorf("%s: regenerated=%v, want %v (boundary %q)\n%q",
+					tc.cte, newMark, wantNewMark, again.Boundary, got)
+			}
+			if tc.cte == "base64" && wantNewMark {
+				t.Errorf("base64 emitted a marker line, which it cannot: %q", got)
+			}
+			if n := len(rwChildren(again)); n != 2 {
+				t.Fatalf("%s: want 2 parts, got %d\n%q", tc.cte, n, got)
+			}
+			if !bytes.Equal(rwChildren(again)[0].Content, content) {
+				t.Errorf("%s: content did not survive: %q", tc.cte, string(rwChildren(again)[0].Content))
+			}
+			if n := countMarkerLines(got, again.Boundary); n != 3 {
+				t.Errorf("%s: marker opens %d lines, want the 3 structural ones\n%q", tc.cte, n, got)
+			}
+		}
+	}
+}
