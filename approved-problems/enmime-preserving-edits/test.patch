+// Coverage: an edit that is refused leaves the tree and the wire image exactly as they were.
+func TestRewriteRefusedEditsLeaveTheMessageAlone(t *testing.T) {
+	stray := enmime.NewPart("text/plain")
+	if err := stray.Replace([]byte("stray")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+
+	for _, tc := range []struct {
+		name string
+		raw  string
+		edit func(p *enmime.Part) error
+	}{
+		{"remove root", rwCRLFMixed, func(p *enmime.Part) error { return p.Remove() }},
+		{"append to leaf", rwQuotedPrintable, func(p *enmime.Part) error { return p.AppendChild(stray) }},
+		{"insert into leaf", rwQuotedPrintable, func(p *enmime.Part) error { return p.InsertBefore(stray, stray) }},
+		{"insert before a stranger", rwCRLFMixed, func(p *enmime.Part) error { return p.InsertBefore(stray, stray) }},
+		{"replace a multipart", rwCRLFMixed, func(p *enmime.Part) error { return p.Replace([]byte("no")) }},
+	} {
+		{
+			p := rwParse(t, tc.raw)
+			before := rwOut(t, p)
+			countBefore := len(rwChildren(p))
+			if err := tc.edit(p); err == nil {
+				t.Errorf("%s: expected an error", tc.name)
+				continue
+			}
+			if n := len(rwChildren(p)); n != countBefore {
+				t.Errorf("%s: child count moved from %d to %d after a refused edit", tc.name, countBefore, n)
+			}
+			if stray.Parent != nil {
+				t.Errorf("%s: the refused part was attached anyway", tc.name)
+			}
+			if after := rwOut(t, p); after != before {
+				t.Errorf("%s: a refused edit changed the message\nbefore: %q\nafter:  %q", tc.name, before, after)
+			}
+			if after := rwOut(t, p); after != tc.raw {
+				t.Errorf("%s: the message no longer matches its input", tc.name)
+			}
+		}
+	}
+}
