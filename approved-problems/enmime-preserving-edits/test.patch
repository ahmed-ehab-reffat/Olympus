+	}
+	got := rwOut(t, p)
+	rwRequireContains(t, got, "--BOUND\r\nX-Odd-CASE: kept\r\nContent-Transfer-Encoding: quoted-printable\r\nContent-Type: text/plain\r\n\r\n")
+	if strings.Contains(got, "Content-Type: text/plain\r\nX-Odd-CASE") {
+		t.Error("the edited part's header block was reordered")
+	}
+}
