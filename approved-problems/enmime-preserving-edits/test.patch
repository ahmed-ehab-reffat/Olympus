+func TestRewriteNestedMultipartSurvivesAnEditBelowIt(t *testing.T) {
+	raw, err := os.ReadFile("../testdata/mail/mime-mixed-related.raw")
+	if err != nil {
+		t.Skipf("fixture unavailable: %v", err)
+	}
+	p, err := enmime.ReadParts(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatalf("parse: %v", err)
+	}
+	var leaf *enmime.Part
+	var walk func(*enmime.Part)
+	walk = func(n *enmime.Part) {
+		if n == nil {
+			return
+		}
+		if leaf == nil && n.Boundary == "" && n.Parent != nil {
+			leaf = n
+		}
+		walk(n.FirstChild)
+		walk(n.NextSibling)
+	}
+	walk(p.FirstChild)
+	if leaf == nil {
+		t.Skip("no leaf part in fixture")
+	}
+	if err := leaf.Replace([]byte("nested edit")); err != nil {
+		t.Fatalf("replace: %v", err)
+	}
+	var buf bytes.Buffer
+	if err := p.Rewrite(&buf); err != nil {
+		t.Fatalf("rewrite: %v", err)
+	}
+	again, err := enmime.ReadParts(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatalf("rewritten nested message no longer parses: %v", err)
+	}
+	found := false
+	var visit func(*enmime.Part)
+	visit = func(n *enmime.Part) {
+		if n == nil {
+			return
+		}
+		if string(n.Content) == "nested edit" {
+			found = true
+		}
+		visit(n.FirstChild)
+		visit(n.NextSibling)
+	}
+	visit(again)
+	if !found {
+		t.Errorf("no part decodes back to the edit\n%q", buf.String())
+	}
+}
