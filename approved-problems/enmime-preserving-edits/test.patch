+#!/bin/sh
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUT="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUT")"
+
+cd "$(dirname "$0")" || exit 1
+export GOFLAGS=-buildvcs=false
+export GOCACHE=${GOCACHE:-/tmp/gocache}
+export GOMODCACHE=${GOMODCACHE:-/tmp/gomod}
+
+if [ "$MODE" = "base" ]; then
+  PKGS=$(go list ./... 2>/dev/null | grep -v '/rewritetest$')
+  # TestRandOption seeds two builders from time.Now().UnixNano() a microsecond apart and asserts the
+  # results differ, so it flips under load. It is unrelated to this change: it exercises MailBuilder
+  # and never parses or rewrites a message. -skip has been a go test flag since Go 1.21; the probe
+  # keeps base mode working on an older toolchain instead of erroring on an unknown flag.
+  SKIP=""
+  if go test -skip X -run XXXNOSUCHTESTXXX ./ >/dev/null 2>&1; then
+    SKIP="-skip TestRandOption"
+  fi
+  go test -v $SKIP $PKGS > /tmp/gotest.out 2>&1
+  EXIT=$?
+  go-junit-report < /tmp/gotest.out > "$OUT"
+else
+  go test -v ./rewritetest/ > /tmp/gotest.out 2>&1
+  EXIT=$?
+  go-junit-report < /tmp/gotest.out > "$OUT"
+  # A missing API makes the package fail to build, which yields no named test
+  # nodes. Emit one failing node per test so the run is reportable.
+  if ! grep -q 'name="TestRewrite' "$OUT" 2>/dev/null; then
+    PKG=$(go list ./rewritetest/ 2>/dev/null || echo github.com/jhillyerd/enmime/v2/rewritetest)
+    NAMES=$(grep -hoE '^func (TestRewrite[A-Za-z0-9_]*)' rewritetest/*_test.go | sed 's/^func //' | sort -u)
+    COUNT=$(printf '%s\n' "$NAMES" | grep -c .)
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      printf '<testsuites tests="%s">\n' "$COUNT"
+      printf '\t<testsuite name="%s" tests="%s" failures="%s" errors="0" id="0" time="0.000">\n' "$PKG" "$COUNT" "$COUNT"
+      printf '%s\n' "$NAMES" | while read -r name; do
+        [ -n "$name" ] || continue
+        printf '\t\t<testcase name="%s" classname="%s" time="0.000">\n' "$name" "$PKG"
+        printf '\t\t\t<failure message="Failed">package failed to build</failure>\n'
+        printf '\t\t</testcase>\n'
+      done
+      echo '\t</testsuite>'
+      echo '</testsuites>'
+    } > "$OUT"
+    EXIT=1
+  fi
+fi
+exit $EXIT
