index 0000000..06736b9
--- /dev/null
+++ b/crates/liwe/src/graph/anchors.rs
@@ -0,0 +1,176 @@
+use std::collections::HashSet;
+
+use itertools::Itertools;
+
+use super::graph_node::GraphNode;
+use super::{Graph, GraphContext};
+use crate::model::node::{NodeIter, NodePointer};
+use crate::model::{number_anchor_slugs, Key, NodeId};
+
+/// A link addressing a header no document holds.
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct DanglingAnchor {
+    pub source_key: Key,
+    pub target_key: Key,
+    pub anchor: String,
+}
+
+/// A header of a document together with the anchor slug it answers to.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct AnchoredHeader {
+    pub id: NodeId,
+    pub slug: String,
+    pub text: String,
+}
+
+impl Graph {
+    /// Every header of a document in document order, with its anchor slug.
+    pub fn anchors(&self, key: &Key) -> Vec<AnchoredHeader> {
+        let Some(document) = self.maybe_key(key) else {
+            return Vec::new();
+        };
+
+        let headers = document
+            .get_all_sub_nodes()
+            .into_iter()
+            .filter(|id| {
+                GraphContext::node(&self, *id).is_header() && !self.graph_node(*id).is_empty()
+            })
+            .map(|id| (id, GraphContext::get_text(&self, id)))
+            .collect_vec();
+
+        let slugs = number_anchor_slugs(headers.iter().map(|(_, text)| text.clone()));
+
+        headers
+            .into_iter()
+            .zip(slugs)
+            .map(|((id, text), slug)| AnchoredHeader { id, slug, text })
+            .collect()
+    }
+
+    /// The header a link fragment addresses, if the document holds one.
+    pub fn resolve_anchor(&self, key: &Key, anchor: &str) -> Option<NodeId> {
+        self.anchors(key)
+            .into_iter()
+            .find(|header| header.slug == anchor)
+            .map(|header| header.id)
+    }
+
+    /// The text of the header a link fragment addresses.
+    pub fn anchor_text(&self, key: &Key, anchor: &str) -> Option<String> {
+        self.anchors(key)
+            .into_iter()
+            .find(|header| header.slug == anchor)
+            .map(|header| header.text)
+    }
+
+    /// The anchor slug of a header node, if the node is a header.
+    pub fn anchor_of(&self, id: NodeId) -> Option<String> {
+        let key = GraphContext::node(&self, id).to_document()?.document_key()?;
+        self.anchors(&key)
+            .into_iter()
+            .find(|header| header.id == id)
+            .map(|header| header.slug)
+    }
+
+    /// Every anchored link a document holds, block level and inline.
+    pub fn anchored_refs_in(&self, key: &Key) -> Vec<(Key, String)> {
+        let nodes = self
+            .maybe_key(key)
+            .map(|node| node.get_all_sub_nodes())
+            .unwrap_or_default();
+
+        let mut refs = Vec::new();
+
+        for id in nodes {
+            let graph_node = self.graph_node(id);
+            if graph_node.is_empty() {
+                continue;
+            }
+
+            if let (Some(target), Some(anchor)) = (graph_node.ref_key(), graph_node.ref_anchor()) {
+                refs.push((target, anchor));
+            }
+
+            match graph_node {
+                GraphNode::Section(section) => {
+                    refs.extend(self.get_line(section.line_id()).anchored_refs());
+                }
+                GraphNode::Leaf(leaf) => {
+                    refs.extend(self.get_line(leaf.line_id()).anchored_refs());
+                }
+                GraphNode::Table(table) => {
+                    for line_id in table.header() {
+                        refs.extend(self.get_line(*line_id).anchored_refs());
+                    }
+                    for row in table.rows() {
+                        for line_id in row {
+                            refs.extend(self.get_line(*line_id).anchored_refs());
+                        }
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        refs
+    }
+
+    /// The documents holding a link addressing a given header, sorted and deduplicated.
+    pub fn anchor_backlinks(&self, key: &Key, anchor: &str) -> Vec<Key> {
+        if self.resolve_anchor(key, anchor).is_none() {
+            return Vec::new();
+        }
+
+        let mut sources = HashSet::new();
+
+        for source in self.keys() {
+            for (target, used) in self.anchored_refs_in(&source) {
+                if target == *key && used == anchor {
+                    sources.insert(source.clone());
+                }
+            }
+        }
+
+        sources.into_iter().sorted().collect()
+    }
+
+    /// The markdown of the section a link fragment addresses.
+    pub fn anchored_markdown(&self, key: &Key, anchor: &str) -> Option<String> {
+        let id = self.resolve_anchor(key, anchor)?;
+        let format = self.format_options().clone();
+
+        Some(
+            GraphContext::node(&self, id)
+                .collect_tree()
+                .iter()
+                .to_text(&key.parent(), &format),
+        )
+    }
+
+    /// Every link of the workspace whose target document holds no header for its anchor.
+    pub fn dangling_anchors(&self) -> Vec<DanglingAnchor> {
+        let mut dangling = HashSet::new();
+
+        for source in self.keys() {
+            for (target, anchor) in self.anchored_refs_in(&source) {
+                if GraphContext::get_node_id(&self, &target).is_none() {
+                    continue;
+                }
+                if self.resolve_anchor(&target, &anchor).is_none() {
+                    dangling.insert((source.clone(), target, anchor));
+                }
+            }
+        }
+
+        dangling
+            .into_iter()
+            .sorted()
+            .map(|(source_key, target_key, anchor)| DanglingAnchor {
+                source_key,
+                target_key,
+                anchor,
+            })
+            .collect()
+    }
+}
