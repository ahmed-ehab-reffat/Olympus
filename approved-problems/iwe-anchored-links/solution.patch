+/// Returns the fragment of a link url, without the leading `#`.
+pub fn anchor_from_link_url(url: &str) -> Option<String> {
+    let decoded = percent_decode_str(url).decode_utf8_lossy().into_owned();
+    decoded
+        .split_once('#')
+        .map(|(_, fragment)| fragment.to_string())
+        .filter(|fragment| !fragment.is_empty())
+}
+
+/// Whether a link url addresses only a fragment, so it names no document.
+pub fn is_fragment_only_url(url: &str) -> bool {
+    percent_decode_str(url)
+        .decode_utf8_lossy()
+        .starts_with('#')
+}
+
+/// Turns a header text into its anchor slug.
+pub fn slugify(text: &str) -> String {
+    let mut slug = String::new();
+    let mut pending_dash = false;
+
+    for character in text.chars() {
+        if character.is_alphanumeric() {
+            if pending_dash && !slug.is_empty() {
+                slug.push('-');
+            }
+            pending_dash = false;
+            slug.extend(character.to_lowercase());
+        } else {
+            pending_dash = true;
+        }
+    }
+
+    slug
+}
+
+/// Numbers repeated slugs in document order, the first occurrence keeps the bare slug.
+pub fn number_anchor_slugs(headers: impl IntoIterator<Item = String>) -> Vec<String> {
+    let mut seen: HashMap<String, usize> = HashMap::new();
+    let mut taken: HashSet<String> = HashSet::new();
+    let mut slugs = Vec::new();
+
+    for header in headers {
+        let base = match slugify(&header) {
+            slug if slug.is_empty() => "section".to_string(),
+            slug => slug,
+        };
+        let count = seen.entry(base.clone()).or_insert(0);
+
+        loop {
+            *count += 1;
+            let slug = match *count {
+                1 => base.clone(),
+                taken_count => format!("{}-{}", base, taken_count),
+            };
+            if taken.insert(slug.clone()) {
+                slugs.push(slug);
+                break;
+            }
+        }
+    }
+
+    slugs
+}
