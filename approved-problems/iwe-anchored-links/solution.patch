diff --git a/crates/liwe/src/operations/anchors.rs b/crates/liwe/src/operations/anchors.rs
new file mode 100644
index 0000000..1b35700
--- /dev/null
+++ b/crates/liwe/src/operations/anchors.rs
@@ -0,0 +1,139 @@
+use std::collections::{HashMap, HashSet};
+
+use itertools::Itertools;
+
+use crate::graph::{Graph, GraphContext};
+use crate::model::node::Reference;
+use crate::model::node::NodeIter;
+use crate::model::tree::Tree;
+
+use super::changes::Changes;
+use crate::model::{number_anchor_slugs, Key, NodeId};
+
+/// A document produced by an operation, paired with the tree it was built from.
+pub struct RelocatedDocument<'a> {
+    pub key: Key,
+    pub tree: &'a Tree,
+    pub created: bool,
+}
+
+/// Follows headers across an operation so links anchored at them keep pointing at the same header.
+#[derive(Default)]
+pub struct AnchorRelocation {
+    before: HashMap<(Key, String), NodeId>,
+    after: HashMap<NodeId, (Key, Option<String>)>,
+}
+
+impl AnchorRelocation {
+    pub fn build(graph: &Graph, sources: &[Key], results: &[RelocatedDocument]) -> AnchorRelocation {
+        let mut before = HashMap::new();
+
+        for key in sources {
+            for header in graph.anchors(key) {
+                before.insert((key.clone(), header.slug), header.id);
+            }
+        }
+
+        let mut after = HashMap::new();
+
+        for result in results {
+            let headers = result.tree.headers();
+            let slugs = number_anchor_slugs(headers.iter().map(|(_, text)| text.clone()));
+
+            for (position, ((id, _), slug)) in headers.iter().zip(slugs).enumerate() {
+                let anchor = if result.created && position == 0 {
+                    None
+                } else {
+                    Some(slug)
+                };
+                after.insert(*id, (result.key.clone(), anchor));
+            }
+        }
+
+        AnchorRelocation { before, after }
+    }
+
+    fn target(&self, reference: &Reference) -> Option<(Key, Option<String>)> {
+        let anchor = reference.anchor.clone()?;
+        let id = self.before.get(&(reference.key.clone(), anchor))?;
+        let (key, anchor) = self.after.get(id)?;
+
+        if *key == reference.key && anchor.as_deref() == reference.anchor.as_deref() {
+            return None;
+        }
+
+        Some((key.clone(), anchor.clone()))
+    }
+
+    /// Rewrites every anchored reference of a tree that addresses a header this operation moved.
+    pub fn apply(&self, tree: &Tree) -> Tree {
+        tree.map_references(&|reference| {
+            let (key, anchor) = self.target(reference)?;
+            let url = match &anchor {
+                Some(anchor) => format!("{}#{}", key.to_library_url(), anchor),
+                None => key.to_library_url(),
+            };
+
+            Some(Reference {
+                key,
+                text: reference.text.clone(),
+                reference_type: reference.reference_type,
+                url,
+                display_url: None,
+                anchor,
+            })
+        })
+    }
+
+    /// The documents holding a link into one of the operation's source documents.
+    pub fn linking_documents(&self, graph: &Graph, sources: &[Key]) -> Vec<Key> {
+        let mut keys: HashSet<Key> = HashSet::new();
+
+        for source in sources {
+            let inbound = graph
+                .get_inclusion_edges_to(source)
+                .into_iter()
+                .chain(graph.get_reference_edges_to(source));
+
+            for node_id in inbound {
+                keys.insert(graph.key_of(node_id));
+            }
+        }
+
+        keys.into_iter().sorted().collect()
+    }
+
+    /// Adds an update for every other document whose anchored links this operation moved.
+    pub fn retarget_linking_documents(
+        &self,
+        graph: &Graph,
+        sources: &[Key],
+        already_written: &[Key],
+        changes: &mut Changes,
+    ) {
+        if self.is_empty() {
+            return;
+        }
+
+        let format = graph.format_options().clone();
+
+        for key in self.linking_documents(graph, sources) {
+            if already_written.contains(&key) {
+                continue;
+            }
+
+            let tree = graph.collect(&key);
+            let updated = self.apply(&tree);
+
+            if updated == tree {
+                continue;
+            }
+
+            changes.add_update(key.clone(), updated.iter().to_text(&key.parent(), &format));
+        }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.before.is_empty() || self.after.is_empty()
+    }
+}
