+    let graph = graph_of(source);
+    let tree = (&graph).collect(&"1".into());
+    let reference = liwe::operations::references(&tree)
+        .first()
+        .map(|reference| reference.id)
+        .expect("document to hold an inclusion link");
+    let changes = inline(
+        &graph,
+        &"1".into(),
+        reference,
+        &InlineConfig {
+            inline_type: InlineType::Quote,
+            keep_target: false,
+        },
+    )
+    .expect("inline to succeed");
+    let documents = applied(source, &changes);
+
+    assert_str_eq!(
+        documents["3"],
+        indoc! {"
+            # other
+
+            [](1#part-one)
+            "}
+    );
