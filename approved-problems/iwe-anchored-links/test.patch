+use std::fs::{create_dir_all, write};
+use std::path::Path;
+use std::process::{Command, Output};
+
+use indoc::indoc;
+use tempfile::TempDir;
+
+const IWE_BINARY: &str = env!("CARGO_BIN_EXE_iwe");
+
+fn write_config(path: &Path) {
+    create_dir_all(path.join(".iwe")).unwrap();
+    write(
+        path.join(".iwe/config.toml"),
+        "library.path = \"\"\nmarkdown.refs_extension = \"\"\n",
+    )
+    .unwrap();
+}
+
+fn run(work_dir: &Path, command: &str, args: &[&str]) -> Output {
+    let mut cmd = Command::new(IWE_BINARY);
+    cmd.arg(command).current_dir(work_dir);
+    for arg in args {
+        cmd.arg(arg);
+    }
+    cmd.output().expect("run iwe command")
+}
+
+fn workspace(documents: &[(&str, &str)]) -> TempDir {
+    let dir = TempDir::new().expect("temp dir");
+    write_config(dir.path());
+    for (key, content) in documents {
+        write(dir.path().join(format!("{}.md", key)), content).unwrap();
+    }
+    dir
+}
+
+fn stats(dir: &TempDir) -> String {
+    let output = run(dir.path(), "stats", &[]);
+    assert!(output.status.success());
+    String::from_utf8(output.stdout).expect("utf8 output")
+}
+
+fn broken_anchors(report: &str) -> Vec<String> {
+    let mut lines = Vec::new();
+    let mut inside = false;
+
+    for line in report.lines() {
+        let heading = line.trim_start_matches('#').trim();
+        if line.starts_with('#') {
+            inside = heading.eq_ignore_ascii_case("broken anchors");
+            continue;
+        }
+        if inside && !line.trim().is_empty() {
+            lines.push(line.to_string());
+        }
+    }
+
+    lines
+}
+
+fn reports(report: &str, source: &str, target: &str, anchor: &str) -> bool {
+    broken_anchors(report)
+        .iter()
+        .any(|line| line.contains(source) && line.contains(target) && line.contains(anchor))
+}
+
+fn mentions(report: &str, text: &str) -> bool {
+    broken_anchors(report).iter().any(|line| line.contains(text))
+}
+
+#[test]
+fn stats_report_a_broken_anchor() {
+    let dir = workspace(&[
+        ("one", "# one\n\nSee [label](two#missing) here.\n"),
+        ("two", "# two\n\n## part one\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(report.contains("Broken Anchors"), "{}", report);
+    assert!(reports(&report, "one", "two", "missing"), "{}", report);
+}
+
+#[test]
+fn stats_leave_out_resolved_anchors() {
+    let dir = workspace(&[
+        (
+            "one",
+            "# one\n\nSee [a](two#part-one) and [b](two#missing) here.\n",
+        ),
+        ("two", "# two\n\n## part one\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(reports(&report, "one", "two", "missing"), "{}", report);
+    assert!(!mentions(&report, "part-one"), "{}", report);
+}
+
+#[test]
+fn stats_leave_out_links_to_unknown_documents() {
+    let dir = workspace(&[
+        (
+            "one",
+            "# one\n\nSee [a](ghost#missing) and [b](two#gone) here.\n",
+        ),
+        ("two", "# two\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(reports(&report, "one", "two", "gone"), "{}", report);
+    assert!(!mentions(&report, "ghost"), "{}", report);
+}
+
+#[test]
+fn stats_report_a_broken_anchor_of_a_block_link() {
+    let dir = workspace(&[
+        (
+            "one",
+            indoc! {"
+                # one
+
+                [label](two#gone)
+            "},
+        ),
+        ("two", "# two\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(reports(&report, "one", "two", "gone"), "{}", report);
+}
+
+#[test]
+fn stats_report_broken_anchors_sorted() {
+    let dir = workspace(&[
+        ("one", "# one\n\nSee [b](two#zulu) and [a](two#alpha).\n"),
+        ("two", "# two\n\nbody\n"),
+    ]);
+
+    let lines = broken_anchors(&stats(&dir));
+    let alpha = lines
+        .iter()
+        .position(|line| line.contains("alpha"))
+        .expect("alpha reported");
+    let zulu = lines
+        .iter()
+        .position(|line| line.contains("zulu"))
+        .expect("zulu reported");
+
+    assert!(alpha < zulu, "{:?}", lines);
+}
+
+#[test]
+fn stats_report_a_broken_anchor_of_a_wiki_link() {
+    let dir = workspace(&[
+        ("one", "# one\n\nSee [[two#missing]] here.\n"),
+        ("two", "# two\n\n## part one\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(reports(&report, "one", "two", "missing"), "{}", report);
+}
+
+#[test]
+fn stats_report_a_repeated_broken_anchor_once() {
+    let dir = workspace(&[
+        (
+            "one",
+            "# one\n\nSee [a](two#missing) and [b](two#missing).\n\nAgain [c](two#missing).\n",
+        ),
+        ("two", "# two\n\nbody\n"),
+    ]);
+
+    let lines = broken_anchors(&stats(&dir));
+
+    assert_eq!(lines.len(), 1, "{:?}", lines);
+    assert!(lines[0].contains("two") && lines[0].contains("missing"), "{:?}", lines);
+}
+
+#[test]
+fn stats_report_broken_anchors_sorted_across_documents() {
+    let dir = workspace(&[
+        (
+            "beta",
+            "# beta\n\nSee [a](delta#zulu) and [b](charlie#alpha).\n",
+        ),
+        (
+            "alpha",
+            "# alpha\n\nSee [c](delta#zulu) and [d](delta#alpha).\n",
+        ),
+        ("charlie", "# charlie\n\nbody\n"),
+        ("delta", "# delta\n\nbody\n"),
+    ]);
+
+    let lines = broken_anchors(&stats(&dir));
+    let at = |source: &str, target: &str, anchor: &str| {
+        lines
+            .iter()
+            .position(|line| {
+                line.contains(source) && line.contains(target) && line.contains(anchor)
+            })
+            .unwrap_or_else(|| panic!("{} {} {} reported, got {:?}", source, target, anchor, lines))
+    };
+
+    assert!(at("alpha", "delta", "alpha") < at("alpha", "delta", "zulu"), "{:?}", lines);
+    assert!(at("alpha", "delta", "zulu") < at("beta", "charlie", "alpha"), "{:?}", lines);
+    assert!(at("beta", "charlie", "alpha") < at("beta", "delta", "zulu"), "{:?}", lines);
+}
+
+#[test]
+fn stats_leave_out_empty_fragments() {
+    let dir = workspace(&[
+        (
+            "one",
+            "# one\n\nSee [a](two#) and [b](two#missing) here.\n",
+        ),
+        ("two", "# two\n\n## part one\n\nbody\n"),
+    ]);
+
+    let lines = broken_anchors(&stats(&dir));
+
+    assert_eq!(lines.len(), 1, "{:?}", lines);
+    assert!(lines[0].contains("missing"), "{:?}", lines);
+}
+
+#[test]
+fn stats_report_a_broken_anchor_decoded() {
+    let dir = workspace(&[
+        ("one", "# one\n\nSee [a](two#stra%C3%9Fe) here.\n"),
+        ("two", "# two\n\n## part one\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(reports(&report, "one", "two", "straße"), "{}", report);
+    assert!(!report.contains("%C3"), "{}", report);
+}
+
+#[test]
+fn stats_report_a_doubly_escaped_broken_anchor() {
+    let dir = workspace(&[
+        ("one", "# one\n\nSee [a](two#foo%252Dbar) here.\n"),
+        ("two", "# two\n\n## Foo bar\n\nbody\n"),
+    ]);
+
+    let report = stats(&dir);
+
+    assert!(reports(&report, "one", "two", "foo%2Dbar"), "{}", report);
+}
