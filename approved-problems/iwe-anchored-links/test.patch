+fn graph_of_document(markdown: &str) -> Graph {
+    Graph::import(
+        &liwe::state::new_form_pairs(vec!["1", markdown]),
+        MarkdownOptions::default(),
+        None,
+    )
+}
+
+fn graph_of_pairs(pairs: Vec<&str>) -> Graph {
+    Graph::import(
+        &liwe::state::new_form_pairs(pairs),
+        MarkdownOptions::default(),
+        None,
+    )
+}
+
+fn squashed_graph(graph: &Graph, key: &str) -> String {
+    let tree = graph.squash(&key.into(), 8);
+    let mut patch = Graph::new();
+    patch.build_key_from_iter(&key.into(), tree.iter());
+    patch.export_key(&key.into()).unwrap_or_default()
+}
+
+fn first_paragraph(tree: &Tree) -> Option<NodeId> {
+    if matches!(tree.node, Node::Leaf(_)) {
+        return Some(tree.id);
+    }
+    tree.children.iter().find_map(first_paragraph)
+}
+
+fn paragraph_id(graph: &Graph, key: &str) -> NodeId {
+    first_paragraph(&(&*graph).collect(&key.into())).expect("document to hold a paragraph")
+}
