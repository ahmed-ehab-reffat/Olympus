+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="/opt/cargo/bin:/root/.cargo/bin:${PATH}"
+export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"
+export CARGO_NET_OFFLINE=true
+
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1 ;;
+  esac
+done
+[ -z "$MODE" ] && { echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1; }
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/report.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+CLASSNAME="cargo-test"
+
+TESTCASES=""
+PASSED=0
+FAILED=0
+STATUS=0
+
+write_junit() {
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="iwe" tests="$((PASSED + FAILED))" failures="${FAILED}" errors="0">
+${TESTCASES}  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+collect() {
+  local line
+  while IFS= read -r line; do
+    if [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ \.\.\.\ ok ]]; then
+      TESTCASES+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\" />"$'\n'
+      PASSED=$((PASSED + 1))
+    elif [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ \.\.\.\ FAILED ]]; then
+      TESTCASES+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\"><failure message=\"test failed\"/></testcase>"$'\n'
+      FAILED=$((FAILED + 1))
+    fi
+  done <<< "$1"
+}
+
+synthesize_failures() {
+  local file="$1" sanitized fn
+  STATUS=1
+  sanitized=$(printf '%s' "$2" | tail -c 3000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/]]>/]] >/g')
+  while IFS= read -r fn; do
+    [ -z "$fn" ] && continue
+    TESTCASES+="    <testcase name=\"${fn}\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+    FAILED=$((FAILED + 1))
+  done < <(awk '/^#\[test\]/{t=1;next} t&&/^fn /{s=$0;sub(/^fn /,"",s);sub(/\(.*/,"",s);print s;t=0}' "$file")
+}
+
+run_suite() {
+  local out
+  out=$(eval "$1" 2>&1)
+  [ $? -ne 0 ] && STATUS=1
+  echo "$out"
+  collect "$out"
+}
+
+run_new_suite() {
+  local before=$((PASSED + FAILED)) out
+  out=$(eval "$1" 2>&1)
+  [ $? -ne 0 ] && STATUS=1
+  echo "$out"
+  collect "$out"
+  if [ $((PASSED + FAILED)) -eq "$before" ]; then
+    synthesize_failures "$2" "$out"
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_suite "cargo test --workspace --features liwe/djot --exclude liwe --exclude iwe"
+    run_suite "cargo test -p liwe --features djot --lib --test integration"
+    run_suite "cargo test -p iwe --lib --bins --test integration"
+    if [ "$((PASSED + FAILED))" -eq 0 ]; then
+      echo "no tests were discovered"
+      STATUS=1
+    fi
+    write_junit
+    exit $STATUS
+    ;;
+  new)
+    run_new_suite "cargo test -p liwe --features djot --test anchored_links_b18f6a" \
+      "crates/liwe/tests/anchored_links_b18f6a.rs"
+    run_new_suite "cargo test -p iwe --test anchored_stats_b18f6a" \
+      "crates/iwe/tests/anchored_stats_b18f6a.rs"
+    write_junit
+    exit $STATUS
+    ;;
+esac
