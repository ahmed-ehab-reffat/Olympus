+use std::collections::BTreeMap;
+
+use indoc::indoc;
+use itertools::Itertools;
+use pretty_assertions::assert_str_eq;
+
+use liwe::graph::{Graph, GraphContext};
+use liwe::model::config::{InlineType, MarkdownOptions, RefsText, WikiLinkPath};
+use liwe::model::node::Node;
+use liwe::model::tree::Tree;
+use liwe::model::{Key, NodeId, State};
+use liwe::operations::{
+    extract, extract_all, inline, rename, rename_header, Changes, ExtractConfig, InlineConfig,
+};
+use liwe::state::from_indoc;
+
+fn state_of(source: &str) -> State {
+    from_indoc(source)
+}
+
+fn graph_of(source: &str) -> Graph {
+    Graph::import(&state_of(source), MarkdownOptions::default(), None)
+}
+
+fn normalizing_graph_of(source: &str) -> Graph {
+    Graph::import(
+        &state_of(source),
+        MarkdownOptions {
+            refs_text: RefsText::Normalize,
+            ..Default::default()
+        },
+        None,
+    )
+}
+
+fn document(graph: &Graph, key: &str) -> String {
+    graph.export_key(&key.into()).unwrap_or_default()
+}
+
+fn squashed(source: &str, key: &str) -> String {
+    let graph = graph_of(source);
+    let tree = (&graph).squash(&key.into(), 8);
+    let mut patch = Graph::new();
+    patch.build_key_from_iter(&key.into(), tree.iter());
+    patch.export_key(&key.into()).unwrap_or_default()
+}
+
+fn slugs(source: &str, key: &str) -> Vec<String> {
+    graph_of(source)
+        .anchors(&key.into())
+        .into_iter()
+        .map(|header| header.slug)
+        .collect()
+}
+
+fn header_id(graph: &Graph, key: &str, anchor: &str) -> NodeId {
+    graph
+        .anchors(&key.into())
+        .into_iter()
+        .find(|header| header.slug == anchor)
+        .map(|header| header.id)
+        .expect("anchor to resolve")
+}
+
+fn applied(source: &str, changes: &Changes) -> BTreeMap<String, String> {
+    let mut documents: BTreeMap<String, String> = state_of(source)
+        .into_iter()
+        .map(|(key, content)| (key, format!("{}\n", content.trim())))
+        .collect();
+
+    for key in &changes.removes {
+        documents.remove(key.as_str());
+    }
+    for (key, markdown) in changes.creates.iter().chain(changes.updates.iter()) {
+        documents.insert(key.to_string(), markdown.clone());
+    }
+
+    documents
+}
+
+fn extract_config() -> ExtractConfig {
+    ExtractConfig {
+        key_template: "extracted".to_string(),
+        ..Default::default()
+    }
+}
+
+fn extracted(source: &str, key: &str, anchor: &str) -> BTreeMap<String, String> {
+    let graph = graph_of(source);
+    let target = header_id(&graph, key, anchor);
+    let changes = extract(
+        &graph,
+        &key.into(),
+        target,
+        &extract_config(),
+        std::time::SystemTime::UNIX_EPOCH,
+    )
+    .expect("extract to succeed");
+
+    applied(source, &changes)
+}
+
+fn inlined(source: &str, key: &str, keep_target: bool) -> BTreeMap<String, String> {
+    let graph = graph_of(source);
+    let tree = (&graph).collect(&key.into());
+    let reference = liwe::operations::references(&tree)
+        .first()
+        .map(|reference| reference.id)
+        .expect("document to hold an inclusion link");
+    let changes = inline(
+        &graph,
+        &key.into(),
+        reference,
+        &InlineConfig {
+            keep_target,
+            ..Default::default()
+        },
+    )
+    .expect("inline to succeed");
+
+    applied(source, &changes)
+}
+
+const NESTED: &str = indoc! {"
+    # one
+
+    [](2#part-two)
+    _
+    # two
+
+    ## part one
+
+    first body
+
+    ## part two
+
+    second body
+
+    ### deep
+
+    deep body
+    "};
+
+#[test]
+fn slug_lowercases_header_text() {
+    assert_eq!(slugs("# Title Case Header\n", "1"), vec!["title-case-header"]);
+}
+
+#[test]
+fn slug_collapses_punctuation_runs() {
+    assert_eq!(slugs("# what -- now?!  ok\n", "1"), vec!["what-now-ok"]);
+}
+
+#[test]
+fn slug_drops_leading_and_trailing_punctuation() {
+    assert_eq!(slugs("# ...trimmed...\n", "1"), vec!["trimmed"]);
+}
+
+#[test]
+fn slug_keeps_digits() {
+    assert_eq!(slugs("# chapter 12 b\n", "1"), vec!["chapter-12-b"]);
+}
+
+#[test]
+fn slug_keeps_unicode_letters() {
+    assert_eq!(slugs("# Straße Über\n", "1"), vec!["straße-über"]);
+}
+
+#[test]
+fn slug_of_punctuation_only_header_is_section() {
