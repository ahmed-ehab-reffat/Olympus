+# Copyright 2008-2026 pydicom authors. See LICENSE file for details.
+"""Frame level access to the pixel data of multi-frame instances."""
+
+import math
+
+from pydicom.dataset import Dataset
+from pydicom.encaps import encapsulate, get_frame
+from pydicom.errors import MultiFrameError
+from pydicom.pixels.utils import concatenate_packed_frames, get_packed_frame
+
+EXTENDED_OFFSETS = ("ExtendedOffsetTable", "ExtendedOffsetTableLengths")
+
+#: The pixel data elements an instance may carry, and the number of bytes one
+#: pixel of each takes. ``None`` means *Bits Allocated* decides.
+PIXEL_KEYWORDS = (
+    ("PixelData", None),
+    ("FloatPixelData", 4),
+    ("DoubleFloatPixelData", 8),
+)
+
+
+def pixel_keyword(ds: Dataset) -> str:
+    """Return the keyword of the pixel data element `ds` carries."""
+    found = [keyword for keyword, _ in PIXEL_KEYWORDS if keyword in ds]
+    if not found:
+        raise MultiFrameError("The dataset carries no pixel data")
+
+    if len(found) > 1:
+        raise MultiFrameError(
+            f"The dataset carries more than one pixel data element: "
+            f"{', '.join(found)}"
+        )
+
+    return found[0]
+
+
+def is_encapsulated(ds: Dataset) -> bool:
+    """Return ``True`` if the pixel data of `ds` is encapsulated."""
+    return bool(ds.file_meta.TransferSyntaxUID.is_encapsulated)
+
+
+def frame_length(ds: Dataset) -> int:
+    """Return the number of pixels in one frame of `ds`."""
+    try:
+        rows = int(ds.Rows)
+        columns = int(ds.Columns)
+    except AttributeError:
+        raise MultiFrameError(
+            "The dataset has no 'Rows' and 'Columns' and so its frames cannot "
+            "be measured"
+        )
+
+    return rows * columns * int(ds.get("SamplesPerPixel", 1))
+
+
+def _bits(ds: Dataset, keyword: str) -> int:
+    """Return the number of bits one pixel of `keyword` takes in `ds`."""
+    per_pixel = dict(PIXEL_KEYWORDS)[keyword]
+    if per_pixel is not None:
+        return per_pixel * 8
+
+    bits_allocated = int(ds.BitsAllocated)
+    if bits_allocated != 1 and bits_allocated % 8:
+        raise MultiFrameError(
+            f"'Bits Allocated' is {bits_allocated}, which does not divide "
+            "into whole bytes"
+        )
+
+    return bits_allocated
+
+
+def _extended_offsets(ds: Dataset) -> tuple[bytes, bytes] | None:
+    """Return the extended offset table of `ds`, if it has one."""
+    table = ds.get(EXTENDED_OFFSETS[0], None)
+    lengths = ds.get(EXTENDED_OFFSETS[1], None)
+    if table is None or lengths is None:
+        return None
+
+    return (table, lengths)
+
+
+def check_length(ds: Dataset, nr_frames: int) -> None:
+    """Raise if the pixel data of `ds` is too short to hold `nr_frames`.
+
+    Native data is measured; encapsulated data is judged by whether every
+    frame can be reached, since how much room a frame takes is only known
+    once its fragments have been read.
+    """
+    keyword = pixel_keyword(ds)
+    if is_encapsulated(ds):
+        for index in range(nr_frames):
+            frame_bytes(ds, index, nr_frames)
+
+        return
+
+    if "Rows" not in ds or "Columns" not in ds:
+        return
+
+    bits = _bits(ds, keyword)
+    pixels = frame_length(ds) * nr_frames
+    needed = math.ceil(pixels / 8) if bits == 1 else pixels * bits // 8
+    held = len(ds[keyword].value)
+    if held < needed:
+        raise MultiFrameError(
+            f"'{keyword}' is {held} bytes, which is too short to hold the "
+            f"{nr_frames} frames the instance describes"
+        )
+
+
+def frame_bytes(ds: Dataset, index: int, nr_frames: int) -> bytes:
+    """Return the encoded bytes of a single frame of `ds`.
+
+    Parameters
+    ----------
+    ds : pydicom.dataset.Dataset
+        The instance the frame belongs to.
+    index : int
+        The zero-based index of the frame.
+    nr_frames : int
+        The number of frames the instance holds.
+
+    Returns
+    -------
+    bytes
+        The encoded frame.
+    """
+    keyword = pixel_keyword(ds)
+    data = ds[keyword].value
+    if is_encapsulated(ds):
+        if keyword != "PixelData":
+            raise MultiFrameError(
+                f"'{keyword}' is never encapsulated, but the transfer syntax "
+                "says it is"
+            )
+
+        try:
+            return get_frame(
+                data,
+                index,
+                number_of_frames=nr_frames,
+                extended_offsets=_extended_offsets(ds),
+            )
+        except (ValueError, IndexError) as exc:
+            raise MultiFrameError(
+                f"'{keyword}' does not hold the frame at index {index}: {exc}"
+            )
+
+    bits = _bits(ds, keyword)
+    if bits == 1:
+        return get_packed_frame(data, index, frame_length(ds), pad=False)
+
+    length = frame_length(ds) * bits // 8
+    start = index * length
+    if start + length > len(data):
+        raise MultiFrameError(
+            f"'{keyword}' is {len(data)} bytes, which is too short to hold "
+            f"the frame at index {index}"
+        )
+
+    return data[start : start + length]
+
+
+def rebuild(ds: Dataset, frames: list[bytes]) -> None:
+    """Replace the pixel data of `ds` with `frames`, in the given order."""
+    keyword = pixel_keyword(ds)
+    for offsets in EXTENDED_OFFSETS:
+        if offsets in ds:
+            del ds[offsets]
+
+    if is_encapsulated(ds):
+        ds.PixelData = encapsulate(list(frames))
+        ds["PixelData"].is_undefined_length = True
+        return
+
+    if _bits(ds, keyword) == 1:
+        data = concatenate_packed_frames(frames, frame_length(ds))
+    else:
+        data = b"".join(frames)
+        if len(data) % 2:
+            data += b"\x00"
+
+    ds[keyword].value = data
+    ds[keyword].is_undefined_length = False
