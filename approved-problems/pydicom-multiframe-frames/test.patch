+class TestPointedDimensions:
+    """Tests for dimensions that name the attribute they index"""
+
+    def make(self, stored, depths, labels=None):
+        frames = []
+        for values, depth in zip(stored, depths):
+            elements = [content(DimensionIndexValues=list(values))]
+            if depth is not None:
+                elements.append(macro("PlanePositionSequence", ImagePositionPatient=[0, 0, depth]))
+
+            frames.append(group(*elements))
+
+        ds = instance(frames)
+        ds.DimensionIndexSequence = labels or pointing(
+            ("Depth", "ImagePositionPatient")
+        )
+
+        return ds
+
+    def test_the_stored_numbers_are_not_used(self):
+        """Useless stored numbers give way to the indexed attribute"""
+        out = pydicom.extract_frames(self.make([[9], [9], [9]], [2, 0, 1]), [0, 1, 2])
+        assert [index_values(out, i) for i in range(3)] == [[1], [2], [3]]
+
+    def test_numbering_follows_the_result_order(self):
+        """The first value seen in the result is the one numbered first"""
+        out = pydicom.extract_frames(self.make([[1], [2], [3]], [2, 0, 1]), [2, 0, 1])
+        assert [index_values(out, i) for i in range(3)] == [[1], [2], [3]]
+        assert positions(out) == [1.0, 2.0, 0.0]
+
+    def test_equal_values_share_a_number(self):
+        """Two frames at the same depth index the same"""
+        out = pydicom.extract_frames(self.make([[1], [2], [3]], [5, 8, 5]), [0, 1, 2])
+        assert [index_values(out, i) for i in range(3)] == [[1], [2], [1]]
+
+    def test_one_value_collapses_the_dimension(self):
+        """A pointed dimension every frame agrees on is dropped"""
+        out = pydicom.extract_frames(self.make([[1], [2]], [4, 4]), [0, 1])
+        content_macro = out.SharedFunctionalGroupsSequence[0].FrameContentSequence[0]
+        assert "DimensionIndexValues" not in content_macro
+        assert "DimensionIndexSequence" not in out
+
+    def test_a_frame_without_the_attribute_stops_there(self):
+        """A frame missing the indexed attribute does not reach the dimension"""
+        out = pydicom.extract_frames(self.make([[1], [2]], [3, None]), [0, 1])
+        assert index_values(out, 0) == [1]
+        assert "DimensionIndexValues" not in frame_item(out, 1).FrameContentSequence[0]
+
+    def test_selection_changes_the_numbering(self):
+        """Numbering is derived per result, not carried from the source"""
+        out = pydicom.extract_frames(self.make([[1], [2], [3]], [7, 4, 7]), [2, 1])
+        assert [index_values(out, i) for i in range(2)] == [[1], [2]]
+
+    def test_an_unpointed_dimension_keeps_its_numbers(self):
+        """Only the described dimension changes; the other is renumbered"""
+        ds = self.make([[5, 1], [5, 2]], [6, 9], labels=pointing(
+            ("Plain", None), ("Depth", "ImagePositionPatient")
+        ))
+        out = pydicom.extract_frames(ds, [0, 1])
+        assert [index_values(out, i) for i in range(2)] == [[1], [2]]
+        labels = [item.DimensionDescriptionLabel for item in out.DimensionIndexSequence]
+        assert labels == ["Depth"]
+
+    def test_both_dimensions_survive_when_both_vary(self):
+        """A plain dimension and a pointed one can both be kept"""
+        ds = self.make([[7, 1], [8, 1], [7, 1]], [3, 3, 6], labels=pointing(
+            ("Plain", None), ("Depth", "ImagePositionPatient")
+        ))
+        out = pydicom.extract_frames(ds, [0, 1, 2])
+        assert [index_values(out, i) for i in range(3)] == [[1, 1], [2, 1], [1, 2]]
+
+    def test_sorting_derives_the_numbers_too(self):
+        """Sorting numbers the dimension in its own new order"""
