+class TestMergeRemainder:
+    def marked(self, uid, number):
+        ds = simple(1)
+        inner = Dataset()
+        inner.SeriesInstanceUID = uid
+        ds.ReferencedSeriesSequence = Sequence([inner])
+        ds.SeriesNumber = number
+
+        return ds
+
+    def test_a_sequence_comes_from_the_first_input(self):
+        """The later input's unrelated sequence does not win"""
+        out = pydicom.merge_frames(
+            [self.marked("1.2.3.10", 7), self.marked("1.2.3.20", 9)]
+        )
+        assert out.ReferencedSeriesSequence[0].SeriesInstanceUID == "1.2.3.10"
+
+    def test_an_attribute_comes_from_the_first_input(self):
+        """A plain conflicting attribute follows the same rule"""
+        out = pydicom.merge_frames(
+            [self.marked("1.2.3.10", 7), self.marked("1.2.3.20", 9)]
+        )
+        assert out.SeriesNumber == 7
+
+    def test_the_first_input_keeps_its_own(self):
+        """Taking the remainder leaves the inputs untouched"""
+        first = self.marked("1.2.3.10", 7)
+        second = self.marked("1.2.3.20", 9)
+        out = pydicom.merge_frames([first, second])
+        out.ReferencedSeriesSequence[0].SeriesInstanceUID = "1.2.3.99"
+        assert first.ReferencedSeriesSequence[0].SeriesInstanceUID == "1.2.3.10"
+        assert second.ReferencedSeriesSequence[0].SeriesInstanceUID == "1.2.3.20"
+
+    def test_a_later_only_attribute_is_not_taken(self):
+        """What only a later input carries does not reach the result"""
+        first = simple(1)
+        second = self.marked("1.2.3.20", 9)
+        out = pydicom.merge_frames([first, second])
+        assert "ReferencedSeriesSequence" not in out
+        assert "SeriesNumber" not in out
