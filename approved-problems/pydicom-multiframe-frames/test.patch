+class TestUndescribedDimensions:
+    def make(self, vectors):
+        frames = [
+            group(content(DimensionIndexValues=list(values))) for values in vectors
+        ]
+        ds = instance(frames)
+
+        return ds
+
+    def test_the_instance_has_no_description(self):
+        """The fixture carries index values and nothing describing them"""
+        ds = self.make([[4, 7], [4, 9]])
+        assert "DimensionIndexSequence" not in ds
+        assert list(pydicom.frame_attributes(ds, 0).DimensionIndexValues) == [4, 7]
+
+    def test_values_are_renumbered_without_one(self):
+        """Renumbering does not wait for a description"""
+        out = pydicom.extract_frames(self.make([[4, 7], [4, 9]]), [0, 1])
+        assert index_values(out, 0) == [1]
+        assert index_values(out, 1) == [2]
+
+    def test_a_constant_dimension_still_collapses(self):
+        """The constant first dimension goes even with nothing describing it"""
+        out = pydicom.extract_frames(self.make([[6, 2], [6, 8], [6, 2]]), [0, 1, 2])
+        assert index_values(out, 0) == [1]
+        assert index_values(out, 1) == [2]
+        assert index_values(out, 2) == [1]
+
+    def test_sorting_renumbers_without_one(self):
+        """The same holds for the other derivations"""
+        ds = self.make([[3], [1], [2]])
+        out = pydicom.sort_frames(ds, ["DimensionIndexValues"])
+        assert [index_values(out, index) for index in range(3)] == [[1], [2], [3]]
+
+    def test_no_description_is_invented(self):
+        """Nothing gains a dimension description it never had"""
+        out = pydicom.extract_frames(self.make([[4, 7], [4, 9]]), [0, 1])
+        assert "DimensionIndexSequence" not in out
