+class TestEqualMultiItemMacros:
+    def referenced(self, *uids):
+        items = []
+        for uid in uids:
+            item = Dataset()
+            item.ReferencedSOPInstanceUID = uid
+            items.append(item)
+
+        holder = Dataset()
+        holder.ReferencedImageSequence = Sequence(items)
+
+        return holder["ReferencedImageSequence"]
+
+    def test_equal_multi_item_macros_are_shared(self):
+        """Two items each, equal, built apart, still one macro"""
+        frames = [
+            group(position(0), self.referenced("1.2.3.1", "1.2.3.2")),
+            group(position(1), self.referenced("1.2.3.1", "1.2.3.2")),
+        ]
+        out = pydicom.extract_frames(instance(frames), [0, 1])
+        assert Tag("ReferencedImageSequence") in shared_tags(out)
+
+    def test_the_shared_macro_keeps_both_items(self):
+        """Sharing does not quietly drop the items after the first"""
+        frames = [
+            group(position(0), self.referenced("1.2.3.1", "1.2.3.2")),
+            group(position(1), self.referenced("1.2.3.1", "1.2.3.2")),
+        ]
+        out = pydicom.extract_frames(instance(frames), [0, 1])
+        shared = out.SharedFunctionalGroupsSequence[0].ReferencedImageSequence
+        assert [item.ReferencedSOPInstanceUID for item in shared] == [
+            "1.2.3.1",
+            "1.2.3.2",
+        ]
+
+    def test_a_different_second_item_is_not_shared(self):
+        """Sameness reaches every item, not just the first"""
+        frames = [
+            group(position(0), self.referenced("1.2.3.1", "1.2.3.2")),
+            group(position(1), self.referenced("1.2.3.1", "1.2.3.9")),
+        ]
+        out = pydicom.extract_frames(instance(frames), [0, 1])
+        assert Tag("ReferencedImageSequence") not in shared_tags(out)
+
+    def test_merging_shares_equal_multi_item_macros(self):
+        """The same holds when the frames come from different instances"""
+        first = instance([group(position(0), self.referenced("1.2.3.1", "1.2.3.2"))])
+        second = instance([group(position(1), self.referenced("1.2.3.1", "1.2.3.2"))])
+        out = pydicom.merge_frames([first, second])
+        assert Tag("ReferencedImageSequence") in shared_tags(out)
