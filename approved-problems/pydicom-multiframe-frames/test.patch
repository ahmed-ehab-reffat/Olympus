+class TestMultiValueOrdering:
+    def depths(self, vectors):
+        frames = [
+            group(macro("PlanePositionSequence", ImagePositionPatient=list(vector)))
+            for vector in vectors
+        ]
+
+        return instance(frames)
+
+    def seen(self, ds):
+        return [
+            [float(value) for value in pydicom.frame_attributes(ds, index)
+             .ImagePositionPatient]
+            for index in range(int(ds.NumberOfFrames))
+        ]
+
+    def test_the_second_component_decides(self):
+        """Equal first components fall through to the next one"""
+        out = pydicom.sort_frames(
+            self.depths([[0, 2, 0], [0, 1, 5], [0, 1, 2]]), ["ImagePositionPatient"]
+        )
+        assert self.seen(out) == [[0, 1, 2], [0, 1, 5], [0, 2, 0]]
+
+    def test_the_third_component_decides(self):
+        """Two equal components fall through to the third"""
+        out = pydicom.sort_frames(
+            self.depths([[1, 1, 9], [1, 1, 3]]), ["ImagePositionPatient"]
+        )
+        assert self.seen(out) == [[1, 1, 3], [1, 1, 9]]
+
+    def test_a_shorter_value_orders_first(self):
+        """A value that runs out earlier comes first"""
+        frames = [
+            group(macro("PlanePositionSequence", ImagePositionPatient=[1, 2, 3])),
+            group(macro("PlanePositionSequence", ImagePositionPatient=[1, 2])),
+        ]
+        out = pydicom.sort_frames(instance(frames), ["ImagePositionPatient"])
+        assert self.seen(out) == [[1, 2], [1, 2, 3]]
+
+    def test_grouping_tells_multi_values_apart(self):
+        """Values differing late are still distinct combinations"""
+        groups = pydicom.group_frames(
+            self.depths([[0, 1, 2], [0, 1, 5], [0, 1, 2]]), ["ImagePositionPatient"]
+        )
+        assert [int(one.NumberOfFrames) for one in groups] == [2, 1]
