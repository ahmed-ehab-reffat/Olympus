+#[test]
+fn unlimited_bandwidth_delivers_every_datagram_together() -> Result {
+    let mut sim = sim(5);
+    let log = log();
+    udp_sink(&mut sim, "server", &log);
+
+    sim.client("client", async move {
+        let sock = bind().await?;
+        for _ in 0..3 {
+            sock.send_to(&vec![0; 500], target("server")).await?;
+        }
+        settle(100).await;
+        Ok(())
+    });
+
+    sim.run()?;
+
+    assert_eq!(arrivals(&log), vec![5, 5, 5]);
+    Ok(())
+}
