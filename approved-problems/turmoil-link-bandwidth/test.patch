+use std::net::{IpAddr, Ipv4Addr, SocketAddr};
+use std::rc::Rc;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+#[cfg(feature = "regex")]
+use regex::Regex;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use turmoil::net::{TcpListener, TcpStream, UdpSocket};
+use turmoil::{Builder, Duplex, Result, Sim};
+
+const PORT: u16 = 1738;
+
+type Log = Arc<Mutex<Vec<(u64, usize)>>>;
+
+fn now_ms() -> u64 {
+    turmoil::sim_elapsed().unwrap().as_millis() as u64
+}
+
+fn sim(latency: u64) -> Sim<'static> {
+    Builder::new()
+        .min_message_latency(Duration::from_millis(latency))
+        .max_message_latency(Duration::from_millis(latency))
+        .tick_duration(Duration::from_millis(1))
+        .simulation_duration(Duration::from_secs(120))
+        .build()
+}
+
+fn log() -> Log {
+    Arc::new(Mutex::new(Vec::new()))
+}
+
+fn arrivals(log: &Log) -> Vec<u64> {
+    log.lock().unwrap().iter().map(|(at, _)| *at).collect()
+}
+
+fn sizes(log: &Log) -> Vec<usize> {
+    log.lock().unwrap().iter().map(|(_, size)| *size).collect()
+}
+
+fn udp_sink(sim: &mut Sim<'_>, name: &'static str, log: &Log) {
+    let log = log.clone();
+
+    sim.host(name, move || {
+        let log = log.clone();
+
+        async move {
+            let sock = UdpSocket::bind((IpAddr::from(Ipv4Addr::UNSPECIFIED), PORT)).await?;
+
+            loop {
+                let mut buf = vec![0; 65536];
+                let (size, _) = sock.recv_from(&mut buf).await?;
+                log.lock().unwrap().push((now_ms(), size));
+            }
+        }
+    });
+}
+
+fn tcp_sink(sim: &mut Sim<'_>, name: &'static str, log: &Log) {
+    let log = log.clone();
+
+    sim.host(name, move || {
+        let log = log.clone();
+
+        async move {
+            let listener =
+                TcpListener::bind((IpAddr::from(Ipv4Addr::UNSPECIFIED), PORT)).await?;
+            let (mut stream, _) = listener.accept().await?;
+
+            loop {
+                let mut buf = vec![0; 65536];
+                match stream.read(&mut buf).await? {
+                    0 => break,
+                    size => log.lock().unwrap().push((now_ms(), size)),
+                }
+            }
+
+            Ok(())
+        }
+    });
+}
+
+fn tcp_byte_sink(sim: &mut Sim<'_>, name: &'static str, log: &Log, bytes: &Arc<Mutex<Vec<u8>>>) {
+    let log = log.clone();
+    let bytes = bytes.clone();
+
+    sim.host(name, move || {
+        let log = log.clone();
+        let bytes = bytes.clone();
+
+        async move {
+            let listener =
+                TcpListener::bind((IpAddr::from(Ipv4Addr::UNSPECIFIED), PORT)).await?;
+            let (mut stream, _) = listener.accept().await?;
+
+            loop {
+                let mut buf = vec![0; 65536];
+                match stream.read(&mut buf).await? {
+                    0 => break,
+                    size => {
+                        log.lock().unwrap().push((now_ms(), size));
+                        bytes.lock().unwrap().extend_from_slice(&buf[..size]);
+                    }
+                }
+            }
+
+            Ok(())
+        }
+    });
+}
+
+async fn bind() -> std::result::Result<UdpSocket, std::io::Error> {
+    UdpSocket::bind((IpAddr::from(Ipv4Addr::UNSPECIFIED), PORT)).await
+}
+
+fn target(name: &str) -> SocketAddr {
+    SocketAddr::from((turmoil::lookup(name), PORT))
+}
+
+fn watch(sock: Rc<UdpSocket>, log: Log) {
+    tokio::task::spawn_local(async move {
+        loop {
+            let mut buf = vec![0; 65536];
+            let (size, _) = sock.recv_from(&mut buf).await.unwrap();
+            log.lock().unwrap().push((now_ms(), size));
+        }
+    });
+}
+
+async fn settle(millis: u64) {
+    tokio::time::sleep(Duration::from_millis(millis)).await;
+}
