+    assert_eq!((server.received, server.bytes_received), (1, 500));
+    Ok(())
+}
+
+#[cfg(feature = "regex")]
+#[test]
+fn a_host_selector_that_matches_nothing_leaves_every_interface_alone() -> Result {
+    let mut sim = sim(0);
+    let log = log();
+    udp_sink(&mut sim, "server", &log);
+
+    sim.client("client", async move {
+        let sock = bind().await?;
+        sock.send_to(&vec![0; 5_000], target("server")).await?;
+        settle(500).await;
+        Ok(())
+    });
+
+    sim.set_host_send_bandwidth(Regex::new("^ghost").unwrap(), 1_000);
+    sim.set_host_receive_bandwidth(Regex::new("^ghost").unwrap(), 1_000);
+    sim.run()?;
+
+    assert_eq!(arrivals(&log), vec![1]);
+    assert_eq!(sim.host_stats("client").send_busy, Duration::ZERO);
+    assert_eq!(sim.host_stats("server").receive_busy, Duration::ZERO);
+    Ok(())
+}
+
+#[test]
+fn a_message_a_host_sends_to_itself_takes_no_hop() -> Result {
+    let mut sim = sim(0);
+    let log = log();
+    let sink = log.clone();
+
+    sim.client("client", async move {
+        let sock = bind().await?;
+        sock.send_to(&vec![0; 5_000], (Ipv4Addr::LOCALHOST, PORT))
+            .await?;
+
+        let mut buf = vec![0; 65536];
+        let (size, _) = sock.recv_from(&mut buf).await?;
+        sink.lock().unwrap().push((now_ms(), size));
+
+        settle(200).await;
+        Ok(())
+    });
+
+    sim.set_bandwidth(50_000);
+    sim.set_message_overhead(500);
+    sim.set_host_send_bandwidth("client", 50_000);
+    sim.set_host_receive_bandwidth("client", 50_000);
+    sim.run()?;
+
+    assert_eq!(arrivals(&log), vec![1]);
+    assert_eq!(sizes(&log), vec![5_000]);
+
+    let client = sim.host_stats("client");
+    assert_eq!((client.sent, client.received), (0, 0));
+    assert_eq!(client.send_busy, Duration::ZERO);
+    assert_eq!(client.receive_busy, Duration::ZERO);
+    Ok(())
+}
