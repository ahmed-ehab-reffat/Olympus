+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="/opt/cargo/bin:/root/.cargo/bin:${PATH}"
+export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"
+export CARGO_NET_OFFLINE=true
+
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1 ;;
+  esac
+done
+[ -z "$MODE" ] && { echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1; }
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/report.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+CLASSNAME="cargo-test"
+
+TESTCASES=""
+PASSED=0
+FAILED=0
+STATUS=0
+
+write_junit() {
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="turmoil" tests="$((PASSED + FAILED))" failures="${FAILED}" errors="0">
+${TESTCASES}  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+collect() {
+  local line
+  while IFS= read -r line; do
+    if [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ (-\ should\ panic\ )?\.\.\.\ ok ]]; then
+      TESTCASES+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\" />"$'\n'
+      PASSED=$((PASSED + 1))
+    elif [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ (-\ should\ panic\ )?\.\.\.\ FAILED ]]; then
+      TESTCASES+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\"><failure message=\"test failed\"/></testcase>"$'\n'
+      FAILED=$((FAILED + 1))
+    fi
+  done <<< "$1"
+}
+
+synthesize_failures() {
+  local file="$1" sanitized fn
+  STATUS=1
+  sanitized=$(printf '%s' "$2" | tail -c 3000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/]]>/]] >/g')
+  while IFS= read -r fn; do
+    [ -z "$fn" ] && continue
+    TESTCASES+="    <testcase name=\"${fn}\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+    FAILED=$((FAILED + 1))
+  done < <(awk '/^#\[test\]/{t=1;next} t&&/^fn /{s=$0;sub(/^fn /,"",s);sub(/\(.*/,"",s);print s;t=0}' "$file")
+}
+
+run_suite() {
+  local out
+  out=$(eval "$1" 2>&1)
+  [ $? -ne 0 ] && STATUS=1
+  echo "$out"
+  collect "$out"
+}
+
+run_new_suite() {
+  local before=$((PASSED + FAILED)) out
+  out=$(eval "$1" 2>&1)
+  [ $? -ne 0 ] && STATUS=1
+  echo "$out"
+  collect "$out"
+  if [ $((PASSED + FAILED)) -eq "$before" ]; then
+    synthesize_failures "$2" "$out"
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_suite "cargo test --workspace --exclude turmoil"
+    run_suite "cargo test -p turmoil --lib --test async_send_sync --test barriers --test dns --test fs --test io_uring_conformance --test io_uring_parity --test net --test tokio_io"
+    if [ "$((PASSED + FAILED))" -eq 0 ]; then
+      echo "no tests were discovered"
+      STATUS=1
+    fi
+    write_junit
+    exit $STATUS
+    ;;
+  new)
+    run_new_suite "cargo test -p turmoil --features regex --test capacity_e557d7" \
+      "crates/turmoil/tests/capacity_e557d7.rs"
+    write_junit
+    exit $STATUS
+    ;;
+esac
