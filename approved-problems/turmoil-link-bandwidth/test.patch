+#[test]
+fn a_selector_makes_every_link_it_matches_half_duplex() -> Result {
+    let mut sim = sim(0);
+    let at_matched = log();
+    let at_untouched = log();
+    let from_matched = log();
+    let from_untouched = log();
+
+    for (name, sink) in [("node-1", &at_matched), ("other", &at_untouched)] {
+        let sink = sink.clone();
+
+        sim.host(name, move || {
+            let sink = sink.clone();
+
+            async move {
+                let sock = bind().await?;
+                sock.send_to(&vec![0; 500], target("client")).await?;
+
+                loop {
+                    let mut buf = vec![0; 65536];
+                    let (size, _) = sock.recv_from(&mut buf).await?;
+                    sink.lock().unwrap().push((now_ms(), size));
+                }
+            }
+        });
+    }
+
+    let matched = from_matched.clone();
+    let untouched = from_untouched.clone();
+    sim.client("client", async move {
+        let sock = bind().await?;
+        sock.send_to(&vec![0; 500], target("node-1")).await?;
+        sock.send_to(&vec![0; 500], target("other")).await?;
+
+        for _ in 0..2 {
+            let mut buf = vec![0; 65536];
+            let (size, origin) = sock.recv_from(&mut buf).await?;
+            let sink = if origin == target("node-1") {
+                &matched
+            } else {
+                &untouched
+            };
+            sink.lock().unwrap().push((now_ms(), size));
+        }
+
+        settle(500).await;
+        Ok(())
+    });
+
+    sim.set_bandwidth(50_000);
+    sim.set_link_duplex(
+        Regex::new("^client$").unwrap(),
+        Regex::new("^node-").unwrap(),
+        Duplex::Half,
+    );
+    sim.run()?;
+
+    let mut matched = [arrivals(&at_matched), arrivals(&from_matched)].concat();
+    matched.sort();
+    assert_eq!(matched, vec![10, 20]);
+
+    let mut untouched = [arrivals(&at_untouched), arrivals(&from_untouched)].concat();
+    untouched.sort();
+    assert_eq!(untouched, vec![10, 10]);
+    Ok(())
+}
