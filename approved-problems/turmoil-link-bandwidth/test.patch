+#[test]
+fn the_two_directions_of_a_link_are_carried_separately() -> Result {
+    let mut sim = sim(0);
+    let to_server = log();
+    let to_client = log();
+
+    let sink = to_server.clone();
+    sim.host("server", move || {
+        let sink = sink.clone();
+
+        async move {
+            let sock = bind().await?;
+            loop {
+                let mut buf = vec![0; 65536];
+                let (size, origin) = sock.recv_from(&mut buf).await?;
+                sink.lock().unwrap().push((now_ms(), size));
+                sock.send_to(&vec![0; 500], origin).await?;
+            }
+        }
+    });
+
+    let sink = to_client.clone();
+    sim.client("client", async move {
+        let sock = bind().await?;
+        sock.send_to(&vec![0; 2_000], target("server")).await?;
+
+        let mut buf = vec![0; 65536];
+        let (size, _) = sock.recv_from(&mut buf).await?;
+        sink.lock().unwrap().push((now_ms(), size));
+
+        settle(200).await;
+        Ok(())
+    });
+
+    sim.set_link_bandwidth("client", "server", 50_000);
+    sim.run()?;
+
+    assert_eq!(arrivals(&to_server), vec![40]);
+    assert_eq!(arrivals(&to_client), vec![50]);
+    Ok(())
+}
