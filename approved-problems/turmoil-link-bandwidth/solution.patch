+impl Capacity {
+    /// The time spent putting `size` bytes on a wire running at `bandwidth`,
+    /// rounded up to the next nanosecond. An unlimited link is instant.
+    pub(crate) fn transmit_time(bandwidth: u64, size: u64) -> Duration {
+        if bandwidth == 0 || size == 0 {
+            return Duration::ZERO;
+        }
+
+        let nanos = u128::from(size) * 1_000_000_000;
+        let bandwidth = u128::from(bandwidth);
+        let rounded_up = nanos.div_ceil(bandwidth);
+
+        Duration::from_nanos(u64::try_from(rounded_up).unwrap_or(u64::MAX))
+    }
 }
 
