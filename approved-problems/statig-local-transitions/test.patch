+#[test]
+fn outcome_traits_and_response_alias_distinguish_variants() {
+    fn require_eq<T: Eq>() {}
+    fn public_variant_name(outcome: &Outcome<State>) -> &'static str {
+        match outcome {
+            Outcome::Handled => "handled",
+            Outcome::Super => "super",
+            Outcome::Transition(_) => "legacy",
+            Outcome::LocalTransition(_) => "local",
+            Outcome::ExternalTransition(_) => "external",
+        }
+    }
+
+    require_eq::<Outcome<State>>();
+
+    let target = State::Leaf { value: 7 };
+    let local = Outcome::LocalTransition(target);
+    let external = Outcome::ExternalTransition(target);
+
+    assert_ne!(local, Outcome::Transition(target));
+    assert_ne!(local, external);
+    assert_ne!(external, Outcome::Transition(target));
+    assert_ne!(
+        external,
+        Outcome::ExternalTransition(State::Leaf { value: 8 })
+    );
+    let target_debug = format!("{target:?}");
+    let local_debug = format!("{local:?}");
+    assert!(local_debug.contains("LocalTransition"), "{local_debug}");
+    assert!(local_debug.contains(&target_debug), "{local_debug}");
+
+    let external_debug = format!("{external:?}");
+    assert!(
+        external_debug.contains("ExternalTransition"),
+        "{external_debug}"
+    );
+    assert!(external_debug.contains(&target_debug), "{external_debug}");
+    assert_eq!(public_variant_name(&external), "external");
+
+    #[allow(deprecated)]
+    let external_response: statig::Response<State> = statig::Response::ExternalTransition(target);
+    assert_eq!(external_response, external);
+
+    #[allow(deprecated)]
+    let local_response: statig::Response<State> = statig::Response::LocalTransition(target);
+    assert_eq!(local_response, local);
+}
