+        fn superstate(&mut self) -> Option<Self> {
+            match self {
+                Superstate::Branch { has_parent: true } => Some(Superstate::Root),
+                Superstate::Branch { has_parent: false } | Superstate::Root => None,
+                Superstate::DynamicBranch(_) | Superstate::DynamicOther => Some(Superstate::Root),
+                Superstate::DynamicInserted(expanded) => Some(Superstate::DynamicBranch(*expanded)),
+                Superstate::Reused { target_side: false } => Some(Superstate::SourceParent),
+                Superstate::Reused { target_side: true } => Some(Superstate::TargetMiddle),
+                Superstate::SourceParent | Superstate::TargetParent => Some(Superstate::Root),
+                Superstate::TargetMiddle => Some(Superstate::TargetParent),
+                Superstate::Layer(2) => Some(Superstate::Layer(1)),
+                Superstate::Layer(1) => Some(Superstate::Root),
+                Superstate::Layer(_) => unreachable!(),
+                Superstate::StableBranch(expanded) => {
+                    if expanded.get() {
+                        Some(Superstate::AddedParent)
+                    } else {
+                        Some(Superstate::Root)
+                    }
+                }
+                Superstate::AddedParent => Some(Superstate::Root),
+            }
+        }
+    }
+
+    #[test]
+    fn leaf_origin_survives_a_handler_induced_depth_change() {
+        block_on(async {
+            let mut machine = Machine::<0>::default()
+                .uninitialized_state_machine()
+                .init()
+                .await;
+            let action_start = machine.inner().actions.len();
+
+            machine.handle(&Event::LeafMovesDeeper).await;
+
+            assert_eq!(machine.state(), &State::Target);
+            assert_eq!(
+                &machine.inner().actions[action_start..],
+                ["exit Source", "enter Target"]
+            );
+        });
+    }
+
+    #[test]
+    fn accepting_superstate_uses_its_invocation_position() {
+        block_on(async {
+            let mut machine = Machine::<1>::default()
+                .uninitialized_state_machine()
+                .init()
+                .await;
+            let action_start = machine.inner().actions.len();
+
+            machine.handle(&Event::MutableSuperstateAccepts).await;
+
+            assert_eq!(machine.state(), &State::Target);
+            assert_eq!(
+                &machine.inner().actions[action_start..],
+                ["exit Source", "exit Branch", "enter Branch", "enter Target"]
+            );
+        });
+    }
+
+    #[test]
+    fn same_variant_at_another_depth_remains_outside_the_handler_subtree() {
+        block_on(async {
+            let mut machine = Machine::<2>::default()
+                .uninitialized_state_machine()
+                .init()
+                .await;
+            let action_start = machine.inner().actions.len();
+
+            machine.handle(&Event::OutsideCollisionAccepts).await;
+
+            assert_eq!(machine.state(), &State::CollisionTarget);
+            assert_eq!(
+                &machine.inner().actions[action_start..],
+                [
+                    "exit CollisionSource",
+                    "exit Source Reused",
+                    "exit SourceParent",
+                    "enter TargetParent",
+                    "enter TargetMiddle",
+                    "enter Target Reused",
+                    "enter CollisionTarget"
+                ]
+            );
+        });
+    }
+
+    #[test]
+    fn repeated_superstate_variants_do_not_collapse_the_boundary() {
+        block_on(async {
+            let mut machine = Machine::<3>::default()
+                .uninitialized_state_machine()
+                .init()
+                .await;
+            let action_start = machine.inner().actions.len();
