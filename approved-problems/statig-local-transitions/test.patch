+                [
+                    "exit RepeatedSource",
+                    "exit Layer 2",
+                    "exit Layer 1",
+                    "enter Layer 1",
+                    "enter Layer 2",
+                    "enter RepeatedTarget"
+                ]
+            );
+        });
+    }
+
+    #[test]
+    fn outside_target_uses_the_changed_source_hierarchy() {
+        block_on(async {
+            let mut machine = Machine::<4>::default()
+                .uninitialized_state_machine()
+                .init()
+                .await;
+            let action_start = machine.inner().actions.len();
+
+            machine.handle(&Event::DynamicOutsideAccepts).await;
+
+            assert_eq!(machine.state(), &State::DynamicOutsideTarget);
+            assert_eq!(
+                &machine.inner().actions[action_start..],
+                [
+                    "exit DynamicSource",
+                    "exit DynamicInserted",
+                    "exit DynamicBranch",
+                    "enter DynamicOther",
+                    "enter DynamicOutsideTarget"
+                ]
+            );
+        });
+    }
+
+    #[test]
+    fn accepting_handler_reenters_after_its_parent_changes() {
+        block_on(async {
+            let mut machine = Machine::<5>::default()
+                .uninitialized_state_machine()
+                .init()
+                .await;
+            let action_start = machine.inner().actions.len();
+
+            machine.handle(&Event::StableHandlerGainsParent).await;
+
+            assert_eq!(
+                machine.state(),
+                &State::StableTarget {
+                    expanded: Cell::new(true)
+                }
+            );
+            assert_eq!(
+                &machine.inner().actions[action_start..],
+                [
+                    "exit StableSource",
+                    "exit StableBranch",
+                    "enter StableBranch",
+                    "enter StableTarget"
+                ]
+            );
+        });
+    }
+}
