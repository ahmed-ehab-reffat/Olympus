+#!/usr/bin/env bash
+#
+# Test runner.
+#
+#   ./test.sh [--output_path <path>] <base|new>
+#
+#   base  runs the existing workspace tests
+#   new   runs the transition-boundary tests
+#
+# JUnit XML is written to --output_path when given.
+
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="${2-}"
+            shift 2
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#*=}"
+            shift
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+cd "$(dirname "$0")" || exit 2
+
+if [ -n "$OUTPUT_PATH" ]; then
+    rm -f -- "$OUTPUT_PATH"
+fi
+
+if [ -z "$MODE" ]; then
+    echo "usage: $0 [--output_path <path>] <base|new>" >&2
+    if [ -n "$OUTPUT_PATH" ]; then
+        mkdir -p "$(dirname "$OUTPUT_PATH")"
+        cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="1" errors="0">
+  <testsuite name="invalid" tests="1" failures="1" errors="0">
+    <testcase name="arguments" classname="invalid">
+      <failure message="expected base or new mode"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    fi
+    exit 2
+fi
+
+find target grader_tests/target -path '*/nextest/*/junit.xml' -type f -delete 2>/dev/null
+
+STATUS=0
+JUNIT_ROOT=""
+USE_NEXTEST=0
+
+CARGO=(cargo)
+if [ -n "${STATIG_RUST_TOOLCHAIN-}" ]; then
+    CARGO=(cargo "+${STATIG_RUST_TOOLCHAIN}")
+elif command -v rustup >/dev/null 2>&1 &&
+    rustup toolchain list | grep -Eq '^1\.90\.0(-|[[:space:]])'; then
+    CARGO=(cargo +1.90.0)
+fi
+
+if [ "${STATIG_FORCE_CARGO_TEST:-0}" != "1" ] &&
+    "${CARGO[@]}" nextest --version >/dev/null 2>&1; then
+    USE_NEXTEST=1
+else
+    echo "cargo-nextest unavailable; using cargo test" >&2
+fi
+
+run_command() {
+    "$@"
+    command_status=$?
+    if [ "$command_status" -ne 0 ]; then
+        STATUS=$command_status
+    fi
+}
+
+case "$MODE" in
+    base)
+        if [ "$USE_NEXTEST" -eq 1 ]; then
+            run_command "${CARGO[@]}" nextest run \
+                --profile default \
+                --no-fail-fast \
+                --workspace \
+                --all-features \
+                --offline
+        else
+            run_command "${CARGO[@]}" test \
+                --workspace \
+                --all-features \
+                --lib \
+                --tests \
+                --no-fail-fast \
+                --offline
+        fi
+        run_command "${CARGO[@]}" test \
+            --workspace \
+            --all-features \
+            --doc \
+            --offline
+        JUNIT_ROOT="target"
+        ;;
+    new)
+        if [ "$USE_NEXTEST" -eq 1 ]; then
+            run_command "${CARGO[@]}" nextest run \
+                --manifest-path grader_tests/Cargo.toml \
+                --config-file .config/nextest.toml \
+                --profile default \
+                --no-fail-fast \
+                --all-features \
+                --offline
+        else
+            run_command "${CARGO[@]}" test \
+                --manifest-path grader_tests/Cargo.toml \
+                --all-features \
+                --no-fail-fast \
+                --offline
+        fi
+        run_command "${CARGO[@]}" test \
+            --manifest-path grader_tests/Cargo.toml \
+            --no-default-features \
+            --test v3n8 \
+            --test k5r7 \
+            --no-run \
+            --offline
+        run_command "${CARGO[@]}" test \
+            --manifest-path grader_tests/Cargo.toml \
+            --no-default-features \
+            --features async \
+            --test t9c4 \
+            --test k5r7 \
+            --no-run \
+            --offline
+        JUNIT_ROOT="grader_tests/target"
+        ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+    JUNIT_SRC="$(find "$JUNIT_ROOT" -path '*/nextest/*/junit.xml' -type f 2>/dev/null | head -1)"
+
+    if [ -n "$JUNIT_SRC" ] && [ -f "$JUNIT_SRC" ]; then
+        cp "$JUNIT_SRC" "$OUTPUT_PATH"
+    else
+        cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="0" skipped="1">
+  <testsuite name="$MODE" tests="1" failures="0" errors="0" skipped="1">
+    <testcase name="run" classname="$MODE">
+      <skipped message="per-test JUnit unavailable (runner exit $STATUS)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    fi
+fi
+
+exit "$STATUS"
