+            storage: &mut Machine,
+            _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+        ) -> impl Future<Output = ()> {
+            let action = match self {
+                Superstate::Left => "enter left",
+                Superstate::Right => "enter right",
+                Superstate::Root => "enter root",
+            };
+            async move {
+                storage.actions.push(action);
+            }
+        }
+
+        fn call_exit_action(
+            &mut self,
+            storage: &mut Machine,
+            _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+        ) -> impl Future<Output = ()> {
+            let action = match self {
+                Superstate::Left => "exit left",
+                Superstate::Right => "exit right",
+                Superstate::Root => "exit root",
+            };
+            async move {
+                storage.actions.push(action);
+            }
+        }
+
+        fn superstate(&mut self) -> Option<Self> {
+            match self {
+                Superstate::Left | Superstate::Right => Some(Superstate::Root),
+                Superstate::Root => None,
+            }
+        }
+    }
+
+    async fn run(event: Event) -> Vec<&'static str> {
+        let mut machine = Machine::default()
+            .uninitialized_state_machine()
+            .init()
+            .await;
+        let start = machine.inner().actions.len();
+
+        machine.handle(&event).await;
+
+        assert_eq!(machine.state(), &State::RightLeaf);
+        machine.inner().actions[start..].to_vec()
+    }
+
+    #[test]
+    fn leaf_accepted_local_cross_branch_uses_ordinary_path() {
+        block_on(async {
+            assert_eq!(
+                run(Event::LeafAccepts).await,
+                [
+                    "exit left leaf",
+                    "exit left",
+                    "enter right",
+                    "enter right leaf"
+                ]
+            );
+        });
+    }
+
+    #[test]
+    fn root_accepted_local_cross_branch_still_retains_root() {
+        block_on(async {
+            assert_eq!(
+                run(Event::RootAccepts).await,
+                [
+                    "exit left leaf",
+                    "exit left",
+                    "enter right",
+                    "enter right leaf"
+                ]
+            );
+        });
+    }
+}
