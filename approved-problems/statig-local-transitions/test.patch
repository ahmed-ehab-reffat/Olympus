+#![allow(clippy::manual_async_fn)]
+
+use core::cell::Cell;
+
+use statig::Outcome;
+
+#[derive(Clone, Copy)]
+enum Event {
+    LeafMovesDeeper,
+    MutableSuperstateAccepts,
+    DynamicOutsideAccepts,
+    OutsideCollisionAccepts,
+    RepeatedSuperstateAccepts,
+    StableHandlerGainsParent,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+enum State {
+    Source { deep: bool },
+    Target,
+    DynamicSource { expanded: Cell<bool> },
+    DynamicOutsideTarget,
+    CollisionSource,
+    CollisionTarget,
+    RepeatedSource,
+    RepeatedTarget,
+    StableSource { expanded: Cell<bool> },
+    StableTarget { expanded: Cell<bool> },
+}
+
+#[derive(Clone, Copy)]
+enum Superstate<'a> {
+    Branch { has_parent: bool },
+    DynamicBranch(&'a Cell<bool>),
+    DynamicInserted(&'a Cell<bool>),
+    DynamicOther,
+    Reused { target_side: bool },
+    SourceParent,
+    TargetMiddle,
+    TargetParent,
+    Layer(u8),
+    StableBranch(&'a Cell<bool>),
+    AddedParent,
+    Root,
+}
+
+mod blocking {
+    use super::*;
+    use statig::blocking::{self, IntoStateMachineExt as _};
+
+    #[derive(Default)]
+    struct Machine<const CASE: u8> {
+        actions: Vec<&'static str>,
+    }
+
+    impl<const CASE: u8> blocking::IntoStateMachine for Machine<CASE> {
+        type State = State;
+        type Superstate<'sub> = Superstate<'sub>;
+        type Event<'evt> = Event;
+        type Context<'ctx> = ();
+
+        fn initial() -> Self::State {
+            match CASE {
+                0 => State::Source { deep: false },
+                1 => State::Source { deep: true },
+                2 => State::CollisionSource,
+                3 => State::RepeatedSource,
+                4 => State::DynamicSource {
+                    expanded: Cell::new(false),
+                },
+                5 => State::StableSource {
+                    expanded: Cell::new(false),
+                },
+                _ => unreachable!(),
+            }
+        }
+    }
+
+    impl<const CASE: u8> blocking::State<Machine<CASE>> for State {
+        fn call_handler(
+            &mut self,
+            _shared_storage: &mut Machine<CASE>,
+            event: &Event,
+            _context: &mut (),
+        ) -> Outcome<Self> {
+            match (self, event) {
+                (State::Source { deep }, Event::LeafMovesDeeper) => {
+                    *deep = true;
+                    Outcome::ExternalTransition(State::Target)
+                }
+                (State::Source { .. }, Event::MutableSuperstateAccepts) => Outcome::Super,
+                (State::DynamicSource { .. }, Event::DynamicOutsideAccepts)
+                | (State::CollisionSource, Event::OutsideCollisionAccepts)
+                | (State::RepeatedSource, Event::RepeatedSuperstateAccepts)
+                | (State::StableSource { .. }, Event::StableHandlerGainsParent) => Outcome::Super,
+                _ => Outcome::Handled,
+            }
+        }
+
+        fn call_entry_action(&mut self, shared_storage: &mut Machine<CASE>, _context: &mut ()) {
+            shared_storage.actions.push(match self {
+                State::Source { .. } => "enter Source",
+                State::Target => "enter Target",
+                State::DynamicSource { .. } => "enter DynamicSource",
+                State::DynamicOutsideTarget => "enter DynamicOutsideTarget",
+                State::CollisionSource => "enter CollisionSource",
+                State::CollisionTarget => "enter CollisionTarget",
+                State::RepeatedSource => "enter RepeatedSource",
+                State::RepeatedTarget => "enter RepeatedTarget",
+                State::StableSource { .. } => "enter StableSource",
+                State::StableTarget { .. } => "enter StableTarget",
+            });
+        }
+
+        fn call_exit_action(&mut self, shared_storage: &mut Machine<CASE>, _context: &mut ()) {
+            shared_storage.actions.push(match self {
+                State::Source { .. } => "exit Source",
+                State::Target => "exit Target",
+                State::DynamicSource { .. } => "exit DynamicSource",
+                State::DynamicOutsideTarget => "exit DynamicOutsideTarget",
+                State::CollisionSource => "exit CollisionSource",
+                State::CollisionTarget => "exit CollisionTarget",
+                State::RepeatedSource => "exit RepeatedSource",
+                State::RepeatedTarget => "exit RepeatedTarget",
+                State::StableSource { .. } => "exit StableSource",
+                State::StableTarget { .. } => "exit StableTarget",
+            });
+        }
+
+        fn superstate(&mut self) -> Option<Superstate<'_>> {
+            match self {
+                State::Source { deep: false } => Some(Superstate::Root),
+                State::Source { deep: true } | State::Target => {
+                    Some(Superstate::Branch { has_parent: true })
+                }
+                State::DynamicSource { expanded } => {
+                    if expanded.get() {
+                        Some(Superstate::DynamicInserted(expanded))
+                    } else {
+                        Some(Superstate::DynamicBranch(expanded))
+                    }
+                }
+                State::DynamicOutsideTarget => Some(Superstate::DynamicOther),
+                State::CollisionSource => Some(Superstate::Reused { target_side: false }),
+                State::CollisionTarget => Some(Superstate::Reused { target_side: true }),
+                State::RepeatedSource | State::RepeatedTarget => Some(Superstate::Layer(2)),
+                State::StableSource { expanded } | State::StableTarget { expanded } => {
+                    Some(Superstate::StableBranch(expanded))
+                }
+            }
+        }
+    }
+
+    impl<const CASE: u8> blocking::Superstate<Machine<CASE>> for Superstate<'_> {
+        fn call_handler(
+            &mut self,
+            _shared_storage: &mut Machine<CASE>,
+            event: &Event,
+            _context: &mut (),
+        ) -> Outcome<State> {
+            match (self, event) {
+                (Superstate::Branch { has_parent }, Event::MutableSuperstateAccepts) => {
+                    *has_parent = false;
+                    Outcome::ExternalTransition(State::Target)
+                }
+                (Superstate::DynamicBranch(expanded), Event::DynamicOutsideAccepts) => {
+                    expanded.set(true);
+                    Outcome::ExternalTransition(State::DynamicOutsideTarget)
+                }
+                (Superstate::Reused { target_side: false }, Event::OutsideCollisionAccepts) => {
+                    Outcome::ExternalTransition(State::CollisionTarget)
+                }
+                (Superstate::Layer(2), Event::RepeatedSuperstateAccepts) => Outcome::Super,
+                (Superstate::Layer(1), Event::RepeatedSuperstateAccepts) => {
+                    Outcome::ExternalTransition(State::RepeatedTarget)
+                }
+                (Superstate::StableBranch(expanded), Event::StableHandlerGainsParent) => {
+                    expanded.set(true);
+                    Outcome::ExternalTransition(State::StableTarget {
+                        expanded: Cell::new(true),
+                    })
+                }
+                _ => Outcome::Handled,
+            }
+        }
+
+        fn call_entry_action(&mut self, shared_storage: &mut Machine<CASE>, _context: &mut ()) {
+            shared_storage.actions.push(match self {
+                Superstate::Branch { .. } => "enter Branch",
+                Superstate::DynamicBranch(_) => "enter DynamicBranch",
+                Superstate::DynamicInserted(_) => "enter DynamicInserted",
+                Superstate::DynamicOther => "enter DynamicOther",
+                Superstate::Reused { target_side: false } => "enter Source Reused",
+                Superstate::Reused { target_side: true } => "enter Target Reused",
+                Superstate::SourceParent => "enter SourceParent",
+                Superstate::TargetMiddle => "enter TargetMiddle",
+                Superstate::TargetParent => "enter TargetParent",
+                Superstate::Layer(1) => "enter Layer 1",
+                Superstate::Layer(2) => "enter Layer 2",
+                Superstate::Layer(_) => unreachable!(),
+                Superstate::StableBranch(_) => "enter StableBranch",
+                Superstate::AddedParent => "enter AddedParent",
+                Superstate::Root => "enter Root",
+            });
+        }
+
+        fn call_exit_action(&mut self, shared_storage: &mut Machine<CASE>, _context: &mut ()) {
+            shared_storage.actions.push(match self {
+                Superstate::Branch { .. } => "exit Branch",
+                Superstate::DynamicBranch(_) => "exit DynamicBranch",
+                Superstate::DynamicInserted(_) => "exit DynamicInserted",
+                Superstate::DynamicOther => "exit DynamicOther",
+                Superstate::Reused { target_side: false } => "exit Source Reused",
+                Superstate::Reused { target_side: true } => "exit Target Reused",
+                Superstate::SourceParent => "exit SourceParent",
+                Superstate::TargetMiddle => "exit TargetMiddle",
+                Superstate::TargetParent => "exit TargetParent",
+                Superstate::Layer(1) => "exit Layer 1",
+                Superstate::Layer(2) => "exit Layer 2",
+                Superstate::Layer(_) => unreachable!(),
+                Superstate::StableBranch(_) => "exit StableBranch",
+                Superstate::AddedParent => "exit AddedParent",
+                Superstate::Root => "exit Root",
+            });
+        }
+
+        fn superstate(&mut self) -> Option<Superstate<'_>> {
+            match self {
+                Superstate::Branch { has_parent: true } => Some(Superstate::Root),
+                Superstate::Branch { has_parent: false } | Superstate::Root => None,
+                Superstate::DynamicBranch(_) | Superstate::DynamicOther => Some(Superstate::Root),
+                Superstate::DynamicInserted(expanded) => Some(Superstate::DynamicBranch(expanded)),
+                Superstate::Reused { target_side: false } => Some(Superstate::SourceParent),
+                Superstate::Reused { target_side: true } => Some(Superstate::TargetMiddle),
+                Superstate::SourceParent | Superstate::TargetParent => Some(Superstate::Root),
+                Superstate::TargetMiddle => Some(Superstate::TargetParent),
+                Superstate::Layer(2) => Some(Superstate::Layer(1)),
+                Superstate::Layer(1) => Some(Superstate::Root),
+                Superstate::Layer(_) => unreachable!(),
+                Superstate::StableBranch(expanded) => {
+                    if expanded.get() {
+                        Some(Superstate::AddedParent)
+                    } else {
+                        Some(Superstate::Root)
+                    }
+                }
+                Superstate::AddedParent => Some(Superstate::Root),
+            }
+        }
+    }
+
+    #[test]
+    fn leaf_origin_survives_a_handler_induced_depth_change() {
+        let mut machine = Machine::<0>::default().uninitialized_state_machine().init();
+        let action_start = machine.inner().actions.len();
+
+        machine.handle(&Event::LeafMovesDeeper);
+
+        assert_eq!(machine.state(), &State::Target);
+        assert_eq!(
+            &machine.inner().actions[action_start..],
+            ["exit Source", "enter Target"]
+        );
+    }
+
+    #[test]
+    fn accepting_superstate_uses_its_invocation_position() {
+        let mut machine = Machine::<1>::default().uninitialized_state_machine().init();
+        let action_start = machine.inner().actions.len();
+
+        machine.handle(&Event::MutableSuperstateAccepts);
+
+        assert_eq!(machine.state(), &State::Target);
+        assert_eq!(
+            &machine.inner().actions[action_start..],
+            ["exit Source", "exit Branch", "enter Branch", "enter Target"]
+        );
+    }
+
+    #[test]
+    fn outside_target_uses_the_changed_source_hierarchy() {
+        let mut machine = Machine::<4>::default().uninitialized_state_machine().init();
+        let action_start = machine.inner().actions.len();
+
+        machine.handle(&Event::DynamicOutsideAccepts);
+
+        assert_eq!(machine.state(), &State::DynamicOutsideTarget);
+        assert_eq!(
+            &machine.inner().actions[action_start..],
+            [
+                "exit DynamicSource",
+                "exit DynamicInserted",
+                "exit DynamicBranch",
+                "enter DynamicOther",
+                "enter DynamicOutsideTarget"
+            ]
+        );
+    }
+
+    #[test]
+    fn same_variant_at_another_depth_remains_outside_the_handler_subtree() {
+        let mut machine = Machine::<2>::default().uninitialized_state_machine().init();
+        let action_start = machine.inner().actions.len();
+
+        machine.handle(&Event::OutsideCollisionAccepts);
+
+        assert_eq!(machine.state(), &State::CollisionTarget);
+        assert_eq!(
+            &machine.inner().actions[action_start..],
+            [
+                "exit CollisionSource",
+                "exit Source Reused",
+                "exit SourceParent",
+                "enter TargetParent",
+                "enter TargetMiddle",
+                "enter Target Reused",
+                "enter CollisionTarget"
+            ]
+        );
+    }
+
+    #[test]
+    fn repeated_superstate_variants_do_not_collapse_the_boundary() {
+        let mut machine = Machine::<3>::default().uninitialized_state_machine().init();
+        let action_start = machine.inner().actions.len();
+
+        machine.handle(&Event::RepeatedSuperstateAccepts);
+
+        assert_eq!(machine.state(), &State::RepeatedTarget);
+        assert_eq!(
+            &machine.inner().actions[action_start..],
+            [
+                "exit RepeatedSource",
+                "exit Layer 2",
+                "exit Layer 1",
+                "enter Layer 1",
+                "enter Layer 2",
+                "enter RepeatedTarget"
+            ]
+        );
+    }
+
+    #[test]
+    fn accepting_handler_reenters_after_its_parent_changes() {
+        let mut machine = Machine::<5>::default().uninitialized_state_machine().init();
+        let action_start = machine.inner().actions.len();
+
+        machine.handle(&Event::StableHandlerGainsParent);
+
+        assert_eq!(
+            machine.state(),
+            &State::StableTarget {
+                expanded: Cell::new(true)
+            }
+        );
+        assert_eq!(
+            &machine.inner().actions[action_start..],
+            [
+                "exit StableSource",
+                "exit StableBranch",
+                "enter StableBranch",
+                "enter StableTarget"
+            ]
+        );
+    }
+}
+
+#[cfg(feature = "async")]
+mod awaitable {
+    use core::future::Future;
+
+    use super::*;
+    use statig::awaitable::{self, IntoStateMachineExt as _};
+    use statig_boundary_tests::block_on;
+
+    #[derive(Default)]
+    struct Machine<const CASE: u8> {
