+#[derive(Debug, Eq, PartialEq)]
+struct Snapshot {
+    state: State,
+    actions: Vec<(&'static str, &'static str, i32)>,
+    transitions: Vec<(&'static str, State, State)>,
+}
+
+fn run(event: Event) -> Snapshot {
+    let mut state_machine = Machine::default().uninitialized_state_machine().init();
+    let action_start = state_machine.inner().actions.len();
+
+    state_machine.handle(&event);
+
+    Snapshot {
+        state: *state_machine.state(),
+        actions: state_machine.inner().actions[action_start..].to_vec(),
+        transitions: state_machine.inner().transitions.clone(),
+    }
+}
+
+fn expected_hooks(target: State) -> Vec<(&'static str, State, State)> {
+    vec![
+        ("before", State::Leaf { value: 1 }, target),
+        ("after", State::Leaf { value: 1 }, target),
+    ]
+}
