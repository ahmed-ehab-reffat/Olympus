+use statig::awaitable::{self, IntoStateMachineExt as _, StateExt as _};
+use statig::{Outcome, StateOrSuperstate};
+use statig_boundary_tests::block_on;
+
+#[derive(Clone, Copy)]
+enum Event {
+    LocalSelf,
+    ExternalSelf,
+    LegacySelf,
+    LocalDeferred,
+    ExternalDeferred,
+    LegacySibling,
+    Handled,
+    Top,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum State {
+    Leaf { value: i32 },
+    Other { value: i32 },
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Superstate {
+    Parent,
+}
+
+#[derive(Clone, Debug, Default, Eq, PartialEq)]
+struct Machine {
+    actions: Vec<(&'static str, &'static str, i32)>,
+    transitions: Vec<(&'static str, State, State)>,
+    dispatch: Vec<&'static str>,
+}
+
+impl awaitable::IntoStateMachine for Machine {
+    type State = State;
+    type Superstate<'sub> = Superstate;
+    type Event<'evt> = Event;
+    type Context<'ctx> = ();
+
+    fn initial() -> Self::State {
+        State::Leaf { value: 1 }
+    }
+
+    fn before_dispatch(
+        &mut self,
+        state_or_superstate: StateOrSuperstate<
+            '_,
+            Self::State,
+            Self::Superstate<'_>,
+        >,
+        _event: &Self::Event<'_>,
+        _context: &mut Self::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        let hook = match state_or_superstate {
+            StateOrSuperstate::State(_) => "before leaf",
+            StateOrSuperstate::Superstate(_) => "before parent",
+        };
+        async move {
+            self.dispatch.push(hook);
+        }
+    }
+
+    fn after_dispatch(
+        &mut self,
+        state_or_superstate: StateOrSuperstate<
+            '_,
+            Self::State,
+            Self::Superstate<'_>,
+        >,
+        _event: &Self::Event<'_>,
+        _context: &mut Self::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        let hook = match state_or_superstate {
+            StateOrSuperstate::State(_) => "after leaf",
+            StateOrSuperstate::Superstate(_) => "after parent",
+        };
+        async move {
+            self.dispatch.push(hook);
+        }
+    }
+
+    fn before_transition(
+        &mut self,
+        source: &Self::State,
+        target: &Self::State,
+        _context: &mut Self::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        let source = *source;
+        let target = *target;
+        async move {
+            self.dispatch.push("before transition");
+            self.transitions.push(("before", source, target));
+        }
+    }
+
+    fn after_transition(
+        &mut self,
+        source: &Self::State,
+        target: &Self::State,
+        _context: &mut Self::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        let source = *source;
+        let target = *target;
+        async move {
+            self.transitions.push(("after", source, target));
+        }
+    }
+}
+
+impl awaitable::State<Machine> for State {
+    fn call_handler(
+        &mut self,
+        shared_storage: &mut Machine,
+        event: &<Machine as awaitable::IntoStateMachine>::Event<'_>,
+        _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+    ) -> impl Future<Output = Outcome<Self>> {
+        shared_storage.dispatch.push("handle leaf");
+        let outcome = match self {
+            State::Leaf { .. } => match event {
+                Event::LocalSelf => Outcome::LocalTransition(State::Leaf { value: 2 }),
+                Event::ExternalSelf => Outcome::ExternalTransition(State::Leaf { value: 3 }),
+                Event::LegacySelf => Outcome::Transition(State::Leaf { value: 4 }),
+                Event::LocalDeferred | Event::ExternalDeferred | Event::Top => Outcome::Super,
+                Event::LegacySibling => Outcome::Transition(State::Other { value: 9 }),
+                Event::Handled => Outcome::Handled,
+            },
+            State::Other { .. } => Outcome::Handled,
+        };
+        core::future::ready(outcome)
+    }
+
+    fn call_entry_action(
+        &mut self,
+        shared_storage: &mut Machine,
+        _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        let (name, value) = state_parts(self);
+        async move {
+            shared_storage.actions.push(("enter", name, value));
+        }
+    }
+
+    fn call_exit_action(
+        &mut self,
+        shared_storage: &mut Machine,
+        _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        let (name, value) = state_parts(self);
+        async move {
+            shared_storage.actions.push(("exit", name, value));
+        }
+    }
+
+    fn superstate(&mut self) -> Option<Superstate> {
+        Some(Superstate::Parent)
+    }
+}
+
+impl awaitable::Superstate<Machine> for Superstate {
+    fn call_handler(
+        &mut self,
+        shared_storage: &mut Machine,
+        event: &<Machine as awaitable::IntoStateMachine>::Event<'_>,
+        _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+    ) -> impl Future<Output = Outcome<State>> {
+        shared_storage.dispatch.push("handle parent");
+        let outcome = match event {
+            Event::LocalDeferred => Outcome::LocalTransition(State::Leaf { value: 5 }),
+            Event::ExternalDeferred => Outcome::ExternalTransition(State::Leaf { value: 6 }),
+            Event::Top => Outcome::Super,
+            _ => Outcome::Handled,
+        };
+        core::future::ready(outcome)
+    }
+
+    fn call_entry_action(
+        &mut self,
+        shared_storage: &mut Machine,
+        _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        async move {
+            shared_storage.actions.push(("enter", "Parent", -1));
+        }
+    }
+
+    fn call_exit_action(
+        &mut self,
+        shared_storage: &mut Machine,
+        _context: &mut <Machine as awaitable::IntoStateMachine>::Context<'_>,
+    ) -> impl Future<Output = ()> {
+        async move {
+            shared_storage.actions.push(("exit", "Parent", -1));
+        }
+    }
+}
+
+fn state_parts(state: &State) -> (&'static str, i32) {
+    match state {
+        State::Leaf { value } => ("Leaf", *value),
+        State::Other { value } => ("Other", *value),
+    }
+}
+
+#[derive(Debug, Eq, PartialEq)]
+struct Snapshot {
+    state: State,
+    actions: Vec<(&'static str, &'static str, i32)>,
+    transitions: Vec<(&'static str, State, State)>,
+}
+
+async fn run(event: Event) -> Snapshot {
+    let mut state_machine = Machine::default()
+        .uninitialized_state_machine()
+        .init()
+        .await;
+    let action_start = state_machine.inner().actions.len();
+
+    state_machine.handle(&event).await;
+
+    Snapshot {
+        state: *state_machine.state(),
+        actions: state_machine.inner().actions[action_start..].to_vec(),
+        transitions: state_machine.inner().transitions.clone(),
+    }
+}
+
+fn expected_hooks(target: State) -> Vec<(&'static str, State, State)> {
+    vec![
+        ("before", State::Leaf { value: 1 }, target),
+        ("after", State::Leaf { value: 1 }, target),
+    ]
+}
+
+#[test]
+fn awaitable_self_transition_storage_and_hooks_match_blocking() {
+    block_on(async {
+        let local = run(Event::LocalSelf).await;
+        assert_eq!(local.state, State::Leaf { value: 2 });
+        assert!(local.actions.is_empty());
+        assert_eq!(local.transitions, expected_hooks(State::Leaf { value: 2 }));
+
+        let external = run(Event::ExternalSelf).await;
+        assert_eq!(external.state, State::Leaf { value: 3 });
+        assert_eq!(
+            external.actions,
+            [("exit", "Leaf", 1), ("enter", "Leaf", 3)]
+        );
+        assert_eq!(
+            external.transitions,
+            expected_hooks(State::Leaf { value: 3 })
+        );
+
+        let legacy = run(Event::LegacySelf).await;
+        assert_eq!(legacy.state, State::Leaf { value: 4 });
+        assert_eq!(legacy.actions, [("exit", "Leaf", 1), ("enter", "Leaf", 4)]);
+        assert_eq!(legacy.transitions, expected_hooks(State::Leaf { value: 4 }));
+    });
+}
+
+#[test]
+fn awaitable_deferred_external_self_reenters_the_accepting_parent() {
+    block_on(async {
+        let local = run(Event::LocalDeferred).await;
+        assert_eq!(local.state, State::Leaf { value: 5 });
+        assert!(local.actions.is_empty());
+        assert_eq!(local.transitions, expected_hooks(State::Leaf { value: 5 }));
+
+        let external = run(Event::ExternalDeferred).await;
+        assert_eq!(external.state, State::Leaf { value: 6 });
+        assert_eq!(
+            external.actions,
+            [
+                ("exit", "Leaf", 1),
+                ("exit", "Parent", -1),
+                ("enter", "Parent", -1),
+                ("enter", "Leaf", 6)
+            ]
+        );
+        assert_eq!(
+            external.transitions,
+            expected_hooks(State::Leaf { value: 6 })
+        );
+    });
+}
+
+#[test]
+fn deferred_external_transition_preserves_dispatch_hooks() {
+    block_on(async {
+        let mut machine = Machine::default()
+            .uninitialized_state_machine()
+            .init()
+            .await;
+
+        machine.handle(&Event::ExternalDeferred).await;
+
+        assert_eq!(
+            machine.inner().dispatch,
+            [
+                "before leaf",
+                "handle leaf",
+                "after leaf",
+                "before parent",
+                "handle parent",
+                "after parent",
+                "before transition",
+            ]
+        );
+    });
+}
+
+#[test]
+fn awaitable_legacy_sibling_and_non_transitions_are_unchanged() {
+    block_on(async {
+        let sibling = run(Event::LegacySibling).await;
+        assert_eq!(sibling.state, State::Other { value: 9 });
+        assert_eq!(
+            sibling.actions,
+            [("exit", "Leaf", 1), ("enter", "Other", 9)]
+        );
+        assert_eq!(
+            sibling.transitions,
+            expected_hooks(State::Other { value: 9 })
+        );
+
+        let handled = run(Event::Handled).await;
+        assert!(handled.actions.is_empty());
+        assert!(handled.transitions.is_empty());
+
+        let top = run(Event::Top).await;
+        assert!(top.actions.is_empty());
+        assert!(top.transitions.is_empty());
+    });
+}
+
+#[test]
+fn public_awaitable_state_extension_preserves_outcome_variants() {
+    block_on(async {
+        let mut storage = Machine::default();
+        let mut context = ();
+        let mut leaf = State::Leaf { value: 1 };
+
+        let local: Outcome<State> = leaf
+            .handle(&mut storage, &Event::LocalSelf, &mut context)
+            .await;
+        assert_eq!(local, Outcome::LocalTransition(State::Leaf { value: 2 }));
+
+        let deferred: Outcome<State> = leaf
+            .handle(&mut storage, &Event::ExternalDeferred, &mut context)
+            .await;
+        assert_eq!(
+            deferred,
+            Outcome::ExternalTransition(State::Leaf { value: 6 })
+        );
+    });
+}
