FROM public.ecr.aws/d3j8x8q7/olympus-base-rust:latest
WORKDIR /app
COPY . .
# Pin the toolchain to the base image's stable Rust (the repo pins nightly, which is
# absent offline). Also create a placeholder for the example wasm that resume_execution.rs
# embeds via include_bytes! (the real artifact is generated by examples/rust/build.sh, which
# needs binaryen and wabt); the placeholder lets the full offline `cargo test` compile and run.
RUN printf '[toolchain]\nchannel = "1.95.0"\n' > rust-toolchain.toml \
    && mkdir -p examples/rust/out \
    && printf 'offline placeholder fixture for resume_execution.rs; real artifact built by examples/rust/build.sh' > examples/rust/out/fibonacci.wasm \
    && cargo fetch --locked \
    && cargo build --workspace --locked \
    && chmod -R a+rwX /app /opt/cargo
CMD ["/bin/bash"]
