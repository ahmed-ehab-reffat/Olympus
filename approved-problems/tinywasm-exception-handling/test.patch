+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"
+rm -f rust-toolchain.toml 2>/dev/null || true
+
+MODE=""; OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/tinywasm_eh_${MODE}.xml"
+
+NEW_TEST_FILE="crates/tinywasm/tests/exception_handling_7f3a2c.rs"
+CLASSNAME="tinywasm-exception-handling"
+
+run_and_produce_junit() {
+    local output_path="$1"; shift
+    local test_output exit_code=0
+    test_output=$("$@" 2>&1) || exit_code=$?
+    echo "$test_output"
+
+    local passed=0 failed=0 testcases=""
+    while IFS= read -r line; do
+        if [[ "$line" =~ ^test\ ([A-Za-z0-9_:]+)\ \.\.\.\ ok ]]; then
+            testcases+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\" />"$'\n'
+            ((passed++)) || true
+        elif [[ "$line" =~ ^test\ ([A-Za-z0-9_:]+)\ \.\.\.\ FAILED ]]; then
+            testcases+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\"><failure message=\"assertion failed\"/></testcase>"$'\n'
+            ((failed++)) || true
+        fi
+    done <<< "$test_output"
+
+    if [ $((passed + failed)) -eq 0 ] && [ $exit_code -ne 0 ]; then
+        local sanitized names=""
+        sanitized=$(printf '%s' "$test_output" | tail -c 4000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+        if [ "$MODE" = "new" ]; then
+            names=$(grep -A1 '#\[test\]' "$NEW_TEST_FILE" 2>/dev/null | grep -oE 'fn [A-Za-z0-9_]+' | sed 's/fn //')
+        fi
+        if [ -n "$names" ]; then
+            while IFS= read -r name; do
+                [ -z "$name" ] && continue
+                testcases+="    <testcase name=\"${name}\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+                ((failed++)) || true
+            done <<< "$names"
+        else
+            testcases="    <testcase name=\"compilation\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+            failed=1
+        fi
+    fi
+
+    mkdir -p "$(dirname "$output_path")"
+    cat > "$output_path" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="${CLASSNAME}" tests="$((passed + failed))" failures="${failed}" errors="0">
+${testcases}  </testsuite>
+</testsuites>
+XMLEOF
+    return $exit_code
+}
+
+case "$MODE" in
+  base) run_and_produce_junit "$OUTPUT_PATH" cargo test --offline --workspace --lib ;;
+  new)  run_and_produce_junit "$OUTPUT_PATH" cargo test --offline -p tinywasm --test exception_handling_7f3a2c ;;
+esac
