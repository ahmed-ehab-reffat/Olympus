+        (block $outer (result i32)
+          (try_table (result i32) (catch $b $outer)
+            (block $inner (result i32)
+              (try_table (result i32) (catch $a $inner)
+                (i32.const 5)
+                (throw $b)))
+            (i32.const 1000)
+            (i32.add)
+            (br $outer)))))
+    "#;
+    assert_eq!(run_i32(wat, "test"), 5);
+}
