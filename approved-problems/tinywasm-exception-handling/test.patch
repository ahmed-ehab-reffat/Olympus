+    let wat = r#"
+    (module
+      (import "env" "host" (func $host (result i32)))
+      (tag $t (param i32))
+      (tag $b (param i32))
+      (func (export "inner") (result i32)
+        (block $ih (result i32)
+          (try_table (result i32) (catch $t $ih)
+            (i32.const 7)
+            (throw $b))))
+      (func (export "outer") (result i32)
+        (i32.const 500)
+        (block $oh (result i32)
+          (try_table (result i32) (catch $t $oh)
+            (call $host)
+            (drop)
+            (i32.const 42)
+            (throw $t)))
+        (i32.add)))
+    "#;
+    let module = tinywasm::parse_bytes(&wat::parse_str(wat).unwrap()).unwrap();
+    let mut store = Store::default();
+    let host = HostFunction::from(&mut store, |mut ctx, ()| -> tinywasm::Result<i32> {
+        let ExternItem::Func(inner) = ctx.extern_item("inner")? else {
+            unreachable!("inner export missing");
+        };
+        let _ = ctx.call_untyped(&inner, &[]);
+        Ok(0)
+    });
+    let mut imports = Imports::new();
+    imports.define("env", "host", host);
+    let instance = ModuleInstance::instantiate(&mut store, &module, Some(imports)).unwrap();
+    let outer = instance.func::<(), i32>(&store, "outer").unwrap();
+    assert_eq!(outer.call(&mut store, ()).unwrap(), 542);
+}
+
+#[test]
+fn sequential_invocations_do_not_leak_handler_state() {
+    let wat = r#"
+    (module
+      (tag $t (param i32))
+      (tag $b (param i32))
+      (func (export "boom") (result i32)
+        (block $bh (result i32)
+          (try_table (result i32) (catch $t $bh)
+            (i32.const 9)
+            (throw $b))))
+      (func (export "probe") (result i32)
+        (i32.const 55)
+        (throw $t)))
+    "#;
+    let module = tinywasm::parse_bytes(&wat::parse_str(wat).unwrap()).unwrap();
+    let mut store = Store::default();
+    let instance = ModuleInstance::instantiate(&mut store, &module, None).unwrap();
+    let boom = instance.func::<(), i32>(&store, "boom").unwrap();
+    assert!(boom.call(&mut store, ()).is_err());
+    let probe = instance.func::<(), i32>(&store, "probe").unwrap();
+    assert!(matches!(probe.call(&mut store, ()), Err(Error::Trap(_))), "leaked handler must not catch a fresh invocation's throw");
+}
