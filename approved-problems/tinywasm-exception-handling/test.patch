+use tinywasm::{Error, ExternItem, HostFunction, Imports, ModuleInstance, Store};
+
+fn run_i32(wat: &str, name: &str) -> i32 {
+    let wasm = wat::parse_str(wat).unwrap();
+    let module = tinywasm::parse_bytes(&wasm).unwrap();
+    let mut store = Store::default();
+    let inst = ModuleInstance::instantiate(&mut store, &module, None).unwrap();
+    let f = inst.func::<(), i32>(&store, name).unwrap();
+    f.call(&mut store, ()).unwrap()
+}
+
+fn run_i32_arg(wat: &str, name: &str, arg: i32) -> i32 {
+    let wasm = wat::parse_str(wat).unwrap();
+    let module = tinywasm::parse_bytes(&wasm).unwrap();
+    let mut store = Store::default();
+    let inst = ModuleInstance::instantiate(&mut store, &module, None).unwrap();
+    let f = inst.func::<(i32,), i32>(&store, name).unwrap();
+    f.call(&mut store, (arg,)).unwrap()
+}
+
+fn expect_uncaught(wat: &str, name: &str) {
+    let wasm = wat::parse_str(wat).unwrap();
+    let module = tinywasm::parse_bytes(&wasm).unwrap();
+    let mut store = Store::default();
+    let inst = ModuleInstance::instantiate(&mut store, &module, None).unwrap();
+    let f = inst.func::<(), i32>(&store, name).unwrap();
+    let err = f.call(&mut store, ()).unwrap_err();
+    assert!(matches!(err, Error::Trap(_)), "expected a trap, got: {err}");
+}
+
+#[test]
+fn throw_caught_same_function_pushes_values() {
+    let wat = r#"
+    (module
+      (tag $t (param i32))
+      (func (export "test") (result i32)
+        (block $h (result i32)
+          (try_table (result i32) (catch $t $h)
+            (i32.const 42)
+            (throw $t)))))
+    "#;
+    assert_eq!(run_i32(wat, "test"), 42);
+}
+
