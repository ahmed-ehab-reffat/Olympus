+        (i32.const 21)
+        (throw 0)))
+    "#;
+    let wat_b = r#"
+    (module
+      (import "a" "t" (tag $t (param i32)))
+      (import "a" "throwit" (func $throwit (result i32)))
+      (func (export "test") (result i32)
+        (block $h (result i32)
+          (try_table (result i32) (catch $t $h)
+            (call $throwit)))))
+    "#;
+
+    let mut store = Store::default();
+    let module_a = tinywasm::parse_bytes(&wat::parse_str(wat_a).unwrap()).unwrap();
+    let inst_a = ModuleInstance::instantiate(&mut store, &module_a, None).unwrap();
+
+    let mut imports = Imports::new();
+    imports.link_module("a", inst_a).unwrap();
+
+    let module_b = tinywasm::parse_bytes(&wat::parse_str(wat_b).unwrap()).unwrap();
+    let inst_b = ModuleInstance::instantiate(&mut store, &module_b, Some(imports)).unwrap();
+    let f = inst_b.func::<(), i32>(&store, "test").unwrap();
+    assert_eq!(f.call(&mut store, ()).unwrap(), 21);
+}
