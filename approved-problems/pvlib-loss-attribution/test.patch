+    chain.run_model(clearsky_weather())
+    assert chain.results.loss_attribution is None
+
+
+def test_ac_field_matches_results_ac():
+    chain = pvwatts_chain()
+    attribution = run(chain)
+    assert_series_close(attribution.ac, chain.results.ac)
+
+
+def test_additivity_pvwatts_clearsky():
+    assert_additive(run(pvwatts_chain()))
+
+
+def test_additivity_pvwatts_cloudy():
+    assert_additive(run(pvwatts_chain(), cloudy_weather()))
+
+
+def test_additivity_pvwatts_cold():
+    assert_additive(run(pvwatts_chain(), cold_weather()))
+
+
+def test_additivity_pvwatts_hot():
+    assert_additive(run(pvwatts_chain(), hot_weather()))
+
+
+def test_additivity_pvwatts_night():
+    assert_additive(run(pvwatts_chain(), night_weather()))
+
+
+def test_additivity_with_extra_losses():
+    assert_additive(run(pvwatts_chain(extra_losses=True)))
+
+
+def test_additivity_sapm():
+    assert_additive(run(sapm_chain()))
+
+
+def test_additivity_sapm_without_spectral_model():
+    assert_additive(run(sapm_chain(spectral_model='no_loss')))
+
+
+def test_additivity_cec_with_ohmic():
+    assert_additive(run(cec_chain()))
+
+
+def test_additivity_two_arrays():
+    assert_additive(run(two_array_chain()))
+
+
+def test_additivity_three_arrays():
+    assert_additive(run(three_array_chain()))
+
+
+def test_additivity_two_arrays_cloudy():
+    assert_additive(run(two_array_chain(), cloudy_weather()))
+
+
+def test_additivity_fd_below_one():
+    assert_additive(run(pvwatts_chain(fd=0.5)))
+
+
+def test_additivity_single_timestamp():
+    weather = clearsky_weather().iloc[6:7]
