+def no_optics_chain(system, **kwargs):
+    return ModelChain(system, location(), aoi_model='no_loss',
+                      spectral_model='no_loss', **kwargs)
+
+
+def clearsky_like(chain, model='ineichen'):
+    solar_position = chain.results.solar_position
+    sky = location().get_clearsky(solar_position.index, model=model,
+                                  solar_position=solar_position)
+    return sky.assign(temp_air=25.0, wind_speed=1.0)
+
+
+def flat_system():
+    return PVSystem(arrays=[pvwatts_array(tilt=0, azimuth=180)],
+                    inverter_parameters={'pdc0': 200})
+
+
+def tilted_system():
+    return PVSystem(arrays=[pvwatts_array(tilt=30, azimuth=180)],
+                    inverter_parameters={'pdc0': 200})
+
+
+def fixed_cell_temperature(frame):
+    return frame.assign(cell_temperature=25.0)
+
+
+def summed_dc(chain):
+    dc = chain.results.dc
+    if isinstance(dc, tuple):
+        total = None
+        for one in dc:
+            series = one['p_mp'] if isinstance(one, pd.DataFrame) else one
+            total = series.copy() if total is None else total + series
+        return total
+    return dc['p_mp'] if isinstance(dc, pd.DataFrame) else dc
+
