+def multiplicative_chain():
+    system = PVSystem(arrays=[pvwatts_array()],
+                      inverter_parameters={'pdc0': 200})
+    return ModelChain(system, location(), aoi_model='no_loss',
+                      spectral_model=constant_spectral,
+                      dc_model=linear_dc,
+                      dc_ohmic_model=constant_ohmic,
+                      losses_model=constant_losses,
+                      ac_model=ninety_percent_ac,
+                      temperature_model='sapm')
+
+
+def expected_multiplicative_shapley(base):
+    factors = {'reflection': 1.0, 'spectral': 0.95, 'temperature': 1.0,
+               'dc_ohmic': 0.95, 'dc_other': 0.9, 'inverter': 0.9}
+    credited = {name: 0.0 for name in MECHANISMS}
+    orderings = list(itertools.permutations(MECHANISMS))
+    for ordering in orderings:
+        running = 1.0
+        for name in ordering:
+            credited[name] += running * (1.0 - factors[name])
+            running *= factors[name]
+    return {name: base * value / len(orderings)
+            for name, value in credited.items()}
+
+
+def test_shapley_values_match_a_multiplicative_model():
+    chain = multiplicative_chain()
+    chain.run_loss_attribution(clearsky_weather())
+    attribution = chain.results.loss_attribution
+    credited = attribution.shapley()
+    base = attribution.cumulative()['weather']
+    expected = expected_multiplicative_shapley(base)
+    for name in MECHANISMS:
+        assert_series_close(credited[name], expected[name], tol=1e-6)
+
+
+def test_shapley_multiplicative_model_is_additive():
+    chain = multiplicative_chain()
+    chain.run_loss_attribution(clearsky_weather())
+    attribution = chain.results.loss_attribution
+    credited = attribution.shapley()
+    expected = attribution.cumulative()['weather'] - attribution.ac
+    assert_series_close(shapley_total(credited), expected, tol=1e-6)
+
+
+def test_shapley_does_not_disturb_ordinary_results():
+    plain = pvwatts_chain(extra_losses=True)
+    plain.run_model(clearsky_weather())
+    attributed = pvwatts_chain(extra_losses=True)
+    attributed.run_loss_attribution(clearsky_weather())
+    attributed.results.loss_attribution.shapley()
+    assert_series_close(attributed.results.dc, plain.results.dc)
+    assert_series_close(attributed.results.ac, plain.results.ac)
+    assert_series_close(attributed.results.effective_irradiance,
+                        plain.results.effective_irradiance)
+    assert_series_close(attributed.results.cell_temperature,
+                        plain.results.cell_temperature)
+
+
+def test_shapley_does_not_disturb_the_sequential_buckets():
+    attribution = run(pvwatts_chain(extra_losses=True))
+    before = attribution.to_frame()
+    attribution.shapley()
+    after = attribution.to_frame()
+    assert_series_close(before.to_numpy().ravel(), after.to_numpy().ravel())
+
+
+def test_shapley_survives_a_later_ordinary_run():
+    chain = pvwatts_chain(extra_losses=True)
+    chain.run_loss_attribution(clearsky_weather())
+    attribution = chain.results.loss_attribution
