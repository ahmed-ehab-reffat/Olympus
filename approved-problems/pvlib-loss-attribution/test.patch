+
+
+def test_temperature_bucket_zero_at_reference_cell_temperature():
+    weather = clearsky_weather().assign(cell_temperature=25.0)
+    attribution = run(pvwatts_chain(), weather)
+    assert_series_close(attribution.temperature, np.zeros(len(times())),
