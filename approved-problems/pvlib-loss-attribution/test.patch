+def dc_share(attribution, i):
+    frame = attribution.to_frame(per_array=True)
+    total = None
+    for other in range(attribution.num_arrays):
+        column = frame[(other, 'reference')].copy()
+        for name in ['transposition', 'weather', 'reflection', 'spectral',
+                     'temperature', 'dc_ohmic', 'dc_other']:
+            column = column - frame[(other, name)]
+        total = column if total is None else total + column
+        if other == i:
+            mine = column
+    return mine, total
+
