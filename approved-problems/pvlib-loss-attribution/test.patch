+import numpy as np
+import itertools
+import pytest
+import pandas as pd
+
+import pvlib
+from pvlib.location import Location
+from pvlib.modelchain import ModelChain
+from pvlib.pvsystem import (Array, FixedMount, PVSystem,
+                            SingleAxisTrackerMount, retrieve_sam)
+
+BUCKETS = ['transposition', 'weather', 'reflection', 'spectral',
+           'temperature', 'dc_ohmic', 'dc_other', 'inverter']
+COLUMNS = ['reference'] + BUCKETS + ['ac']
+TEMP_PARAMS = {'a': -3.56, 'b': -0.075, 'deltaT': 3}
+
+
+def location():
+    return Location(32.2, -110.9, 'MST', 700)
+
+
+def times():
+    return pd.date_range('2019-06-01 05:00', '2019-06-01 19:00', freq='h',
+                         tz='MST')
+
+
+def clearsky_weather():
+    index = times()
+    sky = location().get_clearsky(index)
+    return sky.assign(temp_air=25.0, wind_speed=1.0)
+
+
+def cloudy_weather():
+    sky = clearsky_weather()
+    sky[['ghi', 'dni']] *= 0.4
+    return sky
+
+
+def cold_weather():
+    return clearsky_weather().assign(temp_air=-15.0, wind_speed=8.0)
+
+
+def hot_weather():
+    return clearsky_weather().assign(temp_air=45.0, wind_speed=0.5)
+
+
+def night_weather():
+    index = pd.date_range('2019-06-01 22:00', periods=4, freq='h', tz='MST')
+    return pd.DataFrame({'ghi': 0.0, 'dni': 0.0, 'dhi': 0.0,
+                         'temp_air': 12.0, 'wind_speed': 1.0}, index=index)
+
+
+def pvwatts_array(pdc0=220, fd=None, tilt=30, azimuth=180, ohmic=None):
+    module = {'pdc0': pdc0, 'gamma_pdc': -0.004}
+    if fd is not None:
+        module['FD'] = fd
+    losses = None if ohmic is None else {'dc_ohmic_percent': ohmic}
+    return Array(FixedMount(tilt, azimuth), module_parameters=module,
+                 temperature_model_parameters=TEMP_PARAMS,
+                 array_losses_parameters=losses)
+
+
+def pvwatts_chain(fd=None, tilt=30, extra_losses=False,
+                  aoi_model='physical', spectral_model='no_loss', **kwargs):
+    system = PVSystem(arrays=[pvwatts_array(fd=fd, tilt=tilt)],
+                      inverter_parameters={'pdc0': 200},
+                      losses_parameters={'soiling': 2, 'shading': 3,
+                                         'snow': 0, 'mismatch': 2,
+                                         'wiring': 2, 'connections': 0.5,
+                                         'lid': 1.5, 'nameplate_rating': 1,
+                                         'age': 0, 'availability': 3})
+    return ModelChain(system, location(), aoi_model=aoi_model,
+                      spectral_model=spectral_model,
+                      losses_model='pvwatts' if extra_losses else 'no_loss',
+                      **kwargs)
+
+
+def sapm_chain(spectral_model='sapm', **kwargs):
+    module = retrieve_sam('SandiaMod')['Canadian_Solar_CS5P_220M___2009_']
+    inverter = retrieve_sam('cecinverter')[
+        'ABB__MICRO_0_25_I_OUTD_US_208__208V_']
+    array = Array(FixedMount(30, 180), module_parameters=module,
+                  temperature_model_parameters=TEMP_PARAMS)
+    system = PVSystem(arrays=[array], inverter_parameters=inverter)
+    return ModelChain(system, location(), aoi_model='physical',
+                      spectral_model=spectral_model, **kwargs)
+
+
+def cec_chain(ohmic=2.0):
+    module = dict(retrieve_sam('CECMod')['Canadian_Solar_Inc__CS5P_220M'])
+    inverter = retrieve_sam('cecinverter')[
+        'ABB__MICRO_0_25_I_OUTD_US_208__208V_']
+    array = Array(FixedMount(30, 180), module_parameters=module,
+                  temperature_model_parameters=TEMP_PARAMS,
+                  array_losses_parameters={'dc_ohmic_percent': ohmic})
+    system = PVSystem(arrays=[array], inverter_parameters=inverter)
+    return ModelChain(system, location(), aoi_model='physical',
+                      spectral_model='no_loss',
+                      dc_ohmic_model='dc_ohms_from_percent')
+
+
+def two_array_chain():
+    system = PVSystem(
+        arrays=[pvwatts_array(pdc0=220, tilt=30, azimuth=180),
+                pvwatts_array(pdc0=150, tilt=10, azimuth=90)],
+        inverter_parameters={'pdc0': 300})
+    return ModelChain(system, location(), aoi_model='physical',
+                      spectral_model='no_loss')
+
+
+def two_array_sandia_chain():
+    module = retrieve_sam('SandiaMod')['Canadian_Solar_CS5P_220M___2009_']
+    inverter = retrieve_sam('SandiaInverter')[
+        'ABB__MICRO_0_25_I_OUTD_US_208__208V_']
+    first = Array(FixedMount(30, 180), module_parameters=module,
+                  temperature_model_parameters=TEMP_PARAMS,
+                  modules_per_string=7)
+    second = Array(FixedMount(10, 90), module_parameters=module,
+                   temperature_model_parameters=TEMP_PARAMS,
+                   modules_per_string=5)
+    system = PVSystem(arrays=[first, second], inverter_parameters=inverter)
+    return ModelChain(system, location(), aoi_model='physical',
+                      spectral_model='sapm')
+
+
+def three_array_chain():
+    system = PVSystem(
+        arrays=[pvwatts_array(pdc0=220, tilt=30, azimuth=180),
+                pvwatts_array(pdc0=150, tilt=10, azimuth=90),
+                pvwatts_array(pdc0=180, tilt=45, azimuth=270)],
+        inverter_parameters={'pdc0': 400})
+    return ModelChain(system, location(), aoi_model='physical',
+                      spectral_model='no_loss')
+
+
+def poa_data(tilt=30, azimuth=180):
+    index = times()
+    sky = location().get_clearsky(index)
+    solpos = location().get_solarposition(index)
+    poa = pvlib.irradiance.get_total_irradiance(
+        tilt, azimuth, solpos['apparent_zenith'], solpos['azimuth'],
+        sky['dni'], sky['ghi'], sky['dhi'])
+    return poa.assign(temp_air=25.0, wind_speed=1.0)
+
+
+def effective_data():
+    poa = poa_data()
+    return pd.DataFrame({'effective_irradiance': poa['poa_global'],
+                         'temp_air': 25.0, 'wind_speed': 1.0},
+                        index=poa.index)
+
+
+def run(chain, weather=None):
+    chain.run_loss_attribution(clearsky_weather() if weather is None
+                               else weather)
+    return chain.results.loss_attribution
+
+
+def assert_additive(attribution, tol=1e-8):
+    frame = attribution.to_frame()
+    buckets = frame[BUCKETS]
+    missing = buckets.isna()
+    assert bool(missing.sum(axis=1).isin([0, len(BUCKETS)]).all())
+    known = ~missing.any(axis=1) & frame['ac'].notna()
+    assert bool(known.any())
+    residual = frame['reference'] - buckets.sum(axis=1) - frame['ac']
+    scale = max(float(frame['reference'].abs().max()), 1.0)
+    assert float(residual[known].abs().max()) <= tol * scale
+
+
+def assert_series_close(left, right, tol=1e-8):
+    left = np.asarray(left, dtype=float)
+    right = np.asarray(right, dtype=float)
+    missing = np.isnan(left)
+    assert np.array_equal(missing, np.isnan(right))
+    assert np.allclose(left[~missing], right[~missing], rtol=0, atol=tol)
+
+
+def test_run_loss_attribution_returns_the_chain():
+    chain = pvwatts_chain()
+    assert chain.run_loss_attribution(clearsky_weather()) is chain
+
+
+def test_attribution_is_stored_on_results():
+    chain = pvwatts_chain()
+    chain.run_loss_attribution(clearsky_weather())
+    assert chain.results.loss_attribution is not None
+
+
+def test_attribution_absent_before_running():
