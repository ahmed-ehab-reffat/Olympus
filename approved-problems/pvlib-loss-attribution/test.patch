+
+
+def test_dc_ohmic_bucket_zero_without_ohmic_model():
+    attribution = run(pvwatts_chain())
+    assert_series_close(attribution.dc_ohmic, np.zeros(len(times())))
+
+
+def test_dc_ohmic_bucket_positive_with_ohmic_model():
+    attribution = run(cec_chain())
