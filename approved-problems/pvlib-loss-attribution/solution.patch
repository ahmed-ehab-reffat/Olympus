+    def _per_array(self, value):
+        """Broadcast a result to a tuple with one entry per array."""
+        if isinstance(value, tuple):
+            return value
+        return (value,) * self.system.num_arrays
+
+    def _as_series(self, values, index):
+        """Coerce per-array values that may be scalars to Series."""
+        return tuple(value if isinstance(value, pd.Series)
+                     else pd.Series(value, index=index, dtype=float)
+                     for value in values)
+
+    def _assign_per_array(self, name, values):
+        """Assign per-array values using the shape the chain itself uses."""
+        if self.system.num_arrays == 1:
+            setattr(self.results, name, values[0])
+        else:
+            setattr(self.results, name, values)
+
+    def _attribution_shape(self, values):
+        """Present per-array attribution values as ``results`` would."""
+        if self.system.num_arrays == 1:
+            return self.results._result_type(values[0])
+        return values
+
+    def _staged_effective_irradiance(self, aoi_modifier, spectral_modifier):
+        """Re-run the effective irradiance model with given modifiers."""
+        self._assign_per_array('aoi_modifier', aoi_modifier)
+        self._assign_per_array('spectral_modifier', spectral_modifier)
+        self.effective_irradiance_model()
+        return self._per_array(self.results.effective_irradiance)
+
+    def _clearsky_irradiance(self):
+        """Clear-sky irradiance components from the chain's own model."""
+        solar_position = self.results.solar_position
+        return self.location.get_clearsky(
+            solar_position.index,
+            model=self.clearsky_model,
+            solar_position=solar_position)
+
+    def _clearsky_total_irradiance(self):
+        """
+        Transpose clear-sky irradiance onto every array.
+
+        Uses the chain's own clear-sky, airmass and transposition models and
+        the orientation the arrays already had, so the result differs from
+        ``results.total_irrad`` only through the sky condition.
+        """
+        solar_position = self.results.solar_position
+        clearsky = self._clearsky_irradiance()
+        return self._per_array(self.system.get_irradiance(
+            solar_position['apparent_zenith'],
+            solar_position['azimuth'],
+            clearsky['dni'],
+            clearsky['ghi'],
+            clearsky['dhi'],
+            albedo=self._array_albedo(),
+            airmass=self.results.airmass['airmass_relative'],
+            model=self.transposition_model))
+
+    def _array_albedo(self):
+        """Albedo of each array, falling back to the array's own value."""
+        if self.results.albedo is None:
+            return tuple(array.albedo for array in self.system.arrays)
+        return self._per_array(self.results.albedo)
+
+    def _horizontal_total_irradiance(self):
+        """
+        Transpose clear-sky irradiance onto a horizontal surface.
+
+        Every array is given a surface tilt of zero, so the result differs
+        from :py:meth:`_clearsky_total_irradiance` only through orientation.
+        """
+        solar_position = self.results.solar_position
+        clearsky = self._clearsky_irradiance()
+        albedo = self._array_albedo()
+        dni_extra = pvlib.irradiance.get_extra_radiation(
+            solar_position.index)
+        return tuple(
+            pvlib.irradiance.get_total_irradiance(
+                0.0, 180.0,
+                solar_position['apparent_zenith'],
+                solar_position['azimuth'],
+                clearsky['dni'],
+                clearsky['ghi'],
+                clearsky['dhi'],
+                dni_extra=dni_extra,
+                albedo=array_albedo,
+                airmass=self.results.airmass['airmass_relative'],
+                model=self.transposition_model)
