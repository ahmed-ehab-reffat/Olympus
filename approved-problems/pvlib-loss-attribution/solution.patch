+"""
+The ``lossattribution`` module contains the container that
+:py:class:`~pvlib.modelchain.ModelChain` fills in when a simulation is
+decomposed into the mechanisms that reduce AC power.
+"""
+
+from dataclasses import dataclass, field
+import itertools
+import math
+from typing import Optional, Tuple, TypeVar, Union
+
+import pandas as pd
+
+T = TypeVar('T')
+
+PerArray = Union[T, Tuple[T, ...]]
+
+REFERENCE_CELL_TEMPERATURE = 25.0
+"""Cell temperature (C) at which the temperature-free stages are evaluated."""
+
+BUCKET_NAMES = ('transposition', 'weather', 'reflection', 'spectral',
+                'temperature', 'dc_ohmic', 'dc_other', 'inverter')
+"""Names of the loss buckets, in the order the stages are applied."""
+
+PER_ARRAY_BUCKETS = ('transposition', 'weather', 'reflection', 'spectral',
+                     'temperature', 'dc_ohmic', 'dc_other')
+"""Buckets that are reported for each array."""
+
+FRAME_COLUMNS = ('reference',) + BUCKET_NAMES + ('ac',)
+"""Column order of :py:meth:`LossAttribution.to_frame`."""
+
+CONVERSION_MECHANISMS = ('reflection', 'spectral', 'temperature', 'dc_ohmic',
+                         'dc_other', 'inverter')
+"""Mechanisms :py:meth:`LossAttribution.shapley` credits, in bucket order."""
+
+
+def sum_over_arrays(value):
+    """
+    Add per-array values into a single system-wide value.
+
+    Parameters
+    ----------
+    value : Series, or tuple of Series
+        Per-array quantity. A bare Series is returned unchanged.
+
+    Returns
+    -------
+    Series
+    """
+    if isinstance(value, tuple):
+        total = value[0].copy()
+        for other in value[1:]:
+            total = total + other
+        return total
+    return value
+
+
+def energy(power):
+    """
+    Total energy of a power Series, taken as the sum over its index.
+
+    Parameters
+    ----------
+    power : Series
+        Power [W].
+
+    Returns
+    -------
+    float
+    """
+    return float(power.sum())
+
+
+def energy_fraction(bucket_energy, reference_energy):
+    """
+    Express a bucket energy as a fraction of the reference energy.
+
+    Parameters
+    ----------
+    bucket_energy : float
+        Energy attributed to one mechanism.
+    reference_energy : float
+        Energy of the loss-free reference stage.
+
+    Returns
+    -------
+    float
+        Zero when ``reference_energy`` is zero.
+    """
+    if reference_energy == 0:
+        return 0.0
+    return bucket_energy / reference_energy
+
+
+@dataclass
+class LossAttribution:
+    """
+    Decomposition of a :py:class:`~pvlib.modelchain.ModelChain` simulation
+    into the mechanisms that reduce AC power.
+
+    Every bucket is a power [W] on the model index. A bucket is negative when
+    its mechanism increases power, which happens for ``temperature`` below
+    :py:data:`REFERENCE_CELL_TEMPERATURE` and for spectral modifiers above
+    one.
+    """
+
+    reference: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of DC power [W] from
+    clear-sky irradiance on a horizontal surface, with no reflection loss, no
+    spectral loss and a cell temperature of
+    :py:data:`REFERENCE_CELL_TEMPERATURE`."""
+
+    transposition: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost by
+    orienting the modules as they are rather than horizontally. Negative
+    whenever the orientation collects more irradiance than a horizontal
+    surface would."""
+
+    weather: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost because
+    the sky was not clear."""
+
+    reflection: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost to
+    reflection."""
+
+    spectral: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost to
+    spectral content."""
+
+    temperature: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost to cell
+    temperature."""
+
+    dc_ohmic: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost to DC
+    ohmic resistance."""
+
+    dc_other: Optional[PerArray[pd.Series]] = field(default=None)
+    """Series (or tuple of Series, one per array) of power [W] lost to the
+    remaining DC losses."""
+
+    inverter: Optional[pd.Series] = field(default=None)
+    """Series of power [W] lost in the inverter, for the system as a whole."""
+
+    ac: Optional[pd.Series] = field(default=None)
+    """Series of AC power [W] for the system as a whole."""
+
+    _lattice: Optional[object] = field(default=None, repr=False)
+    """Callable returning the power of every subset of
+    :py:data:`CONVERSION_MECHANISMS`, used by
+    :py:meth:`shapley`."""
+
+    @property
+    def num_arrays(self):
+        """Number of arrays the per-array buckets were reported for."""
+        if isinstance(self.reference, tuple):
+            return len(self.reference)
+        return 1
+
+    def _per_array_value(self, name, i):
+        """One array's entry of a per-array field."""
+        value = getattr(self, name)
+        if isinstance(value, tuple):
+            return value[i]
+        return value
+
+    def _array_dc(self, i):
+        """DC power one array delivered to the inverter."""
+        remaining = self._per_array_value('reference', i)
+        for name in PER_ARRAY_BUCKETS:
+            remaining = remaining - self._per_array_value(name, i)
+        return remaining
+
+    def _inverter_share(self, i):
+        """
+        Split the inverter loss across arrays by DC contribution.
+
+        The inverter is a system-wide device, so its loss is allocated in
+        proportion to the DC power each array delivered to it. Wherever no
+        array delivered any power the loss is split equally instead, so that
+        the shares always add up to the whole.
+        """
+        total = self._array_dc(0)
+        for other in range(1, self.num_arrays):
+            total = total + self._array_dc(other)
+        share = (self._array_dc(i) / total).where(
+            total != 0, 1.0 / self.num_arrays)
+        return self.inverter * share
+
+    def _array_column(self, name, i):
+        """One array's contribution to a column of :py:meth:`to_frame`."""
+        if name == 'inverter':
+            return self._inverter_share(i)
+        if name == 'ac':
+            return self._array_dc(i) - self._inverter_share(i)
+        return self._per_array_value(name, i)
+
+    def to_frame(self, per_array=False):
+        """
+        Collect the decomposition into a DataFrame.
+
+        Parameters
+        ----------
+        per_array : bool, default False
+            When False every per-array bucket is summed over the arrays, so
+            each column is a system-wide power [W]. When True the columns are
+            a MultiIndex whose first level is the array position and whose
+            second level is the bucket name; the system-wide ``inverter``
+            loss is split across the arrays in proportion to the DC power
+            each delivered, so that summing over the first level reproduces
+            the system-wide frame.
+
+        Returns
+        -------
+        DataFrame
+            Indexed by the model index with columns
+            :py:data:`FRAME_COLUMNS`, in that order.
+        """
+        if not per_array:
+            columns = {name: sum_over_arrays(getattr(self, name))
+                       for name in FRAME_COLUMNS}
+            return pd.DataFrame(columns, columns=list(FRAME_COLUMNS))
+        pairs = [(i, name) for i in range(self.num_arrays)
+                 for name in FRAME_COLUMNS]
+        data = {pair: self._array_column(pair[1], pair[0]) for pair in pairs}
+        frame = pd.DataFrame(data)
+        frame.columns = pd.MultiIndex.from_tuples(pairs)
+        return frame
+
+    def energies(self, per_array=False, freq=None):
+        """
+        Total energy of each column of :py:meth:`to_frame`.
+
+        Energy is the sum of power over the model index, so it does not
+        depend on the length of the interval between timestamps.
+
+        Parameters
+        ----------
+        per_array : bool, default False
+            Passed through to :py:meth:`to_frame`.
+        freq : str, optional
+            Pandas offset alias. When given, energies are totalled within
+            each period instead of over the whole index.
+
+        Returns
+        -------
+        Series, or DataFrame
+            A Series indexed by the columns of :py:meth:`to_frame`, in the
+            same order, or a DataFrame of one row per period when ``freq`` is
+            given.
+        """
+        frame = self.to_frame(per_array=per_array)
+        if freq is None:
+            return pd.Series(
+                [energy(frame[column]) for column in frame.columns],
+                index=frame.columns)
+        resampled = frame.resample(freq).sum()
+        resampled.columns = frame.columns
+        return resampled
+
+    def cumulative(self):
+        """
+        Power remaining after each stage of the decomposition.
+
+        The first column is the reference power and each later column is the
+        previous one less that stage's bucket, so the last bucket column
+        equals AC power. This is the waterfall the buckets describe.
+
+        Returns
+        -------
+        DataFrame
+            Indexed by the model index with columns ``'reference'`` followed
+            by :py:data:`BUCKET_NAMES`, in that order.
+        """
+        frame = self.to_frame()
+        remaining = frame['reference']
+        columns = {'reference': remaining}
+        for name in BUCKET_NAMES:
+            remaining = remaining - frame[name]
+            columns[name] = remaining
+        return pd.DataFrame(columns,
+                            columns=['reference'] + list(BUCKET_NAMES))
+
+    def shapley(self):
+        """
+        Credit each conversion mechanism its average marginal drop.
+
+        The sequential buckets depend on the order the stages are applied.
+        This reading removes that dependence: every mechanism in
+        :py:data:`CONVERSION_MECHANISMS` is credited the mean of the drop it
+        causes over all orderings of those mechanisms, holding orientation
+        and sky at their modeled values.
+
+        Returns
+        -------
+        dict
+            Keyed by :py:data:`CONVERSION_MECHANISMS`, each a system-wide
+            power [W]. The values sum, at every timestamp, to the ``weather``
+            column of :py:meth:`cumulative` less :py:attr:`ac`.
+        """
+        lattice = self._lattice()
+        count = len(CONVERSION_MECHANISMS)
+        credited = {}
+        for mechanism in CONVERSION_MECHANISMS:
+            others = [name for name in CONVERSION_MECHANISMS
+                      if name != mechanism]
+            total = None
+            for size in range(len(others) + 1):
+                weight = (math.factorial(size)
+                          * math.factorial(count - size - 1)
+                          / math.factorial(count))
+                for combination in itertools.combinations(others, size):
+                    without = frozenset(combination)
+                    drop = (lattice[without]
+                            - lattice[without | {mechanism}]) * weight
+                    total = drop if total is None else total + drop
+            credited[mechanism] = total
+        return credited
+
+    def as_fraction(self, per_array=False):
+        """
+        Express each bucket as a fraction of the reference energy.
+
+        Parameters
+        ----------
+        per_array : bool, default False
+            When False a single dictionary keyed by
+            :py:data:`BUCKET_NAMES` is returned and every energy is taken
+            over the whole system. When True a tuple of such dictionaries is
+            returned, one per array, and each array's buckets are divided by
+            that array's own reference energy.
+
+        Returns
+        -------
+        dict, or tuple of dict
+            Every value is zero when the reference energy of its divisor is
+            zero.
+        """
+        if not per_array:
+            reference_energy = energy(sum_over_arrays(self.reference))
+            return {name: energy_fraction(
+                energy(sum_over_arrays(getattr(self, name))),
+                reference_energy)
+                for name in BUCKET_NAMES}
+        frame = self.to_frame(per_array=True)
+        result = []
+        for i in range(self.num_arrays):
+            reference_energy = energy(frame[(i, 'reference')])
+            result.append({name: energy_fraction(
+                energy(frame[(i, name)]), reference_energy)
+                for name in BUCKET_NAMES})
+        return tuple(result)
