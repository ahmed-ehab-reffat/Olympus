+                                     reference_temperature, False, False),
+                self._stage_dc_power(transposition_irradiance,
+                                     reference_temperature, False, False),
+                self._stage_dc_power(weather_irradiance,
+                                     reference_temperature, False, False),
+                self._stage_dc_power(reflection_irradiance,
+                                     reference_temperature, False, False),
+                self._stage_dc_power(modeled_irradiance,
+                                     reference_temperature, False, False),
+                self._stage_dc_power(modeled_irradiance,
+                                     modeled_temperature, False, False),
+                self._stage_dc_power(modeled_irradiance,
+                                     modeled_temperature, True, False),
+                self._stage_dc_power(modeled_irradiance,
+                                     modeled_temperature, True, True),
+            ]
+        finally:
+            for name in _ATTRIBUTION_STATE:
+                setattr(self.results, name, saved[name])
+
