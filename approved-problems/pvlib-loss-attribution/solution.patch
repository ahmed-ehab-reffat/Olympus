+        self._assign_per_array('total_irrad', total_irrad)
+        return self._staged_effective_irradiance(aoi_modifier,
+                                                 spectral_modifier)
+
+    def _stage_dc_power(self, effective_irradiance, cell_temperature,
+                        dc_ohmic, extra_losses):
+        """Evaluate DC power for one stage of the loss attribution."""
+        self._assign_per_array('effective_irradiance', effective_irradiance)
+        self._assign_per_array('cell_temperature', cell_temperature)
+        self.dc_model()
+        if dc_ohmic:
+            self.dc_ohmic_model()
+        if extra_losses:
+            self.losses_model()
+        return tuple(
+            (dc['p_mp'] if isinstance(dc, pd.DataFrame) else dc).copy()
+            for dc in self._per_array(self.results.dc))
+
+    def _subset_power(self, saved, enabled, index, optical):
+        """
+        Power reaching the meter with only ``enabled`` mechanisms active.
+
+        Orientation and sky stay at their modeled values; every mechanism in
+        :py:data:`~pvlib.lossattribution.CONVERSION_MECHANISMS` outside
+        ``enabled`` is held at its reference setting. Without ``'inverter'``
+        the inverter is ideal, so the result is DC power summed over the
+        arrays. When the chain was run from effective irradiance the
+        reflection and spectral mechanisms cannot be separated from the
+        input, so toggling them changes nothing.
+        """
+        unity = (1.0,) * self.system.num_arrays
+        if optical:
+            irradiance = self._staged_irradiance_from_total(
+                self._per_array(saved['total_irrad']),
+                self._per_array(saved['aoi_modifier'])
+                if 'reflection' in enabled else unity,
+                self._per_array(saved['spectral_modifier'])
+                if 'spectral' in enabled else unity)
+        else:
+            irradiance = self._per_array(saved['effective_irradiance'])
+        temperature = self._as_series(
+            self._per_array(saved['cell_temperature'])
+            if 'temperature' in enabled
+            else (REFERENCE_CELL_TEMPERATURE,) * self.system.num_arrays,
+            index)
+        power = self._stage_dc_power(irradiance, temperature,
+                                     'dc_ohmic' in enabled,
+                                     'dc_other' in enabled)
+        if 'inverter' in enabled:
+            self.ac_model()
+            return self.results.ac.copy()
+        return sum_over_arrays(power)
+
+    def _conversion_lattice(self, optical):
