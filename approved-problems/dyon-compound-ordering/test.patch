+extern crate dyon;
+
+use dyon::*;
+use std::sync::Arc;
+
+fn eval_bool(body: &str) -> Result<bool, String> {
+    let src = format!("fn t() -> {{\n{}\n}}", body);
+    let mut module = Module::new();
+    load_str("main.dyon", Arc::new(src), &mut module)?;
+    Call::new("t").run_ret::<bool>(&mut Runtime::new(), &Arc::new(module))
+}
+
+fn eval_f64(body: &str) -> Result<f64, String> {
+    let src = format!("fn t() -> {{\n{}\n}}", body);
+    let mut module = Module::new();
+    load_str("main.dyon", Arc::new(src), &mut module)?;
+    Call::new("t").run_ret::<f64>(&mut Runtime::new(), &Arc::new(module))
+}
+
+fn ok(body: &str) {
+    match eval_bool(body) {
+        Ok(true) => {}
+        Ok(false) => panic!("expected true, got false for:\n{}", body),
+        Err(e) => panic!("expected true, got error `{}` for:\n{}", e, body),
+    }
+}
+
+fn num(body: &str, expected: f64) {
+    match eval_f64(body) {
+        Ok(v) => assert!(v == expected, "expected {}, got {} for:\n{}", expected, v, body),
+        Err(e) => panic!("expected {}, got error `{}` for:\n{}", expected, e, body),
+    }
+}
+
+fn err_has(body: &str, kw: &str) {
+    match eval_bool(body) {
+        Err(e) => assert!(
+            e.to_lowercase().contains(&kw.to_lowercase()),
+            "error `{}` missing `{}` for:\n{}",
+            e,
+            kw,
+            body
+        ),
+        Ok(v) => panic!("expected error containing `{}`, got {} for:\n{}", kw, v, body),
+    }
+}
+
+fn errs(body: &str) {
+    if let Ok(v) = eval_bool(body) {
+        panic!("expected an error, got {} for:\n{}", v, body);
+    }
+}
