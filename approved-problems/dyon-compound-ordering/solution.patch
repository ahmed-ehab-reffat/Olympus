+pub(crate) fn bsearch(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let key = rt.stack.pop().expect(TINVOTS);
+    let v = rt.stack.pop().expect(TINVOTS);
+    let arr = match rt.get(&v) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let key = rt.get(&key).deep_clone(&rt.stack);
+    cmp_vars(&key, &key)?;
+    let items = resolved_items(rt, &arr)?;
+    let (mut lo, mut hi) = (0usize, items.len());
+    while lo < hi {
+        let mid = lo + (hi - lo) / 2;
+        match cmp_vars(&items[mid], &key)? {
+            Ordering::Less => lo = mid + 1,
+            Ordering::Greater => hi = mid,
+            Ordering::Equal => {
+                return Ok(Variable::Option(Some(Box::new(Variable::f64(mid as f64)))))
+            }
+        }
+    }
+    Ok(Variable::Option(None))
+}
