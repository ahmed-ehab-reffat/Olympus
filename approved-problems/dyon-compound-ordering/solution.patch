+pub(crate) fn merge(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let vb = rt.stack.pop().expect(TINVOTS);
+    let va = rt.stack.pop().expect(TINVOTS);
+    let a = match rt.get(&va) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let b = match rt.get(&vb) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(1, x, "array")),
+    };
+    let a = resolved_items(rt, &a)?;
+    let b = resolved_items(rt, &b)?;
+    let mut out: Vec<Variable> = Vec::with_capacity(a.len() + b.len());
+    let (mut i, mut j) = (0, 0);
+    while i < a.len() && j < b.len() {
+        if cmp_vars(&b[j], &a[i])? == Ordering::Less {
+            out.push(b[j].clone());
+            j += 1;
+        } else {
+            out.push(a[i].clone());
+            i += 1;
+        }
+    }
+    out.extend_from_slice(&a[i..]);
+    out.extend_from_slice(&b[j..]);
+    Ok(Variable::Array(::std::sync::Arc::new(out)))
+}
