+pub(crate) fn argsort(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let v = rt.stack.pop().expect(TINVOTS);
+    let arr = match rt.get(&v) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let items = resolved_items(rt, &arr)?;
+    let mut idx: Vec<usize> = (0..items.len()).collect();
+    let mut err: Option<String> = None;
+    idx.sort_by(|&a, &b| {
+        if err.is_some() {
+            return Ordering::Equal;
+        }
+        match cmp_vars(&items[a], &items[b]) {
+            Ok(Ordering::Equal) => a.cmp(&b),
+            Ok(o) => o,
+            Err(e) => {
+                err = Some(e);
+                Ordering::Equal
+            }
+        }
+    });
+    if let Some(e) = err {
+        return Err(e);
+    }
+    let out: Vec<Variable> = idx.into_iter().map(|i| Variable::f64(i as f64)).collect();
+    Ok(Variable::Array(::std::sync::Arc::new(out)))
+}
