+fn merge_sort(mut items: Vec<Variable>) -> Result<Vec<Variable>, String> {
+    use std::cmp::Ordering;
+
+    let n = items.len();
+    if n <= 1 {
+        return Ok(items);
+    }
+    let right = items.split_off(n / 2);
+    let left = merge_sort(items)?;
+    let right = merge_sort(right)?;
+    let mut out: Vec<Variable> = Vec::with_capacity(n);
+    let (mut i, mut j) = (0, 0);
+    while i < left.len() && j < right.len() {
+        if cmp_vars(&right[j], &left[i])? == Ordering::Less {
+            out.push(right[j].clone());
+            j += 1;
+        } else {
+            out.push(left[i].clone());
+            i += 1;
+        }
+    }
+    out.extend_from_slice(&left[i..]);
+    out.extend_from_slice(&right[j..]);
+    Ok(out)
+}
