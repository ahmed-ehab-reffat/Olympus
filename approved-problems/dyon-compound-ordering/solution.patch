+pub(crate) fn union(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let vb = rt.stack.pop().expect(TINVOTS);
+    let va = rt.stack.pop().expect(TINVOTS);
+    let a = match rt.get(&va) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let b = match rt.get(&vb) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(1, x, "array")),
+    };
+    let a = resolved_items(rt, &a)?;
+    let b = resolved_items(rt, &b)?;
+    let mut out: Vec<Variable> = vec![];
+    let (mut i, mut j) = (0, 0);
+    let push_uniq = |out: &mut Vec<Variable>, v: Variable| -> Result<(), String> {
+        let dup = match out.last() {
+            Some(prev) => cmp_vars(prev, &v)? == Ordering::Equal,
+            None => false,
+        };
+        if !dup {
+            out.push(v);
+        }
+        Ok(())
+    };
+    while i < a.len() && j < b.len() {
+        match cmp_vars(&a[i], &b[j])? {
+            Ordering::Less => {
+                push_uniq(&mut out, a[i].clone())?;
+                i += 1;
+            }
+            Ordering::Greater => {
+                push_uniq(&mut out, b[j].clone())?;
+                j += 1;
+            }
+            Ordering::Equal => {
+                push_uniq(&mut out, a[i].clone())?;
+                i += 1;
+                j += 1;
+            }
+        }
+    }
+    while i < a.len() {
+        push_uniq(&mut out, a[i].clone())?;
+        i += 1;
+    }
+    while j < b.len() {
+        push_uniq(&mut out, b[j].clone())?;
+        j += 1;
+    }
+    Ok(Variable::Array(::std::sync::Arc::new(out)))
+}
+
+pub(crate) fn intersect(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let vb = rt.stack.pop().expect(TINVOTS);
+    let va = rt.stack.pop().expect(TINVOTS);
+    let a = match rt.get(&va) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let b = match rt.get(&vb) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(1, x, "array")),
+    };
+    let a = resolved_items(rt, &a)?;
+    let b = resolved_items(rt, &b)?;
+    let mut out: Vec<Variable> = vec![];
+    let (mut i, mut j) = (0, 0);
+    while i < a.len() && j < b.len() {
+        match cmp_vars(&a[i], &b[j])? {
+            Ordering::Less => i += 1,
+            Ordering::Greater => j += 1,
+            Ordering::Equal => {
+                let dup = match out.last() {
+                    Some(prev) => cmp_vars(prev, &a[i])? == Ordering::Equal,
+                    None => false,
+                };
+                if !dup {
+                    out.push(a[i].clone());
+                }
+                i += 1;
+                j += 1;
+            }
+        }
+    }
+    Ok(Variable::Array(::std::sync::Arc::new(out)))
 }
 
