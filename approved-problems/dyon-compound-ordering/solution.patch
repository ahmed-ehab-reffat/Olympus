+pub(crate) fn cmp_vars(a: &Variable, b: &Variable) -> Result<::std::cmp::Ordering, String> {
+    use std::cmp::Ordering;
+    use Variable::*;
+
+    match (a, b) {
+        (&Bool(a, _), &Bool(b, _)) => Ok(a.cmp(&b)),
+        (&F64(a, _), &F64(b, _)) => a
+            .partial_cmp(&b)
+            .ok_or_else(|| "Cannot order `nan`: the type does not form a total order".to_string()),
+        (&Str(ref a), &Str(ref b)) => Ok(a.as_str().cmp(b.as_str())),
+        (&Vec4(a), &Vec4(b)) => {
+            for i in 0..4 {
+                match a[i].partial_cmp(&b[i]) {
+                    Some(Ordering::Equal) => {}
+                    Some(o) => return Ok(o),
+                    None => {
+                        return Err(
+                            "Cannot order `nan`: the type does not form a total order".to_string()
+                        )
+                    }
+                }
+            }
+            Ok(Ordering::Equal)
+        }
+        (&Option(ref a), &Option(ref b)) => match (a, b) {
+            (&None, &None) => Ok(Ordering::Equal),
+            (&None, &Some(_)) => Ok(Ordering::Less),
+            (&Some(_), &None) => Ok(Ordering::Greater),
+            (&Some(ref a), &Some(ref b)) => cmp_vars(a, b),
+        },
+        (&Array(ref a), &Array(ref b)) => {
+            let n = a.len().min(b.len());
+            for i in 0..n {
+                match cmp_vars(&a[i], &b[i])? {
+                    Ordering::Equal => {}
+                    o => return Ok(o),
+                }
+            }
+            Ok(a.len().cmp(&b.len()))
+        }
+        (&Object(ref a), &Object(ref b)) => {
+            let mut ak: Vec<&::std::sync::Arc<String>> = a.keys().collect();
+            let mut bk: Vec<&::std::sync::Arc<String>> = b.keys().collect();
+            ak.sort();
+            bk.sort();
+            let n = ak.len().min(bk.len());
+            for i in 0..n {
+                match ak[i].as_str().cmp(bk[i].as_str()) {
+                    Ordering::Equal => match cmp_vars(&a[ak[i]], &b[bk[i]])? {
+                        Ordering::Equal => {}
+                        o => return Ok(o),
+                    },
+                    o => return Ok(o),
+                }
+            }
+            Ok(ak.len().cmp(&bk.len()))
+        }
+        _ => Err("The two values have a mismatched or unorderable type".into()),
+    }
+}
+
+pub(crate) fn check_orderable(v: &Variable) -> Result<(), String> {
+    use Variable::*;
+
+    match v {
+        &Bool(..) | &Str(_) => Ok(()),
+        &F64(x, _) => {
+            if x.is_nan() {
+                Err("Cannot order `nan`: the type does not form a total order".into())
+            } else {
+                Ok(())
+            }
+        }
+        &Vec4(a) => {
+            if a.iter().any(|c| c.is_nan()) {
+                Err("Cannot order `nan`: the type does not form a total order".into())
+            } else {
+                Ok(())
+            }
+        }
+        &Option(None) => Ok(()),
+        &Option(Some(ref x)) => check_orderable(x),
+        &Array(ref a) => {
+            for x in a.iter() {
+                check_orderable(x)?;
+            }
+            Ok(())
+        }
+        &Object(ref o) => {
+            for x in o.values() {
+                check_orderable(x)?;
+            }
+            Ok(())
+        }
+        _ => Err("The value has a mismatched or unorderable type".into()),
+    }
+}
