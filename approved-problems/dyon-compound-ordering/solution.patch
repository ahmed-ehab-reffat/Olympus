+pub(crate) fn rank(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let v = rt.stack.pop().expect(TINVOTS);
+    let arr = match rt.get(&v) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let items = resolved_items(rt, &arr)?;
+    let sorted = merge_sort(items.clone())?;
+    let mut out: Vec<Variable> = Vec::with_capacity(items.len());
+    for a in items.iter() {
+        let (mut lo, mut hi) = (0usize, sorted.len());
+        while lo < hi {
+            let mid = lo + (hi - lo) / 2;
+            if cmp_vars(&sorted[mid], a)? == Ordering::Less {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+        }
+        out.push(Variable::f64(lo as f64));
+    }
+    Ok(Variable::Array(::std::sync::Arc::new(out)))
