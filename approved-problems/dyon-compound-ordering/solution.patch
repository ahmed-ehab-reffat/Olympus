+fn resolved_items(rt: &Runtime, arr: &[Variable]) -> Result<Vec<Variable>, String> {
+    let mut out = Vec::with_capacity(arr.len());
+    for it in arr {
+        let v = rt.get(it).deep_clone(&rt.stack);
+        check_orderable(&v)?;
+        out.push(v);
+    }
+    Ok(out)
+}
