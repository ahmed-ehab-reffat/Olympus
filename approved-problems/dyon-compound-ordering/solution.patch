+fn quickselect(items: &mut [Variable], k: usize) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let (mut lo, mut hi) = (0usize, items.len());
+    loop {
+        if hi - lo == 1 {
+            return Ok(items[lo].clone());
+        }
+        let pivot = items[lo + (hi - lo) / 2].clone();
+        let mut store = lo;
+        items.swap(lo + (hi - lo) / 2, hi - 1);
+        for idx in lo..hi - 1 {
+            if cmp_vars(&items[idx], &pivot)? == Ordering::Less {
+                items.swap(idx, store);
+                store += 1;
+            }
+        }
+        items.swap(store, hi - 1);
+        if k == store {
+            return Ok(items[store].clone());
+        } else if k < store {
+            hi = store;
+        } else {
+            lo = store + 1;
+        }
+    }
+}
