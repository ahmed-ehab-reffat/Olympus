+pub(crate) fn group_by(rt: &mut Runtime) -> Result<Variable, String> {
+    let v = rt.stack.pop().expect(TINVOTS);
+    let arr = match rt.get(&v) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let items = resolved_items(rt, &arr)?;
+    let mut groups: Vec<Variable> = vec![];
+    let mut cur: Vec<Variable> = vec![];
+    for it in items.into_iter() {
+        let same = match cur.last() {
+            None => true,
+            Some(prev) => cmp_vars(prev, &it)? == ::std::cmp::Ordering::Equal,
+        };
+        if !same {
+            groups.push(Variable::Array(::std::sync::Arc::new(std::mem::take(&mut cur))));
+        }
+        cur.push(it);
+    }
+    if !cur.is_empty() {
+        groups.push(Variable::Array(::std::sync::Arc::new(cur)));
+    }
+    Ok(Variable::Array(::std::sync::Arc::new(groups)))
+}
