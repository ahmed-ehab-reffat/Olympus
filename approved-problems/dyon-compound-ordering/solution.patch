+pub(crate) fn kth_smallest(rt: &mut Runtime) -> Result<Variable, String> {
+    let key = rt.stack.pop().expect(TINVOTS);
+    let v = rt.stack.pop().expect(TINVOTS);
+    let k = match rt.get(&key) {
+        &Variable::F64(k, _) => k as usize,
+        x => return Err(rt.expected_arg(1, x, "number")),
+    };
+    let arr = match rt.get(&v) {
+        &Variable::Array(ref arr) => arr.clone(),
+        x => return Err(rt.expected_arg(0, x, "array")),
+    };
+    let mut items = resolved_items(rt, &arr)?;
+    if k >= items.len() {
+        return Err("Index out of range in `kth_smallest`".into());
+    }
+    quickselect(&mut items, k)
+}
