+pub(crate) fn cmp(rt: &mut Runtime) -> Result<Variable, String> {
+    use std::cmp::Ordering;
+
+    let b = rt.stack.pop().expect(TINVOTS);
+    let a = rt.stack.pop().expect(TINVOTS);
+    let a = rt.get(&a).deep_clone(&rt.stack);
+    let b = rt.get(&b).deep_clone(&rt.stack);
+    check_orderable(&a)?;
+    check_orderable(&b)?;
+    Ok(Variable::f64(match cmp_vars(&a, &b)? {
+        Ordering::Less => -1.0,
+        Ordering::Equal => 0.0,
+        Ordering::Greater => 1.0,
+    }))
+}
