+def annotate(upper_bound, rows):
+    interval_metadata = IntervalMetadata(upper_bound)
+    for bounds, metadata in rows:
+        interval_metadata.add(bounds, metadata=metadata)
+    return interval_metadata
+
+
+def pairs(spans):
+    return [tuple(span) for span in spans]
+
+
+def regions(utrs):
+    return [pairs(part) for part in utrs]
+
+
+def described(type, strand="+", identifier=None, parent=None, phase=None):
+    metadata = {"type": type, "strand": strand}
+    if identifier is not None:
+        metadata["ID"] = identifier
+    if parent is not None:
+        metadata["Parent"] = parent
+    if phase is not None:
+        metadata["phase"] = phase
+    return metadata
+
+
+def plus_gene():
+    return annotate(
+        60,
+        [
+            ([(0, 60)], described("gene", identifier="g1")),
+            ([(0, 60)], described("mRNA", identifier="m1", parent="g1")),
+            ([(0, 20)], described("exon", identifier="e1", parent="m1")),
+            ([(30, 60)], described("exon", identifier="e2", parent="m1")),
+            ([(10, 20)], described("CDS", identifier="c1", parent="m1", phase=0)),
+            ([(30, 50)], described("CDS", identifier="c1", parent="m1", phase=2)),
+        ],
+    )
+
+
+def minus_gene():
+    return annotate(
+        60,
+        [
+            ([(0, 60)], described("gene", "-", identifier="g1")),
+            ([(0, 60)], described("mRNA", "-", identifier="m1", parent="g1")),
+            ([(0, 20)], described("exon", "-", identifier="e1", parent="m1")),
+            ([(30, 60)], described("exon", "-", identifier="e2", parent="m1")),
+            ([(30, 50)], described("CDS", "-", identifier="c1", parent="m1", phase=0)),
+            ([(10, 20)], described("CDS", "-", identifier="c1", parent="m1", phase=1)),
+        ],
+    )
+
+
+def compact_plus():
+    return annotate(
+        30,
+        [
+            ([(0, 30)], described("mRNA", identifier="m1")),
+            ([(0, 12)], described("exon", identifier="e1", parent="m1")),
+            ([(18, 30)], described("exon", identifier="e2", parent="m1")),
+            ([(0, 12)], described("CDS", identifier="c1", parent="m1", phase=0)),
+            ([(18, 27)], described("CDS", identifier="c1", parent="m1", phase=0)),
+        ],
+    )
+
+
+def compact_plus_on(upper_bound):
+    return annotate(
+        upper_bound,
+        [
+            ([(0, 12)], described("CDS", identifier="c1", phase=0)),
+            ([(18, 30)], described("CDS", identifier="c1")),
+        ],
+    )
+
+
+def coding_sequence():
+    return DNA(
+        "TTGAAACCCGGGTTTTTTATGAAACCCTGA"
+        "GGCCATTACGATCGATCGGGCCCTTTAAAG"
+    )
