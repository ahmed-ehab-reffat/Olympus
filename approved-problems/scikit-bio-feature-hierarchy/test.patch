+        self.assertEqual(model["m1"].position(30), 20)
+        self.assertEqual(model["m1"].position(59), 49)
+
+    def test_position_inside_an_intron_is_unknown(self):
+        model = plus_gene().hierarchy()
+        self.assertIsNone(model["m1"].position(25))
+
+    def test_position_outside_the_feature_is_unknown(self):
+        model = plus_gene().hierarchy()
+        self.assertIsNone(model["c1"].position(0))
+        self.assertIsNone(model["c1"].position(55))
+
+    def test_position_on_the_minus_strand_counts_from_the_far_end(self):
+        model = minus_gene().hierarchy()
+        self.assertEqual(model["m1"].position(59), 0)
+        self.assertEqual(model["m1"].position(30), 29)
+        self.assertEqual(model["m1"].position(19), 30)
+        self.assertEqual(model["m1"].position(0), 49)
+
+    def test_coordinate_on_the_plus_strand(self):
+        model = plus_gene().hierarchy()
+        self.assertEqual(model["m1"].coordinate(0), 0)
+        self.assertEqual(model["m1"].coordinate(20), 30)
+        self.assertEqual(model["m1"].coordinate(49), 59)
+
+    def test_coordinate_on_the_minus_strand(self):
+        model = minus_gene().hierarchy()
+        self.assertEqual(model["m1"].coordinate(0), 59)
+        self.assertEqual(model["m1"].coordinate(29), 30)
+        self.assertEqual(model["m1"].coordinate(30), 19)
+        self.assertEqual(model["m1"].coordinate(49), 0)
