+    def test_a_converted_model_is_written_back_to_gff3(self):
+        interval_metadata = skbio.io.read(
+            io.StringIO(TEST_GFF), format="gff3", into=IntervalMetadata, seq_id="seq1"
+        )
+        converted = interval_metadata.hierarchy().to_interval_metadata()
+        written = io.StringIO()
+        skbio.io.write(converted, format="gff3", into=written, seq_id="seq1")
+        written.seek(0)
+        again = skbio.io.read(
+            written, format="gff3", into=IntervalMetadata, seq_id="seq1"
+        )
+        self.assertEqual(again.num_interval_features, 6)
+        model = again.hierarchy()
+        self.assertEqual([feature.id for feature in model.roots], ["g1"])
+        self.assertEqual(pairs(model["c1"].bounds), [(10, 20), (30, 50)])
+        self.assertEqual([parent.id for parent in model["c1"].parents], ["m1"])
