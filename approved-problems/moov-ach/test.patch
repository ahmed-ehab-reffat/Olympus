+	require.NoError(t, debit.Create())
+
+	source := ach.NewFile()
+	source.SetHeader(fileHeader())
+	source.AddBatch(credit.Batches[0])
+	source.AddBatch(debit.Batches[0])
+	require.NoError(t, source.Create())
+
+	result, err := correctionResultFor(t, file, source)
+	require.NoError(t, err)
+	require.NotNil(t, result)
+	require.Nil(t, result.Undo)
+	require.Equal(t, []string{"C62", "C62"}, refusedCodes(t, result.Refused))
+	require.Len(t, result.Refused.Batches, 1)
