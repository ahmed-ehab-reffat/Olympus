+func TestApplyCorrections_CorrectionSourceAddendaTracesStayUnchanged(t *testing.T) {
+	file := threeEntryFile(t)
+	source := correctionFile(t,
+		notice{"C01", traceOf(t, file, 0, 0), "23138010", "1918171614"},
+		notice{"C04", traceOf(t, file, 0, 1), "12104288", "JANE R DOE"},
+		notice{"C09", traceOf(t, file, 0, 2), "23138010", "location #77"},
+	)
+	var before []string
+	for _, entry := range source.Batches[0].GetEntries() {
+		before = append(before, entry.Addenda98.TraceNumber)
+	}
+	appliedResult(t, file, source)
+	for i, entry := range source.Batches[0].GetEntries() {
+		require.Equal(t, before[i], entry.Addenda98.TraceNumber)
+		require.Equal(t, entry.TraceNumber, entry.Addenda98.TraceNumber)
+	}
+}
