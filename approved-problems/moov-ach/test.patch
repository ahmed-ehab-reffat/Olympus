+// correctionFileNamed is correctionFile with a company name on the batch header, so the
+// provenance of a refused batch's header is observable.
+func correctionFileNamed(t testing.TB, company string, notices ...notice) *ach.File {
+	t.Helper()
+
+	file := correctionFile(t, notices...)
+	header := file.Batches[0].GetHeader()
+	header.CompanyName = company
+	file.Batches[0].SetHeader(header)
+	require.NoError(t, file.Batches[0].Create())
+	require.NoError(t, file.Create())
+	return file
+}
