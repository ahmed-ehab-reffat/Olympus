+const (
+	originatingODFI = "12104288"
+	receivingODFI   = "23138010"
+)
+
+type correctionResult struct {
+	Refused *ach.File
+	Undo    *ach.File
+}
+
+// correctionResultFor calls ApplyCorrections and projects its public Refused and Undo fields
+// into the local test view.
+func correctionResultFor(t testing.TB, file *ach.File, corrections ...*ach.File) (*correctionResult, error) {
+	t.Helper()
+
+	method := reflect.ValueOf(file).MethodByName("ApplyCorrections")
+	require.True(t, method.IsValid(), "ach.File is missing ApplyCorrections")
+	if !method.IsValid() {
+		return nil, nil
+	}
+
+	args := make([]reflect.Value, len(corrections))
+	for i := range corrections {
+		args[i] = reflect.ValueOf(corrections[i])
+	}
+	out := method.Call(args)
+	require.Len(t, out, 2)
+
+	var err error
+	if !out[1].IsNil() {
+		err = out[1].Interface().(error)
+	}
+	if out[0].IsNil() {
+		return nil, err
+	}
+
+	value := out[0].Elem()
+	refused := value.FieldByName("Refused")
+	undo := value.FieldByName("Undo")
+	require.True(t, refused.IsValid(), "correction result has no Refused field")
+	require.True(t, undo.IsValid(), "correction result has no Undo field")
+
+	result := &correctionResult{}
+	if !refused.IsNil() {
+		result.Refused = refused.Interface().(*ach.File)
+	}
+	if !undo.IsNil() {
+		result.Undo = undo.Interface().(*ach.File)
+	}
+	return result, err
+}
+
+// applyCorrections preserves the L3 helper surface for tests concerned only with refusals.
+func applyCorrections(t testing.TB, file *ach.File, corrections ...*ach.File) (*ach.File, error) {
+	t.Helper()
+
+	result, err := correctionResultFor(t, file, corrections...)
+	if result == nil {
+		return nil, err
+	}
+	return result.Refused, err
+}
+
+// applied runs ApplyCorrections and requires that nothing was refused.
+func applied(t testing.TB, file *ach.File, corrections ...*ach.File) {
+	t.Helper()
+
+	refused, err := applyCorrections(t, file, corrections...)
+	require.NoError(t, err)
+	require.Nil(t, refused, "expected no refusals")
+	require.NoError(t, file.Validate())
+}
+
+// appliedResult requires a non-empty result with no refusals and a usable undo file.
+func appliedResult(t testing.TB, file *ach.File, corrections ...*ach.File) *correctionResult {
+	t.Helper()
+
+	result, err := correctionResultFor(t, file, corrections...)
+	require.NoError(t, err)
+	require.NotNil(t, result)
+	require.Nil(t, result.Refused, "expected no refusals")
+	require.NotNil(t, result.Undo, "expected an undo file")
+	require.NoError(t, result.Undo.Validate())
+	require.NoError(t, file.Validate())
+	return result
+}
+
+// refusedCodes returns the refused change code of every entry of a refused file, in order.
+func refusedCodes(t testing.TB, refused *ach.File) []string {
+	t.Helper()
+
+	require.NotNil(t, refused)
+	var out []string
+	for _, batch := range refused.Batches {
+		for _, entry := range batch.GetEntries() {
+			require.NotNil(t, entry.Addenda98Refused, "refused entry without a refused addenda98")
+			out = append(out, entry.Addenda98Refused.RefusedChangeCode)
+		}
+	}
+	return out
+}
+
+// refuses runs ApplyCorrections and requires exactly the given refusal codes, in order.
+func refuses(t testing.TB, file *ach.File, corrections *ach.File, codes ...string) *ach.File {
+	t.Helper()
+
+	refused, err := applyCorrections(t, file, corrections)
+	require.NoError(t, err)
+	require.Equal(t, codes, refusedCodes(t, refused))
+	require.NoError(t, file.Validate())
+	return refused
+}
+
+// fileBytes renders a file as NACHA text, so a file can be compared against itself
+// across a call which has to leave it untouched.
+func fileBytes(t testing.TB, file *ach.File) []byte {
+	t.Helper()
+
+	var buf bytes.Buffer
+	writer := ach.NewWriter(&buf)
+	require.NoError(t, writer.Write(file))
+	writer.Flush()
+	return buf.Bytes()
+}
+
+// roundTrip writes a file and reads it back through the library's own writer and reader.
+func roundTrip(t testing.TB, file *ach.File) *ach.File {
+	t.Helper()
+
+	read, err := ach.NewReader(bytes.NewReader(fileBytes(t, file))).Read()
+	require.NoError(t, err)
+	require.NoError(t, read.Validate())
+	return &read
+}
+
+// notice describes a Notification of Change to place into a correction file.
+type notice struct {
+	changeCode    string
+	originalTrace string
+	originalDFI   string
+	correctedData string
+}
