new file mode 100755
index 00000000..91aded84
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+# Test runner.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  existing tests covering files, batches and entries
+#   new   tests for applying Notifications of Change
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+MODE=""
+
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="${2:-}"
+      shift 2
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [ -z "$MODE" ]; then
+  echo "missing mode (expected base or new)" >&2
+  exit 2
+fi
+
+# Never let a previous run's report stand in for this one.
+if [ -n "$OUTPUT_PATH" ]; then
+  rm -f "$OUTPUT_PATH"
+fi
+
+TEST_LOG="$(mktemp)"
+STATUS=0
+
+run_tests() {
+  go test -count=1 -v "$@" 2>&1 | tee -a "$TEST_LOG"
+  status=${PIPESTATUS[0]}
+  if [ "$status" -ne 0 ]; then
+    STATUS=$status
+  fi
+}
+
+case "$MODE" in
+  base)
+    run_tests ./ ./cmd/... ./server/... ./internal/... ./examples/... ./test/issues/...
+    ;;
+  new)
+    run_tests ./test/corrections/...
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH"
+
+  # A build failure can leave nothing for the reporter to work with. Record that as a
+  # failure rather than leaving the caller without a report.
+  if [ ! -s "$OUTPUT_PATH" ]; then
+    cat > "$OUTPUT_PATH" <<'XML'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="1">
+  <testsuite name="test.sh" tests="1" failures="1" errors="0">
+    <testcase name="run" classname="test.sh">
+      <failure message="no test results produced">the test run produced no results</failure>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    STATUS=1
+  fi
+fi
+
+exit "$STATUS"
