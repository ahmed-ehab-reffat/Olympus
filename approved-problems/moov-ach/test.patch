+// threeEntryFile is a single credit batch holding entries at three different institutions.
+// Its entry hash is 23138010 + 12104288 + 23138010 and it moves 400000 in credits.
+func threeEntryFile(t testing.TB) *ach.File {
+	t.Helper()
+
+	return forwardFile(t, forwardBatch(t, ach.CreditsOnly,
+		forwardEntry(ach.CheckingCredit, "231380104", "123456789", "WADE ARNOLD", 100000, 1),
+		forwardEntry(ach.CheckingCredit, "121042882", "744-5678-99", "JANE DOE", 250000, 2),
+		forwardEntry(ach.CheckingCredit, "231380104", "987654321", "JOHN SMITH", 50000, 3),
+	))
+}
