+	batch := ach.NewBatchPPD(batchHeader(serviceClassCode, ach.PPD, originatingODFI))
+	for _, entry := range entries {
+		batch.AddEntry(entry)
+	}
+	require.NoError(t, batch.Create())
+	return batch
+}
