+func TestApplyCorrections_OffsetAcceptanceVRefusalAndIATRedo(t *testing.T) {
+	file := creditOffsetFile(t)
+	iat := iatForwardFile(t, iatEntry(1, ach.CheckingCredit))
+	file.AddIATBatch(iat.IATBatches[0])
+	require.NoError(t, file.Create())
+	before := append([]byte(nil), fileBytes(t, file)...)
+	first := entryOf(t, file, 0, 0)
+	second := entryOf(t, file, 0, 1)
+	international := file.IATBatches[0].Entries[0]
+
+	forward, err := correctionResultFor(t, file, correctionFile(t,
+		notice{"C05", first.TraceNumber, "23138010", "22"},
+		notice{"C05", second.TraceNumber, "12104288", "23"},
+		notice{"C09", international.TraceNumber, "12104288", "123456789012345"},
+	))
+	require.NoError(t, err)
+	require.Equal(t, []string{"C69"}, refusedCodes(t, forward.Refused))
+	require.Equal(t, 250000, entryOf(t, file, 0, 2).Amount)
+	require.Equal(t, ach.CheckingDebit, second.TransactionCode)
+	postForward := append([]byte(nil), fileBytes(t, file)...)
+
+	redo := appliedResult(t, file, forward.Undo)
+	require.Equal(t, before, fileBytes(t, file))
+	appliedResult(t, file, redo.Undo)
+	require.Equal(t, postForward, fileBytes(t, file))
+}
