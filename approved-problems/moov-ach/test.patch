+func specializedForwardFile(t testing.TB, sec string, transactionCode int) *ach.File {
+	t.Helper()
+
+	header := batchHeader(ach.CreditsOnly, sec, originatingODFI)
+	entry := forwardEntry(transactionCode, "031300012", "744-5678-99", "Best. #1", 0, 1)
+	entry.SetOriginalTraceNumber("031300010000001")
+
+	var batch ach.Batcher
+	switch sec {
+	case ach.ACK:
+		batch = ach.NewBatchACK(header)
+	case ach.ATX:
+		entry.SetCATXAddendaRecords(1)
+		entry.SetCATXReceivingCompany("Receiver Company")
+		entry.DiscretionaryData = "01"
+		entry.AddendaRecordIndicator = 1
+		addenda := ach.NewAddenda05()
+		addenda.PaymentRelatedInformation = "Credit account for service"
+		entry.AddAddenda05(addenda)
+		batch = ach.NewBatchATX(header)
+	case ach.DNE:
+		header.CompanyEntryDescription = "Death"
+		header.OriginatorStatusCode = 2
+		entry.AddendaRecordIndicator = 1
+		addenda := ach.NewAddenda05()
+		addenda.PaymentRelatedInformation = `DATE OF DEATH*010218*CUSTOMERSSN*#########*AMOUNT*$$$$.cc\`
+		entry.AddAddenda05(addenda)
+		batch = ach.NewBatchDNE(header)
+	case ach.ENR:
+		header.CompanyEntryDescription = "AUTOENROLL"
+		entry.AddendaRecordIndicator = 1
+		addenda := ach.NewAddenda05()
+		addenda.PaymentRelatedInformation = `22*12200004*3*123987654321*777777777*DOE*JOHN*1\`
+		entry.AddAddenda05(addenda)
+		batch = ach.NewBatchENR(header)
+	default:
+		t.Fatalf("unsupported specialized SEC %q", sec)
+	}
+	batch.AddEntry(entry)
+	require.NoError(t, batch.Create())
+	return forwardFile(t, batch)
+}
