+func TestApplyCorrections_IsDeterministic(t *testing.T) {
+	build := func() (*ach.File, *ach.File) {
+		file := threeEntryFile(t)
+		corrections := correctionFile(t,
+			notice{"C01", traceOf(t, file, 0, 0), "23138010", "1111111111"},
+			notice{"C01", "121042880000099", "23138010", "2222222222"},
+			notice{"C02", traceOf(t, file, 0, 2), "23138010", "071000051"},
+			notice{"C04", traceOf(t, file, 0, 1), "12104288", "JANE R DOE"},
+		)
+		refused, err := applyCorrections(t, file, corrections)
+		require.NoError(t, err)
+		return file, refused
+	}
+
+	firstFile, firstRefused := build()
+	secondFile, secondRefused := build()
+
+	require.Equal(t, fileBytes(t, firstFile), fileBytes(t, secondFile))
+	require.Equal(t, fileBytes(t, firstRefused), fileBytes(t, secondRefused))
+	require.Equal(t, refusedCodes(t, firstRefused), refusedCodes(t, secondRefused))
+}
