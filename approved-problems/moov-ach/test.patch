+func correctionFile(t testing.TB, notices ...notice) *ach.File {
+	t.Helper()
+
+	batch := ach.NewBatchCOR(batchHeader(ach.CreditsOnly, ach.COR, receivingODFI))
+	for i, n := range notices {
+		entry := ach.NewEntryDetail()
+		entry.TransactionCode = ach.CheckingReturnNOCCredit
+		entry.SetRDFI("121042882")
+		entry.DFIAccountNumber = "744-5678-99"
+		entry.Amount = 0
+		entry.IndividualName = "WADE ARNOLD"
+		entry.SetTraceNumber(receivingODFI, i+1)
+		entry.AddendaRecordIndicator = 1
+
+		addenda98 := ach.NewAddenda98()
+		addenda98.ChangeCode = n.changeCode
+		addenda98.OriginalTrace = n.originalTrace
+		addenda98.OriginalDFI = n.originalDFI
+		addenda98.CorrectedData = n.correctedData
+		addenda98.TraceNumber = entry.TraceNumber
+
+		entry.Addenda98 = addenda98
+		entry.Category = ach.CategoryNOC
+
+		batch.AddEntry(entry)
+	}
+	require.NoError(t, batch.Create())
+
+	file := ach.NewFile()
+	file.SetHeader(fileHeader())
+	file.AddBatch(batch)
+	require.NoError(t, file.Create())
+	return file
+}
+
+func debitCorrectionFile(t testing.TB, n notice) *ach.File {
+	t.Helper()
+
+	file := correctionFile(t, n)
+	batch := file.Batches[0]
+	batch.GetHeader().ServiceClassCode = ach.DebitsOnly
+	batch.GetEntries()[0].TransactionCode = ach.CheckingReturnNOCDebit
+	require.NoError(t, batch.Create())
+	require.NoError(t, file.Create())
+	return file
+}
+
+// traceOf returns the trace number of an entry of the file, by batch and entry position.
+func traceOf(t testing.TB, file *ach.File, batchIndex, entryIndex int) string {
+	t.Helper()
+
+	require.Greater(t, len(file.Batches), batchIndex)
+	entries := file.Batches[batchIndex].GetEntries()
+	require.Greater(t, len(entries), entryIndex)
+	return entries[entryIndex].TraceNumber
+}
+
+func entryOf(t testing.TB, file *ach.File, batchIndex, entryIndex int) *ach.EntryDetail {
+	t.Helper()
+
+	require.Greater(t, len(file.Batches), batchIndex)
+	entries := file.Batches[batchIndex].GetEntries()
+	require.Greater(t, len(entries), entryIndex)
+	return entries[entryIndex]
+}
