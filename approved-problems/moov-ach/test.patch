+	iat := iatForwardFile(t, iatEntry(1, ach.CheckingCredit))
+	file.AddIATBatch(iat.IATBatches[0])
+	require.NoError(t, file.Create())
+	ordinary := entryOf(t, file, 0, 0)
+	international := file.IATBatches[0].Entries[0]
+
+	result, err := correctionResultFor(t, file, correctionFile(t,
+		notice{"C01", ordinary.TraceNumber, "03130001", "1918171614"},
+		notice{"C05", ordinary.TraceNumber, "03130001", "22"},
+		notice{"C09", international.TraceNumber, "12104288", "123456789012345"},
+	))
+	require.NoError(t, err)
+	require.Equal(t, []string{"C69"}, refusedCodes(t, result.Refused))
+	require.Equal(t, "1918171614", ordinary.DFIAccountNumber)
+	require.Equal(t, ach.CheckingZeroDollarRemittanceCredit, ordinary.TransactionCode)
+	require.Equal(t, "123456789012345", international.Addenda15.ReceiverIDNumber)
+	require.Equal(t, []string{"C09", "C01"}, []string{
+		undoEntries(result)[0].Addenda98.ChangeCode,
+		undoEntries(result)[1].Addenda98.ChangeCode,
+	})
+}
