+func onlyUndoEntry(t testing.TB, result *correctionResult) *ach.EntryDetail {
+	t.Helper()
+
+	require.NotNil(t, result)
+	require.NotNil(t, result.Undo)
+	require.Len(t, result.Undo.Batches, 1)
+	entries := result.Undo.Batches[0].GetEntries()
+	require.Len(t, entries, 1)
+	return entries[0]
+}
+
+func undoEntries(result *correctionResult) []*ach.EntryDetail {
+	if result == nil || result.Undo == nil {
+		return nil
+	}
+	var entries []*ach.EntryDetail
+	for _, batch := range result.Undo.Batches {
+		entries = append(entries, batch.GetEntries()...)
+	}
+	return entries
+}
+
+func assertOrdinaryInverse(t testing.TB, code string, corrected *ach.CorrectedData) *ach.EntryDetail {
+	t.Helper()
+
+	file := threeEntryFile(t)
+	before := *entryOf(t, file, 0, 0)
+	beforeControl := file.Control
+	result := appliedResult(t, file, correctionFile(t, notice{
+		changeCode:    code,
+		originalTrace: traceOf(t, file, 0, 0),
+		originalDFI:   "23138010",
+		correctedData: ach.WriteCorrectionData(code, corrected),
+	}))
+	undo := onlyUndoEntry(t, result)
+	require.Equal(t, code, undo.Addenda98.ChangeCode)
+
+	undoResult := appliedResult(t, file, result.Undo)
+	after := entryOf(t, file, 0, 0)
+	require.Equal(t, before.RDFIIdentification, after.RDFIIdentification)
+	require.Equal(t, before.CheckDigit, after.CheckDigit)
+	require.Equal(t, before.DFIAccountNumber, after.DFIAccountNumber)
+	require.Equal(t, before.IndividualName, after.IndividualName)
+	require.Equal(t, before.TransactionCode, after.TransactionCode)
+	require.Equal(t, before.IdentificationNumber, after.IdentificationNumber)
+	require.Equal(t, beforeControl.EntryAddendaCount, file.Control.EntryAddendaCount)
+	require.Equal(t, beforeControl.EntryHash, file.Control.EntryHash)
+	require.Equal(t, beforeControl.TotalDebitEntryDollarAmountInFile, file.Control.TotalDebitEntryDollarAmountInFile)
+	require.Equal(t, beforeControl.TotalCreditEntryDollarAmountInFile, file.Control.TotalCreditEntryDollarAmountInFile)
+	require.NotNil(t, undoResult.Undo)
+	return undo
+}
