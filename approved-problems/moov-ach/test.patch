+func TestApplyCorrections_RefusedBatchUsesCoveringServiceClass(t *testing.T) {
+	file := threeEntryFile(t)
+	credit := correctionFile(t,
+		notice{"C01", "121042880000091", "23138010", "1111111111"})
+	debit := debitCorrectionFile(t,
+		notice{"C01", "121042880000092", "23138010", "2222222222"})
