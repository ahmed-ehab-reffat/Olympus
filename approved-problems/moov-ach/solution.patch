+// software distributed under the License is distributed on an
+// "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+// KIND, either express or implied.  See the License for the
+// specific language governing permissions and limitations
+// under the License.
+
+package ach
+
+import (
+	"encoding/json"
+	"strings"
+)
+
+type correctionTarget struct {
+	entry    *EntryDetail
+	batch    Batcher
+	iatEntry *IATEntryDetail
+	iatBatch *IATBatch
+
+	originalTrace string
+	originalDFI   string
+}
+
+type correctionState struct {
+	routing        string
+	account        string
+	name           string
+	transaction    int
+	identification string
+}
+
+func (target *correctionTarget) supports(code string) bool {
+	code = strings.ToUpper(code)
+	if target.iatEntry != nil {
+		switch code {
+		case "C02", "C05", "C08", "C09":
+			return true
+		default:
+			return false
+		}
+	}
+	return code != "C08"
+}
+
+func (target *correctionTarget) isOffset() bool {
+	return target.entry != nil && target.entry.IndividualName == offsetIndividualName
+}
+
+func (target *correctionTarget) snapshot() correctionState {
+	if target.entry != nil {
+		return correctionState{
+			routing:        target.entry.RDFIIdentificationField() + target.entry.CheckDigit,
+			account:        target.entry.DFIAccountNumber,
+			name:           target.entry.IndividualName,
+			transaction:    target.entry.TransactionCode,
+			identification: target.entry.IdentificationNumber,
+		}
+	}
+	state := correctionState{
+		routing:     target.iatEntry.RDFIIdentificationField() + target.iatEntry.CheckDigit,
+		account:     target.iatEntry.DFIAccountNumber,
+		transaction: target.iatEntry.TransactionCode,
+	}
+	if target.iatEntry.Addenda10 != nil {
+		state.name = target.iatEntry.Addenda10.Name
+	}
+	if target.iatEntry.Addenda15 != nil {
+		state.identification = target.iatEntry.Addenda15.ReceiverIDNumber
+	}
+	return state
+}
+
+func (target *correctionTarget) restore(state correctionState) {
+	if target.entry != nil {
+		target.entry.SetRDFI(state.routing)
+		target.entry.DFIAccountNumber = state.account
+		target.entry.IndividualName = state.name
+		target.entry.TransactionCode = state.transaction
+		target.entry.IdentificationNumber = state.identification
+		return
+	}
+	target.iatEntry.SetRDFI(state.routing)
+	target.iatEntry.DFIAccountNumber = state.account
+	target.iatEntry.TransactionCode = state.transaction
+	if target.iatEntry.Addenda10 != nil {
+		target.iatEntry.Addenda10.Name = state.name
+	}
+	if target.iatEntry.Addenda15 != nil {
+		target.iatEntry.Addenda15.ReceiverIDNumber = state.identification
+	}
+}
+
+func (target *correctionTarget) apply(data *CorrectedData) {
+	if target.entry != nil {
+		if data.RoutingNumber != "" {
+			target.entry.SetRDFI(data.RoutingNumber)
+		}
+		if data.AccountNumber != "" {
+			target.entry.DFIAccountNumber = data.AccountNumber
+		}
+		if data.Name != "" {
+			target.entry.IndividualName = data.Name
+		}
+		if data.TransactionCode != 0 {
+			target.entry.TransactionCode = data.TransactionCode
+		}
+		if data.Identification != "" {
+			target.entry.IdentificationNumber = data.Identification
+		}
+		return
+	}
+	if data.RoutingNumber != "" {
+		target.iatEntry.SetRDFI(data.RoutingNumber)
+	}
+	if data.TransactionCode != 0 {
+		target.iatEntry.TransactionCode = data.TransactionCode
+	}
+	if data.Identification != "" && target.iatEntry.Addenda15 != nil {
+		target.iatEntry.Addenda15.ReceiverIDNumber = data.Identification
+	}
+}
+
+func (target *correctionTarget) finalDFI() string {
+	if target.entry != nil {
+		return target.entry.RDFIIdentificationField()
+	}
+	return target.iatEntry.RDFIIdentificationField()
+}
+
+func (target *correctionTarget) offsetsFeasible() bool {
+	return target.batch == nil || offsetsRemainFeasible(target.batch.GetEntries())
+}
+
+type invalidEntryLister interface {
+	InvalidEntries() []InvalidEntry
+}
+
+func (target *correctionTarget) transactionValid() bool {
+	if target.entry != nil {
+		header := target.batch.GetHeader()
+		originalServiceClass := header.ServiceClassCode
+		header.ServiceClassCode = coveringServiceClassCode(originalServiceClass, target.batch.GetEntries())
+		invalid := target.batch.(invalidEntryLister).InvalidEntries()
+		header.ServiceClassCode = originalServiceClass
+		return len(invalid) == 0
+	}
+
+	data, err := json.Marshal(target.iatBatch)
+	if err != nil {
+		return false
+	}
+	var staged IATBatch
+	if err := json.Unmarshal(data, &staged); err != nil {
+		return false
+	}
+	staged.category = target.iatBatch.category
+	staged.Header.ServiceClassCode = coveringIATServiceClassCode(staged.Header.ServiceClassCode, staged.Entries)
+	return staged.Create() == nil
+}
+
+func inverseCorrectedData(code string, before correctionState) string {
+	data := &CorrectedData{}
+	switch strings.ToUpper(code) {
+	case "C01":
+		data.AccountNumber = before.account
+	case "C02", "C08":
+		data.RoutingNumber = before.routing
+	case "C03":
+		data.RoutingNumber = before.routing
+		data.AccountNumber = before.account
+	case "C04":
+		data.Name = before.name
+	case "C05":
+		data.TransactionCode = before.transaction
+	case "C06":
+		data.AccountNumber = before.account
+		data.TransactionCode = before.transaction
+	case "C07":
+		data.RoutingNumber = before.routing
+		data.AccountNumber = before.account
+		data.TransactionCode = before.transaction
+	case "C09":
+		data.Identification = before.identification
+	}
+	if strings.EqualFold(code, "C08") {
+		return before.routing
+	}
+	return WriteCorrectionData(code, data)
+}
