+
+package ach
+
+import "strings"
+
+// CorrectionResult contains the two files produced while applying Notifications of Change.
+// Either file is nil when it would contain no entries.
+type CorrectionResult struct {
+	Refused *File
+	Undo    *File
+}
+
+type acceptedNotification struct {
+	header *BatchHeader
+	entry  *EntryDetail
+	target *correctionTarget
+	before correctionState
+}
+
+type refusedNotification struct {
+	source int
+	header *BatchHeader
+	entry  *EntryDetail
+	code   string
+}
+
+// ApplyCorrections updates f from ordinary Notification of Change entries. Every notification
+// applies or is refused independently. The result also contains reverse-order notifications
+// which undo every accepted change.
+func (f *File) ApplyCorrections(corrections ...*File) (*CorrectionResult, error) {
+	if f == nil {
+		return nil, nil
+	}
+
+	index := newCorrectionIndex(f)
+	changedBatches := make(map[Batcher]bool)
+	changedIATBatches := make(map[*IATBatch]bool)
+
+	var accepted []acceptedNotification
+	var refused []refusedNotification
+	hasNotifications := false
+
+	for source, correctionFile := range corrections {
+		if correctionFile == nil {
+			continue
+		}
+		for _, batch := range correctionFile.Batches {
+			for _, entry := range batch.GetEntries() {
+				if entry == nil || entry.Addenda98 == nil {
+					continue
+				}
+				hasNotifications = true
+
+				target, data, code := classifyCorrection(entry.Addenda98, index)
+				var before correctionState
+				if code == "" {
+					before = target.snapshot()
+					target.apply(data)
+
+					if data.TransactionCode != 0 && !target.transactionValid() {
+						target.restore(before)
+						code = "C69"
+					} else if !target.offsetsFeasible() {
+						target.restore(before)
+						code = "C69"
+					}
+				}
+
+				if code != "" {
+					refused = append(refused, refusedNotification{
+						source: source,
+						header: batch.GetHeader(),
+						entry:  entry,
+						code:   code,
+					})
+					continue
+				}
+
+				accepted = append(accepted, acceptedNotification{
+					header: batch.GetHeader(),
+					entry:  entry,
+					target: target,
+					before: before,
+				})
+				if target.batch != nil {
+					changedBatches[target.batch] = true
+				}
+				if target.iatBatch != nil {
+					changedIATBatches[target.iatBatch] = true
+				}
+			}
+		}
+	}
+
+	if !hasNotifications {
+		return nil, nil
+	}
+
+	if err := rebuildCorrectedFile(f, changedBatches, changedIATBatches); err != nil {
+		return nil, err
+	}
+	refusedFile, err := buildRefusedFile(f, refused)
+	if err != nil {
+		return nil, err
+	}
+	undoFile, err := buildUndoFile(f, accepted)
+	if err != nil {
+		return nil, err
+	}
+	return &CorrectionResult{Refused: refusedFile, Undo: undoFile}, nil
+}
+
+// classifyCorrection performs every check which does not require tentatively applying the
+// corrected fields. Its ordering is observable through the refused change code.
+func classifyCorrection(addenda98 *Addenda98, index *correctionIndex) (*correctionTarget, *CorrectedData, string) {
+	data := parseCorrectionData(addenda98)
+	if data == nil {
+		return nil, nil, "C65"
+	}
+
+	key := originalEntryKey{
+		trace: addenda98.OriginalTraceField(),
+		dfi:   addenda98.OriginalDFIField(),
+	}
+	if !index.institutions[key.dfi] {
+		return nil, nil, "C61"
+	}
+	target := index.entries[key]
+	if target == nil {
+		return nil, nil, "C62"
+	}
+	if target.isOffset() {
+		return nil, nil, "C62"
+	}
+	if !target.supports(addenda98.ChangeCode) {
+		return nil, nil, "C65"
+	}
+	if data.RoutingNumber != "" {
+		if err := CheckRoutingNumber(data.RoutingNumber); err != nil {
+			return nil, nil, "C67"
+		}
+	}
+	if data.TransactionCode != 0 {
+		if err := StandardTransactionCode(data.TransactionCode); err != nil {
+			return nil, nil, "C69"
+		}
+	}
+	return target, data, ""
+}
+
+func parseCorrectionData(addenda98 *Addenda98) *CorrectedData {
+	if addenda98 == nil {
+		return nil
+	}
+	if strings.EqualFold(addenda98.ChangeCode, "C08") {
+		routing := strings.TrimSpace(addenda98.CorrectedData)
+		if routing == "" {
+			return nil
+		}
+		return &CorrectedData{RoutingNumber: routing}
+	}
+	return addenda98.ParseCorrectedData()
+}
+
+type originalEntryKey struct {
+	trace string
+	dfi   string
+}
+
+type correctionIndex struct {
+	entries      map[originalEntryKey]*correctionTarget
+	institutions map[string]bool
+}
+
+func newCorrectionIndex(f *File) *correctionIndex {
+	index := &correctionIndex{
+		entries:      make(map[originalEntryKey]*correctionTarget),
+		institutions: make(map[string]bool),
+	}
+	for _, batch := range f.Batches {
+		for _, entry := range batch.GetEntries() {
+			if entry == nil {
+				continue
+			}
+			target := &correctionTarget{
+				entry:         entry,
+				batch:         batch,
+				originalTrace: entry.TraceNumberField(),
+				originalDFI:   entry.RDFIIdentificationField(),
+			}
+			index.add(target)
+		}
+	}
+	for i := range f.IATBatches {
+		batch := &f.IATBatches[i]
+		for _, entry := range batch.GetEntries() {
+			if entry == nil {
+				continue
+			}
+			target := &correctionTarget{
+				iatEntry:      entry,
+				iatBatch:      batch,
+				originalTrace: entry.TraceNumberField(),
+				originalDFI:   entry.RDFIIdentificationField(),
+			}
+			index.add(target)
+		}
+	}
+	return index
+}
+
+func (index *correctionIndex) add(target *correctionTarget) {
+	key := originalEntryKey{trace: target.originalTrace, dfi: target.originalDFI}
+	index.entries[key] = target
+	index.institutions[key.dfi] = true
+}
+
+func rebuildCorrectedFile(f *File, batches map[Batcher]bool, iatBatches map[*IATBatch]bool) error {
+	for batch := range batches {
+		rebalanceOffsets(batch.GetEntries())
+		header := batch.GetHeader()
+		header.ServiceClassCode = coveringServiceClassCode(header.ServiceClassCode, batch.GetEntries())
+		if err := batch.Create(); err != nil {
+			return err
+		}
+	}
+	for batch := range iatBatches {
+		batch.Header.ServiceClassCode = coveringIATServiceClassCode(batch.Header.ServiceClassCode, batch.Entries)
+		if err := batch.Create(); err != nil {
+			return err
+		}
+	}
+	if len(batches) > 0 || len(iatBatches) > 0 {
+		return f.Create()
+	}
+	return nil
+}
+
+func offsetsRemainFeasible(entries []*EntryDetail) bool {
+	credits, debits := nonOffsetAmounts(entries)
+	for _, entry := range entries {
+		if entry == nil || entry.IndividualName != offsetIndividualName {
+			continue
+		}
+		switch entry.CreditOrDebit() {
+		case "C":
+			if debits == 0 {
+				return false
+			}
+		case "D":
+			if credits == 0 {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+func rebalanceOffsets(entries []*EntryDetail) {
+	credits, debits := nonOffsetAmounts(entries)
+	for _, entry := range entries {
+		if entry == nil || entry.IndividualName != offsetIndividualName {
+			continue
+		}
+		switch entry.CreditOrDebit() {
+		case "C":
+			entry.Amount = debits
+		case "D":
+			entry.Amount = credits
+		}
+	}
+}
+
+func nonOffsetAmounts(entries []*EntryDetail) (credits, debits int) {
+	for _, entry := range entries {
+		if entry == nil || entry.IndividualName == offsetIndividualName {
+			continue
+		}
+		switch entry.CreditOrDebit() {
+		case "C":
+			credits += entry.Amount
+		case "D":
+			debits += entry.Amount
+		}
+	}
+	return credits, debits
+}
+
+func coveringServiceClassCode(current int, entries []*EntryDetail) int {
+	var credits, debits bool
+	for _, entry := range entries {
+		if entry == nil {
+			continue
+		}
+		switch entry.CreditOrDebit() {
+		case "C":
+			credits = true
+		case "D":
+			debits = true
+		}
+	}
+	return coveringCode(current, credits, debits)
+}
+
+func coveringIATServiceClassCode(current int, entries []*IATEntryDetail) int {
+	var credits, debits bool
+	for _, entry := range entries {
+		if entry == nil {
+			continue
+		}
+		direction := (&EntryDetail{TransactionCode: entry.TransactionCode}).CreditOrDebit()
+		credits = credits || direction == "C"
+		debits = debits || direction == "D"
+	}
+	return coveringCode(current, credits, debits)
+}
+
+func createCorrectionBatch(batch *BatchCOR) error {
+	header := batch.GetHeader()
+	header.ServiceClassCode = coveringServiceClassCode(header.ServiceClassCode, batch.GetEntries())
+	return batch.Create()
+}
+
+func coveringCode(current int, credits, debits bool) int {
+	switch {
+	case credits && debits:
+		return MixedDebitsAndCredits
+	case credits:
+		if current != MixedDebitsAndCredits {
+			return CreditsOnly
+		}
+	case debits:
+		if current != MixedDebitsAndCredits {
+			return DebitsOnly
+		}
+	}
+	return current
+}
