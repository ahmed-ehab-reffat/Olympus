+package ach
+
+// buildUndoFile builds one COR batch whose notifications reverse every acceptance. Identity
+// fields are resolved after the forward pass so all notifications for a target name the same
+// call-start DFI when the file is later applied.
+func buildUndoFile(f *File, accepted []acceptedNotification) (*File, error) {
+	if len(accepted) == 0 {
+		return nil, nil
+	}
+
+	file := NewFile()
+	file.SetHeader(f.Header)
+	header := *accepted[len(accepted)-1].header
+	header.StandardEntryClassCode = COR
+	header.BatchNumber = 1
+	batch := NewBatchCOR(&header)
+
+	sequence := 1
+	for i := len(accepted) - 1; i >= 0; i-- {
+		batch.AddEntry(undoEntry(accepted[i], header.ODFIIdentification, sequence))
+		sequence++
+	}
+	if err := createCorrectionBatch(batch); err != nil {
+		return nil, err
+	}
+	file.AddBatch(batch)
+	if err := file.Create(); err != nil {
+		return nil, err
+	}
+	return file, nil
+}
+
+func undoEntry(accepted acceptedNotification, odfi string, sequence int) *EntryDetail {
+	entry := *accepted.entry
+	entry.Amount = 0
+	entry.Category = CategoryNOC
+	entry.AddendaRecordIndicator = 1
+	entry.Addenda98Refused = nil
+
+	entry.Addenda98 = &Addenda98{
+		TypeCode:      "98",
+		ChangeCode:    accepted.entry.Addenda98.ChangeCode,
+		OriginalTrace: accepted.target.originalTrace,
+		OriginalDFI:   accepted.target.finalDFI(),
+		CorrectedData: inverseCorrectedData(accepted.entry.Addenda98.ChangeCode, accepted.before),
+	}
+	entry.SetTraceNumber(odfi, sequence)
+	return &entry
+}
