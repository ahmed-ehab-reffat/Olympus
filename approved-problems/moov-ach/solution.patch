+
+package ach
+
+// traceSequenceLength is the number of trailing digits of a Notification of Change trace
+// number which the refused Addenda98 carries as its Trace Sequence Number.
+const traceSequenceLength = 7
+
+// buildRefusedFile assembles the file of refused Notifications of Change.
+//
+// Each supplied file which produced a refusal contributes one COR batch, in the order the
+// files were supplied, and each refusal contributes one entry to the batch for its file.
+// Returns nil when nothing was refused.
+func buildRefusedFile(f *File, refused []refusedNotification) (*File, error) {
+	if len(refused) == 0 {
+		return nil, nil
+	}
+
+	file := NewFile()
+	file.SetHeader(f.Header)
+
+	// The refusals are already in the order they were read, so walking them in that order
+	// keeps both the batches and the entries within them in that order too.
+	var batch *BatchCOR
+	source := -1
+	for _, refusal := range refused {
+		if batch == nil || refusal.source != source {
+			if batch != nil {
+				if err := createCorrectionBatch(batch); err != nil {
+					return nil, err
+				}
+				file.AddBatch(batch)
+			}
+			// A batch takes the header of the batch which held the first refusal of its
+			// file, so the refused notifications go back the way they arrived.
+			header := *refusal.header
+			batch = NewBatchCOR(&header)
+			source = refusal.source
+		}
+		batch.AddEntry(refusedEntry(refusal))
+	}
+	if err := createCorrectionBatch(batch); err != nil {
+		return nil, err
+	}
+	file.AddBatch(batch)
+
+	if err := file.Create(); err != nil {
+		return nil, err
+	}
+	return file, nil
+}
+
+// refusedEntry copies the entry which carried a refused Notification of Change, replacing its
+// Addenda98 with the refused form which names why it was refused.
+func refusedEntry(refusal refusedNotification) *EntryDetail {
+	entry := *refusal.entry
+	addenda98 := refusal.entry.Addenda98
+
+	trace := refusal.entry.TraceNumberField()
+	if len(trace) > traceSequenceLength {
+		trace = trace[len(trace)-traceSequenceLength:]
+	}
+
+	entry.Addenda98 = nil
+	entry.Addenda98Refused = &Addenda98Refused{
+		TypeCode:            addenda98.TypeCode,
+		RefusedChangeCode:   refusal.code,
+		OriginalTrace:       addenda98.OriginalTrace,
+		OriginalDFI:         addenda98.OriginalDFI,
+		CorrectedData:       addenda98.CorrectedData,
+		ChangeCode:          addenda98.ChangeCode,
+		TraceSequenceNumber: trace,
+		TraceNumber:         refusal.entry.TraceNumber,
+	}
+	entry.AddendaRecordIndicator = 1
+
+	return &entry
+}
diff --git a/correction_target.go b/correction_target.go
