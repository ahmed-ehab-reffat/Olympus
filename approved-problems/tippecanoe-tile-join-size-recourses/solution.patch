+static void note_strategy(std::vector<strategy> &strategies, int z, size_t dropped) {
+	if ((size_t) z >= strategies.size()) {
+		strategies.resize(z + 1);
+	}
+
+	strategies[z].dropped_as_needed += dropped;
+}
+
+static void note_oversized(std::vector<size_t> &oversized, int z, size_t tile_size) {
+	if ((size_t) z >= oversized.size()) {
+		oversized.resize(z + 1, 0);
+	}
+
+	oversized[z] = std::max(oversized[z], tile_size);
+}
