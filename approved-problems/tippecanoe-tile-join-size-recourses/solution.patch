+struct ranked_feature {
+	size_t layer = 0;
+	size_t feature = 0;
+	double extent = 0;
+	size_t seq = 0;
+
+	bool operator<(ranked_feature const &o) const {
+		if (extent != o.extent) {
+			return extent < o.extent;
+		}
+
+		return seq > o.seq;
+	}
+};
+
+static std::vector<ranked_feature> rank_features(mvt_tile const &tile, std::vector<staged_feature> const &staged) {
+	std::vector<ranked_feature> ranked;
+
+	for (size_t i = 0; i < tile.layers.size(); i++) {
+		for (size_t j = 0; j < tile.layers[i].features.size(); j++) {
+			ranked_feature rf;
+			rf.layer = i;
+			rf.feature = j;
+			rf.seq = tile.layers[i].features[j].seq;
+			rf.extent = staged[rf.seq].box.extent(staged[rf.seq].type);
+			ranked.push_back(rf);
+		}
+	}
+
+	std::stable_sort(ranked.begin(), ranked.end());
+	return ranked;
+}
+
+static size_t drop_ranked(mvt_tile &tile, std::vector<ranked_feature> const &ranked, size_t to_drop) {
+	if (to_drop == 0) {
+		return 0;
+	}
+
+	std::vector<std::vector<bool>> doomed;
+	for (size_t i = 0; i < tile.layers.size(); i++) {
+		doomed.push_back(std::vector<bool>(tile.layers[i].features.size(), false));
+	}
+
+	for (size_t i = 0; i < to_drop && i < ranked.size(); i++) {
+		doomed[ranked[i].layer][ranked[i].feature] = true;
+	}
+
+	size_t dropped = 0;
+
+	for (size_t i = 0; i < tile.layers.size(); i++) {
+		std::vector<mvt_feature> kept;
+
+		for (size_t j = 0; j < tile.layers[i].features.size(); j++) {
+			if (doomed[i][j]) {
+				dropped++;
+			} else {
+				kept.push_back(std::move(tile.layers[i].features[j]));
+			}
+		}
+
+		tile.layers[i].features = std::move(kept);
+		tile.layers[i].compact_attributes();
+	}
+
+	return dropped;
+}
+
+static void drop_empty_layers(mvt_tile &tile) {
+	std::vector<mvt_layer> kept;
+
+	for (size_t i = 0; i < tile.layers.size(); i++) {
+		if (tile.layers[i].features.size() > 0) {
+			kept.push_back(std::move(tile.layers[i]));
+		}
+	}
+
+	tile.layers = std::move(kept);
+}
+
+static std::string encode_and_compress(mvt_tile &tile) {
+	std::string pbf = tile.encode();
+	std::string compressed;
+
+	if (!pC) {
+		compress(pbf, compressed, true);
+	} else {
+		compressed = pbf;
+	}
+
+	return compressed;
+}
+
+static size_t count_features(mvt_tile const &tile) {
+	size_t count = 0;
+
+	for (size_t i = 0; i < tile.layers.size(); i++) {
+		count += tile.layers[i].features.size();
+	}
+
+	return count;
+}
+
+static std::string reduce_to_fit(mvt_tile &tile, std::vector<staged_feature> const &staged, std::string compressed, size_t *dropped) {
+	while (compressed.size() > max_tile_size) {
+		size_t remaining = count_features(tile);
+		if (remaining <= 1) {
+			break;
+		}
+
+		double fraction = (double) max_tile_size / compressed.size() * 0.75;
+		size_t keep = (size_t) (remaining * fraction);
+		if (keep >= remaining) {
+			keep = remaining - 1;
+		}
+		if (keep < 1) {
+			keep = 1;
+		}
+
+		std::vector<ranked_feature> ranked = rank_features(tile, staged);
+		size_t n = drop_ranked(tile, ranked, remaining - keep);
+		if (n == 0) {
+			break;
+		}
+
+		*dropped += n;
+		drop_empty_layers(tile);
+		compressed = encode_and_compress(tile);
+	}
+
+	return compressed;
+}
