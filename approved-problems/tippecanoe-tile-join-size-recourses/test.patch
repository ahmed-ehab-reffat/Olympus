index 0000000..e0b5ace
--- /dev/null
+++ b/tests/tile_join_limit_0dae2a/mvt.py
@@ -0,0 +1,254 @@
+import gzip
+import struct
+
+
+def _varint(buf, pos):
+    result = 0
+    shift = 0
+    while True:
+        b = buf[pos]
+        pos += 1
+        result |= (b & 0x7F) << shift
+        if not (b & 0x80):
+            return result, pos
+        shift += 7
+
+
+def _fields(buf, start, end):
+    pos = start
+    while pos < end:
+        key, pos = _varint(buf, pos)
+        field, wire = key >> 3, key & 7
+        if wire == 0:
+            value, pos = _varint(buf, pos)
+            yield field, value
+        elif wire == 1:
+            yield field, struct.unpack_from('<d', buf, pos)[0]
+            pos += 8
+        elif wire == 2:
+            length, pos = _varint(buf, pos)
+            yield field, (pos, pos + length)
+            pos += length
+        elif wire == 5:
+            yield field, struct.unpack_from('<f', buf, pos)[0]
+            pos += 4
+        else:
+            raise ValueError('unsupported wire type %d' % wire)
+
+
+def _packed(buf, start, end):
+    out = []
+    pos = start
+    while pos < end:
+        value, pos = _varint(buf, pos)
+        out.append(value)
+    return out
+
+
+def _zigzag(n):
+    return (n >> 1) ^ -(n & 1)
+
+
+def _value(buf, start, end):
+    for field, payload in _fields(buf, start, end):
+        if field == 1:
+            return buf[payload[0]:payload[1]].decode('utf-8')
+        if field in (2, 3):
+            return payload
+        if field in (4, 5):
+            return payload
+        if field == 6:
+            return _zigzag(payload)
+        if field == 7:
+            return bool(payload)
+    return None
+
+
+def _value_field(buf, start, end):
+    for field, _ in _fields(buf, start, end):
+        return field
+    return None
+
+
+def _feature(buf, start, end):
+    feature = {'id': None, 'tags': [], 'type': 0, 'geometry': []}
+    for field, payload in _fields(buf, start, end):
+        if field == 1:
+            feature['id'] = payload
+        elif field == 2:
+            feature['tags'] = _packed(buf, payload[0], payload[1])
+        elif field == 3:
+            feature['type'] = payload
+        elif field == 4:
+            feature['geometry'] = _packed(buf, payload[0], payload[1])
+    return feature
+
+
+def _layer(buf, start, end):
+    layer = {'name': '', 'keys': [], 'values': [], 'value_fields': [], 'features': [], 'extent': 4096}
+    for field, payload in _fields(buf, start, end):
+        if field == 1:
+            layer['name'] = buf[payload[0]:payload[1]].decode('utf-8')
+        elif field == 2:
+            layer['features'].append(_feature(buf, payload[0], payload[1]))
+        elif field == 3:
+            layer['keys'].append(buf[payload[0]:payload[1]].decode('utf-8'))
+        elif field == 4:
+            layer['values'].append(_value(buf, payload[0], payload[1]))
+            layer['value_fields'].append(_value_field(buf, payload[0], payload[1]))
+        elif field == 5:
+            layer['extent'] = payload
+    return layer
+
+
+def decode_tile(data):
+    if data[:2] == b'\x1f\x8b':
+        data = gzip.decompress(data)
+    layers = []
+    for field, payload in _fields(data, 0, len(data)):
+        if field == 3:
+            layers.append(_layer(data, payload[0], payload[1]))
+    return layers
+
+
+def attributes(layer, feature):
+    out = {}
+    tags = feature['tags']
+    for i in range(0, len(tags) - 1, 2):
+        out[layer['keys'][tags[i]]] = layer['values'][tags[i + 1]]
+    return out
+
+
+def used_pool_indexes(layer):
+    keys = set()
+    values = set()
+    for feature in layer['features']:
+        tags = feature['tags']
+        for i in range(0, len(tags) - 1, 2):
+            keys.add(tags[i])
+            values.add(tags[i + 1])
+    return keys, values
+
+
+def bbox(feature):
+    x = y = 0
+    xs = []
+    ys = []
+    geom = feature['geometry']
+    i = 0
+    while i < len(geom):
+        command = geom[i] & 0x7
+        count = geom[i] >> 3
+        i += 1
+        if command in (1, 2):
+            for _ in range(count):
+                x += _zigzag(geom[i])
+                y += _zigzag(geom[i + 1])
+                i += 2
+                xs.append(x)
+                ys.append(y)
+        else:
+            pass
+    if not xs:
+        return None
+    return min(xs), min(ys), max(xs), max(ys)
+
+
+def extent_of(feature):
+    box = bbox(feature)
+    if box is None or feature['type'] == 1:
+        return 0.0
+    width = box[2] - box[0]
+    height = box[3] - box[1]
+    if feature['type'] == 3:
+        return float(width) * float(height)
+    return float(width) + float(height)
+
+
+def _put_varint(value):
+    out = bytearray()
+    while True:
+        byte = value & 0x7F
+        value >>= 7
+        if value:
+            out.append(byte | 0x80)
+        else:
+            out.append(byte)
+            return bytes(out)
+
+
+def _varint_field(field, value):
+    return _put_varint(field << 3) + _put_varint(value)
+
+
+def _bytes_field(field, payload):
+    return _put_varint((field << 3) | 2) + _put_varint(len(payload)) + payload
+
+
+def _zig(n):
+    return 2 * n if n >= 0 else -2 * n - 1
+
+
+def _encode_value(value):
+    if isinstance(value, tuple):
+        kind, raw = value
+        if kind == 'bool':
+            return _varint_field(7, 1 if raw else 0)
+        if kind == 'double':
+            return _put_varint((3 << 3) | 1) + struct.pack('<d', raw)
+        if kind == 'float':
+            return _put_varint((2 << 3) | 5) + struct.pack('<f', raw)
+        if kind == 'sint':
+            return _varint_field(6, _zig(raw))
+        if kind == 'int':
+            return _varint_field(4, raw)
+        return _varint_field(5, raw)
+    if isinstance(value, int):
+        return _varint_field(5, value)
+    return _bytes_field(1, value.encode('utf-8'))
+
+
+def line_geometry(points):
+    x, y = points[0]
+    commands = [1 | (1 << 3), _zig(x), _zig(y), 2 | ((len(points) - 1) << 3)]
+    for px, py in points[1:]:
+        commands += [_zig(px - x), _zig(py - y)]
+        x, y = px, py
+    return commands
+
+
+def encode_tile(layers):
+    tile = b''
+    for layer in layers:
+        keys = []
+        values = []
+        features = b''
+        for feature in layer['features']:
+            tags = []
+            for key, value in feature['attributes'].items():
+                if key not in keys:
+                    keys.append(key)
+                if value not in values:
+                    values.append(value)
+                tags += [keys.index(key), values.index(value)]
+            body = _bytes_field(2, b''.join(_put_varint(t) for t in tags))
+            body += _varint_field(3, feature['type'])
+            body += _bytes_field(4, b''.join(_put_varint(c) for c in feature['geometry']))
+            features += _bytes_field(2, body)
+        encoded = _varint_field(15, 2) + _bytes_field(1, layer['name'].encode('utf-8')) + features
+        for key in keys:
+            encoded += _bytes_field(3, key.encode('utf-8'))
+        for value in values:
+            encoded += _bytes_field(4, _encode_value(value))
+        encoded += _varint_field(5, layer['extent'])
+        tile += _bytes_field(3, encoded)
+    return tile
+
+
+def point_geometry(points):
+    x = y = 0
+    commands = [1 | (len(points) << 3)]
+    for px, py in points:
+        commands += [_zig(px - x), _zig(py - y)]
+        x, y = px, py
+    return commands
diff --git a/tests/tile_join_limit_0dae2a/run_tests.py b/tests/tile_join_limit_0dae2a/run_tests.py
