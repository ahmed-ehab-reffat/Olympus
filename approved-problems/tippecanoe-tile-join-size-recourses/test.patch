+@test
+def ties_are_shed_in_merge_order_across_inputs_and_layers():
+    rows = {'a': 500, 'b': 1500}
+
+    def points(ids):
+        return [{'type': 1, 'geometry': mvt.point_geometry([(40 + 60 * (i % 100), rows['b'] if 100 <= i < 200 else (rows['a'] if i < 100 else 2500))]),
+                 'attributes': {'id': i}} for i in ids]
+
+    def layers(ids):
+        out = []
+        for i in ids:
+            name = 'b' if 100 <= i < 200 else 'a'
+            if not out or out[-1]['name'] != name:
+                out.append({'name': name, 'extent': 4096, 'ids': []})
+            out[-1]['ids'].append(i)
+        return [{'name': layer['name'], 'extent': 4096, 'features': points(layer['ids'])} for layer in out]
+
+    first_a, first_b, second_a = list(range(0, 20)), list(range(100, 120)), list(range(200, 220))
+    first = write_mbtiles('tie_first', layers(first_a + first_b))
+    second = write_mbtiles('tie_second', layers(second_a))
+    whole, code, err = join('tie_whole', [first, second], ['-M', '5000000', '--no-tile-compression'])
+    assert code == 0, err[-400:]
+    grouped = {layer['name']: [mvt.attributes(layer, f)['id'] for f in layer['features']] for layer in layers_of(whole)}
+    assert grouped['b'] == first_b, grouped
+    assert grouped['a'] in (first_a + second_a, second_a + first_a), grouped
+    merge_order = first_a + first_b + second_a if grouped['a'][0] == 0 else second_a + first_a + first_b
+    prefix = write_mbtiles('tie_prefix', layers(merge_order[:30]))
+    reference, _, _ = join('tie_reference', [prefix], ['-M', '5000000', '--no-tile-compression'])
+    out, _, _ = join('tie_reduced', [first, second],
+                     ['-M', str(len(only_tile(reference))), '--no-tile-compression', '--drop-smallest-as-needed'])
+    kept = ids_of(layers_of(out))
+    assert 0 < len(kept) < 60, len(kept)
+    assert kept == set(merge_order[:len(kept)]), sorted(kept)
