@@ -0,0 +1,1107 @@
+import gzip
+import json
+import os
+import random
+import shutil
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import time
+import traceback
+import xml.etree.ElementTree as ET
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import mvt
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..'))
+WORK = None
+
+BASE_TARGETS = [
+    'raw-tiles-test', 'parallel-test', 'radix-sort-test', 'pbf-test', 'join-test',
+    'enumerate-test', 'decode-test', 'join-filter-test', 'json-tool-test',
+    'allow-existing-test', 'csv-test', 'layer-json-test', 'pmtiles-test',
+    'decode-pmtiles-test', 'overzoom-test', 'flatgeobuf-test',
+]
+
+
+def run(args, cwd=ROOT):
+    proc = subprocess.run(args, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    return proc.returncode, proc.stdout.decode('utf-8', 'replace'), proc.stderr.decode('utf-8', 'replace')
+
+
+def path(name):
+    return os.path.join(WORK, name)
+
+
+def write_geojson(name, features):
+    target = path(name)
+    with open(target, 'w') as f:
+        for feature in features:
+            f.write(json.dumps(feature) + '\n')
+    return target
+
+
+def point(i, x, y, props=None):
+    attributes = {'id': i, 'name': 'feature-%d-abcdefghijklmnopqrst' % i, 'cat': 'c%d' % (i % 7)}
+    if props:
+        attributes.update(props)
+    return {'type': 'Feature', 'properties': attributes,
+            'geometry': {'type': 'Point', 'coordinates': [x, y]}}
+
+
+def square(i, x, y, size, props=None):
+    attributes = {'id': i, 'name': 'square-%d' % i}
+    if props:
+        attributes.update(props)
+    ring = [[x, y], [x + size, y], [x + size, y + size], [x, y + size], [x, y]]
+    return {'type': 'Feature', 'properties': attributes,
+            'geometry': {'type': 'Polygon', 'coordinates': [ring]}}
+
+
+def dense_points(count, seed=1):
+    rng = random.Random(seed)
+    return [point(i, -122.5 + rng.random() * 0.5, 37.7 + rng.random() * 0.4) for i in range(count)]
+
+
+def graduated_squares(count):
+    features = []
+    for i in range(count):
+        size = 0.0006 * (i + 1)
+        features.append(square(i, -122.4 + i * 0.02, 37.75, size))
+    return features
+
+
+def build_tileset(name, features, extra=None):
+    source = write_geojson(name + '.json', features)
+    out = path(name + '.mbtiles')
+    args = [os.path.join(ROOT, 'tippecanoe'), '-q', '-f', '-o', out, '-z0', '-r1', '-pf', '--no-tile-size-limit', '-pS']
+    if extra:
+        args += extra
+    args.append(source)
+    code, _, err = run(args)
+    if code != 0:
+        raise AssertionError('tippecanoe failed: %s' % err[-400:])
+    return out
+
+
+def join(name, inputs, extra=None):
+    out = path(name + '.mbtiles')
+    args = [os.path.join(ROOT, 'tile-join'), '-f', '-o', out]
+    if extra:
+        args += extra
+    args += inputs
+    code, _, err = run(args)
+    return out, code, err
+
+
+def tiles(mbtiles):
+    conn = sqlite3.connect(mbtiles)
+    rows = list(conn.execute('select zoom_level, tile_column, tile_row, tile_data from tiles'))
+    conn.close()
+    return rows
+
+
+def only_tile(mbtiles):
+    rows = tiles(mbtiles)
+    assert len(rows) == 1, 'expected exactly one tile, got %d' % len(rows)
+    return rows[0][3]
+
+
+def metadata(mbtiles):
+    conn = sqlite3.connect(mbtiles)
+    rows = dict(conn.execute('select name, value from metadata'))
+    conn.close()
+    return rows
+
+
+def strategies(mbtiles):
+    raw = metadata(mbtiles).get('strategies')
+    if raw is None:
+        return None
+    return json.loads(raw)
+
+
+def layers_of(mbtiles):
+    return mvt.decode_tile(only_tile(mbtiles))
+
+
+def feature_count(mbtiles):
+    return sum(len(layer['features']) for layer in layers_of(mbtiles))
+
+
+def ids_of(layers):
+    found = set()
+    for layer in layers:
+        for feature in layer['features']:
+            attributes = mvt.attributes(layer, feature)
+            if 'id' in attributes:
+                found.add(attributes['id'])
+    return found
+
+
+def assert_pools_are_used(layers):
+    for layer in layers:
+        used_keys, used_values = mvt.used_pool_indexes(layer)
+        unused_keys = set(range(len(layer['keys']))) - used_keys
+        unused_values = set(range(len(layer['values']))) - used_values
+        assert not unused_keys, 'layer %s keeps %d unused attribute keys' % (layer['name'], len(unused_keys))
+        assert not unused_values, 'layer %s keeps %d unused attribute values' % (layer['name'], len(unused_values))
+
+
+def meta_json(mbtiles):
+    return json.loads(metadata(mbtiles)['json'])
+
+
+def tilestats_layers(mbtiles):
+    out = {}
+    for layer in meta_json(mbtiles)['tilestats']['layers']:
+        attributes = {}
+        for attribute in layer.get('attributes', []):
+            attributes[attribute['attribute']] = attribute.get('values', [])
+        out[layer['layer']] = {'count': layer['count'], 'geometry': layer['geometry'], 'attributes': attributes}
+    return out
+
+
+def vector_layers(mbtiles):
+    return {layer['id']: (layer['minzoom'], layer['maxzoom'])
+            for layer in meta_json(mbtiles)['vector_layers']}
+
+
+def bounds_of(mbtiles):
+    return [float(value) for value in metadata(mbtiles)['bounds'].split(',')]
+
+
+def zoom_range(mbtiles):
+    rows = metadata(mbtiles)
+    return int(rows['minzoom']), int(rows['maxzoom'])
+
+
+def written_feature_count(mbtiles):
+    total = 0
+    for row in tiles(mbtiles):
+        for layer in mvt.decode_tile(row[3]):
+            total += len(layer['features'])
+    return total
+
+
+def oversized_source():
+    return build_tileset('oversized', dense_points(90000))
+
+
+def quadrant_points(count, seed=7):
+    rng = random.Random(seed)
+    features = []
+    for i in range(count):
+        quadrant = i % 4
+        lon = (-140.0 if quadrant in (0, 2) else 40.0) + rng.random() * 40.0
+        lat = (40.0 if quadrant in (0, 1) else -40.0) + rng.random() * 20.0
+        features.append(point(i, lon, lat))
+    return features
+
+
+def quad_source():
+    return build_tileset('quad', quadrant_points(90000), ['-Z0', '-z1', '-l', 'quad'])
+
+
+def pyramid_source():
+    rng = random.Random(11)
+    lons = [(-170.0, -100.0), (-80.0, -10.0), (10.0, 80.0), (100.0, 170.0)]
+    lats = [(70.0, 80.0), (10.0, 60.0), (-60.0, -10.0), (-80.0, -70.0)]
+    features = []
+    for i in range(96000):
+        lon = lons[i % 4]
+        lat = lats[(i // 4) % 4]
+        features.append(point(i, lon[0] + rng.random() * (lon[1] - lon[0]), lat[0] + rng.random() * (lat[1] - lat[0])))
+    return build_tileset('pyramid', features, ['-Z0', '-z2', '-l', 'pyramid'])
+
+
+def mixed_extents():
+    small = [point(i, -122.5 + (i % 20) * 0.01, 37.7 + (i // 20) * 0.01, {'tag': 'small'})
+             for i in range(400)]
+    big = [square(1000 + i, -170.0 + (i % 20) * 17.0, -70.0 + (i // 20) * 9.0, 5.0,
+                  {'tag': 'big'}) for i in range(300)]
+    return small, big
+
+
+def set_strategies(mbtiles, value):
+    conn = sqlite3.connect(mbtiles)
+    conn.execute("delete from metadata where name = 'strategies'")
+    conn.execute("insert into metadata (name, value) values ('strategies', ?)", (json.dumps(value),))
+    conn.commit()
+    conn.close()
+
+
+def blob(rng, length):
+    return ''.join(rng.choice('abcdefghijklmnopqrstuvwxyz0123456789') for _ in range(length))
+
+
+def rectangle(i, x, y, width, height):
+    ring = [[x, y], [x + width, y], [x + width, y + height], [x, y + height], [x, y]]
+    return {'type': 'Feature', 'properties': {'id': i, 'name': 'rectangle-%d' % i},
+            'geometry': {'type': 'Polygon', 'coordinates': [ring]}}
+
+
+def write_mbtiles(name, layers=None, tiles=None):
+    tiles = tiles or {(0, 0, 0): layers}
+    target = path(name + '.mbtiles')
+    conn = sqlite3.connect(target)
+    conn.execute('create table metadata (name text, value text)')
+    conn.execute('create table tiles (zoom_level integer, tile_column integer, tile_row integer, tile_data blob)')
+    conn.execute("insert into metadata (name, value) values ('name', ?)", (name,))
+    conn.execute("insert into metadata (name, value) values ('format', 'pbf')")
+    for (zoom, column, row), tile_layers in sorted(tiles.items()):
+        conn.execute('insert into tiles values (?, ?, ?, ?)',
+                     (zoom, column, row, gzip.compress(mvt.encode_tile(tile_layers), mtime=0)))
+    conn.commit()
+    conn.close()
+    return target
+
+
+def typed_attributes_by_id(layers):
+    found = {}
+    for layer in layers:
+        for feature in layer['features']:
+            tags = feature['tags']
+            attributes = {}
+            for i in range(0, len(tags) - 1, 2):
+                attributes[layer['keys'][tags[i]]] = (layer['values'][tags[i + 1]], layer['value_fields'][tags[i + 1]])
+            found[attributes['id'][0]] = attributes
+    return found
+
+
+def line(i, coordinates):
+    return {'type': 'Feature', 'properties': {'id': i, 'name': 'line-%d' % i},
+            'geometry': {'type': 'LineString', 'coordinates': coordinates}}
+
+
+TESTS = []
+
+
+def test(fn):
+    TESTS.append(fn)
+    return fn
+
+
+@test
+def maximum_tile_bytes_option_is_accepted():
+    source = build_tileset('small', dense_points(200))
+    out, code, err = join('small_joined', [source], ['-M', '2000000'])
+    assert code == 0, err[-400:]
+    assert len(tiles(out)) == 1
+
+
+@test
+def maximum_tile_bytes_long_form_sets_the_limit():
+    source = build_tileset('midsize_long', dense_points(20000))
+    out, code, err = join('midsize_long_reduced', [source], ['--maximum-tile-bytes=40000', '--drop-smallest-as-needed'])
+    assert code == 0, err[-400:]
+    assert feature_count(out) < 20000
+    assert len(only_tile(out)) <= 40000
+
+
+@test
+def oversized_tile_is_skipped_without_the_option():
+    source = oversized_source()
+    out, code, _ = join('skipped', [source])
+    assert code == 0
+    assert len(tiles(out)) == 0
+    assert meta_json(out)['tilestats']['layerCount'] == 0
+    assert strategies(out) is None
+
+
+@test
+def oversized_tile_is_reduced_instead_of_skipped():
+    source = oversized_source()
+    out, code, err = join('reduced', [source], ['--drop-smallest-as-needed'])
+    assert code == 0, err[-400:]
+    assert len(tiles(out)) == 1
+
+
+@test
+def reduced_tile_is_within_the_limit():
+    source = oversized_source()
+    out, _, _ = join('reduced2', [source], ['--drop-smallest-as-needed'])
+    assert len(only_tile(out)) <= 500000
+
+
+@test
+def raised_limit_keeps_every_feature():
+    source = oversized_source()
+    out, _, _ = join('raised', [source], ['-M', '2000000', '--drop-smallest-as-needed'])
+    assert feature_count(out) == 90000
+
+
+@test
+def lowered_limit_reduces_a_tile_that_otherwise_fits():
+    source = build_tileset('midsize', dense_points(20000))
+    whole, _, _ = join('midsize_whole', [source], ['-M', '2000000'])
+    reduced, _, _ = join('midsize_reduced', [source], ['-M', '40000', '--drop-smallest-as-needed'])
+    assert feature_count(whole) == 20000
+    assert feature_count(reduced) < 20000
+    assert len(only_tile(reduced)) <= 40000
+
