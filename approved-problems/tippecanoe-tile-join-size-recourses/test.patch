+        written[zoom] = written.get(zoom, 0) + 1
+    assert written == {0: 1, 1: 4, 2: 16}, written
+    recorded = strategies(out) or []
+    assert len(recorded) == 3, recorded
+    assert [recorded[z].get('dropped_as_needed', 0) for z in (0, 1, 2)] == [before[z] - after[z] for z in (0, 1, 2)], recorded
+    assert [recorded[z].get('tile_size_desired', 0) for z in (0, 1, 2)] == [largest[z] for z in (0, 1, 2)], recorded
