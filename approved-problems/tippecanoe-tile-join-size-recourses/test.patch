+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+cd "$(dirname "$0")"
+
+# allow-existing-test's golden output only matches when tippecanoe runs with 8 or fewer threads;
+# pin the count so the base suite gives the same result on any host.
+export TIPPECANOE_MAX_THREADS=8
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+make -j"$(nproc 2>/dev/null || echo 2)" >/tmp/tilejoin_build.log 2>&1
+BUILD_STATUS=$?
+
+if [ $BUILD_STATUS -ne 0 ]; then
+  if [ -n "$OUTPUT_PATH" ]; then
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+      printf '<testsuites><testsuite name="build" tests="1" failures="1" errors="0" time="0">\n'
+      printf '<testcase name="make" classname="build" time="0"><failure message="build failed"><![CDATA[\n'
+      tail -c 60000 /tmp/tilejoin_build.log
+      printf ']]></failure></testcase>\n</testsuite></testsuites>\n'
+    } > "$OUTPUT_PATH"
+  fi
+  tail -40 /tmp/tilejoin_build.log
+  exit 1
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  python3 -B tests/tile_join_limit_0dae2a/run_tests.py "$MODE" --output_path "$OUTPUT_PATH"
+else
+  python3 -B tests/tile_join_limit_0dae2a/run_tests.py "$MODE"
+fi
diff --git a/tests/tile_join_limit_0dae2a/mvt.py b/tests/tile_join_limit_0dae2a/mvt.py
