+def junit(results, output_path, suite):
+    suites = ET.Element('testsuites')
+    element = ET.SubElement(suites, 'testsuite', name=suite,
+                            tests=str(len(results)),
+                            failures=str(sum(1 for r in results if r[1] is not None)),
+                            errors='0', time='%.3f' % sum(r[2] for r in results))
+    for name, failure, seconds, output in results:
+        case = ET.SubElement(element, 'testcase', name=name, classname=suite, time='%.3f' % seconds)
+        if failure is not None:
+            node = ET.SubElement(case, 'failure', message=failure[:200])
+            node.text = output
+    directory = os.path.dirname(output_path)
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    ET.ElementTree(suites).write(output_path, encoding='utf-8', xml_declaration=True)
+
+
+def run_new():
+    global WORK
+    results = []
+    for fn in TESTS:
+        WORK = tempfile.mkdtemp(prefix='tjlimit-')
+        started = time.time()
+        try:
+            fn()
+            results.append((fn.__name__, None, time.time() - started, ''))
+        except BaseException as exc:
+            results.append((fn.__name__, '%s: %s' % (type(exc).__name__, exc),
+                            time.time() - started, traceback.format_exc()))
+        finally:
+            shutil.rmtree(WORK, ignore_errors=True)
+    return results
+
+
+def golden_checks():
+    out = []
+    for directory in sorted(os.listdir(os.path.join(ROOT, 'tests'))):
+        outdir = os.path.join(ROOT, 'tests', directory, 'out')
+        if os.path.isdir(outdir):
+            for name in sorted(os.listdir(outdir)):
+                if name.endswith('.json'):
+                    out.append('tests/%s/out/%s.check' % (directory, name))
+    return out
+
+
+def run_base():
+    results = []
+    jobs = '-j%d' % (os.cpu_count() or 2)
+    for target in BASE_TARGETS:
+        started = time.time()
+        code, out, err = run(['make', jobs, target])
+        results.append(('make_%s' % target.replace('-', '_'),
+                        None if code == 0 else 'exit %d' % code,
+                        time.time() - started, out[-4000:] + err[-4000:]))
+
+    unit_xml = os.path.join(tempfile.mkdtemp(prefix='tjunit-'), 'unit.xml')
+    started = time.time()
+    code, out, err = run([os.path.join(ROOT, 'unit'), '-r', 'junit', '-o', unit_xml])
+    parsed = False
+    unit_results = []
+    if os.path.exists(unit_xml):
+        try:
+            tree = ET.parse(unit_xml)
+            for case in tree.iter('testcase'):
+                problems = case.findall('failure') + case.findall('error')
+                unit_results.append(('unit_' + case.get('name', 'case').replace(' ', '_'),
+                                     None if not problems else (problems[0].get('message') or problems[0].tag),
+                                     float(case.get('time', '0') or 0),
+                                     '\n'.join((problem.text or '') for problem in problems)))
+            parsed = True
+        except ET.ParseError:
+            parsed = False
+    results.extend(unit_results)
+    if not parsed or (code != 0 and all(result[1] is None for result in unit_results)):
+        results.append(('unit_suite', None if code == 0 else 'exit %d' % code,
+                        time.time() - started, out[-4000:] + err[-4000:]))
+
+    checks = golden_checks()
+    started = time.time()
+    code, out, err = run(['make', jobs] + checks)
+    results.append(('golden_file_checks', None if code == 0 else 'exit %d' % code,
+                    time.time() - started, out[-6000:] + err[-6000:]))
+    return results
+
+
+def main():
+    mode = 'base'
+    output_path = None
+    args = sys.argv[1:]
+    i = 0
+    while i < len(args):
+        if args[i].startswith('--output_path='):
+            output_path = args[i].split('=', 1)[1]
+        elif args[i] == '--output_path':
+            output_path = args[i + 1]
+            i += 1
+        elif args[i] in ('base', 'new'):
+            mode = args[i]
+        i += 1
+
+    results = run_new() if mode == 'new' else run_base()
+    if output_path:
+        junit(results, output_path, 'tile_join_limit' if mode == 'new' else 'tippecanoe_base')
+    failed = [r for r in results if r[1] is not None]
+    for name, failure, _, _ in results:
+        print('%s %s' % ('FAIL' if failure else 'ok  ', name))
+    print('%d/%d passed' % (len(results) - len(failed), len(results)))
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
