diff --git a/Lib/fontTools/merge/colr.py b/Lib/fontTools/merge/colr.py
new file mode 100644
index 000000000..05b621855
--- /dev/null
+++ b/Lib/fontTools/merge/colr.py
@@ -0,0 +1,387 @@
+# Copyright 2013 Google, Inc. All Rights Reserved.
+#
+# Google Author(s): Behdad Esfahbod, Roozbeh Pournader
+
+from fontTools import ttLib
+from fontTools.ttLib.tables import otTables
+from fontTools.ttLib.tables.C_O_L_R_ import table_C_O_L_R_
+from fontTools.ttLib.tables.C_P_A_L_ import table_C_P_A_L_
+from fontTools.merge.base import add_method
+
+
+NO_NAME_ID = table_C_P_A_L_.NO_NAME_ID
+FOREGROUND_PALETTE_INDEX = 0xFFFF
+
+
+def computePaletteOffsets(merger, fonts):
+    """Stores merger.paletteOffsets: the index, in the merged CPAL entry space,
+    of the first color record each font contributes."""
+    offsets = []
+    total = 0
+    for font in fonts:
+        if "COLR" in font and "CPAL" not in font:
+            raise ValueError(
+                "Cannot merge '%s': it has a COLR table but no CPAL table"
+                % font._merger__name
+            )
+        offsets.append(total)
+        if "CPAL" in font:
+            total += font["CPAL"].numPaletteEntries
+    merger.paletteOffsets = offsets
+
+
+def _sub(colr, name):
+    return getattr(colr, name, None)
+
+
+def _walkPaint(paint, seen):
+    if paint is None or id(paint) in seen:
+        return
+    seen.add(id(paint))
+    yield paint
+    for conv in paint.getConverters():
+        if conv.tableClass is not None and issubclass(conv.tableClass, otTables.Paint):
+            yield from _walkPaint(getattr(paint, conv.name, None), seen)
+
+
+def _iterPaints(colr):
+    seen = set()
+    baseGlyphList = _sub(colr, "BaseGlyphList")
+    if baseGlyphList is not None:
+        for record in baseGlyphList.BaseGlyphPaintRecord:
+            yield from _walkPaint(record.Paint, seen)
+    layerList = _sub(colr, "LayerList")
+    if layerList is not None:
+        for paint in layerList.Paint:
+            yield from _walkPaint(paint, seen)
+
+
+def mapPaletteIndices(colr, func):
+    """Applies func to every CPAL palette index reachable from an OpenType COLR
+    table: the v0 layer records, the solid paints and the gradient color stops."""
+    layerRecordArray = _sub(colr, "LayerRecordArray")
+    if layerRecordArray is not None:
+        for record in layerRecordArray.LayerRecord:
+            record.PaletteIndex = func(record.PaletteIndex)
+    for paint in _iterPaints(colr):
+        if hasattr(paint, "PaletteIndex"):
+            paint.PaletteIndex = func(paint.PaletteIndex)
+        colorLine = getattr(paint, "ColorLine", None)
+        if colorLine is not None:
+            for stop in colorLine.ColorStop:
+                stop.PaletteIndex = func(stop.PaletteIndex)
+
+
+def _shifter(offset):
+    def shift(index):
+        if index == FOREGROUND_PALETTE_INDEX:
+            return index
+        return index + offset
+
+    return shift
+
+
+@add_method(ttLib.getTableClass("CPAL"))
+def merge(self, m, tables):
+    if all(table is NotImplemented for table in tables):
+        return NotImplemented
+
+    present = [table for table in tables if table is not NotImplemented]
+    numPalettes = max(len(table.palettes) for table in present)
+
+    self.version = max(table.version for table in present)
+    self.numPaletteEntries = sum(table.numPaletteEntries for table in present)
+
+    self.palettes = []
+    for i in range(numPalettes):
+        palette = []
+        for table in present:
+            palette.extend(table.palettes[min(i, len(table.palettes) - 1)])
+        self.palettes.append(palette)
+
+    self.paletteTypes = []
+    for i in range(numPalettes):
+        paletteType = table_C_P_A_L_.DEFAULT_PALETTE_TYPE
+        for table in present:
+            if i < len(table.palettes):
+                if table.paletteTypes:
+                    paletteType = table.paletteTypes[i]
+                break
+        self.paletteTypes.append(paletteType)
+
+    firstTable = tables[0]
+    self.paletteLabels = []
+    for i in range(numPalettes):
+        label = NO_NAME_ID
+        if (
+            firstTable is not NotImplemented
+            and i < len(firstTable.palettes)
+            and firstTable.paletteLabels
+        ):
+            label = firstTable.paletteLabels[i]
+        self.paletteLabels.append(label)
+
+    self.paletteEntryLabels = []
+    for i, table in enumerate(tables):
+        if table is NotImplemented:
+            continue
+        if i == 0 and table.paletteEntryLabels:
+            self.paletteEntryLabels.extend(table.paletteEntryLabels)
+        else:
+            self.paletteEntryLabels.extend([NO_NAME_ID] * table.numPaletteEntries)
+
+    return self
+
+
+def _toOTTable(table, font):
+    return table.table if hasattr(table, "table") else table._toOTTable(font)
+
+
+def _rebaseFirstLayerIndex(colr, layerOffset, recordOffset):
+    for paint in _iterPaints(colr):
+        if paint.Format == otTables.PaintFormat.PaintColrLayers:
+            paint.FirstLayerIndex += layerOffset
+    baseGlyphRecordArray = _sub(colr, "BaseGlyphRecordArray")
+    if baseGlyphRecordArray is not None:
+        for record in baseGlyphRecordArray.BaseGlyphRecord:
+            record.FirstLayerIndex += recordOffset
+
+
+@add_method(ttLib.getTableClass("COLR"))
+def merge(self, m, tables):
+    if all(table is NotImplemented for table in tables):
+        return NotImplemented
+
+    colrs = []
+    for i, table in enumerate(tables):
+        if table is NotImplemented:
+            continue
+        colr = _toOTTable(table, m.fonts[i])
+        varStore = _sub(colr, "VarStore")
+        if varStore is not None and getattr(varStore, "VarData", None):
+            raise NotImplementedError(
+                "Merging COLR tables with variation data is not supported yet"
+            )
+        colrs.append((i, colr))
+
+    layerOffset = 0
+    recordOffset = 0
+    for i, colr in colrs:
+        mapPaletteIndices(colr, _shifter(m.paletteOffsets[i]))
+        _rebaseFirstLayerIndex(colr, layerOffset, recordOffset)
+        layerList = _sub(colr, "LayerList")
+        if layerList is not None:
+            layerOffset += len(layerList.Paint)
+        layerRecordArray = _sub(colr, "LayerRecordArray")
+        if layerRecordArray is not None:
+            recordOffset += len(layerRecordArray.LayerRecord)
+
+    glyphIDs = {name: i for i, name in enumerate(m.glyphOrder)}
+
+    merged = otTables.COLR()
+    merged.Version = max(colr.Version for _, colr in colrs)
+
+    baseRecords = []
+    layerRecords = []
+    basePaints = []
+    layerPaints = []
+    clips = {}
+    for _, colr in colrs:
+        baseGlyphRecordArray = _sub(colr, "BaseGlyphRecordArray")
+        if baseGlyphRecordArray is not None:
+            baseRecords.extend(baseGlyphRecordArray.BaseGlyphRecord)
+        layerRecordArray = _sub(colr, "LayerRecordArray")
+        if layerRecordArray is not None:
+            layerRecords.extend(layerRecordArray.LayerRecord)
+        baseGlyphList = _sub(colr, "BaseGlyphList")
+        if baseGlyphList is not None:
+            basePaints.extend(baseGlyphList.BaseGlyphPaintRecord)
+        layerList = _sub(colr, "LayerList")
+        if layerList is not None:
+            layerPaints.extend(layerList.Paint)
+        clipList = _sub(colr, "ClipList")
+        if clipList is not None:
+            clips.update(clipList.clips)
+
+    baseRecords.sort(key=lambda record: glyphIDs[record.BaseGlyph])
+    basePaints.sort(key=lambda record: glyphIDs[record.BaseGlyph])
+
+    merged.BaseGlyphRecordCount = len(baseRecords)
+    merged.LayerRecordCount = len(layerRecords)
+    if baseRecords:
+        merged.BaseGlyphRecordArray = otTables.BaseGlyphRecordArray()
+        merged.BaseGlyphRecordArray.BaseGlyphRecord = baseRecords
+        merged.LayerRecordArray = otTables.LayerRecordArray()
+        merged.LayerRecordArray.LayerRecord = layerRecords
+    else:
+        merged.BaseGlyphRecordArray = None
+        merged.LayerRecordArray = None
+
+    if basePaints:
+        merged.BaseGlyphList = otTables.BaseGlyphList()
+        merged.BaseGlyphList.BaseGlyphCount = len(basePaints)
+        merged.BaseGlyphList.BaseGlyphPaintRecord = basePaints
+    else:
+        merged.BaseGlyphList = None
+
+    if layerPaints:
+        merged.LayerList = otTables.LayerList()
+        merged.LayerList.LayerCount = len(layerPaints)
+        merged.LayerList.Paint = layerPaints
+    else:
+        merged.LayerList = None
+
+    if clips:
+        merged.ClipList = otTables.ClipList()
+        merged.ClipList.Format = 1
+        merged.ClipList.clips = clips
+    else:
+        merged.ClipList = None
+
+    merged.VarIndexMap = None
+    merged.VarStore = None
+
+    self.version = merged.Version
+    self.table = merged
+    return self
+
+
+def _findRun(emitted, run):
+    for start in range(len(emitted) - len(run) + 1):
+        if emitted[start : start + len(run)] == run:
+            return start
+    return None
+
+
+def _paintKey(paint):
+    if paint is None:
+        return None
+    key = [paint.Format]
+    for conv in paint.getConverters():
+        if conv.name == "Format":
+            continue
+        value = getattr(paint, conv.name, None)
+        if conv.tableClass is not None and issubclass(conv.tableClass, otTables.Paint):
+            key.append(_paintKey(value))
+        elif isinstance(value, otTables.ColorLine):
+            key.append(
+                (
+                    value.Extend,
+                    tuple(
+                        (stop.StopOffset, stop.PaletteIndex, stop.Alpha)
+                        for stop in value.ColorStop
+                    ),
+                )
+            )
+        else:
+            key.append(value)
+    return tuple(key)
+
+
+def _reuseLayers(colr):
+    layerList = _sub(colr, "LayerList")
+    if layerList is None:
+        return
+    keys = [_paintKey(paint) for paint in layerList.Paint]
+    emitted = []
+    paints = []
+    for paint in _iterPaints(colr):
+        if paint.Format != otTables.PaintFormat.PaintColrLayers:
+            continue
+        start = paint.FirstLayerIndex
+        stop = start + paint.NumLayers
+        run = keys[start:stop]
+        index = _findRun(emitted, run)
+        if index is None:
+            index = len(emitted)
+            emitted.extend(run)
+            paints.extend(layerList.Paint[start:stop])
+        paint.FirstLayerIndex = index
+    layerList.Paint = paints
+    layerList.LayerCount = len(paints)
+
+
+def _reuseLayerRecords(colr):
+    layerRecordArray = _sub(colr, "LayerRecordArray")
+    baseGlyphRecordArray = _sub(colr, "BaseGlyphRecordArray")
+    if layerRecordArray is None or baseGlyphRecordArray is None:
+        return
+    keys = [
+        (record.LayerGlyph, record.PaletteIndex)
+        for record in layerRecordArray.LayerRecord
+    ]
+    emitted = []
+    records = []
+    for record in baseGlyphRecordArray.BaseGlyphRecord:
+        start = record.FirstLayerIndex
+        stop = start + record.NumLayers
+        index = _findRun(emitted, keys[start:stop])
+        if index is None:
+            index = len(emitted)
+            emitted.extend(keys[start:stop])
+            records.extend(layerRecordArray.LayerRecord[start:stop])
+        record.FirstLayerIndex = index
+    layerRecordArray.LayerRecord = records
+    colr.LayerRecordCount = len(records)
+
+
+def _usedPaletteIndices(colr):
+    used = set()
+
+    def collect(index):
+        used.add(index)
+        return index
+
+    mapPaletteIndices(colr, collect)
+    used.discard(FOREGROUND_PALETTE_INDEX)
+    return used
+
+
+def _canonicalizePalettes(cpal, colr):
+    used = _usedPaletteIndices(colr.table) if colr is not None else None
+
+    keep = {}
+    entries = {}
+    survivors = []
+    for index in range(cpal.numPaletteEntries):
+        if used is not None and index not in used:
+            continue
+        key = tuple(palette[index] for palette in cpal.palettes)
+        if key not in entries:
+            entries[key] = len(survivors)
+            survivors.append(index)
+        keep[index] = entries[key]
+
+    if len(survivors) == cpal.numPaletteEntries:
+        return
+
+    cpal.palettes = [[palette[i] for i in survivors] for palette in cpal.palettes]
+    if cpal.paletteEntryLabels:
+        cpal.paletteEntryLabels = [cpal.paletteEntryLabels[i] for i in survivors]
+    cpal.numPaletteEntries = len(survivors)
+
+    if colr is not None:
+        mapPaletteIndices(
+            colr.table,
+            lambda index: (
+                index if index == FOREGROUND_PALETTE_INDEX else keep[index]
+            ),
+        )
+
+
+def colorPostMerge(font):
+    """Canonicalizes the merged color tables: palette entries that no color
+    glyph references are dropped, interchangeable ones are collapsed, and the
+    layer runs that survive are shared."""
+    colr = font.get("COLR")
+    cpal = font.get("CPAL")
+
+    if cpal is not None:
+        _canonicalizePalettes(cpal, colr)
+
+    if colr is not None:
+        _reuseLayers(colr.table)
+        _reuseLayerRecords(colr.table)
+        if colr.version == 0:
+            colr.ColorLayers = table_C_O_L_R_._decompileColorLayersV0(colr.table)
+            del colr.table
