@@ -0,0 +1,55 @@
+# Copyright 2013 Google, Inc. All Rights Reserved.
+#
+# Google Author(s): Behdad Esfahbod, Roozbeh Pournader
+
+from fontTools import ttLib
+from fontTools.ttLib.tables.S_V_G_ import SVGDocument
+from fontTools.merge.base import add_method
+from dataclasses import replace
+import re
+
+
+_glyphReference = re.compile(r'((?:id|(?:xlink:)?href)\s*=\s*"#?)glyph(\d+)(")')
+
+
+def remapSVGDocument(data, offset):
+    """Rewrites the glyph IDs an SVG document names, both the id attributes that
+    identify its glyph elements and the href attributes that cross-reference
+    them, by offset. All of them are shifted in a single pass."""
+    if not offset:
+        return data
+
+    def shift(match):
+        return "%sglyph%d%s" % (
+            match.group(1),
+            int(match.group(2)) + offset,
+            match.group(3),
+        )
+
+    return _glyphReference.sub(shift, data)
+
+
+@add_method(ttLib.getTableClass("SVG "))
+def merge(self, m, tables):
+    if all(table is NotImplemented for table in tables):
+        return NotImplemented
+
+    docList = []
+    for i, table in enumerate(tables):
+        if table is NotImplemented:
+            continue
+        offset = m.glyphIDOffsets[i]
+        for doc in table.docList:
+            docList.append(
+                replace(
+                    doc,
+                    data=remapSVGDocument(doc.data, offset),
+                    startGlyphID=doc.startGlyphID + offset,
+                    endGlyphID=doc.endGlyphID + offset,
+                )
+            )
+    docList.sort(key=lambda doc: doc.startGlyphID)
+
+    self.version = 0
+    self.docList = docList
+    return self
