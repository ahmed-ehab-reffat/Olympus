+# Copyright 2013 Google, Inc. All Rights Reserved.
+#
+# Google Author(s): Behdad Esfahbod, Roozbeh Pournader
+
+from fontTools import ttLib
+from fontTools.ttLib.tables.E_B_L_C_ import Strike
+from fontTools.merge.base import add_method
+from fontTools.merge.util import *
+
+
+def _strikeKey(strike):
+    table = strike.bitmapSizeTable
+    return (table.ppemX, table.ppemY, table.bitDepth)
+
+
+def computeBitmapStrikes(merger, fonts):
+    """Stores merger.bitmapStrikes: the ordered keys of the merged CBLC strikes,
+    and merger.bitmapStrikeIndices: for each font, a map from that key to the
+    index of the matching strike in the font. CBDT holds one bitmap dictionary
+    per strike but records no size of its own, so both tables have to agree on
+    this order."""
+    keys = {}
+    indices = []
+    for font in fonts:
+        index = {}
+        indices.append(index)
+        if "CBLC" not in font:
+            continue
+        for i, strike in enumerate(font["CBLC"].strikes):
+            key = _strikeKey(strike)
+            index[key] = i
+            keys[key] = None
+    merger.bitmapStrikes = sorted(keys)
+    merger.bitmapStrikeIndices = indices
+
+
+def _mergeLineMetrics(merged, other):
+    merged.ascender = max(merged.ascender, other.ascender)
+    merged.descender = min(merged.descender, other.descender)
+    merged.widthMax = max(merged.widthMax, other.widthMax)
+    merged.minOriginSB = min(merged.minOriginSB, other.minOriginSB)
+    merged.minAdvanceSB = min(merged.minAdvanceSB, other.minAdvanceSB)
+    merged.maxBeforeBL = max(merged.maxBeforeBL, other.maxBeforeBL)
+    merged.minAfterBL = min(merged.minAfterBL, other.minAfterBL)
+
+
+@add_method(ttLib.getTableClass("CBLC"))
+def merge(self, m, tables):
+    if all(table is NotImplemented for table in tables):
+        return NotImplemented
+
+    self.version = max(
+        table.version for table in tables if table is not NotImplemented
+    )
+    self.strikes = []
+    for key in m.bitmapStrikes:
+        merged = None
+        for i, table in enumerate(tables):
+            index = m.bitmapStrikeIndices[i].get(key)
+            if index is None:
+                continue
+            strike = table.strikes[index]
+            if merged is None:
+                merged = Strike()
+                merged.bitmapSizeTable = strike.bitmapSizeTable
+                merged.indexSubTables = list(strike.indexSubTables)
+            else:
+                merged.indexSubTables.extend(strike.indexSubTables)
+                sizeTable = merged.bitmapSizeTable
+                sizeTable.flags |= strike.bitmapSizeTable.flags
+                _mergeLineMetrics(sizeTable.hori, strike.bitmapSizeTable.hori)
+                _mergeLineMetrics(sizeTable.vert, strike.bitmapSizeTable.vert)
+        self.strikes.append(merged)
+
+    return self
+
+
+@add_method(ttLib.getTableClass("CBDT"))
+def merge(self, m, tables):
+    if all(table is NotImplemented for table in tables):
+        return NotImplemented
+
+    self.version = max(
+        table.version for table in tables if table is not NotImplemented
+    )
+    self.strikeData = []
+    for key in m.bitmapStrikes:
+        glyphs = {}
+        for i, table in enumerate(tables):
+            index = m.bitmapStrikeIndices[i].get(key)
+            if index is None:
+                continue
+            glyphs.update(table.strikeData[index])
+        self.strikeData.append(glyphs)
+
+    return self
+
+
+@add_method(ttLib.getTableClass("sbix"))
+def merge(self, m, tables):
+    if all(table is NotImplemented for table in tables):
+        return NotImplemented
+
+    present = [table for table in tables if table is not NotImplemented]
+    self.version = max(table.version for table in present)
+    self.flags = bitwise_or(table.flags for table in present)
+
+    self.strikes = {}
+    for table in present:
+        for ppem, strike in sorted(table.strikes.items()):
+            merged = self.strikes.get(ppem)
+            if merged is None:
+                self.strikes[ppem] = strike
+            elif merged.resolution != strike.resolution:
+                raise ValueError(
+                    "Cannot merge sbix strikes at %i ppem: they disagree on "
+                    "resolution (%i and %i)"
+                    % (ppem, merged.resolution, strike.resolution)
+                )
+            else:
+                merged.glyphs.update(strike.glyphs)
+
+    return self
