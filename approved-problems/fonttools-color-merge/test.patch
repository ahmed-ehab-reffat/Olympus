+def leafGlyphsOf(colr, baseGlyph):
+    record = [
+        r
+        for r in colr.BaseGlyphList.BaseGlyphPaintRecord
+        if r.BaseGlyph == baseGlyph
+    ][0]
+    names = []
+
+    def collect(paint):
+        if paint.Format == otTables.PaintFormat.PaintGlyph:
+            names.append(paint.Glyph)
+
+    record.Paint.traverse(colr, collect)
+    return names
+
