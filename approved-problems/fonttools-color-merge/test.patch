+def sbixFont(glyphs, ppem, resolution=72):
+    font = buildTestFont(glyphs)
+    sbix = newTable("sbix")
+    sbix.version = 1
+    sbix.flags = 1
+    sbix.strikes = {}
+    from fontTools.ttLib.tables.sbixStrike import Strike
+    from fontTools.ttLib.tables.sbixGlyph import Glyph
+
+    strike = Strike(ppem=ppem, resolution=resolution)
+    for name in glyphs:
+        strike.glyphs[name] = Glyph(
+            glyphName=name, graphicType="png ", imageData=b"\x89PNG" + name.encode()
+        )
+    sbix.strikes[ppem] = strike
+    font["sbix"] = sbix
+    return font
+
+
+def test_sbix_strikes_of_the_same_size_are_merged(tmp_path):
+    merged = mergeFonts([sbixFont(["A"], 20), sbixFont(["B"], 20)], tmp_path)
+    sbix = merged["sbix"]
+    assert sorted(sbix.strikes) == [20]
+    glyphs = sbix.strikes[20].glyphs
+    assert glyphs["A"].imageData == b"\x89PNGA"
+    assert glyphs["B"].imageData == b"\x89PNGB"
+
+
+def test_sbix_strikes_of_different_sizes_are_kept(tmp_path):
+    merged = mergeFonts([sbixFont(["A"], 20), sbixFont(["B"], 40)], tmp_path)
+    assert sorted(merged["sbix"].strikes) == [20, 40]
+
+
+def test_sbix_strikes_of_several_sizes_are_ordered_by_ppem(tmp_path):
+    first = sbixFont(["A"], 40)
+    firstExtra = sbixFont(["A"], 20)
+    first["sbix"].strikes.update(firstExtra["sbix"].strikes)
+    second = sbixFont(["B"], 40)
+    secondExtra = sbixFont(["B"], 30)
+    second["sbix"].strikes.update(secondExtra["sbix"].strikes)
+    merged = mergeFonts([first, second], tmp_path)
+    sbix = merged["sbix"]
+    assert sorted(sbix.strikes) == [20, 30, 40]
+    assert sbix.strikes[40].glyphs["A"].imageData == b"\x89PNGA"
+    assert sbix.strikes[40].glyphs["B"].imageData == b"\x89PNGB"
+
+
+def test_sbix_resolution_conflict_is_rejected(tmp_path):
+    fonts = [sbixFont(["A"], 20, resolution=72), sbixFont(["B"], 20, resolution=144)]
+    paths = savedPaths(fonts, tmp_path)
+    with pytest.raises(ValueError):
+        mergePaths(paths, tmp_path)
