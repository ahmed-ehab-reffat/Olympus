+def test_cblc_line_metrics_widen_across_every_metric(tmp_path):
+    paths = [fontFromTTX("google_color.ttx", tmp_path, i) for i in range(2)]
+    base = TTFont(paths[0])["CBLC"].strikes[0].bitmapSizeTable
+    second = TTFont(paths[1])
+    size = second["CBLC"].strikes[0].bitmapSizeTable
+    size.hori.descender = base.hori.descender - 1
+    size.hori.widthMax = base.hori.widthMax + 1
+    size.vert.ascender = base.vert.ascender + 1
+    expected = (size.hori.descender, size.hori.widthMax, size.vert.ascender)
+    second.save(paths[1])
+    merged = mergePaths(paths, tmp_path)
+    mergedSize = merged["CBLC"].strikes[0].bitmapSizeTable
+    actual = (
+        mergedSize.hori.descender,
+        mergedSize.hori.widthMax,
+        mergedSize.vert.ascender,
+    )
+    assert actual == expected
