+DATA = os.path.join(os.path.dirname(__file__), "..", "subset", "data")
+
+
+def solid(paletteIndex, alpha=1.0):
+    return {"Format": 2, "PaletteIndex": paletteIndex, "Alpha": alpha}
+
+
+def glyphPaint(glyphName, paint):
+    return {"Format": 10, "Glyph": glyphName, "Paint": paint}
+
+
+def colrLayers(layers):
+    return {"Format": 1, "Layers": layers}
+
+
+def gradient(paletteIndices):
+    return {
+        "Format": 4,
+        "ColorLine": {
+            "ColorStop": [
+                {"StopOffset": i / 2.0, "PaletteIndex": p, "Alpha": 1.0}
+                for i, p in enumerate(paletteIndices)
+            ],
+            "Extend": "pad",
+        },
+        "x0": 0,
+        "y0": 0,
+        "x1": 100,
+        "y1": 0,
+        "x2": 0,
+        "y2": 100,
+    }
+
+
+def buildTestFont(
+    glyphs,
+    palettes=None,
+    colorGlyphs=None,
+    colrVersion=None,
+    clipBoxes=None,
+    svgDocs=None,
+    paletteTypes=None,
+    paletteLabels=None,
+    paletteEntryLabels=None,
+    cpalVersion=None,
+):
+    order = [".notdef"] + list(glyphs)
+    fb = FontBuilder(unitsPerEm=1000, isTTF=True)
+    fb.setupGlyphOrder(order)
+    fb.setupCharacterMap({0xE000 + i: name for i, name in enumerate(glyphs)})
+    outlines = {}
+    for i, name in enumerate(order):
+        pen = TTGlyphPen(None)
+        if name != ".notdef":
+            pen.moveTo((0, 0))
+            pen.lineTo((100 * (i + 1), 0))
+            pen.lineTo((100 * (i + 1), 100))
+            pen.closePath()
+        outlines[name] = pen.glyph()
+    fb.setupGlyf(outlines)
+    fb.setupHorizontalMetrics({name: (600, 50) for name in order})
+    fb.setupHorizontalHeader(ascent=800, descent=-200)
+    fb.setupNameTable({"familyName": "Test", "styleName": "Regular"})
+    fb.setupOS2()
+    fb.setupPost()
+    font = fb.font
+    if palettes is not None:
+        kwargs = {}
+        if paletteLabels is not None or paletteEntryLabels is not None:
+            kwargs["nameTable"] = font["name"]
+        cpal = buildCPAL(
+            palettes,
+            paletteTypes=paletteTypes,
+            paletteLabels=paletteLabels,
+            paletteEntryLabels=paletteEntryLabels,
+            **kwargs,
+        )
+        if cpalVersion is not None:
+            cpal.version = cpalVersion
+        font["CPAL"] = cpal
+    if colorGlyphs is not None:
+        font["COLR"] = buildCOLR(
+            colorGlyphs,
+            version=colrVersion,
+            glyphMap=font.getReverseGlyphMap(),
+            clipBoxes=clipBoxes,
+        )
+    if svgDocs is not None:
+        svg = newTable("SVG ")
+        svg.docList = svgDocs
+        svg.version = 0
+        font["SVG "] = svg
+    return font
+
+
+def fontFromTTX(name, tmp_path, index):
+    font = TTFont(recalcBBoxes=False, recalcTimestamp=False)
+    font.importXML(os.path.join(DATA, name))
+    path = str(tmp_path / ("ttx%d.ttf" % index))
+    font.save(path)
+    return path
+
+
+def savedPaths(fonts, tmp_path):
+    paths = []
+    for i, font in enumerate(fonts):
+        path = str(tmp_path / ("in%d.ttf" % i))
+        font.save(path)
+        paths.append(path)
+    return paths
+
+
+def mergePaths(paths, tmp_path):
+    merged = Merger().merge(paths)
+    out = str(tmp_path / "merged.ttf")
+    merged.save(out)
+    return TTFont(out)
+
+
+def mergeFonts(fonts, tmp_path):
+    return mergePaths(savedPaths(fonts, tmp_path), tmp_path)
+
+
+RED = (1, 0, 0, 1)
+GREEN = (0, 1, 0, 1)
+BLUE = (0, 0, 1, 1)
+BLACK = (0, 0, 0, 1)
+WHITE = (1, 1, 1, 1)
+
+RED_HEX = "#FF0000FF"
+GREEN_HEX = "#00FF00FF"
+BLUE_HEX = "#0000FFFF"
+
+
+def paletteColors(cpal, index):
+    return [color.hex() for color in cpal.palettes[index]]
+
+
+def twoV0ColorFonts():
+    first = buildTestFont(
+        ["A", "B"],
+        palettes=[[RED, GREEN]],
+        colorGlyphs={"A": [("B", 0), ("B", 1), ("B", 0xFFFF)]},
+        colrVersion=0,
+    )
+    second = buildTestFont(
+        ["C", "D"],
+        palettes=[[BLUE, WHITE, BLACK]],
+        colorGlyphs={"C": [("D", 0), ("D", 1), ("D", 2), ("D", 0xFFFF)]},
+        colrVersion=0,
+    )
+    return [first, second]
+
+
+def layersOf(font, glyphName):
+    return [(layer.name, layer.colorID) for layer in font["COLR"].ColorLayers[glyphName]]
