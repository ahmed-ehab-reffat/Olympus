+from collections import UserDict
+
+import numpy as np
+import pytest
+
+import skrf as rf
+from skrf.circuit import Circuit
+
+
+def fgrid(fmax_ghz=100.0, npoints=201):
+    return rf.Frequency(0, fmax_ghz, npoints, unit='GHz')
+
+
+def delay_line(fr, tau, z0=50.0, name=None):
+    e = np.exp(-1j * 2 * np.pi * fr.f * tau)
+    s = np.zeros((len(fr), 2, 2), dtype=complex)
+    s[:, 0, 1] = e
+    s[:, 1, 0] = e
+    return rf.Network(frequency=fr, s=s, z0=z0, name=name)
+
+
+def series_z(fr, z, z0=50.0, name=None):
+    z = np.broadcast_to(np.asarray(z, dtype=complex), (len(fr),))
+    d = z + 2 * z0
+    s = np.zeros((len(fr), 2, 2), dtype=complex)
+    s[:, 0, 0] = z / d
+    s[:, 1, 1] = z / d
+    s[:, 0, 1] = 2 * z0 / d
+    s[:, 1, 0] = 2 * z0 / d
+    return rf.Network(frequency=fr, s=s, z0=z0, name=name)
+
+
+def shunt_z(fr, z, z0=50.0, name=None):
+    y = z0 / np.broadcast_to(np.asarray(z, dtype=complex), (len(fr),))
+    d = 2 + y
+    s = np.zeros((len(fr), 2, 2), dtype=complex)
+    s[:, 0, 0] = -y / d
+    s[:, 1, 1] = -y / d
+    s[:, 0, 1] = 2 / d
+    s[:, 1, 0] = 2 / d
+    return rf.Network(frequency=fr, s=s, z0=z0, name=name)
+
+
+def attenuator(fr, db, z0=50.0, name=None):
+    g = 10 ** (-abs(db) / 20.0)
+    s = np.zeros((len(fr), 2, 2), dtype=complex)
+    s[:, 0, 1] = g
+    s[:, 1, 0] = g
+    return rf.Network(frequency=fr, s=s, z0=z0, name=name)
+
+
+def thru(fr, z0=50.0, name=None):
+    return attenuator(fr, 0.0, z0=z0, name=name)
+
+
+def one_port(fr, gamma, z0=50.0, name=None):
+    s = np.zeros((len(fr), 1, 1), dtype=complex)
+    s[:, 0, 0] = np.broadcast_to(np.asarray(gamma, dtype=complex), (len(fr),))
+    return rf.Network(frequency=fr, s=s, z0=z0, name=name)
+
+
+def splitter(fr, z0=50.0, name=None):
+    s = np.zeros((len(fr), 3, 3), dtype=complex)
+    base = (np.ones((3, 3)) * 2 / 3) - np.eye(3)
+    s[:] = base
+    return rf.Network(frequency=fr, s=s, z0=z0, name=name)
+
+
+def step_on(ntwk, port=0, **kw):
+    return ntwk.transient({port: rf.StepSource(1.0)}, **kw)
+
+
+def test_time_grid_step_is_half_of_the_inverse_of_the_highest_frequency():
+    fr = fgrid()
+    res = step_on(thru(fr))
+    assert res.dt == pytest.approx(1.0 / (2 * fr.f[-1]))
+
+
+def test_time_grid_starts_at_zero():
+    res = step_on(thru(fgrid()))
+    assert res.t[0] == 0.0
+
+
+def test_time_grid_length_is_twice_the_number_of_frequency_intervals():
+    fr = fgrid(npoints=51)
+    res = step_on(thru(fr))
+    assert res.t.size == 2 * (len(fr) - 1)
+
+
+def test_record_length_is_the_inverse_of_the_frequency_step():
+    fr = fgrid(npoints=51)
+    res = step_on(thru(fr))
+    assert res.t[-1] + res.dt == pytest.approx(1.0 / fr.step)
+
+
+def test_time_grid_is_uniform():
+    res = step_on(thru(fgrid(npoints=51)))
+    assert np.allclose(np.diff(res.t), res.dt)
+
+
+def test_matched_thru_splits_the_source_in_half():
+    res = step_on(thru(fgrid()))
+    assert res.settled_value(1) == pytest.approx(0.5)
+
+
+def test_matched_thru_leaves_no_reflection():
+    res = step_on(thru(fgrid()))
+    assert np.allclose(res.b[:, 0], 0.0, atol=1e-12)
+
+
+def test_attenuator_scales_the_transmitted_step():
+    res = step_on(attenuator(fgrid(), 6.0))
+    assert res.settled_value(1) == pytest.approx(0.5 * 10 ** (-6 / 20.0))
+
+
+def test_series_resistor_forms_a_voltage_divider():
+    res = step_on(series_z(fgrid(), 50.0))
+    assert res.settled_value(1) == pytest.approx(50.0 / 150.0)
+
+
