+    res = step_on(shunt_z(fgrid(), 50.0))
+    assert res.settled_value(1) == pytest.approx(1.0 / 3.0)
+
+
+def test_delay_line_transmits_the_step_at_the_line_delay():
+    fr = fgrid()
+    tau = 200e-12
+    res = step_on(delay_line(fr, tau))
+    n = int(round(tau / res.dt))
+    assert res.v[n - 1, 1] == pytest.approx(0.0, abs=1e-12)
+    assert res.v[n, 1] == pytest.approx(0.5)
+
+
+def test_delay_line_output_is_quiet_before_the_delay():
