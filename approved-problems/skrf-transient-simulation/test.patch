+    s[:, 0, 0] = -np.exp(-1j * 2 * np.pi * fr.f * 2 * tau)
+    res = step_on(rf.Network(frequency=fr, s=s, z0=50))
+    n = int(round(2 * tau / res.dt))
+    assert res.v[n - 1, 0] == pytest.approx(0.5)
+    assert res.v[n, 0] == pytest.approx(0.0, abs=1e-12)
+
+
+def test_open_ended_line_doubles_after_two_delays():
+    fr = fgrid()
