+    assert np.allclose(res.v[:n, 1], 0.0, atol=1e-12)
+
+
+def test_delay_line_input_port_sees_only_the_forward_step():
+    res = step_on(delay_line(fgrid(), 200e-12))
+    assert np.allclose(res.v[:, 0], 0.5, atol=1e-12)
+
+
+def test_shorted_line_reflects_after_two_delays():
+    fr = fgrid()
+    tau = 200e-12
