+        thru(fgrid()).transient({0: rf.StepSource(1.0)}, z_source=float('-inf'))
+
+
+def test_an_infinite_load_impedance_is_rejected():
+    with pytest.raises(ValueError):
+        thru(fgrid()).transient({0: rf.StepSource(1.0)}, z_load=float('inf'))
+
+
+def test_an_infinite_port_reference_impedance_is_rejected():
+    fr = fgrid(npoints=21)
+    ntwk = thru(fr)
+    ntwk.z0 = np.full((len(fr), 2), np.inf)
+    with pytest.raises(ValueError):
+        step_on(ntwk)
+
+
+def interleaved_circuit(fr):
+    element = series_z(fr, 50.0, name='r1')
+    first = Circuit.Port(fr, 'pB', z0=100)
+    second = Circuit.Port(fr, 'pA', z0=50)
+    return Circuit([[(first, 0), (element, 1)], [(second, 0), (element, 0)]])
+
+
+def test_circuit_sources_follow_the_port_index_order():
+    fr = fgrid()
+    cir = interleaved_circuit(fr)
+    driven_first = cir.transient({0: rf.StepSource(1.0)})
+    assert driven_first.settled_value(0) == pytest.approx(100.0 / 200.0)
+    assert driven_first.settled_value(1) == pytest.approx(50.0 / 200.0)
+
+
+def test_circuit_sources_do_not_follow_the_port_name_order():
+    fr = fgrid()
+    cir = interleaved_circuit(fr)
+    driven_second = cir.transient({1: rf.StepSource(1.0)})
+    assert driven_second.settled_value(1) == pytest.approx(150.0 / 200.0)
+    assert driven_second.settled_value(0) == pytest.approx(100.0 / 200.0)
+
+
+def test_a_load_is_renormalized_to_the_port_it_terminates():
+    fr = fgrid()
+    tau = 200e-12
+    matched_at_75 = one_port(fr, 0.0, z0=75.0)
+    res = delay_line(fr, tau).transient(
+        {0: rf.StepSource(1.0)}, loads={1: matched_at_75})
+    n = int(round(2 * tau / res.dt))
+    assert res.v[n - 1, 0] == pytest.approx(0.5)
+    assert res.v[n, 0] == pytest.approx(0.5 * (1 + 0.2))
+
+
+def test_eye_folding_starts_on_the_first_sample_at_or_after_the_delay():
+    fr = fgrid(npoints=201)
+    bit_rate = 20e9
+    res = bits_result(fr, [0, 1] * 8, bit_rate=bit_rate)
+    delay = res.t[12] + 0.37 * res.dt
+    eye = res.eye(1, bit_rate=bit_rate, delay=delay)
+    first = int(np.searchsorted(res.t, delay))
+    assert first == 13
+    assert eye.traces[0, 0] == pytest.approx(res.v[first, 1])
+
+
+def test_a_parameterised_window_is_accepted():
+    fr = fgrid()
+    line = delay_line(fr, 200e-12)
+    plain = step_on(line)
+    shaped = line.transient({0: rf.StepSource(1.0)}, window=('kaiser', 6))
+    assert not np.allclose(shaped.v[:, 1], plain.v[:, 1])
+
+
+def test_a_parameterised_circuit_window_is_accepted():
+    fr = fgrid()
+    port1 = Circuit.Port(fr, 'p1', z0=50)
+    port2 = Circuit.Port(fr, 'p2', z0=50)
+    line = delay_line(fr, 200e-12, name='line')
+    cnx = [[(port1, 0), (line, 0)], [(line, 1), (port2, 0)]]
+    plain = Circuit(cnx).transient({0: rf.StepSource(1.0)})
+    shaped = Circuit(cnx).transient({0: rf.StepSource(1.0)}, window=('kaiser', 6))
+    assert not np.allclose(shaped.v[:, 1], plain.v[:, 1])
