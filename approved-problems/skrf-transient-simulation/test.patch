+def test_threshold_time_returns_the_first_of_several_crossings():
+    fr = fgrid()
+    tau = 100e-12
+    s = np.zeros((len(fr), 1, 1), dtype=complex)
+    s[:, 0, 0] = (np.exp(-1j * 2 * np.pi * fr.f * 2 * tau)
+                  - 0.5 * np.exp(-1j * 2 * np.pi * fr.f * 4 * tau))
+    res = step_on(rf.Network(frequency=fr, s=s, z0=50))
+    first = int(round(2 * tau / res.dt))
+    assert res.v[first, 0] == pytest.approx(1.0)
+    assert res.settled_value(0) == pytest.approx(0.75)
+    lo, hi = res.v[first - 1, 0], res.v[first, 0]
+    assert res.threshold_time(0, 0.9) == pytest.approx(
+        res.t[first - 1] + (0.9 - lo) / (hi - lo) * res.dt)
