+                "/XObject << /Child 9 0 R >>",
+                "0 1 0 rg 30 30 20 20 re f /Child Do",
+            ),
+            &hidden_child("1 0 0 rg 5 35 20 20 re f"),
+        ],
+    );
+    let shown = render(data.clone());
+    let twice = vec![shown[0].clone(), shown[0].clone()];
+    let pdf = Pdf::new(data).unwrap();
+
+    assert_renders_as(
+        hayro_write::extract_pages_to_pdf(&pdf, &[0, 0]),
+        &twice,
+        "extracted pages",
+    );
+    assert_renders_as(
+        hayro_write::extract_pages_as_xobject_to_pdf(&pdf, &[0, 0]),
+        &twice,
+        "extracted XObjects",
+    );
+}
+
+#[test]
+fn tiling_pattern_prefers_its_own_xobject_over_the_callers() {
+    assert_extracts_as_shown(layered_page(
+        CATALOG,
+        "/Pattern << /P1 7 0 R >> /XObject << /Child 8 0 R >>",
+        "/OC /off BDC 1 0 0 rg 40 40 10 10 re f EMC /Pattern cs /P1 scn 0 0 60 60 re f",
+        &[
+            &tiling_pattern("/XObject << /Child 9 0 R >>", "/Child Do"),
+            &hidden_child("1 0 0 rg 5 5 20 20 re f"),
+            &stream(
+                "/Type /XObject /Subtype /Form /BBox [0 0 60 60]",
+                "0 0 1 rg 5 5 20 20 re f",
+            ),
+        ],
+    ));
+}
+
+#[test]
+fn alternating_groups_sixty_four_levels_deep() {
+    let mut content = String::new();
+    for depth in 0..64 {
+        let group = if depth % 2 == 0 { "on" } else { "off" };
+        let x = depth % 8 * 7 + 2;
+        let y = depth / 8 * 7 + 2;
+        content.push_str(&format!("/OC /{group} BDC 0 0 1 rg {x} {y} 5 5 re f "));
+    }
+    for depth in (0..64).rev() {
+        let x = depth % 8 * 7 + 3;
+        let y = depth / 8 * 7 + 3;
+        content.push_str(&format!("1 0 0 rg {x} {y} 3 3 re f EMC "));
+    }
+
+    assert_extracts_as_shown(page(&content));
+}
