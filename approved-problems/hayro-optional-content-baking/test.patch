+use crate::interpreter_settings;
+use hayro_syntax::Pdf;
+
+const CATALOG: &str = "<< /Type /Catalog /Pages 2 0 R /OCProperties << /OCGs [5 0 R 6 0 R] /D << /OFF [6 0 R] >> >> >>";
+const OCG_SHOWN: &str = "<< /Type /OCG /Name (Shown) >>";
+const OCG_HIDDEN: &str = "<< /Type /OCG /Name (Hidden) >>";
+const FONT: &str = "/Font << /F1 << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> >>";
+const FLATE_HIDDEN_RED_SHOWN_BLUE: &[u8] = b"\x78\xda\xd3\xf7\x77\x56\xd0\xcf\x50\x70\x72\x71\x56\x30\x54\x30\x00\xc2\xa2\x74\x05\x53\x20\x34\x32\x00\xa1\xa2\x54\x85\x34\x05\x57\x5f\x67\xb0\x8c\x21\x48\xce\xd8\x00\x84\x10\xb2\x00\xbe\xca\x0d\xdd";
+const FLATE_HIDDEN_RED_SHOWN_GREEN: &[u8] = b"\x78\xda\xd3\xf7\x77\x56\xd0\xcf\x50\x70\x72\x71\x56\x30\x54\x30\x00\xc2\xa2\x74\x05\x53\x20\x34\x32\x00\xa1\xa2\x54\x85\x34\x05\x57\x5f\x67\xa0\xb8\x21\x44\xce\xd8\x00\x45\x12\x00\xb1\x78\x0d\xaf";
+
+pub(crate) fn stream(dict: &str, data: &str) -> String {
+    format!(
+        "<< {dict} /Length {} >>\nstream\n{data}\nendstream",
+        data.len()
+    )
+}
+
+fn flate_stream(dict: &str, data: &[u8]) -> Vec<u8> {
+    let mut out = format!(
+        "<< {dict} /Filter /FlateDecode /Length {} >>\nstream\n",
+        data.len()
+    )
+    .into_bytes();
+    out.extend_from_slice(data);
+    out.extend_from_slice(b"\nendstream");
+    out
+}
+
+pub(crate) fn document<T: AsRef<[u8]>>(objects: &[T]) -> Vec<u8> {
+    let mut out = b"%PDF-1.7\n".to_vec();
+    let mut offsets = vec![];
+
+    for (i, object) in objects.iter().enumerate() {
+        offsets.push(out.len());
+        out.extend_from_slice(format!("{} 0 obj\n", i + 1).as_bytes());
+        out.extend_from_slice(object.as_ref());
+        out.extend_from_slice(b"\nendobj\n");
+    }
+
+    let xref = out.len();
+    out.extend_from_slice(
+        format!("xref\n0 {}\n0000000000 65535 f \n", objects.len() + 1).as_bytes(),
+    );
+
+    for offset in offsets {
+        out.extend_from_slice(format!("{offset:010} 00000 n \n").as_bytes());
+    }
+
+    out.extend_from_slice(
+        format!(
+            "trailer\n<< /Size {} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n",
+            objects.len() + 1
+        )
+        .as_bytes(),
+    );
+
+    out
+}
+
+fn layered_page(catalog: &str, resources: &str, content: &str, extra: &[&str]) -> Vec<u8> {
+    let properties = extra
+        .iter()
+        .enumerate()
+        .filter(|(_, object)| object.starts_with("<< /Type /OCMD"))
+        .map(|(i, _)| format!("/m{} {} 0 R", i + 7, i + 7))
+        .collect::<Vec<_>>()
+        .join(" ");
+    let mut objects = vec![
+        catalog.to_string(),
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>".to_string(),
+        format!(
+            "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 60 60] /Contents 4 0 R /Resources << /Properties << /on 5 0 R /off 6 0 R {properties} >> {resources} >> >>"
+        ),
+        stream("", content),
+        OCG_SHOWN.to_string(),
+        OCG_HIDDEN.to_string(),
+    ];
+    objects.extend(extra.iter().map(|o| o.to_string()));
+
+    document(&objects)
+}
+
+fn page(content: &str) -> Vec<u8> {
+    layered_page(CATALOG, FONT, content, &[])
+}
+
+pub(crate) fn render(data: Vec<u8>) -> Vec<Vec<u8>> {
+    let pdf = Pdf::new(data).unwrap();
+
+    hayro::render_pdf(&pdf, 1.0, interpreter_settings(), None)
+        .unwrap()
+        .into_iter()
+        .map(|pixmap| pixmap.data_as_u8_slice().to_vec())
+        .collect()
+}
+
+fn render_without_optional_content(mut data: Vec<u8>) -> Vec<Vec<u8>> {
+    let names: [&[u8]; 5] = [b"OC", b"OCG", b"OCGs", b"OCMD", b"OCProperties"];
+
+    for i in 0..data.len() {
+        if data[i] != b'/' {
+            continue;
+        }
+
+        let end = data[i + 1..]
+            .iter()
+            .position(|b| b" \t\r\n\x0c\0()<>[]{}/%".contains(b))
+            .map_or(data.len(), |p| i + 1 + p);
+
+        if names.contains(&&data[i + 1..end]) {
+            data[i + 1] = b'X';
+        }
+    }
+
+    render(data)
+}
+
+fn assert_renders_as(extracted: Vec<u8>, shown: &[Vec<u8>], what: &str) {
+    assert!(
+        render(extracted.clone()) == shown,
+        "{what} differs from the source in a viewer that supports optional content"
+    );
+    assert!(
+        render_without_optional_content(extracted) == shown,
+        "{what} differs from the source in a viewer without optional content support"
+    );
+}
+
+fn assert_extracts_as_shown(data: Vec<u8>) {
+    let shown = render(data.clone());
+    assert_extracts_as(data, shown);
+}
+
+fn assert_extracts_as(data: Vec<u8>, shown: Vec<Vec<u8>>) {
+    let pdf = Pdf::new(data).unwrap();
+
+    assert_renders_as(
+        hayro_write::extract_pages_to_pdf(&pdf, &[0]),
+        &shown,
+        "extracted page",
+    );
+    assert_renders_as(
+        hayro_write::extract_pages_as_xobject_to_pdf(&pdf, &[0]),
+        &shown,
+        "extracted XObject",
+    );
+}
