@@ -0,0 +1,55 @@
+use crate::WORKSPACE_PATH;
+use crate::write_oc_0eadd0::{document, render, stream};
+use hayro_syntax::Pdf;
+
+fn assert_extracts_unchanged(data: Vec<u8>) {
+    let shown = render(data.clone());
+    let pdf = Pdf::new(data).unwrap();
+
+    let as_page = render(hayro_write::extract_pages_to_pdf(&pdf, &[0]));
+    assert!(
+        as_page == shown,
+        "extracted page differs from the source page"
+    );
+
+    let as_xobject = render(hayro_write::extract_pages_as_xobject_to_pdf(&pdf, &[0]));
+    assert!(
+        as_xobject == shown,
+        "extracted XObject differs from the source page"
+    );
+}
+
+#[test]
+fn page_without_optional_content_extracts_unchanged() {
+    assert_extracts_unchanged(
+        std::fs::read(WORKSPACE_PATH.join("pdfs/custom/clip_path_evenodd.pdf")).unwrap(),
+    );
+}
+
+#[test]
+fn marked_content_without_a_configuration_extracts_unchanged() {
+    assert_extracts_unchanged(document(&[
+        "<< /Type /Catalog /Pages 2 0 R >>".to_string(),
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>".to_string(),
+        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 60 60] /Contents 4 0 R /Resources << /Properties << /off 5 0 R >> >> >>".to_string(),
+        stream(
+            "",
+            "/OC /off BDC 1 0 0 rg 5 5 20 20 re f EMC 0 0 1 rg 30 30 20 20 re f",
+        ),
+        "<< /Type /OCG /Name (Hidden) >>".to_string(),
+    ]));
+}
+
+#[test]
+fn configuration_without_a_default_dictionary_changes_nothing() {
+    assert_extracts_unchanged(document(&[
+        "<< /Type /Catalog /Pages 2 0 R /OCProperties << /OCGs [5 0 R] >> >>".to_string(),
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>".to_string(),
+        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 60 60] /Contents 4 0 R /Resources << /Properties << /off 5 0 R >> >> >>".to_string(),
+        stream(
+            "",
+            "/OC /off BDC 1 0 0 rg 5 5 20 20 re f EMC 0 0 1 rg 30 30 20 20 re f",
+        ),
+        "<< /Type /OCG /Name (Hidden) >>".to_string(),
+    ]));
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..357a34c0
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,101 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"; export CARGO_INCREMENTAL=0; export RUSTC_BOOTSTRAP=1; export CARGO_NET_OFFLINE=true
+MODE=""; OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+cd "$(dirname "$0")"
+TEST_JSON="$(mktemp)"; TEST_ERR="$(mktemp)"; STATUS=0; BROKEN=()
+run_cargo() {
+  local label="$1"; shift
+  local json err rc
+  json="$(mktemp)"; err="$(mktemp)"
+  cargo test "$@" -Z unstable-options --format json --report-time > "$json" 2> "$err"
+  rc=$?
+  cat "$json" >> "$TEST_JSON"; cat "$err" >> "$TEST_ERR"
+  if [ "$rc" -ne 0 ]; then
+    STATUS=1
+    if ! grep -q '"type": *"test"' "$json"; then
+      BROKEN+=("$label")
+      cat "$err" "$json" > "$TEST_ERR.$label"
+    elif [ "$(grep -cE '"type": *"suite", *"event": *"(ok|failed)"' "$json")" -lt "$(grep -cE '"type": *"suite", *"event": *"started"' "$json")" ]; then
+      BROKEN+=("${label}_aborted")
+      { cat "$err"; tail -c 2000 "$json"; } > "$TEST_ERR.${label}_aborted"
+    fi
+  fi
+  rm -f "$json" "$err"
+}
+case "$MODE" in
+  base) for crate in hayro-syntax hayro-write hayro-interpret hayro-cmap hayro-postscript; do
+          run_cargo "$crate" -p "$crate" --lib -- --skip pdf::tests::pdf_version_header --skip pdf::tests::pdf_version_catalog
+        done
+        run_cargo hayro-tests -p hayro-tests --test tests -- load:: write::dont_cache_page_references \
+          write::write_xobject_does_not_synthesize_group write::write_xobject_preserves_page_group write::write_null_objects \
+          write_plain_0eadd0:: ;;
+  new)  run_cargo new -p hayro-tests --test tests -- write_oc_0eadd0:: ;;
+esac
+cat "$TEST_ERR" >&2
+NEW_TESTS="$(grep -E '^fn [a-z_0-9]+\(\) \{' hayro-tests/tests/write_oc_0eadd0.rs 2>/dev/null | sed -E 's/^fn ([a-z_0-9]+)\(.*/\1/')"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  HAD_CASES=0
+  : > "$OUTPUT_PATH"
+  if grep -q '"type": *"test"' "$TEST_JSON"; then
+    cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2> "$TEST_ERR.junit"
+    if grep -q '<testcase' "$OUTPUT_PATH" \
+      && python3 -c 'import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])' "$OUTPUT_PATH" 2>> "$TEST_ERR.junit"; then
+      sed -i -e ':a' -e 's/\(classname="[^"]*\)::/\1./' -e 'ta' -e ':b' -e 's/\(name="[^"]*\)::/\1./' -e 'tb' "$OUTPUT_PATH" 2>/dev/null || true
+      grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null && HAD_CASES=1
+    else
+      STATUS=1
+      tail -c 2000 "$TEST_JSON" >> "$TEST_ERR.junit"
+      BROKEN+=(junit)
+    fi
+  fi
+  if [ "$HAD_CASES" -eq 0 ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    if [ "${#BROKEN[@]}" -eq 0 ]; then
+      BROKEN=(compilation)
+      cat "$TEST_ERR" "$TEST_JSON" > "$TEST_ERR.compilation"
+    fi
+  fi
+  count=0; cases=""
+  for label in "${BROKEN[@]}"; do
+    sanitized=$(tail -c 4000 "$TEST_ERR.$label" | sed -e 's/]]>/]]]]><![CDATA[>/g' -e 's/::/./g')
+    if [ "$label" = "new" ] && [ -n "$NEW_TESTS" ]; then
+      while read -r name; do
+        [ -n "$name" ] || continue
+        count=$((count + 1))
+        cases="${cases}    <testcase name=\"${name}\" classname=\"write_oc_0eadd0\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+      done <<< "$NEW_TESTS"
+    else
+      message="build failed"
+      case "$label" in *_aborted) message="test process aborted" ;; esac
+      count=$((count + 1))
+      cases="${cases}    <testcase name=\"${label}\" classname=\"cargo-test\"><failure message=\"${message}\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+    fi
+  done
+  if [ "$count" -gt 0 ]; then
+    suite="  <testsuite name=\"cargo build\" tests=\"${count}\" failures=\"${count}\" errors=\"0\">
+${cases}  </testsuite>
+"
+    if [ "$HAD_CASES" -eq 1 ]; then
+      body="$(cat "$OUTPUT_PATH")"
+      body="${body%</testsuites>*}"
+      { printf '%s' "$body"; printf '%s' "$suite"; printf '</testsuites>\n'; } > "$OUTPUT_PATH"
+    else
+      { printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'; printf '%s' "$suite"; printf '</testsuites>\n'; } > "$OUTPUT_PATH"
+    fi
+  fi
+fi
+rm -f "$TEST_JSON" "$TEST_ERR" "$TEST_ERR".*
+exit $STATUS
