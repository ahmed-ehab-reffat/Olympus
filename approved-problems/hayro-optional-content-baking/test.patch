+#[test]
+fn alternating_groups_eight_levels_deep() {
+    let mut content = String::new();
+    for depth in 0..8 {
+        let group = if depth % 2 == 0 { "on" } else { "off" };
+        let x = 2 + depth * 7;
+        content.push_str(&format!("/OC /{group} BDC 0 0 1 rg {x} {x} 6 6 re f "));
+    }
+    for depth in (0..8).rev() {
+        let x = 2 + depth * 7;
+        content.push_str(&format!("1 0 0 rg {x} 50 6 6 re f EMC "));
+    }
+
+    assert_extracts_as_shown(page(&content));
+}
