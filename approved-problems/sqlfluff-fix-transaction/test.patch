+def test_fixtx_result_folds_every_reason_across_files(tmp_path):
+    """Result folds every reason across files."""
+    # Three distinct files, each engineered to hit a different skip reason.
+    (tmp_path / "conflict.sql").write_text("select a from b\n")
+    (tmp_path / "unparsable.sql").write_text("select c from d\n")
+    (tmp_path / "oscillation.sql").write_text("select e from f\n")
+    rules = [Rule_T807, Rule_T810, Rule_T812, Rule_T813, Rule_T814]
+    config = FluffConfig(
+        overrides={
+            "dialect": "ansi",
+            "rules": "T807,T810,T812,T813,T814",
+            "fix_transaction": True,
+        }
+    )
+    result = Linter(config=config, user_rules=rules).lint_paths(
+        (str(tmp_path),), fix=True, apply_fixes=False
+    )
+    report = result.fix_transaction_report()
+    # The run-level report folds all three reasons, not just conflict.
+    assert occurred_reasons(report.reasons) == {
+        "conflict": 1,
+        "unparsable": 1,
+        "oscillation": 2,
+    }
+    assert report.applied == 3
+    assert report.skipped == 4
+    assert len(result.get_fix_outcomes()) == 7
+    assert set(result.conflict_groups()) == {"T807"}
+    assert "T810" in result.conflict_groups()["T807"]
+    oscillating = {
+        outcome.rule_code
+        for outcome in result.get_fix_outcomes()
+        if outcome.reason == "oscillation"
+    }
+    assert oscillating == {"T814"}
