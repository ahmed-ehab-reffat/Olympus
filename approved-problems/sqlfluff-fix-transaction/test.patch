+def test_fixtx_fix_command_prints_the_transaction_report(tmp_path):
+    """Fix command prints the transaction report."""
+    from click.testing import CliRunner
+
+    from sqlfluff.cli.commands import fix
+
+    # Two built-in layout rules both want the source around the comma, so the
+    # transaction records a conflict skip that the fix command must surface.
+    (tmp_path / ".sqlfluff").write_text(
+        "[sqlfluff]\ndialect = ansi\nrules = LT01,LT09\nfix_transaction = True\n"
+    )
+    target = tmp_path / "in.sql"
+    target.write_text("SELECT a , b FROM t\n")
+    output = CliRunner().invoke(fix, ["--check", str(target)], input="y\n").output
+    # The transaction report reaches the user, showing its applied/skipped counts.
+    assert "applied" in output and "skipped" in output
