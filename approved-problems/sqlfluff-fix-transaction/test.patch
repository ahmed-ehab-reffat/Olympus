+#!/usr/bin/env bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+if [ -z "$MODE" ]; then
+  echo "Usage: ./test.sh [--output_path <path>] {base|new}"
+  exit 1
+fi
+
+JUNIT=""
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT="--junitxml=$OUTPUT_PATH"
+fi
+
+NEW_TESTS="test/core/linter/fix_transaction_staging_test.py"
+
+case "$MODE" in
+  base)
+    # The linter, its CLI and the public API: the subsystem this change touches
+    # and everything that consumes it. The dialect corpus is excluded because it
+    # neither exercises nor is exercised by the fix loop.
+    python -m pytest -q -p no:cacheprovider \
+      --ignore="$NEW_TESTS" \
+      $JUNIT \
+      test/core test/cli test/api
+    ;;
+  new)
+    python -m pytest -q -p no:cacheprovider $JUNIT "$NEW_TESTS"
+    ;;
+esac
