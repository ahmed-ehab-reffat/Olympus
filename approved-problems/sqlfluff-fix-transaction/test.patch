+"""Tests for staged, all-or-nothing application of fixes from several rules."""
+
+from typing import Optional
+
+import pytest
+
+from sqlfluff.core import FluffConfig, Linter
+from sqlfluff.core.parser import CommentSegment, WhitespaceSegment
+from sqlfluff.core.rules import BaseRule, LintFix, LintResult, RuleContext
+from sqlfluff.core.rules.crawlers import SegmentSeekerCrawler
+
+
+class Rule_T801(BaseRule):
+    """Naked identifiers should be upper case.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select A from B
+    """
+
+    name = "fixtx.upper"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw == segment.raw.upper():
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[LintFix.replace(segment, [segment.edit(segment.raw.upper())])],
+        )
+
+
+class Rule_T802(BaseRule):
+    """Lower case naked identifiers should be suffixed.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select a_1 from b_1
+    """
+
+    name = "fixtx.suffix"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw != segment.raw.lower():
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[LintFix.replace(segment, [segment.edit(segment.raw + "_1")])],
+        )
+
+
+class Rule_T803(BaseRule):
+    """The SELECT keyword is redundant and should be removed.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        a from b
+    """
+
+    name = "fixtx.wrecker"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"keyword"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw.upper() != "SELECT":
+            return None
+        return LintResult(anchor=segment, fixes=[LintFix.delete(segment)])
+
+
+class Rule_T804(BaseRule):
+    """Naked identifiers should be lower case.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select A from B
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select a from b
+    """
+
+    name = "fixtx.lower"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw == segment.raw.lower():
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[LintFix.replace(segment, [segment.edit(segment.raw.lower())])],
+        )
+
+
+class Rule_T805(BaseRule):
+    """A comment belongs before the final identifier.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select a from /* x */ b
+    """
+
+    name = "fixtx.before"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw != "b" or context.parent_stack[0].raw != "select a from b\n":
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[
+                LintFix.create_before(
+                    segment, [CommentSegment("/*x*/"), WhitespaceSegment()]
+                )
+            ],
+        )
+
+
+class Rule_T806(BaseRule):
+    """A comment belongs after the final identifier.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select a from b /* y */
+    """
+
+    name = "fixtx.after"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw != "b" or context.parent_stack[0].raw != "select a from b\n":
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[
+                LintFix.create_after(
+                    segment, [WhitespaceSegment(), CommentSegment("/*y*/")]
+                )
+            ],
+        )
+
+
+class Rule_T807(BaseRule):
+    """The identifier a should be upper case.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select A from b
+    """
+
+    name = "fixtx.a"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw != "a":
+            return None
+        return LintResult(
+            anchor=segment, fixes=[LintFix.replace(segment, [segment.edit("A")])]
+        )
+
+
+class Rule_T808(BaseRule):
+    """The identifier b should be upper case.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select a from B
+    """
+
+    name = "fixtx.b"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw != "b":
+            return None
+        return LintResult(
+            anchor=segment, fixes=[LintFix.replace(segment, [segment.edit("B")])]
+        )
+
+
+class Rule_T810(BaseRule):
+    """The identifier a should read differently (loses to T807).
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select a from b
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select Z from b
+    """
+
+    name = "fixtx.a_alt"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw != "a":
+            return None
+        return LintResult(
+            anchor=segment, fixes=[LintFix.replace(segment, [segment.edit("Z")])]
+        )
+
+
+class Rule_T812(BaseRule):
+    """The redundant select keyword should be removed from d queries.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select c from d
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        c from d
+    """
+
+    name = "fixtx.deselect"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"keyword"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw.upper() != "SELECT" or "d" not in context.parent_stack[0].raw:
+            return None
+        return LintResult(anchor=segment, fixes=[LintFix.delete(segment)])
+
+
+class Rule_T813(BaseRule):
+    """The identifiers e and f should be upper case.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select e from f
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select E from F
+    """
+
+    name = "fixtx.ef_up"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw not in ("e", "f"):
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[LintFix.replace(segment, [segment.edit(segment.raw.upper())])],
+        )
+
+
+class Rule_T814(BaseRule):
+    """The identifiers E and F should be lower case.
+
+    **Anti-pattern**
+
+    .. code-block:: sql
+
+        select E from F
+
+    **Best practice**
+
+    .. code-block:: sql
+
+        select e from f
+    """
+
+    name = "fixtx.ef_down"
+    groups = ("all",)
+    crawl_behaviour = SegmentSeekerCrawler({"naked_identifier"})
+    is_fix_compatible = True
+
+    def _eval(self, context: RuleContext) -> Optional[LintResult]:
+        segment = context.segment
+        if segment.raw not in ("E", "F"):
+            return None
+        return LintResult(
+            anchor=segment,
+            fixes=[LintFix.replace(segment, [segment.edit(segment.raw.lower())])],
+        )
+
+
+def fixtx_lint(sql, rules, user_rules, transaction=True):
+    """Fix a string with the given rules, returning the linted file."""
+    config = FluffConfig(
+        overrides={
+            "dialect": "ansi",
+            "rules": rules,
+            "fix_transaction": transaction,
+        }
+    )
+    linter = Linter(config=config, user_rules=user_rules)
+    return linter.lint_string(sql, fix=True)
+
+
+def fixtx_by(linted, status=None, reason=None):
+    """Select outcome records by status or reason."""
+    return [
+        outcome
+        for outcome in linted.fix_outcomes
+        if (status is None or outcome.status == status)
+        and (reason is None or outcome.reason == reason)
+    ]
+
+
+def occurred_reasons(reasons):
+    """The reason counts that actually occurred.
+
+    Whether the report omits reasons with a zero count or lists every known
+    reason with a zero is an implementation choice, so tests compare only the
+    reasons that occurred.
+    """
+    return {reason: count for reason, count in reasons.items() if count}
+
+
+def test_fixtx_default_path_records_no_outcomes():
+    """Default path records no outcomes."""
+    linted = fixtx_lint("select a from b\n", "T801", [Rule_T801], transaction=False)
+    assert linted.fix_string()[0] == "select A from B\n"
+    assert not linted.fix_outcomes
+
+
+def test_fixtx_is_off_unless_the_setting_is_turned_on():
+    """Is off unless the setting is turned on."""
+    config = FluffConfig(overrides={"dialect": "ansi", "rules": "T801"})
+    linter = Linter(config=config, user_rules=[Rule_T801])
+    linted = linter.lint_string("select a from b\n", fix=True)
+    assert linted.fix_string()[0] == "select A from B\n"
+    assert not linted.fix_outcomes
+
+
+def test_fixtx_applied_fixes_are_recorded():
+    """Applied fixes are recorded."""
+    linted = fixtx_lint("select a from b\n", "T801", [Rule_T801])
+    assert linted.fix_string()[0] == "select A from B\n"
+    applied = fixtx_by(linted, status="applied")
+    assert len(applied) == 2
+    assert {outcome.rule_code for outcome in applied} == {"T801"}
+    assert all(outcome.reason is None for outcome in applied)
+    applied_record = applied[0].to_dict()
+    assert applied_record["status"] == "applied"
+    assert applied_record["reason"] is None
+    from sqlfluff.core.linter.fix_transaction import FixOutcome
+
+    assert all(isinstance(outcome, FixOutcome) for outcome in linted.fix_outcomes)
+
+
+def test_fixtx_opposite_end_inserts_on_one_anchor_compose():
+    """Opposite end inserts on one anchor compose."""
+    linted = fixtx_lint("select a from b\n", "T805,T806", [Rule_T805, Rule_T806])
+    assert linted.fix_string()[0] == "select a from /*x*/ b /*y*/\n"
+    assert {outcome.rule_code for outcome in fixtx_by(linted, status="applied")} == {
+        "T805",
+        "T806",
+    }
+    assert not fixtx_by(linted, status="skipped")
+
+
+def test_fixtx_outcomes_carry_source_position():
+    """Outcomes carry source position."""
+    linted = fixtx_lint("select a from b\n", "T801", [Rule_T801])
+    positions = [(outcome.line_no, outcome.line_pos) for outcome in linted.fix_outcomes]
+    # Both identifiers are on the first line at their own distinct positions.
+    assert all(line_no == 1 for line_no, _ in positions)
+    assert len(set(positions)) == 2
+    assert all(line_pos > 0 for _, line_pos in positions)
+
+
+def test_fixtx_competing_rules_conflict_and_lower_code_wins():
+    """Competing rules conflict and lower code wins."""
+    linted = fixtx_lint("select a from b\n", "T801,T802", [Rule_T801, Rule_T802])
+    assert linted.fix_string()[0] == "select A from B\n"
+    assert {outcome.rule_code for outcome in fixtx_by(linted, status="applied")} == {
+        "T801"
+    }
+
+
+def test_fixtx_losing_fix_names_the_rule_that_took_the_source():
+    """Losing fix names the rule that took the source."""
+    linted = fixtx_lint("select a from b\n", "T801,T802", [Rule_T801, Rule_T802])
+    conflicted = fixtx_by(linted, reason="conflict")
+    assert len(conflicted) == 2
+    assert all(outcome.rule_code == "T802" for outcome in conflicted)
+    assert all(outcome.conflict_with == "T801" for outcome in conflicted)
+    assert all(outcome.status == "skipped" for outcome in conflicted)
+
+
+def test_fixtx_conflict_resolution_ignores_the_order_rules_are_given_in():
+    """Conflict resolution ignores the order rules are given in."""
+    forward = fixtx_lint("select a from b\n", "T801,T802", [Rule_T801, Rule_T802])
+    reverse = fixtx_lint("select a from b\n", "T802,T801", [Rule_T802, Rule_T801])
+    assert forward.fix_string()[0] == reverse.fix_string()[0] == "select A from B\n"
+    assert {o.rule_code for o in fixtx_by(forward, reason="conflict")} == {"T802"}
+    assert {o.rule_code for o in fixtx_by(reverse, reason="conflict")} == {"T802"}
+
+
+def test_fixtx_unparsable_batch_is_rolled_back():
+    """Unparsable batch is rolled back."""
+    linted = fixtx_lint("select a from b\n", "T803", [Rule_T803])
+    assert linted.fix_string()[0] == "select a from b\n"
+    rolled_back = fixtx_by(linted, reason="unparsable")
+    assert rolled_back
+    assert all(outcome.status == "skipped" for outcome in rolled_back)
+    assert all(outcome.rule_code == "T803" for outcome in rolled_back)
+    assert occurred_reasons(linted.fix_transaction_report().reasons) == {
+        "unparsable": len(rolled_back)
+    }
+
+
+def test_fixtx_rollback_discards_the_whole_batch_not_just_the_bad_fix():
+    """Rollback discards the whole batch not just the bad fix."""
+    linted = fixtx_lint("select a from b\n", "T801,T803", [Rule_T801, Rule_T803])
+    assert linted.fix_string()[0] == "select a from b\n"
+    assert {outcome.reason for outcome in linted.fix_outcomes} == {"unparsable"}
+    assert {outcome.rule_code for outcome in linted.fix_outcomes} == {"T801", "T803"}
+    assert not fixtx_by(linted, status="applied")
+
+
+def test_fixtx_cycling_rules_are_rolled_back_and_named():
+    """Cycling rules are rolled back and named."""
+    linted = fixtx_lint("select a from b\n", "T801,T804", [Rule_T801, Rule_T804])
+    cycling = fixtx_by(linted, reason="oscillation")
+    assert cycling
+    assert all(outcome.status == "skipped" for outcome in cycling)
+    assert {outcome.rule_code for outcome in cycling} == {"T804"}
+    assert "oscillation" in linted.fix_transaction_report().reasons
+
+
+def test_fixtx_cycle_leaves_the_file_at_the_last_committed_state():
+    """Cycle leaves the file at the last committed state."""
+    linted = fixtx_lint("select a from b\n", "T801,T804", [Rule_T801, Rule_T804])
+    assert linted.fix_string()[0] == "select A from B\n"
+    assert {outcome.rule_code for outcome in fixtx_by(linted, status="applied")} == {
+        "T801"
+    }
+    assert not fixtx_by(linted, status="applied", reason="oscillation")
+
+
+@pytest.mark.parametrize("transaction", [True, False])
+def test_fixtx_clean_file_produces_no_outcomes(transaction):
+    """Clean file produces no outcomes."""
+    linted = fixtx_lint(
+        "select A_1 from B_1\n", "T801,T802", [Rule_T801, Rule_T802], transaction
+    )
+    assert not linted.fix_outcomes
+    # The public reporting helpers report their empty form for this path.
+    report = linted.fix_transaction_report()
+    assert report.applied == 0
+    assert report.skipped == 0
+    assert report.total == 0
+    assert occurred_reasons(report.reasons) == {}
+    assert linted.conflict_groups() == {}
+    assert set(linted.oscillating_rules()) == set()
+
+
+def test_fixtx_rules_on_distinct_sources_do_not_conflict():
+    """Rules on distinct sources do not conflict."""
+    linted = fixtx_lint("select a from b\n", "T807,T808", [Rule_T807, Rule_T808])
+    assert linted.fix_string()[0] == "select A from B\n"
+    assert {outcome.rule_code for outcome in fixtx_by(linted, status="applied")} == {
+        "T807",
+        "T808",
+    }
+    assert not fixtx_by(linted, status="skipped")
+
+
+def test_fixtx_convenience_selectors_expose_outcomes():
+    """Convenience selectors expose outcomes."""
+    linted = fixtx_lint("select a from b\n", "T801,T802", [Rule_T801, Rule_T802])
+    assert {outcome.rule_code for outcome in linted.applied_fixes()} == {"T801"}
+    assert {outcome.rule_code for outcome in linted.skipped_fixes()} == {"T802"}
+    # Every skip here is a conflict, so fix_conflicts() covers all of them.
+    assert len(linted.fix_conflicts()) == len(linted.skipped_fixes())
+    assert all(outcome.reason == "conflict" for outcome in linted.skipped_fixes())
+    assert all(outcome.status == "applied" for outcome in linted.applied_fixes())
+    loser = linted.fix_conflicts()[0]
+    assert loser.to_dict() == {
+        "rule_code": "T802",
+        "line_no": loser.line_no,
+        "line_pos": loser.line_pos,
+        "status": "skipped",
+        "reason": "conflict",
+        "conflict_with": "T801",
+    }
+
+
+def test_fixtx_fix_conflicts_returns_only_conflict_skips():
+    """Fix conflicts returns only conflict skips."""
+    linted = fixtx_lint(
+        "select a from b\n", "T801,T802,T803", [Rule_T801, Rule_T802, Rule_T803]
+    )
+    # T802 loses a conflict; the T801/T803 batch is rolled back as unparsable.
+    assert {outcome.reason for outcome in linted.skipped_fixes()} == {
+        "conflict",
+        "unparsable",
+    }
+    assert {outcome.rule_code for outcome in linted.fix_conflicts()} == {"T802"}
+    assert all(outcome.reason == "conflict" for outcome in linted.fix_conflicts())
+    # fix_conflicts() is the conflict-only subset of skipped_fixes().
+    skipped = linted.skipped_fixes()
+    assert len(linted.fix_conflicts()) < len(skipped)
+    assert all(outcome in skipped for outcome in linted.fix_conflicts())
+
+
+def test_fixtx_report_tallies_applied_and_skipped():
+    """Report tallies applied and skipped."""
+    linted = fixtx_lint("select a from b\n", "T801,T802", [Rule_T801, Rule_T802])
+    report = linted.fix_transaction_report()
+    assert report.applied == 2
+    assert report.skipped == 2
+    assert report.total == 4
+    assert occurred_reasons(report.reasons) == {"conflict": 2}
+    # A summary is returned as text; its exact wording is not part of the contract.
+    assert isinstance(report.summary(), str)
+    # The serialised form carries the report's counts; the exact key set is not
+    # pinned so an implementation may include extra fields.
+    serialised = report.to_dict()
+    assert serialised["applied"] == 2
+    assert serialised["skipped"] == 2
+    assert occurred_reasons(serialised["reasons"]) == {"conflict": 2}
+
+
+def test_fixtx_conflict_groups_map_winner_to_losers():
+    """Conflict groups map winner to losers."""
+    linted = fixtx_lint("select a from b\n", "T801,T802", [Rule_T801, Rule_T802])
+    groups = linted.conflict_groups()
+    assert set(groups) == {"T801"}
+    assert "T802" in groups["T801"]
+
+
+def test_fixtx_conflict_groups_track_distinct_losers():
+    """Conflict groups track distinct losers."""
+    linted = fixtx_lint(
+        "select a from b\n", "T801,T807,T808", [Rule_T801, Rule_T807, Rule_T808]
+    )
+    assert linted.fix_string()[0] == "select A from B\n"
+    groups = linted.conflict_groups()
+    assert set(groups) == {"T801"}
+    assert set(groups["T801"]) == {"T807", "T808"}
+
