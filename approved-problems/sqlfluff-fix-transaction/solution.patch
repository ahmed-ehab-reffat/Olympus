diff --git a/src/sqlfluff/core/linter/fix_transaction.py b/src/sqlfluff/core/linter/fix_transaction.py
new file mode 100644
index 000000000..c5d460e4a
--- /dev/null
+++ b/src/sqlfluff/core/linter/fix_transaction.py
@@ -0,0 +1,293 @@
+"""Staged, all-or-nothing application of fixes proposed by several rules.
+
+The default fix loop hands each rule the tree left behind by the rule before it,
+so two rules can never propose a fix against the same tree and a conflict between
+them cannot be observed. A transaction stages every rule's fixes against a single
+snapshot instead, which makes conflicts visible, lets the batch be committed or
+rolled back as a unit, and leaves a record of what happened to each fix.
+"""
+
+from collections import Counter
+from collections.abc import Iterable, Mapping
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Optional
+
+from sqlfluff.core.linter.fix import apply_fixes, compute_anchor_edit_info
+
+if TYPE_CHECKING:  # pragma: no cover
+    from sqlfluff.core.dialects import Dialect
+    from sqlfluff.core.parser import BaseSegment
+    from sqlfluff.core.rules.fix import LintFix
+    from sqlfluff.core.templaters import TemplatedFile
+
+APPLIED = "applied"
+SKIPPED = "skipped"
+
+CONFLICT = "conflict"
+UNPARSABLE = "unparsable"
+OSCILLATION = "oscillation"
+
+
+@dataclass(frozen=True)
+class FixOutcome:
+    """What became of a single fix proposed during a fix transaction."""
+
+    rule_code: str
+    line_no: int
+    line_pos: int
+    status: str
+    reason: Optional[str] = None
+    conflict_with: Optional[str] = None
+
+    def to_dict(self) -> dict[str, object]:
+        """A plain mapping for serialised (e.g. JSON) output."""
+        return {
+            "rule_code": self.rule_code,
+            "line_no": self.line_no,
+            "line_pos": self.line_pos,
+            "status": self.status,
+            "reason": self.reason,
+            "conflict_with": self.conflict_with,
+        }
+
+
+@dataclass(frozen=True)
+class StagedFix:
+    """A fix held against the snapshot, remembering which rule proposed it."""
+
+    rule_code: str
+    fix: "LintFix"
+
+    @property
+    def span(self) -> tuple[int, int]:
+        """The source positions the fix anchor covers."""
+        pos = self.fix.anchor.pos_marker
+        if pos is None:
+            return (0, 0)
+        source_slice = pos.source_slice
+        return (source_slice.start, source_slice.stop)
+
+    def footprint(
+        self, templated_file: Optional["TemplatedFile"]
+    ) -> Optional[frozenset[int]]:
+        """The editable source the fix touches, as literal raw-slice offsets.
+
+        A fix can only rewrite literal source; the parts of a templated file
+        that come from a `{{ ... }}` or `{% ... %}` block are off limits, so a
+        fix landing wholly inside one of them touches nothing editable. Two
+        fixes only truly compete when the literal slices they touch actually
+        intersect, which is finer than their anchors sharing a source position.
+        Returns ``None`` when the footprint cannot be computed and the caller
+        should fall back to raw source positions alone.
+        """
+        if templated_file is None or self.fix.anchor.pos_marker is None:
+            return None
+        slices = self.fix.get_fix_slices(templated_file, within_only=True)
+        return frozenset(
+            raw_slice.source_idx
+            for raw_slice in slices
+            if raw_slice.slice_type == "literal"
+        )
+
+    def outcome(
+        self,
+        status: str,
+        reason: Optional[str] = None,
+        conflict_with: Optional[str] = None,
+    ) -> FixOutcome:
+        """Record the fate of this fix."""
+        pos = self.fix.anchor.pos_marker
+        line_no, line_pos = (pos.working_loc) if pos else (0, 0)
+        return FixOutcome(
+            rule_code=self.rule_code,
+            line_no=line_no,
+            line_pos=line_pos,
+            status=status,
+            reason=reason,
+            conflict_with=conflict_with,
+        )
+
+
+def stage_fixes(rule_code: str, fixes: list["LintFix"]) -> list[StagedFix]:
+    """Attach the proposing rule to each fix."""
+    return [StagedFix(rule_code, fix) for fix in fixes]
+
+
+def _composes(left: StagedFix, right: StagedFix) -> bool:
+    """Do these two fixes sit either side of one anchor rather than fight over it?"""
+    if left.fix.anchor.uuid != right.fix.anchor.uuid:
+        return False
+    return {left.fix.edit_type, right.fix.edit_type} == {
+        "create_before",
+        "create_after",
+    }
+
+
+def _overlaps(left: StagedFix, right: StagedFix) -> bool:
+    """Do the source positions of the two fix anchors intersect?"""
+    left_start, left_stop = left.span
+    right_start, right_stop = right.span
+    if left_start == left_stop or right_start == right_stop:
+        return left_start == right_start
+    return left_start < right_stop and right_start < left_stop
+
+
+def _competes(
+    left: StagedFix,
+    right: StagedFix,
+    footprints: Mapping[int, Optional[frozenset[int]]],
+) -> bool:
+    """Do two fixes from different rules fight over the same editable source?
+
+    They compete when their source positions overlap and the literal slices
+    they touch actually intersect. The position check discriminates fixes in a
+    single literal file (where every fix shares the one whole-file slice); the
+    slice check then drops pairs that only meet in a templated region, or that
+    edit different literal slices behind one anchor. A missing footprint means
+    the positions alone decide.
+    """
+    if _composes(left, right):
+        return False
+    if not _overlaps(left, right):
+        return False
+    left_prints = footprints[id(left)]
+    right_prints = footprints[id(right)]
+    if left_prints is None or right_prints is None:
+        return True
+    return not left_prints.isdisjoint(right_prints)
+
+
+def resolve_conflicts(
+    staged: list[StagedFix],
+    templated_file: Optional["TemplatedFile"] = None,
+) -> tuple[list[StagedFix], list[FixOutcome]]:
+    """Settle fixes from different rules that compete for the same source.
+
+    Fixes are considered in rule code order, so the rule whose code sorts first
+    is the one that keeps its fix; every later rule that wants overlapping source
+    is skipped and told which rule took it. Competition is judged on the literal
+    source each fix touches, so fixes to templated regions never spuriously block
+    one another.
+    """
+    footprints = {id(s): s.footprint(templated_file) for s in staged}
+    ordered = sorted(staged, key=lambda s: (s.rule_code, s.span, s.fix.edit_type))
+    accepted: list[StagedFix] = []
+    skipped: list[FixOutcome] = []
+
+    for candidate in ordered:
+        blocker: Optional[StagedFix] = None
+        for winner in accepted:
+            if winner.rule_code == candidate.rule_code:
+                continue
+            if _competes(winner, candidate, footprints):
+                blocker = winner
+                break
+        if blocker:
+            skipped.append(
+                candidate.outcome(SKIPPED, CONFLICT, conflict_with=blocker.rule_code)
+            )
+        else:
+            accepted.append(candidate)
+
+    return accepted, skipped
+
+
+def commit(
+    tree: "BaseSegment",
+    dialect: "Dialect",
+    accepted: list[StagedFix],
+    fix_even_unparsable: bool,
+    max_parse_depth: int,
+    max_parse_nodes: int,
+) -> tuple["BaseSegment", bool]:
+    """Apply the accepted fixes to the snapshot as a single batch.
+
+    The whole batch is applied in one pass so that no fix observes the effect of
+    another. The caller keeps the returned tree only if it is valid.
+    """
+    anchor_info = compute_anchor_edit_info([staged.fix for staged in accepted])
+    codes = ",".join(sorted({staged.rule_code for staged in accepted}))
+    new_tree, _, _, is_valid = apply_fixes(
+        tree,
+        dialect,
+        codes,
+        anchor_info,
+        fix_even_unparsable=fix_even_unparsable,
+        max_parse_depth=max_parse_depth,
+        max_parse_nodes=max_parse_nodes,
+    )
+    return new_tree, is_valid
+
+
+def roll_back(accepted: list[StagedFix], reason: str) -> list[FixOutcome]:
+    """Discard a batch, recording why every fix in it went unapplied."""
+    return [staged.outcome(SKIPPED, reason) for staged in accepted]
+
+
+def record_applied(accepted: list[StagedFix]) -> list[FixOutcome]:
+    """Record a committed batch."""
+    return [staged.outcome(APPLIED) for staged in accepted]
+
+
+def conflict_groups(
+    outcomes: Iterable[FixOutcome],
+) -> dict[str, tuple[str, ...]]:
+    """Group conflict skips by the rule that won each contested source.
+
+    The result maps a winning rule code to the codes of the rules whose fixes
+    it displaced, in the order they were skipped.
+    """
+    groups: dict[str, list[str]] = {}
+    for outcome in outcomes:
+        if outcome.reason == CONFLICT and outcome.conflict_with is not None:
+            groups.setdefault(outcome.conflict_with, []).append(outcome.rule_code)
+    return {winner: tuple(losers) for winner, losers in groups.items()}
+
+
+def oscillating_rules(outcomes: Iterable[FixOutcome]) -> frozenset[str]:
+    """The rules whose fixes were rolled back for cycling the file."""
+    return frozenset(o.rule_code for o in outcomes if o.reason == OSCILLATION)
+
+
+@dataclass(frozen=True)
+class FixTransactionReport:
+    """A tally of what a set of transactions did to the fixes they staged."""
+
+    applied: int
+    skipped: int
+    reasons: Mapping[str, int] = field(default_factory=dict)
+
+    @classmethod
+    def from_outcomes(cls, outcomes: Iterable[FixOutcome]) -> "FixTransactionReport":
+        """Summarise a run of outcomes, counting the skips by reason."""
+        applied = 0
+        reasons: "Counter[str]" = Counter()
+        for outcome in outcomes:
+            if outcome.status == APPLIED:
+                applied += 1
+            elif outcome.reason is not None:
+                reasons[outcome.reason] += 1
+        return cls(
+            applied=applied, skipped=sum(reasons.values()), reasons=dict(reasons)
+        )
+
+    @property
+    def total(self) -> int:
+        """How many fixes were staged in all."""
+        return self.applied + self.skipped
+
+    def summary(self) -> str:
+        """A one line description, ordered by reason for a stable read."""
+        if not self.total:
+            return "no staged fixes"
+        parts = [f"{self.applied} applied", f"{self.skipped} skipped"]
+        parts += [f"{self.reasons[reason]} {reason}" for reason in sorted(self.reasons)]
+        return ", ".join(parts)
+
+    def to_dict(self) -> dict[str, object]:
+        """A plain mapping for serialised (e.g. JSON) output."""
+        return {
+            "applied": self.applied,
+            "skipped": self.skipped,
+            "reasons": dict(self.reasons),
+        }
