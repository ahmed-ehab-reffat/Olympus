+    def format_fix_transaction_report(self, result: LintingResult) -> str:
+        """Format the outcomes of a fix transaction for display.
+
+        Returns an empty string unless the run staged at least one fix, which
+        only happens when the fix transaction is switched on.
+        """
+        report = result.fix_transaction_report()
+        if not report.total:
+            return ""
+        text_buffer = StringIO()
+        text_buffer.write("==== fix transaction ====\n")
+        text_buffer.write(report.summary())
+        for record in result.fix_outcome_records():
+            outcomes = cast(list[dict], record["fix_outcomes"])
+            skipped = [
+                outcome for outcome in outcomes if outcome["status"] == "skipped"
+            ]
+            if not skipped:
+                continue
+            text_buffer.write("\n")
+            text_buffer.write(
+                self.format_filename(cast(str, record["filepath"]), success=False)
+            )
+            for outcome in sorted(skipped, key=lambda o: (o["line_no"], o["line_pos"])):
+                detail = outcome["reason"]
+                if outcome["conflict_with"]:
+                    detail = f"{detail} with {outcome['conflict_with']}"
+                line = (
+                    f"L:{outcome['line_no']:4} | P:{outcome['line_pos']:4} | "
+                    f"{outcome['rule_code']}: skipped ({detail})"
+                )
+                text_buffer.write("\n" + self.colorize(line, Color.blue))
+        return text_buffer.getvalue()
+
