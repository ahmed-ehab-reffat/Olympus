diff --git a/src/merge.rs b/src/merge.rs
new file mode 100644
index 0000000..03f20f6
--- /dev/null
+++ b/src/merge.rs
@@ -0,0 +1,102 @@
+use crate::{InternalKeyKind, Value};
+
+pub(crate) const OP_ADD: u8 = 0;
+pub(crate) const OP_MIN: u8 = 1;
+pub(crate) const OP_MAX: u8 = 2;
+
+#[inline]
+pub(crate) fn is_merge_kind(kind: InternalKeyKind) -> bool {
+	matches!(kind, InternalKeyKind::Merge)
+}
+
+#[inline]
+pub(crate) fn encode_operand(op: u8, value: u64) -> Value {
+	let mut buf = Vec::with_capacity(9);
+	buf.push(op);
+	buf.extend_from_slice(&value.to_le_bytes());
+	buf
+}
+
+#[inline]
+fn decode_operand(bytes: &[u8]) -> Option<(u8, u64)> {
+	if bytes.len() == 9 {
+		let mut v = [0u8; 8];
+		v.copy_from_slice(&bytes[1..9]);
+		Some((bytes[0], u64::from_le_bytes(v)))
+	} else {
+		None
+	}
+}
+
+#[inline]
+fn decode_base(bytes: &[u8]) -> u64 {
+	if bytes.len() == 8 {
+		let mut v = [0u8; 8];
+		v.copy_from_slice(bytes);
+		u64::from_le_bytes(v)
+	} else {
+		0
+	}
+}
+
+#[inline]
+fn apply(acc: u64, op: u8, value: u64) -> u64 {
+	match op {
+		OP_ADD => acc.saturating_add(value),
+		OP_MIN => acc.min(value),
+		OP_MAX => acc.max(value),
+		_ => acc,
+	}
+}
+
+#[inline]
+fn encode_base(value: u64) -> Value {
+	value.to_le_bytes().to_vec()
+}
+
+pub(crate) fn fold(base: Option<&[u8]>, operands: &[Value]) -> Value {
+	let mut acc: u64 = base.map_or(0, decode_base);
+	for op in operands {
+		if let Some((kind, value)) = decode_operand(op) {
+			acc = apply(acc, kind, value);
+		}
+	}
+	encode_base(acc)
+}
+
+pub(crate) fn partial_fold_stamped(operands: &[(u64, u64, Value)]) -> Vec<(u64, u64, Value)> {
+	let mut out: Vec<(u64, u64, Value)> = Vec::new();
+	let mut run_op: Option<u8> = None;
+	let mut run_acc: u64 = 0;
+	let mut run_seq: u64 = 0;
+	let mut run_ts: u64 = 0;
+	for (seq, ts, op) in operands {
+		let (kind, value) = match decode_operand(op) {
+			Some(d) => d,
+			None => continue,
+		};
+		match run_op {
+			Some(prev) if prev == kind && *ts == run_ts => {
+				run_acc = apply(run_acc, prev, value);
+				run_seq = run_seq.max(*seq);
+			}
+			Some(prev) => {
+				out.push((run_seq, run_ts, encode_operand(prev, run_acc)));
+				run_op = Some(kind);
+				run_acc = value;
+				run_seq = *seq;
+				run_ts = *ts;
+			}
+			None => {
+				run_op = Some(kind);
+				run_acc = value;
+				run_seq = *seq;
+				run_ts = *ts;
+			}
+		}
+	}
+	if let Some(op) = run_op {
+		out.push((run_seq, run_ts, encode_operand(op, run_acc)));
+	}
+	out
+}
