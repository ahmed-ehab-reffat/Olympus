+#[derive(Clone, Debug)]
+enum ModelOp {
+	Put(u8, u64),
+	Merge(u8, u8, u64),
+	Delete(u8),
+	Snapshot,
+	Read(u8),
+}
+
+#[derive(Default)]
+struct Model {
+	versions: BTreeMap<u8, Vec<(u64, Op)>>,
+	seq: u64,
+}
+
+#[derive(Clone, Copy)]
+enum Op {
+	Put(u64),
+	Merge(u8, u64),
+	Delete,
+}
+
+impl Model {
+	fn next_seq(&mut self) -> u64 {
+		self.seq += 1;
+		self.seq
+	}
+
+	fn push(&mut self, k: u8, op: Op) {
+		let s = self.next_seq();
+		self.versions.entry(k).or_default().push((s, op));
+	}
+
+	fn snapshot(&self) -> u64 {
+		self.seq
+	}
+
+	fn read_at(&self, k: u8, snap: u64) -> Option<u64> {
+		let vers = self.versions.get(&k)?;
+		let visible: Vec<&(u64, Op)> = vers.iter().filter(|(s, _)| *s <= snap).collect();
+		if visible.is_empty() {
+			return None;
+		}
+		match visible.last().unwrap().1 {
+			Op::Delete => return None,
+			Op::Put(v) => return Some(v),
+			Op::Merge(_, _) => {}
+		}
+		let mut base: u64 = 0;
+		let mut start = 0usize;
+		for i in (0..visible.len()).rev() {
+			match visible[i].1 {
+				Op::Merge(_, _) => {}
+				Op::Put(v) => {
+					base = v;
+					start = i + 1;
+					break;
+				}
+				Op::Delete => {
+					base = 0;
+					start = i + 1;
+					break;
+				}
+			}
+		}
+		let mut acc = base;
+		for entry in visible.iter().skip(start) {
+			if let Op::Merge(opb, v) = entry.1 {
+				acc = match opb {
+					1 => acc.min(v),
+					2 => acc.max(v),
+					_ => acc.saturating_add(v),
+				};
+			}
+		}
+		Some(acc)
+	}
+}
+
+fn op_strategy() -> impl Strategy<Value = ModelOp> {
+	prop_oneof![
+		(0u8..5, 0u64..50).prop_map(|(k, v)| ModelOp::Put(k, v)),
+		(0u8..5, 0u8..3, 0u64..50).prop_map(|(k, o, v)| ModelOp::Merge(k, o, v)),
+		(0u8..5).prop_map(ModelOp::Delete),
+		Just(ModelOp::Snapshot),
+		(0u8..5).prop_map(ModelOp::Read),
+	]
+}
+
+#[test]
+fn model_equivalence() {
+	use proptest::test_runner::{RngAlgorithm, TestRng, TestRunner};
+	let config = ProptestConfig {
+		cases: 64,
+		failure_persistence: None,
+		..ProptestConfig::default()
+	};
+	let mut runner =
+		TestRunner::new_with_rng(config, TestRng::deterministic_rng(RngAlgorithm::ChaCha));
+	runner
+		.run(&prop::collection::vec(op_strategy(), 1..40), |ops| {
+			let rt = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+			rt.block_on(async {
+				let td = temp();
+				let tree = open(&td);
+				let mut model = Model::default();
+				let mut snapshots: Vec<(Transaction, u64)> = Vec::new();
+
+				for op in &ops {
+					match op {
+						ModelOp::Put(k, v) => {
+							put(&tree, &[*k], *v).await;
+							model.push(*k, Op::Put(*v));
+						}
+						ModelOp::Merge(k, o, v) => {
+							let operand = {
+								let mut b = vec![*o];
+								b.extend_from_slice(&v.to_le_bytes());
+								b
+							};
+							merge(&tree, &[*k], operand).await;
+							model.push(*k, Op::Merge(*o, *v));
+						}
+						ModelOp::Delete(k) => {
+							delete(&tree, &[*k]).await;
+							model.push(*k, Op::Delete);
+						}
+						ModelOp::Snapshot => {
+							let tx = tree.begin_with_mode(Mode::ReadOnly).unwrap();
+							let snap = model.snapshot();
+							snapshots.push((tx, snap));
+						}
+						ModelOp::Read(k) => {
+							let got = get(&tree, &[*k]);
+							let expected = model.read_at(*k, model.snapshot());
+							prop_assert_eq!(got, expected, "live read mismatch key {}", k);
+						}
+					}
+				}
+
+				for (tx, snap) in &snapshots {
+					for k in 0u8..5 {
+						let got = tx.get(&[k][..]).unwrap().map(|v| read_u64(&v));
+						let expected = model.read_at(k, *snap);
+						prop_assert_eq!(got, expected, "snapshot read mismatch key {} snap {}", k, snap);
+					}
+				}
+
+				Ok(())
+			})
+		})
+		.unwrap();
+}
