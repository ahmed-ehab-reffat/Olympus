+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+use proptest::prelude::*;
+use tempdir::TempDir;
+use test_log::test;
+
+use crate::clock::MockLogicalClock;
+use crate::compaction::leveled::Strategy as LeveledStrategy;
+use crate::compaction::CompactionStrategy;
+use crate::lsm::Tree;
+use crate::test::{collect_transaction_all, collect_transaction_reverse};
+use crate::{LSMIterator, Mode, Options, Transaction};
+
+fn temp() -> TempDir {
+	TempDir::new("merge_fold").unwrap()
+}
+
+fn open(td: &TempDir) -> Tree {
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 3;
+	opts.level0_max_files = 4;
+	opts.l0_stall_threshold = 12;
+	opts.max_memtable_size = 1 << 20;
+	Tree::new(Arc::new(opts)).unwrap()
+}
+
+fn open_versioned(td: &TempDir) -> Tree {
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 3;
+	opts.enable_versioning = true;
+	opts.enable_vlog = true;
+	opts.vlog_value_threshold = 0;
+	Tree::new(Arc::new(opts)).unwrap()
+}
+
+fn open_for_compaction(td: &TempDir) -> Tree {
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 2;
+	opts.level0_max_files = 1;
+	opts.l0_stall_threshold = 12;
+	opts.max_memtable_size = 1 << 20;
+	Tree::new(Arc::new(opts)).unwrap()
+}
+
+fn open_versioned_compaction(td: &TempDir) -> Tree {
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 2;
+	opts.level0_max_files = 1;
+	opts.l0_stall_threshold = 12;
+	opts.max_memtable_size = 1 << 20;
+	opts.enable_versioning = true;
+	opts.enable_vlog = true;
+	opts.vlog_value_threshold = 0;
+	Tree::new(Arc::new(opts)).unwrap()
+}
+
+fn open_versioned_clock(td: &TempDir) -> (Tree, Arc<MockLogicalClock>) {
+	let clock = Arc::new(MockLogicalClock::new());
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 3;
+	opts.enable_versioning = true;
+	opts.enable_vlog = true;
+	opts.vlog_value_threshold = 0;
+	opts.clock = Arc::clone(&clock) as Arc<dyn crate::clock::LogicalClock>;
+	(Tree::new(Arc::new(opts)).unwrap(), clock)
+}
+
+fn open_versioned_compaction_clock(td: &TempDir) -> (Tree, Arc<MockLogicalClock>) {
+	let clock = Arc::new(MockLogicalClock::new());
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 2;
+	opts.level0_max_files = 1;
+	opts.l0_stall_threshold = 12;
+	opts.max_memtable_size = 1 << 20;
+	opts.enable_versioning = true;
+	opts.enable_vlog = true;
+	opts.vlog_value_threshold = 0;
+	opts.clock = Arc::clone(&clock) as Arc<dyn crate::clock::LogicalClock>;
+	(Tree::new(Arc::new(opts)).unwrap(), clock)
+}
+
+fn force_compact(tree: &Tree) {
+	let strategy: Arc<dyn CompactionStrategy> =
+		Arc::new(LeveledStrategy::from_options(Arc::clone(&tree.core.inner.opts)));
+	for _ in 0..8 {
+		tree.compact(Arc::clone(&strategy)).unwrap();
+	}
+}
+
+fn pinned_reader(tree: &Tree) -> Transaction {
+	let tx = tree.begin_with_mode(Mode::ReadOnly).unwrap();
+	let current = tree.core.seq_num();
+	tree.core.commit_pipeline.set_seq_num(current + 1);
+	tx
+}
+
+fn add(v: u64) -> Vec<u8> {
+	let mut o = vec![0u8];
+	o.extend_from_slice(&v.to_le_bytes());
+	o
+}
+
+fn min_op(v: u64) -> Vec<u8> {
+	let mut o = vec![1u8];
+	o.extend_from_slice(&v.to_le_bytes());
+	o
+}
+
+fn max_op(v: u64) -> Vec<u8> {
+	let mut o = vec![2u8];
+	o.extend_from_slice(&v.to_le_bytes());
+	o
+}
+
+fn baseval(n: u64) -> Vec<u8> {
+	n.to_le_bytes().to_vec()
+}
+
+fn read_u64(v: &[u8]) -> u64 {
+	let mut b = [0u8; 8];
+	b.copy_from_slice(&v[..8]);
+	u64::from_le_bytes(b)
+}
+
+async fn put(tree: &Tree, key: &[u8], v: u64) {
+	let mut tx = tree.begin().unwrap();
+	tx.set(key, baseval(v)).unwrap();
+	tx.commit().await.unwrap();
+}
+
+async fn put_at(tree: &Tree, key: &[u8], v: u64, ts: u64) {
+	let mut tx = tree.begin().unwrap();
+	tx.set_at(key, baseval(v), ts).unwrap();
+	tx.commit().await.unwrap();
+}
+
+async fn merge(tree: &Tree, key: &[u8], operand: Vec<u8>) {
+	let mut tx = tree.begin().unwrap();
+	tx.merge(key, operand).unwrap();
+	tx.commit().await.unwrap();
+}
+
+async fn merge_at(tree: &Tree, clock: &MockLogicalClock, key: &[u8], operand: Vec<u8>, ts: u64) {
+	clock.set_time(ts);
+	let mut tx = tree.begin().unwrap();
+	tx.merge(key, operand).unwrap();
+	tx.commit().await.unwrap();
+}
+
+async fn delete(tree: &Tree, key: &[u8]) {
+	let mut tx = tree.begin().unwrap();
+	tx.delete(key).unwrap();
+	tx.commit().await.unwrap();
+}
+
+fn get(tree: &Tree, key: &[u8]) -> Option<u64> {
+	let tx = tree.begin().unwrap();
+	tx.get(key).unwrap().map(|v| read_u64(&v))
+}
+
+fn scan_fwd(tree: &Tree, start: &[u8], end: &[u8]) -> Vec<(Vec<u8>, u64)> {
+	let tx = tree.begin().unwrap();
+	let pairs = collect_transaction_all(&mut tx.range(start, end).unwrap()).unwrap();
+	pairs.into_iter().map(|(k, v)| (k, read_u64(&v))).collect()
+}
+
+fn scan_bwd(tree: &Tree, start: &[u8], end: &[u8]) -> Vec<(Vec<u8>, u64)> {
+	let tx = tree.begin().unwrap();
+	let pairs = collect_transaction_reverse(&mut tx.range(start, end).unwrap()).unwrap();
+	pairs.into_iter().map(|(k, v)| (k, read_u64(&v))).collect()
+}
