+#[test(tokio::test)]
+async fn non_bottom_compaction_preserves_base() {
+	let td = temp();
+	let mut opts = Options {
+		path: td.path().to_path_buf(),
+		..Default::default()
+	};
+	opts.level_count = 3;
+	opts.level0_max_files = 1;
+	opts.l0_stall_threshold = 12;
+	opts.max_memtable_size = 1 << 20;
+	let tree = Tree::new(Arc::new(opts)).unwrap();
+
+	put(&tree, b"k", 100).await;
+	tree.flush().unwrap();
+	merge(&tree, b"k", add(5)).await;
+	merge(&tree, b"k", add(7)).await;
+	tree.flush().unwrap();
+
+	let strategy: Arc<dyn CompactionStrategy> =
