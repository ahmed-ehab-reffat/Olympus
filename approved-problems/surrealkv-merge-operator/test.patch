+#[test(tokio::test)]
+async fn mvcc_as_of() {
+	let td = temp();
+	let tree = open_versioned(&td);
+	put_at(&tree, b"k", 10, 50).await;
+	merge(&tree, b"k", add(5)).await;
+	merge(&tree, b"k", max_op(20)).await;
+	let s0 = pinned_reader(&tree);
+	merge(&tree, b"k", add(1000)).await;
+	assert_eq!(get(&tree, b"k"), Some(1020));
+	assert_eq!(s0.get(b"k").unwrap().map(|v| read_u64(&v)), Some(20));
+
+	assert_eq!(s0.get_at(b"k", u64::MAX).unwrap().map(|v| read_u64(&v)), Some(20));
+	let live = tree.begin().unwrap();
+	assert_eq!(live.get_at(b"k", u64::MAX).unwrap().map(|v| read_u64(&v)), Some(1020));
+
+	let s0_fwd = collect_transaction_all(&mut s0.range(b"k", b"l").unwrap()).unwrap();
+	assert_eq!(s0_fwd.iter().map(|(_, v)| read_u64(v)).collect::<Vec<_>>(), vec![20]);
+	let s0_bwd = collect_transaction_reverse(&mut s0.range(b"k", b"l").unwrap()).unwrap();
+	assert_eq!(s0_bwd.iter().map(|(_, v)| read_u64(v)).collect::<Vec<_>>(), vec![20]);
+	assert_eq!(scan_fwd(&tree, b"k", b"l"), vec![(b"k".to_vec(), 1020)]);
+	assert_eq!(scan_bwd(&tree, b"k", b"l"), vec![(b"k".to_vec(), 1020)]);
+
+	let s0_hist = hist_set(&mut s0.history(b"k", b"l").unwrap(), true);
+	assert!(s0_hist.contains(&20));
+	assert!(!s0_hist.contains(&1020));
+	let lh = tree.begin().unwrap();
+	let live_hist = hist_set(&mut lh.history(b"k", b"l").unwrap(), true);
+	assert!(live_hist.contains(&1020));
+}
