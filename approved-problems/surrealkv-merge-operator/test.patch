+#[test(tokio::test)]
+async fn folded_reads_are_8_bytes() {
+	let td = temp();
+	let tree = open_versioned(&td);
+	put(&tree, b"k", 5).await;
+	merge(&tree, b"k", add(10)).await;
+	merge(&tree, b"k", min_op(8)).await;
+
+	let tx = tree.begin().unwrap();
+	assert_eq!(tx.get(b"k").unwrap().unwrap().len(), 8);
+	assert_eq!(tx.get_at(b"k", u64::MAX).unwrap().unwrap().len(), 8);
+
+	let fwd = collect_transaction_all(&mut tx.range(b"k", b"l").unwrap()).unwrap();
+	assert_eq!(fwd.len(), 1);
+	for (_, v) in &fwd {
+		assert_eq!(v.len(), 8);
+	}
+	let bwd = collect_transaction_reverse(&mut tx.range(b"k", b"l").unwrap()).unwrap();
+	assert_eq!(bwd.len(), 1);
+	for (_, v) in &bwd {
+		assert_eq!(v.len(), 8);
+	}
+
+	let mut it = tx.history(b"k", b"l").unwrap();
+	it.seek_first().unwrap();
+	let mut seen = 0;
+	while it.valid() {
+		assert_eq!(it.value().unwrap().len(), 8);
+		seen += 1;
+		if !it.next().unwrap() {
+			break;
+		}
+	}
+	assert_eq!(seen, 2);
+}
