+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/usr/local/bin:/root/.cargo/bin:${PATH}"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+        --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+        base|new) MODE="$1"; shift ;;
+        *) echo "Usage: $0 --output_path <path> base|new"; exit 1 ;;
+    esac
+done
+
+if [ -z "$MODE" ] || [ -z "$OUTPUT_PATH" ]; then
+    echo "Usage: $0 --output_path <path> base|new"
+    exit 1
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites/>\n' > "$OUTPUT_PATH"
+
+FILTER='test(/merge_fold_behavior/)'
+
+NEW_TESTS="test::merge_fold_behavior::absent_base_zero test::merge_fold_behavior::base_then_merges test::merge_fold_behavior::basic_add_fold test::merge_fold_behavior::delete_resets_then_merge test::merge_fold_behavior::folded_reads_are_8_bytes test::merge_fold_behavior::get_at_after_compaction_versioned test::merge_fold_behavior::get_at_merge_selects_by_timestamp test::merge_fold_behavior::get_at_none_below_earliest test::merge_fold_behavior::get_at_per_group_timestamps_survive_compaction test::merge_fold_behavior::get_at_selects_by_timestamp_not_commit_order test::merge_fold_behavior::history_fold_fwd_bwd test::merge_fold_behavior::history_folds_vlog_backed_values test::merge_fold_behavior::later_put_replaces test::merge_fold_behavior::max_basic_both_orders test::merge_fold_behavior::min_basic_both_orders test::merge_fold_behavior::mixed_op_order test::merge_fold_behavior::mixed_op_survives_compaction_no_reorder test::merge_fold_behavior::model_equivalence test::merge_fold_behavior::mvcc_as_of test::merge_fold_behavior::non_bottom_compaction_preserves_base test::merge_fold_behavior::regular_key_untouched test::merge_fold_behavior::ryow_get_at_uncommitted test::merge_fold_behavior::ryow_history_uncommitted test::merge_fold_behavior::ryow_reverse_scan_uncommitted test::merge_fold_behavior::ryow_uncommitted test::merge_fold_behavior::same_op_combine_survives_compaction test::merge_fold_behavior::same_op_distinct_ts_intermediate_after_compaction test::merge_fold_behavior::saturating_add_overflow test::merge_fold_behavior::scan_fold_fwd_bwd"
+
+write_fallback_failures() {
+    local cases=""
+    local count=0
+    for name in $NEW_TESTS; do
+        cases+="    <testcase name=\"${name}\" classname=\"surrealkv\"><failure message=\"build failed: merge operator not implemented\"/></testcase>"$'\n'
+        count=$((count + 1))
+    done
+    cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="surrealkv" tests="${count}" failures="${count}" errors="0">
+${cases}  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+write_fallback_single() {
+    cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="surrealkv" tests="1" failures="1" errors="0">
+    <testcase name="lib_build" classname="surrealkv"><failure message="lib build failed"/></testcase>
+  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+find target/nextest -name junit.xml -delete 2>/dev/null || true
+
+case "$MODE" in
+    new)
+        cargo nextest run --profile ci --no-fail-fast --features merge_op_tests --lib -E "$FILTER"
+        code=$?
+        JUNIT="$(find target/nextest -name junit.xml -type f 2>/dev/null | head -1)"
+        if [ -n "$JUNIT" ] && [ -f "$JUNIT" ]; then
+            cp "$JUNIT" "$OUTPUT_PATH"
+            exit $code
+        else
+            write_fallback_failures
+            exit 1
+        fi
+        ;;
+    base)
+        cargo nextest run --profile ci --no-fail-fast --lib
+        code=$?
+        JUNIT="$(find target/nextest -name junit.xml -type f 2>/dev/null | head -1)"
+        if [ -n "$JUNIT" ] && [ -f "$JUNIT" ]; then
+            cp "$JUNIT" "$OUTPUT_PATH"
+            exit $code
+        else
