+fn hist_vec(it: &mut impl LSMIterator, forward: bool) -> Vec<u64> {
+	if forward {
+		it.seek_first().unwrap();
+	} else {
+		it.seek_last().unwrap();
+	}
+	let mut out = Vec::new();
+	while it.valid() {
+		out.push(read_u64(&it.value().unwrap()));
+		let advanced = if forward { it.next().unwrap() } else { it.prev().unwrap() };
+		if !advanced {
+			break;
+		}
+	}
+	out
+}
+
+fn hist_set(it: &mut impl LSMIterator, forward: bool) -> BTreeSet<u64> {
+	if forward {
+		it.seek_first().unwrap();
+	} else {
+		it.seek_last().unwrap();
+	}
+	let mut out = BTreeSet::new();
+	while it.valid() {
+		out.insert(read_u64(&it.value().unwrap()));
+		let advanced = if forward { it.next().unwrap() } else { it.prev().unwrap() };
+		if !advanced {
+			break;
+		}
+	}
+	out
+}
