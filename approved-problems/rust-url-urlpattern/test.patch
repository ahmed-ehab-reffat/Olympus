+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="/opt/cargo/bin:/root/.cargo/bin:${PATH}"
+export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"
+export CARGO_NET_OFFLINE=true
+
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1 ;;
+  esac
+done
+[ -z "$MODE" ] && { echo "Usage: ./test.sh [--output_path <path>] {base|new}"; exit 1; }
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/report.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+NEW_TEST_FILE="urlpattern/tests/urlpattern_behavior_test.rs"
+CLASSNAME="cargo-test"
+
+write_junit() {
+  local testcases="$1" passed="$2" failed="$3"
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="urlpattern" tests="$((passed + failed))" failures="${failed}" errors="0">
+${testcases}  </testsuite>
+</testsuites>
+XMLEOF
+}
+
+parse_and_emit() {
+  local test_output="$1" testcases="" passed=0 failed=0 line
+  while IFS= read -r line; do
+    if [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ \.\.\.\ ok ]]; then
+      testcases+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\" />"$'\n'
+      ((passed++)) || true
+    elif [[ "$line" =~ ^[[:space:]]*test\ ([^[:space:]]+)\ \.\.\.\ FAILED ]]; then
+      testcases+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"${CLASSNAME}\"><failure message=\"test failed\"/></testcase>"$'\n'
+      ((failed++)) || true
+    fi
+  done <<< "$test_output"
+  echo "PARSED:$passed:$failed"
+  printf '%s' "$testcases"
+}
+
+synthesize_new_failures() {
+  local msg="$1" testcases="" n=0 fn sanitized
+  sanitized=$(printf '%s' "$msg" | tail -c 3000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/]]>/]] >/g')
+  while IFS= read -r fn; do
+    [ -z "$fn" ] && continue
+    testcases+="    <testcase name=\"${fn}\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+    ((n++)) || true
+  done < <(awk '/^#\[test\]/{t=1;next} t&&/^fn /{s=$0;sub(/^fn /,"",s);sub(/\(.*/,"",s);print s;t=0}' "$NEW_TEST_FILE")
+  write_junit "$testcases" 0 "$n"
+}
+
+case "$MODE" in
+  base)
+    OUT=$(cargo test -p url 2>&1)
+    CODE=$?
+    echo "$OUT"
+    RES=$(parse_and_emit "$OUT")
+    HDR=$(printf '%s' "$RES" | head -1)
+    BODY=$(printf '%s\n' "$RES" | tail -n +2)
+    P=$(echo "$HDR" | cut -d: -f2); F=$(echo "$HDR" | cut -d: -f3)
+    write_junit "$BODY" "${P:-0}" "${F:-0}"
+    exit $CODE
+    ;;
+  new)
+    OUT=$(cargo test -p urlpattern --test urlpattern_behavior_test 2>&1)
+    CODE=$?
+    echo "$OUT"
+    RES=$(parse_and_emit "$OUT")
+    HDR=$(printf '%s' "$RES" | head -1)
+    BODY=$(printf '%s\n' "$RES" | tail -n +2)
+    P=$(echo "$HDR" | cut -d: -f2); F=$(echo "$HDR" | cut -d: -f3)
+    if [ "$((${P:-0} + ${F:-0}))" -eq 0 ]; then
+      synthesize_new_failures "$OUT"
+    else
+      write_junit "$BODY" "${P:-0}" "${F:-0}"
+    fi
+    exit $CODE
+    ;;
+esac
