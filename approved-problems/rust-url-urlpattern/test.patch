+use url::Url;
+use urlpattern::{
+    UrlPattern, UrlPatternComponentResult, UrlPatternInit, UrlPatternMatchInput, UrlPatternOptions,
+};
+
+fn pat(s: &str) -> UrlPattern {
+    let init = UrlPatternInit::parse_constructor_string(s, None).unwrap();
+    UrlPattern::parse(init, UrlPatternOptions::default()).unwrap()
+}
+
+fn pat_base(s: &str, base: &str) -> UrlPattern {
+    let init = UrlPatternInit::parse_constructor_string(s, Some(Url::parse(base).unwrap())).unwrap();
+    UrlPattern::parse(init, UrlPatternOptions::default()).unwrap()
+}
+
+fn ipat(init: UrlPatternInit) -> UrlPattern {
+    UrlPattern::parse(init, UrlPatternOptions::default()).unwrap()
+}
+
+fn ipat_ic(init: UrlPatternInit, ignore_case: bool) -> UrlPattern {
+    UrlPattern::parse(init, UrlPatternOptions { ignore_case }).unwrap()
+}
+
+fn url(s: &str) -> UrlPatternMatchInput {
+    UrlPatternMatchInput::Url(Url::parse(s).unwrap())
+}
+
+fn path_pat(p: &str) -> UrlPatternInit {
+    UrlPatternInit { pathname: Some(p.into()), ..Default::default() }
+}
+
+fn path_in(p: &str) -> UrlPatternMatchInput {
+    UrlPatternMatchInput::Init(path_pat(p))
+}
+
+fn group<'a>(r: &'a UrlPatternComponentResult, key: &str) -> Option<&'a str> {
+    r.groups.get(key).and_then(|v| v.as_deref())
+}
+
+#[test]
+fn pathname_exact_matches() {
+    assert!(ipat(path_pat("/foo/bar")).test(path_in("/foo/bar")).unwrap());
+}
+
+#[test]
+fn pathname_exact_rejects_trailing_slash() {
+    assert!(!ipat(path_pat("/foo/bar")).test(path_in("/foo/bar/")).unwrap());
+}
+
+#[test]
+fn pathname_exact_rejects_truncated() {
+    assert!(!ipat(path_pat("/foo/bar")).test(path_in("/foo/ba")).unwrap());
+}
+
+#[test]
+fn named_group_captures_value() {
+    let p = pat("https://example.com/books/:id");
+    let r = p.exec(url("https://example.com/books/123")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "id"), Some("123"));
+}
+
+#[test]
+fn named_group_component_input_field() {
+    let p = pat("https://example.com/books/:id");
+    let r = p.exec(url("https://example.com/books/123")).unwrap().unwrap();
+    assert_eq!(r.pathname.input, "/books/123");
+}
+
+#[test]
+fn named_group_rejects_empty_segment() {
+    let p = pat("https://example.com/books/:id");
+    assert!(!p.test(url("https://example.com/books/")).unwrap());
+}
+
+#[test]
+fn two_named_groups_capture_both() {
+    let p = ipat(path_pat("/a/:b/c/:d"));
+    let r = p.exec(path_in("/a/1/c/2")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "b"), Some("1"));
+    assert_eq!(group(&r.pathname, "d"), Some("2"));
+}
+
+#[test]
+fn group_with_prefix_and_suffix_delimiters() {
+    let p = ipat(path_pat("/foo/:id.:fmt"));
+    let r = p.exec(path_in("/foo/pic.png")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "id"), Some("pic"));
+    assert_eq!(group(&r.pathname, "fmt"), Some("png"));
+}
+
+#[test]
+fn wildcard_captures_rest_as_group_zero() {
+    let p = ipat(path_pat("/foo/*"));
+    let r = p.exec(path_in("/foo/bar/baz")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "0"), Some("bar/baz"));
+}
+
+#[test]
+fn full_wildcard_matches_any_pathname() {
+    let p = ipat(path_pat("*"));
+    assert!(p.test(path_in("/anything/at/all")).unwrap());
+}
+
+#[test]
+fn regex_group_matches_digits() {
+    assert!(ipat(path_pat("/(\\d+)")).test(path_in("/42")).unwrap());
+}
+
+#[test]
+fn regex_group_rejects_non_digits() {
+    assert!(!ipat(path_pat("/(\\d+)")).test(path_in("/xy")).unwrap());
+}
+
+#[test]
+fn regex_group_captures_value() {
+    let p = ipat(path_pat("/(\\d+)"));
+    let r = p.exec(path_in("/42")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "0"), Some("42"));
+}
+
+#[test]
+fn has_regexp_groups_true_for_regex() {
+    assert!(ipat(path_pat("/(\\d+)")).has_regexp_groups());
+}
+
+#[test]
+fn has_regexp_groups_false_for_named_and_wildcard() {
+    assert!(!ipat(path_pat("/books/:id/*")).has_regexp_groups());
+}
+
+#[test]
+fn optional_modifier_matches_present_and_absent() {
+    let p = ipat(path_pat("/books/:id?"));
+    assert!(p.test(path_in("/books/1")).unwrap());
+    assert!(p.test(path_in("/books")).unwrap());
+}
+
+#[test]
+fn one_or_more_modifier_requires_at_least_one() {
+    let p = ipat(path_pat("/x/:a+"));
+    assert!(p.test(path_in("/x/a/b")).unwrap());
+    assert!(!p.test(path_in("/x")).unwrap());
+}
+
+#[test]
+fn protocol_component_matches_and_rejects() {
+    let p = ipat(UrlPatternInit { protocol: Some("https".into()), ..Default::default() });
+    assert!(p.test(url("https://a.com/")).unwrap());
+    assert!(!p.test(url("http://a.com/")).unwrap());
+}
+
+#[test]
+fn protocol_optional_group_matches_both_schemes() {
+    let p = pat("http{s}?://example.com/*");
+    assert!(p.test(url("http://example.com/a")).unwrap());
+    assert!(p.test(url("https://example.com/a")).unwrap());
+}
+
+#[test]
+fn hostname_exact_matches_and_rejects() {
+    let p = ipat(UrlPatternInit { hostname: Some("example.com".into()), ..Default::default() });
+    assert!(p.test(url("https://example.com/")).unwrap());
+    assert!(!p.test(url("https://other.com/")).unwrap());
+}
+
+#[test]
+fn hostname_wildcard_matches_subdomain() {
+    let p = pat("https://*.example.com/*");
+    assert!(p.test(url("https://sub.example.com/a")).unwrap());
+    assert_eq!(p.hostname(), "*.example.com");
+}
+
+#[test]
+fn hostname_wildcard_matches_ipv6_host() {
+    let p = ipat(UrlPatternInit { hostname: Some("*".into()), ..Default::default() });
+    assert!(p.test(url("https://[2001:db8::1]/")).unwrap());
+}
+
+#[test]
+fn port_default_is_elided_for_special_scheme() {
+    let p = pat("https://example.com:443/");
+    assert_eq!(p.port(), "");
+    assert!(p.test(url("https://example.com/")).unwrap());
+}
+
+#[test]
+fn port_explicit_matches_and_rejects() {
+    let p = ipat(UrlPatternInit { port: Some("8080".into()), ..Default::default() });
+    assert!(p.test(url("https://a.com:8080/")).unwrap());
+    assert!(!p.test(url("https://a.com/")).unwrap());
+}
+
+#[test]
+fn username_and_password_components_match() {
+    let p = ipat(UrlPatternInit {
+        username: Some("admin".into()),
+        password: Some(":pw".into()),
+        ..Default::default()
+    });
+    assert!(p.test(url("https://admin:secret@a.com/")).unwrap());
+}
+
+#[test]
+fn search_named_group_captures() {
+    let p = pat("https://ex.com/p?q=:v");
+    let r = p.exec(url("https://ex.com/p?q=1")).unwrap().unwrap();
+    assert_eq!(group(&r.search, "v"), Some("1"));
+}
+
+#[test]
+fn hash_named_group_captures() {
+    let p = pat("https://ex.com/p#:h");
+    let r = p.exec(url("https://ex.com/p#top")).unwrap().unwrap();
+    assert_eq!(group(&r.hash, "h"), Some("top"));
+}
+
+#[test]
+fn full_url_string_pattern_matches_all_components() {
+    let p = pat("https://example.com/books/:id");
+    assert_eq!(p.protocol(), "https");
+    assert_eq!(p.hostname(), "example.com");
+    assert_eq!(p.pathname(), "/books/:id");
+    assert!(p.test(url("https://example.com/books/9")).unwrap());
+}
+
+#[test]
+fn init_dict_multiple_components() {
+    let p = ipat(UrlPatternInit {
+        protocol: Some("https".into()),
+        hostname: Some("example.com".into()),
+        pathname: Some("/api/:v".into()),
+        ..Default::default()
+    });
+    let r = p.exec(url("https://example.com/api/v2")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "v"), Some("v2"));
+}
+
+#[test]
+fn base_url_resolves_relative_pattern() {
+    let p = pat_base("/foo/:bar", "https://example.com");
+    let r = p.exec(url("https://example.com/foo/xyz")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "bar"), Some("xyz"));
+}
+
+#[test]
+fn base_url_pattern_inherits_protocol_and_hostname() {
+    let p = pat_base("/foo/:bar", "https://example.com");
+    assert_eq!(p.protocol(), "https");
+    assert_eq!(p.hostname(), "example.com");
+}
+
+#[test]
+fn ignore_case_option_matches_across_case() {
+    let p = ipat_ic(path_pat("/CaSe"), true);
+    assert!(p.test(path_in("/case")).unwrap());
+}
+
+#[test]
+fn case_sensitive_by_default_rejects_case_difference() {
+    let p = ipat(path_pat("/CaSe"));
+    assert!(!p.test(path_in("/case")).unwrap());
+}
+
+#[test]
+fn exec_returns_none_on_no_match() {
+    let p = pat("https://example.com/books/:id");
+    assert!(p.exec(url("https://example.com/authors/1")).unwrap().is_none());
+}
+
+#[test]
+fn fixed_component_has_empty_groups() {
+    let p = pat("https://ex.com/a/b/c");
+    let r = p.exec(url("https://ex.com/a/b/c")).unwrap().unwrap();
+    assert!(r.pathname.groups.is_empty());
+}
+
+#[test]
+fn test_agrees_with_exec_presence() {
+    let p = pat("https://example.com/books/:id");
+    let matched = url("https://example.com/books/5");
+    assert_eq!(
+        p.test(matched).unwrap(),
+        p.exec(url("https://example.com/books/5")).unwrap().is_some()
+    );
+}
+
+#[test]
+fn pattern_string_preserves_literal_case() {
+    assert_eq!(ipat(path_pat("/CaSe")).pathname(), "/CaSe");
+}
+
+#[test]
+fn error_constructor_string_without_protocol_or_base() {
+    assert!(UrlPatternInit::parse_constructor_string("/no-protocol", None).is_err());
+}
+
+#[test]
+fn error_invalid_regex_group() {
+    assert!(UrlPattern::parse(path_pat("/(a"), UrlPatternOptions::default()).is_err());
+}
+
+#[test]
+fn error_duplicate_group_name() {
+    assert!(UrlPattern::parse(path_pat("/:a/:a"), UrlPatternOptions::default()).is_err());
+}
+
+#[test]
+fn hostname_wildcard_rejects_different_domain() {
+    let p = pat("https://*.example.com/*");
+    assert!(!p.test(url("https://sub.other.com/a")).unwrap());
+}
+
+#[test]
+fn matches_input_from_structured_init() {
+    let p = ipat(path_pat("/foo/:id"));
+    let r = p.exec(UrlPatternMatchInput::Init(path_pat("/foo/77"))).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "id"), Some("77"));
+}
+
+#[test]
+fn zero_or_more_modifier_matches_zero_and_many() {
+    let p = ipat(path_pat("/x/:a*"));
+    assert!(p.test(path_in("/x")).unwrap());
+    assert!(p.test(path_in("/x/a/b/c")).unwrap());
+}
+
+#[test]
+fn ignore_case_applies_to_search_and_hash() {
+    let mk = || UrlPatternInit {
+        search: Some("Q=1".into()),
+        hash: Some("TOP".into()),
+        ..Default::default()
+    };
+    assert!(ipat_ic(mk(), true).test(url("https://a.com/?q=1#top")).unwrap());
+    assert!(!ipat_ic(mk(), false).test(url("https://a.com/?q=1#top")).unwrap());
+}
+
+#[test]
+fn optional_group_absent_captures_none() {
+    let p = ipat(path_pat("/books/:id?"));
+    let r = p.exec(path_in("/books")).unwrap().unwrap();
+    assert!(r.pathname.groups.contains_key("id"));
+    assert_eq!(r.pathname.groups.get("id"), Some(&None));
+}
+
+#[test]
+fn multiple_anonymous_groups_number_sequentially() {
+    let p = ipat(path_pat("/(\\d+)-(\\w+)"));
+    let r = p.exec(path_in("/12-ab")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "0"), Some("12"));
+    assert_eq!(group(&r.pathname, "1"), Some("ab"));
+}
+
+#[test]
+fn protocol_and_hostname_canonicalize_to_lowercase() {
+    let p = ipat(UrlPatternInit {
+        protocol: Some("HTTPS".into()),
+        hostname: Some("Example.COM".into()),
+        ..Default::default()
+    });
+    assert_eq!(p.protocol(), "https");
+    assert_eq!(p.hostname(), "example.com");
+}
+
+#[test]
+fn exec_reports_search_component_input_and_groups() {
+    let p = ipat(UrlPatternInit { search: Some("q=:v".into()), ..Default::default() });
+    let r = p.exec(url("https://a.com/?q=abc")).unwrap().unwrap();
+    assert_eq!(r.search.input, "q=abc");
+    assert_eq!(group(&r.search, "v"), Some("abc"));
+}
+
+#[test]
+fn exec_reports_username_component_input_and_groups() {
+    let p = ipat(UrlPatternInit { username: Some(":user".into()), ..Default::default() });
+    let r = p.exec(url("https://bob@a.com/")).unwrap().unwrap();
+    assert_eq!(r.username.input, "bob");
+    assert_eq!(group(&r.username, "user"), Some("bob"));
+}
+
+#[test]
+fn mixed_wildcard_and_regexp_share_anonymous_numbering() {
+    let p = ipat(path_pat("/*/(\\d+)"));
+    let r = p.exec(path_in("/ab/12")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "0"), Some("ab"));
+    assert_eq!(group(&r.pathname, "1"), Some("12"));
+}
+
+#[test]
+fn constructor_string_splits_credentials_port_search_hash() {
+    let p = pat("https://user@host.example:8080/path?query#frag");
+    assert_eq!(p.protocol(), "https");
+    assert_eq!(p.username(), "user");
+    assert_eq!(p.hostname(), "host.example");
+    assert_eq!(p.port(), "8080");
+    assert_eq!(p.pathname(), "/path");
+    assert_eq!(p.search(), "query");
+    assert_eq!(p.hash(), "frag");
+}
+
+fn port_pat(protocol: &str, port: &str) -> UrlPattern {
+    ipat(UrlPatternInit {
+        protocol: Some(protocol.into()),
+        port: Some(port.into()),
+        ..Default::default()
+    })
+}
+
+#[test]
+fn default_port_elided_for_every_special_scheme() {
+    for (protocol, port, scheme) in
+        [("http", "80", "http"), ("ws", "80", "ws"), ("wss", "443", "wss"), ("ftp", "21", "ftp")]
+    {
+        let p = port_pat(protocol, port);
+        assert_eq!(p.port(), "", "{protocol} default port should elide");
+        assert!(p.test(url(&format!("{scheme}://host.example/"))).unwrap());
+    }
+}
+
+#[test]
+fn pathname_percent_encoding_is_canonicalized() {
+    let p = ipat(path_pat("/a b"));
+    assert!(p.test(url("https://x.example/a%20b")).unwrap());
+    assert!(p.test(url("https://x.example/a b")).unwrap());
+}
+
+#[test]
+fn hostname_is_canonicalized_through_idna() {
+    let p = ipat(UrlPatternInit { hostname: Some("m\u{fc}nchen.de".into()), ..Default::default() });
+    assert_eq!(p.hostname(), "xn--mnchen-3ya.de");
+    assert!(p.test(url("https://m\u{fc}nchen.de/")).unwrap());
+    assert!(p.test(url("https://xn--mnchen-3ya.de/")).unwrap());
+}
+
+#[test]
+fn backslash_escapes_a_pattern_character() {
+    let p = ipat(path_pat("/foo\\:bar"));
+    assert!(p.test(url("https://x.example/foo:bar")).unwrap());
+    assert!(!p.test(url("https://x.example/foo/anything")).unwrap());
+}
+
+#[test]
+fn result_populates_every_component_input_field() {
+    let init = UrlPatternInit {
+        protocol: Some("https".into()),
+        username: Some("user".into()),
+        password: Some("pw".into()),
+        hostname: Some("example.com".into()),
+        port: Some("8080".into()),
+        pathname: Some("/p".into()),
+        ..Default::default()
+    };
+    let r = ipat(init).exec(url("https://user:pw@example.com:8080/p")).unwrap().unwrap();
+    assert_eq!(r.protocol.input, "https");
+    assert_eq!(r.username.input, "user");
+    assert_eq!(r.password.input, "pw");
+    assert_eq!(r.hostname.input, "example.com");
+    assert_eq!(r.port.input, "8080");
+}
+
+#[test]
+fn base_url_relative_pattern_respects_trailing_slash() {
+    let with_slash = pat_base("foo/:id", "https://example.com/dir/");
+    assert_eq!(with_slash.pathname(), "/dir/foo/:id");
+    assert!(with_slash.test(url("https://example.com/dir/foo/xyz")).unwrap());
+    assert!(!with_slash.test(url("https://example.com/foo/xyz")).unwrap());
+
+    let no_slash = pat_base("foo/:id", "https://example.com/dir");
+    assert_eq!(no_slash.pathname(), "/foo/:id");
+    assert!(no_slash.test(url("https://example.com/foo/xyz")).unwrap());
+    assert!(!no_slash.test(url("https://example.com/dir/foo/xyz")).unwrap());
+}
+
+#[test]
+fn search_percent_encoding_is_canonicalized() {
+    let p = ipat(UrlPatternInit { search: Some("q=a b".into()), ..Default::default() });
+    assert_eq!(p.search(), "q=a%20b");
+    assert!(p.test(url("https://x.example/?q=a%20b")).unwrap());
+    assert!(p.test(url("https://x.example/?q=a b")).unwrap());
+}
+
+#[test]
+fn brace_grouping_without_modifier_is_required() {
+    let p = ipat(path_pat("/foo{bar}baz"));
+    assert!(p.test(path_in("/foobarbaz")).unwrap());
+    assert!(!p.test(path_in("/foobaz")).unwrap());
+}
+
+#[test]
+fn brace_grouping_with_optional_modifier_matches_with_and_without() {
+    let p = ipat(path_pat("/foo{bar}?baz"));
+    assert!(p.test(path_in("/foobarbaz")).unwrap());
+    assert!(p.test(path_in("/foobaz")).unwrap());
+}
+
+#[test]
+fn hash_result_input_omits_delimiter_and_reports_groups() {
+    let p = pat("https://ex.com/p#sec=:h");
+    let r = p.exec(url("https://ex.com/p#sec=top")).unwrap().unwrap();
+    assert_eq!(r.hash.input, "sec=top");
+    assert_eq!(group(&r.hash, "h"), Some("top"));
+}
+
+#[test]
+fn ignore_case_does_not_broaden_username() {
+    let p = ipat_ic(UrlPatternInit { username: Some("Admin".into()), ..Default::default() }, true);
+    assert!(p.test(url("https://Admin@a.com/")).unwrap());
+    assert!(!p.test(url("https://admin@a.com/")).unwrap());
+}
+
+#[test]
+fn pathname_named_group_matches_single_segment_only() {
+    let p = ipat(path_pat("/x/:a"));
+    assert!(p.test(path_in("/x/y")).unwrap());
+    assert!(!p.test(path_in("/x/y/z")).unwrap());
+}
+
+#[test]
+fn backslash_escape_does_not_form_named_group() {
+    let p = ipat(path_pat("/foo\\:bar"));
+    assert!(p.test(path_in("/foo:bar")).unwrap());
+    assert!(!p.test(path_in("/foo:other")).unwrap());
+    let r = p.exec(path_in("/foo:bar")).unwrap().unwrap();
+    assert!(r.pathname.groups.is_empty());
+}
+
+#[test]
+fn anonymous_numbering_ignores_preceding_named_group() {
+    let p = ipat(path_pat("/:a/(\\d+)"));
+    let r = p.exec(path_in("/x/12")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "a"), Some("x"));
+    assert_eq!(group(&r.pathname, "0"), Some("12"));
+    assert!(!r.pathname.groups.contains_key("1"));
+}
+
+#[test]
+fn malformed_match_input_is_non_match() {
+    let p = ipat(path_pat("/x"));
+    let bad = UrlPatternMatchInput::Init(UrlPatternInit {
+        hostname: Some("a b".into()),
+        pathname: Some("/x".into()),
+        ..Default::default()
+    });
+    assert_eq!(p.exec(bad).unwrap(), None);
+}
+
+#[test]
+fn pathname_encodes_caret_like_url_model() {
+    let p = ipat(path_pat("/a^b"));
+    assert_eq!(p.pathname(), "/a%5Eb");
+    assert!(p.test(url("https://x.example/a^b")).unwrap());
+    assert!(p.test(url("https://x.example/a%5Eb")).unwrap());
+}
+
+#[test]
+fn one_or_more_group_captures_all_segments() {
+    let p = ipat(path_pat("/x/:part+"));
+    let r = p.exec(path_in("/x/a/b/c")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "part"), Some("a/b/c"));
+    assert!(!p.test(path_in("/x")).unwrap());
+}
+
+#[test]
+fn zero_or_more_group_captures_all_segments() {
+    let p = ipat(path_pat("/x/:part*"));
+    let r = p.exec(path_in("/x/a/b")).unwrap().unwrap();
+    assert_eq!(group(&r.pathname, "part"), Some("a/b"));
+}
