new file mode 100644
index 0000000..d7e8587
--- /dev/null
+++ b/urlpattern/src/parser.rs
@@ -0,0 +1,345 @@
+//! Pattern-string parser: turns a component pattern into a list of [`Part`]s.
+//! Ref: <https://urlpattern.spec.whatwg.org/#pattern-string>
+
+use crate::error::ParserError;
+use crate::tokenizer::{tokenize, Token, TokenType, TokenizePolicy};
+use crate::UrlPatternError;
+
+pub const FULL_WILDCARD_REGEXP_VALUE: &str = ".*";
+
+#[derive(Debug, Clone)]
+pub struct Options {
+    pub delimiter_code_point: Option<char>,
+    pub prefix_code_point: Option<char>,
+    pub ignore_case: bool,
+}
+
+impl Default for Options {
+    fn default() -> Self {
+        Options {
+            delimiter_code_point: None,
+            prefix_code_point: None,
+            ignore_case: false,
+        }
+    }
+}
+
+impl Options {
+    pub fn hostname() -> Self {
+        Options {
+            delimiter_code_point: Some('.'),
+            prefix_code_point: None,
+            ignore_case: false,
+        }
+    }
+
+    pub fn pathname() -> Self {
+        Options {
+            delimiter_code_point: Some('/'),
+            prefix_code_point: Some('/'),
+            ignore_case: false,
+        }
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#escape-a-regexp-string>
+    pub fn escape_regexp_string(&self, input: &str) -> String {
+        debug_assert!(input.is_ascii());
+        let mut result = String::new();
+        for c in input.chars() {
+            if matches!(
+                c,
+                '.' | '+' | '*' | '?' | '^' | '$' | '{' | '}' | '(' | ')' | '[' | ']' | '|' | '/' | '\\'
+            ) {
+                result.push('\\');
+            }
+            result.push(c);
+        }
+        result
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#generate-a-segment-wildcard-regexp>
+    pub fn segment_wildcard_regexp(&self) -> String {
+        match self.delimiter_code_point {
+            Some(c) => {
+                let mut buf = [0u8; 4];
+                format!("[^{}]+?", self.escape_regexp_string(c.encode_utf8(&mut buf)))
+            }
+            // Deviation from spec: rust-regex has no empty negated class.
+            None => ".+?".to_owned(),
+        }
+    }
+
+    pub fn prefix_string(&self) -> String {
+        match self.prefix_code_point {
+            Some(c) => c.to_string(),
+            None => String::new(),
+        }
+    }
+}
+
+#[derive(Debug, Eq, PartialEq)]
+pub enum PartType {
+    FixedText,
+    Regexp,
+    SegmentWildcard,
+    FullWildcard,
+}
+
+#[derive(Debug, Eq, PartialEq, Clone, Copy)]
+pub enum PartModifier {
+    None,
+    Optional,
+    ZeroOrMore,
+    OneOrMore,
+}
+
+impl std::fmt::Display for PartModifier {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.write_str(match self {
+            PartModifier::None => "",
+            PartModifier::Optional => "?",
+            PartModifier::ZeroOrMore => "*",
+            PartModifier::OneOrMore => "+",
+        })
+    }
+}
+
+#[derive(Debug)]
+pub struct Part {
+    pub kind: PartType,
+    pub value: String,
+    pub modifier: PartModifier,
+    pub name: String,
+    pub prefix: String,
+    pub suffix: String,
+}
+
+impl Part {
+    fn fixed(value: String, modifier: PartModifier) -> Self {
+        Part {
+            kind: PartType::FixedText,
+            value,
+            modifier,
+            name: String::new(),
+            prefix: String::new(),
+            suffix: String::new(),
+        }
+    }
+}
+
+struct PatternParser<'a, F>
+where
+    F: Fn(&str) -> Result<String, UrlPatternError>,
+{
+    tokens: Vec<Token<'a>>,
+    encoding_callback: F,
+    segment_wildcard_regexp: String,
+    parts: Vec<Part>,
+    pending_fixed_value: String,
+    index: usize,
+    next_numeric_name: usize,
+}
+
+impl<'a, F> PatternParser<'a, F>
+where
+    F: Fn(&str) -> Result<String, UrlPatternError>,
+{
+    fn try_consume(&mut self, kind: TokenType) -> Option<Token<'a>> {
+        let token = self.tokens[self.index].clone();
+        if token.kind != kind {
+            None
+        } else {
+            self.index += 1;
+            Some(token)
+        }
+    }
+
+    fn try_consume_regexp_or_wildcard(&mut self, name_is_none: bool) -> Option<Token<'a>> {
+        let token = self.try_consume(TokenType::Regexp);
+        if name_is_none && token.is_none() {
+            self.try_consume(TokenType::Asterisk)
+        } else {
+            token
+        }
+    }
+
+    fn try_consume_modifier(&mut self) -> Option<Token<'a>> {
+        self.try_consume(TokenType::OtherModifier)
+            .or_else(|| self.try_consume(TokenType::Asterisk))
+    }
+
+    fn maybe_add_fixed(&mut self) -> Result<(), UrlPatternError> {
+        if self.pending_fixed_value.is_empty() {
+            return Ok(());
+        }
+        let encoded = (self.encoding_callback)(&self.pending_fixed_value)?;
+        self.pending_fixed_value.clear();
+        self.parts
+            .push(Part::fixed(encoded, PartModifier::None));
+        Ok(())
+    }
+
+    fn consume_text(&mut self) -> String {
+        let mut result = String::new();
+        loop {
+            let token = self
+                .try_consume(TokenType::Char)
+                .or_else(|| self.try_consume(TokenType::EscapedChar));
+            match token {
+                Some(token) => result.push_str(token.value),
+                None => break,
+            }
+        }
+        result
+    }
+
+    fn consume_required(&mut self, kind: TokenType) -> Result<Token<'_>, UrlPatternError> {
+        self.try_consume(kind.clone()).ok_or_else(|| {
+            UrlPatternError::Parser(ParserError::ExpectedToken(
+                kind,
+                self.tokens[self.index].kind.clone(),
+                self.tokens[self.index].value.to_owned(),
+            ))
+        })
+    }
+
+    fn is_duplicate_name(&self, name: &str) -> bool {
+        self.parts.iter().any(|p| p.name == name)
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn add_part(
+        &mut self,
+        prefix: &str,
+        name_token: Option<Token>,
+        regexp_or_wildcard: Option<Token>,
+        suffix: &str,
+        modifier_token: Option<Token>,
+    ) -> Result<(), UrlPatternError> {
+        let modifier = match modifier_token.as_ref().map(|t| t.value) {
+            Some("?") => PartModifier::Optional,
+            Some("*") => PartModifier::ZeroOrMore,
+            Some("+") => PartModifier::OneOrMore,
+            None => PartModifier::None,
+            _ => unreachable!(),
+        };
+
+        if name_token.is_none() && regexp_or_wildcard.is_none() && modifier == PartModifier::None {
+            self.pending_fixed_value.push_str(prefix);
+            return Ok(());
+        }
+        self.maybe_add_fixed()?;
+        if name_token.is_none() && regexp_or_wildcard.is_none() {
+            debug_assert!(suffix.is_empty());
+            if prefix.is_empty() {
+                return Ok(());
+            }
+            let encoded = (self.encoding_callback)(prefix)?;
+            self.parts.push(Part::fixed(encoded, modifier));
+            return Ok(());
+        }
+
+        let mut regexp_value = match &regexp_or_wildcard {
+            None => self.segment_wildcard_regexp.clone(),
+            Some(token) if token.kind == TokenType::Asterisk => {
+                FULL_WILDCARD_REGEXP_VALUE.to_owned()
+            }
+            Some(token) => token.value.to_owned(),
+        };
+
+        let mut kind = PartType::Regexp;
+        if regexp_value == self.segment_wildcard_regexp {
+            kind = PartType::SegmentWildcard;
+            regexp_value = String::new();
+        } else if regexp_value == FULL_WILDCARD_REGEXP_VALUE {
+            kind = PartType::FullWildcard;
+            regexp_value = String::new();
+        }
+
+        let name = if let Some(name_token) = name_token {
+            name_token.value.to_owned()
+        } else if regexp_or_wildcard.is_some() {
+            let n = self.next_numeric_name.to_string();
+            self.next_numeric_name += 1;
+            n
+        } else {
+            String::new()
+        };
+        if self.is_duplicate_name(&name) {
+            return Err(UrlPatternError::Parser(ParserError::DuplicateName(name)));
+        }
+        let encoded_prefix = (self.encoding_callback)(prefix)?;
+        let encoded_suffix = (self.encoding_callback)(suffix)?;
+        self.parts.push(Part {
+            kind,
+            value: regexp_value,
+            modifier,
+            name,
+            prefix: encoded_prefix,
+            suffix: encoded_suffix,
+        });
+        Ok(())
+    }
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#parse-a-pattern-string>
+pub fn parse_pattern_string<F>(
+    input: &str,
+    options: &Options,
+    encoding_callback: F,
+) -> Result<Vec<Part>, UrlPatternError>
+where
+    F: Fn(&str) -> Result<String, UrlPatternError>,
+{
+    let tokens = tokenize(input, TokenizePolicy::Strict)?;
+    let mut parser = PatternParser {
+        tokens,
+        encoding_callback,
+        segment_wildcard_regexp: options.segment_wildcard_regexp(),
+        parts: Vec::new(),
+        pending_fixed_value: String::new(),
+        index: 0,
+        next_numeric_name: 0,
+    };
+    let prefix_string = options.prefix_string();
+
+    while parser.index < parser.tokens.len() {
+        let char_token = parser.try_consume(TokenType::Char);
+        let mut name_token = parser.try_consume(TokenType::Name);
+        let mut regexp_or_wildcard =
+            parser.try_consume_regexp_or_wildcard(name_token.is_none());
+        if name_token.is_some() || regexp_or_wildcard.is_some() {
+            let mut prefix = char_token.map(|t| t.value.to_owned()).unwrap_or_default();
+            if !prefix.is_empty() && prefix != prefix_string {
+                parser.pending_fixed_value.push_str(&prefix);
+                prefix.clear();
+            }
+            parser.maybe_add_fixed()?;
+            let modifier_token = parser.try_consume_modifier();
+            parser.add_part(&prefix, name_token, regexp_or_wildcard, "", modifier_token)?;
+            continue;
+        }
+        let mut fixed_token = char_token;
+        if fixed_token.is_none() {
+            fixed_token = parser.try_consume(TokenType::EscapedChar);
+        }
+        if let Some(fixed_token) = fixed_token {
+            parser.pending_fixed_value.push_str(fixed_token.value);
+            continue;
+        }
+        if parser.try_consume(TokenType::Open).is_some() {
+            let prefix = parser.consume_text();
+            name_token = parser.try_consume(TokenType::Name);
+            regexp_or_wildcard = parser.try_consume_regexp_or_wildcard(name_token.is_none());
+            let suffix = parser.consume_text();
+            parser.consume_required(TokenType::Close)?;
+            let modifier_token = parser.try_consume_modifier();
+            parser.add_part(&prefix, name_token, regexp_or_wildcard, &suffix, modifier_token)?;
+            continue;
+        }
+        parser.maybe_add_fixed()?;
+        parser.consume_required(TokenType::End)?;
+    }
+
+    Ok(parser.parts)
+}
