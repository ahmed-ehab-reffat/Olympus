+++ b/urlpattern/src/tokenizer.rs
@@ -0,0 +1,268 @@
+//! Tokenizer for URLPattern pattern strings.
+//! Ref: <https://urlpattern.spec.whatwg.org/#tokenizing>
+
+use icu_properties::props::{IdContinue, IdStart};
+use icu_properties::CodePointSetDataBorrowed;
+
+use crate::error::TokenizerError;
+use crate::UrlPatternError;
+
+#[derive(Debug, Clone, Eq, PartialEq)]
+pub enum TokenType {
+    Open,
+    Close,
+    Regexp,
+    Name,
+    Char,
+    EscapedChar,
+    OtherModifier,
+    Asterisk,
+    End,
+    InvalidChar,
+}
+
+#[derive(Debug, Clone)]
+pub struct Token<'a> {
+    pub kind: TokenType,
+    pub index: usize,
+    pub value: &'a str,
+}
+
+#[derive(Debug, Eq, PartialEq)]
+pub enum TokenizePolicy {
+    Strict,
+    Lenient,
+}
+
+struct Tokenizer<'a> {
+    input: &'a str,
+    policy: TokenizePolicy,
+    tokens: Vec<Token<'a>>,
+    index: usize,
+    next_index: usize,
+    code_point: char,
+}
+
+impl<'a> Tokenizer<'a> {
+    fn get_next_code_point(&mut self) {
+        let c = self.input[self.next_index..].chars().next().unwrap();
+        self.code_point = c;
+        self.next_index += c.len_utf8();
+    }
+
+    fn seek(&mut self, index: usize) {
+        self.next_index = index;
+        self.get_next_code_point();
+    }
+
+    fn push(&mut self, kind: TokenType, next_pos: usize, value_pos: usize, len: usize) {
+        let value = &self.input[value_pos..value_pos + len];
+        self.tokens.push(Token {
+            kind,
+            index: self.index,
+            value,
+        });
+        self.index = next_pos;
+    }
+
+    fn push_default_len(&mut self, kind: TokenType, next_pos: usize, value_pos: usize) {
+        self.push(kind, next_pos, value_pos, next_pos - value_pos);
+    }
+
+    fn push_here(&mut self, kind: TokenType) {
+        self.push_default_len(kind, self.next_index, self.index);
+    }
+
+    fn tokenizing_error(
+        &mut self,
+        next_pos: usize,
+        value_pos: usize,
+        error: TokenizerError,
+    ) -> Result<(), UrlPatternError> {
+        if self.policy == TokenizePolicy::Strict {
+            Err(UrlPatternError::Tokenizer(error, value_pos))
+        } else {
+            self.push_default_len(TokenType::InvalidChar, next_pos, value_pos);
+            Ok(())
+        }
+    }
+}
+
+pub fn tokenize(
+    input: &str,
+    policy: TokenizePolicy,
+) -> Result<Vec<Token<'_>>, UrlPatternError> {
+    let mut t = Tokenizer {
+        input,
+        policy,
+        tokens: Vec::new(),
+        index: 0,
+        next_index: 0,
+        code_point: '\0',
+    };
+
+    while t.index < t.input.len() {
+        t.seek(t.index);
+        match t.code_point {
+            '*' => {
+                t.push_here(TokenType::Asterisk);
+                continue;
+            }
+            '+' | '?' => {
+                t.push_here(TokenType::OtherModifier);
+                continue;
+            }
+            '\\' => {
+                if t.index == t.input.len() - 1 {
+                    t.tokenizing_error(
+                        t.next_index,
+                        t.index,
+                        TokenizerError::IncompleteEscapeCode,
+                    )?;
+                    continue;
+                }
+                let escaped = t.next_index;
+                t.get_next_code_point();
+                t.push_default_len(TokenType::EscapedChar, t.next_index, escaped);
+                continue;
+            }
+            '\n' | '\r' | '\t' => {
+                t.index = t.next_index;
+                continue;
+            }
+            '{' => {
+                t.push_here(TokenType::Open);
+                continue;
+            }
+            '}' => {
+                t.push_here(TokenType::Close);
+                continue;
+            }
+            ':' => {
+                let name_start = t.next_index;
+                let mut name_pos = name_start;
+                while name_pos < t.input.len() {
+                    t.seek(name_pos);
+                    let first = name_pos == name_start;
+                    if !is_valid_name_code_point(t.code_point, first) {
+                        break;
+                    }
+                    name_pos = t.next_index;
+                }
+                if name_pos <= name_start {
+                    t.tokenizing_error(name_start, t.index, TokenizerError::InvalidName)?;
+                    continue;
+                }
+                t.push_default_len(TokenType::Name, name_pos, name_start);
+                continue;
+            }
+            '(' => {
+                tokenize_regexp(&mut t)?;
+                continue;
+            }
+            _ => {
+                t.push_here(TokenType::Char);
+            }
+        }
+    }
+    t.push_default_len(TokenType::End, t.index, t.index);
+    Ok(t.tokens)
+}
+
+fn tokenize_regexp(t: &mut Tokenizer) -> Result<(), UrlPatternError> {
+    let mut depth = 1usize;
+    let regexp_start = t.next_index;
+    let mut regexp_pos = regexp_start;
+    while regexp_pos < t.input.len() {
+        t.seek(regexp_pos);
+        if !t.code_point.is_ascii() || (regexp_pos == regexp_start && t.code_point == '?') {
+            t.tokenizing_error(
+                regexp_start,
+                t.index,
+                TokenizerError::InvalidRegex("must not start with ?, and may only contain ascii"),
+            )?;
+            return Ok(());
+        }
+        if t.code_point == '\\' {
+            if regexp_pos == t.input.len() - 1 {
+                t.tokenizing_error(
+                    regexp_start,
+                    t.index,
+                    TokenizerError::IncompleteEscapeCode,
+                )?;
+                return Ok(());
+            }
+            t.get_next_code_point();
+            if !t.code_point.is_ascii() {
+                t.tokenizing_error(
+                    regexp_start,
+                    t.index,
+                    TokenizerError::InvalidRegex("non ascii character was escaped"),
+                )?;
+                return Ok(());
+            }
+            regexp_pos = t.next_index;
+            continue;
+        }
+        if t.code_point == ')' {
+            depth -= 1;
+            if depth == 0 {
+                regexp_pos = t.next_index;
+                break;
+            }
+        } else if t.code_point == '(' {
+            depth += 1;
+            if regexp_pos == t.input.len() - 1 {
+                t.tokenizing_error(
+                    regexp_start,
+                    t.index,
+                    TokenizerError::InvalidRegex("nested groups not closed"),
+                )?;
+                return Ok(());
+            }
+            let temp_pos = t.next_index;
+            t.get_next_code_point();
+            if t.code_point != '?' {
+                t.tokenizing_error(
+                    regexp_start,
+                    t.index,
+                    TokenizerError::InvalidRegex("nested groups must start with ?"),
+                )?;
+                return Ok(());
+            }
+            t.next_index = temp_pos;
+        }
+        regexp_pos = t.next_index;
+    }
+    if depth != 0 {
+        t.tokenizing_error(
+            regexp_start,
+            t.index,
+            TokenizerError::InvalidRegex("missing closing )"),
+        )?;
+        return Ok(());
+    }
+    let regexp_len = regexp_pos - regexp_start - 1;
+    if regexp_len == 0 {
+        t.tokenizing_error(
+            regexp_start,
+            t.index,
+            TokenizerError::InvalidRegex("length must be > 0"),
+        )?;
+        return Ok(());
+    }
+    t.push(TokenType::Regexp, regexp_pos, regexp_start, regexp_len);
+    Ok(())
+}
+
+static ID_START: CodePointSetDataBorrowed<'_> = CodePointSetDataBorrowed::new::<IdStart>();
+static ID_CONTINUE: CodePointSetDataBorrowed<'_> = CodePointSetDataBorrowed::new::<IdContinue>();
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#is-a-valid-name-code-point>
+pub(crate) fn is_valid_name_code_point(c: char, first: bool) -> bool {
+    if first {
+        ID_START.contains(c) || matches!(c, '$' | '_')
+    } else {
+        ID_CONTINUE.contains(c) || matches!(c, '$' | '\u{200C}' | '\u{200D}')
+    }
+}
