diff --git a/urlpattern/src/canonicalize.rs b/urlpattern/src/canonicalize.rs
new file mode 100644
index 0000000..0aebe5f
--- /dev/null
+++ b/urlpattern/src/canonicalize.rs
@@ -0,0 +1,243 @@
+//! Per-component canonicalization callbacks plus init-processing helpers.
+//! Each of the eight URL components is canonicalized through rust-url so that a
+//! pattern's fixed text matches what `url::Url` would produce.
+//! Ref: <https://urlpattern.spec.whatwg.org/#canon-encoding-callbacks>
+
+use crate::UrlPatternError;
+
+fn url_err(e: url::ParseError) -> UrlPatternError {
+    UrlPatternError::Url(e)
+}
+
+pub fn canonicalize_protocol(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    url::Url::parse(&format!("{value}://dummy.test"))
+        .map(|url| url.scheme().to_owned())
+        .map_err(url_err)
+}
+
+pub fn canonicalize_username(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let mut url = url::Url::parse("http://dummy.test").unwrap();
+    url.set_username(value)
+        .map_err(|_| url_err(url::ParseError::InvalidDomainCharacter))?;
+    Ok(url.username().to_owned())
+}
+
+pub fn canonicalize_password(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let mut url = url::Url::parse("http://dummy.test").unwrap();
+    url.set_password(Some(value))
+        .map_err(|_| url_err(url::ParseError::InvalidDomainCharacter))?;
+    Ok(url.password().unwrap_or("").to_owned())
+}
+
+pub fn canonicalize_hostname(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let mut url = url::Url::parse("http://dummy.test").unwrap();
+    url::quirks::set_hostname(&mut url, value)
+        .map_err(|_| url_err(url::ParseError::InvalidDomainCharacter))?;
+    Ok(url::quirks::hostname(&url).to_owned())
+}
+
+pub fn canonicalize_ipv6_hostname(value: &str) -> Result<String, UrlPatternError> {
+    let valid = value
+        .chars()
+        .all(|c| c.is_ascii_hexdigit() || matches!(c, '[' | ']' | ':'));
+    if !valid {
+        Err(url_err(url::ParseError::InvalidIpv6Address))
+    } else {
+        Ok(value.to_ascii_lowercase())
+    }
+}
+
+pub fn canonicalize_port(value: &str, protocol: Option<&str>) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let protocol = match protocol {
+        Some("") | None => "dummy",
+        Some(p) => p,
+    };
+    let mut url = url::Url::parse(&format!("{protocol}://dummy.test")).unwrap();
+    url::quirks::set_port(&mut url, value)
+        .map_err(|_| url_err(url::ParseError::InvalidPort))?;
+    Ok(url::quirks::port(&url).to_owned())
+}
+
+pub fn canonicalize_pathname(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let leading_slash = value.starts_with('/');
+    let modified = if leading_slash {
+        value.to_owned()
+    } else {
+        format!("/-{value}")
+    };
+    let mut url = url::Url::parse("http://dummy.test").unwrap();
+    url.set_path(&modified);
+    let mut pathname = url::quirks::pathname(&url);
+    if !leading_slash && pathname.starts_with("/-") {
+        pathname = &pathname[2..];
+    }
+    Ok(pathname.to_owned())
+}
+
+pub fn canonicalize_opaque_pathname(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let mut url = url::Url::parse("data:dummy,test").unwrap();
+    url.set_path(value);
+    Ok(url::quirks::pathname(&url).to_owned())
+}
+
+pub fn canonicalize_search(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let mut url = url::Url::parse("http://dummy.test").unwrap();
+    url.set_query(Some(value));
+    Ok(url.query().unwrap_or("").to_owned())
+}
+
+pub fn canonicalize_hash(value: &str) -> Result<String, UrlPatternError> {
+    if value.is_empty() {
+        return Ok(String::new());
+    }
+    let mut url = url::Url::parse("http://dummy.test").unwrap();
+    url.set_fragment(Some(value));
+    Ok(url.fragment().unwrap_or("").to_owned())
+}
+
+#[derive(Debug, Eq, PartialEq, Clone, Copy)]
+pub enum ProcessType {
+    Pattern,
+    Url,
+}
+
+pub fn process_protocol_init(value: &str, kind: ProcessType) -> Result<String, UrlPatternError> {
+    let stripped = value.strip_suffix(':').unwrap_or(value);
+    if kind == ProcessType::Pattern {
+        Ok(stripped.to_owned())
+    } else {
+        canonicalize_protocol(stripped)
+    }
+}
+
+pub fn process_username_init(value: &str, kind: ProcessType) -> Result<String, UrlPatternError> {
+    if kind == ProcessType::Pattern {
+        Ok(value.to_owned())
+    } else {
+        canonicalize_username(value)
+    }
+}
+
+pub fn process_password_init(value: &str, kind: ProcessType) -> Result<String, UrlPatternError> {
+    if kind == ProcessType::Pattern {
+        Ok(value.to_owned())
+    } else {
+        canonicalize_password(value)
+    }
+}
+
+pub fn process_hostname_init(value: &str, kind: ProcessType) -> Result<String, UrlPatternError> {
+    if kind == ProcessType::Pattern {
+        Ok(value.to_owned())
+    } else {
+        canonicalize_hostname(value)
+    }
+}
+
+pub fn process_port_init(
+    port: &str,
+    protocol: Option<&str>,
+    kind: ProcessType,
+) -> Result<String, UrlPatternError> {
+    if kind == ProcessType::Pattern {
+        Ok(port.to_owned())
+    } else {
+        canonicalize_port(port, protocol)
+    }
+}
+
+pub fn process_pathname_init(
+    pathname: &str,
+    protocol: Option<&str>,
+    kind: ProcessType,
+) -> Result<String, UrlPatternError> {
+    if kind == ProcessType::Pattern {
+        return Ok(pathname.to_owned());
+    }
+    let non_opaque = match protocol {
+        Some(p) if p.is_empty() || is_special_scheme(p) => true,
+        _ => pathname.starts_with('/'),
+    };
+    if non_opaque {
+        canonicalize_pathname(pathname)
+    } else {
+        canonicalize_opaque_pathname(pathname)
+    }
+}
+
+pub fn process_search_init(value: &str, kind: ProcessType) -> Result<String, UrlPatternError> {
+    let stripped = value.strip_prefix('?').unwrap_or(value);
+    if kind == ProcessType::Pattern {
+        Ok(stripped.to_owned())
+    } else {
+        canonicalize_search(stripped)
+    }
+}
+
+pub fn process_hash_init(value: &str, kind: ProcessType) -> Result<String, UrlPatternError> {
+    let stripped = value.strip_prefix('#').unwrap_or(value);
+    if kind == ProcessType::Pattern {
+        Ok(stripped.to_owned())
+    } else {
+        canonicalize_hash(stripped)
+    }
+}
+
+pub fn is_special_scheme(scheme: &str) -> bool {
+    matches!(scheme, "http" | "https" | "ws" | "wss" | "ftp" | "file")
+}
+
+pub fn special_scheme_default_port(scheme: &str) -> Option<&'static str> {
+    match scheme {
+        "http" | "ws" => Some("80"),
+        "https" | "wss" => Some("443"),
+        "ftp" => Some("21"),
+        _ => None,
+    }
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#process-a-base-url-string>
+pub fn process_base_url(input: &str, kind: ProcessType) -> String {
+    if kind == ProcessType::Pattern {
+        escape_pattern_string(input)
+    } else {
+        input.to_owned()
+    }
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#escape-a-pattern-string>
+pub fn escape_pattern_string(input: &str) -> String {
+    debug_assert!(input.is_ascii());
+    let mut result = String::new();
+    for c in input.chars() {
+        if matches!(c, '+' | '*' | '?' | ':' | '{' | '}' | '(' | ')' | '\\') {
+            result.push('\\');
+        }
+        result.push(c);
+    }
+    result
+}
diff --git a/urlpattern/src/component.rs b/urlpattern/src/component.rs
new file mode 100644
index 0000000..24a3efe
--- /dev/null
+++ b/urlpattern/src/component.rs
@@ -0,0 +1,248 @@
+//! A compiled URLPattern component: its part list, canonical pattern string,
+//! and the anchored regex used to match one URL component.
+//! Ref: <https://urlpattern.spec.whatwg.org/#compile-a-component>
+
+use std::collections::HashMap;
+use std::fmt::Write;
+
+use regex::Regex;
+
+use crate::canonicalize::escape_pattern_string;
+use crate::parser::{
+    parse_pattern_string, Options, Part, PartModifier, PartType, FULL_WILDCARD_REGEXP_VALUE,
+};
+use crate::tokenizer::is_valid_name_code_point;
+use crate::{UrlPatternComponentResult, UrlPatternError};
+
+#[derive(Debug)]
+pub struct Component {
+    pub pattern_string: String,
+    pub regexp: Regex,
+    pub group_name_list: Vec<String>,
+    pub has_regexp_group: bool,
+}
+
+impl Component {
+    pub fn compile<F>(
+        input: Option<&str>,
+        encoding_callback: F,
+        options: Options,
+    ) -> Result<Self, UrlPatternError>
+    where
+        F: Fn(&str) -> Result<String, UrlPatternError>,
+    {
+        let part_list = parse_pattern_string(input.unwrap_or("*"), &options, encoding_callback)?;
+        let (regexp_string, name_list) = generate_regexp_and_name_list(&part_list, &options);
+        let regexp = regex::RegexBuilder::new(&regexp_string)
+            .case_insensitive(options.ignore_case)
+            .build()
+            .map_err(|e| UrlPatternError::RegExp(e.to_string()))?;
+        let pattern_string = generate_pattern_string(&part_list, &options);
+        let has_regexp_group = part_list.iter().any(|p| p.kind == PartType::Regexp);
+        Ok(Component {
+            pattern_string,
+            regexp,
+            group_name_list: name_list,
+            has_regexp_group,
+        })
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#protocol-component-matches-a-special-scheme>
+    pub fn protocol_component_matches_special_scheme(&self) -> bool {
+        const SPECIAL: [&str; 6] = ["ftp", "file", "http", "https", "ws", "wss"];
+        SPECIAL.iter().any(|s| self.regexp.is_match(s))
+    }
+
+    /// Run the compiled regex; on success return the ordered capture groups
+    /// (excluding the whole match), each `None` if the group did not participate.
+    pub fn matches<'a>(&self, input: &'a str) -> Option<Vec<Option<&'a str>>> {
+        let captures = self.regexp.captures(input)?;
+        Some(
+            captures
+                .iter()
+                .skip(1)
+                .map(|c| c.map(|m| m.as_str()))
+                .collect(),
+        )
+    }
+
+    pub fn create_match_result(
+        &self,
+        input: String,
+        exec_result: Vec<Option<&str>>,
+    ) -> UrlPatternComponentResult {
+        let groups: HashMap<String, Option<String>> = self
+            .group_name_list
+            .iter()
+            .cloned()
+            .zip(exec_result.into_iter().map(|s| s.map(str::to_owned)))
+            .collect();
+        UrlPatternComponentResult { input, groups }
+    }
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#generate-a-regular-expression-and-name-list>
+fn generate_regexp_and_name_list(part_list: &[Part], options: &Options) -> (String, Vec<String>) {
+    let mut result = String::from("^");
+    let mut name_list = Vec::new();
+    for part in part_list {
+        if part.kind == PartType::FixedText {
+            if part.modifier == PartModifier::None {
+                result.push_str(&options.escape_regexp_string(&part.value));
+            } else {
+                write!(
+                    result,
+                    "(?:{}){}",
+                    options.escape_regexp_string(&part.value),
+                    part.modifier
+                )
+                .unwrap();
+            }
+            continue;
+        }
+
+        debug_assert!(!part.name.is_empty());
+        name_list.push(part.name.clone());
+        let regexp_value = match part.kind {
+            PartType::SegmentWildcard => options.segment_wildcard_regexp(),
+            PartType::FullWildcard => FULL_WILDCARD_REGEXP_VALUE.to_owned(),
+            _ => part.value.clone(),
+        };
+
+        if part.prefix.is_empty() && part.suffix.is_empty() {
+            if matches!(part.modifier, PartModifier::None | PartModifier::Optional) {
+                write!(result, "({}){}", regexp_value, part.modifier).unwrap();
+            } else {
+                write!(result, "((?:{}){})", regexp_value, part.modifier).unwrap();
+            }
+            continue;
+        }
+        if matches!(part.modifier, PartModifier::None | PartModifier::Optional) {
+            write!(
+                result,
+                "(?:{}({}){}){}",
+                options.escape_regexp_string(&part.prefix),
+                regexp_value,
+                options.escape_regexp_string(&part.suffix),
+                part.modifier
+            )
+            .unwrap();
+            continue;
+        }
+        write!(
+            result,
+            "(?:{}((?:{})(?:{}{}(?:{}))*){}){}",
+            options.escape_regexp_string(&part.prefix),
+            regexp_value,
+            options.escape_regexp_string(&part.suffix),
+            options.escape_regexp_string(&part.prefix),
+            regexp_value,
+            options.escape_regexp_string(&part.suffix),
+            if part.modifier == PartModifier::ZeroOrMore {
+                "?"
+            } else {
+                ""
+            }
+        )
+        .unwrap();
+    }
+    result.push('$');
+    (result, name_list)
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#generate-a-pattern-string>
+fn generate_pattern_string(part_list: &[Part], options: &Options) -> String {
+    let prefix_string = options.prefix_string();
+    let mut result = String::new();
+    for (i, part) in part_list.iter().enumerate() {
+        let prev_part = if i == 0 { None } else { part_list.get(i - 1) };
+        let next_part = part_list.get(i + 1);
+        if part.kind == PartType::FixedText {
+            if part.modifier == PartModifier::None {
+                result.push_str(&escape_pattern_string(&part.value));
+            } else {
+                write!(
+                    result,
+                    "{{{}}}{}",
+                    escape_pattern_string(&part.value),
+                    part.modifier
+                )
+                .unwrap();
+            }
+            continue;
+        }
+        let custom_name = !part.name.chars().next().unwrap().is_ascii_digit();
+        let mut needs_grouping = !part.suffix.is_empty()
+            || (!part.prefix.is_empty() && part.prefix != prefix_string);
+        if !needs_grouping
+            && custom_name
+            && part.kind == PartType::SegmentWildcard
+            && part.modifier == PartModifier::None
+            && matches!(next_part, Some(Part { prefix, suffix, .. }) if prefix.is_empty() && suffix.is_empty())
+        {
+            let next_part = next_part.unwrap();
+            if next_part.kind == PartType::FixedText {
+                needs_grouping = is_valid_name_code_point(
+                    next_part.value.chars().next().unwrap_or_default(),
+                    false,
+                );
+            } else {
+                needs_grouping = next_part.name.chars().next().unwrap().is_ascii_digit();
+            }
+        }
+        if !needs_grouping
+            && part.prefix.is_empty()
+            && matches!(
+                prev_part,
+                Some(Part { kind: PartType::FixedText, value, .. })
+                    if !value.is_empty()
+                        && value.chars().last().unwrap().to_string() == prefix_string
+            )
+        {
+            needs_grouping = true;
+        }
+        debug_assert!(!part.name.is_empty());
+        if needs_grouping {
+            result.push('{');
+        }
+        result.push_str(&escape_pattern_string(&part.prefix));
+        if custom_name {
+            result.push(':');
+            result.push_str(&part.name);
+        }
+        match part.kind {
+            PartType::FixedText => unreachable!(),
+            PartType::Regexp => write!(result, "({})", part.value).unwrap(),
+            PartType::SegmentWildcard if !custom_name => {
+                write!(result, "({})", options.segment_wildcard_regexp()).unwrap();
+            }
+            PartType::SegmentWildcard => {}
+            PartType::FullWildcard => {
+                if !custom_name
+                    && (prev_part.is_none()
+                        || prev_part.unwrap().kind == PartType::FixedText
+                        || prev_part.unwrap().modifier != PartModifier::None
+                        || needs_grouping
+                        || !part.prefix.is_empty())
+                {
+                    result.push('*');
+                } else {
+                    write!(result, "({FULL_WILDCARD_REGEXP_VALUE})").unwrap();
+                }
+            }
+        }
+        if part.kind == PartType::SegmentWildcard
+            && custom_name
+            && !part.suffix.is_empty()
+            && is_valid_name_code_point(part.suffix.chars().next().unwrap(), false)
+        {
+            result.push('\\');
+        }
+        result.push_str(&escape_pattern_string(&part.suffix));
+        if needs_grouping {
+            result.push('}');
+        }
+        write!(result, "{}", part.modifier).unwrap();
+    }
+    result
+}
diff --git a/urlpattern/src/constructor_parser.rs b/urlpattern/src/constructor_parser.rs
new file mode 100644
index 0000000..eddd703
--- /dev/null
+++ b/urlpattern/src/constructor_parser.rs
@@ -0,0 +1,358 @@
+//! Splits a URLPattern constructor string into a [`UrlPatternInit`] with the
+//! eight components filled in per the spec's delimiter rules.
+//! Ref: <https://urlpattern.spec.whatwg.org/#constructor-string-parser>
+
+use crate::canonicalize::canonicalize_protocol;
+use crate::component::Component;
+use crate::parser::Options;
+use crate::tokenizer::{tokenize, Token, TokenType, TokenizePolicy};
+use crate::{UrlPatternError, UrlPatternInit};
+
+#[derive(Debug, Eq, PartialEq, Clone, Copy)]
+enum State {
+    Init,
+    Protocol,
+    Authority,
+    Username,
+    Password,
+    Hostname,
+    Port,
+    Pathname,
+    Search,
+    Hash,
+    Done,
+}
+
+struct ConstructorStringParser<'a> {
+    input: &'a str,
+    tokens: Vec<Token<'a>>,
+    result: UrlPatternInit,
+    component_start: usize,
+    token_index: usize,
+    token_increment: usize,
+    group_depth: usize,
+    ipv6_bracket_depth: usize,
+    protocol_matches_special_scheme: bool,
+    state: State,
+}
+
+impl<'a> ConstructorStringParser<'a> {
+    fn rewind(&mut self) {
+        self.token_index = self.component_start;
+        self.token_increment = 0;
+    }
+
+    fn rewind_and_set_state(&mut self, state: State) {
+        self.rewind();
+        self.state = state;
+    }
+
+    fn safe_token(&self, index: usize) -> &Token<'_> {
+        if index < self.tokens.len() {
+            &self.tokens[index]
+        } else {
+            let token = self.tokens.last().unwrap();
+            debug_assert!(token.kind == TokenType::End);
+            token
+        }
+    }
+
+    fn is_non_special_pattern_char(&self, index: usize, value: &str) -> bool {
+        let token = self.safe_token(index);
+        token.value == value
+            && matches!(
+                token.kind,
+                TokenType::Char | TokenType::EscapedChar | TokenType::InvalidChar
+            )
+    }
+
+    fn is_hash_prefix(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, "#")
+    }
+
+    fn is_protocol_suffix(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, ":")
+    }
+
+    fn is_search_prefix(&self) -> bool {
+        if self.is_non_special_pattern_char(self.token_index, "?") {
+            return true;
+        }
+        if self.tokens[self.token_index].value != "?" {
+            return false;
+        }
+        if self.token_index == 0 {
+            return true;
+        }
+        let previous = self.safe_token(self.token_index - 1);
+        !matches!(
+            previous.kind,
+            TokenType::Name | TokenType::Regexp | TokenType::Close | TokenType::Asterisk
+        )
+    }
+
+    fn is_password_prefix(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, ":")
+    }
+
+    fn is_port_prefix(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, ":")
+    }
+
+    fn is_pathname_start(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, "/")
+    }
+
+    fn is_identity_terminator(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, "@")
+    }
+
+    fn is_group_open(&self) -> bool {
+        self.tokens[self.token_index].kind == TokenType::Open
+    }
+
+    fn is_group_close(&self) -> bool {
+        self.tokens[self.token_index].kind == TokenType::Close
+    }
+
+    fn is_ipv6_open(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, "[")
+    }
+
+    fn is_ipv6_close(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index, "]")
+    }
+
+    fn next_is_authority_slashes(&self) -> bool {
+        self.is_non_special_pattern_char(self.token_index + 1, "/")
+            && self.is_non_special_pattern_char(self.token_index + 2, "/")
+    }
+
+    fn make_component_string(&self) -> String {
+        debug_assert!(self.token_index < self.tokens.len());
+        let token = &self.tokens[self.token_index];
+        let start = self.safe_token(self.component_start).index;
+        self.input[start..token.index].to_owned()
+    }
+
+    fn compute_protocol_matches_special_scheme(&mut self) -> Result<(), UrlPatternError> {
+        let protocol_string = self.make_component_string();
+        let component = Component::compile(
+            Some(&protocol_string),
+            canonicalize_protocol,
+            Options::default(),
+        )?;
+        if component.protocol_component_matches_special_scheme() {
+            self.protocol_matches_special_scheme = true;
+        }
+        Ok(())
+    }
+
+    fn change_state(&mut self, new_state: State, skip: usize) {
+        match self.state {
+            State::Protocol => self.result.protocol = Some(self.make_component_string()),
+            State::Username => self.result.username = Some(self.make_component_string()),
+            State::Password => self.result.password = Some(self.make_component_string()),
+            State::Hostname => self.result.hostname = Some(self.make_component_string()),
+            State::Port => self.result.port = Some(self.make_component_string()),
+            State::Pathname => self.result.pathname = Some(self.make_component_string()),
+            State::Search => self.result.search = Some(self.make_component_string()),
+            State::Hash => self.result.hash = Some(self.make_component_string()),
+            State::Init | State::Authority | State::Done => {}
+        }
+
+        if self.state != State::Init && new_state != State::Done {
+            if matches!(
+                self.state,
+                State::Protocol | State::Authority | State::Username | State::Password
+            ) && matches!(
+                new_state,
+                State::Port | State::Pathname | State::Search | State::Hash
+            ) && self.result.hostname.is_none()
+            {
+                self.result.hostname = Some(String::new());
+            }
+
+            if matches!(
+                self.state,
+                State::Protocol
+                    | State::Authority
+                    | State::Username
+                    | State::Password
+                    | State::Hostname
+                    | State::Port
+            ) && matches!(new_state, State::Search | State::Hash)
+                && self.result.pathname.is_none()
+            {
+                self.result.pathname = Some(if self.protocol_matches_special_scheme {
+                    String::from("/")
+                } else {
+                    String::new()
+                });
+            }
+
+            if matches!(
+                self.state,
+                State::Protocol
+                    | State::Authority
+                    | State::Username
+                    | State::Password
+                    | State::Hostname
+                    | State::Port
+                    | State::Pathname
+            ) && new_state == State::Hash
+                && self.result.search.is_none()
+            {
+                self.result.search = Some(String::new());
+            }
+        }
+
+        self.state = new_state;
+        self.token_index += skip;
+        self.component_start = self.token_index;
+        self.token_increment = 0;
+    }
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#parse-a-constructor-string>
+pub fn parse_constructor_string(input: &str) -> Result<UrlPatternInit, UrlPatternError> {
+    let tokens = tokenize(input, TokenizePolicy::Lenient)?;
+    let mut parser = ConstructorStringParser {
+        input,
+        tokens,
+        result: UrlPatternInit::default(),
+        component_start: 0,
+        token_index: 0,
+        token_increment: 1,
+        group_depth: 0,
+        ipv6_bracket_depth: 0,
+        protocol_matches_special_scheme: false,
+        state: State::Init,
+    };
+
+    while parser.token_index < parser.tokens.len() {
+        parser.token_increment = 1;
+        if parser.tokens[parser.token_index].kind == TokenType::End {
+            if parser.state == State::Init {
+                parser.rewind();
+                if parser.is_hash_prefix() {
+                    parser.change_state(State::Hash, 1);
+                } else if parser.is_search_prefix() {
+                    parser.change_state(State::Search, 1);
+                } else {
+                    parser.change_state(State::Pathname, 0);
+                }
+                parser.token_index += parser.token_increment;
+                continue;
+            }
+            if parser.state == State::Authority {
+                parser.rewind_and_set_state(State::Hostname);
+                parser.token_index += parser.token_increment;
+                continue;
+            }
+            parser.change_state(State::Done, 0);
+            break;
+        }
+        if parser.is_group_open() {
+            parser.group_depth += 1;
+            parser.token_index += parser.token_increment;
+            continue;
+        }
+        if parser.group_depth > 0 {
+            if parser.is_group_close() {
+                parser.group_depth -= 1;
+            } else {
+                parser.token_index += parser.token_increment;
+                continue;
+            }
+        }
+        match parser.state {
+            State::Init => {
+                if parser.is_protocol_suffix() {
+                    parser.rewind_and_set_state(State::Protocol);
+                }
+            }
+            State::Protocol => {
+                if parser.is_protocol_suffix() {
+                    parser.compute_protocol_matches_special_scheme()?;
+                    let mut next_state = State::Pathname;
+                    let mut skip = 1;
+                    if parser.next_is_authority_slashes() {
+                        next_state = State::Authority;
+                        skip = 3;
+                    } else if parser.protocol_matches_special_scheme {
+                        next_state = State::Authority;
+                    }
+                    parser.change_state(next_state, skip);
+                }
+            }
+            State::Authority => {
+                if parser.is_identity_terminator() {
+                    parser.rewind_and_set_state(State::Username);
+                } else if parser.is_pathname_start()
+                    || parser.is_search_prefix()
+                    || parser.is_hash_prefix()
+                {
+                    parser.rewind_and_set_state(State::Hostname);
+                }
+            }
+            State::Username => {
+                if parser.is_password_prefix() {
+                    parser.change_state(State::Password, 1);
+                } else if parser.is_identity_terminator() {
+                    parser.change_state(State::Hostname, 1);
+                }
+            }
+            State::Password => {
+                if parser.is_identity_terminator() {
+                    parser.change_state(State::Hostname, 1);
+                }
+            }
+            State::Hostname => {
+                if parser.is_ipv6_open() {
+                    parser.ipv6_bracket_depth += 1;
+                } else if parser.is_ipv6_close() {
+                    parser.ipv6_bracket_depth -= 1;
+                } else if parser.is_port_prefix() && parser.ipv6_bracket_depth == 0 {
+                    parser.change_state(State::Port, 1);
+                } else if parser.is_pathname_start() {
+                    parser.change_state(State::Pathname, 0);
+                } else if parser.is_search_prefix() {
+                    parser.change_state(State::Search, 1);
+                } else if parser.is_hash_prefix() {
+                    parser.change_state(State::Hash, 1);
+                }
+            }
+            State::Port => {
+                if parser.is_pathname_start() {
+                    parser.change_state(State::Pathname, 0);
+                } else if parser.is_search_prefix() {
+                    parser.change_state(State::Search, 1);
+                } else if parser.is_hash_prefix() {
+                    parser.change_state(State::Hash, 1);
+                }
+            }
+            State::Pathname => {
+                if parser.is_search_prefix() {
+                    parser.change_state(State::Search, 1);
+                } else if parser.is_hash_prefix() {
+                    parser.change_state(State::Hash, 1);
+                }
+            }
+            State::Search => {
+                if parser.is_hash_prefix() {
+                    parser.change_state(State::Hash, 1);
+                }
+            }
+            State::Hash => {}
+            State::Done => unreachable!(),
+        }
+        parser.token_index += parser.token_increment;
+    }
+
+    if parser.result.hostname.is_some() && parser.result.port.is_none() {
+        parser.result.port = Some(String::new());
+    }
+
+    Ok(parser.result)
+}
diff --git a/urlpattern/src/error.rs b/urlpattern/src/error.rs
new file mode 100644
index 0000000..8e25831
--- /dev/null
+++ b/urlpattern/src/error.rs
@@ -0,0 +1,77 @@
+use std::fmt;
+
+use crate::tokenizer::TokenType;
+
+/// An error raised while constructing or matching a [`UrlPattern`](crate::UrlPattern).
+#[derive(Debug)]
+pub enum UrlPatternError {
+    /// A relative constructor string was given without a base URL.
+    BaseUrlRequired,
+    /// The tokenizer rejected the pattern at the given char offset.
+    Tokenizer(TokenizerError, usize),
+    /// The pattern parser rejected the token stream.
+    Parser(ParserError),
+    /// A component failed URL canonicalization.
+    Url(url::ParseError),
+    /// A generated component regex failed to compile.
+    RegExp(String),
+}
+
+impl fmt::Display for UrlPatternError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            UrlPatternError::BaseUrlRequired => {
+                f.write_str("a relative input without a base URL is not valid")
+            }
+            UrlPatternError::Tokenizer(err, pos) => {
+                write!(f, "tokenizer error: {err} (at char {pos})")
+            }
+            UrlPatternError::Parser(err) => write!(f, "parser error: {err}"),
+            UrlPatternError::Url(err) => err.fmt(f),
+            UrlPatternError::RegExp(msg) => write!(f, "regexp error: {msg}"),
+        }
+    }
+}
+
+impl std::error::Error for UrlPatternError {}
+
+#[derive(Debug)]
+pub enum TokenizerError {
+    IncompleteEscapeCode,
+    InvalidName,
+    InvalidRegex(&'static str),
+}
+
+impl fmt::Display for TokenizerError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::IncompleteEscapeCode => f.write_str("incomplete escape code"),
+            Self::InvalidName => f.write_str("invalid name; must be at least length 1"),
+            Self::InvalidRegex(err) => write!(f, "invalid regex: {err}"),
+        }
+    }
+}
+
+impl std::error::Error for TokenizerError {}
+
+#[derive(Debug)]
+pub enum ParserError {
+    ExpectedToken(TokenType, TokenType, String),
+    DuplicateName(String),
+}
+
+impl fmt::Display for ParserError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::ExpectedToken(expected, found, value) => write!(
+                f,
+                "expected token {expected:?}, found '{value}' of type {found:?}"
+            ),
+            Self::DuplicateName(name) => {
+                write!(f, "pattern contains duplicate name {name}")
+            }
+        }
+    }
+}
+
+impl std::error::Error for ParserError {}
diff --git a/urlpattern/src/lib.rs b/urlpattern/src/lib.rs
new file mode 100644
index 0000000..78c6032
--- /dev/null
+++ b/urlpattern/src/lib.rs
@@ -0,0 +1,517 @@
+//! A WHATWG [URLPattern](https://urlpattern.spec.whatwg.org/) implementation
+//! built on the servo/rust-url workspace crates.
+//!
+//! # Example
+//! ```
+//! use urlpattern::{UrlPattern, UrlPatternInit, UrlPatternMatchInput};
+//!
+//! let init = UrlPatternInit { pathname: Some("/users/:id".to_owned()), ..Default::default() };
+//! let pattern = UrlPattern::parse(init, Default::default()).unwrap();
+//!
+//! let url: url::Url = "https://example.com/users/123".parse().unwrap();
+//! let res = pattern.exec(UrlPatternMatchInput::Url(url)).unwrap().unwrap();
+//! assert_eq!(res.pathname.groups.get("id").unwrap().as_deref(), Some("123"));
+//! ```
+
+mod canonicalize;
+mod component;
+mod constructor_parser;
+mod error;
+mod parser;
+mod tokenizer;
+
+use std::collections::HashMap;
+
+use url::Url;
+
+use crate::canonicalize::ProcessType;
+use crate::component::Component;
+
+pub use crate::error::{ParserError, TokenizerError, UrlPatternError};
+use crate::parser::Options as ComponentOptions;
+
+/// Options passed to [`UrlPattern::parse`].
+#[derive(Debug, Default, Clone, Copy, PartialEq, Eq)]
+pub struct UrlPatternOptions {
+    pub ignore_case: bool,
+}
+
+/// The structured input used to create or match a URL pattern.
+#[derive(Debug, Default, Clone, PartialEq, Eq)]
+pub struct UrlPatternInit {
+    pub protocol: Option<String>,
+    pub username: Option<String>,
+    pub password: Option<String>,
+    pub hostname: Option<String>,
+    pub port: Option<String>,
+    pub pathname: Option<String>,
+    pub search: Option<String>,
+    pub hash: Option<String>,
+    pub base_url: Option<Url>,
+}
+
+impl UrlPatternInit {
+    /// Parse a constructor string (with an optional base URL) into an init.
+    pub fn parse_constructor_string(
+        pattern: &str,
+        base_url: Option<Url>,
+    ) -> Result<UrlPatternInit, UrlPatternError> {
+        let mut init = constructor_parser::parse_constructor_string(pattern)?;
+        if base_url.is_none() && init.protocol.is_none() {
+            return Err(UrlPatternError::BaseUrlRequired);
+        }
+        init.base_url = base_url;
+        Ok(init)
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#process-a-urlpatterninit>
+    #[allow(clippy::too_many_arguments)]
+    fn process(
+        &self,
+        kind: ProcessType,
+        protocol: Option<String>,
+        username: Option<String>,
+        password: Option<String>,
+        hostname: Option<String>,
+        port: Option<String>,
+        pathname: Option<String>,
+        search: Option<String>,
+        hash: Option<String>,
+    ) -> Result<UrlPatternInit, UrlPatternError> {
+        let mut result = UrlPatternInit {
+            protocol,
+            username,
+            password,
+            hostname,
+            port,
+            pathname,
+            search,
+            hash,
+            base_url: None,
+        };
+
+        let base_url = if let Some(base) = &self.base_url {
+            if self.protocol.is_none() {
+                result.protocol = Some(canonicalize::process_base_url(base.scheme(), kind));
+            }
+            if kind != ProcessType::Pattern
+                && self.protocol.is_none()
+                && self.hostname.is_none()
+                && self.port.is_none()
+                && self.username.is_none()
+            {
+                result.username = Some(canonicalize::process_base_url(base.username(), kind));
+            }
+            if kind != ProcessType::Pattern
+                && self.protocol.is_none()
+                && self.hostname.is_none()
+                && self.port.is_none()
+                && self.username.is_none()
+                && self.password.is_none()
+            {
+                result.password =
+                    Some(canonicalize::process_base_url(base.password().unwrap_or(""), kind));
+            }
+            if self.protocol.is_none() && self.hostname.is_none() {
+                result.hostname =
+                    Some(canonicalize::process_base_url(base.host_str().unwrap_or(""), kind));
+            }
+            if self.protocol.is_none() && self.hostname.is_none() && self.port.is_none() {
+                result.port =
+                    Some(canonicalize::process_base_url(url::quirks::port(base), kind));
+            }
+            if self.protocol.is_none()
+                && self.hostname.is_none()
+                && self.port.is_none()
+                && self.pathname.is_none()
+            {
+                result.pathname =
+                    Some(canonicalize::process_base_url(url::quirks::pathname(base), kind));
+            }
+            if self.protocol.is_none()
+                && self.hostname.is_none()
+                && self.port.is_none()
+                && self.pathname.is_none()
+                && self.search.is_none()
+            {
+                result.search =
+                    Some(canonicalize::process_base_url(base.query().unwrap_or(""), kind));
+            }
+            if self.protocol.is_none()
+                && self.hostname.is_none()
+                && self.port.is_none()
+                && self.pathname.is_none()
+                && self.search.is_none()
+                && self.hash.is_none()
+            {
+                result.hash =
+                    Some(canonicalize::process_base_url(base.fragment().unwrap_or(""), kind));
+            }
+            Some(base)
+        } else {
+            None
+        };
+
+        if let Some(protocol) = &self.protocol {
+            result.protocol = Some(canonicalize::process_protocol_init(protocol, kind)?);
+        }
+        if let Some(username) = &self.username {
+            result.username = Some(canonicalize::process_username_init(username, kind)?);
+        }
+        if let Some(password) = &self.password {
+            result.password = Some(canonicalize::process_password_init(password, kind)?);
+        }
+        if let Some(hostname) = &self.hostname {
+            result.hostname = Some(canonicalize::process_hostname_init(hostname, kind)?);
+        }
+        if let Some(port) = &self.port {
+            result.port =
+                Some(canonicalize::process_port_init(port, result.protocol.as_deref(), kind)?);
+        }
+        if let Some(pathname) = &self.pathname {
+            result.pathname = Some(pathname.clone());
+            if let Some(base) = base_url {
+                if !base.cannot_be_a_base() && !is_absolute_pathname(pathname, kind) {
+                    let base_path = url::quirks::pathname(base);
+                    if let Some(slash_index) = base_path.rfind('/') {
+                        let new_prefix =
+                            canonicalize::process_base_url(&base_path[..=slash_index], kind);
+                        result.pathname =
+                            Some(format!("{new_prefix}{}", result.pathname.unwrap()));
+                    }
+                }
+            }
+            result.pathname = Some(canonicalize::process_pathname_init(
+                &result.pathname.unwrap(),
+                result.protocol.as_deref(),
+                kind,
+            )?);
+        }
+        if let Some(search) = &self.search {
+            result.search = Some(canonicalize::process_search_init(search, kind)?);
+        }
+        if let Some(hash) = &self.hash {
+            result.hash = Some(canonicalize::process_hash_init(hash, kind)?);
+        }
+        Ok(result)
+    }
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#is-an-absolute-pathname>
+fn is_absolute_pathname(input: &str, kind: ProcessType) -> bool {
+    if input.is_empty() {
+        return false;
+    }
+    if input.starts_with('/') {
+        return true;
+    }
+    if kind == ProcessType::Url {
+        return false;
+    }
+    if input.len() < 2 {
+        return false;
+    }
+    input.starts_with("\\/") || input.starts_with("{/")
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#hostname-pattern-is-an-ipv6-address>
+fn hostname_pattern_is_ipv6_address(input: &str) -> bool {
+    if input.len() < 2 {
+        return false;
+    }
+    input.starts_with('[') || input.starts_with("{[") || input.starts_with("\\[")
+}
+
+/// A compiled URL pattern.
+#[derive(Debug)]
+pub struct UrlPattern {
+    pub protocol: Component,
+    pub username: Component,
+    pub password: Component,
+    pub hostname: Component,
+    pub port: Component,
+    pub pathname: Component,
+    pub search: Component,
+    pub hash: Component,
+}
+
+/// The input to [`UrlPattern::test`] / [`UrlPattern::exec`].
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum UrlPatternMatchInput {
+    Init(UrlPatternInit),
+    Url(Url),
+}
+
+impl UrlPattern {
+    /// Ref: <https://urlpattern.spec.whatwg.org/#dom-urlpattern-urlpattern>
+    pub fn parse(
+        init: UrlPatternInit,
+        options: UrlPatternOptions,
+    ) -> Result<Self, UrlPatternError> {
+        let mut processed = init.process(
+            ProcessType::Pattern,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+        )?;
+
+        if let Some(protocol) = &processed.protocol {
+            if let Some(default_port) = canonicalize::special_scheme_default_port(protocol) {
+                if processed.port.as_deref() == Some(default_port) {
+                    processed.port = Some(String::new());
+                }
+            }
+        }
+
+        let ignore = options.ignore_case;
+        let protocol = Component::compile(
+            processed.protocol.as_deref(),
+            canonicalize::canonicalize_protocol,
+            ComponentOptions::default(),
+        )?;
+
+        let hostname_is_ipv6 = processed
+            .hostname
+            .as_deref()
+            .map(hostname_pattern_is_ipv6_address)
+            .unwrap_or(false);
+        let hostname = if hostname_is_ipv6 {
+            Component::compile(
+                processed.hostname.as_deref(),
+                canonicalize::canonicalize_ipv6_hostname,
+                ComponentOptions::hostname(),
+            )?
+        } else {
+            Component::compile(
+                processed.hostname.as_deref(),
+                canonicalize::canonicalize_hostname,
+                ComponentOptions::hostname(),
+            )?
+        };
+
+        let pathname = {
+            let protocol_is_empty = processed.protocol.as_ref().map_or(false, |p| p.is_empty());
+            let has_leading_slash =
+                processed.pathname.as_ref().map_or(false, |p| p.starts_with('/'));
+            let is_non_opaque = protocol_is_empty
+                || protocol.protocol_component_matches_special_scheme()
+                || has_leading_slash;
+            if is_non_opaque {
+                let mut opts = ComponentOptions::pathname();
+                opts.ignore_case = ignore;
+                Component::compile(
+                    processed.pathname.as_deref(),
+                    canonicalize::canonicalize_pathname,
+                    opts,
+                )?
+            } else {
+                Component::compile(
+                    processed.pathname.as_deref(),
+                    canonicalize::canonicalize_opaque_pathname,
+                    ComponentOptions { ignore_case: ignore, ..Default::default() },
+                )?
+            }
+        };
+
+        Ok(UrlPattern {
+            protocol,
+            username: Component::compile(
+                processed.username.as_deref(),
+                canonicalize::canonicalize_username,
+                ComponentOptions::default(),
+            )?,
+            password: Component::compile(
+                processed.password.as_deref(),
+                canonicalize::canonicalize_password,
+                ComponentOptions::default(),
+            )?,
+            hostname,
+            port: Component::compile(
+                processed.port.as_deref(),
+                |port| canonicalize::canonicalize_port(port, None),
+                ComponentOptions::default(),
+            )?,
+            pathname,
+            search: Component::compile(
+                processed.search.as_deref(),
+                canonicalize::canonicalize_search,
+                ComponentOptions { ignore_case: ignore, ..Default::default() },
+            )?,
+            hash: Component::compile(
+                processed.hash.as_deref(),
+                canonicalize::canonicalize_hash,
+                ComponentOptions { ignore_case: ignore, ..Default::default() },
+            )?,
+        })
+    }
+
+    pub fn protocol(&self) -> &str {
+        &self.protocol.pattern_string
+    }
+    pub fn username(&self) -> &str {
+        &self.username.pattern_string
+    }
+    pub fn password(&self) -> &str {
+        &self.password.pattern_string
+    }
+    pub fn hostname(&self) -> &str {
+        &self.hostname.pattern_string
+    }
+    pub fn port(&self) -> &str {
+        &self.port.pattern_string
+    }
+    pub fn pathname(&self) -> &str {
+        &self.pathname.pattern_string
+    }
+    pub fn search(&self) -> &str {
+        &self.search.pattern_string
+    }
+    pub fn hash(&self) -> &str {
+        &self.hash.pattern_string
+    }
+
+    pub fn has_regexp_groups(&self) -> bool {
+        self.protocol.has_regexp_group
+            || self.username.has_regexp_group
+            || self.password.has_regexp_group
+            || self.hostname.has_regexp_group
+            || self.port.has_regexp_group
+            || self.pathname.has_regexp_group
+            || self.search.has_regexp_group
+            || self.hash.has_regexp_group
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#dom-urlpattern-test>
+    pub fn test(&self, input: UrlPatternMatchInput) -> Result<bool, UrlPatternError> {
+        self.matches(input).map(|r| r.is_some())
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#dom-urlpattern-exec>
+    pub fn exec(
+        &self,
+        input: UrlPatternMatchInput,
+    ) -> Result<Option<UrlPatternResult>, UrlPatternError> {
+        self.matches(input)
+    }
+
+    /// Ref: <https://urlpattern.spec.whatwg.org/#match>
+    fn matches(
+        &self,
+        input: UrlPatternMatchInput,
+    ) -> Result<Option<UrlPatternResult>, UrlPatternError> {
+        let input = match parse_match_input(input) {
+            Some(input) => input,
+            None => return Ok(None),
+        };
+
+        let protocol = self.protocol.matches(&input.protocol);
+        let username = self.username.matches(&input.username);
+        let password = self.password.matches(&input.password);
+        let hostname = self.hostname.matches(&input.hostname);
+        let port = self.port.matches(&input.port);
+        let pathname = self.pathname.matches(&input.pathname);
+        let search = self.search.matches(&input.search);
+        let hash = self.hash.matches(&input.hash);
+
+        match (protocol, username, password, hostname, port, pathname, search, hash) {
+            (
+                Some(protocol),
+                Some(username),
+                Some(password),
+                Some(hostname),
+                Some(port),
+                Some(pathname),
+                Some(search),
+                Some(hash),
+            ) => Ok(Some(UrlPatternResult {
+                protocol: self.protocol.create_match_result(input.protocol.clone(), protocol),
+                username: self.username.create_match_result(input.username.clone(), username),
+                password: self.password.create_match_result(input.password.clone(), password),
+                hostname: self.hostname.create_match_result(input.hostname.clone(), hostname),
+                port: self.port.create_match_result(input.port.clone(), port),
+                pathname: self.pathname.create_match_result(input.pathname.clone(), pathname),
+                search: self.search.create_match_result(input.search.clone(), search),
+                hash: self.hash.create_match_result(input.hash.clone(), hash),
+            })),
+            _ => Ok(None),
+        }
+    }
+}
+
+/// A result of a URL pattern match.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct UrlPatternResult {
+    pub protocol: UrlPatternComponentResult,
+    pub username: UrlPatternComponentResult,
+    pub password: UrlPatternComponentResult,
+    pub hostname: UrlPatternComponentResult,
+    pub port: UrlPatternComponentResult,
+    pub pathname: UrlPatternComponentResult,
+    pub search: UrlPatternComponentResult,
+    pub hash: UrlPatternComponentResult,
+}
+
+/// A per-component match result: the matched input plus named group values.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct UrlPatternComponentResult {
+    pub input: String,
+    pub groups: HashMap<String, Option<String>>,
+}
+
+#[derive(Debug, Default)]
+struct MatchInput {
+    protocol: String,
+    username: String,
+    password: String,
+    hostname: String,
+    port: String,
+    pathname: String,
+    search: String,
+    hash: String,
+}
+
+/// Ref: <https://urlpattern.spec.whatwg.org/#create-a-url-pattern-match-input>
+fn parse_match_input(input: UrlPatternMatchInput) -> Option<MatchInput> {
+    let mut i = MatchInput::default();
+    match input {
+        UrlPatternMatchInput::Init(init) => {
+            let applied = init
+                .process(
+                    ProcessType::Url,
+                    Some(i.protocol),
+                    Some(i.username),
+                    Some(i.password),
+                    Some(i.hostname),
+                    Some(i.port),
+                    Some(i.pathname),
+                    Some(i.search),
+                    Some(i.hash),
+                )
+                .ok()?;
+            i.protocol = applied.protocol.unwrap_or_default();
+            i.username = applied.username.unwrap_or_default();
+            i.password = applied.password.unwrap_or_default();
+            i.hostname = applied.hostname.unwrap_or_default();
+            i.port = applied.port.unwrap_or_default();
+            i.pathname = applied.pathname.unwrap_or_default();
+            i.search = applied.search.unwrap_or_default();
+            i.hash = applied.hash.unwrap_or_default();
+        }
+        UrlPatternMatchInput::Url(url) => {
+            i.protocol = url.scheme().to_owned();
+            i.username = url.username().to_owned();
+            i.password = url.password().unwrap_or_default().to_owned();
+            i.hostname = url.host_str().unwrap_or_default().to_owned();
+            i.port = url::quirks::port(&url).to_owned();
+            i.pathname = url::quirks::pathname(&url).to_owned();
+            i.search = url.query().unwrap_or_default().to_owned();
+            i.hash = url.fragment().unwrap_or_default().to_owned();
+        }
+    }
+    Some(i)
+}
