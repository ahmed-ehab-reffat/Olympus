+def product_market(k):
+    prop, resp = [], []
+    for t in range(k):
+        prop.append([2 * t, 2 * t + 1])
+        prop.append([2 * t + 1, 2 * t])
+        resp.append([2 * t + 1, 2 * t])
+        resp.append([2 * t, 2 * t + 1])
+    return prop, resp
+
+
+CROWD_PROP = [[0], [0], [0]]
+CROWD_RESP = [[0, 1, 2]]
+CROWD_CAPS = [2]
+
+
+def reversed_product(k):
+    prop, resp = [], []
+    for t in range(k):
+        prop.append([2 * t + 1, 2 * t])
+        prop.append([2 * t, 2 * t + 1])
+        resp.append([2 * t, 2 * t + 1])
+        resp.append([2 * t + 1, 2 * t])
+    return prop, resp
+
+
+def linked_market(k):
+    n = 2 * k
+    prop, resp = [], []
+    for t in range(k):
+        a, b = 2 * t, 2 * t + 1
+        rest = [j for j in range(n) if j not in (a, b)]
+        others = [i for i in range(n) if i not in (a, b)]
+        prop.append([a, b] + rest)
+        prop.append([b, a] + rest[::-1])
+        resp.append([b, a] + others)
+        resp.append([a, b] + others[::-1])
+    return prop, resp
+
