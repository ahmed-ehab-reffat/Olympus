+def capacity_blocks(k):
+    prop, resp, caps = [], [], []
+    for t in range(k):
+        p, r = 3 * t, 2 * t
+        prop += [[r, r + 1], [r + 1, r], [r, r + 1]]
+        resp += [[p + 2, p + 1, p], [p, p + 2, p + 1]]
+        caps += [2, 1]
+    return prop, resp, caps
+
+
+def room_blocks(k):
+    prefs = []
+    for t in range(k):
+        a, b, c, d = 4 * t, 4 * t + 1, 4 * t + 2, 4 * t + 3
+        prefs += [[b, c], [d, a], [a, d], [c, b]]
+    return prefs
+
+
+def rank_of(row, item):
+    row = list(row)
+    return row.index(item) if item in row else None
+
+
+def reference_stable(x, prop_prefs, resp_prefs, caps):
+    m, n = len(prop_prefs), len(resp_prefs)
+    holders = {j: [] for j in range(n)}
+    for i in range(m):
+        j = x[i]
+        if j < 0:
+            continue
+        if rank_of(prop_prefs[i], j) is None or \
+                rank_of(resp_prefs[j], i) is None:
+            return False
+        holders[j].append(i)
+    if any(len(holders[j]) > caps[j] for j in range(n)):
+        return False
+    for i in range(m):
+        for j in range(n):
+            if rank_of(prop_prefs[i], j) is None or \
+                    rank_of(resp_prefs[j], i) is None or x[i] == j:
+                continue
+            here = rank_of(prop_prefs[i], x[i]) if x[i] >= 0 else None
+            if here is not None and rank_of(prop_prefs[i], j) > here:
+                continue
+            if len(holders[j]) < caps[j]:
+                return False
+            worst = max(rank_of(resp_prefs[j], p) for p in holders[j])
+            if rank_of(resp_prefs[j], i) < worst:
+                return False
+    return True
+
+
+def reference_stable_set(prop_prefs, resp_prefs, caps=None):
+    m, n = len(prop_prefs), len(resp_prefs)
+    if caps is None:
+        caps = [1] * n
+    out = []
+    for combo in itertools.product(range(-1, n), repeat=m):
+        load = [0] * n
+        for j in combo:
+            if j >= 0:
+                load[j] += 1
+        if any(load[j] > caps[j] for j in range(n)):
+            continue
+        if reference_stable(list(combo), prop_prefs, resp_prefs, caps):
+            out.append(tuple(combo))
+    return sorted(out)
+
+
+def reference_roommate_stable(x, prefs):
+    n = len(prefs)
+    for i in range(n):
+        j = x[i]
+        if j < 0:
+            continue
+        if j == i or x[j] != i:
+            return False
+        if rank_of(prefs[i], j) is None or rank_of(prefs[j], i) is None:
+            return False
+    for i in range(n):
+        for j in range(n):
+            if i == j or x[i] == j:
+                continue
+            if rank_of(prefs[i], j) is None or \
+                    rank_of(prefs[j], i) is None:
+                continue
+            here = rank_of(prefs[i], x[i]) if x[i] >= 0 else None
+            there = rank_of(prefs[j], x[j]) if x[j] >= 0 else None
+            if here is not None and rank_of(prefs[i], j) > here:
+                continue
+            if there is not None and rank_of(prefs[j], i) > there:
+                continue
+            return False
+    return True
+
+
+def reference_roommate_set(prefs):
+    n = len(prefs)
+    out = []
+
+    def extend(partner, k):
+        while k < n and partner[k] is not None:
+            k += 1
+        if k == n:
+            if reference_roommate_stable(list(partner), prefs):
+                out.append(tuple(partner))
+            return
+        partner[k] = -1
+        extend(partner, k + 1)
+        partner[k] = None
+        for j in range(k + 1, n):
+            if partner[j] is None:
+                partner[k], partner[j] = j, k
+                extend(partner, k + 1)
+                partner[k], partner[j] = None, None
+
+    extend([None] * n, 0)
+    return sorted(out)
+
