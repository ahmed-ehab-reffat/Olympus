+#!/bin/sh
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+else
+  OUTPUT_PATH=/tmp/junit.xml
+fi
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TESTS=quantecon/tests/test_matching_b65eb2.py
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -p no:cacheprovider \
+      --junitxml="$OUTPUT_PATH"
+  EXIT_CODE=$?
+else
+  python -m pytest quantecon --ignore="$NEW_TESTS" -p no:cacheprovider \
+      --junitxml="$OUTPUT_PATH"
+  EXIT_CODE=$?
+fi
+
+if [ ! -s "$OUTPUT_PATH" ]; then
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="1" failures="0" tests="1" time="0">
+<testcase classname="test_matching" name="collection"><error message="pytest produced no report">The test session did not produce a JUnit report.</error></testcase>
+</testsuite></testsuites>
+XMLEOF
+fi
+
+exit $EXIT_CODE
