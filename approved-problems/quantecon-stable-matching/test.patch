+def largest_rank(matching, prop_prefs, resp_prefs):
+    seen = [max(list(prop_prefs[i]).index(j), list(resp_prefs[j]).index(i))
+            for i, j in enumerate(matching) if j >= 0]
+    return max(seen) if seen else 0
