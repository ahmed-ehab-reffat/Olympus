+"""
+Exchange of indivisible goods in a one sided market.
+
+"""
+import numpy as np
+
+from ._util import _preference_lists
+
+
+def _check_endowment(endowment, n):
+    """
+    Validate the initial ownership of the houses.
+
+    """
+    if endowment is None:
+        return np.arange(n, dtype=int)
+    owned = np.asarray(endowment, dtype=int).ravel()
+    if owned.size != n:
+        raise ValueError(f"endowment must have {n} entries")
+    if owned.size and (owned.min() < 0 or owned.max() >= n):
+        raise ValueError(f"endowment entries must lie in range(0, {n})")
+    if np.unique(owned).size != owned.size:
+        raise ValueError("endowment must give every agent a distinct house")
+    return owned
+
+
+def serial_dictatorship(prefs, order):
+    """
+    Allocate the houses by letting the agents choose in turn.
+
+    Parameters
+    ----------
+    prefs : array_like
+        Sequence of `n` sequences of integers. Entry `i` lists the houses
+        acceptable to agent `i`, most preferred first.
+
+    order : array_like(int, ndim=1)
+        The `n` agents, in the order in which they choose.
+
+    Returns
+    -------
+    allocation : ndarray(int, ndim=1)
+        Array of length `n`. Entry `i` is the house allocated to agent
+        `i`, or -1 when every house agent `i` finds acceptable was taken
+        before its turn.
+
+    """
+    raw = list(prefs)
+    n = len(raw)
+    lists = _preference_lists(raw, n, 'prefs')
+    turns = np.asarray(order, dtype=int).ravel()
+    if turns.size != n:
+        raise ValueError(f"order must have {n} entries")
+    if n and (turns.min() < 0 or turns.max() >= n or
+              np.unique(turns).size != n):
+        raise ValueError("order must list every agent exactly once")
+    allocation = np.full(n, -1, dtype=int)
+    taken = np.zeros(n, dtype=bool)
+    for agent in turns:
+        for house in lists[agent]:
+            if not taken[house]:
+                allocation[agent] = int(house)
+                taken[house] = True
+                break
+    return allocation
+
+
+def _drop_starved(lists, pointer, live_agent, live_house, endowment, n):
+    """
+    Retire every agent left without an acceptable house, and its own.
+
+    Returns the number of agents retired.
+
+    """
+    dropped = 0
+    changed = True
+    while changed:
+        changed = False
+        for i in range(n):
+            if not live_agent[i]:
+                continue
+            while pointer[i] < lists[i].size and \
+                    not live_house[lists[i][pointer[i]]]:
+                pointer[i] += 1
+            if pointer[i] >= lists[i].size:
+                live_agent[i] = False
+                live_house[endowment[i]] = False
+                dropped += 1
+                changed = True
+    return dropped
+
+
+def _trading_cycles(target):
+    """
+    Collect the cycles of a mapping from agents to agents.
+
+    """
+    state = {}
+    cycles = []
+    for start in target:
+        if state.get(start, 0):
+            continue
+        path = []
+        node = start
+        while state.get(node, 0) == 0:
+            state[node] = 1
+            path.append(node)
+            node = target[node]
+        if state[node] == 1:
+            cycles.append(path[path.index(node):])
+        for node in path:
+            state[node] = 2
+    return cycles
+
+
+def top_trading_cycles(prefs, endowment=None):
+    """
+    Reallocate indivisible goods by top trading cycles.
+
+    Parameters
+    ----------
+    prefs : array_like
+        Sequence of `n` sequences of integers. Entry `i` lists the houses
+        acceptable to agent `i`, most preferred first.
+
+    endowment : array_like(int, ndim=1), optional(default=None)
+        Distinct house owned by each agent at the start. Defaults to
+        agent `i` owning house `i`.
+
+    Returns
+    -------
+    allocation : ndarray(int, ndim=1)
+        Array of length `n`. Entry `i` is the house allocated to agent
+        `i`, or -1 when agent `i` ends up with nothing.
+
+    """
+    raw = list(prefs)
+    n = len(raw)
+    lists = _preference_lists(raw, n, 'prefs')
+    endowment = _check_endowment(endowment, n)
+    owner = np.full(n, -1, dtype=int)
+    for i in range(n):
+        owner[endowment[i]] = i
+    live_agent = np.ones(n, dtype=bool)
+    live_house = np.ones(n, dtype=bool)
+    pointer = np.zeros(n, dtype=int)
+    allocation = np.full(n, -1, dtype=int)
+    remaining = n
+    while remaining > 0:
+        remaining -= _drop_starved(lists, pointer, live_agent, live_house,
+                                   endowment, n)
+        if remaining == 0:
+            break
+        target = {}
+        for i in range(n):
+            if live_agent[i]:
+                target[i] = int(owner[lists[i][pointer[i]]])
+        for cycle in _trading_cycles(target):
+            for agent in cycle:
+                house = int(lists[agent][pointer[agent]])
+                allocation[agent] = house
+                live_agent[agent] = False
+                live_house[house] = False
+                remaining -= 1
+    return allocation
