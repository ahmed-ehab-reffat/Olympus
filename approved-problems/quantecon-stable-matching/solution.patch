+"""
+Optimal stable matchings of a two sided market.
+
+"""
+import numpy as np
+
+from ._core import _propose, _is_stable_tables
+from ._util import _two_sided_setup
+
+
+def _shortlists(prop_lists, resp_lists, prop_ranks, resp_ranks, m, n):
+    """
+    Keep only the pairs that lie between the two optimal matchings.
+
+    A pair survives when the proposer likes it no better than its
+    proposer optimal partner and no worse than its respondent optimal
+    one, and the respondent likewise. Both sides are needed: after the
+    reduction the last remaining holder of a respondent is the proposer
+    it is matched to, which is what the rotations are read from.
+
+    """
+    prop_opt = _propose(prop_lists, resp_ranks, np.ones(n, dtype=int), m, n)
+    resp_opt = _propose(resp_lists, prop_ranks, np.ones(m, dtype=int), n, m)
+    prop_pess = np.full(m, -1, dtype=int)
+    for j in range(n):
+        if resp_opt[j] >= 0:
+            prop_pess[resp_opt[j]] = j
+    resp_pess = np.full(n, -1, dtype=int)
+    for i in range(m):
+        if prop_opt[i] >= 0:
+            resp_pess[prop_opt[i]] = i
+    lists = []
+    for i in range(m):
+        if prop_opt[i] < 0:
+            lists.append([])
+            continue
+        best = prop_ranks[i, prop_opt[i]]
+        worst = prop_ranks[i, prop_pess[i]]
+        row = []
+        for j in prop_lists[i]:
+            if not best <= prop_ranks[i, j] <= worst:
+                continue
+            if resp_opt[j] < 0 or resp_pess[j] < 0:
+                continue
+            if not resp_ranks[j, resp_opt[j]] <= resp_ranks[j, i] \
+                    <= resp_ranks[j, resp_pess[j]]:
+                continue
+            row.append(int(j))
+        lists.append(row)
+    holders = [[] for _ in range(n)]
+    for i in range(m):
+        for j in lists[i]:
+            holders[j].append(i)
+    for j in range(n):
+        holders[j].sort(key=lambda i: resp_ranks[j, i])
+    return lists, holders, prop_opt
+
+
+def _eliminate(rotation, lists, holders, resp_ranks, deleted_by, index):
+    """
+    Move every proposer of a rotation on to the next respondent.
+
+    Every pair removed from the lists is stamped with the rotation that
+    removed it, which is what the precedence relation is read from.
+
+    """
+    size = len(rotation)
+    for t in range(size):
+        proposer = rotation[t][0]
+        taker = rotation[(t + 1) % size][1]
+        keep = []
+        for held in holders[taker]:
+            if resp_ranks[taker, held] <= resp_ranks[taker, proposer]:
+                keep.append(held)
+            else:
+                lists[held].remove(taker)
+                deleted_by[(held, taker)] = index
+        holders[taker] = keep
+
+
+def _find_cycle(successor):
+    """
+    Return the agents of one cycle of a partial mapping, or None.
+
+    """
+    state = {}
+    for start in successor:
+        if state.get(start, 0):
+            continue
+        path = []
+        node = start
+        while node in successor and state.get(node, 0) == 0:
+            state[node] = 1
+            path.append(node)
+            node = successor[node]
+        if node in successor and state[node] == 1:
+            return path[path.index(node):]
+        for seen in path:
+            state[seen] = 2
+    return None
+
+
+def _rotation_poset(prop_lists, resp_lists, prop_ranks, resp_ranks, m, n):
+    """
+    Build every rotation of the market with its weight and the rotations
+    that have to be eliminated before it.
+
+    Returns
+    -------
+    rotations : list(list(tuple))
+    weights : list(int)
+        Change in the total rank caused by eliminating each rotation.
+
+    edges : list(tuple(int, int))
+        Pair `(p, q)` means rotation `p` comes before rotation `q`.
+
+    base : ndarray(int, ndim=1)
+        The proposer optimal matching the rotations start from.
+
+    """
+    lists, holders, prop_opt = _shortlists(prop_lists, resp_lists, prop_ranks,
+                                           resp_ranks, m, n)
+    active = [i for i in range(m) if prop_opt[i] >= 0]
+    full = [list(row) for row in lists]
+    deleted_by = {}
+    rotations, weights, edges = [], [], []
+    while True:
+        successor = {}
+        for i in active:
+            if len(lists[i]) >= 2:
+                successor[i] = holders[lists[i][1]][-1]
+        found = _find_cycle(successor)
+        if found is None:
+            break
+        rotation = [(i, lists[i][0]) for i in found]
+        index = len(rotations)
+        weight = 0
+        before = set()
+        size = len(rotation)
+        for t in range(size):
+            proposer, leaving = rotation[t]
+            taker = rotation[(t + 1) % size][1]
+            weight += int(prop_ranks[proposer, taker]
+                          - prop_ranks[proposer, leaving])
+            weight += int(resp_ranks[taker, proposer]
+                          - resp_ranks[taker, rotation[(t + 1) % size][0]])
+            for other in full[proposer]:
+                if other == leaving or other == taker:
+                    continue
+                if prop_ranks[proposer, other] > prop_ranks[proposer, taker]:
+                    continue
+                if (proposer, other) in deleted_by:
+                    before.add(deleted_by[(proposer, other)])
+        rotations.append(rotation)
+        weights.append(weight)
+        for earlier in before:
+            edges.append((earlier, index))
+        _eliminate(rotation, lists, holders, resp_ranks, deleted_by, index)
+    return rotations, weights, edges, prop_opt
+
+
+class _Flow:
+    """
+    Maximum flow on a small network, used for the closed subset cut.
+
+    """
+    def __init__(self, size):
+        self.size = size
+        self.graph = [[] for _ in range(size)]
+
+    def add(self, tail, head, capacity):
+        self.graph[tail].append([head, capacity, len(self.graph[head])])
+        self.graph[head].append([tail, 0, len(self.graph[tail]) - 1])
+
+    def _levels(self, source, sink):
+        level = [-1] * self.size
+        level[source] = 0
+        queue = [source]
+        while queue:
+            node = queue.pop(0)
+            for head, capacity, _ in self.graph[node]:
+                if capacity > 0 and level[head] < 0:
+                    level[head] = level[node] + 1
+                    queue.append(head)
+        return level, level[sink] >= 0
+
+    def _augment(self, node, sink, limit, level, cursor):
+        if node == sink:
+            return limit
+        while cursor[node] < len(self.graph[node]):
+            edge = self.graph[node][cursor[node]]
+            head, capacity, back = edge
+            if capacity > 0 and level[head] == level[node] + 1:
+                pushed = self._augment(head, sink, min(limit, capacity),
+                                       level, cursor)
+                if pushed > 0:
+                    edge[1] -= pushed
+                    self.graph[head][back][1] += pushed
+                    return pushed
+            cursor[node] += 1
+        return 0
+
+    def source_side(self, source, sink):
+        while True:
+            _, reachable = self._levels(source, sink)
+            if not reachable:
+                break
+            level, _ = self._levels(source, sink)
+            cursor = [0] * self.size
+            while self._augment(source, sink, float('inf'), level,
+                                cursor) > 0:
+                pass
+        level, _ = self._levels(source, sink)
+        return [node for node in range(self.size) if level[node] >= 0]
+
+
+def _min_weight_closed(weights, edges):
+    """
+    The smallest subset closed under the precedence with the least total
+    weight.
+
+    A subset is closed when it holds every rotation that comes before any
+    of its members. Taking each helpful rotation on its own is not enough,
+    since a helpful one can sit behind a costly predecessor.
+
+    """
+    count = len(weights)
+    net = _Flow(count + 2)
+    source, sink = count, count + 1
+    big = sum(abs(w) for w in weights) + 1
+    for index, weight in enumerate(weights):
+        if weight < 0:
+            net.add(source, index, -weight)
+        elif weight > 0:
+            net.add(index, sink, weight)
+    for earlier, later in edges:
+        net.add(later, earlier, big)
+    reachable = set(net.source_side(source, sink))
+    return [index for index in range(count) if index in reachable]
+
+
+def _apply(base, rotations, chosen):
+    """
+    Eliminate a set of rotations from the proposer optimal matching.
+
+    """
+    matching = base.copy()
+    for index in sorted(chosen):
+        rotation = rotations[index]
+        size = len(rotation)
+        for t in range(size):
+            matching[rotation[t][0]] = rotation[(t + 1) % size][1]
+    return matching
+
+
+def egalitarian_stable_matching(prop_prefs, resp_prefs):
+    """
+    Compute the stable matching with the smallest total rank.
+
+    Parameters
+    ----------
+    prop_prefs : array_like
+    resp_prefs : array_like
+
+    Returns
+    -------
+    matching : ndarray(int, ndim=1)
+        Array of length `m`, holding the respondent of each proposer just
+        as `deferred_acceptance` does. When several stable matchings share
+        the smallest total rank, the one every proposer likes at least as
+        well as the others is returned.
+
+    """
+    prop_lists, resp_lists, prop_ranks, resp_ranks, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    rotations, weights, edges, base = _rotation_poset(
+        prop_lists, resp_lists, prop_ranks, resp_ranks, m, n
+    )
+    return _apply(base, rotations, _min_weight_closed(weights, edges))
+
+
+def _reduced_lists(prop_lists, prop_ranks, resp_ranks, limit, m):
+    """
+    Drop every pair either side ranks worse than `limit`.
+
+    """
+    return [np.array([j for j in prop_lists[i]
+                      if prop_ranks[i, j] <= limit
+                      and resp_ranks[j, i] <= limit], dtype=int)
+            for i in range(m)]
+
+
+def minimum_regret_stable_matching(prop_prefs, resp_prefs):
+    """
+    Compute the stable matching with the smallest largest rank.
+
+    Parameters
+    ----------
+    prop_prefs : array_like
+    resp_prefs : array_like
+
+    Returns
+    -------
+    matching : ndarray(int, ndim=1)
+        Array of length `m`, holding the respondent of each proposer just
+        as `deferred_acceptance` does. When several stable matchings share
+        the smallest largest rank, the one every proposer likes at least
+        as well as the others is returned.
+
+    """
+    prop_lists, _, prop_ranks, resp_ranks, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    caps = np.ones(n, dtype=int)
+    base = _propose(prop_lists, resp_ranks, caps, m, n)
+    widest = 0
+    for i in range(m):
+        if base[i] >= 0:
+            widest = max(widest, int(prop_ranks[i, base[i]]),
+                         int(resp_ranks[base[i], i]))
+    best = base
+    for limit in range(widest + 1):
+        lists = _reduced_lists(prop_lists, prop_ranks, resp_ranks, limit, m)
+        candidate = _propose(lists, resp_ranks, caps, m, n)
+        if _is_stable_tables(candidate, prop_lists, prop_ranks, resp_ranks,
+                             caps, m, n):
+            best = candidate
+            break
+    return best
