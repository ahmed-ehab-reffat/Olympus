+"""
+Stable matching in a one sided market.
+
+"""
+import numpy as np
+
+from ._util import (
+    _check_matching, _mutual_lists, _preference_lists, _rank_table,
+    _sorted_pairs, _sorted_rows
+)
+
+
+def _roommate_setup(prefs):
+    """
+    Validate one sided preferences and build the lookup tables.
+
+    """
+    raw = list(prefs)
+    n = len(raw)
+    lists = _preference_lists(raw, n, 'prefs', forbid_self=True)
+    ranks = _rank_table(lists, n)
+    return _mutual_lists(lists, ranks), ranks, n
+
+
+def _check_roommate_matching(matching, n):
+    """
+    Validate a partner vector of a one sided market.
+
+    """
+    x = _check_matching(matching, n, n)
+    for i in range(n):
+        if x[i] == i:
+            raise ValueError(f"matching[{i}] matches agent {i} with itself")
+        if x[i] >= 0 and x[x[i]] != i:
+            raise ValueError("matching is not symmetric")
+    return x
+
+
+def _roommate_blocking_tables(matching, lists, ranks, n):
+    """
+    Collect the blocking pairs of a one sided matching.
+
+    """
+    pairs = set()
+    for i in range(n):
+        current = matching[i]
+        current_rank = ranks[i, current] if current >= 0 else -1
+        for j in lists[i]:
+            if j == current:
+                continue
+            if current_rank >= 0 and ranks[i, j] > current_rank:
+                break
+            other = matching[j]
+            other_rank = ranks[j, other] if other >= 0 else -1
+            if other_rank < 0 or ranks[j, i] < other_rank:
+                pairs.add((min(i, int(j)), max(i, int(j))))
+    return pairs
+
+
+def roommate_blocking_pairs(matching, prefs):
+    """
+    Find the pairs that block a one sided matching.
+
+    Parameters
+    ----------
+    matching : array_like(int, ndim=1)
+        Array of length `n` holding the partner of each agent, with -1
+        for an unmatched agent.
+
+    prefs : array_like
+        Sequence of `n` sequences of integers. Entry `i` lists the agents
+        acceptable to agent `i`, most preferred first.
+
+    Returns
+    -------
+    pairs : ndarray(int, ndim=2)
+        Array of shape `(k, 2)`, sorted lexicographically, each row
+        holding the smaller index first.
+
+    """
+    lists, ranks, n = _roommate_setup(prefs)
+    x = _check_roommate_matching(matching, n)
+    return _sorted_pairs(_roommate_blocking_tables(x, lists, ranks, n))
+
+
+def is_roommate_stable(matching, prefs):
+    """
+    Test whether a one sided matching is stable.
+
+    Parameters
+    ----------
+    matching : array_like(int, ndim=1)
+    prefs : array_like
+
+    Returns
+    -------
+    bool
+        True when every matched pair is mutually acceptable and there is
+        no blocking pair.
+
+    """
+    lists, ranks, n = _roommate_setup(prefs)
+    x = _check_roommate_matching(matching, n)
+    for i in range(n):
+        if x[i] >= 0 and ranks[i, x[i]] < 0:
+            return False
+    return not _roommate_blocking_tables(x, lists, ranks, n)
+
+
+def _blocks_decided(agent, matching, decided, lists, ranks):
+    """
+    Test a freshly decided agent against the agents decided before it.
+
+    """
+    current = matching[agent]
+    current_rank = ranks[agent, current] if current >= 0 else -1
+    for j in lists[agent]:
+        if j == current:
+            continue
+        if current_rank >= 0 and ranks[agent, j] > current_rank:
+            break
+        if not decided[j]:
+            continue
+        other = matching[j]
+        other_rank = ranks[j, other] if other >= 0 else -1
+        if other_rank < 0 or ranks[j, agent] < other_rank:
+            return True
+    return False
+
+
+def stable_roommate_matchings(prefs):
+    """
+    Enumerate every stable matching of a one sided market.
+
+    Parameters
+    ----------
+    prefs : array_like
+        Sequence of `n` sequences of integers. Entry `i` lists the agents
+        acceptable to agent `i`, most preferred first.
+
+    Returns
+    -------
+    matchings : ndarray(int, ndim=2)
+        Array of shape `(t, n)` whose rows are the stable matchings of the
+        market, sorted lexicographically. The market may admit none, in
+        which case `t` is zero.
+
+    """
+    lists, ranks, n = _roommate_setup(prefs)
+    matching = np.full(n, -1, dtype=int)
+    decided = np.zeros(n, dtype=bool)
+    found = []
+
+    def extend(start):
+        agent = start
+        while agent < n and decided[agent]:
+            agent += 1
+        if agent == n:
+            if not _roommate_blocking_tables(matching, lists, ranks, n):
+                found.append(matching.copy())
+            return
+        for j in lists[agent]:
+            if decided[j]:
+                continue
+            matching[agent] = int(j)
+            matching[j] = agent
+            decided[agent] = True
+            decided[j] = True
+            if not _blocks_decided(agent, matching, decided, lists, ranks) \
+                    and not _blocks_decided(int(j), matching, decided, lists,
+                                            ranks):
+                extend(agent + 1)
+            decided[agent] = False
+            decided[j] = False
+            matching[agent] = -1
+            matching[j] = -1
+        decided[agent] = True
+        if not _blocks_decided(agent, matching, decided, lists, ranks):
+            extend(agent + 1)
+        decided[agent] = False
+
+    extend(0)
+    return _sorted_rows(found, n)
