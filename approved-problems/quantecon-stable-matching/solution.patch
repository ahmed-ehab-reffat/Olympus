+"""
+Stable matching in a two sided market.
+
+"""
+from bisect import insort
+
+import numpy as np
+
+from ._util import (
+    _check_caps, _check_matching, _preference_lists, _rank_table,
+    _sorted_pairs, _sorted_rows, _two_sided_setup
+)
+
+
+def deferred_acceptance(prop_prefs, resp_prefs, caps=None):
+    """
+    Compute the proposer optimal stable matching of a two sided market.
+
+    Parameters
+    ----------
+    prop_prefs : array_like
+        Sequence of `m` sequences of integers. Entry `i` lists the
+        respondents acceptable to proposer `i`, most preferred first.
+
+    resp_prefs : array_like
+        Sequence of `n` sequences of integers. Entry `j` lists the
+        proposers acceptable to respondent `j`, most preferred first.
+
+    caps : array_like(int, ndim=1), optional(default=None)
+        Number of partners respondent `j` can take. Defaults to one each.
+
+    Returns
+    -------
+    matching : ndarray(int, ndim=1)
+        Array of length `m`. Entry `i` is the respondent matched to
+        proposer `i`, or -1 when proposer `i` is unmatched.
+
+    Examples
+    --------
+    >>> prop_prefs = [[0, 1], [1, 0], [0]]
+    >>> resp_prefs = [[2, 0, 1], [0, 1]]
+    >>> deferred_acceptance(prop_prefs, resp_prefs)
+    array([ 1,  0, -1])
+
+    """
+    prop_lists, _, _, resp_ranks, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    caps = _check_caps(caps, n)
+    return _propose(prop_lists, resp_ranks, caps, m, n)
+
+
+def _propose(prop_lists, resp_ranks, caps, m, n):
+    """
+    Run the proposal loop on already validated tables.
+
+    """
+    matching = np.full(m, -1, dtype=int)
+    next_index = np.zeros(m, dtype=int)
+    held = [[] for _ in range(n)]
+    free = list(range(m - 1, -1, -1))
+    while free:
+        i = free.pop()
+        settled = False
+        while not settled and next_index[i] < prop_lists[i].size:
+            j = int(prop_lists[i][next_index[i]])
+            next_index[i] += 1
+            insort(held[j], (int(resp_ranks[j, i]), i))
+            matching[i] = j
+            if len(held[j]) > caps[j]:
+                rejected = held[j].pop()[1]
+                matching[rejected] = -1
+                if rejected != i:
+                    free.append(rejected)
+                    settled = True
+            else:
+                settled = True
+    return matching
+
+
+def respondent_optimal(prop_prefs, resp_prefs, caps=None):
+    """
+    Compute the respondent optimal stable matching of a two sided market.
+
+    Parameters
+    ----------
+    prop_prefs : array_like
+    resp_prefs : array_like
+    caps : array_like(int, ndim=1), optional(default=None)
+
+    Returns
+    -------
+    matching : ndarray(int, ndim=1)
+        Array of length `m`, holding the respondent of each proposer just
+        as `deferred_acceptance` does.
+
+    """
+    _, resp_lists, prop_ranks, _, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    caps = _check_caps(caps, n)
+    return _propose_multi(resp_lists, prop_ranks, caps, n, m)
+
+
+def _blocking_pairs_tables(matching, prop_lists, prop_ranks, resp_ranks, caps,
+                           m, n):
+    """
+    Collect the blocking pairs of a two sided matching.
+
+    """
+    loads = np.zeros(n, dtype=int)
+    worst = np.full(n, -1, dtype=int)
+    for i in range(m):
+        j = matching[i]
+        if j >= 0 and resp_ranks[j, i] >= 0:
+            loads[j] += 1
+            if resp_ranks[j, i] > worst[j]:
+                worst[j] = resp_ranks[j, i]
+    pairs = []
+    for i in range(m):
+        current = matching[i]
+        current_rank = prop_ranks[i, current] if current >= 0 else -1
+        for j in prop_lists[i]:
+            if j == current:
+                continue
+            if current_rank >= 0 and prop_ranks[i, j] > current_rank:
+                break
+            if loads[j] < caps[j] or resp_ranks[j, i] < worst[j]:
+                pairs.append((i, int(j)))
+    return pairs
+
+
+def _is_stable_tables(matching, prop_lists, prop_ranks, resp_ranks, caps,
+                      m, n):
+    """
+    Test stability on already validated tables.
+
+    """
+    loads = np.zeros(n, dtype=int)
+    for i in range(m):
+        j = matching[i]
+        if j < 0:
+            continue
+        if prop_ranks[i, j] < 0 or resp_ranks[j, i] < 0:
+            return False
+        loads[j] += 1
+    if (loads > caps).any():
+        return False
+    return not _blocking_pairs_tables(matching, prop_lists, prop_ranks,
+                                      resp_ranks, caps, m, n)
+
+
+def blocking_pairs(matching, prop_prefs, resp_prefs, caps=None):
+    """
+    Find the pairs that block a two sided matching.
+
+    Parameters
+    ----------
+    matching : array_like(int, ndim=1)
+        Array of length `m` holding the respondent of each proposer, with
+        -1 for an unmatched proposer.
+
+    prop_prefs : array_like
+    resp_prefs : array_like
+    caps : array_like(int, ndim=1), optional(default=None)
+
+    Returns
+    -------
+    pairs : ndarray(int, ndim=2)
+        Array of shape `(k, 2)`, sorted lexicographically. Row `(i, j)`
+        means that proposer `i` and respondent `j` block the matching.
+
+    """
+    prop_lists, _, prop_ranks, resp_ranks, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    caps = _check_caps(caps, n)
+    x = _check_matching(matching, m, n)
+    return _sorted_pairs(_blocking_pairs_tables(x, prop_lists, prop_ranks,
+                                                resp_ranks, caps, m, n))
+
+
+def is_stable(matching, prop_prefs, resp_prefs, caps=None):
+    """
+    Test whether a two sided matching is stable.
+
+    Parameters
+    ----------
+    matching : array_like(int, ndim=1)
+    prop_prefs : array_like
+    resp_prefs : array_like
+    caps : array_like(int, ndim=1), optional(default=None)
+
+    Returns
+    -------
+    bool
+        True when every matched pair is mutually acceptable, no
+        respondent holds more partners than its capacity, and there is no
+        blocking pair.
+
+    """
+    prop_lists, _, prop_ranks, resp_ranks, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    caps = _check_caps(caps, n)
+    x = _check_matching(matching, m, n)
+    return _is_stable_tables(x, prop_lists, prop_ranks, resp_ranks, caps,
+                             m, n)
+
+
+def _propose_multi(resp_lists, prop_ranks, caps, n, m):
+    """
+    Run the proposal loop with the respondents proposing.
+
+    Each respondent works down its own list until its capacity is filled,
+    so the result is the respondent optimal stable matching.
+
+    """
+    holder = np.full(m, -1, dtype=int)
+    next_index = np.zeros(n, dtype=int)
+    load = np.zeros(n, dtype=int)
+    free = list(range(n - 1, -1, -1))
+    while free:
+        j = free.pop()
+        while load[j] < caps[j] and next_index[j] < resp_lists[j].size:
+            i = int(resp_lists[j][next_index[j]])
+            next_index[j] += 1
+            current = holder[i]
+            if current < 0:
+                holder[i] = j
+                load[j] += 1
+            elif prop_ranks[i, j] < prop_ranks[i, current]:
+                holder[i] = j
+                load[j] += 1
+                load[current] -= 1
+                free.append(current)
+    return holder
+
+
+def _stable_candidates(prop_lists, resp_lists, prop_ranks, resp_ranks, caps,
+                       m, n):
+    """
+    Narrow each proposer's list and pin the number of partners each
+    respondent takes.
+
+    A proposer is matched to the same respondent in every stable matching
+    unless it lies weakly between its proposer optimal and its respondent
+    optimal partner, and every respondent fills exactly as many places in
+    one stable matching as in any other.
+
+    """
+    prop_opt = _propose(prop_lists, resp_ranks, caps, m, n)
+    prop_pess = _propose_multi(resp_lists, prop_ranks, caps, n, m)
+    target = np.zeros(n, dtype=int)
+    for i in range(m):
+        if prop_opt[i] >= 0:
+            target[prop_opt[i]] += 1
+    candidates = [[] for _ in range(m)]
+    active = []
+    for i in range(m):
+        if prop_opt[i] < 0 or prop_pess[i] < 0:
+            continue
+        active.append(i)
+        best = prop_ranks[i, prop_opt[i]]
+        worst = prop_ranks[i, prop_pess[i]]
+        for j in prop_lists[i]:
+            rank = prop_ranks[i, j]
+            if best <= rank <= worst and target[j] > 0:
+                candidates[i].append(int(j))
+    return candidates, active, target
+
+
+def _would_displace(j, candidate, slots, target, resp_ranks):
+    """
+    Test whether a respondent whose places are all taken would swap.
+
+    Returns False whenever the respondent may still receive further
+    partners, so that no partial assignment is ever discarded wrongly.
+
+    """
+    if resp_ranks[j, candidate] < 0 or len(slots[j]) < target[j]:
+        return False
+    return any(resp_ranks[j, candidate] < resp_ranks[j, held]
+               for held in slots[j])
+
+
+def _creates_block(assignment, active, k, i, j, slots, target, prop_ranks,
+                   resp_ranks):
+    """
+    Test a freshly committed pair against the pairs already committed to.
+
+    """
+    for t in range(k):
+        other = active[t]
+        partner = assignment[other]
+        if 0 <= prop_ranks[other, j] < prop_ranks[other, partner] and \
+                _would_displace(j, other, slots, target, resp_ranks):
+            return True
+        if 0 <= prop_ranks[i, partner] < prop_ranks[i, j] and \
+                _would_displace(partner, i, slots, target, resp_ranks):
+            return True
+    return False
+
+
+def stable_matchings(prop_prefs, resp_prefs, caps=None):
+    """
+    Enumerate every stable matching of a two sided market.
+
+    Parameters
+    ----------
+    prop_prefs : array_like
+    resp_prefs : array_like
+    caps : array_like(int, ndim=1), optional(default=None)
+
+    Returns
+    -------
+    matchings : ndarray(int, ndim=2)
+        Array of shape `(t, m)` whose rows are the stable matchings of the
+        market, sorted lexicographically.
+
+    """
+    prop_lists, resp_lists, prop_ranks, resp_ranks, m, n = \
+        _two_sided_setup(prop_prefs, resp_prefs)
+    caps = _check_caps(caps, n)
+    candidates, active, target = _stable_candidates(
+        prop_lists, resp_lists, prop_ranks, resp_ranks, caps, m, n
+    )
+    assignment = np.full(m, -1, dtype=int)
+    slots = [[] for _ in range(n)]
+    found = []
+
+    def extend(k):
+        if k == len(active):
+            if _is_stable_tables(assignment, prop_lists, prop_ranks,
+                                 resp_ranks, caps, m, n):
+                found.append(assignment.copy())
+            return
+        i = active[k]
+        for j in candidates[i]:
+            if len(slots[j]) >= target[j]:
+                continue
+            assignment[i] = j
+            slots[j].append(i)
+            if not _creates_block(assignment, active, k, i, j, slots, target,
+                                  prop_ranks, resp_ranks):
+                extend(k + 1)
+            slots[j].pop()
+            assignment[i] = -1
+
+    extend(0)
+    return _sorted_rows(found, m)
+
+
+def _proposer_side_ranks(prop_prefs):
+    """
+    Validate proposer side preferences on their own.
+
+    """
+    raw = [np.asarray(row, dtype=int).ravel() for row in prop_prefs]
+    bound = 0
+    for row in raw:
+        if row.size:
+            bound = max(bound, int(row.max()) + 1)
+    lists = _preference_lists(raw, bound, 'prop_prefs')
+    return _rank_table(lists, bound), len(lists), bound
+
+
+def _combine(matching1, matching2, prop_prefs, take_better):
+    """
+    Combine two matchings proposer by proposer.
+
+    """
+    ranks, m, bound = _proposer_side_ranks(prop_prefs)
+    x1 = _check_matching(matching1, m, bound, 'matching1')
+    x2 = _check_matching(matching2, m, bound, 'matching2')
+    out = np.full(m, -1, dtype=int)
+    for i in range(m):
+        for x, name in ((x1, 'matching1'), (x2, 'matching2')):
+            if x[i] >= 0 and ranks[i, x[i]] < 0:
+                raise ValueError(
+                    f"{name}[{i}] is not acceptable to proposer {i}"
+                )
+        r1 = ranks[i, x1[i]] if x1[i] >= 0 else -1
+        r2 = ranks[i, x2[i]] if x2[i] >= 0 else -1
+        if r1 < 0:
+            out[i] = x2[i] if take_better else -1
+        elif r2 < 0:
+            out[i] = x1[i] if take_better else -1
+        elif (r1 <= r2) == take_better:
+            out[i] = x1[i]
+        else:
+            out[i] = x2[i]
+    return out
+
+
+def matching_join(matching1, matching2, prop_prefs):
+    """
+    Give every proposer the better of its two partners.
+
+    Parameters
+    ----------
+    matching1 : array_like(int, ndim=1)
+    matching2 : array_like(int, ndim=1)
+    prop_prefs : array_like
+
+    Returns
+    -------
+    matching : ndarray(int, ndim=1)
+        Array of length `m`. Entry `i` is whichever of the two partners
+        proposer `i` prefers, an unmatched proposer counting as worse than
+        every acceptable respondent.
+
+    """
+    return _combine(matching1, matching2, prop_prefs, True)
+
+
+def matching_meet(matching1, matching2, prop_prefs):
+    """
+    Give every proposer the worse of its two partners.
+
+    Parameters
+    ----------
+    matching1 : array_like(int, ndim=1)
+    matching2 : array_like(int, ndim=1)
+    prop_prefs : array_like
+
+    Returns
+    -------
+    matching : ndarray(int, ndim=1)
+        Array of length `m`. Entry `i` is whichever of the two partners
+        proposer `i` likes less, an unmatched proposer counting as worse
+        than every acceptable respondent.
+
+    """
+    return _combine(matching1, matching2, prop_prefs, False)
