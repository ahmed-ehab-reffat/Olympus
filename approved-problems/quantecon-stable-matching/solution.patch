+"""
+Shared preference bookkeeping for the matching subpackage.
+
+"""
+import numpy as np
+
+
+def _preference_lists(prefs, num_partners, name, forbid_self=False):
+    """
+    Convert preference lists to a list of 1-D integer arrays.
+
+    Parameters
+    ----------
+    prefs : array_like
+        Sequence of sequences of integers. Entry `i` lists the partners
+        acceptable to agent `i`, most preferred first.
+
+    num_partners : scalar(int)
+        Number of agents on the other side, or on the same side for a
+        one sided market.
+
+    name : str
+        Name used in the error messages.
+
+    forbid_self : bool, optional(default=False)
+        If True, an agent listing itself raises `ValueError`.
+
+    Returns
+    -------
+    lists : list(ndarray(int, ndim=1))
+
+    """
+    try:
+        lists = [np.asarray(row, dtype=int).ravel() for row in prefs]
+    except (TypeError, ValueError):
+        raise ValueError(
+            f"{name} must be a sequence of sequences of integers"
+        )
+    for i, row in enumerate(lists):
+        if row.size == 0:
+            continue
+        if row.min() < 0 or row.max() >= num_partners:
+            raise ValueError(
+                f"{name}[{i}] contains an index outside "
+                f"range(0, {num_partners})"
+            )
+        if np.unique(row).size != row.size:
+            raise ValueError(f"{name}[{i}] contains a repeated index")
+        if forbid_self and (row == i).any():
+            raise ValueError(f"{name}[{i}] lists agent {i} itself")
+    return lists
+
+
+def _rank_table(lists, num_partners):
+    """
+    Dense rank lookup for a collection of preference lists.
+
+    Returns
+    -------
+    ranks : ndarray(int, ndim=2)
+        Array of shape `(len(lists), num_partners)`. Entry `(i, j)` is the
+        position of `j` in `lists[i]`, or -1 when `j` is unacceptable to `i`.
+
+    """
+    ranks = np.full((len(lists), num_partners), -1, dtype=int)
+    for i, row in enumerate(lists):
+        ranks[i, row] = np.arange(row.size)
+    return ranks
+
+
+def _mutual_lists(lists, other_ranks):
+    """
+    Restrict each preference list to the mutually acceptable partners.
+
+    """
+    return [row[other_ranks[row, i] >= 0] for i, row in enumerate(lists)]
+
+
+def _two_sided_setup(prop_prefs, resp_prefs):
+    """
+    Validate a two sided market and build the tables every routine uses.
+
+    Returns
+    -------
+    prop_lists : list(ndarray(int, ndim=1))
+        Mutually acceptable respondents of each proposer, in that
+        proposer's preference order.
+
+    resp_lists : list(ndarray(int, ndim=1))
+        Mutually acceptable proposers of each respondent, in that
+        respondent's preference order.
+
+    prop_ranks : ndarray(int, ndim=2)
+    resp_ranks : ndarray(int, ndim=2)
+    m : scalar(int)
+    n : scalar(int)
+
+    """
+    prop_raw = list(prop_prefs)
+    resp_raw = list(resp_prefs)
+    m, n = len(prop_raw), len(resp_raw)
+    prop_all = _preference_lists(prop_raw, n, 'prop_prefs')
+    resp_all = _preference_lists(resp_raw, m, 'resp_prefs')
+    prop_ranks = _rank_table(prop_all, n)
+    resp_ranks = _rank_table(resp_all, m)
+    prop_lists = _mutual_lists(prop_all, resp_ranks)
+    resp_lists = _mutual_lists(resp_all, prop_ranks)
+    return prop_lists, resp_lists, prop_ranks, resp_ranks, m, n
+
+
+def _check_caps(caps, n):
+    """
+    Validate the capacity vector and return it as an integer array.
+
+    """
+    if caps is None:
+        return np.ones(n, dtype=int)
+    caps = np.asarray(caps, dtype=int).ravel()
+    if caps.size != n:
+        raise ValueError(f"caps must have {n} entries")
+    if caps.size and caps.min() < 1:
+        raise ValueError("caps must be positive")
+    return caps
+
+
+def _check_matching(matching, size, num_partners, name='matching'):
+    """
+    Validate a partner vector and return it as an integer array.
+
+    """
+    x = np.asarray(matching, dtype=int).ravel()
+    if x.size != size:
+        raise ValueError(f"{name} must have {size} entries")
+    if x.size and (x.min() < -1 or x.max() >= num_partners):
+        raise ValueError(
+            f"{name} entries must be -1 or lie in range(0, {num_partners})"
+        )
+    return x
+
+
+def _sorted_pairs(pairs):
+    """
+    Pack a collection of index pairs into a sorted 2-D integer array.
+
+    """
+    if not pairs:
+        return np.empty((0, 2), dtype=int)
+    out = np.array(sorted(pairs), dtype=int)
+    return out.reshape(-1, 2)
+
+
+def _sorted_rows(rows, width):
+    """
+    Pack partner vectors into a lexicographically sorted 2-D array.
+
+    """
+    if not rows or width == 0:
+        return np.empty((len(rows), width), dtype=int)
+    out = np.array(sorted(tuple(int(v) for v in row) for row in rows),
+                   dtype=int)
+    return out.reshape(-1, width)
