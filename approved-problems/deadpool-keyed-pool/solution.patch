new file mode 100644
index 0000000..7084ec6
--- /dev/null
+++ b/crates/deadpool/src/managed/keyed/config.rs
@@ -0,0 +1,158 @@
+use std::{fmt, time::Duration};
+
+use crate::{
+    Runtime,
+    managed::{BuildError, Timeouts},
+};
+
+use super::{KeyedManager, KeyedPool};
+
+/// Configuration of a [`KeyedPool`].
+///
+/// [`KeyedPool`]: super::KeyedPool
+#[derive(Clone, Copy, Debug)]
+pub struct KeyedPoolConfig {
+    /// Maximum number of objects across all keys.
+    pub max_size: usize,
+
+    /// Maximum number of objects for a single key. `0` means unlimited.
+    pub max_per_key: usize,
+
+    /// Timeouts of the pool.
+    ///
+    /// Default: No timeouts.
+    pub timeouts: Timeouts,
+
+    /// Maximum lifetime of an idle object before it is reaped.
+    ///
+    /// Default: `None` (idle objects live forever).
+    pub max_idle_lifetime: Option<Duration>,
+}
+
+impl KeyedPoolConfig {
+    /// Creates a new [`KeyedPoolConfig`] with the given `max_size` and
+    /// `max_per_key` and no timeouts.
+    #[must_use]
+    pub fn new(max_size: usize, max_per_key: usize) -> Self {
+        Self {
+            max_size,
+            max_per_key,
+            timeouts: Timeouts::default(),
+            max_idle_lifetime: None,
+        }
+    }
+}
+
+impl Default for KeyedPoolConfig {
+    fn default() -> Self {
+        Self::new(crate::util::get_default_pool_max_size(), 0)
+    }
+}
+
+/// Builder for [`KeyedPool`]s.
+///
+/// Instances of this are created by calling [`KeyedPool::builder()`].
+///
+/// [`KeyedPool`]: super::KeyedPool
+#[must_use = "builder does nothing itself, use `.build()` to build it"]
+pub struct KeyedPoolBuilder<M: KeyedManager> {
+    pub(crate) manager: M,
+    pub(crate) config: KeyedPoolConfig,
+    pub(crate) runtime: Option<Runtime>,
+}
+
+impl<M> fmt::Debug for KeyedPoolBuilder<M>
+where
+    M: fmt::Debug + KeyedManager,
+{
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("KeyedPoolBuilder")
+            .field("manager", &self.manager)
+            .field("config", &self.config)
+            .field("runtime", &self.runtime)
+            .finish()
+    }
+}
+
+impl<M: KeyedManager> KeyedPoolBuilder<M> {
+    pub(crate) fn new(manager: M) -> Self {
+        Self {
+            manager,
+            config: KeyedPoolConfig::default(),
+            runtime: None,
+        }
+    }
+
+    /// Builds the [`KeyedPool`].
+    ///
+    /// # Errors
+    ///
+    /// See [`BuildError`] for details.
+    pub fn build(self) -> Result<KeyedPool<M>, BuildError> {
+        let t = &self.config.timeouts;
+        if (t.wait.is_some() || t.create.is_some() || t.recycle.is_some()) && self.runtime.is_none()
+        {
+            return Err(BuildError::NoRuntimeSpecified);
+        }
+        Ok(KeyedPool::from_builder(self))
+    }
+
+    /// Sets a [`KeyedPoolConfig`] to build the [`KeyedPool`] with.
+    pub fn config(mut self, value: KeyedPoolConfig) -> Self {
+        self.config = value;
+        self
+    }
+
+    /// Sets the [`KeyedPoolConfig::max_size`].
+    pub fn max_size(mut self, value: usize) -> Self {
+        self.config.max_size = value;
+        self
+    }
+
+    /// Sets the [`KeyedPoolConfig::max_per_key`].
+    pub fn max_per_key(mut self, value: usize) -> Self {
+        self.config.max_per_key = value;
+        self
+    }
+
+    /// Sets the [`KeyedPoolConfig::timeouts`].
+    pub fn timeouts(mut self, value: Timeouts) -> Self {
+        self.config.timeouts = value;
+        self
+    }
+
+    /// Sets the [`Timeouts::wait`] value of the [`KeyedPoolConfig::timeouts`].
+    pub fn wait_timeout(mut self, value: Option<Duration>) -> Self {
+        self.config.timeouts.wait = value;
+        self
+    }
+
+    /// Sets the [`Timeouts::create`] value of the [`KeyedPoolConfig::timeouts`].
+    pub fn create_timeout(mut self, value: Option<Duration>) -> Self {
+        self.config.timeouts.create = value;
+        self
+    }
+
+    /// Sets the [`Timeouts::recycle`] value of the
+    /// [`KeyedPoolConfig::timeouts`].
+    pub fn recycle_timeout(mut self, value: Option<Duration>) -> Self {
+        self.config.timeouts.recycle = value;
+        self
+    }
+
+    /// Sets the [`KeyedPoolConfig::max_idle_lifetime`].
+    pub fn max_idle_lifetime(mut self, value: Option<Duration>) -> Self {
+        self.config.max_idle_lifetime = value;
+        self
+    }
+
+    /// Sets the [`Runtime`].
+    ///
+    /// A [`Runtime`] is required whenever any timeout is configured. Building a
+    /// pool with timeouts but no [`Runtime`] fails with
+    /// [`BuildError::NoRuntimeSpecified`].
+    pub fn runtime(mut self, value: Runtime) -> Self {
+        self.runtime = Some(value);
+        self
+    }
+}
diff --git a/crates/deadpool/src/managed/keyed/manager.rs b/crates/deadpool/src/managed/keyed/manager.rs
