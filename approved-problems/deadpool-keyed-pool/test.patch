+/// Reads an object's id through the associated-function API.
+fn object_id(o: &deadpool::managed::KeyedObject<Backend>) -> ObjectId {
+    deadpool::managed::KeyedObject::id(o)
+}
+
+#[tokio::test]
+async fn idle_object_is_reused_for_same_key() {
+    let pool = pool(4, 0);
+    let a = pool.get("k").await.unwrap();
+    let id = object_id(&a);
+    drop(a);
+    let b = pool.get("k").await.unwrap();
+    assert_eq!(object_id(&b), id, "idle object should be reused, not recreated");
+    drop(b);
+}
+
+#[tokio::test]
+async fn stale_idle_object_is_discarded_on_get() {
+    // A zero idle lifetime makes every idle object stale, so `get` must discard
+    // it and create a fresh one instead of reusing it.
+    let pool = KeyedPool::builder(Backend::default())
+        .max_size(4)
+        .max_idle_lifetime(Some(Duration::ZERO))
+        .build()
+        .unwrap();
+    let a = pool.get("k").await.unwrap();
+    let first = object_id(&a);
+    drop(a);
+
+    let b = pool.get("k").await.unwrap();
+    assert_ne!(object_id(&b), first, "a stale idle object must not be reused");
+    assert_eq!(pool.key_size(&"k"), 1);
+    drop(b);
+}
+
+#[tokio::test]
+async fn zero_max_per_key_means_unlimited() {
+    let pool = pool(4, 0);
+    let a = pool.get("k").await.unwrap();
+    let b = pool.get("k").await.unwrap();
+    let c = pool.get("k").await.unwrap();
+    assert_eq!(pool.key_size(&"k"), 3, "max_per_key of 0 must not limit a key");
+    drop((a, b, c));
+}
