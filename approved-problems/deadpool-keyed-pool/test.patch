+#[tokio::test]
+async fn resize_shrink_drops_idle_and_respects_new_cap() {
+    let pool = pool(4, 0);
+    for k in ["a", "b", "c"] {
+        drop(pool.get(k).await.unwrap());
+    }
+    assert_eq!(pool.status().size, 3);
+    pool.resize(1);
+    assert!(pool.status().size <= 1, "shrink must drop idle objects down to the new cap");
+    // the freed slots are reusable
+    let x = pool.get("d").await.unwrap();
+    assert!(pool.status().size <= 1);
+    drop(x);
+}
+
+#[tokio::test]
+async fn resize_grow_adds_capacity() {
+    let pool = pool(1, 0);
+    let a = pool.get("a").await.unwrap();
+    let fut = pool.get("b");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await);
+    pool.resize(2);
+    let b = fut.await.unwrap();
+    assert_eq!(pool.status().size, 2);
+    drop((a, b));
+}
+
+#[tokio::test]
+async fn clear_key_frees_only_that_key() {
+    let pool = pool(4, 0);
+    drop(pool.get("a").await.unwrap());
+    drop(pool.get("b").await.unwrap());
+    assert_eq!(pool.status().size, 2);
+    pool.clear_key(&"a");
+    assert_eq!(pool.key_size(&"a"), 0);
+    assert_eq!(pool.key_size(&"b"), 1);
+    assert_eq!(pool.status().size, 1);
+    // freed slot reusable by any key
+    let c = pool.get("c").await.unwrap();
+    assert!(pool.status().size <= 4);
+    drop(c);
+}
+
+#[tokio::test]
+async fn capacity_is_still_enforced_after_clear_key() {
+    // Removing an idle object frees a slot, but it must not increase the pool's
+    // effective capacity: once the freed slot is refilled the pool is full again.
+    let pool = pool(2, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    drop(a);
+    pool.clear_key(&"a");
+    assert_eq!(pool.status().size, 1);
+
+    let c = pool.get("c").await.unwrap();
+    assert_eq!(pool.status().size, 2);
+
+    // "b" and "c" are in flight and nothing is idle, so a further get must wait.
+    let fut = pool.get("d");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await, "max_size must still be enforced after clear_key");
+    assert!(pool.status().size <= 2);
+    drop((b, c));
+}
+
+#[tokio::test]
+async fn capacity_is_still_enforced_after_reap_idle() {
+    let pool = KeyedPool::builder(Backend::default())
+        .max_size(2)
+        .max_idle_lifetime(Some(Duration::ZERO))
+        .build()
+        .unwrap();
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    drop(a);
+    assert_eq!(pool.reap_idle(), 1);
+    assert_eq!(pool.status().size, 1);
+
+    let c = pool.get("c").await.unwrap();
+    assert_eq!(pool.status().size, 2);
+
+    let fut = pool.get("d");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await, "max_size must still be enforced after reap_idle");
+    assert!(pool.status().size <= 2);
+    drop((b, c));
+}
+
+#[tokio::test]
+async fn retain_removes_rejected_idle_objects() {
+    let pool = pool(4, 0);
+    drop(pool.get("a").await.unwrap());
+    drop(pool.get("b").await.unwrap());
+    let result: KeyedRetainResult = pool.retain(|key, _obj, _metrics| *key == "a");
+    assert_eq!(result.retained, 1);
+    assert_eq!(result.removed, 1);
+    assert_eq!(pool.key_size(&"b"), 0);
+    assert_eq!(pool.key_size(&"a"), 1);
+}
+
+#[tokio::test]
+async fn reap_idle_removes_stale_and_keeps_fresh() {
+    let stale = KeyedPool::builder(Backend::default())
+        .max_size(4)
+        .max_idle_lifetime(Some(Duration::ZERO))
+        .build()
+        .unwrap();
+    drop(stale.get("a").await.unwrap());
+    drop(stale.get("b").await.unwrap());
+    assert_eq!(stale.reap_idle(), 2, "zero lifetime makes every idle object stale");
+    assert_eq!(stale.status().size, 0);
+
+    let fresh = KeyedPool::builder(Backend::default())
+        .max_size(4)
+        .max_idle_lifetime(Some(Duration::from_secs(3600)))
+        .build()
+        .unwrap();
+    drop(fresh.get("a").await.unwrap());
+    assert_eq!(fresh.reap_idle(), 0);
+    assert_eq!(fresh.status().size, 1);
+}
+
+#[tokio::test]
+async fn close_rejects_new_gets_but_returns_in_flight() {
+    let pool = pool(2, 0);
+    let a = pool.get("a").await.unwrap();
+    pool.close();
+    assert!(pool.is_closed());
+    assert!(matches!(pool.get("b").await, Err(PoolError::Closed)));
+    // the in-flight object still drops cleanly
+    drop(a);
+}
+
+#[tokio::test]
+async fn take_removes_object_permanently() {
+    let pool = pool(2, 0);
+    let a = pool.get("k").await.unwrap();
+    assert_eq!(pool.key_size(&"k"), 1);
+    let value = deadpool::managed::KeyedObject::take(a);
+    let _ = value;
+    assert_eq!(pool.key_size(&"k"), 0, "take must free the slot");
+    // slot is reusable
+    let b = pool.get("k").await.unwrap();
+    assert_eq!(pool.key_size(&"k"), 1);
+    drop(b);
+}
+
+#[tokio::test]
+async fn object_ids_are_unique_and_increasing() {
+    let pool = pool(4, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    let c = pool.get("a").await.unwrap();
+    let (ia, ib, ic) = (object_id(&a), object_id(&b), object_id(&c));
+    assert!(ia < ib && ib < ic, "ids must be unique and increasing: {ia:?}, {ib:?}, {ic:?}");
+    drop((a, b, c));
+}
+
+#[tokio::test]
+async fn close_detaches_idle_objects() {
+    let pool = pool(4, 0);
+    drop(pool.get("a").await.unwrap());
+    drop(pool.get("b").await.unwrap());
+    assert_eq!(pool.status().size, 2);
+
+    pool.close();
+    assert!(pool.is_closed());
+    assert_eq!(pool.status().size, 0, "close must detach the idle objects");
+}
+
+#[tokio::test]
+async fn resize_shrink_keeps_checked_out_objects() {
+    let pool = pool(3, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    drop(pool.get("c").await.unwrap()); // one idle object
+    assert_eq!(pool.status().size, 3);
+
+    // Shrinking below the number of checked-out objects drops only the idle one;
+    // the two in-flight objects are never removed.
+    pool.resize(1);
+    assert_eq!(pool.status().size, 2, "checked-out objects must survive a shrink");
+    assert_eq!(pool.key_size(&"c"), 0, "the idle object is dropped");
+    assert_eq!(pool.key_size(&"a"), 1);
+    assert_eq!(pool.key_size(&"b"), 1);
+    drop((a, b));
+}
+
+#[tokio::test]
+async fn close_returns_closed_even_for_a_saturated_key() {
+    // The per-key limit is reached, so a further get for that key would queue on
+    // the per-key gate. Closing the pool must still make it fail rather than
+    // leave the caller blocked forever.
+    let pool = pool(4, 1);
+    let a = pool.get("k").await.unwrap();
+    pool.close();
+
+    let result = tokio::time::timeout(Duration::from_secs(5), pool.get("k"))
+        .await
+        .expect("close() must not leave a get() for a saturated key blocked");
+    assert!(matches!(result, Err(PoolError::Closed)));
+    drop(a);
+}
+
+#[tokio::test]
+async fn nothing_is_handed_out_while_over_capacity_after_a_shrink() {
+    let pool = pool(3, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    let c = pool.get("c").await.unwrap();
+    assert_eq!(pool.status().size, 3);
+
+    // Nothing is idle, so the shrink cannot remove anything and the pool is left
+    // above the new cap.
+    pool.resize(1);
+    assert_eq!(pool.status().size, 3, "checked-out objects survive a shrink");
+
+    let fut = pool.get("d");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await, "no object may be handed out while over the cap");
+
+    // While over the cap a returned object is discarded rather than kept idle,
+    // and the waiter still gets nothing.
+    drop(a);
+    assert_eq!(pool.status().size, 2);
+    assert!(is_pending(&mut fut).await, "still over the cap");
+
+    drop(b);
+    assert_eq!(pool.status().size, 1);
+    assert!(is_pending(&mut fut).await, "the last object is still checked out");
+
+    // Once the pool is back within the cap the waiter is finally served.
+    drop(c);
+    let d = fut.await.unwrap();
+    assert!(pool.status().size <= 1, "size must be back within the new cap");
+    drop(d);
+}
+
+#[tokio::test]
+async fn resize_shrink_then_grow_does_not_over_issue_capacity() {
+    // A shrink cannot remove checked-out objects, so it can leave the pool over
+    // capacity. Growing again must only hand out the slots that are genuinely
+    // free, not `new_max - old_max` of them.
+    let pool = pool(3, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    drop(pool.get("c").await.unwrap()); // one idle object
+    assert_eq!(pool.status().size, 3);
+
+    pool.resize(1); // drops the idle object; the two checked-out ones remain
+    assert_eq!(pool.status().size, 2);
+    pool.resize(3);
+
+    let d = pool.get("d").await.unwrap(); // fills the single genuinely free slot
+    assert_eq!(pool.status().size, 3);
+
+    let fut = pool.get("e");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await, "growing must not over-issue capacity");
+    assert!(pool.status().size <= 3, "size must never exceed max_size");
+    drop((a, b, d));
+}
+
+#[tokio::test]
+async fn cleanup_never_disturbs_checked_out_objects() {
+    let pool = pool(4, 0);
+    let a = pool.get("k").await.unwrap(); // checked out
+    drop(pool.get("k").await.unwrap()); // idle, same key
+    assert_eq!(pool.key_size(&"k"), 2);
+
+    pool.clear_key(&"k");
+    assert_eq!(pool.key_size(&"k"), 1, "clear_key removes only the idle object");
+
+    // the checked-out object is untouched and still returns cleanly
+    drop(a);
+    assert_eq!(pool.key_size(&"k"), 1);
+    assert_eq!(pool.status().available, 1);
+}
+
+#[tokio::test]
+async fn status_and_key_introspection() {
+    let pool = pool(4, 3);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("a").await.unwrap();
+    drop(pool.get("b").await.unwrap());
+    let ks: KeyedKeyStatus = pool.key_status(&"a");
+    assert_eq!(ks.size, 2);
+    assert_eq!(ks.available, 0);
+    assert_eq!(ks.max_per_key, 3);
+
+    let status: KeyedStatus = pool.status();
+    assert_eq!(status.max_size, 4);
+    assert_eq!(status.size, 3);
+    assert_eq!(status.available, 1, "only the returned \"b\" object is idle");
+    assert_eq!(status.keys, 2, "two keys hold objects");
+
+    let mut keys = pool.keys();
+    keys.sort_unstable();
+    assert_eq!(keys, vec!["a", "b"]);
+    drop((a, b));
+}
