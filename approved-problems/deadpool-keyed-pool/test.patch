+/// A manager whose `create` and `recycle` are slow enough to trip timeouts.
+#[derive(Default)]
+struct SlowBackend {
+    next: AtomicUsize,
+    slow_recycle: bool,
+}
+
+impl KeyedManager for SlowBackend {
+    type Key = &'static str;
+    type Type = usize;
+    type Error = ();
+
+    async fn create(&self, _key: &&'static str) -> Result<usize, ()> {
+        if !self.slow_recycle {
+            tokio::time::sleep(Duration::from_millis(500)).await;
+        }
+        Ok(self.next.fetch_add(1, Ordering::SeqCst))
+    }
+
+    async fn recycle(
+        &self,
+        _key: &&'static str,
+        _obj: &mut usize,
+        _metrics: &Metrics,
+    ) -> RecycleResult<()> {
+        if self.slow_recycle {
+            tokio::time::sleep(Duration::from_millis(500)).await;
+        }
+        Ok(())
+    }
+
+    fn detach(&self, _key: &&'static str, _obj: &mut usize) {}
+}
+
+#[tokio::test]
+async fn timeout_get_overrides_the_create_timeout() {
+    // The pool's configured create timeout is generous; a per-call short one
+    // must override it, so the override applies to more than just `wait`.
+    let pool = KeyedPool::builder(SlowBackend::default())
+        .max_size(1)
+        .create_timeout(Some(Duration::from_secs(30)))
+        .runtime(Runtime::Tokio1)
+        .build()
+        .unwrap();
+
+    let short = Timeouts {
+        create: Some(Duration::from_millis(20)),
+        ..Timeouts::default()
+    };
+    let err = pool.timeout_get("a", &short).await.err().unwrap();
+    assert!(matches!(err, PoolError::Timeout(_)));
+}
+
+#[tokio::test]
+async fn timeout_get_overrides_the_recycle_timeout() {
+    // The pool's configured recycle timeout is generous; a per-call short one
+    // must override it, so the idle object cannot be recycled and is replaced.
+    let pool = KeyedPool::builder(SlowBackend {
+        next: AtomicUsize::new(0),
+        slow_recycle: true,
+    })
+    .max_size(2)
+    .recycle_timeout(Some(Duration::from_secs(30)))
+    .runtime(Runtime::Tokio1)
+    .build()
+    .unwrap();
+
+    drop(pool.get("k").await.unwrap()); // object 0, now idle
+
+    let short = Timeouts {
+        recycle: Some(Duration::from_millis(20)),
+        ..Timeouts::default()
+    };
+    let b = pool.timeout_get("k", &short).await.unwrap();
+    assert_eq!(*b, 1, "the un-recyclable idle object is replaced by a fresh one");
+    drop(b);
+}
+
+#[tokio::test]
+async fn create_timeout_expires() {
+    let pool = KeyedPool::builder(SlowBackend::default())
+        .max_size(1)
+        .create_timeout(Some(Duration::from_millis(20)))
+        .runtime(Runtime::Tokio1)
+        .build()
+        .unwrap();
+    let err = pool.get("a").await.err().unwrap();
+    assert!(matches!(err, PoolError::Timeout(_)));
+}
+
+#[tokio::test]
+async fn recycle_timeout_discards_the_idle_object() {
+    let pool = KeyedPool::builder(SlowBackend {
+        next: AtomicUsize::new(0),
+        slow_recycle: true,
+    })
+    .max_size(2)
+    .recycle_timeout(Some(Duration::from_millis(20)))
+    .runtime(Runtime::Tokio1)
+    .build()
+    .unwrap();
+
+    let a = pool.get("k").await.unwrap();
+    drop(a); // now idle; recycling it will time out
+
+    // The idle object cannot be recycled, so it is discarded and a fresh one is
+    // created instead of surfacing an error.
+    let b = pool.get("k").await.unwrap();
+    assert_eq!(*b, 1, "a fresh object replaces the un-recyclable idle one");
+    assert_eq!(pool.key_size(&"k"), 1);
+    drop(b);
+}
+
+#[test]
+fn builder_requires_runtime_for_timeouts() {
+    let result = KeyedPool::builder(Backend::default())
+        .wait_timeout(Some(Duration::from_millis(10)))
+        .build();
+    assert!(result.is_err(), "timeouts without a runtime must fail to build");
+}
+
+#[tokio::test]
+async fn cancelling_a_get_while_it_creates_gives_the_slot_back() {
+    let pool = slow_pool(2, 0, false);
+    {
+        let fut = pool.get("a");
+        tokio::pin!(fut);
+        assert!(is_pending(&mut fut).await);
+    }
+    assert_eq!(pool.status().size, 0);
+    assert_eq!(pool.key_size(&"a"), 0);
+    assert_eq!(pool.status().available, 0);
+}
+
+#[tokio::test]
+async fn cancelling_a_get_while_it_recycles_gives_the_slot_back() {
+    let pool = slow_pool(2, 0, true);
+    drop(pool.get("a").await.unwrap());
+    assert_eq!(pool.status().size, 1);
+    {
+        let fut = pool.get("a");
+        tokio::pin!(fut);
+        assert!(is_pending(&mut fut).await);
+    }
+    assert_eq!(pool.status().size, 0);
+    assert_eq!(pool.key_size(&"a"), 0);
+}
+
+#[tokio::test]
+async fn cancelling_a_get_that_waits_for_capacity_leaves_the_pool_intact() {
+    let pool = pool(1, 0);
+    let held = pool.get("a").await.unwrap();
+    {
+        let fut = pool.get("b");
+        tokio::pin!(fut);
+        assert!(is_pending(&mut fut).await);
+    }
+    assert_eq!(pool.status().size, 1);
+    drop(held);
+    let next = pool.get("b").await.unwrap();
+    assert_eq!(pool.key_size(&"b"), 1);
+    drop(next);
+}
+
+#[tokio::test]
+async fn a_cancelled_waiter_does_not_swallow_the_object_it_was_waiting_for() {
+    let pool = pool(1, 0);
+    let held = pool.get("a").await.unwrap();
+    let mut abandoned = Box::pin(pool.get("a"));
+    assert!(is_pending(&mut abandoned.as_mut()).await);
+    drop(held);
+    drop(abandoned);
+
+    let obj = tokio::time::timeout(Duration::from_secs(5), pool.get("a"))
+        .await
+        .expect("the cancelled waiter must not keep the only slot")
+        .unwrap();
+    assert_eq!(pool.status().size, 1);
+    drop(obj);
+}
+
+#[tokio::test]
+async fn cancelling_a_get_frees_the_per_key_slot_too() {
+    let pool = slow_pool(4, 1, false);
+    {
+        let fut = pool.get("a");
+        tokio::pin!(fut);
+        assert!(is_pending(&mut fut).await);
+    }
+    assert_eq!(pool.key_size(&"a"), 0);
+
+    let fut = pool.get("a");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await);
+    let obj = fut.await.unwrap();
+    assert_eq!(pool.key_size(&"a"), 1);
+    drop(obj);
+}
+
+#[tokio::test]
+async fn repeated_cancellation_never_erodes_the_capacity() {
+    let pool = slow_pool(2, 0, false);
+    for key in ["a", "b", "c", "a", "b"] {
+        let fut = pool.get(key);
+        tokio::pin!(fut);
+        assert!(is_pending(&mut fut).await);
+    }
+    assert_eq!(pool.status().size, 0);
+    assert_eq!(pool.keys().len(), 0);
+
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    assert_eq!(pool.status().size, 2);
+
+    let fut = pool.get("c");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await);
+    drop((a, b));
+}
