+#[tokio::test]
+async fn timeout_get_overrides_configured_timeouts() {
+    // The pool is configured to wait indefinitely; a per-call zero wait timeout
+    // must override that and fail immediately instead of blocking.
+    let pool = pool(1, 0);
+    let _a = pool.get("a").await.unwrap();
+
+    let non_blocking = Timeouts { wait: Some(Duration::ZERO), ..Timeouts::default() };
+    let err = pool.timeout_get("b", &non_blocking).await.err().unwrap();
+    assert!(matches!(err, PoolError::Timeout(_)));
+
+    // ...while the configured (unbounded) wait still blocks rather than erroring.
+    let fut = pool.get("b");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await);
+}
+
+#[tokio::test]
+async fn non_blocking_wait_returns_timeout_when_saturated() {
+    let pool = pool(1, 0);
+    let _a = pool.get("a").await.unwrap();
+    let timeouts = Timeouts { wait: Some(Duration::ZERO), ..Timeouts::default() };
+    let err = pool.timeout_get("b", &timeouts).await.err().unwrap();
+    assert!(matches!(err, PoolError::Timeout(_)));
+}
+
+#[tokio::test]
+async fn blocking_wait_timeout_expires() {
+    let pool = KeyedPool::builder(Backend::default())
+        .max_size(1)
+        .wait_timeout(Some(Duration::from_millis(20)))
+        .runtime(Runtime::Tokio1)
+        .build()
+        .unwrap();
+    let _a = pool.get("a").await.unwrap();
+    let err = pool.get("b").await.err().unwrap();
+    assert!(matches!(err, PoolError::Timeout(_)));
+}
