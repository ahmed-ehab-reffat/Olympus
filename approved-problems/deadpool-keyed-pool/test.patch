+#!/usr/bin/env bash
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      shift
+      ;;
+  esac
+done
+
+if [ -z "$MODE" ] || [ -z "$OUTPUT_PATH" ]; then
+  echo "usage: test.sh --output_path <path> base|new" >&2
+  exit 2
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+cd "$(dirname "$0")"
+
+export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"
+export PATH="${CARGO_HOME}/bin:${PATH}"
+export CARGO_NET_OFFLINE=true
+export CARGO_TERM_COLOR=never
+
+TEST_FILE="crates/deadpool/tests/keyed_pool_behavior_matrix.rs"
+TEST_TARGET="keyed_pool_behavior_matrix"
+
+sanitize() {
+  printf '%s' "$1" | tail -c 4000 | sed 's/]]>/]] >/g'
+}
+
+if [ "$MODE" = "new" ]; then
+  # The hidden suite exercises the keyed pool through the public API. On the
+  # base repo it does not compile (the keyed pool does not exist yet), so cargo
+  # emits a compiler error and no per-test results; in that case synthesize one
+  # failing node per expected test so the report keeps per-test granularity.
+  TESTS=$(awk '/#\[(tokio::)?test\]/{getline; if ($0 ~ /fn /) {sub(/.*fn /,""); sub(/\(.*/,""); print}}' "$TEST_FILE")
+
+  OUT=$(cd crates/deadpool && cargo test --features rt_tokio_1,managed --test "$TEST_TARGET" 2>&1)
+
+  total=0
+  failures=0
+  body=""
+  for tn in $TESTS; do
+    total=$((total + 1))
+    if printf '%s\n' "$OUT" | grep -qE "^test ${tn} \.\.\. ok"; then
+      body="$body    <testcase name=\"${tn}\" classname=\"keyed_pool\"></testcase>
+"
+    else
+      failures=$((failures + 1))
+      body="$body    <testcase name=\"${tn}\" classname=\"keyed_pool\"><failure message=\"failed\"><![CDATA[$(sanitize "$OUT")]]></failure></testcase>
+"
+    fi
+  done
+
+  cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="keyed_pool" tests="${total}" failures="${failures}">
+${body}  </testsuite>
+</testsuites>
+XML
+  [ "$failures" -eq 0 ] && exit 0 || exit 1
+fi
+
+# base mode: the crate's own unit tests and doctests. Integration test targets
+# are not compiled here, so the hidden suite (added by test.patch) is excluded
+# and this passes on the base repo as well as with the solution applied.
+LIB_OUT=$(cd crates/deadpool && cargo test --lib 2>&1)
+RC=$?
+DOC_OUT=$(cd crates/deadpool && cargo test --doc 2>&1)
+DOC_RC=$?
+[ "$RC" -eq 0 ] && RC=$DOC_RC
+OUT="${LIB_OUT}
+${DOC_OUT}"
+
+if [ "$RC" -eq 0 ]; then
+  cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="regression" tests="1" failures="0">
+    <testcase name="deadpool_lib_and_doctests" classname="regression"></testcase>
+  </testsuite>
+</testsuites>
+XML
+else
+  cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="regression" tests="1" failures="1">
+    <testcase name="deadpool_lib_and_doctests" classname="regression"><failure message="failed"><![CDATA[$(sanitize "$OUT")]]></failure></testcase>
+  </testsuite>
+</testsuites>
+XML
+fi
+exit "$RC"
