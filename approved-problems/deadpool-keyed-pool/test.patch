+//! Behavioral conformance suite for the keyed managed pool, exercised entirely
+//! through the public API.
+
+#![cfg(feature = "managed")]
+
+use std::{
+    future::{poll_fn, Future},
+    pin::Pin,
+    sync::atomic::{AtomicUsize, Ordering},
+    sync::{Arc, Mutex},
+    task::Poll,
+    time::Duration,
+};
+
+use deadpool::managed::{
+    KeyedKeyStatus, KeyedManager, KeyedPool, KeyedPoolConfig, KeyedRetainResult, KeyedStatus,
+    Metrics, ObjectId, PoolError, RecycleResult, Timeouts,
+};
+use deadpool::Runtime;
+
+#[derive(Default)]
+struct Backend {
+    next: AtomicUsize,
+}
+
+impl KeyedManager for Backend {
+    type Key = &'static str;
+    type Type = usize;
+    type Error = ();
+
+    async fn create(&self, _key: &&'static str) -> Result<usize, ()> {
+        Ok(self.next.fetch_add(1, Ordering::SeqCst))
+    }
+
+    async fn recycle(
+        &self,
+        _key: &&'static str,
+        _obj: &mut usize,
+        _metrics: &Metrics,
+    ) -> RecycleResult<()> {
+        Ok(())
+    }
+
+}
+
+fn pool(max_size: usize, max_per_key: usize) -> KeyedPool<Backend> {
+    KeyedPool::new(Backend::default(), KeyedPoolConfig::new(max_size, max_per_key))
+}
+
+fn slow_pool(max_size: usize, max_per_key: usize, slow_recycle: bool) -> KeyedPool<SlowBackend> {
+    KeyedPool::new(
+        SlowBackend {
+            next: AtomicUsize::new(0),
+            slow_recycle,
+        },
+        KeyedPoolConfig::new(max_size, max_per_key),
+    )
+}
+
+/// Polls the future once and reports whether it is still pending.
+async fn is_pending<F: Future>(fut: &mut Pin<&mut F>) -> bool {
+    poll_fn(|cx| Poll::Ready(fut.as_mut().poll(cx).is_pending())).await
+}
+
+#[tokio::test]
+async fn per_key_limit_serializes_same_key() {
+    let pool = pool(8, 1);
+    let a = pool.get("k").await.unwrap();
+    assert_eq!(pool.key_size(&"k"), 1);
+
+    let fut = pool.get("k");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await, "second get on a saturated key must wait");
+
+    drop(a);
+    let b = fut.await.unwrap();
+    assert_eq!(pool.key_size(&"k"), 1);
+    drop(b);
+}
+
+#[tokio::test]
+async fn global_capacity_is_never_exceeded() {
+    let pool = pool(2, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    assert_eq!(pool.status().size, 2);
+
+    let fut = pool.get("c");
+    tokio::pin!(fut);
+    assert!(is_pending(&mut fut).await, "third object over global cap must wait");
+
+    drop(a);
+    let c = fut.await.unwrap();
+    assert!(pool.status().size <= 2, "size must never exceed max_size");
+    drop((b, c));
+}
+
+#[tokio::test]
+async fn full_pool_evicts_idle_object_of_another_key() {
+    let pool = pool(2, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    // "a" is returned first, so it is the least-recently-returned idle object.
+    drop(a);
+    drop(b);
+    assert_eq!(pool.status().size, 2);
+    assert_eq!(pool.status().available, 2);
+
+    // A brand-new key when globally full must evict the least-recently-returned
+    // idle object of a different key, i.e. "a" rather than "b".
+    let c = pool.get("c").await.unwrap();
+    assert!(pool.status().size <= 2);
+    assert_eq!(pool.key_size(&"c"), 1);
+    assert_eq!(pool.key_size(&"a"), 0, "the least-recently-returned idle object is the victim");
+    assert_eq!(pool.key_size(&"b"), 1, "the more recently returned idle object survives");
+    drop(c);
+}
+
+#[tokio::test]
+async fn eviction_victim_follows_return_order() {
+    // Same as above but with the return order reversed: "b" is returned first
+    // and must therefore be the victim.
+    let pool = pool(2, 0);
+    let a = pool.get("a").await.unwrap();
+    let b = pool.get("b").await.unwrap();
+    drop(b);
+    drop(a);
+
+    let c = pool.get("c").await.unwrap();
+    assert_eq!(pool.key_size(&"b"), 0, "the least-recently-returned idle object is the victim");
+    assert_eq!(pool.key_size(&"a"), 1);
+    assert_eq!(pool.key_size(&"c"), 1);
+    drop(c);
+}
