+/// Records the key handed to every manager callback into a shared log.
+struct Recorder {
+    calls: Arc<Mutex<Vec<String>>>,
+}
+
+impl KeyedManager for Recorder {
+    type Key = &'static str;
+    type Type = usize;
+    type Error = ();
+
+    async fn create(&self, key: &&'static str) -> Result<usize, ()> {
+        self.calls.lock().unwrap().push(format!("create:{key}"));
+        Ok(0)
+    }
+
+    async fn recycle(
+        &self,
+        key: &&'static str,
+        _obj: &mut usize,
+        _metrics: &Metrics,
+    ) -> RecycleResult<()> {
+        self.calls.lock().unwrap().push(format!("recycle:{key}"));
+        Ok(())
+    }
+
+    fn detach(&self, key: &&'static str, _obj: &mut usize) {
+        self.calls.lock().unwrap().push(format!("detach:{key}"));
+    }
+}
+
+#[tokio::test]
+async fn manager_callbacks_receive_the_right_key() {
+    let calls: Arc<Mutex<Vec<String>>> = Arc::new(Mutex::new(Vec::new()));
+    let pool = KeyedPool::new(
+        Recorder {
+            calls: Arc::clone(&calls),
+        },
+        KeyedPoolConfig::new(2, 0),
+    );
+
+    drop(pool.get("a").await.unwrap()); // create:a, then idle
+    drop(pool.get("a").await.unwrap()); // recycle:a (reused)
+    let b = pool.get("b").await.unwrap(); // create:b
+    drop(b);
+
+    // Pool is full with "a" and "b" idle; "a" was returned first, so a get for a
+    // new key evicts "a" -> detach:a, then create:c.
+    let c = pool.get("c").await.unwrap();
+    drop(c);
+
+    let calls = calls.lock().unwrap().clone();
+    assert_eq!(
+        calls,
+        vec!["create:a", "recycle:a", "create:b", "detach:a", "create:c"],
+        "each callback must receive the key it belongs to"
+    );
+}
