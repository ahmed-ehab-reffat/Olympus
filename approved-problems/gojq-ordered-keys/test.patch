+// orderedRejectsLikePlain checks that input the existing decoder rejects is
+// rejected the same way when the key order is kept, and that neither route
+// writes a value first.
+func orderedRejectsLikePlain(t *testing.T, args, plainArgs []string, input string) {
+	t.Helper()
+	got, code := orderedRunFull(t, args, input)
+	want, plainCode := orderedRunFull(t, plainArgs, input)
+	if plainCode == 0 {
+		t.Fatalf("input %s\nexpected the plain run to fail", input)
+	}
+	if code != plainCode {
+		t.Fatalf("input %s\nordered exited %d, plain exited %d", input, code, plainCode)
+	}
+	if got != "" || want != "" {
+		t.Fatalf("input %s\nordered wrote %q, plain wrote %q", input, got, want)
+	}
+}
