+// orderedExitCode runs a query which is expected to fail and returns the exit
+// code, so that a function can be compared against an established one without
+// depending on the wording of the message.
+func orderedExitCode(t *testing.T, args []string, input string) int {
+	t.Helper()
+	var outStream, errStream strings.Builder
+	c := cli{
+		inStream:  newStringReader(input),
+		outStream: &outStream,
+		errStream: &errStream,
+	}
+	code := c.run(args)
+	if code == 0 {
+		t.Fatalf("args %v\ninput %s\nexpected a non-zero exit code", args, input)
+	}
+	if s := outStream.String(); s != "" {
+		t.Fatalf("args %v\ninput %s\nstandard output: %s", args, input, s)
+	}
+	if s := errStream.String(); s == "" {
+		t.Fatalf("args %v\ninput %s\nexpected a message on standard error", args, input)
+	}
+	return code
+}
