+	got, code := orderedRunFull(t, []string{"-c", "--ordered-keys", "."}, input)
+	if got != "{\"b\":1,\"a\":2}\n" {
+		t.Fatalf("ordered run wrote %q", got)
+	}
+	want, plainCode := orderedRunFull(t, []string{"-c", "."}, input)
+	if want != "{\"a\":2,\"b\":1}\n" {
+		t.Fatalf("plain run wrote %q", want)
+	}
+	if code != plainCode {
+		t.Fatalf("ordered exited %d, plain exited %d", code, plainCode)
+	}
+	if code == 0 {
+		t.Fatal("expected a non-zero exit code")
+	}
+}
