+var orderedKeyPattern = regexp.MustCompile(`"([a-z]+)":`)
+
+// orderedKeySequence returns the object keys a run printed, in the order they
+// were printed, so that one output layout can be compared against another
+// without pinning any whitespace.
+func orderedKeySequence(t *testing.T, args []string, input string) []string {
+	t.Helper()
+	var keys []string
+	for _, m := range orderedKeyPattern.FindAllStringSubmatch(orderedRun(t, args, input), -1) {
+		keys = append(keys, m[1])
+	}
+	return keys
+}
+
+var orderedANSI = regexp.MustCompile("\x1b\\[[0-9;]*m")
+
+// orderedColored checks that colored output carries the same keys in the same
+// order as the uncolored form, and that it really is colored.
+func orderedColored(t *testing.T, args []string, input, expected string) {
+	t.Helper()
+	got := orderedRun(t, args, input)
+	if !strings.Contains(got, "\x1b[") {
+		t.Fatalf("args %v\noutput carries no color escapes: %q", args, got)
+	}
+	if plain := orderedANSI.ReplaceAllString(got, ""); plain != expected {
+		t.Fatalf("args %v\ngot  %q\nwant %q", args, plain, expected)
+	}
+}
