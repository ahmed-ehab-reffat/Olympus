+// orderedSameAsPlain checks that a run with the option produces exactly what
+// the same input produces without it, so that a rule the repository already
+// implements can be asserted as unchanged rather than restated.
+func orderedSameAsPlain(t *testing.T, args, plainArgs []string, input string) {
+	t.Helper()
+	got := orderedRun(t, args, input)
+	want := orderedRun(t, plainArgs, input)
+	if got != want {
+		t.Fatalf("args %v\ninput %s\ngot  %q\nwant %q", args, input, got, want)
+	}
+}
