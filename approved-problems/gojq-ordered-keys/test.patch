+// orderedRunFull runs a query and returns what it wrote to standard output
+// along with the exit code, for comparing one invocation against another.
+func orderedRunFull(t *testing.T, args []string, input string) (string, int) {
+	t.Helper()
+	var outStream, errStream strings.Builder
+	c := cli{
+		inStream:  newStringReader(input),
+		outStream: &outStream,
+		errStream: &errStream,
+	}
+	code := c.run(args)
+	return outStream.String(), code
+}
