+// orderedRunStderr runs a query which is expected to stop the program and
+// returns what it wrote to standard error along with the exit code.
+func orderedRunStderr(t *testing.T, args []string, input string) (string, int) {
+	t.Helper()
+	var outStream, errStream strings.Builder
+	c := cli{
+		inStream:  newStringReader(input),
+		outStream: &outStream,
+		errStream: &errStream,
+	}
+	code := c.run(args)
+	if s := outStream.String(); s != "" {
+		t.Fatalf("args %v\nstandard output: %s", args, s)
+	}
+	return errStream.String(), code
+}
