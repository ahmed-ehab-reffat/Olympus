+// orderedErrorsLikeKeys checks that a failing input fails the same way for the
+// new function as for the established one.
+func orderedErrorsLikeKeys(t *testing.T, input string) {
+	t.Helper()
+	got := orderedExitCode(t, []string{"-c", "--ordered-keys", "keys_unsorted"}, input)
+	want := orderedExitCode(t, []string{"-c", "keys"}, input)
+	if got != want {
+		t.Fatalf("input %s\nkeys_unsorted exited %d, keys exited %d", input, got, want)
+	}
+}
