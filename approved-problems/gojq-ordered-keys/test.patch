diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..d9abed9
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/go/bin:$PATH"
+export GOFLAGS=-buildvcs=false
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) echo "usage: ./test.sh --output_path <path> {base|new}"; exit 1 ;;
+  esac
+done
+[ -z "$MODE" ] && { echo "usage: ./test.sh --output_path <path> {base|new}"; exit 1; }
+[ -z "$OUTPUT_PATH" ] && OUTPUT_PATH="/tmp/gojq-junit.xml"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+produce() {
+  local out ec=0
+  out=$("$@" 2>&1) || ec=$?
+  printf '%s\n' "$out"
+  printf '%s\n' "$out" | go-junit-report > "$OUTPUT_PATH"
+  return $ec
+}
+
+case "$MODE" in
+  base)
+    produce go test -v -count=1 ./...
+    ;;
+  new)
+    produce go test -v -count=1 -tags=orderedkeys -run '^TestOrderedKeys' ./cli
+    ;;
+esac
