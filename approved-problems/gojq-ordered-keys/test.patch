+// orderedLibraryValue runs a query through the public library API and returns
+// its single result, so that the value can be handed to another query.
+func orderedLibraryValue(t *testing.T, query string, input any) any {
+	t.Helper()
+	q, err := gojq.Parse(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	code, err := gojq.Compile(q)
+	if err != nil {
+		t.Fatal(err)
+	}
+	iter := code.Run(input)
+	v, ok := iter.Next()
+	if !ok {
+		t.Fatalf("query %s produced nothing", query)
+	}
+	if err, ok := v.(error); ok {
+		t.Fatal(err)
+	}
+	if _, ok := iter.Next(); ok {
+		t.Fatalf("query %s produced more than one value", query)
+	}
+	return v
+}
+
+// orderedLibrary runs a query through the public library API over a value the
+// caller built in Go, so that an object with no order to keep goes in.
+func orderedLibrary(t *testing.T, query string, input any, expected string) {
+	t.Helper()
+	q, err := gojq.Parse(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	code, err := gojq.Compile(q)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got []any
+	iter := code.Run(input)
+	for {
+		v, ok := iter.Next()
+		if !ok {
+			break
+		}
+		if err, ok := v.(error); ok {
+			t.Fatal(err)
+		}
+		got = append(got, v)
+	}
+	bs, err := gojq.Marshal(got)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(bs) != expected {
+		t.Fatalf("query %s\ngot  %s\nwant %s", query, bs, expected)
+	}
+}
