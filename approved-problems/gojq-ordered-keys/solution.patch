+// yamlValue replaces every object which keeps its key order by a mapping node
+// listing the keys in that order, since the encoder has no other way of being
+// told the order to write them in. Values of any other type are left alone.
+func (m *yamlMarshaler) yamlValue(v any) (any, error) {
+	switch v := v.(type) {
+	case *gojq.OrderedObject:
+		keys := v.Keys()
+		if m.sortKeys {
+			slices.Sort(keys)
+		}
+		node := &yaml.Node{Kind: yaml.MappingNode}
+		for _, k := range keys {
+			key := &yaml.Node{}
+			if err := key.Encode(k); err != nil {
+				return nil, err
+			}
+			w, _ := v.Get(k)
+			w, err := m.yamlValue(w)
+			if err != nil {
+				return nil, err
+			}
+			val := &yaml.Node{}
+			if err := val.Encode(w); err != nil {
+				return nil, err
+			}
+			node.Content = append(node.Content, key, val)
+		}
+		return node, nil
+	case map[string]any:
+		m2 := make(map[string]any, len(v))
+		for k, w := range v {
+			w, err := m.yamlValue(w)
+			if err != nil {
+				return nil, err
+			}
+			m2[k] = w
+		}
+		return m2, nil
+	case []any:
+		vs := make([]any, len(v))
+		for i, w := range v {
+			w, err := m.yamlValue(w)
+			if err != nil {
+				return nil, err
+			}
+			vs[i] = w
+		}
+		return vs, nil
+	default:
+		return v, nil
+	}
+}
