+// newOrderedJSONInputIter reads the same JSON as newJSONInputIter but builds
+// objects which remember the order their keys appear in the text.
+func newOrderedJSONInputIter(r io.Reader, fname string) inputIter {
+	ir := newInputReader(r)
+	dec := json.NewDecoder(ir)
+	dec.UseNumber()
+	next := func() (v any, err error) {
+		t, err := dec.Token()
+		if err != nil {
+			return nil, err
+		}
+		return gojq.DecodeOrdered(dec, t)
+	}
+	return &jsonInputIter{next: next, ir: ir, fname: fname}
+}
+
