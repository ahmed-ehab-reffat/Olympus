new file mode 100644
index 0000000..06f10f0
--- /dev/null
+++ b/object.go
@@ -0,0 +1,130 @@
+package gojq
+
+import (
+	"encoding/json"
+	"slices"
+)
+
+// OrderedObject is a JSON object which remembers the order of its keys. Values of
+// this type appear in a query only when the input was decoded with the key
+// order kept; otherwise objects are plain maps and their keys are sorted.
+//
+// An OrderedObject is never modified in place once it is part of a value. Every
+// operation that changes an object returns a new one, so that a value which
+// is still reachable from an earlier state of the query is left alone.
+type OrderedObject struct {
+	keys []string
+	m    map[string]any
+}
+
+// NewOrderedObject returns an empty OrderedObject with room for n keys.
+func NewOrderedObject(n int) *OrderedObject {
+	return &OrderedObject{
+		keys: make([]string, 0, n),
+		m:    make(map[string]any, n),
+	}
+}
+
+// Len returns the number of keys.
+func (o *OrderedObject) Len() int {
+	return len(o.keys)
+}
+
+// Keys returns the keys in their own order.
+func (o *OrderedObject) Keys() []string {
+	return slices.Clone(o.keys)
+}
+
+// Get returns the value of the key and whether the key is present.
+func (o *OrderedObject) Get(key string) (any, bool) {
+	v, ok := o.m[key]
+	return v, ok
+}
+
+// Delete returns an object without the key, leaving the order of the rest.
+func (o *OrderedObject) Delete(key string) *OrderedObject {
+	if _, ok := o.m[key]; !ok {
+		return o
+	}
+	p := o.clone()
+	delete(p.m, key)
+	if i := slices.Index(p.keys, key); i >= 0 {
+		p.keys = slices.Delete(p.keys, i, i+1)
+	}
+	return p
+}
+
+// clone copies the key order and the values so that the receiver, which may
+// still be reachable from a suspended alternative, is not touched.
+func (o *OrderedObject) clone() *OrderedObject {
+	p := &OrderedObject{
+		keys: slices.Clone(o.keys),
+		m:    make(map[string]any, len(o.m)),
+	}
+	for k, v := range o.m {
+		p.m[k] = v
+	}
+	return p
+}
+
+// DecodeOrdered builds a value from the JSON token stream, keeping the key
+// order of every object it reads.
+func DecodeOrdered(dec *json.Decoder, t json.Token) (any, error) {
+	return decodeOrdered(dec, t)
+}
+
+// Append adds a key to an object under construction. It must only be used
+// while building an object no one else can see yet.
+func (o *OrderedObject) Append(key string, v any) {
+	o.append(key, v)
+}
+
+// append adds a key to an object under construction. It is only used while
+// building an object no one else can see yet.
+func (o *OrderedObject) append(key string, v any) {
+	if _, ok := o.m[key]; !ok {
+		o.keys = append(o.keys, key)
+	}
+	o.m[key] = v
+}
+
+// objectValues returns the map and the key order of an object value. The
+// order is nil for a plain map, whose keys are sorted wherever they are
+// printed or listed.
+func objectValues(v any) (map[string]any, []string, bool) {
+	switch v := v.(type) {
+	case map[string]any:
+		return v, nil, true
+	case *OrderedObject:
+		return v.m, v.keys, true
+	default:
+		return nil, nil, false
+	}
+}
+
+// objectKeys returns the keys of an object in the order they should be
+// visited: the object's own order, or sorted for a plain map.
+func objectKeys(v any) []string {
+	switch v := v.(type) {
+	case map[string]any:
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			keys = append(keys, k)
+		}
+		slices.Sort(keys)
+		return keys
+	case *OrderedObject:
+		return v.keys
+	default:
+		return nil
+	}
+}
+
+// newObjectLike builds an empty object of the same representation as v, so
+// that a result keeps the order of the object it was derived from.
+func newObjectLike(v any, n int) any {
+	if _, ok := v.(*OrderedObject); ok {
+		return NewOrderedObject(n)
+	}
+	return make(map[string]any, n)
+}
