+Node MakeUintVal(uint64_t val, CanonType ct_uint, const SrcLoc& sl) {
+  Node out = NodeNew(NT::ValNum);
+  NodeInitValNum(out, StrNew(EVAL_STR), kStrInvalid, sl, ct_uint);
+  Node_x_eval(out) = ConstNewUnsigned(val, CanonType_base_type_kind(ct_uint));
+  return out;
+}
+
+Node MakeAs(Node expr, CanonType ct, const SrcLoc& sl) {
