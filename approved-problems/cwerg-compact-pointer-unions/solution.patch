+bool IsCompactUnion(CanonType ct) {
+  return !ct.isnull() && CanonType_is_tagged_union(ct) &&
+         DKFlavor(CanonType_ir_regs(ct)) == DK_FLAVOR_A;
+}
+
+CanonType CompactPointerMember(CanonType ct) {
+  for (CanonType m : CanonType_children(ct)) {
+    if (CanonType_size(m) != 0) {
+      return m;
+    }
+  }
+  CHECK(false, "no pointer member");
+  return kCanonTypeInvalid;
+}
+
+CanonType CurrentType(CanonType ct) {
+  CanonType replacement_ct = CanonType_replacement_type(ct);
+  return replacement_ct.isnull() ? ct : replacement_ct;
+}
+
+Node MakeCompactReplacementStruct(CanonType union_ct, TypeCorpus* tc) {
+  std::vector<CanonType> members;
+  for (CanonType m : CanonType_children(union_ct)) {
+    members.push_back(CurrentType(m));
+  }
+  members.push_back(tc->get_uint_canon_type());
+  std::array<NameAndType, 1> fields = {{
+      NameAndType{NameNew("bits"), tc->InsertUnionType(true, members)},
+  }};
+  std::string name = "xcompact_";
+  name += NameData(CanonType_name(union_ct));
+  return MakeDefRec(NameNew(name), fields, tc);
+}
