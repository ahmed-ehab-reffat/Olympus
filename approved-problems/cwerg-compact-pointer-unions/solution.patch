+
+Node MakeCompactVal(CanonType dst_ct, Node val, const SrcLoc& sl) {
+  CanonType bits_ct = Node_x_type(CanonType_get_rec_field(dst_ct, 0));
+  Node bits =
+      MakeExprWidenBetweeUntaggedUnions(val, bits_ct, sl, kConstInvalid);
+  std::array<FieldTypeAndValue, 1> fields = {{{bits_ct, bits}}};
+  return MakeValCompound(dst_ct, fields, sl);
+}
+
+Node MakeExprStmtWithCase(CanonType ct, const SrcLoc& sl, Node cond, Node val,
+                          Node last) {
+  Node out = NodeNew(NT::ExprStmt);
+  NodeInitExprStmt(out, kNodeInvalid, kStrInvalid, sl, ct);
+  Node ret_t = NodeNew(NT::StmtReturn);
+  NodeInitStmtReturn(ret_t, val, kStrInvalid, sl, out);
+  Node if_stmt = NodeNew(NT::StmtIf);
+  NodeInitStmtIf(if_stmt, cond, ret_t, kNodeInvalid, kStrInvalid, sl);
+  Node ret = NodeNew(NT::StmtReturn);
+  NodeInitStmtReturn(ret, last, kStrInvalid, sl, out);
+  NodeChain body;
+  body.Append(if_stmt);
+  body.Append(ret);
+  Node_body(out) = body.First();
+  return out;
+}
+
+// Cwerg executables are loaded at 0x400000 (x64, a64) or 0x20000 (a32) and
+// the stack and heap are placed above the image, so no object lives below this
+constexpr uint64_t kMinObjectAddress = 0x20000;
+
+Node MakeCompactTag(Node src, CanonType union_ct, TypeCorpus* tc,
+                    const SrcLoc& sl) {
+  CanonType ct_uint = tc->get_uint_canon_type();
+  CanonType ct_tag = tc->get_typeid_canon_type();
+  CHECK((uint64_t(1) << (8 * CanonType_size(ct_tag))) <= kMinObjectAddress, "");
+  Node tmp = MakeDefVar(
+      NameNew("compact_bits"),
+      MakeUncheckedNarrow(MakeCompactBits(src, sl), ct_uint, sl));
+  Node is_small = NodeNew(NT::Expr2);
+  NodeInitExpr2(
+      is_small, BINARY_EXPR_KIND::LT, IdNodeFromDef(tmp, sl),
+      MakeUintVal(uint64_t(1) << (8 * CanonType_size(ct_tag)), ct_uint, sl),
+      kStrInvalid, sl, tc->get_bool_canon_type());
+  Node out = MakeExprStmtWithCase(
+      ct_tag, sl, is_small, MakeAs(IdNodeFromDef(tmp, sl), ct_tag, sl),
+      MakeTypeidVal(CompactPointerMember(union_ct), sl, ct_tag));
+  Node_next(tmp) = Node_body(out);
+  Node_body(out) = tmp;
+  return out;
+}
+
+bool IsDiscardable(Node expr) {
+  while (expr.kind() == NT::ExprWrap) {
+    expr = Node_expr(expr);
+  }
+  return expr.kind() == NT::Id || expr.kind() == NT::ValVoid;
+}
+
+Node MakeCompactFromMember(Node expr, CanonType dst_ct, TypeCorpus* tc,
+                           const SrcLoc& sl) {
+  CanonType src_ct = Node_x_type(expr);
+  if (CanonType_size(src_ct) != 0) {
+    return MakeCompactVal(dst_ct, expr, sl);
+  }
+  Node val = MakeCompactVal(
+      dst_ct,
+      MakeUintVal(CanonType_get_original_typeid(src_ct),
+                  tc->get_uint_canon_type(), sl),
+      sl);
+  if (IsDiscardable(expr)) {
+    NodeFreeRecursively(expr);
+    return val;
+  }
+  Node out = NodeNew(NT::ExprStmt);
+  NodeInitExprStmt(out, kNodeInvalid, kStrInvalid, sl, dst_ct);
+  Node do_stmt = NodeNew(NT::StmtExpr);
+  NodeInitStmtExpr(do_stmt, expr, kStrInvalid, sl);
+  Node ret = NodeNew(NT::StmtReturn);
+  NodeInitStmtReturn(ret, val, kStrInvalid, sl, out);
+  NodeChain body;
+  body.Append(do_stmt);
+  body.Append(ret);
+  Node_body(out) = body.First();
+  return out;
+}
+
+Node MakeCompactFromUnion(Node src, CanonType src_union, CanonType dst_ct,
+                          TypeCorpus* tc, const SrcLoc& sl) {
+  CanonType ct_uint = tc->get_uint_canon_type();
+  if (IsCompactUnion(src_union)) {
+    return MakeCompactVal(
+        dst_ct, MakeUncheckedNarrow(MakeCompactBits(src, sl), ct_uint, sl),
+        sl);
+  }
+  NodeChain stmts;
+  src = MakeNodeCopyableWithoutRiskOfSideEffects(src, &stmts, false);
+  CanonType src_ct = Node_x_type(src);
+  Node tag_field = CanonType_get_rec_field(src_ct, 0);
+  NodeToNodeMap dummy1;
+  NodeToNodeMap dummy2;
+  Node small = MakeCompactVal(
+      dst_ct,
+      MakeAs(MakeExprField(NodeCloneRecursively(src, &dummy1, &dummy2),
+                           tag_field, sl),
+             ct_uint, sl),
+      sl);
+  CanonType ptr_ct = CompactPointerMember(CanonType_original_type(dst_ct));
+  Node out;
+  if (!CanonType_union_contains(src_union, ptr_ct)) {
+    NodeFreeRecursively(src);
+    out = small;
+  } else {
+    Node is_ptr = NodeNew(NT::Expr2);
+    NodeInitExpr2(is_ptr, BINARY_EXPR_KIND::EQ,
+                  MakeExprField(NodeCloneRecursively(src, &dummy1, &dummy2),
+                                tag_field, sl),
+                  MakeTypeidVal(ptr_ct, sl, Node_x_type(tag_field)),
+                  kStrInvalid, sl, tc->get_bool_canon_type());
+    Node payload =
+        MakeExprField(src, CanonType_get_rec_field(src_ct, 1), sl);
+    Node ptr =
+        MakeCompactVal(dst_ct, MakeUncheckedNarrow(payload, CurrentType(ptr_ct), sl), sl);
+    out = MakeExprStmtWithCase(dst_ct, sl, is_ptr, ptr, small);
+  }
+  return MakeExprStmtWithPrefix(&stmts, out, dst_ct, sl);
+}
+
+Node MakeUnionFromCompact(Node src, CanonType src_union, CanonType dst_ct,
+                          TypeCorpus* tc, const SrcLoc& sl) {
+  NodeChain stmts;
+  src = MakeNodeCopyableWithoutRiskOfSideEffects(src, &stmts, false);
+  NodeToNodeMap dummy1;
+  NodeToNodeMap dummy2;
+  Node tag = MakeCompactTag(NodeCloneRecursively(src, &dummy1, &dummy2),
+                            src_union, tc, sl);
+  CanonType dst_union_ct = Node_x_type(CanonType_get_rec_field(dst_ct, 1));
+  Node payload;
+  if (CanonType_size(dst_union_ct) == 0) {
+    NodeFreeRecursively(src);
+    payload = MakeValUndef(sl);
+  } else {
+    Node ptr = MakeUncheckedNarrow(MakeCompactBits(src, sl),
+                                   CurrentType(CompactPointerMember(src_union)), sl);
+    payload = MakeExprWidenBetweeUntaggedUnions(ptr, dst_union_ct, sl,
+                                                kConstInvalid);
+  }
+  return MakeExprStmtWithPrefix(
+      &stmts, MakeValRecForTaggedUnion(dst_ct, tag, payload, sl), dst_ct, sl);
 }
 
