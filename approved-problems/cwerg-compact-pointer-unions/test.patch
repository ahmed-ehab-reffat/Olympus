+module:
+
+import test
+
+wrapped type Missing = void
+
+global MISSING = wrap_as(void_val, Missing)
+
+wrapped type Expired = void
+
+global EXPIRED = wrap_as(void_val, Expired)
+
+wrapped type Handle = ^!u32
+
+type Lookup = union(Missing, Expired, ^!u32)
+
+type Held = union(Missing, Handle)
+
+type Wide = union(Missing, Expired, ^!u32, u16)
+
+type WideHeld = union(Missing, Handle, u16)
+
+static_assert size_of(Held) == size_of(^u8)
+
+static_assert size_of(Lookup) == size_of(^u8)
+
+global! c1 u32 = 50
+
+global! c2 u32 = 70
+
+fun held_eq() bool:
+    let! h Held = MISSING
+    return h == wrap_as(@!c1, Handle)
+
+fun held_read() u32:
+    let! h Held = MISSING
+    let! v u32 = 1
+    if is(h, Handle):
+        set v = unwrap(narrow_as(h, Handle))^
+    return v
+
+fun lookup_read() u32:
+    let! l Lookup = EXPIRED
+    let! v u32 = 2
+    if is(l, ^!u32):
+        set v = narrow_as(l, ^!u32)^
+    return v
+
+fun lookup_widen() bool:
+    let! l Lookup = EXPIRED
+    let w Wide = l
+    return is(w, Expired)
+
+fun held_widen() bool:
+    let! h Held = MISSING
+    let w WideHeld = h
+    return is(w, Missing)
+
+fun lookup_try() u32:
+    let! l Lookup = MISSING
+    trylet p ^!u32 = l, err:
+        if is(err, Missing):
+            return 4
+        return 5
+    return p^
+
+fun lookup_ne() bool:
+    let! l Lookup = MISSING
+    return l != @!c1 && l != @!c2
+
+fun main(argc s32, argv ^^u8) s32:
+    test\AssertFalse#(held_eq())
+    test\AssertEq#(held_read(), 1_u32)
+    test\AssertEq#(lookup_read(), 2_u32)
+    test\AssertTrue#(lookup_widen())
+    test\AssertTrue#(held_widen())
+    test\AssertEq#(lookup_try(), 4_u32)
+    test\AssertTrue#(lookup_ne())
+    test\Success#()
+    return 0
diff --git a/FE/UnionTest/ops_755373_test.cw b/FE/UnionTest/ops_755373_test.cw
new file mode 100644
index 00000000..90688025
--- /dev/null
+++ b/FE/UnionTest/ops_755373_test.cw
@@ -0,0 +1,83 @@
+module:
+
+import test
+
+import fmt
+
+wrapped type Empty = void
+
+global EMPTY = wrap_as(void_val, Empty)
+
+wrapped type Closed = void
+
+global CLOSED = wrap_as(void_val, Closed)
+
+wrapped type Busy = void
+
+global BUSY = wrap_as(void_val, Busy)
+
+type Reply = union(Empty, Closed, Busy, ^!s32)
+
+static_assert size_of(Reply) == size_of(^u8)
+
+global! cells = {[4]s32: 5, 6, 7, 8}
+
+fun fetch(i s32) Reply:
+    if i == 0:
+        return EMPTY
+    if i == 1:
+        return CLOSED
+    if i == 2:
+        return BUSY
+    return @!cells[i - 3]
+
+fun code(r Reply) s32:
+    if is(r, Empty):
+        return -1
+    if is(r, union(Closed, Busy)):
+        return -2
+    return narrow_as(r, ^!s32)^
+
+fun first_value(n s32) union(void, ^!s32):
+    for i = 0, n, 1:
+        let r = fetch(i)
+        trylet p ^!s32 = r, _:
+            continue
+        return p
+    return void_val
+
+fun describe(r Reply) s32:
+    trylet p ^!s32 = r, err:
+        if is(err, Busy):
+            return 300
+        if err == CLOSED:
+            return 200
+        return 100
+    return p^
+
+fun main(argc s32, argv ^^u8) s32:
+    for i = 0, 5_s32, 1:
+        let r = fetch(i)
+        fmt\print#(i, " ", code(r), " ", describe(r), " ", union_tag(r) == typeid_of(^!s32), "\n")
+    test\AssertEq#(code(fetch(4)), 6_s32)
+    test\AssertEq#(describe(fetch(1)), 200_s32)
+    test\AssertEq#(describe(fetch(2)), 300_s32)
+    let! r Reply = fetch(1)
+    test\AssertEq#(union_tag(r), typeid_of(Closed))
+    test\AssertTrue#(r == CLOSED)
+    test\AssertTrue#(r != BUSY)
+    test\AssertFalse#(r == EMPTY)
+    set r = @!cells[3]
+    test\AssertEq#(union_tag(r), typeid_of(^!s32))
+    test\AssertTrue#(r == @!cells[3])
+    test\AssertTrue#(r != @!cells[2])
+    test\AssertFalse#(is(r, union(Empty, Busy)))
+    set narrow_as(r, ^!s32)^ = 80
+    test\AssertEq#(cells[3], 80_s32)
+    let! o = first_value(2)
+    test\AssertTrue#(o == void_val)
+    test\AssertEq#(union_tag(o), typeid_of(void))
+    set o = first_value(5)
+    test\AssertEq#(narrow_as(o, ^!s32)^, 5_s32)
+    test\Success#()
+    return 0
