+module:
+
+import test
+
+wrapped type Missing = void
+
+global MISSING = wrap_as(void_val, Missing)
+
+wrapped type Expired = void
+
+global EXPIRED = wrap_as(void_val, Expired)
+
+wrapped type Handle = ^!u32
+
+type Lookup = union(Missing, Expired, ^!u32)
+
+type Held = union(Missing, Handle)
+
+type Wide = union(Missing, Expired, ^!u32, u16)
+
+type WideHeld = union(Missing, Expired, Handle, u16)
+
+type Outer = union(Missing, ^!Lookup)
+
+static_assert size_of(Lookup) == size_of(^u8)
+
+static_assert size_of(Outer) == size_of(^u8)
+
+rec Slot:
+    id u8
+    entry Lookup
+
+global! c1 u32 = 50
+
+global! c2 u32 = 70
+
+global! table = {[3]Lookup: MISSING, @!c1, EXPIRED}
+
+fun score(w Wide) u32:
+    if is(w, ^!u32):
+        return narrow_as(w, ^!u32)^
+    if is(w, Expired):
+        return 2
+    if is(w, Missing):
+        return 1
+    return 3
+
+fun held_score(w WideHeld) u32:
+    if is(w, Handle):
+        return unwrap(narrow_as(w, Handle))^
+    if is(w, Missing):
+        return 1
+    return 3
+
+fun pick(a [3]Lookup, i uint) Wide:
+    return a[i]
+
+fun total(s span(Lookup)) u32:
+    let! t u32 = 0
+    for i = 0, len(s), 1:
+        let w Wide = s[i]
+        set t += score(w)
+    return t
+
+fun outer_score(o Outer) u32:
+    if is(o, Missing):
+        return 0
+    let p = narrow_as(o, ^!Lookup)
+    let w Wide = p^
+    return score(w)
+
+fun main(argc s32, argv ^^u8) s32:
+    let w0 Wide = table[0]
+    test\AssertEq#(score(w0), 1_u32)
+    test\AssertEq#(score(table[1]), 50_u32)
+    ref let! arr = {[3]Lookup: EXPIRED, @!c2, MISSING}
+    let! w Wide = 9_u16
+    set w = arr[1]
+    test\AssertEq#(score(w), 70_u32)
+    set arr[1] = MISSING
+    set w = arr[1]
+    test\AssertEq#(score(w), 1_u32)
+    test\AssertEq#(score(pick(arr, 0)), 2_u32)
+    set arr[2] = @!c1
+    test\AssertEq#(total(arr), 53_u32)
+    let slots = {[2]Slot: {Slot: 1, @!c1}, {Slot: 2, EXPIRED}}
+    let ws Wide = slots[0].entry
+    test\AssertEq#(score(ws), 50_u32)
+    test\AssertEq#(score(slots[1].entry), 2_u32)
+    let hs = {[2]Held: MISSING, wrap_as(@!c2, Handle)}
+    let hw WideHeld = hs[1]
+    test\AssertEq#(held_score(hw), 70_u32)
+    test\AssertEq#(held_score(hs[0]), 1_u32)
+    set table[1] = EXPIRED
+    test\AssertEq#(score(table[1]), 2_u32)
+    ref let! inner Lookup = @!c1
+    let! o Outer = @!inner
+    test\AssertEq#(outer_score(o), 50_u32)
+    set inner = EXPIRED
+    test\AssertEq#(outer_score(o), 2_u32)
+    set o = MISSING
+    test\AssertEq#(outer_score(o), 0_u32)
+    test\Success#()
+    return 0
