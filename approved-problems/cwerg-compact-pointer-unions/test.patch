+module:
+
+import test
+
+wrapped type Gone = void
+
+global GONE = wrap_as(void_val, Gone)
+
+wrapped type Stale = void
+
+global STALE = wrap_as(void_val, Stale)
+
+wrapped type Cursor = ^!u32
+
+type Probe = union(Gone, Stale, ^!u32)
+
+type Mark = union(Gone, Cursor)
+
+type Maybe = union(void, ^!u32)
+
+static_assert size_of(Probe) == size_of(^u8)
+
+static_assert size_of(Mark) == size_of(^u8)
+
+rec Tagged:
+    flag u8
+    mark Mark
+    tail u8
+
+static_assert offset_of(Tagged, mark) == size_of(^u8)
+
+static_assert offset_of(Tagged, tail) == 2 * size_of(^u8)
+
+global! calls u32 = 0
+
+global! cell u32 = 70
+
+fun stale_now() Stale:
+    set calls += 1
+    return STALE
+
+fun touch() void:
+    set calls += 10
+
+fun pass_through() Probe:
+    return stale_now()
+
+fun main(argc s32, argv ^^u8) s32:
+    let! p Probe = @!cell
+    set p = stale_now()
+    test\AssertEq#(calls, 1_u32)
+    test\AssertTrue#(is(p, Stale))
+    set p = pass_through()
+    test\AssertEq#(calls, 2_u32)
+    test\AssertEq#(union_tag(p), typeid_of(Stale))
+    let! m Maybe = @!cell
+    set m = touch()
+    test\AssertEq#(calls, 12_u32)
+    test\AssertTrue#(is(m, void))
+    let! k Mark = wrap_as(@!cell, Cursor)
+    set k = wrap_as(touch(), Gone)
+    test\AssertEq#(calls, 22_u32)
+    test\AssertTrue#(is(k, Gone))
+    let! t = {Tagged: 3, GONE, 4}
+    set t.mark = wrap_as(@!cell, Cursor)
+    test\AssertEq#(unwrap(narrow_as(t.mark, Cursor))^, 70_u32)
+    set t.mark = wrap_as(touch(), Gone)
+    test\AssertEq#(calls, 32_u32)
+    test\AssertTrue#(is(t.mark, Gone))
+    test\AssertEq#(t.flag, 3_u8)
+    test\AssertEq#(t.tail, 4_u8)
+    test\Success#()
+    return 0
diff --git a/FE/UnionTest/elements_755373_test.cw b/FE/UnionTest/elements_755373_test.cw
