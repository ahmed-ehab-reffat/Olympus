@@ -0,0 +1,90 @@
+module:
+
+import test
+
+wrapped type Missing = void
+
+global MISSING = wrap_as(void_val, Missing)
+
+wrapped type Expired = void
+
+global EXPIRED = wrap_as(void_val, Expired)
+
+type P = ^!u16
+
+type Errs = union(Missing, Expired)
+
+type Lookup = union(Missing, Expired, P)
+
+type Maybe = union(void, P)
+
+type Any = union(void, Missing, Expired, P)
+
+type Wide = union(Missing, Expired, P, u16, bool)
+
+static_assert size_of(Lookup) == size_of(P)
+
+static_assert size_of(Any) == size_of(P)
+
+global! slots = {[3]u16: 100, 200, 300}
+
+fun lookup(i u16) Lookup:
+    if i == 0:
+        return MISSING
+    if i == 1:
+        return EXPIRED
+    return @!slots[i - 2]
+
+fun to_wide(x Lookup) Wide:
+    return x
+
+fun from_wide(w Wide) Lookup:
+    return narrow_as(w, Lookup)
+
+fun to_any(m Maybe) Any:
+    return m
+
+fun errs_of(x Lookup) Errs:
+    return narrow_as(x, Errs)
+
+fun score(x Lookup) u16:
+    if is(x, Missing):
+        return 1
+    if is(x, Expired):
+        return 2
+    return narrow_as(x, P)^
+
+fun main(argc s32, argv ^^u8) s32:
+    let! sum u16 = 0
+    for i = 0, 4_u16, 1:
+        let x = lookup(i)
+        let w = to_wide(x)
+        let back = from_wide(w)
+        set sum += score(back)
+        let a Any = x
+        let again = narrow_as(a, Lookup)
+        set sum += score(again)
+    test\AssertEq#(sum, 606_u16)
+    let! w Wide = true
+    test\AssertTrue#(is(w, bool))
+    set w = 9_u16
+    test\AssertTrue#(is(w, u16))
+    set w = EXPIRED
+    test\AssertEq#(score(from_wide(w)), 2_u16)
+    set w = @!slots[2]
+    test\AssertEq#(score(from_wide(w)), 300_u16)
+    let e = errs_of(lookup(1))
+    test\AssertTrue#(is(e, Expired))
+    let! l Lookup = e
+    test\AssertTrue#(is(l, Expired))
+    let e0 = errs_of(lookup(0))
+    set l = e0
+    test\AssertEq#(union_tag(l), typeid_of(Missing))
+    let! m Maybe = void_val
+    test\AssertTrue#(is(to_any(m), void))
+    set m = @!slots[1]
+    let a = to_any(m)
+    test\AssertEq#(narrow_as(a, P)^, 200_u16)
+    test\AssertEq#(narrow_as(narrow_as(a, Maybe), P)^, 200_u16)
+    test\Success#()
+    return 0
