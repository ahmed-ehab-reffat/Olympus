+module:
+
+import test
+
+wrapped type Unset = void
+
+global UNSET = wrap_as(void_val, Unset)
+
+wrapped type Locked = void
+
+global LOCKED = wrap_as(void_val, Locked)
+
+type Ref = union(Unset, Locked, ^s32)
+
+static_assert size_of(Ref) == size_of(^s32)
+
+global a s32 = 11
+
+global b s32 = 22
+
+global! c s32 = 33
+
+global ra Ref = @a
+
+global rl Ref = LOCKED
+
+global! rm Ref = UNSET
+
+global table = {[4]Ref: @b, UNSET, @a, LOCKED}
+
+rec Link:
+    label u8
+    target Ref
+    alt union(void, ^s32)
+
+global links = {[2]Link: {Link: 7, @c, void_val}, {Link: 8, LOCKED, @b}}
+
+global! spare Link = {Link: 9, @a, @c}
+
+fun value(r Ref) s32:
+    if is(r, Unset):
+        return 0
+    if is(r, Locked):
+        return -1
+    return narrow_as(r, ^s32)^
+
+fun main(argc s32, argv ^^u8) s32:
+    test\AssertEq#(value(ra), 11_s32)
+    test\AssertEq#(value(rl), -1_s32)
+    test\AssertEq#(value(rm), 0_s32)
+    set rm = @c
+    test\AssertEq#(value(rm), 33_s32)
+    let! sum s32 = 0
+    for i = 0, 4_uint, 1:
+        set sum += value(table[i])
+    test\AssertEq#(sum, 32_s32)
+    test\AssertEq#(value(links[0].target), 33_s32)
+    test\AssertTrue#(is(links[0].alt, void))
+    test\AssertEq#(value(links[1].target), -1_s32)
+    test\AssertEq#(narrow_as(links[1].alt, ^s32)^, 22_s32)
+    test\AssertEq#(value(spare.target), 11_s32)
+    set c = 44
+    test\AssertEq#(narrow_as(spare.alt, ^s32)^, 44_s32)
+    set spare.target = UNSET
+    test\AssertEq#(value(spare.target), 0_s32)
+    test\AssertEq#(spare.label, 9_u8)
+    test\Success#()
+    return 0
