+module:
+
+import test
+
+wrapped type NotFound = void
+
+wrapped type Denied = void
+
+global NOT_FOUND = wrap_as(void_val, NotFound)
+
+wrapped type Handle = ^!u32
+
+wrapped type Tag = u16
+
+type Opt = union(void, ^!u32)
+
+type Res = union(NotFound, Denied, ^u8)
+
+type Held = union(NotFound, Handle)
+
+type Mixed = union(NotFound, ^!u32, Tag)
+
+type Two = union(void, ^u8, ^!u32)
+
+wrapped type Empty = [0]u8
+
+type Gap = union(^u8, [0]u8)
+
+type GapHeld = union(NotFound, Handle, Empty)
+
+static_assert size_of(Opt) == size_of(^u8)
+
+static_assert size_of(Res) == size_of(^u8)
+
+static_assert size_of(Held) == size_of(^u8)
+
+static_assert size_of(union(Opt, NotFound)) == size_of(^u8)
+
+static_assert size_of(Mixed) == 2 * size_of(^u8)
+
+static_assert size_of(Two) == 2 * size_of(^u8)
+
+static_assert size_of(Gap) == 2 * size_of(^u8)
+
+static_assert size_of(GapHeld) == 2 * size_of(^u8)
+
+static_assert size_of(union(NotFound, Denied)) == size_of(typeid)
+
+rec Entry:
+    key u8
+    next union(void, ^!Entry)
+    count u32
+
+static_assert offset_of(Entry, next) == size_of(^u8)
+
+static_assert offset_of(Entry, count) == 2 * size_of(^u8)
+
+static_assert size_of([5]Res) == 5 * size_of(^u8)
+
+rec Slot:
+    first Res
+    second Held
+    guard u32
+
+static_assert offset_of(Slot, guard) == 2 * size_of(^u8)
+
+global! cell u32 = 41
+
+global! entries = {[3]Entry: {Entry: 1, void_val, 10}, {Entry: 2, void_val, 20}, {Entry: 3, void_val, 30}}
+
+fun main(argc s32, argv ^^u8) s32:
+    set entries[0].next = @!entries[1]
+    set entries[1].next = @!entries[2]
+    let! total u32 = 0
+    let! cur union(void, ^!Entry) = @!entries[0]
+    while true:
+        trylet e ^!Entry = cur, _:
+            break
+        set total += e^.count + as(e^.key, u32)
+        set cur = e^.next
+    test\AssertEq#(total, 66_u32)
+    test\AssertEq#(entries[2].key, 3_u8)
+    test\AssertTrue#(is(entries[2].next, void))
+    let! slots = {[2]Slot: {Slot: NOT_FOUND, wrap_as(@!cell, Handle), 5}, {Slot: NOT_FOUND, NOT_FOUND, 6}}
+    test\AssertTrue#(is(slots[0].first, NotFound))
+    test\AssertEq#(unwrap(narrow_as(slots[0].second, Handle))^, 41_u32)
+    set slots[0].second = NOT_FOUND
+    set slots[1].second = wrap_as(@!cell, Handle)
+    test\AssertTrue#(is(slots[0].second, NotFound))
+    test\AssertTrue#(is(slots[1].second, Handle))
+    test\AssertEq#(slots[0].guard, 5_u32)
+    test\AssertEq#(slots[1].guard, 6_u32)
+    test\AssertTrue#(is(slots[1].first, NotFound))
+    test\Success#()
+    return 0
