+#[test]
+fn equal_int_operands_match() {
+    let scheme = build_scheme();
+    let mut ctx = ExecutionContext::<()>::new(&scheme);
+    set(&mut ctx, &scheme, "port", 8080.into());
+    set(&mut ctx, &scheme, "backend_port", 8080.into());
+    assert!(matches(&scheme, &ctx, "port == backend_port"));
+    assert!(!matches(&scheme, &ctx, "port != backend_port"));
+}
