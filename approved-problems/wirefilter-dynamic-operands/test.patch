+use std::net::IpAddr;
+use wirefilter::{
+    Array, ConcatFunction, ExecutionContext, LhsValue, Map, Scheme, SchemeBuilder, Type,
+    TypeMismatchError,
+};
+
+fn build_scheme() -> Scheme {
+    let mut builder = SchemeBuilder::new();
+    for (name, ty) in [
+        ("http.host", Type::Bytes),
+        ("http.referer", Type::Bytes),
+        ("http.path", Type::Bytes),
+        ("port", Type::Int),
+        ("backend_port", Type::Int),
+        ("flags", Type::Int),
+        ("mask", Type::Int),
+        ("ip.src", Type::Ip),
+        ("ip.dst", Type::Ip),
+        ("hosts", Type::Array(Type::Bytes.into())),
+        ("other_hosts", Type::Array(Type::Bytes.into())),
+        ("ports", Type::Array(Type::Int.into())),
+        ("other_ports", Type::Array(Type::Int.into())),
+        ("headers", Type::Map(Type::Bytes.into())),
+        ("nested", Type::Array(Type::Array(Type::Bytes.into()).into())),
+        ("key", Type::Bytes),
+        ("flag_a", Type::Bool),
+        ("flag_b", Type::Bool),
+        ("flags_arr", Type::Array(Type::Bool.into())),
+        ("other_flags_arr", Type::Array(Type::Bool.into())),
+        ("flags_map", Type::Map(Type::Bool.into())),
+        ("other_flags_map", Type::Map(Type::Bool.into())),
+        ("other_headers", Type::Map(Type::Bytes.into())),
+        ("idx", Type::Int),
+        ("outer_idx", Type::Int),
+    ] {
+        builder.add_optional_field(name, ty).unwrap();
+    }
+    builder
+        .add_function("concat", ConcatFunction::new())
+        .unwrap();
+    builder.build()
+}
+
+fn set<'a>(ctx: &mut ExecutionContext<'a, ()>, scheme: &'a Scheme, name: &str, value: LhsValue<'a>) {
+    ctx.set_field_value(scheme.get_field(name).unwrap(), value)
+        .unwrap();
+}
+
+fn bytes_array<'a>(values: impl IntoIterator<Item = &'a str>) -> LhsValue<'a> {
+    LhsValue::Array(Array::from_iter(values))
+}
+
+fn int_array(values: impl IntoIterator<Item = i64>) -> LhsValue<'static> {
+    LhsValue::Array(Array::from_iter(values))
+}
+
+fn bytes_map<'a>(entries: impl IntoIterator<Item = (&'a str, &'a str)>) -> LhsValue<'a> {
+    let map = Map::try_from_iter::<TypeMismatchError, _>(
+        Type::Bytes,
+        entries
+            .into_iter()
+            .map(|(key, value)| Ok((key.as_bytes().to_vec().into_boxed_slice(), value))),
+    )
+    .unwrap();
+    LhsValue::Map(map)
+}
+
+fn ip(value: &str) -> LhsValue<'static> {
+    LhsValue::Ip(value.parse::<IpAddr>().unwrap())
+}
+
+fn matches(scheme: &Scheme, ctx: &ExecutionContext<'_, ()>, filter: &str) -> bool {
+    scheme
+        .parse(filter)
+        .unwrap()
+        .compile()
+        .execute(ctx)
+        .unwrap()
+}
+
+fn accepted(scheme: &Scheme, filter: &str) -> bool {
+    scheme.parse(filter).is_ok()
+}
