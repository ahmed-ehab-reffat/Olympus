+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum OperandOp {
+    Ordering(OrderingOp),
+    Int(IntOp),
+    Contains,
+    In,
+}
+
+pub(crate) enum OperandItems<'v, 'e> {
+    Array(ArrayIter<'e, 'v>),
+    Map(MapIter<'e, 'v>),
+}
+
+impl<'v, 'e> Iterator for OperandItems<'v, 'e> {
+    type Item = &'v LhsValue<'e>;
+
+    #[inline]
+    fn next(&mut self) -> Option<Self::Item> {
+        match self {
+            Self::Array(iter) => iter.next(),
+            Self::Map(iter) => iter.next().map(|(_, value)| value),
+        }
+    }
+
+    #[inline]
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let len = match self {
+            Self::Array(iter) => iter.len(),
+            Self::Map(iter) => iter.len(),
+        };
+        (len, Some(len))
+    }
+}
+
+#[inline]
+pub(crate) fn operand_items<'v, 'e>(value: &'v LhsValue<'e>) -> Option<OperandItems<'v, 'e>> {
+    match value {
+        LhsValue::Array(array) => Some(OperandItems::Array(array.iter())),
+        LhsValue::Map(map) => Some(OperandItems::Map(map.iter())),
+        _ => None,
+    }
+}
+
+fn values_equal(lhs: &LhsValue<'_>, rhs: &LhsValue<'_>) -> bool {
+    match (lhs, rhs) {
+        (LhsValue::Array(lhs), LhsValue::Array(rhs)) => {
+            lhs.len() == rhs.len()
+                && lhs
+                    .iter()
+                    .zip(rhs.iter())
+                    .all(|(lhs, rhs)| values_equal(lhs, rhs))
+        }
+        (LhsValue::Map(lhs), LhsValue::Map(rhs)) => {
+            lhs.len() == rhs.len()
+                && lhs.iter().zip(rhs.iter()).all(
+                    |((lhs_key, lhs_value), (rhs_key, rhs_value))| {
+                        lhs_key == rhs_key && values_equal(lhs_value, rhs_value)
+                    },
+                )
+        }
+        (lhs, rhs) => scalars_match(OrderingOp::Equal, lhs, rhs),
+    }
+}
+
+#[inline]
+fn scalars_match(op: OrderingOp, lhs: &LhsValue<'_>, rhs: &LhsValue<'_>) -> bool {
+    match (lhs, rhs) {
+        (LhsValue::Int(lhs), LhsValue::Int(rhs)) => op.matches(lhs.cmp(rhs)),
+        (LhsValue::Bytes(lhs), LhsValue::Bytes(rhs)) => op.matches(lhs.as_ref().cmp(rhs.as_ref())),
+        (LhsValue::Ip(lhs), LhsValue::Ip(rhs)) => op.matches_opt(lhs.strict_partial_cmp(rhs)),
+        (LhsValue::Bool(lhs), LhsValue::Bool(rhs)) => op.matches(lhs.cmp(rhs)),
+        _ => op == OrderingOp::NotEqual,
+    }
+}
+
+#[inline]
+fn ordering_matches(op: OrderingOp, lhs: &LhsValue<'_>, rhs: &LhsValue<'_>) -> bool {
+    match (lhs, rhs) {
+        (LhsValue::Array(_) | LhsValue::Map(_), _) | (_, LhsValue::Array(_) | LhsValue::Map(_)) => {
+            match op {
+                OrderingOp::Equal => values_equal(lhs, rhs),
+                OrderingOp::NotEqual => !values_equal(lhs, rhs),
+                _ => false,
+            }
+        }
+        (lhs, rhs) => scalars_match(op, lhs, rhs),
+    }
+}
+
+/// Whether an operand of this type supports the given ordering operator.
+#[inline]
+pub(crate) fn supports_ordering(ty: &Type, op: OrderingOp) -> bool {
+    match ty {
+        Type::Array(_) | Type::Map(_) => {
+            matches!(op, OrderingOp::Equal | OrderingOp::NotEqual)
+        }
+        _ => true,
+    }
+}
+
+/// Reads an ordering operator followed by an operand expression of the given
+/// type. Yields nothing when the input does not continue with an ordering
+/// operator the type supports, which leaves the caller's other readings intact.
+pub(crate) fn lex_ordering_operand<'i>(
+    input: &'i str,
+    parser: &FilterParser<'_>,
+    expected: Type,
+) -> Option<LexResult<'i, (OrderingOp, IndexExpr)>> {
+    let (op, rest) = ComparisonOp::lex(skip_space(input)).ok()?;
+    let ComparisonOp::Ordering(op) = op else {
+        return None;
+    };
+    if !supports_ordering(&expected, op) {
+        return None;
+    }
+    let result = lex_operand(skip_space(rest), parser, expected)?;
+    Some(result.map(|(rhs, rest)| ((op, rhs), rest)))
+}
+
+#[inline]
+fn contains_bytes(lhs: &LhsValue<'_>, rhs: &LhsValue<'_>) -> bool {
+    match (lhs, rhs) {
+        (LhsValue::Bytes(lhs), LhsValue::Bytes(rhs)) => {
+            memmem::find(lhs.as_ref(), rhs.as_ref()).is_some()
+        }
+        _ => false,
+    }
+}
+
+#[inline]
+fn is_member(lhs: &LhsValue<'_>, rhs: &LhsValue<'_>) -> bool {
+    match rhs {
+        LhsValue::Array(array) => array
+            .iter()
+            .any(|item| ordering_matches(OrderingOp::Equal, lhs, item)),
+        _ => false,
+    }
+}
+
+#[inline]
+pub(crate) fn compare_operands(op: OperandOp, lhs: &LhsValue<'_>, rhs: &LhsValue<'_>) -> bool {
+    match op {
+        OperandOp::Ordering(op) => ordering_matches(op, lhs, rhs),
+        OperandOp::Int(IntOp::BitwiseAnd) => match (lhs, rhs) {
+            (LhsValue::Int(lhs), LhsValue::Int(rhs)) => lhs & rhs != 0,
+            _ => false,
+        },
+        OperandOp::Contains => contains_bytes(lhs, rhs),
+        OperandOp::In => is_member(lhs, rhs),
+    }
+}
+
+struct OperandCompare<U> {
+    op: OperandOp,
+    rhs: CompiledValueExpr<U>,
+    default: bool,
+}
+
+impl<U: 'static> Compare<U> for OperandCompare<U> {
+    #[inline]
+    fn compare<'e>(&self, value: &LhsValue<'e>, ctx: &'e ExecutionContext<'e, U>) -> bool {
+        match self.rhs.execute(ctx) {
+            Ok(rhs) => compare_operands(self.op, value, &rhs),
+            Err(_) => self.default,
+        }
+    }
+}
+
+/// Lexes an operand expression when the input starts one, checking it against
+/// the type the operator expects.
+pub(crate) fn lex_operand<'i>(
+    input: &'i str,
+    parser: &FilterParser<'_>,
+    expected: Type,
+) -> Option<LexResult<'i, IndexExpr>> {
+    let (rhs, rest) = IndexExpr::lex_with(input, parser).ok()?;
+    let actual = rhs.get_type();
+    if actual != expected {
+        return Some(Err((
+            LexErrorKind::TypeMismatch(TypeMismatchError {
+                expected: expected.into(),
+                actual,
+            }),
+            span(input, rest),
+        )));
+    }
+    Some(Ok((rhs, rest)))
+}
+
+fn empty() -> TypedArray<'static, bool> {
+    TypedArray::default()
+}
+
+/// Compiles a comparison whose right operand is an expression evaluated
+/// against the execution context.
+pub(crate) fn compile_operand_comparison<C: Compiler>(
+    compiler: &mut C,
+    lhs: IndexExpr,
+    rhs: IndexExpr,
+    op: OperandOp,
+    default: bool,
+) -> CompiledExpr<C::U> {
+    if rhs.map_each_count() == 0 {
+        let rhs = rhs.compile_with_compiler(compiler);
+        return lhs.compile_with(compiler, default, OperandCompare { op, rhs, default });
+    }
+
+    let paired = lhs.map_each_count() > 0;
+    let lhs = lhs.compile_with_compiler(compiler);
+    let rhs = rhs.compile_with_compiler(compiler);
+
+    CompiledExpr::Vec(CompiledVecExpr::new(move |ctx| {
+        let rhs_value = match rhs.execute(ctx) {
+            Ok(value) => value,
+            Err(_) => return empty(),
+        };
+        let Some(rhs_items) = operand_items(&rhs_value) else {
+            return empty();
+        };
+        match lhs.execute(ctx) {
+            Ok(lhs_value) => {
+                if !paired {
+                    return TypedArray::from_iter(
+                        rhs_items.map(|rhs_item| compare_operands(op, &lhs_value, rhs_item)),
+                    );
+                }
+                match operand_items(&lhs_value) {
+                    Some(lhs_items) => TypedArray::from_iter(
+                        lhs_items
+                            .zip(rhs_items)
+                            .map(|(lhs_item, rhs_item)| compare_operands(op, lhs_item, rhs_item)),
+                    ),
+                    None => empty(),
+                }
+            }
+            Err(_) => {
+                if paired {
+                    empty()
+                } else {
+                    TypedArray::from_iter(rhs_items.map(|_| default))
+                }
+            }
+        }
+    }))
+}
+
+/// Type an `in` operand must have for a left operand of type `ty`.
+#[inline]
+pub(crate) fn membership_operand_type(ty: Type) -> Type {
+    Type::Array(ty.into())
+}
+
+/// One element of a `contains {...}` set: either a literal or an expression.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Serialize)]
+#[serde(untagged)]
+pub enum ContainsElement {
+    /// A literal byte string.
+    Literal(BytesExpr),
+    /// An expression evaluated against the execution context.
+    Operand(IndexExpr),
+}
+
+impl ContainsElement {
+    fn walk<'a, V: Visitor<'a>>(&'a self, visitor: &mut V) {
+        if let Self::Operand(expr) = self {
+            visitor.visit_index_expr(expr);
+        }
+    }
+
+    fn walk_mut<'a, V: VisitorMut<'a>>(&'a mut self, visitor: &mut V) {
+        if let Self::Operand(expr) = self {
+            visitor.visit_index_expr(expr);
+        }
+    }
+}
+
+pub(crate) fn walk_contains_set<'a, V: Visitor<'a>>(set: &'a [ContainsElement], visitor: &mut V) {
+    for element in set {
+        element.walk(visitor);
+    }
+}
+
+pub(crate) fn walk_contains_set_mut<'a, V: VisitorMut<'a>>(
+    set: &'a mut [ContainsElement],
+    visitor: &mut V,
+) {
+    for element in set {
+        element.walk_mut(visitor);
+    }
+}
+
+/// Lexes a braced `contains {...}` set of literals and expressions.
+pub(crate) fn lex_contains_set<'i>(
+    input: &'i str,
+    parser: &FilterParser<'_>,
+) -> Option<LexResult<'i, Vec<ContainsElement>>> {
+    let mut rest = skip_space(expect(input, "{").ok()?);
+    let mut elements = Vec::new();
+    loop {
+        if let Ok(after) = expect(rest, "}") {
+            return Some(Ok((elements, after)));
+        }
+        let element = match lex_operand(rest, parser, Type::Bytes) {
+            Some(Ok((expr, after))) => {
+                if expr.map_each_count() > 0 {
+                    return Some(Err((
+                        LexErrorKind::TypeMismatch(TypeMismatchError {
+                            expected: Type::Bytes.into(),
+                            actual: Type::Array(Type::Bytes.into()),
+                        }),
+                        span(rest, after),
+                    )));
+                }
+                rest = after;
+                ContainsElement::Operand(expr)
+            }
+            Some(Err(err)) => return Some(Err(err)),
+            None => match BytesExpr::lex(rest) {
+                Ok((bytes, after)) => {
+                    rest = after;
+                    ContainsElement::Literal(bytes)
+                }
+                Err(err) => return Some(Err(err)),
+            },
+        };
+        elements.push(element);
+        rest = skip_space(rest);
+    }
+}
+
+enum Needle<U> {
+    Static(Box<[u8]>),
+    Dynamic(CompiledValueExpr<U>),
+}
+
+struct ContainsOneOfOperands<U>(Box<[Needle<U>]>);
+
+impl<U: 'static> Compare<U> for ContainsOneOfOperands<U> {
+    fn compare<'e>(&self, value: &LhsValue<'e>, ctx: &'e ExecutionContext<'e, U>) -> bool {
+        let LhsValue::Bytes(haystack) = value else {
+            return false;
+        };
+        self.0.iter().any(|needle| match needle {
+            Needle::Static(needle) => memmem::find(haystack.as_ref(), needle).is_some(),
+            Needle::Dynamic(expr) => match expr.execute(ctx) {
+                Ok(LhsValue::Bytes(needle)) => {
+                    memmem::find(haystack.as_ref(), needle.as_ref()).is_some()
+                }
+                _ => false,
+            },
+        })
+    }
+}
+
+/// Compiles a `contains {...}` set comparison.
+pub(crate) fn compile_contains_set<C: Compiler>(
+    compiler: &mut C,
+    lhs: IndexExpr,
+    set: Vec<ContainsElement>,
+) -> CompiledExpr<C::U> {
+    let needles: Box<[Needle<C::U>]> = set
+        .into_iter()
+        .map(|element| match element {
+            ContainsElement::Literal(bytes) => Needle::Static(bytes.into()),
+            ContainsElement::Operand(expr) => Needle::Dynamic(expr.compile_with_compiler(compiler)),
+        })
+        .collect();
+    lhs.compile_with(compiler, false, ContainsOneOfOperands(needles))
+}
