+        (LhsValue::Map(map), FieldIndex::MapKey(key)) => map.get(key.as_bytes()),
+        _ => None,
+    }
+}
+
+fn index_by_value<'v, 'e>(
+    value: &'v LhsValue<'e>,
+    key: &LhsValue<'_>,
+) -> Option<&'v LhsValue<'e>> {
+    match (value, key) {
+        (LhsValue::Map(map), LhsValue::Bytes(key)) => map.get(key.as_ref()),
+        (LhsValue::Array(array), LhsValue::Int(index)) => {
