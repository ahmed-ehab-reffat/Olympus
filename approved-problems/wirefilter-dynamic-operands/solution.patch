+/// Lexes an index that is computed by an expression, checking it against the
+/// key type the indexed value expects.
+fn lex_dynamic_index<'i>(
+    input: &'i str,
+    parser: &FilterParser<'_>,
+    indexed_type: Type,
+) -> Option<LexResult<'i, FieldIndex>> {
+    let expected = match indexed_type {
+        Type::Array(_) => Type::Int,
+        Type::Map(_) => Type::Bytes,
+        _ => return None,
+    };
+    let (expr, rest) = IndexExpr::lex_with(input, parser).ok()?;
+    let actual = expr.get_type();
+    if actual != expected || expr.map_each_count() > 0 {
+        return Some(Err((
+            LexErrorKind::TypeMismatch(TypeMismatchError {
+                expected: expected.into(),
+                actual,
+            }),
+            span(input, rest),
+        )));
+    }
+    Some(Ok((FieldIndex::Dynamic(expr.into()), rest)))
+}
+
+enum IndexStep<U> {
+    Static(FieldIndex),
+    Dynamic(CompiledValueExpr<U>),
+}
+
+fn compile_index_steps<C: Compiler>(
+    compiler: &mut C,
+    indexes: Vec<FieldIndex>,
