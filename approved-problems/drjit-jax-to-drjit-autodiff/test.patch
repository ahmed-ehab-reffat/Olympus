+def test_repeated_eager_calls_keep_derivative_state_local():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x):
+        return x * x + 3 * x
+
+    for size in (2, 5, 3, 2):
+        x = jnp.arange(size, dtype=jnp.float64) - 1.0
+        grad = jax.grad(lambda value: jnp.sum(operation(value)))(x)
+        _, tangent = jax.jvp(
+            operation, (x,), (jnp.full_like(x, 4.0),)
+        )
+        assert_close(grad, 2 * x + 3)
+        assert_close(tangent, 4 * (2 * x + 3))
+
