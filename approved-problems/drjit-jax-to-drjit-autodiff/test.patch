+def test_zero_sized_vmap_forward_mode_preserves_float0_tangents():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(value):
+        return {"value": value * value + dr.sin(value), "integer": 3}
+
+    empty = jnp.empty((0, 4), dtype=jnp.float64)
+    tangent = jnp.empty_like(empty)
+    primal, derivative = jax.vmap(
+        lambda value, direction: jax.jvp(
+            operation, (value,), (direction,)
+        )
+    )(empty, tangent)
+
+    assert primal["value"].shape == (0, 4)
+    assert derivative["value"].shape == (0, 4)
+    assert primal["integer"].shape == (0,)
+    assert derivative["integer"].shape == (0,)
+    assert np.asarray(derivative["integer"]).dtype == np.dtype(jax.float0)
+
