+import drjit as dr
+import jax
+import jax.numpy as jnp
+import numpy as np
+import pytest
+
+
+jax.config.update("jax_enable_x64", True)
+
+
+def assert_close(actual, expected, *, rtol=1e-6, atol=1e-6):
+    np.testing.assert_allclose(
+        np.asarray(actual), np.asarray(expected), rtol=rtol, atol=atol
+    )
+
+
+def test_primal_nested_pytrees_kwargs_multiple_outputs_and_constants():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(payload, *, bias):
+        x = payload["left"][0]
+        y = payload["right"]
+        assert dr.is_array_v(x) and dr.is_array_v(y) and dr.is_array_v(bias)
+        return {
+            "computed": [x * y + bias, x + 2 * y],
+            "constant": 9.0,
+        }
+
+    x = jnp.array([1.0, 2.0, 3.0], dtype=jnp.float64)
+    y = jnp.array([4.0, 5.0, 6.0], dtype=jnp.float64)
+    bias = jnp.array([0.5], dtype=jnp.float64)
+    result = operation({"left": (x,), "right": y}, bias=bias)
+
+    assert isinstance(result, dict)
+    assert isinstance(result["computed"], list)
+    assert result["constant"] == 9.0
+    assert_close(result["computed"][0], x * y + bias)
+    assert_close(result["computed"][1], x + 2 * y)
+
+
+def test_reverse_mode_uses_all_multi_output_cotangents():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, y):
+        return x * x * y + dr.sin(x), x + y * y
+
+    x = jnp.array([0.2, -0.4, 0.7], dtype=jnp.float64)
+    y = jnp.array([1.5, 0.5, -2.0], dtype=jnp.float64)
+    c0 = jnp.array([2.0, -3.0, 4.0], dtype=jnp.float64)
+    c1 = jnp.array([-1.0, 5.0, 0.25], dtype=jnp.float64)
+
+    output, pullback = jax.vjp(operation, x, y)
+    dx, dy = pullback((c0, c1))
+
+    assert_close(output[0], x * x * y + jnp.sin(x))
+    assert_close(output[1], x + y * y)
+    assert_close(dx, c0 * (2 * x * y + jnp.cos(x)) + c1)
+    assert_close(dy, c0 * x * x + c1 * 2 * y)
+
+
+def test_reverse_mode_accumulates_cotangents_for_aliased_output_leaves():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x):
+        shared = x * x + dr.sin(x)
+        return shared, {"again": shared}
+
+    x = jnp.array([0.2, -0.7, 1.5], dtype=jnp.float64)
+    c0 = jnp.array([2.0, -3.0, 4.0], dtype=x.dtype)
+    c1 = jnp.array([-5.0, 0.25, 1.5], dtype=x.dtype)
+    output, pullback = jax.vjp(operation, x)
+    (gradient,) = pullback((c0, {"again": c1}))
+
+    derivative = 2 * x + jnp.cos(x)
+    assert_close(output[0], x * x + jnp.sin(x))
+    assert_close(output[1]["again"], output[0])
+    assert_close(gradient, (c0 + c1) * derivative)
+
+
+def test_forward_mode_combines_distinct_tangents():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, y):
+        return x * x * y + dr.cos(y), x * y
+
+    x = jnp.array([0.5, 1.5, -2.0], dtype=jnp.float64)
+    y = jnp.array([3.0, -0.25, 0.75], dtype=jnp.float64)
+    tx = jnp.array([2.0, -1.0, 4.0], dtype=jnp.float64)
+    ty = jnp.array([-3.0, 5.0, 0.5], dtype=jnp.float64)
+
+    primal, tangent = jax.jvp(operation, (x, y), (tx, ty))
+    assert_close(primal[0], x * x * y + jnp.cos(y))
+    assert_close(primal[1], x * y)
+    assert_close(tangent[0], tx * 2 * x * y + ty * (x * x - jnp.sin(y)))
+    assert_close(tangent[1], tx * y + x * ty)
+
