+def test_nested_keywords_participate_in_reverse_and_forward_mode():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(payload, *, scale):
+        x = payload[0]["x"]
+        offset = payload[1]
+        return {"value": x * scale + offset}
+
+    x = jnp.array([1.0, 2.0, 4.0], dtype=jnp.float64)
+    offset = jnp.array([3.0, 5.0, 7.0], dtype=jnp.float64)
+    scale = jnp.array(2.5, dtype=jnp.float64)
+
+    dx, ds = jax.grad(
+        lambda a, s: jnp.sum(
+            operation([{"x": a}, offset], scale=s)["value"]
+        ),
+        argnums=(0, 1),
+    )(x, scale)
+    _, tangent = jax.jvp(
+        lambda a, s: operation([{"x": a}, offset], scale=s)["value"],
+        (x, scale),
+        (jnp.array([0.5, 1.0, -2.0]), jnp.array(3.0)),
+    )
+
+    assert_close(dx, jnp.full_like(x, scale))
+    assert_close(ds, jnp.sum(x))
+    assert_close(tangent, jnp.array([4.25, 8.5, 7.0]))
+
+
+def test_broadcast_scalar_cotangent_is_reduced_to_input_shape():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, scale):
+        return x * scale + 2
+
+    x = jnp.array([1.0, 3.0, 5.0, 7.0], dtype=jnp.float64)
+    scale = jnp.array([2.0], dtype=jnp.float64)
+    dx, dscale = jax.grad(
+        lambda a, s: jnp.sum(operation(a, s)), argnums=(0, 1)
+    )(x, scale)
+
+    assert_close(dx, jnp.full_like(x, 2.0))
+    assert dscale.shape == (1,)
+    assert_close(dscale, jnp.array([16.0]))
+
