+def test_vmap_reverse_mode_zeros_inputs_disconnected_from_selected_output():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, other):
+        return x * x + dr.sin(x), other * other + dr.cos(other)
+
+    x = jnp.arange(12.0, dtype=jnp.float64).reshape(3, 4) / 5
+    other = jnp.arange(12.0, dtype=jnp.float64).reshape(4, 3) / 7
+    cotangent = jnp.arange(12.0, dtype=jnp.float64).reshape(4, 3) / 9
+
+    def pullback_selected(a, b, seed):
+        _, pullback = jax.vjp(operation, a, b)
+        return pullback((seed, jnp.zeros_like(b)))
+
+    dx, dother = jax.vmap(
+        pullback_selected, in_axes=(1, 0, 0)
+    )(x, other, cotangent)
+
+    x_front = jnp.moveaxis(x, 1, 0)
+    assert_close(dx, cotangent * (2 * x_front + jnp.cos(x_front)))
+    assert_close(dother, jnp.zeros_like(other))
+
