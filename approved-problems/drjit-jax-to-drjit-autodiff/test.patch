+def test_int64_arrays_cross_boundary_without_narrowing():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(value, index):
+        return value * (index + 2), index + 1
+
+    value = jnp.array([1.0, 2.0, -3.0], dtype=jnp.float64)
+    index = jnp.array([2**40, -(2**40), 7], dtype=jnp.int64)
+    result, shifted = operation(value, index)
+    gradient = jax.grad(
+        lambda argument: jnp.sum(operation(argument, index)[0])
+    )(value)
+
+    assert shifted.dtype == jnp.int64
+    np.testing.assert_array_equal(np.asarray(shifted), np.asarray(index + 1))
+    assert_close(result, value * (index + 2))
+    assert_close(gradient, index + 2)
