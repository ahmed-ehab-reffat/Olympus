+def test_vmap_primal_preserves_mixed_axes_and_nested_pytrees():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(payload, scale):
+        x = payload["x"]
+        y = payload["y"][0]
+        return {
+            "sum": [x * scale + y],
+            "pair": (x - y, x * y),
+            "constant": 9.0,
+        }
+
+    x = jnp.arange(24.0, dtype=jnp.float64).reshape(2, 3, 4) / 10
+    y = jnp.arange(24.0, dtype=jnp.float64).reshape(3, 2, 4) / 7
+    scale = jnp.array(1.5, dtype=jnp.float64)
+    result = jax.vmap(
+        operation,
+        in_axes=({"x": -2, "y": (0,)}, None),
+        out_axes={"sum": [1], "pair": (0, 0), "constant": 0},
+    )({"x": x, "y": (y,)}, scale)
+
+    x_front = jnp.moveaxis(x, 1, 0)
+    assert_close(result["sum"][0], x * scale + jnp.moveaxis(y, 0, 1))
+    assert_close(result["pair"][0], x_front - y)
+    assert_close(result["pair"][1], x_front * y)
+    assert_close(result["constant"], jnp.full((3,), 9.0))
+
