+def test_vmap_primal_maps_values_independent_of_ad_connectivity():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(value, index):
+        return {
+            "floored": dr.floor(value),
+            "from_integer": index * 1.5,
+        }
+
+    value = jnp.array([0.3, 1.7, 2.2, 3.9], dtype=jnp.float64)
+    index = jnp.array([2, 5, 9, 1], dtype=jnp.int32)
+    result = jax.vmap(operation)(value, index)
+
+    assert_close(result["floored"], jnp.floor(value))
+    assert_close(result["from_integer"], index * 1.5)
+
