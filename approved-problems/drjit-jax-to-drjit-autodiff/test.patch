+def test_reverse_mode_handles_integer_and_unused_inputs():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, indices, unused, offset, stride):
+        return {
+            "value": x * (indices + stride) + offset,
+            "indices": indices + 2,
+            "literal": 7,
+        }
+
+    x = jnp.array([1.0, 2.0, 3.0], dtype=jnp.float32)
+    indices = jnp.array([0, 2, 4], dtype=jnp.int32)
+    unused = jnp.array([10.0, 20.0, 30.0], dtype=jnp.float32)
+
+    dx, dunused = jax.grad(
+        lambda a, u: jnp.sum(operation(a, indices, u, 2.5, 1)["value"]),
+        argnums=(0, 1),
+    )(x, unused)
+    result = operation(x, indices, unused, 2.5, 1)
+    _, tangent = jax.jvp(
+        lambda a: operation(a, indices, unused, 2.5, 1),
+        (x,),
+        (jnp.ones_like(x),),
+    )
+
+    assert_close(dx, indices + 1)
+    assert_close(dunused, jnp.zeros_like(unused))
+    assert_close(result["value"], x * (indices + 1) + 2.5)
+    assert_close(tangent["value"], indices + 1)
+    assert np.asarray(tangent["indices"]).dtype == np.dtype(jax.float0)
+    assert np.asarray(tangent["literal"]).dtype == np.dtype(jax.float0)
+    np.testing.assert_array_equal(
+        np.asarray(result["indices"]), np.asarray(indices + 2)
+    )
+    assert result["literal"] == 7
+
