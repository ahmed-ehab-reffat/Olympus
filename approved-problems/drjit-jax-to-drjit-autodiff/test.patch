+def test_vmap_composes_with_forward_mode_inside_the_batch():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, scale):
+        return x * x * scale + dr.sin(x), x + scale
+
+    x = jnp.arange(12.0, dtype=jnp.float64).reshape(4, 3) / 5
+    scale = jnp.array([1.0, -2.0, 0.5], dtype=jnp.float64)
+    tx = jnp.arange(12.0, dtype=jnp.float64).reshape(4, 3) / 9
+    ts = jnp.array([0.25, 3.0, -1.5], dtype=jnp.float64)
+
+    primal, tangent = jax.vmap(
+        lambda a, s, da, ds: jax.jvp(operation, (a, s), (da, ds)),
+        in_axes=(1, 0, 1, 0),
+    )(x, scale, tx, ts)
+
+    x_front = jnp.moveaxis(x, 1, 0)
+    tx_front = jnp.moveaxis(tx, 1, 0)
+    expected_primal = x_front * x_front * scale[:, None] + jnp.sin(x_front)
+    expected_tangent = (
+        tx_front * (2 * x_front * scale[:, None] + jnp.cos(x_front))
+        + ts[:, None] * x_front * x_front
+    )
+    assert_close(primal[0], expected_primal)
+    assert_close(primal[1], x_front + scale[:, None])
+    assert_close(tangent[0], expected_tangent)
+    assert_close(tangent[1], tx_front + ts[:, None])
+
+    _, outer_tangent = jax.jvp(
+        lambda a, s: jax.vmap(operation, in_axes=(1, 0))(a, s),
+        (x, scale),
+        (tx, ts),
+    )
+    assert_close(outer_tangent[0], expected_tangent)
+    assert_close(outer_tangent[1], tx_front + ts[:, None])
+
