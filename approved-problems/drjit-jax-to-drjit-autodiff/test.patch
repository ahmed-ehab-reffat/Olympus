+@pytest.mark.parametrize(
+    ("source", "target"),
+    [(jax, "drjit"), ("jax", dr)],
+    ids=["module-source", "module-target"],
+)
+def test_mixed_string_and_module_decorator_arguments(source, target):
+    @dr.wrap(source=source, target=target)
+    def operation(x):
+        return x * x + 1
+
+    x = jnp.array([1.0, -2.0, 3.5], dtype=jnp.float32)
+    value = operation(x)
+    grad = jax.grad(lambda a: jnp.sum(operation(a)))(x)
+
+    assert_close(value, x * x + 1)
+    assert_close(grad, 2 * x)
+
+
+@pytest.mark.parametrize("dtype", [jnp.float16, jnp.float32, jnp.float64])
+def test_supported_float_dtype_rank_and_module_form_are_preserved(dtype):
+    @dr.wrap(source=jax, target=dr)
+    def operation(x):
+        return x * x
+
+    x = jnp.array([[1.25, -2.5], [0.5, 3.0]], dtype=dtype)
+    value = operation(x)
+    grad = jax.grad(lambda a: jnp.sum(operation(a)))(x)
+
+    assert value.dtype == dtype
+    assert grad.dtype == dtype
+    assert value.shape == x.shape
+    tolerance = 2e-3 if dtype == jnp.float16 else 1e-6
+    assert_close(value, x * x, rtol=tolerance, atol=tolerance)
+    assert_close(grad, 2 * x, rtol=tolerance, atol=tolerance)
+
