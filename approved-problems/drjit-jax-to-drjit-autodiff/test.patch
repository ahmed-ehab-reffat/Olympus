+def test_zero_sized_vmap_reverse_mode_uses_input_avals():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x, y):
+        return dr.sum(x * x) + dr.sum(y * y)
+
+    x = jnp.empty((0, 4), dtype=jnp.float64)
+    y = jnp.empty((0, 2), dtype=jnp.float64)
+    dx, dy = jax.vmap(jax.grad(operation, argnums=(0, 1)))(x, y)
+
+    assert dx.shape == (0, 4)
+    assert dy.shape == (0, 2)
+    assert dx.dtype == x.dtype
+    assert dy.dtype == y.dtype
+
