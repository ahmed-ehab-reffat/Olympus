+def test_reverse_mode_composes_outside_vmap_and_handles_empty_batches():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(x):
+        return {"value": x * x * x + dr.cos(x), "shifted": x + 2}
+
+    x = jnp.arange(12.0, dtype=jnp.float64).reshape(3, 4) / 6
+    objective = lambda value: jnp.sum(jax.vmap(operation)(value)["value"])
+    gradient = jax.grad(objective)(x)
+    assert_close(gradient, 3 * x * x - jnp.sin(x))
+
+    empty = jnp.empty((0, 4), dtype=jnp.float64)
+    result = jax.vmap(operation)(empty)
+    assert result["value"].shape == (0, 4)
+    assert result["value"].dtype == empty.dtype
+    assert result["shifted"].shape == (0, 4)
+
