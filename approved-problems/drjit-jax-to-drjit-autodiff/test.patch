+def test_direct_python_numeric_primals_work_with_jvp_and_vjp():
+    @dr.wrap(source="jax", target="drjit")
+    def operation(value, scale):
+        return value * scale
+
+    value = jnp.array([1.0, -2.0, 4.0], dtype=jnp.float64)
+    direction = jnp.array([0.5, 3.0, -1.0], dtype=jnp.float64)
+    primal, tangent = jax.jvp(
+        operation, (value, 2.0), (direction, 0.0)
+    )
+    output, pullback = jax.vjp(operation, value, 2.0)
+    dvalue, dscale = pullback(jnp.ones_like(output))
+
+    assert_close(primal, value * 2.0)
+    assert_close(tangent, direction * 2.0)
+    assert_close(dvalue, jnp.full_like(value, 2.0))
+    assert_close(dscale, jnp.sum(value))
+
