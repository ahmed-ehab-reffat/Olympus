+#!/usr/bin/env bash
+set -euo pipefail
+
+output_path="results.xml"
+if [ "${1:-}" = "--output_path" ]; then
+    output_path="$2"
+    shift 2
+fi
+
+case "${1:-}" in
+    base)
+        test_file="tests/test_wrap.py"
+        ;;
+    new)
+        test_file="tests/test_jax_to_drjit_7f31c2.py"
+        ;;
+    *)
+        echo "usage: $0 [--output_path PATH] {base|new}" >&2
+        exit 2
+        ;;
+esac
+
+source_root="$(pwd)"
+run_root="$(mktemp -d /tmp/drjit-eval.XXXXXX)"
+runtime_root="$run_root/runtime"
+
+cleanup() {
+    rm -rf -- "$run_root"
+}
+trap cleanup EXIT
+
+mkdir -p "$runtime_root" "$(dirname "$output_path")"
+cp -a /opt/drjit-runtime/. "$runtime_root/"
+cp -a "$source_root/drjit/." "$runtime_root/drjit/"
+
+cd /tmp
+PYTHONPATH="$runtime_root:/usr/local/lib/python3.12/site-packages" \
+    python -S -P -m pytest \
+    "$source_root/$test_file" -q --rootdir=/tmp --junitxml="$output_path"
