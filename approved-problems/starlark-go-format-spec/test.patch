+func TestStrFormatRejections(t *testing.T) {
+	cases := []struct {
+		name    string
+		valid   string
+		want    string
+		invalid string
+	}{
+		{"precision_on_int", `"{:5d}".format(5)`, "    5", `"{:.2d}".format(5)`},
+		{"comma_with_binary", `"{:b}".format(5)`, "101", `"{:,b}".format(255)`},
+		{"comma_with_char", `"{:c}".format(65)`, "A", `"{:,c}".format(65)`},
+		{"sign_with_char", `"{:c}".format(65)`, "A", `"{:+c}".format(65)`},
+		{"precision_with_char", `"{:c}".format(65)`, "A", `"{:.2c}".format(65)`},
+		{"char_out_of_range", `"{:c}".format(65)`, "A", `"{:c}".format(-1)`},
+		{"sign_on_string", `"{:>5}".format("x")`, "    x", `"{:+}".format("x")`},
+		{"alt_on_string", `"{:>5}".format("x")`, "    x", `"{:#}".format("x")`},
+		{"grouping_on_string", `"{:>5}".format("x")`, "    x", `"{:,}".format("x")`},
+		{"equals_align_on_string", `"{:>5}".format("x")`, "    x", `"{:=5}".format("x")`},
+		{"int_type_on_float", `"{:.1f}".format(3.5)`, "3.5", `"{:d}".format(3.14)`},
+		{"hex_type_on_float", `"{:.1f}".format(3.5)`, "3.5", `"{:x}".format(3.14)`},
+		{"string_type_on_int", `"{:5d}".format(5)`, "    5", `"{:s}".format(5)`},
+		{"string_type_on_float", `"{:.1f}".format(3.5)`, "3.5", `"{:s}".format(3.5)`},
+		{"unknown_type_code", `"{:5d}".format(5)`, "    5", `"{:5q}".format(5)`},
+		{"auto_then_manual", `"{0:d}".format(5)`, "5", `"{:d}{0:d}".format(1, 2)`},
+		{"manual_then_auto", `"{0:d}".format(5)`, "5", `"{0:d}{:d}".format(1, 2)`},
+		{"index_out_of_range", `"{0:d}".format(5)`, "5", `"{5:d}".format(1)`},
+		{"missing_keyword", `"{x:d}".format(x=5)`, "5", `"{y:d}".format(x=5)`},
+		{"missing_dict_key", `"{0[a]}".format({"a": 1})`, "1", `"{0[z]}".format({"a": 1})`},
+		{"list_index_out_of_range", `"{0[0]}".format([1])`, "1", `"{0[9]}".format([1])`},
+		{"missing_attribute", `"{0.x:d}".format(struct(x=1))`, "1", `"{0.y:d}".format(struct(x=1))`},
+		{"nested_non_numeric_width", `"{:{}d}".format(5, 4)`, "   5", `"{:{}d}".format(5, "wide")`},
+		{"nested_manual_then_auto_latch", `"{0:{1}d}".format(5, 4)`, "   5", `"{0:{}d}".format(5, 4)`},
+		{"double_sign", `"{:+d}".format(5)`, "+5", `"{:++d}".format(5)`},
+		{"comma_and_underscore", `"{:,d}".format(1000)`, "1,000", `"{:,_d}".format(1000)`},
+		{"lone_close_brace", `"{:d}".format(5)`, "5", `"}".format()`},
+		{"unmatched_open_brace", `"{:d}".format(5)`, "5", `"{:d".format(5)`},
+		{"unknown_conversion", `"{0!s:>3}".format(1)`, "  1", `"{0!q}".format(1)`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := formatResult(t, c.valid); got != c.want {
+				t.Errorf("%s = %q, want %q", c.valid, got, c.want)
+			}
+			if _, err := evalFormat(c.invalid); err == nil {
+				t.Errorf("%s: expected an error, got none", c.invalid)
+			}
+		})
+	}
+}
