+func TestPercentInterpolation(t *testing.T) {
+	cases := []struct {
+		name string
+		src  string
+		want string
+	}{
+		{"percent_float_width_precision", `"%5.2f" % 3.14159`, " 3.14"},
+		{"percent_float_zero_pad", `"%08.2f" % -3.14159`, "-0003.14"},
+		{"percent_float_sign_zero", `"%+08.2f" % 3.14159`, "+0003.14"},
+		{"percent_float_exponent_sign", `"%+.2e" % -1234.5`, "-1.23e+03"},
+		{"percent_float_general_precision", `"%.2g" % 1234.5`, "1.2e+03"},
+		{"percent_int_sign", `"%+d" % 42`, "+42"},
+		{"percent_int_space_sign", `"% d" % 42`, " 42"},
+		{"percent_int_zero_pad_negative", `"%05d" % -42`, "-0042"},
+		{"percent_int_precision_min_digits", `"%.3d" % 5`, "005"},
+		{"percent_int_precision_space_width", `"%5.3d" % 5`, "  005"},
+		{"percent_int_precision_left", `"%-5.3d" % 5`, "005  "},
+		{"percent_int_alt_hex", `"%#x" % 255`, "0xff"},
+		{"percent_int_alt_hex_upper", `"%#X" % 255`, "0XFF"},
+		{"percent_int_alt_octal", `"%#o" % 64`, "0o100"},
+		{"percent_int_left_plus", `"%-+8d" % 42`, "+42     "},
+		{"percent_string_default_right", `"%5s" % "x"`, "    x"},
+		{"percent_string_left", `"%-10s" % "hi"`, "hi        "},
+		{"percent_string_zero_flag_ignored", `"%05s" % "x"`, "    x"},
+		{"percent_string_precision", `"%.3s" % "hello"`, "hel"},
+		{"percent_char_width", `"%5c" % 65`, "    A"},
+		{"percent_char_zero_flag_ignored", `"%05c" % 65`, "    A"},
+		{"percent_tuple_two_specs", `"%05d:%-4s" % (7, "ab")`, "00007:ab  "},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := formatResult(t, c.src); got != c.want {
+				t.Errorf("%s = %q, want %q", c.src, got, c.want)
+			}
+		})
+	}
+}
+
+func TestPercentRejections(t *testing.T) {
+	cases := []struct {
+		name    string
+		valid   string
+		want    string
+		invalid string
+	}{
+		{"width_int_on_string", `"%5d" % 42`, "   42", `"%5d" % "x"`},
+		{"precision_float_on_string", `"%.2f" % 3.5`, "3.50", `"%.2f" % "x"`},
+		{"width_char_out_of_range", `"%5c" % 65`, "    A", `"%5c" % -1`},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := formatResult(t, c.valid); got != c.want {
+				t.Errorf("%s = %q, want %q", c.valid, got, c.want)
+			}
+			if _, err := evalFormat(c.invalid); err == nil {
+				t.Errorf("%s: expected an error, got none", c.invalid)
+			}
+		})
+	}
+}
