+#!/usr/bin/env bash
+set -uo pipefail
+
+export GOFLAGS="-buildvcs=false"
+export PATH="/usr/local/bin:/usr/local/go/bin:/root/go/bin:${PATH:-}"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    --output_path=*) OUTPUT_PATH="${1#*=}"; shift ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="/tmp/report.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+cd /app
+
+code=0
+case "$MODE" in
+  base)
+    # Run the full existing suite for regression detection, excluding only the
+    # new feature's package (which lives in its own directory).
+    pkgs=$(go list ./... 2>/dev/null | grep -v 'go.starlark.net/starlark/strformatspec$' || true)
+    go test -v $pkgs 2>&1 | go-junit-report -set-exit-code > "$OUTPUT_PATH"
+    code=${PIPESTATUS[1]}
+    ;;
+  new)
+    go test -v ./starlark/strformatspec/ 2>&1 | go-junit-report -set-exit-code > "$OUTPUT_PATH"
+    code=${PIPESTATUS[1]}
+    ;;
+  *)
+    echo "usage: test.sh --output_path <path> base|new" >&2
+    exit 2
+    ;;
+esac
+
+# Fallback: if the run produced no testcases (e.g. a build failure), emit a
+# single failing node so the report is never empty.
+if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  cat > "$OUTPUT_PATH" <<'XML'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="strformat" tests="1" failures="1" errors="0">
+    <testcase name="TestStrFormatMiniLanguage" classname="go.starlark.net/starlark"><failure message="no tests ran or build failed"/></testcase>
+  </testsuite>
+</testsuites>
+XML
+  exit 1
+fi
+
+exit "$code"
