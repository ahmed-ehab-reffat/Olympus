+func evalFormat(src string) (starlark.Value, error) {
+	thread := &starlark.Thread{Name: "strformat"}
+	predeclared := starlark.StringDict{
+		"struct": starlark.NewBuiltin("struct", starlarkstruct.Make),
+	}
+	return starlark.Eval(thread, "strformat_test.star", src, predeclared)
+}
+
+func formatResult(t *testing.T, src string) string {
+	t.Helper()
+	v, err := evalFormat(src)
+	if err != nil {
+		t.Fatalf("%s: unexpected error: %v", src, err)
+	}
+	s, ok := starlark.AsString(v)
+	if !ok {
+		t.Fatalf("%s: result is %s, want string", src, v.Type())
+	}
+	return s
+}
