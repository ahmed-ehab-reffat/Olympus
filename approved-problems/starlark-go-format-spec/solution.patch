+// formatSignificant renders a magnitude to sig significant digits, choosing
+// scientific notation when the decimal exponent is below -4 or at least
+// threshold. The 'g' and empty types pass threshold == sig.
+func formatSignificant(mag float64, sig, threshold int, alt, upper bool) string {
+	s := strconv.FormatFloat(mag, 'e', sig-1, 64)
