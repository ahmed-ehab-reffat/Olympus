--- a/starlark/int.go
+++ b/starlark/int.go
@@ -10,6 +10,7 @@ import (
 	"math/big"
 	"reflect"
 	"strconv"
+	"strings"
 
 	"go.starlark.net/syntax"
 )
@@ -457,3 +458,143 @@ func finiteFloatToInt(f Float) Int {
 	}
 	return MakeBigInt(new(big.Int).Div(rat.Num(), rat.Denom()))
 }
+
+// formatInteger renders an arbitrary-precision integer for str.format using
+// the parsed spec. It operates on the *big.Int magnitude so values outside the
+// int64 range format correctly. The 'c' type is handled by formatChar.
+func formatInteger(x *big.Int, fs formatSpec) (string, error) {
+	if fs.hasPrec {
+		return "", fmt.Errorf("format: precision not allowed with integer type")
+	}
+	typ := fs.typ
+	if typ == 0 {
+		typ = 'd'
+	}
+	if typ == 'c' {
+		return formatChar(x, fs)
+	}
+
+	var base int
+	var prefix string
+	upper := false
+	switch typ {
+	case 'b':
+		base, prefix = 2, "0b"
+	case 'o':
+		base, prefix = 8, "0o"
+	case 'x':
+		base, prefix = 16, "0x"
+	case 'X':
+		base, prefix, upper = 16, "0X", true
+	case 'd':
+		base = 10
+	case 'n':
+		base = 10
+		if fs.group != 0 {
+			return "", fmt.Errorf("format: cannot specify a grouping option with the 'n' type")
+		}
+	default:
+		return "", fmt.Errorf("format: unknown format code %q for integer", typ)
+	}
+	if fs.group == ',' && base != 10 {
+		return "", fmt.Errorf("format: cannot specify ',' with the %q type", typ)
+	}
+
+	if fs.align == 0 {
+		if fs.zero {
+			fs.align = '='
+		} else {
+			fs.align = '>'
+		}
+	}
+	if !fs.alt {
+		prefix = ""
+	}
+
+	neg := x.Sign() < 0
+	mag := new(big.Int).Abs(x)
+	digits := mag.Text(base)
+	if upper {
+		digits = strings.ToUpper(digits)
+	}
+	sign := signString(neg, fs.sign)
+	sep, gsize := groupingFor(fs.group, base)
+
+	if fs.align == '=' && fs.fill == '0' {
+		minWidth := 0
+		if fs.hasWidth {
+			minWidth = fs.width - len(sign) - len(prefix)
+			if minWidth < 0 {
+				minWidth = 0
+			}
+		}
+		return applyAlign(sign, prefix, groupDigits(digits, sep, gsize, minWidth), fs), nil
+	}
+	return applyAlign(sign, prefix, groupDigits(digits, sep, gsize, 0), fs), nil
+}
+
+// formatChar renders an integer codepoint as a single character. The 'c' type
+// rejects the sign, alternate-form, grouping, and precision options.
+func formatChar(x *big.Int, fs formatSpec) (string, error) {
+	if fs.sign != 0 || fs.alt || fs.group != 0 || fs.hasPrec {
+		return "", fmt.Errorf("format: sign, '#', grouping, and precision are not allowed with the 'c' type")
+	}
+	if !x.IsInt64() {
+		return "", fmt.Errorf("format: 'c' argument out of range")
+	}
+	cp := x.Int64()
+	if cp < 0 || cp > 0x10FFFF {
+		return "", fmt.Errorf("format: 'c' argument out of range")
+	}
+	if fs.align == 0 {
+		if fs.zero {
+			fs.align = '='
+		} else {
+			fs.align = '>'
+		}
+	}
+	return applyAlign("", "", string(rune(cp)), fs), nil
+}
+
+// formatPercentInt renders an integer for %-interpolation. Unlike the
+// str.format integer renderer a precision sets the minimum number of digits
+// (zero-extending the magnitude) and there is no grouping; the zero-padding
+// flag still applies and is performed by the '=' branch of applyAlign.
+func formatPercentInt(x *big.Int, fs formatSpec, conv byte) (string, error) {
+	var base int
+	var prefix string
+	upper := false
+	switch conv {
+	case 'd':
+		base = 10
+	case 'o':
+		base, prefix = 8, "0o"
+	case 'x':
+		base, prefix = 16, "0x"
+	case 'X':
+		base, prefix, upper = 16, "0X", true
+	default:
+		return "", fmt.Errorf("unknown conversion %%%c", conv)
+	}
+
+	neg := x.Sign() < 0
+	digits := new(big.Int).Abs(x).Text(base)
+	if upper {
+		digits = strings.ToUpper(digits)
+	}
+	if fs.hasPrec && len(digits) < fs.prec {
+		digits = strings.Repeat("0", fs.prec-len(digits)) + digits
+	}
+	if !fs.alt {
+		prefix = ""
+	}
+	sign := signString(neg, fs.sign)
+	if fs.align == 0 {
+		if fs.zero {
+			fs.align = '='
+		} else {
+			fs.align = '>'
+		}
+	}
+	return applyAlign(sign, prefix, digits, fs), nil
+}
