diff --git a/starlark/format.go b/starlark/format.go
new file mode 100644
index 0000000..20b5e32
--- /dev/null
+++ b/starlark/format.go
@@ -0,0 +1,336 @@
+// Copyright 2017 The Bazel Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package starlark
+
+// This file implements the Python str.format() format specifier mini-language:
+//
+//	[[fill]align][sign][#][0][width][grouping_option][.precision][type]
+//
+// The grammar parser and the alignment/padding/grouping engine live here as
+// pure functions with no dependence on Value; the per-type renderers
+// (formatInteger, formatFloat, formatString) consume a formatSpec and call
+// applyAlign and groupDigits.
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+)
+
+// formatSpec is a parsed format specifier.
+type formatSpec struct {
+	fill     rune // pad rune (default ' ')
+	align    byte // '<', '>', '^', '=', or 0 if unset
+	sign     byte // '+', '-', ' ', or 0 (default '-')
+	alt      bool // '#': alternate form
+	zero     bool // leading '0': sign-aware zero padding
+	width    int
+	hasWidth bool
+	group    byte // ',', '_', or 0
+	prec     int
+	hasPrec  bool
+	typ      byte // presentation type, or 0 if empty
+}
+
+func isAlignByte(c byte) bool {
+	return c == '<' || c == '>' || c == '^' || c == '='
+}
+
+// parseFormatSpec parses a fully-resolved (no nested fields) format specifier.
+func parseFormatSpec(spec string) (formatSpec, error) {
+	fs := formatSpec{fill: ' '}
+	r := []rune(spec)
+	n := len(r)
+	i := 0
+
+	fillSpecified := false
+	if n >= 2 && r[1] < utf8.RuneSelf && isAlignByte(byte(r[1])) {
+		fs.fill = r[0]
+		fs.align = byte(r[1])
+		fillSpecified = true
+		i = 2
+	} else if n >= 1 && r[0] < utf8.RuneSelf && isAlignByte(byte(r[0])) {
+		fs.align = byte(r[0])
+		i = 1
+	}
+
+	if i < n && (r[i] == '+' || r[i] == '-' || r[i] == ' ') {
+		fs.sign = byte(r[i])
+		i++
+	}
+
+	if i < n && r[i] == '#' {
+		fs.alt = true
+		i++
+	}
+
+	// A leading '0' before the width sets sign-aware zero padding. It supplies
+	// the fill character only when no explicit fill was given, and leaves the
+	// default alignment to the per-type renderer.
+	if i < n && r[i] == '0' && !fillSpecified {
+		fs.fill = '0'
+		fs.zero = true
+		i++
+	}
+
+	w := i
+	for i < n && r[i] >= '0' && r[i] <= '9' {
+		i++
+	}
+	if i > w {
+		width, ok := decimal(string(r[w:i]))
+		if !ok {
+			return fs, fmt.Errorf("format: invalid width in format specifier %q", spec)
+		}
+		fs.width = width
+		fs.hasWidth = true
+	}
+
+	if i < n && (r[i] == ',' || r[i] == '_') {
+		fs.group = byte(r[i])
+		i++
+	}
+
+	if i < n && r[i] == '.' {
+		i++
+		p := i
+		for i < n && r[i] >= '0' && r[i] <= '9' {
+			i++
+		}
+		if i == p {
+			return fs, fmt.Errorf("format: format specifier missing precision: %q", spec)
+		}
+		prec, ok := decimal(string(r[p:i]))
+		if !ok {
+			return fs, fmt.Errorf("format: invalid precision in format specifier %q", spec)
+		}
+		fs.prec = prec
+		fs.hasPrec = true
+	}
+
+	if i < n {
+		fs.typ = byte(r[i])
+		i++
+	}
+
+	if i != n {
+		return fs, fmt.Errorf("format: invalid format specifier %q", spec)
+	}
+	return fs, nil
+}
+
+// applyAlign pads sign+prefix+body to spec.width using the alignment and fill.
+// For '=' alignment the fill is inserted between the prefix and the body so the
+// sign and any base prefix stay leftmost.
+func applyAlign(sign, prefix, body string, fs formatSpec) string {
+	if !fs.hasWidth {
+		return sign + prefix + body
+	}
+	total := utf8.RuneCountInString(sign) + utf8.RuneCountInString(prefix) + utf8.RuneCountInString(body)
+	if total >= fs.width {
+		return sign + prefix + body
+	}
+	pad := fs.width - total
+	fill := string(fs.fill)
+	switch fs.align {
+	case '>':
+		return strings.Repeat(fill, pad) + sign + prefix + body
+	case '^':
+		left := pad / 2
+		return strings.Repeat(fill, left) + sign + prefix + body + strings.Repeat(fill, pad-left)
+	case '=':
+		return sign + prefix + strings.Repeat(fill, pad) + body
+	default: // '<'
+		return sign + prefix + body + strings.Repeat(fill, pad)
+	}
+}
+
+// groupingFor returns the separator and group size for a base, or (0, 0) when
+// no grouping was requested. The ',' separator groups by three; '_' groups
+// decimal digits by three and binary/octal/hexadecimal digits by four.
+func groupingFor(group byte, base int) (byte, int) {
+	if group == 0 {
+		return 0, 0
+	}
+	if base == 10 {
+		return group, 3
+	}
+	return group, 4
+}
+
+// groupDigits inserts sep into a run of digits, grouping from the right in
+// chunks of g. When minWidth > 0 the digit run is first left-extended with '0'
+// to the fewest digits whose grouped form spans at least minWidth characters,
+// implementing grouping-aware zero padding.
+func groupDigits(digits string, sep byte, g int, minWidth int) string {
+	if g == 0 {
+		if minWidth > len(digits) {
+			return strings.Repeat("0", minWidth-len(digits)) + digits
+		}
+		return digits
+	}
+	d := len(digits)
+	if minWidth > 0 {
+		for d+(d-1)/g < minWidth {
+			d++
+		}
+	}
+	if d > len(digits) {
+		digits = strings.Repeat("0", d-len(digits)) + digits
+	}
+	n := len(digits)
+	var b strings.Builder
+	for i := 0; i < n; i++ {
+		if i > 0 && (n-i)%g == 0 {
+			b.WriteByte(sep)
+		}
+		b.WriteByte(digits[i])
+	}
+	return b.String()
+}
+
+// parsePercentSpec parses the optional [flags][width][.precision] that may
+// follow a '%' in string interpolation (before the conversion character),
+// translating the printf flags into a formatSpec. It returns the spec, the
+// number of bytes consumed, and whether any field was present; a bare
+// conversion (no fields) leaves the legacy interpolation path in charge.
+func parsePercentSpec(s string) (formatSpec, int, bool) {
+	fs := formatSpec{fill: ' '}
+	i, n := 0, len(s)
+	present := false
+	minus, zero := false, false
+flags:
+	for i < n {
+		switch s[i] {
+		case '-':
+			minus = true
+		case '+':
+			fs.sign = '+'
+		case ' ':
+			if fs.sign == 0 {
+				fs.sign = ' '
+			}
+		case '#':
+			fs.alt = true
+		case '0':
+			zero = true
+		default:
+			break flags
+		}
+		present = true
+		i++
+	}
+
+	w := i
+	for i < n && s[i] >= '0' && s[i] <= '9' {
+		i++
+	}
+	if i > w {
+		if width, ok := decimal(s[w:i]); ok {
+			fs.width = width
+			fs.hasWidth = true
+			present = true
+		}
+	}
+
+	if i < n && s[i] == '.' {
+		i++
+		p := i
+		for i < n && s[i] >= '0' && s[i] <= '9' {
+			i++
+		}
+		prec, _ := decimal(s[p:i])
+		fs.prec = prec
+		fs.hasPrec = true
+		present = true
+	}
+
+	// A '-' flag left-aligns and overrides the zero flag; otherwise a '0' flag
+	// requests sign-aware zero padding.
+	if minus {
+		fs.align = '<'
+	} else if zero {
+		fs.align = '='
+		fs.fill = '0'
+		fs.zero = true
+	}
+	return fs, i, present
+}
+
+// signString returns the leading sign for a magnitude, given whether the value
+// is negative and the requested sign mode.
+func signString(neg bool, sign byte) string {
+	if neg {
+		return "-"
+	}
+	switch sign {
+	case '+':
+		return "+"
+	case ' ':
+		return " "
+	}
+	return ""
+}
+
+// renderSig builds the significant-digit form of a non-negative magnitude from
+// its shortest/rounded decimal digits and decimal exponent X (value =
+// digits[0].digits[1:] x 10**X). useExp selects scientific notation; alt keeps
+// trailing zeros and the decimal point; upper uppercases the exponent marker.
+func renderSig(digits string, X int, useExp, alt, upper bool) string {
+	if useExp {
+		mant := digits[:1]
+		frac := digits[1:]
+		if !alt {
+			frac = strings.TrimRight(frac, "0")
+		}
+		var b strings.Builder
+		b.WriteString(mant)
+		if len(frac) > 0 || alt {
+			b.WriteByte('.')
+			b.WriteString(frac)
+		}
+		if upper {
+			b.WriteByte('E')
+		} else {
+			b.WriteByte('e')
+		}
+		e := X
+		if e < 0 {
+			b.WriteByte('-')
+			e = -e
+		} else {
+			b.WriteByte('+')
+		}
+		es := strconv.Itoa(e)
+		if len(es) < 2 {
+			b.WriteByte('0')
+		}
+		b.WriteString(es)
+		return b.String()
+	}
+
+	n := len(digits)
+	point := X + 1
+	var intPart, fracPart string
+	switch {
+	case point <= 0:
+		intPart = "0"
+		fracPart = strings.Repeat("0", -point) + digits
+	case point >= n:
+		intPart = digits + strings.Repeat("0", point-n)
+		fracPart = ""
+	default:
+		intPart = digits[:point]
+		fracPart = digits[point:]
+	}
+	if !alt {
+		fracPart = strings.TrimRight(fracPart, "0")
+	}
+	if len(fracPart) > 0 || alt {
+		return intPart + "." + fracPart
+	}
+	return intPart
+}
