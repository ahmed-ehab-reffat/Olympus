+// formatExponent renders a magnitude in scientific notation with prec fraction
+// digits, honoring the alternate form when the precision is zero.
+func formatExponent(mag float64, typ byte, prec int, alt bool) string {
+	s := strconv.FormatFloat(mag, typ, prec, 64)
