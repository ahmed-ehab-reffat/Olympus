+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2016-2026 by University of Kassel and Fraunhofer Institute for Energy Economics
+# and Energy System Technology (IEE), Kassel. All rights reserved.
+
+from types import SimpleNamespace
+
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_allclose, assert_array_equal
+
+import pandapower as pp
+import pandapower.topology as top
+from pandapower.create import create_bus, create_empty_network, create_ext_grid, \
+    create_line_from_parameters, create_load, create_switch, create_transformer_from_parameters
+from pandapower.results import reset_results
+
+
+def connect(net, from_bus, to_bus, length_km=1.0):
+    return create_line_from_parameters(net, from_bus, to_bus, length_km=length_km, r_ohm_per_km=0.1,
+                                       x_ohm_per_km=0.1, c_nf_per_km=0.0, max_i_ka=1.0)
+
+
+def transform(net, hv_bus, lv_bus):
+    return create_transformer_from_parameters(net, hv_bus=hv_bus, lv_bus=lv_bus, sn_mva=1.0,
+                                              vn_hv_kv=20.0, vn_lv_kv=0.4, vkr_percent=1.0,
+                                              vk_percent=6.0, pfe_kw=0.0, i0_percent=0.0)
+
+
+def with_line_faults(net, rate=0.1, repair_time_h=5.0):
+    net.line["failure_rate_per_km_per_year"] = rate
+    net.line["repair_time_h"] = repair_time_h
+    return net
+
+
+def feeder(breaker=True, tie=True):
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(5)]
+    grid = [create_ext_grid(net, bus[0])]
+    line = [connect(net, bus[position], bus[position + 1]) for position in range(3)]
+    switch = []
+    if breaker:
+        switch.append(create_switch(net, bus[0], line[0], et="l", type="CB"))
+    switch.append(create_switch(net, bus[1], line[1], et="l", type="DS"))
+    if tie:
+        grid.append(create_ext_grid(net, bus[4]))
+        switch.append(create_switch(net, bus[3], bus[4], et="b", closed=False, type="LBS"))
+    load = [create_load(net, bus[position], p_mw=0.1, customers=10) for position in (1, 2, 3)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def reversed_feeder():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(4)]
+    grid = [create_ext_grid(net, bus[3])]
+    line = [connect(net, bus[3], bus[2]), connect(net, bus[2], bus[1]), connect(net, bus[1], bus[0])]
+    switch = [create_switch(net, bus[3], line[0], et="l", type="CB")]
+    load = [create_load(net, bus[0], p_mw=0.1, customers=5)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def two_sided_switches():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(4)]
+    grid = [create_ext_grid(net, bus[0])]
+    line = [connect(net, bus[position], bus[position + 1]) for position in range(3)]
+    switch = [create_switch(net, bus[0], line[0], et="l", type="CB"),
+              create_switch(net, bus[1], line[0], et="l", type="DS"),
+              create_switch(net, bus[1], line[1], et="l", type="DS"),
+              create_switch(net, bus[2], line[1], et="l", type="DS")]
+    load = [create_load(net, bus[position], p_mw=0.1, customers=10) for position in (1, 2, 3)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def parallel_lines():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(3)]
+    grid = [create_ext_grid(net, bus[0])]
+    line = [connect(net, bus[0], bus[1]), connect(net, bus[1], bus[2]), connect(net, bus[1], bus[2])]
+    switch = [create_switch(net, bus[0], line[0], et="l", type="CB"),
+              create_switch(net, bus[1], line[1], et="l", type="DS")]
+    load = [create_load(net, bus[2], p_mw=0.1, customers=10)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def switched_parallel_lines():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(3)]
+    grid = [create_ext_grid(net, bus[0])]
+    line = [connect(net, bus[0], bus[1]), connect(net, bus[1], bus[2]), connect(net, bus[1], bus[2])]
+    switch = [create_switch(net, bus[0], line[0], et="l", type="CB")]
+    for element in (line[1], line[2]):
+        switch.append(create_switch(net, bus[1], element, et="l", type="DS"))
+        switch.append(create_switch(net, bus[2], element, et="l", type="DS"))
+    load = [create_load(net, bus[2], p_mw=0.1, customers=10)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def ring_with_a_tie():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(5)]
+    grid = [create_ext_grid(net, bus[0])]
+    line = [connect(net, bus[0], bus[1]), connect(net, bus[1], bus[2]), connect(net, bus[1], bus[2]),
+            connect(net, bus[2], bus[3])]
+    switch = [create_switch(net, bus[0], line[0], et="l", type="CB"),
+              create_switch(net, bus[1], line[1], et="l", type="DS"),
+              create_switch(net, bus[2], line[3], et="l", type="DS")]
+    grid.append(create_ext_grid(net, bus[4]))
+    switch.append(create_switch(net, bus[3], bus[4], et="b", closed=False, type="LBS"))
+    load = [create_load(net, bus[3], p_mw=0.1, customers=10)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def two_grid_backup():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(4)]
+    grid = [create_ext_grid(net, bus[0])]
+    line = [connect(net, bus[0], bus[1]), connect(net, bus[1], bus[2])]
+    switch = [create_switch(net, bus[0], line[0], et="l", type="CB"),
+              create_switch(net, bus[1], line[1], et="l", type="DS")]
+    load = [create_load(net, bus[2], p_mw=0.1, customers=10)]
+    grid.append(create_ext_grid(net, bus[3]))
+    grid.append(create_ext_grid(net, bus[3]))
+    switch.append(create_switch(net, bus[2], bus[3], et="b", closed=False, type="LBS"))
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def sparse_indices():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0, index=index) for index in (50, 7, 23)]
+    grid = [create_ext_grid(net, bus[0], index=3)]
+    line = [create_line_from_parameters(net, bus[0], bus[1], length_km=1.0, r_ohm_per_km=0.1,
+                                        x_ohm_per_km=0.1, c_nf_per_km=0.0, max_i_ka=1.0, index=9),
+            create_line_from_parameters(net, bus[1], bus[2], length_km=1.0, r_ohm_per_km=0.1,
+                                        x_ohm_per_km=0.1, c_nf_per_km=0.0, max_i_ka=1.0, index=2)]
+    switch = [create_switch(net, bus[0], line[0], et="l", type="CB", index=4),
+              create_switch(net, bus[1], line[1], et="l", type="DS", index=8)]
+    load = [create_load(net, bus[2], p_mw=0.1, customers=10, index=6),
+            create_load(net, bus[1], p_mw=0.1, customers=10, index=1)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def substation():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0) for _ in range(3)]
+    grid = [create_ext_grid(net, bus[0])]
+    switch = [create_switch(net, bus[0], bus[1], et="b", type="CB")]
+    line = [connect(net, bus[1], bus[2])]
+    load = [create_load(net, bus[2], p_mw=0.1, customers=10)]
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load)
+
+
+def transformer_feeder():
+    net = create_empty_network()
+    bus = [create_bus(net, vn_kv=20.0), create_bus(net, vn_kv=0.4), create_bus(net, vn_kv=0.4)]
+    grid = [create_ext_grid(net, bus[0])]
+    trafo = [transform(net, bus[0], bus[1])]
+    line = [connect(net, bus[1], bus[2])]
+    switch = [create_switch(net, bus[0], trafo[0], et="t", type="CB")]
+    load = [create_load(net, bus[2], p_mw=0.1, customers=10)]
+    net.trafo["failure_rate_per_year"] = 0.02
+    net.trafo["repair_time_h"] = 20.0
+    return with_line_faults(net), SimpleNamespace(bus=bus, line=line, switch=switch, grid=grid,
+                                                  load=load, trafo=trafo)
+
+
+def rates(net):
+    return net.res_reliability_bus["interruption_rate_1_per_year"]
+
+
+def durations(net):
+    return net.res_reliability_bus["outage_duration_h_per_year"]
+
+
+def indices(net):
+    return net.res_reliability.iloc[0]
+
+
+def zones_of(net, handles, *positions):
+    zones = top.protection_zones(net)
+    return [zones.at[handles.bus[position]] for position in positions]
+
+
+def plan_maintenance(net, rate=0.5, time_h=2.0):
+    net.line["maintenance_rate_per_km_per_year"] = rate
+    net.line["maintenance_time_h"] = time_h
+
+
+def test_zones_split_at_a_closed_breaker():
+    net, h = feeder()
+    assert_array_equal(top.protection_zones(net).values, [0, 1, 1, 1, 2])
+
+
+def test_zones_ignore_a_disconnector():
+    net, h = feeder(breaker=False, tie=False)
+    assert_array_equal(top.protection_zones(net).values, [0, 0, 0, 0, 1])
+
+
+def test_a_closed_tie_puts_both_feeders_in_one_zone():
+    net, h = feeder()
+    net.switch.at[h.switch[2], "closed"] = True
+    assert_array_equal(top.protection_zones(net).values, [0, 1, 1, 1, 1])
+
+
+def test_zones_are_numbered_by_their_smallest_bus():
+    net, h = reversed_feeder()
+    assert_array_equal(top.protection_zones(net).values, [0, 0, 0, 1])
+
+
+def test_zones_index_lists_the_in_service_buses():
+    net, h = feeder()
+    net.bus.at[h.bus[2], "in_service"] = False
+    zones = top.protection_zones(net)
+    assert_array_equal(zones.index.values, [h.bus[0], h.bus[1], h.bus[3], h.bus[4]])
+    assert zones.at[h.bus[1]] != zones.at[h.bus[3]]
+
+
+def test_zones_split_at_a_breaker_between_two_buses():
+    net, h = substation()
+    assert_array_equal(top.protection_zones(net).values, [0, 1, 1])
+
+
+def test_zones_separate_a_bus_behind_an_out_of_service_line():
+    net, h = feeder(tie=False)
+    net.line.at[h.line[1], "in_service"] = False
+    first, second, third = zones_of(net, h, 1, 2, 3)
+    assert first != second
+    assert second == third
+
+
+def test_isolated_part_stops_at_switches_on_both_sides():
+    net, h = two_sided_switches()
+    assert_array_equal(top.isolated_buses(net, h.line[1]), [])
+    assert_array_equal(top.isolating_switches(net, h.line[1]), [h.switch[2], h.switch[3]])
+
+
+def test_isolated_part_reaches_past_a_line_without_switches():
+    net, h = two_sided_switches()
+    assert_array_equal(top.isolated_buses(net, h.line[2]), [h.bus[2], h.bus[3]])
+    assert_array_equal(top.isolating_switches(net, h.line[2]), [h.switch[3]])
+
+
+def test_isolated_part_reaches_past_the_open_end_of_a_line():
+    net, h = feeder()
+    assert_array_equal(top.isolated_buses(net, h.line[1]), [h.bus[2], h.bus[3]])
+    assert_array_equal(top.isolating_switches(net, h.line[1]), [h.switch[1], h.switch[2]])
+
+
+def test_isolated_part_of_the_first_line():
+    net, h = feeder()
+    assert_array_equal(top.isolated_buses(net, h.line[0]), [h.bus[1]])
+    assert_array_equal(top.isolating_switches(net, h.line[0]), [h.switch[0], h.switch[1]])
+
+
+def test_isolating_switches_leave_out_a_switch_inside_the_part():
+    net, h = parallel_lines()
+    assert_array_equal(top.isolated_buses(net, h.line[1]), [h.bus[1], h.bus[2]])
+    assert_array_equal(top.isolating_switches(net, h.line[1]), [h.switch[0]])
+
+
+def test_isolating_switches_of_a_ring_leave_out_the_inner_one():
+    net, h = ring_with_a_tie()
+    assert_array_equal(top.isolated_buses(net, h.line[1]), [h.bus[1], h.bus[2]])
+    assert_array_equal(top.isolating_switches(net, h.line[1]), [h.switch[0], h.switch[2]])
+
+
+def test_isolated_part_of_a_bus():
+    net, h = feeder()
+    assert_array_equal(top.isolated_buses(net, h.bus[2], et="b"), [h.bus[2], h.bus[3]])
+    assert_array_equal(top.isolating_switches(net, h.bus[2], et="b"), [h.switch[1], h.switch[2]])
+
+
+def test_isolated_part_of_a_transformer():
+    net, h = transformer_feeder()
+    assert_array_equal(top.isolated_buses(net, h.trafo[0], et="t"), [h.bus[1], h.bus[2]])
+    assert_array_equal(top.isolating_switches(net, h.trafo[0], et="t"), [h.switch[0]])
+
+
+def test_isolated_part_without_any_switch():
+    net, h = feeder(breaker=False, tie=False)
+    net.switch = net.switch.iloc[0:0]
+    assert_array_equal(top.isolated_buses(net, h.line[0]), h.bus[:4])
+    assert_array_equal(top.isolating_switches(net, h.line[0]), [])
+
+
+def test_restorable_buses_reach_the_second_source():
+    net, h = feeder()
+    assert_array_equal(top.restorable_buses(net, h.line[0]),
+                       [h.bus[0], h.bus[2], h.bus[3], h.bus[4]])
+
+
+def test_restorable_buses_without_a_second_source():
+    net, h = feeder(tie=False)
+    assert_array_equal(top.restorable_buses(net, h.line[0]), [h.bus[0]])
+
+
+def test_restorable_buses_of_a_transformer():
+    net, h = transformer_feeder()
+    assert_array_equal(top.restorable_buses(net, h.trafo[0], et="t"), [h.bus[0]])
+
+
+def test_restorable_buses_of_a_bus():
+    net, h = feeder()
+    assert_array_equal(top.restorable_buses(net, h.bus[2], et="b"),
+                       [h.bus[0], h.bus[1], h.bus[4]])
+
+
+def test_restorable_buses_ignore_the_transfer_limit():
+    net, h = feeder()
+    net.ext_grid.at[h.grid[1], "max_p_mw"] = 0.01
+    assert_array_equal(top.restorable_buses(net, h.line[0]),
+                       [h.bus[0], h.bus[2], h.bus[3], h.bus[4]])
+
+
+def test_returned_arrays_are_sorted_integers():
+    net, h = feeder()
+    isolated = top.isolated_buses(net, h.line[1])
+    switches = top.isolating_switches(net, h.line[1])
+    restorable = top.restorable_buses(net, h.line[1])
+    for returned in (isolated, switches, restorable):
+        assert isinstance(returned, np.ndarray)
+        assert np.issubdtype(returned.dtype, np.integer)
+        assert_array_equal(returned, np.sort(returned))
+    assert isinstance(top.protection_zones(net), pd.Series)
+
+
+def test_a_load_inside_the_isolated_part_waits_for_the_repair():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_allclose(durations(net).at[h.bus[2]], 0.1 * (0.5 + 5.0 + 5.0))
+
+
+def test_a_load_behind_the_fault_is_restored_by_switching():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_allclose(durations(net).at[h.bus[1]], 0.1 * (5.0 + 0.5 + 0.5))
+
+
+def test_a_load_without_a_restoration_path_waits_for_the_repair():
+    net, h = feeder(tie=False)
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_allclose(durations(net).at[h.bus[2]], 0.1 * (5.0 + 5.0 + 5.0))
+    assert_allclose(durations(net).at[h.bus[1]], 0.1 * (5.0 + 0.5 + 0.5))
+
+
+def test_a_load_outside_the_zone_is_not_affected():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_allclose(rates(net).at[h.bus[4]], 0.0)
+    assert_allclose(rates(net).at[h.bus[0]], 0.0)
+
+
+def test_the_whole_feeder_matches_the_hand_calculation():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_array_equal(net.res_reliability_bus.index.values, h.bus)
+    assert_allclose(rates(net).values, [0.0, 0.3, 0.3, 0.3, 0.0])
+    assert_allclose(durations(net).values, [0.0, 0.6, 1.05, 1.05, 0.0])
+
+
+def test_average_interruption_time_is_the_duration_over_the_rate():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    average = net.res_reliability_bus["average_interruption_time_h"]
+    assert_allclose(average.at[h.bus[1]], 2.0)
+    assert_allclose(average.at[h.bus[2]], 3.5)
+
+
+def test_average_interruption_time_without_an_interruption_is_nan():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net)
+    assert np.isnan(net.res_reliability_bus["average_interruption_time_h"].at[h.bus[0]])
+
+
+def test_a_restored_load_still_counts_as_interrupted():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_allclose(rates(net).at[h.bus[1]], 0.3)
+
+
+def test_the_rate_adds_up_every_element_that_interrupts_a_bus():
+    net, h = feeder(tie=False)
+    net.line.at[h.line[2], "failure_rate_per_km_per_year"] = 0.4
+    pp.reliability.calc_reliability(net)
+    assert_allclose(rates(net).at[h.bus[3]], 0.1 + 0.1 + 0.4)
+    assert_allclose(rates(net).at[h.bus[1]], 0.1 + 0.1 + 0.4)
+
+
+def test_a_longer_line_fails_more_often():
+    net, h = feeder(tie=False)
+    net.line.at[h.line[0], "length_km"] = 4.0
+    pp.reliability.calc_reliability(net)
+    assert_allclose(rates(net).at[h.bus[1]], 0.4 + 0.1 + 0.1)
+
+
+def test_load_results_follow_the_bus_they_sit_on():
+    net, h = feeder()
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_array_equal(net.res_reliability_load.index.values, h.load)
+    assert_allclose(net.res_reliability_load["outage_duration_h_per_year"].values,
+                    [0.6, 1.05, 1.05])
+    assert_allclose(net.res_reliability_load["energy_not_supplied_mwh_per_year"].values,
+                    [0.06, 0.105, 0.105])
+
+
+def test_load_average_interruption_time_follows_its_bus():
+    net, h = feeder()
+    create_load(net, h.bus[4], p_mw=0.1, customers=10)
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    average = net.res_reliability_load["average_interruption_time_h"]
+    assert_allclose(average.values[:3], [2.0, 3.5, 3.5])
+    assert np.isnan(average.values[3])
+    assert_allclose(net.res_reliability_load["interruption_rate_1_per_year"].values[3], 0.0)
+
+
+def test_two_loads_on_one_bus_share_its_indices():
+    net, h = feeder()
+    second = create_load(net, h.bus[1], p_mw=0.2, customers=5)
+    pp.reliability.calc_reliability(net, switching_time_h=0.5)
+    assert_allclose(net.res_reliability_load["outage_duration_h_per_year"].at[second], 0.6)
+    assert_allclose(net.res_reliability_load["energy_not_supplied_mwh_per_year"].at[second], 0.12)
+
+
+def test_an_out_of_service_load_is_left_out():
+    net, h = feeder()
+    net.load.at[h.load[1], "in_service"] = False
+    pp.reliability.calc_reliability(net)
+    assert_array_equal(net.res_reliability_load.index.values, [h.load[0], h.load[2]])
+
+
