diff --git a/pandapower/reliability/run_reliability.py b/pandapower/reliability/run_reliability.py
new file mode 100644
index 0000000..a50c930
--- /dev/null
+++ b/pandapower/reliability/run_reliability.py
@@ -0,0 +1,294 @@
+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2016-2026 by University of Kassel and Fraunhofer Institute for Energy Economics
+# and Energy System Technology (IEE), Kassel. All rights reserved.
+
+import numpy as np
+import pandas as pd
+
+from pandapower.results import reset_results
+from pandapower.topology.incidence import SwitchIncidence
+
+HOURS_PER_YEAR = 8760.0
+
+FAULT_PARAMETERS = {
+    "l": ("line", "failure_rate_per_km_per_year", "repair_time_h"),
+    "t": ("trafo", "failure_rate_per_year", "repair_time_h"),
+    "b": ("bus", "failure_rate_per_year", "repair_time_h"),
+}
+
+MAINTENANCE_PARAMETERS = {
+    "l": ("line", "maintenance_rate_per_km_per_year", "maintenance_time_h"),
+    "t": ("trafo", "maintenance_rate_per_year", "maintenance_time_h"),
+    "b": ("bus", "maintenance_rate_per_year", "maintenance_time_h"),
+}
+
+BUS_RESULT_COLUMNS = ["interruption_rate_1_per_year", "outage_duration_h_per_year",
+                      "average_interruption_time_h"]
+
+LOAD_RESULT_COLUMNS = BUS_RESULT_COLUMNS + ["energy_not_supplied_mwh_per_year",
+                                            "interruption_cost_eur_per_year"]
+
+SYSTEM_RESULT_COLUMNS = ["saifi_1_per_year", "saidi_h_per_year", "caidi_h", "asai",
+                         "ens_mwh_per_year", "aens_mwh_per_year", "ecost_eur_per_year"]
+
+ELEMENT_RESULT_COLUMNS = ["et", "element", "kind", "rate_1_per_year", "saifi_1_per_year",
+                          "saidi_h_per_year", "ens_mwh_per_year"]
+
+
+def _numeric(table, name):
+    if name not in table.columns:
+        return np.full(len(table), np.nan)
+    return pd.to_numeric(table[name], errors="coerce").values.astype(np.float64)
+
+
+def _column(table, name):
+    return np.nan_to_num(_numeric(table, name), nan=0.0)
+
+
+def _collect_events(net, parameters):
+    events = []
+    for et, (table_name, rate_column, time_column) in parameters.items():
+        table = net[table_name]
+        if not len(table):
+            continue
+        rates = _column(table, rate_column)
+        times = _column(table, time_column)
+        if et == "l":
+            rates = rates * _column(table, "length_km")
+        in_service = table.in_service.values.astype(bool)
+        for position, index in enumerate(table.index.values):
+            if not in_service[position] or rates[position] <= 0:
+                continue
+            events.append((et, int(index), float(rates[position]), float(times[position])))
+    return events
+
+
+def _remote_controlled(net):
+    if "remote_controlled" not in net.switch.columns:
+        return {}
+    values = net.switch["remote_controlled"].values
+    return {int(index): bool(values[position]) if values[position] == values[position] else False
+            for position, index in enumerate(net.switch.index.values)}
+
+
+def _supplied_bus_nodes(incidence):
+    supply = incidence.supply_nodes()
+    if not supply:
+        raise UserWarning("reliability assessment needs at least one in service external grid")
+    energized = incidence.energized()
+    roots = set(energized[node] for node in supply)
+    return [node for node in incidence.bus_nodes() if energized[node] in roots]
+
+
+def _switching_duration(incidence, section, remote, switching_time_h, remote_switching_time_h):
+    opened = [int(switch) for switch in incidence.border_switches(section)
+              if not incidence.is_open(switch)]
+    if len(opened) and all(remote.get(switch, False) for switch in opened):
+        return remote_switching_time_h
+    return switching_time_h
+
+
+def _bus_demand(net, incidence):
+    demand = {}
+    loads = net.load[net.load.in_service.values.astype(bool)]
+    power = loads.p_mw.values.astype(np.float64)
+    for position, bus in enumerate(loads.bus.values.astype(np.int64)):
+        node = incidence.bus_node(int(bus))
+        if node is not None:
+            demand[node] = demand.get(node, 0.0) + float(power[position])
+    return demand
+
+
+def _bus_capacity(net, incidence):
+    capacity = {}
+    grids = net.ext_grid[net.ext_grid.in_service.values.astype(bool)]
+    limits = _numeric(grids, "max_p_mw")
+    for position, bus in enumerate(grids.bus.values.astype(np.int64)):
+        node = incidence.bus_node(int(bus))
+        if node is None:
+            continue
+        limit = limits[position]
+        capacity[node] = capacity.get(node, 0.0) + (np.inf if np.isnan(limit) else float(limit))
+    return capacity
+
+
+def _reconnectable(incidence, section, demand, capacity):
+    reconnectable = set()
+    for part in incidence.reconnectable_parts(section):
+        available = sum(capacity.get(node, 0.0) for node in part)
+        needed = sum(demand.get(node, 0.0) for node in part)
+        if needed <= available:
+            reconnectable.update(part)
+    return reconnectable
+
+
+def _fault_durations(incidence, node, supplied, reconnectable, repair_time_h, switching_time_h):
+    zones = incidence.zones()
+    section = incidence.part(incidence.sections(), node)
+    durations = {}
+    for bus_node in supplied:
+        if zones[bus_node] != zones[node]:
+            continue
+        if bus_node in section or bus_node not in reconnectable:
+            durations[bus_node] = repair_time_h
+        else:
+            durations[bus_node] = switching_time_h
+    return durations
+
+
+def _maintenance_durations(incidence, node, supplied, reconnectable, maintenance_time_h):
+    section = incidence.part(incidence.sections(), node)
+    durations = {}
+    for bus_node in supplied:
+        if bus_node in section or bus_node not in reconnectable:
+            durations[bus_node] = maintenance_time_h
+    return durations
+
+
+def _bus_results(incidence, supplied, rates, durations):
+    buses = np.array([incidence.bus_index(node) for node in supplied], dtype=np.int64)
+    rate = np.array([rates[node] for node in supplied], dtype=np.float64)
+    duration = np.array([durations[node] for node in supplied], dtype=np.float64)
+    average = np.divide(duration, rate, out=np.full(len(rate), np.nan), where=rate > 0)
+    return pd.DataFrame({BUS_RESULT_COLUMNS[0]: rate,
+                         BUS_RESULT_COLUMNS[1]: duration,
+                         BUS_RESULT_COLUMNS[2]: average},
+                        index=pd.Index(buses, dtype=np.int64))
+
+
+def _load_results(net, res_bus):
+    loads = net.load[net.load.in_service.values.astype(bool)]
+    loads = loads[np.isin(loads.bus.values, res_bus.index.values)]
+    buses = loads.bus.values.astype(np.int64)
+    rate = res_bus[BUS_RESULT_COLUMNS[0]].loc[buses].values
+    duration = res_bus[BUS_RESULT_COLUMNS[1]].loc[buses].values
+    average = res_bus[BUS_RESULT_COLUMNS[2]].loc[buses].values
+    energy = duration * loads.p_mw.values.astype(np.float64)
+    cost = energy * _column(loads, "interruption_cost_eur_per_mwh")
+    return pd.DataFrame({LOAD_RESULT_COLUMNS[0]: rate,
+                         LOAD_RESULT_COLUMNS[1]: duration,
+                         LOAD_RESULT_COLUMNS[2]: average,
+                         LOAD_RESULT_COLUMNS[3]: energy,
+                         LOAD_RESULT_COLUMNS[4]: cost},
+                        index=pd.Index(loads.index.values, dtype=np.int64))
+
+
+def _system_indices(res_load, customers):
+    rate = res_load[LOAD_RESULT_COLUMNS[0]].values
+    duration = res_load[LOAD_RESULT_COLUMNS[1]].values
+    total = float(customers.sum())
+    energy = float(res_load[LOAD_RESULT_COLUMNS[3]].values.sum())
+    cost = float(res_load[LOAD_RESULT_COLUMNS[4]].values.sum())
+    if total > 0:
+        saifi = float((rate * customers).sum()) / total
+        saidi = float((duration * customers).sum()) / total
+        caidi = saidi / saifi if saifi > 0 else np.nan
+        asai = (HOURS_PER_YEAR - saidi) / HOURS_PER_YEAR
+        aens = energy / total
+    else:
+        saifi = saidi = caidi = asai = aens = np.nan
+    values = [saifi, saidi, caidi, asai, energy, aens, cost]
+    return pd.DataFrame(dict(zip(SYSTEM_RESULT_COLUMNS, [[value] for value in values])),
+                        index=pd.Index([0], dtype=np.int64))
+
+
+def _weights_per_bus(net, incidence, supplied, res_load, customers):
+    customers_at = dict.fromkeys(supplied, 0.0)
+    power_at = dict.fromkeys(supplied, 0.0)
+    node_of = {incidence.bus_index(node): node for node in supplied}
+    loads = net.load.loc[res_load.index]
+    power = loads.p_mw.values.astype(np.float64)
+    for position, bus in enumerate(loads.bus.values.astype(np.int64)):
+        node = node_of[int(bus)]
+        customers_at[node] += float(customers[position])
+        power_at[node] += float(power[position])
+    return customers_at, power_at
+
+
+def _element_results(events, customers_at, power_at, total_customers):
+    rows = []
+    for kind, et, element, rate, durations in events:
+        interrupted = sum(customers_at[node] for node in durations)
+        weighted = sum(customers_at[node] * duration for node, duration in durations.items())
+        energy = sum(power_at[node] * duration for node, duration in durations.items())
+        rows.append({ELEMENT_RESULT_COLUMNS[0]: et,
+                     ELEMENT_RESULT_COLUMNS[1]: element,
+                     ELEMENT_RESULT_COLUMNS[2]: kind,
+                     ELEMENT_RESULT_COLUMNS[3]: rate,
+                     ELEMENT_RESULT_COLUMNS[4]: rate * interrupted / total_customers
+                     if total_customers > 0 else np.nan,
+                     ELEMENT_RESULT_COLUMNS[5]: rate * weighted / total_customers
+                     if total_customers > 0 else np.nan,
+                     ELEMENT_RESULT_COLUMNS[6]: rate * energy})
+    res = pd.DataFrame(rows, columns=ELEMENT_RESULT_COLUMNS)
+    res = res.sort_values(by=[ELEMENT_RESULT_COLUMNS[5], ELEMENT_RESULT_COLUMNS[0],
+                              ELEMENT_RESULT_COLUMNS[1], ELEMENT_RESULT_COLUMNS[2]],
+                          ascending=[False, True, True, True], kind="stable")
+    return res.reset_index(drop=True)
+
+
+def calc_reliability(net, switching_time_h=1.0, remote_switching_time_h=0.05):
+    """
+    Calculates how often and for how long the loads of a network lose supply.
+
+    Every line, transformer and bus that carries a failure rate is taken out of the network once.
+    The part of the network reachable from it without passing a closed circuit breaker or an open
+    switch loses supply, the part reachable from it without passing any switch at all is isolated,
+    and every bus that reaches an external grid again once the isolated part is removed is
+    reconnected after the switching time. The results are written into net.res_reliability_bus,
+    net.res_reliability_load, net.res_reliability_element and net.res_reliability.
+
+    Parameters:
+        net (pandapowerNet): variable that contains a pandapower network
+        switching_time_h (float, 1.0): time until a bus is reconnected by switching
+        remote_switching_time_h (float, 0.05): the same time if every switch that has to be
+            opened to isolate the failed element is remote controlled
+
+    Example:
+        >>> from pandapower.reliability import calc_reliability
+        >>> calc_reliability(net)
+    """
+    reset_results(net, "rel")
+    incidence = SwitchIncidence(net)
+    supplied = _supplied_bus_nodes(incidence)
+    remote = _remote_controlled(net)
+    rates = dict.fromkeys(supplied, 0.0)
+    durations = dict.fromkeys(supplied, 0.0)
+    events = []
+
+    demand = _bus_demand(net, incidence)
+    capacity = _bus_capacity(net, incidence)
+
+    for et, element, rate, repair_time_h in _collect_events(net, FAULT_PARAMETERS):
+        node = incidence.node(et, element)
+        section = incidence.part(incidence.sections(), node)
+        reconnectable = _reconnectable(incidence, section, demand, capacity)
+        time_h = _switching_duration(incidence, section, remote, switching_time_h,
+                                     remote_switching_time_h)
+        events.append(("fault", et, element, rate,
+                       _fault_durations(incidence, node, supplied, reconnectable, repair_time_h,
+                                        time_h)))
+
+    for et, element, rate, maintenance_time_h in _collect_events(net, MAINTENANCE_PARAMETERS):
+        node = incidence.node(et, element)
+        section = incidence.part(incidence.sections(), node)
+        reconnectable = _reconnectable(incidence, section, demand, capacity)
+        events.append(("maintenance", et, element, rate,
+                       _maintenance_durations(incidence, node, supplied, reconnectable,
+                                              maintenance_time_h)))
+
+    for _, _, _, rate, contribution in events:
+        for bus_node, duration in contribution.items():
+            rates[bus_node] += rate
+            durations[bus_node] += rate * duration
+
+    res_bus = _bus_results(incidence, supplied, rates, durations)
+    res_load = _load_results(net, res_bus)
+    customers = _column(net.load.loc[res_load.index], "customers")
+    customers_at, power_at = _weights_per_bus(net, incidence, supplied, res_load, customers)
+    net["res_reliability_bus"] = res_bus
+    net["res_reliability_load"] = res_load
+    net["res_reliability_element"] = _element_results(events, customers_at, power_at,
+                                                      float(customers.sum()))
+    net["res_reliability"] = _system_indices(res_load, customers)
