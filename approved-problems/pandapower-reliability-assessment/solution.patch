+def protection_zones(net, incidence=None):
+    """
+    Splits the in service buses of a network into the parts that a fault de-energizes. Two buses
+    belong to the same zone if one is reachable from the other without passing a closed circuit
+    breaker or an open switch.
+
+    Parameters:
+        net (pandapowerNet): variable that contains a pandapower network
+        incidence (SwitchIncidence, None): a prebuilt incidence graph of the network
+
+    Returns:
+        A pandas Series of the zone number of every in service bus, the zones being numbered
+        from zero in ascending order of their smallest bus
+
+    Example:
+        >>> from pandapower.topology.graph_searches import protection_zones
+        >>> zones = protection_zones(net)
+    """
+    incidence = incidence or SwitchIncidence(net)
+    labels = incidence.zones()
+    nodes = incidence.bus_nodes()
+    buses = incidence.buses(set(nodes))
+    numbers = {}
+    zones = []
+    for node in nodes:
+        label = labels[node]
+        if label not in numbers:
+            numbers[label] = len(numbers)
+        zones.append(numbers[label])
+    return pd.Series(zones, index=pd.Index(buses, name="bus"), dtype=np.int64)
+
+
+def isolated_buses(net, element, et="l", incidence=None):
+    """
+    Finds the buses that are separated from the rest of the network together with an element
+    when it is isolated, which are the buses reachable from it without passing any switch.
+
+    Parameters:
+        net (pandapowerNet): variable that contains a pandapower network
+        element (int): index of the element
+        et (str, "l"): element type, using the codes of net.switch.et with "b" for a bus
+        incidence (SwitchIncidence, None): a prebuilt incidence graph of the network
+
+    Returns:
+        A numpy array of the bus indices inside the isolated part, sorted ascending
+
+    Example:
+        >>> from pandapower.topology.graph_searches import isolated_buses
+        >>> isolated_buses(net, 3, et="l")
+    """
+    incidence = incidence or SwitchIncidence(net)
+    node = incidence.node(et, element)
+    return incidence.buses(incidence.part(incidence.sections(), node))
+
+
+def isolating_switches(net, element, et="l", incidence=None):
+    """
+    Finds the switches that have to be opened to isolate an element, which are the switches on
+    the border of the part reachable from it without passing any switch.
+
+    Parameters:
+        net (pandapowerNet): variable that contains a pandapower network
+        element (int): index of the element
+        et (str, "l"): element type, using the codes of net.switch.et with "b" for a bus
+        incidence (SwitchIncidence, None): a prebuilt incidence graph of the network
+
+    Returns:
+        A numpy array of switch indices, sorted ascending
+
+    Example:
+        >>> from pandapower.topology.graph_searches import isolating_switches
+        >>> isolating_switches(net, 3, et="l")
+    """
+    incidence = incidence or SwitchIncidence(net)
+    node = incidence.node(et, element)
+    return incidence.border_switches(incidence.part(incidence.sections(), node))
+
+
+def restorable_buses(net, element, et="l", incidence=None):
+    """
+    Finds the buses that still reach an external grid once an element is isolated and every
+    remaining switch may be closed, including the ones that are connected anyway.
+
+    Parameters:
+        net (pandapowerNet): variable that contains a pandapower network
+        element (int): index of the element
+        et (str, "l"): element type, using the codes of net.switch.et with "b" for a bus
+        incidence (SwitchIncidence, None): a prebuilt incidence graph of the network
+
+    Returns:
+        A numpy array of bus indices, sorted ascending
+
+    Example:
+        >>> from pandapower.topology.graph_searches import restorable_buses
+        >>> restorable_buses(net, 3, et="l")
+    """
+    incidence = incidence or SwitchIncidence(net)
+    node = incidence.node(et, element)
+    section = incidence.part(incidence.sections(), node)
+    return incidence.buses(incidence.reconnectable(section))
