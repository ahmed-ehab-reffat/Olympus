@@ -0,0 +1,249 @@
+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2016-2026 by University of Kassel and Fraunhofer Institute for Energy Economics
+# and Energy System Technology (IEE), Kassel. All rights reserved.
+
+import numpy as np
+
+BRANCH_TERMINALS = {
+    "l": ("line", ("from_bus", "to_bus")),
+    "t": ("trafo", ("hv_bus", "lv_bus")),
+    "t3": ("trafo3w", ("hv_bus", "mv_bus", "lv_bus")),
+    "i": ("impedance", ("from_bus", "to_bus")),
+}
+
+SWITCH_ELEMENT_TYPES = ("l", "t", "t3")
+
+
+class SwitchIncidence:
+    """
+    Bus and branch elements of a network as nodes of a graph whose edges are the single
+    connections between them. Every switch sits on exactly one of those edges: a bus-element
+    switch on the connection between the element and one of its buses, a bus-bus switch on the
+    connection between the two buses. Opening a switch therefore removes one connection instead
+    of a whole element, which is what separates the part of a network that a switch can isolate
+    from the part that is reachable around it.
+
+    Parameters:
+        net (pandapowerNet): variable that contains a pandapower network
+    """
+
+    def __init__(self, net):
+        self.net = net
+        self._index = {}
+        self._nodes = []
+        self._edges = []
+        self._labels = {}
+        self._closed = net.switch.closed.values.astype(bool) if len(net.switch) else np.array([], dtype=bool)
+        self._breaker = self._breaker_mask()
+        self._switch_position = {}
+        self._build()
+
+    def _breaker_mask(self):
+        if not len(self.net.switch):
+            return np.array([], dtype=bool)
+        types = self.net.switch.type.values
+        return np.array([str(t) == "CB" for t in types], dtype=bool)
+
+    def _node(self, et, element):
+        key = (et, int(element))
+        node = self._index.get(key)
+        if node is None:
+            node = len(self._nodes)
+            self._index[key] = node
+            self._nodes.append(key)
+        return node
+
+    def node(self, et, element):
+        """Returns the node of an element, raising if it is not part of the network."""
+        key = (et, int(element))
+        if key not in self._index:
+            raise UserWarning("element %s of type %s is not part of the network" % (element, et))
+        return self._index[key]
+
+    def _switch_lookup(self):
+        lookup = {}
+        net = self.net
+        if not len(net.switch):
+            return lookup
+        for position, index in enumerate(net.switch.index.values):
+            et = net.switch.et.values[position]
+            bus = int(net.switch.bus.values[position])
+            element = int(net.switch.element.values[position])
+            self._switch_position[int(index)] = position
+            if et == "b":
+                lookup.setdefault(("b", element, bus), []).append(int(index))
+            elif et in SWITCH_ELEMENT_TYPES:
+                lookup.setdefault((et, element, bus), []).append(int(index))
+        return lookup
+
+    def _build(self):
+        net = self.net
+        in_service = set(int(b) for b in net.bus.index.values[net.bus.in_service.values.astype(bool)])
+        for bus in sorted(in_service):
+            self._node("b", bus)
+        switches = self._switch_lookup()
+        for et, (table_name, terminals) in BRANCH_TERMINALS.items():
+            table = net[table_name]
+            if not len(table):
+                continue
+            element_in_service = table.in_service.values.astype(bool)
+            buses = [table[terminal].values for terminal in terminals]
+            for position, index in enumerate(table.index.values):
+                if not element_in_service[position]:
+                    continue
+                element = int(index)
+                node = self._node(et, element)
+                for terminal in buses:
+                    bus = int(terminal[position])
+                    if bus not in in_service:
+                        continue
+                    self._edges.append((node, self._node("b", bus), switches.get((et, element, bus), [])))
+        for (et, element, bus), indices in switches.items():
+            if et != "b":
+                continue
+            if bus not in in_service or element not in in_service:
+                continue
+            for index in indices:
+                self._edges.append((self._node("b", bus), self._node("b", element), [index]))
+
+    def is_open(self, switch):
+        """Returns whether a switch is open."""
+        return not bool(self._closed[self._switch_position[int(switch)]])
+
+    def is_breaker(self, switch):
+        """Returns whether a switch is a circuit breaker."""
+        return bool(self._breaker[self._switch_position[int(switch)]])
+
+    def _cut_switched(self, switches):
+        return len(switches) > 0
+
+    def _cut_breakers(self, switches):
+        return any(self.is_open(switch) or self.is_breaker(switch) for switch in switches)
+
+    def _cut_open(self, switches):
+        return any(self.is_open(switch) for switch in switches)
+
+    def _cut_nothing(self, switches):
+        return False
+
+    def components(self, cut, exclude=None):
+        """
+        Labels every node with the smallest node of the part of the network it is connected to.
+
+        Parameters:
+            cut (callable): decides for the switches on a connection whether it is separated
+            exclude (set, None): nodes that are removed from the network before the search
+
+        Returns:
+            A numpy array with one label per node
+        """
+        exclude = exclude or set()
+        parent = np.arange(len(self._nodes))
+
+        def root(node):
+            while parent[node] != node:
+                parent[node] = parent[parent[node]]
+                node = parent[node]
+            return node
+
+        for left, right, switches in self._edges:
+            if left in exclude or right in exclude:
+                continue
+            if cut(switches):
+                continue
+            left_root, right_root = root(left), root(right)
+            if left_root != right_root:
+                if left_root < right_root:
+                    parent[right_root] = left_root
+                else:
+                    parent[left_root] = right_root
+        return np.array([root(node) for node in range(len(self._nodes))])
+
+    def _cached(self, name, cut):
+        if name not in self._labels:
+            self._labels[name] = self.components(cut)
+        return self._labels[name]
+
+    def sections(self):
+        """Labels reached without passing any switch at all."""
+        return self._cached("sections", self._cut_switched)
+
+    def zones(self):
+        """Labels reached without passing a closed circuit breaker or an open switch."""
+        return self._cached("zones", self._cut_breakers)
+
+    def energized(self):
+        """Labels reached in the switching state the network is in."""
+        return self._cached("energized", self._cut_open)
+
+    def part(self, labels, node):
+        """Returns the nodes carrying the same label as the given node."""
+        return set(np.flatnonzero(labels == labels[node]).tolist())
+
+    def border_switches(self, nodes):
+        """
+        Returns the switches that have to be opened to separate a set of nodes from the rest of
+        the network, which are the switches on a connection with exactly one end inside it.
+        """
+        border = set()
+        for left, right, switches in self._edges:
+            if (left in nodes) == (right in nodes):
+                continue
+            border.update(switches)
+        return np.array(sorted(border), dtype=np.int64)
+
+    def bus_node(self, bus):
+        """Returns the node of a bus, or None if the bus is not in service."""
+        return self._index.get(("b", int(bus)))
+
+    def bus_index(self, node):
+        """Returns the bus a node stands for."""
+        et, element = self._nodes[node]
+        if et != "b":
+            raise UserWarning("node %s is not a bus" % node)
+        return element
+
+    def buses(self, nodes):
+        """Returns the bus indices among a set of nodes, sorted ascending."""
+        found = [element for et, element in (self._nodes[node] for node in nodes) if et == "b"]
+        return np.array(sorted(found), dtype=np.int64)
+
+    def bus_nodes(self):
+        """Returns the nodes that are buses, ordered by bus index."""
+        return [self._index[("b", bus)] for bus in sorted(bus for et, bus in self._nodes if et == "b")]
+
+    def supply_nodes(self):
+        """Returns the nodes of the buses that carry an in service external grid."""
+        net = self.net
+        if not len(net.ext_grid):
+            return set()
+        supplying = net.ext_grid.bus.values[net.ext_grid.in_service.values.astype(bool)]
+        return set(self._index[("b", int(bus))] for bus in supplying if ("b", int(bus)) in self._index)
+
+    def reconnectable_parts(self, removed):
+        """
+        Returns the parts of the network that hold a supply point once a part of it is removed
+        and every remaining switch may be closed, ordered by their smallest node.
+        """
+        supply = self.supply_nodes() - removed
+        if not supply:
+            return []
+        labels = self.components(self._cut_nothing, exclude=removed)
+        roots = sorted(set(labels[node] for node in supply))
+        parts = {root: set() for root in roots}
+        for node in range(len(self._nodes)):
+            if node in removed or labels[node] not in parts:
+                continue
+            parts[labels[node]].add(node)
+        return [parts[root] for root in roots]
+
+    def reconnectable(self, removed):
+        """
+        Returns the nodes that reach a supply point once a part of the network is removed and
+        every remaining switch may be closed.
+        """
+        reconnectable = set()
+        for part in self.reconnectable_parts(removed):
+            reconnectable.update(part)
+        return reconnectable
