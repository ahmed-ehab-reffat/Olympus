+        return delete_attdef(self, tag)
+
+    def reorder_attdefs(self, tags: Sequence[str]) -> AttribSyncReport:
+        """Rearranges the :class:`~ezdxf.entities.AttDef` entities in the order of
+        `tags` and applies the new order to the :class:`~ezdxf.entities.Attrib`
+        entities of every block reference in the document.
+
+        Raises:
+            DXFValueError: `tags` does not contain the tag of every ATTDEF entity
