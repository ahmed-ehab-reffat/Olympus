+def test_definition_turned_constant_removes_the_attrib(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    block.sync_attribs()
+    block.get_attdef("NAME").is_const = True
+
+    report = block.sync_attribs()
+
+    assert tags_of(insert) == []
+    assert report.removed == 1
+    assert bool(block.block.dxf.flags & const.BLK_NON_CONSTANT_ATTRIBUTES) is False
+
+
+def test_definition_turned_back_non_constant_recreates_the_attrib(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    block.sync_attribs()
+    insert.attribs[0].dxf.text = "edited"
+    block.get_attdef("NAME").is_const = True
+    block.sync_attribs()
+    block.get_attdef("NAME").is_const = False
+
+    report = block.sync_attribs()
+
+    assert values_of(insert) == ["NAME-default"]
+    assert report.added == 1
+    assert bool(block.block.dxf.flags & const.BLK_NON_CONSTANT_ATTRIBUTES) is True
+    assert block.sync_attribs().changed is False
