+def test_attrib_becomes_multiline_when_its_definition_does(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.sync_attribs()
+    insert.attribs[0].dxf.text = "user value"
+    mtext = MText.new(dxfattribs={"insert": (0, 0), "char_height": 0.5})
+    mtext.text = "new default"
+    block.get_attdef("NAME").set_mtext(mtext)
+
+    report = insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.has_embedded_mtext_entity is True
+    assert attrib.dxf.text == "user value"
+    assert attrib.virtual_mtext_entity().text == "user value"
+    assert report.updated == 1
+    assert insert.sync_attribs().changed is False
+
+
+def test_attrib_becomes_single_line_when_its_definition_does(doc):
+    block = doc.blocks.new("ML")
+    attdef = block.add_attdef("TEXT", (0, 0), text="default")
+    mtext = MText.new(dxfattribs={"insert": (0, 0), "char_height": 0.5})
+    mtext.text = "default"
+    attdef.set_mtext(mtext)
+    insert = doc.modelspace().add_blockref("ML", (0, 0))
+    insert.sync_attribs()
+    content = insert.attribs[0].virtual_mtext_entity()
+    content.text = "user value"
+    insert.attribs[0].set_mtext(content)
+    attdef.discard_mtext()
+
+    insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.has_embedded_mtext_entity is False
+    assert attrib.dxf.text == "user value"
+    assert insert.sync_attribs().changed is False
+
