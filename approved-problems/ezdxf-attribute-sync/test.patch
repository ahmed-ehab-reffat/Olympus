+# Copyright (c) 2026, Manfred Moitzi
+# License: MIT License
+from typing import Iterable, Optional
+
+import io
+import pytest
+
+import ezdxf
+from ezdxf.entities import Attrib, MText
+from ezdxf.lldxf import const
+from ezdxf.lldxf.const import DXFKeyError, DXFValueError
+from ezdxf.math import Vec3
+
+
+def new_doc():
+    return ezdxf.new("R2018", setup=False)
+
+
+def add_block(doc, name="FLAG", tags: Iterable[str] = ("NAME",), **kwargs):
+    block = doc.blocks.new(name)
+    block.add_line((0, 0), (0, 5))
+    for index, tag in enumerate(tags):
+        block.add_attdef(
+            tag, (1, index), text=f"{tag}-default", dxfattribs=dict(kwargs)
+        )
+    return block
+
+
+def tags_of(insert) -> list[str]:
+    return [attrib.dxf.get("tag", "") for attrib in insert.attribs]
+
+
+def values_of(insert) -> list[str]:
+    return [attrib.dxf.get("text", "") for attrib in insert.attribs]
+
+
+def placement_of(attrib: Attrib) -> tuple:
+    dxf = attrib.dxf
+    return (
+        Vec3(dxf.get_default("insert")).round(9),
+        Vec3(dxf.get_default("align_point")).round(9),
+        Vec3(dxf.get_default("extrusion")).round(9),
+        round(dxf.get_default("rotation"), 9),
+        round(dxf.get_default("height"), 9),
+        round(dxf.get_default("width"), 9),
+        round(dxf.get_default("oblique"), 9),
+        dxf.get_default("halign"),
+        dxf.get_default("valign"),
+        dxf.get_default("text_generation_flag"),
+        dxf.get_default("style"),
+        dxf.get_default("layer"),
+    )
+
+
+def export(doc) -> str:
+    previous = ezdxf.options.write_fixed_meta_data_for_testing
+    ezdxf.options.write_fixed_meta_data_for_testing = True
+    try:
+        stream = io.StringIO()
+        doc.write(stream)
+        return stream.getvalue()
+    finally:
+        ezdxf.options.write_fixed_meta_data_for_testing = previous
+
+
+def fresh_reference(doc, name, values: Optional[dict] = None, **dxfattribs):
+    insert = doc.modelspace().add_blockref(name, (0, 0), dxfattribs=dxfattribs)
+    insert.add_auto_attribs(values or {})
+    return insert
+
+
+@pytest.fixture
+def doc():
+    return new_doc()
+
+
+def test_sync_adds_an_attrib_for_each_definition(doc):
+    add_block(doc, tags=("ONE", "TWO"))
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+
+    insert.sync_attribs()
+
+    assert tags_of(insert) == ["ONE", "TWO"]
+
+
+def test_added_attrib_carries_the_default_text(doc):
+    add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+
+    insert.sync_attribs()
+
+    assert values_of(insert) == ["NAME-default"]
+
+
+def test_attribs_follow_the_order_of_the_definitions(doc):
+    add_block(doc, tags=("A", "B", "C"))
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.add_attrib("C", "c")
+    insert.add_attrib("A", "a")
+
+    insert.sync_attribs()
+
+    assert tags_of(insert) == ["A", "B", "C"]
+
+
+def test_constant_definition_gets_no_attrib(doc):
+    block = add_block(doc, tags=("PLAIN", "FIXED"))
+    block.get_attdef("FIXED").is_const = True
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+
+    insert.sync_attribs()
+
+    assert tags_of(insert) == ["PLAIN"]
+
+
+def test_attrib_of_a_constant_definition_is_removed(doc):
+    block = add_block(doc, tags=("PLAIN", "FIXED"))
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.sync_attribs()
+    block.get_attdef("FIXED").is_const = True
+
+    insert.sync_attribs()
+
+    assert tags_of(insert) == ["PLAIN"]
+
+
+def test_definition_without_tag_is_ignored(doc):
+    block = add_block(doc, tags=("NAME",))
+    attdef = block.add_attdef("NOTAG", (2, 2))
+    attdef.dxf.discard("tag")
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+
+    insert.sync_attribs()
+
+    assert tags_of(insert) == ["NAME"]
+
+
+def test_content_text_of_an_existing_attrib_is_preserved(doc):
+    add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.add_attrib("NAME", "edited by the user")
+
+    insert.sync_attribs()
+
+    assert values_of(insert) == ["edited by the user"]
+
+
+def test_a_new_default_does_not_overwrite_an_edited_attrib(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.sync_attribs()
+    insert.attribs[0].dxf.text = "user edit"
+    attdef = block.get_attdef("NAME")
+    attdef.dxf.text = "new default"
+    attdef.dxf.layer = "UPDATED"
+
+    report = insert.sync_attribs()
+
+    assert values_of(insert) == ["user edit"]
+    assert insert.attribs[0].dxf.layer == "UPDATED"
+    assert report.updated == 1
+
+
+def test_existing_attrib_stays_the_same_entity(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.sync_attribs()
+    attrib = insert.attribs[0]
+    handle = attrib.dxf.handle
+    block.get_attdef("NAME").dxf.height = 3.0
+
+    insert.sync_attribs()
+
+    assert insert.attribs[0] is attrib
+    assert insert.attribs[0].dxf.handle == handle
+
+
+def test_extended_data_of_an_existing_attrib_survives(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.sync_attribs()
+    doc.appids.add("EZDXF")
+    insert.attribs[0].set_xdata("EZDXF", [(1000, "keep me")])
+    block.get_attdef("NAME").dxf.height = 3.0
+
+    insert.sync_attribs()
+
+    assert insert.attribs[0].get_xdata("EZDXF")[0].value == "keep me"
+
+
+def test_properties_of_an_existing_attrib_follow_the_definition(doc):
+    block = add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.add_attrib("NAME", "text", dxfattribs={"layer": "WRONG", "height": 9})
+    attdef = block.get_attdef("NAME")
+    attdef.dxf.layer = "ATTRIBS"
+    attdef.dxf.height = 0.25
+    attdef.dxf.color = 3
+
+    insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.dxf.layer == "ATTRIBS"
+    assert attrib.dxf.height == pytest.approx(0.25)
+    assert attrib.dxf.color == 3
+
+
+def test_attrib_property_absent_in_the_definition_is_discarded(doc):
+    add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0))
+    insert.add_attrib("NAME", "text", dxfattribs={"oblique": 15})
+
+    insert.sync_attribs()
+
+    assert insert.attribs[0].dxf.get_default("oblique") == 0
+
+
+def test_added_attrib_matches_a_newly_created_reference(doc):
+    add_block(doc)
+    insert = doc.modelspace().add_blockref("FLAG", (7, 3))
+    reference = fresh_reference(doc, "FLAG", {"NAME": "NAME-default"})
+    reference.dxf.insert = (7, 3)
+    reference.attribs[0].dxf.insert = Vec3(1, 0) + Vec3(7, 3)
+
+    insert.sync_attribs()
+
+    assert insert.attribs[0].dxf.insert.isclose(reference.attribs[0].dxf.insert)
+
+
+def test_attrib_placement_follows_rotation_and_scaling(doc):
+    add_block(doc)
+    dxfattribs = {"rotation": 30, "xscale": 2, "yscale": 2, "zscale": 2}
+    insert = doc.modelspace().add_blockref("FLAG", (10, 20), dxfattribs=dxfattribs)
+    reference = fresh_reference(doc, "FLAG", {"NAME": "NAME-default"}, **dxfattribs)
+    reference.dxf.insert = (10, 20)
+    reference.attribs.clear()
+    reference.add_auto_attribs({"NAME": "NAME-default"})
+
+    insert.sync_attribs()
+
+    assert placement_of(insert.attribs[0]) == placement_of(reference.attribs[0])
+
+
+def test_attrib_placement_follows_a_block_base_point(doc):
+    block = doc.blocks.new("BASED", base_point=(3, 4))
+    block.add_attdef("NAME", (1, 1), text="NAME-default", dxfattribs={"height": 0.5})
+    dxfattribs = {"rotation": 25}
+    insert = doc.modelspace().add_blockref("BASED", (10, 20), dxfattribs=dxfattribs)
+    reference = doc.modelspace().add_blockref("BASED", (10, 20), dxfattribs=dxfattribs)
+    reference.add_auto_attribs({"NAME": "NAME-default"})
+
+    insert.sync_attribs()
+
+    assert placement_of(insert.attribs[0]) == placement_of(reference.attribs[0])
+
+
+def test_attrib_placement_follows_non_uniform_scaling(doc):
+    add_block(doc)
+    dxfattribs = {"xscale": 2, "yscale": 3, "rotation": 10}
+    insert = doc.modelspace().add_blockref("FLAG", (1, 2), dxfattribs=dxfattribs)
+    reference = doc.modelspace().add_blockref("FLAG", (1, 2), dxfattribs=dxfattribs)
+    reference.add_auto_attribs({"NAME": "NAME-default"})
+
+    report = insert.sync_attribs()
+
+    assert placement_of(insert.attribs[0]) == placement_of(reference.attribs[0])
+    assert insert.sync_attribs().changed is False
+    assert report.added == 1
+
+
+def test_attrib_placement_follows_mirroring(doc):
+    add_block(doc)
+    dxfattribs = {"xscale": -1, "rotation": 15}
+    insert = doc.modelspace().add_blockref("FLAG", (4, 4), dxfattribs=dxfattribs)
+    reference = doc.modelspace().add_blockref("FLAG", (4, 4), dxfattribs=dxfattribs)
+    reference.add_auto_attribs({"NAME": "NAME-default"})
+
+    insert.sync_attribs()
+
+    assert placement_of(insert.attribs[0]) == placement_of(reference.attribs[0])
+
+
+def test_attrib_placement_follows_the_extrusion(doc):
+    add_block(doc)
+    dxfattribs = {"extrusion": (0, 0, -1), "rotation": 45}
+    insert = doc.modelspace().add_blockref("FLAG", (2, 5), dxfattribs=dxfattribs)
+    reference = doc.modelspace().add_blockref("FLAG", (2, 5), dxfattribs=dxfattribs)
+    reference.add_auto_attribs({"NAME": "NAME-default"})
+
+    insert.sync_attribs()
+
+    assert placement_of(insert.attribs[0]) == placement_of(reference.attribs[0])
+
+
+def test_aligned_definition_keeps_its_alignment(doc):
+    from ezdxf.enums import TextEntityAlignment
+
+    block = add_block(doc)
+    block.get_attdef("NAME").set_placement(
+        (1, 1), align=TextEntityAlignment.MIDDLE_CENTER
+    )
+    dxfattribs = {"rotation": 90, "xscale": 3, "yscale": 3, "zscale": 3}
+    insert = doc.modelspace().add_blockref("FLAG", (0, 0), dxfattribs=dxfattribs)
+    reference = doc.modelspace().add_blockref("FLAG", (0, 0), dxfattribs=dxfattribs)
+    reference.add_auto_attribs({"NAME": "NAME-default"})
+
+    insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.dxf.halign == reference.attribs[0].dxf.halign
+    assert attrib.dxf.valign == reference.attribs[0].dxf.valign
+    assert attrib.dxf.align_point.isclose(reference.attribs[0].dxf.align_point)
+
+
+def test_multiline_definition_creates_a_multiline_attrib(doc):
+    block = doc.blocks.new("ML")
+    attdef = block.add_attdef("TEXT", (0, 0), text="line")
+    mtext = MText.new(dxfattribs={"insert": (0, 0), "char_height": 0.5})
+    mtext.text = "first\\Psecond"
+    attdef.set_mtext(mtext)
+    insert = doc.modelspace().add_blockref("ML", (0, 0))
+
+    insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.has_embedded_mtext_entity is True
+    assert attrib.dxf.attribute_type == const.ATTRIB_TYPE_MULTI_LINE
+
+
+def test_multiline_attrib_carries_the_content_text(doc):
+    block = doc.blocks.new("ML")
+    attdef = block.add_attdef("TEXT", (0, 0), text="line")
+    mtext = MText.new(dxfattribs={"insert": (0, 0), "char_height": 0.5})
+    mtext.text = "default"
+    attdef.set_mtext(mtext)
+    insert = doc.modelspace().add_blockref("ML", (0, 0))
+    insert.sync_attribs()
+    attrib = insert.attribs[0]
+    content = attrib.virtual_mtext_entity()
+    content.text = "user value"
+    attrib.set_mtext(content)
+
+    insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.dxf.text == "user value"
+    assert attrib.virtual_mtext_entity().text == "user value"
+
+
+def test_added_multiline_attrib_carries_the_full_default(doc):
+    block = doc.blocks.new("ML")
+    attdef = block.add_attdef("TEXT", (0, 0), text="ignored")
+    mtext = MText.new(dxfattribs={"insert": (0, 0), "char_height": 0.5})
+    mtext.text = "first\\Psecond"
+    attdef.set_mtext(mtext)
+    insert = doc.modelspace().add_blockref("ML", (0, 0))
+
+    insert.sync_attribs()
+
+    attrib = insert.attribs[0]
+    assert attrib.virtual_mtext_entity().text == "first\\Psecond"
+    assert attrib.dxf.text == "first"
+
+
+def test_multiline_content_of_an_attrib_is_kept_in_full(doc):
+    block = doc.blocks.new("ML")
+    attdef = block.add_attdef("TEXT", (0, 0), text="line")
+    mtext = MText.new(dxfattribs={"insert": (0, 0), "char_height": 0.5})
