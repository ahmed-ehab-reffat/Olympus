+string PiscsiImage::GetImageName(const string& filename) const
+{
+	path folder(default_folder);
+	if (!folder.has_filename()) {
+		folder = folder.parent_path();
+	}
+
+	const path name(filename);
+	const path file = name.is_absolute() ? name : folder / name;
+	if (const path last = file.filename(); last.empty() || last == "." || last == "..") {
+		return "";
+	}
+
+	// The folders leading to the file are resolved the way the filesystem resolves them, so that ".." after a
+	// symbolic link to a folder refers to the parent of the link target
+	error_code error;
+	const path resolved_folder = weakly_canonical(folder, error);
+	if (error) {
+		return "";
+	}
+	const path resolved_parent = weakly_canonical(file.parent_path(), error);
+	if (error) {
+		return "";
+	}
+
+	const path relative_parent = resolved_parent.lexically_relative(resolved_folder);
+	if (IsOutside(relative_parent)) {
+		return "";
+	}
+
+	return (relative_parent / file.filename()).lexically_normal().string();
+}
+
+bool PiscsiImage::IsOutside(const path& relative_name)
+{
+	return relative_name.empty() || *relative_name.begin() == "..";
+}
