+/// The crossfade applied to a [`Transport`]'s loop region.
+pub struct Crossfade {
+	settings: LoopCrossfade,
+	sample_rate: u32,
+	/// The number of frames blended across the wrap, clamped to half
+	/// the loop region.
+	pub frames: usize,
+}
+
+impl Crossfade {
+	#[must_use]
+	pub fn new(settings: LoopCrossfade, sample_rate: u32, transport: &Transport) -> Self {
+		let mut crossfade = Self {
+			settings,
+			sample_rate,
+			frames: 0,
+		};
+		crossfade.update(transport);
+		crossfade
+	}
+
+	pub fn set(&mut self, settings: LoopCrossfade, transport: &Transport) {
+		self.settings = settings;
+		self.update(transport);
+	}
+
+	/// Recomputes the crossfade length for the transport's current loop region.
+	pub fn update(&mut self, transport: &Transport) {
+		self.frames = match transport.loop_region {
+			Some((loop_start, loop_end)) => {
+				let half = loop_end.saturating_sub(loop_start) / 2;
+				self.settings.frames(self.sample_rate).min(half)
+			}
+			None => 0,
+		};
+	}
+
+	/// If the transport's position lies in the crossfade window for the given
+	/// direction of travel, returns the index of the frame past the wrap it is
+	/// blended with and the weight of that frame.
+	#[must_use]
+	pub fn pair(&self, transport: &Transport, backwards: bool) -> Option<(usize, f32)> {
+		let (loop_start, loop_end) = transport.loop_region?;
+		let length = self.frames;
+		if length == 0 {
+			return None;
+		}
+		let position = transport.position;
+		let (step, past_wrap) = if backwards {
+			let window_end = loop_start + length;
+			if position < loop_start || position >= window_end {
+				return None;
+			}
+			let step = window_end - 1 - position;
+			(step, loop_end - 1 - step)
+		} else {
+			let window_start = loop_end - length;
+			if position < window_start || position >= loop_end {
+				return None;
+			}
+			let step = position - window_start;
+			(step, loop_start + step)
+		};
+		let weight = self.settings.easing.apply(step as f64 / length as f64) as f32;
+		Some((past_wrap, weight))
+	}
+}
+
+pub fn blend_frames(before_wrap: Frame, past_wrap: Frame, weight: f32) -> Frame {
+	before_wrap * (1.0 - weight) + past_wrap * weight
+}
