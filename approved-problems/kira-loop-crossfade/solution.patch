+/// A crossfade applied where a loop region wraps around.
+///
+/// The last frames before the wrap are blended with the frames
+/// just past it, and the wrap then lands past those frames.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct LoopCrossfade {
+	/// How much audio is blended across the wrap.
+	pub duration: PlaybackPosition,
+	/// The curve of the blend.
+	pub easing: Easing,
+}
+
+impl LoopCrossfade {
+	/// No crossfade.
+	pub const NONE: Self = Self {
+		duration: PlaybackPosition::Samples(0),
+		easing: Easing::Linear,
+	};
+
+	pub(crate) fn frames(self, sample_rate: u32) -> usize {
+		self.duration.into_samples(sample_rate)
+	}
+}
+
+impl Default for LoopCrossfade {
+	fn default() -> Self {
+		Self::NONE
+	}
+}
+
+impl From<PlaybackPosition> for LoopCrossfade {
+	fn from(duration: PlaybackPosition) -> Self {
+		Self {
+			duration,
+			easing: Easing::Linear,
+		}
+	}
+}
+
+impl From<f64> for LoopCrossfade {
+	fn from(seconds: f64) -> Self {
+		PlaybackPosition::Seconds(seconds).into()
+	}
+}
+
+impl From<std::time::Duration> for LoopCrossfade {
+	fn from(duration: std::time::Duration) -> Self {
+		PlaybackPosition::Seconds(duration.as_secs_f64()).into()
+	}
+}
