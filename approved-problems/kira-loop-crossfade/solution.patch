+	/// Returns a copy of the sound with the loop region already crossfaded.
+	///
+	/// The frames before the wrap are blended into the audio itself, the
+	/// loop region starts one crossfade later and is one crossfade shorter,
+	/// and the crossfade setting is reset, so playing the result loops
+	/// exactly like the original does with its live crossfade.
+	#[must_use = "This method returns a modified StaticSoundData and does not mutate the original value"]
+	pub fn bake_loop_crossfade(&self) -> Self {
+		let num_frames = self.num_frames();
+		let Some(Region { start, end }) = self.settings.loop_region else {
+			return self.clone();
+		};
+		let loop_start = start.into_samples(self.sample_rate);
+		let loop_end = match end {
+			EndPosition::EndOfAudio => num_frames,
+			EndPosition::Custom(end) => end.into_samples(self.sample_rate),
+		};
+		let length = loop_end.saturating_sub(loop_start);
+		let crossfade = self
+			.settings
+			.loop_crossfade
+			.frames(self.sample_rate)
+			.min(length / 2);
+		if crossfade == 0 {
+			return self.clone();
+		}
+		let frame = |index: usize| self.frame_at_index(index).unwrap_or_default();
+		let mut frames = Vec::with_capacity(num_frames);
+		frames.extend((0..loop_end - crossfade).map(frame));
+		for step in 0..crossfade {
+			let weight = self
+				.settings
+				.loop_crossfade
+				.easing
+				.apply(step as f64 / crossfade as f64) as f32;
+			frames.push(blend_frames(
+				frame(loop_end - crossfade + step),
+				frame(loop_start + step),
+				weight,
+			));
+		}
+		frames.extend((loop_end..num_frames).map(frame));
+		Self {
+			sample_rate: self.sample_rate,
+			frames: frames.into(),
+			settings: StaticSoundSettings {
+				loop_region: Some(Region {
+					start: PlaybackPosition::Samples(loop_start + crossfade),
+					end: EndPosition::Custom(PlaybackPosition::Samples(loop_end)),
+				}),
+				loop_crossfade: LoopCrossfade::NONE,
+				..self.settings
+			},
+			slice: None,
+		}
+	}
+
 	pub(super) fn split(self) -> (StaticSound, StaticSoundHandle) {
 		let (command_writers, command_readers) = command_writers_and_readers();
 		let sound = StaticSound::new(self, command_readers);
