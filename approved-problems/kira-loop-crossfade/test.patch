+mod api {
+	use super::*;
+
+	#[test]
+	fn none_is_a_zero_linear_crossfade_and_the_settings_default() {
+		assert!(matches!(LoopCrossfade::NONE.duration, PlaybackPosition::Samples(0)) || LoopCrossfade::NONE.duration == PlaybackPosition::Seconds(0.0));
+		assert_eq!(LoopCrossfade::NONE.easing, Easing::Linear);
+		assert_eq!(StaticSoundSettings::new().loop_crossfade, LoopCrossfade::NONE);
+		assert_eq!(StaticSoundSettings::default().loop_crossfade, LoopCrossfade::NONE);
+		assert_eq!(StreamingSoundSettings::new().loop_crossfade, LoopCrossfade::NONE);
+		assert_eq!(StreamingSoundSettings::default().loop_crossfade, LoopCrossfade::NONE);
+	}
+
+	#[test]
+	fn settings_and_handles_take_seconds_positions_and_crossfades() {
+		let linear = |duration| LoopCrossfade { duration, easing: Easing::Linear };
+		let eased = LoopCrossfade { duration: PlaybackPosition::Samples(2), easing: Easing::InPowi(2) };
+		assert_eq!(LoopCrossfade::from(PlaybackPosition::Samples(3)), linear(PlaybackPosition::Samples(3)));
+		assert_eq!(LoopCrossfade::from(0.25), linear(PlaybackPosition::Seconds(0.25)));
+		assert_eq!(StaticSoundSettings::new().loop_crossfade(0.25).loop_crossfade, linear(PlaybackPosition::Seconds(0.25)));
+		assert_eq!(StaticSoundSettings::new().loop_crossfade(PlaybackPosition::Samples(3)).loop_crossfade, linear(PlaybackPosition::Samples(3)));
+		assert_eq!(StaticSoundSettings::new().loop_crossfade(eased).loop_crossfade, eased);
+		assert_eq!(StreamingSoundSettings::new().loop_crossfade(0.25).loop_crossfade, linear(PlaybackPosition::Seconds(0.25)));
+		assert_eq!(StreamingSoundSettings::new().loop_crossfade(PlaybackPosition::Samples(3)).loop_crossfade, linear(PlaybackPosition::Samples(3)));
+		assert_eq!(StreamingSoundSettings::new().loop_crossfade(eased).loop_crossfade, eased);
+		let mut manager = manager();
+		let mut static_handle = manager.play(data(10, StaticSoundSettings::new())).unwrap();
+		static_handle.set_loop_crossfade(0.25);
+		static_handle.set_loop_crossfade(PlaybackPosition::Samples(3));
+		static_handle.set_loop_crossfade(eased);
+		let (sound, _log) = streaming(10, StreamingSoundSettings::new());
+		let mut streaming_handle = manager.play(sound).unwrap();
+		streaming_handle.set_loop_crossfade(0.25);
+		streaming_handle.set_loop_crossfade(PlaybackPosition::Samples(3));
+		streaming_handle.set_loop_crossfade(eased);
+	}
+}
