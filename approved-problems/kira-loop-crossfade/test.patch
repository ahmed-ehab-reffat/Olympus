+mod stereo {
+	use super::*;
+
+	fn right(i: usize) -> f32 {
+		value(19 - i)
+	}
+
+	fn stereo_frames(n: usize) -> Vec<Frame> {
+		(0..n).map(|i| Frame::new(value(i), right(i))).collect()
+	}
+
+	fn channel(sample: impl Fn(usize) -> f32, loop_start: usize, loop_end: usize, fade: usize, total: usize) -> Vec<f32> {
+		let mut pass: Vec<f32> = (loop_start + fade..loop_end - fade).map(&sample).collect();
+		for step in 0..fade {
+			pass.push(blend(sample(loop_end - fade + step), sample(loop_start + step), weight(step, fade)));
+		}
+		let prefix: Vec<f32> = (0..loop_start + fade).map(&sample).collect();
+		repeated(&prefix, &pass, total)
+	}
+
+	fn assert_channels(out: &[(f32, f32)], loop_start: usize, loop_end: usize, fade: usize) {
+		let left: Vec<f32> = out.iter().map(|f| f.0).collect();
+		let right_out: Vec<f32> = out.iter().map(|f| f.1).collect();
+		assert_output(&left, &channel(value, loop_start, loop_end, fade, out.len()));
+		assert_output(&right_out, &channel(right, loop_start, loop_end, fade, out.len()));
+	}
+
+	#[test]
+	fn static_crossfade_blends_both_channels() {
+		for fade in [2, 3] {
+			let sound = StaticSoundData {
+				sample_rate: 1,
+				frames: stereo_frames(10).into(),
+				settings: StaticSoundSettings::new().loop_region(samples(2..8)).loop_crossfade(crossfade(fade)),
+				slice: None,
+			};
+			let mut manager = manager();
+			manager.play(sound).unwrap();
+			assert_channels(&manager.backend_mut().render_stereo(24), 2, 8, fade);
+		}
+	}
+
+	#[test]
+	fn streaming_crossfade_blends_both_channels() {
+		for fade in [2, 3] {
+			let (sound, log, _) = decoded_sound(stereo_frames(10), StreamingSoundSettings::new().loop_region(samples(2..8)).loop_crossfade(crossfade(fade)), None);
+			let mut manager = manager();
+			let _handle = manager.play(sound).unwrap();
+			wait_for_frames(&log, 24);
+			let mut out = vec![];
+			let start = Instant::now();
+			while out.len() < 24 {
+				let frame = manager.backend_mut().render_stereo(1)[0];
+				if frame != (0.0, 0.0) || !out.is_empty() {
+					out.push(frame);
+				}
+				assert!(start.elapsed() < Duration::from_secs(60), "streaming sound never produced audio");
+			}
+			assert_channels(&out, 2, 8, fade);
+		}
+	}
+
+	#[test]
+	fn baked_frames_blend_both_channels() {
+		for fade in [2, 3] {
+			let sound = StaticSoundData {
+				sample_rate: 1,
+				frames: stereo_frames(10).into(),
+				settings: StaticSoundSettings::new().loop_region(samples(2..8)).loop_crossfade(crossfade(fade)),
+				slice: None,
+			};
+			let baked = sound.bake_loop_crossfade();
+			for (sample, pick) in [(value as fn(usize) -> f32, (|f: Frame| f.left) as fn(Frame) -> f32), (right, |f: Frame| f.right)] {
+				let actual: Vec<f32> = (0..10).map(|i| pick(baked.frame_at_index(i).unwrap())).collect();
+				let mut expected: Vec<f32> = (0..10).map(sample).collect();
+				for step in 0..fade {
+					expected[8 - fade + step] = blend(sample(8 - fade + step), sample(2 + step), weight(step, fade));
+				}
+				assert_output(&actual, &expected);
+			}
+		}
+	}
+}
