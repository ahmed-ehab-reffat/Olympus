+struct CaptureBackend {
+	renderer: Option<Renderer>,
+}
+
+impl Backend for CaptureBackend {
+	type Settings = ();
+	type Error = ();
+
+	fn setup(_settings: (), _internal_buffer_size: usize) -> Result<(Self, u32), ()> {
+		Ok((Self { renderer: None }, 1))
+	}
+
+	fn start(&mut self, renderer: Renderer) -> Result<(), ()> {
+		self.renderer = Some(renderer);
+		Ok(())
+	}
+}
+
+impl CaptureBackend {
+	fn render_stereo(&mut self, num_frames: usize) -> Vec<(f32, f32)> {
+		let renderer = self.renderer.as_mut().unwrap();
+		let mut out = vec![0.0; num_frames * 2];
+		for chunk in out.chunks_mut(2) {
+			renderer.on_start_processing();
+			renderer.process(chunk, 2);
+		}
+		out.chunks(2).map(|c| (c[0], c[1])).collect()
+	}
+
+	fn render(&mut self, num_frames: usize) -> Vec<f32> {
+		self.render_stereo(num_frames).into_iter().map(|(left, _)| left).collect()
+	}
+}
+
+fn manager() -> AudioManager<CaptureBackend> {
+	AudioManager::new(AudioManagerSettings {
+		internal_buffer_size: 1,
+		backend_settings: (),
+		..Default::default()
+	})
+	.unwrap()
+}
+
+const VALUES: [u32; 20] = [
+	106, 178, 231, 38, 33, 3, 232, 104, 254, 255, 193, 218, 121, 191, 134, 45, 60, 240, 42, 203,
+];
+
+fn value(i: usize) -> f32 {
+	VALUES[i] as f32 / 256.0
+}
+
+fn weight(step: usize, fade: usize) -> f32 {
+	(step as f64 / fade as f64) as f32
+}
+
+fn close(a: f32, b: f32) -> bool {
+	(a - b).abs() <= 1e-5
+}
+
+fn same(actual: &[f32], expected: &[f32]) -> bool {
+	actual.len() == expected.len() && actual.iter().zip(expected).all(|(a, e)| close(*a, *e))
+}
+
+fn ends_with_passes(out: &[f32], pass: &[f32]) -> bool {
+	let passes = [pass, pass].concat();
+	out.len() >= passes.len() + pass.len() && out[out.len() - passes.len() - pass.len()..].windows(passes.len()).any(|w| same(w, &passes))
+}
+
+fn has(frames: &[f32], frame: f32) -> bool {
+	frames.iter().any(|f| close(*f, frame))
+}
+
+fn settles_to(actual: &[f32], expected: &[f32], within: usize) {
+	for offset in 0..=within {
+		if actual.len() >= offset + expected.len() && same(&actual[offset..offset + expected.len()], expected) {
+			return;
+		}
+	}
+	panic!("expected sequence not found within {within} frames\nactual {actual:?}\nexpected {expected:?}");
+}
+
+fn frames(n: usize) -> Vec<Frame> {
+	(0..n).map(|i| Frame::from_mono(value(i))).collect()
+}
+
+fn data(n: usize, settings: StaticSoundSettings) -> StaticSoundData {
+	StaticSoundData {
+		sample_rate: 1,
+		frames: frames(n).into(),
+		settings,
+		slice: None,
+	}
+}
+
+fn samples(range: std::ops::Range<usize>) -> Region {
+	Region {
+		start: PlaybackPosition::Samples(range.start),
+		end: EndPosition::Custom(PlaybackPosition::Samples(range.end)),
+	}
+}
+
+fn resolved_loop(sound: &StaticSoundData) -> Option<(usize, usize)> {
+	let frames_at = |position: PlaybackPosition| match position {
+		PlaybackPosition::Samples(samples) => samples,
+		PlaybackPosition::Seconds(seconds) => (seconds * sound.sample_rate as f64).round() as usize,
+	};
+	sound.settings.loop_region.map(|region| {
+		let end = match region.end {
+			EndPosition::EndOfAudio => sound.num_frames(),
+			EndPosition::Custom(end) => frames_at(end),
+		};
+		(frames_at(region.start), end)
+	})
+}
+
+fn crossfade(frames: usize) -> LoopCrossfade {
+	LoopCrossfade::from(PlaybackPosition::Samples(frames))
+}
+
+fn blend(before: f32, past: f32, weight: f32) -> f32 {
+	before * (1.0 - weight) + past * weight
+}
+
+fn linear_pass(loop_start: usize, loop_end: usize, fade: usize) -> Vec<f32> {
+	rule_pass(loop_start, loop_end, fade, |x| x)
+}
+
+fn rule_pass(loop_start: usize, loop_end: usize, fade: usize, easing: impl Fn(f64) -> f64) -> Vec<f32> {
+	let mut pass: Vec<f32> = (loop_start + fade..loop_end - fade).map(value).collect();
+	for step in 0..fade {
+		let w = easing(step as f64 / fade as f64) as f32;
+		pass.push(blend(value(loop_end - fade + step), value(loop_start + step), w));
+	}
+	pass
+}
+
+fn play_static(sound: StaticSoundData, num_frames: usize) -> Vec<f32> {
+	let mut manager = manager();
+	manager.play(sound).unwrap();
+	manager.backend_mut().render(num_frames)
+}
+
+fn assert_output(actual: &[f32], expected: &[f32]) {
+	assert_eq!(actual.len(), expected.len());
+	for (i, (a, e)) in actual.iter().zip(expected).enumerate() {
+		assert!(close(*a, *e), "frame {i}: got {a}, expected {e}\nactual {actual:?}\nexpected {expected:?}");
+	}
+}
+
+fn repeated(prefix: &[f32], pass: &[f32], total: usize) -> Vec<f32> {
+	let mut out = prefix.to_vec();
+	while out.len() < total {
+		out.extend_from_slice(pass);
+	}
+	out.truncate(total);
+	out
+}
+
+fn values(indices: impl IntoIterator<Item = usize>) -> Vec<f32> {
+	indices.into_iter().map(value).collect()
+}
+
+#[derive(Debug, Clone, Copy, PartialEq)]
+enum DecoderEvent {
+	Seek(usize),
+	Decode(usize),
+	Blocked,
+}
+
+struct DecoderLog {
+	events: Mutex<Vec<DecoderEvent>>,
+	changed: Condvar,
+}
+
+impl DecoderLog {
+	fn push(&self, event: DecoderEvent) {
+		self.events.lock().unwrap().push(event);
+		self.changed.notify_all();
+	}
+
+	fn snapshot(&self) -> Vec<DecoderEvent> {
+		self.events.lock().unwrap().clone()
+	}
+
+	fn wait_until(&self, done: impl Fn(&[DecoderEvent]) -> bool) -> Vec<DecoderEvent> {
+		let deadline = Instant::now() + Duration::from_secs(60);
+		let mut events = self.events.lock().unwrap();
+		while !done(&events) {
+			let now = Instant::now();
+			assert!(now < deadline, "decoder never reached the expected state: {} events", events.len());
+			events = self.changed.wait_timeout(events, deadline - now).unwrap().0;
+		}
+		events.clone()
+	}
+}
+
+fn decodes(events: &[DecoderEvent]) -> usize {
+	events.iter().filter(|e| matches!(e, DecoderEvent::Decode(_))).count()
+}
+
+fn seeks(events: &[DecoderEvent]) -> usize {
+	events.iter().filter(|e| matches!(e, DecoderEvent::Seek(_))).count()
+}
+
+struct Gate {
+	calls_left: Mutex<Option<usize>>,
+	opened: Condvar,
+}
+
+impl Gate {
+	fn open(&self) {
+		*self.calls_left.lock().unwrap() = None;
+		self.opened.notify_all();
+	}
+}
+
+struct RecordingDecoder {
+	sample_rate: u32,
+	frames: Vec<Frame>,
+	current: usize,
+	log: Arc<DecoderLog>,
+	gate: Arc<Gate>,
+	owner: ThreadId,
+}
+
+impl RecordingDecoder {
+	fn pass_gate(&self) {
+		if thread::current().id() == self.owner {
+			return;
+		}
+		let mut calls_left = self.gate.calls_left.lock().unwrap();
+		if *calls_left == Some(0) {
+			self.log.push(DecoderEvent::Blocked);
+			while *calls_left == Some(0) {
+				calls_left = self.gate.opened.wait(calls_left).unwrap();
+			}
+		}
+		if let Some(left) = calls_left.as_mut() {
+			*left -= 1;
+		}
+	}
+}
+
+const PACKET: usize = 3;
+
+impl Decoder for RecordingDecoder {
+	type Error = ();
+
+	fn sample_rate(&self) -> u32 {
+		self.sample_rate
+	}
+
+	fn num_frames(&self) -> usize {
+		self.frames.len()
+	}
+
+	fn decode(&mut self) -> Result<Vec<Frame>, ()> {
+		self.pass_gate();
+		self.log.push(DecoderEvent::Decode(self.current));
+		let mut packet = vec![];
+		for _ in 0..PACKET {
+			if self.current >= self.frames.len() {
+				break;
+			}
+			packet.push(self.frames[self.current]);
+			self.current += 1;
+		}
+		Ok(packet)
+	}
+
+	fn seek(&mut self, index: usize) -> Result<usize, ()> {
+		self.pass_gate();
+		self.current = index / PACKET * PACKET;
+		self.log.push(DecoderEvent::Seek(self.current));
+		Ok(self.current)
+	}
+}
+
+fn decoded_sound(frames: Vec<Frame>, settings: StreamingSoundSettings, calls: Option<usize>) -> (StreamingSoundData<()>, Arc<DecoderLog>, Arc<Gate>) {
+	decoded_sound_at(1, frames, settings, calls)
+}
+
+fn decoded_sound_at(sample_rate: u32, frames: Vec<Frame>, settings: StreamingSoundSettings, calls: Option<usize>) -> (StreamingSoundData<()>, Arc<DecoderLog>, Arc<Gate>) {
+	let log = Arc::new(DecoderLog {
+		events: Mutex::new(vec![]),
+		changed: Condvar::new(),
+	});
+	let gate = Arc::new(Gate {
+		calls_left: Mutex::new(calls),
+		opened: Condvar::new(),
+	});
+	let decoder = RecordingDecoder {
+		sample_rate,
+		frames,
+		current: 0,
+		log: log.clone(),
+		gate: gate.clone(),
+		owner: thread::current().id(),
+	};
+	(StreamingSoundData::from_decoder(decoder).with_settings(settings), log, gate)
+}
+
+fn streaming(n: usize, settings: StreamingSoundSettings) -> (StreamingSoundData<()>, Arc<DecoderLog>) {
+	let (sound, log, _) = decoded_sound(frames(n), settings, None);
+	(sound, log)
+}
+
+fn seeks_before_the_decoder_thread_runs(settings: StreamingSoundSettings) -> usize {
+	let (sound, log, gate) = decoded_sound(frames(10), settings, Some(0));
+	let mut manager = manager();
+	let _handle = manager.play(sound).unwrap();
+	let seeks = seeks(&log.snapshot());
+	gate.open();
+	seeks
+}
+
+fn render_streaming(manager: &mut AudioManager<CaptureBackend>, num_frames: usize) -> Vec<f32> {
+	let mut out = vec![];
+	let start = Instant::now();
+	while out.len() < num_frames {
+		let frame = manager.backend_mut().render(1)[0];
+		if frame != 0.0 || !out.is_empty() {
+			out.push(frame);
+		}
+		assert!(start.elapsed() < Duration::from_secs(60), "streaming sound never produced audio");
+	}
+	out
+}
+
+fn wait_for_frames(log: &DecoderLog, num_frames: usize) {
+	log.wait_until(|events| decodes(events) >= 4 * num_frames + 32);
+}
+
+fn render_until(manager: &mut AudioManager<CaptureBackend>, done: impl Fn(&[f32]) -> bool) -> Vec<f32> {
+	let mut out = vec![];
+	let start = Instant::now();
+	while !done(&out) {
+		out.extend(render_streaming(manager, 256));
+		assert!(start.elapsed() < Duration::from_secs(60), "expected audio never played: {:?}", &out[out.len().saturating_sub(16)..]);
+	}
+	out
+}
+
+fn play_streaming(handle_out: &mut Option<StreamingSoundHandle<()>>, sound: StreamingSoundData<()>, log: &DecoderLog, num_frames: usize) -> (AudioManager<CaptureBackend>, Vec<f32>) {
+	let mut manager = manager();
+	let handle = manager.play(sound).unwrap();
+	wait_for_frames(log, num_frames);
+	let out = render_streaming(&mut manager, num_frames);
+	*handle_out = Some(handle);
+	(manager, out)
+}
