+			assert!(out.iter().all(|frame| has(&heard, *frame)), "seek to {target}: {out:?}");
+		}
+	}
+
+	#[test]
+	fn streaming_seconds_are_converted_with_the_sample_rate() {
+		let mut outputs = vec![];
+		for loop_crossfade in [LoopCrossfade::from(0.5), crossfade(2)] {
+			let (sound, log, _) = decoded_sound_at(4, frames(20), StreamingSoundSettings::new().loop_region(samples(4..16)).loop_crossfade(loop_crossfade), None);
+			let mut handle = None;
+			let (_manager, out) = play_streaming(&mut handle, sound, &log, 40);
+			outputs.push(out);
+		}
+		assert_output(&outputs[0], &outputs[1]);
+	}
+
+	#[test]
+	fn streaming_set_loop_region_keeps_the_buffered_audio_then_uses_new_weights() {
+		let (sound, log, gate) = decoded_sound(frames(14), StreamingSoundSettings::new().loop_region(samples(2..8)).loop_crossfade(crossfade(3)), Some(60));
+		let mut manager = manager();
+		let mut handle = manager.play(sound).unwrap();
+		log.wait_until(|events| events.contains(&DecoderEvent::Blocked));
+		handle.set_loop_region(samples(4..12));
+		let buffered = render_streaming(&mut manager, 48);
+		assert_output(&buffered, &repeated(&values(0..5), &linear_pass(2, 8, 3), 48));
+		gate.open();
+		let pass = linear_pass(4, 12, 3);
+		render_until(&mut manager, |out| ends_with_passes(out, &pass));
+	}
+
+	#[test]
+	fn streaming_playback_rate_applies_to_the_blended_frames() {
+		let baked = data(10, StaticSoundSettings::new().loop_region(samples(2..8)).loop_crossfade(crossfade(2))).bake_loop_crossfade();
+		let baked_frames: Vec<Frame> = (0..10).map(|i| baked.frame_at_index(i).unwrap()).collect();
+		for rate in [2.0, 1.5, 0.5] {
+			let (live, live_log) = streaming(10, StreamingSoundSettings::new().playback_rate(PlaybackRate(rate)).loop_region(samples(2..8)).loop_crossfade(crossfade(2)));
+			let (plain, plain_log, _) = decoded_sound(baked_frames.clone(), StreamingSoundSettings::new().playback_rate(PlaybackRate(rate)).loop_region(samples(4..8)), None);
+			let mut live_handle = None;
+			let (_live_manager, live_out) = play_streaming(&mut live_handle, live, &live_log, 60);
+			let mut plain_handle = None;
+			let (_plain_manager, plain_out) = play_streaming(&mut plain_handle, plain, &plain_log, 60);
+			assert_output(&live_out, &plain_out);
+		}
+	}
+}
