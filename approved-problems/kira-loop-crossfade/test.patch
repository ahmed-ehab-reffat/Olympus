+mod reverse {
+	use super::*;
+
+	fn reverse_pass(loop_start: usize, loop_end: usize, fade: usize) -> Vec<f32> {
+		let mut pass: Vec<f32> = (loop_start + fade..loop_end - fade).rev().map(value).collect();
+		for step in 0..fade {
+			let w = weight(step, fade);
+			pass.push(blend(value(loop_start + fade - 1 - step), value(loop_end - 1 - step), w));
+		}
+		pass
+	}
