+mod easing {
+	use super::*;
+
+	fn in_out(power: impl Fn(f64) -> f64) -> impl Fn(f64) -> f64 {
+		move |x| {
+			let x = x * 2.0;
+			if x < 1.0 { 0.5 * power(x) } else { 0.5 * (1.0 - power(2.0 - x)) + 0.5 }
+		}
+	}
+
+	#[test]
+	fn in_out_and_float_power_easings_follow_their_curves() {
+		let curves: [(Easing, Box<dyn Fn(f64) -> f64>); 4] = [
+			(Easing::InOutPowi(3), Box::new(in_out(|x| x.powi(3)))),
+			(Easing::InPowf(1.5), Box::new(|x: f64| x.powf(1.5))),
+			(Easing::OutPowf(2.5), Box::new(|x: f64| 1.0 - (1.0 - x).powf(2.5))),
+			(Easing::InOutPowf(1.5), Box::new(in_out(|x| x.powf(1.5)))),
+		];
+		for (easing, curve) in curves {
+			let sound = data(16, StaticSoundSettings::new().loop_region(samples(2..14)).loop_crossfade(LoopCrossfade { duration: PlaybackPosition::Samples(6), easing }));
+			let out = play_static(sound, 32);
+			assert_output(&out, &repeated(&values(0..8), &rule_pass(2, 14, 6, &curve), 32));
+		}
+	}
+
+	#[test]
+	fn in_powi_two_weights_the_head_by_the_square() {
+		let sound = data(12, StaticSoundSettings::new().loop_region(samples(2..10)).loop_crossfade(LoopCrossfade { duration: PlaybackPosition::Samples(4), easing: Easing::InPowi(2) }));
+		let out = play_static(sound, 30);
+		assert_output(&out, &repeated(&values(0..6), &rule_pass(2, 10, 4, |x| x * x), 30));
+	}
+
+	#[test]
+	fn out_powi_two_weights_the_head_by_one_minus_the_square_of_the_rest() {
+		let sound = data(12, StaticSoundSettings::new().loop_region(samples(2..10)).loop_crossfade(LoopCrossfade { duration: PlaybackPosition::Samples(4), easing: Easing::OutPowi(2) }));
+		let out = play_static(sound, 30);
+		assert_output(&out, &repeated(&values(0..6), &rule_pass(2, 10, 4, |x| 1.0 - (1.0 - x) * (1.0 - x)), 30));
+	}
