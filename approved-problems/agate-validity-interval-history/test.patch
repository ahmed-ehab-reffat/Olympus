+        table = self.observations((
+            ('a', '2020-01-01', 'free'),
+            ('a', '2020-03-01', 'pro'),
+        ))
+
+        history = table.to_history('id', 'effective')
+
+        self.assertColumnNames(history, ['id', 'valid_from', 'valid_to', 'plan'])
+        self.assertColumnTypes(history, [Text, Date, Date, Text])
+        self.assertRows(history, [
+            ('a', date(2020, 1, 1), date(2020, 3, 1), 'free'),
+            ('a', date(2020, 3, 1), None, 'pro'),
+        ])
+        self.assertEqual(len(history.rows), 2)
