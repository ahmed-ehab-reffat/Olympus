+class HistoryTestCase(AgateTestCase):
+    def setUp(self):
+        self.text_type = Text()
+        self.date_type = Date()
+        self.date_time_type = DateTime()
+        self.number_type = Number()
+
+    def observations(self, rows, column_names=None):
+        return Table(
+            rows,
+            column_names or ['id', 'effective', 'plan'],
+            [self.text_type, self.date_type, self.text_type]
+        )
+
+    def history(self, rows, column_names=None):
+        return Table(
+            rows,
+            column_names or ['id', 'valid_from', 'valid_to', 'plan'],
+            [self.text_type, self.date_type, self.date_type, self.text_type]
+        )
+
