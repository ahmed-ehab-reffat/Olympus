+++ b/agate/table/history_at.py
@@ -0,0 +1,38 @@
+from agate import history
+from agate.rows import Row
+
+
+def history_at(self, instant, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table holding the rows of a history table whose interval
+    covers a given instant, without the two interval columns.
+
+    :param instant:
+        The instant to look at. It is cast with the data type of the interval
+        columns, so a string may be used.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    data_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    instant = data_type.cast(instant)
+
+    if instant is None:
+        raise ValueError('An instant may not be null.')
+
+    column_names = [name for name in self._column_names if name not in (start_column_name, end_column_name)]
+    column_types = [self._columns[name].data_type for name in column_names]
+
+    rows = []
+
+    for row in self._rows:
+        if row[start_column_name] <= instant and history.ends_after(row[end_column_name], instant):
+            rows.append(Row([row[name] for name in column_names], column_names))
+
+    return self._fork(rows, column_names, column_types, row_names=[])
