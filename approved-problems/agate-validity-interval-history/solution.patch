@@ -0,0 +1,52 @@
+from agate import history
+
+
+def coalesce_history(self, key, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table in which the intervals of a key that meet end to end and
+    carry the same values are replaced by the single interval they span.
+
+    Two intervals meet when the end of one is the start of the next. Intervals
+    separated by a gap are never merged, however alike their values are.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+
+    history.interval_data_type(self, start_column_name, end_column_name)
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    payload_names = history.payload_column_names(self, key_names, start_column_name, end_column_name)
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        ordered = history.sorted_by_start(group_rows, start_column_name)
+
+        history.validate_no_overlaps(ordered, start_column_name, end_column_name)
+
+        segments = []
+
+        for row in ordered:
+            values = history.payload_values(row, payload_names)
+            start = row[start_column_name]
+            end = row[end_column_name]
+
+            if segments and segments[-1][2] is not None and segments[-1][2] == start and segments[-1][3] == values:
+                segments[-1][2] = end
+                continue
+
+            segments.append([row, start, end, values])
+
+        for row, start, end, values in segments:
+            rows.append(history.replace_interval(self, row, start_column_name, end_column_name, start, end))
+
+    return self._fork(rows, row_names=[])
