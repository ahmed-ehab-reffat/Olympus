@@ -0,0 +1,47 @@
+from agate import history
+
+
+def flatten_history(self, key, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table in which the intervals of a key no longer overlap.
+
+    The rows of a key are applied in the order they appear in this table, and
+    each one takes the instants it covers away from the rows applied before it.
+    An interval that loses a span out of its middle survives as the two pieces
+    left on either side.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+
+    history.interval_data_type(self, start_column_name, end_column_name)
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        segments = []
+
+        for row in group_rows:
+            start = row[start_column_name]
+            end = row[end_column_name]
+            remaining = []
+
+            for segment in segments:
+                remaining.extend(history.subtract(segment, start, end))
+
+            remaining.append([row, start, end])
+            segments = remaining
+
+        for row, start, end in sorted(segments, key=lambda segment: segment[1]):
+            rows.append(history.replace_interval(self, row, start_column_name, end_column_name, start, end))
+
+    return self._fork(rows, row_names=[])
