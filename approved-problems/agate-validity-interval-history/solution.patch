+++ b/agate/aggregations/coverage.py
@@ -0,0 +1,59 @@
+import datetime
+
+from agate.aggregations.base import Aggregation
+from agate.data_types import TimeDelta
+from agate.history import interval_data_type, validate_intervals
+
+
+class Coverage(Aggregation):
+    """
+    Calculate how much time the intervals of a history table cover in total.
+
+    Intervals that overlap or meet end to end are treated as the single stretch
+    of time they span, so no instant is ever counted twice. The result is null
+    when any interval is open ended.
+
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    """
+    def __init__(self, start_column_name='valid_from', end_column_name='valid_to'):
+        self._start_column_name = start_column_name
+        self._end_column_name = end_column_name
+
+    def get_aggregate_data_type(self, table):
+        return TimeDelta()
+
+    def validate(self, table):
+        interval_data_type(table, self._start_column_name, self._end_column_name)
+        validate_intervals(table, self._start_column_name, self._end_column_name)
+
+    def run(self, table):
+        intervals = []
+
+        for row in table.rows:
+            start = row[self._start_column_name]
+            end = row[self._end_column_name]
+
+            if end is None:
+                return None
+
+            intervals.append((start, end))
+
+        covered = datetime.timedelta()
+        span = None
+
+        for start, end in sorted(intervals):
+            if span is None:
+                span = [start, end]
+            elif start > span[1]:
+                covered += span[1] - span[0]
+                span = [start, end]
+            elif end > span[1]:
+                span[1] = end
+
+        if span is not None:
+            covered += span[1] - span[0]
+
+        return covered
