new file mode 100644
index 0000000..0a67f0f
--- /dev/null
+++ b/agate/table/to_history.py
@@ -0,0 +1,87 @@
+from agate import history
+from agate.data_types import Date, DateTime
+from agate.exceptions import DataTypeError
+from agate.rows import Row
+
+
+def to_history(self, key, effective, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table that describes each key as a sequence of half-open
+    intervals, from a table of observations that each carry the instant they
+    took effect.
+
+    The observations of a key are read in order of their effective instant.
+    Each one holds until the next one replaces it, so the last observation of a
+    key is left open ended. Observations that repeat the values of the one
+    before them do not begin a new interval.
+
+    :param key:
+        Either the name or index of a column that identifies what an
+        observation describes, or a sequence of such column identifiers.
+    :param effective:
+        The name or index of the column holding the instant an observation took
+        effect. It must be a :class:`.Date` or :class:`.DateTime` column.
+    :param start_column_name:
+        The name to give the column holding interval starts.
+    :param end_column_name:
+        The name to give the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+    effective_name = self._columns[effective].name
+    effective_type = self._columns[effective_name].data_type
+
+    if not isinstance(effective_type, (Date, DateTime)):
+        raise DataTypeError('The "%s" column must be a Date or DateTime column.' % effective_name)
+
+    excluded = key_names + [effective_name]
+    payload_names = [name for name in self._column_names if name not in excluded]
+
+    history.validate_new_column_names(self._column_names, [start_column_name, end_column_name])
+
+    column_names = key_names + [start_column_name, end_column_name] + payload_names
+    column_types = [self._columns[name].data_type for name in key_names]
+    column_types += [effective_type, effective_type]
+    column_types += [self._columns[name].data_type for name in payload_names]
+
+    for row in self._rows:
+        if row[effective_name] is None:
+            raise ValueError('The "%s" column may not contain nulls.' % effective_name)
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        observations = []
+
+        for row in sorted(group_rows, key=lambda row: row[effective_name]):
+            if observations and observations[-1][effective_name] == row[effective_name]:
+                observations[-1] = row
+            else:
+                observations.append(row)
+
+        segments = []
+
+        for row in observations:
+            values = history.payload_values(row, payload_names)
+            instant = row[effective_name]
+            open_segment = segments[-1] if segments and segments[-1][1] is None else None
+
+            if all(value is None for value in values):
+                if open_segment is not None:
+                    open_segment[1] = instant
+
+                continue
+
+            if open_segment is not None:
+                if open_segment[2] == values:
+                    continue
+
+                open_segment[1] = instant
+
+            segments.append([instant, None, values])
+
+        for start, end, values in segments:
+            rows.append(Row(list(group) + [start, end] + list(values), column_names))
+
+    return self._fork(rows, column_names, column_types, row_names=[])
