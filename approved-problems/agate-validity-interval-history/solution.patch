+++ b/agate/table/history_spans.py
@@ -0,0 +1,60 @@
+import datetime
+
+from agate import history
+from agate.data_types import TimeDelta
+from agate.rows import Row
+
+
+def history_spans(self, key, start_column_name='valid_from', end_column_name='valid_to',
+                  duration_column_name='duration'):
+    """
+    Create a new table with one row per key, holding the reach of that key's
+    intervals and how much of it they actually cover.
+
+    The new table has the key columns, the two interval columns and a
+    :class:`.TimeDelta` column. The start is the earliest start of the key and
+    the end is its latest end. A key with an open ended interval has a null end
+    and a null duration, because neither of them is known yet.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :param duration_column_name:
+        The name to give the column holding covered time.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+    data_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+    history.validate_new_column_names(self._column_names, [duration_column_name])
+
+    column_names = key_names + [start_column_name, end_column_name, duration_column_name]
+    column_types = [self._columns[name].data_type for name in key_names]
+    column_types += [data_type, data_type, TimeDelta()]
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        ordered = history.sorted_by_start(group_rows, start_column_name)
+
+        history.validate_no_overlaps(ordered, start_column_name, end_column_name)
+
+        start = ordered[0][start_column_name]
+        ends = [row[end_column_name] for row in ordered]
+
+        if None in ends:
+            end = None
+            duration = None
+        else:
+            end = max(ends)
+            duration = sum((row[end_column_name] - row[start_column_name] for row in ordered), datetime.timedelta())
+
+        rows.append(Row(list(group) + [start, end, duration], column_names))
+
+    return self._fork(rows, column_names, column_types, row_names=[])
diff --git a/agate/table/join_history.py b/agate/table/join_history.py
new file mode 100644
index 0000000..d2fe38c
--- /dev/null
+++ b/agate/table/join_history.py
@@ -0,0 +1,109 @@
+from agate import history
+from agate.exceptions import DataTypeError
+from agate.rows import Row
+
+
+def join_history(self, right_table, key, inner=True, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table by pairing the rows of two history tables that share a
+    key over the instants their intervals have in common.
+
+    Every pair of rows that share a key and cover a common instant contributes
+    one row, whose interval is the span the two of them cover together. Rows
+    that merely touch, so that one begins where the other ends, share no
+    instant and contribute nothing.
+
+    If :code:`inner` is :code:`False`, whatever is left of a row of this table
+    once every span it shares with the right table is taken away also comes
+    through, with the right-hand columns set to :code:`None`. A row can be left
+    with more than one such piece.
+
+    Both tables must name their interval columns and their key columns the
+    same way. Column names taken from :code:`right_table` which also exist in
+    this table are suffixed "2" in the new table.
+
+    :param right_table:
+        The "right" table to join to.
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param inner:
+        Leave out the parts of this table's intervals that the right table does
+        not cover.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+
+    left_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.matching_key_column_names(right_table, key, key_names)
+
+    for name in [start_column_name, end_column_name]:
+        if name not in right_table._column_names:
+            raise ValueError('The "%s" column is missing from the right table.' % name)
+
+    right_type = history.interval_data_type(right_table, start_column_name, end_column_name)
+
+    if type(left_type) is not type(right_type):
+        raise DataTypeError('Both tables must bound their intervals with the same data type.')
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+    history.validate_intervals(right_table, start_column_name, end_column_name)
+
+    left_payload = history.payload_column_names(self, key_names, start_column_name, end_column_name)
+    right_payload = history.payload_column_names(right_table, key_names, start_column_name, end_column_name)
+
+    column_names = key_names + [start_column_name, end_column_name] + left_payload
+    column_types = [self._columns[name].data_type for name in key_names]
+    column_types += [left_type, left_type]
+    column_types += [self._columns[name].data_type for name in left_payload]
+
+    for name in right_payload:
+        if name in column_names:
+            column_names.append('%s2' % name)
+        else:
+            column_names.append(name)
+
+        column_types.append(right_table._columns[name].data_type)
+
+    right_groups = history.group_rows(right_table, key_names)
+
+    rows = []
+
+    for left_row in self._rows:
+        group = history.payload_values(left_row, key_names)
+        remainder = [] if inner else [[left_row, left_row[start_column_name], left_row[end_column_name]]]
+
+        for right_row in right_groups.get(group, []):
+            start = max(left_row[start_column_name], right_row[start_column_name])
+            end = history.earlier_end(left_row[end_column_name], right_row[end_column_name])
+
+            if not history.ends_after(end, start):
+                continue
+
+            values = list(group) + [start, end]
+            values += [left_row[name] for name in left_payload]
+            values += [right_row[name] for name in right_payload]
+
+            rows.append(Row(values, column_names))
+
+            pieces = []
+
+            for segment in remainder:
+                pieces.extend(history.subtract(segment, start, end))
+
+            remainder = pieces
+
+        for segment in remainder:
+            values = list(group) + [segment[1], segment[2]]
+            values += [left_row[name] for name in left_payload]
+            values += [None] * len(right_payload)
+
+            rows.append(Row(values, column_names))
+
+    return self._fork(rows, column_names, column_types, row_names=[])
