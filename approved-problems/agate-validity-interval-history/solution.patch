+++ b/agate/table/history_events.py
@@ -0,0 +1,59 @@
+from agate import history
+from agate.rows import Row
+
+
+def history_events(self, key, effective_column_name='effective', start_column_name='valid_from',
+                   end_column_name='valid_to'):
+    """
+    Create a new table that describes a history table as the moments at which
+    something about a key changed.
+
+    Every interval contributes the moment it began, carrying its values. An
+    interval that ends without another one taking over at that instant also
+    contributes the moment it ended, carrying nulls, because from then on the
+    key has no values at all. The two interval columns are replaced by a single
+    column holding the moment.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param effective_column_name:
+        The name to give the column holding the moment of a change.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+    data_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    payload_names = history.payload_column_names(self, key_names, start_column_name, end_column_name)
+
+    history.validate_new_column_names(self._column_names, [effective_column_name])
+
+    column_names = key_names + [effective_column_name] + payload_names
+    column_types = [self._columns[name].data_type for name in key_names] + [data_type]
+    column_types += [self._columns[name].data_type for name in payload_names]
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        ordered = history.sorted_by_start(group_rows, start_column_name)
+
+        history.validate_no_overlaps(ordered, start_column_name, end_column_name)
+
+        starts = [row[start_column_name] for row in ordered]
+
+        for row in ordered:
+            values = [row[name] for name in payload_names]
+
+            rows.append(Row(list(group) + [row[start_column_name]] + values, column_names))
+
+            if row[end_column_name] is not None and row[end_column_name] not in starts:
+                rows.append(Row(list(group) + [row[end_column_name]] + [None] * len(payload_names), column_names))
+
+    return self._fork(rows, column_names, column_types, row_names=[])
