@@ -0,0 +1,45 @@
+from agate import history
+from agate.rows import Row
+
+
+def history_gaps(self, key, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table holding the stretches of time a history table leaves
+    uncovered between the intervals of a key.
+
+    The new table has the key columns and the two interval columns, and nothing
+    else.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+    data_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    column_names = key_names + [start_column_name, end_column_name]
+    column_types = [self._columns[name].data_type for name in key_names] + [data_type, data_type]
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        ordered = history.sorted_by_start(group_rows, start_column_name)
+
+        history.validate_no_overlaps(ordered, start_column_name, end_column_name)
+
+        for previous, row in zip(ordered, ordered[1:]):
+            end = previous[end_column_name]
+            start = row[start_column_name]
+
+            if end < start:
+                rows.append(Row(list(group) + [end, start], column_names))
+
+    return self._fork(rows, column_names, column_types, row_names=[])
