--- /dev/null
+++ b/agate/history.py
@@ -0,0 +1,250 @@
+"""
+This module contains the machinery shared by the history methods of
+:class:`.Table`. A history table records the values that belong to a key over a
+sequence of half-open intervals: an interval covers every instant from its
+start up to, but not including, its end. An interval with a null end has not
+finished yet and covers every instant from its start onwards.
+"""
+
+from collections import OrderedDict
+
+from agate import utils
+from agate.data_types import Date, DateTime
+from agate.exceptions import DataTypeError
+from agate.rows import Row
+
+
+def key_column_names(table, key):
+    """
+    Resolve a key argument into a list of column names.
+
+    :param table:
+        The :class:`.Table` the key refers to.
+    :param key:
+        Either the name or index of a column, or a sequence of such column
+        identifiers.
+    :returns:
+        A :class:`list` of column names.
+    """
+    if utils.issequence(key):
+        identifiers = list(key)
+    else:
+        identifiers = [key]
+
+    return [table._columns[identifier].name for identifier in identifiers]
+
+
+def matching_key_column_names(table, key, key_names):
+    """
+    Resolve a key against a second table the way it was resolved against the
+    first, and raise when the two do not arrive at the same column names.
+
+    :param table:
+        The other :class:`.Table` the key must also select.
+    :param key:
+        The key argument as it was given.
+    :param key_names:
+        The column names the key selected in the first table.
+    """
+    try:
+        names = key_column_names(table, key)
+    except KeyError:
+        names = None
+
+    if names != list(key_names):
+        raise ValueError('Both tables must name their key columns the same way.')
+
+
+def interval_data_type(table, start_column_name, end_column_name):
+    """
+    Return the data type shared by a pair of interval columns.
+
+    :param table:
+        The :class:`.Table` the interval columns belong to.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        An instance of :class:`.Date` or :class:`.DateTime`.
+    """
+    start_type = table._columns[start_column_name].data_type
+    end_type = table._columns[end_column_name].data_type
+
+    if not isinstance(start_type, (Date, DateTime)):
+        raise DataTypeError('History intervals must be bounded by Date or DateTime columns.')
+
+    if type(start_type) is not type(end_type):
+        raise DataTypeError('The "%s" and "%s" columns must share a data type.' % (start_column_name, end_column_name))
+
+    return start_type
+
+
+def payload_column_names(table, key_names, start_column_name, end_column_name):
+    """
+    Return the names of the columns that carry the values of a history table.
+
+    :param table:
+        The :class:`.Table` to read column names from.
+    :param key_names:
+        A sequence of key column names.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A :class:`list` of column names.
+    """
+    excluded = list(key_names) + [start_column_name, end_column_name]
+
+    return [name for name in table._column_names if name not in excluded]
+
+
+def payload_values(row, names):
+    """
+    Return the values a row carries in the given columns.
+    """
+    return tuple(row[name] for name in names)
+
+
+def validate_new_column_names(existing_names, new_names):
+    """
+    Raise if a column that is about to be created already exists.
+    """
+    seen = list(existing_names)
+
+    for name in new_names:
+        if name in seen:
+            raise ValueError('The "%s" column already exists in this table.' % name)
+
+        seen.append(name)
+
+
+def validate_intervals(table, start_column_name, end_column_name):
+    """
+    Raise if any interval in a history table is unbounded at its start or ends
+    at or before it begins.
+    """
+    for row in table._rows:
+        start = row[start_column_name]
+        end = row[end_column_name]
+
+        if start is None:
+            raise ValueError('The "%s" column of a history table may not contain nulls.' % start_column_name)
+
+        if end is not None and end <= start:
+            raise ValueError('A history interval must end after it begins.')
+
+
+def validate_no_overlaps(rows, start_column_name, end_column_name):
+    """
+    Raise if any two of the given intervals cover a common instant.
+
+    :param rows:
+        A sequence of rows sharing a key, ordered by interval start.
+    """
+    for previous, row in zip(rows, rows[1:]):
+        if ends_after(previous[end_column_name], row[start_column_name]):
+            raise ValueError('The history intervals of a key may not overlap.')
+
+
+def group_rows(table, key_names):
+    """
+    Collect the rows of a table into groups sharing a key, in the order the
+    keys first appear.
+
+    :returns:
+        An :class:`.OrderedDict` mapping key tuples to lists of rows.
+    """
+    groups = OrderedDict()
+
+    for row in table._rows:
+        group = payload_values(row, key_names)
+
+        if group not in groups:
+            groups[group] = []
+
+        groups[group].append(row)
+
+    return groups
+
+
+def sorted_by_start(rows, start_column_name):
+    """
+    Order a sequence of rows by interval start.
+    """
+    return sorted(rows, key=lambda row: row[start_column_name])
+
+
+def ends_after(end, instant):
+    """
+    Return :code:`True` when an interval that stops at :code:`end` still covers
+    :code:`instant`. A null end never stops.
+    """
+    return end is None or end > instant
+
+
+def earlier_end(first, second):
+    """
+    Return whichever of two interval ends comes first, treating a null end as
+    coming after every other one.
+    """
+    if first is None:
+        return second
+
+    if second is None:
+        return first
+
+    return min(first, second)
+
+
+def overlap(first_start, first_end, second_start, second_end):
+    """
+    Return :code:`True` when two intervals cover a common instant.
+    """
+    return ends_after(first_end, second_start) and ends_after(second_end, first_start)
+
+
+def subtract(segment, start, end):
+    """
+    Remove the span an interval covers from a segment and return what is left
+    of it. A segment the interval covers entirely disappears, and one the
+    interval divides comes back in two pieces.
+
+    :param segment:
+        A :class:`list` of a row, an interval start and an interval end.
+    :returns:
+        A :class:`list` of segments.
+    """
+    row, segment_start, segment_end = segment
+
+    if not overlap(segment_start, segment_end, start, end):
+        return [segment]
+
+    pieces = []
+
+    if segment_start < start:
+        pieces.append([row, segment_start, start])
+
+    if end is not None and ends_after(segment_end, end):
+        pieces.append([row, end, segment_end])
+
+    return pieces
+
+
+def replace_interval(table, row, start_column_name, end_column_name, start, end):
+    """
+    Copy a row, giving it a new interval and leaving every other column where
+    it was.
+    """
+    values = []
+
+    for name in table._column_names:
+        if name == start_column_name:
+            values.append(start)
+        elif name == end_column_name:
+            values.append(end)
+        else:
+            values.append(row[name])
+
+    return Row(values, table._column_names)
