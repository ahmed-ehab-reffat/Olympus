index 0000000..9319c21
--- /dev/null
+++ b/agate/table/clip_history.py
@@ -0,0 +1,56 @@
+from agate import history
+
+
+def clip_history(self, key, start, end=None, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table holding only the part of each interval that falls inside
+    a window of time.
+
+    An interval that reaches past either edge of the window is cut back to it,
+    and one that shares no instant with the window is dropped. The window is
+    half open, like the intervals themselves.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param start:
+        The instant the window begins at. It is cast with the data type of the
+        interval columns, so a string may be used.
+    :param end:
+        The instant the window ends at, or :code:`None` for a window that never
+        ends.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+    data_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    window_start = data_type.cast(start)
+    window_end = data_type.cast(end)
+
+    if window_start is None:
+        raise ValueError('A window must have a start.')
+
+    if window_end is not None and window_end <= window_start:
+        raise ValueError('A window must end after it begins.')
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        for row in history.sorted_by_start(group_rows, start_column_name):
+            if not history.overlap(row[start_column_name], row[end_column_name], window_start, window_end):
+                continue
+
+            clipped_start = max(row[start_column_name], window_start)
+            clipped_end = history.earlier_end(row[end_column_name], window_end)
+
+            rows.append(history.replace_interval(self, row, start_column_name, end_column_name,
+                                                 clipped_start, clipped_end))
+
+    return self._fork(rows, row_names=[])
