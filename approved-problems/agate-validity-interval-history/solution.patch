new file mode 100644
index 0000000..4b40af0
--- /dev/null
+++ b/agate/table/split_history.py
@@ -0,0 +1,49 @@
+from agate import history
+
+
+def split_history(self, key, boundaries, start_column_name='valid_from', end_column_name='valid_to'):
+    """
+    Create a new table in which every interval is cut at the given instants.
+
+    An instant that falls strictly inside an interval ends the piece before it
+    and begins the piece after it, and every piece keeps the values of the
+    interval it came from. An instant that falls on an interval boundary, or
+    outside it, changes nothing.
+
+    :param key:
+        Either the name or index of a column that identifies what an interval
+        describes, or a sequence of such column identifiers.
+    :param boundaries:
+        A sequence of instants to cut at. Each one is cast with the data type
+        of the interval columns, so strings may be used.
+    :param start_column_name:
+        The name of the column holding interval starts.
+    :param end_column_name:
+        The name of the column holding interval ends.
+    :returns:
+        A new :class:`.Table`.
+    """
+    key_names = history.key_column_names(self, key)
+    data_type = history.interval_data_type(self, start_column_name, end_column_name)
+
+    history.validate_intervals(self, start_column_name, end_column_name)
+
+    instants = sorted({data_type.cast(boundary) for boundary in boundaries} - {None})
+
+    rows = []
+
+    for group, group_rows in history.group_rows(self, key_names).items():
+        for row in history.sorted_by_start(group_rows, start_column_name):
+            start = row[start_column_name]
+            end = row[end_column_name]
+
+            for instant in instants:
+                if instant <= start or not history.ends_after(end, instant):
+                    continue
+
+                rows.append(history.replace_interval(self, row, start_column_name, end_column_name, start, instant))
+                start = instant
+
+            rows.append(history.replace_interval(self, row, start_column_name, end_column_name, start, end))
+
+    return self._fork(rows, row_names=[])
