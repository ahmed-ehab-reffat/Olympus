diff --git a/asdf/_pass_through.py b/asdf/_pass_through.py
new file mode 100644
index 00000000..a15fcec3
--- /dev/null
+++ b/asdf/_pass_through.py
@@ -0,0 +1,349 @@
+import collections
+import contextlib
+import sys
+import weakref
+from typing import Any
+
+import numpy as np
+
+from . import _node_info, lazy_nodes, tagged, util
+from ._block.options import Options
+from .config import get_config
+from .extension._manager import _resolve_type
+from .tags.core import AsdfObject, NDArrayType
+from .tags.core.ndarray import asdf_datatype_to_numpy_dtype
+from .treeutil import get_children, is_container
+
+_NDARRAY_TAG_PREFIX = "tag:stsci.edu:asdf/core/ndarray-"
+
+
+def _is_ndarray(node):
+    return (
+        isinstance(node, (tagged.TaggedDict, tagged.TaggedList))
+        and node._tag is not None
+        and node._tag.startswith(_NDARRAY_TAG_PREFIX)
+    )
+
+
+def _ndarray_source(node):
+    return node.get("source") if isinstance(node, dict) else None
+
+
+def _inline_data(node):
+    return node.get("data") if isinstance(node, dict) else _unwrap(node)
+
+
+def _unwrap(container):
+    while isinstance(container, (collections.UserDict, collections.UserList)):
+        container = container.data
+    return container
+
+
+def _raw(node):
+    return _unwrap(node) if isinstance(node, lazy_nodes._AsdfNode) else node
+
+
+def _raw_items(container):
+    data = _unwrap(container)
+    if isinstance(data, dict):
+        return list(data.items())
+    return list(enumerate(data))
+
+
+def materialize(owner, container, key, value):
+    """
+    Convert ``value`` (stored at ``container[key]``) the way tree access
+    would, so the result is cached and replaces the tagged node in the tree.
+    """
+    if isinstance(container, (lazy_nodes.AsdfDictNode, lazy_nodes.AsdfListNode)):
+        return container[key]
+    obj = owner._tagged_object_cache.retrieve(value)
+    if obj is None:
+        obj = lazy_nodes.AsdfListNode([value], weakref.ref(owner))[0]
+    _unwrap(container)[key] = obj
+    return obj
+
+
+@contextlib.contextmanager
+def _read_context(owner):
+    current = owner._version, owner._extension_manager
+    owner._version, owner._extension_manager = owner._lazy_tree_version, owner._lazy_tree_extension_manager
+    try:
+        yield
+    finally:
+        owner._version, owner._extension_manager = current
+
+
+def copy_history(history):
+    """
+    Copy the containers of a lazy tree's raw ``history`` without
+    converting the entries they hold.
+    """
+    history = _raw(history)
+    if isinstance(history, list):
+        return list(history)
+    if not isinstance(history, dict):
+        return history
+    result: dict[Any, Any] = {}
+    for key, value in history.items():
+        value = _raw(value)
+        result[key] = list(value) if isinstance(value, list) else value
+    return result
+
+
+class PassThrough:
+    """
+    Write-time state for lazy trees whose untouched nodes are written
+    from the tagged form they were read in instead of being converted.
+    """
+
+    def __init__(self, af, serialization_context):
+        self._af = af
+        self._ctx = serialization_context
+        self._blocks = af._blocks
+        self._extension_manager = serialization_context.extension_manager
+        self._owners = {}
+        self._storage = {}
+        self.renumbered = []
+
+    @classmethod
+    def create(cls, af, serialization_context):
+        if af._blocks._write_fd is None:
+            return None
+        return cls(af, serialization_context)
+
+    def _lazy_owner(self, node):
+        owner = node._af_ref() if node._af_ref is not None else None
+        if owner is None or owner._closed or owner._lazy_tree_extension_manager is None:
+            return None
+        return owner
+
+    def _must_convert(self, owner, node):
+        if not isinstance(node, tagged.Tagged):
+            return False
+        if not self._extension_manager.handles_tag(node._tag):
+            return False
+        if _is_ndarray(node):
+            read_storage, options = self._ndarray_storage(owner, node)
+            return options.storage_type != read_storage or not self._saves_base(options)
+        return len(owner._blocks.blocks) > 0
+
+    def _resolve(self, owner, container, key, value):
+        if not isinstance(value, tagged.Tagged) and type(value) not in (dict, list, collections.OrderedDict):
+            return value
+        if owner._tagged_object_cache.retrieve(value) is None and not self._must_convert(owner, value):
+            self._owners[id(value)] = owner
+            return value
+        with _read_context(owner):
+            return materialize(owner, container, key, value)
+
+    def _plain(self, owner, container, result):
+        for key, value in _raw_items(container):
+            value = self._resolve(owner, container, key, value)
+            if isinstance(result, list):
+                result.append(value)
+            else:
+                result[key] = value
+        return result
+
+    def view(self, node):
+        """
+        Return the node the writer should serialize in place of ``node``.
+        """
+        if isinstance(node, AsdfObject) and isinstance(node.data, lazy_nodes._AsdfNode):
+            owner = self._lazy_owner(node.data)
+            return node if owner is None else AsdfObject(self._plain(owner, node.data, {}))
+        if isinstance(node, lazy_nodes._AsdfNode):
+            if (owner := self._lazy_owner(node)) is None:
+                return node
+            if isinstance(node, lazy_nodes.AsdfOrderedDictNode):
+                return self._plain(owner, node, collections.OrderedDict())
+            return self._plain(owner, node, {} if isinstance(node, lazy_nodes.AsdfDictNode) else [])
+        owner = self._owners.get(id(node))
+        if owner is None:
+            return node
+        if isinstance(node, tagged.Tagged) and (tag := node._tag) is not None:
+            for manager in (self._extension_manager, owner._lazy_tree_extension_manager):
+                if manager.handles_tag(tag):
+                    self._ctx._mark_extension_used(manager.get_converter_for_tag(tag).extension)
+                    break
+            if isinstance(node, tagged.TaggedString):
+                return node
+            result = tagged.tag_object(tag, self._plain(owner, node, {} if isinstance(node, dict) else []))
+            if _is_ndarray(node):
+                self._write_ndarray(owner, node, result)
+            return result
+        return self._plain(owner, node, node.__class__())
+
+    def _block_data(self, owner, source):
+        if isinstance(source, str):
+            return owner._blocks._load_external(source)
+        return util.get_array_base(owner._blocks.blocks[source].cached_data)
+
+    def _saves_base(self, options):
+        return options.save_base or (options.save_base is None and get_config().default_array_save_base)
+
+    def _ndarray_storage(self, owner, node):
+        if id(node) in self._storage:
+            return self._storage[id(node)][1:]
+        source = _ndarray_source(node)
+        data = None
+        if source is None:
+            read_storage = "inline"
+            options = Options("inline")
+        elif isinstance(source, str):
+            read_storage = "external"
+            data = self._block_data(owner, source)
+            options = self._blocks.options.lookup_by_object(data) or Options("external")
+        else:
+            read_storage = "streamed" if source == -1 else "internal"
+            data = self._block_data(owner, source)
+            options = self._blocks.options.get_options(data)
+        cfg = get_config()
+        if cfg.all_array_storage is not None:
+            options.storage_type = cfg.all_array_storage
+        if cfg.all_array_compression != "input":
+            options.compression = cfg.all_array_compression
+            options.compression_kwargs = cfg.all_array_compression_kwargs
+        if cfg.array_inline_threshold is not None and options.storage_type in ("inline", "internal"):
+            size = np.size(_inline_data(node)) if source is None else int(np.prod(node.get("shape")))
+            options.storage_type = "inline" if size < cfg.array_inline_threshold else "internal"
+        if data is not None:
+            self._blocks.options.set_options(data, options)
+        self._storage[id(node)] = (node, read_storage, options)
+        return read_storage, options
+
+    def _write_ndarray(self, owner, node, result):
+        source = _ndarray_source(node)
+        if source is None:
+            return
+        _, options = self._ndarray_storage(owner, node)
+        data = self._block_data(owner, source)
+        if options.storage_type == "streamed":
+            self._blocks.set_streamed_write_block(data, node)
+            result["source"] = -1
+            return
+        result["source"] = self._blocks.make_write_block(data, options, node)
+        if owner is self._af and isinstance(source, int) and source >= 0:
+            self.renumbered.append((node, result["source"]))
+
+
+class LazyView:
+    """
+    Traversal of a lazy tree for info and search that leaves tagged
+    nodes nobody accessed in their tagged form.
+    """
+
+    def __init__(self, extension_manager):
+        self._extension_manager = extension_manager
+        self._slots = {}
+
+    @classmethod
+    def create(cls, af):
+        if not isinstance(getattr(af._tree, "data", None), lazy_nodes._AsdfNode):
+            return None
+        return cls(af.extension_manager)
+
+    def untouched(self, node):
+        slot = self._slots.get(id(node))
+        return slot is not None and slot[3] is node and slot[0]._tagged_object_cache.retrieve(node) is None
+
+    def resolved(self, node):
+        slot = self._slots.get(id(node))
+        if slot is None or slot[3] is not node:
+            return node
+        cached = slot[0]._tagged_object_cache.retrieve(node)
+        return node if cached is None else cached
+
+    def materialize(self, node):
+        slot = self._slots.get(id(node))
+        if slot is None or slot[3] is not node:
+            return node
+        owner, container, key, _ = slot
+        return materialize(owner, container, key, node)
+
+    def _declared_type(self, owner, node):
+        if not self._extension_manager.handles_tag(node._tag):
+            return type(node)
+        if node._tag.startswith(_NDARRAY_TAG_PREFIX):
+            if owner._blocks._lazy_load:
+                return NDArrayType
+            return np.ma.MaskedArray if isinstance(node, dict) and "mask" in node else np.ndarray
+        types = self._extension_manager.get_converter_for_tag(node._tag).types
+        if len(types) != 1:
+            return None
+        return types[0]
+
+    def _array_info(self, node):
+        shape = node.get("shape") if isinstance(node, dict) else None
+        if not isinstance(shape, list) or "*" in shape or "datatype" not in node:
+            return None
+        byteorder = node["byteorder"] if "source" in node else sys.byteorder
+        return {"shape": tuple(shape), "dtype": asdf_datatype_to_numpy_dtype(node["datatype"], byteorder)}
+
+    def _needs_conversion(self, owner, node, for_info):
+        if not self._extension_manager.handles_tag(node._tag):
+            return False
+        if node._tag.startswith(_NDARRAY_TAG_PREFIX):
+            return for_info and self._array_info(node) is None
+        typ = self._declared_type(owner, node)
+        if typ is None:
+            return False
+        if isinstance(typ, str) and (typ := _resolve_type(typ)) is None:
+            return False
+        return issubclass(typ, (dict, list, tuple)) or hasattr(typ, "__asdf_traverse__")
+
+    def _children(self, owner, container, for_info):
+        children = []
+        for key, value in _raw_items(container):
+            if isinstance(value, tagged.Tagged) or type(value) in (dict, list, collections.OrderedDict):
+                if (cached := owner._tagged_object_cache.retrieve(value)) is not None:
+                    value = cached
+                elif isinstance(value, tagged.Tagged) and not self._needs_conversion(owner, value, for_info):
+                    self._slots[id(value)] = (owner, container, key, value)
+                else:
+                    value = materialize(owner, container, key, value)
+            children.append((key, value))
+        return children
+
+    def type_of(self, node):
+        if not self.untouched(node):
+            return type(self.resolved(node))
+        return self._declared_type(self._slots[id(node)][0], node) or type(node)
+
+    def describe(self, node, for_info):
+        """
+        Return ``(target, traversable, container, rendered_type, hide_value)``
+        where ``target`` is what the children of ``node`` are taken from.
+        """
+        if not self.untouched(node):
+            node = self.resolved(node)
+        else:
