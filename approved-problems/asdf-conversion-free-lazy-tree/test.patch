+            af.search(key="^(x|y)$").node
+    with asdf.open(io.BytesIO(data), lazy_tree=True) as af:
+        result = af.search(key="^(x|y)$", type_=Thing, filter_=lambda node: node.value == 4)
+        rendered = repr(result)
+        assert "x (Thing)" in rendered
+        assert "y (Thing)" in rendered
+        assert result.paths == ["root['x']", "root['y']"]
+    with asdf.open(io.BytesIO(data), lazy_tree=True) as af:
+        af.search(key="^(x|y)$", filter_=lambda node: node.value == 4).replace(9)
