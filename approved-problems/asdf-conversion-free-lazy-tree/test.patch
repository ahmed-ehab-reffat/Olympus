+def test_writes_convert_untouched_nodes_only_in_files_with_blocks(thing_config, tmp_path):
+    cases = (
+        ({"t": Thing(3)}, []),
+        ({"t": Thing(3), "arr": np.arange(4)}, [3]),
+        ({"t": Thing(3), "p": Payload(b"abc")}, [3]),
+    )
+    for n, (tree, loaded) in enumerate(cases):
+        out = io.BytesIO()
+        path = tmp_path / f"case{n}.asdf"
+        path.write_bytes(_write(tree).getvalue())
+        with asdf.open(path, lazy_tree=True) as af:
+            ThingConverter.loaded.clear()
+            assert af.search(key="^t$").paths == ["root['t']"]
+            assert ThingConverter.loaded == []
+            af.write_to(out)
+            assert ThingConverter.loaded == loaded
+        with asdf.open(path, mode="rw", lazy_tree=True) as af:
+            ThingConverter.loaded.clear()
+            af.update()
+            assert ThingConverter.loaded == loaded
+        for buff in (out, io.BytesIO(path.read_bytes())):
+            assert _tags(buff)["t"]._tag == (THING_1_1 if loaded else THING_1_0)
+            with asdf.open(buff) as af:
+                assert af["t"].value == 3
+    with asdf.open(tmp_path / "case2.asdf") as af:
+        assert af["p"].data == b"abc"
