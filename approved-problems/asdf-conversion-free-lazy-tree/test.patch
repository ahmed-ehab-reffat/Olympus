+def test_unknown_tags_and_schema_info_show_as_before(thing_config, capsys):
+    unknown = (
+        b"u: !<asdf://example.com/tags/unknown-1.0.0> {z: 1}\n"
+        b"v: !<asdf://example.com/tags/unknown-1.0.0> hello\n"
+        b"w: !<asdf://example.com/tags/unknown-1.0.0> [1, 2]\n"
+    )
+    plain = _write({"good": Thing(1)}).getvalue()
+    bad = b"bad: !<asdf://example.com/tags/thing-1.0.0> {value: -1}\n"
+    with (
+        asdf.open(
+            io.BytesIO(plain.replace(b"...\n", unknown + bad + b"...\n")), lazy_tree=True, ignore_unrecognized_tag=True
+        ) as lazy,
+        asdf.open(
+            io.BytesIO(plain.replace(b"...\n", unknown + b"...\n")), lazy_tree=True, ignore_unrecognized_tag=True
+        ) as ref,
+    ):
+        ThingConverter.loaded.clear()
+        ref_lines = _info_lines(ref, capsys)
+        lines = _info_lines(lazy, capsys)
+        assert [line for line in ref_lines if line in lines] == ref_lines
+        assert "u (TaggedDict)" in lines
+        assert lazy.search(key="^(v|w)$").paths == ref.search(key="^(v|w)$").paths == ["root['v']", "root['w']"]
+        assert lazy.schema_info("title") == ref.schema_info("title")
+        assert lazy.search(type_=Thing).paths == ["root['good']", "root['bad']"]
+        assert lazy.search(key="^z$").paths == ref.search(key="^z$").paths == ["root['u']['z']"]
+        assert ThingConverter.loaded == []
+
