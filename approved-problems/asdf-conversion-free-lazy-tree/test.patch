+def test_shared_containers_stay_shared_after_they_are_accessed(thing_config, tmp_path):
+    shared = {"t": Thing(2), "items": [1, 2]}
+    listed = [3, {"t": Thing(4)}]
+    data = _write({"a": shared, "b": shared, "p": {"l": listed}, "q": listed, "bad": Thing(-1)}).getvalue()
+    ThingConverter.loaded.clear()
+    out = io.BytesIO()
+    with asdf.open(io.BytesIO(data), lazy_tree=True) as af:
+        assert len(af["a"]["items"]) == 2
+        assert af["q"][0] == 3
+        assert len(af["q"][1]) == 1
+        af.write_to(out)
+    path = tmp_path / "shared.asdf"
+    path.write_bytes(data)
+    with asdf.open(path, mode="rw", lazy_tree=True) as af:
+        assert len(af["a"]["items"]) == 2
+        assert len(af["q"][1]) == 1
+        af.update()
+    for buff in (out, io.BytesIO(path.read_bytes())):
+        tree = _tags(buff)
+        assert tree["a"] is tree["b"]
+        assert tree["p"]["l"] is tree["q"]
+        assert tree["a"]["t"]._tag == THING_1_0
+        assert tree["q"][1]["t"]._tag == THING_1_0
+        assert tree["bad"]._tag == THING_1_0
+    assert ThingConverter.loaded == []
