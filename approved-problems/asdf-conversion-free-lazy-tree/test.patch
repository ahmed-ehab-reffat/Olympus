+    data = _write({"x": shared, "y": shared, "bad": Thing(-1)}).getvalue()
+    with asdf.open(io.BytesIO(data), lazy_tree=True) as af:
+        nodes = af.search(key="^(x|y)$", type_=Thing).nodes
+        assert len(nodes) == 2
+        assert nodes[0] is nodes[1] is af["x"]
+    with asdf.open(io.BytesIO(data), lazy_tree=True) as af:
