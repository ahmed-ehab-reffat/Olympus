@@ -0,0 +1,819 @@
+import io
+import re
+
+import numpy as np
+import pytest
+
+import asdf
+from asdf.extension import Converter, Extension, TagDefinition
+from asdf.util import load_yaml
+
+THING_1_0 = "asdf://example.com/tags/thing-1.0.0"
+THING_1_1 = "asdf://example.com/tags/thing-1.1.0"
+THING_EXTENSION = "asdf://example.com/extensions/thing-1.0.0"
+PAYLOAD_TAG = "asdf://example.com/tags/payload-1.0.0"
+KEEPER_TAG = "asdf://example.com/tags/keeper-1.0.0"
+HOLDER_TAG = "asdf://example.com/tags/holder-1.0.0"
+SHAPE_TAGS = [f"asdf://example.com/tags/{name}-1.0.0" for name in ("bag", "walk", "row", "pair")]
+WALK_SCHEMA = "asdf://example.com/schemas/walk-1.0.0"
+WALK_SCHEMA_YAML = b"""%YAML 1.1
+---
+$schema: http://stsci.edu/schemas/yaml-schema/draft-01
+id: asdf://example.com/schemas/walk-1.0.0
+type: object
+properties:
+  inner:
+    title: The walked value
+..."""
+LABEL_TAG = "asdf://example.com/tags/label-1.0.0"
+LABEL_EXTENSION = "asdf://example.com/extensions/label-1.0.0"
+COIN_1_0 = "asdf://example.com/tags/coin-1.0.0"
+COIN_1_1 = "asdf://example.com/tags/coin-1.1.0"
+
+HISTORY = b"""#ASDF 1.0.0
+#ASDF_STANDARD 1.5.0
+%YAML 1.1
+%TAG ! tag:stsci.edu:asdf/
+--- !core/asdf-1.1.0
+history:
+  entries:
+  - !core/history_entry-1.0.0
+    description: made by hand
+    extra: !<asdf://example.com/tags/thing-1.0.0> {value: -1}
+n: 1
+..."""
+
+LABELS = b"""#ASDF 1.0.0
+#ASDF_STANDARD 1.5.0
+%YAML 1.1
+--- !<tag:stsci.edu:asdf/core/asdf-1.1.0>
+s: !<asdf://example.com/tags/label-1.0.0> hello
+r: !<asdf://example.com/tags/row-1.0.0> [1, 2]
+n: 1
+..."""
+
+
+COINS = b"""#ASDF 1.0.0
+#ASDF_STANDARD 1.5.0
+%YAML 1.1
+--- !<tag:stsci.edu:asdf/core/asdf-1.1.0>
+good: !<asdf://example.com/tags/coin-1.0.0> {value: 2}
+bad: !<asdf://example.com/tags/coin-1.0.0> {value: -1}
+n: 1
+..."""
+
+
+class Thing:
+    def __init__(self, value, data=None):
+        self.value = value
+        self.data = data
+
+    def __str__(self):
+        return f"Thing {self.value}"
+
+
+class ThingConverter(Converter):
+    lazy = True
+    tags = []
+    types = [Thing]
+    loaded = []
+
+    def select_tag(self, obj, tags, ctx):
+        return max(tags)
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        node = {"value": obj.value}
+        if obj.data is not None:
+            node["data"] = obj.data
+        return node
+
+    def from_yaml_tree(self, node, tag, ctx):
+        self.loaded.append(node["value"])
+        if node["value"] < 0:
+            msg = "this thing can not be converted"
+            raise ValueError(msg)
+        return Thing(node["value"], node.get("data"))
+
+
+class Payload:
+    def __init__(self, data):
+        self.data = data
+
+
+class Keeper(dict):
+    def __init__(self, value):
+        super().__init__(kept=True)
+        self.value = value
+
+
+class KeeperConverter(Converter):
+    tags = [KEEPER_TAG]
+    types = [Keeper]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return {"value": obj.value}
+
+    def from_yaml_tree(self, node, tag, ctx):
+        return Keeper(node["value"])
+
+
+class Holder:
+    def __init__(self, data):
+        self.data = data
+
+
+class HolderConverter(Converter):
+    tags = [HOLDER_TAG]
+    types = [Holder]
+    loaded = []
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return {"block": ctx.find_available_block_index(obj.data)}
+
+    def from_yaml_tree(self, node, tag, ctx):
+        self.loaded.append(node["block"])
+        return Holder(ctx.get_block_data_callback(node["block"])())
+
+
+class HolderExtension(Extension):
+    extension_uri = "asdf://example.com/extensions/holder-1.0.0"
+    converters = [HolderConverter()]
+    tags = [HOLDER_TAG]
+
+
+class KeeperExtension(Extension):
+    extension_uri = "asdf://example.com/extensions/keeper-1.0.0"
+    converters = [KeeperConverter()]
+    tags = [KEEPER_TAG]
+
+
+class PayloadConverter(Converter):
+    lazy = True
+    tags = [PAYLOAD_TAG]
+    types = [Payload]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return {"block": ctx.find_available_block_index(lambda: np.frombuffer(obj.data, dtype="u1"))}
+
+    def from_yaml_tree(self, node, tag, ctx):
+        return Payload(ctx.get_block_data_callback(node["block"])().tobytes())
+
+
+class Bag(dict):
+    pass
+
+
+class Walk:
+    _tag = SHAPE_TAGS[1]
+
+    def __init__(self, value):
+        self.value = value
+
+    def __asdf_traverse__(self):
+        return {"inner": self.value}
+
+
+class Row(list):
+    pass
+
+
+class Pair(tuple):
+    pass
+
+
+class BagConverter(Converter):
+    tags = [SHAPE_TAGS[0]]
+    types = [Bag]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return {key: value // 10 for key, value in obj.items()}
+
+    def from_yaml_tree(self, node, tag, ctx):
+        return Bag({key: value * 10 for key, value in node.items()})
+
+
+class WalkConverter(Converter):
+    tags = [SHAPE_TAGS[1]]
+    types = [Walk]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return {"value": obj.value}
+
+    def from_yaml_tree(self, node, tag, ctx):
+        return Walk(node["value"])
+
+
+class RowConverter(Converter):
+    tags = [SHAPE_TAGS[2]]
+    types = [Row]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return [value // 10 for value in obj]
+
+    def from_yaml_tree(self, node, tag, ctx):
+        return Row(value * 10 for value in node)
+
+
+class PairConverter(Converter):
+    tags = [SHAPE_TAGS[3]]
+    types = [Pair]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return [value // 10 for value in obj]
+
+    def from_yaml_tree(self, node, tag, ctx):
+        return Pair(value * 10 for value in node)
+
+
+class Label(str):
+    pass
+
+
+class LabelConverter(Converter):
+    tags = [LABEL_TAG]
+    types = [Label]
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return str(obj)
+
+    def from_yaml_tree(self, node, tag, ctx):
+        msg = "labels can not be loaded"
+        raise ValueError(msg)
+
+
+class LabelExtension(Extension):
+    extension_uri = LABEL_EXTENSION
+    converters = [LabelConverter()]
+    tags = [LABEL_TAG]
+
+
+class Heads:
+    def __init__(self, value):
+        self.value = value
+
+
+class Tails(Heads):
+    pass
+
+
+class CoinConverter(Converter):
+    tags = [COIN_1_1, COIN_1_0]
+    types = [Heads, Tails]
+    loaded = []
+
+    def select_tag(self, obj, tags, ctx):
+        return max(tags)
+
+    def to_yaml_tree(self, obj, tag, ctx):
+        return {"value": obj.value}
+
+    def from_yaml_tree(self, node, tag, ctx):
+        self.loaded.append(node["value"])
+        if node["value"] < 0:
+            msg = "this coin can not be converted"
+            raise ValueError(msg)
+        return (Heads if node["value"] % 2 == 0 else Tails)(node["value"])
+
+
+class CoinExtension(Extension):
+    extension_uri = "asdf://example.com/extensions/coin-1.0.0"
+    converters = [CoinConverter()]
+    tags = [COIN_1_1, COIN_1_0]
+
+
+class ShapeExtension(Extension):
+    extension_uri = "asdf://example.com/extensions/shapes-1.0.0"
+    converters = [
+        BagConverter(),
+        WalkConverter(),
+        RowConverter(),
+        PairConverter(),
+    ]
+    tags = [TagDefinition(tag, schema_uris=[WALK_SCHEMA]) if tag == Walk._tag else tag for tag in SHAPE_TAGS]
+
+
+class PayloadExtension(Extension):
+    extension_uri = "asdf://example.com/extensions/payload-1.0.0"
+    converters = [PayloadConverter()]
+    tags = [PAYLOAD_TAG]
+
+
+def _extension(*tags):
+    converter = type("TaggedThingConverter", (ThingConverter,), {"tags": list(tags)})()
+    attrs = {"extension_uri": THING_EXTENSION, "converters": [converter], "tags": list(tags)}
+    return type("ThingExtension", (Extension,), attrs)()
+
+
+def _write(tree):
+    buff = io.BytesIO()
+    with asdf.config_context() as cfg:
+        cfg.add_resource_mapping({WALK_SCHEMA: WALK_SCHEMA_YAML})
+        cfg.add_extension(_extension(THING_1_0))
+        cfg.add_extension(PayloadExtension())
+        cfg.add_extension(ShapeExtension())
+        asdf.AsdfFile(tree).write_to(buff)
+    buff.seek(0)
+    return buff
+
+
+@pytest.fixture
+def thing_config():
+    with asdf.config_context() as cfg:
+        cfg.add_resource_mapping({WALK_SCHEMA: WALK_SCHEMA_YAML})
+        cfg.add_extension(_extension(THING_1_1, THING_1_0))
+        cfg.add_extension(PayloadExtension())
+        cfg.add_extension(ShapeExtension())
+        yield cfg
+
+
+def _tags(buff):
+    buff.seek(0)
+    tree = load_yaml(buff, tagged=True)
+    buff.seek(0)
+    return tree
+
+
+def _info_lines(af, capsys, **kwargs):
+    capsys.readouterr()
+    af.info(max_rows=None, max_cols=None, **kwargs)
+    return [re.sub(r"^[^\w\[]+", "", line) for line in capsys.readouterr().out.splitlines()]
+
+
+def test_info_renders_untouched_nodes_without_converting_them(thing_config, capsys):
+    buff = _write({"good": Thing(1), "bad": Thing(-1), "meta": {"x": 1}})
+    with asdf.open(buff, lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        lines = _info_lines(af, capsys)
+        assert "good (Thing)" in lines
+        assert "bad (Thing)" in lines
+        assert "x (int): 1" in lines
+        assert ThingConverter.loaded == []
+        assert af["good"].value == 1
+        assert ThingConverter.loaded == [1]
+
+
+def test_search_by_key_does_not_convert_other_nodes(thing_config):
+    buff = _write({"good": Thing(1), "bad": Thing(-1), "meta": {"x": 1}})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        assert af.search(key="^x$").paths == ["root['meta']['x']"]
+        assert af.search(key="^good$").paths == ["root['good']"]
+        assert ThingConverter.loaded == []
+        af.write_to(out)
+    assert _tags(out)["good"]._tag == THING_1_0
+
+
+def test_search_by_type_uses_the_declared_type(thing_config):
+    buff = _write({"bad": Thing(-1), "things": [Thing(-2), Thing(3)], "n": 4})
+    with asdf.open(buff, lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        assert af.search(type_=Thing).paths == ["root['bad']", "root['things'][0]", "root['things'][1]"]
+        assert af.search(type_=int).paths == ["root['n']"]
+        assert af.search(key="^bad$").search(type_=object).paths == ["root['bad']"]
+        assert ThingConverter.loaded == []
+
+
+def test_filter_only_sees_nodes_the_key_accepts(thing_config):
+    buff = _write({"good": Thing(1), "bad": Thing(-1), "other": Thing(1)})
+    with asdf.open(buff, lazy_tree=True) as af:
+        result = af.search(key="^good$", filter_=lambda node: node.value == 1)
+        assert result.paths == ["root['good']"]
+        assert result.node is af["good"]
+
+
+def test_chained_search_checks_every_key_before_any_filter(thing_config):
+    buff = _write({"a": {"k": Thing(2), "m": Thing(3)}, "b": {"j": Thing(-1)}})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        result = af.search(filter_=lambda node: getattr(node, "value", None) in (2, 3)).search(key="^k$")
+        assert result.paths == ["root['a']['k']"]
+        assert ThingConverter.loaded == [2]
+        af.write_to(out)
+    tree = _tags(out)
+    assert tree["a"]["m"]._tag == THING_1_0
+    assert tree["b"]["j"]._tag == THING_1_0
+
+
+def test_write_keeps_the_tags_of_untouched_nodes(thing_config):
+    buff = _write({"things": [Thing(1), Thing(2), Thing(3)], "single": Thing(4)})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        af.write_to(out)
+    tree = _tags(out)
+    assert [t._tag for t in tree["things"]] == [THING_1_0] * 3
+    assert tree["single"]._tag == THING_1_0
+    with asdf.open(out) as af:
+        assert [t.value for t in af["things"]] == [1, 2, 3]
+
+
+def test_write_converts_only_nodes_that_were_accessed(thing_config):
+    buff = _write({"a": Thing(1), "b": Thing(-2)})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        af["a"].value = 10
+        af.write_to(out)
+    tree = _tags(out)
+    assert tree["a"]._tag == THING_1_1
+    assert tree["a"]["value"] == 10
+    assert tree["b"]._tag == THING_1_0
+    assert tree["b"]["value"] == -2
+
+
+def test_edit_made_through_a_search_result_is_written(thing_config):
+    buff = _write({"things": [Thing(1), Thing(2), Thing(3)]})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        hit = af.search(type_=Thing).search(key=1).node
+        assert isinstance(hit, Thing)
+        hit.value = 99
+        af.write_to(out)
+    tree = _tags(out)
+    assert [t._tag for t in tree["things"]] == [THING_1_0, THING_1_1, THING_1_0]
+    with asdf.open(out) as af:
+        assert [t.value for t in af["things"]] == [1, 99, 3]
+
+
+def test_alias_reached_through_search_stays_one_object(thing_config):
+    shared = Thing(4)
+    buff = _write({"x": shared, "y": shared, "z": Thing(-8)})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        hit = af.search(key="^x$").node
+        assert isinstance(hit, Thing)
+        hit.value = 42
+        assert af["y"] is hit
+        af.write_to(out)
+    tree = _tags(out)
+    assert tree["x"] is tree["y"]
+    assert tree["z"]._tag == THING_1_0
+    with asdf.open(out, lazy_tree=True) as af:
+        assert af["x"] is af["y"]
+        assert af["y"].value == 42
+
+
+def test_info_and_search_convert_nodes_whose_object_is_needed(thing_config, capsys):
+    tree = {
+        "bag": Bag(k=50),
+        "row": Row([60]),
+        "pair": Pair((80, 90)),
+        "walk": Walk(7),
+        "bad": Thing(-1),
+    }
+    with asdf.open(_write(tree), lazy_tree=True) as af:
+        assert sorted(af.search(type_=int).paths) == [
+            "root['bag']['k']",
+            "root['pair'][0]",
+            "root['pair'][1]",
+            "root['row'][0]",
+            "root['walk']['inner']",
+        ]
+    with asdf.open(_write(tree), lazy_tree=True) as af:
+        lines = _info_lines(af, capsys)
+        assert lines[lines.index("bag (Bag)") + 1] == "k (int): 50"
+        assert lines[lines.index("row (Row)") + 1] == "[0] (int): 60"
+        assert lines[lines.index("pair (Pair)") + 1 :][:2] == ["[0] (int): 80", "[1] (int): 90"]
+        assert af.search(key="^k$", value=50).paths == ["root['bag']['k']"]
+        assert lines[lines.index("walk (Walk)") + 1] == "inner (int): 7 # The walked value"
+        assert lines[lines.index("asdf_library (Software)") + 1].startswith("author (str): ")
+        assert "bad (Thing)" in lines
+
