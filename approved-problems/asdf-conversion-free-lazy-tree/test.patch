+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/asdf-junit-$MODE.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+export PYTHONDONTWRITEBYTECODE=1
+export HOME="${TMPDIR:-/tmp}"
+if [ -z "${USER:-}" ]; then USER="$(id -un 2>/dev/null)" || USER=asdf; fi
+export USER
+
+NEW_TESTS="asdf/_tests/test_lazy_untouched_11b889.py"
+LOG="$(mktemp)"
+rm -f "$OUTPUT_PATH"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest -p no:cacheprovider --color=no \
+    --junitxml="$OUTPUT_PATH" "$NEW_TESTS" 2>&1 | tee "$LOG"
+else
+  python -m pytest -p no:cacheprovider --color=no \
+    --junitxml="$OUTPUT_PATH" --ignore="$NEW_TESTS" \
+    --deselect asdf/_tests/test_api.py::test_open_readonly asdf docs 2>&1 | tee "$LOG"
+fi
+STATUS=${PIPESTATUS[0]}
+
+if [ -s "$OUTPUT_PATH" ] && grep -q "<testcase" "$OUTPUT_PATH"; then
+  sed -i 's/::/./g' "$OUTPUT_PATH"
+else
+  python - "$OUTPUT_PATH" "$MODE" "$LOG" <<'PY'
+import sys
+from xml.sax.saxutils import escape
+
+path, mode, log = sys.argv[1:4]
+with open(log, encoding="utf-8", errors="replace") as f:
+    text = escape(f.read()[-20000:])
+with open(path, "w", encoding="utf-8") as f:
+    f.write('<?xml version="1.0" encoding="utf-8"?>\n')
+    f.write('<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0">')
+    f.write(f'<testcase classname="{mode}" name="pytest_run"><failure message="pytest produced no results">')
+    f.write(text)
+    f.write("</failure></testcase></testsuite></testsuites>\n")
+PY
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -f "$LOG"
+exit "$STATUS"
