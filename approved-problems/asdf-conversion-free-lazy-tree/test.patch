+def test_value_and_filter_wait_for_type_criteria(thing_config):
+    buff = _write({"bad": Thing(-1), "n": 4, "m": 5})
+    with asdf.open(buff, lazy_tree=True) as af:
+        assert af.search(value=4).search(type_=int).paths == ["root['n']"]
+        assert af.search(filter_=lambda node: node == 5).search(type_=int).paths == ["root['m']"]
+
+
+def test_iteration_and_search_nodes_reach_untouched_nodes(thing_config):
+    buff = _write({"things": [Thing(1), Thing(2)], "more": {"p": Thing(3), "q": Thing(4)}, "bad": Thing(-1)})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        for thing in af["things"]:
+            thing.value += 10
+        hits = af.search(key="^[pq]$").nodes
+        for hit in hits:
+            hit.value += 20
+        assert af["more"]["p"] is hits[0]
+        assert af["more"]["q"] is hits[1]
+        af.write_to(out)
+    tree = _tags(out)
+    assert [t._tag for t in tree["things"]] == [THING_1_1, THING_1_1]
+    assert [tree["more"][k]._tag for k in "pq"] == [THING_1_1, THING_1_1]
+    assert tree["bad"]._tag == THING_1_0
+    with asdf.open(out, lazy_tree=True) as af:
+        assert [t.value for t in af["things"]] == [11, 12]
+        assert [af["more"][k].value for k in "pq"] == [23, 24]
+
+
+def _history_check(buff):
+    tree = _tags(buff)
+    entry = tree["history"]["entries"][0]
+    assert entry._tag == "tag:stsci.edu:asdf/core/history_entry-1.0.0"
+    assert entry["description"] == "made by hand"
+    assert entry["extra"]._tag == THING_1_0
+    assert entry["extra"]["value"] == -1
+    assert THING_EXTENSION in [ext["extension_uri"] for ext in tree["history"]["extensions"]]
+
+
+def test_history_entries_are_written_like_other_unconverted_nodes(thing_config, tmp_path):
+    out = io.BytesIO()
+    with asdf.open(io.BytesIO(HISTORY), lazy_tree=True) as af:
+        af.write_to(out)
+        assert "extensions" not in af["history"]
+    _history_check(out)
+    path = tmp_path / "history.asdf"
+    path.write_bytes(HISTORY)
+    with asdf.open(path, mode="rw", lazy_tree=True) as af:
+        af["n"] = 2
+        af.update()
+    _history_check(io.BytesIO(path.read_bytes()))
+    with asdf.open(path, lazy_tree=True) as af:
+        assert af["n"] == 2
+    blocks = tmp_path / "blocks.asdf"
+    with asdf.config_context() as cfg:
+        cfg.add_extension(_extension(THING_1_0))
+        af = asdf.AsdfFile({"arr": np.arange(4)})
+        af.add_history_entry("made by hand")
+        af["history"]["entries"][0]["extra"] = Thing(5)
+        af.write_to(blocks)
+    out = io.BytesIO()
+    with asdf.open(blocks, lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        af.write_to(out)
+        assert 5 in ThingConverter.loaded
+    with asdf.open(blocks, mode="rw", lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        af.update()
+        assert 5 in ThingConverter.loaded
+    for buff in (out, io.BytesIO(blocks.read_bytes())):
+        buff.seek(0)
+        with asdf.open(buff) as af:
+            assert af["history"]["entries"][0]["extra"].value == 5
+            assert list(af["arr"]) == [0, 1, 2, 3]
+
