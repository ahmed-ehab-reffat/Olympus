+def test_untouched_nodes_of_multiple_type_converters_keep_their_tag(thing_config, tmp_path):
+    thing_config.add_extension(CoinExtension())
+    out = io.BytesIO()
+    path = tmp_path / "coins.asdf"
+    path.write_bytes(COINS)
+    with asdf.open(io.BytesIO(COINS), lazy_tree=True) as af:
+        CoinConverter.loaded.clear()
+        af.info(max_rows=None, max_cols=None)
+        assert af.search(key="^n$").paths == ["root['n']"]
+        af.write_to(out)
+        assert CoinConverter.loaded == []
