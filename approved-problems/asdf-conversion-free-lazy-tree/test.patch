+def test_update_with_blocks_keeps_arrays_readable(thing_config, tmp_path):
+    path = tmp_path / "update.asdf"
+    base = np.arange(30, dtype="i8")
+    with asdf.config_context() as cfg:
+        cfg.add_extension(_extension(THING_1_0))
+        tree = {"g": np.arange(100.0), "t": Thing(3), "x": base[5:], "y": base[:4], "z": np.arange(8, dtype="u2")}
+        asdf.AsdfFile(tree).write_to(path)
+    with asdf.open(path, mode="rw", lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        assert "t (Thing)" in repr(af.search(key="^t$"))
+        assert ThingConverter.loaded == []
+        del af["g"]
+        af["x"][0] = -5
+        af.update()
+        assert ThingConverter.loaded == [3]
+        assert list(af["y"]) == [0, 1, 2, 3]
+        assert list(af["z"]) == list(range(8))
+    with asdf.open(path) as af:
+        assert af["x"][0] == -5
+        assert list(af["y"]) == [0, 1, 2, 3]
+        assert list(af["z"]) == list(range(8))
+        assert af["t"].value == 3
+
