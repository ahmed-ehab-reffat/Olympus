+def test_block_shared_with_an_array_stays_valid_after_reordering(thing_config, tmp_path):
+    thing_config.add_extension(HolderExtension())
+    path = tmp_path / "holder.asdf"
+    moved = tmp_path / "moved.asdf"
+    _holder_file(path)
+    with asdf.open(path, lazy_tree=True) as af:
+        HolderConverter.loaded.clear()
+        assert af.search(key="^holder$").paths == ["root['holder']"]
+        assert HolderConverter.loaded == []
+        af["first"] = af.tree.pop("first")
+        af.write_to(moved)
+    with asdf.open(path, mode="rw", lazy_tree=True) as af:
+        af["first"] = af.tree.pop("first")
+        af.update()
+        assert af["holder"].data.tolist() == [0, 1, 2, 3]
+    for target in (moved, path):
+        with asdf.open(target) as af:
+            assert af["holder"].data.tolist() == [0, 1, 2, 3]
+            assert af["first"].tolist() == [0, 1, 2, 3]
+            assert af["second"].tolist() == [10, 11, 12, 13, 14, 15]
+
