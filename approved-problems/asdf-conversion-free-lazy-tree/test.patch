+def test_search_results_render_and_replace_without_converting_other_nodes(thing_config):
+    buff = _write({"good": Thing(1), "bad": Thing(-1), "n": 2})
+    out = io.BytesIO()
+    with asdf.open(buff, lazy_tree=True) as af:
+        ThingConverter.loaded.clear()
+        result = af.search(key="^bad$")
+        assert "bad (Thing)" in repr(result)
+        assert "bad (Thing)" in repr(result.format(max_rows=None))
+        af.search(key="^good$").replace(7)
+        assert ThingConverter.loaded == []
+        assert af["good"] == 7
+        af.write_to(out)
+    tree = _tags(out)
+    assert tree["good"] == 7
+    assert tree["bad"]._tag == THING_1_0
