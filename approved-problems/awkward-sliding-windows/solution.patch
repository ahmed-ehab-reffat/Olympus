@@ -0,0 +1,102 @@
+# BSD 3-Clause License; see https://github.com/scikit-hep/awkward/blob/main/LICENSE
+
+from __future__ import annotations
+
+import awkward as ak
+from awkward._dispatch import high_level_function
+from awkward._layout import HighLevelContext
+from awkward._namedaxis import (
+    _get_named_axis,
+    _named_axis_to_positional_axis,
+    _remove_named_axis,
+)
+from awkward._nplikes.numpy_like import NumpyMetadata
+from awkward._regularize import regularize_axis
+
+__all__ = ("unwindows",)
+
+np = NumpyMetadata.instance()
+
+
+@high_level_function()
+def unwindows(
+    array, *, stride=1, axis=-2, highlevel=True, behavior=None, attrs=None
+):
+    """Lays every list of windows back over one another, undoing #ak.windows.
+
+    Args:
+        array: Array-like data (anything #ak.to_layout recognizes).
+        stride (int): Distance between the starts of consecutive windows; at
+            least 1.
+        axis (int or str): The dimension holding the windows, the one that
+            #ak.windows was applied at. The outermost dimension is `0`, followed
+            by `1`, etc., and negative values count backward from the innermost:
+            `-1` is the innermost dimension, `-2` is the next level up, etc.
+            If a str, it is interpreted as the name of the axis which maps
+            to an int if named axes are present. Named axes are attached
+            to an array using #ak.with_named_axis and removed with
+            #ak.without_named_axis; also see the
+            [Named axes user guide](../../user-guide/how-to-array-properties-named-axis.html).
+        highlevel (bool): If True, return an #ak.Array; otherwise, return
+            a low-level #ak.contents.Content subclass.
+        behavior (None or dict): Custom #ak.behavior for the output array, if
+            high-level.
+        attrs (None or dict): Custom attributes for the output array, if
+            high-level.
+
+    Returns:
+        An array with one fewer dimension than `array`, in which every list of
+        windows has become a single list.
+
+    Overlapping windows are laid back over one another:
+
+        >>> windows = ak.Array([[[1, 2, 3], [2, 3, 4], [3, 4, 5]], [[6, 7], [7, 8]]])
+        >>> ak.unwindows(windows).to_list()
+        [[1, 2, 3, 4, 5], [6, 7, 8]]
+
+    Two elements apart, the windows of the first list no longer overlap at all:
+
+        >>> ak.unwindows(windows, stride=3).to_list()
+        [[1, 2, 3, 2, 3, 4, 3, 4, 5], [6, 7, 7, 8]]
+
+    It recovers the lists that #ak.windows was given, as long as the windows
+    that ran off the end were kept:
+
+        >>> array = ak.Array([[1, 2, 3, 4], [5, 6], []])
+        >>> ak.unwindows(ak.windows(array, 3, incomplete="keep")).to_list()
+        [[1, 2, 3, 4], [5, 6], []]
+    """
+    # Dispatch
+    yield (array,)
+
+    # Implementation
+    return _impl(array, stride, axis, highlevel, behavior, attrs)
+
+
+def _impl(array, stride, axis, highlevel, behavior, attrs):
+    stride = ak._windowing.regularize_unwindows(stride)
+
+    with HighLevelContext(behavior=behavior, attrs=attrs) as ctx:
+        layout = ctx.unwrap(array, allow_record=False, primitive_policy="error")
+
+    named_axis = _get_named_axis(ctx)
+    axis = _named_axis_to_positional_axis(named_axis, axis)
+    axis = regularize_axis(axis, none_allowed=False)
+
+    out_named_axis = _remove_named_axis(
+        named_axis=named_axis,
+        axis=axis,
+        total=layout.minmax_depth[1],
+    )
+
+    out = ak._do.unwindows(layout, stride, axis)
+
+    wrapped_out = ctx.wrap(out, highlevel=highlevel)
+
+    return ak.operations.ak_with_named_axis._impl(
+        wrapped_out,
+        named_axis=out_named_axis,
+        highlevel=highlevel,
+        behavior=ctx.behavior,
+        attrs=ctx.attrs,
+    )
