diff --git a/src/awkward/_windowing.py b/src/awkward/_windowing.py
new file mode 100644
index 00000000..1328b267
--- /dev/null
+++ b/src/awkward/_windowing.py
@@ -0,0 +1,277 @@
+# BSD 3-Clause License; see https://github.com/scikit-hep/awkward/blob/main/LICENSE
+
+from __future__ import annotations
+
+import awkward as ak
+from awkward._backends.backend import Backend
+from awkward._nplikes.numpy_like import NumpyMetadata
+from awkward._nplikes.shape import unknown_length
+from awkward._regularize import is_integer
+from awkward._typing import Any
+from awkward.index import Index64
+
+np = NumpyMetadata.instance()
+
+INCOMPLETE_CHOICES = ("drop", "keep", "pad")
+ALIGN_CHOICES = ("left", "right")
+
+
+def regularize_windows(size, stride, incomplete, align) -> tuple[int, int, str, str]:
+    if not is_integer(size):
+        raise TypeError(f"size must be an integer, not {size!r}")
+    if not is_integer(stride):
+        raise TypeError(f"stride must be an integer, not {stride!r}")
+    size = int(size)
+    stride = int(stride)
+    if size < 1:
+        raise ValueError(f"size must be at least 1, not {size}")
+    if stride < 1:
+        raise ValueError(f"stride must be at least 1, not {stride}")
+    if incomplete not in INCOMPLETE_CHOICES:
+        raise ValueError(
+            "incomplete must be 'drop', 'keep', or 'pad', not {!r}".format(incomplete)
+        )
+    if align not in ALIGN_CHOICES:
+        raise ValueError(f"align must be 'left' or 'right', not {align!r}")
+    return size, stride, incomplete, align
+
+
+def window_count(length: int, size: int, stride: int, incomplete: str) -> int:
+    if length == 0:
+        return 0
+    elif incomplete == "drop":
+        if length < size:
+            return 0
+        else:
+            return (length - size) // stride + 1
+    else:
+        return (length - 1) // stride + 1
+
+
+def padded_window(content, parameters, incomplete: str):
+    """The content and window parameters to use for one windowed dimension.
+
+    A string or bytestring cannot hold missing characters, so padding gives up that
+    tag, and its characters give up theirs with it; every other parameter moves to the
+    windows unchanged.
+    """
+    if incomplete != "pad" or not parameters:
+        return content, parameters
+    if parameters.get("__array__") not in ("string", "bytestring"):
+        return content, parameters
+
+    def without_array(existing):
+        remaining = {k: v for k, v in (existing or {}).items() if k != "__array__"}
+        return remaining or None
+
+    return content.copy(parameters=without_array(content._parameters)), without_array(
+        parameters
+    )
+
+
+def _unknown_windows(backend: Backend, content, size, incomplete, parameters):
+    nplike = backend.nplike
+    if incomplete == "keep":
+        inner = ak.contents.ListOffsetArray(
+            Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike),
+            content._carry(
+                Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike),
+                False,
+            ),
+            parameters=parameters,
+        )
+    else:
+        gathered = content._carry(
+            Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike), False
+        )
+        if incomplete == "pad":
+            gathered = ak.contents.IndexedOptionArray.simplified(
+                Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike),
+                gathered,
+            )
+        inner = ak.contents.RegularArray(
+            gathered, size, unknown_length, parameters=parameters
+        )
+    return (
+        Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike),
+        inner,
+    )
+
+
+def windows_of_offsets(
+    backend: Backend,
+    offsets: Index64,
+    content,
+    size: int,
+    stride: int,
+    incomplete: str,
+    align: str,
+    parameters: dict[str, Any] | None,
+):
+    """Builds the windows of every list described by `offsets` over `content`.
+
+    Returns the offsets of the outer (one entry per input list) dimension and the
+    contents of that dimension, which is one list per window.
+    """
+    nplike = backend.nplike
+
+    content, parameters = padded_window(content, parameters, incomplete)
+
+    if not nplike.known_data:
+        return _unknown_windows(backend, content, size, incomplete, parameters)
+
+    offsets_data = nplike.asarray(offsets.data, dtype=np.int64)
+    starts = offsets_data[:-1]
+    lengths = offsets_data[1:] - starts
+
+    if incomplete == "drop":
+        counts = nplike.where(
+            lengths < size,
+            nplike.zeros_like(lengths),
+            (lengths - size) // stride + 1,
+        )
+    else:
+        counts = nplike.where(
+            lengths == 0,
+            nplike.zeros_like(lengths),
+            (lengths - 1) // stride + 1,
+        )
+
+    outer_offsets = nplike.empty(offsets_data.shape[0], dtype=np.int64)
+    outer_offsets[0] = 0
+    outer_offsets[1:] = nplike.cumsum(counts)
+    num_windows = int(outer_offsets[-1])
+
+    within = nplike.arange(num_windows, dtype=np.int64) - nplike.repeat(
+        outer_offsets[:-1], counts
+    )
+    window_lengths = nplike.repeat(lengths, counts)
+    window_bases = nplike.repeat(starts, counts)
+
+    if align == "left":
+        window_starts = within * stride
+    else:
+        window_starts = (
+            window_lengths - (nplike.repeat(counts, counts) - 1 - within) * stride - size
+        )
+
+    if incomplete == "keep":
+        clipped_starts = nplike.maximum(window_starts, nplike.zeros_like(window_starts))
+        clipped_stops = nplike.minimum(window_starts + size, window_lengths)
+        kept = clipped_stops - clipped_starts
+
+        inner_offsets = nplike.empty(num_windows + 1, dtype=np.int64)
+        inner_offsets[0] = 0
+        inner_offsets[1:] = nplike.cumsum(kept)
+        total = int(inner_offsets[-1])
+
+        local = nplike.arange(total, dtype=np.int64) - nplike.repeat(
+            inner_offsets[:-1], kept
+        )
+        carry = nplike.repeat(window_bases + clipped_starts, kept) + local
+        inner = ak.contents.ListOffsetArray(
+            Index64(inner_offsets, nplike=nplike),
+            content._carry(Index64(carry, nplike=nplike), False),
+            parameters=parameters,
+        )
+    else:
+        local = nplike.arange(num_windows * size, dtype=np.int64) % size
+        positions = nplike.repeat(window_starts, size) + local
+        carry = nplike.repeat(window_bases, size) + positions
+
+        if incomplete == "pad":
+            inside = (positions >= 0) & (positions < nplike.repeat(window_lengths, size))
+            gathered = content._carry(Index64(carry[inside], nplike=nplike), False)
+            outindex = nplike.full(num_windows * size, -1, dtype=np.int64)
+            outindex[inside] = nplike.arange(
+                nplike.shape_item_as_index(gathered.length), dtype=np.int64
+            )
+            gathered = ak.contents.IndexedOptionArray.simplified(
+                Index64(outindex, nplike=nplike), gathered
+            )
+        else:
+            gathered = content._carry(Index64(carry, nplike=nplike), False)
+
+        inner = ak.contents.RegularArray(
+            gathered, size, num_windows, parameters=parameters
+        )
+
+    return Index64(outer_offsets, nplike=nplike), inner
+
+
+def regularize_unwindows(stride) -> int:
+    if not is_integer(stride):
+        raise TypeError(f"stride must be an integer, not {stride!r}")
+    stride = int(stride)
+    if stride < 1:
+        raise ValueError(f"stride must be at least 1, not {stride}")
+    return stride
+
+
+def _unknown_merge(backend: Backend, content):
+    nplike = backend.nplike
+    return (
+        Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike),
+        content._carry(
+            Index64(nplike.empty(unknown_length, dtype=np.int64), nplike=nplike), False
+        ),
+    )
+
+
+def merge_windows(
+    backend: Backend,
+    outer_offsets: Index64,
+    inner_offsets: Index64,
+    content,
+    stride: int,
+):
+    """Lays the windows described by `inner_offsets` back over one another.
+
+    Window `j` of a list sits `j * stride` elements along, and contributes only what
+    the window before it did not reach. Returns the offsets of the rebuilt lists and
+    their elements.
+    """
+    nplike = backend.nplike
+
+    if not nplike.known_data:
+        return _unknown_merge(backend, content)
+
+    outer_data = nplike.asarray(outer_offsets.data, dtype=np.int64)
+    inner_data = nplike.asarray(inner_offsets.data, dtype=np.int64)
+
+    counts = outer_data[1:] - outer_data[:-1]
+    starts = inner_data[:-1]
+    lengths = inner_data[1:] - starts
+    num_windows = starts.shape[0]
+
+    within = nplike.arange(num_windows, dtype=np.int64) - nplike.repeat(
+        outer_data[:-1], counts
+    )
+    placed = within * stride
+    ends = placed + lengths
+
+    previous_ends = nplike.empty(num_windows, dtype=np.int64)
+    if num_windows > 0:
+        previous_ends[0] = 0
+        previous_ends[1:] = ends[:-1]
+        previous_ends[within == 0] = 0
+
+    skipped = nplike.maximum(previous_ends - placed, nplike.zeros_like(placed))
+    taken = nplike.maximum(lengths - skipped, nplike.zeros_like(lengths))
+
+    window_offsets = nplike.empty(num_windows + 1, dtype=np.int64)
+    window_offsets[0] = 0
+    window_offsets[1:] = nplike.cumsum(taken)
+    total = int(window_offsets[-1])
+
+    local = nplike.arange(total, dtype=np.int64) - nplike.repeat(
+        window_offsets[:-1], taken
+    )
+    carry = nplike.repeat(starts + skipped, taken) + local
+
+    rebuilt_offsets = window_offsets[outer_data]
+
+    return (
+        Index64(rebuilt_offsets, nplike=nplike),
+        content._carry(Index64(carry, nplike=nplike), False),
+    )
