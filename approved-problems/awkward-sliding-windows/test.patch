+
+
+def test_axis_zero_with_keep_and_right_align():
+    assert ak.windows(
+        ak.Array([1, 2, 3]), 2, axis=0, incomplete="keep", align="right"
+    ).to_list() == [[1], [1, 2], [2, 3]]
+
+
+def test_axis_beyond_the_depth_is_an_axis_error():
+    with pytest.raises(np.exceptions.AxisError):
+        ak.windows(ak.Array([1, 2, 3]), 2, axis=1)
+
+
+def test_axis_two_beyond_the_depth_is_an_axis_error():
+    with pytest.raises(np.exceptions.AxisError):
+        ak.windows(ragged(), 2, axis=2)
+
+
+def test_dimensions_outside_axis_are_left_alone():
+    out = ak.windows(nested(), 2, axis=2)
+    assert ak.num(out, axis=1).to_list() == ak.num(nested(), axis=1).to_list()
+
+
+def test_fixed_size_lists_give_a_fixed_size_window_dimension():
+    array = ak.Array(np.arange(12).reshape(3, 4))
+    assert str(ak.windows(array, 2).type) == "3 * 3 * 2 * int64"
+
+
+def test_fixed_size_lists_hold_the_expected_windows():
+    array = ak.Array(np.arange(6).reshape(2, 3))
+    assert ak.windows(array, 2).to_list() == [
+        [[0, 1], [1, 2]],
+        [[3, 4], [4, 5]],
+    ]
+
+
+def test_fixed_size_lists_with_keep_have_variable_windows():
+    array = ak.Array(np.arange(12).reshape(3, 4))
+    assert str(ak.windows(array, 3, incomplete="keep").type) == "3 * 4 * var * int64"
+
+
+def test_fixed_size_lists_with_pad():
+    array = ak.Array(np.arange(6).reshape(2, 3))
+    assert str(ak.windows(array, 2, incomplete="pad").type) == "2 * 3 * 2 * ?int64"
+    assert ak.windows(array, 2, incomplete="pad").to_list() == [
+        [[0, 1], [1, 2], [2, None]],
+        [[3, 4], [4, 5], [5, None]],
+    ]
+
+
+def test_fixed_size_lists_shorter_than_size_give_an_empty_dimension():
+    array = ak.Array(np.arange(4).reshape(2, 2))
+    assert str(ak.windows(array, 3).type) == "2 * 0 * 3 * int64"
+    assert ak.windows(array, 3).to_list() == [[], []]
+
+
+def test_fixed_size_lists_with_stride():
+    array = ak.Array(np.arange(10).reshape(2, 5))
+    assert ak.windows(array, 2, stride=3).to_list() == [
+        [[0, 1], [3, 4]],
+        [[5, 6], [8, 9]],
+    ]
+
+
+def test_a_missing_list_stays_missing():
+    assert ak.windows(optional_lists(), 2).to_list() == [
+        [[1, 2], [2, 3]],
+        None,
+        [[4, 5]],
+    ]
+
+
+def test_a_missing_list_keeps_its_option_type():
+    assert (
+        str(ak.windows(optional_lists(), 2).type) == "3 * option[var * 2 * int64]"
+    )
+
+
+def test_a_missing_list_stays_missing_when_keeping():
+    assert ak.windows(optional_lists(), 3, incomplete="keep").to_list() == [
+        [[1, 2, 3], [2, 3], [3]],
+        None,
+        [[4, 5], [5]],
+    ]
+
+
+def test_a_missing_list_stays_missing_when_padding():
+    assert ak.windows(optional_lists(), 2, incomplete="pad").to_list() == [
+        [[1, 2], [2, 3], [3, None]],
+        None,
+        [[4, 5], [5, None]],
+    ]
+
+
+def test_byte_masked_lists_stay_missing():
+    assert ak.windows(byte_masked(), 2).to_list() == [
+        [[1, 2], [2, 3]],
+        None,
+        [[4, 5]],
+    ]
+
+
+def test_bit_masked_lists_stay_missing():
+    assert ak.windows(bit_masked(), 2).to_list() == [
+        [[1, 2], [2, 3]],
+        None,
+        [[4, 5]],
+    ]
+
+
+def test_unmasked_lists_are_windowed():
+    array = ak.Array(ak.contents.UnmaskedArray(ak.Array([[1, 2, 3]]).layout))
+    assert ak.windows(array, 2).to_list() == [[[1, 2], [2, 3]]]
+
+
+def test_missing_values_inside_a_list_are_ordinary_elements():
+    assert ak.windows(ak.Array([[1, None, 3]]), 2).to_list() == [
