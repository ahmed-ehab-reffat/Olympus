+
+
+def test_axis_one_windows_the_outer_lists():
+    assert ak.windows(nested(), 2, axis=1).to_list() == [
+        [[[1, 2, 3], [4, 5]]],
+        [],
+    ]
+
+
+def test_negative_axis_two_is_the_same_as_axis_one():
+    assert (
+        ak.windows(nested(), 2, axis=-2).to_list()
