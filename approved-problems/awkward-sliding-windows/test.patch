+    assert out.to_list() == [[[1, None], [None, 3], [3, None]]]
+    assert str(out.type) == "1 * var * 2 * ?int64"
+
+
+def test_lists_reached_through_an_index():
+    assert ak.windows(indexed_lists(), 2).to_list() == [
+        [[5, 6], [6, 7]],
+        [[1, 2]],
+    ]
+
+
+def test_lists_of_records():
+    array = ak.Array([[{"x": 1}, {"x": 2}, {"x": 3}]])
+    assert ak.windows(array, 2).to_list() == [
