+    )
+
+
+def test_axis_zero_windows_the_array_itself():
+    assert ak.windows(ak.Array([1, 2, 3, 4]), 3, axis=0).to_list() == [
+        [1, 2, 3],
+        [2, 3, 4],
+    ]
+
+
+def test_a_flat_array_is_windowed_by_default():
+    assert ak.windows(ak.Array([1, 2, 3, 4]), 2).to_list() == [
+        [1, 2],
+        [2, 3],
+        [3, 4],
+    ]
+
+
+def test_axis_zero_result_has_one_more_dimension():
+    assert str(ak.windows(ak.Array([1, 2, 3, 4]), 2, axis=0).type) == "3 * 2 * int64"
+
+
+def test_axis_zero_of_lists_keeps_the_lists_whole():
+    assert ak.windows(ragged(), 2, axis=0).to_list() == [
+        [[1, 2, 3, 4], [5, 6]],
