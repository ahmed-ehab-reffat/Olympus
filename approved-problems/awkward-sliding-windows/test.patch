+def dispatch_sentinel():
+    captured = []
+
+    def __awkward_function__(func, array_likes, args, kwargs):
+        captured[:] = list(array_likes)
+        return "intercepted"
+
+    return types.SimpleNamespace(
+        captured=captured, __awkward_function__=__awkward_function__
+    )
