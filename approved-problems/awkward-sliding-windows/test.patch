+# BSD 3-Clause License; see https://github.com/scikit-hep/awkward/blob/main/LICENSE
+
+from __future__ import annotations
+
+import types
+
+import numpy as np
+import pytest
+
+import awkward as ak
+
+
+def ragged():
+    return ak.Array([[1, 2, 3, 4], [5, 6], [], [7]])
+
+
+def seven():
+    return ak.Array([[0, 1, 2, 3, 4, 5, 6]])
+
+
+def optional_lists():
+    return ak.Array([[1, 2, 3], None, [4, 5]])
+
+
+def nested():
+    return ak.Array([[[1, 2, 3], [4, 5]], [[6, 7, 8, 9]]])
+
+
+def byte_masked():
+    return ak.Array(
+        ak.contents.ByteMaskedArray(
+            ak.index.Index8(np.array([1, 0, 1], dtype=np.int8)),
+            ak.Array([[1, 2, 3], [9, 9, 9], [4, 5]]).layout,
+            valid_when=True,
+        )
+    )
+
+
+def bit_masked():
+    return ak.Array(
+        ak.contents.BitMaskedArray(
+            ak.index.IndexU8(np.array([0b101], dtype=np.uint8)),
+            ak.Array([[1, 2, 3], [9], [4, 5]]).layout,
+            valid_when=True,
+            length=3,
+            lsb_order=True,
+        )
+    )
+
+
+def indexed_lists():
+    return ak.Array(
+        ak.contents.IndexedArray(
+            ak.index.Index64(np.array([2, 0], dtype=np.int64)),
+            ak.Array([[1, 2], [9, 9], [5, 6, 7]]).layout,
+        )
+    )
+
+
+def unordered_list_array():
+    return ak.Array(
+        ak.contents.ListArray(
+            ak.index.Index64(np.array([4, 0, 2], dtype=np.int64)),
+            ak.index.Index64(np.array([7, 3, 2], dtype=np.int64)),
+            ak.contents.NumpyArray(np.arange(10)),
+        )
+    )
+
+
+def union_of_lists():
+    return ak.concatenate(
+        [ak.Array([[1, 2, 3]]), ak.Array([[{"x": 1}, {"x": 2}, {"x": 3}]])]
+    )
+
+
+def traced(array):
+    return ak.Array(ak.to_layout(array).to_typetracer(forget_length=True))
+
+
+def assert_sound(out):
+    assert ak.validity_error(out) == ""
+    assert ak.to_packed(out).to_list() == out.to_list()
+    form, length, container = ak.to_buffers(out)
+    assert ak.from_buffers(form, length, container).to_list() == out.to_list()
+
+
+def test_left_drop_windows_of_each_list():
+    assert ak.windows(ragged(), 3).to_list() == [
+        [[1, 2, 3], [2, 3, 4]],
+        [],
+        [],
+        [],
+    ]
+
+
+def test_size_one_makes_every_element_a_window():
+    assert ak.windows(ragged(), 1).to_list() == [
+        [[1], [2], [3], [4]],
+        [[5], [6]],
+        [],
+        [[7]],
+    ]
+
+
+def test_size_equal_to_the_list_length_gives_one_window():
+    assert ak.windows(ragged(), 4).to_list() == [[[1, 2, 3, 4]], [], [], []]
+
+
+def test_size_above_every_length_gives_no_windows():
+    assert ak.windows(ragged(), 5).to_list() == [[], [], [], []]
+
+
+def test_stride_two_starts_every_other_element():
+    assert ak.windows(ragged(), 2, stride=2).to_list() == [
+        [[1, 2], [3, 4]],
+        [[5, 6]],
+        [],
+        [],
+    ]
+
+
+def test_stride_wider_than_size_leaves_elements_out():
+    assert ak.windows(seven(), 2, stride=3).to_list() == [[[0, 1], [3, 4]]]
+
+
+def test_stride_wider_than_the_list_gives_one_window():
+    assert ak.windows(seven(), 2, stride=10).to_list() == [[[0, 1]]]
+
+
+def test_empty_list_gives_no_windows_when_dropping():
+    assert ak.windows(ak.Array([[]]), 1).to_list() == [[]]
+
+
+def test_windows_come_in_the_order_they_begin():
+    out = ak.windows(seven(), 3, stride=2).to_list()[0]
+    assert out == [[0, 1, 2], [2, 3, 4], [4, 5, 6]]
+    assert [window[0] for window in out] == [0, 2, 4]
+
+
+def test_dropped_windows_are_fixed_size_lists():
+    assert str(ak.windows(ragged(), 3).type) == "4 * var * 3 * int64"
+
+
+def test_the_input_is_left_alone():
+    array = ragged()
+    ak.windows(array, 2, incomplete="pad")
+    assert array.to_list() == [[1, 2, 3, 4], [5, 6], [], [7]]
+
+
+def test_keep_cuts_windows_off_at_the_end_of_the_list():
+    assert ak.windows(ragged(), 3, incomplete="keep").to_list() == [
+        [[1, 2, 3], [2, 3, 4], [3, 4], [4]],
+        [[5, 6], [6]],
+        [],
+        [[7]],
+    ]
+
+
+def test_keep_of_a_list_shorter_than_size():
+    assert ak.windows(ak.Array([[1, 2]]), 5, incomplete="keep").to_list() == [
+        [[1, 2], [2]]
+    ]
+
+
+def test_keep_gives_an_empty_list_no_windows():
+    assert ak.windows(ak.Array([[]]), 3, incomplete="keep").to_list() == [[]]
+
+
+def test_kept_windows_are_variable_length_lists():
+    assert (
+        str(ak.windows(ragged(), 3, incomplete="keep").type) == "4 * var * var * int64"
+    )
+
+
+def test_keep_with_stride_two():
+    assert ak.windows(ragged(), 3, stride=2, incomplete="keep").to_list() == [
+        [[1, 2, 3], [3, 4]],
+        [[5, 6]],
+        [],
+        [[7]],
+    ]
+
+
+def test_keep_with_stride_wider_than_size():
+    assert ak.windows(seven(), 2, stride=3, incomplete="keep").to_list() == [
+        [[0, 1], [3, 4], [6]]
+    ]
+
+
+def test_keep_and_drop_agree_when_size_is_one():
+    assert (
+        ak.windows(ragged(), 1, incomplete="keep").to_list()
+        == ak.windows(ragged(), 1).to_list()
+    )
+
+
+def test_pad_fills_the_end_of_a_cut_window():
+    assert ak.windows(ragged(), 3, incomplete="pad").to_list() == [
+        [[1, 2, 3], [2, 3, 4], [3, 4, None], [4, None, None]],
+        [[5, 6, None], [6, None, None]],
+        [],
+        [[7, None, None]],
+    ]
+
+
+def test_padded_windows_are_fixed_size_and_optional():
+    assert (
+        str(ak.windows(ragged(), 3, incomplete="pad").type) == "4 * var * 3 * ?int64"
+    )
+
+
+def test_pad_of_a_list_shorter_than_size():
+    assert ak.windows(ak.Array([[1, 2]]), 4, incomplete="pad").to_list() == [
+        [[1, 2, None, None], [2, None, None, None]]
+    ]
+
+
+def test_pad_gives_an_empty_list_no_windows():
+    assert ak.windows(ak.Array([[]]), 3, incomplete="pad").to_list() == [[]]
+
+
+def test_pad_with_stride_two():
+    assert ak.windows(ragged(), 3, stride=2, incomplete="pad").to_list() == [
+        [[1, 2, 3], [3, 4, None]],
+        [[5, 6, None]],
+        [],
+        [[7, None, None]],
+    ]
+
+
+def test_pad_and_keep_produce_the_same_number_of_windows():
+    kept = ak.num(ak.windows(ragged(), 3, stride=2, incomplete="keep"), axis=1)
+    padded = ak.num(ak.windows(ragged(), 3, stride=2, incomplete="pad"), axis=1)
+    assert kept.to_list() == padded.to_list()
+
+
+def test_right_aligned_dropped_windows_end_at_the_last_element():
+    assert ak.windows(ragged(), 3, stride=2, align="right").to_list() == [
+        [[2, 3, 4]],
+        [],
+        [],
+        [],
+    ]
+
+
+def test_right_aligned_windows_with_stride_three():
+    assert ak.windows(seven(), 2, stride=3, align="right").to_list() == [
+        [[2, 3], [5, 6]]
+    ]
+
+
+def test_right_aligned_keep_cuts_the_first_windows_off():
+    assert ak.windows(ragged(), 3, incomplete="keep", align="right").to_list() == [
+        [[1], [1, 2], [1, 2, 3], [2, 3, 4]],
+        [[5], [5, 6]],
+        [],
+        [[7]],
+    ]
+
+
+def test_right_aligned_keep_with_stride_two():
+    assert ak.windows(
+        ragged(), 3, stride=2, incomplete="keep", align="right"
+    ).to_list() == [[[1, 2], [2, 3, 4]], [[5, 6]], [], [[7]]]
+
+
+def test_right_aligned_pad_fills_the_front():
+    assert ak.windows(ragged(), 3, incomplete="pad", align="right").to_list() == [
+        [[None, None, 1], [None, 1, 2], [1, 2, 3], [2, 3, 4]],
+        [[None, None, 5], [None, 5, 6]],
+        [],
+        [[None, None, 7]],
+    ]
+
+
+def test_right_aligned_pad_of_a_short_list():
+    assert ak.windows(
+        ak.Array([[1, 2]]), 4, incomplete="pad", align="right"
+    ).to_list() == [[[None, None, None, 1], [None, None, 1, 2]]]
+
+
+def test_right_aligned_windows_come_in_the_order_they_begin():
+    out = ak.windows(seven(), 3, stride=2, align="right").to_list()[0]
+    assert out == [[0, 1, 2], [2, 3, 4], [4, 5, 6]]
+
+
+def test_both_alignments_give_the_same_number_of_windows():
+    for size in (1, 2, 3, 4, 8):
+        for stride in (1, 2, 3, 5):
+            for incomplete in ("drop", "keep", "pad"):
+                left = ak.num(
+                    ak.windows(
+                        ragged(), size, stride=stride, incomplete=incomplete
+                    ),
+                    axis=1,
+                )
+                right = ak.num(
+                    ak.windows(
+                        ragged(),
+                        size,
+                        stride=stride,
+                        incomplete=incomplete,
+                        align="right",
+                    ),
+                    axis=1,
+                )
+                assert left.to_list() == right.to_list()
+
+
+def test_right_aligned_padded_windows_are_fixed_size_and_optional():
+    assert (
+        str(ak.windows(ragged(), 2, incomplete="pad", align="right").type)
+        == "4 * var * 2 * ?int64"
+    )
+
+
+def test_default_axis_windows_the_innermost_lists():
+    assert (
+        ak.windows(nested(), 2).to_list() == ak.windows(nested(), 2, axis=2).to_list()
+    )
+
+
+def test_axis_two_windows_the_inner_lists():
+    assert ak.windows(nested(), 2, axis=2).to_list() == [
+        [[[1, 2], [2, 3]], [[4, 5]]],
+        [[[6, 7], [7, 8], [8, 9]]],
