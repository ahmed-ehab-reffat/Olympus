+import os.path
+
+from pathlib import Path
+
+from siliconcompiler import Design
+
+
+def touch(*paths):
+    for path in paths:
+        directory = os.path.dirname(path)
+        if directory:
+            os.makedirs(directory, exist_ok=True)
+        open(path, "w").close()
+
+
+def abspath(*parts):
+    return os.path.abspath(os.path.join(*parts))
+
+
+def make_lib(name, source):
+    lib = Design(name)
+    lib.set_dataroot("root", os.path.abspath("work"))
+    with lib.active_fileset("rtl"), lib.active_dataroot("root"):
+        lib.set_topmodule(name)
+        lib.add_file(source)
+        lib.add_idir("inc")
+        lib.add_define("WIDTH=8")
+    return lib
+
+
+def make_top():
+    touch("work/inc/shared.vh", "work/alib/increment.v", "work/blib/heartbeat.v", "work/top.v")
+    top = Design("top")
+    top.set_dataroot("root", os.path.abspath("work"))
+    top.add_dep(make_lib("alib", "alib/increment.v"))
+    top.add_dep(make_lib("blib", "blib/heartbeat.v"))
+    with top.active_fileset("rtl"), top.active_dataroot("root"):
+        top.set_topmodule("top")
+        top.add_file("top.v")
+        top.add_depfileset("alib", "rtl")
+        top.add_depfileset("blib", "rtl")
+    return top
+
+
+def test_write_default_output_unchanged():
+    make_top().write_fileset("flat.f", fileset="rtl")
+
+    assert Path("flat.f").read_text().splitlines() == [
+        f"+incdir+{abspath('work/inc')}",
+        "+define+WIDTH=8",
+        f"{abspath('work/alib/increment.v')}",
+        f"// +incdir+{abspath('work/inc')}",
+        "// +define+WIDTH=8",
+        f"{abspath('work/blib/heartbeat.v')}",
+        f"{abspath('work/top.v')}",
+    ]
+
+
+def test_write_default_output_omits_the_rest_of_the_fileset():
+    touch("work/core.v", "work/inc/shared.vh", "work/vendor/cell.v")
+    lib = Design("loaded")
+    lib.set_dataroot("root", os.path.abspath("work"))
+    with lib.active_fileset("rtl"), lib.active_dataroot("root"):
+        lib.set_topmodule("core")
+        lib.add_file("core.v")
+        lib.add_idir("inc")
+        lib.add_libdir("vendor")
+        lib.add_define("WIDTH=8")
+        lib.add_undefine("DEBUG")
+        lib.add_lib("stdcells")
+        lib.set_param("DEPTH", "4")
+
+    lib.write_fileset("flat.f", fileset="rtl")
+
+    assert Path("flat.f").read_text().splitlines() == [
+        f"+incdir+{abspath('work/inc')}",
+        "+define+WIDTH=8",
+        f"{abspath('work/core.v')}",
+    ]
+
+
+def test_read_unmarked_list_unchanged(datadir):
+    read = Design("test")
+    read.read_fileset(os.path.join(datadir, "heartbeat.f"), fileset="rtl")
+
+    assert read.get("deps") == []
+    assert read.get_define("rtl") == ["ASIC"]
+    assert read.get_idir("rtl") == [os.path.abspath(datadir)]
+    assert [read.get("dataroot", name, "path") for name in read.getkeys("dataroot")] == [
+        os.path.abspath(datadir)]
+    assert read.get_file("rtl") == [
+        os.path.abspath(os.path.join(datadir, "heartbeat.v")),
+        os.path.abspath(os.path.join(datadir, "increment.v")),
+    ]
+
+
+def test_read_unmarked_list_with_two_directories_unchanged():
+    touch("files1/heartbeat.v", "files2/increment.v")
+    with open("flist.f", "w") as fileobj:
+        fileobj.write("files1/heartbeat.v\n")
+        fileobj.write("files2/increment.v\n")
+
+    read = Design("test")
+    read.read_fileset("flist.f", fileset="rtl")
+
+    assert [read.get("dataroot", name, "path") for name in read.getkeys("dataroot")] == [
+        abspath("files1"), abspath("files2")]
+    assert read.get_file("rtl") == [
+        abspath("files1/heartbeat.v"), abspath("files2/increment.v")]
+
+
+def write_list(name, *lines):
+    directory = os.path.dirname(name)
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    with open(name, "w") as fileobj:
+        for line in lines:
+            fileobj.write(f"{line}\n")
+    return os.path.abspath(name)
+
+
+def test_read_unmarked_list_infers_every_type_from_the_extension():
+    touch("work/a.v", "work/b.sv", "work/c.vhd")
+    write_list("work/p.f",
+               abspath("work/a.v"),
+               abspath("work/b.sv"),
+               abspath("work/c.vhd"))
+
+    read = Design("reader")
+    read.read_fileset("work/p.f", fileset="rtl")
+
+    assert read.get_file("rtl", filetype="verilog") == [abspath("work/a.v")]
+    assert read.get_file("rtl", filetype="systemverilog") == [abspath("work/b.sv")]
+    assert read.get_file("rtl", filetype="vhdl") == [abspath("work/c.vhd")]
