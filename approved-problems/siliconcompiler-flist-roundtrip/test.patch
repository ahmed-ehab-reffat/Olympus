diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..1e2d22b
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,110 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="$(pwd)/results.xml"
+fi
+case "$OUTPUT_PATH" in
+  /*) ;;
+  *) OUTPUT_PATH="$(pwd)/$OUTPUT_PATH" ;;
+esac
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd /app
+
+RUNDIR=""
+for candidate in "${TMPDIR:-/tmp}" /tmp /app; do
+  [ -d "$candidate" ] && [ -w "$candidate" ] || continue
+  if mkdir -p "$candidate/sc-flist-run.$$" 2>/dev/null; then
+    RUNDIR="$candidate/sc-flist-run.$$"
+    break
+  fi
+done
+if [ -z "$RUNDIR" ]; then
+  RUNDIR="/app/sc-flist-run.$$"
+  mkdir -p "$RUNDIR"
+fi
+trap 'rm -rf "$RUNDIR"' EXIT
+
+fail_junit() {
+  DIAG=$(sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' "$2" 2>/dev/null)
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  {
+    printf '<?xml version="1.0" encoding="utf-8"?>\n'
+    printf '<testsuites><testsuite name="pytest" errors="0" failures="1" skipped="0" tests="1" time="0">\n'
+    printf '<testcase classname="testsuite" name="collection" time="0">\n'
+    printf '<failure message="%s">%s</failure>\n' "$1" "$DIAG"
+    printf '</testcase></testsuite></testsuites>\n'
+  } > "$OUTPUT_PATH"
+  exit 1
+}
+
+export HOME="$RUNDIR"
+export TMPDIR="$RUNDIR"
+export PYTHONDONTWRITEBYTECODE=1
+
+NEW_TESTS="tests/test_design_flist_0dc9af.py"
+
+BASE_TESTS="tests/test_design.py tests/test_design_flist_base_0dc9af.py tests/test_library.py tests/schema_support"
+
+if [ "$MODE" = "new" ]; then
+  TARGETS="$NEW_TESTS"
+else
+  TARGETS="$BASE_TESTS"
+fi
+
+ABS_TARGETS=""
+MISSING=""
+for t in $TARGETS; do
+  if [ -e "/app/$t" ]; then
+    ABS_TARGETS="$ABS_TARGETS /app/$t"
+  else
+    MISSING="$MISSING /app/$t"
+  fi
+done
+
+LOG="$RUNDIR/pytest.log"
+if [ -n "$MISSING" ]; then
+  {
+    echo "missing test targets:$MISSING"
+    echo "contents of /app:"
+    ls -a /app
+  } > "$LOG" 2>&1
+  cat "$LOG"
+  fail_junit "configured test targets are missing" "$LOG"
+fi
+
+cd "$RUNDIR"
+python -m pytest $ABS_TARGETS \
+  -p no:randomly \
+  -p no:cacheprovider \
+  -m "not eda and not docker and not nightly and not slurm" \
+  --rootdir=/app \
+  -c /app/pyproject.toml \
+  --basetemp="$RUNDIR/pytest" \
+  --junitxml="$OUTPUT_PATH" \
+  -q >> "$LOG" 2>&1
+EXIT_CODE=$?
+cat "$LOG"
+
+if [ ! -f "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  tail -n 60 "$LOG" > "$RUNDIR/tail.log" 2>/dev/null
+  fail_junit "pytest produced no test results (exit $EXIT_CODE)" "$RUNDIR/tail.log"
+fi
+
+sed -i 's/::/./g' "$OUTPUT_PATH"
+
+exit $EXIT_CODE
diff --git a/tests/test_design_flist_0dc9af.py b/tests/test_design_flist_0dc9af.py
new file mode 100644
index 0000000..e6c1fbd
--- /dev/null
+++ b/tests/test_design_flist_0dc9af.py
@@ -0,0 +1,1003 @@
+import os.path
+
+from pathlib import Path
+
+from siliconcompiler import Design
+
+
+def touch(*paths):
+    created = []
+    for path in paths:
+        directory = os.path.dirname(path)
+        if directory:
+            os.makedirs(directory, exist_ok=True)
+        open(path, "w").close()
+        created.append(os.path.abspath(path))
+    return created
+
+
+def write_list(name, *lines):
+    directory = os.path.dirname(name)
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    with open(name, "w") as fileobj:
+        for line in lines:
+            fileobj.write(f"{line}\n")
+    return os.path.abspath(name)
+
+
+def make_lib(name, source):
+    lib = Design(name)
+    lib.set_dataroot("root", os.path.abspath("work"))
+    with lib.active_fileset("rtl"), lib.active_dataroot("root"):
+        lib.set_topmodule(name)
+        lib.add_file(source)
+        lib.add_idir("inc")
+        lib.add_define("WIDTH=8")
+    return lib
+
+
+def make_top():
+    touch("work/inc/shared.vh", "work/alib/increment.v", "work/blib/heartbeat.v", "work/top.v")
+    top = Design("top")
+    top.set_dataroot("root", os.path.abspath("work"))
+    top.add_dep(make_lib("alib", "alib/increment.v"))
+    top.add_dep(make_lib("blib", "blib/heartbeat.v"))
+    with top.active_fileset("rtl"), top.active_dataroot("root"):
+        top.set_topmodule("top")
+        top.add_file("top.v")
+        top.add_depfileset("alib", "rtl")
+        top.add_depfileset("blib", "rtl")
+    return top
+
+
+def make_chain():
+    touch("work/head.v", "work/middle.v", "work/tail.v", "work/inc/shared.vh")
+    tail = Design("tail")
+    tail.set_dataroot("root", os.path.abspath("work"))
+    with tail.active_fileset("rtl"), tail.active_dataroot("root"):
+        tail.set_topmodule("tail")
+        tail.add_file("tail.v")
+
+    middle = Design("middle")
+    middle.set_dataroot("root", os.path.abspath("work"))
+    middle.add_dep(tail)
+    with middle.active_fileset("rtl"), middle.active_dataroot("root"):
+        middle.set_topmodule("middle")
+        middle.add_file("middle.v")
+        middle.add_depfileset("tail", "rtl")
+
+    head = Design("head")
+    head.set_dataroot("root", os.path.abspath("work"))
+    head.add_dep(middle)
+    with head.active_fileset("rtl"), head.active_dataroot("root"):
+        head.set_topmodule("head")
+        head.add_file("head.v")
+        head.add_depfileset("middle", "rtl")
+    return head
+
+
+def make_loaded():
+    touch("work/lib/core.v", "work/lib/pkg.sv", "work/inc/shared.vh", "work/vendor/cell.v")
+    lib = Design("loaded")
+    lib.set_dataroot("root", os.path.abspath("work"))
+    with lib.active_fileset("rtl"), lib.active_dataroot("root"):
+        lib.set_topmodule("core")
+        lib.add_file("lib/core.v")
+        lib.add_file("lib/pkg.sv", filetype="verilog")
+        lib.add_idir("inc")
+        lib.add_libdir("vendor")
+        lib.add_define("WIDTH=8")
+        lib.add_undefine("DEBUG")
+        lib.add_lib("stdcells")
+        lib.set_param("DEPTH", "4")
+        lib.set_param("ADDR", "16")
+    return lib
+
+
+def abspath(*parts):
+    return os.path.abspath(os.path.join(*parts))
+
+
+def lines(path):
+    return Path(path).read_text().splitlines()
+
+
+def markers(path):
+    found = []
+    for line in lines(path):
+        fields = line.split()
+        if fields and fields[0] == "//" and fields[1:2] and \
+                fields[1] in ("sc-fileset", "sc-depfileset", "sc-filetype"):
+            found.append(" ".join(fields[1:]))
+    return found
+
+
+def roundtrip(design, name="top", fileset="rtl"):
+    design.write_fileset("graph.f", fileset="rtl", hierarchy=True)
+    read = Design(name)
+    read.read_fileset("graph.f", fileset=fileset)
+    return read
+
+
+def dataroot_paths(design):
+    return sorted(design.get("dataroot", name, "path") for name in design.getkeys("dataroot"))
+
+
+def stored_files(design, fileset="rtl", filetype="verilog"):
+    return design.get("fileset", fileset, "file", filetype)
+
+
+def unrooted_entries(design, fileset="rtl"):
+    roots = {name: os.path.abspath(design.get("dataroot", name, "path"))
+             for name in design.getkeys("dataroot")}
+
+    keypaths = [("idir",), ("libdir",)]
+    keypaths += [("file", filetype) for filetype in design.getkeys("fileset", fileset, "file")]
+
+    found = []
+    for keypath in keypaths:
+        values = design.get("fileset", fileset, *keypath)
+        names = design.get("fileset", fileset, *keypath, field="dataroot")
+        for value, name in zip(values, names):
+            root = roots.get(name)
+            if root is None:
+                found.append((keypath, value, name))
+                continue
+            resolved = os.path.abspath(os.path.join(root, value))
+            if os.path.relpath(resolved, root).split(os.sep)[0] == os.pardir:
+                found.append((keypath, value, name))
+    return found
+
+
+def test_write_hierarchy_marks_every_group():
+    make_top().write_fileset("graph.f", fileset="rtl", hierarchy=True)
+
+    assert markers("graph.f") == [
+        "sc-fileset alib rtl",
+        "sc-filetype verilog",
+        "sc-fileset blib rtl",
+        "sc-filetype verilog",
+        "sc-fileset top rtl",
+        "sc-depfileset alib rtl",
+        "sc-depfileset blib rtl",
+        "sc-filetype verilog",
+    ]
+
+
+def test_write_hierarchy_records_dependency_edges_on_owning_group():
+    make_top().write_fileset("graph.f", fileset="rtl", hierarchy=True)
+
+    content = lines("graph.f")
+    index = content.index("// sc-fileset top rtl")
+
+    assert content[index + 1] == "// sc-depfileset alib rtl"
+    assert content[index + 2] == "// sc-depfileset blib rtl"
+
+
+def test_write_hierarchy_records_aliased_dependency_under_replacement():
+    top = make_top()
+    touch("work/clib/increment.v")
+    clib = make_lib("clib", "clib/increment.v")
+
+    top.write_fileset("graph.f", fileset="rtl", hierarchy=True,
+                      depalias={("alib", "rtl"): (clib, "rtl")})
+
+    assert "sc-fileset clib rtl" in markers("graph.f")
+    assert "sc-depfileset clib rtl" in markers("graph.f")
+    assert "sc-depfileset alib rtl" not in markers("graph.f")
+
+
+def test_write_hierarchy_repeats_entry_carried_by_an_earlier_group():
+    make_top().write_fileset("graph.f", fileset="rtl", hierarchy=True)
+
+    content = lines("graph.f")
+
+    assert content.count(f"+incdir+{abspath('work/inc')}") == 2
+    assert content.count("+define+WIDTH=8") == 2
+    assert "// +define+WIDTH=8" not in content
+
+
+def test_write_hierarchy_writes_the_whole_group_in_order():
+    make_loaded().write_fileset("graph.f", fileset="rtl", hierarchy=True)
+
+    assert lines("graph.f") == [
+        "// sc-fileset loaded rtl",
+        "-top core",
+        f"+incdir+{abspath('work/inc')}",
+        f"-y {abspath('work/vendor')}",
+        "+define+WIDTH=8",
+        "+undefine+DEBUG",
+        "-GADDR=16",
+        "-GDEPTH=4",
+        "-v stdcells",
+        "// sc-filetype verilog",
+        f"{abspath('work/lib/core.v')}",
+        f"{abspath('work/lib/pkg.sv')}",
+    ]
+
+
+def test_write_hierarchy_orders_parameters_by_name():
+    lib = make_loaded()
+    lib.set_param("BBB", "1", fileset="rtl")
+
+    lib.write_fileset("graph.f", fileset="rtl", hierarchy=True)
+
+    content = lines("graph.f")
+    assert [line for line in content if line.startswith("-G")] == [
+        "-GADDR=16", "-GBBB=1", "-GDEPTH=4"]
+
+
+def test_read_marked_list_rebuilds_dependencies():
+    read = roundtrip(make_top())
+
+    assert read.get("deps") == ["alib", "blib"]
+    assert read.get_dep("alib").name == "alib"
+    assert read.get_dep("blib").name == "blib"
+
+
+def test_read_marked_list_rebuilds_depfilesets():
+    read = roundtrip(make_top())
+
+    assert read.get_depfileset("rtl") == [("alib", "rtl"), ("blib", "rtl")]
+    assert read.get_dep("alib").get_depfileset("rtl") == []
+
+
+def test_read_records_a_nested_edge_on_the_group_that_carries_it():
+    read = roundtrip(make_chain(), name="head")
+
+    assert read.get_depfileset("rtl") == [("middle", "rtl")]
+    assert read.get_dep("middle").get_depfileset("rtl") == [("tail", "rtl")]
+    assert read.get_dep("middle").get("deps") == ["tail"]
+    assert read.get("deps") == ["middle"]
+
+
+def test_read_keeps_the_files_of_every_level_of_a_chain():
+    read = roundtrip(make_chain(), name="head")
+
+    assert read.get_file("rtl") == [abspath("work/head.v")]
+    assert read.get_dep("middle").get_file("rtl") == [abspath("work/middle.v")]
+    assert read.get_dep("middle").get_dep("tail").get_file("rtl") == [abspath("work/tail.v")]
+
+
+def test_read_marked_list_keeps_group_files():
+    read = roundtrip(make_top())
+
+    assert read.get_file("rtl") == [abspath("work/top.v")]
+    assert read.get_dep("alib").get_file("rtl") == [abspath("work/alib/increment.v")]
+    assert read.get_dep("blib").get_file("rtl") == [abspath("work/blib/heartbeat.v")]
+
+
+def test_roundtrip_keeps_define_shared_by_two_libraries():
+    read = roundtrip(make_top())
+
+    assert read.get_dep("alib").get_define("rtl") == ["WIDTH=8"]
+    assert read.get_dep("blib").get_define("rtl") == ["WIDTH=8"]
+
+
+def test_roundtrip_keeps_idir_shared_by_two_libraries():
+    read = roundtrip(make_top())
+
+    assert read.get_dep("alib").get_idir("rtl") == [abspath("work/inc")]
+    assert read.get_dep("blib").get_idir("rtl") == [abspath("work/inc")]
+
+
+def test_roundtrip_keeps_entry_the_reading_design_shares_with_a_dependency():
+    top = make_top()
+    with top.active_fileset("rtl"), top.active_dataroot("root"):
+        top.add_define("WIDTH=8")
+        top.add_idir("inc")
+
+    read = roundtrip(top)
+
+    assert read.get_define("rtl") == ["WIDTH=8"]
+    assert read.get_idir("rtl") == [abspath("work/inc")]
+    assert read.get_dep("blib").get_define("rtl") == ["WIDTH=8"]
+
+
+def test_roundtrip_keeps_topmodule_undefine_libdir_lib_and_params():
+    read = roundtrip(make_loaded(), name="loaded")
+
+    assert read.get_topmodule("rtl") == "core"
+    assert read.get_undefine("rtl") == ["DEBUG"]
+    assert read.get_libdir("rtl") == [abspath("work/vendor")]
+    assert read.get_lib("rtl") == ["stdcells"]
+    assert read.get_param("DEPTH", "rtl") == "4"
+    assert read.get_param("ADDR", "rtl") == "16"
+
+
+def test_roundtrip_keeps_filetype_the_extension_does_not_imply():
+    read = roundtrip(make_loaded(), name="loaded")
+
+    assert read.get_file("rtl", filetype="verilog") == [
+        abspath("work/lib/core.v"), abspath("work/lib/pkg.sv")]
+    assert read.get_file("rtl", filetype="systemverilog") == []
+
+
+def test_roundtrip_merges_group_named_after_the_reading_design():
+    read = roundtrip(make_top(), name="top")
+
+    assert read.get_topmodule("rtl") == "top"
+    assert read.get("deps") == ["alib", "blib"]
+    assert read.get_dep("alib").get_topmodule("rtl") == "alib"
+
+
+def test_read_group_no_edge_refers_to_becomes_a_dependency_of_the_named_fileset():
+    touch("work/orphan.v")
+    write_list("orphan.f",
+               "// sc-fileset olib rtl",
+               abspath("work/orphan.v"))
+
+    read = Design("reader")
+    read.read_fileset("orphan.f", fileset="rtl")
+
+    assert read.get("deps") == ["olib"]
+    assert read.get_depfileset("rtl") == [("olib", "rtl")]
+
+
+def test_read_list_with_unmarked_prologue():
+    touch("work/top.v", "work/alib/increment.v")
+    write_list("prologue.f",
+               "+define+PROLOGUE",
+               abspath("work/top.v"),
+               "// sc-fileset alib rtl",
+               abspath("work/alib/increment.v"))
+
+    read = Design("reader")
+    read.read_fileset("prologue.f", fileset="rtl")
+
+    assert read.get_define("rtl") == ["PROLOGUE"]
+    assert read.get_file("rtl") == [abspath("work/top.v")]
+    assert read.get("deps") == ["alib"]
+    assert read.get_dep("alib").get_file("rtl") == [abspath("work/alib/increment.v")]
+
+
+def test_read_included_list_resolves_relative_paths_against_the_naming_list():
+    touch("work/top.v", "work/sub/top.v")
+    write_list("work/sub/inner.f", "top.v")
+    write_list("work/outer.f", "-f sub/inner.f")
+
+    read = Design("reader")
+    read.read_fileset("work/outer.f", fileset="rtl")
+
+    assert read.get_file("rtl") == [abspath("work/top.v")]
+
+
+def test_read_local_included_list_resolves_relative_paths_against_itself():
+    touch("work/top.v", "work/sub/top.v")
+    write_list("work/sub/inner.f", "top.v")
+    write_list("work/outer.f", "-F sub/inner.f")
+
+    read = Design("reader")
+    read.read_fileset("work/outer.f", fileset="rtl")
+
+    assert read.get_file("rtl") == [abspath("work/sub/top.v")]
+
+
+def test_read_nested_include_keeps_the_base_directory_it_was_given():
+    touch("work/sub/a.v", "work/sub/b.v", "work/b.v")
+    write_list("work/sub/deep.f", "b.v")
+    write_list("work/sub/inner.f", "a.v", "-f deep.f")
+    write_list("work/outer.f", "-F sub/inner.f")
+
+    read = Design("reader")
+    read.read_fileset("work/outer.f", fileset="rtl")
+
+    assert read.get_file("rtl") == [abspath("work/sub/a.v"), abspath("work/sub/b.v")]
+
+
+def test_read_include_cycle_reads_each_list_once():
+    touch("work/a.v", "work/b.v")
+    write_list("work/a.f", "a.v", "-f b.f")
+    write_list("work/b.f", "b.v", "-f a.f")
+
+    read = Design("reader")
+    read.read_fileset("work/a.f", fileset="rtl")
+
+    assert read.get_file("rtl") == [abspath("work/a.v"), abspath("work/b.v")]
+
+
+def test_read_group_opened_in_an_included_list_ends_with_that_list():
+    touch("work/top.v", "work/later.v", "work/sub/dep.v")
+    write_list("work/sub/inner.f",
+               "// sc-fileset dlib rtl",
+               abspath("work/sub/dep.v"))
+    write_list("work/outer.f",
+               abspath("work/top.v"),
+               "-F sub/inner.f",
+               abspath("work/later.v"))
+
+    read = Design("reader")
+    read.read_fileset("work/outer.f", fileset="rtl")
+
+    assert read.get_file("rtl") == [abspath("work/top.v"), abspath("work/later.v")]
+    assert read.get_dep("dlib").get_file("rtl") == [abspath("work/sub/dep.v")]
+
+
+def test_read_filetype_marker_does_not_escape_the_included_list():
+    touch("work/inner.v", "work/outer.v")
+    write_list("work/inner.f",
+               "// sc-filetype systemverilog",
+               abspath("work/inner.v"))
+    write_list("work/outer.f",
+               "-f inner.f",
+               abspath("work/outer.v"))
+
+    read = Design("reader")
+    read.read_fileset("work/outer.f", fileset="rtl")
+
+    assert read.get_file("rtl", filetype="systemverilog") == [abspath("work/inner.v")]
+    assert read.get_file("rtl", filetype="verilog") == [abspath("work/outer.v")]
+
+
+def test_read_unmarked_list_accepts_every_command():
+    touch("work/core.v", "work/vendor/cell.v", "work/inc/shared.vh")
+    write_list("work/plain.f",
+               "-top core",
+               f"+incdir+{abspath('work/inc')}",
+               f"-y {abspath('work/vendor')}",
+               "+define+WIDTH=8",
+               "+undefine+DEBUG",
+               "-GDEPTH=4",
+               "-v stdcells",
+               abspath("work/core.v"))
+
+    read = Design("reader")
+    read.read_fileset("work/plain.f", fileset="rtl")
+
+    assert read.get_topmodule("rtl") == "core"
+    assert read.get_idir("rtl") == [abspath("work/inc")]
+    assert read.get_libdir("rtl") == [abspath("work/vendor")]
+    assert read.get_define("rtl") == ["WIDTH=8"]
+    assert read.get_undefine("rtl") == ["DEBUG"]
+    assert read.get_param("DEPTH", "rtl") == "4"
+    assert read.get_lib("rtl") == ["stdcells"]
+    assert read.get_file("rtl") == [abspath("work/core.v")]
+
+
+def test_read_sibling_sharing_a_name_prefix_gets_its_own_dataroot():
+    touch("work/lib/a.v", "work/libextra/b.v")
+    write_list("work/p.f", abspath("work/lib/a.v"), abspath("work/libextra/b.v"))
+
+    read = Design("reader")
+    read.read_fileset("work/p.f", fileset="rtl")
+
+    assert dataroot_paths(read) == [abspath("work/lib"), abspath("work/libextra")]
+    assert unrooted_entries(read) == []
+    assert read.get_file("rtl") == [abspath("work/lib/a.v"), abspath("work/libextra/b.v")]
+
