+def make_converging():
+    touch("work/shared.v", "work/left.v", "work/right.v", "work/top.v")
+
+    def design(name, source, deps=()):
+        built = Design(name)
+        built.set_dataroot("root", os.path.abspath("work"))
+        for dep in deps:
+            built.add_dep(dep)
+        with built.active_fileset("rtl"), built.active_dataroot("root"):
+            built.set_topmodule(name)
+            built.add_file(source)
+            for dep in deps:
+                built.add_depfileset(dep.name, "rtl")
+        return built
+
+    shared = design("shared", "shared.v")
+    return design("top", "top.v", [design("left", "left.v", [shared]),
+                                   design("right", "right.v", [shared])])
+
