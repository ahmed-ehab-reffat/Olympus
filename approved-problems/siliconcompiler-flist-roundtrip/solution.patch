+FLIST_GROUP_MARKER = "sc-fileset"
+FLIST_EDGE_MARKER = "sc-depfileset"
+FLIST_FILETYPE_MARKER = "sc-filetype"
+
+FLIST_MARKER_FIELDS = {
+    FLIST_GROUP_MARKER: 2,
+    FLIST_EDGE_MARKER: 2,
+    FLIST_FILETYPE_MARKER: 1
+}
+
+FLIST_PREFIX_COMMANDS = (
+    ("+incdir+", "idir"),
+    ("+define+", "define"),
+    ("+undefine+", "undefine"),
+    ("-G", "param")
+)
+
+FLIST_FLAG_COMMANDS = {
+    "-y": "libdir",
+    "-v": "lib",
+    "-top": "topmodule",
+    "-f": "include",
+    "-F": "include_local"
+}
+
+
+FLIST_GROUP_CONTENT = (
+    "topmodule", "idir", "libdir", "define", "undefine", "param", "lib", "file"
+)
+
+
+def _new_flist_group(design: Optional[str], fileset: str) -> Dict:
+    '''
+    Builds an empty file list group.
+
+    Args:
+        design (str): Name of the design the group belongs to, or None for the
+            group the reading design starts with.
+        fileset (str): Name of the fileset the group populates.
+
+    Returns:
+        Dict: Group holding the contents collected between two markers.
+    '''
+    group = {"design": design, "fileset": fileset, "topmodule": None, "dep": []}
+    for key in FLIST_GROUP_CONTENT:
+        group.setdefault(key, [])
+    return group
+
+
+def _parse_flist_marker(line: str) -> Optional[Tuple[str, List[str]]]:
+    '''
+    Parses a file list comment line into a boundary marker.
+
+    Args:
+        line (str): A stripped line from a file list.
+
+    Returns:
+        Tuple[str, List[str]]: The marker name and its fields, or None when the
+        line is an ordinary comment.
+    '''
+    if not line.startswith("//"):
+        return None
+
+    fields = line[2:].split()
+    if not fields:
+        return None
+
+    count = FLIST_MARKER_FIELDS.get(fields[0])
+    if count is None or len(fields) != count + 1:
+        return None
+
+    return fields[0], fields[1:]
+
+
+def _parse_flist_command(line: str) -> Tuple[str, str]:
+    '''
+    Parses a file list line into a command name and its argument.
+
+    Args:
+        line (str): A stripped, non-empty, non-comment line from a file list.
+
+    Returns:
+        Tuple[str, str]: The command name and its argument. A line carrying no
+        recognized command is reported as a file.
+    '''
+    fields = line.split(None, 1)
+    command = FLIST_FLAG_COMMANDS.get(fields[0])
+    if command:
+        return command, fields[1].strip() if len(fields) > 1 else ""
+
+    for prefix, name in FLIST_PREFIX_COMMANDS:
+        if line.startswith(prefix):
+            return name, line[len(prefix):]
+
+    return "file", line
+
 
