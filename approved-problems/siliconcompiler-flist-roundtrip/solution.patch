+class DataRootAllocator:
+    """Assigns absolute paths to data roots registered on a schema.
+
+    Paths handed to :meth:`reserve` are grouped so that each one is covered by a
+    data root that contains it, reusing roots reserved earlier by the same
+    allocator instead of registering a directory twice.
+
+    Args:
+        schema (PathSchema): Schema the data roots are registered on.
+        prefix (str): Leading part of every generated data root name.
+    """
+
+    def __init__(self, schema: "PathSchema", prefix: str):
+        self.__schema = schema
+        self.__prefix = prefix
+        self.__roots: Dict[str, str] = {}
+
+        for name in schema.getkeys("dataroot"):
+            path = self.__local_dataroot(name)
+            if path:
+                self.__roots.setdefault(path, name)
+
+    def __local_dataroot(self, name: str) -> Optional[str]:
+        """Returns the directory a data root was registered with.
+
+        Args:
+            name (str): Name of the data root.
+
+        Returns:
+            Optional[str]: The directory, or None when the root is versioned or
+            was not registered with a local directory path.
+        """
+
+        if self.__schema.get("dataroot", name, "tag") is not None:
+            return None
+
+        path = self.__schema.get("dataroot", name, "path")
+        if not os.path.isdir(path):
+            return None
+
+        return os.path.abspath(path)
+
+    def reserve(self, paths: List[str], label: str) -> None:
+        """Registers data roots covering the given paths.
+
+        Args:
+            paths (List[str]): Absolute paths that must be covered.
+            label (str): Name fragment identifying the caller of this batch.
+        """
+
+        for path in sorted(set(paths)):
+            if self.select(path)[0]:
+                continue
+
+            name = f"{self.__prefix}-{label}-{len(self.__roots)}"
+            self.__schema.set_dataroot(name, path)
+            self.__roots[path] = name
+
+    def select(self, path: str) -> Tuple[Optional[str], Optional[str]]:
+        """Finds the data root covering a path.
+
+        Args:
+            path (str): Absolute path to place.
+
+        Returns:
+            Tuple[Optional[str], Optional[str]]: Name and directory of the
+            covering data root, or a pair of None when no root contains it.
+        """
+
+        for root, name in self.__roots.items():
+            if path_contains(root, path):
+                return name, root
+
+        return None, None
+
+    def relative(self, path: str) -> Tuple[Optional[str], str]:
+        """Rewrites a path so it is stored against its data root.
+
+        Args:
+            path (str): Absolute path to rewrite.
+
+        Returns:
+            Tuple[Optional[str], str]: Data root name and the path expressed
+            relative to it, or None and the unchanged path.
+        """
+
+        name, root = self.select(path)
+        if not name:
+            return None, path
+
+        return name, os.path.relpath(path, root)
