+def path_contains(root: str, path: str) -> bool:
+    """Checks whether a path lies inside a directory.
+
+    The comparison is made on whole path components, so a directory is not
+    considered to contain a sibling whose name merely starts with its own.
+
+    Args:
+        root (str): Directory the containment is tested against.
+        path (str): Path being tested.
+
+    Returns:
+        bool: True when path is root itself or sits below it.
+    """
+
+    try:
+        relative = os.path.relpath(path, root)
+    except ValueError:
+        return False
+
+    if relative == os.curdir:
+        return True
+
+    return not relative.split(os.sep)[0] == os.pardir
