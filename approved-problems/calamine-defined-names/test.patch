+            ),
+            name(
+                "ScopedName",
+                "Sheet1!$A$1",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(false),
+            ),
+            with_extended_metadata(
+                name(
+                    "ScopedName",
+                    "Sheet1!$A$3",
+                    DefinedNameScope::Worksheet(0),
+                    Some(false),
