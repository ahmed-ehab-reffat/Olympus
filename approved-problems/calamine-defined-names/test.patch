+#[test]
+fn empty_defined_name_metadata() {
+    let tests = PathBuf::from(env!("CARGO_MANIFEST_DIR")).join("tests");
+
+    let xlsx_path = tests.join("any_sheets.xlsx");
+    let xlsx: Xlsx<_> = open_workbook(&xlsx_path).unwrap();
+    let xlsx_auto = open_workbook_auto(xlsx_path).unwrap();
+    assert!(xlsx.defined_names_metadata().is_empty());
+    assert!(xlsx.defined_names().is_empty());
+    assert_auto_dispatch_matches(&xlsx, &xlsx_auto);
+
+    let xls_path = tests.join("any_sheets.xls");
+    let xls: Xls<_> = open_workbook(&xls_path).unwrap();
+    let xls_auto = open_workbook_auto(xls_path).unwrap();
+    assert!(xls.defined_names_metadata().is_empty());
+    assert!(xls.defined_names().is_empty());
+    assert_auto_dispatch_matches(&xls, &xls_auto);
+
+    let xlsb_path = tests.join("any_sheets.xlsb");
+    let xlsb: Xlsb<_> = open_workbook(&xlsb_path).unwrap();
+    let xlsb_auto = open_workbook_auto(xlsb_path).unwrap();
+    assert!(xlsb.defined_names_metadata().is_empty());
+    assert!(xlsb.defined_names().is_empty());
+    assert_auto_dispatch_matches(&xlsb, &xlsb_auto);
+
+    let ods_path = tests.join("any_sheets.ods");
+    let ods: Ods<_> = open_workbook(&ods_path).unwrap();
+    let ods_auto = open_workbook_auto(ods_path).unwrap();
+    assert!(ods.defined_names_metadata().is_empty());
+    assert!(ods.defined_names().is_empty());
+    assert_auto_dispatch_matches(&ods, &ods_auto);
+}
