+#!/usr/bin/env bash
+
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="${2-}"
+            shift 2
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#*=}"
+            shift
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [ -z "$MODE" ]; then
+    echo "usage: $0 [--output_path <path>] <base|new>" >&2
+    exit 2
+fi
+
+cd "$(dirname "$0")" || exit 2
+
+TARGET_DIR="${CARGO_TARGET_DIR:-target}"
+REPORT_ROOTS=(target)
+if [ "$TARGET_DIR" != "target" ]; then
+    REPORT_ROOTS+=("$TARGET_DIR")
+fi
+
+case "$MODE" in
+    base)
+        TARGET=(--lib --test test)
+        ;;
+    new)
+        TARGET=(--test defined_name_metadata_d1cf90)
+        ;;
+esac
+
+find "${REPORT_ROOTS[@]}" -path '*/nextest/*/junit.xml' -type f -delete 2>/dev/null
+
+CARGO_NET_OFFLINE=true cargo +1.88.0 nextest run \
+    --locked \
+    --offline \
+    --profile default \
+    --no-fail-fast \
+    --all-features \
+    "${TARGET[@]}"
+STATUS=$?
+
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    JUNIT_SRC="$(
+        find "${REPORT_ROOTS[@]}" -path '*/nextest/*/junit.xml' -type f 2>/dev/null |
+            head -1
+    )"
+
+    if [ -n "$JUNIT_SRC" ] && [ -f "$JUNIT_SRC" ]; then
+        cp "$JUNIT_SRC" "$OUTPUT_PATH"
+    else
+        cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="0" errors="0" skipped="1">
+  <testsuite name="$MODE" tests="1" failures="0" errors="0" skipped="1">
+    <testcase name="run" classname="$MODE">
+      <skipped message="per-test JUnit unavailable (runner exit $STATUS)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    fi
+fi
+
+exit "$STATUS"
