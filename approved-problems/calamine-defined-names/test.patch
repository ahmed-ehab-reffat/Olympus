+use std::path::PathBuf;
+
+use calamine::{
+    open_workbook, open_workbook_auto, DefinedName, DefinedNameScope, Ods, Reader, Sheets, Xls,
+    Xlsb, Xlsx,
+};
+
+fn decode_nibble(value: u8) -> u8 {
+    match value {
+        b'0'..=b'9' => value - b'0',
+        b'a'..=b'f' => value - b'a' + 10,
+        b'A'..=b'F' => value - b'A' + 10,
+        _ => panic!("invalid fixture encoding"),
+    }
+}
+
+fn decoded_fixture(payload: &str, filename: &str) -> PathBuf {
+    let encoded = std::fs::read_to_string(
+        PathBuf::from(env!("CARGO_MANIFEST_DIR"))
+            .join("tests")
+            .join(payload),
+    )
+    .unwrap();
+    let digits = encoded
+        .bytes()
+        .filter(u8::is_ascii_hexdigit)
+        .collect::<Vec<_>>();
+    assert_eq!(digits.len() % 2, 0);
+
+    let bytes = digits
+        .chunks_exact(2)
+        .map(|pair| (decode_nibble(pair[0]) << 4) | decode_nibble(pair[1]))
+        .collect::<Vec<_>>();
+    let directory = std::env::temp_dir().join(format!(
+        "calamine-defined-names-d1cf90-{}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&directory).unwrap();
+    let output = directory.join(filename);
+    std::fs::write(&output, bytes).unwrap();
+    output
+}
+
+fn fixture(extension: &str) -> PathBuf {
+    let payload = match extension {
+        "ods" => "fixture_b_d1cf90.txt",
+        "xls" => "fixture_c_d1cf90.txt",
+        "xlsb" => "fixture_d_d1cf90.txt",
+        "xlsx" => "fixture_e_d1cf90.txt",
+        _ => panic!("unsupported fixture extension"),
+    };
+    decoded_fixture(payload, &format!("scoped_names.{extension}"))
+}
+
+fn name(
+    name: &str,
+    formula: &str,
+    scope: DefinedNameScope,
+    hidden: Option<bool>,
+    built_in: Option<bool>,
+) -> DefinedName {
+    DefinedName {
+        name: name.into(),
+        formula: formula.into(),
+        scope,
+        hidden,
+        built_in,
+        comment: None,
+        published: hidden.map(|_| false),
+        workbook_parameter: hidden.map(|_| false),
+    }
+}
+
+fn with_extended_metadata(
+    mut defined_name: DefinedName,
+    comment: Option<&str>,
+    published: bool,
+    workbook_parameter: bool,
+) -> DefinedName {
+    defined_name.comment = comment.map(str::to_owned);
+    defined_name.published = Some(published);
+    defined_name.workbook_parameter = Some(workbook_parameter);
+    defined_name
+}
+
+type FileReader = std::io::BufReader<std::fs::File>;
+
+fn assert_public_traits<T: std::fmt::Debug + PartialEq + Clone>() {}
+
+fn assert_reader_interface<R: Reader<FileReader>>() {
+    assert_public_traits::<DefinedName>();
+    assert_public_traits::<DefinedNameScope>();
+    let accessor: fn(&R) -> &[DefinedName] = <R as Reader<FileReader>>::defined_names_metadata;
+    let _ = accessor;
+}
+
+fn assert_legacy_projection<R: Reader<FileReader>>(workbook: &R) {
+    let projected = workbook
+        .defined_names_metadata()
+        .iter()
+        .map(|defined_name| (defined_name.name.clone(), defined_name.formula.clone()))
+        .collect::<Vec<_>>();
+    assert_eq!(workbook.defined_names(), projected);
+}
+
+fn assert_ods_legacy_projection<R: Reader<FileReader>>(workbook: &R) {
+    let all_records = workbook
+        .defined_names_metadata()
+        .iter()
+        .map(|defined_name| (defined_name.name.clone(), defined_name.formula.clone()))
+        .collect::<Vec<_>>();
+    let workbook_records = workbook
+        .defined_names_metadata()
+        .iter()
+        .filter(|defined_name| defined_name.scope == DefinedNameScope::Workbook)
+        .map(|defined_name| (defined_name.name.clone(), defined_name.formula.clone()))
+        .collect::<Vec<_>>();
+    assert!(
+        workbook.defined_names() == all_records || workbook.defined_names() == workbook_records,
+        "ODS legacy names must be a complete ordered metadata projection"
+    );
+}
+
+fn assert_auto_dispatch_matches<R: Reader<FileReader>>(workbook: &R, auto: &Sheets<FileReader>) {
+    assert_eq!(
+        auto.defined_names_metadata(),
+        workbook.defined_names_metadata()
+    );
+}
+
+fn assert_local_scope_owners<R: Reader<FileReader>>(workbook: &R, expected: &[(usize, &str)]) {
+    for &(record_index, owner) in expected {
+        let DefinedNameScope::Worksheet(sheet_index) =
+            &workbook.defined_names_metadata()[record_index].scope
+        else {
+            panic!("expected a worksheet-scoped record at index {record_index}");
+        };
+        assert_eq!(workbook.sheets_metadata()[*sheet_index].name, owner);
+    }
+}
+
+fn formulas<R: Reader<FileReader>>(workbook: &mut R) -> Vec<String> {
+    workbook
+        .worksheet_formula("Sheet1")
+        .unwrap()
+        .cells()
+        .filter_map(|(_, _, formula)| (!formula.is_empty()).then_some(formula.clone()))
+        .collect()
+}
+
+#[test]
+fn xlsx_defined_name_metadata() {
+    let path = fixture("xlsx");
+    let mut workbook: Xlsx<_> = open_workbook(&path).unwrap();
+    let auto = open_workbook_auto(path).unwrap();
+    assert_reader_interface::<Xlsx<FileReader>>();
+    assert_auto_dispatch_matches(&workbook, &auto);
+    assert_eq!(
+        workbook.defined_names_metadata(),
+        [
+            with_extended_metadata(
+                name(
+                    "ScopedName",
+                    "Sheet1!$A$1",
+                    DefinedNameScope::Workbook,
+                    Some(false),
+                    Some(false),
+                ),
+                Some("Workbook & owner"),
+                false,
+                false,
+            ),
+            with_extended_metadata(
+                name(
+                    "ScopedName",
+                    "datatypes!$A$2",
+                    DefinedNameScope::Worksheet(1),
+                    Some(false),
+                    Some(false),
+                ),
+                None,
+                true,
+                true,
+            ),
+            with_extended_metadata(
+                name(
+                    "ScopedName",
+                    "Sheet1!$A$3",
+                    DefinedNameScope::Worksheet(0),
+                    Some(false),
+                    Some(false),
+                ),
+                None,
+                false,
+                true,
+            ),
+            with_extended_metadata(
+                name(
+                    "HiddenName",
+                    "Sheet1!$A$4",
+                    DefinedNameScope::Workbook,
+                    Some(true),
+                    Some(false),
+                ),
+                Some(""),
+                false,
+                false,
+            ),
+            name(
+                "_xlnm.Print_Area",
+                "Sheet1!$A$1:$B$2",
+                DefinedNameScope::Worksheet(1),
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.Print_Titles",
+                "Sheet1!$A$6",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.Criteria",
+                "Sheet1!$A$7",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm._FilterDatabase",
+                "Sheet1!$A$8",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.Extract",
+                "Sheet1!$A$9",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.Consolidate_Area",
+                "Sheet1!$A$10",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.Database",
+                "Sheet1!$A$11",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.Sheet_Title",
+                "Sheet1!$A$12",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(true),
+            ),
+            name(
+                "_xlnm.UserDefined",
+                "Sheet1!$A$5",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(false),
+            ),
+            name(
+                "OneRange",
+                "Sheet1!$A$1",
+                DefinedNameScope::Workbook,
+                Some(false),
+                Some(false),
+            ),
+        ]
+    );
+    assert_local_scope_owners(&workbook, &[(1, "Sheet1"), (2, "datatypes"), (4, "Sheet1")]);
+    assert_legacy_projection(&workbook);
+    let metadata_before_read = workbook.defined_names_metadata().to_vec();
+    assert!(formulas(&mut workbook)
+        .iter()
+        .any(|formula| formula == "B1+OneRange"));
+    assert_eq!(workbook.defined_names_metadata(), metadata_before_read);
+}
+
+#[test]
+fn xls_defined_name_metadata() {
+    let path = fixture("xls");
+    let mut workbook: Xls<_> = open_workbook(&path).unwrap();
+    let auto = open_workbook_auto(path).unwrap();
