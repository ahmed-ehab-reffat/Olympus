+fn nullable_wide_str(buf: &[u8]) -> Result<Option<Cow<'_, str>>, XlsbError> {
+    let len = read_u32(buf);
+    if len == u32::MAX {
+        return Ok(None);
+    }
+    let byte_len = len as usize * 2;
+    if buf.len() < 4 + byte_len {
+        return Err(XlsbError::WideStr {
+            ws_len: 4 + byte_len,
+            buf_len: buf.len(),
+        });
+    }
+    Ok(Some(UTF_16LE.decode(&buf[4..4 + byte_len]).0))
+}
