+/// A workbook defined name and its source-format metadata.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct DefinedName {
+    /// The defined name.
+    pub name: String,
+    /// The formula, range, or expression represented by the name.
+    pub formula: String,
+    /// The namespace in which the name is visible.
+    pub scope: DefinedNameScope,
+    /// Whether the source format marks the name as hidden.
+    ///
+    /// This is `None` when the source format has no equivalent property.
+    pub hidden: Option<bool>,
+    /// Whether the source format marks or identifies the name as built in.
+    ///
+    /// This is `None` when the source format has no equivalent property.
+    pub built_in: Option<bool>,
+    /// The source comment associated with the name.
+    ///
+    /// `Some("")` represents an explicitly present empty comment. This is
+    /// `None` when no comment is present or the format has no equivalent.
+    pub comment: Option<String>,
+    /// Whether the source format marks the name for publication.
+    ///
+    /// This is `None` when the source format has no equivalent property.
+    pub published: Option<bool>,
+    /// Whether the source format marks the name as a workbook parameter.
+    ///
+    /// This is `None` when the source format has no equivalent property.
+    pub workbook_parameter: Option<bool>,
+}
+
+/// The namespace in which a defined name is visible.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DefinedNameScope {
+    /// The name is visible throughout the workbook.
+    Workbook,
+    /// The name is local to the worksheet at this zero-based workbook index.
+    Worksheet(usize),
 }
 
