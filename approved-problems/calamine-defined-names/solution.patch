+fn parse_name_comment(r: &Record<'_>, encoding: &XlsEncoding) -> Result<String, XlsError> {
+    if r.data.len() < 18 {
+        return Err(XlsError::Len {
+            expected: 18,
+            found: r.data.len(),
+            typ: "NameCmt",
+        });
+    }
+
+    let name_len = read_u16(&r.data[12..]) as usize;
+    let comment_len = read_u16(&r.data[14..]) as usize;
+    let (_, name_size) =
+        parse_unicode_string_no_cch(&r.data[16..], name_len, encoding, "NameCmt:name")?;
+    let (comment, _) = parse_unicode_string_no_cch(
+        &r.data[16 + name_size..],
+        comment_len,
+        encoding,
+        "NameCmt:comment",
+    )?;
+    Ok(comment)
+}
+
+fn parse_unicode_string_no_cch(
+    data: &[u8],
+    character_count: usize,
+    encoding: &XlsEncoding,
+    typ: &'static str,
+) -> Result<(String, usize), XlsError> {
+    let Some(options) = data.first() else {
+        return Err(XlsError::Len {
+            expected: 1,
+            found: 0,
+            typ,
+        });
+    };
+    let mut value = String::with_capacity(character_count);
+    let (decoded, bytes) = encoding.decode_to(
+        &data[1..],
+        character_count,
+        &mut value,
+        Some(options & 0x01 != 0),
+    );
+    if decoded != character_count {
+        return Err(XlsError::Len {
+            expected: 1 + character_count * if options & 0x01 == 0 { 1 } else { 2 },
+            found: data.len(),
+            typ,
+        });
+    }
+    Ok((value, 1 + bytes))
 }
 
