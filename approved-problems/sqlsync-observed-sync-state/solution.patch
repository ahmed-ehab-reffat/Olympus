diff --git a/lib/sqlsync/src/sync.rs b/lib/sqlsync/src/sync.rs
new file mode 100644
index 0000000..e1f868c
--- /dev/null
+++ b/lib/sqlsync/src/sync.rs
@@ -0,0 +1,111 @@
+use crate::{JournalId, Lsn};
+
+/// Identifies one mutation accepted into a local timeline.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct MutationReceipt {
+    pub timeline_id: JournalId,
+    pub lsn: Lsn,
+}
+
+/// The furthest stage at which a mutation has been observed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum MutationStatus {
+    Local,
+    Received,
+    Applied,
+}
+
+/// A conservative snapshot of one local timeline's observed synchronization progress.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SyncState {
+    pub timeline_id: JournalId,
+    pub local: Option<Lsn>,
+    pub received: Option<Lsn>,
+    pub applied: Option<Lsn>,
+}
+
+impl SyncState {
+    pub fn new(
+        timeline_id: JournalId,
+        local: Option<Lsn>,
+        received: Option<Lsn>,
+        applied: Option<Lsn>,
+    ) -> Self {
+        Self { timeline_id, local, received, applied }
+    }
+
+    /// Returns the furthest observed stage for `receipt`.
+    ///
+    /// `None` means that the receipt belongs to another timeline or refers to
+    /// an LSN that has not existed locally in this timeline.
+    pub fn status(&self, receipt: MutationReceipt) -> Option<MutationStatus> {
+        if receipt.timeline_id != self.timeline_id
+            || self.local.is_none_or(|local| receipt.lsn > local)
+        {
+            return None;
+        }
+
+        if self.applied.is_some_and(|applied| receipt.lsn <= applied) {
+            Some(MutationStatus::Applied)
+        } else if self
+            .received
+            .is_some_and(|received| receipt.lsn <= received)
+        {
+            Some(MutationStatus::Received)
+        } else {
+            Some(MutationStatus::Local)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{MutationReceipt, MutationStatus, SyncState};
+    use crate::JournalId;
+
+    fn id(byte: u8) -> JournalId {
+        JournalId::try_from(vec![byte; 16]).unwrap()
+    }
+
+    #[test]
+    fn mutation_status_tracks_distinct_observed_stages() {
+        let timeline_id = id(1);
+        let receipt = MutationReceipt { timeline_id, lsn: 2 };
+
+        assert_eq!(
+            SyncState::new(timeline_id, Some(2), None, None).status(receipt),
+            Some(MutationStatus::Local)
+        );
+        assert_eq!(
+            SyncState::new(timeline_id, Some(2), Some(2), None).status(receipt),
+            Some(MutationStatus::Received)
+        );
+        assert_eq!(
+            SyncState::new(timeline_id, Some(2), Some(2), Some(2)).status(receipt),
+            Some(MutationStatus::Applied)
+        );
+    }
+
+    #[test]
+    fn applied_observation_takes_precedence_over_received_regression() {
+        let timeline_id = id(1);
+        let receipt = MutationReceipt { timeline_id, lsn: 4 };
+        let state = SyncState::new(timeline_id, Some(4), Some(1), Some(4));
+
+        assert_eq!(state.status(receipt), Some(MutationStatus::Applied));
+    }
+
+    #[test]
+    fn mutation_status_rejects_foreign_and_future_receipts() {
+        let state = SyncState::new(id(1), Some(2), Some(2), Some(1));
+
+        assert_eq!(
+            state.status(MutationReceipt { timeline_id: id(2), lsn: 1 }),
+            None
+        );
+        assert_eq!(
+            state.status(MutationReceipt { timeline_id: id(1), lsn: 3 }),
+            None
+        );
+    }
+}
