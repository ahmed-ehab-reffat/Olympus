diff --git a/test-support/observed-sync-state-status/src/main.rs b/test-support/observed-sync-state-status/src/main.rs
new file mode 100644
index 0000000..5657c15
--- /dev/null
+++ b/test-support/observed-sync-state-status/src/main.rs
@@ -0,0 +1,92 @@
+use sqlsync::{JournalId, Lsn, MutationReceipt, MutationStatus, SyncState};
+
+#[cfg(all(feature = "receipt-by-value", feature = "receipt-by-reference"))]
+compile_error!("select exactly one receipt argument form");
+
+#[cfg(not(any(feature = "receipt-by-value", feature = "receipt-by-reference")))]
+compile_error!("select one receipt argument form");
+
+fn id(byte: u8) -> JournalId {
+    JournalId::try_from(vec![byte; 16]).unwrap()
+}
+
+fn receipt(timeline_id: JournalId, lsn: Lsn) -> MutationReceipt {
+    MutationReceipt { timeline_id, lsn }
+}
+
+#[cfg(feature = "receipt-by-value")]
+fn status(state: &SyncState, timeline_id: JournalId, lsn: Lsn) -> Option<MutationStatus> {
+    state.status(receipt(timeline_id, lsn))
+}
+
+#[cfg(feature = "receipt-by-reference")]
+fn status(state: &SyncState, timeline_id: JournalId, lsn: Lsn) -> Option<MutationStatus> {
+    state.status(&receipt(timeline_id, lsn))
+}
+
+fn main() {
+    let timeline_id = id(1);
+    let state = SyncState {
+        timeline_id,
+        local: Some(5),
+        received: Some(3),
+        applied: Some(4),
+    };
+
+    assert!(matches!(
+        status(&state, timeline_id, 2),
+        Some(MutationStatus::Applied)
+    ));
+    assert!(matches!(
+        status(&state, timeline_id, 3),
+        Some(MutationStatus::Applied)
+    ));
+    assert!(matches!(
+        status(&state, timeline_id, 4),
+        Some(MutationStatus::Applied)
+    ));
+    assert!(matches!(
+        status(&state, timeline_id, 5),
+        Some(MutationStatus::Local)
+    ));
+    assert!(status(&state, id(2), 2).is_none());
+    assert!(status(&state, timeline_id, 6).is_none());
+
+    let missing_local = SyncState {
+        timeline_id,
+        local: None,
+        received: Some(5),
+        applied: Some(5),
+    };
+    assert!(status(&missing_local, timeline_id, 2).is_none());
+
+    let received_state = SyncState {
+        timeline_id,
+        local: Some(5),
+        received: Some(3),
+        applied: Some(1),
+    };
+    assert!(matches!(
+        status(&received_state, timeline_id, 2),
+        Some(MutationStatus::Received)
+    ));
+    assert!(matches!(
+        status(&received_state, timeline_id, 3),
+        Some(MutationStatus::Received)
+    ));
+    assert!(matches!(
+        status(&received_state, timeline_id, 4),
+        Some(MutationStatus::Local)
+    ));
+
+    let lagging_ack = SyncState {
+        timeline_id,
+        local: Some(5),
+        received: Some(1),
+        applied: Some(5),
+    };
+    assert!(matches!(
+        status(&lagging_ack, timeline_id, 5),
+        Some(MutationStatus::Applied)
+    ));
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..d09cc43
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,164 @@
+#!/usr/bin/env bash
+
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+RUN_LOG=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="${2-}"
+            shift 2
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#*=}"
+            shift
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [ -z "$MODE" ]; then
+    echo "usage: $0 [--output_path PATH] {base|new}" >&2
+    exit 2
+fi
+
+cd "$(dirname "$0")" || exit 2
+
+if [ -n "$OUTPUT_PATH" ]; then
+    rm -f -- "$OUTPUT_PATH"
+fi
+
+STATUS=0
+run_command() {
+    "$@"
+    command_status=$?
+    if [ "$command_status" -ne 0 ]; then
+        STATUS=$command_status
+    fi
+}
+
+run_browser_checks() {
+    for tool in node pnpm wasm-pack; do
+        if ! command -v "$tool" >/dev/null; then
+            echo "required browser integration tool is missing: $tool" >&2
+            STATUS=1
+            return
+        fi
+    done
+    run_command cargo build --locked --offline --target wasm32-unknown-unknown \
+        --example task-reducer
+    if [ "$STATUS" -ne 0 ]; then
+        return
+    fi
+    run_command cargo build --locked --offline -p sqlsync \
+        --example observed-sync-state-coordinator
+    if [ "$STATUS" -ne 0 ]; then
+        return
+    fi
+    run_command pnpm --dir lib/sqlsync-worker run build
+    if [ "$STATUS" -ne 0 ]; then
+        return
+    fi
+    run_command pnpm --dir lib/sqlsync-worker exec tsc --noEmit --strict \
+        --target es2022 --module esnext --moduleResolution Bundler \
+        --lib ESNext,DOM,WebWorker --skipLibCheck \
+        tests/observed_sync_state.types.ts
+    run_command pnpm --dir lib/sqlsync-react run build
+    run_command pnpm --dir lib/sqlsync-react exec tsc --noEmit \
+        --lib ESNext,DOM,DOM.Iterable
+    run_command pnpm --dir lib/sqlsync-solid-js run build
+    run_command pnpm --dir lib/sqlsync-solid-js exec tsc --noEmit \
+        --lib ESNext,DOM,DOM.Iterable
+    run_command pnpm --dir lib/sqlsync-worker exec tsc --noEmit --strict \
+        --target es2022 --module esnext --moduleResolution Bundler \
+        --lib ESNext,DOM,DOM.Iterable --skipLibCheck \
+        tests/observed_sync_state.hooks.types.ts
+    run_command node --import \
+        ./lib/sqlsync-worker/tests/observed_sync_state.hooks.register.mjs \
+        ./lib/sqlsync-worker/tests/observed_sync_state.hooks.mjs
+    run_command node lib/sqlsync-worker/tests/observed_sync_state.mjs
+}
+
+run_status_checks() {
+    manifest="test-support/observed-sync-state-status/Cargo.toml"
+    owned_log="$(mktemp)"
+    borrowed_log="$(mktemp)"
+    cp Cargo.lock "$(dirname "$manifest")/Cargo.lock"
+
+    if cargo check --offline --manifest-path "$manifest" \
+        --features receipt-by-value >"$owned_log" 2>&1; then
+        run_command cargo run --offline --manifest-path "$manifest" \
+            --features receipt-by-value
+    elif cargo check --offline --manifest-path "$manifest" \
+        --features receipt-by-reference >"$borrowed_log" 2>&1; then
+        run_command cargo run --offline --manifest-path "$manifest" \
+            --features receipt-by-reference
+    else
+        echo "SyncState::status accepts neither an owned nor borrowed receipt" >&2
+        cat "$owned_log" "$borrowed_log" >&2
+        STATUS=1
+    fi
+}
+
+export CARGO_NET_OFFLINE=true
+
+run_mode() {
+    case "$MODE" in
+        base)
+            run_command cargo test --locked --offline --workspace --all-features --lib
+            run_command cargo test --locked --offline --workspace --all-features --doc
+            ;;
+        new)
+            run_browser_checks
+            run_status_checks
+            run_command cargo test --locked --offline -p sqlsync \
+                --test observed_sync_state -- --test-threads=1
+            ;;
+    esac
+    return "$STATUS"
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+    RUN_LOG="$(mktemp)"
+    run_mode 2>&1 | tee "$RUN_LOG"
+    STATUS="${PIPESTATUS[0]}"
+else
+    run_mode
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    if [ "$STATUS" -eq 0 ]; then
+        FAILURES=0
+    else
+        FAILURES=1
+    fi
+    XML_LOG="$(
+        LC_ALL=C tr -cd '\11\12\15\40-\176' < "$RUN_LOG" \
+            | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
+    )"
+    cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="$FAILURES" errors="0">
+  <testsuite name="$MODE" tests="1" failures="$FAILURES" errors="0">
+    <testcase name="run" classname="$MODE">
+$(if [ "$FAILURES" -eq 1 ]; then printf '      <failure message="runner exited %s"/>\n' "$STATUS"; fi)
+      <system-out>$XML_LOG</system-out>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    rm -f -- "$RUN_LOG"
+fi
+
+exit "$STATUS"
