+import {
+  SQLSync,
+  type DocId,
+  type DocType,
+  type Lsn,
+  type MutationReceipt,
+  type MutationStatus,
+  type SyncState,
+  type SyncStateSubscription,
+} from "../src/index";
+
+type Mutation = { value: string };
+type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends <T>() => T extends B ? 1 : 2
+  ? true
+  : false;
+type IsAny<T> = 0 extends 1 & T ? true : false;
+type IsNever<T> = [T] extends [never] ? true : false;
+type IsOptionalLsn<T> = Equal<T, Lsn | undefined> extends true
+  ? true
+  : Equal<T, Lsn | null> extends true
+    ? true
+    : Equal<T, Lsn | null | undefined>;
+type TimelineField<T> = T extends { readonly timelineId: infer Value }
+  ? Value
+  : T extends { readonly timeline_id: infer Value }
+    ? Value
+    : never;
+type SubscriptionHandler = SyncStateSubscription["handleState"];
+
+declare const sqlsync: SQLSync;
+declare const docId: DocId;
+declare const docType: DocType<Mutation>;
+declare const mutation: Mutation;
+declare const receipt: MutationReceipt;
+declare const exportedState: SyncState;
+
+const mutationResult: Promise<MutationReceipt> = sqlsync.mutate(docId, docType, mutation);
+const stateResult: Promise<SyncState> = sqlsync.syncState(docId, docType);
+const statusResult: Promise<MutationStatus | undefined> = sqlsync.mutationStatus(
+  docId,
+  docType,
+  receipt,
+);
+const syncStateSubscription: SyncStateSubscription = {
+  handleState(state) {
+    void state;
+  },
+};
+const subscriptionResult: Promise<() => void> = sqlsync.subscribeSyncState(
+  docId,
+  docType,
+  syncStateSubscription,
+);
+
+function assertType<T extends true>() {}
+
+assertType<Equal<ReturnType<SQLSync["mutate"]>, Promise<MutationReceipt>>>();
+assertType<Equal<ReturnType<SQLSync["syncState"]>, Promise<SyncState>>>();
+assertType<Equal<ReturnType<SQLSync["mutationStatus"]>, Promise<MutationStatus | undefined>>>();
+assertType<Equal<ReturnType<SQLSync["subscribeSyncState"]>, Promise<() => void>>>();
+assertType<Equal<IsAny<Lsn>, false>>();
+assertType<Equal<IsNever<Lsn>, false>>();
+assertType<number extends Lsn ? false : true>();
+assertType<Equal<IsAny<MutationReceipt>, false>>();
+assertType<Equal<IsAny<MutationReceipt["lsn"]>, false>>();
+assertType<Equal<MutationReceipt["lsn"], Lsn>>();
+assertType<Equal<IsAny<SyncState>, false>>();
+assertType<Equal<IsAny<SyncState["local"]>, false>>();
+assertType<Equal<IsAny<SyncState["received"]>, false>>();
+assertType<Equal<IsAny<SyncState["applied"]>, false>>();
+assertType<Equal<IsOptionalLsn<SyncState["local"]>, true>>();
+assertType<Equal<IsOptionalLsn<SyncState["received"]>, true>>();
+assertType<Equal<IsOptionalLsn<SyncState["applied"]>, true>>();
+assertType<Equal<IsAny<TimelineField<MutationReceipt>>, false>>();
+assertType<Equal<IsNever<TimelineField<MutationReceipt>>, false>>();
+assertType<Equal<TimelineField<MutationReceipt>, TimelineField<SyncState>>>();
+assertType<TimelineField<MutationReceipt> extends DocId ? true : false>();
+assertType<DocId extends TimelineField<MutationReceipt> ? true : false>();
+assertType<Equal<IsAny<SyncStateSubscription>, false>>();
+assertType<Equal<Parameters<SubscriptionHandler>, [SyncState]>>();
+assertType<Equal<ReturnType<SubscriptionHandler>, void>>();
+assertType<Equal<IsAny<MutationStatus>, false>>();
+assertType<Equal<MutationStatus, "local" | "received" | "applied">>();
+
+const appliedResult: Lsn | null | undefined = exportedState.applied;
+
+void mutationResult;
+void stateResult;
+void statusResult;
+void subscriptionResult;
+void appliedResult;
diff --git a/lib/sqlsync/examples/observed-sync-state-coordinator.rs b/lib/sqlsync/examples/observed-sync-state-coordinator.rs
new file mode 100644
index 0000000..728a56a
--- /dev/null
+++ b/lib/sqlsync/examples/observed-sync-state-coordinator.rs
@@ -0,0 +1,82 @@
+use std::io::{self, Cursor, Read, Write};
+
+use sqlsync::{
+    coordinator::CoordinatorDocument,
+    replication::{ReplicationMsg, ReplicationProtocol},
+    JournalId, MemoryJournal, MemoryJournalFactory, WasmReducer,
+};
+
+const NETWORK_MESSAGE: u8 = 0;
+const APPLY_PENDING: u8 = 1;
+
+fn serialize_message(message: &ReplicationMsg) -> anyhow::Result<Vec<u8>> {
+    Ok(bincode::serialize(message)?)
+}
+
+fn write_batch(writer: &mut impl Write, messages: &[Vec<u8>]) -> anyhow::Result<()> {
+    writer.write_all(&(messages.len() as u32).to_le_bytes())?;
+    for message in messages {
+        writer.write_all(&(message.len() as u32).to_le_bytes())?;
+        writer.write_all(message)?;
+    }
+    writer.flush()?;
+    Ok(())
+}
+
+fn read_request(reader: &mut impl Read) -> anyhow::Result<Option<(u8, Vec<u8>)>> {
+    let mut command = [0];
+    match reader.read_exact(&mut command) {
+        Ok(()) => {}
+        Err(error) if error.kind() == io::ErrorKind::UnexpectedEof => return Ok(None),
+        Err(error) => return Err(error.into()),
+    }
+
+    let mut encoded_len = [0; 4];
+    reader.read_exact(&mut encoded_len)?;
+    let mut payload = vec![0; u32::from_le_bytes(encoded_len) as usize];
+    reader.read_exact(&mut payload)?;
+    Ok(Some((command[0], payload)))
+}
+
+fn main() -> anyhow::Result<()> {
+    let document_id = JournalId::try_from(&[8_u8; 16][..])?;
+    let reducer =
+        include_bytes!("../../../target/wasm32-unknown-unknown/debug/examples/task_reducer.wasm");
+    let mut document = CoordinatorDocument::open(
+        MemoryJournal::open(document_id)?,
+        MemoryJournalFactory,
+        WasmReducer::new(reducer.as_slice())?,
+    )?;
+    let mut protocol = ReplicationProtocol::new();
+    let mut input = io::stdin().lock();
+    let mut output = io::stdout().lock();
+
+    write_batch(
+        &mut output,
+        &[serialize_message(&protocol.start(&document))?],
+    )?;
+
+    while let Some((command, payload)) = read_request(&mut input)? {
+        let mut outgoing = Vec::new();
+        match command {
+            NETWORK_MESSAGE => {
+                let mut payload = Cursor::new(payload);
+                let message: ReplicationMsg = bincode::deserialize_from(&mut payload)?;
+                if let Some(response) = protocol.handle(&mut document, message, &mut payload)? {
+                    outgoing.push(serialize_message(&response)?);
+                }
+            }
+            APPLY_PENDING => document.step()?,
+            command => anyhow::bail!("unknown coordinator command {command}"),
+        }
+
+        if let Some((message, mut frame)) = protocol.sync(&document)? {
+            let mut encoded = serialize_message(&message)?;
+            io::copy(&mut frame, &mut encoded)?;
+            outgoing.push(encoded);
+        }
+        write_batch(&mut output, &outgoing)?;
+    }
+
+    Ok(())
+}
diff --git a/lib/sqlsync/tests/observed_sync_state.rs b/lib/sqlsync/tests/observed_sync_state.rs
new file mode 100644
index 0000000..08c72ce
--- /dev/null
+++ b/lib/sqlsync/tests/observed_sync_state.rs
@@ -0,0 +1,275 @@
+use std::{fmt::Debug, io};
+
+use serde::Serialize;
+use sqlsync::{
+    coordinator::CoordinatorDocument,
+    local::{LocalDocument, NoopSignal},
+    replication::{ReplicationMsg, ReplicationProtocol},
+    JournalId, Lsn, MemoryJournal, MemoryJournalFactory, SyncState, WasmReducer,
+};
+
+#[derive(Serialize)]
+enum Mutation {
+    InitSchema,
+}
+
+fn id(byte: u8) -> JournalId {
+    JournalId::try_from(vec![byte; 16]).unwrap()
+}
+
+fn mutation() -> Vec<u8> {
+    bincode::serialize(&Mutation::InitSchema).unwrap()
+}
+
+trait IntoSyncState {
+    fn into_sync_state(self) -> SyncState;
+}
+
+impl IntoSyncState for SyncState {
+    fn into_sync_state(self) -> SyncState {
+        self
+    }
+}
+
+impl IntoSyncState for Option<SyncState> {
+    fn into_sync_state(self) -> SyncState {
+        self.expect("sync state should be available")
+    }
+}
+
+impl<E: Debug> IntoSyncState for Result<SyncState, E> {
+    fn into_sync_state(self) -> SyncState {
+        self.expect("sync state should be readable")
+    }
+}
+
+fn observed_state(state: impl IntoSyncState) -> SyncState {
+    state.into_sync_state()
+}
+
+fn reducer() -> WasmReducer {
+    // A tiny reducer implementing the repository's existing guest ABI. It
+    // accepts the four-byte test mutation and rejects malformed input.
+    const BYTES: &[u8] = &[
+        0, 97, 115, 109, 1, 0, 0, 0, 1, 13, 3, 96, 1, 127, 1, 127, 96, 1, 127, 0, 96, 0, 0, 3, 7,
+        6, 0, 1, 0, 2, 0, 0, 5, 3, 1, 0, 1, 6, 12, 2, 127, 1, 65, 128, 16, 11, 127, 1, 65, 0, 11,
+        7, 115, 7, 6, 109, 101, 109, 111, 114, 121, 2, 0, 16, 102, 102, 105, 95, 98, 117, 102, 95,
+        97, 108, 108, 111, 99, 97, 116, 101, 0, 0, 18, 102, 102, 105, 95, 98, 117, 102, 95, 100,
+        101, 97, 108, 108, 111, 99, 97, 116, 101, 0, 1, 11, 102, 102, 105, 95, 98, 117, 102, 95,
+        108, 101, 110, 0, 2, 16, 102, 102, 105, 95, 105, 110, 105, 116, 95, 114, 101, 100, 117, 99,
+        101, 114, 0, 3, 10, 102, 102, 105, 95, 114, 101, 100, 117, 99, 101, 0, 4, 16, 102, 102,
+        105, 95, 114, 101, 97, 99, 116, 111, 114, 95, 115, 116, 101, 112, 0, 5, 10, 82, 6, 21, 1,
+        1, 127, 35, 0, 33, 1, 32, 1, 32, 0, 106, 36, 0, 32, 0, 36, 1, 32, 1, 11, 2, 0, 11, 28, 0,
+        32, 0, 65, 128, 8, 70, 4, 127, 65, 5, 5, 32, 0, 65, 136, 8, 70, 4, 127, 65, 1, 5, 35, 1,
+        11, 11, 11, 2, 0, 11, 17, 0, 35, 1, 65, 4, 70, 4, 127, 65, 128, 8, 5, 65, 136, 8, 11, 11,
+        5, 0, 65, 128, 8, 11, 11, 19, 2, 0, 65, 128, 8, 11, 5, 0, 0, 0, 0, 0, 0, 65, 136, 8, 11, 1,
+        0,
+    ];
+    WasmReducer::new(BYTES).unwrap()
+}
+
+fn local_document(
+    document_id: JournalId,
+    timeline_id: JournalId,
+) -> LocalDocument<MemoryJournal, NoopSignal> {
+    LocalDocument::open(
+        MemoryJournal::open(document_id).unwrap(),
+        MemoryJournal::open(timeline_id).unwrap(),
+        reducer(),
+        NoopSignal,
+        NoopSignal,
+        NoopSignal,
+    )
+    .unwrap()
+}
+
+fn observed_watermark(message: &ReplicationMsg) -> Option<Lsn> {
+    match message {
+        ReplicationMsg::Range { range } => range.next().checked_sub(1),
+        _ => panic!("expected a public range acknowledgement"),
+    }
+}
+
+#[test]
+fn successful_mutations_return_timeline_bound_exact_receipts() {
+    let timeline_id = id(1);
+    let mut local = local_document(id(9), timeline_id);
+
+    let first = local.mutate(&mutation()).unwrap();
+    let second = local.mutate(&mutation()).unwrap();
+
+    assert!(first.timeline_id == timeline_id);
+    assert!(first.lsn == 0);
+    assert!(second.timeline_id == timeline_id);
+    assert!(second.lsn == 1);
+    assert_eq!(observed_state(local.sync_state(None)).local, Some(1));
+}
+
+#[test]
+fn failed_mutation_does_not_advance_local_progress() {
+    let timeline_id = id(2);
+    let mut local = local_document(id(9), timeline_id);
+    let accepted = local.mutate(&mutation()).unwrap();
+
+    assert!(local.mutate(b"not a serialized mutation").is_err());
+    let state_after_failure = observed_state(local.sync_state(None));
+    assert!(accepted.timeline_id == timeline_id);
+    assert!(accepted.lsn == 0);
+    assert_eq!(state_after_failure.local, Some(0));
+
+    let accepted_after_failure = local.mutate(&mutation()).unwrap();
+    assert!(accepted_after_failure.timeline_id == timeline_id);
+    assert!(accepted_after_failure.lsn == accepted.lsn + 1);
+    assert_eq!(
+        observed_state(local.sync_state(None)).local,
+        Some(accepted_after_failure.lsn)
+    );
+}
+
+#[test]
+fn stage_order_and_retained_prefix_are_observable() {
+    let document_id = id(6);
+    let timeline_id = id(7);
+    let mut local = local_document(document_id, timeline_id);
+    let mut remote = CoordinatorDocument::open(
+        MemoryJournal::open(document_id).unwrap(),
+        MemoryJournalFactory,
+        reducer(),
+    )
+    .unwrap();
+    let mut upload = ReplicationProtocol::new();
+    let mut download = ReplicationProtocol::new();
+    let mut received = None;
+
+    let start = upload.start(&local);
+    let range = download
+        .handle(&mut remote, start, &mut io::empty())
+        .unwrap()
+        .unwrap();
+    upload.handle(&mut local, range, &mut io::empty()).unwrap();
+
+    let start = download.start(&remote);
+    let range = upload
+        .handle(&mut local, start, &mut io::empty())
+        .unwrap()
+        .unwrap();
+    download
+        .handle(&mut remote, range, &mut io::empty())
+        .unwrap();
+
+    let receipt = local.mutate(&mutation()).unwrap();
+    let receipt_lsn = receipt.lsn;
+    let state = observed_state(local.sync_state(received));
+    assert_eq!(state.local, Some(receipt_lsn));
+    assert_eq!(state.received, None);
+    assert_eq!(state.applied, None);
+
+    while let Some((frame, data)) = upload.sync(&local).unwrap() {
+        let bytes = data.to_owned();
+        let ack = download
+            .handle(&mut remote, frame, &mut &bytes[..])
+            .unwrap()
+            .unwrap();
+        let acknowledgement = observed_watermark(&ack);
+        upload.handle(&mut local, ack, &mut io::empty()).unwrap();
+        received = acknowledgement;
+    }
+    let state = observed_state(local.sync_state(received));
+    assert_eq!(state.local, Some(receipt_lsn));
+    assert_eq!(state.received, Some(receipt_lsn));
+    assert_eq!(state.applied, None);
+
+    remote.step().unwrap();
+    let state = observed_state(local.sync_state(received));
+    assert_eq!(state.received, Some(receipt_lsn));
+    assert_eq!(state.applied, None);
+
+    while let Some((frame, data)) = download.sync(&remote).unwrap() {
+        let bytes = data.to_owned();
+        let ack = upload
+            .handle(&mut local, frame, &mut &bytes[..])
+            .unwrap()
+            .unwrap();
+        download.handle(&mut remote, ack, &mut io::empty()).unwrap();
+    }
+    local.rebase().unwrap();
+
+    let state = observed_state(local.sync_state(received));
+    assert_eq!(state.local, Some(receipt_lsn));
+    assert_eq!(state.received, Some(receipt_lsn));
+    assert_eq!(state.applied, Some(receipt_lsn));
+
+    let next_receipt = local.mutate(&mutation()).unwrap();
+    assert!(next_receipt.timeline_id == timeline_id);
+    assert!(next_receipt.lsn == receipt_lsn + 1);
+    let state = observed_state(local.sync_state(received));
+    assert_eq!(state.local, Some(next_receipt.lsn));
+    assert_eq!(state.received, Some(receipt_lsn));
+    assert_eq!(state.applied, Some(receipt_lsn));
+}
+
+#[test]
+fn applied_progress_is_bound_to_snapshot_timeline() {
+    let document_id = id(20);
+    let timeline_a = id(21);
+    let timeline_b = id(22);
+    let mut source = local_document(document_id, timeline_a);
+    let mut remote = CoordinatorDocument::open(
+        MemoryJournal::open(document_id).unwrap(),
+        MemoryJournalFactory,
+        reducer(),
+    )
+    .unwrap();
+    let mut source_protocol = ReplicationProtocol::new();
+    let mut remote_protocol = ReplicationProtocol::new();
+
+    let start = source_protocol.start(&source);
+    let range = remote_protocol
+        .handle(&mut remote, start, &mut io::empty())
+        .unwrap()
+        .unwrap();
+    source_protocol
+        .handle(&mut source, range, &mut io::empty())
+        .unwrap();
+
+    source.mutate(&mutation()).unwrap();
+    while let Some((frame, data)) = source_protocol.sync(&source).unwrap() {
+        let bytes = data.to_owned();
+        let ack = remote_protocol
+            .handle(&mut remote, frame, &mut &bytes[..])
+            .unwrap()
+            .unwrap();
+        source_protocol
+            .handle(&mut source, ack, &mut io::empty())
+            .unwrap();
+    }
+    remote.step().unwrap();
+
+    let mut other_timeline = local_document(document_id, timeline_b);
+    let mut local_protocol = ReplicationProtocol::new();
+    let mut second_remote_protocol = ReplicationProtocol::new();
+    let start = second_remote_protocol.start(&remote);
+    let range = local_protocol
+        .handle(&mut other_timeline, start, &mut io::empty())
+        .unwrap()
+        .unwrap();
+    second_remote_protocol
+        .handle(&mut remote, range, &mut io::empty())
+        .unwrap();
+    while let Some((frame, data)) = second_remote_protocol.sync(&remote).unwrap() {
+        let bytes = data.to_owned();
+        let ack = local_protocol
+            .handle(&mut other_timeline, frame, &mut &bytes[..])
+            .unwrap()
+            .unwrap();
+        second_remote_protocol
+            .handle(&mut remote, ack, &mut io::empty())
+            .unwrap();
+    }
+    other_timeline.rebase().unwrap();
+
+    let state = observed_state(other_timeline.sync_state(None));
+    assert_eq!(state.timeline_id, timeline_b);
+    assert_eq!(state.local, None);
+    assert_eq!(state.applied, None);
+}
