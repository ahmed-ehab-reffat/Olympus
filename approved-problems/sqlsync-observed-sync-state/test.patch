@@ -0,0 +1,56 @@
+const virtualModules = new Map([
+  [
+    "react",
+    `
+      export function createContext(defaultValue) {
+        return { defaultValue, Provider() {} };
+      }
+      export function createElement() {}
+      export function useCallback(callback) { return callback; }
+      export function useContext() { return globalThis.__sqlsyncHookRuntime; }
+      export function useEffect() {}
+      export function useRef(value) { return { current: value }; }
+      export function useState(value) { return [value, () => {}]; }
+    `,
+  ],
+  [
+    "solid-js",
+    `
+      export function createContext(defaultValue) {
+        return { defaultValue, Provider() {} };
+      }
+      export function createSignal(value) {
+        return [() => value, (next) => { value = next; }];
+      }
+      export function createComponent(component, props) { return component(props); }
+      export function createEffect(effect) { return effect(); }
+      export function onCleanup() {}
+      export function useContext() {
+        return [() => globalThis.__sqlsyncHookRuntime, () => {}];
+      }
+    `,
+  ],
+  [
+    "@orbitinghail/sqlsync-worker",
+    `
+      export class SQLSync {}
+      export function normalizeQuery(value) { return value; }
+      export function pendingPromise() {
+        let resolve;
+        const promise = new Promise((resolvePromise) => { resolve = resolvePromise; });
+        return [promise, resolve];
+      }
+    `,
+  ],
+]);
+
+export async function resolve(specifier, context, nextResolve) {
+  const source = virtualModules.get(specifier);
+  if (source !== undefined) {
+    return {
+      shortCircuit: true,
+      url: `data:text/javascript,${encodeURIComponent(source)}`,
+    };
+  }
+  return nextResolve(specifier, context);
+}
diff --git a/lib/sqlsync-worker/tests/observed_sync_state.hooks.mjs b/lib/sqlsync-worker/tests/observed_sync_state.hooks.mjs
