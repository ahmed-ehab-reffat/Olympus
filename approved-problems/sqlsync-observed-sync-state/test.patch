index 0000000..f55c723
--- /dev/null
+++ b/lib/sqlsync-worker/tests/observed_sync_state.hooks.mjs
@@ -0,0 +1,61 @@
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { isDeepStrictEqual } from "node:util";
+
+const root = process.cwd();
+const react = await import(
+  pathToFileURL(resolve(root, "lib/sqlsync-react/dist/index.js"))
+);
+const solid = await import(
+  pathToFileURL(resolve(root, "lib/sqlsync-solid-js/dist/index.js"))
+);
+
+async function exerciseHook(label, makeMutate, byte) {
+  const docId = new Uint8Array(16).fill(byte);
+  const docType = {
+    reducerUrl: `${label.toLowerCase()}-reducer.wasm`,
+    serializeMutation: () => new Uint8Array([byte]),
+  };
+  const mutation = { source: label, value: byte };
+  const receipt = {
+    timelineId: new Uint8Array(16).fill(byte ^ 0xff),
+    lsn: `1844674407370955${byte}`,
+  };
+  const calls = [];
+  globalThis.__sqlsyncHookRuntime = {
+    mutate(...args) {
+      calls.push(args);
+      return Promise.resolve(receipt);
+    },
+  };
+
+  const mutate = makeMutate(docId, docType);
+  const observedReceipt = await mutate(mutation);
+  if (calls.length !== 1) {
+    throw new Error(`${label} mutation hook invoked SQLSync.mutate ${calls.length} times`);
+  }
+  if (!isDeepStrictEqual(calls[0], [docId, docType, mutation])) {
+    throw new Error(`${label} mutation hook changed the underlying mutation call`);
+  }
+  if (!isDeepStrictEqual(observedReceipt, receipt)) {
+    throw new Error(`${label} mutation hook did not propagate the SQLSync receipt`);
+  }
+  return observedReceipt;
+}
+
+const reactReceipt = await exerciseHook(
+  "React",
+  (docId, docType) => react.createDocHooks(docType).useMutate(docId),
+  0x31,
+);
+const solidReceipt = await exerciseHook(
+  "Solid",
+  (docId, docType) => solid.createDocHooks(() => docType).useMutate(docId),
+  0x42,
+);
+delete globalThis.__sqlsyncHookRuntime;
+
+console.log("HOOK_RUNTIME_PROBE", {
+  react: reactReceipt.lsn,
+  solid: solidReceipt.lsn,
+});
diff --git a/lib/sqlsync-worker/tests/observed_sync_state.mjs b/lib/sqlsync-worker/tests/observed_sync_state.mjs
new file mode 100644
index 0000000..2e00bf9
--- /dev/null
+++ b/lib/sqlsync-worker/tests/observed_sync_state.mjs
@@ -0,0 +1,1271 @@
+import { createHash } from "node:crypto";
+import { spawn } from "node:child_process";
+import { readFile } from "node:fs/promises";
+import { createServer } from "node:http";
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+import { isDeepStrictEqual } from "node:util";
+
+const root = process.cwd();
+const reducerPath = resolve(root, "target/wasm32-unknown-unknown/debug/examples/task_reducer.wasm");
+const apiPath = resolve(root, "lib/sqlsync-worker/sqlsync-wasm/pkg/sqlsync_wasm.js");
+const wasmPath = resolve(root, "lib/sqlsync-worker/sqlsync-wasm/pkg/sqlsync_wasm_bg.wasm");
+const coordinatorPath = resolve(root, "target/debug/examples/observed-sync-state-coordinator");
+
+// Wire-only fixtures. Public LSN values are never decoded or compared to these objects.
+const WIRE_ZERO = Object.freeze({ high: 0, low: 0 });
+const WIRE_HIGH_A = Object.freeze({ high: 0x00200000, low: 0 });
+const WIRE_HIGH_B = Object.freeze({ high: 0x00200000, low: 1 });
+const WIRE_HIGH_C = Object.freeze({ high: 0x00200000, low: 2 });
+const WIRE_UNSIGNED_HALF_A = Object.freeze({ high: 0x80000000, low: 0 });
+const WIRE_UNSIGNED_HALF_B = Object.freeze({ high: 0x80000000, low: 1 });
+const WIRE_NEAR_U64_MAX = Object.freeze({ high: 0xffffffff, low: 0xfffffffe });
+
+function writeU64LE(buffer, offset, { low, high }) {
+  buffer.writeUInt32LE(low, offset);
+  buffer.writeUInt32LE(high, offset + 4);
+}
+
+function rangeMessage(last) {
+  if (last === undefined) {
+    const msg = Buffer.alloc(16);
+    msg.writeUInt32LE(1, 0);
+    msg.writeUInt32LE(0, 4);
+    writeU64LE(msg, 8, WIRE_ZERO);
+    return msg;
+  }
+
+  const msg = Buffer.alloc(24);
+  msg.writeUInt32LE(1, 0);
+  msg.writeUInt32LE(1, 4);
+  writeU64LE(msg, 8, WIRE_ZERO);
+  writeU64LE(msg, 16, last);
+  return msg;
+}
+
+function emptyFollowingRangeMessage(next) {
+  const msg = Buffer.alloc(16);
+  msg.writeUInt32LE(1, 0);
+  msg.writeUInt32LE(0, 4);
+  writeU64LE(msg, 8, next);
+  return msg;
+}
+
+function binaryFrame(payload) {
+  if (payload.length < 126) {
+    return Buffer.concat([Buffer.from([0x82, payload.length]), payload]);
+  }
+  const header = Buffer.alloc(4);
+  header[0] = 0x82;
+  header[1] = 126;
+  header.writeUInt16BE(payload.length, 2);
+  return Buffer.concat([header, payload]);
+}
+
+function consumeFrames(socket, onBinary) {
+  let pending = Buffer.alloc(0);
+  socket.on("data", (chunk) => {
+    pending = Buffer.concat([pending, chunk]);
+    while (pending.length >= 2) {
+      const opcode = pending[0] & 0x0f;
+      const masked = (pending[1] & 0x80) !== 0;
+      let length = pending[1] & 0x7f;
+      let offset = 2;
+      if (length === 126) {
+        if (pending.length < 4) return;
+        length = pending.readUInt16BE(2);
+        offset = 4;
+      } else if (length === 127) {
+        if (pending.length < 10) return;
+        const longHigh = pending.readUInt32BE(2);
+        const longLow = pending.readUInt32BE(6);
+        if (longHigh > 0x1fffff) {
+          throw new Error("oversized WebSocket frame");
+        }
+        length = longHigh * 0x100000000 + longLow;
+        offset = 10;
+      }
+      const maskLength = masked ? 4 : 0;
+      if (pending.length < offset + maskLength + length) return;
+      const mask = masked ? pending.subarray(offset, offset + 4) : undefined;
+      offset += maskLength;
+      const payload = Buffer.from(pending.subarray(offset, offset + length));
+      pending = pending.subarray(offset + length);
+      if (mask) {
+        for (let i = 0; i < payload.length; i += 1) {
+          payload[i] ^= mask[i % 4];
+        }
+      }
+      if (opcode === 2) onBinary(payload);
+      if (opcode === 8) socket.end();
+    }
+  });
+}
+
+async function waitUntil(predicate, label, timeoutMs = 5000) {
+  const deadline = Date.now() + timeoutMs;
+  while (!(await predicate())) {
+    if (Date.now() >= deadline) throw new Error(`timed out waiting for ${label}`);
+    await new Promise((resolveWait) => setTimeout(resolveWait, 10));
+  }
+}
+
+function startCoordinatorHelper() {
+  const child = spawn(coordinatorPath, [], { stdio: ["pipe", "pipe", "inherit"] });
+  const chunks = child.stdout[Symbol.asyncIterator]();
+  let buffered = Buffer.alloc(0);
+
+  async function readBytes(length) {
+    while (buffered.length < length) {
+      const next = await chunks.next();
+      if (next.done) throw new Error("coordinator helper closed its output unexpectedly");
+      buffered = Buffer.concat([buffered, next.value]);
+    }
+    const value = buffered.subarray(0, length);
+    buffered = buffered.subarray(length);
+    return value;
+  }
+
+  async function readBatch() {
+    const count = (await readBytes(4)).readUInt32LE(0);
+    const messages = [];
+    for (let index = 0; index < count; index += 1) {
+      const length = (await readBytes(4)).readUInt32LE(0);
+      messages.push(await readBytes(length));
+    }
+    return messages;
+  }
+
+  const initial = readBatch();
+  let queue = initial.then(() => undefined);
+  function exchange(command, payload = Buffer.alloc(0)) {
+    const request = queue.then(async () => {
+      const header = Buffer.alloc(5);
+      header[0] = command;
+      header.writeUInt32LE(payload.length, 1);
+      await new Promise((resolveWrite, rejectWrite) => {
+        child.stdin.write(Buffer.concat([header, payload]), (error) => {
+          if (error) rejectWrite(error);
+          else resolveWrite();
+        });
+      });
+      return readBatch();
+    });
+    queue = request.then(
+      () => undefined,
+      () => undefined,
+    );
+    return request;
+  }
+
+  return {
+    initial,
+    network: (payload) => exchange(0, payload),
+    apply: () => exchange(1),
+    close() {
+      child.stdin.end();
+    },
+  };
+}
+
+function timelineId(value, label) {
+  if (typeof value !== "object" || value === null) {
+    throw new Error(`${label} is not a structured public value`);
+  }
+  const timeline = "timelineId" in value ? value.timelineId : value.timeline_id;
+  if (timeline === undefined || timeline === null) {
+    throw new Error(`${label} does not expose its timeline identifier`);
+  }
+  return timeline;
+}
+
+function isAbsent(value) {
+  return value === undefined || value === null;
+}
+
+function assertSyncProgressAbsent(state, label) {
+  for (const field of ["local", "received", "applied"]) {
+    if (!isAbsent(state[field])) {
+      throw new Error(`${label} unexpectedly exposed ${field} progress`);
+    }
+  }
+}
+
+function assertBrowserLsnIsNotNumber(value, label) {
+  if (!isAbsent(value) && typeof value === "number") {
+    throw new Error(`${label} was exposed as a JavaScript number`);
+  }
+}
+
+function assertSameSyncState(actual, expected, label) {
+  for (const field of ["local", "received", "applied"]) {
+    assertBrowserLsnIsNotNumber(actual[field], `${label} callback ${field}`);
+    assertBrowserLsnIsNotNumber(expected[field], `${label} snapshot ${field}`);
+  }
+  if (
+    !isDeepStrictEqual(timelineId(actual, `${label} callback`), timelineId(expected, label)) ||
+    !isDeepStrictEqual(actual.local, expected.local) ||
+    !isDeepStrictEqual(actual.received, expected.received) ||
+    !isDeepStrictEqual(actual.applied, expected.applied)
+  ) {
+    throw new Error(`${label} callback did not contain the current SyncState snapshot`);
+  }
+}
+
+function receiptWith(receipt, timeline, lsn) {
+  const timelineField = "timelineId" in receipt ? "timelineId" : "timeline_id";
+  return { ...receipt, [timelineField]: timeline, lsn };
+}
+
+async function assertOlderReceiptUsesInclusiveWatermarks(
+  sqlsync,
+  docId,
+  docType,
+  olderReceipt,
+  expectedStatus,
+) {
+  const actualStatus = await sqlsync.mutationStatus(docId, docType, olderReceipt);
+  if (actualStatus !== expectedStatus) {
+    throw new Error(`browser classifier did not classify an older receipt as ${expectedStatus}`);
+  }
+}
+
+async function assertOpaqueFutureReceiptRoundTrips(sqlsync, docId, docType, receipt, lsn, label) {
+  if (typeof lsn === "number") {
+    throw new Error(`${label} was exposed as a JavaScript number`);
+  }
+  let status;
+  try {
+    status = await sqlsync.mutationStatus(
+      docId,
+      docType,
+      receiptWith(receipt, timelineId(receipt, "mutation receipt"), lsn),
+    );
+  } catch (error) {
+    throw new Error(`${label} could not round-trip through the public receipt API`, {
+      cause: error,
+    });
+  }
+  if (status !== undefined) {
+    throw new Error(`${label} was not preserved as an above-local receipt`);
+  }
+}
+
+async function main() {
+  class NodeWorkerGlobalScope {}
+  Object.defineProperty(NodeWorkerGlobalScope, Symbol.hasInstance, {
+    value: () => true,
+  });
+  globalThis.WorkerGlobalScope = NodeWorkerGlobalScope;
+
+  const reducer = await readFile(reducerPath);
+  const sockets = new Set();
+  let binaryMessages = 0;
+  let reconnectWatermark;
+  let allowMutationAcknowledgement = false;
+
+  const server = createServer((req, res) => {
+    if (req.url === "/reducer.wasm") {
+      res.writeHead(200, { "content-type": "application/wasm" });
+      res.end(reducer);
+      return;
+    }
+    res.writeHead(404);
+    res.end();
+  });
+
+  server.on("upgrade", (req, socket) => {
+    sockets.add(socket);
+    socket.on("close", () => sockets.delete(socket));
+    const key = req.headers["sec-websocket-key"];
+    const accept = createHash("sha1")
+      .update(`${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`)
+      .digest("base64");
+    socket.write(
+      `HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${accept}\r\n\r\n`,
+    );
+    consumeFrames(socket, () => {
+      binaryMessages += 1;
+      if (reconnectWatermark !== undefined && reconnectWatermark !== null) {
+        socket.write(binaryFrame(rangeMessage(reconnectWatermark)));
+      } else if (reconnectWatermark === null) {
+        return;
+      } else if (binaryMessages === 1) {
+        socket.write(binaryFrame(rangeMessage()));
+      } else if (allowMutationAcknowledgement) {
+        socket.write(binaryFrame(rangeMessage(WIRE_ZERO)));
+      }
+    });
+  });
+
+  await new Promise((resolveListen) => server.listen(0, "127.0.0.1", resolveListen));
+  const address = server.address();
+  if (typeof address === "string" || address === null) throw new Error("missing server port");
+  const base = `127.0.0.1:${address.port}`;
+
+  const module = await import(pathToFileURL(apiPath));
+  await module.default({ module_or_path: await readFile(wasmPath) });
+
+  let activeWorker;
+  let workerRequestCount = 0;
+  const workerActivities = [];
+  const deliver = (message) => {
+    workerActivities.push("delivery");
+    queueMicrotask(() => activeWorker?.onmessage?.({ data: message }));
+  };
+  const ports = {
+    sendOne(_port, msg) {
+      deliver(msg);
+    },
+    sendMany(_ports, msg) {
+      deliver(msg);
+    },
+    sendAll(msg) {
+      deliver(msg);
+    },
+  };
+  let activeApi = new module.WorkerApi(ports, `ws://${base}`);
+  const docId = new Uint8Array(16).fill(7);
+
+  class ForwardingWorker {
+    onmessage = null;
+    queue = Promise.resolve();
+    heldDocumentRequest = undefined;
+    shouldHoldNextDocumentRequest = false;
+
+    constructor() {
+      activeWorker = this;
+    }
+
+    schedule(message) {
+      this.queue = this.queue.then(async () => {
+        if (message.tag === "Boot") {
+          deliver({ tag: "Reply", handlerId: message.handlerId, reply: { tag: "Ack" } });
+        } else if (message.tag === "Doc") {
+          await activeApi.handle({ portId: 1, ...message });
+        } else if (message.tag !== "Close") {
+          throw new Error(`unknown outer worker request: ${message.tag}`);
+        }
+      });
+    }
+
+    postMessage(message) {
+      workerRequestCount += 1;
+      workerActivities.push("request");
+      if (message.tag === "Doc" && this.shouldHoldNextDocumentRequest) {
+        this.shouldHoldNextDocumentRequest = false;
+        this.heldDocumentRequest = message;
+        return;
+      }
+      this.schedule(message);
+    }
+
+    holdNextDocumentRequest() {
+      if (this.shouldHoldNextDocumentRequest || this.heldDocumentRequest !== undefined) {
+        throw new Error("a document request is already held");
+      }
+      this.shouldHoldNextDocumentRequest = true;
+    }
+
+    get hasHeldDocumentRequest() {
+      return this.heldDocumentRequest !== undefined;
+    }
+
+    async releaseHeldDocumentRequest() {
+      if (this.heldDocumentRequest === undefined) {
+        throw new Error("no document request is held");
+      }
+      const message = this.heldDocumentRequest;
+      this.heldDocumentRequest = undefined;
+      this.schedule(message);
+      await this.queue;
+    }
+  }
+
+  globalThis.Worker = ForwardingWorker;
+  const facadeModule = await import(
+    pathToFileURL(resolve(root, "lib/sqlsync-worker/dist/index.js"))
+  );
+  const sqlsync = new facadeModule.SQLSync("worker.js", "sqlsync.wasm", `ws://${base}`);
+  const connectionStatuses = [];
+  const removeConnectionListener = sqlsync.addConnectionStatusListener((status) => {
+    connectionStatuses.push(status);
+  });
+  const docType = {
+    reducerUrl: `http://${base}/reducer.wasm`,
+    serializeMutation: (mutation) =>
+      mutation.rejectReducer ? new Uint8Array([0xff]) : new Uint8Array(4),
+  };
+  const observedStates = [];
+  let unsubscribePrimaryDuringNextChange = false;
+  let unsubscribeSyncState = () => {};
+  unsubscribeSyncState = await sqlsync.subscribeSyncState(docId, docType, {
+    handleState(observedState) {
+      observedStates.push(observedState);
+      if (unsubscribePrimaryDuringNextChange) {
+        unsubscribePrimaryDuringNextChange = false;
+        unsubscribeSyncState();
+      }
+    },
+  });
+  if (observedStates.length === 0) {
+    throw new Error("sync-state subscription did not deliver its current snapshot");
+  }
+  const initialState = await sqlsync.syncState(docId, docType);
+  const initialObservedState = observedStates.at(-1);
+  assertSameSyncState(initialObservedState, initialState, "initial subscription");
+  assertSyncProgressAbsent(initialObservedState, "initial subscription callback");
+  assertSyncProgressAbsent(initialState, "initial syncState snapshot");
+  const initialTimeline = timelineId(initialState, "initial syncState snapshot");
+  await waitUntil(
+    () => sqlsync.connectionStatus === "connected",
+    "stable connected state before local mutation",
+  );
+
+  const scopedDocId = new Uint8Array(16).fill(6);
+  const scopedObservedStates = [];
+  const unsubscribeScopedSyncState = await sqlsync.subscribeSyncState(
+    scopedDocId,
+    docType,
+    {
+      handleState(observedState) {
+        scopedObservedStates.push(observedState);
+      },
+    },
+  );
+  if (scopedObservedStates.length === 0) {
+    throw new Error("second document subscription did not deliver its current snapshot");
+  }
+  const scopedInitialState = await sqlsync.syncState(scopedDocId, docType);
+  assertSameSyncState(
+    scopedObservedStates.at(-1),
+    scopedInitialState,
+    "second document initial subscription",
+  );
+  assertSyncProgressAbsent(scopedInitialState, "second document initial snapshot");
+  const scopedInitialTimeline = timelineId(
+    scopedInitialState,
+    "second document initial snapshot",
+  );
+  await waitUntil(
+    () => sqlsync.connectionStatus === "connected",
+    "stable second document connection before scoped mutations",
+  );
+  const requestsBeforeIdleSubscription = workerRequestCount;
+  await new Promise((resolveWait) => setTimeout(resolveWait, 5100));
+  if (workerRequestCount !== requestsBeforeIdleSubscription) {
+    throw new Error("idle sync-state subscriptions polled the worker");
+  }
+
+  const scopedObservationsBeforeMutation = scopedObservedStates.length;
