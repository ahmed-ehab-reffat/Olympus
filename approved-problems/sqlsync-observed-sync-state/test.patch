+import { createDocHooks as createReactDocHooks } from "../../sqlsync-react/dist/index";
+import { createDocHooks as createSolidDocHooks } from "../../sqlsync-solid-js/dist/index";
+import type { DocType, MutationReceipt } from "../src/index";
+
+type Mutation = { value: string };
+type Equal<A, B> = (<T>() => T extends A ? 1 : 2) extends <T>() => T extends B ? 1 : 2
+  ? true
+  : false;
+
+declare const docType: DocType<Mutation>;
+
+const reactHooks = createReactDocHooks(docType);
+const solidHooks = createSolidDocHooks(() => docType);
+
+type ReactMutate = ReturnType<(typeof reactHooks)["useMutate"]>;
+type SolidMutate = ReturnType<(typeof solidHooks)["useMutate"]>;
+
+function assertType<T extends true>() {}
+
+assertType<Equal<ReturnType<ReactMutate>, Promise<MutationReceipt>>>();
+assertType<Equal<ReturnType<SolidMutate>, Promise<MutationReceipt>>>();
