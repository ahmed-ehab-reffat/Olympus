+    reducerUrl: `http://${appliedBase}/reducer.wasm`,
+    serializeMutation: () => new Uint8Array(4),
+  };
+  const appliedObservedStates = [];
+  const unsubscribeAppliedSyncState = await appliedSqlsync.subscribeSyncState(
+    appliedDocId,
+    appliedDocType,
+    {
+      handleState(observedState) {
+        appliedObservedStates.push(observedState);
+      },
+    },
+  );
+  const removedAppliedObservedStates = [];
+  const unsubscribeRemovedAppliedSyncState = await appliedSqlsync.subscribeSyncState(
+    appliedDocId,
+    appliedDocType,
+    {
+      handleState(observedState) {
+        removedAppliedObservedStates.push(observedState);
+      },
+    },
+  );
+  if (removedAppliedObservedStates.length !== 1) {
+    throw new Error("applied-flow peer did not receive exactly one initial snapshot");
+  }
+  const appliedInitialState = await appliedSqlsync.syncState(appliedDocId, appliedDocType);
+  const receiptWithoutLocalProgress = receiptWith(
+    receipt,
+    timelineId(appliedInitialState, "fresh applied-flow sync state"),
+    receipt.lsn,
+  );
+  if (
+    (await appliedSqlsync.mutationStatus(
+      appliedDocId,
+      appliedDocType,
+      receiptWithoutLocalProgress,
+    )) !== undefined
+  ) {
+    throw new Error("browser classifier accepted a receipt without local progress");
+  }
+  await waitUntil(() => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    return appliedSqlsync.connectionStatus === "connected";
+  }, "coordinator-backed worker connection");
+
+  const appliedReceipt = await appliedSqlsync.mutate(appliedDocId, appliedDocType, {
+    value: "apply mutation",
+  });
+  assertBrowserLsnIsNotNumber(appliedReceipt.lsn, "applied-flow mutation receipt LSN");
+  let beforeApplication;
+  await waitUntil(async () => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    beforeApplication = await appliedSqlsync.syncState(appliedDocId, appliedDocType);
+    return isDeepStrictEqual(beforeApplication.received, appliedReceipt.lsn);
+  }, "coordinator receipt before application");
+  if (isDeepStrictEqual(beforeApplication.applied, appliedReceipt.lsn)) {
+    throw new Error("applied watermark advanced before coordinator application was visible");
+  }
+  if (
+    (await appliedSqlsync.mutationStatus(appliedDocId, appliedDocType, appliedReceipt)) !==
+    "received"
+  ) {
+    throw new Error("browser classifier skipped the received stage before application");
+  }
+
+  if (typeof sendCoordinatorMessages !== "function") {
+    throw new Error("coordinator-backed worker did not establish a socket");
+  }
+  const firstApplicationMessages = await coordinator.apply();
+  const observationsBeforeFirstAppliedReturn = appliedObservedStates.length;
+  await sendCoordinatorMessages(firstApplicationMessages);
+  await waitUntil(() => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    return appliedObservedStates
+      .slice(observationsBeforeFirstAppliedReturn)
+      .some((observed) => isDeepStrictEqual(observed.applied, appliedReceipt.lsn));
+  }, "subscription first applied observation after coordinator application and rebase");
+  let firstAppliedState;
+  await waitUntil(async () => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    firstAppliedState = await appliedSqlsync.syncState(appliedDocId, appliedDocType);
+    return isDeepStrictEqual(firstAppliedState.applied, appliedReceipt.lsn);
+  }, "worker first applied watermark after coordinator application and rebase");
+  if (
+    (await appliedSqlsync.mutationStatus(appliedDocId, appliedDocType, appliedReceipt)) !==
+    "applied"
+  ) {
+    throw new Error("browser classifier did not report the first applied mutation");
+  }
+
+  const newerAppliedReceipt = await appliedSqlsync.mutate(appliedDocId, appliedDocType, {
+    value: "newer apply mutation",
+  });
+  assertBrowserLsnIsNotNumber(
+    newerAppliedReceipt.lsn,
+    "newer applied-flow mutation receipt LSN",
+  );
+  if (isDeepStrictEqual(newerAppliedReceipt.lsn, appliedReceipt.lsn)) {
+    throw new Error("mutation after rebase reused the applied prefix LSN");
+  }
+  let mixedStageState;
+  await waitUntil(async () => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    mixedStageState = await appliedSqlsync.syncState(appliedDocId, appliedDocType);
+    return (
+      isDeepStrictEqual(mixedStageState.local, newerAppliedReceipt.lsn) &&
+      isDeepStrictEqual(mixedStageState.received, newerAppliedReceipt.lsn) &&
+      isDeepStrictEqual(mixedStageState.applied, appliedReceipt.lsn)
+    );
+  }, "mixed applied and received watermarks for successive mutations");
+  await assertOlderReceiptUsesInclusiveWatermarks(
+    appliedSqlsync,
+    appliedDocId,
+    appliedDocType,
+    appliedReceipt,
+    "applied",
+  );
+  if (
+    (await appliedSqlsync.mutationStatus(
+      appliedDocId,
+      appliedDocType,
+      newerAppliedReceipt,
+    )) !== "received"
+  ) {
+    throw new Error("browser classifier collapsed a newer received mutation into applied");
+  }
+
+  unsubscribeRemovedAppliedSyncState();
+  await appliedSqlsync.syncState(appliedDocId, appliedDocType);
+  const removedAppliedObservationsBeforeApplication = removedAppliedObservedStates.length;
+  const applicationMessages = await coordinator.apply();
+  const observationsBeforeAppliedReturn = appliedObservedStates.length;
+  await sendCoordinatorMessages(applicationMessages);
+  await waitUntil(() => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    return appliedObservedStates
+      .slice(observationsBeforeAppliedReturn)
+      .some((observed) => isDeepStrictEqual(observed.applied, newerAppliedReceipt.lsn));
+  }, "subscription applied observation after coordinator application and rebase");
+  let appliedState;
+  await waitUntil(async () => {
+    if (appliedBridgeError) throw appliedBridgeError;
+    appliedState = await appliedSqlsync.syncState(appliedDocId, appliedDocType);
+    return isDeepStrictEqual(appliedState.applied, newerAppliedReceipt.lsn);
+  }, "worker applied watermark after coordinator application and rebase");
+  if (
+    removedAppliedObservedStates.length !== removedAppliedObservationsBeforeApplication
+  ) {
+    throw new Error("unsubscribed listener received a later applied-progress change");
+  }
+  if (
+    !isDeepStrictEqual(
+      timelineId(appliedReceipt, "applied mutation receipt"),
+      timelineId(appliedState, "applied sync state"),
+    )
+  ) {
+    throw new Error("applied receipt and SyncState identify different timelines");
+  }
+  await assertOlderReceiptUsesInclusiveWatermarks(
+    appliedSqlsync,
+    appliedDocId,
+    appliedDocType,
+    appliedReceipt,
+    "applied",
+  );
+  assertBrowserLsnIsNotNumber(appliedState.local, "applied-flow local watermark");
+  assertBrowserLsnIsNotNumber(appliedState.received, "applied-flow received watermark");
+  assertBrowserLsnIsNotNumber(appliedState.applied, "applied-flow applied watermark");
+
+  console.log("BROWSER_PROBE", {
+    receipt: receipt.lsn,
+    received: state.received,
+    disconnectedReceived: disconnected.received,
+    firstHighReceived: firstHighState.received,
+    secondHighReceived: secondHighState.received,
+    lowerFreshReceived: lowerFreshState.received,
+    emptyFollowingReceived: emptyFollowingState.received,
+    firstUpperHalfReceived: unsignedHalfStateA.received,
+    secondUpperHalfReceived: unsignedHalfStateB.received,
+    applied: appliedState.applied,
+    subscriptionObservations: observationsBeforeUnsubscribe,
+    appliedSubscriptionObservations: appliedObservedStates.length,
+  });
+  unsubscribeAppliedSyncState();
+  appliedSqlsync.close();
+  appliedServer.close();
+  for (const socket of appliedSockets) socket.destroy();
+  coordinator.close();
+}
+
+main().then(
+  () => process.exit(0),
+  (error) => {
+    console.error(error);
+    process.exit(1);
+  },
+);
