+def test_eigenvalue_residual_vanishes():
+    sol = _solve(_bar(), n_modes=5)
+
+    for im in range(sol.n_modes):
+        vec = sol.reduced_vectors[:, im]
+        res = sol.mtx_k @ vec - sol.eigenvalues[im] * (sol.mtx_m @ vec)
+        assert nm.abs(res).max() < 1e-6 * nm.abs(sol.mtx_k @ vec).max()
+
