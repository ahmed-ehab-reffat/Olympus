+
+    pb = _make_problem((1.0, 0.2), (5, 3), names=('kk', 'mm'))
+    reference = solve_modes(pb, n_modes=3, stiffness='kk', mass='mm')
+    positional = pb.solve_modes(3, 'kk', 'mm')
