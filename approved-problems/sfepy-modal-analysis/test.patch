+def test_the_package_exports_the_modal_names():
+    import sfepy.discrete as sd
+
+    for name in ['ModalSolution', 'solve_modes', 'assemble_matrices',
+                 'rayleigh_coefficients', 'rayleigh_damping_ratios']:
