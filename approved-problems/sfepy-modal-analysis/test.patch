+def test_the_repeated_rigid_eigenspace_is_matched_as_a_subspace():
+    pb = _bar(fixed=False)
+    sol = _solve(pb, n_modes=6)
+    rigid = sol.rigid_body_vectors()[_active(pb)]
+    modes = sol.reduced_vectors[:, :3]
+
+    basis = nm.linalg.qr(modes)[0]
+    for ic in range(rigid.shape[1]):
+        vec = rigid[:, ic]
+        residual = vec - basis @ (basis.T @ vec)
+        assert nm.abs(residual).max() < 1e-6 * nm.abs(vec).max()
+
+    rigid_basis = nm.linalg.qr(rigid)[0]
+    for im in range(3):
+        vec = sol.reduced_vectors[:, im]
+        residual = vec - rigid_basis @ (rigid_basis.T @ vec)
+        assert nm.abs(residual).max() < 1e-6 * nm.abs(vec).max()
+
