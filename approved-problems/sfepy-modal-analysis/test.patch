+#!/bin/sh
+set -e
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+export HOME="${HOME:-/app}"
+export PYTHONPATH="$(pwd):${PYTHONPATH}"
+export MPLBACKEND=Agg
+
+NEW_TESTS="sfepy/tests/test_modal_d415c2.py"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT="--junitxml=$OUTPUT_PATH"
+else
+  JUNIT=""
+fi
+
+set +e
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -p no:cacheprovider -W ignore $JUNIT
+else
+  python -m pytest sfepy/tests --ignore="$NEW_TESTS" -p no:cacheprovider \
+    -W ignore $JUNIT
+fi
+EXIT_CODE=$?
+set -e
+
+exit $EXIT_CODE
