+def test_modal_quantities_are_the_diagonal_products():
+    plain = _solve(_bar(), n_modes=4)
+
+    for sol in [plain, plain.normalize('max')]:
+        masses = sol.modal_masses()
+        stiffnesses = sol.modal_stiffnesses()
+        for im in range(sol.n_modes):
+            vec = sol.reduced_vectors[:, im]
+            assert nm.allclose(masses[im], vec @ (sol.mtx_m @ vec))
+            assert nm.allclose(stiffnesses[im], vec @ (sol.mtx_k @ vec))
+
+    assert not nm.allclose(plain.normalize('max').modal_masses(), 1.0)
