+def test_frequency_follows_from_eigenvalue():
+    sol = _solve(_bar(), n_modes=4)
+
+    assert nm.allclose(sol.omegas, nm.sqrt(sol.eigenvalues))
+    assert nm.allclose(sol.frequencies, sol.omegas / (2.0 * nm.pi))
