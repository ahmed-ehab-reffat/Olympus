+def test_damped_complete_quadratic_combination_matches_the_formula():
+    sol = _solve(_bar(), n_modes=4)
+    spectrum = nm.array([1.0, 1.5, 2.0, 2.5])
+    zeta = 0.07
+    peaks = (sol.participation_factors()[:, 0] * spectrum
+             / (sol.modal_masses() * sol.omegas ** 2))
+    responses = sol.vectors * peaks[None, :]
+
+    rho = nm.zeros((4, 4))
+    for ii in range(4):
+        for jj in range(4):
+            rr = sol.omegas[ii] / sol.omegas[jj]
+            rho[ii, jj] = (8.0 * zeta ** 2 * (1.0 + rr) * rr ** 1.5
+                           / ((1.0 - rr ** 2) ** 2
+                              + 4.0 * zeta ** 2 * rr * (1.0 + rr) ** 2))
+
+    expected = nm.sqrt(nm.einsum('ij,jk,ik->i', responses, rho, responses))
+    out = sol.response_spectrum(spectrum, 0, damping=zeta, rule='cqc')
+
+    assert nm.abs(expected).max() > 0.0
+    assert nm.allclose(out, expected)
