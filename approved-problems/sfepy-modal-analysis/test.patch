+def test_a_load_driven_response_honours_the_constrained_region():
+    pb = _make_problem((1.0, 0.2), (5, 3), lcbc=True)
+    sol = _solve(pb, n_modes=6)
+    variables = pb.get_variables()
+    coors = variables['u'].field.get_coor()
+    right = nm.where(coors[:, 0] > (1.0 - 1e-10))[0]
+    order = nm.argsort(coors[right, 1])
+    right = right[order]
+    arms = coors[right, 1] - coors[right[0], 1]
+
+    load = nm.zeros(variables.di.n_dof_total)
+    load[-1] = 1.0e3
+    out = sol.frequency_response([0.0], load)[0].real.reshape(-1, 2)[right]
+    scale = nm.abs(out).max()
+    spins = (out[1:, 0] - out[0, 0]) / arms[1:]
+
+    assert scale > 0.0
+    assert nm.abs(out[:, 1] - out[0, 1]).max() < 1e-8 * scale
+    assert nm.abs(spins - spins[0]).max() < 1e-8 * scale / arms[-1]
