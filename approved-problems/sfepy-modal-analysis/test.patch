+def test_free_block_has_three_rigid_body_modes():
+    sol = _solve(_bar(fixed=False), n_modes=6)
+    stiffnesses = sol.modal_stiffnesses()
+
+    assert (stiffnesses[:3] < 1e-8 * stiffnesses[3]).all()
+    assert (stiffnesses[3:] > 0.0).all()
