+def test_a_damped_response_under_a_linear_combination_matches_the_formula():
+    pb = _make_problem((1.0, 0.2), (5, 3), lcbc=True)
+    sol = _solve(pb, n_modes=4)
+    variables = pb.get_variables()
+    load = nm.zeros(variables.di.n_dof_total)
+    load[-1] = 1.0e3
+    reduced = variables.mtx_lcbc.T @ load[_active(pb)]
+
+    zeta = 0.05
+    omega = 2.0 * nm.pi * 9.0
+    masses = sol.modal_masses()
+    denominators = (sol.modal_stiffnesses() - omega ** 2 * masses
+                    + 2j * zeta * omega * sol.omegas * masses)
+    coors = (sol.reduced_vectors.T @ reduced) / denominators
+    expected = sol.expand(sol.reduced_vectors @ coors)
+    out = sol.frequency_response([9.0], load, damping=zeta)[0]
+
+    assert nm.abs(out).max() > 0.0
+    assert nm.allclose(out, expected)
+
