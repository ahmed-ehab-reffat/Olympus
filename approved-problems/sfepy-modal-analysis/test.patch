+def test_a_damped_start_and_a_ramp_add_up():
+    pb = _bar()
+    sol = _solve(pb, n_modes=1).normalize('max')
+    shape = sol.vectors[:, 0]
+    load = nm.zeros(shape.shape[0])
+    load[-1] = 1.0e3
+    zeta = 0.04
+    duration = 3.0 / sol.frequencies[0]
+    times = nm.linspace(0.0, duration, 1201)
+    history = times / duration
+
+    both = sol.transient_response(times, load, history, damping=zeta,
+                                  displacement=shape, velocity=shape)
+    free = sol.transient_response(times, nm.zeros_like(load),
+                                  nm.zeros_like(times), damping=zeta,
+                                  displacement=shape, velocity=shape)
+    forced = sol.transient_response(times, load, history, damping=zeta)
+
+    omega = sol.omegas[0]
+    damped = omega * nm.sqrt(1.0 - zeta ** 2)
+    decay = nm.exp(-zeta * omega * times)
+    start = sol.project(shape)[0]
+    rate = sol.project(shape)[0]
+    coors = decay * (start * nm.cos(damped * times)
+                     + (rate + zeta * omega * start) / damped
+                     * nm.sin(damped * times))
+    expected = nm.outer(coors, sol.vectors[:, 0])
+
+    assert nm.abs(both).max() > 0.0
+    assert nm.allclose(both, free + forced)
+    assert nm.abs(free - expected).max() < 1e-8 * nm.abs(expected).max()
+
