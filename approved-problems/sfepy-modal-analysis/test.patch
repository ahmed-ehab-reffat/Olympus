+import numpy as nm
+import pytest
+import scipy.linalg as sla
+import scipy.sparse as sps
+
+from sfepy.base.base import Struct
+from sfepy.discrete import (FieldVariable, Material, Integral, Equation,
+                            Equations, Problem)
+from sfepy.discrete.conditions import (Conditions, EssentialBC,
+                                       LinearCombinationBC)
+from sfepy.discrete.fem import FEDomain, Field
+from sfepy.mechanics.matcoefs import stiffness_from_youngpoisson
+from sfepy.mesh.mesh_generators import gen_block_mesh
+from sfepy.terms import Term
+
+YOUNG = 1.0e10
+RHO = 1000.0
+
+
+def _make_problem(dims, shape, order=1, fixed=True, poisson=0.0, lcbc=False,
+                  scalar=False, names=('stiffness', 'mass'), extra_var=False,
+                  fixed_value=0.0):
+    dims = nm.array(dims, dtype=nm.float64)
+    shape = nm.array(shape, dtype=nm.int32)
+    centre = 0.5 * dims
+    mesh = gen_block_mesh(dims, shape, centre, name='block', verbose=False)
+    domain = FEDomain('domain', mesh)
+    dim = len(dims)
+
+    omega = domain.create_region('Omega', 'all')
+    left = domain.create_region('Left', 'vertices in (x < 1e-10)', 'facet')
+    right = domain.create_region('Right', 'vertices in (x > %.10f)'
+                                 % (dims[0] - 1e-10), 'facet')
+
+    kind = 'scalar' if scalar else 'vector'
+    field = Field.from_args('fu', nm.float64, kind, omega,
+                            approx_order=order)
+    u = FieldVariable('u', 'unknown', field)
+    v = FieldVariable('v', 'test', field, primary_var_name='u')
+
+    integral = Integral('i', order=2 * order + 1)
+    if scalar:
+        mat = Material('m', c=1.0, rho=RHO)
+        t1 = Term.new('dw_laplace(m.c, v, u)', integral, omega, m=mat, v=v,
+                      u=u)
+
+    else:
+        mat = Material('m', D=stiffness_from_youngpoisson(dim, YOUNG,
+                                                          poisson),
+                       rho=RHO)
+        t1 = Term.new('dw_lin_elastic(m.D, v, u)', integral, omega, m=mat,
+                      v=v, u=u)
+
+    t2 = Term.new('dw_dot(m.rho, v, u)', integral, omega, m=mat, v=v, u=u)
+
+    eqs = [Equation(names[0], t1), Equation(names[1], t2)]
+    if extra_var:
+        field2 = Field.from_args('fp', nm.float64, 'scalar', omega,
+                                 approx_order=1)
+        p = FieldVariable('p', 'unknown', field2)
+        q = FieldVariable('q', 'test', field2, primary_var_name='p')
+        eqs.append(Equation('extra', Term.new('dw_laplace(q, p)', integral,
+                                              omega, q=q, p=p)))
+
+    pb = Problem('modal', equations=Equations(eqs))
+
+    ebcs = Conditions([EssentialBC('Fixed', left, {'u.all': fixed_value})]) \
+        if fixed else Conditions([])
+    if lcbc:
+        rig = LinearCombinationBC('rig', [right, None], {'u.all': None},
+                                  None, 'rigid')
+        pb.time_update(ebcs=ebcs, lcbcs=Conditions([rig]))
+
+    else:
+        pb.time_update(ebcs=ebcs)
+
+    pb.update_materials()
+
+    return pb
+
+
+def _bar(order=1, fixed=True, shape=(7, 3)):
+    return _make_problem((1.0, 0.2), shape, order=order, fixed=fixed)
+
+
+def _block3d(fixed=True):
+    return _make_problem((1.0, 0.3, 0.2), (4, 3, 3), fixed=fixed)
+
+
+def _solve(pb, n_modes=6):
+    from sfepy.discrete.modal import solve_modes
+
+    return solve_modes(pb, n_modes=n_modes)
+
+
+def _dense(mtx):
+    return nm.asarray(mtx.todense())
+
+
+def _active(pb):
+    variables = pb.get_variables()
+
+    return variables.di.indx['u'].start + variables['u'].eq_map.eqi
+
+
+def _reference_matrix(pb, name):
+    mtx = pb.mtx_a.copy()
+    mtx.data[:] = 0.0
+
+    return pb.equations[name].evaluate(mode='weak', dw_mode='matrix',
+                                       asm_obj=mtx).tocsr()
+
+
+def _mismatched_problem(dims, shape, components):
+    mesh = gen_block_mesh(nm.array(dims, dtype=nm.float64),
+                          nm.array(shape, dtype=nm.int32),
+                          0.5 * nm.array(dims, dtype=nm.float64),
+                          name='block', verbose=False)
+    domain = FEDomain('domain', mesh)
+    omega = domain.create_region('Omega', 'all')
+    field = Field.from_args('fu', nm.float64, components, omega,
+                            approx_order=1)
+    u = FieldVariable('u', 'unknown', field)
+    v = FieldVariable('v', 'test', field, primary_var_name='u')
+    mat = Material('m', c=2.0, rho=RHO)
+    integral = Integral('i', order=2)
+    eqs = [Equation('stiffness', Term.new('dw_dot(m.c, v, u)', integral,
+                                          omega, m=mat, v=v, u=u)),
+           Equation('mass', Term.new('dw_dot(m.rho, v, u)', integral, omega,
+                                     m=mat, v=v, u=u))]
+    pb = Problem('modal', equations=Equations(eqs))
+    pb.time_update()
+    pb.update_materials()
+
+    return pb
+
