+def test_a_broken_history_follows_the_superposed_exact_response():
+    pb = _bar()
+    sol = _solve(pb, n_modes=1)
+    load = nm.zeros(pb.get_variables().di.n_dof_total)
+    load[-1] = 1.0e3
+    duration = 4.0 / sol.frequencies[0]
+    times = nm.linspace(0.0, duration, 601)
+    knots = [0, 200, 400, 600]
+    values = [0.0, 1.0, -0.5, 0.25]
+
+    history = nm.interp(times, times[knots], values)
+    slopes = [(values[ii + 1] - values[ii])
+              / (times[knots[ii + 1]] - times[knots[ii]])
+              for ii in range(3)]
+
+    omega = sol.omegas[0]
+    force = sol.reduced_vectors[:, 0] @ load[_active(pb)]
+    coors = nm.zeros_like(times)
+    previous = 0.0
+    for ii in range(3):
+        start = times[knots[ii]]
+        after = times >= start
+        lag = times[after] - start
+        coors[after] += ((slopes[ii] - previous)
+                         * (lag - nm.sin(omega * lag) / omega))
+        previous = slopes[ii]
+
+    coors *= force / sol.modal_stiffnesses()[0]
+    expected = nm.outer(coors, sol.vectors[:, 0])
+    out = sol.transient_response(times, load, history)
+
+    assert nm.abs(expected).max() > 0.0
+    assert nm.abs(out - expected).max() < 1e-8 * nm.abs(expected).max()
