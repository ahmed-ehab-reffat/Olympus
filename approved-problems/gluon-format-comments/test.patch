+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+
+cd "$(dirname "$0")"
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+run_and_produce_junit() {
+  local suite="$1"; shift
+  local log
+  log="$(mktemp)"
+  "$@" > "$log" 2>&1
+  local status=$?
+
+  if [ -z "$OUTPUT_PATH" ]; then
+    cat "$log"
+    rm -f "$log"
+    return $status
+  fi
+
+  local cases=""
+  local total=0
+  local failures=0
+  while IFS= read -r line; do
+    case "$line" in
+      "test "*" ... ok"|"test "*" ... ignored")
+        name="${line#test }"; name="${name%% ... *}"
+        total=$((total + 1))
+        cases="${cases}<testcase name=\"$(printf '%s' "$name" | xml_escape)\" classname=\"${suite}\"/>"$'\n'
+        ;;
+      "test "*" ... FAILED")
+        name="${line#test }"; name="${name%% ... *}"
+        total=$((total + 1)); failures=$((failures + 1))
+        cases="${cases}<testcase name=\"$(printf '%s' "$name" | xml_escape)\" classname=\"${suite}\"><failure message=\"assertion failed\"/></testcase>"$'\n'
+        ;;
+    esac
+  done < "$log"
+
+  if [ "$total" -eq 0 ]; then
+    total=1; failures=1
+    cases="<testcase name=\"${suite}_build\" classname=\"${suite}\"><failure message=\"build or harness failure\">$(cat "$log" | tail -40 | xml_escape)</failure></testcase>"
+  fi
+
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo "<testsuites name=\"gluon\" tests=\"${total}\" failures=\"${failures}\">"
+    echo "<testsuite name=\"${suite}\" tests=\"${total}\" failures=\"${failures}\">"
+    printf '%s' "$cases"
+    echo '</testsuite>'
+    echo '</testsuites>'
+  } > "$OUTPUT_PATH"
+
+  cat "$log"
+  rm -f "$log"
+  return $status
+}
+
+if [ "$MODE" = "base" ]; then
+  # `cargo test -p gluon_format` cannot build the `std` test target on this commit: it uses
+  # `#[tokio::main]` while gluon_format's dev-dependency on tokio enables only the `macros`
+  # feature, so the default multi-thread runtime is unavailable. That defect predates this change
+  # and is hidden in CI by workspace feature unification.
+  #
+  # `preserve_comments_in_empty_record` and `preserve_comments_in_record_base` are excluded here
+  # because they pin comment placement at column 0 inside a record, which the requested behaviour
+  # replaces. Neither shape loses coverage: the new suite asserts both of them against the
+  # requested placement, in `a_record_carrying_only_a_comment_keeps_it_indented` and
+  # `comments_around_a_record_base_stay_inside_the_record`.
+  run_and_produce_junit "base" cargo test -p gluon_format --test pretty_print -- \
+    --skip preserve_comments_in_empty_record \
+    --skip preserve_comments_in_record_base
+else
+  run_and_produce_junit "new" cargo test -p gluon_format --test comments_a02674
+fi
