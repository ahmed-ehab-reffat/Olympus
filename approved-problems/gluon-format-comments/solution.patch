+pub struct Gap<'a, A> {
+    pub trailing: DocBuilder<'a, Arena<'a, A>, A>,
+    pub own_line: DocBuilder<'a, Arena<'a, A>, A>,
+    pub has_trailing: bool,
+    pub has_own_line: bool,
+    pub has_line_comment: bool,
+}
+
+impl<'a, A> Gap<'a, A> {
+    pub fn has_comments(&self) -> bool {
+        self.has_trailing || self.has_own_line
+    }
+
+    /// Places the gap between two items, breaking the line wherever a comment requires it.
+    pub fn between_items(self) -> DocBuilder<'a, Arena<'a, A>, A> {
+        let arena = self.trailing.0;
+        let mut doc = self.trailing;
+        if self.has_own_line {
+            doc = doc
+                .append(arena.hardline())
+                .append(self.own_line)
+                .append(arena.hardline());
+        } else if self.has_trailing {
+            doc = doc.append(if self.has_line_comment {
+                arena.hardline()
+            } else {
+                arena.line()
+            });
+        }
+        doc
+    }
+
+    /// Places the gap at the end of a bracketed construct. The trailing comment stays on the line
+    /// of the last item and own line comments keep the indentation of the items, so the caller is
+    /// responsible only for the break before the closing delimiter.
+    pub fn before_closing_delimiter(self) -> DocBuilder<'a, Arena<'a, A>, A> {
+        let arena = self.trailing.0;
+        let mut doc = self.trailing;
+        if self.has_own_line {
+            doc = doc.append(arena.hardline()).append(self.own_line);
+        }
+        doc
+    }
+}
