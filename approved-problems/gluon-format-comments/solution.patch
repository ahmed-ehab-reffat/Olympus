+pub struct GapCommentIter<'a> {
+    src: &'a str,
+    pos: BytePos,
+}
+
+impl<'a> GapCommentIter<'a> {
+    fn advance(&mut self, len: usize) -> &'a str {
+        let (taken, rest) = self.src.split_at(len);
+        self.src = rest;
+        self.pos += ByteOffset::from(len as i64);
+        taken
+    }
+}
+
+impl<'a> Iterator for GapCommentIter<'a> {
+    type Item = Comment<'a>;
+
+    fn next(&mut self) -> Option<Comment<'a>> {
+        loop {
+            let c = self.src.chars().next()?;
+            if !self.src.starts_with("//") && !self.src.starts_with("/*") {
+                self.advance(c.len_utf8());
+                continue;
+            }
+            if self.src.starts_with("///") {
+                let line = self.src.lines().next().unwrap_or("");
+                self.advance(line.len());
+                continue;
+            }
+            if self.src.starts_with("/**") {
+                let len = self.src.find("*/").map_or(self.src.len(), |i| i + 2);
+                self.advance(len);
+                continue;
+            }
+            let start = self.pos;
+            if self.src.starts_with("//") {
+                let text = self.src.lines().next().unwrap_or("");
+                self.advance(text.len());
+                if self.src.starts_with("\r\n") {
+                    self.advance(2);
+                } else if self.src.starts_with('\n') {
+                    self.advance(1);
+                }
+                return Some(Comment {
+                    text,
+                    kind: CommentKind::Line,
+                    start,
+                    end: self.pos,
+                });
+            }
+            let len = self.src.find("*/").map_or(self.src.len(), |i| i + 2);
+            let text = self.advance(len);
+            return Some(Comment {
+                text,
+                kind: CommentKind::Block,
+                start,
+                end: self.pos,
+            });
+        }
+    }
 }
 
