+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+export MPLBACKEND=Agg
+export MPLCONFIGDIR="${MPLCONFIGDIR:-$(mktemp -d)}"
+
+if command -v python >/dev/null 2>&1; then
+  PYTHON=python
+else
+  PYTHON=python3
+fi
+
+NEW_TESTS="tests/unit/motors/test_tank_slosh_6e8286.py tests/unit/simulation/test_flight_slosh_6e8286.py"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  JUNIT="--junitxml=$OUTPUT_PATH"
+else
+  JUNIT=""
+fi
+
+LOG="$(mktemp)"
+trap 'rm -f "$LOG"' EXIT
+
+if [ "$MODE" = "new" ]; then
+  "$PYTHON" -m pytest $NEW_TESTS -p no:cacheprovider $JUNIT 2>&1 | tee "$LOG"
+  STATUS=$?
+else
+  "$PYTHON" -m pytest tests/unit -p no:cacheprovider \
+    --ignore=tests/unit/motors/test_tank_slosh_6e8286.py \
+    --ignore=tests/unit/simulation/test_flight_slosh_6e8286.py $JUNIT 2>&1 | tee "$LOG"
+  STATUS=$?
+fi
+
+if [ -n "$OUTPUT_PATH" ] && [ ! -s "$OUTPUT_PATH" ]; then
+  DETAIL="$(tail -n 40 "$LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    echo '<testsuite name="pytest" tests="1" failures="1" errors="0">'
+    echo '<testcase name="collection" classname="pytest"><failure message="pytest produced no results">'
+    printf '%s\n' "$DETAIL"
+    echo '</failure></testcase>'
+    echo '</testsuite>'
+    echo '</testsuites>'
+  } > "$OUTPUT_PATH"
+  STATUS=1
+fi
+
+exit $STATUS
diff --git a/tests/unit/motors/test_tank_slosh_6e8286.py b/tests/unit/motors/test_tank_slosh_6e8286.py
