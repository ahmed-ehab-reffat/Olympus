+def test_a_three_degree_of_freedom_flight_ignores_the_offset_rate(
+    three_dof_unequal_flight, three_dof_unequal_tanks
+):
+    time = 6.0
+    lower, upper = three_dof_unequal_tanks
+    lower_mass = lower.slosh_mass.get_value_opt(time)
+    upper_mass = upper.slosh_mass.get_value_opt(time)
+    assert abs(0.5 * lower_mass - 0.3 * upper_mass) > 1e-3
+
+    def vehicle(lower_velocity, upper_velocity):
+        state = (
+            sideslip_state()
+            + [0.02, 0.0, lower_velocity, 0.0]
+            + [0.01, 0.0, upper_velocity, 0.0]
+        )
+        return np.array(
+            three_dof_unequal_flight.u_dot_generalized_3dof(time, state)[3:6]
+        )
+
+    assert vehicle(0.5, -0.3) == pytest.approx(vehicle(0.0, 0.0), abs=1e-9)
+
