+def test_the_drive_divides_by_the_total_mass_and_not_the_dry_mass(
+    environment, state_length
+):
+    def build(mass, offset):
+        return make_rocket(
+            [(make_tank(TankSlosh(0.35, 7.0, 0.02)), 0.5)],
+            mass=mass,
+            center_of_mass_without_motor=offset,
+        )
+
+    light = build(8, 1.0)
+    target = light.center_of_dry_mass_position
+    low = build(24, 0.0).center_of_dry_mass_position
+    high = build(24, 1.0).center_of_dry_mass_position
+    heavy = build(24, (target - low) / (high - low))
+    assert heavy.center_of_dry_mass_position == pytest.approx(target, abs=1e-9)
+
+    light_flight = fly(environment, light)
+    heavy_flight = fly(environment, heavy)
+    row = cruising_row(light_flight)
+    time = row[0]
+    light_mass = light.total_mass.get_value_opt(time)
+    heavy_mass = heavy.total_mass.get_value_opt(time)
+    light_drive = derivative_at(light_flight, row, state_length)
+    heavy_drive = derivative_at(heavy_flight, row, state_length)
+    for axis in (2, 3):
+        assert light_drive[state_length + axis] != pytest.approx(
+            heavy_drive[state_length + axis], rel=1e-3
+        )
+        assert light_drive[state_length + axis] * light_mass == pytest.approx(
+            heavy_drive[state_length + axis] * heavy_mass, rel=1e-6, abs=1e-9
+        )
