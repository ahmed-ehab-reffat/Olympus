+@pytest.mark.parametrize("name, scale", [("rtol", 1e-7), ("atol", 1e-4)])
+@pytest.mark.parametrize("as_array", [False, True])
+def test_padding_keeps_every_supplied_tolerance_entry(
+    environment, state_length, name, scale, as_array
+):
+    supplied = heterogeneous_tolerance(state_length, scale)
+    assert len(set(supplied)) == state_length
+    vector = np.array(supplied) if as_array else list(supplied)
+    flight = fly(
+        environment,
+        make_rocket([(make_tank(TankSlosh(0.35, 7.0, 0.02)), 0.5)]),
+        **{name: vector},
+    )
+    widened = getattr(flight, name)
+    assert len(widened) == state_length + MODE_ENTRIES
+    assert list(widened[:state_length]) == pytest.approx(supplied, rel=1e-12)
+    assert flight.apogee > 0
