+    assert len(rocket.slosh_modes) == 2
+    prefix = [0, 0, 100, 0, 0, 50, 1, 0, 0, 0, 0, 0, 0]
+    blocks = [0.01, -0.02, 0.3, -0.4, -0.03, 0.04, -0.5, 0.6]
