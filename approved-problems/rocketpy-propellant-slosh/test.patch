@@ -0,0 +1,273 @@
+import functools
+
+import pytest
+
+from rocketpy import (
+    CylindricalTank,
+    Fluid,
+    LevelBasedTank,
+    LiquidMotor,
+    MassBasedTank,
+    MassFlowRateBasedTank,
+    Rocket,
+    UllageBasedTank,
+)
+
+try:
+    from rocketpy import TankSlosh
+except ImportError:
+    TankSlosh = None
+
+
+@pytest.fixture
+def liquid():
+    return Fluid("liquid", 1000)
+
+
+@pytest.fixture
+def gas():
+    return Fluid("gas", 1)
+
+
+@pytest.fixture
+def geometry():
+    return CylindricalTank(0.05, 0.6)
+
+
+def make_tank(geometry, liquid, gas, slosh=None, name="tank"):
+    return MassFlowRateBasedTank(
+        name=name,
+        geometry=geometry,
+        flux_time=(0, 4),
+        liquid=liquid,
+        gas=gas,
+        initial_liquid_mass=3,
+        initial_gas_mass=0.001,
+        liquid_mass_flow_rate_in=0,
+        gas_mass_flow_rate_in=0,
+        liquid_mass_flow_rate_out=0.5,
+        gas_mass_flow_rate_out=0,
+        slosh=slosh,
+    )
+
+
+def make_rocket(tanks):
+    motor = LiquidMotor(
+        thrust_source=2000,
+        dry_mass=2,
+        dry_inertia=(0.1, 0.1, 0.01),
+        nozzle_radius=0.02,
+        center_of_dry_mass_position=0.4,
+        nozzle_position=0,
+        burn_time=4,
+        coordinate_system_orientation="nozzle_to_combustion_chamber",
+    )
+    for tank, position in tanks:
+        motor.add_tank(tank, position=position)
+    rocket = Rocket(
+        radius=0.06,
+        mass=8,
+        inertia=(4, 4, 0.03),
+        power_off_drag=0.5,
+        power_on_drag=0.5,
+        center_of_mass_without_motor=1.0,
+        coordinate_system_orientation="tail_to_nose",
+    )
+    rocket.add_motor(motor, position=0.0)
+    return rocket
+
+
+CONCRETE_TANKS = [MassFlowRateBasedTank, UllageBasedTank, LevelBasedTank, MassBasedTank]
+
+
+def half_of(fill):
+    return 0.5 * fill
+
+
+def scale_by(scale, fill):
+    return scale * fill
+
+
+class FillScaler:
+    """Callable object returning a fixed multiple of the fill fraction."""
+
+    def __init__(self, scale):
+        self.scale = scale
+
+    def __call__(self, fill):
+        return self.scale * fill
+
+
+CALLABLE_FORMS = [
+    ("function", half_of),
+    ("lambda", lambda fill: 0.5 * fill),
+    ("partial", functools.partial(scale_by, 0.5)),
+    ("instance", FillScaler(0.5)),
+    ("defaulted", lambda fill, scale=0.5: scale * fill),
+    ("varargs", lambda *values: 0.5 * values[0]),
+    ("keyword_only", lambda fill, *, scale=0.5: scale * fill),
+]
+CALLABLE_IDS = [label for label, _ in CALLABLE_FORMS]
+
+
+def make_concrete_tank(tank_class, geometry, liquid, gas, slosh=None):
+    kwargs = {
+        "name": "tank",
+        "geometry": geometry,
+        "flux_time": (0, 4),
+        "liquid": liquid,
+        "gas": gas,
+        "slosh": slosh,
+    }
+    if tank_class is UllageBasedTank:
+        return tank_class(ullage=0.001, **kwargs)
+    if tank_class is LevelBasedTank:
+        return tank_class(liquid_height=0.1, **kwargs)
+    if tank_class is MassFlowRateBasedTank:
+        return tank_class(
+            initial_liquid_mass=3,
+            initial_gas_mass=0.001,
+            liquid_mass_flow_rate_in=0,
+            gas_mass_flow_rate_in=0,
+            liquid_mass_flow_rate_out=0.5,
+            gas_mass_flow_rate_out=0,
+            **kwargs,
+        )
+    return tank_class(liquid_mass=2, gas_mass=0.001, **kwargs)
+
+
+@pytest.mark.parametrize("tank_class", CONCRETE_TANKS)
+def test_every_concrete_tank_class_accepts_slosh(tank_class, geometry, liquid, gas):
+    tank = make_concrete_tank(
+        tank_class, geometry, liquid, gas, TankSlosh(0.3, 8.0, 0.05)
+    )
+    assert tank.slosh_mass.get_value_opt(0.0) == pytest.approx(
+        0.3 * tank.liquid_mass.get_value_opt(0.0)
+    )
+
+
+def reported_slosh_mass(tank, time):
+    mass = tank.slosh_mass
+    evaluate = getattr(mass, "get_value_opt", None)
+    return evaluate(time) if evaluate is not None else mass
+
+
+@pytest.mark.parametrize("tank_class", CONCRETE_TANKS)
+def test_a_tank_without_slosh_has_no_participating_mass(
+    tank_class, geometry, liquid, gas
+):
+    tank = make_concrete_tank(tank_class, geometry, liquid, gas)
+    assert reported_slosh_mass(tank, 0.0) == 0
+    assert reported_slosh_mass(tank, 3.0) == 0
+
+
+def test_slosh_mass_is_the_ratio_times_the_liquid_mass(geometry, liquid, gas):
+    tank = make_tank(geometry, liquid, gas, TankSlosh(0.4, 8.0, 0.05))
+    for time in (0.0, 1.5, 3.0):
+        expected = 0.4 * tank.liquid_mass.get_value_opt(time)
+        assert tank.slosh_mass.get_value_opt(time) == pytest.approx(expected)
+
+
+def test_slosh_mass_tracks_the_draining_liquid(geometry, liquid, gas):
+    tank = make_tank(geometry, liquid, gas, TankSlosh(0.4, 8.0, 0.05))
+    assert tank.slosh_mass.get_value_opt(3.0) < tank.slosh_mass.get_value_opt(0.0)
+
+
+def test_a_callable_mass_ratio_is_read_at_the_tank_fill_fraction(geometry, liquid, gas):
+    tank = make_tank(
+        geometry, liquid, gas, TankSlosh(lambda fill: 0.5 * fill, 8.0, 0.0)
+    )
+    time = 1.0
+    fill = tank.liquid_volume.get_value_opt(time) / tank.geometry.total_volume
+    expected = 0.5 * fill * tank.liquid_mass.get_value_opt(time)
+    assert tank.slosh_mass.get_value_opt(time) == pytest.approx(expected)
+
+
+def test_a_callable_mass_ratio_changes_as_the_tank_drains(geometry, liquid, gas):
+    constant = make_tank(geometry, liquid, gas, TankSlosh(0.5, 8.0, 0.0))
+    varying = make_tank(
+        geometry, liquid, gas, TankSlosh(lambda fill: 0.5 * fill, 8.0, 0)
+    )
+    early = varying.slosh_mass.get_value_opt(0.0) / constant.slosh_mass.get_value_opt(
+        0.0
+    )
+    late = varying.slosh_mass.get_value_opt(3.0) / constant.slosh_mass.get_value_opt(
+        3.0
+    )
+    assert late < early
+
+
+def test_a_zero_mass_ratio_gives_no_participating_mass(geometry, liquid, gas):
+    tank = make_tank(geometry, liquid, gas, TankSlosh(0.0, 8.0, 0.05))
+    assert tank.slosh_mass.get_value_opt(0.0) == pytest.approx(0.0)
+    assert tank.slosh_mass.get_value_opt(3.0) == pytest.approx(0.0)
+
+
+def test_a_rocket_without_slosh_has_no_modes(geometry, liquid, gas):
+    rocket = make_rocket([(make_tank(geometry, liquid, gas), 0.5)])
+    assert len(rocket.slosh_modes) == 0
+
+
+def test_a_tank_without_slosh_contributes_no_mode(geometry, liquid, gas):
+    rocket = make_rocket(
+        [
+            (make_tank(geometry, liquid, gas, name="plain"), 0.2),
+            (make_tank(geometry, liquid, gas, TankSlosh(0.3, 8.0, 0.0), "wet"), 0.6),
+        ]
+    )
+    assert len(rocket.slosh_modes) == 1
+
+
+def test_each_sloshing_tank_contributes_one_mode(geometry, liquid, gas):
+    rocket = make_rocket(
+        [
+            (make_tank(geometry, liquid, gas, TankSlosh(0.3, 8.0, 0.0), "a"), 0.2),
+            (make_tank(geometry, liquid, gas, TankSlosh(0.3, 6.0, 0.0), "b"), 0.6),
+        ]
+    )
+    assert len(rocket.slosh_modes) == 2
+
+
+def test_a_zero_mass_ratio_still_contributes_a_mode(geometry, liquid, gas):
+    rocket = make_rocket(
+        [(make_tank(geometry, liquid, gas, TankSlosh(0.0, 8.0, 0.0)), 0.5)]
+    )
+    assert len(rocket.slosh_modes) == 1
+
+
+def test_tank_slosh_accepts_its_parameters_by_keyword(geometry, liquid, gas):
+    slosh = TankSlosh(mass_ratio=0.3, natural_frequency=8.0, damping_ratio=0.05)
+    tank = make_concrete_tank(MassBasedTank, geometry, liquid, gas, slosh)
+    assert tank.slosh_mass.get_value_opt(0.0) == pytest.approx(
+        0.3 * tank.liquid_mass.get_value_opt(0.0)
+    )
+
+
+@pytest.mark.parametrize("tank_class", CONCRETE_TANKS)
+def test_a_callable_mass_ratio_works_on_every_concrete_tank_class(
+    tank_class, geometry, liquid, gas
+):
+    tank = make_concrete_tank(
+        tank_class, geometry, liquid, gas, TankSlosh(lambda fill: 0.5 * fill, 8.0, 0.0)
+    )
+    time = 1.0
+    fill = tank.liquid_volume.get_value_opt(time) / tank.geometry.total_volume
+    assert 0 < fill < 1
+    assert tank.slosh_mass.get_value_opt(time) == pytest.approx(
+        0.5 * fill * tank.liquid_mass.get_value_opt(time)
+    )
+
+
+@pytest.mark.parametrize(
+    "parameter", [form for _, form in CALLABLE_FORMS], ids=CALLABLE_IDS
+)
+def test_any_callable_of_the_fill_fraction_sets_the_mass_ratio(
+    geometry, liquid, gas, parameter
+):
+    tank = make_tank(geometry, liquid, gas, TankSlosh(parameter, 8.0, 0.0))
+    time = 1.0
+    fill = tank.liquid_volume.get_value_opt(time) / tank.geometry.total_volume
+    assert 0 < fill < 1
+    assert tank.slosh_mass.get_value_opt(time) == pytest.approx(
+        0.5 * fill * tank.liquid_mass.get_value_opt(time)
+    )
