+def test_a_damped_mode_follows_the_damping_ratio_solution(environment):
+    damping = 0.25
+    frequency = 7.0
+    amplitude = 0.01
+    rocket = make_rocket([(make_tank(TankSlosh(0.35, frequency, damping)), 0.5)])
+    reference = fly(environment, rocket, inclination=90)
+    flight = seeded_flight(environment, rocket, reference, {1: amplitude})
+    _, displacement_y = flight.slosh_displacement[0]
+    period = 2 * np.pi / frequency
+    ringing = np.sqrt(1 - damping**2)
+    expected = (
+        amplitude
+        * np.exp(-damping * frequency * period)
+        * (
+            np.cos(ringing * frequency * period)
+            + damping / ringing * np.sin(ringing * frequency * period)
+        )
+    )
+    assert displacement_y.get_value_opt(
+        reference.apogee_time + period
+    ) == pytest.approx(expected, rel=0.05)
