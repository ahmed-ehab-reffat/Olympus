+@pytest.mark.parametrize("tank_class", OTHER_TANK_CLASSES)
+def test_a_callable_frequency_sets_the_period_on_every_tank_class(
+    environment, tank_class
+):
+    tank = make_class_tank(tank_class, TankSlosh(0.35, lambda fill: 30.0 * fill, 0.0))
+    rocket = make_rocket([(tank, 0.5)])
+    reference = fly(environment, rocket, inclination=90)
+    flight = seeded_flight(environment, rocket, reference, {1: 0.01})
+    _, displacement_y = flight.slosh_displacement[0]
+    start = reference.apogee_time
+    fill = tank.liquid_volume.get_value_opt(start) / tank.geometry.total_volume
+    assert 0 < fill < 1
+    period = 2 * np.pi / (30.0 * fill)
+    assert displacement_y.get_value_opt(start + period) == pytest.approx(0.01, rel=0.05)
+    assert displacement_y.get_value_opt(start + period / 2) == pytest.approx(
+        -0.01, rel=0.05
+    )
+
