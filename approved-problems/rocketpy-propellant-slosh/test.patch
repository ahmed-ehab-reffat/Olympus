+def make_class_tank(tank_class, slosh, name="tank"):
+    kwargs = {
+        "name": name,
+        "geometry": CylindricalTank(0.05, 0.6),
+        "flux_time": (0, 1000),
+        "liquid": Fluid("liquid", 1000),
+        "gas": Fluid("gas", 1),
+        "slosh": slosh,
+    }
+    if tank_class is UllageBasedTank:
+        return tank_class(ullage=0.001, **kwargs)
+    if tank_class is LevelBasedTank:
+        return tank_class(liquid_height=0.1, **kwargs)
+    return tank_class(liquid_mass=2, gas_mass=0.001, **kwargs)
+
+
+def class_mode_samples(environment, tank):
+    rocket = make_rocket([(tank, 0.5)])
+    reference = fly(environment, rocket, inclination=90)
+    flight = seeded_flight(environment, rocket, reference, {1: 0.01})
+    _, displacement_y = flight.slosh_displacement[0]
+    start = reference.apogee_time
+    return [displacement_y.get_value_opt(start + step * 0.1) for step in range(1, 9)]
+
