+        max_time=0.5,
+        simulation_mode=simulation_mode,
+    )
+    first = 1 + state_length
+    assert len(flight.solution[0]) == first + 2 * MODE_ENTRIES
+    assert flight.solution[0][1:first] == pytest.approx(prefix)
+    assert flight.solution[0][first:] == pytest.approx(blocks)
