+import functools
+
+import numpy as np
+import pytest
+
+from rocketpy import (
+    CylindricalTank,
+    Environment,
+    Flight,
+    Fluid,
+    LevelBasedTank,
+    LiquidMotor,
+    MassBasedTank,
+    MassFlowRateBasedTank,
+    Rocket,
+    UllageBasedTank,
+)
+
+try:
+    from rocketpy import TankSlosh
+except ImportError:
+    TankSlosh = None
+
+MODE_ENTRIES = 4
+LEGACY_ATOL = 6 * [1e-3] + 4 * [1e-6] + 3 * [1e-3]
+MODE_ATOL = 1e-9
+
+
+def resolved_atol(modes):
+    return LEGACY_ATOL + MODE_ENTRIES * modes * [MODE_ATOL]
+
+
+def scale_by(scale, fill):
+    return scale * fill
+
+
+class FillScaler:
+    """Callable object returning a fixed multiple of the fill fraction."""
+
+    def __init__(self, scale):
+        self.scale = scale
+
+    def __call__(self, fill):
+        return self.scale * fill
+
+
+def callable_forms(scale):
+    def plain(fill):
+        return scale * fill
+
+    return [
+        ("function", plain),
+        ("lambda", lambda fill: scale * fill),
+        ("partial", functools.partial(scale_by, scale)),
+        ("instance", FillScaler(scale)),
+        ("defaulted", lambda fill, bound=scale: bound * fill),
+        ("varargs", lambda *values: scale * values[0]),
+        ("keyword_only", lambda fill, *, bound=scale: bound * fill),
+    ]
+
+
+FREQUENCY_FORMS = callable_forms(30.0)
+DAMPING_FORMS = callable_forms(0.4)
+FORM_IDS = [label for label, _ in FREQUENCY_FORMS]
+
+
+@pytest.fixture(scope="module")
+def environment():
+    return Environment(latitude=0, longitude=0, elevation=0)
+
+
+def make_tank(slosh, name="tank"):
+    return MassFlowRateBasedTank(
+        name=name,
+        geometry=CylindricalTank(0.05, 0.6),
+        flux_time=(0, 4),
+        liquid=Fluid("liquid", 1000),
+        gas=Fluid("gas", 1),
+        initial_liquid_mass=3,
+        initial_gas_mass=0.001,
+        liquid_mass_flow_rate_in=0,
+        gas_mass_flow_rate_in=0,
+        liquid_mass_flow_rate_out=0.5,
+        gas_mass_flow_rate_out=0,
+        slosh=slosh,
+    )
+
+
+def make_motor(
+    orientation="nozzle_to_combustion_chamber",
+    nozzle_position=0,
+    center_of_dry_mass_position=0.4,
+):
+    return LiquidMotor(
+        thrust_source=2000,
+        dry_mass=2,
+        dry_inertia=(0.1, 0.1, 0.01),
+        nozzle_radius=0.02,
+        center_of_dry_mass_position=center_of_dry_mass_position,
+        nozzle_position=nozzle_position,
+        burn_time=4,
+        coordinate_system_orientation=orientation,
+    )
+
+
+def make_rocket(
+    tanks,
+    mass=8,
+    center_of_mass_without_motor=1.0,
+    motor=None,
+    motor_position=0.0,
+):
+    motor = make_motor() if motor is None else motor
+    for tank, position in tanks:
+        motor.add_tank(tank, position=position)
+    rocket = Rocket(
+        radius=0.06,
+        mass=mass,
+        inertia=(4, 4, 0.03),
+        power_off_drag=0.5,
+        power_on_drag=0.5,
+        center_of_mass_without_motor=center_of_mass_without_motor,
+        coordinate_system_orientation="tail_to_nose",
+    )
+    rocket.add_motor(motor, position=motor_position)
+    rocket.add_nose(length=0.3, kind="von karman", position=2.0)
+    rocket.add_trapezoidal_fins(
+        n=4, root_chord=0.12, tip_chord=0.06, span=0.1, position=0.3
+    )
+    return rocket
+
+
+def fly(environment, rocket, inclination=85, **kwargs):
+    options = {"terminate_on_apogee": True}
+    options.update(kwargs)
+    return Flight(
+        rocket=rocket,
+        environment=environment,
+        rail_length=3,
+        inclination=inclination,
+        heading=0,
+        **options,
+    )
+
+
+def seeded_flight(environment, rocket, reference, entries, **options):
+    seed = list(reference.solution[-1])
+    seed[0] = reference.apogee_time
+    modes = len(rocket.slosh_modes)
+    base = len(seed) - 1 - MODE_ENTRIES * modes
+    seed[1 + base :] = [0.0] * (MODE_ENTRIES * modes)
+    for index, value in entries.items():
+        seed[1 + base + index] = value
+    settings = {
+        "rocket": rocket,
+        "environment": environment,
+        "rail_length": 3,
+        "inclination": 90,
+        "heading": 0,
+        "initial_solution": seed,
+        "max_time": reference.apogee_time + 2.0,
+        "terminate_on_apogee": False,
+        "atol": resolved_atol(modes),
+    }
+    settings.update(options)
+    return Flight(**settings)
+
+
+def derivative_at(flight, row, state_length, entries=None):
+    state = list(row[1:])
+    state[state_length:] = [0.0] * (len(state) - state_length)
+    for index, value in (entries or {}).items():
+        state[state_length + index] = value
+    return np.array(flight.u_dot_generalized(row[0], state))
+
+
+def cruising_row(flight):
+    rows = flight.solution_array[flight.solution_array[:, 0] > flight.out_of_rail_time]
+    return rows[len(rows) // 2]
+
+
+@pytest.fixture(scope="module")
+def plain_flight(environment):
+    return fly(environment, make_rocket([(make_tank(None), 0.5)]))
+
+
+@pytest.fixture(scope="module")
+def state_length(plain_flight):
+    return len(plain_flight.solution[-1]) - 1
+
+
+@pytest.fixture(scope="module")
+def single_tank():
+    return make_tank(TankSlosh(0.35, 7.0, 0.02))
+
+
+@pytest.fixture(scope="module")
+def single_mode_flight(environment, single_tank):
+    return fly(environment, make_rocket([(single_tank, 0.5)]))
+
+
+@pytest.fixture(scope="module")
+def two_tanks():
+    return (
+        make_tank(TankSlosh(0.3, 9.0, 0.01), name="upper"),
+        make_tank(TankSlosh(0.4, 5.0, 0.03), name="lower"),
+    )
+
+
+@pytest.fixture(scope="module")
+def two_mode_flight(environment, two_tanks):
+    upper, lower = two_tanks
+    return fly(environment, make_rocket([(upper, 0.9), (lower, 0.2)]))
+
+
+def test_one_mode_adds_exactly_four_entries_to_the_plain_width(
+    plain_flight, single_mode_flight
+):
+    plain = len(plain_flight.solution[-1])
+    assert len(single_mode_flight.solution[-1]) == plain + MODE_ENTRIES
+
+
+def test_one_mode_appends_four_state_entries(single_mode_flight, state_length):
+    assert len(single_mode_flight.solution[-1]) - 1 == state_length + MODE_ENTRIES
+
+
+def test_two_modes_append_eight_state_entries(two_mode_flight, state_length):
+    assert len(two_mode_flight.solution[-1]) - 1 == state_length + 2 * MODE_ENTRIES
+
+
+def test_every_solution_row_keeps_the_same_width(single_mode_flight, state_length):
+    widths = {len(row) for row in single_mode_flight.solution}
+    assert widths == {1 + state_length + MODE_ENTRIES}
+
+
+def test_the_modes_start_at_rest(single_mode_flight, state_length):
+    first = 1 + state_length
+    assert single_mode_flight.solution[0][
+        first : first + MODE_ENTRIES
+    ] == pytest.approx([0, 0, 0, 0])
+
+
+def test_a_rocket_without_slosh_has_no_lateral_offset(plain_flight):
+    offset_x, offset_y = plain_flight.lateral_center_of_mass_offset
+    for time in plain_flight.solution_array[:, 0]:
+        assert offset_x.get_value_opt(time) == 0
+        assert offset_y.get_value_opt(time) == 0
+
+
+def test_a_rocket_without_slosh_reports_no_mode_motion(plain_flight):
+    assert len(plain_flight.slosh_displacement) == 0
+    assert len(plain_flight.slosh_velocity) == 0
+
+
+def test_one_mode_reports_one_displacement_and_one_velocity(single_mode_flight):
+    assert len(single_mode_flight.slosh_displacement) == 1
+    assert len(single_mode_flight.slosh_velocity) == 1
+
+
+def test_two_modes_report_two_displacements_and_velocities(two_mode_flight):
+    assert len(two_mode_flight.slosh_displacement) == 2
+    assert len(two_mode_flight.slosh_velocity) == 2
+
+
+def test_a_zero_mass_ratio_mode_imposes_no_lateral_offset(environment):
+    flight = fly(
+        environment, make_rocket([(make_tank(TankSlosh(0.0, 7.0, 0.02)), 0.5)])
+    )
+    offset_x, offset_y = flight.lateral_center_of_mass_offset
+    for time in flight.solution_array[:, 0]:
+        assert offset_x.get_value_opt(time) == 0
+        assert offset_y.get_value_opt(time) == 0
+
+
+def test_the_offset_acts_on_the_vehicle(
+    environment, vertical_rocket, vertical_reference
+):
+    forward = seeded_flight(environment, vertical_rocket, vertical_reference, {1: 0.01})
