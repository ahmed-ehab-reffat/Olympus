+def test_a_parachute_descent_ignores_the_offset_rate(
+    parachute_pair_flight, parachute_pair_tanks, state_length
+):
+    flight = parachute_pair_flight
+    lower, upper = parachute_pair_tanks
+    rows = flight.solution_array
+    under = rows[rows[:, 0] > flight.apogee_time + 5.0]
+    row = under[len(under) // 2]
+    time = row[0]
+    lower_mass = lower.slosh_mass.get_value_opt(time)
+    upper_mass = upper.slosh_mass.get_value_opt(time)
+    assert abs(0.5 * lower_mass - 0.3 * upper_mass) > 1e-3
+
+    def vehicle(lower_velocity, upper_velocity):
+        state = list(row[1:])
+        state[state_length:] = [
+            0.02,
+            0.0,
+            lower_velocity,
+            0.0,
+            0.01,
+            0.0,
+            upper_velocity,
+            0.0,
+        ]
+        return np.array(flight.u_dot_parachute(time, state)[3:6])
+
+    assert vehicle(0.5, -0.3) == pytest.approx(vehicle(0.0, 0.0), abs=1e-9)
+
