+@pytest.mark.parametrize("tank_class", OTHER_TANK_CLASSES)
+def test_a_callable_damping_drives_every_concrete_tank_class(environment, tank_class):
+    strong = class_mode_samples(
+        environment,
+        make_class_tank(tank_class, TankSlosh(0.35, 7.0, lambda fill: 1.2 * fill)),
+    )
+    weak = class_mode_samples(
+        environment,
+        make_class_tank(tank_class, TankSlosh(0.35, 7.0, lambda fill: 0.02 * fill)),
+    )
+    assert abs(strong[-1]) < abs(weak[-1])
