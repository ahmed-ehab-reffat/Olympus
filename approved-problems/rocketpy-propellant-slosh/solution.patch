@@ -0,0 +1,389 @@
+from ..mathutils.function import Function
+from ..tools import from_hex_decode, to_hex_encode
+
+
+class TankSlosh:
+    """Class that represents the lateral slosh behaviour of the liquid held by
+    a tank. The liquid is split into a participating mass, free to move in the
+    two body directions perpendicular to the rocket axis, and a remainder that
+    stays rigid with the tank.
+
+    Attributes
+    ----------
+    TankSlosh.mass_ratio : int, float, callable
+        Fraction of the liquid mass that participates in the slosh motion. If a
+        callable is given, it receives the tank fill fraction and returns the
+        fraction.
+    TankSlosh.natural_frequency : int, float, callable
+        Undamped natural frequency of the slosh motion in rad/s. If a callable
+        is given, it receives the tank fill fraction and returns the frequency.
+    TankSlosh.damping_ratio : int, float, callable
+        Damping ratio of the slosh motion. If a callable is given, it receives
+        the tank fill fraction and returns the ratio.
+    """
+
+    def __init__(self, mass_ratio, natural_frequency, damping_ratio):
+        """Initialize a TankSlosh object.
+
+        Parameters
+        ----------
+        mass_ratio : int, float, callable
+            Fraction of the liquid mass that participates in the slosh motion.
+            A callable receives the tank fill fraction, the liquid volume
+            divided by the total tank volume, and returns the fraction.
+        natural_frequency : int, float, callable
+            Undamped natural frequency of the slosh motion in rad/s. A callable
+            receives the tank fill fraction and returns the frequency.
+        damping_ratio : int, float, callable
+            Damping ratio of the slosh motion. A callable receives the tank
+            fill fraction and returns the ratio.
+
+        Returns
+        -------
+        None
+        """
+        self.mass_ratio = mass_ratio
+        self.natural_frequency = natural_frequency
+        self.damping_ratio = damping_ratio
+
+    @staticmethod
+    def _evaluate_parameter(parameter, fill_fraction):
+        """Resolve a slosh parameter at a given fill fraction.
+
+        Parameters
+        ----------
+        parameter : int, float, callable
+            The parameter to resolve.
+        fill_fraction : float
+            Liquid volume divided by the total tank volume.
+
+        Returns
+        -------
+        float
+            The resolved parameter value.
+        """
+        if callable(parameter):
+            return parameter(fill_fraction)
+        return parameter
+
+    def evaluate_mass_ratio(self, fill_fraction):
+        """Mass ratio at a given fill fraction.
+
+        Parameters
+        ----------
+        fill_fraction : float
+            Liquid volume divided by the total tank volume.
+
+        Returns
+        -------
+        float
+            Fraction of the liquid mass that participates in the slosh motion.
+        """
+        return self._evaluate_parameter(self.mass_ratio, fill_fraction)
+
+    def evaluate_natural_frequency(self, fill_fraction):
+        """Natural frequency at a given fill fraction.
+
+        Parameters
+        ----------
+        fill_fraction : float
+            Liquid volume divided by the total tank volume.
+
+        Returns
+        -------
+        float
+            Undamped natural frequency in rad/s.
+        """
+        return self._evaluate_parameter(self.natural_frequency, fill_fraction)
+
+    def evaluate_damping_ratio(self, fill_fraction):
+        """Damping ratio at a given fill fraction.
+
+        Parameters
+        ----------
+        fill_fraction : float
+            Liquid volume divided by the total tank volume.
+
+        Returns
+        -------
+        float
+            Damping ratio of the slosh motion.
+        """
+        return self._evaluate_parameter(self.damping_ratio, fill_fraction)
+
+    def to_dict(self, **kwargs):
+        """Return the slosh model as a dictionary.
+
+        Parameters
+        ----------
+        **kwargs : dict
+            Accepted for signature compatibility. The model holds no outputs.
+
+        Returns
+        -------
+        dict
+            The three parameters the model was built from.
+        """
+        allow_pickle = kwargs.get("allow_pickle", True)
+        return {
+            name: self._encode_parameter(getattr(self, name), allow_pickle)
+            for name in ("mass_ratio", "natural_frequency", "damping_ratio")
+        }
+
+    @staticmethod
+    def _encode_parameter(parameter, allow_pickle):
+        """Prepare one parameter for serialization.
+
+        Parameters
+        ----------
+        parameter : int, float, callable
+            The parameter to encode.
+        allow_pickle : bool
+            Whether callables may be pickled.
+
+        Returns
+        -------
+        object
+            The parameter, or an encoding of it when it is a callable.
+        """
+        if callable(parameter) and not isinstance(parameter, Function):
+            if allow_pickle:
+                return to_hex_encode(parameter)
+            return parameter.__name__
+        return parameter
+
+    @staticmethod
+    def _decode_parameter(parameter):
+        """Rebuild one parameter read back from a dictionary.
+
+        Parameters
+        ----------
+        parameter : object
+            The stored parameter.
+
+        Returns
+        -------
+        int, float, callable
+            The parameter, decoded when it was an encoded callable.
+        """
+        if isinstance(parameter, str):
+            try:
+                return from_hex_decode(parameter)
+            except (TypeError, ValueError):
+                return parameter
+        return parameter
+
+    @classmethod
+    def from_dict(cls, data):
+        """Rebuild a slosh model from a dictionary.
+
+        Parameters
+        ----------
+        data : dict
+            The dictionary produced by :meth:`to_dict`.
+
+        Returns
+        -------
+        TankSlosh
+            The rebuilt model.
+        """
+        return cls(
+            mass_ratio=cls._decode_parameter(data["mass_ratio"]),
+            natural_frequency=cls._decode_parameter(data["natural_frequency"]),
+            damping_ratio=cls._decode_parameter(data["damping_ratio"]),
+        )
+
+    def __repr__(self):
+        return (
+            f"TankSlosh(mass_ratio={self.mass_ratio}, "
+            f"natural_frequency={self.natural_frequency}, "
+            f"damping_ratio={self.damping_ratio})"
+        )
+
+
+class SloshMode:
+    """A single lateral slosh degree of freedom contributed by a tank that was
+    given a :class:`TankSlosh`. The mode holds the tank it belongs to and the
+    axial position of the tank fluid center of mass in the rocket frame.
+
+    Attributes
+    ----------
+    SloshMode.tank : Tank
+        The tank that contributes this mode.
+    SloshMode.position : float
+        Axial position of the owning tank in the rocket frame, in meters.
+    SloshMode.slosh : TankSlosh
+        The slosh model carried by the tank.
+    """
+
+    def __init__(self, tank, position):
+        """Initialize a SloshMode object.
+
+        Parameters
+        ----------
+        tank : Tank
+            The tank that contributes this mode.
+        position : float
+            Axial position of the owning tank in the rocket frame, in meters.
+
+        Returns
+        -------
+        None
+        """
+        self.tank = tank
+        self.position = position
+        self.slosh = tank.slosh
+
+    def fill_fraction_at(self, t):
+        """Tank fill fraction at a given time.
+
+        Parameters
+        ----------
+        t : float
+            Time in seconds.
+
+        Returns
+        -------
+        float
+            Liquid volume divided by the total tank volume.
+        """
+        total_volume = self.tank.geometry.total_volume
+        if total_volume == 0:
+            return 0.0
+        return self.tank.liquid_volume.get_value_opt(t) / total_volume
+
+    def mass_at(self, t):
+        """Participating mass at a given time.
+
+        Parameters
+        ----------
+        t : float
+            Time in seconds.
+
+        Returns
+        -------
+        float
+            Mass ratio times the liquid mass, in kg.
+        """
+        return self.tank.slosh_mass.get_value_opt(t)
+
+    def natural_frequency_at(self, t):
+        """Natural frequency at a given time.
+
+        Parameters
+        ----------
+        t : float
+            Time in seconds.
+
+        Returns
+        -------
+        float
+            Undamped natural frequency in rad/s.
+        """
+        return self.slosh.evaluate_natural_frequency(self.fill_fraction_at(t))
+
+    def damping_ratio_at(self, t):
+        """Damping ratio at a given time.
+
+        Parameters
+        ----------
+        t : float
+            Time in seconds.
+
+        Returns
+        -------
+        float
+            Damping ratio of the slosh motion.
+        """
+        return self.slosh.evaluate_damping_ratio(self.fill_fraction_at(t))
+
+    def acceleration_at(self, t, displacement, velocity, drive):
+        """Lateral acceleration of the participating mass.
+
+        Parameters
+        ----------
+        t : float
+            Time in seconds.
+        displacement : tuple of float
+            Lateral displacement of the mode in the body frame, in meters.
+        velocity : tuple of float
+            Lateral velocity of the mode in the body frame, in m/s.
+        drive : tuple of float
+            Body frame lateral force per unit mass acting on the rocket, in
+            m/s^2.
+
+        Returns
+        -------
+        tuple of float
+            Lateral acceleration of the mode in the body frame, in m/s^2.
+        """
+        omega = self.natural_frequency_at(t)
+        zeta = self.damping_ratio_at(t)
+        stiffness = omega * omega
+        damping = 2 * zeta * omega
+        return (
+            -stiffness * displacement[0] - damping * velocity[0] - drive[0],
+            -stiffness * displacement[1] - damping * velocity[1] - drive[1],
+        )
+
+    def __repr__(self):
+        return f"SloshMode(tank={self.tank.name})"
+
+
+def weighted_lateral_mean(masses, values, total_mass):
+    """Participating-mass-weighted mean of a per-mode lateral quantity.
+
+    Parameters
+    ----------
+    masses : list of float
+        Participating mass of each mode, in kg.
+    values : list of tuple of float
+        The per-mode lateral quantity, one pair per mode.
+    total_mass : float
+        Total mass of the rocket, in kg.
+
+    Returns
+    -------
+    tuple of float
+        The weighted mean, in the units of ``values``.
+    """
+    if total_mass == 0:
+        return (0.0, 0.0)
+    x = sum(mass * value[0] for mass, value in zip(masses, values))
+    y = sum(mass * value[1] for mass, value in zip(masses, values))
+    return (x / total_mass, y / total_mass)
+
+
+def slosh_mass_function(tank):
+    """Participating mass of a tank as a function of time.
+
+    Parameters
+    ----------
+    tank : Tank
+        The tank whose participating mass is evaluated.
+
+    Returns
+    -------
+    Function
+        Mass ratio times the liquid mass, in kg, as a function of time.
+    """
+    if tank.slosh is None:
+        return Function(0).set_discrete_based_on_model(tank.liquid_mass)
+
+    total_volume = tank.geometry.total_volume
+    liquid_volume = tank.liquid_volume
+    liquid_mass = tank.liquid_mass
+    ratio = tank.slosh.mass_ratio
+
+    if not callable(ratio):
+        return ratio * liquid_mass
+
+    def source(t):
+        fill = (
+            0.0 if total_volume == 0 else liquid_volume.get_value_opt(t) / total_volume
+        )
+        return ratio(fill) * liquid_mass.get_value_opt(t)
+
+    return Function(source, "Time (s)", "Slosh mass (kg)").set_discrete_based_on_model(
+        liquid_mass
+    )
