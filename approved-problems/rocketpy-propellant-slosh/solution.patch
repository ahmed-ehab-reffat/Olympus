+    def _widen_tolerance(self, tolerance, kind):
+        """Extend a per-state tolerance vector to cover the slosh entries.
+
+        A scalar tolerance already applies to every entry and is returned
+        unchanged, as is a vector that already accounts for the modes.
+
+        Parameters
+        ----------
+        tolerance : float, list, array
+            The tolerance given to the solver.
+        kind : str
+            How the tolerance is named in an error message.
+
+        Returns
+        -------
+        float, list
+            The tolerance, padded when it was a vector of the original width.
+
+        Raises
+        ------
+        ValueError
+            If the vector carries more entries than the modes account for.
+        """
+        extra = 4 * len(self._slosh_modes)
+        if extra == 0 or np.ndim(tolerance) == 0:
+            return tolerance
+        values = [float(value) for value in np.asarray(tolerance).ravel()]
+        if len(values) == 13 + extra:
+            return values
+        if len(values) > 13 + extra:
+            raise ValueError(
+                f"{kind} tolerance has {len(values)} entries, "
+                f"but this rocket needs {13 + extra}."
+            )
+        return values + extra * [1e-6]
+
+    def _widen_initial_solution(self, solution):
+        """Append the slosh entries an original width initial state lacks.
+
+        A state given at the original width carries no slosh entries and starts
+        every mode at rest. A state that carries them carries one block for
+        every mode.
+
+        Parameters
+        ----------
+        solution : list
+            Time followed by the state variables.
+
+        Returns
+        -------
+        list
+            The same state padded to the width the rocket's modes require.
+
+        Raises
+        ------
+        ValueError
+            If the state is neither the original width nor the full width.
+        """
+        original = 1 + 13
+        expected = original + 4 * len(self._slosh_modes)
+        if len(solution) == expected:
+            return list(solution)
+        if len(solution) != original:
+            raise ValueError(
+                f"Initial solution has {len(solution)} entries, but this "
+                f"rocket needs {original} or {expected}."
+            )
+        return list(solution) + [0.0] * (expected - original)
+
