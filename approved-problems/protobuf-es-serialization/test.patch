+    );
+    const cases: {
+      bytes: Uint8Array;
+      options?: { readMaxBytes: number };
+    }[] = [
+      { bytes: new Uint8Array(10).fill(0x80) },
+      { bytes: new Uint8Array([0x02, 0x08]) },
+      { bytes: valid, options: { readMaxBytes: 1 } },
+    ];
+    for (const entry of cases) {
+      await captureAsyncFailure(
+        async () => {
+          for await (const _ of sizeDelimitedDecodeStream(
+            MessageFieldMessageSchema,
+            partition(entry.bytes, 1),
+            entry.options,
+          )) {
+            assert.fail("rejected framing must not yield a message");
+          }
+        },
+        {
+          format: "binary",
+          operation: "read",
+          schema: MessageFieldMessageSchema,
+          path: "",
+        },
+      );
+    }
+  });
+
+  void test("serialization_error_c7bbc8_size_delimited_stream_preserves_prefix_and_failure", async () => {
+    const firstMessage = create(MessageFieldMessageSchema, {
+      messageField: { name: "first" },
+    });
+    const firstFrame = sizeDelimitedEncode(
+      MessageFieldMessageSchema,
+      firstMessage,
+    );
+    const failures = [
+      {
+        bytes: concatenate(firstFrame, frame(malformedRepeatedMessageBinary())),
+        path: "repeated_message_field[1].name",
+      },
+      {
+        bytes: concatenate(firstFrame, new Uint8Array([0x02, 0x08])),
+        path: "",
+      },
+    ];
+    for (const failureCase of failures) {
+      for (const width of [1, failureCase.bytes.byteLength]) {
+        const iterator = sizeDelimitedDecodeStream(
+          MessageFieldMessageSchema,
+          partition(failureCase.bytes, width),
+        )[Symbol.asyncIterator]();
+        const first = await iterator.next();
+        assert.strictEqual(first.done, false);
+        assert.deepStrictEqual(first.value, firstMessage);
+        await captureAsyncFailure(() => iterator.next(), {
+          format: "binary",
+          operation: "read",
+          schema: MessageFieldMessageSchema,
+          path: failureCase.path,
+        });
+        assert.deepStrictEqual(await iterator.next(), {
+          done: true,
+          value: undefined,
+        });
+      }
+    }
+
+    const secondMessage = create(MessageFieldMessageSchema, {
+      messageField: { name: "second" },
+    });
+    const decoded = [];
+    for await (const message of sizeDelimitedDecodeStream(
+      MessageFieldMessageSchema,
+      partition(
+        concatenate(
+          firstFrame,
+          sizeDelimitedEncode(MessageFieldMessageSchema, secondMessage),
+        ),
+        2,
+      ),
+    )) {
+      decoded.push(message.messageField?.name);
+    }
+    assert.deepStrictEqual(decoded, ["first", "second"]);
+  });
+});
