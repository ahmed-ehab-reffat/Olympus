+
+type SerializationFormat = "binary" | "json" | "text";
+type SerializationOperation = "read" | "write";
+
+type SerializationFailure = Error & {
+  readonly format: SerializationFormat;
+  readonly operation: SerializationOperation;
+  readonly schema: DescMessage;
+  readonly path: Path;
+  readonly cause: unknown;
+};
+
+type ErrorConstructor = new (...args: never[]) => Error;
+
+type ExpectedFailure = {
+  format: SerializationFormat;
+  operation: SerializationOperation;
+  schema: DescMessage;
+  path: string | readonly string[];
+};
+
+function serializationErrorConstructor(): ErrorConstructor {
+  const value = (protobuf as unknown as Record<string, unknown>)
+    .SerializationError;
+  assert.strictEqual(
+    typeof value,
+    "function",
+    "@bufbuild/protobuf must export SerializationError",
+  );
+  return value as ErrorConstructor;
+}
+
+function captureFailure(
+  run: () => unknown,
+  expected: ExpectedFailure,
+): SerializationFailure {
+  let caught: unknown;
+  try {
+    run();
+  } catch (error) {
+    caught = error;
+  }
+  return assertFailure(caught, expected);
+}
+
+async function captureAsyncFailure(
+  run: () => Promise<unknown>,
+  expected: ExpectedFailure,
+): Promise<SerializationFailure> {
+  let caught: unknown;
+  try {
+    await run();
+  } catch (error) {
+    caught = error;
+  }
+  return assertFailure(caught, expected);
+}
+
+function assertFailure(
+  caught: unknown,
+  expected: ExpectedFailure,
+): SerializationFailure {
+  assert.ok(caught instanceof Error, "operation must throw an Error");
+  assert.ok(caught instanceof serializationErrorConstructor());
+  const failure = caught as SerializationFailure;
+  assert.strictEqual(failure.name, "Error");
+  assert.strictEqual(failure.format, expected.format);
+  assert.strictEqual(failure.operation, expected.operation);
+  assert.strictEqual(failure.schema, expected.schema);
+  assert.ok(Array.isArray(failure.path));
+  const path = pathToString(failure.path);
+  if (Array.isArray(expected.path)) {
+    assert.ok(
+      expected.path.includes(path),
+      `path ${JSON.stringify(path)} is not one of the accepted staging outcomes ${JSON.stringify(expected.path)}`,
+    );
+  } else {
+    assert.strictEqual(path, expected.path);
+  }
+  assert.strictEqual(
+    pathToString(buildPath(failure.schema).add(failure.path).toPath()),
+    path,
+  );
+  assert.strictEqual(
+    pathToString(
+      parsePath(failure.schema, path, {
+        registry: createRegistry(
+          file_extra_extensions_proto2,
+          file_google_protobuf_unittest_custom_options,
+        ),
+      }),
+    ),
+    path,
+  );
+  assert.ok(failure.cause instanceof Error);
+  return failure;
+}
+
+function frame(bytes: Uint8Array): Uint8Array {
+  return new BinaryWriter().bytes(bytes).finish();
+}
+
+function concatenate(...parts: Uint8Array[]): Uint8Array {
+  const bytes = new Uint8Array(
+    parts.reduce((length, part) => length + part.byteLength, 0),
+  );
+  let offset = 0;
+  for (const part of parts) {
+    bytes.set(part, offset);
+    offset += part.byteLength;
+  }
+  return bytes;
+}
+
+async function* partition(
+  bytes: Uint8Array,
+  width: number,
+): AsyncIterable<Uint8Array> {
+  for (let offset = 0; offset < bytes.byteLength; offset += width) {
+    yield bytes.subarray(offset, offset + width);
+  }
+}
+
+function malformedRepeatedMessageBinary(): Uint8Array {
+  return new Uint8Array([0x12, 0x03, 0x0a, 0x01, 0x61, 0x12, 0x01, 0x0a]);
+}
+
+function malformedNestedMessageBodyBinary(): Uint8Array {
+  // field 1 (message_field, LEN), length 5: a valid `name` field ("ok")
+  // followed by a truncated varint tag, so the failure happens between
+  // fields inside the nested message body rather than at its own end.
+  return new Uint8Array([0x0a, 0x05, 0x0a, 0x02, 0x6f, 0x6b, 0x80]);
+}
+
+function malformedUint64MapValueBinary(): Uint8Array {
+  // field 59 (map_uint64_uint64, LEN) on TestAllTypesProto3Schema: a map
+  // entry keyed at UINT64_MAX (18446744073709551615) whose value is a
+  // truncated varint, so the failure occurs while reading the value for
+  // a key at the unsigned 64-bit precision boundary.
+  return new Uint8Array([
+    0xda, 0x03, 0x0d, 0x08, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    0xff, 0x01, 0x10, 0x80,
+  ]);
+}
+
+function invalidRepeatedMessage() {
+  const message = create(MessageFieldMessageSchema, {
+    repeatedMessageField: [{ name: "ok" }, { name: "bad" }],
+  });
+  (message.repeatedMessageField[1] as unknown as { name: unknown }).name = 7;
+  return message;
+}
+
+function invalidNestedMapMessage() {
+  const message = create(MapsMessageSchema, {
+    strMsgField: {
+      branch: {
+        strInt32Field: { leaf: 1 },
+      },
+    },
+  });
+  (
+    message.strMsgField.branch.strInt32Field as unknown as Record<
+      string,
+      unknown
+    >
+  ).leaf = "bad";
+  return message;
+}
+
+function invalidNestedStringMapMessage() {
+  const message = create(MapsMessageSchema, {
+    strMsgField: {
+      branch: {
+        strStrField: { leaf: "ok" },
+      },
+    },
+  });
+  (
+    message.strMsgField.branch.strStrField as unknown as Record<string, unknown>
+  ).leaf = 7;
+  return message;
+}
+
+function invalidInt32KeyedIntMapMessage() {
+  const message = create(MapsMessageSchema, {
+    int32MsgField: {
+      5: { strInt32Field: { leaf: 1 } },
+    },
+  });
+  (
+    message.int32MsgField[5].strInt32Field as unknown as Record<
+      string,
+      unknown
+    >
+  ).leaf = "bad";
+  return message;
+}
+
+function invalidInt32KeyedStringMapMessage() {
+  const message = create(MapsMessageSchema, {
+    int32MsgField: {
+      5: { strStrField: { leaf: "ok" } },
+    },
+  });
+  (
+    message.int32MsgField[5].strStrField as unknown as Record<string, unknown>
