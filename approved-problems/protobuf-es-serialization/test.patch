+      optionalNestedMessage: { a: 9 },
+    }),
+  );
+  const bytes = new Uint8Array(early.length + 7);
+  bytes.set(early);
+  bytes.set([0xb8, 0x3e, 0x02], early.length);
+  bytes.set([0x92, 0x01, 0x01, 0x08], early.length + 3);
+  return bytes;
+}
