diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..aacbe3b2
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+
+mode=""
+output_path=""
+
+while (($# > 0)); do
+    case "$1" in
+        --output_path)
+            if (($# < 2)); then
+                echo "error: --output_path requires a path" >&2
+                exit 2
+            fi
+            output_path="$2"
+            shift 2
+            ;;
+        base|new)
+            if [[ -n "$mode" ]]; then
+                echo "error: mode already set to '$mode'" >&2
+                exit 2
+            fi
+            mode="$1"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ "$mode" != "base" && "$mode" != "new" ]]; then
+    echo "mode must be base or new" >&2
+    exit 2
+fi
+
+if [[ -z "$output_path" ]]; then
+    output_path="test-results.xml"
+fi
+
+cd "$(dirname "$0")"
+mkdir -p "$(dirname "$output_path")"
+rm -f "$output_path"
+
+if [[ "$mode" == "new" ]]; then
+    # Remove the whole directory, not just its contents: the build tool
+    # (tshy) chmods the dist directory itself, which fails with EPERM if it
+    # already exists owned by the image-build UID and the eval UID differs.
+    # Deleting it lets the build recreate it owned by the current UID.
+    rm -rf packages/protobuf/dist
+    if ! build_output=$(npm run build --workspace=@bufbuild/protobuf 2>&1); then
+        echo "error: failed to build the @bufbuild/protobuf prerequisite" >&2
+        echo "$build_output" >&2
+        printf '<testsuites/>\n' >"$output_path"
+        exit 1
+    fi
+fi
+
+if [[ "$mode" == "base" ]]; then
+    mapfile -t test_files < <(
+        find packages/protobuf-test -type f -name '*.test.ts' \
+            ! -name 'serialization-error.c7bbc8.test.ts' | sort
+    )
+else
+    test_files=(
+        packages/protobuf-test/src/serialization-error.c7bbc8.test.ts
+    )
+fi
+
+if [[ ${#test_files[@]} -eq 0 ]]; then
+    echo "error: no test files found for mode '$mode'" >&2
+    exit 1
+fi
+
+npx tsx --test \
+    --test-reporter=junit \
+    --test-reporter-destination="$output_path" \
+    "${test_files[@]}"
+status=$?
+
+if [[ ! -s "$output_path" ]]; then
+    printf '<testsuites/>\n' >"$output_path"
+    if [[ "$status" -eq 0 ]]; then
+        status=1
+    fi
+fi
+
+exit "$status"
