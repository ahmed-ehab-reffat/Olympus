+    const requireProbe = spawnSync(
+      process.execPath,
+      [
+        "-e",
+        'const p = require("@bufbuild/protobuf"); if (typeof p.SerializationError !== "function") process.exit(2);',
+      ],
+      { cwd: process.cwd(), encoding: "utf8" },
+    );
+    assert.strictEqual(
+      requireProbe.status,
+      0,
+      requireProbe.stderr || requireProbe.stdout,
+    );
+  });
