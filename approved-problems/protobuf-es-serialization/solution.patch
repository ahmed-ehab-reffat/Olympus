+import type { DescMessage } from "./descriptors.js";
+import type { Path } from "./reflect/path.js";
+
+export type SerializationFormat = "binary" | "json" | "text";
+
+export type SerializationOperation = "read" | "write";
+
+export class SerializationError extends Error {
+  readonly format: SerializationFormat;
+  readonly operation: SerializationOperation;
+  readonly schema: DescMessage;
+  readonly path: Path;
+  readonly cause: unknown;
+
+  constructor(
+    format: SerializationFormat,
+    operation: SerializationOperation,
+    schema: DescMessage,
+    path: Path,
+    cause: unknown,
+    message?: string,
+  ) {
+    super(message ?? errorMessage(cause));
+    this.format = format;
+    this.operation = operation;
+    this.schema = schema;
+    this.path = path.concat();
+    this.cause = cause;
+    Object.setPrototypeOf(this, new.target.prototype);
+  }
+}
+
+export type SerializationContext = Readonly<{
+  format: SerializationFormat;
+  operation: SerializationOperation;
+  schema: DescMessage;
+}>;
+
+export function makeSerializationContext(
+  format: SerializationFormat,
+  operation: SerializationOperation,
+  schema: DescMessage,
+): SerializationContext {
+  return { format, operation, schema };
+}
+
+export function withSerializationError<T>(
+  context: SerializationContext,
+  path: Path,
+  run: () => T,
+  message?: (cause: unknown) => string | undefined,
+): T {
+  try {
+    return run();
+  } catch (cause) {
+    rethrowSerializationError(context, path, cause, message?.(cause));
+  }
+}
+
+export function rethrowSerializationError(
+  context: SerializationContext,
+  path: Path,
+  cause: unknown,
+  message?: string,
+): never {
+  if (
+    cause instanceof SerializationError &&
+    cause.format === context.format &&
+    cause.operation === context.operation &&
+    cause.schema === context.schema
+  ) {
+    throw cause;
+  }
+  throw new SerializationError(
+    context.format,
+    context.operation,
+    context.schema,
+    path,
+    cause,
+    message,
+  );
+}
+
+function errorMessage(cause: unknown): string {
+  return cause instanceof Error ? cause.message : String(cause);
+}
