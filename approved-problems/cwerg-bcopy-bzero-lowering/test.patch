+.fun nib NORMAL [] = [U32]
+.bbl start
+    poparg d:U32
+    ble d 9 digit
+    add c:U32 d 87
+    bra out
+.bbl digit
+    add c d 48
+.bbl out
+    conv ch:U8 c
+    pusharg ch
+    pusharg 1:S32
+    bsr write_c
+    poparg r:S32
+    ret
+
+.fun dump NORMAL [] = [A32 U32]
