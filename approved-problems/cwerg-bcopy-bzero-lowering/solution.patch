+def Handle_BULK(fun: ir.Fun, opcode, ops: List, _ctx):
+    """Byte loops for bcopy/bzero honoring the direction given by the sign of the length
+
+    The downward loop counts up to the negative length and offsets by one
+    below the cursor so that it never steps past the smallest length.
+    """
+    is_copy = opcode is o.BCOPY
+    length = ops[-1]
+    signed = length.kind.flavor() is o.DK_FLAVOR_S
+    ind = "int64_t" if signed else "uint64_t"
+    i = BulkLoopVar(fun)
+    n = f"({ind})({RegOrNum(fun, length)})"
+    dst = f"((uint8_t*){RegOrNum(fun, ops[0])})"
+    src = f"((uint8_t*){RegOrNum(fun, ops[1])})" if is_copy else None
+    up = f"{src}[{i}]" if is_copy else "0"
+    print(f"    for ({ind} {i} = 0; {i} < {n}; ++{i}) {dst}[{i}] = {up};")
+    if signed:
+        down = f"{src}[{i} - 1]" if is_copy else "0"
+        print(f"    for ({ind} {i} = 0; {i} > {n}; --{i}) {dst}[{i} - 1] = {down};")
