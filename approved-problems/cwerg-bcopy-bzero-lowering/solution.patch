+def BulkMemCntKind(kind: o.DK) -> o.DK:
+    """The kind of the byte counter used for a length of the given kind
+
+    A narrow length is widened to 32 bit of the same flavor so that the
+    counter arithmetic is available on every target. A wider length keeps
+    its own kind so that neither its magnitude nor its sign is lost.
+    """
+    if kind.bitwidth() >= 32:
+        return kind
+    return o.DK.U32 if kind.flavor() is o.DK_FLAVOR_U else o.DK.S32
+
+
+def _BblBulkMemLoop(fun: ir.Fun, name: str, is_copy: bool, down: bool,
+                    dst: ir.Reg, src: Optional[ir.Reg], cnt: ir.Reg,
+                    offset_kind: o.DK) -> ir.Bbl:
+    """Creates a bbl that transfers one byte per iteration
+
+    The upward loop steps the addresses after the access and counts cnt
+    down to zero, the downward loop steps them before the access and
+    counts cnt (which is negative) up to zero.
+    """
+    bbl = ir.Bbl(name)
+    fun.bbl_syms[name] = bbl
+    cnt_kind = cnt.kind
+    zero = ir.Const(offset_kind, 0)
+    step = ir.Const(offset_kind, -1 if down else 1)
+    if down:
+        bbl.inss.append(ir.Ins(o.LEA, [dst, dst, step], False))
+        if is_copy:
+            bbl.inss.append(ir.Ins(o.LEA, [src, src, step], False))
+    if is_copy:
+        val = fun.GetScratchReg(o.DK.U8, "bulk_byte", False)
+        bbl.inss.append(ir.Ins(o.LD, [val, src, zero], False))
+    else:
+        val = ir.Const(o.DK.U8, 0)
+    bbl.inss.append(ir.Ins(o.ST, [dst, zero, val], False))
+    if not down:
+        bbl.inss.append(ir.Ins(o.LEA, [dst, dst, step], False))
+        if is_copy:
+            bbl.inss.append(ir.Ins(o.LEA, [src, src, step], False))
+    bbl.inss.append(ir.Ins(o.ADD if down else o.SUB,
+                           [cnt, cnt, ir.Const(cnt_kind, 1)], False))
+    bbl.inss.append(ir.Ins(o.BNE, [cnt, ir.Const(cnt_kind, 0), bbl], False))
+    bbl.AddEdgeOut(bbl)
+    return bbl
+
+
+def InsEliminateBulkMem(ins: ir.Ins, bbl: ir.Bbl, fun: ir.Fun, offset_kind: o.DK):
+    """Rewrites bcopy/bzero into byte loops
+
+    bzero dst len / bcopy dst src len
+    becomes
+      mov d dst
+      mov s src            (bcopy only)
+      mov c len            (conv if len has another kind)
+      beq c 0 tail         (register lengths only)
+      blt c 0 down         (signed register lengths only)
+    .bbl up
+      ...
+    .bbl down
+      ...
+    .bbl tail
+    A constant length selects the loop statically and a constant zero
+    removes the instruction altogether.
+    """
+    is_copy = ins.opcode.kind is o.OPC_KIND.BCOPY
+    ops = ins.operands
+    length = ops[-1]
+    if isinstance(length, ir.Const) and length.value == 0:
+        del bbl.inss[bbl.index(ins)]
+        return
+    tail = bbl
+    head = cfg.BblSplitBeforeFixEdges(
+        bbl, ins, fun, cfg.NewDerivedBblName(bbl.name, "_bulk", fun))
+    assert head.inss[-1] is ins
+    del head.inss[-1]
+    pos = fun.bbls.index(tail)
+    dst = fun.GetScratchReg(ops[0].kind, "bulk_dst", False)
+    head.inss.append(ir.Ins(o.MOV, [dst, ops[0]], False))
+    src = None
+    if is_copy:
+        src = fun.GetScratchReg(ops[1].kind, "bulk_src", False)
+        head.inss.append(ir.Ins(o.MOV, [src, ops[1]], False))
+    cnt_kind = BulkMemCntKind(length.kind)
+    cnt = fun.GetScratchReg(cnt_kind, "bulk_cnt", False)
+    if isinstance(length, ir.Const):
+        head.inss.append(ir.Ins(o.MOV, [cnt, ir.Const(cnt_kind, length.value)], False))
+        down = length.kind.flavor() is o.DK_FLAVOR_S and length.value < 0
+        loop = _BblBulkMemLoop(
+            fun, cfg.NewDerivedBblName(bbl.name, "_bulk_down" if down else "_bulk_up", fun),
+            is_copy, down, dst, src, cnt, offset_kind)
+        fun.bbls.insert(pos, loop)
+        head.ReplaceEdgeOut(tail, loop)
+        loop.AddEdgeOut(tail)
+        return
+    if length.kind is cnt_kind:
+        head.inss.append(ir.Ins(o.MOV, [cnt, length], False))
+    else:
+        head.inss.append(ir.Ins(o.CONV, [cnt, length], False))
+    zero = ir.Const(cnt_kind, 0)
+    head.inss.append(ir.Ins(o.BEQ, [cnt, zero, tail], False))
+    up = _BblBulkMemLoop(fun, cfg.NewDerivedBblName(bbl.name, "_bulk_up", fun),
+                         is_copy, False, dst, src, cnt, offset_kind)
+    up.AddEdgeOut(tail)
+    if length.kind.flavor() is o.DK_FLAVOR_U:
+        fun.bbls.insert(pos, up)
+        head.AddEdgeOut(up)
+        return
+    down = _BblBulkMemLoop(fun, cfg.NewDerivedBblName(bbl.name, "_bulk_down", fun),
+                           is_copy, True, dst, src, cnt, offset_kind)
+    down.AddEdgeOut(tail)
+    sel = ir.Bbl(cfg.NewDerivedBblName(bbl.name, "_bulk_sel", fun))
+    fun.bbl_syms[sel.name] = sel
+    sel.inss.append(ir.Ins(o.BLT, [cnt, zero, down], False))
+    sel.AddEdgeOut(down)
+    sel.AddEdgeOut(up)
+    fun.bbls[pos:pos] = [sel, up, down]
+    head.AddEdgeOut(sel)
+
+
+def FunEliminateBulkMem(fun: ir.Fun, offset_kind: o.DK) -> int:
+    count = 0
+    for bbl in fun.bbls[:]:  # not we are updating the list while iterating over it
+        for ins in bbl.inss[:]:
