-       [TC.ADDR, TC.SAME_AS_PREV, TC.OFFSET], OPC_GENUS.TBD,
-       "TBD",
-       OA.MEM_WR | OA.MEM_RD)
-
-# Note, negative lengths copy downwards
-Opcode(0xba, "bzero", OPC_KIND.BZERO, [OP_KIND.REG, OP_KIND.REG_OR_CONST],
-       [TC.ADDR, TC.OFFSET], OPC_GENUS.TBD,
-       "TBD",
-       OA.MEM_WR)
+BCOPY = Opcode(0xb8, "bcopy", OPC_KIND.BCOPY,
+               [OP_KIND.REG, OP_KIND.REG, OP_KIND.REG_OR_CONST],
+               [TC.ADDR, TC.SAME_AS_PREV, TC.OFFSET], OPC_GENUS.BASE,
+               """Copy bytes: `RAM[dst + i] := RAM[src + i]`
+
+               A non-negative length copies that many bytes upward starting
+               at the given addresses, one byte at a time.
+               A negative length copies downward starting with the byte
+               just below the given addresses.
+               The sign is taken from the value even when it is in a register.""",
+               OA.MEM_WR | OA.MEM_RD)
+
+BZERO = Opcode(0xba, "bzero", OPC_KIND.BZERO, [OP_KIND.REG, OP_KIND.REG_OR_CONST],
+               [TC.ADDR, TC.OFFSET], OPC_GENUS.BASE,
+               """Zero bytes: `RAM[dst + i] := 0`
+
+               The length works like the one of `bcopy`.""",
+               OA.MEM_WR)
 
 
