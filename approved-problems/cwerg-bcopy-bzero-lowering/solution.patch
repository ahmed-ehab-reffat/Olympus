+def BulkLoopVar(fun: ir.Fun) -> str:
+    """A loop variable that cannot capture one of the function's own registers"""
+    taken = {MangleReg(reg) for reg in fun.regs}
+    name = "bulk_i"
+    while name in taken:
+        name += "_"
+    return name
