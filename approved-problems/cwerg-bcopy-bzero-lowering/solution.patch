+
+Bbl BblBulkMemLoop(Fun fun, Str name, bool is_copy, bool down, Reg dst,
+                   Reg src, Reg cnt, DK offset_kind) {
+  const Bbl bbl = BblNew(name);
+  FunBblAddBst(fun, bbl);
+  const DK cnt_kind = RegKind(cnt);
+  const Const zero = ConstNewACS(offset_kind, 0);
+  const Const step = ConstNewACS(offset_kind, down ? -1 : 1);
+  if (down) {
+    BblInsAppendList(bbl, InsNew(OPC::LEA, false, dst, dst, step));
+    if (is_copy) BblInsAppendList(bbl, InsNew(OPC::LEA, false, src, src, step));
+  }
+  Handle val;
+  if (is_copy) {
+    const Reg byte = FunGetScratchReg(fun, DK::U8, "bulk_byte", false);
+    BblInsAppendList(bbl, InsNew(OPC::LD, false, byte, src, zero));
+    val = byte;
+  } else {
+    val = ConstNewU(DK::U8, 0);
+  }
+  BblInsAppendList(bbl, InsNew(OPC::ST, false, dst, zero, val));
+  if (!down) {
+    BblInsAppendList(bbl, InsNew(OPC::LEA, false, dst, dst, step));
+    if (is_copy) BblInsAppendList(bbl, InsNew(OPC::LEA, false, src, src, step));
+  }
+  BblInsAppendList(bbl, InsNew(down ? OPC::ADD : OPC::SUB, false, cnt, cnt,
+                               ConstNewACS(cnt_kind, 1)));
+  BblInsAppendList(bbl,
+                   InsNew(OPC::BNE, false, cnt, ConstNewACS(cnt_kind, 0), bbl));
+  EdgLink(EdgNew(bbl, bbl));
+  return bbl;
+}
+
+int64_t ConstValueSignedAtWidth(Const num) {
+  const int64_t value = ConstValueACS(num);
+  const unsigned bw = DKBitWidth(ConstKind(num));
+  if (bw >= 64) return value;
+  const unsigned shift = 64 - bw;
+  return int64_t(uint64_t(value) << shift) >> shift;
+}
+
+uint64_t ConstValueUnsignedAtWidth(Const num) {
+  const uint64_t value = ConstValueU(num);
+  const unsigned bw = DKBitWidth(ConstKind(num));
+  if (bw >= 64) return value;
+  return value & ((uint64_t(1) << bw) - 1);
+}
+
+bool ConstIsZeroValue(Const num) {
+  if (DKFlavor(ConstKind(num)) == DK_FLAVOR_U) {
+    return ConstValueUnsignedAtWidth(num) == 0;
+  }
+  return ConstValueSignedAtWidth(num) == 0;
+}
+
+
+bool ConstIsNegativeValue(Const num) {
+  return DKFlavor(ConstKind(num)) == DK_FLAVOR_S &&
+         ConstValueSignedAtWidth(num) < 0;
+}
+
+Const ConstWithKind(Const num, DK kind) {
+  if (DKFlavor(ConstKind(num)) == DK_FLAVOR_U) {
+    return ConstNewU(kind, ConstValueUnsignedAtWidth(num));
+  }
+  return ConstNewACS(kind, ConstValueSignedAtWidth(num));
+}
+
+void BblReplaceSuccEdg(Bbl bbl, Bbl old_succ, Bbl new_succ) {
+  for (Edg edg : BblSuccEdgIter(bbl)) {
+    if (EdgSuccBbl(edg) == old_succ) {
+      EdgUnlink(edg);
+      EdgDel(edg);
+      break;
+    }
+  }
+  EdgLink(EdgNew(bbl, new_succ));
+}
+
+void InsEliminateBulkMem(Ins ins, Bbl bbl, Fun fun, DK offset_kind) {
+  const bool is_copy = InsOpcode(ins).kind == OPC_KIND::BCOPY;
+  const Handle length = InsOperand(ins, is_copy ? 2 : 1);
+  if (Kind(length) == RefKind::CONST && ConstIsZeroValue(Const(length))) {
+    BblInsUnlink(ins);
+    InsDel(ins);
+    return;
+  }
+  const Bbl tail = bbl;
+  const Bbl head = BblNew(NewDerivedBblName(Name(bbl), "_bulk", fun));
+  FunBblAddBst(fun, head);
+  FunBblInsertBefore(fun, tail, head);
+  BblSplitBeforeFixEdges(tail, ins, head);
+  BblInsUnlink(ins);
+  const Reg dst =
+      FunGetScratchReg(fun, RegKind(Reg(InsOperand(ins, 0))), "bulk_dst", false);
+  BblInsAppendList(head, InsNew(OPC::MOV, false, dst, InsOperand(ins, 0)));
+  Reg src;
+  if (is_copy) {
+    src = FunGetScratchReg(fun, RegKind(Reg(InsOperand(ins, 1))), "bulk_src",
+                           false);
+    BblInsAppendList(head, InsNew(OPC::MOV, false, src, InsOperand(ins, 1)));
+  }
+  const DK cnt_kind = BulkMemCntKind(
+      Kind(length) == RefKind::CONST ? ConstKind(Const(length))
+                                     : RegKind(Reg(length)));
+  const Reg cnt = FunGetScratchReg(fun, cnt_kind, "bulk_cnt", false);
+  if (Kind(length) == RefKind::CONST) {
+    BblInsAppendList(
+        head, InsNew(OPC::MOV, false, cnt,
+                     ConstWithKind(Const(length), cnt_kind)));
+    const bool down = ConstIsNegativeValue(Const(length));
+    const Bbl loop = BblBulkMemLoop(
+        fun, NewDerivedBblName(Name(bbl), down ? "_bulk_down" : "_bulk_up", fun),
+        is_copy, down, dst, src, cnt, offset_kind);
+    FunBblInsertBefore(fun, tail, loop);
+    BblReplaceSuccEdg(head, tail, loop);
+    EdgLink(EdgNew(loop, tail));
+    InsDel(ins);
+    return;
+  }
+  const DK length_kind = RegKind(Reg(length));
+  BblInsAppendList(head, InsNew(length_kind == cnt_kind ? OPC::MOV : OPC::CONV,
+                                false, cnt, length));
+  const Const zero = ConstNewACS(cnt_kind, 0);
+  BblInsAppendList(head, InsNew(OPC::BEQ, false, cnt, zero, tail));
+  const Bbl up =
+      BblBulkMemLoop(fun, NewDerivedBblName(Name(bbl), "_bulk_up", fun), is_copy,
+                     false, dst, src, cnt, offset_kind);
+  EdgLink(EdgNew(up, tail));
+  if (DKFlavor(length_kind) == DK_FLAVOR_U) {
+    FunBblInsertBefore(fun, tail, up);
+    EdgLink(EdgNew(head, up));
+    InsDel(ins);
+    return;
+  }
+  const Bbl down =
+      BblBulkMemLoop(fun, NewDerivedBblName(Name(bbl), "_bulk_down", fun),
+                     is_copy, true, dst, src, cnt, offset_kind);
+  EdgLink(EdgNew(down, tail));
+  const Bbl sel = BblNew(NewDerivedBblName(Name(bbl), "_bulk_sel", fun));
+  FunBblAddBst(fun, sel);
+  BblInsAppendList(sel, InsNew(OPC::BLT, false, cnt, zero, down));
+  EdgLink(EdgNew(sel, down));
+  EdgLink(EdgNew(sel, up));
+  FunBblInsertBefore(fun, tail, sel);
+  FunBblInsertBefore(fun, tail, up);
+  FunBblInsertBefore(fun, tail, down);
+  EdgLink(EdgNew(head, sel));
+  InsDel(ins);
+}
+
+void FunEliminateBulkMem(Fun fun, DK offset_kind) {
+  std::vector<std::pair<Ins, Bbl>> todo;
+  for (Bbl bbl : FunBblIter(fun)) {
+    for (Ins ins : BblInsIter(bbl)) {
+      const OPC_KIND kind = InsOpcode(ins).kind;
+      if (kind == OPC_KIND::BCOPY || kind == OPC_KIND::BZERO) {
+        todo.emplace_back(ins, bbl);
+      }
+    }
+  }
+  for (const auto& [ins, bbl] : todo) {
+    InsEliminateBulkMem(ins, bbl, fun, offset_kind);
+  }
+}
