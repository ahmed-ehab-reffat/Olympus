+int64_t SignExtend(int64_t val, unsigned bitwidth) {
+  if (bitwidth >= 64) return val;
+  const uint64_t data = uint64_t(val) & ((1ULL << bitwidth) - 1);
+  if (data & (1ULL << (bitwidth - 1))) {
+    return int64_t(data) - int64_t(1ULL << bitwidth);
+  }
+  return int64_t(data);
+}
+
+
+template <typename VAL>
+VAL GenericEvaluateALU(OPC opc, DK dk, VAL va, VAL vb);
+
+int64_t SignedEvaluateALU(OPC opc, DK dk, int64_t va, int64_t vb) {
+  const uint64_t ua = uint64_t(va);
+  const uint64_t ub = uint64_t(vb);
+  switch (opc) {
+    case OPC::ADD:
+      return int64_t(ua + ub);
+    case OPC::SUB:
+      return int64_t(ua - ub);
+    case OPC::MUL:
+      return int64_t(ua * ub);
+    case OPC::SHL:
+      return int64_t((ua << (ub % DKBitWidth(dk))) &
+                     GetMask<uint64_t>(DKBitWidth(dk)));
+    case OPC::SHR:
+      return va >> (ub % DKBitWidth(dk));
+    default:
+      return GenericEvaluateALU<int64_t>(opc, dk, va, vb);
+  }
+}
 
