+        run(env, 3)
+        assert log_of(env) == [(at(0.2), "t")]
+        assert env.get_object_by_name("box_1") is not None
+
+
+class TestConditions:
+    """The condition kinds and how they combine."""
+
+    def test_arrive_fires_at_first_arrival(self, tmp_path):
+        """An arrive event fires at the check where the robot first counts as arrived."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "a",
+                    "when": {"arrive": "robot_0"},
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+            robots=[robot_entry([1, 1, 0], [2, 1, 0])],
+        )
+        first = None
+        for _ in range(40):
+            env.step()
+            if first is None and env.robot.arrive:
+                first = env.time
+        assert first is not None
+        assert log_of(env) == [(at(first), "a")]
+
+    def test_arrive_holds_while_arrived(self, tmp_path):
+        """arrive stays true while the robot remains at its goal."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "a",
+                    "when": {"arrive": "robot_0"},
+                    "repeat": True,
+                    "cooldown": 2,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+            robots=[robot_entry([1, 1, 0], [1, 1, 0])],
+        )
+        run(env, 5)
+        assert times_of(env) == [at(0.1), at(0.3), at(0.5)]
+
+    def test_collision_holds_while_colliding(self, tmp_path):
+        """collision stays true while the objects keep overlapping."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "c",
+                    "when": {"collision": "robot_0"},
+                    "repeat": True,
+                    "do": [spawn_box([8, 8, 0])],
+                }
+            ],
+            robots=[lidar_robot([1, 1, 0], [1, 1, 0])],
+            obstacles=[obstacle_entry([1.3, 1, 0], radius=0.4)],
+        )
+        run(env, 4)
+        assert times_of(env) == [at(0.1), at(0.2), at(0.3), at(0.4)]
+
+    def test_distance_follows_moving_objects(self, tmp_path):
+        """distance is evaluated on the current positions at every check."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "d",
+                    "when": {"distance": {"objects": ["robot_0", "o"], "below": 2.0}},
+                    "repeat": True,
+                    "do": [spawn_box([8, 8, 0])],
