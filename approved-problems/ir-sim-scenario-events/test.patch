+class TestRegions:
+    """enter and leave conditions."""
+
+    REGION = (2.0, 0.0, 3.0, 2.0)
+
+    def crossing(self, env, steps):
+        """Step and return the times at which robot_0 crossed into and out of REGION."""
+
+        def inside():
+            x, y = env.robot.state[0, 0], env.robot.state[1, 0]
+            return 2.0 <= x <= 3.0 and 0.0 <= y <= 2.0
+
+        entered, left = [], []
+        was = inside()
+        for _ in range(steps):
+            env.step()
+            now = inside()
+            if now and not was:
+                entered.append(env.time)
+            if was and not now:
+                left.append(env.time)
+            was = now
+        return entered, left
+
+    def test_enter_and_leave_fire_on_crossings_only(self, tmp_path):
+        """enter fires when the robot moves in, leave when it moves out, not while it stays."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "in",
+                    "when": {
+                        "enter": {"object": "robot_0", "region": list(self.REGION)}
+                    },
+                    "repeat": True,
+                    "do": [spawn_box([8, 8, 0])],
+                },
+                {
+                    "name": "out",
+                    "when": {
+                        "leave": {"object": "robot_0", "region": list(self.REGION)}
+                    },
+                    "repeat": True,
+                    "do": [spawn_box([8, 9, 0], name="b")],
+                },
+            ],
+        )
+        entered, left = self.crossing(env, 40)
+        assert len(entered) == 1
+        assert len(left) == 1
+        assert times_of(env, "in") == [at(entered[0])]
+        assert times_of(env, "out") == [at(left[0])]
+
