+"""
+Tests for scenario events declared in the ``events`` section of a world YAML.
+"""
+
+import numpy as np
+import pytest
+import yaml
+
+import irsim
+
+
+def robot_entry(state, goal, **extra):
+    """A differential robot driving to ``goal`` with the dash behavior."""
+    entry = {
+        "kinematics": {"name": "diff"},
+        "shape": {"name": "circle", "radius": 0.2},
+        "state": list(state),
+        "goal": list(goal),
+        "behavior": {"name": "dash"},
+    }
+    entry.update(extra)
+    return entry
+
+
+def obstacle_entry(state, radius=0.3, **extra):
+    """A static circular obstacle."""
+    entry = {"shape": {"name": "circle", "radius": radius}, "state": list(state)}
+    entry.update(extra)
+    return entry
+
+
+def scenario(
+    tmp_path,
+    events=None,
+    robots=None,
+    obstacles=None,
+    filename="scenario.yaml",
+    **world,
+):
+    """Write a world YAML and return its path."""
+    config = {"world": {"height": 10, "width": 10, "step_time": 0.1, **world}}
+    config["robot"] = (
+        robots if robots is not None else [robot_entry([1, 1, 0], [9, 1, 0])]
+    )
+    if obstacles is not None:
+        config["obstacle"] = obstacles
+    if events is not None:
+        config["events"] = events
+    path = tmp_path / filename
+    path.write_text(yaml.safe_dump(config, sort_keys=False))
+    return str(path)
+
+
+def make(tmp_path, events=None, **kwargs):
+    """Build a headless environment from a written scenario."""
+    options = {k: kwargs.pop(k) for k in ("step_mode", "seed") if k in kwargs}
+    return irsim.make(scenario(tmp_path, events, **kwargs), headless=True, **options)
+
+
+def run(env, steps):
+    """Advance the environment by ``steps`` calls to ``env.step``."""
+    for _ in range(steps):
+        env.step()
+
+
+def log_of(env):
+    """The event log as ``(time, name)`` tuples."""
+    return [tuple(entry) for entry in env.event_log]
+
+
+def names_of(env):
+    """Names of the logged event runs, in order."""
+    return [entry[1] for entry in log_of(env)]
+
+
+def times_of(env, name=None):
+    """Times of the logged event runs, optionally of one event."""
+    return [entry[0] for entry in log_of(env) if name is None or entry[1] == name]
+
+
+def scene(env):
+    """``(name, id)`` of every object, in list order."""
+    return [(obj.name, obj.id) for obj in env.objects]
+
+
+def at(value):
+    """Tolerant comparison for a simulation time."""
+    return pytest.approx(value, abs=1e-9)
+
+
+def spawn_box(state, name="box", radius=0.2, **extra):
+    """A spawn action for a static circular obstacle."""
+    template = {"shape": {"name": "circle", "radius": radius}, "state": list(state)}
+    if name is not None:
+        template["name"] = name
+    template.update(extra)
+    return {"spawn": {"obstacle": template}}
+
+
+def square(state, **extra):
+    """A static square robot whose centre is exactly its position."""
+    entry = {
+        "kinematics": {"name": "diff"},
+        "shape": {"name": "rectangle", "length": 0.5, "width": 0.5},
+        "state": list(state),
+        "goal": list(state),
+    }
+    entry.update(extra)
+    return entry
+
+
+def square_obstacle(state, **extra):
+    """A static square obstacle whose centre is exactly its position."""
+    entry = {
+        "shape": {"name": "rectangle", "length": 0.5, "width": 0.5},
+        "state": list(state),
+    }
+    entry.update(extra)
+    return entry
+
+
+def lidar_robot(state, goal):
+    """A static robot with a forward-looking lidar."""
+    return {
+        "kinematics": {"name": "diff"},
+        "shape": {"name": "circle", "radius": 0.2},
+        "state": list(state),
+        "goal": list(goal),
+        "sensors": [
+            {"name": "lidar2d", "range_max": 5, "angle_range": 0.4, "number": 5}
+        ],
+    }
+
+
+class TestEventConfig:
+    """Parsing and validation of the events section."""
+
+    def test_world_without_events_has_empty_log(self, tmp_path):
+        """A world with no events section runs and logs nothing."""
+        env = make(tmp_path)
+        run(env, 5)
+        assert log_of(env) == []
+
+    def test_unknown_condition_key_raises(self, tmp_path):
+        """A condition with an unknown key makes creation fail."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"when": {"tme": 1.0}, "do": {"pause": True}}])
+
+    def test_unknown_action_key_raises(self, tmp_path):
+        """An action with an unknown key makes creation fail."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"when": {"time": 1.0}, "do": [{"spwn": {}}]}])
+
+    def test_unknown_event_key_raises(self, tmp_path):
+        """An event entry with an unknown key makes creation fail."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(
+                tmp_path,
+                [{"when": {"time": 1.0}, "do": {"pause": True}, "repat": True}],
+            )
+
+    def test_event_without_do_raises(self, tmp_path):
+        """An event missing its actions makes creation fail."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"when": {"time": 1.0}}])
+
+    def test_event_without_when_raises(self, tmp_path):
+        """An event missing its condition makes creation fail."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"do": {"pause": True}}])
+
+    def test_events_section_must_be_a_list(self, tmp_path):
+        """An events value that is not a list makes creation fail."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, {"when": {"time": 1.0}, "do": {"pause": True}})
+
+    def test_null_events_section_raises(self, tmp_path):
+        """An explicit null events section is not a list."""
+        path = scenario(tmp_path)
+        with open(path, "a") as handle:
+            handle.write("events:\n")
+        with pytest.raises(ValueError):  # noqa: PT011
+            irsim.make(path, headless=True)
+
+    @pytest.mark.parametrize("when", [1.0, [{"time": 1.0}], "time"])
+    def test_condition_that_is_not_a_mapping_raises(self, tmp_path, when):
+        """A condition must be a mapping."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"when": when, "do": {"pause": True}}])
+
+    def test_condition_with_two_keys_raises(self, tmp_path):
+        """A condition mapping must have exactly one key."""
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(
+                tmp_path,
+                [{"when": {"time": 1.0, "arrive": "robot_0"}, "do": {"pause": True}}],
+            )
+
+    def test_unknown_key_inside_condition_raises(self, tmp_path):
+        """An unknown key inside a condition's arguments makes creation fail."""
+        distance = {"objects": ["robot_0", "robot_0"], "below": 1.0, "typo": True}
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"when": {"distance": distance}, "do": {"pause": True}}])
+
+    def test_unknown_key_inside_action_raises(self, tmp_path):
+        """An unknown key inside an action's arguments makes creation fail."""
+        goal = {"object": "robot_0", "goal": [2, 1, 0], "typo": True}
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(tmp_path, [{"when": {"time": 1.0}, "do": {"goal": goal}}])
+
+    @pytest.mark.parametrize("role", ["robot", "obstacle"])
+    def test_unknown_key_in_spawned_object_raises(self, tmp_path, role):
+        """An unknown key in a spawned object's mapping makes creation fail."""
+        template = {"shpae": {"name": "circle", "radius": 0.2}, "state": [5, 5, 0]}
+        with pytest.raises(ValueError):  # noqa: PT011
+            make(
+                tmp_path,
+                [{"when": {"time": 1.0}, "do": {"spawn": {role: template}}}],
+            )
+
+    def test_default_names_count_from_zero(self, tmp_path):
+        """Unnamed events are called event_<index>."""
+        env = make(
+            tmp_path,
+            [
+                {"when": {"time": 0.2}, "do": [spawn_box([5, 5, 0], name=None)]},
+                {
+                    "name": "named",
+                    "when": {"time": 0.2},
+                    "do": [spawn_box([6, 6, 0], name=None)],
+                },
+                {"when": {"time": 0.3}, "do": [spawn_box([7, 7, 0], name=None)]},
+            ],
+        )
+        run(env, 4)
+        assert names_of(env) == ["event_0", "named", "event_2"]
+
+    def test_single_action_may_be_given_without_list(self, tmp_path):
+        """``do`` may be one action mapping."""
+        env = make(
+            tmp_path,
+            [{"name": "one", "when": {"time": 0.2}, "do": spawn_box([5, 5, 0])}],
+        )
+        run(env, 3)
+        assert env.get_object_by_name("box_1") is not None
+        assert names_of(env) == ["one"]
+
+
+class TestFiring:
+    """When events fire and when their actions run."""
+
+    def test_time_event_fires_once(self, tmp_path):
+        """A time event without repeat fires at the first check at or past its time."""
+        env = make(
+            tmp_path,
+            [{"name": "t", "when": {"time": 0.3}, "do": [spawn_box([5, 5, 0])]}],
+        )
+        run(env, 10)
+        assert log_of(env) == [(at(0.3), "t")]
+
+    def test_time_condition_is_inclusive_at_threshold(self, tmp_path):
+        """The check at exactly the stated time fires."""
+        env = make(
+            tmp_path,
+            [{"name": "t", "when": {"time": 0.1}, "do": [spawn_box([5, 5, 0])]}],
+        )
+        run(env, 1)
+        assert log_of(env) == [(at(0.1), "t")]
+
+    def test_repeat_fires_every_step_with_default_cooldown(self, tmp_path):
+        """A repeating event fires at every check its condition holds."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "r",
+                    "when": {"time": 0.2},
+                    "repeat": True,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 5)
+        assert times_of(env) == [at(0.2), at(0.3), at(0.4), at(0.5)]
+
+    def test_repeat_cooldown_counts_steps_since_last_firing(self, tmp_path):
+        """With cooldown 3 a repeating event fires every third step."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "r",
+                    "when": {"time": 0.1},
+                    "repeat": True,
+                    "cooldown": 3,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 10)
+        assert times_of(env) == [at(0.1), at(0.4), at(0.7), at(1.0)]
+
+    def test_zero_cooldown_fires_every_check(self, tmp_path):
+        """A repeating event with cooldown 0 fires at every check its condition holds."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "r",
+                    "when": {"time": 0.2},
+                    "repeat": True,
+                    "cooldown": 0,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 4)
+        assert times_of(env) == [at(0.2), at(0.3), at(0.4)]
+
+    def test_repeating_event_stops_when_condition_fails(self, tmp_path):
+        """A repeating event does not fire at checks where its condition is false."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "r",
+                    "when": {"not": {"time": 0.4}},
+                    "repeat": True,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 8)
+        assert times_of(env) == [at(0.1), at(0.2), at(0.3)]
+
+    def test_delay_runs_actions_later(self, tmp_path):
+        """With delay 3 the actions and the log entry come three steps after firing."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "d",
+                    "when": {"time": 0.2},
+                    "delay": 3,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 4)
+        assert env.get_object_by_name("box_1") is None
+        assert log_of(env) == []
+        run(env, 1)
+        assert env.get_object_by_name("box_1") is not None
+        assert log_of(env) == [(at(0.5), "d")]
+
+    def test_delayed_actions_run_before_events_of_the_same_check(self, tmp_path):
+        """Due delayed actions run before the listed events are checked."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "late",
+                    "when": {"time": 0.4},
+                    "do": [spawn_box([6, 6, 0], name="b")],
+                },
+                {
+                    "name": "early",
+                    "when": {"time": 0.2},
+                    "delay": 2,
+                    "do": [spawn_box([5, 5, 0])],
+                },
+            ],
+        )
+        run(env, 5)
+        assert log_of(env) == [(at(0.4), "early"), (at(0.4), "late")]
+
+    def test_due_delayed_actions_run_in_scheduling_order(self, tmp_path):
+        """Two delayed runs due at one check run in the order they were scheduled."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "short",
+                    "when": {"time": 0.3},
+                    "delay": 1,
+                    "do": [spawn_box([6, 6, 0], name="b")],
+                },
+                {
+                    "name": "long",
+                    "when": {"time": 0.1},
+                    "delay": 3,
+                    "do": [spawn_box([5, 5, 0])],
+                },
+            ],
+        )
+        run(env, 5)
+        assert log_of(env) == [(at(0.4), "long"), (at(0.4), "short")]
+
+    def test_later_event_sees_status_after_goal_change(self, tmp_path):
+        """An arrive check after a goal change in the same check sees the new goal."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "send",
+                    "when": {"time": 0.1},
+                    "do": [{"goal": {"object": "robot_0", "goal": [3, 1, 0]}}],
+                },
+                {
+                    "name": "there",
+                    "when": {"arrive": "robot_0"},
+                    "do": [spawn_box([8, 8, 0])],
+                },
+            ],
+            robots=[robot_entry([1, 1, 0], [1, 1, 0])],
+        )
+        first = None
+        for _ in range(60):
+            env.step()
+            if first is None and env.time > 0.15 and env.robot.arrive:
+                first = env.time
+        assert first is not None
+        assert log_of(env) == [(at(0.1), "send"), (at(first), "there")]
+
+    def test_later_event_sees_collision_with_spawned_object(self, tmp_path):
+        """A collision check after a spawn in the same check sees the new object."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "drop",
+                    "when": {"time": 0.2},
+                    "do": [spawn_box([1, 1, 0], radius=0.4)],
+                },
+                {
+                    "name": "hit",
+                    "when": {"collision": "robot_0"},
+                    "do": [spawn_box([8, 8, 0], name="b")],
+                },
+            ],
+            robots=[lidar_robot([1, 1, 0], [1, 1, 0])],
+        )
+        run(env, 3)
+        assert log_of(env) == [(at(0.2), "drop"), (at(0.2), "hit")]
+
+    def test_repeating_delayed_event_queues_every_firing(self, tmp_path):
+        """Each firing of a repeating delayed event runs its actions once, in order."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "q",
+                    "when": {"time": 0.1},
+                    "repeat": True,
+                    "cooldown": 2,
+                    "delay": 3,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 8)
+        assert times_of(env) == [at(0.4), at(0.6), at(0.8)]
+        assert [obj.name for obj in env.obstacle_list] == ["box_1", "box_2", "box_3"]
+
+    def test_later_event_sees_earlier_event_effects_in_same_check(self, tmp_path):
+        """An event listed after a spawn sees the spawned object in the same check."""
+        env = make(
+            tmp_path,
+            [
+                {"name": "drop", "when": {"time": 0.2}, "do": [spawn_box([2, 1, 0])]},
+                {
+                    "name": "near",
+                    "when": {
+                        "distance": {"objects": ["robot_0", "box_1"], "below": 2.0}
+                    },
+                    "do": [spawn_box([8, 8, 0], name="flag")],
+                },
+            ],
+        )
+        run(env, 4)
+        assert log_of(env) == [(at(0.2), "drop"), (at(0.2), "near")]
+
+    def test_earlier_event_does_not_see_later_event_effects(self, tmp_path):
+        """An event listed before a spawn only sees the object at the next check."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "near",
+                    "when": {
+                        "distance": {"objects": ["robot_0", "box_1"], "below": 2.0}
+                    },
+                    "do": [spawn_box([8, 8, 0], name="flag")],
+                },
+                {"name": "drop", "when": {"time": 0.2}, "do": [spawn_box([2, 1, 0])]},
+            ],
+        )
+        run(env, 4)
+        assert log_of(env) == [(at(0.2), "drop"), (at(0.3), "near")]
+
+    def test_events_not_checked_while_paused(self, tmp_path):
+        """Paused steps do not advance time or check events."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "name": "t",
+                    "when": {"time": 0.3},
+                    "repeat": True,
+                    "do": [spawn_box([5, 5, 0])],
+                }
+            ],
+        )
+        run(env, 2)
+        env.pause()
+        run(env, 5)
+        assert log_of(env) == []
+        env.resume()
+        run(env, 2)
+        assert times_of(env) == [at(0.3), at(0.4)]
+
+    def test_events_checked_in_external_step_mode(self, tmp_path):
+        """Events are checked after each external step too."""
+        env = make(
+            tmp_path,
+            [{"name": "t", "when": {"time": 0.2}, "do": [spawn_box([5, 5, 0])]}],
+            step_mode="external",
