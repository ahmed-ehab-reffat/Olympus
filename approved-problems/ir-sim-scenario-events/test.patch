+    def test_reset_removes_spawned_and_restores_deleted_in_place(self, tmp_path):
+        """After reset the objects, their ids and their order are as built."""
+        env = make(
+            tmp_path,
+            [
+                {
+                    "when": {"time": 0.2},
+                    "do": [
+                        {"delete": "robot_0"},
+                        spawn_box([5, 5, 0]),
+                        {"delete": "obstacle_2"},
+                    ],
+                }
+            ],
+            robots=[
+                robot_entry([1, 1, 0], [9, 1, 0]),
+                robot_entry([1, 3, 0], [9, 3, 0]),
+            ],
+            obstacles=[obstacle_entry([5, 8, 0]), obstacle_entry([6, 8, 0])],
+        )
+        built = scene(env)
+        run(env, 3)
+        assert [name for name, _ in scene(env)] == ["robot_1", "obstacle_3", "box_1"]
+        env.reset()
+        assert scene(env) == built
+        assert env.robot.name == "robot_0"
+        assert [r.name for r in env.robot_list] == ["robot_0", "robot_1"]
+
+    def test_restored_object_is_back_at_initial_state(self, tmp_path):
