+        run(env, 5)
+        assert env.get_object_by_name("robot_0") is None
+        env.reset()
+        robot = env.get_object_by_name("robot_0")
+        assert robot is not None
+        assert np.allclose(robot.state[:2, 0], [1, 1])
+        assert np.allclose(robot.goal[:2, 0], [9, 1])
+        run(env, 3)
+        assert robot.state[0, 0] > 1.0
