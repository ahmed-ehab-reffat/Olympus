+def test_length_across_the_seam_uses_the_short_arc():
+    """Test that length across the seam uses the short arc."""
+    lons = np.arange(0.0, 360.0, 2.5)
+    u = build(lambda t, lat, lon: 20.0, lons=lons)
+    v = build(lambda t, lat, lon: 0.0, lons=lons)
+    across = mpcalc.parcel_trajectory(u, v, (179.0, 40.0), HOUR, 3)
+    inside = mpcalc.parcel_trajectory(u, v, (10.0, 40.0), HOUR, 3)
+    assert positions(across)[0][-1] < 0.0
+    assert (mpcalc.trajectory_length(across).metpy.magnitude
+            == pytest.approx(mpcalc.trajectory_length(inside).metpy.magnitude))
