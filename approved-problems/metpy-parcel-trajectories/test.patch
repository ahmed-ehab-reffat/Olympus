+def test_a_crossing_on_the_seam_is_wrapped():
+    """Test that a crossing on the seam is wrapped."""
+    lons = np.arange(0.0, 360.0, 2.5)
+    u = build(lambda t, lat, lon: 20.0, lons=lons)
+    v = build(lambda t, lat, lon: 0.0, lons=lons)
+    traj = mpcalc.parcel_trajectory(u, v, (179.5, 40.0), HOUR, 2)
+    series = xr.DataArray(units.Quantity(np.array([[0.0, 1.0, 2.0]]), 'kelvin'),
+                          dims=('trajectory', 'step'))
+    crossings = mpcalc.trajectory_crossings(traj, series, 0.5)
+    longitude = positions(traj)[0]
+    span = (longitude[1] - longitude[0] + 180.0) % 360.0 - 180.0
+    expected = (longitude[0] + 0.5 * span + 180.0) % 360.0 - 180.0
+    assert longitude[0] > 0.0 and longitude[1] < 0.0
+    assert crossings['longitude'].metpy.magnitude[0, 0] == pytest.approx(expected)
+    assert -180.0 <= crossings['longitude'].metpy.magnitude[0, 0] < 180.0
