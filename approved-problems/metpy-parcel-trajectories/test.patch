+# Copyright (c) 2026 MetPy Developers.
+# Distributed under the terms of the BSD 3-Clause License.
+# SPDX-License-Identifier: BSD-3-Clause
+"""Test the parcel trajectory calculations."""
+from datetime import timedelta
+
+import numpy as np
+import pytest
+from scipy.integrate import solve_ivp
+import xarray as xr
+
+from metpy.constants import earth_avg_radius
+import metpy.calc as mpcalc
+import metpy.interpolate as mpinterp
+from metpy.units import units
+
+pytestmark = pytest.mark.filterwarnings('ignore::RuntimeWarning')
+
+RADIUS = earth_avg_radius.m_as('meter')
+LONS = np.arange(-20.0, 20.1, 2.0)
+LATS = np.arange(20.0, 60.1, 2.0)
+LEVELS = np.array([1000.0, 850.0, 700.0, 500.0])
+TIMES = np.array(['2024-03-01T00', '2024-03-01T12'], dtype='datetime64[ns]')
+HOUR = np.timedelta64(3600, 's')
+
+
+def build(func, *, lons=LONS, lats=LATS, times=TIMES, levels=None, unit='m/s',
+          level_units='hPa', level_name='isobaric'):
+    """Build a gridded field from a function of its coordinates."""
+    coords = {}
+    dims = []
+    axes = []
+    if times is not None:
+        coords['time'] = ('time', times)
+        dims.append('time')
+        axes.append(((times - times[0]) / np.timedelta64(1, 's')).astype(float))
+    if levels is not None:
+        coords[level_name] = (level_name, levels, {'units': level_units})
+        dims.append(level_name)
+        axes.append(levels)
+    coords['latitude'] = ('latitude', lats, {'units': 'degrees_north',
+                                             'standard_name': 'latitude'})
+    coords['longitude'] = ('longitude', lons, {'units': 'degrees_east',
+                                               'standard_name': 'longitude'})
+    dims.extend(('latitude', 'longitude'))
+    axes.extend((lats, lons))
+
+    mesh = np.meshgrid(*axes, indexing='ij')
+    values = np.broadcast_to(np.asarray(func(*mesh), dtype=np.float64),
+                             tuple(axis.size for axis in axes)).copy()
+    return xr.DataArray(values, dims=tuple(dims), coords=coords, attrs={'units': unit})
+
+
+def steady(func, **kwargs):
+    """Build a field with no time coordinate."""
+    return build(func, times=None, **kwargs)
+
+
+def uniform(u_value, v_value, **kwargs):
+    """Build a pair of wind components with constant values."""
+    return (build(lambda *mesh: u_value, **kwargs), build(lambda *mesh: v_value, **kwargs))
+
+
+def projected_grid(spacing=100000.0, size=21):
+    """Build wind components on a Lambert conformal grid."""
+    from pyproj import CRS, Proj
+    crs = CRS.from_cf({'grid_mapping_name': 'lambert_conformal_conic',
+                       'standard_parallel': (30.0, 50.0),
+                       'longitude_of_central_meridian': 0.0,
+                       'latitude_of_projection_origin': 40.0,
+                       'earth_radius': RADIUS})
+    origin = Proj(crs)(0.0, 40.0)
+    axes = [origin[index] + (np.arange(size) - size // 2) * spacing for index in (0, 1)]
+    coords = {'time': ('time', TIMES),
+              'y': ('y', axes[1], {'units': 'meter',
+                                   'standard_name': 'projection_y_coordinate'}),
+              'x': ('x', axes[0], {'units': 'meter',
+                                   'standard_name': 'projection_x_coordinate'})}
+    shape = (TIMES.size, size, size)
+    made = [xr.DataArray(np.full(shape, value), dims=('time', 'y', 'x'), coords=coords,
+                         attrs={'units': 'm/s'}).metpy.assign_crs(crs.to_cf())
+            for value in (10.0, 0.0)]
+    return made
+
+
+def zonal_degrees(speed, seconds, latitude):
+    """Return the change in longitude for an eastward wind."""
+    return np.degrees(speed * seconds / (RADIUS * np.cos(np.radians(latitude))))
+
+
+def meridional_degrees(speed, seconds):
+    """Return the change in latitude for a northward wind."""
+    return np.degrees(speed * seconds / RADIUS)
+
+
+def positions(trajectory, index=0):
+    """Return the longitude and latitude of one trajectory."""
+    return (trajectory['longitude'].metpy.magnitude[index],
+            trajectory['latitude'].metpy.magnitude[index])
+
+
+def reference_path(u_func, v_func, start, seconds, count):
+    """Integrate the same system with an adaptive solver."""
+    def rhs(time, state):
+        longitude, latitude = state
+        return [np.degrees(u_func(time, longitude, latitude)
+                           / (RADIUS * np.cos(np.radians(latitude)))),
+                np.degrees(v_func(time, longitude, latitude) / RADIUS)]
+
+    span = np.arange(count + 1) * seconds
+    answer = solve_ivp(rhs, (0.0, span[-1]), list(start), t_eval=span, rtol=1e-12,
+                       atol=1e-12, method='DOP853')
+    return answer.y[0], answer.y[1]
+
+
+def expect_error(call):
+    """Check that a call is rejected."""
+    with pytest.raises(ValueError):
+        call()
+
+
+def test_result_has_trajectory_and_step_dimensions():
+    """Test that result has trajectory and step dimensions."""
+    u, v = uniform(10.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 4)
+    assert traj.sizes == {'trajectory': 1, 'step': 5}
+
+
+def test_start_point_order_is_preserved():
+    """Test that start point order is preserved."""
+    u, v = uniform(10.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, [(1.0, 30.0), (-3.0, 50.0)], HOUR, 2)
+    assert traj['longitude'].metpy.magnitude[:, 0] == pytest.approx([1.0, -3.0])
+    assert traj['latitude'].metpy.magnitude[:, 0] == pytest.approx([30.0, 50.0])
+
+
+def test_step_coordinate_counts_from_zero():
+    """Test that step coordinate counts from zero."""
+    u, v = uniform(5.0, 5.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 3)
+    assert traj['step'].values.tolist() == [0, 1, 2, 3]
+
+
+def test_times_advance_by_the_step():
+    """Test that times advance by the step."""
+    u, v = uniform(5.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 2)
+    assert (traj['time'].values == np.array(['2024-03-01T00', '2024-03-01T01',
+                                            '2024-03-01T02'],
+                                            dtype='datetime64[ns]')).all()
+
+
+def test_backward_run_starts_at_the_last_field_time():
+    """Test that backward run starts at the last field time."""
+    u, v = uniform(5.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), -HOUR, 2)
+    assert traj['time'].values[0] == np.datetime64('2024-03-01T12')
+    assert traj['time'].values[-1] == np.datetime64('2024-03-01T10')
+
+
+def test_given_start_time_is_used():
+    """Test that given start time is used."""
+    u, v = uniform(5.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 1,
+                                    start_time=np.datetime64('2024-03-01T05'))
+    assert traj['time'].values[0] == np.datetime64('2024-03-01T05')
+
+
+def test_first_sample_is_the_start_point():
+    """Test that first sample is the start point."""
+    u, v = uniform(-7.5, 3.0)
+    traj = mpcalc.parcel_trajectory(u, v, (2.5, 33.0), HOUR, 3)
+    longitude, latitude = positions(traj)
+    assert longitude[0] == pytest.approx(2.5)
+    assert latitude[0] == pytest.approx(33.0)
+
+
+def test_positions_carry_degree_units():
+    """Test that positions carry degree units."""
+    u, v = uniform(5.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 1)
+    assert traj['longitude'].metpy.units == units('degrees_east')
+    assert traj['latitude'].metpy.units == units('degrees_north')
+
+
+def test_two_dimensional_field_has_no_vertical_variable():
+    """Test that two dimensional field has no vertical variable."""
+    u, v = uniform(5.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 1)
+    assert 'vertical' not in traj
+
+
+def test_layered_field_reports_the_vertical():
+    """Test that layered field reports the vertical."""
+    u, v = uniform(5.0, 0.0, levels=LEVELS)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0, 900.0), HOUR, 1)
+    assert traj['vertical'].metpy.units == units('hPa')
+
+
+def test_zonal_step_uses_the_cosine_of_latitude():
+    """Test that zonal step uses the cosine of latitude."""
+    u, v = uniform(10.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 50.0), HOUR, 3)
+    longitude, latitude = positions(traj)
+    assert longitude == pytest.approx(zonal_degrees(10.0, 3600.0, 50.0) * np.arange(4))
+    assert latitude == pytest.approx(np.full(4, 50.0))
+
+
+def test_zonal_step_at_the_equator_needs_no_cosine():
+    """Test that zonal step at the equator needs no cosine."""
+    u, v = uniform(10.0, 0.0, lats=np.arange(-10.0, 10.1, 2.0))
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 0.0), HOUR, 2)
+    longitude, _ = positions(traj)
+    assert longitude == pytest.approx(meridional_degrees(10.0, 3600.0) * np.arange(3))
+
+
+def test_meridional_step_matches_the_sphere():
+    """Test that meridional step matches the sphere."""
+    u, v = uniform(0.0, 8.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 3)
+    _, latitude = positions(traj)
+    assert latitude == pytest.approx(40.0 + meridional_degrees(8.0, 3600.0) * np.arange(4))
+
+
+def test_zonal_rate_follows_the_latitude_within_a_step():
+    """Test that zonal rate follows the latitude within a step."""
+    u, v = uniform(20.0, 20.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(6, 'h'), 2)
+    longitude, latitude = positions(traj)
+    frozen = zonal_degrees(20.0, 6 * 3600.0, 40.0)
+    assert longitude[1] != pytest.approx(frozen, abs=1e-6)
+    assert latitude[1] == pytest.approx(40.0 + meridional_degrees(20.0, 6 * 3600.0))
+
+
+def test_path_matches_an_independent_integration():
+    """Test that path matches an independent integration."""
+    def u_func(time, longitude, latitude):
+        return 8.0 + 0.05 * longitude + 0.03 * latitude + 0.001 * longitude * latitude
+
+    def v_func(time, longitude, latitude):
+        return -3.0 + 0.02 * longitude - 0.04 * latitude + 0.0005 * longitude * latitude
+
+    u = build(lambda t, lat, lon: u_func(t, lon, lat))
+    v = build(lambda t, lat, lon: v_func(t, lon, lat))
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(600, 's'), 24)
+    longitude, latitude = positions(traj)
+    want_lon, want_lat = reference_path(u_func, v_func, (0.0, 40.0), 600.0, 24)
+    assert longitude == pytest.approx(want_lon, abs=1e-8)
+    assert latitude == pytest.approx(want_lat, abs=1e-8)
+
+
+def test_backward_path_matches_an_independent_integration():
+    """Test that backward path matches an independent integration."""
+    def u_func(time, longitude, latitude):
+        return 6.0 + 0.04 * longitude * latitude
+
+    def v_func(time, longitude, latitude):
+        return 4.0 - 0.03 * latitude
+
+    u = build(lambda t, lat, lon: u_func(t, lon, lat))
+    v = build(lambda t, lat, lon: v_func(t, lon, lat))
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(-600, 's'), 24,
+                                    start_time=TIMES[1])
+    longitude, latitude = positions(traj)
+    want_lon, want_lat = reference_path(u_func, v_func, (0.0, 40.0), -600.0, 24)
+    assert longitude == pytest.approx(want_lon, abs=1e-8)
+    assert latitude == pytest.approx(want_lat, abs=1e-8)
+
+
+def test_time_varying_wind_is_sampled_within_the_step():
+    """Test that time varying wind is sampled within the step."""
+    span = (TIMES[1] - TIMES[0]) / np.timedelta64(1, 's')
+    u = build(lambda t, lat, lon: 10.0 * t / span)
+    v = build(lambda t, lat, lon: 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(3, 'h'), 1)
+    longitude, _ = positions(traj)
+    seconds = 3 * 3600.0
+    mean_speed = 10.0 * (seconds / 2.0) / span
+    assert longitude[1] == pytest.approx(zonal_degrees(mean_speed, seconds, 40.0))
+
+
+def test_wind_curving_in_time_follows_the_stored_times():
+    """Test that wind curving in time follows the stored times."""
+    span = (TIMES[1] - TIMES[0]) / np.timedelta64(1, 's')
+    stamps = np.arange('2024-03-01T00', '2024-03-01T13', np.timedelta64(1, 'h'),
+                       dtype='datetime64[ns]')
+    u = build(lambda t, lat, lon: 12.0 * (t / span) ** 2, times=stamps)
+    v = build(lambda t, lat, lon: 0.0, times=stamps)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(1, 'h'), 1)
+    longitude, _ = positions(traj)
+    seconds = 3600.0
+    average = 0.5 * 12.0 * (seconds / span) ** 2
+    assert longitude[1] == pytest.approx(zonal_degrees(average, seconds, 40.0), rel=1e-9)
+
+
+def test_longer_run_extends_the_same_path():
+    """Test that longer run extends the same path."""
+    u, v = uniform(9.0, 4.0)
+    short = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 2)
+    long_run = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 5)
+    assert positions(long_run)[0][:3] == pytest.approx(positions(short)[0])
+
+
+def test_backward_run_returns_to_the_start():
+    """Test that backward run returns to the start."""
+    u, v = uniform(12.0, -6.0)
+    forward = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(600, 's'), 12)
+    ending = (forward['longitude'].metpy.magnitude[0, -1],
+              forward['latitude'].metpy.magnitude[0, -1])
+    back = mpcalc.parcel_trajectory(u, v, ending, np.timedelta64(-600, 's'), 12,
+                                    start_time=forward['time'].values[-1])
+    longitude, latitude = positions(back)
+    assert longitude[-1] == pytest.approx(0.0, abs=1e-9)
+    assert latitude[-1] == pytest.approx(40.0, abs=1e-9)
+
+
+def test_wind_is_interpolated_between_grid_points():
+    """Test that wind is interpolated between grid points."""
+    u = steady(lambda lat, lon: 4.0 + lon)
+    v = steady(lambda lat, lon: 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (1.0, 40.0), np.timedelta64(1, 's'), 1,
+                                    start_time=TIMES[0])
+    longitude, _ = positions(traj)
+    assert longitude[1] == pytest.approx(1.0 + zonal_degrees(5.0, 1.0, 40.0), rel=1e-9)
+
+
+def test_speed_between_levels_is_interpolated_in_log_pressure():
+    """Test that speed between levels is interpolated in log pressure."""
+    u = build(lambda t, level, lat, lon: np.log(level), levels=LEVELS)
+    v = build(lambda t, level, lat, lon: 0.0, levels=LEVELS)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0, 900.0), np.timedelta64(1, 's'), 1)
+    longitude, _ = positions(traj)
+    assert longitude[1] == pytest.approx(zonal_degrees(np.log(900.0), 1.0, 40.0), rel=1e-9)
+
+
+def test_height_coordinate_is_interpolated_linearly():
+    """Test that height coordinate is interpolated linearly."""
+    heights = np.array([0.0, 1000.0, 2000.0, 3000.0])
+    u = build(lambda t, level, lat, lon: level / 100.0, levels=heights, level_units='meter',
+              level_name='height')
+    v = build(lambda t, level, lat, lon: 0.0, levels=heights, level_units='meter',
+              level_name='height')
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0, 1500.0), np.timedelta64(1, 's'), 1)
+    longitude, _ = positions(traj)
+    assert longitude[1] == pytest.approx(zonal_degrees(15.0, 1.0, 40.0), rel=1e-9)
+
+
+def test_descending_latitude_grid_gives_the_same_path():
+    """Test that descending latitude grid gives the same path."""
+    def wind(t, lat, lon):
+        return 5.0 + 0.1 * lat
+
+    rising = build(wind)
+    falling = build(wind, lats=LATS[::-1])
+    zero = build(lambda t, lat, lon: 0.0)
+    up = mpcalc.parcel_trajectory(rising, zero, (0.0, 41.0), HOUR, 3)
+    down = mpcalc.parcel_trajectory(falling, build(lambda t, lat, lon: 0.0, lats=LATS[::-1]),
+                                    (0.0, 41.0), HOUR, 3)
+    assert positions(down)[0] == pytest.approx(positions(up)[0])
+
+
+def test_descending_pressure_grid_gives_the_same_path():
+    """Test that descending pressure grid gives the same path."""
+    def wind(t, level, lat, lon):
+        return np.log(level)
+
+    rising = build(wind, levels=LEVELS[::-1])
+    falling = build(wind, levels=LEVELS)
+    zero_up = build(lambda t, level, lat, lon: 0.0, levels=LEVELS[::-1])
+    zero_down = build(lambda t, level, lat, lon: 0.0, levels=LEVELS)
+    up = mpcalc.parcel_trajectory(rising, zero_up, (0.0, 40.0, 900.0), HOUR, 2)
+    down = mpcalc.parcel_trajectory(falling, zero_down, (0.0, 40.0, 900.0), HOUR, 2)
+    assert positions(down)[0] == pytest.approx(positions(up)[0])
+
+
+def test_field_is_interpolated_between_times():
+    """Test that field is interpolated between times."""
+    stamps = np.array(['2024-03-01T00', '2024-03-01T02'], dtype='datetime64[ns]')
+    u = build(lambda t, lat, lon: np.where(t > 0.0, 20.0, 0.0), times=stamps)
+    v = build(lambda t, lat, lon: 0.0, times=stamps)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(1, 's'), 1)
+    longitude, _ = positions(traj)
+    assert longitude[1] == pytest.approx(zonal_degrees(20.0 / 7200.0 * 0.5, 1.0, 40.0),
+                                         rel=1e-6)
+
+
+def test_leaving_the_grid_gives_missing_values():
+    """Test that leaving the grid gives missing values."""
+    u, v = uniform(20.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (16.0, 40.0), np.timedelta64(2, 'h'), 4)
+    longitude, _ = positions(traj)
+    assert np.isfinite(longitude[:3]).all()
+    assert np.isnan(longitude[3:]).all()
+
+
+def test_samples_before_leaving_are_kept():
+    """Test that samples before leaving are kept."""
+    u, v = uniform(20.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (16.0, 40.0), np.timedelta64(2, 'h'), 4)
+    longitude, _ = positions(traj)
+    assert longitude[1] == pytest.approx(16.0 + zonal_degrees(20.0, 7200.0, 40.0))
+
+
+def test_only_the_parcel_that_leaves_terminates():
+    """Test that only the parcel that leaves terminates."""
+    u, v = uniform(20.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, [(16.0, 40.0), (0.0, 40.0)],
+                                    np.timedelta64(2, 'h'), 4)
+    assert np.isnan(traj['longitude'].metpy.magnitude[0]).any()
+    assert np.isfinite(traj['longitude'].metpy.magnitude[1]).all()
+
+
+def test_running_past_the_last_field_time_terminates():
+    """Test that running past the last field time terminates."""
+    u, v = uniform(5.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), np.timedelta64(5, 'h'), 4)
