+def test_nearest_sampling_stops_at_the_edge_of_a_narrower_field():
+    """Test that nearest sampling stops at the edge of a narrower field."""
+    u, v = uniform(10.0, 0.0)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0), HOUR, 3)
+    narrow = build(lambda t, lat, lon: lon, lons=np.arange(-20.0, 0.1, 2.0), unit='degC')
+    along = mpcalc.sample_trajectory(traj, narrow, method='nearest').metpy.magnitude[0]
+    assert np.isfinite(positions(traj)[0]).all()
+    assert along[0] == pytest.approx(0.0)
+    assert np.isnan(along[1:]).all()
