+def test_conserved_surface_is_solved_at_each_stage_time():
+    """Test that a conserved surface is solved at each stage time."""
+    span = (TIMES[1] - TIMES[0]) / np.timedelta64(1, 's')
+    ratio = np.log(0.85)
+    theta = build(lambda t, level, lat, lon: 300.0 + 15.0 * np.log(level / 1000.0) / ratio
+                  + 3.0 * t / span, levels=LEVELS, unit='kelvin')
+    u = build(lambda t, level, lat, lon: 20.0 - 0.01 * level, levels=LEVELS)
+    v = build(lambda t, level, lat, lon: 0.0, levels=LEVELS)
+    seconds = 1800.0
+    count = 12
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0, 900.0), np.timedelta64(1800, 's'),
+                                    count, surface=theta)
+
+    start_fraction = np.log(0.9) / ratio
+
+    def fraction_at(time):
+        return start_fraction - 0.2 * time / span
+
+    def rhs(time, state):
+        speed = 10.0 + 1.5 * fraction_at(time)
+        return [np.degrees(speed / (RADIUS * np.cos(np.radians(40.0))))]
+
+    stamps = np.arange(count + 1) * seconds
+    answer = solve_ivp(rhs, (0.0, stamps[-1]), [0.0], t_eval=stamps, rtol=1e-12, atol=1e-12,
+                       method='DOP853')
+    assert positions(traj)[0] == pytest.approx(answer.y[0], abs=1e-9)
+    assert traj['vertical'].metpy.magnitude[0] == pytest.approx(
+        1000.0 * np.exp(fraction_at(stamps) * ratio), rel=1e-9)
