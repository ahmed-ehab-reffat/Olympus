+def test_projected_path_through_a_varying_wind_matches_an_independent_integration():
+    """Test that a projected path through a varying wind matches an independent integration."""
+    from pyproj import Proj
+    template, zero = projected_grid()
+    projection = Proj(template.metpy.pyproj_crs)
+    origin = projection(0.0, 40.0)[0]
+    shaped = template.copy()
+    shaped.data = np.broadcast_to(
+        10.0 + (template['x'].values[None, None, :] - origin) / 1e5, template.shape).copy()
+
+    seconds = 300.0
+    count = 12
+    traj = mpcalc.parcel_trajectory(shaped, zero, (0.0, 40.0),
+                                    np.timedelta64(int(seconds), 's'), count)
+
+    def rhs(time, state):
+        speed = 10.0 + (projection(state[0], 40.0)[0] - origin) / 1e5
+        return [np.degrees(speed / (RADIUS * np.cos(np.radians(40.0))))]
+
+    span = np.arange(count + 1) * seconds
+    answer = solve_ivp(rhs, (0.0, span[-1]), [0.0], t_eval=span, rtol=1e-12, atol=1e-12,
+                       method='DOP853')
+    assert positions(traj)[0] == pytest.approx(answer.y[0], abs=1e-8)
+    assert positions(traj)[1] == pytest.approx(np.full(count + 1, 40.0))
