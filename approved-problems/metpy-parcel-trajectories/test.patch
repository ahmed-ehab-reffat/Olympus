+def test_conserved_parcel_reads_the_wind_at_each_stage():
+    """Test that conserved parcel reads the wind at each stage."""
+    theta = build(lambda t, level, lat, lon: 300.0 + 15.0 * np.log(level / 1000.0)
+                  / np.log(0.85) + lon, levels=LEVELS, unit='kelvin')
+    u = build(lambda t, level, lat, lon: 20.0 - 0.01 * level, levels=LEVELS)
+    v = build(lambda t, level, lat, lon: 0.0, levels=LEVELS)
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0, 900.0), np.timedelta64(30, 'm'), 12,
+                                    surface=theta)
+
+    ratio = np.log(0.85)
+    start_fraction = np.log(0.9) / ratio
+
+    def speed(longitude):
+        fraction = start_fraction - longitude / 15.0
+        return 10.0 + 1.5 * fraction
+
+    def rhs(time, state):
+        return [np.degrees(speed(state[0]) / (RADIUS * np.cos(np.radians(40.0))))]
+
+    span = np.arange(13) * 1800.0
+    answer = solve_ivp(rhs, (0.0, span[-1]), [0.0], t_eval=span, rtol=1e-12, atol=1e-12,
+                       method='DOP853')
+    assert positions(traj)[0] == pytest.approx(answer.y[0], abs=1e-9)
