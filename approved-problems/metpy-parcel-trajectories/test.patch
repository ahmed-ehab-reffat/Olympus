+    """Test that a crossing level may use another pressure unit."""
+    u = build(lambda t, level, lat, lon: 0.0, levels=LEVELS)
+    v = build(lambda t, level, lat, lon: 0.0, levels=LEVELS)
+    w = build(lambda t, level, lat, lon: 0.5, levels=LEVELS, unit='Pa/s')
+    traj = mpcalc.parcel_trajectory(u, v, (0.0, 40.0, 800.0), HOUR, 2, w=w)
+    in_pascals = mpcalc.trajectory_crossings(traj, traj['vertical'],
+                                             units.Quantity(80900.0, 'Pa'))
+    in_hectopascals = mpcalc.trajectory_crossings(traj, traj['vertical'],
+                                                  units.Quantity(809.0, 'hPa'))
+    assert in_pascals['time'].values[0, 0] == np.datetime64('2024-03-01T00:30:00')
+    assert (in_pascals['time'].values == in_hectopascals['time'].values).all()
