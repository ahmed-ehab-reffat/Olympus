@@ -0,0 +1,293 @@
+# Copyright (c) 2026 MetPy Developers.
+# Distributed under the terms of the BSD 3-Clause License.
+# SPDX-License-Identifier: BSD-3-Clause
+"""Interpolate gridded fields onto a track of points in space and time."""
+import itertools
+
+import numpy as np
+import xarray as xr
+
+from ..package_tools import Exporter
+from ..units import units
+from ..xarray import check_axis
+
+exporter = Exporter(globals())
+
+_TOL = 1e-9
+
+
+def _coordinate_values(coord):
+    """Return the magnitude of a coordinate in its own units as a float array."""
+    return np.asarray(coord.metpy.unit_array.magnitude, dtype=np.float64)
+
+
+def _is_pressure(coord):
+    """Check whether a coordinate is a pressure."""
+    return coord.metpy.units.dimensionality == units('Pa').dimensionality
+
+
+def _spans_the_globe(lons):
+    """Check whether a longitude coordinate covers the whole globe."""
+    if lons.size < 2:
+        return False
+    spacing = lons[1] - lons[0]
+    return abs(abs(lons[-1] - lons[0] + spacing) - 360.0) < 1e-6
+
+
+def _axis_weights(coord, values, *, log=False):
+    """Locate values within a monotonic coordinate.
+
+    Returns the index of the lower bracketing point, the weight of the upper point, and a
+    mask of the values that fall outside the coordinate.
+    """
+    values = np.asarray(values, dtype=np.float64)
+    size = coord.size
+    if size < 2:
+        inside = np.isclose(values, coord[0], atol=_TOL, rtol=0.0)
+        return np.zeros(values.shape, dtype=int), np.zeros(values.shape), ~inside
+
+    if log:
+        coord = np.log(coord)
+        with np.errstate(invalid='ignore', divide='ignore'):
+            values = np.log(np.where(values > 0.0, values, np.nan))
+
+    ascending = coord[-1] > coord[0]
+    ordered = coord if ascending else coord[::-1]
+
+    with np.errstate(invalid='ignore'):
+        outside = ~((values >= ordered[0] - _TOL) & (values <= ordered[-1] + _TOL))
+    filled = np.where(np.isfinite(values), values, ordered[0])
+
+    index = np.clip(np.searchsorted(ordered, filled, side='right') - 1, 0, size - 2)
+    lower = ordered[index]
+    weight = (filled - lower) / (ordered[index + 1] - lower)
+
+    if not ascending:
+        index = size - 2 - index
+        weight = 1.0 - weight
+
+    return index, np.clip(weight, 0.0, 1.0), outside
+
+
+def _horizontal_grid(field):
+    """Return the mapping onto a field's horizontal grid along with that grid.
+
+    The returned callable takes longitude and latitude in degrees and gives back the
+    coordinates the field itself is indexed by. A longitude coordinate that covers the
+    globe is extended by one column so that the seam is crossed by interpolation.
+    """
+    geographic = (check_axis(field.metpy.x, 'longitude')
+                  and check_axis(field.metpy.y, 'latitude'))
+    x_values = _coordinate_values(field[field.metpy.find_axis_name('x')])
+    y_values = _coordinate_values(field[field.metpy.find_axis_name('y')])
+
+    periodic = geographic and _spans_the_globe(x_values)
+    if periodic:
+        x_values = np.append(x_values, 2.0 * x_values[-1] - x_values[-2])
+
+    if geographic:
+        start = min(x_values[0], x_values[-1])
+
+        def to_grid(lon, lat):
+            with np.errstate(invalid='ignore'):
+                return start + np.mod(lon - start, 360.0), lat
+    else:
+        from pyproj import Proj
+        proj = Proj(field.metpy.pyproj_crs)
+        scale = units.Quantity(1.0, field.metpy.x.metpy.units).m_as('meter')
+
+        def to_grid(lon, lat):
+            valid = np.isfinite(lon) & np.isfinite(lat)
+            x = np.full(np.shape(lon), np.nan)
+            y = np.full(np.shape(lat), np.nan)
+            if valid.any():
+                proj_x, proj_y = proj(np.asarray(lon)[valid], np.asarray(lat)[valid])
+                x[valid] = np.asarray(proj_x) / scale
+                y[valid] = np.asarray(proj_y) / scale
+            return x, y
+
+    return to_grid, x_values, y_values, periodic
+
+
+def _nearest_index(coord, values):
+    """Return the index of the closest coordinate point, and a mask of the values outside."""
+    order = np.argsort(coord)
+    ordered = coord[order]
+    with np.errstate(invalid='ignore'):
+        outside = ~((values >= ordered[0] - _TOL) & (values <= ordered[-1] + _TOL))
+    filled = np.where(np.isfinite(values), values, ordered[0])
+    upper = np.clip(np.searchsorted(ordered, filled), 1, ordered.size - 1)
+    closer = np.abs(filled - ordered[upper - 1]) <= np.abs(ordered[upper] - filled)
+    return order[np.where(closer, upper - 1, upper)], outside
+
+
+class _FieldSampler:
+    """Sample a gridded field at arbitrary times and positions.
+
+    The field is transposed into time, vertical, y, x order, keeping only the dimensions it
+    actually has, so that every sample is a multilinear interpolation over the axes present.
+    """
+
+    def __init__(self, field, reference_time, target_units=None, method='linear'):
+        self.reference_time = reference_time
+        self.method = method
+        self.horizontal, x_values, y_values, periodic = _horizontal_grid(field)
+
+        self.axes = []
+        dims = []
+
+        time = field.metpy.find_axis_name('time') if _has_axis(field, 'time') else None
+        if time is not None:
+            dims.append(time)
+            offsets = (field[time].values - reference_time) / np.timedelta64(1, 's')
+            self.axes.append(('time', np.asarray(offsets, dtype=np.float64), False))
+
+        vertical = field.metpy.find_axis_name('vertical') if _has_axis(field, 'vertical') \
+            else None
+        self.levels = None
+        self.log_vertical = False
+        if vertical is not None:
+            dims.append(vertical)
+            self.levels = _coordinate_values(field[vertical])
+            self.log_vertical = _is_pressure(field[vertical])
+            self.axes.append(('vertical', self.levels, self.log_vertical))
+
+        dims.extend((field.metpy.find_axis_name('y'), field.metpy.find_axis_name('x')))
+        self.axes.append(('y', y_values, False))
+        self.axes.append(('x', x_values, False))
+
+        ordered = field.transpose(*dims)
+        data = ordered.metpy.unit_array
+        if target_units is not None:
+            data = data.to(target_units)
+        self.units = data.units
+        values = np.asarray(data.magnitude, dtype=np.float64)
+        self.values = (np.concatenate([values, values[..., :1]], axis=-1) if periodic
+                       else values)
+
+    def __call__(self, time, lon, lat, vertical=None):
+        """Interpolate the field at the given times and positions."""
+        grid_x, grid_y = self.horizontal(lon, lat)
+        requested = {'time': time, 'vertical': vertical, 'y': grid_y, 'x': grid_x}
+
+        indices = []
+        weights = []
+        outside = np.zeros(np.shape(grid_x), dtype=bool)
+        for name, coord, log in self.axes:
+            values = requested[name]
+            if values is None:
+                values = np.full(np.shape(grid_x), np.nan)
+            index, weight, missing = _axis_weights(coord, np.broadcast_to(
+                np.asarray(values, dtype=np.float64), np.shape(grid_x)), log=log)
+            if self.method == 'nearest':
+                weight = np.round(weight)
+            indices.append(index)
+            weights.append(weight)
+            outside |= missing
+
+        total = np.zeros(np.shape(grid_x))
+        for corner in itertools.product((0, 1), repeat=len(self.axes)):
+            share = np.ones(np.shape(grid_x))
+            for offset, weight in zip(corner, weights, strict=True):
+                share = share * (weight if offset else 1.0 - weight)
+            total = total + share * self.values[tuple(index + offset for index, offset
+                                                      in zip(indices, corner, strict=True))]
+
+        return np.where(outside, np.nan, total)
+
+
+def _has_axis(field, axis):
+    """Check whether a field is laid out along the requested MetPy axis type."""
+    try:
+        return field.metpy.find_axis_name(axis) in field.dims
+    except (AttributeError, KeyError, ValueError):
+        return False
+
+
+def _check_method(method):
+    """Check that an interpolation method is one of the supported ones."""
+    if method not in ('linear', 'nearest'):
+        raise ValueError("method must be either 'linear' or 'nearest'")
+
+
+def _track_values(field, longitude, latitude, time, vertical, method):
+    """Interpolate one field onto a track of points."""
+    if _has_axis(field, 'time') and time is None:
+        raise ValueError('a field with a time coordinate needs times along the track')
+    if _has_axis(field, 'vertical') and vertical is None:
+        raise ValueError('a field with a vertical coordinate needs levels along the track')
+
+    stamps = np.asarray(time) if time is not None else None
+    reference = stamps.min() if stamps is not None else None
+    sampler = _FieldSampler(field, reference, method=method)
+
+    offsets = (((stamps - reference) / np.timedelta64(1, 's')).astype(float)
+               if stamps is not None else None)
+    return sampler(offsets, np.asarray(longitude, dtype=np.float64),
+                   np.asarray(latitude, dtype=np.float64),
+                   None if vertical is None else np.asarray(vertical, dtype=np.float64)
+                   ), sampler.units
+
+
+@exporter.export
+def interpolate_to_track(data, longitude, latitude, *, time=None, vertical=None,
+                         method='linear'):
+    r"""Interpolate gridded data onto a track of points in space and time.
+
+    The track is followed point by point: the horizontal position is located on the grid of
+    `data`, converting longitude and latitude into the grid's own coordinates through its
+    projection, and time and the vertical coordinate are followed as well when the data has
+    them. A longitude coordinate that covers the globe is treated as continuous across the
+    seam, an isobaric coordinate is interpolated in the logarithm of pressure, and a point
+    outside the data gives NaN rather than an extrapolation.
+
+    Parameters
+    ----------
+    data : `xarray.DataArray` or `xarray.Dataset`
+        The field or fields to interpolate, parsed by MetPy. A Dataset is interpolated
+        variable by variable.
+    longitude, latitude : array-like
+        The track, in degrees east and degrees north, of the same shape as each other and as
+        any times and levels given. A track of more than one dimension is flattened.
+    time : array-like, optional
+        The time of each point of the track, needed when the data has a time coordinate.
+    vertical : array-like, optional
+        The vertical coordinate of each point of the track, in the units the data uses,
+        needed when the data has a vertical coordinate.
+    method : str, optional
+        Either ``'linear'``, the default, for a multilinear interpolation over every
+        coordinate, or ``'nearest'`` to take the value of the closest grid point.
+
+    Returns
+    -------
+    `xarray.DataArray` or `xarray.Dataset`
+        The data along the track, with the single dimension ``track``.
+
+    See Also
+    --------
+    metpy.calc.parcel_trajectory, interpolate_to_slice
+
+    """
+    _check_method(method)
+
+    longitude = np.atleast_1d(np.asarray(longitude, dtype=np.float64))
+    latitude = np.atleast_1d(np.asarray(latitude, dtype=np.float64))
+    along_track = [np.atleast_1d(np.asarray(along)) for along in (time, vertical)
+                   if along is not None]
+    for other in (latitude, *along_track):
+        if other.shape != longitude.shape:
+            raise ValueError('every quantity along the track must have the same shape')
+
+    longitude, latitude = longitude.ravel(), latitude.ravel()
+    time, vertical = (None if along is None else np.asarray(along).ravel()
+                      for along in (time, vertical))
+
+    if isinstance(data, xr.Dataset):
+        return xr.Dataset({name: interpolate_to_track(data[name], longitude, latitude,
+                                                      time=time, vertical=vertical,
+                                                      method=method)
+                           for name in data.data_vars})
+
+    values, found_units = _track_values(data, longitude, latitude, time, vertical, method)
+    return xr.DataArray(units.Quantity(values, found_units), dims=('track',),
+                        coords={'track': np.arange(longitude.size)})
