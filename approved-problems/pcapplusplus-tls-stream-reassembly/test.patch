+	void missingDataRecovery()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		feedIPv4(reassembly, {}, 8000, "203.0.113.10", "203.0.113.20", 443, 54000, true);
+		feedIPv4(reassembly, {}, 9000, "203.0.113.20", "203.0.113.10", 54000, 443, true);
+		Bytes unaffectedHandshake = makeHandshake(2, { 7, 8, 9, 10 });
+		Bytes unaffectedFirst = makeRecord(
+		    22, Bytes(unaffectedHandshake.begin(), unaffectedHandshake.begin() + 3));
+		Bytes unaffectedSecond = makeRecord(
+		    22, Bytes(unaffectedHandshake.begin() + 3, unaffectedHandshake.end()));
+		feedIPv4(reassembly, unaffectedFirst, 9001, "203.0.113.20", "203.0.113.10", 54000, 443);
+
+		Bytes partialHandshake = makeRecord(22, { 1, 0, 0 });
+		feedIPv4(reassembly, partialHandshake, 8001, "203.0.113.10", "203.0.113.20", 443, 54000);
+		Bytes partialRecord = { 23, 3, 3, 0, 6 };
+		feedIPv4(reassembly, partialRecord, 8001 + partialHandshake.size(), "203.0.113.10", "203.0.113.20", 443,
+		         54000);
+		Bytes recovered = makeRecord(23, { 0x71, 0x72 });
+		uint32_t recoveredSequence = 8001 + static_cast<uint32_t>(partialHandshake.size() + partialRecord.size()) + 4;
+		feedIPv4(reassembly, recovered, recoveredSequence, "203.0.113.10", "203.0.113.20", 443, 54000);
+		Bytes crossGapContinuation = makeRecord(22, { 2, 0xc1, 0xc2 });
+		feedIPv4(reassembly, crossGapContinuation,
+		         recoveredSequence + static_cast<uint32_t>(recovered.size()), "203.0.113.10", "203.0.113.20",
+		         443, 54000);
+		require(collector.records.size() == 2 && collector.records[0].bytes == unaffectedFirst &&
+		            collector.records[1].bytes == partialHandshake,
+		        "out-of-order bytes emitted before loss was declared");
+
+		Bytes reverseTrigger = makeRecord(21, { 1, 0 });
+		feedIPv4(reassembly, reverseTrigger, 9001 + static_cast<uint32_t>(unaffectedFirst.size()),
+		         "203.0.113.20", "203.0.113.10", 54000, 443);
+		feedIPv4(reassembly, unaffectedSecond,
+		         9001 + static_cast<uint32_t>(unaffectedFirst.size() + reverseTrigger.size()),
+		         "203.0.113.20", "203.0.113.10", 54000, 443);
+		auto loss = std::find_if(collector.events.begin(), collector.events.end(), [](const EventResult& event) {
+			return event.type == pcpp::TlsReassemblyEvent::TcpDataMissing;
+		});
+		require(loss != collector.events.end(), "TCP loss was not surfaced");
+		require(loss->side == 0 && loss->missingBytes == 4 && loss->discardedBytes == 8,
+		        "loss event has the wrong side, missing count, or discarded count");
+		require(loss->connection.flowKey == collector.starts[0].flowKey,
+		        "loss event lost connection metadata");
+		require(collector.events.size() == 1,
+		        "synthetic TCP missing-data text was reported as invalid network TLS data");
+		require(collector.records.size() == 6 && collector.records[0].bytes == unaffectedFirst &&
+		            collector.records[1].bytes == partialHandshake && collector.records[2].bytes == recovered &&
+		            collector.records[3].bytes == crossGapContinuation && collector.records[4].bytes == reverseTrigger &&
+		            collector.records[5].bytes == unaffectedSecond,
+		        "TCP loss fabricated a record or failed to recover the later records in order");
+		require(collector.handshakes.size() == 1 && collector.handshakes[0].bytes == unaffectedHandshake &&
+		            collector.handshakes[0].side == 1,
+		        "a TCP gap discarded the unaffected direction's handshake or completed the affected one");
+
+		Collector cleanGapCollector;
+		auto cleanGapReassembly = makeReassembly(cleanGapCollector);
+		feedIPv4(cleanGapReassembly, {}, 34000, "192.0.2.103", "198.51.100.103", 7446, 60003, true);
+		feedIPv4(cleanGapReassembly, {}, 35000, "198.51.100.103", "192.0.2.103", 60003, 7446, true);
+		Bytes beforeCleanGap = makeRecord(23, { 0xe1 });
+		feedIPv4(cleanGapReassembly, beforeCleanGap, 34001, "192.0.2.103", "198.51.100.103", 7446, 60003);
+		Bytes afterCleanGap = makeRecord(23, { 0xe2 });
+		feedIPv4(cleanGapReassembly, afterCleanGap,
+		         34001 + static_cast<uint32_t>(beforeCleanGap.size()) + 5, "192.0.2.103", "198.51.100.103",
+		         7446, 60003);
+		feedIPv4(cleanGapReassembly, makeRecord(23, { 0xe3 }), 35001, "198.51.100.103", "192.0.2.103", 60003,
+		         7446);
+		auto cleanLoss = std::find_if(cleanGapCollector.events.begin(), cleanGapCollector.events.end(),
+		                              [](const EventResult& event) {
+			                              return event.type == pcpp::TlsReassemblyEvent::TcpDataMissing;
+		                              });
+		require(cleanLoss != cleanGapCollector.events.end() && cleanLoss->side == 0 &&
+		            cleanLoss->missingBytes == 5 && cleanLoss->discardedBytes == 0,
+		        "a TCP gap with no buffered TLS state was not reported accurately");
+	}
