+	void outOfOrderAndRetransmission()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		require(feedIPv4(reassembly, {}, 7000, "203.0.113.1", "203.0.113.2", 443, 53000, true) ==
+		            pcpp::TcpReassembly::TcpMessageHandled,
+		        "ordinary TCP packet status was not forwarded");
+		Bytes expected = makeRecord(23, { 9, 8, 7, 6, 5, 4, 3, 2 });
+		Bytes head(expected.begin(), expected.begin() + 4);
+		Bytes tail(expected.begin() + 4, expected.end());
+		require(feedIPv4(reassembly, tail, 7005, "203.0.113.1", "203.0.113.2", 443, 53000) ==
+		            pcpp::TcpReassembly::OutOfOrderTcpMessageBuffered,
+		        "out-of-order record tail was not buffered");
+		require(collector.records.empty(), "out-of-order tail emitted a record early");
+		require(feedIPv4(reassembly, head, 7001, "203.0.113.1", "203.0.113.2", 443, 53000) ==
+		            pcpp::TcpReassembly::TcpMessageHandled,
+		        "in-order TCP packet status was not forwarded");
+		require(collector.records.size() == 1 && collector.records[0].bytes == expected,
+		        "out-of-order record was not reconstructed");
+
+		require(feedIPv4(reassembly, head, 7001, "203.0.113.1", "203.0.113.2", 443, 53000) ==
+		            pcpp::TcpReassembly::Ignore_Retransimission,
+		        "retransmission status was not forwarded");
+		require(feedIPv4(reassembly, tail, 7005, "203.0.113.1", "203.0.113.2", 443, 53000) ==
+		            pcpp::TcpReassembly::Ignore_Retransimission,
+		        "tail retransmission status was not forwarded");
+		require(collector.records.size() == 1, "retransmission emitted a duplicate TLS record");
+
+		require(feedIPv4(reassembly, {}, 7014, "203.0.113.1", "203.0.113.2", 443, 53000) ==
+		            pcpp::TcpReassembly::Ignore_PacketWithNoData,
+		        "no-data ACK status was not forwarded");
+		require(feedIPv4(reassembly, {}, 7014, "203.0.113.1", "203.0.113.2", 443, 53000, false, false,
+		                 false, true) == pcpp::TcpReassembly::FIN_RSTWithNoData,
+		        "RST status was not forwarded");
+		require(feedIPv4(reassembly, expected, 7014, "203.0.113.1", "203.0.113.2", 443, 53000) ==
+		            pcpp::TcpReassembly::Ignore_PacketOfClosedFlow,
+		        "closed-flow status was not forwarded");
+
+		pcpp::EthLayer ethernet(pcpp::MacAddress("00:11:22:33:44:55"), pcpp::MacAddress("00:66:77:88:99:aa"),
+		                        PCPP_ETHERTYPE_ARP);
+		pcpp::PayloadLayer ethernetPayload(expected.data(), expected.size());
+		pcpp::Packet nonIpPacket(256);
+		require(nonIpPacket.addLayer(&ethernet) && nonIpPacket.addLayer(&ethernetPayload),
+		        "cannot construct non-IP status fixture");
+		nonIpPacket.computeCalculateFields();
+		require(reassembly->reassemblePacket(nonIpPacket) == pcpp::TcpReassembly::NonIpPacket,
+		        "non-IP status was not forwarded");
+		require(reassembly->reassemblePacket(nonIpPacket.getRawPacket()) == pcpp::TcpReassembly::NonIpPacket,
+		        "raw non-IP status was not forwarded");
+
+		pcpp::IPv4Layer ip(pcpp::IPv4Address("192.0.2.80"), pcpp::IPv4Address("198.51.100.80"));
+		pcpp::UdpLayer udp(1234, 4321);
+		pcpp::PayloadLayer udpPayload(expected.data(), expected.size());
+		pcpp::EthLayer ipv4Ethernet(pcpp::MacAddress("00:11:22:33:44:55"),
+		                            pcpp::MacAddress("00:66:77:88:99:aa"), PCPP_ETHERTYPE_IP);
+		pcpp::Packet nonTcpPacket(256);
+		require(nonTcpPacket.addLayer(&ipv4Ethernet) && nonTcpPacket.addLayer(&ip) && nonTcpPacket.addLayer(&udp) &&
+		            nonTcpPacket.addLayer(&udpPayload),
+		        "cannot construct non-TCP status fixture");
+		nonTcpPacket.computeCalculateFields();
+		require(reassembly->reassemblePacket(nonTcpPacket) == pcpp::TcpReassembly::NonTcpPacket,
+		        "non-TCP status was not forwarded");
+		require(reassembly->reassemblePacket(nonTcpPacket.getRawPacket()) == pcpp::TcpReassembly::NonTcpPacket,
+		        "raw non-TCP status was not forwarded");
+	}
