+		auto zeroHandshakeReassembly =
+		    makeReassembly(zeroHandshakeCollector, pcpp::TlsReassemblyConfiguration(32, 0));
+		feedIPv4(zeroHandshakeReassembly, {}, 10400, "192.0.2.34", "198.51.100.34", 4324, 55004, true);
+		Bytes emptyHandshake = makeHandshake(0, {});
+		Bytes nonemptyHandshake = makeHandshake(1, { 0x02 });
+		Bytes zeroHandshakePayload = emptyHandshake;
+		zeroHandshakePayload.insert(zeroHandshakePayload.end(), nonemptyHandshake.begin(), nonemptyHandshake.end());
+		Bytes zeroHandshakeRecord = makeRecord(22, zeroHandshakePayload);
+		feedIPv4(zeroHandshakeReassembly, zeroHandshakeRecord, 10401, "192.0.2.34", "198.51.100.34", 4324,
+		         55004);
+		require(zeroHandshakeCollector.records.size() == 1 &&
+		            zeroHandshakeCollector.records[0].bytes == zeroHandshakeRecord,
+		        "zero handshake maximum suppressed the containing TLS record");
+		require(zeroHandshakeCollector.handshakes.size() == 1 &&
+		            zeroHandshakeCollector.handshakes[0].bytes == emptyHandshake,
+		        "zero handshake maximum did not accept only the zero-length message");
+		size_t zeroHandshakeDiscarded = 0;
+		for (const EventResult& event : zeroHandshakeCollector.events)
+			if (event.type == pcpp::TlsReassemblyEvent::InvalidTlsData)
+				zeroHandshakeDiscarded += event.discardedBytes;
+		require(zeroHandshakeDiscarded == nonemptyHandshake.size(),
+		        "zero handshake maximum silently ignored its rejected message");
+	}
+
+	void connectionLifecycle()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		feedIPv4(reassembly, {}, 11000, "192.0.2.40", "198.51.100.40", 443, 56000, true);
+		feedIPv4(reassembly, {}, 12000, "198.51.100.40", "192.0.2.40", 56000, 443, true);
+		require(collector.starts.size() == 1, "connection start callback count is wrong");
+
+		feedIPv4(reassembly, { 23, 3, 3 }, 11001, "192.0.2.40", "198.51.100.40", 443, 56000);
+		Bytes partialHandshake = makeRecord(22, { 1, 0, 0 });
+		feedIPv4(reassembly, partialHandshake, 12001, "198.51.100.40", "192.0.2.40", 56000, 443);
+		reassembly->closeConnection(collector.starts[0].flowKey);
+
+		require(collector.ends.size() == 1 &&
+		            collector.ends[0].reason == pcpp::TcpReassembly::TcpReassemblyConnectionClosedManually,
+		        "manual close was not forwarded");
+		require(reassembly->isConnectionOpen(collector.starts[0]) == 0, "closed connection is still open");
+		bool incompleteSides[2] = { false, false };
+		for (const EventResult& event : collector.events)
+		{
+			if (event.type == pcpp::TlsReassemblyEvent::IncompleteDataOnConnectionEnd)
+			{
+				require(event.side == 0 || event.side == 1, "close event has an invalid side");
+				require(!incompleteSides[event.side], "close reported one direction more than once");
+				incompleteSides[event.side] = true;
+				require(event.discardedBytes == 3, "close reported the wrong partial-state size");
+				require(event.connection.flowKey == collector.starts[0].flowKey,
+				        "close event lost connection metadata");
+			}
+		}
+		require(incompleteSides[0] && incompleteSides[1], "close did not report both incomplete directions");
+		require(collector.closeOrder == std::vector<std::string>({ "event", "event", "end" }),
+		        "connection-end callback ran before incomplete TLS state was reported");
+
+		feedIPv4(reassembly, {}, 13000, "192.0.2.43", "198.51.100.43", 443, 56300, true);
+		Bytes sameSideHandshake = makeRecord(22, { 1, 0, 0 });
+		feedIPv4(reassembly, sameSideHandshake, 13001, "192.0.2.43", "198.51.100.43", 443, 56300);
+		Bytes sameSideRecord = { 23, 3, 3, 0, 5 };
+		feedIPv4(reassembly, sameSideRecord, 13001 + static_cast<uint32_t>(sameSideHandshake.size()),
+		         "192.0.2.43", "198.51.100.43", 443, 56300);
+		size_t eventsBeforeCombinedClose = collector.events.size();
+		reassembly->closeConnection(collector.starts[1].flowKey);
+		require(collector.events.size() == eventsBeforeCombinedClose + 1,
+		        "close emitted separate events for one direction's record and handshake state");
+		const EventResult& combined = collector.events.back();
+		require(combined.type == pcpp::TlsReassemblyEvent::IncompleteDataOnConnectionEnd && combined.side == 0 &&
+		            combined.discardedBytes == 8 && combined.connection.flowKey == collector.starts[1].flowKey,
+		        "close did not combine one direction's incomplete record and handshake bytes");
+		require(collector.ends.size() == 2 && collector.closeOrder.size() == 5 &&
+		            collector.closeOrder[3] == "event" && collector.closeOrder[4] == "end",
+		        "combined incomplete event did not precede the connection-end callback");
+	}
+
+	void rawPacketAndCloseAll()
+	{
+		Collector collector;
+		int cookie = 42;
+		auto reassembly = makeReassembly(collector, pcpp::TlsReassemblyConfiguration(),
+		                                 pcpp::TcpReassemblyConfiguration(), &cookie);
+		require(feedIPv4(reassembly, {}, 12100, "192.0.2.41", "198.51.100.41", 9443, 56100, true, false, true) ==
+		            pcpp::TcpReassembly::TcpMessageHandled,
+		        "raw ordinary TCP status was not forwarded");
+		Bytes expectedHandshake = makeHandshake(1, { 0x71, 0x72, 0x73 });
+		Bytes expected = makeRecord(22, expectedHandshake);
+		require(feedIPv4(reassembly, expected, 12101, "192.0.2.41", "198.51.100.41", 9443, 56100, false, false,
+		                 true) == pcpp::TcpReassembly::TcpMessageHandled,
+		        "raw TLS-data status was not forwarded");
+		feedIPv4(reassembly, {}, 12200, "192.0.2.42", "198.51.100.42", 10443, 56200, true);
+		feedIPv4(reassembly, { 23, 3, 3 }, 12201, "192.0.2.42", "198.51.100.42", 10443, 56200);
+
+		require(collector.records.size() == 1 && collector.records[0].bytes == expected,
+		        "RawPacket input did not produce a TLS record");
+		require(collector.handshakes.size() == 1 && collector.handshakes[0].bytes == expectedHandshake,
+		        "non-null-cookie input did not produce its handshake callback");
+		require(collector.starts.size() == 2 && reassembly->getConnectionInformation().size() == 2,
+		        "connection information did not include both flows");
+		require(reassembly->purgeClosedConnections(1) == 0, "purge removed an open connection");
+		reassembly->closeAllConnections();
+		require(collector.ends.size() == 2, "close-all did not close every connection");
+		require(collector.events.size() == 1 &&
+		            collector.events[0].type == pcpp::TlsReassemblyEvent::IncompleteDataOnConnectionEnd &&
+		            collector.events[0].discardedBytes == 3,
+		        "non-null-cookie close did not produce its incomplete-data event callback");
+		for (const pcpp::ConnectionData& connection : collector.starts)
+			require(reassembly->isConnectionOpen(connection) == 0, "close-all left a connection open");
+	}
+
+	void purgeClosedConnections()
+	{
+		Collector collector;
+		g_UseControlledTime = true;
+		g_ControlledTime = 1000;
+		pcpp::TcpReassemblyConfiguration tcpConfig(true, 1, 30);
+		auto reassembly = makeReassembly(collector, pcpp::TlsReassemblyConfiguration(), tcpConfig);
+		feedIPv4(reassembly, {}, 18000, "192.0.2.70", "198.51.100.70", 443, 59000, true);
+		Bytes partialHandshake = makeRecord(22, { 1, 0, 0 });
+		feedIPv4(reassembly, partialHandshake, 18001, "192.0.2.70", "198.51.100.70", 443, 59000);
+		Bytes partialRecord = { 23, 3, 3 };
+		feedIPv4(reassembly, partialRecord, 18001 + static_cast<uint32_t>(partialHandshake.size()),
+		         "192.0.2.70", "198.51.100.70", 443, 59000);
+		feedIPv4(reassembly, {}, 19000, "192.0.2.71", "198.51.100.71", 443, 59001, true);
+		feedIPv4(reassembly, {}, 20000, "192.0.2.72", "198.51.100.72", 443, 59002, true);
+		require(collector.starts.size() == 3 && reassembly->getConnectionInformation().size() == 3,
+		        "purge fixture did not create three connections");
+		reassembly->closeAllConnections();
+		for (const pcpp::ConnectionData& connection : collector.starts)
+			require(reassembly->isConnectionOpen(connection) == 0, "purge fixture did not close a connection");
+
+		g_ControlledTime = 1002;
+		require(reassembly->purgeClosedConnections(1) == 1,
+		        "bounded purge did not remove exactly one expired connection");
+		require(reassembly->getConnectionInformation().size() == 2,
+		        "bounded purge changed the wrong number of connection records");
+		size_t unmanagedAfterBoundedPurge = 0;
+		for (const pcpp::ConnectionData& connection : collector.starts)
+			if (reassembly->isConnectionOpen(connection) < 0)
+				++unmanagedAfterBoundedPurge;
+		require(unmanagedAfterBoundedPurge == 1, "bounded purge did not release one closed connection");
+
+		require(reassembly->purgeClosedConnections() == 2,
+		        "default purge did not remove the remaining expired connections");
+		require(reassembly->getConnectionInformation().empty(), "default purge retained closed connection records");
+		for (const pcpp::ConnectionData& connection : collector.starts)
+			require(reassembly->isConnectionOpen(connection) < 0, "purged connection is still managed");
+
+		size_t recordsBeforeRecreate = collector.records.size();
+		size_t handshakesBeforeRecreate = collector.handshakes.size();
+		size_t eventsBeforeRecreate = collector.events.size();
+		feedIPv4(reassembly, {}, 28000, "192.0.2.70", "198.51.100.70", 443, 59000, true);
+		Bytes freshRecord = makeRecord(23, { 0xa1, 0xa2 });
+		feedIPv4(reassembly, freshRecord, 28001, "192.0.2.70", "198.51.100.70", 443, 59000);
+		require(collector.starts.size() == 4, "recreated tuple did not start a new connection");
+		require(collector.records.size() == recordsBeforeRecreate + 1 && collector.records.back().bytes == freshRecord,
+		        "closed TLS state contaminated a recreated connection tuple");
+		require(collector.handshakes.size() == handshakesBeforeRecreate,
+		        "closed handshake state completed on a recreated connection tuple");
+		require(collector.events.size() == eventsBeforeRecreate,
+		        "closed TLS state produced an event on a recreated connection tuple");
+		g_UseControlledTime = false;
+	}
+
+	void automaticFinRstLifecycle()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+
+		feedIPv4(reassembly, {}, 15000, "192.0.2.60", "198.51.100.60", 443, 58000, true);
+		feedIPv4(reassembly, { 23, 3, 3 }, 15001, "192.0.2.60", "198.51.100.60", 443, 58000);
+		require(feedIPv4(reassembly, {}, 15004, "192.0.2.60", "198.51.100.60", 443, 58000, false, false,
+		                 false, true) == pcpp::TcpReassembly::FIN_RSTWithNoData,
+		        "RST packet was not handled by TCP reassembly");
+		require(collector.ends.size() == 1 &&
+		            collector.ends[0].reason == pcpp::TcpReassembly::TcpReassemblyConnectionClosedByFIN_RST,
+		        "RST did not close the TLS connection");
+		require(reassembly->isConnectionOpen(collector.starts[0]) == 0, "RST-closed connection remained open");
+
+		feedIPv4(reassembly, {}, 16000, "192.0.2.61", "198.51.100.61", 443, 58001, true);
+		feedIPv4(reassembly, {}, 17000, "198.51.100.61", "192.0.2.61", 58001, 443, true);
+		Bytes partialHandshake = makeRecord(22, { 1, 0, 0 });
+		feedIPv4(reassembly, partialHandshake, 16001, "192.0.2.61", "198.51.100.61", 443, 58001);
+		feedIPv4(reassembly, {}, 16001 + static_cast<uint32_t>(partialHandshake.size()), "192.0.2.61",
+		         "198.51.100.61", 443, 58001, false, true);
+		require(collector.ends.size() == 1, "one-sided FIN closed the connection early");
+		feedIPv4(reassembly, {}, 17001, "198.51.100.61", "192.0.2.61", 58001, 443, false, true);
+		require(collector.ends.size() == 2 &&
+		            collector.ends[1].reason == pcpp::TcpReassembly::TcpReassemblyConnectionClosedByFIN_RST,
+		        "two-sided FIN did not close the TLS connection");
+		require(reassembly->isConnectionOpen(collector.starts[1]) == 0, "FIN-closed connection remained open");
+
+		size_t automaticIncompleteEvents = 0;
+		for (const EventResult& event : collector.events)
+		{
+			if (event.type == pcpp::TlsReassemblyEvent::IncompleteDataOnConnectionEnd)
+			{
+				++automaticIncompleteEvents;
+				require(event.discardedBytes == 3, "automatic close reported the wrong incomplete byte count");
+			}
+		}
+		require(automaticIncompleteEvents == 2, "automatic closes did not report both incomplete streams");
+	}
+
+	void ipv6Stream()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		feedIPv6(reassembly, {}, 13000, true);
+		Bytes expected = makeRecord(23, { 0x81, 0x82, 0x83, 0x84 });
+		feedIPv6(reassembly, Bytes(expected.begin(), expected.begin() + 2), 13001);
+		feedIPv6(reassembly, Bytes(expected.begin() + 2, expected.end()), 13003);
+		require(collector.records.size() == 1 && collector.records[0].bytes == expected,
+		        "segmented IPv6 TLS record was not reconstructed");
+		require(collector.records[0].connection.srcIP.isIPv6() && collector.records[0].connection.dstIP.isIPv6(),
+		        "IPv6 connection metadata was lost");
+	}
+
+	void initialResynchronization()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		Bytes expected = makeRecord(23, { 0x91, 0x92, 0x93 });
+		Bytes first = { 0xde, 0xad, 0xbe, expected[0], expected[1], expected[2] };
+		Bytes second(expected.begin() + 3, expected.end());
+		feedIPv4(reassembly, first, 14000, "192.0.2.50", "198.51.100.50", 12345, 23456);
+		feedIPv4(reassembly, second, 14006, "192.0.2.50", "198.51.100.50", 12345, 23456);
+		require(collector.records.size() == 1 && collector.records[0].bytes == expected,
+		        "initial junk or split header prevented TLS resynchronization");
+		size_t invalidDiscardedBytes = 0;
+		for (const EventResult& event : collector.events)
+			if (event.type == pcpp::TlsReassemblyEvent::InvalidTlsData)
+				invalidDiscardedBytes += event.discardedBytes;
+		require(invalidDiscardedBytes == 3, "invalid-data events did not account for every discarded captured byte");
+	}
+}  // namespace
+
+int main(int argc, char* argv[])
+{
+	const std::unordered_map<std::string, std::function<void()>> scenarios = {
+		{ "RequiredCallbackOnly", requiredCallbackOnly },
+		{ "SegmentedRecords", segmentedRecords },
+		{ "CoalescedRecords", coalescedRecords },
+		{ "HandshakeFraming", handshakeFraming },
+		{ "DirectionAndConnectionIsolation", directionAndConnectionIsolation },
+		{ "OutOfOrderAndRetransmission", outOfOrderAndRetransmission },
+		{ "MissingDataRecovery", missingDataRecovery },
+		{ "MalformedAndConfiguredBounds", malformedAndConfiguredBounds },
+		{ "ConnectionLifecycle", connectionLifecycle },
+		{ "RawPacketAndCloseAll", rawPacketAndCloseAll },
+		{ "PurgeClosedConnections", purgeClosedConnections },
+		{ "AutomaticFinRstLifecycle", automaticFinRstLifecycle },
+		{ "IPv6Stream", ipv6Stream },
+		{ "InitialResynchronization", initialResynchronization },
+	};
+
+	if (argc != 2 || scenarios.count(argv[1]) == 0)
+	{
+		std::cerr << "usage: " << argv[0] << " SCENARIO\n";
+		return 2;
+	}
+
+	try
+	{
+		scenarios.at(argv[1])();
+		std::cout << argv[1] << ": passed\n";
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::cerr << argv[1] << ": " << error.what() << '\n';
+		return 1;
+	}
+}
