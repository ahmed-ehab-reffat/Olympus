+	void directionAndConnectionIsolation()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		Bytes first = makeRecord(23, { 1, 2, 3, 4 });
+		Bytes second = makeRecord(21, { 2, 10 });
+		Bytes reverse = makeRecord(20, { 1 });
+
+		feedIPv4(reassembly, {}, 4000, "192.0.2.10", "198.51.100.10", 443, 51000, true);
+		feedIPv4(reassembly, {}, 5000, "192.0.2.20", "198.51.100.20", 443, 52000, true);
+		feedIPv4(reassembly, {}, 6000, "198.51.100.10", "192.0.2.10", 51000, 443, true);
+
+		feedIPv4(reassembly, Bytes(first.begin(), first.begin() + 3), 4001, "192.0.2.10", "198.51.100.10", 443,
+		         51000);
+		feedIPv4(reassembly, Bytes(second.begin(), second.begin() + 4), 5001, "192.0.2.20", "198.51.100.20", 443,
+		         52000);
+		feedIPv4(reassembly, Bytes(reverse.begin(), reverse.begin() + 2), 6001, "198.51.100.10", "192.0.2.10",
+		         51000, 443);
+		require(collector.records.empty(), "partial streams leaked across a direction or connection");
+
+		feedIPv4(reassembly, Bytes(second.begin() + 4, second.end()), 5005, "192.0.2.20", "198.51.100.20", 443,
+		         52000);
+		feedIPv4(reassembly, Bytes(first.begin() + 3, first.end()), 4004, "192.0.2.10", "198.51.100.10", 443,
+		         51000);
+		feedIPv4(reassembly, Bytes(reverse.begin() + 2, reverse.end()), 6003, "198.51.100.10", "192.0.2.10",
+		         51000, 443);
+
+		require(collector.records.size() == 3, "isolated streams did not all complete");
+		require(collector.records[0].bytes == second && collector.records[1].bytes == first &&
+		            collector.records[2].bytes == reverse,
+		        "interleaved streams changed record ownership or order");
+		require(collector.records[1].connection.flowKey == collector.records[2].connection.flowKey &&
+		            collector.records[1].side != collector.records[2].side,
+		        "two directions of one connection were not distinguished");
+		require(collector.records[0].connection.flowKey != collector.records[1].connection.flowKey,
+		        "different connections shared state");
+
+		Bytes forwardHandshake = makeHandshake(1, { 0xa1, 0xa2, 0xa3 });
+		Bytes reverseHandshake = makeHandshake(2, { 0xb1, 0xb2 });
+		Bytes forwardFirst = makeRecord(22, Bytes(forwardHandshake.begin(), forwardHandshake.begin() + 3));
+		Bytes forwardSecond = makeRecord(22, Bytes(forwardHandshake.begin() + 3, forwardHandshake.end()));
+		Bytes reverseFirst = makeRecord(22, Bytes(reverseHandshake.begin(), reverseHandshake.begin() + 3));
+		Bytes reverseSecond = makeRecord(22, Bytes(reverseHandshake.begin() + 3, reverseHandshake.end()));
+
+		feedIPv4(reassembly, forwardFirst, 4001 + static_cast<uint32_t>(first.size()), "192.0.2.10",
+		         "198.51.100.10", 443, 51000);
+		feedIPv4(reassembly, reverseFirst, 6001 + static_cast<uint32_t>(reverse.size()), "198.51.100.10",
+		         "192.0.2.10", 51000, 443);
+		require(collector.handshakes.empty(), "partial handshakes completed across directions");
+		feedIPv4(reassembly, reverseSecond,
+		         6001 + static_cast<uint32_t>(reverse.size() + reverseFirst.size()), "198.51.100.10",
+		         "192.0.2.10", 51000, 443);
+		feedIPv4(reassembly, forwardSecond,
+		         4001 + static_cast<uint32_t>(first.size() + forwardFirst.size()), "192.0.2.10",
+		         "198.51.100.10", 443, 51000);
+		require(collector.handshakes.size() == 2, "directional handshakes did not complete independently");
+		require(collector.handshakes[0].bytes == reverseHandshake && collector.handshakes[0].side == 1 &&
+		            collector.handshakes[1].bytes == forwardHandshake && collector.handshakes[1].side == 0,
+		        "interleaved handshake bytes or callback sides crossed directions");
+	}
