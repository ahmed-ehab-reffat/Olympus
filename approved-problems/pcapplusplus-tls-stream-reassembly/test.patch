+#include "EndianPortable.h"
+#include "EthLayer.h"
+#include "IPv4Layer.h"
+#include "IPv6Layer.h"
+#include "Packet.h"
+#include "PayloadLayer.h"
+#include "TcpLayer.h"
+#include "TlsReassembly.h"
+#include "UdpLayer.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <ctime>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <type_traits>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace
+{
+	bool g_UseControlledTime = false;
+	std::time_t g_ControlledTime = 0;
+}
+
+extern "C" std::time_t time(std::time_t* result) noexcept
+{
+	std::time_t value = g_ControlledTime;
+	if (!g_UseControlledTime)
+	{
+		timespec currentTime = {};
+		clock_gettime(CLOCK_REALTIME, &currentTime);
+		value = currentTime.tv_sec;
+	}
+	if (result != nullptr)
+		*result = value;
+	return value;
+}
+
+namespace
+{
+	using Bytes = std::vector<uint8_t>;
+
+	void require(bool condition, const std::string& message)
+	{
+		if (!condition)
+			throw std::runtime_error(message);
+	}
+
+	Bytes makeRecord(uint8_t type, const Bytes& payload, uint16_t version = 0x0303)
+	{
+		Bytes result = { type, static_cast<uint8_t>(version >> 8), static_cast<uint8_t>(version),
+		                 static_cast<uint8_t>(payload.size() >> 8), static_cast<uint8_t>(payload.size()) };
+		result.insert(result.end(), payload.begin(), payload.end());
+		return result;
+	}
+
+	Bytes makeHandshake(uint8_t type, const Bytes& payload)
+	{
+		require(payload.size() <= 0xffffff, "test handshake is too large");
+		Bytes result = { type, static_cast<uint8_t>(payload.size() >> 16), static_cast<uint8_t>(payload.size() >> 8),
+		                 static_cast<uint8_t>(payload.size()) };
+		result.insert(result.end(), payload.begin(), payload.end());
+		return result;
+	}
+
+	struct RecordResult
+	{
+		int8_t side;
+		Bytes bytes;
+		Bytes payload;
+		pcpp::SSLRecordType type;
+		uint16_t version;
+		pcpp::ConnectionData connection;
+		std::chrono::time_point<std::chrono::high_resolution_clock> timestamp;
+	};
+
+	struct HandshakeResult
+	{
+		int8_t side;
+		Bytes bytes;
+		Bytes payload;
+		pcpp::SSLHandshakeType type;
+		pcpp::ConnectionData connection;
+	};
+
+	struct EventResult
+	{
+		int8_t side;
+		pcpp::TlsReassemblyEvent::EventType type;
+		size_t missingBytes;
+		size_t discardedBytes;
+		pcpp::ConnectionData connection;
+	};
+
+	struct EndResult
+	{
+		pcpp::ConnectionData connection;
+		pcpp::TcpReassembly::ConnectionEndReason reason;
+	};
+
+	struct Collector
+	{
+		std::vector<RecordResult> records;
+		std::vector<HandshakeResult> handshakes;
+		std::vector<EventResult> events;
+		std::vector<pcpp::ConnectionData> starts;
+		std::vector<EndResult> ends;
+		std::vector<std::string> closeOrder;
+	};
+
+	std::unique_ptr<pcpp::TlsReassembly> makeReassembly(
+	    Collector& collector, const pcpp::TlsReassemblyConfiguration& tlsConfig = pcpp::TlsReassemblyConfiguration(),
+	    const pcpp::TcpReassemblyConfiguration& tcpConfig = pcpp::TcpReassemblyConfiguration(),
+	    void* userCookie = nullptr)
+	{
+		return std::unique_ptr<pcpp::TlsReassembly>(new pcpp::TlsReassembly(
+		    [&collector, userCookie](int8_t side, const pcpp::TlsRecordData& data, void* cookie) {
+			    require(cookie == userCookie, "record callback changed the user cookie");
+			    RecordResult result;
+			    result.side = side;
+			    result.bytes.assign(data.getData(), data.getData() + data.getDataLength());
+			    result.payload.assign(data.getPayload(), data.getPayload() + data.getPayloadLength());
+			    result.type = data.getRecordType();
+			    result.version = data.getRecordVersion().asUInt();
+			    result.connection = data.getConnectionData();
+			    result.timestamp = data.getTimeStampPrecise();
+			    collector.records.push_back(result);
+		    },
+		    userCookie,
+		    [&collector, userCookie](int8_t side, const pcpp::TlsHandshakeData& data, void* cookie) {
+			    require(cookie == userCookie, "handshake callback changed the user cookie");
+			    HandshakeResult result;
+			    result.side = side;
+			    result.bytes.assign(data.getData(), data.getData() + data.getDataLength());
+			    result.payload.assign(data.getPayload(), data.getPayload() + data.getPayloadLength());
+			    result.type = data.getHandshakeType();
+			    result.connection = data.getConnectionData();
+			    collector.handshakes.push_back(result);
+		    },
+		    [&collector, userCookie](int8_t side, const pcpp::TlsReassemblyEvent& data, void* cookie) {
+			    require(cookie == userCookie, "event callback changed the user cookie");
+			    EventResult result;
+			    result.side = side;
+			    result.type = data.getType();
+			    result.missingBytes = data.getMissingByteCount();
+			    result.discardedBytes = data.getDiscardedByteCount();
+			    result.connection = data.getConnectionData();
+			    collector.events.push_back(result);
+			    if (result.type == pcpp::TlsReassemblyEvent::IncompleteDataOnConnectionEnd)
+				    collector.closeOrder.push_back("event");
+		    },
+		    [&collector, userCookie](const pcpp::ConnectionData& data, void* cookie) {
+			    require(cookie == userCookie, "connection-start callback changed the user cookie");
+			    collector.starts.push_back(data);
+		    },
+		    [&collector, userCookie](const pcpp::ConnectionData& data,
+			                             pcpp::TcpReassembly::ConnectionEndReason reason, void* cookie) {
+			    require(cookie == userCookie, "connection-end callback changed the user cookie");
+			    collector.ends.push_back({ data, reason });
+			    collector.closeOrder.push_back("end");
+		    },
+		    tcpConfig, tlsConfig));
+	}
+
+	pcpp::TcpReassembly::ReassemblyStatus feedIPv4(
+	    pcpp::TlsReassembly& reassembly, const Bytes& payload, uint32_t sequence,
+	    const char* source = "192.0.2.1", const char* destination = "198.51.100.2", uint16_t sourcePort = 443,
+	    uint16_t destinationPort = 50000, bool syn = false, bool fin = false, bool useRawPacket = false,
+	    bool rst = false)
+	{
+		pcpp::EthLayer eth(pcpp::MacAddress("00:11:22:33:44:55"), pcpp::MacAddress("00:66:77:88:99:aa"),
+		                   PCPP_ETHERTYPE_IP);
+		pcpp::IPv4Layer ip{ pcpp::IPv4Address(source), pcpp::IPv4Address(destination) };
+		pcpp::TcpLayer tcp(sourcePort, destinationPort);
+		tcp.getTcpHeader()->sequenceNumber = htobe32(sequence);
+		tcp.getTcpHeader()->synFlag = syn ? 1 : 0;
+		tcp.getTcpHeader()->finFlag = fin ? 1 : 0;
+		tcp.getTcpHeader()->rstFlag = rst ? 1 : 0;
+		tcp.getTcpHeader()->ackFlag = syn ? 0 : 1;
+		pcpp::Packet packet(256 + payload.size());
+		if (useRawPacket)
+			require(packet.addLayer(&eth), "cannot add Ethernet layer");
+		require(packet.addLayer(&ip), "cannot add IPv4 layer");
+		require(packet.addLayer(&tcp), "cannot add TCP layer");
+		if (!payload.empty())
+		{
+			pcpp::PayloadLayer data(payload.data(), payload.size());
+			require(packet.addLayer(&data), "cannot add payload layer");
+			packet.computeCalculateFields();
+			return useRawPacket ? reassembly.reassemblePacket(packet.getRawPacket())
+			                    : reassembly.reassemblePacket(packet);
+		}
+		packet.computeCalculateFields();
+		return useRawPacket ? reassembly.reassemblePacket(packet.getRawPacket()) : reassembly.reassemblePacket(packet);
+	}
+
+	pcpp::TcpReassembly::ReassemblyStatus feedIPv4(
+	    const std::unique_ptr<pcpp::TlsReassembly>& reassembly, const Bytes& payload, uint32_t sequence,
+	    const char* source = "192.0.2.1", const char* destination = "198.51.100.2", uint16_t sourcePort = 443,
+	    uint16_t destinationPort = 50000, bool syn = false, bool fin = false, bool useRawPacket = false,
+	    bool rst = false)
+	{
+		return feedIPv4(*reassembly, payload, sequence, source, destination, sourcePort, destinationPort, syn, fin,
+		                useRawPacket, rst);
+	}
+
+	pcpp::TcpReassembly::ReassemblyStatus feedIPv6(pcpp::TlsReassembly& reassembly, const Bytes& payload,
+	                                                  uint32_t sequence, bool syn = false)
+	{
+		pcpp::IPv6Layer ip(pcpp::IPv6Address("2001:db8::1"), pcpp::IPv6Address("2001:db8::2"));
+		pcpp::TcpLayer tcp(443, 50001);
+		tcp.getTcpHeader()->sequenceNumber = htobe32(sequence);
+		tcp.getTcpHeader()->synFlag = syn ? 1 : 0;
+		tcp.getTcpHeader()->ackFlag = syn ? 0 : 1;
+		pcpp::Packet packet(256 + payload.size());
+		require(packet.addLayer(&ip), "cannot add IPv6 layer");
+		require(packet.addLayer(&tcp), "cannot add TCP layer");
+		if (!payload.empty())
+		{
+			pcpp::PayloadLayer data(payload.data(), payload.size());
+			require(packet.addLayer(&data), "cannot add IPv6 payload");
+			packet.computeCalculateFields();
+			return reassembly.reassemblePacket(packet);
+		}
+		packet.computeCalculateFields();
+		return reassembly.reassemblePacket(packet);
+	}
+
+	pcpp::TcpReassembly::ReassemblyStatus feedIPv6(const std::unique_ptr<pcpp::TlsReassembly>& reassembly,
+	                                                  const Bytes& payload, uint32_t sequence, bool syn = false)
+	{
+		return feedIPv6(*reassembly, payload, sequence, syn);
+	}
+
+	void feedChunks(pcpp::TlsReassembly& reassembly, const Bytes& stream, uint32_t firstSequence,
+	                const std::vector<size_t>& chunkSizes)
+	{
+		size_t offset = 0;
+		uint32_t sequence = firstSequence;
+		for (size_t chunkSize : chunkSizes)
+		{
+			require(offset + chunkSize <= stream.size(), "chunk fixture overruns stream");
+			Bytes chunk(stream.begin() + offset, stream.begin() + offset + chunkSize);
+			feedIPv4(reassembly, chunk, sequence);
+			offset += chunkSize;
+			sequence += static_cast<uint32_t>(chunkSize);
+		}
+		if (offset < stream.size())
+		{
+			Bytes chunk(stream.begin() + offset, stream.end());
+			feedIPv4(reassembly, chunk, sequence);
+		}
+	}
+
+	void feedChunks(const std::unique_ptr<pcpp::TlsReassembly>& reassembly, const Bytes& stream,
+	                uint32_t firstSequence, const std::vector<size_t>& chunkSizes)
+	{
+		feedChunks(*reassembly, stream, firstSequence, chunkSizes);
+	}
+
+	void requiredCallbackOnly()
+	{
+		static_assert(
+		    std::is_same<decltype(pcpp::TlsReassemblyConfiguration::maxRecordPayloadSize), size_t>::value,
+		    "record payload limit must have type size_t");
+		static_assert(
+		    std::is_same<decltype(pcpp::TlsReassemblyConfiguration::maxHandshakeMessageSize), size_t>::value,
+		    "handshake payload limit must have type size_t");
+		static_assert(std::is_same<decltype(std::declval<const pcpp::TlsRecordData&>().getConnectionData()),
+		                           const pcpp::ConnectionData&>::value,
+		              "record connection getter must return a const reference");
+		static_assert(std::is_same<decltype(std::declval<const pcpp::TlsHandshakeData&>().getConnectionData()),
+		                           const pcpp::ConnectionData&>::value,
+		              "handshake connection getter must return a const reference");
+		static_assert(std::is_same<decltype(std::declval<const pcpp::TlsReassemblyEvent&>().getConnectionData()),
+		                           const pcpp::ConnectionData&>::value,
+		              "event connection getter must return a const reference");
+		static_assert(std::is_same<decltype(std::declval<const pcpp::TlsReassembly&>().getConnectionInformation()),
+		                           const pcpp::TcpReassembly::ConnectionInfoList&>::value,
+		              "connection information must be a const query returning a const reference");
+		static_assert(std::is_same<decltype(std::declval<const pcpp::TlsReassembly&>().isConnectionOpen(
+		                               std::declval<const pcpp::ConnectionData&>())),
+		                           int>::value,
+		              "connection-open query must preserve the TcpReassembly return type");
+
+		std::vector<Bytes> records;
+		int8_t observedSide = -1;
+		bool cookieWasNull = false;
+		pcpp::TlsReassembly reassembly(
+		    [&records, &observedSide, &cookieWasNull](int8_t side, const pcpp::TlsRecordData& record, void* cookie) {
+			    observedSide = side;
+			    cookieWasNull = cookie == nullptr;
+			    records.emplace_back(record.getData(), record.getData() + record.getDataLength());
+		    });
+
+		feedIPv4(reassembly, {}, 500, "192.0.2.90", "198.51.100.90", 8443, 59000, true);
+		Bytes expected = makeRecord(23, { 0x10, 0x20, 0x30 });
+		feedIPv4(reassembly, expected, 501, "192.0.2.90", "198.51.100.90", 8443, 59000);
+		require(records.size() == 1 && records[0] == expected, "record-only construction did not emit the record");
+		require(observedSide == 0 && cookieWasNull, "record-only construction did not use callback defaults");
+	}
+
+	void segmentedRecords()
+	{
+		Collector collector;
+		pcpp::TlsReassemblyConfiguration defaults;
+		require(defaults.maxRecordPayloadSize == 18 * 1024 && defaults.maxHandshakeMessageSize == 0xffffff,
+		        "TLS reassembly configuration defaults changed");
+		auto reassembly = makeReassembly(collector);
+		feedIPv4(reassembly, {}, 1000, "192.0.2.1", "198.51.100.2", 443, 50000, true);
+
+		Bytes payload(37);
+		for (size_t index = 0; index < payload.size(); ++index)
+			payload[index] = static_cast<uint8_t>(0x30 + index);
+		Bytes expected = makeRecord(23, payload);
+		feedChunks(reassembly, expected, 1001, { 1, 1, 1, 1, 1, 2, 7, 3 });
+
+		require(collector.records.size() == 1, "segmented record was not emitted exactly once");
+		const RecordResult& actual = collector.records[0];
+		require(actual.bytes == expected && actual.payload == payload, "segmented record bytes changed");
+		require(actual.type == pcpp::SSL_APPLICATION_DATA && actual.version == 0x0303,
+		        "record header getters changed values");
+		require(actual.connection.srcPort == 443 && actual.connection.dstPort == 50000,
+		        "record lost connection metadata");
+		require(actual.timestamp.time_since_epoch().count() != 0, "record lost its TCP packet timestamp");
+		require(reassembly->getConnectionInformation().size() == 1, "connection forwarding is unavailable");
+		require(reassembly->isConnectionOpen(actual.connection) > 0, "open TLS connection is not reported open");
+
+		Bytes aboveConventionalLimit = makeRecord(23, Bytes(17 * 1024, 0x7a));
+		const uint32_t aboveLimitSequence = 1001 + static_cast<uint32_t>(expected.size());
+		feedIPv4(reassembly, aboveConventionalLimit, aboveLimitSequence);
+		require(collector.records.size() == 2 && collector.records[1].bytes == aboveConventionalLimit,
+		        "default record limit rejected a payload between 16 KiB and 18 KiB");
+
+		Bytes exactLimit = makeRecord(23, Bytes(18 * 1024, 0x7b));
+		const uint32_t exactLimitSequence = aboveLimitSequence + static_cast<uint32_t>(aboveConventionalLimit.size());
+		feedIPv4(reassembly, Bytes(exactLimit.begin(), exactLimit.begin() + 4), exactLimitSequence);
+		require(collector.records.size() == 2, "four-byte record-header prefix emitted a record early");
+		feedIPv4(reassembly, Bytes(exactLimit.begin() + 4, exactLimit.end()), exactLimitSequence + 4);
+		require(collector.records.size() == 3 && collector.records[2].bytes == exactLimit,
+		        "split record at the inclusive default payload limit was rejected");
+
+		feedIPv4(reassembly, {}, 26000, "192.0.2.91", "198.51.100.91", 9443, 59001, true);
+		Bytes timestampedRecord = makeRecord(23, { 0x81, 0x82 });
+		auto feedTimestampedFragment = [&](const Bytes& fragment, uint32_t sequence, const timespec& timestamp) {
+			pcpp::IPv4Layer timestampIp(pcpp::IPv4Address("192.0.2.91"), pcpp::IPv4Address("198.51.100.91"));
+			pcpp::TcpLayer timestampTcp(9443, 59001);
+			timestampTcp.getTcpHeader()->sequenceNumber = htobe32(sequence);
+			timestampTcp.getTcpHeader()->ackFlag = 1;
+			pcpp::PayloadLayer timestampPayload(fragment.data(), fragment.size());
+			pcpp::Packet timestampPacket(256);
+			require(timestampPacket.addLayer(&timestampIp) && timestampPacket.addLayer(&timestampTcp) &&
+			            timestampPacket.addLayer(&timestampPayload),
+			        "cannot construct timestamp fixture");
+			timestampPacket.computeCalculateFields();
+			require(timestampPacket.getRawPacket()->setPacketTimeStamp(timestamp),
+			        "cannot set timestamp fixture");
+			reassembly->reassemblePacket(timestampPacket);
+		};
+		timespec firstFragmentTimestamp = { 123456700, 111111111 };
+		timespec completingFragmentTimestamp = { 123456789, 987654321 };
+		feedTimestampedFragment(Bytes(timestampedRecord.begin(), timestampedRecord.begin() + 4), 26001,
+		                        firstFragmentTimestamp);
+		require(collector.records.size() == 3, "timestamp fixture emitted before its header was complete");
+		feedTimestampedFragment(Bytes(timestampedRecord.begin() + 4, timestampedRecord.end()), 26005,
+		                        completingFragmentTimestamp);
+		auto expectedTimestamp = std::chrono::duration_cast<std::chrono::high_resolution_clock::duration>(
+		    std::chrono::seconds(completingFragmentTimestamp.tv_sec) +
+		    std::chrono::nanoseconds(completingFragmentTimestamp.tv_nsec));
+		require(collector.records.size() == 4 && collector.records.back().bytes == timestampedRecord &&
+		            collector.records.back().timestamp.time_since_epoch() == expectedTimestamp,
+		        "record timestamp did not preserve the TCP packet timestamp that completed it");
+	}
+
+	void coalescedRecords()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		feedIPv4(reassembly, {}, 2000, "192.0.2.3", "198.51.100.4", 8443, 50002, true);
+		Bytes first = makeRecord(20, { 1 }, 0x0300);
+		Bytes second = makeRecord(21, { 2, 40 }, 0x0301);
+		Bytes third = makeRecord(23, { 3 }, 0x0302);
+		Bytes fourth = makeRecord(23, { 4, 5, 6, 7 });
+		Bytes stream = first;
+		stream.insert(stream.end(), second.begin(), second.end());
+		stream.insert(stream.end(), third.begin(), third.end());
+		stream.insert(stream.end(), fourth.begin(), fourth.end());
+		feedIPv4(reassembly, stream, 2001, "192.0.2.3", "198.51.100.4", 8443, 50002);
+
+		require(collector.records.size() == 4, "coalesced records were not separated");
+		require(collector.records[0].bytes == first && collector.records[1].bytes == second &&
+		            collector.records[2].bytes == third && collector.records[3].bytes == fourth,
+		        "coalesced record order or bytes changed");
+		require(collector.records[0].type == pcpp::SSL_CHANGE_CIPHER_SPEC &&
+		            collector.records[1].type == pcpp::SSL_ALERT,
+		        "coalesced record types changed");
+		require(collector.records[0].version == 0x0300 && collector.records[1].version == 0x0301 &&
+		            collector.records[2].version == 0x0302 && collector.records[3].version == 0x0303,
+		        "a supported TLS record version was not preserved");
+	}
+
+	void handshakeFraming()
+	{
+		Collector collector;
+		auto reassembly = makeReassembly(collector);
+		feedIPv4(reassembly, {}, 3000, "192.0.2.1", "198.51.100.2", 443, 50000, true);
+
+		Bytes largePayload(70000);
+		for (size_t index = 0; index < largePayload.size(); ++index)
+			largePayload[index] = static_cast<uint8_t>(index * 17);
+		Bytes expectedHandshake = makeHandshake(11, largePayload);
+		Bytes recordStream;
+		for (size_t offset = 0; offset < expectedHandshake.size();)
+		{
+			size_t chunkSize = std::min<size_t>(15000, expectedHandshake.size() - offset);
+			Bytes recordPayload(expectedHandshake.begin() + offset, expectedHandshake.begin() + offset + chunkSize);
+			Bytes encoded = makeRecord(22, recordPayload);
+			recordStream.insert(recordStream.end(), encoded.begin(), encoded.end());
+			offset += chunkSize;
+		}
+		feedChunks(reassembly, recordStream, 3001, { 2, 4, 9000, 7000, 16000, 13000 });
+		require(collector.handshakes.size() == 1, "cross-record 24-bit handshake was not emitted once");
+		require(collector.handshakes[0].bytes == expectedHandshake && collector.handshakes[0].payload == largePayload,
+		        "large handshake bytes changed");
+		require(collector.handshakes[0].type == pcpp::SSL_CERTIFICATE,
+		        "large handshake type was decoded incorrectly");
+		require(collector.handshakes[0].connection.srcPort == 443 &&
+		            collector.handshakes[0].connection.dstPort == 50000,
+		        "handshake lost connection metadata");
+
+		Bytes smallOne = makeHandshake(0, {});
+		Bytes smallTwo = makeHandshake(250, { 9, 8, 7 });
+		Bytes combined = smallOne;
+		combined.insert(combined.end(), smallTwo.begin(), smallTwo.end());
+		Bytes encoded = makeRecord(22, combined);
+		feedIPv4(reassembly, encoded, 3001 + static_cast<uint32_t>(recordStream.size()));
+		require(collector.handshakes.size() == 3, "multiple handshakes in one record were collapsed");
+		require(collector.handshakes[1].bytes == smallOne && collector.handshakes[2].bytes == smallTwo,
+		        "coalesced handshake bytes or order changed");
+
+		Bytes interrupted = makeHandshake(2, { 1, 2, 3, 4, 5 });
+		Bytes interruptedFirst = makeRecord(22, Bytes(interrupted.begin(), interrupted.begin() + 3));
+		Bytes application = makeRecord(23, { 0xaa, 0xbb });
+		Bytes interruptedSecond = makeRecord(22, Bytes(interrupted.begin() + 3, interrupted.end()));
+		Bytes mixedStream = interruptedFirst;
+		mixedStream.insert(mixedStream.end(), application.begin(), application.end());
+		mixedStream.insert(mixedStream.end(), interruptedSecond.begin(), interruptedSecond.end());
+		feedIPv4(reassembly, mixedStream,
+		         3001 + static_cast<uint32_t>(recordStream.size() + encoded.size()));
+		require(collector.handshakes.size() == 4 && collector.handshakes[3].bytes == interrupted,
+		        "a non-handshake record discarded or contaminated an incomplete handshake");
+	}
