--- /dev/null
+++ b/Packet++/header/TlsReassembly.h
@@ -0,0 +1,233 @@
+#pragma once
+
+#include "TcpReassembly.h"
+#include "SSLCommon.h"
+#include <array>
+#include <functional>
+#include <unordered_map>
+#include <vector>
+
+namespace pcpp
+{
+	struct TlsReassemblyConfiguration
+	{
+		size_t maxRecordPayloadSize;
+		size_t maxHandshakeMessageSize;
+
+		explicit TlsReassemblyConfiguration(size_t maxRecordPayloadSize = 18 * 1024,
+		                                    size_t maxHandshakeMessageSize = 0xffffff)
+		    : maxRecordPayloadSize(maxRecordPayloadSize), maxHandshakeMessageSize(maxHandshakeMessageSize)
+		{}
+	};
+
+	class TlsRecordData
+	{
+	public:
+		SSLRecordType getRecordType() const
+		{
+			return static_cast<SSLRecordType>(m_Data[0]);
+		}
+
+		SSLVersion getRecordVersion() const
+		{
+			return SSLVersion(static_cast<uint16_t>((m_Data[1] << 8) | m_Data[2]));
+		}
+
+		const uint8_t* getData() const
+		{
+			return m_Data;
+		}
+
+		size_t getDataLength() const
+		{
+			return m_DataLen;
+		}
+
+		const uint8_t* getPayload() const
+		{
+			return m_Data + 5;
+		}
+
+		size_t getPayloadLength() const
+		{
+			return m_DataLen - 5;
+		}
+
+		const ConnectionData& getConnectionData() const
+		{
+			return m_Connection;
+		}
+
+		std::chrono::time_point<std::chrono::high_resolution_clock> getTimeStampPrecise() const
+		{
+			return m_Timestamp;
+		}
+
+	private:
+		friend class TlsReassembly;
+
+		TlsRecordData(const uint8_t* data, size_t dataLen, const ConnectionData& connection,
+		              std::chrono::time_point<std::chrono::high_resolution_clock> timestamp)
+		    : m_Data(data), m_DataLen(dataLen), m_Connection(connection), m_Timestamp(timestamp)
+		{}
+
+		const uint8_t* m_Data;
+		size_t m_DataLen;
+		const ConnectionData& m_Connection;
+		std::chrono::time_point<std::chrono::high_resolution_clock> m_Timestamp;
+	};
+
+	class TlsHandshakeData
+	{
+	public:
+		SSLHandshakeType getHandshakeType() const
+		{
+			return static_cast<SSLHandshakeType>(m_Data[0]);
+		}
+
+		const uint8_t* getData() const
+		{
+			return m_Data;
+		}
+
+		size_t getDataLength() const
+		{
+			return m_DataLen;
+		}
+
+		const uint8_t* getPayload() const
+		{
+			return m_Data + 4;
+		}
+
+		size_t getPayloadLength() const
+		{
+			return m_DataLen - 4;
+		}
+
+		const ConnectionData& getConnectionData() const
+		{
+			return m_Connection;
+		}
+
+	private:
+		friend class TlsReassembly;
+
+		TlsHandshakeData(const uint8_t* data, size_t dataLen, const ConnectionData& connection)
+		    : m_Data(data), m_DataLen(dataLen), m_Connection(connection)
+		{}
+
+		const uint8_t* m_Data;
+		size_t m_DataLen;
+		const ConnectionData& m_Connection;
+	};
+
+	class TlsReassemblyEvent
+	{
+	public:
+		enum EventType
+		{
+			TcpDataMissing,
+			InvalidTlsData,
+			IncompleteDataOnConnectionEnd
+		};
+
+		EventType getType() const
+		{
+			return m_Type;
+		}
+
+		size_t getMissingByteCount() const
+		{
+			return m_MissingBytes;
+		}
+
+		size_t getDiscardedByteCount() const
+		{
+			return m_DiscardedBytes;
+		}
+
+		const ConnectionData& getConnectionData() const
+		{
+			return m_Connection;
+		}
+
+	private:
+		friend class TlsReassembly;
+
+		TlsReassemblyEvent(EventType type, size_t missingBytes, size_t discardedBytes,
+		                   const ConnectionData& connection)
+		    : m_Type(type), m_MissingBytes(missingBytes), m_DiscardedBytes(discardedBytes),
+		      m_Connection(connection)
+		{}
+
+		EventType m_Type;
+		size_t m_MissingBytes;
+		size_t m_DiscardedBytes;
+		const ConnectionData& m_Connection;
+	};
+
+	class TlsReassembly
+	{
+	public:
+		using OnTlsRecordReady =
+		    std::function<void(int8_t side, const TlsRecordData& recordData, void* userCookie)>;
+		using OnTlsHandshakeReady =
+		    std::function<void(int8_t side, const TlsHandshakeData& handshakeData, void* userCookie)>;
+		using OnTlsReassemblyEvent =
+		    std::function<void(int8_t side, const TlsReassemblyEvent& eventData, void* userCookie)>;
+
+		explicit TlsReassembly(
+		    OnTlsRecordReady onRecordReady, void* userCookie = nullptr,
+		    OnTlsHandshakeReady onHandshakeReady = nullptr, OnTlsReassemblyEvent onReassemblyEvent = nullptr,
+		    TcpReassembly::OnTcpConnectionStart onConnectionStart = nullptr,
+		    TcpReassembly::OnTcpConnectionEnd onConnectionEnd = nullptr,
+		    const TcpReassemblyConfiguration& tcpConfig = TcpReassemblyConfiguration(),
+		    const TlsReassemblyConfiguration& tlsConfig = TlsReassemblyConfiguration());
+
+		TcpReassembly::ReassemblyStatus reassemblePacket(Packet& tcpPacket);
+		TcpReassembly::ReassemblyStatus reassemblePacket(RawPacket* tcpRawPacket);
+		void closeConnection(uint32_t flowKey);
+		void closeAllConnections();
+		const TcpReassembly::ConnectionInfoList& getConnectionInformation() const;
+		int isConnectionOpen(const ConnectionData& connection) const;
+		uint32_t purgeClosedConnections(uint32_t maxNumToClean = 0);
+
+	private:
+		struct DirectionState
+		{
+			std::vector<uint8_t> recordBuffer;
+			std::vector<uint8_t> handshakeBuffer;
+			size_t handshakeBytesToDiscard = 0;
+			bool synchronized = false;
+		};
+
+		struct ConnectionState
+		{
+			std::array<DirectionState, 2> sides;
+		};
+
+		OnTlsRecordReady m_OnRecordReady;
+		OnTlsHandshakeReady m_OnHandshakeReady;
+		OnTlsReassemblyEvent m_OnReassemblyEvent;
+		TcpReassembly::OnTcpConnectionStart m_OnConnectionStart;
+		TcpReassembly::OnTcpConnectionEnd m_OnConnectionEnd;
+		void* m_UserCookie;
+		TlsReassemblyConfiguration m_Config;
+		std::unordered_map<uint32_t, ConnectionState> m_ConnectionStates;
+		TcpReassembly m_TcpReassembly;
+
+		void onTcpData(int8_t side, const TcpStreamData& tcpData);
+		void onConnectionStart(const ConnectionData& connectionData);
+		void onConnectionEnd(const ConnectionData& connectionData, TcpReassembly::ConnectionEndReason reason);
+		void processAvailableRecords(int8_t side, DirectionState& state, const ConnectionData& connectionData,
+		                             std::chrono::time_point<std::chrono::high_resolution_clock> timestamp);
+		std::vector<std::vector<uint8_t>> processHandshakeRecord(DirectionState& state, const uint8_t* payload,
+		                                                          size_t payloadLength,
+		                                                          const ConnectionData& connectionData, int8_t side);
+		bool findRecordBoundary(DirectionState& state, const ConnectionData& connectionData, int8_t side);
+		bool isPlausibleRecordHeader(const uint8_t* data, size_t dataLength) const;
+		void emitEvent(int8_t side, TlsReassemblyEvent::EventType type, size_t missingBytes, size_t discardedBytes,
+		               const ConnectionData& connectionData);
+	};
+}  // namespace pcpp
diff --git a/Packet++/src/TlsReassembly.cpp b/Packet++/src/TlsReassembly.cpp
new file mode 100644
index 00000000..aeb8f416
--- /dev/null
+++ b/Packet++/src/TlsReassembly.cpp
@@ -0,0 +1,276 @@
+#include "TlsReassembly.h"
+
+#include <algorithm>
+#include <string>
+#include <utility>
+
+namespace pcpp
+{
+	namespace
+	{
+		constexpr size_t TlsRecordHeaderSize = 5;
+		constexpr size_t TlsHandshakeHeaderSize = 4;
+	}
+
+	TlsReassembly::TlsReassembly(OnTlsRecordReady onRecordReady, void* userCookie,
+	                             OnTlsHandshakeReady onHandshakeReady, OnTlsReassemblyEvent onReassemblyEvent,
+	                             TcpReassembly::OnTcpConnectionStart onConnectionStart,
+	                             TcpReassembly::OnTcpConnectionEnd onConnectionEnd,
+	                             const TcpReassemblyConfiguration& tcpConfig,
+	                             const TlsReassemblyConfiguration& tlsConfig)
+	    : m_OnRecordReady(std::move(onRecordReady)), m_OnHandshakeReady(std::move(onHandshakeReady)),
+	      m_OnReassemblyEvent(std::move(onReassemblyEvent)), m_OnConnectionStart(std::move(onConnectionStart)),
+	      m_OnConnectionEnd(std::move(onConnectionEnd)), m_UserCookie(userCookie), m_Config(tlsConfig),
+	      m_TcpReassembly(
+	          [this](int8_t side, const TcpStreamData& tcpData, void*) { onTcpData(side, tcpData); }, nullptr,
+	          [this](const ConnectionData& connectionData, void*) { this->onConnectionStart(connectionData); },
+	          [this](const ConnectionData& connectionData, TcpReassembly::ConnectionEndReason reason, void*) {
+		          this->onConnectionEnd(connectionData, reason);
+	          },
+	          tcpConfig)
+	{}
+
+	TcpReassembly::ReassemblyStatus TlsReassembly::reassemblePacket(Packet& tcpPacket)
+	{
+		return m_TcpReassembly.reassemblePacket(tcpPacket);
+	}
+
+	TcpReassembly::ReassemblyStatus TlsReassembly::reassemblePacket(RawPacket* tcpRawPacket)
+	{
+		return m_TcpReassembly.reassemblePacket(tcpRawPacket);
+	}
+
+	void TlsReassembly::closeConnection(uint32_t flowKey)
+	{
+		m_TcpReassembly.closeConnection(flowKey);
+	}
+
+	void TlsReassembly::closeAllConnections()
+	{
+		m_TcpReassembly.closeAllConnections();
+	}
+
+	const TcpReassembly::ConnectionInfoList& TlsReassembly::getConnectionInformation() const
+	{
+		return m_TcpReassembly.getConnectionInformation();
+	}
+
+	int TlsReassembly::isConnectionOpen(const ConnectionData& connection) const
+	{
+		return m_TcpReassembly.isConnectionOpen(connection);
+	}
+
+	uint32_t TlsReassembly::purgeClosedConnections(uint32_t maxNumToClean)
+	{
+		return m_TcpReassembly.purgeClosedConnections(maxNumToClean);
+	}
+
+	void TlsReassembly::onConnectionStart(const ConnectionData& connectionData)
+	{
+		m_ConnectionStates[connectionData.flowKey] = ConnectionState();
+		if (m_OnConnectionStart)
+			m_OnConnectionStart(connectionData, m_UserCookie);
+	}
+
+	void TlsReassembly::onConnectionEnd(const ConnectionData& connectionData,
+	                                    TcpReassembly::ConnectionEndReason reason)
+	{
+		auto connection = m_ConnectionStates.find(connectionData.flowKey);
+		if (connection != m_ConnectionStates.end())
+		{
+			for (int8_t side = 0; side < 2; ++side)
+			{
+				const DirectionState& direction = connection->second.sides[side];
+				size_t incompleteBytes = direction.recordBuffer.size() + direction.handshakeBuffer.size();
+				if (incompleteBytes != 0)
+					emitEvent(side, TlsReassemblyEvent::IncompleteDataOnConnectionEnd, 0, incompleteBytes,
+					          connectionData);
+			}
+			m_ConnectionStates.erase(connection);
+		}
+
+		if (m_OnConnectionEnd)
+			m_OnConnectionEnd(connectionData, reason, m_UserCookie);
+	}
+
+	void TlsReassembly::onTcpData(int8_t side, const TcpStreamData& tcpData)
+	{
+		if (side < 0 || side > 1)
+			return;
+
+		const ConnectionData& connectionData = tcpData.getConnectionData();
+		DirectionState& state = m_ConnectionStates[connectionData.flowKey].sides[side];
+		const uint8_t* deliveredData = tcpData.getData();
+		size_t deliveredDataLength = tcpData.getDataLength();
+		if (tcpData.isBytesMissing())
+		{
+			size_t discardedBytes = state.recordBuffer.size() + state.handshakeBuffer.size();
+			state.recordBuffer.clear();
+			state.handshakeBuffer.clear();
+			state.handshakeBytesToDiscard = 0;
+			state.synchronized = false;
+			emitEvent(side, TlsReassemblyEvent::TcpDataMissing, tcpData.getMissingByteCount(), discardedBytes,
+			          connectionData);
+
+			const std::string missingDataMarker =
+			    "[" + std::to_string(tcpData.getMissingByteCount()) + " bytes missing]";
+			if (deliveredDataLength >= missingDataMarker.size() &&
+			    std::equal(missingDataMarker.begin(), missingDataMarker.end(), deliveredData))
+			{
+				deliveredData += missingDataMarker.size();
+				deliveredDataLength -= missingDataMarker.size();
+			}
+		}
+
+		state.recordBuffer.insert(state.recordBuffer.end(), deliveredData, deliveredData + deliveredDataLength);
+		processAvailableRecords(side, state, connectionData, tcpData.getTimeStampPrecise());
+	}
+
+	void TlsReassembly::processAvailableRecords(
+	    int8_t side, DirectionState& state, const ConnectionData& connectionData,
+	    std::chrono::time_point<std::chrono::high_resolution_clock> timestamp)
+	{
+		while (true)
+		{
+			if (!state.synchronized && !findRecordBoundary(state, connectionData, side))
+				return;
+
+			if (state.recordBuffer.size() < TlsRecordHeaderSize)
+				return;
+
+			if (!isPlausibleRecordHeader(state.recordBuffer.data(), state.recordBuffer.size()))
+			{
+				state.synchronized = false;
+				state.handshakeBuffer.clear();
+				state.handshakeBytesToDiscard = 0;
+				state.recordBuffer.erase(state.recordBuffer.begin());
+				emitEvent(side, TlsReassemblyEvent::InvalidTlsData, 0, 1, connectionData);
+				continue;
+			}
+
+			size_t payloadLength = static_cast<size_t>((state.recordBuffer[3] << 8) | state.recordBuffer[4]);
+			size_t totalLength = TlsRecordHeaderSize + payloadLength;
+			if (state.recordBuffer.size() < totalLength)
+				return;
+
+			std::vector<uint8_t> record(state.recordBuffer.begin(), state.recordBuffer.begin() + totalLength);
+			state.recordBuffer.erase(state.recordBuffer.begin(), state.recordBuffer.begin() + totalLength);
+
+			std::vector<std::vector<uint8_t>> handshakes;
+			if (record[0] == SSL_HANDSHAKE)
+				handshakes = processHandshakeRecord(state, record.data() + TlsRecordHeaderSize, payloadLength,
+				                                    connectionData, side);
+
+			if (m_OnRecordReady)
+			{
+				TlsRecordData recordData(record.data(), record.size(), connectionData, timestamp);
+				m_OnRecordReady(side, recordData, m_UserCookie);
+			}
+
+			if (m_OnHandshakeReady)
+			{
+				for (const std::vector<uint8_t>& handshake : handshakes)
+				{
+					TlsHandshakeData handshakeData(handshake.data(), handshake.size(), connectionData);
+					m_OnHandshakeReady(side, handshakeData, m_UserCookie);
+				}
+			}
+		}
+	}
+
+	std::vector<std::vector<uint8_t>> TlsReassembly::processHandshakeRecord(
+	    DirectionState& state, const uint8_t* payload, size_t payloadLength, const ConnectionData& connectionData,
+	    int8_t side)
+	{
+		std::vector<std::vector<uint8_t>> result;
+		size_t payloadOffset = 0;
+		if (state.handshakeBytesToDiscard != 0)
+		{
+			size_t discarded = std::min(state.handshakeBytesToDiscard, payloadLength);
+			state.handshakeBytesToDiscard -= discarded;
+			payloadOffset = discarded;
+			emitEvent(side, TlsReassemblyEvent::InvalidTlsData, 0, discarded, connectionData);
+		}
+
+		state.handshakeBuffer.insert(state.handshakeBuffer.end(), payload + payloadOffset, payload + payloadLength);
+
+		while (state.handshakeBuffer.size() >= TlsHandshakeHeaderSize)
+		{
+			size_t messagePayloadLength = (static_cast<size_t>(state.handshakeBuffer[1]) << 16) |
+			                              (static_cast<size_t>(state.handshakeBuffer[2]) << 8) |
+			                              state.handshakeBuffer[3];
+			if (messagePayloadLength > m_Config.maxHandshakeMessageSize)
+			{
+				size_t totalLength = TlsHandshakeHeaderSize + messagePayloadLength;
+				size_t discarded = std::min(totalLength, state.handshakeBuffer.size());
+				state.handshakeBuffer.erase(state.handshakeBuffer.begin(), state.handshakeBuffer.begin() + discarded);
+				state.handshakeBytesToDiscard = totalLength - discarded;
+				emitEvent(side, TlsReassemblyEvent::InvalidTlsData, 0, discarded, connectionData);
+				if (state.handshakeBytesToDiscard != 0)
+					break;
+				continue;
+			}
+
+			size_t totalLength = TlsHandshakeHeaderSize + messagePayloadLength;
+			if (state.handshakeBuffer.size() < totalLength)
+				break;
+
+			result.emplace_back(state.handshakeBuffer.begin(), state.handshakeBuffer.begin() + totalLength);
+			state.handshakeBuffer.erase(state.handshakeBuffer.begin(), state.handshakeBuffer.begin() + totalLength);
+		}
+
+		return result;
+	}
+
+	bool TlsReassembly::findRecordBoundary(DirectionState& state, const ConnectionData& connectionData, int8_t side)
+	{
+		if (state.recordBuffer.size() < TlsRecordHeaderSize)
+			return false;
+
+		for (size_t offset = 0; offset + TlsRecordHeaderSize <= state.recordBuffer.size(); ++offset)
+		{
+			if (isPlausibleRecordHeader(state.recordBuffer.data() + offset, state.recordBuffer.size() - offset))
+			{
+				if (offset != 0)
+				{
+					state.recordBuffer.erase(state.recordBuffer.begin(), state.recordBuffer.begin() + offset);
+					emitEvent(side, TlsReassemblyEvent::InvalidTlsData, 0, offset, connectionData);
+				}
+				state.synchronized = true;
+				return true;
+			}
+		}
+
+		size_t bytesToKeep = std::min(state.recordBuffer.size(), TlsRecordHeaderSize - 1);
+		size_t bytesToDiscard = state.recordBuffer.size() - bytesToKeep;
+		if (bytesToDiscard != 0)
+		{
+			state.recordBuffer.erase(state.recordBuffer.begin(), state.recordBuffer.begin() + bytesToDiscard);
+			emitEvent(side, TlsReassemblyEvent::InvalidTlsData, 0, bytesToDiscard, connectionData);
+		}
+		return false;
+	}
+
+	bool TlsReassembly::isPlausibleRecordHeader(const uint8_t* data, size_t dataLength) const
+	{
+		if (dataLength < TlsRecordHeaderSize || data[0] < SSL_CHANGE_CIPHER_SPEC || data[0] > SSL_APPLICATION_DATA)
+			return false;
+
+		uint16_t version = static_cast<uint16_t>((data[1] << 8) | data[2]);
+		if (version < 0x0300 || version > 0x0303)
+			return false;
+
+		size_t payloadLength = static_cast<size_t>((data[3] << 8) | data[4]);
+		return payloadLength != 0 && payloadLength <= m_Config.maxRecordPayloadSize;
+	}
+
+	void TlsReassembly::emitEvent(int8_t side, TlsReassemblyEvent::EventType type, size_t missingBytes,
+	                              size_t discardedBytes, const ConnectionData& connectionData)
+	{
+		if (!m_OnReassemblyEvent)
+			return;
+
+		TlsReassemblyEvent eventData(type, missingBytes, discardedBytes, connectionData);
+		m_OnReassemblyEvent(side, eventData, m_UserCookie);
+	}
+}  // namespace pcpp
