+func encryptedSampleBytes7c1e4b(t *testing.T, data []byte) [][]byte {
+	t.Helper()
+	inFile, err := mp4.DecodeFile(bytes.NewReader(data))
+	if err != nil {
+		t.Fatal(err)
+	}
+	trex, ok := inFile.Init.Moov.Mvex.GetTrex(1)
+	if !ok {
+		t.Fatal("no trex for track 1")
+	}
+	var out [][]byte
+	for _, seg := range inFile.Segments {
+		for _, frag := range seg.Fragments {
+			samples, err := frag.GetFullSamples(trex)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for i := range samples {
+				out = append(out, samples[i].Data)
+			}
+		}
+	}
+	return out
+}
