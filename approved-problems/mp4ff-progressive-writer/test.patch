+func buildEncryptedScheme7c1e4b(t *testing.T, scheme, ivHex string) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	trak := init.AddEmptyTrack(48000, "audio", "und")
+	if err := trak.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	key, err := hex.DecodeString("00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv, err := hex.DecodeString(ivHex)
+	if err != nil {
+		t.Fatal(err)
+	}
+	kid, err := mp4.NewUUIDFromString("11112222-3333-4444-5555-666677778888")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ipd, err := mp4.InitProtect(init, key, iv, scheme, kid, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	frag, err := mp4.CreateFragment(1, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 3; i++ {
+		frag.AddFullSample(mp4.FullSample{
+			Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 1024, Size: 32},
+			DecodeTime: uint64(i) * 1024,
+			Data:       bytes.Repeat([]byte{byte(i + 1)}, 32),
+		})
+	}
+	if _, err := mp4.EncryptFragment(frag, key, iv, ipd); err != nil {
+		t.Fatal(err)
+	}
+	if err := frag.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func buildEncryptedWithIV7c1e4b(t *testing.T, ivHex string) []byte {
+	t.Helper()
+	return buildEncryptedScheme7c1e4b(t, "cenc", ivHex)
+}
