+type trackSpec7c1e4b struct {
+	timescale uint32
+	frags     [][]mp4.FullSample
+}
+
+func sample7c1e4b(dur uint32, size uint32, sync bool, cto int32, tag byte) mp4.FullSample {
+	var flags uint32
+	if sync {
+		flags = mp4.SetSyncSampleFlags(0)
+	}
+	return mp4.FullSample{
+		Sample: mp4.Sample{
+			Flags:                 flags,
+			Dur:                   dur,
+			Size:                  size,
+			CompositionTimeOffset: cto,
+		},
+		Data: bytes.Repeat([]byte{tag}, int(size)),
+	}
+}
+
+func runOfSamples7c1e4b(nr int, dur, size uint32, startTag byte) []mp4.FullSample {
+	samples := make([]mp4.FullSample, 0, nr)
+	for i := 0; i < nr; i++ {
+		samples = append(samples, sample7c1e4b(dur, size, i == 0, 0, startTag+byte(i)))
+	}
+	return samples
+}
