+	assertEqualUint7c1e4b(t, uint64(len(shortTrack.Saio.Offset)), 1, "saio offsets of the first track")
+	assertEqualUint7c1e4b(t, uint64(len(longTrack.Saio.Offset)), 1, "saio offsets of the second track")
+	shortAux := uint64(shortTrack.Saio.Offset[0])
+	longAux := uint64(longTrack.Saio.Offset[0])
+	assertEqualUint7c1e4b(t, uint64(shortTrack.Stco.ChunkOffset[0])-shortAux, 2*8, "aux block of the first track")
+	assertEqualUint7c1e4b(t, uint64(longTrack.Stco.ChunkOffset[0])-longAux, 2*16, "aux block of the second track")
+	assertEqualUint7c1e4b(t, uint64(fileData[shortAux]), 0xa0, "first byte of the first track's records")
+	assertEqualUint7c1e4b(t, uint64(fileData[longAux]), 0xb0, "first byte of the second track's records")
+	if longAux <= shortAux {
+		t.Error("the second track's chunk should follow the first at equal times")
+	}
+	for i := 0; i < 2; i++ {
+		got := sampleDataAt7c1e4b(t, out, fileData, 1, uint32(i+1))
+		assertEqualBytes7c1e4b(t, got, bytes.Repeat([]byte{byte(50 + i)}, 7), "second track sample data")
+	}
+}
