+func TestProgressiveKeepsProtectionMetadata(t *testing.T) {
+	cases := []struct {
+		name       string
+		data       []byte
+		scheme     string
+		ivSize     byte
+		constantIV int
+	}{
+		{"cenc", buildEncrypted7c1e4b(t, [][]mp4.FullSample{runOfSamples7c1e4b(2, 1024, 16, 1)}), "cenc", 8, 0},
+		{"cbcs", buildCbcs7c1e4b(t), "cbcs", 0, 16},
+	}
+	for _, c := range cases {
+		inFile, err := mp4.DecodeFile(bytes.NewReader(c.data))
+		if err != nil {
+			t.Fatal(err)
+		}
+		out, err := inFile.ToProgressive(mp4.ProgressiveConfig{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		inSinf := inFile.Init.Moov.GetSinf(1)
+		outSinf := out.Moov.GetSinf(1)
+		if inSinf == nil || outSinf == nil {
+			t.Fatalf("%s: protection information is missing", c.name)
+		}
+		if outSinf == inSinf {
+			t.Errorf("%s: the output shares the sinf box with the input", c.name)
+		}
+		if outSinf.Schm == nil || outSinf.Schm.SchemeType != c.scheme {
+			t.Errorf("%s: scheme type not preserved", c.name)
+		}
+		if outSinf.Frma == nil || inSinf.Frma == nil || outSinf.Frma.DataFormat != inSinf.Frma.DataFormat {
+			t.Errorf("%s: original data format not preserved", c.name)
+		}
+		inTenc := inSinf.Schi.Tenc
+		outTenc := outSinf.Schi.Tenc
+		assertEqualBytes7c1e4b(t, outTenc.DefaultKID, inTenc.DefaultKID, c.name+" default KID")
+		assertEqualUint7c1e4b(t, uint64(outTenc.DefaultPerSampleIVSize), uint64(c.ivSize), c.name+" per sample IV size")
+		assertEqualUint7c1e4b(t, uint64(len(outTenc.DefaultConstantIV)), uint64(c.constantIV), c.name+" constant IV size")
+		assertEqualBytes7c1e4b(t, outTenc.DefaultConstantIV, inTenc.DefaultConstantIV, c.name+" constant IV")
+		assertEqualUint7c1e4b(t, uint64(outTenc.DefaultIsProtected), uint64(inTenc.DefaultIsProtected), c.name+" is protected")
+		var inBuf, outBuf bytes.Buffer
+		if err := inSinf.Encode(&inBuf); err != nil {
+			t.Fatal(err)
+		}
+		if err := outSinf.Encode(&outBuf); err != nil {
+			t.Fatal(err)
+		}
+		assertEqualBytes7c1e4b(t, outBuf.Bytes(), inBuf.Bytes(), c.name+" encoded protection information")
+	}
+}
