+func buildOptimizedTrun7c1e4b(t *testing.T, samples []mp4.FullSample) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	trak := init.AddEmptyTrack(1000, "video", "und")
+	if err := trak.SetMJpegDescriptor(64, 64, nil); err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	frag, err := mp4.CreateFragment(1, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	frag.EncOptimize = mp4.OptimizeTrun
+	decTime := uint64(0)
+	for _, s := range samples {
+		s.DecodeTime = decTime
+		frag.AddFullSample(s)
+		decTime += uint64(s.Dur)
+	}
+	if err := frag.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
