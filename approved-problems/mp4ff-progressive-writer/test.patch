+func buildMixedDescriptions7c1e4b(t *testing.T, protectedFirst bool, descID uint32) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	trak := init.AddEmptyTrack(48000, "audio", "und")
+	if err := trak.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	key, err := hex.DecodeString("00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv, err := hex.DecodeString("0102030405060708")
+	if err != nil {
+		t.Fatal(err)
+	}
+	kid, err := mp4.NewUUIDFromString("11112222-3333-4444-5555-666677778888")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := mp4.InitProtect(init, key, iv, "cenc", kid, nil); err != nil {
+		t.Fatal(err)
+	}
+	clearInit := mp4.CreateEmptyInit()
+	clearTrak := clearInit.AddEmptyTrack(48000, "audio", "und")
+	if err := clearTrak.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	stsd := trak.Mdia.Minf.Stbl.Stsd
+	protectedEntry := stsd.Children[0]
+	clearEntry := clearTrak.Mdia.Minf.Stbl.Stsd.Children[0]
+	stsd.Children = nil
+	stsd.SampleCount = 0
+	stsd.Enca, stsd.Mp4a = nil, nil
+	if protectedFirst {
+		stsd.AddChild(protectedEntry)
+		stsd.AddChild(clearEntry)
+	} else {
+		stsd.AddChild(clearEntry)
+		stsd.AddChild(protectedEntry)
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	frag, err := mp4.CreateFragment(1, 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tfhd := frag.Moof.Traf.Tfhd
+	tfhd.Flags |= mp4.TfhdSampleDescriptionIndexPresentFlag
+	tfhd.SampleDescriptionIndex = descID
+	for i := 0; i < 2; i++ {
+		frag.AddFullSample(mp4.FullSample{
+			Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 1024, Size: 16},
+			DecodeTime: uint64(1024 * i),
+			Data:       bytes.Repeat([]byte{byte(i + 1)}, 16),
+		})
+	}
+	if err := frag.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
