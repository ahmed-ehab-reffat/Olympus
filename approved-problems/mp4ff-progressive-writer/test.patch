+	sampleNr := 0
+	for chunkNr := 1; chunkNr <= nrChunks; chunkNr++ {
+		chunk := stbl.Stsc.GetChunk(uint32(chunkNr))
+		auxOffset := uint64(stbl.Saio.Offset[chunkNr-1])
+		var block []byte
+		for i := uint32(0); i < chunk.NrSamples; i++ {
+			block = append(block, auxBytes7c1e4b(senc, sampleNr)...)
+			sampleNr++
+		}
+		end := auxOffset + uint64(len(block))
+		assertEqualBytes7c1e4b(t, fileData[auxOffset:end], block, "auxiliary block of a chunk")
+		assertEqualUint7c1e4b(t, uint64(stbl.Stco.ChunkOffset[chunkNr-1]), end, "chunk data follows its auxiliary block")
+	}
+	assertEqualUint7c1e4b(t, uint64(sampleNr), uint64(senc.SampleCount), "samples covered by the chunks")
+}
