+func buildFragmented7c1e4b(t *testing.T, specs []trackSpec7c1e4b, startTimes []uint64) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	trackIDs := make([]uint32, 0, len(specs))
+	for i, spec := range specs {
+		trak := init.AddEmptyTrack(spec.timescale, "video", "und")
+		if err := trak.SetMJpegDescriptor(64, 64, nil); err != nil {
+			t.Fatal(err)
+		}
+		trackIDs = append(trackIDs, uint32(i+1))
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	nrFrags := 0
+	for _, spec := range specs {
+		if len(spec.frags) > nrFrags {
+			nrFrags = len(spec.frags)
+		}
+	}
+	decTimes := make([]uint64, len(specs))
+	copy(decTimes, startTimes)
+	for fragNr := 0; fragNr < nrFrags; fragNr++ {
+		frag, err := mp4.CreateMultiTrackFragment(uint32(fragNr+1), trackIDs)
+		if err != nil {
+			t.Fatal(err)
+		}
+		empty := true
+		for trackIdx, spec := range specs {
+			if fragNr >= len(spec.frags) {
+				continue
+			}
+			for _, s := range spec.frags[fragNr] {
+				s.DecodeTime = decTimes[trackIdx]
+				if err := frag.AddFullSampleToTrack(s, uint32(trackIdx+1)); err != nil {
+					t.Fatal(err)
+				}
+				decTimes[trackIdx] += uint64(s.Dur)
+				empty = false
+			}
+		}
+		if empty {
+			continue
+		}
+		if err := frag.Encode(&buf); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return buf.Bytes()
+}
+
+func singleTrack7c1e4b(t *testing.T, frags [][]mp4.FullSample) []byte {
+	t.Helper()
+	return buildFragmented7c1e4b(t, []trackSpec7c1e4b{{timescale: 1000, frags: frags}}, []uint64{0})
+}
+
+func flatten7c1e4b(t *testing.T, fragData []byte, cfg mp4.ProgressiveConfig) (*mp4.File, []byte) {
+	t.Helper()
+	inFile, err := mp4.DecodeFile(bytes.NewReader(fragData))
+	if err != nil {
+		t.Fatal(err)
+	}
+	outFile, err := inFile.ToProgressive(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := outFile.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	decoded, err := mp4.DecodeFile(bytes.NewReader(buf.Bytes()))
+	if err != nil {
+		t.Fatalf("could not decode progressive output: %s", err)
+	}
+	return decoded, buf.Bytes()
+}
+
+func stblOf7c1e4b(t *testing.T, file *mp4.File, trackIdx int) *mp4.StblBox {
+	t.Helper()
+	if file.Moov == nil || len(file.Moov.Traks) <= trackIdx {
+		t.Fatalf("no track with index %d", trackIdx)
+	}
+	return file.Moov.Traks[trackIdx].Mdia.Minf.Stbl
+}
+
+func sampleDataAt7c1e4b(t *testing.T, file *mp4.File, fileData []byte, trackIdx int, sampleNr uint32) []byte {
+	t.Helper()
+	trak := file.Moov.Traks[trackIdx]
+	ranges, err := trak.GetRangesForSampleInterval(sampleNr, sampleNr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var out []byte
+	for _, r := range ranges {
+		if r.Offset+r.Size > uint64(len(fileData)) {
+			t.Fatalf("range %d-%d outside file of size %d", r.Offset, r.Offset+r.Size, len(fileData))
+		}
+		out = append(out, fileData[r.Offset:r.Offset+r.Size]...)
+	}
+	return out
+}
