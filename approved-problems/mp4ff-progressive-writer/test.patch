+func buildTwoDescriptions7c1e4b(t *testing.T, descIDs []uint32) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	trak := init.AddEmptyTrack(1000, "video", "und")
+	if err := trak.SetMJpegDescriptor(64, 64, nil); err != nil {
+		t.Fatal(err)
+	}
+	stsd := trak.Mdia.Minf.Stbl.Stsd
+	second := mp4.CreateVisualSampleEntryBox("mjpg", 32, 32, nil)
+	stsd.AddChild(second)
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	decTime := uint64(0)
+	for fragNr, descID := range descIDs {
+		frag, err := mp4.CreateFragment(uint32(fragNr+1), 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		tfhd := frag.Moof.Traf.Tfhd
+		tfhd.Flags |= mp4.TfhdSampleDescriptionIndexPresentFlag
+		tfhd.SampleDescriptionIndex = descID
+		for i := 0; i < 2; i++ {
+			frag.AddFullSample(mp4.FullSample{
+				Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 1000, Size: 10},
+				DecodeTime: decTime,
+				Data:       bytes.Repeat([]byte{byte(10*fragNr + i + 1)}, 10),
+			})
+			decTime += 1000
+		}
+		if err := frag.Encode(&buf); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return buf.Bytes()
+}
