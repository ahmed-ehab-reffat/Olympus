+func buildMixedTrafFragment7c1e4b(t *testing.T) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	audio := init.AddEmptyTrack(48000, "audio", "und")
+	if err := audio.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	second := init.AddEmptyTrack(48000, "audio", "und")
+	if err := second.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	key, err := hex.DecodeString("00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv, err := hex.DecodeString("0102030405060708")
+	if err != nil {
+		t.Fatal(err)
+	}
+	kid, err := mp4.NewUUIDFromString("11112222-3333-4444-5555-666677778888")
+	if err != nil {
+		t.Fatal(err)
+	}
+	allTraks := init.Moov.Traks
+	init.Moov.Traks = []*mp4.TrakBox{allTraks[0]}
+	_, err = mp4.InitProtect(init, key, iv, "cenc", kid, nil)
+	init.Moov.Traks = allTraks
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	frag, err := mp4.CreateMultiTrackFragment(1, []uint32{1, 2})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		s := mp4.FullSample{
+			Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 48000, Size: 16},
+			DecodeTime: uint64(i) * 48000,
+			Data:       bytes.Repeat([]byte{byte(i + 1)}, 16),
+		}
+		if err := frag.AddFullSampleToTrack(s, 1); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 0; i < 2; i++ {
+		s := mp4.FullSample{
+			Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 48000, Size: 7},
+			DecodeTime: uint64(i) * 48000,
+			Data:       bytes.Repeat([]byte{byte(50 + i)}, 7),
+		}
+		if err := frag.AddFullSampleToTrack(s, 2); err != nil {
+			t.Fatal(err)
+		}
+	}
+	senc := &mp4.SencBox{}
+	senc.SetPerSampleIVSize(8)
+	for i := 0; i < 2; i++ {
+		ivBytes := append([]byte{}, iv...)
+		ivBytes[7] = byte(i + 1)
+		if err := senc.AddSample(mp4.SencSample{IV: ivBytes}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := frag.Moof.Trafs[0].AddChild(senc); err != nil {
+		t.Fatal(err)
+	}
+	if err := frag.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
