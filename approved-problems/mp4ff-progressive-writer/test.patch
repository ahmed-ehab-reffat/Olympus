+func sampleFlags7c1e4b(isLeading, dependsOn, dependedOn, redundancy byte, nonSync bool) uint32 {
+	flags := uint32(isLeading)<<26 | uint32(dependsOn)<<24 | uint32(dependedOn)<<22 | uint32(redundancy)<<20
+	if nonSync {
+		flags |= 1 << 16
+	}
+	return flags
+}
