+func buildMixedProtection7c1e4b(t *testing.T, nrSamples int) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	audio := init.AddEmptyTrack(48000, "audio", "und")
+	if err := audio.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	video := init.AddEmptyTrack(1000, "video", "und")
+	if err := video.SetMJpegDescriptor(64, 64, nil); err != nil {
+		t.Fatal(err)
+	}
+	key, err := hex.DecodeString("00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv, err := hex.DecodeString("0102030405060708")
+	if err != nil {
+		t.Fatal(err)
+	}
+	kid, err := mp4.NewUUIDFromString("11112222-3333-4444-5555-666677778888")
+	if err != nil {
+		t.Fatal(err)
+	}
+	allTraks := init.Moov.Traks
+	init.Moov.Traks = []*mp4.TrakBox{allTraks[0]}
+	ipd, err := mp4.InitProtect(init, key, iv, "cenc", kid, nil)
+	init.Moov.Traks = allTraks
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	nextIV := iv
+	for i := 0; i < nrSamples; i++ {
+		encFrag, err := mp4.CreateFragment(uint32(2*i+1), 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		encFrag.AddFullSample(mp4.FullSample{
+			Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 48000, Size: 16},
+			DecodeTime: uint64(i) * 48000,
+			Data:       bytes.Repeat([]byte{byte(i + 1)}, 16),
+		})
+		nextIV, err = mp4.EncryptFragment(encFrag, key, nextIV, ipd)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := encFrag.Encode(&buf); err != nil {
+			t.Fatal(err)
+		}
+		clearFrag, err := mp4.CreateFragment(uint32(2*i+2), 2)
+		if err != nil {
+			t.Fatal(err)
+		}
+		clearFrag.AddFullSample(mp4.FullSample{
+			Sample:     mp4.Sample{Flags: mp4.SetSyncSampleFlags(0), Dur: 1000, Size: 10},
+			DecodeTime: uint64(i) * 1000,
+			Data:       bytes.Repeat([]byte{byte(50 + i)}, 10),
+		})
+		if err := clearFrag.Encode(&buf); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return buf.Bytes()
+}
