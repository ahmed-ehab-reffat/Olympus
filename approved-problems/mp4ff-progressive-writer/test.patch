+func TestProgressiveHasFtypMoovMdatOrder(t *testing.T) {
+	data := singleTrack7c1e4b(t, [][]mp4.FullSample{runOfSamples7c1e4b(3, 1000, 10, 1)})
+	out, _ := flatten7c1e4b(t, data, mp4.ProgressiveConfig{})
+	types := make([]string, 0, len(out.Children))
+	for _, ch := range out.Children {
+		types = append(types, ch.Type())
+	}
+	if len(types) != 3 || types[0] != "ftyp" || types[1] != "moov" || types[2] != "mdat" {
+		t.Errorf("unexpected top level boxes %v", types)
+	}
+}
