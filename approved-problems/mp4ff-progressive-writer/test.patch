+func encryptedAVC7c1e4b(t *testing.T, varySubSamples bool) []byte {
+	t.Helper()
+	ifh, err := os.Open("testdata/init.mp4")
+	if err != nil {
+		t.Fatal(err)
+	}
+	initSeg, err := mp4.DecodeFile(ifh)
+	ifh.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	key, err := hex.DecodeString("00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv, err := hex.DecodeString("7766554433221100")
+	if err != nil {
+		t.Fatal(err)
+	}
+	kid, err := mp4.NewUUIDFromString("11112222-3333-4444-5555-666677778888")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ipd, err := mp4.InitProtect(initSeg.Init, key, iv, "cenc", kid, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := initSeg.Init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile("testdata/1.m4s")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seg, err := mp4.DecodeFile(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatal(err)
+	}
+	frag := seg.Segments[0].Fragments[0]
+	if _, err := mp4.EncryptFragment(frag, key, iv, ipd); err != nil {
+		t.Fatal(err)
+	}
+	if varySubSamples {
+		traf := frag.Moof.Traf
+		senc := traf.Senc
+		protected := senc.SubSamples[1][0].BytesOfProtectedData
+		senc.SubSamples[1][0].BytesOfProtectedData = protected/2 - 4
+		senc.SubSamples[1] = append(senc.SubSamples[1], mp4.SubSamplePattern{
+			BytesOfClearData: 4, BytesOfProtectedData: protected / 2,
+		})
+		children := make([]mp4.Box, 0, len(traf.Children))
+		for _, ch := range traf.Children {
+			if ch.Type() == "saiz" || ch.Type() == "saio" {
+				continue
+			}
+			children = append(children, ch)
+		}
+		traf.Children = children
+		traf.Saiz = nil
+		traf.Saio = nil
+	}
+	if err := frag.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	return buf.Bytes()
+}
+
+func auxBytes7c1e4b(senc *mp4.SencBox, sampleNr int) []byte {
+	info := append([]byte{}, senc.IVs[sampleNr]...)
+	subSamples := senc.SubSamples[sampleNr]
+	info = binary.BigEndian.AppendUint16(info, uint16(len(subSamples)))
+	for _, ss := range subSamples {
+		info = binary.BigEndian.AppendUint16(info, ss.BytesOfClearData)
+		info = binary.BigEndian.AppendUint32(info, ss.BytesOfProtectedData)
+	}
+	return info
+}
