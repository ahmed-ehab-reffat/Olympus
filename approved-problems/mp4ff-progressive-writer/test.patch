+write_build_failure_xml() {
+  out="$1"
+  log="$2"
+  nr=$(printf '%s\n' "$NEW_TESTS" | wc -l)
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites tests="%s" failures="%s" errors="0">\n' "$nr" "$nr"
+    printf '<testsuite name="github.com/Eyevinn/mp4ff/mp4" tests="%s" failures="%s" errors="0">\n' "$nr" "$nr"
+    while IFS= read -r name; do
+      [ -z "$name" ] && continue
+      printf '<testcase name="%s" classname="github.com/Eyevinn/mp4ff/mp4" time="0">\n' "$name"
+      printf '<failure message="build failed">'
+      sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' "$log" | head -50
+      printf '</failure>\n</testcase>\n'
+    done <<EOF
+$NEW_TESTS
+EOF
+    printf '</testsuite>\n</testsuites>\n'
+  } > "$out"
+}
+
+LOG=$(mktemp)
+if [ "$MODE" = "base" ]; then
+  go test ./... -v > "$LOG" 2>&1
+  EXIT=$?
+else
+  go test -tags progressive ./mp4/ -run '^TestProgressive' -v > "$LOG" 2>&1
+  EXIT=$?
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  go-junit-report < "$LOG" > "$OUTPUT_PATH"
+  if [ "$MODE" = "new" ] && ! grep -q '<testcase name="TestProgressive' "$OUTPUT_PATH"; then
+    write_build_failure_xml "$OUTPUT_PATH" "$LOG"
+  fi
+fi
+
+cat "$LOG"
+rm -f "$LOG"
+exit $EXIT
