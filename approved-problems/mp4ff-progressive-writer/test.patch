+func buildEncrypted7c1e4b(t *testing.T, fragSamples [][]mp4.FullSample) []byte {
+	t.Helper()
+	init := mp4.CreateEmptyInit()
+	trak := init.AddEmptyTrack(48000, "audio", "und")
+	if err := trak.SetAACDescriptor(2, 48000); err != nil {
+		t.Fatal(err)
+	}
+	key, err := hex.DecodeString("00112233445566778899aabbccddeeff")
+	if err != nil {
+		t.Fatal(err)
+	}
+	iv, err := hex.DecodeString("0102030405060708")
+	if err != nil {
+		t.Fatal(err)
+	}
+	kid, err := mp4.NewUUIDFromString("11112222-3333-4444-5555-666677778888")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ipd, err := mp4.InitProtect(init, key, iv, "cenc", kid, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	if err := init.Encode(&buf); err != nil {
+		t.Fatal(err)
+	}
+	decTime := uint64(0)
+	nextIV := iv
+	for fragNr, samples := range fragSamples {
+		frag, err := mp4.CreateFragment(uint32(fragNr+1), 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, s := range samples {
+			s.DecodeTime = decTime
+			frag.AddFullSample(s)
+			decTime += uint64(s.Dur)
+		}
+		nextIV, err = mp4.EncryptFragment(frag, key, nextIV, ipd)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := frag.Encode(&buf); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return buf.Bytes()
+}
+
+func inputIVs7c1e4b(t *testing.T, fragData []byte) []mp4.InitializationVector {
+	t.Helper()
+	inFile, err := mp4.DecodeFile(bytes.NewReader(fragData))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ivs []mp4.InitializationVector
+	for _, seg := range inFile.Segments {
+		for _, frag := range seg.Fragments {
+			senc := frag.Moof.Traf.Senc
+			if senc == nil {
+				t.Fatal("no senc box in encrypted fragment")
+			}
+			ivs = append(ivs, senc.IVs...)
+		}
+	}
+	return ivs
+}
