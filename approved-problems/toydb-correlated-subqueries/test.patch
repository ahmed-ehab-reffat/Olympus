+    exec(&db, "UPDATE products SET price = (SELECT COUNT(*) FROM orders WHERE orders.product = products.id)");
+    assert_eq!(query(&db, "SELECT id, price FROM products ORDER BY id"), vec![vec![i(1), i(1)], vec![i(2), i(2)], vec![i(3), i(0)], vec![i(4), i(0)], vec![i(5), i(0)]]);
