+
+#[test]
+fn update_where_in_subquery() {
+    let db = db();
+    exec(&db, "UPDATE products SET category = 9 WHERE id IN (SELECT product FROM orders)");
+    assert_eq!(query(&db, "SELECT id, category FROM products ORDER BY id"), vec![vec![i(1), i(9)], vec![i(2), i(9)], vec![i(3), i(2)], vec![i(4), i(2)], vec![i(5), null()]]);
