+    exec(&db, "UPDATE products SET price = (SELECT MAX(qty) FROM orders) WHERE category = 1");
+    assert_eq!(query(&db, "SELECT id, price FROM products ORDER BY id"), vec![vec![i(1), i(7)], vec![i(2), i(7)], vec![i(3), i(30)], vec![i(4), null()], vec![i(5), i(15)]]);
+}
+
+#[test]
+fn update_set_correlated_subquery() {
