+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:${PATH}"
+
+# Parse arguments position-independently. The platform invokes:
+#   ./test.sh --output_path <path> base|new
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+        base|new) MODE="$1"; shift ;;
+        *) echo "Usage: $0 --output_path <path> base|new"; exit 1 ;;
+    esac
+done
+
+if [ -z "$MODE" ] || [ -z "$OUTPUT_PATH" ]; then
+    echo "Usage: $0 --output_path <path> base|new"
+    exit 1
+fi
+
+# Runs a cargo test command, parses its libtest output, and emits JUnit XML.
+# Includes a build-failure fallback so a compilation error still produces a
+# non-empty report instead of "no test suite results were found".
+run_and_produce_junit() {
+    local output_path="$1"; shift
+    local test_output exit_code=0
+    test_output=$("$@" 2>&1) || exit_code=$?
+    echo "$test_output"
+
+    local passed=0 failed=0 testcases=""
+    while IFS= read -r line; do
+        if [[ "$line" =~ ^test\ (.+)\ \.\.\.\ ok$ ]]; then
+            testcases+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"toydb-test\" />"$'\n'
+            ((passed++)) || true
+        elif [[ "$line" =~ ^test\ (.+)\ \.\.\.\ FAILED$ ]]; then
+            testcases+="    <testcase name=\"${BASH_REMATCH[1]}\" classname=\"toydb-test\"><failure message=\"test failed\"/></testcase>"$'\n'
+            ((failed++)) || true
+        fi
+    done <<< "$test_output"
+
+    # Build-failure fallback: cargo crashed before any test ran.
+    if [ $((passed + failed)) -eq 0 ] && [ $exit_code -ne 0 ]; then
+        local sanitized
+        sanitized=$(printf '%s' "$test_output" | tail -c 4000 \
+            | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+        testcases="    <testcase name=\"compilation\" classname=\"toydb-test\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+        failed=1
+    fi
+
+    mkdir -p "$(dirname "$output_path")"
+    cat > "$output_path" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="toydb-test" tests="$((passed + failed))" failures="${failed}" errors="0">
+${testcases}  </testsuite>
+</testsuites>
+XMLEOF
+    return $exit_code
+}
+
+case "$MODE" in
+    # Base mode runs the full library test suite: every SQL (parser, planner,
+    # optimizer, executor) and storage/MVCC testscript, the regression surface
+    # for this change. The tests/ end-to-end cluster scripts are networked Raft
+    # e2e tests orthogonal to the SQL engine and are not run here.
+    base)
+        run_and_produce_junit "$OUTPUT_PATH" cargo test --lib
+        ;;
+    # New mode runs only the new subquery integration test.
+    new)
+        run_and_produce_junit "$OUTPUT_PATH" cargo test --test predicate_resolution_suite
+        ;;
+esac
