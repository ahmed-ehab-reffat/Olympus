+    fn resolve_uncorrelated(&self, expr: &Expression) -> Result<Expression> {
+        expr.clone().transform(&Ok, &|expr| match expr {
+            // Scalar and EXISTS subqueries yield a single row-independent value.
+            Expression::ScalarSubquery(plan) if !plan.references_outer() => {
+                self.eval_scalar(*plan, None).map(Expression::Constant)
