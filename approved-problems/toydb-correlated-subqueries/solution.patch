+        let needle = needle.evaluate(row)?;
+        let (mut matched, mut unknown) = (false, false);
+        for subrow in self.run_subquery(plan, row)? {
+            let value = subrow.into_iter().next().expect("subquery has one column");
+            match Self::compare(op, &needle, &value)? {
+                // ANY matches on a true comparison; ALL matches (fails) on false.
+                Value::Boolean(result) if result != all => matched = true,
+                Value::Boolean(_) => {}
+                Value::Null => unknown = true,
+                value => return errinput!("subquery comparison returned {value}, expected boolean"),
+            }
+        }
