+    /// for NULL and NAN, by building and evaluating a comparison expression.
+    fn compare(op: &QuantifiedOp, lhs: &Value, rhs: &Value) -> Result<Value> {
+        let lhs = || Box::new(Expression::Constant(lhs.clone()));
+        let rhs = || Box::new(Expression::Constant(rhs.clone()));
+        let expr = match op {
+            QuantifiedOp::Equal => Expression::Equal(lhs(), rhs()),
+            QuantifiedOp::NotEqual => Expression::Not(Box::new(Expression::Equal(lhs(), rhs()))),
+            QuantifiedOp::GreaterThan => Expression::GreaterThan(lhs(), rhs()),
+            QuantifiedOp::GreaterThanOrEqual => {
+                Expression::Or(Expression::GreaterThan(lhs(), rhs()).into(), Expression::Equal(lhs(), rhs()).into())
+            }
+            QuantifiedOp::LessThan => Expression::LessThan(lhs(), rhs()),
+            QuantifiedOp::LessThanOrEqual => {
+                Expression::Or(Expression::LessThan(lhs(), rhs()).into(), Expression::Equal(lhs(), rhs()).into())
+            }
+        };
+        expr.evaluate(None)
+    }
 }
 
