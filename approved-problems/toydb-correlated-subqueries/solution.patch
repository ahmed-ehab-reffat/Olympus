+            Expression::ScalarSubquery(plan) => {
+                self.eval_scalar(*plan, row).map(Expression::Constant)
+            }
+            Expression::Exists(plan) => self.eval_exists(*plan, row).map(Expression::Constant),
+            Expression::Quantified(needle, op, all, plan) => {
+                self.eval_quantified(&needle, &op, all, *plan, row).map(Expression::Constant)
+            }
+            expr => Ok(expr),
+        })
+    }
