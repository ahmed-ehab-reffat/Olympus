+                    .run_subquery(*plan, None)?
+                    .into_iter()
+                    .map(|row| row.into_iter().map(Expression::Constant).collect())
+                    .collect();
+                Ok(Expression::Quantified(needle, op, all, Box::new(Node::Values { rows })))
+            }
