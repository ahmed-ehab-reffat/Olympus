+    /// Outer(level, index) reads the level-th enclosing row from the end of the
+    /// stack. Aggregate expressions are bound too (transform_expressions skips
+    /// them).
+    fn bind_outer(plan: Node, stack: &[Row]) -> Result<Node> {
+        let substitute = |expr: Expression| {
+            expr.transform(&Ok, &|expr| match expr {
+                Expression::Outer(level, index) => {
+                    match stack.len().checked_sub(level + 1).and_then(|i| stack[i].get(index)) {
+                        Some(value) => Ok(Expression::Constant(value.clone())),
+                        None => errinput!("invalid correlated column reference"),
