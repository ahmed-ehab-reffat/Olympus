+func TestParseDefaultArgumentMalformedExpression(t *testing.T) {
+
+	t.Parallel()
+
+	_, validErr := ParseProgram(nil, []byte(`
+      fun f(_ a: Int = 1) {}
+    `), Config{})
+	require.NoError(t, validErr)
+
+	for _, code := range []string{
+		"fun f(_ a: Int = ) {}",
+		"fun f(_ a: Int = *) {}",
+		"fun f(_ a: Int = 1 +) {}",
+		"let g = fun (_ a: Int = ): Int { return a }",
+		"struct S { init(a: Int = ) {} }",
+	} {
+		_, err := ParseProgram(nil, []byte(code), Config{})
+		assert.Error(t, err, code)
+	}
+}
