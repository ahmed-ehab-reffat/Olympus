diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..5d3b6f0
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+
+export GOFLAGS=-buildvcs=false
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+mkdir -p "$GOCACHE"
+
+# `go test -skip` below needs Go 1.20 or later; the base image ships Go 1.26.
+NEW='^(TestParseDefaultArgument|TestCheckDefaultArgument|TestInterpretDefaultArgument)'
+
+# Base mode skips three groups of existing tests.
+# The smoke tests seed their random value generator from the current time
+# (interpreter/values_test.go, -smokeTestSeed defaults to -1), and interpreter.TestStringer
+# adds entries to the map it is ranging over, so how many subtests each generates depends on
+# the seed and on map iteration order, and their reported test set is not stable.
+# parser.TestParseInvalidDefaultArgument asserts that a function declaration and a function
+# expression reject a default argument, which is the behaviour this task changes; the cases
+# which remain valid (transactions and events) are covered by the new parser tests.
+# opcode.TestPrintInstruction keys its table by the expected printed instruction, so each
+# subtest is named after that text; a solution which threads argument information through
+# Invoke renames the subtest and the run is then graded on a node which no longer exists.
+# The printing and decoding of instructions stays covered by TestPrintRecursionFib,
+# TestPrettyInstructionWithResolvableOperands and TestPrettyInstructionMapping.
+SKIP='^(TestParseDefaultArgument|TestCheckDefaultArgument|TestInterpretDefaultArgument|TestInterpretSmokeRandom|TestRandomValueGeneration|TestStringer$|TestParseInvalidDefaultArgument$|TestPrintInstruction$)'
+
+PACKAGES='./ast/... ./parser/... ./sema/... ./interpreter/... ./bbq/... ./stdlib/... ./runtime/...'
+
+run_new() {
+  go test ./parser/ ./sema/ ./interpreter/ -run "$NEW" -json -count=1
+}
+
+run_base() {
+  go test $PACKAGES -skip "$SKIP" -json -count=1
+}
+
+if [ "$MODE" = "new" ]; then
+  RUN=run_new
+else
+  RUN=run_base
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  "$RUN" 2>&1 | go-junit-report -parser gojson -set-exit-code > "$OUTPUT_PATH"
+  exit ${PIPESTATUS[0]}
+fi
+"$RUN"
