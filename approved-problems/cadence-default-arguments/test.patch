+func TestParseDefaultArgumentFunctionDeclaration(t *testing.T) {
+
+	t.Parallel()
+
+	program, err := ParseProgram(nil, []byte(`
+      fun add(_ a: Int, _ b: Int = 2): Int {
+          return a + b
+      }
+    `), Config{})
+
+	require.NoError(t, err)
+
+	declaration := program.FunctionDeclarations()[0]
+	parameters := declaration.ParameterList.Parameters
+
+	require.Len(t, parameters, 2)
+	assert.False(t, parameters[0].HasDefaultArgument())
+	assert.True(t, parameters[1].HasDefaultArgument())
+
+	defaultArgument, ok := parameters[1].DefaultArgument.(*ast.IntegerExpression)
+	require.True(t, ok)
+
+	assert.Equal(t, big.NewInt(2), defaultArgument.Value)
+	assert.Equal(t, []byte("2"), defaultArgument.PositiveLiteral)
+	assert.Equal(t,
+		ast.Position{Line: 2, Column: 35, Offset: 36},
+		defaultArgument.StartPos,
+	)
+	assert.Equal(t,
+		ast.Position{Line: 2, Column: 35, Offset: 36},
+		defaultArgument.EndPos,
+	)
+}
