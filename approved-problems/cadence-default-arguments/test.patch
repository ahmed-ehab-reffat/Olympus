+func TestParseDefaultArgumentJSON(t *testing.T) {
+
+	t.Parallel()
+
+	program, err := ParseProgram(nil, []byte(`
+      fun add(_ a: Int, _ b: Int = 2): Int {
+          return a + b
+      }
+    `), Config{})
+
+	require.NoError(t, err)
+
+	declaration := program.FunctionDeclarations()[0]
+	parameters := declaration.ParameterList.Parameters
+
+	encoded, err := json.Marshal(parameters[1])
+	require.NoError(t, err)
+
+	encodedWithout, err := json.Marshal(parameters[0])
+	require.NoError(t, err)
+
+	// The parameter which declares a default carries the expression,
+	// the one which does not carries nothing extra
+
+	assert.Contains(t, string(encoded), `"IntegerExpression"`)
+	assert.NotContains(t, string(encodedWithout), `"IntegerExpression"`)
+
+	assert.Greater(t, len(encoded), len(encodedWithout))
+}
