+func TestInterpretDefaultArgumentSparseEvaluationOrder(t *testing.T) {
+
+	t.Parallel()
+
+	const code = `
+      let zero = 0
+      let empty: [Int] = []
+
+      fun compose(
+          a: Int = empty[0],
+          b: Int = 2,
+          c: Int = 1 / zero,
+          d: Int = 4,
+      ): Int {
+          return a + b + c + d
+      }
+
+      fun omitsFirstAndThird(): Int {
+          return compose(b: 20, d: 40)
+      }
+
+      fun omitsSecondAndThird(): Int {
+          return compose(a: 10, d: 40)
+      }
+
+      fun omitsSecondAndFourth(): Int {
+          return compose(a: 10, c: 30)
+      }
+    `
+
+	inter := parseCheckAndPrepare(t, code)
+
+	_, firstErr := inter.Invoke("omitsFirstAndThird")
+	require.Error(t, firstErr)
+
+	var indexErr *interpreter.ArrayIndexOutOfBoundsError
+	require.ErrorAs(t, firstErr, &indexErr)
+
+	_, secondErr := inter.Invoke("omitsSecondAndThird")
+	require.Error(t, secondErr)
+
+	var stillIndexErr *interpreter.ArrayIndexOutOfBoundsError
+	require.False(t, errors.As(secondErr, &stillIndexErr))
+
+	var divisionErr values.DivisionByZeroError
+	require.ErrorAs(t, secondErr, &divisionErr)
+
+	value, err := inter.Invoke("omitsSecondAndFourth")
+	require.NoError(t, err)
+
+	AssertValuesEqual(
+		t,
+		inter,
+		interpreter.NewUnmeteredIntValueFromInt64(46),
+		value,
+	)
