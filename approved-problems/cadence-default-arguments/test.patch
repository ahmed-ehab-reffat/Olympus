+func TestInterpretDefaultArgumentEvaluatedInDeclarationOrder(t *testing.T) {
+
+	t.Parallel()
+
+	inter := parseCheckAndPrepare(t, `
+      let zero = 0
+      let empty: [Int] = []
+
+      fun first(_ a: Int = empty[0], _ b: Int = 1 / zero): Int {
+          return a + b
+      }
+
+      fun test(): Int {
+          return first()
+      }
+    `)
+
+	_, err := inter.Invoke("test")
+	require.Error(t, err)
+
+	var indexErr *interpreter.ArrayIndexOutOfBoundsError
+	require.ErrorAs(t, err, &indexErr)
+
+	other := parseCheckAndPrepare(t, `
+      let zero = 0
+      let empty: [Int] = []
+
+      fun second(_ a: Int = 1 / zero, _ b: Int = empty[0]): Int {
+          return a + b
+      }
+
+      fun test(): Int {
+          return second()
+      }
+    `)
+
+	_, otherErr := other.Invoke("test")
+	require.Error(t, otherErr)
+
+	var otherIndexErr *interpreter.ArrayIndexOutOfBoundsError
+	require.False(t, errors.As(otherErr, &otherIndexErr))
+
+	var divisionErr values.DivisionByZeroError
+	require.ErrorAs(t, otherErr, &divisionErr)
+}
