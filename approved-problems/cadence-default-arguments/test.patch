+func TestParseDefaultArgumentFormattingFunctionExpressionAndInitializer(t *testing.T) {
+
+	t.Parallel()
+
+	program, err := ParseProgram(nil, []byte(`
+      let f = fun (x: Int = 3): Int {
+          return x
+      }
+
+      struct S {
+          init(y: Int = 4) {}
+      }
+    `), Config{})
+
+	require.NoError(t, err)
+
+	variableDeclaration := program.VariableDeclarations()[0]
+	functionExpression, ok := variableDeclaration.Value.(*ast.FunctionExpression)
+	require.True(t, ok)
+
+	assert.Equal(t, "(x: Int = 3)", functionExpression.ParameterList.String())
+
+	compositeDeclaration := program.CompositeDeclarations()[0]
+	initializer := compositeDeclaration.Members.Initializers()[0]
+
+	assert.Equal(t,
+		"(y: Int = 4)",
+		initializer.FunctionDeclaration.ParameterList.String(),
+	)
+}
