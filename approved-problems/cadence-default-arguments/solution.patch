+// MinimumArgumentCount returns the number of arguments
+// which a call of a function of this type has to provide.
+// Parameters which declare a default argument may be left off,
+// so the minimum is the number of parameters
+// up to the first one with a default argument.
+// Default arguments are deliberately not part of the type's identity:
+// they belong to the declaration, not to the type.
+func (t *FunctionType) MinimumArgumentCount() int {
+	parameterCount := len(t.Parameters)
+
+	for index, parameter := range t.Parameters {
+		if parameter.DefaultArgument != nil {
+			return min(index, t.Arity.MinCount(parameterCount))
+		}
+	}
+
+	return t.Arity.MinCount(parameterCount)
