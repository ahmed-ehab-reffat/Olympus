+#[test]
+fn a_raw_socket_send_is_also_sized_by_the_learned_path_mtu() {
+    use smoltcp::socket::raw;
+    use smoltcp::wire::IpVersion;
+
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let _sender = bound_udp(&mut sockets);
+
+    let quote = quoted_udp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        FRAG_REQUIRED,
+        900,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(iface.pmtu(REMOTE_V4), 900);
+    device.tx.clear();
+
+    let socket = raw::Socket::new(
+        Some(IpVersion::Ipv4),
+        Some(IpProtocol::Udp),
+        raw::PacketBuffer::new(vec![raw::PacketMetadata::EMPTY; 4], vec![0; 4096]),
+        raw::PacketBuffer::new(vec![raw::PacketMetadata::EMPTY; 4], vec![0; 4096]),
+    );
+    let handle = sockets.add(socket);
+
+    // A complete IPv4 packet of 1200 bytes, which is under the interface MTU but over the
+    // size this destination now accepts.
+    let payload_len = 1200 - 20 - 8;
+    let repr = UdpRepr {
+        src_port: LOCAL_PORT,
+        dst_port: REMOTE_PORT,
+    };
+    let ip_repr = Ipv4Repr {
+        src_addr: LOCAL_V4,
+        dst_addr: REMOTE_V4,
+        next_header: IpProtocol::Udp,
+        payload_len: repr.header_len() + payload_len,
+        hop_limit: 64,
+    };
+    let mut packet = vec![0; ip_repr.buffer_len() + repr.header_len() + payload_len];
+    ip_repr.emit(
+        &mut Ipv4Packet::new_unchecked(&mut packet),
+        &ChecksumCapabilities::default(),
+    );
+    repr.emit(
+        &mut UdpPacket::new_unchecked(&mut packet[ip_repr.buffer_len()..]),
+        &LOCAL_V4.into(),
+        &REMOTE_V4.into(),
+        payload_len,
+        |buf| buf.fill(0x77),
+        &ChecksumCapabilities::default(),
+    );
+    sockets
+        .get_mut::<raw::Socket>(handle)
+        .send_slice(&packet)
+        .unwrap();
+
+    let mut now = Instant::ZERO;
+    for _ in 0..8 {
+        iface.poll(now, &mut device, &mut sockets);
+        now += Duration::from_millis(1);
+    }
+
+    assert!(device.tx.len() >= 2, "the raw packet was not fragmented");
+    for frame in device.tx.iter() {
+        let ip = Ipv4Packet::new_checked(frame).unwrap();
+        assert!(
+            ip.total_len() as usize <= 900,
+            "a frame of {} bytes was sent to a path with an MTU of 900",
+            ip.total_len()
+        );
+    }
+}
