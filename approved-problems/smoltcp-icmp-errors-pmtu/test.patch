+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .send_slice(&[0x44; 100])
+        .unwrap();
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    device.tx.clear();
+
+    // Both ports survive the truncation but the sequence number does not, so there is no
+    // way to tell whether this quotes something the socket still has outstanding.
+    let mut quote = quoted_tcp_v6(local, remote, LOCAL_PORT, REMOTE_PORT, base);
+    quote.truncate(40 + 4);
+    device
+        .rx
+        .push_back(icmpv6_error(remote, local, 1, 4, 0, &quote));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    let socket = sockets.get_mut::<tcp::Socket>(handle);
+    assert_eq!(socket.state(), tcp::State::Established);
+    assert_eq!(socket.take_error(), None);
