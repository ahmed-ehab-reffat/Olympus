+#[test]
+fn ipv6_segments_shrink_to_the_learned_path_mtu() {
+    let local = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 1);
+    let remote = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 2);
+
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, _base) = connected_v6(&mut iface, &mut device, &mut sockets, local, remote);
+
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .send_slice(&[0x61; 16384])
+        .unwrap();
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    let first = device.tx.pop_front().expect("no data segment was sent");
+    let first_len = first.len();
+    assert!(
+        first_len > 1300,
+        "the first segment already fitted the path MTU the error is about"
+    );
+    let seq = tcp_of_v6(&first).seq_number;
+    device.tx.clear();
+
+    let quote = quoted_tcp_v6(local, remote, LOCAL_PORT, REMOTE_PORT, seq);
+    device
+        .rx
+        .push_back(icmpv6_packet_too_big(remote, local, 1300, &quote));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(iface.pmtu(remote), 1300);
+    device.tx.clear();
+
+    let mut now = Instant::ZERO;
+    for _ in 0..40 {
+        now += Duration::from_millis(250);
+        iface.poll(now, &mut device, &mut sockets);
+        if !device.tx.is_empty() {
+            break;
+        }
+    }
+
+    assert!(!device.tx.is_empty(), "nothing was retransmitted");
+    for frame in device.tx.iter() {
+        assert!(
+            frame.len() <= 1300,
+            "a segment of {} bytes was sent to a path with an MTU of 1300",
+            frame.len()
+        );
+    }
+}
