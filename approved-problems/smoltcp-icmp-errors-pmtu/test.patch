new file mode 100755
index 0000000..c64723f
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,109 @@
+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+NEW_TEST=icmp_errors_7be31c
+LOG=$(mktemp)
+XML=$(mktemp)
+
+emit_case() {
+  name=$1
+  status=$2
+  if [ "$status" = ok ]; then
+    printf '<testcase name="%s" classname="smoltcp"/>\n' "$name" >> "$XML"
+  else
+    printf '<testcase name="%s" classname="smoltcp"><failure message="test failed"/></testcase>\n' "$name" >> "$XML"
+  fi
+}
+
+# Turn the lines cargo test prints for each test into JUnit test cases. Doc test names
+# carry spaces and angle brackets, so the name is escaped before it goes into the XML.
+collect_results() {
+  awk '
+    /^test .* \.\.\. / {
+      line = $0
+      sub(/^test /, "", line)
+      idx = index(line, " ... ")
+      name = substr(line, 1, idx - 1)
+      status = substr(line, idx + 5)
+      sub(/ .*$/, "", status)
+      gsub(/&/, "\\&amp;", name)
+      gsub(/</, "\\&lt;", name)
+      gsub(/>/, "\\&gt;", name)
+      gsub(/"/, "\\&quot;", name)
+      if (status == "ok" || status == "ignored")
+        printf "<testcase name=\"%s\" classname=\"smoltcp\"/>\n", name
+      else
+        printf "<testcase name=\"%s\" classname=\"smoltcp\"><failure message=\"test failed\"/></testcase>\n", name
+    }
+  ' "$LOG" >> "$XML"
+}
+
+# A compilation failure produces no per-test lines at all, so write one failing case
+# per test function instead, otherwise the run looks like it had no tests.
+synthesize_failures() {
+  for name in $(awk '/^#\[test\]/ { want = 1; next } want && /^fn / { sub(/^fn /, ""); sub(/\(.*$/, ""); print; want = 0 }' "tests/$NEW_TEST.rs"); do
+    emit_case "$name" failed
+  done
+}
+
+: > "$XML"
+
+if [ "$MODE" = new ]; then
+  cargo test --offline --test "$NEW_TEST" > "$LOG" 2>&1
+  EXIT_CODE=$?
+  collect_results
+  if ! grep -q '<testcase' "$XML"; then
+    synthesize_failures
+    EXIT_CODE=1
+  fi
+else
+  # The library's own unit tests. Two suites are deliberately left out:
+  #
+  # - Doc tests. Rustdoc names them after the line the example starts on, so inserting
+  #   a single line anywhere above one renames it. Any solution to this task edits
+  #   src/socket/tcp.rs, which moves the `connect` example, and a regression check keyed
+  #   on test names would read that rename as a failure no matter what the code does.
+  # - tests/netsim.rs, the one integration test the repo ships, which is behind the
+  #   `_netsim` feature and is not built by default.
+  cargo test --offline --lib > "$LOG" 2>&1
+  EXIT_CODE=$?
+  collect_results
+  if ! grep -q '<testcase' "$XML"; then
+    emit_case "build" failed
+    EXIT_CODE=1
+  fi
+fi
+
+cat "$LOG"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  TOTAL=$(grep -c '<testcase' "$XML")
+  FAILURES=$(grep -c '<failure' "$XML")
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites name="smoltcp" tests="%s" failures="%s" errors="0" time="0">\n' "$TOTAL" "$FAILURES"
+    printf '<testsuite name="smoltcp" tests="%s" failures="%s" errors="0" time="0">\n' "$TOTAL" "$FAILURES"
+    sort "$XML"
+    printf '</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+fi
+
+rm -f "$LOG" "$XML"
+exit "$EXIT_CODE"
