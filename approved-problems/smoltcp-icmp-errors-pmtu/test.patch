+#[test]
+fn a_learned_ipv6_path_mtu_constrains_what_is_sent() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+
+    let local = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 1);
+    let remote = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 2);
+
+    let socket = udp::Socket::new(
+        udp::PacketBuffer::new(vec![udp::PacketMetadata::EMPTY; 4], vec![0; 4096]),
+        udp::PacketBuffer::new(vec![udp::PacketMetadata::EMPTY; 4], vec![0; 4096]),
+    );
+    let handle = sockets.add(socket);
+    sockets
+        .get_mut::<udp::Socket>(handle)
+        .bind(LOCAL_PORT)
+        .unwrap();
+
+    let quote = quoted_udp_v6(local, remote, LOCAL_PORT, REMOTE_PORT);
+    device
+        .rx
+        .push_back(icmpv6_packet_too_big(remote, local, 1300, &quote));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(iface.pmtu(remote), 1300);
+    device.tx.clear();
+
+    let mut now = Instant::ZERO;
+    let mut run = |iface: &mut Interface, device: &mut TestDevice, sockets: &mut SocketSet| {
+        for _ in 0..8 {
+            iface.poll(now, device, sockets);
+            now += Duration::from_millis(1);
+        }
+    };
+
+    // A datagram that fits the learned size still goes out.
+    sockets
+        .get_mut::<udp::Socket>(handle)
+        .send_slice(&[0x21; 1000], (remote, REMOTE_PORT))
+        .unwrap();
+    run(&mut iface, &mut device, &mut sockets);
+    assert!(!device.tx.is_empty(), "a datagram within the path MTU was not sent");
+    for frame in device.tx.iter() {
+        assert!(frame.len() <= 1300);
+    }
+    device.tx.clear();
+
+    // One that does not fit must not go out over that path at its full size.
+    sockets
+        .get_mut::<udp::Socket>(handle)
+        .send_slice(&[0x22; 1400], (remote, REMOTE_PORT))
+        .unwrap();
+    run(&mut iface, &mut device, &mut sockets);
+    for frame in device.tx.iter() {
+        assert!(
+            frame.len() <= 1300,
+            "a frame of {} bytes was sent to a path with an MTU of 1300",
+            frame.len()
+        );
+    }
+
+    // Whether that datagram is dropped or held back until the path grows again is not
+    // something this task decides, so nothing is asserted about it beyond its size.
+}
