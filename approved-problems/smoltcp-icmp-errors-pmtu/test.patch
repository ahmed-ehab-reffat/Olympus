+#[test]
+fn segments_shrink_to_the_learned_path_mtu() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, _seq) = connected(&mut iface, &mut device, &mut sockets, Instant::ZERO);
+
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .send_slice(&[0x42; 16384])
+        .unwrap();
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    let first = device.tx.pop_front().expect("no data segment was sent");
+    let first_len = Ipv4Packet::new_checked(&first).unwrap().total_len() as usize;
+    assert!(
+        first_len <= IFACE_MTU,
+        "a segment of {first_len} bytes was sent over a link with an MTU of {IFACE_MTU}"
+    );
+    assert!(
+        first_len > 900,
+        "this segment is already within the path MTU the error is about, so shrinking it \
+         would prove nothing"
+    );
+    device.tx.clear();
+
+    let quote = quoted_tcp(
+        LOCAL_V4,
+        REMOTE_V4,
+        LOCAL_PORT,
+        REMOTE_PORT,
+        tcp_of(&first).seq_number,
+    );
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        FRAG_REQUIRED,
+        900,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(iface.pmtu(REMOTE_V4), 900);
+
+    // The socket that sent the segment is told about it, like any other sender.
+    let socket = sockets.get_mut::<tcp::Socket>(handle);
+    assert_eq!(socket.take_error(), Some(IcmpError::PacketTooBig { mtu: 900 }));
+    assert_eq!(socket.take_error(), None);
+    device.tx.clear();
+
+    // The whole window is retransmitted after the retransmission timer expires, and
+    // every segment of it has to fit the path the error came from.
+    let mut now = Instant::ZERO;
+    for _ in 0..40 {
+        now += Duration::from_millis(250);
+        iface.poll(now, &mut device, &mut sockets);
+        if !device.tx.is_empty() {
+            break;
+        }
+    }
+
+    let resent = device.tx.pop_front().expect("nothing was retransmitted");
+    assert!(
+        Ipv4Packet::new_checked(&resent).unwrap().total_len() as usize <= 900,
+        "a segment of {} bytes was sent to a path with an MTU of 900",
+        Ipv4Packet::new_checked(&resent).unwrap().total_len()
+    );
+    for frame in device.tx.iter() {
+        assert!(Ipv4Packet::new_checked(frame).unwrap().total_len() as usize <= 900);
+    }
+}
