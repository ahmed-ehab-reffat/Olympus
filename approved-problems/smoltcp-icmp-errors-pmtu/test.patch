+/// An established connection whose outstanding data runs past the largest sequence number
+/// and wraps around, plus the sequence number of the first outstanding byte.
+///
+/// The initial sequence number is random, so this looks for one that starts close enough
+/// below the top of the space. Every `connect` draws a fresh one from the interface, so a
+/// single interface yields many candidates without rebuilding anything.
+#[allow(clippy::type_complexity)]
+fn connected_across_the_wrap(
+    queued: usize,
+    sent: usize,
+) -> (
+    Interface,
+    TestDevice,
+    SocketSet<'static>,
+    smoltcp::iface::SocketHandle,
+    TcpSeqNumber,
+) {
+    for seed in 0..64u64 {
+        let mut device = TestDevice::new();
+        let mut config = Config::new(HardwareAddress::Ip);
+        config.random_seed = seed;
+        let mut iface = Interface::new(config, &mut device, Instant::ZERO);
+        iface.update_ip_addrs(|addrs| {
+            addrs.push(IpCidr::new(LOCAL_V4.into(), 24)).unwrap();
+        });
+
+        let mut sockets = SocketSet::new(vec![]);
+        let socket = tcp::Socket::new(
+            tcp::SocketBuffer::new(vec![0; 4096]),
+            tcp::SocketBuffer::new(vec![0; queued]),
+        );
+        let handle = sockets.add(socket);
+
+        for _ in 0..8192 {
+            sockets.get_mut::<tcp::Socket>(handle).abort();
+            iface.poll(Instant::ZERO, &mut device, &mut sockets);
+            device.tx.clear();
+
+            sockets
+                .get_mut::<tcp::Socket>(handle)
+                .connect(iface.context(), (REMOTE_V4, REMOTE_PORT), LOCAL_PORT)
+                .unwrap();
+            iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+            let Some(syn) = device.tx.pop_front() else {
+                continue;
+            };
+            device.tx.clear();
+            let isn = tcp_of(&syn).seq_number;
+            let base = isn + 1;
+
+            // Read as plain numbers, the window starts high and ends low: it went round.
+            if !(base.0 > 0 && (base + sent).0 < 0) {
+                continue;
+            }
+
+            let reply = tcp_packet(
+                REMOTE_V4,
+                LOCAL_V4,
+                TcpRepr {
+                    src_port: REMOTE_PORT,
+                    dst_port: LOCAL_PORT,
+                    control: smoltcp::wire::TcpControl::Syn,
+                    seq_number: TcpSeqNumber(0x4000),
+                    ack_number: Some(isn + 1),
+                    window_len: 65535,
+                    window_scale: None,
+                    max_seg_size: Some(1460),
+                    sack_permitted: false,
+                    sack_ranges: [None, None, None],
+                    timestamp: None,
+                    payload: &[],
+                },
+            );
+            device.rx.push_back(reply);
+            iface.poll(Instant::ZERO, &mut device, &mut sockets);
+            device.tx.clear();
+            assert_eq!(
+                sockets.get::<tcp::Socket>(handle).state(),
+                tcp::State::Established
+            );
+            return (iface, device, sockets, handle, base);
+        }
+    }
+    panic!("no initial sequence number put the outstanding window across the wrap");
+}
+
+#[test]
+fn a_send_window_that_crosses_the_wrap_is_still_matched_correctly() {
+    const QUEUED: usize = 1 << 20;
+    // One full window of data goes out on the first poll; the outstanding range has to
+    // cross the wrap, so ask for a little less than that to leave room.
+    const SENT: usize = 60_000;
+
+    let (mut iface, mut device, mut sockets, handle, base) =
+        connected_across_the_wrap(QUEUED, SENT);
+
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .send_slice(&vec![0x5a; QUEUED])
+        .unwrap();
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    device.tx.clear();
+
+    // Both of these are outstanding, but the far one has gone past the largest sequence
+    // number and reads as a smaller number than the near one.
+    for offset in [0usize, SENT - 1] {
+        let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, base + offset);
+        device.rx.push_back(icmpv4_error(
+            ROUTER_V4,
+            DST_UNREACHABLE,
+            HOST_UNREACHABLE,
+            0,
+            &quote,
+        ));
+        iface.poll(Instant::ZERO, &mut device, &mut sockets);
+        assert_eq!(
+            sockets.get_mut::<tcp::Socket>(handle).take_error(),
+            Some(IcmpError::HostUnreachable),
+            "sequence {offset} bytes into a window that crosses the wrap"
+        );
+    }
+
+    // Just below the window, which has also wrapped, and so is still not outstanding.
+    let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, base - 1);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        HOST_UNREACHABLE,
+        0,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(sockets.get_mut::<tcp::Socket>(handle).take_error(), None);
+}
