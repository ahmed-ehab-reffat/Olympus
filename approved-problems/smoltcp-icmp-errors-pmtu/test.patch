+#[test]
+fn an_ipv6_router_that_reports_no_mtu_walks_down_to_the_ipv6_floor() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let _sender = bound_udp(&mut sockets);
+
+    let local = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 1);
+    let remote = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 2);
+    let quote = quoted_udp_v6(local, remote, LOCAL_PORT, REMOTE_PORT);
+
+    // The zero rule is the same for both families; only the floor it stops at differs.
+    for expected in [1492usize, 1280, 1280] {
+        device
+            .rx
+            .push_back(icmpv6_packet_too_big(remote, local, 0, &quote));
+        iface.poll(Instant::ZERO, &mut device, &mut sockets);
+        assert_eq!(iface.pmtu(remote), expected);
+    }
