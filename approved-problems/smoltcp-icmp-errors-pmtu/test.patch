+fn tcp_of_v6(frame: &[u8]) -> TcpRepr<'_> {
+    let ip = Ipv6Packet::new_checked(frame).expect("not an IPv6 packet");
+    assert_eq!(ip.next_header(), IpProtocol::Tcp);
+    let tcp = TcpPacket::new_checked(&frame[40..][..ip.payload_len() as usize])
+        .expect("not a TCP packet");
+    TcpRepr::parse(
+        &tcp,
+        &ip.src_addr().into(),
+        &ip.dst_addr().into(),
+        &ChecksumCapabilities::default(),
+    )
+    .expect("malformed TCP packet")
+}
+
+/// The IPv6 header plus the first eight bytes of a TCP segment this stack would have sent.
+fn quoted_tcp_v6(
+    src: Ipv6Address,
+    dst: Ipv6Address,
+    src_port: u16,
+    dst_port: u16,
+    seq: TcpSeqNumber,
+) -> Vec<u8> {
+    let ip_repr = Ipv6Repr {
+        src_addr: src,
+        dst_addr: dst,
+        next_header: IpProtocol::Tcp,
+        payload_len: 8,
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + 8];
+    ip_repr.emit(&mut Ipv6Packet::new_unchecked(&mut frame));
+    frame[40..42].copy_from_slice(&src_port.to_be_bytes());
+    frame[42..44].copy_from_slice(&dst_port.to_be_bytes());
+    frame[44..48].copy_from_slice(&(seq.0 as u32).to_be_bytes());
+    frame
+}
