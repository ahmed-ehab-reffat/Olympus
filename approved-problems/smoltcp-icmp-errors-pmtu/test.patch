+++ b/tests/icmp_errors_7be31c.rs
@@ -0,0 +1,3134 @@
+use std::collections::VecDeque;
+
+use smoltcp::iface::{Config, Interface, SocketSet};
+use smoltcp::phy::{self, ChecksumCapabilities, Device, DeviceCapabilities, Medium};
+use smoltcp::socket::{tcp, udp, IcmpError};
+use smoltcp::time::{Duration, Instant};
+use smoltcp::wire::{
+    HardwareAddress, IpAddress, IpCidr, IpProtocol, Ipv4Address, Ipv4Packet, Ipv4Repr, Ipv6Address,
+    Ipv6Cidr, Ipv6Packet, Ipv6Repr, TcpPacket, TcpRepr, TcpSeqNumber, UdpPacket, UdpRepr,
+};
+
+const LOCAL_V4: Ipv4Address = Ipv4Address::new(192, 168, 1, 1);
+const REMOTE_V4: Ipv4Address = Ipv4Address::new(192, 168, 1, 2);
+const OTHER_V4: Ipv4Address = Ipv4Address::new(192, 168, 1, 3);
+const ROUTER_V4: Ipv4Address = Ipv4Address::new(192, 168, 1, 254);
+
+const LOCAL_PORT: u16 = 49500;
+const REMOTE_PORT: u16 = 80;
+
+const IFACE_MTU: usize = 1500;
+
+struct TestDevice {
+    rx: VecDeque<Vec<u8>>,
+    tx: VecDeque<Vec<u8>>,
+}
+
+impl TestDevice {
+    fn new() -> Self {
+        Self {
+            rx: VecDeque::new(),
+            tx: VecDeque::new(),
+        }
+    }
+}
+
+impl Device for TestDevice {
+    type RxToken<'a> = RxToken;
+    type TxToken<'a> = TxToken<'a>;
+
+    fn capabilities(&self) -> DeviceCapabilities {
+        let mut caps = DeviceCapabilities::default();
+        caps.max_transmission_unit = IFACE_MTU;
+        caps.medium = Medium::Ip;
+        caps.checksum = ChecksumCapabilities::default();
+        caps
+    }
+
+    fn receive(&mut self, _timestamp: Instant) -> Option<(Self::RxToken<'_>, Self::TxToken<'_>)> {
+        let buffer = self.rx.pop_front()?;
+        Some((RxToken { buffer }, TxToken { queue: &mut self.tx }))
+    }
+
+    fn transmit(&mut self, _timestamp: Instant) -> Option<Self::TxToken<'_>> {
+        Some(TxToken { queue: &mut self.tx })
+    }
+}
+
+struct RxToken {
+    buffer: Vec<u8>,
+}
+
+impl phy::RxToken for RxToken {
+    fn consume<R, F>(self, f: F) -> R
+    where
+        F: FnOnce(&[u8]) -> R,
+    {
+        f(&self.buffer)
+    }
+}
+
+struct TxToken<'a> {
+    queue: &'a mut VecDeque<Vec<u8>>,
+}
+
+impl phy::TxToken for TxToken<'_> {
+    fn consume<R, F>(self, len: usize, f: F) -> R
+    where
+        F: FnOnce(&mut [u8]) -> R,
+    {
+        let mut buffer = vec![0; len];
+        let result = f(&mut buffer);
+        self.queue.push_back(buffer);
+        result
+    }
+}
+
+fn setup() -> (Interface, TestDevice) {
+    let mut device = TestDevice::new();
+    let config = Config::new(HardwareAddress::Ip);
+    let mut iface = Interface::new(config, &mut device, Instant::ZERO);
+    iface.update_ip_addrs(|addrs| {
+        addrs.push(IpCidr::new(LOCAL_V4.into(), 24)).unwrap();
+        addrs
+            .push(IpCidr::Ipv6(Ipv6Cidr::new(
+                Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 1),
+                64,
+            )))
+            .unwrap();
+    });
+    (iface, device)
+}
+
+/// A TCP socket that has completed its handshake with `REMOTE_V4`, plus the sequence
+/// number the local side will use for its first data byte.
+fn connected(
+    iface: &mut Interface,
+    device: &mut TestDevice,
+    sockets: &mut SocketSet,
+    now: Instant,
+) -> (smoltcp::iface::SocketHandle, TcpSeqNumber) {
+    let socket = tcp::Socket::new(
+        tcp::SocketBuffer::new(vec![0; 4096]),
+        tcp::SocketBuffer::new(vec![0; 65535]),
+    );
+    let handle = sockets.add(socket);
+
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .connect(iface.context(), (REMOTE_V4, REMOTE_PORT), LOCAL_PORT)
+        .unwrap();
+
+    iface.poll(now, device, sockets);
+    let syn = device.tx.pop_front().expect("no SYN was sent");
+    let local_isn = tcp_of(&syn).seq_number;
+
+    let reply = tcp_packet(
+        REMOTE_V4,
+        LOCAL_V4,
+        TcpRepr {
+            src_port: REMOTE_PORT,
+            dst_port: LOCAL_PORT,
+            control: smoltcp::wire::TcpControl::Syn,
+            seq_number: TcpSeqNumber(0x4000),
+            ack_number: Some(local_isn + 1),
+            window_len: 65535,
+            window_scale: None,
+            max_seg_size: Some(1460),
+            sack_permitted: false,
+            sack_ranges: [None, None, None],
+            timestamp: None,
+            payload: &[],
+        },
+    );
+    device.rx.push_back(reply);
+    iface.poll(now, device, sockets);
+    device.tx.clear();
+
+    assert_eq!(
+        sockets.get::<tcp::Socket>(handle).state(),
+        tcp::State::Established
+    );
+    (handle, local_isn + 1)
+}
+
+
+/// An established connection that has sent `bytes` it has not had acknowledged, plus the
+/// sequence number of the first of them.
+fn connected_with_data_in_flight(
+    iface: &mut Interface,
+    device: &mut TestDevice,
+    sockets: &mut SocketSet,
+    bytes: usize,
+) -> (smoltcp::iface::SocketHandle, TcpSeqNumber) {
+    let (handle, base) = connected(iface, device, sockets, Instant::ZERO);
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .send_slice(&vec![0x33; bytes])
+        .unwrap();
+    iface.poll(Instant::ZERO, device, sockets);
+    device.tx.clear();
+    (handle, base)
+}
+
+fn tcp_of(frame: &[u8]) -> TcpRepr<'_> {
+    let ip = Ipv4Packet::new_checked(frame).expect("not an IPv4 packet");
+    assert_eq!(ip.next_header(), IpProtocol::Tcp);
+    let payload_len = ip.total_len() as usize - ip.header_len() as usize;
+    let tcp = TcpPacket::new_checked(&frame[ip.header_len() as usize..][..payload_len])
+        .expect("not a TCP packet");
+    TcpRepr::parse(
+        &tcp,
+        &ip.src_addr().into(),
+        &ip.dst_addr().into(),
+        &ChecksumCapabilities::default(),
+    )
+    .expect("malformed TCP packet")
+}
+
+fn tcp_packet(src: Ipv4Address, dst: Ipv4Address, repr: TcpRepr<'_>) -> Vec<u8> {
+    let ip_repr = Ipv4Repr {
+        src_addr: src,
+        dst_addr: dst,
+        next_header: IpProtocol::Tcp,
+        payload_len: repr.buffer_len(),
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + repr.buffer_len()];
+    ip_repr.emit(
+        &mut Ipv4Packet::new_unchecked(&mut frame),
+        &ChecksumCapabilities::default(),
+    );
+    repr.emit(
+        &mut TcpPacket::new_unchecked(&mut frame[ip_repr.buffer_len()..]),
+        &src.into(),
+        &dst.into(),
+        &ChecksumCapabilities::default(),
+    );
+    frame
+}
+
+/// The IPv4 header plus the first eight bytes of the transport header of a TCP segment
+/// this stack would have sent, which is all an ICMP error is required to quote.
+fn quoted_tcp(src: Ipv4Address, dst: Ipv4Address, src_port: u16, dst_port: u16, seq: TcpSeqNumber) -> Vec<u8> {
+    let repr = TcpRepr {
+        src_port,
+        dst_port,
+        control: smoltcp::wire::TcpControl::None,
+        seq_number: seq,
+        ack_number: None,
+        window_len: 1024,
+        window_scale: None,
+        max_seg_size: None,
+        sack_permitted: false,
+        sack_ranges: [None, None, None],
+        timestamp: None,
+        payload: &[],
+    };
+    let mut frame = tcp_packet(src, dst, repr);
+    frame.truncate(20 + 8);
+    frame
+}
+
+fn quoted_udp(src: Ipv4Address, dst: Ipv4Address, src_port: u16, dst_port: u16) -> Vec<u8> {
+    let repr = UdpRepr {
+        src_port,
+        dst_port,
+    };
+    let ip_repr = Ipv4Repr {
+        src_addr: src,
+        dst_addr: dst,
+        next_header: IpProtocol::Udp,
+        payload_len: repr.header_len(),
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + repr.header_len()];
+    ip_repr.emit(
+        &mut Ipv4Packet::new_unchecked(&mut frame),
+        &ChecksumCapabilities::default(),
+    );
+    repr.emit(
+        &mut UdpPacket::new_unchecked(&mut frame[ip_repr.buffer_len()..]),
+        &src.into(),
+        &dst.into(),
+        0,
+        |_| {},
+        &ChecksumCapabilities::default(),
+    );
+    frame.truncate(20 + 8);
+    frame
+}
+
+/// The IPv6 header plus the first eight bytes of a UDP datagram this stack would have
+/// sent, which is all an ICMPv6 error is required to quote.
+fn quoted_udp_v6(src: Ipv6Address, dst: Ipv6Address, src_port: u16, dst_port: u16) -> Vec<u8> {
+    let ip_repr = Ipv6Repr {
+        src_addr: src,
+        dst_addr: dst,
+        next_header: IpProtocol::Udp,
+        payload_len: 8,
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + 8];
+    ip_repr.emit(&mut Ipv6Packet::new_unchecked(&mut frame));
+    let header_len = ip_repr.buffer_len();
+    frame[header_len..header_len + 2].copy_from_slice(&src_port.to_be_bytes());
+    frame[header_len + 2..header_len + 4].copy_from_slice(&dst_port.to_be_bytes());
+    frame
+}
+
+/// An ICMPv4 error message carrying `quote`, with the raw type, code and next-hop MTU
+/// fields written by hand so that messages routers really send can be reproduced.
+fn icmpv4_error(from: Ipv4Address, msg_type: u8, code: u8, next_hop_mtu: u16, quote: &[u8]) -> Vec<u8> {
+    let icmp_len = 8 + quote.len();
+    let ip_repr = Ipv4Repr {
+        src_addr: from,
+        dst_addr: LOCAL_V4,
+        next_header: IpProtocol::Icmp,
+        payload_len: icmp_len,
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + icmp_len];
+    ip_repr.emit(
+        &mut Ipv4Packet::new_unchecked(&mut frame),
+        &ChecksumCapabilities::default(),
+    );
+
+    let icmp = &mut frame[ip_repr.buffer_len()..];
+    icmp[0] = msg_type;
+    icmp[1] = code;
+    icmp[6..8].copy_from_slice(&next_hop_mtu.to_be_bytes());
+    icmp[8..].copy_from_slice(quote);
+
+    let checksum = checksum(icmp);
+    icmp[2..4].copy_from_slice(&checksum.to_be_bytes());
+    frame
+}
+
+fn icmpv6_packet_too_big(from: Ipv6Address, to: Ipv6Address, mtu: u32, quote: &[u8]) -> Vec<u8> {
+    icmpv6_error(from, to, 2, 0, mtu, quote)
+}
+
+/// An ICMPv6 error message carrying `quote`. `word` is the four bytes that follow the
+/// checksum, which hold the MTU of a "packet too big" and the pointer of a
+/// "parameter problem".
+fn icmpv6_error(
+    from: Ipv6Address,
+    to: Ipv6Address,
+    msg_type: u8,
+    code: u8,
+    word: u32,
+    quote: &[u8],
+) -> Vec<u8> {
+    let icmp_len = 8 + quote.len();
+    let ip_repr = Ipv6Repr {
+        src_addr: from,
+        dst_addr: to,
+        next_header: IpProtocol::Icmpv6,
+        payload_len: icmp_len,
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + icmp_len];
+    ip_repr.emit(&mut Ipv6Packet::new_unchecked(&mut frame));
+
+    let icmp = &mut frame[ip_repr.buffer_len()..];
+    icmp[0] = msg_type;
+    icmp[1] = code;
+    icmp[4..8].copy_from_slice(&word.to_be_bytes());
+    icmp[8..].copy_from_slice(quote);
+
+    let checksum = icmpv6_checksum(&from, &to, icmp);
+    icmp[2..4].copy_from_slice(&checksum.to_be_bytes());
+    frame
+}
+
+fn checksum(data: &[u8]) -> u16 {
+    let mut sum = 0u32;
+    let mut chunks = data.chunks_exact(2);
+    for chunk in &mut chunks {
+        sum += u16::from_be_bytes([chunk[0], chunk[1]]) as u32;
+    }
+    if let Some(&last) = chunks.remainder().first() {
+        sum += (last as u32) << 8;
+    }
+    while sum >> 16 != 0 {
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    !(sum as u16)
+}
+
+fn icmpv6_checksum(src: &Ipv6Address, dst: &Ipv6Address, icmp: &[u8]) -> u16 {
+    let mut pseudo = Vec::new();
+    pseudo.extend_from_slice(&src.octets());
+    pseudo.extend_from_slice(&dst.octets());
+    pseudo.extend_from_slice(&(icmp.len() as u32).to_be_bytes());
+    pseudo.extend_from_slice(&[0, 0, 0, 58]);
+    pseudo.extend_from_slice(icmp);
+    checksum(&pseudo)
+}
+
+const DST_UNREACHABLE: u8 = 3;
+const TIME_EXCEEDED: u8 = 11;
+
+const NET_UNREACHABLE: u8 = 0;
+const HOST_UNREACHABLE: u8 = 1;
+const PROTO_UNREACHABLE: u8 = 2;
+const PORT_UNREACHABLE: u8 = 3;
+const FRAG_REQUIRED: u8 = 4;
+
+fn connecting(
+    iface: &mut Interface,
+    device: &mut TestDevice,
+    sockets: &mut SocketSet,
+) -> (smoltcp::iface::SocketHandle, TcpSeqNumber) {
+    let socket = tcp::Socket::new(
+        tcp::SocketBuffer::new(vec![0; 4096]),
+        tcp::SocketBuffer::new(vec![0; 4096]),
+    );
+    let handle = sockets.add(socket);
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .connect(iface.context(), (REMOTE_V4, REMOTE_PORT), LOCAL_PORT)
+        .unwrap();
+    iface.poll(Instant::ZERO, device, sockets);
+    let syn = device.tx.pop_front().expect("no SYN was sent");
+    let seq = tcp_of(&syn).seq_number;
+    assert_eq!(
+        sockets.get::<tcp::Socket>(handle).state(),
+        tcp::State::SynSent
+    );
+    (handle, seq)
+}
+
+#[test]
+fn host_unreachable_aborts_a_connection_attempt() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, seq) = connecting(&mut iface, &mut device, &mut sockets);
+
+    let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, seq);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        HOST_UNREACHABLE,
+        0,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    let socket = sockets.get_mut::<tcp::Socket>(handle);
+    assert_eq!(socket.state(), tcp::State::Closed);
+    assert_eq!(socket.take_error(), Some(IcmpError::HostUnreachable));
+    assert_eq!(socket.take_error(), None);
+}
+
+#[test]
+fn every_unreachable_reason_aborts_a_connection_attempt() {
+    for (code, expected) in [
+        (NET_UNREACHABLE, IcmpError::NetUnreachable),
+        (HOST_UNREACHABLE, IcmpError::HostUnreachable),
+        (PROTO_UNREACHABLE, IcmpError::ProtoUnreachable),
+        (PORT_UNREACHABLE, IcmpError::PortUnreachable),
+    ] {
+        let (mut iface, mut device) = setup();
+        let mut sockets = SocketSet::new(vec![]);
+        let (handle, seq) = connecting(&mut iface, &mut device, &mut sockets);
+
+        let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, seq);
+        device
+            .rx
+            .push_back(icmpv4_error(ROUTER_V4, DST_UNREACHABLE, code, 0, &quote));
+        iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+        let socket = sockets.get_mut::<tcp::Socket>(handle);
+        assert_eq!(socket.state(), tcp::State::Closed);
+        assert_eq!(socket.take_error(), Some(expected));
+    }
+}
+
+#[test]
+fn time_exceeded_does_not_abort_a_connection_attempt() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, seq) = connecting(&mut iface, &mut device, &mut sockets);
+
+    let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, seq);
+    device
+        .rx
+        .push_back(icmpv4_error(ROUTER_V4, TIME_EXCEEDED, 0, 0, &quote));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    let socket = sockets.get_mut::<tcp::Socket>(handle);
+    assert_eq!(socket.state(), tcp::State::SynSent);
+    assert_eq!(socket.take_error(), Some(IcmpError::TimeExceeded));
+}
+
+#[test]
+fn an_open_connection_survives_a_hard_error() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, seq) = connected_with_data_in_flight(&mut iface, &mut device, &mut sockets, 100);
+
+    let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, seq);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        HOST_UNREACHABLE,
+        0,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    let socket = sockets.get_mut::<tcp::Socket>(handle);
+    assert_eq!(socket.state(), tcp::State::Established);
+    assert_eq!(socket.take_error(), Some(IcmpError::HostUnreachable));
+}
+
+#[test]
+fn an_error_quoting_a_sequence_number_we_never_sent_is_ignored() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, seq) = connecting(&mut iface, &mut device, &mut sockets);
+
+    let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, seq + 5000);
