+fn tcp_packet_v6(src: Ipv6Address, dst: Ipv6Address, repr: TcpRepr<'_>) -> Vec<u8> {
+    let ip_repr = Ipv6Repr {
+        src_addr: src,
+        dst_addr: dst,
+        next_header: IpProtocol::Tcp,
+        payload_len: repr.buffer_len(),
+        hop_limit: 64,
+    };
+    let mut frame = vec![0; ip_repr.buffer_len() + repr.buffer_len()];
+    ip_repr.emit(&mut Ipv6Packet::new_unchecked(&mut frame));
+    repr.emit(
+        &mut TcpPacket::new_unchecked(&mut frame[ip_repr.buffer_len()..]),
+        &src.into(),
+        &dst.into(),
+        &ChecksumCapabilities::default(),
+    );
+    frame
+}
