+/// A quoted UDP datagram whose IPv4 header carries four bytes of options, so the transport
+/// header starts at offset 24 rather than the usual 20.
+fn quoted_udp_with_ip_options(
+    src: Ipv4Address,
+    dst: Ipv4Address,
+    src_port: u16,
+    dst_port: u16,
+) -> Vec<u8> {
+    const HEADER_LEN: usize = 24;
+    let mut frame = vec![0u8; HEADER_LEN + 8];
+    {
+        let mut packet = Ipv4Packet::new_unchecked(&mut frame);
+        packet.set_version(4);
+        packet.set_header_len(HEADER_LEN as u8);
+        packet.set_dscp(0);
+        packet.set_ecn(0);
+        packet.set_total_len((HEADER_LEN + 8) as u16);
+        packet.set_ident(0);
+        packet.set_dont_frag(false);
+        packet.set_more_frags(false);
+        packet.set_frag_offset(0);
+        packet.set_hop_limit(64);
+        packet.set_next_header(IpProtocol::Udp);
+        packet.set_src_addr(src);
+        packet.set_dst_addr(dst);
+    }
+    // Four no-operation options. An implementation reading the ports at a fixed offset of
+    // twenty would find these bytes instead.
+    frame[20..24].copy_from_slice(&[1, 1, 1, 1]);
+    frame[HEADER_LEN..HEADER_LEN + 2].copy_from_slice(&src_port.to_be_bytes());
+    frame[HEADER_LEN + 2..HEADER_LEN + 4].copy_from_slice(&dst_port.to_be_bytes());
+    Ipv4Packet::new_unchecked(&mut frame).fill_checksum();
+    frame
+}
+
+#[test]
+fn a_quote_whose_ip_header_carries_options_is_still_read_correctly() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let handle = bound_udp(&mut sockets);
+
+    let quote = quoted_udp_with_ip_options(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        FRAG_REQUIRED,
+        900,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+    assert_eq!(
+        sockets.get_mut::<udp::Socket>(handle).take_error(),
+        Some(IcmpError::PacketTooBig { mtu: 900 })
+    );
+    assert_eq!(iface.pmtu(REMOTE_V4), 900);
+}
