+#[test]
+fn an_unreachable_reason_that_carries_no_mtu_leaves_the_path_mtu_alone() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let _sender = bound_udp(&mut sockets);
+
+    // A destination unreachable with a code this stack has no name for. Whether such a
+    // report is reported to the socket at all is left open here; what it certainly is
+    // not is a report of how large a packet may be, so the path MTU must not move. The
+    // MTU field is filled in to catch an implementation that reads it regardless.
+    let quote = quoted_udp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        200,
+        900,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(iface.pmtu(REMOTE_V4), IFACE_MTU);
+
+    let local = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 1);
+    let remote = Ipv6Address::new(0xfe80, 0, 0, 0, 0, 0, 0, 2);
+    let quote = quoted_udp_v6(local, remote, LOCAL_PORT, REMOTE_PORT);
+    device
+        .rx
+        .push_back(icmpv6_error(remote, local, 1, 200, 1300, &quote));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(iface.pmtu(remote), IFACE_MTU);
+}
