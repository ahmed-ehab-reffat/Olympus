+#[test]
+fn the_fragments_of_a_datagram_reassemble_to_the_original() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+
+    let socket = udp::Socket::new(
+        udp::PacketBuffer::new(vec![udp::PacketMetadata::EMPTY; 4], vec![0; 4096]),
+        udp::PacketBuffer::new(vec![udp::PacketMetadata::EMPTY; 4], vec![0; 4096]),
+    );
+    let handle = sockets.add(socket);
+    sockets
+        .get_mut::<udp::Socket>(handle)
+        .bind(LOCAL_PORT)
+        .unwrap();
+
+    let quote = quoted_udp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        FRAG_REQUIRED,
+        900,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    device.tx.clear();
+
+    let payload: Vec<u8> = (0..1200u32).map(|i| (i % 251) as u8).collect();
+    sockets
+        .get_mut::<udp::Socket>(handle)
+        .send_slice(&payload, (REMOTE_V4, REMOTE_PORT))
+        .unwrap();
+
+    let mut now = Instant::ZERO;
+    for _ in 0..8 {
+        iface.poll(now, &mut device, &mut sockets);
+        now += Duration::from_millis(1);
+    }
+
+    let mut reassembled = vec![0u8; 0];
+    let frames: Vec<_> = device.tx.iter().cloned().collect();
+    assert!(frames.len() >= 2, "the datagram was not fragmented");
+
+    for (index, frame) in frames.iter().enumerate() {
+        let packet = Ipv4Packet::new_checked(frame).unwrap();
+        let last = index + 1 == frames.len();
+
+        assert_eq!(
+            packet.more_frags(),
+            !last,
+            "fragment {index} has the wrong more-fragments flag"
+        );
+        assert_eq!(
+            packet.frag_offset() as usize,
+            reassembled.len(),
+            "fragment {index} starts at the wrong offset"
+        );
+        if !last {
+            assert_eq!(
+                packet.frag_offset() as usize % 8,
+                0,
+                "fragment {index} is not aligned to an eight byte boundary"
+            );
+        }
+        reassembled.extend_from_slice(packet.payload());
+    }
+
+    let datagram = UdpPacket::new_checked(&reassembled[..]).expect("not a UDP datagram");
+    assert_eq!(datagram.src_port(), LOCAL_PORT);
+    assert_eq!(datagram.dst_port(), REMOTE_PORT);
+    assert_eq!(datagram.payload(), &payload[..]);
+}
