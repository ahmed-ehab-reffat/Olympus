+/// An established IPv6 connection, plus the sequence number of its first data byte.
+fn connected_v6(
+    iface: &mut Interface,
+    device: &mut TestDevice,
+    sockets: &mut SocketSet,
+    local: Ipv6Address,
+    remote: Ipv6Address,
+) -> (smoltcp::iface::SocketHandle, TcpSeqNumber) {
+    let socket = tcp::Socket::new(
+        tcp::SocketBuffer::new(vec![0; 4096]),
+        tcp::SocketBuffer::new(vec![0; 65535]),
+    );
+    let handle = sockets.add(socket);
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .connect(iface.context(), (remote, REMOTE_PORT), LOCAL_PORT)
+        .unwrap();
+    iface.poll(Instant::ZERO, device, sockets);
+
+    let syn = device.tx.pop_front().expect("no SYN was sent");
+    let isn = tcp_of_v6(&syn).seq_number;
+
+    let reply = tcp_packet_v6(
+        remote,
+        local,
+        TcpRepr {
+            src_port: REMOTE_PORT,
+            dst_port: LOCAL_PORT,
+            control: smoltcp::wire::TcpControl::Syn,
+            seq_number: TcpSeqNumber(0x4000),
+            ack_number: Some(isn + 1),
+            window_len: 65535,
+            window_scale: None,
+            max_seg_size: Some(1440),
+            sack_permitted: false,
+            sack_ranges: [None, None, None],
+            timestamp: None,
+            payload: &[],
+        },
+    );
+    device.rx.push_back(reply);
+    iface.poll(Instant::ZERO, device, sockets);
+    device.tx.clear();
+
+    assert_eq!(
+        sockets.get::<tcp::Socket>(handle).state(),
+        tcp::State::Established
+    );
+    (handle, isn + 1)
+}
