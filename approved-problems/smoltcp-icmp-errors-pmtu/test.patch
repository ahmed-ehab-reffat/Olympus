+#[test]
+fn only_a_sequence_still_outstanding_is_acted_on() {
+    let (mut iface, mut device) = setup();
+    let mut sockets = SocketSet::new(vec![]);
+    let (handle, base) = connected(&mut iface, &mut device, &mut sockets, Instant::ZERO);
+
+    sockets
+        .get_mut::<tcp::Socket>(handle)
+        .send_slice(&[0x11; 100])
+        .unwrap();
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    device.tx.clear();
+
+    // Nothing has been acknowledged, so the outstanding window is [base, base + 100].
+    for (seq, expected) in [
+        (base, Some(IcmpError::HostUnreachable)),
+        (base + 99, Some(IcmpError::HostUnreachable)),
+        // One past the last byte sent: the next sequence number, not an outstanding one.
+        (base + 100, None),
+        (base + 500, None),
+    ] {
+        let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, seq);
+        device.rx.push_back(icmpv4_error(
+            ROUTER_V4,
+            DST_UNREACHABLE,
+            HOST_UNREACHABLE,
+            0,
+            &quote,
+        ));
+        iface.poll(Instant::ZERO, &mut device, &mut sockets);
+        assert_eq!(
+            sockets.get_mut::<tcp::Socket>(handle).take_error(),
+            expected,
+            "error quoting sequence {seq}"
+        );
+    }
+
+    device.rx.push_back(ack_from_remote(base + 100));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    device.tx.clear();
+
+    // That data has been acknowledged now, so an error about it is stale.
+    let quote = quoted_tcp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT, base);
+    device.rx.push_back(icmpv4_error(
+        ROUTER_V4,
+        DST_UNREACHABLE,
+        HOST_UNREACHABLE,
+        0,
+        &quote,
+    ));
+    iface.poll(Instant::ZERO, &mut device, &mut sockets);
+    assert_eq!(sockets.get_mut::<tcp::Socket>(handle).take_error(), None);
+}
