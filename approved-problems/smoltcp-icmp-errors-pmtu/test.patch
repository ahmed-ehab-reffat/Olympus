+#[test]
+fn a_report_outside_the_bounds_is_still_reported_and_recorded_at_the_bound() {
+    // Below the IPv4 floor, and above the interface MTU: the recorded path MTU moves to
+    // the bound in both cases. Whether the socket hears the size the router quoted or the
+    // one that ended up recorded is not something this task decides, so only the shape of
+    // the error is asserted here.
+    for (reported, recorded) in [(68u16, 576usize), (9000, IFACE_MTU)] {
+        let (mut iface, mut device) = setup();
+        let mut sockets = SocketSet::new(vec![]);
+        let handle = bound_udp(&mut sockets);
+
+        let quote = quoted_udp(LOCAL_V4, REMOTE_V4, LOCAL_PORT, REMOTE_PORT);
+        device.rx.push_back(icmpv4_error(
+            ROUTER_V4,
+            DST_UNREACHABLE,
+            FRAG_REQUIRED,
+            reported,
+            &quote,
+        ));
+        iface.poll(Instant::ZERO, &mut device, &mut sockets);
+
+        assert!(
+            matches!(
+                sockets.get_mut::<udp::Socket>(handle).take_error(),
+                Some(IcmpError::PacketTooBig { .. })
+            ),
+            "a report of {reported} did not reach the socket"
+        );
+        assert_eq!(iface.pmtu(REMOTE_V4), recorded, "a report of {reported}");
+    }
+}
