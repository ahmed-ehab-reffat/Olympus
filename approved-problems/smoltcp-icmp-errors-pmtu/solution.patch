+/// An error an ICMP message reported about a packet this stack sent.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[cfg_attr(feature = "defmt", derive(defmt::Format))]
+pub enum IcmpError {
+    /// There is no route to the destination network.
+    NetUnreachable,
+    /// The destination host could not be reached.
+    HostUnreachable,
+    /// The destination host does not speak the protocol.
+    ProtoUnreachable,
+    /// Nothing is listening on the destination port.
+    PortUnreachable,
+    /// The source route in the packet could not be followed.
+    SrcRouteFailed,
+    /// A router refused to forward the packet.
+    Prohibited,
+    /// The packet outlived its hop limit, or reassembly of it timed out.
+    TimeExceeded,
+    /// A field of the packet was not understood.
+    ParamProblem,
+    /// The packet was larger than a link on the path allows, which reported this MTU.
+    PacketTooBig {
+        /// The MTU of the link that could not carry the packet.
+        mtu: usize,
+    },
+}
+
+impl IcmpError {
+    /// Whether the error says the destination cannot be reached at all, as opposed to
+    /// reporting something about this one packet.
+    pub fn is_hard(&self) -> bool {
+        match self {
+            Self::NetUnreachable
+            | Self::HostUnreachable
+            | Self::ProtoUnreachable
+            | Self::PortUnreachable
+            | Self::SrcRouteFailed
+            | Self::Prohibited => true,
+            Self::TimeExceeded | Self::ParamProblem | Self::PacketTooBig { .. } => false,
+        }
+    }
+}
