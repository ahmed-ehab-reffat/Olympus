diff --git a/src/iface/pmtu.rs b/src/iface/pmtu.rs
new file mode 100644
index 0000000..a047e38
--- /dev/null
+++ b/src/iface/pmtu.rs
@@ -0,0 +1,140 @@
+use heapless::Vec;
+
+use crate::time::{Duration, Instant};
+use crate::wire::IpAddress;
+
+/// The number of destinations whose path MTU is remembered at a time.
+pub(crate) const PMTU_CACHE_COUNT: usize = 4;
+
+/// How long a path MTU stays in effect before the next larger size is tried again.
+pub(crate) const PMTU_PROBE_INTERVAL: Duration = Duration::from_secs(600);
+
+/// The smallest path MTU an IPv4 destination may be given, from RFC 791.
+pub const IPV4_MIN_PMTU: usize = 576;
+
+/// The smallest path MTU an IPv6 destination may be given, from RFC 8200.
+pub const IPV6_MIN_PMTU: usize = 1280;
+
+/// The MTUs links in common use have, largest first, from RFC 1191.
+///
+/// A router that reports no MTU of its own leaves the sender to guess, and guessing
+/// along this table takes a handful of steps instead of one per octet.
+const PLATEAUS: [usize; 11] = [
+    65535, 32000, 17914, 8166, 4352, 2002, 1492, 1006, 508, 296, 68,
+];
+
+/// The largest size in the table that is smaller than `mtu`.
+fn plateau_below(mtu: usize) -> usize {
+    PLATEAUS
+        .iter()
+        .copied()
+        .find(|&plateau| plateau < mtu)
+        .unwrap_or(PLATEAUS[PLATEAUS.len() - 1])
+}
+
+/// The smallest size in the table that is larger than `mtu`.
+fn plateau_above(mtu: usize) -> Option<usize> {
+    PLATEAUS.iter().copied().rev().find(|&plateau| plateau > mtu)
+}
+
+/// The smallest path MTU the given destination may be given.
+fn min_pmtu(dst: &IpAddress) -> usize {
+    match dst {
+        #[cfg(feature = "proto-ipv4")]
+        IpAddress::Ipv4(_) => IPV4_MIN_PMTU,
+        #[cfg(feature = "proto-ipv6")]
+        IpAddress::Ipv6(_) => IPV6_MIN_PMTU,
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+#[cfg_attr(feature = "defmt", derive(defmt::Format))]
+struct Entry {
+    dst: IpAddress,
+    mtu: usize,
+    recorded_at: Instant,
+}
+
+/// The path MTU learned for each destination the stack has been told about.
+#[derive(Debug, Default)]
+#[cfg_attr(feature = "defmt", derive(defmt::Format))]
+pub(crate) struct PathMtuCache {
+    entries: Vec<Entry, PMTU_CACHE_COUNT>,
+}
+
+impl PathMtuCache {
+    /// The path MTU in effect for `dst`, or `None` when nothing smaller than the
+    /// interface MTU applies.
+    ///
+    /// A report only holds for one probe interval. After that the next larger size in
+    /// the table is tried, and the one after that an interval later, until the entry
+    /// has climbed back to the interface MTU and no longer says anything.
+    pub(crate) fn lookup(&self, dst: &IpAddress, now: Instant, iface_mtu: usize) -> Option<usize> {
+        let entry = self.entries.iter().find(|entry| &entry.dst == dst)?;
+
+        let elapsed = now - entry.recorded_at;
+        let mut intervals = elapsed.total_millis() / PMTU_PROBE_INTERVAL.total_millis();
+        let mut mtu = entry.mtu;
+        while intervals > 0 {
+            match plateau_above(mtu) {
+                Some(larger) if larger < iface_mtu => mtu = larger,
+                _ => return None,
+            }
+            intervals -= 1;
+        }
+
+        (mtu < iface_mtu).then_some(mtu)
+    }
+
+    /// Learn that packets to `dst` may be no larger than `mtu`, and return the path MTU
+    /// that ends up in effect.
+    ///
+    /// A report of zero, which routers too old to implement RFC 1191 send, means the
+    /// next size down the table from whatever is in effect now. Whatever the report, the
+    /// result is at most the interface MTU, at least the destination's own minimum, and
+    /// never larger than what was already in effect.
+    pub(crate) fn record(
+        &mut self,
+        dst: IpAddress,
+        mtu: usize,
+        iface_mtu: usize,
+        now: Instant,
+    ) -> usize {
+        let floor = min_pmtu(&dst);
+        let in_effect = self.lookup(&dst, now, iface_mtu).unwrap_or(iface_mtu);
+        let reported = if mtu == 0 { plateau_below(in_effect) } else { mtu };
+
+        let mtu = reported
+            .min(in_effect)
+            .max(floor)
+            .min(iface_mtu.max(floor));
+
+        let entry = Entry {
+            dst,
+            mtu,
+            recorded_at: now,
+        };
+
+        if let Some(existing) = self.entries.iter_mut().find(|entry| entry.dst == dst) {
+            *existing = entry;
+            return mtu;
+        }
+
+        if self.entries.push(entry).is_err() {
+            // The cache is full, so replace whichever destination was learned longest
+            // ago, since it is the one closest to being probed away anyway.
+            let victim = self
+                .entries
+                .iter_mut()
+                .min_by_key(|entry| entry.recorded_at)
+                .expect("cache is full but holds no entries");
+            *victim = entry;
+        }
+        mtu
+    }
+
+    /// Forget every learned path MTU.
+    pub(crate) fn flush(&mut self) {
+        self.entries.clear();
+    }
+}
