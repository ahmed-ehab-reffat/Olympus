+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+package com.mojang.datafixers.schemas;
+
+import java.util.List;
+
+public class UninhabitedRecursionException extends IllegalStateException {
+    private final List<String> types;
+
+    public UninhabitedRecursionException(final List<String> types) {
+        super("Recursive types without any value: " + String.join(", ", types));
+        this.types = List.copyOf(types);
+    }
+
+    public List<String> types() {
+        return types;
+    }
+}
