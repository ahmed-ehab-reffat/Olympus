diff --git a/src/main/java/com/mojang/datafixers/schemas/SchemaStructure.java b/src/main/java/com/mojang/datafixers/schemas/SchemaStructure.java
new file mode 100644
index 0000000..8a5e042
--- /dev/null
+++ b/src/main/java/com/mojang/datafixers/schemas/SchemaStructure.java
@@ -0,0 +1,178 @@
+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+package com.mojang.datafixers.schemas;
+
+import com.google.common.collect.Lists;
+import com.google.common.collect.Maps;
+import com.google.common.collect.Sets;
+import com.mojang.datafixers.types.templates.TypeTemplate;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public final class SchemaStructure {
+    private final List<String> registrationOrder;
+    private final Map<String, List<String>> references = Maps.newHashMap();
+    private final Map<String, Set<String>> reachable = Maps.newHashMap();
+    private final List<List<String>> groups = Lists.newArrayList();
+    private final Map<String, Integer> groupOf = Maps.newHashMap();
+    private final Map<String, Integer> indexInGroup = Maps.newHashMap();
+    private final List<Integer> buildOrder;
+    private final List<String> uninhabited;
+
+    public SchemaStructure(final List<String> registrationOrder, final Map<String, TypeTemplate> templates, final Set<String> declaredRecursive) {
+        this.registrationOrder = List.copyOf(registrationOrder);
+        collectReferences(templates);
+        computeReachability();
+        computeGroups(declaredRecursive);
+        this.buildOrder = computeBuildOrder();
+        this.uninhabited = computeUninhabited(templates);
+    }
+
+    private void collectReferences(final Map<String, TypeTemplate> templates) {
+        for (final String name : registrationOrder) {
+            final Set<String> collected = new LinkedHashSet<>();
+            TemplateStructure.collectReferences(templates.get(name), collected);
+            final List<String> ordered = Lists.newArrayList();
+            for (final String candidate : registrationOrder) {
+                if (collected.contains(candidate)) {
+                    ordered.add(candidate);
+                }
+            }
+            references.put(name, List.copyOf(ordered));
+        }
+    }
+
+    private void computeReachability() {
+        for (final String name : registrationOrder) {
+            final Set<String> seen = new LinkedHashSet<>();
+            final Deque<String> pending = new ArrayDeque<>(references.get(name));
+            while (!pending.isEmpty()) {
+                final String next = pending.pop();
+                if (seen.add(next)) {
+                    pending.addAll(references.getOrDefault(next, List.of()));
+                }
+            }
+            reachable.put(name, seen);
+        }
+    }
+
+    private void computeGroups(final Set<String> declaredRecursive) {
+        final Set<String> assigned = Sets.newHashSet();
+        for (final String name : registrationOrder) {
+            if (assigned.contains(name)) {
+                continue;
+            }
+            if (!reachable.get(name).contains(name) && !declaredRecursive.contains(name)) {
+                continue;
+            }
+            final List<String> group = Lists.newArrayList();
+            for (final String other : registrationOrder) {
+                if (other.equals(name) || (reachable.get(name).contains(other) && reachable.get(other).contains(name))) {
+                    group.add(other);
+                    assigned.add(other);
+                }
+            }
+            final int index = groups.size();
+            groups.add(List.copyOf(group));
+            for (int i = 0; i < group.size(); i++) {
+                groupOf.put(group.get(i), index);
+                indexInGroup.put(group.get(i), i);
+            }
+        }
+    }
+
+    private List<Integer> computeBuildOrder() {
+        final List<Integer> order = Lists.newArrayList();
+        final Set<Integer> built = Sets.newHashSet();
+        while (order.size() < groups.size()) {
+            int chosen = -1;
+            for (int candidate = 0; candidate < groups.size() && chosen == -1; candidate++) {
+                if (!built.contains(candidate) && dependenciesBuilt(candidate, built)) {
+                    chosen = candidate;
+                }
+            }
+            if (chosen == -1) {
+                throw new IllegalStateException("Recursion groups form a cycle");
+            }
+            order.add(chosen);
+            built.add(chosen);
+        }
+        return List.copyOf(order);
+    }
+
+    private boolean dependenciesBuilt(final int group, final Set<Integer> built) {
+        for (final String member : groups.get(group)) {
+            for (final String reached : reachable.get(member)) {
+                final Integer other = groupOf.get(reached);
+                if (other != null && other != group && !built.contains(other)) {
+                    return false;
+                }
+            }
+        }
+        return true;
+    }
+
+    private List<String> computeUninhabited(final Map<String, TypeTemplate> templates) {
+        final Set<String> withValue = Sets.newHashSet();
+        boolean changed = true;
+        while (changed) {
+            changed = false;
+            for (final String name : registrationOrder) {
+                if (!withValue.contains(name) && TemplateStructure.producesValue(templates.get(name), reference -> withValue.contains(reference) || !templates.containsKey(reference))) {
+                    withValue.add(name);
+                    changed = true;
+                }
+            }
+        }
+        final List<String> missing = Lists.newArrayList();
+        for (final String name : registrationOrder) {
+            if (!withValue.contains(name)) {
+                missing.add(name);
+            }
+        }
+        return List.copyOf(missing);
+    }
+
+    public List<String> references(final String name) {
+        return references.getOrDefault(name, List.of());
+    }
+
+    public boolean isRecursive(final String name) {
+        return groupOf.containsKey(name);
+    }
+
+    public int indexInGroup(final String name) {
+        return indexInGroup.get(name);
+    }
+
+    public int groupOf(final String name) {
+        return groupOf.get(name);
+    }
+
+    public List<List<String>> groups() {
+        return List.copyOf(groups);
+    }
+
+    public List<Integer> buildOrder() {
+        return buildOrder;
+    }
+
+    public List<String> recursiveTypeNames() {
+        final List<String> names = Lists.newArrayList();
+        for (final String name : registrationOrder) {
+            if (groupOf.containsKey(name)) {
+                names.add(name);
+            }
+        }
+        return List.copyOf(names);
+    }
+
+    public List<String> uninhabited() {
+        return uninhabited;
+    }
+}
