+// Copyright (c) Microsoft Corporation. All rights reserved.
+// Licensed under the MIT license.
+package com.mojang.datafixers.schemas;
+
+import com.mojang.datafixers.FamilyOptic;
+import com.mojang.datafixers.RewriteResult;
+import com.mojang.datafixers.types.Type;
+import com.mojang.datafixers.types.families.TypeFamily;
+import com.mojang.datafixers.types.templates.Check;
+import com.mojang.datafixers.types.templates.CompoundList;
+import com.mojang.datafixers.types.templates.Hook;
+import com.mojang.datafixers.types.templates.Named;
+import com.mojang.datafixers.types.templates.Product;
+import com.mojang.datafixers.types.templates.Sum;
+import com.mojang.datafixers.types.templates.Tag;
+import com.mojang.datafixers.types.templates.TaggedChoice;
+import com.mojang.datafixers.types.templates.TypeTemplate;
+import com.mojang.datafixers.util.Either;
+
+import it.unimi.dsi.fastutil.objects.Object2ObjectMap;
+import it.unimi.dsi.fastutil.objects.Object2ObjectOpenHashMap;
+
+import javax.annotation.Nullable;
+import java.util.Collection;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.function.IntFunction;
+import java.util.function.Predicate;
+
+public final class TemplateStructure {
+    private TemplateStructure() {
+    }
+
+    public record Reference(String name) implements TypeTemplate {
+        @Override
+        public int size() {
+            return 0;
+        }
+
+        @Override
+        public TypeFamily apply(final TypeFamily family) {
+            throw new UnsupportedOperationException("Reference placeholder was not resolved");
+        }
+
+        @Override
+        public <A, B> FamilyOptic<A, B> applyO(final FamilyOptic<A, B> input, final Type<A> aType, final Type<B> bType) {
+            throw new UnsupportedOperationException("Reference placeholder was not resolved");
+        }
+
+        @Override
+        public <FT, FR> Either<TypeTemplate, Type.FieldNotFoundException> findFieldOrType(final int index, @Nullable final String name, final Type<FT> type, final Type<FR> resultType) {
+            throw new UnsupportedOperationException("Reference placeholder was not resolved");
+        }
+
+        @Override
+        public IntFunction<RewriteResult<?, ?>> hmap(final TypeFamily family, final IntFunction<RewriteResult<?, ?>> function) {
+            throw new UnsupportedOperationException("Reference placeholder was not resolved");
+        }
+
+        @Override
+        public String toString() {
+            return "Reference[" + name + "]";
+        }
+    }
+
+    public static TypeTemplate substitute(final TypeTemplate template, final Function<String, TypeTemplate> resolver) {
+        if (template instanceof Reference reference) {
+            return resolver.apply(reference.name());
+        }
+        if (template instanceof Sum sum) {
+            final TypeTemplate first = substitute(sum.f(), resolver);
+            final TypeTemplate second = substitute(sum.g(), resolver);
+            return first == sum.f() && second == sum.g() ? sum : new Sum(first, second);
+        }
+        if (template instanceof Product product) {
+            final TypeTemplate first = substitute(product.f(), resolver);
+            final TypeTemplate second = substitute(product.g(), resolver);
+            return first == product.f() && second == product.g() ? product : new Product(first, second);
+        }
+        if (template instanceof CompoundList compoundList) {
+            final TypeTemplate key = substitute(compoundList.key(), resolver);
+            final TypeTemplate element = substitute(compoundList.element(), resolver);
+            return key == compoundList.key() && element == compoundList.element() ? compoundList : new CompoundList(key, element);
+        }
+        if (template instanceof Tag tag) {
+            final TypeTemplate element = substitute(tag.element(), resolver);
+            return element == tag.element() ? tag : new Tag(tag.name(), element);
+        }
+        if (template instanceof Named named) {
+            final TypeTemplate element = substitute(named.element(), resolver);
+            return element == named.element() ? named : new Named(named.name(), element);
+        }
+        if (template instanceof Check check) {
+            final TypeTemplate element = substitute(check.element(), resolver);
+            return element == check.element() ? check : new Check(check.name(), check.index(), element);
+        }
+        if (template instanceof Hook hook) {
+            final TypeTemplate element = substitute(hook.element(), resolver);
+            return element == hook.element() ? hook : new Hook(element, hook.preRead(), hook.postWrite());
+        }
+        if (template instanceof com.mojang.datafixers.types.templates.List list) {
+            final TypeTemplate element = substitute(list.element(), resolver);
+            return element == list.element() ? list : new com.mojang.datafixers.types.templates.List(element);
+        }
+        if (template instanceof TaggedChoice<?> choice) {
+            return substituteChoice(choice, resolver);
+        }
+        return template;
+    }
+
+    private static <K> TypeTemplate substituteChoice(final TaggedChoice<K> choice, final Function<String, TypeTemplate> resolver) {
+        final Object2ObjectMap<K, TypeTemplate> branches = new Object2ObjectOpenHashMap<>(choice.templates().size());
+        boolean changed = false;
+        for (final Map.Entry<K, TypeTemplate> entry : choice.templates().entrySet()) {
+            final TypeTemplate branch = substitute(entry.getValue(), resolver);
+            changed = changed || branch != entry.getValue();
+            branches.put(entry.getKey(), branch);
+        }
+        return changed ? new TaggedChoice<>(choice.name(), choice.keyType(), branches) : choice;
+    }
+
+    public static void collectReferences(final TypeTemplate template, final Collection<String> into) {
+        if (template instanceof Reference reference) {
+            into.add(reference.name());
+        } else if (template instanceof Sum sum) {
+            collectReferences(sum.f(), into);
+            collectReferences(sum.g(), into);
+        } else if (template instanceof Product product) {
+            collectReferences(product.f(), into);
+            collectReferences(product.g(), into);
+        } else if (template instanceof CompoundList compoundList) {
+            collectReferences(compoundList.key(), into);
+            collectReferences(compoundList.element(), into);
+        } else if (template instanceof Tag tag) {
+            collectReferences(tag.element(), into);
+        } else if (template instanceof Named named) {
+            collectReferences(named.element(), into);
+        } else if (template instanceof Check check) {
+            collectReferences(check.element(), into);
+        } else if (template instanceof Hook hook) {
+            collectReferences(hook.element(), into);
+        } else if (template instanceof com.mojang.datafixers.types.templates.List list) {
+            collectReferences(list.element(), into);
+        } else if (template instanceof TaggedChoice<?> choice) {
+            for (final TypeTemplate branch : choice.templates().values()) {
+                collectReferences(branch, into);
+            }
+        }
+    }
+
+    public static boolean producesValue(final TypeTemplate template, final Predicate<String> referenceHasValue) {
+        if (template instanceof Reference reference) {
+            return referenceHasValue.test(reference.name());
+        }
+        if (template instanceof Sum sum) {
+            return producesValue(sum.f(), referenceHasValue) || producesValue(sum.g(), referenceHasValue);
+        }
+        if (template instanceof Product product) {
+            return producesValue(product.f(), referenceHasValue) && producesValue(product.g(), referenceHasValue);
+        }
+        if (template instanceof Tag tag) {
+            return producesValue(tag.element(), referenceHasValue);
+        }
+        if (template instanceof Named named) {
+            return producesValue(named.element(), referenceHasValue);
+        }
+        if (template instanceof Check check) {
+            return producesValue(check.element(), referenceHasValue);
+        }
+        if (template instanceof Hook hook) {
+            return producesValue(hook.element(), referenceHasValue);
+        }
+        if (template instanceof TaggedChoice<?> choice) {
+            for (final TypeTemplate branch : choice.templates().values()) {
+                if (producesValue(branch, referenceHasValue)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+        return true;
+    }
+}
