+fi
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+write_setup_failure() {
+  message="$1"
+  detail="$2"
+  echo "test.sh: $message" >&2
+  echo "$detail" >&2
+  if [ -n "$OUTPUT_PATH" ]; then
+    escaped_detail="$(printf '%s' "$detail" | xml_escape)"
+    escaped_message="$(printf '%s' "$message" | xml_escape)"
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo '<testsuite name="setup" tests="1" skipped="0" failures="1" errors="0">'
+      echo '<testcase name="test_environment" classname="setup">'
+      echo "<failure message=\"$escaped_message\">$escaped_detail</failure>"
+      echo '</testcase>'
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+}
+
+write_empty_base_suite() {
+  echo "test.sh: no pre-existing test sources under src/test/java, base mode has nothing to run" >&2
+  if [ -n "$OUTPUT_PATH" ]; then
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo '<testsuites>'
+      echo '<testsuite name="base" tests="1" skipped="1" failures="0" errors="0">'
+      echo '<testcase name="no_preexisting_tests" classname="base">'
+      echo '<skipped/>'
+      echo '</testcase>'
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH"
+  fi
+}
+
+write_compile_failure() {
+  detail="$1"
+  if [ "$MODE" = "new" ] && [ -f "$NEW_TEST_FILE" ]; then
+    names="$(grep -oE 'public void [A-Za-z0-9_]+\(\)' "$NEW_TEST_FILE" | sed -E 's/public void ([A-Za-z0-9_]+)\(\)/\1/')"
+    count="$(printf '%s\n' "$names" | grep -c . || true)"
+    if [ -n "$OUTPUT_PATH" ] && [ "$count" -gt 0 ]; then
+      escaped_detail="$(printf '%s' "$detail" | xml_escape)"
+      {
+        echo '<?xml version="1.0" encoding="UTF-8"?>'
+        echo '<testsuites>'
+        echo "<testsuite name=\"$NEW_TEST_CLASS\" tests=\"$count\" skipped=\"0\" failures=\"$count\" errors=\"0\">"
+        while IFS= read -r name; do
+          [ -n "$name" ] || continue
+          echo "<testcase name=\"$name\" classname=\"$NEW_TEST_CLASS\">"
+          echo "<failure message=\"Compilation failed\">$escaped_detail</failure>"
+          echo '</testcase>'
+        done <<< "$names"
+        echo '</testsuite>'
+        echo '</testsuites>'
+      } > "$OUTPUT_PATH"
+      return
+    fi
+  fi
+  write_setup_failure "compilation failed" "$detail"
+}
+
+if ! command -v "$JAVAC_BIN" >/dev/null 2>&1 && [ ! -x "$JAVAC_BIN" ]; then
+  write_setup_failure "no Java compiler available" "javac was not found on PATH and JAVA_HOME was not usable."
+  exit 1
+fi
+if [ -z "$CLASSPATH_LIBS" ]; then
+  write_setup_failure "no dependency jars available" "Expected the project dependencies as jars under $LIB_DIR (override with DFU_TEST_LIBS)."
+  exit 1
+fi
+
+find src/main/java -name '*.java' > "$WORK/main-sources.txt"
+if ! "$JAVAC_BIN" -nowarn -encoding UTF-8 -d "$WORK/classes" -cp "$CLASSPATH_LIBS" "@$WORK/main-sources.txt" > "$WORK/main-compile.log" 2>&1; then
+  write_compile_failure "$(tail -n 40 "$WORK/main-compile.log")"
+  exit 1
+fi
+
+if [ "$MODE" = "new" ]; then
+  if [ ! -f "$NEW_TEST_FILE" ]; then
+    write_setup_failure "new tests are missing" "Expected $NEW_TEST_FILE to exist."
+    exit 1
+  fi
+  printf '%s\n' "$NEW_TEST_FILE" > "$WORK/test-sources.txt"
+  echo "$NEW_TEST_CLASS" > "$WORK/test-classes.txt"
+else
+  : > "$WORK/test-sources.txt"
+  if [ -d src/test/java ]; then
+    find src/test/java -name '*.java' ! -path "$NEW_TEST_FILE" > "$WORK/test-sources.txt"
+  fi
+  sed -e 's#^src/test/java/##' -e 's#\.java$##' -e 's#/#.#g' "$WORK/test-sources.txt" > "$WORK/test-classes.txt"
+fi
+
+if [ ! -s "$WORK/test-sources.txt" ]; then
+  if [ "$MODE" = "base" ]; then
+    write_empty_base_suite
+    exit 0
+  fi
+  write_setup_failure "no test sources found" "Mode new selected no test source files under src/test/java."
+  exit 1
+fi
+
+if ! "$JAVAC_BIN" -nowarn -encoding UTF-8 -d "$WORK/test-classes" -cp "$CLASSPATH_LIBS$WORK/classes" "@$WORK/test-sources.txt" > "$WORK/test-compile.log" 2>&1; then
+  write_compile_failure "$(tail -n 40 "$WORK/test-compile.log")"
+  exit 1
+fi
+
+cat > "$WORK/JUnitXmlRunner.java" <<'JAVAEOF'
+import org.junit.runner.Description;
+import org.junit.runner.JUnitCore;
+import org.junit.runner.notification.Failure;
+import org.junit.runner.notification.RunListener;
+
+import java.io.IOException;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+public final class JUnitXmlRunner extends RunListener {
+    private static final class Case {
+        private String className;
+        private String name;
+        private String failureMessage;
+        private String failureTrace;
+        private boolean skipped;
+        private long startNanos;
+        private long endNanos;
+    }
+
+    private final Map<String, Case> byId = new LinkedHashMap<>();
+    private final List<Case> ordered = new ArrayList<>();
+
+    private static String id(final Description description) {
+        return description.getClassName() + "#" + description.getMethodName();
+    }
+
+    private Case create(final Description description) {
+        final Case testCase = new Case();
+        testCase.className = description.getClassName();
+        testCase.name = description.getMethodName() == null ? "initializationError" : description.getMethodName();
+        testCase.startNanos = System.nanoTime();
+        testCase.endNanos = testCase.startNanos;
+        byId.put(id(description), testCase);
+        ordered.add(testCase);
+        return testCase;
+    }
+
+    @Override
+    public void testStarted(final Description description) {
+        create(description);
+    }
+
+    @Override
+    public void testFinished(final Description description) {
+        final Case testCase = byId.get(id(description));
+        if (testCase != null) {
+            testCase.endNanos = System.nanoTime();
+        }
+    }
+
+    @Override
+    public void testFailure(final Failure failure) {
+        Case testCase = byId.get(id(failure.getDescription()));
+        if (testCase == null) {
+            testCase = create(failure.getDescription());
+        }
+        testCase.failureMessage = failure.getMessage() == null ? failure.toString() : failure.getMessage();
+        testCase.failureTrace = failure.getTrace();
+    }
+
+    @Override
+    public void testAssumptionFailure(final Failure failure) {
+        final Case testCase = byId.get(id(failure.getDescription()));
+        if (testCase != null) {
+            testCase.skipped = true;
+        }
+    }
+
+    @Override
+    public void testIgnored(final Description description) {
+        create(description).skipped = true;
+    }
+
+    private int failures() {
+        int total = 0;
+        for (final Case testCase : ordered) {
+            if (testCase.failureMessage != null) {
+                total++;
+            }
+        }
+        return total;
+    }
+
+    private static String escape(final String raw) {
+        if (raw == null) {
+            return "";
+        }
+        final StringBuilder builder = new StringBuilder(raw.length());
+        for (int i = 0; i < raw.length(); i++) {
+            final char c = raw.charAt(i);
+            if (c == '&') {
+                builder.append("&amp;");
+            } else if (c == '<') {
+                builder.append("&lt;");
+            } else if (c == '>') {
+                builder.append("&gt;");
+            } else if (c == '"') {
+                builder.append("&quot;");
+            } else if (c == '\n' || c == '\r' || c == '\t' || c >= 0x20) {
+                builder.append(c);
+            } else {
+                builder.append(' ');
+            }
+        }
+        return builder.toString();
+    }
+
+    private void write(final Path path) throws IOException {
+        final Map<String, List<Case>> suites = new LinkedHashMap<>();
+        for (final Case testCase : ordered) {
+            suites.computeIfAbsent(testCase.className, key -> new ArrayList<>()).add(testCase);
+        }
+        final StringBuilder builder = new StringBuilder();
+        builder.append("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<testsuites>\n");
+        for (final Map.Entry<String, List<Case>> suite : suites.entrySet()) {
+            int failed = 0;
+            int skipped = 0;
+            for (final Case testCase : suite.getValue()) {
+                if (testCase.failureMessage != null) {
+                    failed++;
+                }
+                if (testCase.skipped) {
+                    skipped++;
+                }
+            }
+            builder.append("<testsuite name=\"").append(escape(suite.getKey()))
+                .append("\" tests=\"").append(suite.getValue().size())
+                .append("\" skipped=\"").append(skipped)
+                .append("\" failures=\"").append(failed)
+                .append("\" errors=\"0\">\n");
+            for (final Case testCase : suite.getValue()) {
+                final double seconds = Math.max(0L, testCase.endNanos - testCase.startNanos) / 1.0e9;
+                builder.append("<testcase name=\"").append(escape(testCase.name))
+                    .append("\" classname=\"").append(escape(testCase.className))
+                    .append("\" time=\"").append(String.format(Locale.ROOT, "%.3f", seconds)).append("\"");
+                if (testCase.failureMessage != null) {
+                    builder.append(">\n<failure message=\"").append(escape(testCase.failureMessage)).append("\">")
+                        .append(escape(testCase.failureTrace)).append("</failure>\n</testcase>\n");
+                } else if (testCase.skipped) {
+                    builder.append(">\n<skipped/>\n</testcase>\n");
+                } else {
+                    builder.append("/>\n");
+                }
+            }
+            builder.append("</testsuite>\n");
+        }
+        builder.append("</testsuites>\n");
+        Files.write(path, builder.toString().getBytes(StandardCharsets.UTF_8));
+    }
+
+    private void record(final String className, final String name, final Throwable thrown) {
+        final Case testCase = new Case();
+        testCase.className = className;
+        testCase.name = name;
+        testCase.startNanos = System.nanoTime();
+        testCase.endNanos = testCase.startNanos;
+        testCase.failureMessage = thrown.toString();
+        final StringWriter trace = new StringWriter();
+        thrown.printStackTrace(new PrintWriter(trace));
+        testCase.failureTrace = trace.toString();
+        ordered.add(testCase);
+    }
+
+    public static void main(final String[] args) throws Exception {
+        final JUnitXmlRunner listener = new JUnitXmlRunner();
+        final JUnitCore core = new JUnitCore();
+        core.addListener(listener);
+        final List<Class<?>> classes = new ArrayList<>();
+        for (int i = 1; i < args.length; i++) {
+            try {
+                classes.add(Class.forName(args[i]));
+            } catch (final Throwable thrown) {
+                listener.record(args[i], "initializationError", thrown);
+            }
+        }
+        try {
+            core.run(classes.toArray(new Class<?>[0]));
+        } catch (final Throwable thrown) {
+            listener.record("runner", "testRunAborted", thrown);
+        }
+        if (!args[0].isEmpty()) {
+            listener.write(Paths.get(args[0]));
+        }
+        final int failed = listener.failures();
+        System.out.println("Ran " + listener.ordered.size() + " tests, " + failed + " failures.");
+        for (final Case testCase : listener.ordered) {
+            if (testCase.failureMessage != null) {
+                System.out.println("FAILED " + testCase.className + "." + testCase.name + ": " + testCase.failureMessage);
+            }
+        }
+        System.exit(failed > 0 ? 1 : 0);
+    }
+}
+JAVAEOF
+
+if ! "$JAVAC_BIN" -nowarn -encoding UTF-8 -d "$WORK/runner" -cp "$CLASSPATH_LIBS" "$WORK/JUnitXmlRunner.java" > "$WORK/runner-compile.log" 2>&1; then
+  write_setup_failure "could not build the JUnit reporter" "$(tail -n 40 "$WORK/runner-compile.log")"
+  exit 1
+fi
+
+TEST_CLASS_ARGS=""
+while IFS= read -r class_name; do
+  [ -n "$class_name" ] || continue
+  TEST_CLASS_ARGS="$TEST_CLASS_ARGS $class_name"
+done < "$WORK/test-classes.txt"
+
+"$JAVA_BIN" -cp "$CLASSPATH_LIBS$WORK/classes:$WORK/test-classes:$WORK/runner" JUnitXmlRunner "$OUTPUT_PATH" $TEST_CLASS_ARGS > "$WORK/run.log" 2>&1
+RUN_EXIT=$?
+cat "$WORK/run.log"
+
+if [ -n "$OUTPUT_PATH" ] && [ ! -s "$OUTPUT_PATH" ]; then
+  write_setup_failure "the test run produced no results" "The JUnit reporter exited with status $RUN_EXIT without writing results. Runner output:
+$(tail -n 40 "$WORK/run.log")"
+  exit 1
+fi
+
+exit $RUN_EXIT
