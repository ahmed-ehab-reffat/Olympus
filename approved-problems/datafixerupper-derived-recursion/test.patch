+    private record Ref(String name) implements DSL.TypeReference {
+        @Override
+        public String typeName() {
+            return name;
+        }
+    }
+
+    private interface Registrar {
+        void register(Schema schema);
+    }
+
+    private static final ThreadLocal<Registrar> PENDING = new ThreadLocal<>();
+
+    private static final class TestSchema extends Schema {
+        private final Registrar registrar;
+
+        TestSchema(final int versionKey, final Schema parent, final Registrar registrar) {
+            super(versionKey, parent);
+            this.registrar = registrar;
+        }
+
+        @Override
+        public void registerTypes(final Schema schema, final Map<String, Supplier<TypeTemplate>> entityTypes, final Map<String, Supplier<TypeTemplate>> blockEntityTypes) {
+            PENDING.get().register(schema);
+        }
+
+        @Override
+        public Map<String, Supplier<TypeTemplate>> registerEntities(final Schema schema) {
+            return new HashMap<>();
+        }
+
+        @Override
+        public Map<String, Supplier<TypeTemplate>> registerBlockEntities(final Schema schema) {
+            return new HashMap<>();
+        }
+    }
+
+    private static Ref ref(final String name) {
+        return new Ref(name);
+    }
+
+    private static Schema schema(final Registrar registrar) {
+        return schema(0, null, registrar);
+    }
+
+    private static Schema schema(final int versionKey, final Schema parent, final Registrar registrar) {
+        PENDING.set(registrar);
+        try {
+            return new TestSchema(versionKey, parent, registrar);
+        } finally {
+            PENDING.remove();
+        }
+    }
+
+    private static TypeTemplate optRef(final Schema schema, final String field, final String target) {
+        return DSL.optionalFields(field, schema.id(target));
+    }
+
+    private static TypeTemplate reqRef(final Schema schema, final String field, final String target) {
+        return DSL.fields(field, schema.id(target));
+    }
+
+    private static TypeTemplate listRef(final Schema schema, final String field, final String target) {
+        return DSL.fields(field, DSL.list(schema.id(target)));
+    }
+
+    private static TypeTemplate mapRef(final Schema schema, final String field, final String target) {
+        return DSL.fields(field, DSL.compoundList(schema.id(target)));
+    }
+
+    private static TypeTemplate leaf(final String field) {
+        return DSL.optionalFields(field, DSL.constType(DSL.string()));
+    }
+
+    private static TypeTemplate choiceRef(final Schema schema, final String first, final String second) {
+        final Map<String, TypeTemplate> branches = new LinkedHashMap<>();
+        branches.put("first", schema.id(first));
+        branches.put("second", schema.id(second));
+        return DSL.taggedChoice("id", DSL.string(), branches);
+    }
+
+    private static RecursivePoint.RecursivePointType<?> point(final Schema schema, final String name) {
+        final Type<?> raw = schema.getTypeRaw(ref(name));
+        assertTrue(name + " is not a recursion point: " + raw.getClass().getSimpleName(), raw instanceof RecursivePoint.RecursivePointType<?>);
+        return (RecursivePoint.RecursivePointType<?>) raw;
+    }
+
+    private static void assertRecursive(final Schema schema, final String name, final int index, final int familySize) {
+        final RecursivePoint.RecursivePointType<?> raw = point(schema, name);
+        assertEquals("recursion index of " + name, index, raw.index());
+        assertEquals("family size of " + name, familySize, raw.family().size());
+    }
+
+    private static void assertNotRecursive(final Schema schema, final String name) {
+        assertFalse(name + " should not be recursive", schema.getTypeRaw(ref(name)) instanceof RecursivePoint.RecursivePointType<?>);
+        assertFalse(name + " should not be listed", schema.recursiveTypeNames().contains(name));
+    }
+
+    private static void assertRoundTrips(final Schema schema, final String name, final String json) {
+        final JsonElement element = JsonParser.parseString(json);
+        final DataResult<?> result = schema.getType(ref(name)).codec().parse(JsonOps.INSTANCE, element);
+        assertTrue("could not decode " + json + " as " + name + ": " + result.error().map(DataResult.Error::message).orElse(""), result.result().isPresent());
+    }
+
+    private static void assertDecodeFails(final Schema schema, final String name, final String json) {
+        final DataResult<?> result = schema.getType(ref(name)).codec().parse(JsonOps.INSTANCE, JsonParser.parseString(json));
+        assertTrue("expected " + json + " to be rejected as " + name, result.result().isEmpty());
+    }
+
+    private static UninhabitedRecursionException uninhabited(final Registrar registrar) {
+        try {
+            schema(registrar);
+        } catch (final UninhabitedRecursionException expected) {
+            return expected;
+        }
+        fail("expected UninhabitedRecursionException");
+        return null;
+    }
