+func Test_ChannelSendAllNonblocking_StopsAtFirstThatDoesNotFit(t *testing.T) {
+	c := NewBufferedChannel[int](2)
+
+	sent := c.SendAllNonblocking([]int{1, 2, 3, 4})
+
+	require.Equal(t, 2, sent)
+	require.Equal(t, 1, c.DroppedCount(), "the first value that did not fit must count as lost")
+	require.Equal(t, []int{1, 2}, c.Drain())
+
+	prefilled := NewBufferedChannel[int](3)
+	prefilled.SendNonblocking(1)
+	prefilled.SendNonblocking(2)
+
+	sent = prefilled.SendAllNonblocking([]int{3, 4, 5})
+
+	require.Equal(t, 1, sent, "only the one free slot may be used, not the whole configured capacity")
+	require.Equal(t, 1, prefilled.DroppedCount(), "the batch stops at the first value that does not fit, leaving later values unattempted")
+	require.Equal(t, []int{1, 2, 3}, prefilled.Drain())
+
+	empty := NewBufferedChannel[int](2)
+	require.Equal(t, 0, empty.SendAllNonblocking(nil))
+	require.Equal(t, 0, empty.DroppedCount())
+
+	allFit := NewBufferedChannel[int](3)
+	require.Equal(t, 2, allFit.SendAllNonblocking([]int{1, 2}))
+	require.Equal(t, 0, allFit.DroppedCount(), "nothing was refused, so nothing is dropped")
+	require.Equal(t, []int{1, 2}, allFit.Drain())
+
+	full := NewBufferedChannel[int](1)
+	require.True(t, full.SendNonblocking(1))
+	require.Equal(t, 0, full.SendAllNonblocking([]int{2, 3}), "no free slot means nothing is sent")
+	require.Equal(t, 1, full.DroppedCount(), "only the first value is attempted")
+	require.Equal(t, []int{1}, full.Drain())
+}
