+func Test_SignalBacklog_ExceedsCapacityWithDefaultBlockPolicy_MaterializesWithoutDeadlocking(t *testing.T) {
+	var drained []int
+	var dropped int
+
+	wf := func(ctx workflow.Context) error {
+		if err := workflow.Sleep(ctx, 10*time.Millisecond); err != nil {
+			return err
+		}
+
+		// Materializing this backlog must not block the coroutine that is creating the channel:
+		// nothing else could ever drain or receive from it to make room, since the caller here
+		// has not gotten the channel handle back yet.
+		c := workflow.NewSignalChannel[int](ctx, "overflowing", workflow.WithSignalChannelCapacity(1))
+
+		drained = c.Drain()
+		dropped = c.DroppedCount()
+
+		return nil
+	}
+
+	tester := NewWorkflowTester[any](wf)
+	tester.ScheduleCallback(1*time.Millisecond, func() { tester.SignalWorkflow("overflowing", 1) })
+	tester.ScheduleCallback(2*time.Millisecond, func() { tester.SignalWorkflow("overflowing", 2) })
+	tester.ScheduleCallback(3*time.Millisecond, func() { tester.SignalWorkflow("overflowing", 3) })
+
+	tester.Execute(context.Background())
+
+	require.True(t, tester.WorkflowFinished(), "backlog materialization under the default policy must not deadlock channel creation")
+
+	_, wfErr := tester.WorkflowResult()
+	require.NoError(t, wfErr)
+	require.Equal(t, []int{1}, drained)
+	require.Equal(t, 2, dropped)
+}
+
+func Test_LiveSignal_BeyondCapacityWithBlockPolicy_IsDroppedAndCounted(t *testing.T) {
+	var dropped, droppedViaWorkflow int
+	var drained []int
+
+	wf := func(ctx workflow.Context) error {
+		c := workflow.NewSignalChannel[int](ctx, "live", workflow.WithSignalChannelCapacity(1))
+
+		// Sleep without receiving, so signals delivered in the meantime fill the buffer
+		// (and overflow it) instead of being handed directly to a waiting Receive. Delivery
+		// here is always non-blocking (SendNonblocking), so even under the default
+		// OverflowBlock policy a signal that finds no room is lost, not queued to retry.
+		if err := workflow.Sleep(ctx, 10*time.Millisecond); err != nil {
+			return err
+		}
+
+		dropped = c.DroppedCount()
+		droppedViaWorkflow = workflow.SignalChannelDroppedCount(ctx, "live")
+		drained = c.Drain()
+
+		return nil
+	}
+
+	tester := NewWorkflowTester[any](wf)
+	tester.ScheduleCallback(1*time.Millisecond, func() { tester.SignalWorkflow("live", 1) })
+	tester.ScheduleCallback(2*time.Millisecond, func() { tester.SignalWorkflow("live", 2) })
+	tester.ScheduleCallback(3*time.Millisecond, func() { tester.SignalWorkflow("live", 3) })
+
+	tester.Execute(context.Background())
+
+	require.True(t, tester.WorkflowFinished())
+
+	_, wfErr := tester.WorkflowResult()
+	require.NoError(t, wfErr)
+	require.Equal(t, []int{1}, drained)
+	require.Equal(t, 2, dropped)
+	require.Equal(t, 2, droppedViaWorkflow)
+}
