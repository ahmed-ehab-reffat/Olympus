+func Test_ChannelDrain_BufferedAndMultipleBlockedSenders_InOneCall(t *testing.T) {
+	c := NewBufferedChannel[int](2)
+	require.True(t, c.SendNonblocking(1))
+	require.True(t, c.SendNonblocking(2))
+
+	first := NewCoroutine(Background(), func(ctx Context) error {
+		c.Send(ctx, 3)
+		return nil
+	})
+	first.Execute()
+	require.True(t, first.Blocked())
+
+	second := NewCoroutine(Background(), func(ctx Context) error {
+		c.Send(ctx, 4)
+		return nil
+	})
+	second.Execute()
+	require.True(t, second.Blocked())
+
+	require.Equal(t, []int{1, 2, 3, 4}, c.Drain(), "buffered values first, then blocked senders in the order they blocked")
+
+	first.Execute()
+	second.Execute()
+
+	require.True(t, first.Finished(), "draining its value must resolve the first sender")
+	require.True(t, second.Finished(), "draining its value must resolve the second sender")
+	require.Empty(t, c.PeekAll())
+}
+
+func Test_ChannelDrain_LaterSendTakesRoomFreedWhileAnOlderSenderIsStillBlocked(t *testing.T) {
+	c := NewBufferedChannel[int](1)
+	require.True(t, c.SendNonblocking(1))
+
+	cr := NewCoroutine(Background(), func(ctx Context) error {
+		c.Send(ctx, 2)
+		return nil
+	})
+	cr.Execute()
+	require.True(t, cr.Blocked())
+
+	v, ok := c.ReceiveNonBlocking()
+	require.True(t, ok)
+	require.Equal(t, 1, v)
+
+	require.True(t, c.SendNonblocking(3), "the freed room goes to the arriving send, not to the coroutine already blocked sending")
+	require.Equal(t, 0, c.DroppedCount(), "nothing was refused, so nothing is dropped")
+
+	require.Equal(t, []int{2, 3}, c.PeekAll(), "2 became available before 3 and must stay ordered first")
+	require.False(t, cr.Finished(), "2's Send only resolves once it is actually taken, not just peeked")
+
+	require.Equal(t, []int{2, 3}, c.Drain())
+
+	cr.Execute()
+	require.True(t, cr.Finished(), "draining past 2 must resolve its Send")
+}
