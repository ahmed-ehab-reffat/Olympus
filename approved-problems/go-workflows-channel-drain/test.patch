+func Test_SignalBacklog_ReplayedInOriginalArrivalOrder(t *testing.T) {
+	var drained []string
+
+	wf := func(ctx workflow.Context) error {
+		if err := workflow.Sleep(ctx, 10*time.Millisecond); err != nil {
+			return err
+		}
+
+		c := workflow.NewSignalChannel[string](ctx, "orders")
+		drained = c.Drain()
+
+		return nil
+	}
+
+	tester := NewWorkflowTester[any](wf)
+	tester.ScheduleCallback(1*time.Millisecond, func() { tester.SignalWorkflow("orders", "first") })
+	tester.ScheduleCallback(2*time.Millisecond, func() { tester.SignalWorkflow("orders", "second") })
+	tester.ScheduleCallback(3*time.Millisecond, func() { tester.SignalWorkflow("orders", "third") })
+
+	tester.Execute(context.Background())
+
+	require.True(t, tester.WorkflowFinished())
+
+	_, wfErr := tester.WorkflowResult()
+	require.NoError(t, wfErr)
+	require.Equal(t, []string{"first", "second", "third"}, drained)
+}
+
+func Test_SignalBacklog_ExceedsCapacityWithDropOldest_KeepsMostRecent(t *testing.T) {
+	var drained []int
+	var dropped int
+
+	wf := func(ctx workflow.Context) error {
+		if err := workflow.Sleep(ctx, 10*time.Millisecond); err != nil {
+			return err
+		}
+
+		c := workflow.NewSignalChannel[int](ctx, "nums",
+			workflow.WithSignalChannelCapacity(2),
+			workflow.WithSignalChannelOverflowPolicy(workflow.OverflowDropOldest),
+		)
+
+		drained = c.Drain()
+		dropped = c.DroppedCount()
+
+		return nil
+	}
+
+	tester := NewWorkflowTester[any](wf)
+	tester.ScheduleCallback(1*time.Millisecond, func() { tester.SignalWorkflow("nums", 1) })
+	tester.ScheduleCallback(2*time.Millisecond, func() { tester.SignalWorkflow("nums", 2) })
+	tester.ScheduleCallback(3*time.Millisecond, func() { tester.SignalWorkflow("nums", 3) })
+	tester.ScheduleCallback(4*time.Millisecond, func() { tester.SignalWorkflow("nums", 4) })
+
+	tester.Execute(context.Background())
+
+	require.True(t, tester.WorkflowFinished())
+
+	_, wfErr := tester.WorkflowResult()
+	require.NoError(t, wfErr)
+	require.Equal(t, []int{3, 4}, drained)
+	require.Equal(t, 2, dropped)
+}
