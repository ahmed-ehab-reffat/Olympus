+
+# Reconciles one package's <testsuite> block in the real go-junit-report output against the
+# expected test-name list for that package: real results (pass or fail) are kept exactly as
+# reported, and only the specific expected tests that never produced a result (never ran, because
+# an earlier test in the same package crashed the process with an unrecovered panic, or the
+# package failed to compile) are added back as synthetic failing <testcase> entries. This avoids
+# treating every other, unrelated package as failed just because one package's binary crashed.
+reconcile_package() {
+  local pkg="$1"
+  local raw_xml="$2"
+  local detail="$3"
+  shift 3
+  local expected=("$@")
+
+  local block
+  block=$(awk -v pat="<testsuite name=\"${pkg}\"" '
+    index($0, pat) > 0 { inblock = 1 }
+    inblock { print }
+    inblock && index($0, "</testsuite>") > 0 { exit }
+  ' "$raw_xml")
+
+  local present=() missing=()
+  for name in "${expected[@]}"; do
+    if [ -n "$block" ] && grep -qF "name=\"${name}\"" <<< "$block"; then
+      present+=("$name")
+    else
+      missing+=("$name")
+    fi
+  done
+
+  # Nothing from this package's expected tests produced a real result (package never compiled,
+  # or crashed before its first expected test ran): synthesize the whole suite fresh.
+  if [ "${#present[@]}" -eq 0 ]; then
+    echo '<testsuite name="'"$pkg"'" tests="'"${#expected[@]}"'" failures="'"${#expected[@]}"'" errors="0">'
+    for name in "${expected[@]}"; do
+      echo '<testcase name="'"$name"'" classname="'"$pkg"'">'
+      echo '<failure message="test run did not produce a result for this test">'"$detail"'</failure>'
+      echo '</testcase>'
+    done
+    echo '</testsuite>'
+    return
+  fi
+
+  if [ "${#missing[@]}" -eq 0 ]; then
+    printf '%s\n' "$block"
+    return
+  fi
+
+  local real_failures
+  real_failures=$(grep -o '<failure\|<error' <<< "$block" | wc -l)
+  local new_tests=$(( ${#present[@]} + ${#missing[@]} ))
+  local new_failures=$(( real_failures + ${#missing[@]} ))
+
+  printf '%s\n' "$block" | head -1 | sed -E "s/tests=\"[0-9]+\"/tests=\"${new_tests}\"/; s/failures=\"[0-9]+\"/failures=\"${new_failures}\"/"
+  printf '%s\n' "$block" | tail -n +2 | sed '$d'
+  for name in "${missing[@]}"; do
+    echo '<testcase name="'"$name"'" classname="'"$pkg"'">'
+    echo '<failure message="test run did not produce a result for this test">'"$detail"'</failure>'
+    echo '</testcase>'
+  done
+  echo '</testsuite>'
+}
+
+reconcile_junit_xml() {
+  local out="$1"
+  local raw_output="$2"
+
+  local detail
+  if [ -f "$raw_output" ]; then
+    detail=$(cat "$raw_output")
+  else
+    detail="test run produced no output"
+  fi
+
+  detail=$(printf '%s' "$detail" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+
+  local tmp="${out}.reconcile.tmp"
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites>'
+    reconcile_package "github.com/cschleiden/go-workflows/internal/sync" "$out" "$detail" "${NEW_SYNC_TESTS[@]}"
+    reconcile_package "github.com/cschleiden/go-workflows/tester" "$out" "$detail" "${NEW_TESTER_TESTS[@]}"
+    reconcile_package "github.com/cschleiden/go-workflows/workflow" "$out" "$detail" "${NEW_WORKFLOW_TESTS[@]}"
+    echo '</testsuites>'
+  } > "$tmp"
+
+  mv "$tmp" "$out"
+}
+
+STATUS=0
+
+# Base scope covers ./workflow/... in full, so workflow/executor's own existing tests run as a
+# genuine regression check on a package this change touches, including the
+# Test_Executor/Workflow_with_signal coverage of the signal-receipt path. The three
+# Close_removes_any_goroutines* subtests assert on runtime.NumGoroutine() deltas around executor
+# shutdown and are documented upstream as flaky under -race; this suite does not run -race, and
+# those subtests were verified stable across 10 consecutive full-package runs here, so the whole
+# package is included rather than filtered.
+case "$MODE" in
+  base)
+    go test -v -count=1 -timeout=120s \
+      ./internal/sync/... ./internal/workflowstate/... ./workflow/... ./tester/... \
+      > /tmp/base_test_out.txt 2>&1
+    TEST_STATUS=$?
+
+    go-junit-report -set-exit-code < /tmp/base_test_out.txt > "$OUTPUT_PATH"
+    REPORT_STATUS=$?
+
+    STATUS=$TEST_STATUS
+    if [ "$REPORT_STATUS" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+      STATUS=$REPORT_STATUS
+    fi
+    ;;
+
+  new)
+    ALL_NEW=("${NEW_SYNC_TESTS[@]}" "${NEW_TESTER_TESTS[@]}" "${NEW_WORKFLOW_TESTS[@]}")
+    RUN_PATTERN="^($(join_by_pipe "${ALL_NEW[@]}"))\$"
+
+    go test -v -count=1 -timeout=120s -tags=channeldrain -run "$RUN_PATTERN" \
+      ./internal/sync/... ./tester/... ./workflow \
+      > /tmp/new_test_out.txt 2>&1
+    TEST_STATUS=$?
+
+    go-junit-report -set-exit-code < /tmp/new_test_out.txt > "$OUTPUT_PATH"
+    REPORT_STATUS=$?
+
+    STATUS=$TEST_STATUS
+    if [ "$REPORT_STATUS" -ne 0 ] && [ "$STATUS" -eq 0 ]; then
+      STATUS=$REPORT_STATUS
+    fi
+
+    reconcile_junit_xml "$OUTPUT_PATH" /tmp/new_test_out.txt
+
+    TOTAL_FAILURES=$(grep -o 'failures="[0-9]*"' "$OUTPUT_PATH" | grep -o '[0-9]*' | awk '{s+=$1} END{print s+0}')
+    if [ "$TOTAL_FAILURES" -gt 0 ]; then
+      STATUS=1
+    fi
+    ;;
+
+  *)
+    echo "Usage: ./test.sh {base|new} --output_path <path>"
+    exit 1
+    ;;
+esac
+
+exit "$STATUS"
