+		return nil
+	})
+
+	require.NoError(t, s.Execute())
+	require.Equal(t, []int{1}, c.PeekAll(), "while the sender is blocked its value is available")
+
+	values, ok := c.TryCloseDraining()
+	require.False(t, ok)
+	require.Equal(t, []int{1}, values)
+
+	s.Exit()
+
+	require.Empty(t, c.PeekAll(), "no coroutine holds the value once the sender is torn down")
+	require.Empty(t, c.Drain())
+
+	values, ok = c.TryCloseDraining()
+	require.True(t, ok, "nothing is blocked sending any more, so the close must go through")
+	require.True(t, c.Closed())
+	require.Empty(t, values)
