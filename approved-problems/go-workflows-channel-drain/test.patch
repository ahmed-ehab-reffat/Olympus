+func Test_ChannelDrain_DirectDrain_ResumesBlockedSenderUnderScheduler(t *testing.T) {
+	c := NewChannel[int]()
+	done := NewChannel[int]()
+
+	sent := false
+
+	var got []int
+
+	s := NewScheduler()
+
+	s.NewCoroutine(Background(), func(ctx Context) error {
+		c.Send(ctx, 7)
+		sent = true
+		done.Send(ctx, 1)
+
+		return nil
+	})
+
+	s.NewCoroutine(Background(), func(ctx Context) error {
+		got = c.Drain()
+		done.Receive(ctx)
+
+		return nil
+	})
+
+	require.NoError(t, s.Execute())
+
+	require.Equal(t, []int{7}, got)
+	require.True(t, sent, "a direct Drain must let the scheduler resume the sender whose value it took")
+	require.Equal(t, 0, s.RunningCoroutines(), "no coroutine may be left blocked once the drained sender has been resumed")
+}
