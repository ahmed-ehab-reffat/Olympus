+func Test_PendingSignalNames_ReflectsUncreatedChannels(t *testing.T) {
+	var namesBeforeCreate, namesAfterCreate []string
+	var hasGreetingBefore, hasFarewellBefore, hasGreetingAfter, hasFarewellAfter bool
+
+	wf := func(ctx workflow.Context) error {
+		if err := workflow.Sleep(ctx, 10*time.Millisecond); err != nil {
+			return err
+		}
+
+		namesBeforeCreate = workflow.PendingSignalNames(ctx)
+		hasGreetingBefore = workflow.HasPendingSignal(ctx, "greeting")
+		hasFarewellBefore = workflow.HasPendingSignal(ctx, "farewell")
+
+		workflow.NewSignalChannel[string](ctx, "greeting")
+
+		namesAfterCreate = workflow.PendingSignalNames(ctx)
+		hasGreetingAfter = workflow.HasPendingSignal(ctx, "greeting")
+		hasFarewellAfter = workflow.HasPendingSignal(ctx, "farewell")
+
+		return nil
+	}
+
+	tester := NewWorkflowTester[any](wf)
+	tester.ScheduleCallback(1*time.Millisecond, func() {
+		tester.SignalWorkflow("greeting", "hi")
+		tester.SignalWorkflow("farewell", "bye")
+	})
+
+	tester.Execute(context.Background())
+
+	require.True(t, tester.WorkflowFinished())
+
+	_, wfErr := tester.WorkflowResult()
+	require.NoError(t, wfErr)
+	require.ElementsMatch(t, []string{"greeting", "farewell"}, namesBeforeCreate)
+	require.True(t, hasGreetingBefore)
+	require.True(t, hasFarewellBefore)
+
+	require.ElementsMatch(t, []string{"farewell"}, namesAfterCreate, "creating a channel for one name must not remove any other pending name")
+	require.False(t, hasGreetingAfter)
+	require.True(t, hasFarewellAfter)
+}
