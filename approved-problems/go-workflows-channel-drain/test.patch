+func Test_ChannelTryCloseDraining_FailsWithBlockedSelectSendCase(t *testing.T) {
+	c := NewBufferedChannel[int](1)
+	require.True(t, c.SendNonblocking(1))
+
+	v := 2
+	handled := false
+
+	s := NewScheduler()
+	s.NewCoroutine(Background(), func(ctx Context) error {
+		Select(ctx, Send(c, &v, func(ctx Context) { handled = true }))
+
+		return nil
+	})
+
+	require.NoError(t, s.Execute())
+	require.Equal(t, 1, s.RunningCoroutines(), "the buffer is full, so the send case stays parked")
+
+	values, ok := c.TryCloseDraining()
+	require.False(t, ok, "a coroutine parked in a Select send case is still blocked sending")
+	require.False(t, c.Closed(), "the channel must be left open so the waiting send can still go through")
+	require.Equal(t, []int{1}, values, "the refused close must still report the remaining values")
+
+	require.Equal(t, []int{1}, c.Drain())
+
+	require.NoError(t, s.Execute())
+	require.True(t, handled, "the send case must still complete once room appears after a refused close")
+	require.Equal(t, 0, s.RunningCoroutines())
+	require.Equal(t, []int{2}, c.Drain())
+}
