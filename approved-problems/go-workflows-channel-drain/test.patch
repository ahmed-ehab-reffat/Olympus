+func Test_ChannelDrain_IncludesBlockedSenders_InOrder(t *testing.T) {
+	c := NewChannel[int]()
+
+	var order []int
+
+	crA := NewCoroutine(Background(), func(ctx Context) error {
+		c.Send(ctx, 1)
+		order = append(order, 1)
+		return nil
+	})
+	crA.Execute()
+	require.True(t, crA.Blocked())
+
+	crB := NewCoroutine(Background(), func(ctx Context) error {
+		c.Send(ctx, 2)
+		order = append(order, 2)
+		return nil
+	})
+	crB.Execute()
+	require.True(t, crB.Blocked())
+
+	drained := c.Drain()
+	require.Equal(t, []int{1, 2}, drained)
+
+	crA.Execute()
+	crB.Execute()
+	require.True(t, crA.Finished())
+	require.True(t, crB.Finished())
+	require.Equal(t, []int{1, 2}, order)
+}
