new file mode 100755
index 00000000..990ee46a
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+export PATH="/usr/local/go/bin:/root/go/bin:${PATH}"
+export GOFLAGS="-mod=mod"
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+
+if [ ! -w "${HOME:-/nonexistent}" ]; then
+  export HOME=/tmp
+fi
+export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+NEW_TESTS=$(ls -d ./e2e/a3d64e_* 2>/dev/null | tr '\n' ' ')
+# base mode runs every package that has tests, except the e2e cases added by this
+# task and two cases that download a neva dependency over the network, which is
+# not available while tests run
+BASE_E2E=$(find ./e2e -name '*_test.go' -not -path '*/a3d64e_*' -printf '%h\n' 2>/dev/null \
+  | grep -v '^./e2e/interface_with_imports$' \
+  | grep -v '^./e2e/cli/build_with_ir_target$' \
+  | sort -u | tr '\n' ' ')
+
+case "$MODE" in
+  base) TARGETS="./internal/... ./pkg/... $BASE_E2E" ;;
+  new)  TARGETS="$NEW_TESTS" ;;
+esac
+
+TEST_LOG=$(mktemp)
+go test -v -count=1 -p 1 -timeout 30m $TARGETS 2>&1 | tee "$TEST_LOG"
+STATUS=${PIPESTATUS[0]}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  go-junit-report -set-exit-code < "$TEST_LOG" > "$OUTPUT_PATH" 2>/dev/null || true
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    sanitized=$(tail -c 4000 "$TEST_LOG" | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n  <testsuite name="go-test" tests="1" failures="1" errors="0">\n    <testcase name="compilation" classname="go-test"><failure message="build failed"><![CDATA[%s]]></failure></testcase>\n  </testsuite>\n</testsuites>\n' "$sanitized" > "$OUTPUT_PATH"
+  fi
+fi
+
+exit $STATUS
