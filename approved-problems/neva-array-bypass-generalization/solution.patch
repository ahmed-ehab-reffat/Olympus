@@ -0,0 +1,47 @@
+package funcs
+
+import (
+	"context"
+
+	"github.com/nevalang/neva/internal/runtime"
+	"github.com/nevalang/neva/internal/runtime/messages"
+)
+
+type waitAll struct{}
+
+//nolint:varnamelen
+func (w waitAll) Create(io runtime.IO, _ messages.Msg) (func(ctx context.Context), error) {
+	sigIn, err := io.In.Array("sig")
+	if err != nil {
+		//nolint:wrapcheck
+		return nil, err
+	}
+
+	sigOut, err := io.Out.Single("sig")
+	if err != nil {
+		//nolint:wrapcheck
+		return nil, err
+	}
+
+	return w.Handle(sigIn, sigOut), nil
+}
+
+func (waitAll) Handle(
+	sigIn runtime.ArrayInport,
+	sigOut runtime.SingleOutport,
+) func(ctx context.Context) {
+	return func(ctx context.Context) {
+		for {
+			received := sigIn.ReceiveAll(ctx, func(int, runtime.OrderedMsg) bool {
+				return true
+			})
+			if !received {
+				return
+			}
+
+			if !sigOut.Send(ctx, emptyStruct()) {
+				return
+			}
+		}
+	}
+}
