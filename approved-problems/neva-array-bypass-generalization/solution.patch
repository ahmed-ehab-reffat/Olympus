+// WaitAll outputs one signal after every used slot of :sig received a message.
+//
+// Slot count is whatever the parent wires, so it is known at compile time and
+// there is no counter to set.
+//
+// Example:
+//  sync.WaitAll
+// ---
+//  task1 -> wait:sig[0]
+//  task2 -> wait:sig[1]
+//  wait -> :stop  // Signals after both tasks are done.
+#extern(wait_all)
+pub def WaitAll([sig] any) (sig any)
