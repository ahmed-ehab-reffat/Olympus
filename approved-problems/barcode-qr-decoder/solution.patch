+package qr
+
+import (
+	"image"
+
+	"github.com/boombuler/barcode"
+)
+
+type decodedQR struct {
+	image.Image
+	content string
+}
+
+func (d *decodedQR) Content() string {
+	return d.content
+}
+
+func (d *decodedQR) Metadata() barcode.Metadata {
+	return barcode.Metadata{CodeKind: barcode.TypeQR, Dimensions: 2}
+}
+
+func init() {
+	barcode.RegisterDecoder(func(img image.Image) (barcode.Barcode, error) {
+		res, err := Decode(img)
+		if err != nil {
+			return nil, err
+		}
+		return &decodedQR{Image: img, content: res.Content}, nil
+	})
+}
