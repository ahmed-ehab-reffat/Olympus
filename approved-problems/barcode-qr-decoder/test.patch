+//go:build qr_decoder
+
+package qr
+
+import (
+	"image"
+	"image/color"
+	"strings"
+	"testing"
+
+	"github.com/boombuler/barcode"
+)
+
+func qrdecGrayCopy(img image.Image) *image.Gray {
+	b := img.Bounds()
+	g := image.NewGray(b)
+	for x := b.Min.X; x < b.Max.X; x++ {
+		for y := b.Min.Y; y < b.Max.Y; y++ {
+			r, _, _, _ := img.At(x, y).RGBA()
+			v := uint8(255)
+			if r < 0x8000 {
+				v = 0
+			}
+			g.SetGray(x, y, color.Gray{Y: v})
+		}
+	}
+	return g
+}
+
+func qrdecFlipModules(g *image.Gray, coords [][2]int) {
+	for _, c := range coords {
+		if g.GrayAt(c[0], c[1]).Y < 128 {
+			g.SetGray(c[0], c[1], color.Gray{Y: 255})
+		} else {
+			g.SetGray(c[0], c[1], color.Gray{Y: 0})
+		}
+	}
+}
+
+var qrdecV1DataModules = [][2]int{{0, 9}, {0, 10}, {0, 11}, {0, 12}, {1, 9}, {1, 10}, {1, 11}, {1, 12}}
+var qrdecFormatModules = [][2]int{{0, 8}, {1, 8}, {2, 8}, {3, 8}, {4, 8}, {5, 8}, {7, 8}, {8, 8}, {8, 7}, {8, 5}, {8, 4}, {8, 3}, {8, 2}, {8, 1}, {8, 0}}
+var qrdecV1FormatModulesCopy2 = [][2]int{{8, 20}, {8, 19}, {8, 18}, {8, 17}, {8, 16}, {8, 15}, {8, 14}, {13, 8}, {14, 8}, {15, 8}, {16, 8}, {17, 8}, {18, 8}, {19, 8}, {20, 8}}
+var qrdecV1SpreadDataModules = [][2]int{{0, 9}, {3, 9}, {7, 9}, {9, 4}, {9, 17}, {10, 9}, {11, 0}, {11, 13}, {12, 4}, {12, 17}, {13, 17}, {14, 17}, {15, 17}, {16, 17}, {17, 17}, {18, 17}, {19, 17}, {20, 17}}
+
+func qrdecWithQuietZone(img image.Image, qz int) *image.Gray {
+	dim := img.Bounds().Dx()
+	g := image.NewGray(image.Rect(0, 0, dim+2*qz, dim+2*qz))
+	for i := range g.Pix {
+		g.Pix[i] = 255
+	}
+	for x := 0; x < dim; x++ {
+		for y := 0; y < dim; y++ {
+			r, _, _, _ := img.At(x, y).RGBA()
+			if r < 0x8000 {
+				g.SetGray(qz+x, qz+y, color.Gray{Y: 0})
+			}
+		}
+	}
+	return g
+}
+
+func qrdecEncode(t *testing.T, s string, lvl ErrorCorrectionLevel, mode Encoding) barcode.Barcode {
+	t.Helper()
+	img, err := Encode(s, lvl, mode)
+	if err != nil {
+		t.Fatalf("Encode(%q) error: %v", s, err)
+	}
+	return img
+}
+
+type qrdecOpaqueImage struct{ image.Image }
+
+func qrdecDecode(t *testing.T, img image.Image) *DecodeResult {
+	t.Helper()
+	res, err := Decode(qrdecOpaqueImage{img})
+	if err != nil {
+		t.Fatalf("Decode error: %v", err)
+	}
+	return res
+}
+
+func qrdecWantContent(t *testing.T, img image.Image, want string) {
+	t.Helper()
+	res := qrdecDecode(t, img)
+	if res.Content != want {
+		t.Fatalf("content: got %q, want %q", res.Content, want)
+	}
+}
+
+// qrdecFormatInfoM holds the QR-spec 15-bit format-information strings for the M
+// error-correction level and mask patterns 0..7 (ISO/IEC 18004), used to read
+// the encoded mask from a symbol independently of the decoder.
+var qrdecFormatInfoM = [8][15]bool{
+	{true, false, true, false, true, false, false, false, false, false, true, false, false, true, false},
+	{true, false, true, false, false, false, true, false, false, true, false, false, true, false, true},
+	{true, false, true, true, true, true, false, false, true, true, true, true, true, false, false},
+	{true, false, true, true, false, true, true, false, true, false, false, true, false, true, true},
+	{true, false, false, false, true, false, true, true, true, true, true, true, false, false, true},
+	{true, false, false, false, false, false, false, true, true, false, false, true, true, true, false},
+	{true, false, false, true, true, true, true, true, false, false, true, false, true, true, true},
+	{true, false, false, true, false, true, false, true, false, true, false, false, false, false, false},
+}
+
+func qrdecExpectedMaskM(t *testing.T, img image.Image) int {
+	t.Helper()
+	var bits [15]bool
+	for i, c := range qrdecFormatModules {
+		r, _, _, _ := img.At(c[0], c[1]).RGBA()
+		bits[i] = r < 0x8000
+	}
+	for mask := 0; mask < 8; mask++ {
+		if qrdecFormatInfoM[mask] == bits {
+			return mask
+		}
+	}
+	t.Fatal("no level-M format pattern matched the image")
+	return -1
+}
