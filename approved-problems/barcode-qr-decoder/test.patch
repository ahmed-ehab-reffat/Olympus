+#!/usr/bin/env bash
+set -uo pipefail
+export GOFLAGS="-buildvcs=false"
+export PATH="/usr/local/bin:/usr/local/go/bin:$PATH"
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+if [ -z "$OUTPUT_PATH" ] || [ -z "$MODE" ]; then
+  echo "Usage: ./test.sh --output_path <path> {base|new}"
+  exit 1
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+CLASSNAME="github.com/boombuler/barcode/qr"
+NEW_TESTS=(
+  TestQRDecode_numericShortV1   TestQRDecode_numericFortyDigits   TestQRDecode_numericLeadingZeros
+  TestQRDecode_numericTwoDigitTail   TestQRDecode_numericSingleDigit   TestQRDecode_numericLongV2
+  TestQRDecode_alphaNumericHelloWorld   TestQRDecode_alphaNumericSymbols   TestQRDecode_alphaNumericOddLength
+  TestQRDecode_alphaNumericV4   TestQRDecode_byteAscii   TestQRDecode_byteUtf8Multibyte
+  TestQRDecode_byteLowercaseAndDigits   TestQRDecode_byteLongV7   TestQRDecode_autoUrl
+  TestQRDecode_levelLRoundTrip   TestQRDecode_levelMRoundTrip   TestQRDecode_levelQRoundTrip
+  TestQRDecode_levelHRoundTrip   TestQRDecode_maskRecoveredInRange   TestQRDecode_versionMatchesDimension
+  TestQRDecode_versionGrowsWithData   TestQRDecode_correctsSingleModuleError   TestQRDecode_correctsErrorsLevelL
+  TestQRDecode_correctsErrorsLevelM   TestQRDecode_correctsErrorsLevelQ   TestQRDecode_correctsErrorsLevelH
+  TestQRDecode_corruptBothFormatCopiesErrors   TestQRDecode_recoversFromSecondFormatCopy   TestQRDecode_scaledImageRoundTrips
+  TestQRDecode_scaledImageRecoversParams   TestQRDecode_quietZoneRoundTrips   TestQRDecode_scaledWithQuietZoneRoundTrips
+  TestQRDecode_invalidDimensionErrors   TestQRDecode_nonSquareErrors   TestQRDecode_tooSmallErrors
+  TestQRDecode_numericAllZeros   TestQRDecode_alphaNumericMaxV1H   TestQRDecode_byteSingleChar
+  TestQRDecode_roundTripPreservesSpaces   TestQRDecode_locatesSymbolInLargerCanvas   TestQRDecode_correctsErrorsOnScaledImage
+  TestQRDecode_noFinderPatternErrors   TestQRDecode_uncorrectableDamageErrors   TestQRDecode_highVersionNumericV13
+  TestQRDecode_multiGroupAlphaNumericV11   TestQRDecode_multiGroupByteV19   TestQRDecode_recoversFromFirstFormatCopy
+  TestQRDecode_zeroAreaImageErrors   TestQRDecode_barcodePackageDecode   TestQRDecode_barcodePackageDecodeErrorsOnNonBarcode)
+
+synth_build_failure() {
+  local msg
+  msg=$(printf '%s' "$1" | tail -c 2000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo "<testsuites>"
+    echo "  <testsuite name=\"${CLASSNAME}\" tests=\"${#NEW_TESTS[@]}\" failures=\"${#NEW_TESTS[@]}\" errors=\"0\">"
+    for name in "${NEW_TESTS[@]}"; do
+      echo "    <testcase name=\"${name}\" classname=\"${CLASSNAME}\"><failure message=\"build failed\"><![CDATA[${msg}]]></failure></testcase>"
+    done
+    echo "  </testsuite>"
+    echo "</testsuites>"
+  } > "$OUTPUT_PATH"
+}
+
+if [ "$MODE" = "base" ]; then
+  output=$(go test -v -count=1 ./... 2>&1)
+  code=$?
+  echo "$output"
+  printf '%s\n' "$output" | go-junit-report > "$OUTPUT_PATH"
+  exit $code
+else
+  output=$(go test -tags=qr_decoder -run '^TestQRDecode' -v -count=1 ./qr/ 2>&1)
+  code=$?
+  echo "$output"
+  if printf '%s\n' "$output" | grep -qE '^(--- PASS|--- FAIL|=== RUN)'; then
+    printf '%s\n' "$output" | go-junit-report > "$OUTPUT_PATH"
+  else
+    synth_build_failure "$output"
+  fi
+  exit $code
+fi
