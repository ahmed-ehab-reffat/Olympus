+func TestQRDecode_correctsErrorsOnScaledImage(t *testing.T) {
+	img := qrdecEncode(t, "HELLO", H, AlphaNumeric)
+	dim := img.Bounds().Dx()
+	k := 4
+	scaled, _ := barcode.Scale(img, dim*k, dim*k)
+	g := qrdecGrayCopy(scaled)
+	for _, mod := range qrdecV1DataModules[:6] {
+		for dx := 0; dx < k; dx++ {
+			for dy := 0; dy < k; dy++ {
+				px, py := mod[0]*k+dx, mod[1]*k+dy
+				if g.GrayAt(px, py).Y < 128 {
+					g.SetGray(px, py, color.Gray{Y: 255})
+				} else {
+					g.SetGray(px, py, color.Gray{Y: 0})
+				}
+			}
+		}
+	}
+	qrdecWantContent(t, g, "HELLO")
+}
