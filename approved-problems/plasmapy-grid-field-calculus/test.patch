+def make_mixed_scale_grid():
+    # B_x and B_y are stored in tesla; B_z is stored in millitesla, a unit
+    # that is convertible to tesla but is not the same unit.
+    grid = CartesianGrid(
+        np.array([-1.0, -1.0, -1.0]) * u.m,
+        np.array([1.0, 2.0, 3.0]) * u.m,
+        num=[5, 6, 7],
+    )
+    x, y, z = (component.si.value for component in grid.grids)
+    grid.add_quantities(B_x=(y * z) * u.T, B_y=(z * x) * u.T)
+    grid.add_quantities(B_z=(x * y) * 1000 * u.mT)
+    return grid
+
