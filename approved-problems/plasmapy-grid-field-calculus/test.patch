+def test_line_integral_across_several_cells_on_rough_data():
+    grid = make_rough_grid()
+    start = np.array([-0.85, -0.55, 0.15])
+    stop = np.array([0.75, 1.65, 2.45])
+    got = grid.line_integral(np.stack([start, stop]) * u.m, "phi")
+
+    # Reference built only from the interpolator the grid already has, by
+    # composite Simpson at a resolution far finer than any cell. The
+    # integrand has a kink at every cell crossing, so convergence is slower
+    # than for a smooth one and the resolution is chosen accordingly.
+    intervals = 2**16
+    t = np.linspace(0.0, 1.0, intervals + 1)
+    points = start + t[:, None] * (stop - start)
+    values = grid.volume_averaged_interpolator(points * u.m, "phi").value
+    step = 1.0 / intervals
+    weights = np.ones(intervals + 1)
+    weights[1:-1:2] = 4.0
+    weights[2:-1:2] = 2.0
+    expected = float(np.sum(weights * values)) * step / 3
+    expected *= float(np.linalg.norm(stop - start))
+
+    assert_close(got.value, expected, rtol=1e-7, atol=1e-9)
+
+
+def test_circulation_across_several_cells_on_rough_data():
+    grid = make_rough_grid()
+    start = np.array([-0.85, -0.55, 0.15])
+    stop = np.array([0.75, 1.65, 2.45])
+    got = grid.circulation(np.stack([start, stop]) * u.m, VECTOR)
+
+    intervals = 2**16
+    t = np.linspace(0.0, 1.0, intervals + 1)
+    points = start + t[:, None] * (stop - start)
+    sampled = np.stack(
+        [
+            component.value
+            for component in grid.volume_averaged_interpolator(points * u.m, *VECTOR)
+        ],
+        axis=-1,
+    )
+    integrand = sampled @ (stop - start)
+    weights = np.ones(intervals + 1)
+    weights[1:-1:2] = 4.0
+    weights[2:-1:2] = 2.0
+    expected = float(np.sum(weights * integrand)) / intervals / 3
+
+    assert_close(got.value, expected, rtol=1e-7, atol=1e-9)
+
