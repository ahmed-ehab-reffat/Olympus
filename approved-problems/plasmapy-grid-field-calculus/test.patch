@@ -0,0 +1,2183 @@
+"""Tests for the calculus of the field defined by a grid."""
+
+import astropy.units as u
+import numpy as np
+import pytest
+
+from plasmapy.plasma.grids import CartesianGrid, NonUniformCartesianGrid
+
+COEFFS = {
+    "a": 1.3,
+    "x": 2.1,
+    "y": -3.2,
+    "z": 0.7,
+    "xy": 1.9,
+    "yz": -2.4,
+    "zx": 0.6,
+    "xyz": 3.1,
+}
+
+
+def scalar_field(x, y, z):
+    c = COEFFS
+    return (
+        c["a"]
+        + c["x"] * x
+        + c["y"] * y
+        + c["z"] * z
+        + c["xy"] * x * y
+        + c["yz"] * y * z
+        + c["zx"] * z * x
+        + c["xyz"] * x * y * z
+    )
+
+
+def scalar_gradient(x, y, z):
+    c = COEFFS
+    return np.stack(
+        [
+            c["x"] + c["xy"] * y + c["zx"] * z + c["xyz"] * y * z,
+            c["y"] + c["xy"] * x + c["yz"] * z + c["xyz"] * x * z,
+            c["z"] + c["yz"] * y + c["zx"] * x + c["xyz"] * x * y,
+        ],
+        axis=-1,
+    )
+
+
+def scalar_antiderivative(x, y, z):
+    c = COEFFS
+    return (
+        c["a"] * x * y * z
+        + c["x"] * x**2 * y * z / 2
+        + c["y"] * x * y**2 * z / 2
+        + c["z"] * x * y * z**2 / 2
+        + c["xy"] * x**2 * y**2 * z / 4
+        + c["yz"] * x * y**2 * z**2 / 4
+        + c["zx"] * x**2 * y * z**2 / 4
+        + c["xyz"] * x**2 * y**2 * z**2 / 8
+    )
+
+
+def box_reference(lower, upper):
+    total = 0.0
+    for i in (0, 1):
+        for j in (0, 1):
+            for k in (0, 1):
+                corner = (
+                    upper[0] if i else lower[0],
+                    upper[1] if j else lower[1],
+                    upper[2] if k else lower[2],
+                )
+                total += (-1) ** (i + j + k + 1) * scalar_antiderivative(*corner)
+    return total
+
+
+def line_reference(start, stop):
+    # The analytic field restricted to a straight line is a cubic in the
+    # path parameter, so Simpson's rule over the whole segment is exact.
+    middle = 0.5 * (start + stop)
+    average = (
+        scalar_field(*start) + 4 * scalar_field(*middle) + scalar_field(*stop)
+    ) / 6
+    return average * float(np.linalg.norm(stop - start))
+
+
+def make_grid(num=(5, 6, 7)):
+    grid = CartesianGrid(
+        np.array([-1.0, -1.0, -1.0]) * u.m,
+        np.array([1.0, 2.0, 3.0]) * u.m,
+        num=list(num),
+    )
+    x, y, z = (component.si.value for component in grid.grids)
+    grid.add_quantities(phi=scalar_field(x, y, z) * u.V)
+    # A solenoidal, irrotational field.
+    grid.add_quantities(B_x=(y * z) * u.T, B_y=(z * x) * u.T, B_z=(x * y) * u.T)
+    # A field with divergence x + y + z and curl (-y, -z, -x).
+    grid.add_quantities(
+        E_x=(x * y) * u.V / u.m,
+        E_y=(y * z) * u.V / u.m,
+        E_z=(z * x) * u.V / u.m,
+    )
+    return grid
+
+
+def make_nonuniform_grid():
+    rng = np.random.default_rng(7)
+    points = rng.uniform(-1.0, 1.0, size=(4, 4, 4))
+    grid = NonUniformCartesianGrid(
+        points * u.m,
+        points * u.m,
+        points * u.m,
+    )
+    grid.add_quantities(phi=points * u.V)
+    return grid
+
+
+def make_centimetre_grid():
+    grid = CartesianGrid(
+        np.array([-100.0, -100.0, -100.0]) * u.cm,
+        np.array([100.0, 200.0, 300.0]) * u.cm,
+        num=[5, 6, 7],
+    )
+    x, y, z = (component.si.value for component in grid.grids)
+    grid.add_quantities(phi=scalar_field(x, y, z) * u.V)
+    grid.add_quantities(
+        E_x=(x * y) * u.V / u.m,
+        E_y=(y * z) * u.V / u.m,
+        E_z=(z * x) * u.V / u.m,
+    )
+    return grid
+
+
+def make_mixed_unit_grid():
+    # Metres, centimetres and millimetres on the three axes, spanning
+    # exactly the same region in SI as make_grid, so the analytic
+    # references apply unchanged.
+    x = np.linspace(-1.0, 1.0, 5)
+    y = np.linspace(-100.0, 200.0, 6)
+    z = np.linspace(-1000.0, 3000.0, 7)
+    gx, gy, gz = np.meshgrid(x, y, z, indexing="ij")
+    grid = CartesianGrid(gx * u.m, gy * u.cm, gz * u.mm)
+    xs, ys, zs = (component.si.value for component in grid.grids)
+    grid.add_quantities(phi=scalar_field(xs, ys, zs) * u.V)
+    grid.add_quantities(
+        E_x=(xs * ys) * u.V / u.m,
+        E_y=(ys * zs) * u.V / u.m,
+        E_z=(zs * xs) * u.V / u.m,
+    )
+    return grid
+
+
+def make_rough_grid(num=(4, 5, 6)):
+    rng = np.random.default_rng(99)
+    grid = CartesianGrid(
+        np.array([-1.0, -1.0, -1.0]) * u.m,
+        np.array([1.0, 2.0, 3.0]) * u.m,
+        num=list(num),
+    )
+    grid.add_quantities(phi=rng.normal(size=(num[0], num[1], num[2])) * u.V)
+    grid.add_quantities(
+        E_x=rng.normal(size=(num[0], num[1], num[2])) * u.V / u.m,
+        E_y=rng.normal(size=(num[0], num[1], num[2])) * u.V / u.m,
+        E_z=rng.normal(size=(num[0], num[1], num[2])) * u.V / u.m,
+    )
+    return grid
+
+
+def trapezoid_weights(count):
+    weights = np.ones(count)
+    weights[0] = weights[-1] = 0.5
+    return weights
+
+
+def nodal_volume_integral(grid, key):
+    values = grid[key].value
+    step = spacings(grid)
+    weight = (
+        trapezoid_weights(values.shape[0])[:, None, None]
+        * trapezoid_weights(values.shape[1])[None, :, None]
+        * trapezoid_weights(values.shape[2])[None, None, :]
+    )
+    return float(np.sum(weight * values)) * float(np.prod(step))
+
+
+def spacings(grid):
+    return np.array(
+        [grid.dax0.si.value, grid.dax1.si.value, grid.dax2.si.value],
+    )
+
+
+def forward_difference(grid, index):
+    values = grid["phi"].value
+    i, j, k = index
+    step = spacings(grid)
+    return np.array(
+        [
+            (values[i + 1, j, k] - values[i, j, k]) / step[0],
+            (values[i, j + 1, k] - values[i, j, k]) / step[1],
+            (values[i, j, k + 1] - values[i, j, k]) / step[2],
+        ],
+    )
+
+
+def backward_difference(grid, index):
+    values = grid["phi"].value
+    i, j, k = index
+    step = spacings(grid)
+    return np.array(
+        [
+            (values[i, j, k] - values[i - 1, j, k]) / step[0],
+            (values[i, j, k] - values[i, j - 1, k]) / step[1],
+            (values[i, j, k] - values[i, j, k - 1]) / step[2],
+        ],
+    )
+
+
+def node_position(grid, index):
+    i, j, k = index
+    return np.array(
+        [
+            grid.ax0.si.value[i],
+            grid.ax1.si.value[j],
+            grid.ax2.si.value[k],
+        ],
+    )
+
+
+def sample_positions(count=40):
+    rng = np.random.default_rng(2024)
+    return rng.uniform([-1.0, -1.0, -1.0], [1.0, 2.0, 3.0], size=(count, 3))
+
+
+VECTOR = ("E_x", "E_y", "E_z")
+SOLENOIDAL = ("B_x", "B_y", "B_z")
+
+
+def assert_close(got, expected, rtol=1e-9, atol=1e-11):
+    np.testing.assert_allclose(got, expected, rtol=rtol, atol=atol)
+
+
+def test_gradient_matches_the_analytic_gradient():
+    grid = make_grid()
+    pos = sample_positions()
+    got = grid.gradient(pos * u.m, "phi")
+    assert_close(got.value, scalar_gradient(*pos.T))
+
+
+def test_gradient_has_quantity_per_metre_units():
+    grid = make_grid()
+    got = grid.gradient(np.array([[0.0, 0.5, 1.0]]) * u.m, "phi")
+    assert got.unit.is_equivalent(u.V / u.m)
+
+
+def test_gradient_shape_is_positions_by_three():
+    grid = make_grid()
+    got = grid.gradient(sample_positions(11) * u.m, "phi")
+    assert got.shape == (11, 3)
+
+
+def test_gradient_accepts_a_single_position():
+    grid = make_grid()
+    got = grid.gradient(np.array([0.25, 0.75, 1.5]) * u.m, "phi")
+    assert got.shape == (1, 3)
+    assert_close(got.value[0], scalar_gradient(0.25, 0.75, 1.5))
+
+
+def test_gradient_off_the_grid_is_nan():
+    grid = make_grid()
+    got = grid.gradient(np.array([[5.0, 0.0, 0.0]]) * u.m, "phi")
+    assert np.all(np.isnan(got.value))
+
+
+def test_gradient_marks_only_the_off_grid_rows_as_nan():
+    grid = make_grid()
+    pos = np.array([[0.0, 0.0, 0.0], [5.0, 0.0, 0.0], [0.5, 0.5, 0.5]])
+    got = grid.gradient(pos * u.m, "phi").value
+    assert not np.any(np.isnan(got[0]))
+    assert np.all(np.isnan(got[1]))
+    assert not np.any(np.isnan(got[2]))
+
+
+def test_gradient_returns_one_array_per_quantity():
+    grid = make_grid()
+    pos = sample_positions(5)
+    first, second = grid.gradient(pos * u.m, "E_x", "E_y")
+    assert first.shape == (5, 3)
+    assert second.shape == (5, 3)
+
+
+def test_gradient_at_an_interior_node_uses_the_cell_above():
+    grid = make_rough_grid()
+    index = (2, 2, 3)
+    got = grid.gradient(node_position(grid, index) * u.m, "phi").value[0]
+    assert_close(got, forward_difference(grid, index))
+
+
+def test_gradient_just_below_an_interior_node_uses_the_cell_below():
+    grid = make_rough_grid()
+    index = (2, 2, 3)
+    below = node_position(grid, index) - 1e-9
+    got = grid.gradient(below * u.m, "phi").value[0]
+    assert_close(got, backward_difference(grid, index), rtol=1e-6)
+
+
+def test_gradient_at_the_upper_edge_uses_the_last_cell():
+    grid = make_rough_grid()
+    last = (grid.shape[0] - 1, grid.shape[1] - 1, grid.shape[2] - 1)
+    got = grid.gradient(node_position(grid, last) * u.m, "phi").value[0]
+    assert np.all(np.isfinite(got))
+    assert_close(got, backward_difference(grid, last))
+
+
+def test_gradient_at_the_lower_edge_uses_the_first_cell():
+    grid = make_rough_grid()
+    got = grid.gradient(node_position(grid, (0, 0, 0)) * u.m, "phi").value[0]
+    assert_close(got, forward_difference(grid, (0, 0, 0)))
+
+
+def test_gradient_of_a_ndarray_position_assumes_grid_units():
+    grid = make_grid()
+    pos = sample_positions(6)
+    assert_close(
+        grid.gradient(pos, "phi").value,
+        grid.gradient(pos * u.m, "phi").value,
+    )
+
+
+def test_gradient_rejects_an_unknown_quantity():
+    grid = make_grid()
+    with pytest.raises(KeyError):
+        grid.gradient(np.array([[0.0, 0.0, 0.0]]) * u.m, "not_a_quantity")
+
+
+def test_gradient_on_a_nonuniform_grid_is_not_implemented():
+    grid = make_nonuniform_grid()
+    with pytest.raises(NotImplementedError):
+        grid.gradient(np.array([[0.0, 0.0, 0.0]]) * u.m, "phi")
+
+
+def test_gradient_is_not_the_finite_difference_of_the_samples():
+    grid = make_grid(num=(3, 3, 3))
+    inside = np.array([[0.4, 0.1, 0.6]])
+    got = grid.gradient(inside * u.m, "phi").value[0]
+    coarse = np.gradient(
+        grid["phi"].value,
+        grid.ax0.si.value,
+        grid.ax1.si.value,
+        grid.ax2.si.value,
+    )
+    nodal = np.array([component[1, 1, 1] for component in coarse])
+    assert not np.allclose(got, nodal, rtol=1e-3)
+
+
+def test_divergence_of_a_solenoidal_field_is_zero():
+    grid = make_grid()
+    got = grid.divergence(sample_positions() * u.m, SOLENOIDAL)
+    assert_close(got.value, np.zeros(40))
+
+
+def test_divergence_matches_the_analytic_value():
+    grid = make_grid()
+    pos = sample_positions()
+    got = grid.divergence(pos * u.m, VECTOR)
+    assert_close(got.value, pos.sum(axis=1))
+
+
+def test_divergence_is_one_dimensional():
+    grid = make_grid()
+    got = grid.divergence(sample_positions(9) * u.m, VECTOR)
+    assert got.shape == (9,)
+
+
+def test_divergence_has_field_per_metre_units():
+    grid = make_grid()
+    got = grid.divergence(np.array([[0.0, 0.0, 0.0]]) * u.m, VECTOR)
+    assert got.unit.is_equivalent(u.V / u.m**2)
+
+
+def test_divergence_rejects_the_wrong_number_of_components():
+    grid = make_grid()
+    with pytest.raises(ValueError):
+        grid.divergence(np.array([[0.0, 0.0, 0.0]]) * u.m, ("E_x", "E_y"))
+
+
+def test_divergence_rejects_components_with_different_units():
+    grid = make_grid()
+    with pytest.raises(ValueError):
+        grid.divergence(np.array([[0.0, 0.0, 0.0]]) * u.m, ("E_x", "E_y", "B_z"))
+
+
+def test_curl_of_an_irrotational_field_is_zero():
+    grid = make_grid()
+    got = grid.curl(sample_positions() * u.m, SOLENOIDAL)
+    assert_close(got.value, np.zeros((40, 3)))
+
+
+def test_curl_matches_the_analytic_value():
+    grid = make_grid()
+    pos = sample_positions()
+    got = grid.curl(pos * u.m, VECTOR)
+    assert_close(got.value, -pos[:, [1, 2, 0]])
+
+
+def test_curl_shape_is_positions_by_three():
+    grid = make_grid()
+    assert grid.curl(sample_positions(8) * u.m, VECTOR).shape == (8, 3)
+
+
+def test_curl_off_the_grid_is_nan():
+    grid = make_grid()
+    got = grid.curl(np.array([[0.0, 0.0, -9.0]]) * u.m, VECTOR)
+    assert np.all(np.isnan(got.value))
+
+
+def test_line_integral_matches_the_analytic_quadrature():
+    grid = make_grid()
+    start = np.array([-0.9, -0.5, 0.2])
+    stop = np.array([0.8, 1.7, 2.5])
+    got = grid.line_integral(np.stack([start, stop]) * u.m, "phi")
+    assert_close(got.value, line_reference(start, stop))
+
+
+def test_line_integral_has_quantity_times_metre_units():
+    grid = make_grid()
+    path = np.array([[0.0, 0.0, 0.0], [0.5, 0.5, 0.5]])
+    got = grid.line_integral(path * u.m, "phi")
+    assert got.unit.is_equivalent(u.V * u.m)
+
+
+def test_line_integral_is_a_scalar():
+    grid = make_grid()
+    path = np.array([[0.0, 0.0, 0.0], [0.5, 0.5, 0.5]])
+    assert grid.line_integral(path * u.m, "phi").isscalar
+
+
+def test_line_integral_is_unchanged_by_reversing_the_path():
+    grid = make_grid()
+    path = np.array([[-0.9, -0.5, 0.2], [0.8, 1.7, 2.5]])
+    forward = grid.line_integral(path * u.m, "phi")
+    backward = grid.line_integral(path[::-1] * u.m, "phi")
+    assert_close(backward.value, forward.value)
+
+
+def test_line_integral_adds_over_the_segments_of_a_polyline():
+    grid = make_grid()
+    a = np.array([-0.8, -0.4, 0.1])
+    b = np.array([0.2, 0.9, 1.4])
+    c = np.array([0.9, 1.8, 2.6])
+    whole = grid.line_integral(np.stack([a, b, c]) * u.m, "phi")
+    parts = grid.line_integral(np.stack([a, b]) * u.m, "phi") + grid.line_integral(
+        np.stack([b, c]) * u.m,
+        "phi",
+    )
+    assert_close(whole.value, parts.value)
+
+
+def test_line_integral_only_counts_the_part_on_the_grid():
+    grid = make_grid()
+    path = np.array([[-4.0, 0.5, 0.5], [4.0, 0.5, 0.5]])
+    clipped = np.array([[-1.0, 0.5, 0.5], [1.0, 0.5, 0.5]])
+    got = grid.line_integral(path * u.m, "phi")
+    expected = grid.line_integral(clipped * u.m, "phi")
+    assert_close(got.value, expected.value)
+
+
+def test_line_integral_of_a_path_that_misses_the_grid_is_zero():
+    grid = make_grid()
+    path = np.array([[8.0, 8.0, 8.0], [9.0, 9.0, 9.0]])
+    assert_close(grid.line_integral(path * u.m, "phi").value, 0.0)
+
+
+def test_line_integral_of_a_zero_length_path_is_zero():
+    grid = make_grid()
+    path = np.array([[0.3, 0.3, 0.3], [0.3, 0.3, 0.3]])
+    assert_close(grid.line_integral(path * u.m, "phi").value, 0.0)
+
+
+def test_line_integral_along_an_axis_matches_the_analytic_integral():
+    grid = make_grid()
+    path = np.array([[-1.0, 0.5, 1.5], [1.0, 0.5, 1.5]])
+    c = COEFFS
+    expected = 2 * (
+        c["a"]
+        + c["y"] * 0.5
+        + c["z"] * 1.5
+        + c["yz"] * 0.5 * 1.5
+    )
+    assert_close(grid.line_integral(path * u.m, "phi").value, expected)
+
+
+def test_line_integral_rejects_a_single_vertex():
+    grid = make_grid()
+    with pytest.raises(ValueError):
+        grid.line_integral(np.array([[0.0, 0.0, 0.0]]) * u.m, "phi")
+
+
+def test_line_integral_returns_one_scalar_per_quantity():
+    grid = make_grid()
+    path = np.array([[-0.5, 0.0, 0.5], [0.5, 1.0, 1.5]])
+    first, second = grid.line_integral(path * u.m, "phi", "E_x")
+    assert first.unit.is_equivalent(u.V * u.m)
+    assert second.unit.is_equivalent(u.V)
+
+
+def test_circulation_changes_sign_when_the_path_is_reversed():
+    grid = make_grid()
+    path = np.array([[-0.7, -0.3, 0.4], [0.6, 1.4, 2.2]])
+    forward = grid.circulation(path * u.m, VECTOR)
+    backward = grid.circulation(path[::-1] * u.m, VECTOR)
+    assert_close(backward.value, -forward.value)
+
+
+def test_circulation_along_an_axis_matches_the_analytic_integral():
+    grid = make_grid()
+    path = np.array([[-1.0, 0.5, 1.5], [1.0, 0.5, 1.5]])
+    expected = 0.5 * (1.0**2 - (-1.0) ** 2) / 2
+    assert_close(grid.circulation(path * u.m, VECTOR).value, expected)
+
+
+def test_circulation_has_field_times_metre_units():
+    grid = make_grid()
+    path = np.array([[0.0, 0.0, 0.0], [0.5, 0.0, 0.0]])
+    assert grid.circulation(path * u.m, VECTOR).unit.is_equivalent(u.V)
+
+
+def test_circulation_around_a_closed_loop_obeys_stokes_theorem():
+    grid = make_grid()
+    x0, x1, y0, y1, zc = -0.6, 0.5, -0.2, 1.3, 1.1
+    loop = np.array(
+        [
+            [x0, y0, zc],
+            [x1, y0, zc],
+            [x1, y1, zc],
