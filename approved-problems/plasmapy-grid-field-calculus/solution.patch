+
+        return pos
+
+    def gradient(self, pos, *args: str):  # noqa: ANN201
+        r"""
+        The gradient of one or more quantities at arbitrary positions.
+
+        The grid defines a continuous field by multilinear interpolation
+        between the eight grid points that surround a position, which is
+        the same field returned by
+        `~plasmapy.plasma.grids.CartesianGrid.volume_averaged_interpolator`.
+        The gradient returned here is the exact gradient of that field.
+
+        Parameters
+        ----------
+        pos : `~numpy.ndarray` or `~astropy.units.Quantity`, shape (n,3)
+            Positions at which to evaluate the gradient. If a
+            `~numpy.ndarray` is provided, units are assumed to match
+            those of the grid.
+
+        *args : `str`
+            Strings that correspond to DataArrays in the dataset.
+
+        Returns
+        -------
+        `~astropy.units.Quantity` or `tuple`
+            An array of shape ``(n, 3)`` for each quantity, in units of
+            that quantity per metre. Positions off the grid are returned
+            as not-a-number.
+        """
+        axes, values, units = self._calculus_setup(args)
+        pos = self._si_positions(pos)
+        result = _grid_calculus.gradient(axes, values, pos)
+        output = [
+            result[:, index, :] * (unit / u.m) for index, unit in enumerate(units)
+        ]
+        return output[0] if len(output) == 1 else tuple(output)
+
+    def divergence(self, pos, keys):
+        r"""
+        The divergence of a vector field at arbitrary positions.
+
+        The three components of the field are taken from the three
+        quantities named in ``keys``, and the divergence is that of the
+        multilinear field the grid defines.
+
+        Parameters
+        ----------
+        pos : `~numpy.ndarray` or `~astropy.units.Quantity`, shape (n,3)
+            Positions at which to evaluate the divergence.
+
+        keys : ``iterable`` of `str`
+            The three DataArrays holding the components of the vector
+            field along each axis of the grid.
+
+        Returns
+        -------
+        `~astropy.units.Quantity`
+            An array of shape ``(n,)`` in units of the field per metre.
+        """
+        axes, values, unit = self._vector_setup(keys)
+        pos = self._si_positions(pos)
+        jacobian = _grid_calculus.gradient(axes, values, pos)
+        return np.trace(jacobian, axis1=1, axis2=2) * (unit / u.m)
+
+    def curl(self, pos, keys):
+        r"""
+        The curl of a vector field at arbitrary positions.
+
+        Parameters
+        ----------
+        pos : `~numpy.ndarray` or `~astropy.units.Quantity`, shape (n,3)
+            Positions at which to evaluate the curl.
+
+        keys : ``iterable`` of `str`
+            The three DataArrays holding the components of the vector
+            field along each axis of the grid.
+
+        Returns
+        -------
+        `~astropy.units.Quantity`
+            An array of shape ``(n, 3)`` in units of the field per metre.
+        """
+        axes, values, unit = self._vector_setup(keys)
+        pos = self._si_positions(pos)
+        jacobian = _grid_calculus.gradient(axes, values, pos)
+        result = np.empty((pos.shape[0], 3))
