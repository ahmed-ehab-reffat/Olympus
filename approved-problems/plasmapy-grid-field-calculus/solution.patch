+
+    def _calculus_setup(self, args):
+        r"""
+        Common validation for the calculus methods.
+
+        Returns the three axes and the quantity arrays in SI units, along
+        with the units that were stripped from the quantities.
+
+        Raises
+        ------
+        `NotImplementedError`
+            If the grid is not uniformly spaced.
+
+        `KeyError`
+            If one of the ``args`` does not correspond to a DataArray in
+            the DataSet.
+        """
+        if not self.is_uniform:
+            raise NotImplementedError(
+                "Calculus on a grid is only defined for uniformly spaced grids.",
+            )
+
+        for arg in args:
+            if arg not in self.quantities:
+                raise KeyError(
+                    "Quantity arguments must correspond to "
+                    "DataArrays in the DataSet. "
+                    f"{arg} was not found. "
+                    f"Existing keys are: {self.quantities}",
+                )
+
+        axes = [self._ax0_si, self._ax1_si, self._ax2_si]
+        values = np.stack(
+            [self.ds[arg].to_numpy() for arg in args],
+            axis=-1,
+        ).astype(np.float64)
+        units = [self.ds[arg].attrs["unit"] for arg in args]
+        return axes, values, units
+
+    def _vector_setup(self, keys):
+        r"""
+        Validation for the calculus methods that take the three
+        components of a vector field.
+
+        Raises
+        ------
+        `ValueError`
+            If ``keys`` does not name exactly three quantities, or if the
+            three quantities do not share a single unit.
+        """
+        keys = tuple(keys)
+        if len(keys) != 3:
+            raise ValueError(
+                "A vector field must be given as three quantity keys, "
+                f"but {len(keys)} were provided.",
+            )
+
+        axes, values, units = self._calculus_setup(keys)
+
+        if not (units[0] == units[1] == units[2]):
+            raise ValueError(
+                f"The components {keys} do not all have the same units: {units}.",
+            )
+
+        return axes, values, units[0]
+
+    def _si_positions(self, pos, *, name: str = "pos"):  # noqa: ANN202
