+"""
+Kernels for the exact calculus of the multilinear field defined by a
+uniformly spaced Cartesian grid.
+
+Every routine in this module works in SI units and on bare
+`~numpy.ndarray` objects. The public entry points live on
+`~plasmapy.plasma.grids.AbstractGrid`.
+"""
+
+__all__: list[str] = []
+
+from itertools import pairwise
+
+import numpy as np
+
+# Relative tolerance used when deciding whether a direction cosine is small
+# enough that a segment does not cross cell boundaries along that axis.
+_DIRECTION_TOL = 1e-14
+
+
+def _cell_index(ax, x):
+    """
+    Index of the cell along ``ax`` that contains ``x``.
+
+    Cell ``i`` spans ``ax[i]`` to ``ax[i + 1]``. A position that falls
+    exactly on an interior node belongs to the cell above it; the upper
+    edge of the axis belongs to the final cell.
+    """
+    index = np.searchsorted(ax, x, side="right") - 1
+    return np.clip(index, 0, ax.size - 2)
+
+
+def _corner_values(values, i0, i1, i2):
+    """
+    Gather the eight corner values of the cells identified by the index
+    arrays into an array of shape ``(n, 8, nargs)``.
+
+    The corner ordering is the binary counting order of the offsets
+    ``(a, b, c)`` along the three axes.
+    """
+    corners = np.empty((i0.size, 8, values.shape[-1]))
+    for corner, (a, b, c) in enumerate(_OFFSETS):
+        corners[:, corner, :] = values[i0 + a, i1 + b, i2 + c, :]
+    return corners
+
+
+_OFFSETS = [(a, b, c) for a in (0, 1) for b in (0, 1) for c in (0, 1)]
+
+
+def _corner_weights(u0, u1, u2):
+    """
+    Multilinear weights of the eight cell corners for local coordinates
+    that each run from zero to one across the cell.
+    """
+    weights = np.empty((np.size(u0), 8))
+    for corner, (a, b, c) in enumerate(_OFFSETS):
+        w0 = u0 if a else 1 - u0
+        w1 = u1 if b else 1 - u1
+        w2 = u2 if c else 1 - u2
+        weights[:, corner] = w0 * w1 * w2
+    return weights
+
+
+def _corner_weight_derivatives(u0, u1, u2):
+    """
+    Derivatives of the multilinear corner weights with respect to each of
+    the three local coordinates, as an array of shape ``(n, 8, 3)``.
+    """
+    derivatives = np.empty((np.size(u0), 8, 3))
+    for corner, (a, b, c) in enumerate(_OFFSETS):
+        w0 = u0 if a else 1 - u0
+        w1 = u1 if b else 1 - u1
+        w2 = u2 if c else 1 - u2
+        d0 = 1.0 if a else -1.0
+        d1 = 1.0 if b else -1.0
+        d2 = 1.0 if c else -1.0
+        derivatives[:, corner, 0] = d0 * w1 * w2
+        derivatives[:, corner, 1] = w0 * d1 * w2
+        derivatives[:, corner, 2] = w0 * w1 * d2
+    return derivatives
+
+
+def _local_coordinates(axes, positions):
+    """
+    Cell indices and local coordinates of positions given in SI metres.
+    """
+    indices = []
+    local = []
+    for axis, column in zip(axes, positions.T, strict=True):
+        index = _cell_index(axis, column)
+        indices.append(index)
+        spacing = axis[index + 1] - axis[index]
+        local.append((column - axis[index]) / spacing)
+    return indices, local
+
+
+def _outside(axes, positions):
+    """Boolean mask of positions that lie outside the grid."""
+    mask = np.zeros(positions.shape[0], dtype=bool)
+    for axis, column in zip(axes, positions.T, strict=True):
+        mask |= (column < axis[0]) | (column > axis[-1])
+    return mask
+
+
+def evaluate(axes, values, positions):
+    """
+    Multilinear field values at ``positions``, shape ``(n, nargs)``.
+
+    Positions outside the grid are returned as not-a-number.
+    """
+    (i0, i1, i2), (u0, u1, u2) = _local_coordinates(axes, positions)
+    corners = _corner_values(values, i0, i1, i2)
+    weights = _corner_weights(u0, u1, u2)
+    result = np.einsum("nc,ncq->nq", weights, corners)
+    result[_outside(axes, positions), :] = np.nan
+    return result
+
+
+def gradient(axes, values, positions):
+    """
+    Gradient of the multilinear field at ``positions``, shape
+    ``(n, nargs, 3)``, in units of the quantity per metre.
+    """
+    (i0, i1, i2), (u0, u1, u2) = _local_coordinates(axes, positions)
+    corners = _corner_values(values, i0, i1, i2)
+    derivatives = _corner_weight_derivatives(u0, u1, u2)
+
+    spacings = np.empty((positions.shape[0], 3))
+    for axis_number, (axis, index) in enumerate(zip(axes, (i0, i1, i2), strict=True)):
+        spacings[:, axis_number] = axis[index + 1] - axis[index]
+
+    result = np.einsum("ncd,ncq->nqd", derivatives, corners)
+    result /= spacings[:, None, :]
+    result[_outside(axes, positions), :, :] = np.nan
+    return result
+
+
+def deposit(axes, shape, positions, amounts):
+    """
+    Spread each amount over the eight grid points that surround its
+    position, using the same weights the multilinear field uses.
+
+    This is the transpose of `evaluate`: the total that lands on the grid
+    is exactly the total carried by the positions that are on it.
+    """
+    (i0, i1, i2), (u0, u1, u2) = _local_coordinates(axes, positions)
+    weights = _corner_weights(u0, u1, u2)
+    weights[_outside(axes, positions), :] = 0.0
+
+    result = np.zeros(shape)
+    for corner, (a, b, c) in enumerate(_OFFSETS):
+        np.add.at(
+            result,
+            (i0 + a, i1 + b, i2 + c),
+            weights[:, corner] * amounts,
+        )
+    return result
+
+
+def _segment_bounds(axes, start, direction):
+    """
+    Parameter interval of the segment ``start + t * direction`` that lies
+    inside the grid, or `None` when no part of it does.
+    """
+    lower, upper = 0.0, 1.0
+    for axis, origin, step in zip(axes, start, direction, strict=True):
+        span = abs(axis[-1] - axis[0])
+        if abs(step) <= _DIRECTION_TOL * max(span, abs(origin)):
+            if origin < axis[0] or origin > axis[-1]:
+                return None
+            continue
+        first = (axis[0] - origin) / step
+        last = (axis[-1] - origin) / step
+        lower = max(lower, min(first, last))
+        upper = min(upper, max(first, last))
+    return None if upper <= lower else (lower, upper)
+
+
+def _segment_breaks(axes, start, direction, lower, upper):
+    """
+    Sorted parameter values at which the segment enters a new cell,
+    including the two ends of the interval.
+    """
+    breaks = [lower, upper]
+    for axis, origin, step in zip(axes, start, direction, strict=True):
+        span = abs(axis[-1] - axis[0])
+        if abs(step) <= _DIRECTION_TOL * max(span, abs(origin)):
+            continue
+        crossings = (axis - origin) / step
+        breaks.extend(crossings[(crossings > lower) & (crossings < upper)].tolist())
+    return np.unique(np.asarray(breaks, dtype=float))
+
+
+def _integrate_segment(axes, values, start, stop, weight):
+    """
+    Integral of ``weight(field)`` along one straight segment with respect
+    to the segment parameter.
+
+    ``weight`` maps an array of field values of shape ``(n, nargs)`` onto
+    an array of shape ``(n, nresults)``. Because the field is a cubic
+    polynomial of the parameter within any one cell, Simpson's rule is
+    exact on each piece.
+    """
+    direction = stop - start
+    bounds = _segment_bounds(axes, start, direction)
+    if bounds is None:
+        return None
+    breaks = _segment_breaks(axes, start, direction, *bounds)
+    if breaks.size < 2:
+        return None
+
+    left = breaks[:-1]
+    right = breaks[1:]
+    middle = 0.5 * (left + right)
+
+    samples = np.concatenate([left, middle, right])
+    positions = start[None, :] + samples[:, None] * direction[None, :]
+
+    # Every sample of a piece is evaluated with the polynomial of the cell
+    # that piece lies in, which is the cell holding its midpoint. The two
+    # ends sit on the boundary of that cell, so this is not an
+    # extrapolation.
+    (i0, i1, i2), _ = _local_coordinates(axes, positions[len(left) : 2 * len(left)])
+    indices = (np.tile(i0, 3), np.tile(i1, 3), np.tile(i2, 3))
+
+    corners = _corner_values(values, *indices)
+    spacings = [axes[k][indices[k] + 1] - axes[k][indices[k]] for k in range(3)]
+    local = [(positions[:, k] - axes[k][indices[k]]) / spacings[k] for k in range(3)]
+    field = np.einsum("nc,ncq->nq", _corner_weights(*local), corners)
+
+    integrand = weight(field)
+    pieces = len(left)
+    simpson = (
+        integrand[:pieces]
+        + 4 * integrand[pieces : 2 * pieces]
+        + integrand[2 * pieces :]
+    ) / 6
+    return np.einsum("p,pr->r", right - left, simpson)
+
+
+def line_integral(axes, values, vertices):
+    """
+    Integral of each quantity with respect to arc length along the
+    polyline given by ``vertices``.
+    """
+    nargs = values.shape[-1]
+    total = np.zeros(nargs)
+    for start, stop in pairwise(vertices):
+        length = float(np.linalg.norm(stop - start))
+        if length == 0.0:
+            continue
+        piece = _integrate_segment(axes, values, start, stop, lambda field: field)
+        if piece is not None:
+            total += length * piece
+    return total
+
+
+def circulation(axes, values, vertices):
+    """
+    Integral of the vector field, whose three components are the three
+    quantities in ``values``, projected onto the polyline.
+    """
+    total = 0.0
+    for start, stop in pairwise(vertices):
+        direction = stop - start
+        if not np.any(direction):
+            continue
+        piece = _integrate_segment(
+            axes,
+            values,
+            start,
+            stop,
+            lambda field, step=direction: (field @ step)[:, None],
+        )
+        if piece is not None:
+            total += float(piece[0])
+    return total
+
+
+def _clip_intervals(axis, lower, upper):
+    """
+    Intersection of each interval with the extent of ``axis``, returned
+    as its two ends and its length. An interval that misses the axis
+    entirely is reported with zero length.
+    """
+    left = np.maximum(np.minimum(lower, upper), axis[0])
+    right = np.minimum(np.maximum(lower, upper), axis[-1])
+    right = np.maximum(right, left)
+    return left, right, right - left
+
+
+def _hat_values(axis, position):
+    """
+    Value of every nodal basis function at each position, as an array of
+    shape ``(m, n)``.
+
+    The multilinear field of the grid is the sum of the nodal values
+    weighted by these functions, so a field integral becomes a
+    contraction against basis integrals.
+    """
+    weights = np.zeros((np.size(position), axis.size))
+    cell = _cell_index(axis, position)
+    width = axis[cell + 1] - axis[cell]
+    local = (position - axis[cell]) / width
+    rows = np.arange(np.size(position))
+    weights[rows, cell] = 1 - local
+    weights[rows, cell + 1] += local
+    return weights
+
+
+def _hat_integrals(axis, lower, upper):
+    """
+    Integral of every nodal basis function over each interval, as an
+    array of shape ``(m, n)``.
+
+    Each cell is visited once and contributes to the two basis functions
+    it supports. Within a cell both are linear, so the integral over the
+    part of the interval inside that cell is the average of the two end
+    values times the length of that part.
+    """
+    left, right, _ = _clip_intervals(axis, lower, upper)
+    weights = np.zeros((left.size, axis.size))
+
+    for cell in range(axis.size - 1):
+        start, stop = axis[cell], axis[cell + 1]
+        width = stop - start
+        a = np.clip(left, start, stop)
+        b = np.clip(right, start, stop)
+        length = b - a
+        weights[:, cell] += 0.5 * ((stop - a) + (stop - b)) * length / width
+        weights[:, cell + 1] += 0.5 * ((a - start) + (b - start)) * length / width
+
+    return weights
+
+
+def _contract(values, w0, w1, w2):
+    """
+    Contract nodal values against per-axis weight matrices, giving one
+    result per weight row and quantity.
+    """
+    return np.einsum("ijkq,mi,mj,mk->mq", values, w0, w1, w2, optimize=True)
+
+
+def box_integral(axes, values, lower, upper):
+    """
+    Integral of each quantity over an axis-aligned box, with the part of
+    the box outside the grid contributing nothing.
+    """
+    weights = [
+        _hat_integrals(axis, np.array([lower[k]]), np.array([upper[k]]))
+        for k, axis in enumerate(axes)
+    ]
+    return _contract(values, *weights)[0]
+
+
+def box_volume(axes, lower, upper):
+    """Volume of the part of an axis-aligned box that lies on the grid."""
+    lengths = [
+        _clip_intervals(axis, np.array([lower[k]]), np.array([upper[k]]))[2]
+        for k, axis in enumerate(axes)
+    ]
+    return float(lengths[0][0] * lengths[1][0] * lengths[2][0])
+
+
+def surface_flux(axes, values, lower, upper, normal_axis):
+    """
+    Flux of the vector field, whose three components are the three
+    quantities in ``values``, through an axis-aligned rectangle, taken
+    towards increasing ``normal_axis``.
+    """
+    position = lower[normal_axis]
+    axis = axes[normal_axis]
+    if position < axis[0] or position > axis[-1]:
+        return 0.0
+
+    weights = []
+    for k, axis_k in enumerate(axes):
+        if k == normal_axis:
+            weights.append(_hat_values(axis_k, np.array([position])))
+        else:
+            weights.append(
+                _hat_integrals(axis_k, np.array([lower[k]]), np.array([upper[k]])),
+            )
+
+    return float(_contract(values, *weights)[0, normal_axis])
+
+
+def remap(source_axes, values, target_axes):
+    """
+    Average of each quantity over the target cell that surrounds every
+    node of the target axes.
+
+    The cell around a node reaches half of the local target spacing in
+    each direction. Averages are taken over the part of that cell inside
+    the source grid; nodes whose cell misses the source grid entirely
+    come back as not-a-number.
+    """
+    lengths = []
+    weights = []
+    for axis, target in zip(source_axes, target_axes, strict=True):
+        edges = np.concatenate(
+            [
+                [target[0] - 0.5 * (target[1] - target[0])],
+                0.5 * (target[:-1] + target[1:]),
+                [target[-1] + 0.5 * (target[-1] - target[-2])],
+            ],
+        )
+        lower, upper = edges[:-1], edges[1:]
+        weights.append(_hat_integrals(axis, lower, upper))
+        lengths.append(_clip_intervals(axis, lower, upper)[2])
+
+    integrals = np.einsum(
+        "ijkq,ai,bj,ck->abcq",
+        values,
+        *weights,
+        optimize=True,
+    )
+    volumes = lengths[0][:, None, None] * lengths[1][None, :, None]
+    volumes = volumes * lengths[2][None, None, :]
+
+    empty = volumes == 0
+    result = integrals / np.where(empty, 1.0, volumes)[..., None]
+    result[empty, :] = np.nan
+    return result
