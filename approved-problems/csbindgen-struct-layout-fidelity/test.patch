+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"; export CARGO_INCREMENTAL=0; export RUSTC_BOOTSTRAP=1
+MODE=""; OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+cd "$(dirname "$0")"
+TEST_JSON="$(mktemp)"; TEST_ERR="$(mktemp)"; STATUS=0; BROKEN=()
+run_cargo() {
+  local label="$1"; shift
+  local json err rc
+  json="$(mktemp)"; err="$(mktemp)"
+  cargo test -p csbindgen "$@" -Z unstable-options --format json --report-time > "$json" 2> "$err"
+  rc=$?
+  cat "$json" >> "$TEST_JSON"; cat "$err" >> "$TEST_ERR"
+  if [ "$rc" -ne 0 ]; then
+    STATUS=1
+    if ! grep -q '"type": *"test"' "$json"; then
+      BROKEN+=("$label")
+      cat "$err" "$json" > "$TEST_ERR.$label"
+    fi
+  fi
+  rm -f "$json" "$err"
+}
+# csbindgen-tests is not part of either mode: its build script runs bindgen (libclang) and a C compiler.
+case "$MODE" in
+  base) run_cargo lib --lib --
+        run_cargo unchanged --test struct_layout_6cd9d4 -- unchanged:: ;;
+  new)  run_cargo new --test struct_layout_6cd9d4 -- --skip unchanged:: ;;
+esac
+cat "$TEST_ERR" >&2
+NEW_TESTS="$(grep -E '^\s*(mod |fn [a-z_0-9]+\(\) \{)' csbindgen/tests/struct_layout_6cd9d4.rs 2>/dev/null | awk '/^mod /{m=$2} /fn /{sub(/\(\).*/,"",$2); if (m!="" && m!="fx" && m!="unchanged") print m" "$2}')"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  HAD_CASES=0
+  : > "$OUTPUT_PATH"
+  if grep -q '"type": *"test"' "$TEST_JSON"; then
+    cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2> "$TEST_ERR.junit"
+    if grep -q '<testcase' "$OUTPUT_PATH" \
+      && python3 -c 'import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])' "$OUTPUT_PATH" 2>> "$TEST_ERR.junit"; then
+      sed -i -e ':a' -e 's/\(classname="[^"]*\)::/\1./' -e 'ta' "$OUTPUT_PATH" 2>/dev/null || true
+      grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null && HAD_CASES=1
+    else
+      STATUS=1
+      tail -c 2000 "$TEST_JSON" >> "$TEST_ERR.junit"
+      BROKEN+=(junit)
+    fi
+  fi
+  if [ "$HAD_CASES" -eq 0 ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    if [ "${#BROKEN[@]}" -eq 0 ]; then
+      BROKEN=(compilation)
+      cat "$TEST_ERR" "$TEST_JSON" > "$TEST_ERR.compilation"
+    fi
+  fi
+  count=0; cases=""
+  for label in "${BROKEN[@]}"; do
+    sanitized=$(tail -c 4000 "$TEST_ERR.$label" | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    if [ "$label" = "new" ] && [ -n "$NEW_TESTS" ]; then
+      while read -r class name; do
+        [ -n "$name" ] || continue
+        count=$((count + 1))
+        cases="${cases}    <testcase name=\"${name}\" classname=\"${class}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+      done <<< "$NEW_TESTS"
+    else
+      count=$((count + 1))
+      cases="${cases}    <testcase name=\"${label}\" classname=\"cargo-test\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+    fi
+  done
+  if [ "$count" -gt 0 ]; then
+    suite="  <testsuite name=\"cargo build\" tests=\"${count}\" failures=\"${count}\" errors=\"0\">
+${cases}  </testsuite>
+"
+    if [ "$HAD_CASES" -eq 1 ]; then
+      body="$(cat "$OUTPUT_PATH")"
+      body="${body%</testsuites>*}"
+      { printf '%s' "$body"; printf '%s' "$suite"; printf '</testsuites>\n'; } > "$OUTPUT_PATH"
+    else
+      { printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'; printf '%s' "$suite"; printf '</testsuites>\n'; } > "$OUTPUT_PATH"
+    fi
+  fi
+fi
+rm -f "$TEST_JSON" "$TEST_ERR" "$TEST_ERR".*
+exit $STATUS
