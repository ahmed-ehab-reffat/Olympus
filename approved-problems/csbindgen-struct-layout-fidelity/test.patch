+
+fn generated() -> &'static str {
+    static CS: OnceLock<String> = OnceLock::new();
+    CS.get_or_init(|| {
+        let dir = std::path::PathBuf::from(env!("CARGO_TARGET_TMPDIR"));
+        let input = dir.join("struct_layout_input.rs");
+        let output = dir.join("struct_layout_output.cs");
+        std::fs::write(&input, SRC).unwrap();
+        csbindgen::Builder::new()
+            .input_extern_file(&input)
+            .always_included_types(TYPES.iter().map(|x| x.to_string()))
+            .generate_csharp_file(&output)
+            .unwrap();
+        std::fs::read_to_string(&output).unwrap()
+    })
+}
+
+fn block(name: &str) -> String {
+    let cs = generated();
+    let marker = format!(" struct {name}\n");
+    let pos = cs
+        .find(&marker)
+        .unwrap_or_else(|| panic!("{name} not emitted\n{cs}"));
+    let start = cs[..pos].rfind("[StructLayout").unwrap();
+    let end = pos + cs[pos..].find("\n    }").unwrap();
+    cs[start..end].to_string()
+}
+
+fn layout_line(name: &str) -> String {
+    block(name).lines().next().unwrap().to_string()
+}
+
+fn sequential(name: &str, fields: &[&str]) -> String {
+    let mut text = format!(
+        "[StructLayout(LayoutKind.Sequential)]\n    internal unsafe partial struct {name}\n    {{"
+    );
+    for f in fields {
+        text.push_str(&format!("\n        {f}"));
+    }
+    text
+}
+
+fn explicit_size(b: &str) -> Option<usize> {
+    let i = b.find("Size = ")?;
+    b[i + 7..]
+        .chars()
+        .take_while(|c| c.is_ascii_digit())
+        .collect::<String>()
+        .parse()
+        .ok()
+}
+
+fn field_offset(b: &str, field: &str) -> Option<usize> {
+    let lines: Vec<&str> = b.lines().collect();
+    for (i, l) in lines.iter().enumerate() {
+        let t = l.trim().trim_end_matches(';');
+        if t.ends_with(&format!(" {field}")) || t.contains(&format!(" {field}[")) {
+            let prev = lines[i - 1].trim();
+            let prev = prev.strip_prefix("[FieldOffset(")?.strip_suffix(")]")?;
+            return prev.parse().ok();
+        }
+    }
+    None
+}
+
+fn assert_explicit(name: &str, size: usize, fields: &[(&str, usize)]) {
+    let b = block(name);
+    assert!(
+        b.starts_with("[StructLayout(LayoutKind.Explicit, Size = "),
+        "{name} not explicit:\n{b}"
+    );
+    assert_eq!(explicit_size(&b), Some(size), "{name} size\n{b}");
+    let lines: Vec<&str> = b.lines().map(str::trim).collect();
+    for (i, l) in lines.iter().enumerate().skip(3) {
+        if l.starts_with("public ") {
+            assert!(
+                lines[i - 1].starts_with("[FieldOffset("),
+                "{name}: no FieldOffset on `{l}`\n{b}"
+            );
+        }
+    }
+    for (f, off) in fields {
+        assert_eq!(field_offset(&b, f), Some(*off), "{name}.{f}\n{b}");
+    }
+}
