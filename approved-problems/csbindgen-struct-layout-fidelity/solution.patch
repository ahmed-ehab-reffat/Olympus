+            } else {
+                None
+            };
+            if meta.path.is_ident("packed") {
+                pack = Some(value.unwrap_or(1));
+            } else if meta.path.is_ident("align") {
+                align = value.max(align);
+            }
+            Ok(())
+        });
+    }
+    (repr, pack, align)
