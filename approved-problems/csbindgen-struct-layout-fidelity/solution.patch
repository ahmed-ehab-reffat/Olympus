diff --git a/csbindgen/src/layout.rs b/csbindgen/src/layout.rs
new file mode 100644
index 0000000..7aa6a80
--- /dev/null
+++ b/csbindgen/src/layout.rs
@@ -0,0 +1,265 @@
+use crate::alias_map::AliasMap;
+use crate::type_meta::{PointerType, RustEnum, RustStruct, RustType, TypeKind};
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Layout {
+    pub size: usize,
+    pub align: usize,
+}
+
+#[derive(Clone, Debug)]
+pub struct StructLayout {
+    pub rust: Layout,
+    pub csharp: Layout,
+    pub offsets: Vec<Option<usize>>,
+    pub explicit: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct ArrayShape {
+    pub element: RustType,
+    pub count: usize,
+    pub stride: usize,
+    pub fixed: bool,
+}
+
+pub struct LayoutMap<'a> {
+    structs: HashMap<&'a str, &'a RustStruct>,
+    enums: HashMap<&'a str, &'a RustEnum>,
+    aliases: &'a AliasMap,
+    cache: RefCell<HashMap<String, Option<StructLayout>>>,
+}
+
+fn round_up(value: usize, align: usize) -> usize {
+    value.div_ceil(align) * align
+}
+
+fn primitive_size(name: &str) -> Option<usize> {
+    let size = match name {
+        "()" | "PhantomData" => 0,
+        "i8" | "u8" | "bool" | "c_char" | "c_schar" | "c_uchar" | "NonZeroI8" | "NonZeroU8" => 1,
+        "i16" | "u16" | "c_short" | "c_ushort" | "NonZeroI16" | "NonZeroU16" => 2,
+        "i32" | "u32" | "f32" | "char" | "c_int" | "c_uint" | "c_float" | "NonZeroI32"
+        | "NonZeroU32" => 4,
+        "i64" | "u64" | "f64" | "isize" | "usize" | "c_long" | "c_ulong" | "c_longlong"
+        | "c_ulonglong" | "c_double" | "NonZeroI64" | "NonZeroU64" | "NonZeroIsize"
+        | "NonZeroUsize" => 8,
+        "i128" | "u128" | "NonZeroI128" | "NonZeroU128" => 16,
+        _ => return None,
+    };
+    Some(size)
+}
+
+fn fixed_element_size(name: &str) -> Option<usize> {
+    match name {
+        "()" | "PhantomData" | "isize" | "usize" | "c_long" | "c_ulong" | "i128" | "u128"
+        | "NonZeroI128" | "NonZeroU128" | "NonZeroIsize" | "NonZeroUsize" => None,
+        x => primitive_size(x),
+    }
+}
+
+impl<'a> LayoutMap<'a> {
+    pub fn new(structs: &'a [RustStruct], enums: &'a [RustEnum], aliases: &'a AliasMap) -> Self {
+        Self {
+            structs: structs
+                .iter()
+                .map(|x| (x.struct_name.as_str(), x))
+                .collect(),
+            enums: enums.iter().map(|x| (x.enum_name.as_str(), x)).collect(),
+            aliases,
+            cache: RefCell::new(HashMap::new()),
+        }
+    }
+
+    pub fn struct_layout(&self, name: &str) -> Option<StructLayout> {
+        if let Some(x) = self.cache.borrow().get(name) {
+            return x.clone();
+        }
+        self.cache.borrow_mut().insert(name.to_string(), None);
+        let result = self.structs.get(name).and_then(|x| self.compute(x));
+        self.cache
+            .borrow_mut()
+            .insert(name.to_string(), result.clone());
+        result
+    }
+
+    fn named(&self, name: &str, rust: bool) -> Option<Layout> {
+        if let Some(size) = primitive_size(name).filter(|_| !self.structs.contains_key(name)) {
+            let align = if rust { size } else { size.min(8) }.max(1);
+            return Some(Layout { size, align });
+        }
+        if let Some(target) = self.aliases.get(name) {
+            return if rust {
+                self.rust_layout(target)
+            } else {
+                self.csharp_layout(target)
+            };
+        }
+        if let Some(e) = self.enums.get(name) {
+            let size = match e.repr.as_deref()? {
+                "C" => 4,
+                x => primitive_size(x)?,
+            };
+            return Some(if rust {
+                let align = size.max(e.align.unwrap_or(1));
+                Layout {
+                    size: round_up(size, align),
+                    align,
+                }
+            } else {
+                Layout {
+                    size,
+                    align: size.min(8),
+                }
+            });
+        }
+        let info = self.struct_layout(name)?;
+        Some(if rust { info.rust } else { info.csharp })
+    }
+
+    fn resolve(&self, rust_type: &RustType) -> RustType {
+        let mut current = rust_type.clone();
+        while matches!(current.type_kind, TypeKind::Normal) {
+            match self.aliases.get(&current.type_name) {
+                Some(x) => current = x.clone(),
+                None => break,
+            }
+        }
+        current
+    }
+
+    pub fn array_shape(&self, rust_type: &RustType) -> Option<ArrayShape> {
+        let TypeKind::FixedArray(digits, None, elem) = self.resolve(rust_type).type_kind else {
+            return None;
+        };
+        let count = digits.parse::<usize>().ok()?;
+        if let Some(inner) = self.array_shape(&elem) {
+            return Some(ArrayShape {
+                count: count * inner.count,
+                ..inner
+            });
+        }
+        let resolved = self.resolve(&elem);
+        let fixed = match &resolved.type_kind {
+            TypeKind::Normal => fixed_element_size(&resolved.type_name).is_some(),
+            TypeKind::Option(inner) if self.nullable(inner) => {
+                let payload = self.resolve(inner);
+                matches!(payload.type_kind, TypeKind::Normal)
+                    && fixed_element_size(&payload.type_name).is_some()
+            }
+            _ => false,
+        };
+        Some(ArrayShape {
+            stride: self.rust_layout(&elem)?.size,
+            element: *elem,
+            count,
+            fixed,
+        })
+    }
+
+    fn nullable(&self, rust_type: &RustType) -> bool {
+        let resolved = self.resolve(rust_type);
+        if self.structs.contains_key(resolved.type_name.as_str()) {
+            return false;
+        }
+        match &resolved.type_kind {
+            TypeKind::Function(..) => true,
+            TypeKind::Pointer(p, _) => matches!(p, PointerType::NonNull | PointerType::Box),
+            TypeKind::Normal => {
+                resolved.type_name.starts_with("NonZero")
+                    && primitive_size(&resolved.type_name).is_some()
+            }
+            _ => false,
+        }
+    }
+
+    fn rust_layout(&self, rust_type: &RustType) -> Option<Layout> {
+        match &rust_type.type_kind {
+            TypeKind::Normal => self.named(&rust_type.type_name, true),
+            TypeKind::Option(inner) if self.nullable(inner) => self.rust_layout(inner),
+            TypeKind::Option(_) => None,
+            TypeKind::FixedArray(..) => {
+                let shape = self.array_shape(rust_type)?;
+                let elem = self.rust_layout(&shape.element)?;
+                Some(Layout {
+                    size: elem.size * shape.count,
+                    align: elem.align,
+                })
+            }
+            _ => Some(Layout { size: 8, align: 8 }),
+        }
+    }
+
+    fn csharp_layout(&self, rust_type: &RustType) -> Option<Layout> {
+        match &rust_type.type_kind {
+            TypeKind::Normal => self.named(&rust_type.type_name, false),
+            TypeKind::Option(inner) if self.nullable(inner) => self.csharp_layout(inner),
+            TypeKind::Option(_) => None,
+            TypeKind::FixedArray(..) => {
+                let shape = self.array_shape(rust_type)?;
+                let elem = self.csharp_layout(&shape.element)?;
+                Some(Layout {
+                    size: elem.size * shape.count,
+                    align: elem.align,
+                })
+            }
+            _ => Some(Layout { size: 8, align: 8 }),
+        }
+    }
+
+    fn compute(&self, item: &RustStruct) -> Option<StructLayout> {
+        if !item.is_repr && !item.is_union {
+            return None;
+        }
+        let cap = |align: usize| item.pack.map_or(align, |p| align.min(p));
+
+        let mut offsets = Vec::new();
+        let mut same_offsets = true;
+        let (mut rust_end, mut rust_align) = (0, 1);
+        let (mut cs_end, mut cs_align) = (0, 1);
+        for field in &item.fields {
+            let rust = self.rust_layout(&field.rust_type)?;
+            let cs = self.csharp_layout(&field.rust_type)?;
+            let rust_offset = if item.is_union {
+                0
+            } else {
+                round_up(rust_end, cap(rust.align))
+            };
+            rust_end = rust_end.max(rust_offset + rust.size);
+            rust_align = rust_align.max(cap(rust.align));
+            if rust.size == 0 {
+                offsets.push(None);
+                continue;
+            }
+            offsets.push(Some(rust_offset));
+            let cs_offset = if item.is_union {
+                0
+            } else {
+                round_up(cs_end, cap(cs.align))
+            };
+            same_offsets &= rust_offset == cs_offset;
+            cs_end = cs_end.max(cs_offset + cs.size);
+            cs_align = cs_align.max(cap(cs.align));
+        }
+
+        let rust_align = rust_align.max(item.align.unwrap_or(1));
+        let rust_size = round_up(rust_end, rust_align);
+        let cs_size = round_up(cs_end, cs_align);
+        let explicit = rust_size > 0 && (!same_offsets || rust_size != cs_size);
+
+        Some(StructLayout {
+            rust: Layout {
+                size: rust_size,
+                align: rust_align,
+            },
+            csharp: Layout {
+                size: rust_size,
+                align: cs_align,
+            },
+            offsets,
+            explicit,
+        })
+    }
+}
