+def test_nonblock_call_keeps_its_format_values(tmp_path):
+    single = spanning("s", [(HAP_A, 12), ({}, 12)], range(1185, 1196))
+    block = spanning("g", [({2200: alt(2200), 2240: alt(2240)}, 10), ({}, 10)], range(2185, 2196))
+    runs = {}
+    for name, frags, peaks, extra in (("alone", single, [(1100, 1400)], ("--pair-aware", "-F", "off")),
+                                      ("block", single + block, [(1100, 1400), (2100, 2400)],
+                                       ("--pair-aware", "-F", "off")),
+                                      ("read", single, [(1100, 1400)], ("-F", "off"))):
