+        assert any(len(r["alt"]) > len(r["ref"]) for r in rows["pair"].values())
+        read, frag = rows["read"][site]["info"], rows["pair"][site]["info"]
+        assert (depth(read, "DPT"), depth(read, "DPC")) == (60, 40)
+        assert (depth(frag, "DPT"), depth(frag, "DPC")) == (30, 20)
+        assert [depth(frag, k) for k in ("DP1T", "DP2T", "DP1C", "DP2C")] == [15, 15, 10, 10]
+        assert rows["pair"][site]["sample"]["DP"] == "50"
