diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..1d88001
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,85 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/macs3-test-results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")"
+export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"
+
+NEW_TESTS="test/test_callvar_fragments_38c44a.py"
+
+BUILD_LOG="$(mktemp)"
+python setup.py build_ext --inplace -j "$(nproc)" > "$BUILD_LOG" 2>&1
+BUILD_RC=$?
+
+PYTEST_LOG="$(mktemp)"
+if [ "$MODE" = "new" ]; then
+  python -m pytest -p no:cacheprovider -q "$NEW_TESTS" --junitxml="$OUTPUT_PATH" 2>&1 | tee "$PYTEST_LOG"
+else
+  python -m pytest -p no:cacheprovider -q test --ignore="$NEW_TESTS" --junitxml="$OUTPUT_PATH" 2>&1 | tee "$PYTEST_LOG"
+fi
+TEST_RC=$?
+
+python - "$OUTPUT_PATH" "$BUILD_RC" "$BUILD_LOG" "$MODE" "$PYTEST_LOG" <<'PYEOF'
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+path, build_rc, build_log, mode, pytest_log = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5]
+with open(build_log, errors="replace") as f:
+    log_tail = f.read()[-4000:]
+with open(pytest_log, errors="replace") as f:
+    pytest_tail = f.read()[-4000:]
+
+tree = None
+if os.path.exists(path):
+    try:
+        tree = ET.parse(path)
+    except ET.ParseError:
+        tree = None
+
+cases = tree.getroot().iter("testcase") if tree is not None else []
+cases = list(cases)
+if not cases:
+    root = ET.Element("testsuites")
+    suite = ET.SubElement(root, "testsuite", name="macs3-" + mode, tests="1", failures="1")
+    case = ET.SubElement(suite, "testcase", classname="macs3." + mode, name="test_collection")
+    failure = ET.SubElement(case, "failure", message="no test results were produced")
+    failure.text = "pytest output:\n" + pytest_tail + "\n\nextension build output:\n" + log_tail
+    ET.ElementTree(root).write(path, encoding="utf-8", xml_declaration=True)
+    sys.exit(1)
+
+for case in cases:
+    case.set("classname", case.get("classname", "").replace("::", "."))
+    case.set("name", case.get("name", "").replace("::", "."))
+    if build_rc != 0:
+        outcome = next((child for child in case if child.tag in ("failure", "error")), None)
+        if outcome is None:
+            for child in [c for c in case if c.tag == "skipped"]:
+                case.remove(child)
+            outcome = ET.SubElement(case, "failure", message="extension build failed")
+            outcome.text = ""
+        outcome.text = (outcome.text or "") + "\n\nextension build failed:\n" + log_tail
+tree.write(path, encoding="utf-8", xml_declaration=True)
+sys.exit(1 if build_rc != 0 else 0)
+PYEOF
+POST_RC=$?
+
+rm -f "$BUILD_LOG" "$PYTEST_LOG"
+if [ "$BUILD_RC" -ne 0 ] || [ "$POST_RC" -ne 0 ]; then
+  exit 1
+fi
+exit "$TEST_RC"
diff --git a/test/test_callvar_fragments_38c44a.py b/test/test_callvar_fragments_38c44a.py
new file mode 100644
index 0000000..e8c3799
--- /dev/null
+++ b/test/test_callvar_fragments_38c44a.py
@@ -0,0 +1,1167 @@
+import os
+import random
+import struct
+import subprocess
+import sys
+import zlib
+
+
+REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+MACS3 = [sys.executable, os.path.join(REPO, "bin", "macs3")]
+RL = 60
+CHROM = "chrT"
+CHROM_LEN = 5000
+BAM_CODE = "=ACMGRSVTWYHKDBN"
+EOF_BLOCK = bytes.fromhex("1f8b08040000000000ff0600424302001b0003000000000000000000")
+
+
+def reference(seed=7):
+    rng = random.Random(seed)
+    return "".join(rng.choice("ACGT") for _ in range(CHROM_LEN))
+
+
+REF = reference()
+
+
+def alt(pos, k=1):
+    return "ACGT"[("ACGT".index(REF[pos]) + k) % 4]
+
+
+def bgzf(data):
+    comp = zlib.compressobj(6, zlib.DEFLATED, -15)
+    cdata = comp.compress(data) + comp.flush()
+    head = b"\x1f\x8b\x08\x04\x00\x00\x00\x00\x00\xff" + struct.pack("<H", 6)
+    head += b"BC" + struct.pack("<HH", 2, len(cdata) + 25)
+    return head + cdata + struct.pack("<II", zlib.crc32(data) & 0xFFFFFFFF, len(data))
+
+
+def reg2bin(beg, end):
+    end -= 1
+    for shift, base in ((14, 4681), (17, 585), (20, 73), (23, 9), (26, 1)):
+        if beg >> shift == end >> shift:
+            return base + (beg >> shift)
+    return 0
+
+
+class Read:
+    def __init__(self, start, strand, bases, quals, ops=None):
+        self.start = start
+        self.strand = strand
+        self.bases = bases
+        self.quals = quals
+        self.ops = ops or [("M", RL)]
+
+    def encode(self):
+        seq, qual, cigar, md = [], [], [], []
+        run = 0
+        pos = self.start
+        for op, arg in self.ops:
+            if op == "M":
+                for _ in range(arg):
+                    b = self.bases.get(pos, REF[pos])
+                    seq.append(b)
+                    qual.append(self.quals.get(pos, 30))
+                    if b == REF[pos]:
+                        run += 1
+                    else:
+                        md += [str(run), REF[pos]]
+                        run = 0
+                    pos += 1
+                cigar.append((arg, 0))
+            elif op == "I":
+                seq.extend(arg)
+                qual.extend([30] * len(arg))
+                cigar.append((len(arg), 1))
+            elif op == "D":
+                md += [str(run), "^" + REF[pos:pos + arg]]
+                run = 0
+                pos += arg
+                cigar.append((arg, 2))
+        md.append(str(run))
+        return "".join(seq), qual, cigar, "".join(md), pos
+
+    def end(self):
+        return self.encode()[4]
+
+    def covers(self, pos):
+        return self.start <= pos < self.end()
+
+    def deleted(self, pos):
+        ref = self.start
+        for op, arg in self.ops:
+            if op == "D" and ref <= pos < ref + arg:
+                return True
+            if op in ("M", "D"):
+                ref += arg
+        return False
+
+
+class Fragment:
+    def __init__(self, name, reads, unpaired=False):
+        self.name = name
+        self.reads = reads
+        self.unpaired = unpaired
+
+    def observe(self, pos, q=20):
+        seen = []
+        for r in self.reads:
+            if r.covers(pos) and r.deleted(pos):
+                seen.append(("*", 93, r.strand))
+            elif r.covers(pos) and r.quals.get(pos, 30) > q:
+                seen.append((r.bases.get(pos, REF[pos]), r.quals.get(pos, 30), r.strand))
+        if not seen or len({s[0] for s in seen}) > 1:
+            return None
+        return max(seen, key=lambda s: (s[1], -s[2]))
+
+
+def pair(name, left, flen, hap, first_forward=True, bases1=None, bases2=None,
+         quals1=None, quals2=None, ops1=None, ops2=None):
+    b1 = dict(hap)
+    b1.update(bases1 or {})
+    b2 = dict(hap)
+    b2.update(bases2 or {})
+    r1 = Read(left, 0, b1, quals1 or {}, ops1)
+    r2 = Read(left + flen - RL, 1, b2, quals2 or {}, ops2)
+    r1.first = first_forward
+    r2.first = not first_forward
+    return Fragment(name, [r1, r2])
+
+
+def encode_record(name, read, mate, ref_id=0):
+    seq, qual, cigar, md, end = read.encode()
+    rname = name.encode() + b"\0"
+    packed = bytearray()
+    for i in range(0, len(seq), 2):
+        hi = BAM_CODE.index(seq[i])
+        lo = BAM_CODE.index(seq[i + 1]) if i + 1 < len(seq) else 0
+        packed.append(hi << 4 | lo)
+    flag = 16 if read.strand else 0
+    next_ref, next_pos, tlen = -1, -1, 0
+    if mate is not None:
+        flag |= 1 | 2 | (32 if mate.strand else 0) | (64 if read.first else 128)
+        lo_ = min(read.start, mate.start)
+        hi_ = max(end, mate.end())
+        next_ref, next_pos = ref_id, mate.start
+        tlen = hi_ - lo_ if read.start <= mate.start else lo_ - hi_
+    body = struct.pack("<iiBBHHHiiii", ref_id, read.start, len(rname), 60, reg2bin(read.start, end),
+                       len(cigar), flag, len(seq), next_ref, next_pos, tlen)
+    body += rname + b"".join(struct.pack("<I", n << 4 | op) for n, op in cigar)
+    body += bytes(packed) + bytes(qual) + b"MDZ" + md.encode() + b"\0"
+    return read.start, end, struct.pack("<i", len(body)) + body
+
+
+def write_bam(path, fragments, contigs=(CHROM,)):
+    records = []
+    for frag in fragments:
+        ref_id = contigs.index(getattr(frag, "contig", CHROM))
+        for r in frag.reads:
+            mate = [m for m in frag.reads if m is not r]
+            records.append((ref_id,) + encode_record(frag.name, r, mate[0] if mate and not frag.unpaired else None, ref_id))
+    records.sort(key=lambda r: (r[0], r[1], r[2]))
+    text = b"@HD\tVN:1.6\tSO:coordinate\n" + b"".join(b"@SQ\tSN:%s\tLN:%d\n" % (c.encode(), CHROM_LEN) for c in contigs)
+    header = b"BAM\1" + struct.pack("<i", len(text)) + text + struct.pack("<i", len(contigs))
+    for c in contigs:
+        header += struct.pack("<i", len(c) + 1) + c.encode() + b"\0" + struct.pack("<i", CHROM_LEN)
+    out = bytearray(bgzf(header))
+    offsets = []
+    for ref_id in range(len(contigs)):
+        block = bytearray()
+        coffset = len(out)
+        for rid, beg, end, raw in records:
+            if rid == ref_id:
+                offsets.append((ref_id, coffset << 16 | len(block), beg, end, len(raw)))
+                block.extend(raw)
+        if block:
+            out.extend(bgzf(bytes(block)))
+    out.extend(EOF_BLOCK)
+    with open(path, "wb") as f:
+        f.write(bytes(out))
+    bai = bytearray(b"BAI\1" + struct.pack("<i", len(contigs)))
+    for ref_id in range(len(contigs)):
+        bins, linear, spans = {}, {}, []
+        for rid, uoff, beg, end, blen in offsets:
+            if rid != ref_id:
+                continue
+            v0, v1 = uoff, uoff + blen
+            spans.append((v0, v1))
+            chunks = bins.setdefault(reg2bin(beg, end), [])
+            if chunks and chunks[-1][1] == v0:
+                chunks[-1][1] = v1
+            else:
+                chunks.append([v0, v1])
+            for w in range(beg >> 14, ((end - 1) >> 14) + 1):
+                linear.setdefault(w, v0)
+        if not spans:
+            bai += struct.pack("<ii", 0, 0)
+            continue
+        bai += struct.pack("<i", len(bins) + 1)
+        for b, chunks in sorted(bins.items()):
+            bai += struct.pack("<Ii", b, len(chunks))
+            for v0, v1 in chunks:
+                bai += struct.pack("<QQ", v0, v1)
+        bai += struct.pack("<Ii", 37450, 2) + struct.pack("<QQQQ", spans[0][0], spans[-1][1], len(spans), 0)
+        bai += struct.pack("<i", max(linear) + 1)
+        for w in range(max(linear) + 1):
+            bai += struct.pack("<Q", linear.get(w, spans[0][0]))
+    bai += struct.pack("<Q", 0)
+    with open(path + ".bai", "wb") as f:
+        f.write(bytes(bai))
+
+
+def callvar(tmp_path, treat, peaks, ctrl=None, extra=("--pair-aware", "-F", "off"), contigs=(CHROM,)):
+    tfile = os.path.join(str(tmp_path), "t.bam")
+    write_bam(tfile, treat, contigs)
+    bed = os.path.join(str(tmp_path), "peaks.bed")
+    with open(bed, "w") as f:
+        for peak in peaks:
+            chrom, s, e = peak if len(peak) == 3 else (CHROM,) + tuple(peak)
+            f.write("%s\t%d\t%d\n" % (chrom, s, e))
+    out = os.path.join(str(tmp_path), "out.vcf")
+    cmd = MACS3 + ["callvar", "-b", bed, "-t", tfile, "-o", out, "-D", "100"] + list(extra)
+    if ctrl is not None:
+        cfile = os.path.join(str(tmp_path), "c.bam")
+        write_bam(cfile, ctrl, contigs)
+        cmd += ["-c", cfile]
+    proc = subprocess.run(cmd, capture_output=True, text=True, cwd=str(tmp_path))
+    assert proc.returncode == 0, proc.stderr[-3000:]
+    rows = {}
+    with open(out) as f:
+        for line in f:
+            if line.startswith("#") or not line.strip():
+                continue
+            fs = line.rstrip("\n").split("\t")
+            info = dict(kv.split("=", 1) for kv in fs[7].split(";") if "=" in kv)
+            sample = dict(zip(fs[8].split(":"), fs[9].split(":")))
+            rows[int(fs[1]) - 1] = {"ref": fs[3], "alt": fs[4], "info": info,
+                                    "format": fs[8], "sample": sample}
+    return rows
+
+
+def depth(info, key):
+    return int("".join(c for c in info[key] if c.isdigit()))
+
+
+def n_edits(read):
+    seq, _, cigar, md, _ = read.encode()
+    return sum(1 for c in md if c.isalpha()) + sum(n for n, op in cigar if op == 1)
+
+
+def kept(fragments, others=()):
+    edits = sorted(n_edits(r) for f in list(fragments) + list(others) for r in f.reads)
+    cutoff = edits[int(len(edits) * 0.95)]
+    return [Fragment(f.name, [r for r in f.reads if n_edits(r) <= cutoff]) for f in fragments]
+
+
+def expected_counts(fragments, pos, others=(), q=20):
+    counts = {}
+    for frag in kept(fragments, others):
+        obs = frag.observe(pos, q)
+        if obs is not None:
+            counts[obs[0]] = counts.get(obs[0], 0) + 1
+    return counts
+
+
+def two_site_fragments(n, sites, haps, seed, flens=(80, 90, 100, 150, 170), window=(1100, 1190)):
+    rng = random.Random(seed)
+    frags = []
+    for i in range(n):
+        hap = haps[i % len(haps)]
+        left = rng.randint(*window)
+        frags.append(pair("f%03d" % i, left, rng.choice(flens), hap, first_forward=bool(i % 3)))
+    return frags
+
+
+S1, S2 = 1200, 1240
+HAP_A = {S1: alt(S1)}
+HAP_B = {S2: alt(S2)}
+
+
+def test_overlapping_mates_count_once_per_site(tmp_path):
+    frags = two_site_fragments(40, (S1, S2), [HAP_A, HAP_B], seed=3)
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    for site in (S1, S2):
+        want = expected_counts(frags, site)
+        info = rows[site]["info"]
+        assert depth(info, "DPT") == sum(want.values())
+        got = {info["DP1T"].lstrip("0123456789"): depth(info, "DP1T"),
+               info["DP2T"].lstrip("0123456789"): depth(info, "DP2T")}
+        assert got == want
+        assert int(rows[site]["sample"]["DP"]) == sum(want.values())
+
+
+def test_mates_that_disagree_contribute_nothing(tmp_path):
+    frags = two_site_fragments(40, (S1, S2), [HAP_A, HAP_B], seed=11, flens=(80, 90))
+    both = [f for f in frags if all(r.covers(S1) for r in f.reads)]
+    assert len(both) >= 6
+    for frag in both[:6]:
+        frag.reads[1].bases[S1] = alt(S1, 2)
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    want = expected_counts(frags, S1)
+    assert alt(S1, 2) not in want
+    info = rows[S1]["info"]
+    assert depth(info, "DPT") == sum(want.values())
+    got = {info["DP1T"].lstrip("0123456789"): depth(info, "DP1T"),
+           info["DP2T"].lstrip("0123456789"): depth(info, "DP2T")}
+    assert got == want
+
+
+def test_low_quality_mate_is_ignored_for_the_fragment(tmp_path):
+    frags = two_site_fragments(40, (S1, S2), [HAP_A, HAP_B], seed=12, flens=(80, 90))
+    both = [f for f in frags if all(r.covers(S1) for r in f.reads)]
+    assert len(both) >= 8
+    for frag in both[:8]:
+        frag.reads[1].bases[S1] = alt(S1, 2)
+        frag.reads[1].quals[S1] = 12
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    want = expected_counts(frags, S1)
+    info = rows[S1]["info"]
+    assert depth(info, "DPT") == sum(want.values())
+    assert sorted([depth(info, "DP1T"), depth(info, "DP2T")]) == sorted(want.values())
+
+
+def test_custom_quality_cutoff_ignores_mates_at_the_cutoff(tmp_path):
+    frags = two_site_fragments(40, (S1, S2), [HAP_A, HAP_B], seed=12, flens=(80, 90))
+    for frag in frags:
+        for r in frag.reads:
+            r.quals.update({S1: 35, S2: 35})
+    both = [f for f in frags if all(r.covers(S1) for r in f.reads)]
+    assert len(both) >= 10
+    for i, frag in enumerate(both[:10]):
+        frag.reads[1].bases[S1] = alt(S1, 2)
+        frag.reads[1].quals[S1] = 30 if i % 2 else 31
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off", "-Q", "30"))
+    want = {}
+    for frag in kept(frags):
+        obs = frag.observe(S1, q=30)
+        if obs is not None:
+            want[obs[0]] = want.get(obs[0], 0) + 1
+    info = rows[S1]["info"]
+    assert depth(info, "DPT") == sum(want.values())
+    assert sorted([depth(info, "DP1T"), depth(info, "DP2T")]) == sorted(want.values())
+
+
+def test_opposite_alleles_phase_in_trans(tmp_path):
+    frags = two_site_fragments(40, (S1, S2), [HAP_A, HAP_B], seed=3)
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    assert rows[S1]["format"] == rows[S2]["format"] == "GT:DP:GQ:PL:PS"
+    assert rows[S1]["sample"]["GT"] == "0|1"
+    assert rows[S2]["sample"]["GT"] == "1|0"
+    assert rows[S1]["sample"]["PS"] == rows[S2]["sample"]["PS"] == str(S1 + 1)
+
+
+def test_shared_alleles_phase_in_cis(tmp_path):
+    hap = {S1: alt(S1), S2: alt(S2)}
+    frags = two_site_fragments(40, (S1, S2), [hap, {}], seed=5)
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    assert rows[S1]["sample"]["GT"] == "0|1"
+    assert rows[S2]["sample"]["GT"] == "0|1"
+    assert rows[S2]["sample"]["PS"] == str(S1 + 1)
+
+
+def block_haplotypes(frags, lefts):
+    hap1, hap2 = [], []
+    for frag in frags:
+        sides = set()
+        best = 0
+        for entry in lefts:
+            site, left = entry[:2]
+            called = entry[2] if len(entry) > 2 else (REF[site], alt(site))
+            obs = frag.observe(site)
+            if obs is None:
+                continue
+            if obs[0] not in called:
+                sides.add(2)
+            else:
+                sides.add(0 if obs[0] == left else 1)
+            best = max(best, obs[1])
+        if sides == {0}:
+            hap1.append(best)
+        elif sides == {1}:
+            hap2.append(best)
+    return hap1, hap2
+
+
+def test_block_ratio_is_the_first_haplotype_share(tmp_path):
+    frags = two_site_fragments(48, (S1, S2), [HAP_A, HAP_A, HAP_A, HAP_B], seed=8)
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    hap1, hap2 = block_haplotypes(kept(frags), ((S1, REF[S1]), (S2, alt(S2))))
+    assert rows[S1]["sample"]["GT"] == "0|1"
+    for site in (S1, S2):
+        assert rows[site]["info"]["BAR"] == "%.2f" % (len(hap1) / (len(hap1) + len(hap2)))
+
+
+def test_uncalled_allele_keeps_fragment_out_of_both_haplotypes(tmp_path):
+    frags = two_site_fragments(48, (S1, S2), [HAP_A, HAP_A, HAP_A, HAP_B], seed=8)
+    for i, (left, flen) in enumerate(((1146, 118), (1152, 116), (1160, 104), (1167, 101), (1174, 89))):
+        frags.append(pair("u%02d" % i, left, flen, HAP_B, first_forward=bool(i % 2),
+                          bases1={S1: alt(S1, 2)}))
+    rows = callvar(tmp_path, frags, [(1100, 1400)], extra=("--pair-aware", "-F", "off"))
+    hap1, hap2 = block_haplotypes(kept(frags), ((S1, REF[S1]), (S2, alt(S2))))
+    assert rows[S1]["sample"]["GT"] == "0|1"
+    assert rows[S2]["sample"]["GT"] == "1|0"
+    for site in (S1, S2):
+        assert rows[site]["info"]["BAR"] == "%.2f" % (len(hap1) / (len(hap1) + len(hap2)))
+
+
+def spanning(prefix, groups, lefts, flen=200):
+    frags = []
+    for hap, n in groups:
+        for _ in range(n):
+            i = len(frags)
+            frags.append(pair("%s%03d" % (prefix, i), lefts[i % len(lefts)], flen, hap,
