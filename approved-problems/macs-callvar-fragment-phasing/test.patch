+def strand_counts(frags, site, alleles, first_read=True):
+    counts = [0, 0, 0, 0]
+    strands = {f.name: next(r.strand for r in f.reads if len(f.reads) == 1 or r.first) for f in frags}
+    for frag in kept(frags):
+        obs = frag.observe(site)
+        if obs is None or obs[0] not in alleles:
+            continue
+        strand = strands[frag.name] if first_read else obs[2]
+        counts[2 * strand + alleles.index(obs[0])] += 1
+    return counts
+
