+    @cython.cfunc
+    def set_block_ratio(self, block: list, flips: dict):
+        haps: dict = {}
+        name: object
+        p: cython.long
+        h: cython.int
+        hap1: cython.int
+        hap2: cython.int
+        ar: cython.float = 0.0
+        for p in block:
+            table = self.d_Variants[p].fragments("T")
+            for name in table:
+                h = table[name][0] ^ flips[p] if table[name][0] >= 0 else -1
+                if haps.setdefault(name, h) != h:
+                    haps[name] = -1
+        hap1 = sum(1 for h in haps.values() if h == 0)
+        hap2 = sum(1 for h in haps.values() if h == 1)
+        if hap1 + hap2 > 0:
+            ar = hap1 / (hap1 + hap2)
+        for p in block:
+            self.d_Variants[p].set_block_ar(ar)
+
