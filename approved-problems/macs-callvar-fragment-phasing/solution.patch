+    @cython.ccall
+    def phase(self):
+        hets: list
+        block: list
+        blocks: dict = {}
+        flips: dict = {}
+        roots: dict = {}
+        p: cython.long
+        q: cython.long
+        i: cython.int
+        j: cython.int
+        votes: cython.int
+        hets = [p for p in sorted(self.d_Variants.keys()) if self.d_Variants[p].is_heter_call()]
+        for i in range(len(hets)):
+            p = hets[i]
+            flips[p] = 0
+            roots[p] = p
+            for j in range(i - 1, -1, -1):
+                q = hets[j]
+                votes = self.link(q, p)
+                if votes != 0:
+                    flips[p] = flips[q] if votes > 0 else 1 - flips[q]
+                    roots[p] = roots[q]
+                    break
+            blocks.setdefault(roots[p], []).append(p)
+        for block in blocks.values():
+            if len(block) < 2:
+                continue
+            for p in block:
+                self.d_Variants[p].set_phase(flips[p], block[0] + 1)
+            self.set_block_ratio(block, flips)
