+    @cython.cfunc
+    def link(self, p: cython.long, q: cython.long) -> cython.int:
+        votes: cython.int = 0
+        opt: str
+        name: object
+        table_p: dict
+        table_q: dict
+        for opt in ("T", "C"):
+            table_p = self.d_Variants[p].fragments(opt)
+            table_q = self.d_Variants[q].fragments(opt)
+            for name in table_p:
+                if name in table_q and table_p[name][0] >= 0 and table_q[name][0] >= 0:
+                    if table_p[name][0] == table_q[name][0]:
+                        votes += 1
+                    else:
+                        votes -= 1
+        return votes
