+func TestWashSaleTacksAcquisition_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 10), big.ZERO)
