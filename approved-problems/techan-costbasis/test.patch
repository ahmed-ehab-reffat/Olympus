+func TestPortfolioMissingMark_cbconf(t *testing.T) {
+	p := cb.NewPortfolio(cb.FIFO, year)
+	p.Apply(techan.Order{Side: techan.BUY, Security: "AAA", Price: big.NewFromInt(10), Amount: big.NewFromInt(4), ExecutionTime: epoch}, big.ZERO)
+	p.Apply(techan.Order{Side: techan.BUY, Security: "BBB", Price: big.NewFromInt(5), Amount: big.NewFromInt(2), ExecutionTime: epoch}, big.ZERO)
+	marks := map[string]big.Decimal{"AAA": big.NewFromInt(12)} // BBB omitted -> contributes nothing
+	eqi(t, p.UnrealizedPnL(marks), 8)       // AAA 4*(12-10)
+	eqi(t, p.GrossExposure(marks), 48)      // AAA 4*12
