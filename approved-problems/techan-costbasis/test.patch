+++ b/test.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd "$(dirname "$0")"
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path)
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      MODE="$1"
+      shift
+      ;;
+    *)
+      shift
+      ;;
+  esac
+done
+
+if [ -z "$MODE" ]; then
+  echo "Usage: ./test.sh --output_path <path> base|new" >&2
+  exit 2
+fi
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="/tmp/report.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+export GOFLAGS="-mod=mod -buildvcs=false"
+export GOCACHE="${GOCACHE:-/tmp/gocache}"
+mkdir -p "$GOCACHE"
+
+CLASSNAME="github.com/sdcoffey/techan/costbasis"
+TEST_FILE="costbasis/costbasis_conformance_test.go"
+LOG="$(mktemp)"
+
+synthesize_failures() {
+  local reason="$1"
+  local names
+  names="$(grep -oE '^func (Test[A-Za-z0-9_]+)\(' "$TEST_FILE" 2>/dev/null | sed -E 's/^func (Test[A-Za-z0-9_]+)\(/\1/')"
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    local count
+    count="$(printf '%s\n' "$names" | grep -c .)"
+    echo "<testsuites><testsuite name=\"$CLASSNAME\" tests=\"$count\" failures=\"$count\">"
+    printf '%s\n' "$names" | while IFS= read -r n; do
+      [ -z "$n" ] && continue
+      echo "  <testcase classname=\"$CLASSNAME\" name=\"$n\"><failure message=\"build failed\"><![CDATA[${reason}]]></failure></testcase>"
+    done
+    echo '</testsuite></testsuites>'
+  } > "$OUTPUT_PATH"
+}
+
+case "$MODE" in
+  base)
+    pkgs="$(go list ./... 2>/dev/null | grep -v '/costbasis$')"
+    go test -v $pkgs 2>&1 | tee "$LOG" | go-junit-report > "$OUTPUT_PATH"
+    STATUS=${PIPESTATUS[0]}
+    ;;
+  new)
+    go test -v -tags=cbconf -run '_cbconf$' ./costbasis/ 2>&1 | tee "$LOG"
+    STATUS=${PIPESTATUS[0]}
+    go-junit-report < "$LOG" > "$OUTPUT_PATH" || true
+    if grep -qE "build failed|cannot find package|no Go files|no required module|undefined:|found packages|is not in std" "$LOG" \
+       || ! grep -q "<testcase" "$OUTPUT_PATH"; then
+      synthesize_failures "$(cat "$LOG")"
+      STATUS=1
+    fi
+    ;;
+esac
+
+rm -f "$LOG"
+exit "$STATUS"
