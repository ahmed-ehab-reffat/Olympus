+func TestWashSaleAdjustsMethodSelection_cbconf(t *testing.T) {
+	// a wash raises the replacement lot's price above another open lot, so a
+	// later HIFO close must select the wash-adjusted lot (price 60), not the
+	// untouched 30 lot; the failure only surfaces on the later close.
+	l := cb.NewWashSaleLedger(cb.HIFO, year, 30*24*time.Hour)
+	l.Apply(buy(30, 5, 0), big.ZERO)
+	l.Apply(buy(50, 5, 1), big.ZERO)
+	l.Apply(sell(10, 5, 10), big.ZERO) // HIFO closes the 50 lot: loss -200
+	l.Apply(buy(20, 5, 15), big.ZERO)  // washes -200 into 5 shares: price 20 -> 60
+	eqi(t, l.Disallowed(), 200)
+	l.Apply(sell(70, 5, 20), big.ZERO) // HIFO must pick the 60 lot: 5*(70-60)=50
+	eqi(t, l.RealizedPnL(), 50)
+	eqi(t, l.Position(), 5)
+	eqi(t, l.CostBasis(), 150) // the 30 lot remains, proving the 60 lot was closed
+}
