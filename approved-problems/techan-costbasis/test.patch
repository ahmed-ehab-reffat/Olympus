+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(sell(20, 10, 0), big.ZERO) // short 10@20
+	l.Apply(buy(15, 10, 1), big.ZERO)  // cover at 15: gain 50
+	s := l.TaxSummary()
+	eqi(t, s.Proceeds, 150)        // close trade price: 15*10
+	eqi(t, s.CostBasisClosed, 200) // matched short lot basis: 20*10
+	eqi(t, s.NetRealized, 50)
+}
+
+func TestSplitOnWashAdjustedLot_cbconf(t *testing.T) {
+	// a Split scales the wash-adjusted basis (40 -> 20), not the pre-wash 30.
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 5), big.ZERO) // loss -100
+	l.Apply(buy(30, 10, 20), big.ZERO) // washed: lot -> 10@40
+	l.Split(big.NewFromInt(2))         // -> 20@20
+	eqi(t, l.CostBasis(), 400)         // adjusted basis survived: 20*20
+	l.Apply(sell(25, 20, 30), big.ZERO)
+	eqi(t, l.RealizedPnL(), 100) // 20*(25-20); -100 loss + 100 washed + 100
+	eqi(t, l.Position(), 0)
+}
+
+// ---- T4 gaps: realized event uses the wash-adjusted basis; CloseLot indexes the compacted current slice ----
+
+func TestWashSaleEventUsesAdjustedBasis_cbconf(t *testing.T) {
+	// closing a wash-raised lot must emit a RealizedEvent whose PnL and OpenPrice
+	// use the adjusted basis (40), not the pre-wash purchase price (30).
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 5), big.ZERO) // close, loss -100 (event 0)
+	l.Apply(buy(30, 10, 20), big.ZERO) // washed: lot -> 10@40
+	l.Apply(sell(45, 10, 30), big.ZERO) // close the adjusted lot (event 1)
+	ev := l.Events()
+	if len(ev) != 2 {
+		t.Fatalf("events = %d, want 2", len(ev))
+	}
+	eqi(t, ev[1].OpenPrice, 40) // adjusted basis, not 30
+	eqi(t, ev[1].PnL, 50)       // 10*(45-40), not 10*(45-30)=150
+}
+
+func TestCloseLotAfterFullRemoval_cbconf(t *testing.T) {
+	// after a FIFO close fully removes lot 0 and the slice compacts, CloseLot's
+	// index refers to the CURRENT open-lot order, not a historical identifier.
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 5, 0), big.ZERO)
+	l.Apply(buy(20, 5, 1), big.ZERO)
+	l.Apply(buy(30, 5, 2), big.ZERO)
+	l.Apply(sell(40, 5, 3), big.ZERO) // FIFO fully removes the 10 lot; now [20, 30]
+	if !l.CloseLot(sell(50, 5, 4), 1, big.ZERO) { // index 1 of the compacted slice = the 30 lot
+		t.Fatal("expected success")
+	}
+	eqi(t, l.RealizedPnL(), 250) // 5*(40-10) + 5*(50-30)
+	eqi(t, l.Position(), 5)
+	lots := l.OpenLots()
+	if len(lots) != 1 {
+		t.Fatalf("lots = %d, want 1", len(lots))
+	}
+	eqi(t, lots[0].Price, 20) // the 20 lot remains, proving the 30 lot (index 1) was closed
+}
+
+// ---- coverage: event OpenPrice on an ordinary close; statistics count per matched-lot event ----
+
+func TestEventOpenPriceOrdinary_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 3, 0), big.ZERO)
+	l.Apply(buy(20, 2, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO) // spans both lots, no wash
+	ev := l.Events()
+	if len(ev) != 2 {
+		t.Fatalf("events = %d, want 2", len(ev))
+	}
+	eqi(t, ev[0].OpenPrice, 10) // original lot basis
+	eqi(t, ev[1].OpenPrice, 20)
+	eqi(t, ev[0].PnL, 60)
+	eqi(t, ev[1].PnL, 20)
+}
+
+func TestStatisticsPerMatchedLot_cbconf(t *testing.T) {
+	// one close spanning two winning lots counts as two wins, not one.
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 3, 0), big.ZERO)
+	l.Apply(buy(20, 2, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO) // matches both lots: +60 and +20
+	if l.WinCount() != 2 {
+		t.Fatalf("wins = %d, want 2", l.WinCount())
+	}
+	if l.LossCount() != 0 {
+		t.Fatalf("losses = %d, want 0", l.LossCount())
+	}
+	eqi(t, l.GrossProfit(), 80) // 60 + 20
+	eqi(t, l.LargestWin(), 60)
+}
+
+// ---- coverage: CloseLot negative index; fractional quantities/prices through matching, averaging, wash ----
+
+func dec(v string) big.Decimal { return big.NewFromString(v) }
+func ordf(side techan.OrderSide, price, amount string, day int) techan.Order {
+	return techan.Order{Side: side, Price: dec(price), Amount: dec(amount), ExecutionTime: epoch.AddDate(0, 0, day)}
+}
+func buyf(price, amount string, day int) techan.Order  { return ordf(techan.BUY, price, amount, day) }
+func sellf(price, amount string, day int) techan.Order { return ordf(techan.SELL, price, amount, day) }
+func eqd(t *testing.T, got big.Decimal, want string) {
+	t.Helper()
+	if got.Cmp(dec(want)) != 0 {
+		t.Fatalf("got %s, want %s", got.String(), want)
+	}
+}
+
+func TestCloseLotNegativeIndex_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 5, 0), big.ZERO)
+	if l.CloseLot(sell(30, 1, 1), -1, big.NewFromInt(5)) { // negative index: rejected, no-op
+		t.Fatal("expected rejection")
+	}
+	eqi(t, l.RealizedPnL(), 0)
+	eqi(t, l.Commissions(), 0)
+	eqi(t, l.Position(), 5)
+	if len(l.OpenLots()) != 1 {
+		t.Fatalf("lots = %d, want 1", len(l.OpenLots()))
+	}
+}
+
+func TestFractionalMatchingAndAverage_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.Average, year)
+	l.Apply(buyf("10.5", "2", 0), big.ZERO)
+	l.Apply(buyf("20.5", "2", 1), big.ZERO) // Average merge: (2*10.5 + 2*20.5)/4 = 15.5
+	eqd(t, l.AverageCost(), "15.5")
+	eqi(t, l.CostBasis(), 62)
+	l.Apply(sellf("25.5", "1.5", 2), big.ZERO) // close 1.5 @ 15.5: 1.5*(25.5-15.5)=15
+	eqi(t, l.RealizedPnL(), 15)
+	eqd(t, l.Position(), "2.5")
+	eqd(t, l.CostBasis(), "38.75") // 2.5 * 15.5
+}
+
+func TestFractionalWashAllocation_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 5), big.ZERO)     // loss -100, per share -10
+	l.Apply(buyf("30", "2.5", 20), big.ZERO) // wash 2.5 shares: disallow 25, price 30 + 25/2.5 = 40
+	eqi(t, l.Disallowed(), 25)
+	eqi(t, l.RealizedPnL(), -75) // -100 + 25 washed back
+	lots := l.OpenLots()
+	if len(lots) != 1 {
+		t.Fatalf("lots = %d, want 1", len(lots))
+	}
+	eqd(t, lots[0].Amount, "2.5")
+	eqi(t, lots[0].Price, 40)
+}
+
+// ---- coverage: Split non-positive ratio, corporate actions on flat/short books, extraneous portfolio marks ----
+
+func TestSplitNonPositiveRatio_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(20, 4, 0), big.ZERO)
+	l.Split(big.ZERO) // ignored
+	eqi(t, l.Position(), 4)
+	eqi(t, l.CostBasis(), 80)
+	l.Split(big.NewFromInt(-2)) // ignored
+	eqi(t, l.Position(), 4)
+	eqi(t, l.CostBasis(), 80)
+}
+
+func TestCorporateActionsEmptyAndShort_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Split(big.NewFromInt(2))            // flat: no-op
+	l.ReturnOfCapital(big.NewFromInt(5))  // flat: no-op
+	eqi(t, l.Position(), 0)
+	eqi(t, l.CostBasis(), 0)
+	l.Apply(sell(20, 4, 0), big.ZERO)     // open short 4@20
+	l.ReturnOfCapital(big.NewFromInt(5))  // lowers each lot's price: 20 -> 15
+	eqi(t, l.Position(), -4)
+	eqi(t, l.CostBasis(), 60) // 4 * 15
+}
+
+func TestExtraneousPortfolioMarks_cbconf(t *testing.T) {
+	p := cb.NewPortfolio(cb.FIFO, year)
+	p.Apply(techan.Order{Side: techan.BUY, Security: "AAA", Price: big.NewFromInt(10), Amount: big.NewFromInt(4), ExecutionTime: epoch}, big.ZERO)
+	marks := map[string]big.Decimal{"AAA": big.NewFromInt(12), "ZZZ": big.NewFromInt(99)} // ZZZ never traded
+	eqi(t, p.GrossExposure(marks), 48) // 4*12; ZZZ ignored
+	eqi(t, p.UnrealizedPnL(marks), 8)  // 4*(12-10)
+	eqi(t, p.NetExposure(marks), 48)
+}
+
+// ---- T4: NewPortfolio must propagate its Method to per-security ledgers (non-FIFO discriminator) ----
+
+func TestPortfolioMethodPropagation_cbconf(t *testing.T) {
+	p := cb.NewPortfolio(cb.LIFO, year)
+	p.Apply(techan.Order{Side: techan.BUY, Security: "AAA", Price: big.NewFromInt(10), Amount: big.NewFromInt(5), ExecutionTime: epoch}, big.ZERO)
+	p.Apply(techan.Order{Side: techan.BUY, Security: "AAA", Price: big.NewFromInt(20), Amount: big.NewFromInt(5), ExecutionTime: epoch.AddDate(0, 0, 1)}, big.ZERO)
+	p.Apply(techan.Order{Side: techan.SELL, Security: "AAA", Price: big.NewFromInt(30), Amount: big.NewFromInt(5), ExecutionTime: epoch.AddDate(0, 0, 2)}, big.ZERO)
+	eqi(t, p.RealizedPnL(), 50) // LIFO closes the 20 lot: 5*(30-20); FIFO would be 100
+	eqi(t, p.Positions()["AAA"], 5)
+}
+
+// ---- T3/T4: portfolio realized nets commissions; LargestLoss is the single worst event, not GrossLoss ----
+
+func TestPortfolioRealizedNetsCommissions_cbconf(t *testing.T) {
+	p := cb.NewPortfolio(cb.FIFO, year)
+	p.Apply(techan.Order{Side: techan.BUY, Security: "AAA", Price: big.NewFromInt(10), Amount: big.NewFromInt(10), ExecutionTime: epoch}, big.ZERO)
+	p.Apply(techan.Order{Side: techan.SELL, Security: "AAA", Price: big.NewFromInt(15), Amount: big.NewFromInt(10), ExecutionTime: epoch.AddDate(0, 0, 1)}, big.NewFromInt(4))
+	eqi(t, p.RealizedPnL(), 46)                                     // 50 gross - 4 commission, not 50
+	eqi(t, p.NetLiquidationValue(map[string]big.Decimal{}), 46)     // flat: realized only, net of commission
+}
+
+func TestLargestLossVsGrossLoss_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(20, 5, 0), big.ZERO)
+	l.Apply(buy(20, 5, 1), big.ZERO)
+	l.Apply(sell(10, 5, 2), big.ZERO) // loss -50
+	l.Apply(sell(15, 5, 3), big.ZERO) // loss -25
+	if l.LossCount() != 2 {
+		t.Fatalf("losses = %d, want 2", l.LossCount())
+	}
+	eqi(t, l.GrossLoss(), -75)   // sum of both losses
+	eqi(t, l.LargestLoss(), -50) // most negative single event, not the sum
+}
+
+// ---- coverage: CloseLot emits a RealizedEvent; ordinary buys record the order's ExecutionTime ----
+
+func TestCloseLotEmitsEvent_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 5, 0), big.ZERO)
+	if !l.CloseLot(sell(30, 3, 1), 0, big.ZERO) { // partial close
+		t.Fatal("expected success")
+	}
+	ev := l.Events()
+	if len(ev) != 1 {
+		t.Fatalf("events = %d, want 1", len(ev))
+	}
+	eqi(t, ev[0].OpenPrice, 10) // same event semantics as an Apply-driven close
+	eqi(t, ev[0].PnL, 60)       // 3*(30-10)
+}
+
+func TestOrdinaryAcquisitionTimestamp_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 3, 5), big.ZERO)
+	lots := l.OpenLots()
+	if len(lots) != 1 {
+		t.Fatalf("lots = %d, want 1", len(lots))
+	}
+	want := epoch.AddDate(0, 0, 5)
+	if !lots[0].Acquired.Equal(want) {
+		t.Fatalf("acquired = %v, want %v", lots[0].Acquired, want)
+	}
+}
+
+// ---- coverage: wash-disallowed loss still counts in statistics; empty-portfolio zero/empty state ----
+
+func TestWashSaleStatistics_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 5), big.ZERO) // loss -100 (a matched-lot event)
+	l.Apply(buy(30, 10, 20), big.ZERO) // washes it
+	eqi(t, l.RealizedPnL(), 0)         // removed from realized results
+	eqi(t, l.Disallowed(), 100)
+	if l.WinCount() != 0 || l.LossCount() != 1 {
+		t.Fatalf("win %d loss %d, want 0/1", l.WinCount(), l.LossCount())
+	}
+	eqi(t, l.GrossLoss(), -100) // the event still counts in the statistics
+}
+
+func TestPortfolioEmptyState_cbconf(t *testing.T) {
+	p := cb.NewPortfolio(cb.FIFO, year)
+	if len(p.Securities()) != 0 {
+		t.Fatalf("securities = %d, want 0", len(p.Securities()))
+	}
+	if len(p.Positions()) != 0 {
+		t.Fatalf("positions = %d, want 0", len(p.Positions()))
+	}
+	m := map[string]big.Decimal{}
+	eqi(t, p.RealizedPnL(), 0)
+	eqi(t, p.UnrealizedPnL(m), 0)
+	eqi(t, p.GrossExposure(m), 0)
+	eqi(t, p.NetExposure(m), 0)
+	s := p.TaxSummary()
+	eqi(t, s.Proceeds, 0)
+	eqi(t, s.CostBasisClosed, 0)
+	eqi(t, s.NetRealized, 0)
+}
+
+// ---- T3/T4: a wash-disallowed long-term loss reverses from LongTermRealized, not ShortTermRealized ----
+
+func TestWashSaleReversesLongTermLoss_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 400), big.ZERO) // held 400 days: a long-term loss of -100
+	eqi(t, l.LongTermRealized(), -100)
+	l.Apply(buy(30, 10, 410), big.ZERO) // washes it within the window
+	eqi(t, l.Disallowed(), 100)
+	eqi(t, l.RealizedPnL(), 0)
+	eqi(t, l.LongTermRealized(), 0)  // reversed from the long-term bucket
+	eqi(t, l.ShortTermRealized(), 0) // NOT reversed from short-term
+}
