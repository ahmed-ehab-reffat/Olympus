+// ---- wash sale (division; exact inputs) ----
+
+func TestWashSaleDisallows_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 10), big.ZERO)  // loss -100
+	l.Apply(buy(30, 10, 20), big.ZERO)   // replacement within 30 days: loss disallowed
+	eqi(t, l.RealizedPnL(), 0)           // the -100 loss is removed
+	eqi(t, l.Disallowed(), 100)          // and recorded as disallowed
+	l.Apply(sell(45, 10, 30), big.ZERO)  // basis was raised to 30 + 100/10 = 40; 10*(45-40)=50
+	eqi(t, l.RealizedPnL(), 50)
+}
+func TestWashSalePartial_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 10), big.ZERO) // loss -100 (per share -10)
+	l.Apply(buy(30, 4, 20), big.ZERO)   // replacement of only 4 shares: disallow 4*(-10) = -40
+	eqi(t, l.Disallowed(), 40)
+	eqi(t, l.RealizedPnL(), -60) // -100 loss, 40 disallowed
+	lots := l.OpenLots()
+	if len(lots) != 1 {
+		t.Fatalf("lots = %d, want 1", len(lots))
+	}
+	eqi(t, lots[0].Amount, 4)
+	eqi(t, lots[0].Price, 40) // 30 + 40/4
+}
+func TestWashSaleMostRecentLoss_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 5, 0), big.ZERO)
+	l.Apply(buy(30, 5, 5), big.ZERO)
+	l.Apply(sell(10, 5, 10), big.ZERO) // FIFO closes the 20 lot: loss -50
+	l.Apply(sell(10, 5, 11), big.ZERO) // closes the 30 lot: loss -100
+	l.Apply(buy(40, 5, 15), big.ZERO)  // washes the most recent loss (-100), not the -50
+	eqi(t, l.Disallowed(), 100)
+	eqi(t, l.RealizedPnL(), -50) // the -50 loss remains
+}
+
+func TestWashSaleMultipleLosses_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 5, 0), big.ZERO)
+	l.Apply(buy(30, 5, 5), big.ZERO)
+	l.Apply(sell(10, 5, 10), big.ZERO) // closes the 20 lot: loss -50
+	l.Apply(sell(10, 5, 11), big.ZERO) // closes the 30 lot: loss -100
+	l.Apply(buy(40, 10, 15), big.ZERO) // replacement covers both losses (150 disallowed)
+	eqi(t, l.Disallowed(), 150)
+	eqi(t, l.RealizedPnL(), 0)
+	lots := l.OpenLots()
+	if len(lots) != 1 {
+		t.Fatalf("lots = %d, want 1", len(lots))
+	}
+	eqi(t, lots[0].Amount, 10)
+	eqi(t, lots[0].Price, 55) // 40 + 150/10
+}
