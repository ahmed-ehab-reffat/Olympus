+func TestWashSaleAverageMerge_cbconf(t *testing.T) {
+	// under Average, a small replacement buy that merges into an existing long
+	// must wash only up to the PURCHASED quantity, not the merged lot size.
+	l := cb.NewWashSaleLedger(cb.Average, year, 30*24*time.Hour)
+	l.Apply(buy(10, 4, 0), big.ZERO)
+	l.Apply(sell(5, 3, 10), big.ZERO) // loss -15 (per share -5); avg lot -> 1@10
+	l.Apply(buy(20, 1, 20), big.ZERO) // merges to 2@15; wash caps at purchased=1 share
+	eqi(t, l.Disallowed(), 5)         // only 1 share washed (5), not 2 (10)
+	eqi(t, l.RealizedPnL(), -10)      // -15 loss, 5 disallowed
+	eqi(t, l.Position(), 2)
+	eqi(t, l.CostBasis(), 35) // 2 shares at 17.5 (15 + 5/2)
+}
