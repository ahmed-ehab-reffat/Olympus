+func TestWashSaleTaxSummary_cbconf(t *testing.T) {
+	l := cb.NewWashSaleLedger(cb.FIFO, year, 30*24*time.Hour)
+	l.Apply(buy(20, 10, 0), big.ZERO)
+	l.Apply(sell(10, 10, 10), big.ZERO) // loss disallowed by the next buy
+	l.Apply(buy(30, 10, 20), big.ZERO)  // wash: basis -> 40
+	l.Apply(sell(45, 10, 30), big.ZERO) // realized 50
