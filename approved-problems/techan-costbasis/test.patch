+//go:build cbconf
+
+package costbasis_test
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sdcoffey/big"
+	"github.com/sdcoffey/techan"
+	cb "github.com/sdcoffey/techan/costbasis"
+)
+
+var epoch = time.Date(2021, 1, 1, 0, 0, 0, 0, time.UTC)
+
+const year = 365 * 24 * time.Hour
+
+func ord(side techan.OrderSide, price, amount, day int) techan.Order {
+	return techan.Order{
+		Side:          side,
+		Price:         big.NewFromInt(price),
+		Amount:        big.NewFromInt(amount),
+		ExecutionTime: epoch.AddDate(0, 0, day),
+	}
+}
+
+func buy(price, amount, day int) techan.Order  { return ord(techan.BUY, price, amount, day) }
+func sell(price, amount, day int) techan.Order { return ord(techan.SELL, price, amount, day) }
+
+func eqi(t *testing.T, got big.Decimal, want int) {
+	t.Helper()
+	if got.Cmp(big.NewFromInt(want)) != 0 {
+		t.Fatalf("got %s, want %d", got.String(), want)
+	}
+}
+
+// ---- FIFO / LIFO / HIFO / LOFO matching order ----
+
+func TestFIFOOrder_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 10, 0), big.ZERO)
+	l.Apply(buy(20, 10, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO)
+	eqi(t, l.RealizedPnL(), 100) // matches the 10-cost lot: 5*(30-10)
+}
+func TestLIFOOrder_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.LIFO, year)
+	l.Apply(buy(10, 10, 0), big.ZERO)
+	l.Apply(buy(20, 10, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO)
+	eqi(t, l.RealizedPnL(), 50) // matches the 20-cost lot: 5*(30-20)
+}
+func TestHIFOOrder_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.HIFO, year)
+	l.Apply(buy(10, 10, 0), big.ZERO)
+	l.Apply(buy(20, 10, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO)
+	eqi(t, l.RealizedPnL(), 50) // highest cost (20) first
+}
+func TestLOFOOrder_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.LOFO, year)
+	l.Apply(buy(10, 10, 0), big.ZERO)
+	l.Apply(buy(20, 10, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO)
+	eqi(t, l.RealizedPnL(), 100) // lowest cost (10) first
+}
+
+func TestMethodDiscrimination_cbconf(t *testing.T) {
+	// lots acquired out of price order (20, 30, 10) so every method picks a
+	// different lot: FIFO=oldest(20), LIFO=newest(10), HIFO=highest(30), LOFO=lowest(10).
+	run := func(m cb.Method) big.Decimal {
+		l := cb.NewLedger(m, year)
+		l.Apply(buy(20, 5, 0), big.ZERO)
+		l.Apply(buy(30, 5, 1), big.ZERO)
+		l.Apply(buy(10, 5, 2), big.ZERO)
+		l.Apply(sell(40, 5, 3), big.ZERO)
+		return l.RealizedPnL()
+	}
+	eqi(t, run(cb.FIFO), 100) // close @20
+	eqi(t, run(cb.LIFO), 150) // close @10 (newest)
+	eqi(t, run(cb.HIFO), 50)  // close @30
+	eqi(t, run(cb.LOFO), 150) // close @10 (lowest)
+}
+
+// ---- partial fills spanning lots ----
+
+func TestPartialSpansLots_cbconf(t *testing.T) {
+	l := cb.NewLedger(cb.FIFO, year)
+	l.Apply(buy(10, 3, 0), big.ZERO)
+	l.Apply(buy(20, 3, 1), big.ZERO)
+	l.Apply(sell(30, 5, 2), big.ZERO) // 3*(30-10) + 2*(30-20) = 60 + 20
+	eqi(t, l.RealizedPnL(), 80)
+	eqi(t, l.Position(), 1)
+}
