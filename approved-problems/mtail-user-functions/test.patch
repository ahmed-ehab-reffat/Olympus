--- /dev/null
+++ b/test.sh
@@ -0,0 +1,42 @@
+#!/bin/bash
+set -o pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -n "$OUTPUT_PATH" ]; then mkdir -p "$(dirname "$OUTPUT_PATH")"; fi
+
+export GOFLAGS="-buildvcs=false"
+export CGO_ENABLED=0
+export PATH="$PATH:$(go env GOPATH)/bin:/root/go/bin"
+
+run() {
+  if [ -n "$OUTPUT_PATH" ]; then
+    go test -v -count=1 "$@" 2>&1 | tee /tmp/gotest.out | go-junit-report > "$OUTPUT_PATH"
+    return ${PIPESTATUS[0]}
+  fi
+  go test -v -count=1 "$@"
+}
+
+# These two are excluded from the baseline because they are timing races in mtail's log transport,
+# not in the compiler or the virtual machine.  TestFileSocketStreamComparison runs two mtail
+# instances concurrently and pumps a log file through a unixgram socket, so datagrams are dropped
+# under load and the comparison fails nondeterministically.  TestFifoStreamReadCompletedBecauseCancel
+# wraps a fifo write, a context cancel and a goroutine join in a one second TimeoutTest, which a busy
+# machine misses.
+FLAKY='TestFileSocketStreamComparison|TestFifoStreamReadCompletedBecauseCancel'
+
+if [ "$MODE" = "new" ]; then
+  run -run 'E6382b' ./internal/runtime/vm/
+else
+  run -skip "E6382b|$FLAKY" ./...
+fi
+exit $?
