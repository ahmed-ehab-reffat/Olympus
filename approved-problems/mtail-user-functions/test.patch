+func datumE6382b(tb testing.TB, v *vm.VM, name string, labels ...string) datum.Datum {
+	tb.Helper()
+	d, err := metricE6382b(tb, v, name).GetDatum(labels...)
+	if err != nil {
+		tb.Fatalf("GetDatum(%q, %v): %s", name, labels, err)
+	}
+	return d
+}
