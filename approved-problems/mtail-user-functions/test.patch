+func metricE6382b(tb testing.TB, v *vm.VM, name string) *metrics.Metric {
+	tb.Helper()
+	for _, m := range v.Metrics {
+		if m.Name == name {
+			return m
+		}
+	}
+	tb.Fatalf("no metric named %q in %v", name, v.Metrics)
+	return nil
+}
