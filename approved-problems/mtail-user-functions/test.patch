+func compileE6382b(tb testing.TB, prog string) (*vm.VM, error) {
+	tb.Helper()
+	c, err := compiler.New()
+	if err != nil {
+		tb.Fatalf("compiler.New: %s", err)
+	}
+	obj, err := c.Compile("userfunc", strings.NewReader(prog))
+	if err != nil {
+		return nil, err
+	}
+	return vm.New("userfunc", obj, false, time.UTC, true, false), nil
+}
+
+func mustCompileE6382b(tb testing.TB, prog string) *vm.VM {
+	tb.Helper()
+	v, err := compileE6382b(tb, prog)
+	if err != nil {
+		tb.Fatalf("compile failed: %s\nprogram:\n%s", err, prog)
+	}
+	return v
+}
+
+func runE6382b(tb testing.TB, prog string, lines ...string) *vm.VM {
+	tb.Helper()
+	v := mustCompileE6382b(tb, prog)
+	for _, line := range lines {
+		v.ProcessLogLine(context.Background(), logline.New(context.Background(), "userfunc.log", line))
+	}
+	return v
+}
+
+func wantRejectedE6382b(tb testing.TB, accepted, rejected string) {
+	tb.Helper()
+	if _, err := compileE6382b(tb, accepted); err != nil {
+		tb.Fatalf("control program should compile but did not: %s\nprogram:\n%s", err, accepted)
+	}
+	if _, err := compileE6382b(tb, rejected); err == nil {
+		tb.Errorf("program should be rejected but compiled:\n%s", rejected)
+	}
+}
+
+func unparseE6382b(tb testing.TB, prog string) string {
+	tb.Helper()
+	n, err := parser.Parse("userfunc", strings.NewReader(prog))
+	if err != nil {
+		tb.Fatalf("parse failed: %s\nprogram:\n%s", err, prog)
+	}
+	u := parser.Unparser{}
+	return u.Unparse(n)
+}
+
+func sexpE6382b(tb testing.TB, prog string) string {
+	tb.Helper()
+	n, err := parser.Parse("userfunc", strings.NewReader(prog))
+	if err != nil {
+		tb.Fatalf("parse failed: %s\nprogram:\n%s", err, prog)
+	}
+	s := parser.Sexp{}
+	return s.Dump(n)
+}
