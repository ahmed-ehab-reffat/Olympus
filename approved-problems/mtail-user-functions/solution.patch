+
+func (n *FuncDecl) Type() types.Type {
+	if n.Symbol != nil {
+		return n.Symbol.Type
+	}
+	return types.Undef
+}
+
+// CallExpr is an invocation of a user defined function.
+type CallExpr struct {
+	P      position.Position
+	Name   string
+	Args   Node           // An ExprList of the argument expressions.
+	Symbol *symbol.Symbol // The symbol of the function being called.
+
+	mu  sync.RWMutex
+	typ types.Type
+}
+
+func (n *CallExpr) Pos() *position.Position {
+	return position.Merge(&n.P, n.Args.Pos())
+}
+
+func (n *CallExpr) Type() types.Type {
+	n.mu.RLock()
+	defer n.mu.RUnlock()
+	if n.typ == nil {
+		return types.Undef
+	}
+	return n.typ
+}
+
+func (n *CallExpr) SetType(t types.Type) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.typ = t
+}
+
+// LocalDecl declares storage local to a call of the enclosing function.
+type LocalDecl struct {
+	P      position.Position
+	Name   string
+	Symbol *symbol.Symbol
+}
+
+func (n *LocalDecl) Pos() *position.Position {
+	return &n.P
+}
+
+func (n *LocalDecl) Type() types.Type {
+	if n.Symbol != nil {
+		return n.Symbol.Type
+	}
+	return types.Undef
+}
+
