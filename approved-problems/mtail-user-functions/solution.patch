+// FuncDecl is a user defined function declaration.
+type FuncDecl struct {
+	P      position.Position
+	Name   string
+	Params []string
+	Body   Node
+	Symbol *symbol.Symbol // The symbol naming this function, holding its Function type.
+	Scope  *symbol.Scope  // The scope holding the parameters of this function.
+	Frame  int            // The number of frame slots the body needs.
+	Addr   int            // The address of the first instruction of the body.
