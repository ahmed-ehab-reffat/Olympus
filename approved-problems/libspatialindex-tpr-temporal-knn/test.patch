+    EXPECT_EQ(ids({1}), sorted(visitor.ids));
+    EXPECT_THROW(scene.tree->pointLocationQuery(timePoint(1.0, 1.0, 0.0, 10.0), visitor), Tools::IllegalArgumentException);
+
+    scene.tree->insertData(0, nullptr, SpatialIndex::TimePoint(at, 3.0, 3.0, 2), 7);
+    EXPECT_THROW(scene.tree->pointLocationQuery(timePoint(1.0, 1.0, 2.0, 5.0), visitor), Tools::IllegalArgumentException);
