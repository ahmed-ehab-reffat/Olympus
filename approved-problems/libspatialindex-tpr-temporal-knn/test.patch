+    std::vector<std::pair<double, id_type> > all;
+    for (std::map<id_type, Mover>::const_iterator it = scene.movers.begin(); it != scene.movers.end(); ++it) {
+        all.push_back(std::make_pair(oracleDistance(q, it->second, 3.5, 9.0), it->first));
