@@ -0,0 +1,153 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+mode=""
+output_path=""
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path=*) output_path="${1#--output_path=}"; shift ;;
+        --output_path) output_path="$2"; shift 2 ;;
+        base|new) mode="$1"; shift ;;
+        *) shift ;;
+    esac
+done
+mode="${mode:-base}"
+output_path="${output_path:-$PWD/test-results-$mode.xml}"
+case "$output_path" in
+    /*) ;;
+    *) output_path="$PWD/$output_path" ;;
+esac
+mkdir -p "$(dirname "$output_path")"
+
+repo_root="$(cd "$(dirname "$0")" && pwd)"
+build_dir="$repo_root/build"
+log_file="$(mktemp)"
+
+if [ "$mode" = "base" ]; then
+    target="libsidxtest"
+    fallback_case="LibsidxtestBuild"
+else
+    target="tprtree_temporal_test"
+    fallback_case="TemporalQueriesBuild"
+fi
+
+write_failure() {
+    python3 - "$output_path" "$fallback_case" "$1" "$log_file" <<'PY'
+import sys
+from xml.sax.saxutils import escape
+out, name, phase, log = sys.argv[1:5]
+try:
+    text = open(log, errors="replace").read()[-16000:]
+except OSError:
+    text = ""
+with open(out, "w") as f:
+    f.write('<?xml version="1.0" encoding="UTF-8"?>\n')
+    f.write('<testsuites tests="1" failures="1" errors="0">\n')
+    f.write('<testsuite name="build" tests="1" failures="1" errors="0">\n')
+    f.write('<testcase name="%s" classname="build">' % escape(name))
+    f.write('<failure message="%s failed">%s</failure>' % (escape(phase), escape(text)))
+    f.write('</testcase>\n</testsuite>\n</testsuites>\n')
+PY
+}
+
+if [ -d "$build_dir" ] && [ "$(stat -c %u "$build_dir")" != "$(id -u)" ]; then
+    rm -rf "$build_dir.owned"
+    if cp -R --preserve=mode,timestamps "$build_dir" "$build_dir.owned" 2>>"$log_file" \
+        && rm -rf "$build_dir" 2>>"$log_file" \
+        && mv "$build_dir.owned" "$build_dir" 2>>"$log_file"; then
+        :
+    else
+        rm -rf "$build_dir.owned"
+        build_dir="$repo_root/build-$(id -u)"
+    fi
+fi
+
+if [ ! -f "$build_dir/CMakeCache.txt" ]; then
+    cmake -S "$repo_root" -B "$build_dir" -G Ninja \
+        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON >>"$log_file" 2>&1
+    status=$?
+    if [ $status -ne 0 ]; then
+        cat "$log_file"
+        write_failure "configure"
+        exit 1
+    fi
+fi
+
+cmake --build "$build_dir" --target "$target" --parallel 4 >>"$log_file" 2>&1
+status=$?
+if [ $status -ne 0 ]; then
+    cat "$log_file"
+    write_failure "build of $target"
+    exit 1
+fi
+
+python3 - "$build_dir/bin/$target" "$output_path" <<'PY'
+import os
+import subprocess
+import sys
+import tempfile
+import xml.etree.ElementTree as ET
+
+binary, out = sys.argv[1], sys.argv[2]
+listing = subprocess.run([binary, "--gtest_list_tests"], capture_output=True, text=True, cwd=os.path.dirname(binary))
+tests = []
+suite = None
+for line in listing.stdout.splitlines():
+    if not line.strip() or line.startswith("Running main"):
+        continue
+    if not line.startswith(" "):
+        suite = line.strip().rstrip(".")
+    else:
+        tests.append((suite, line.strip().split()[0]))
+
+root = ET.Element("testsuites")
+suites = {}
+failed = 0
+workdir = tempfile.mkdtemp()
+for index, (suite_name, test_name) in enumerate(tests):
+    xml_path = os.path.join(workdir, "case%d.xml" % index)
+    try:
+        proc = subprocess.run(
+            [binary, "--gtest_filter=%s.%s" % (suite_name, test_name), "--gtest_output=xml:" + xml_path],
+            capture_output=True, text=True, cwd=os.path.dirname(binary), timeout=300)
+    except subprocess.TimeoutExpired as expired:
+        proc = subprocess.CompletedProcess(expired.cmd, 124, str(expired.stdout or ""), "timed out after 300 s")
+    sys.stdout.write(proc.stdout)
+    sys.stderr.write(proc.stderr)
+    if suite_name not in suites:
+        suites[suite_name] = ET.SubElement(root, "testsuite", name=suite_name)
+    case = None
+    if os.path.exists(xml_path):
+        for element in ET.parse(xml_path).getroot().iter("testcase"):
+            if element.get("name") == test_name:
+                case = element
+    if case is None:
+        case = ET.Element("testcase", name=test_name, classname=suite_name)
+        failure = ET.SubElement(case, "failure", message="test process exited with status %d" % proc.returncode)
+        failure.text = (proc.stdout + proc.stderr)[-8000:]
+    elif proc.returncode != 0 and case.find("failure") is None:
+        failure = ET.SubElement(case, "failure", message="test process exited with status %d" % proc.returncode)
+        failure.text = (proc.stdout + proc.stderr)[-8000:]
+    if case.find("failure") is not None or case.find("error") is not None:
+        failed += 1
+    suites[suite_name].append(case)
+
+if not tests:
+    suite_element = ET.SubElement(root, "testsuite", name="listing")
+    case = ET.SubElement(suite_element, "testcase", name="ListTests", classname="listing")
+    failure = ET.SubElement(case, "failure", message="no tests could be listed")
+    failure.text = (listing.stdout + listing.stderr)[-8000:]
+    failed = 1
+    tests = [("listing", "ListTests")]
+
+for suite_element in root:
+    suite_element.set("tests", str(len(suite_element)))
+root.set("tests", str(len(tests)))
+root.set("failures", str(failed))
+ET.ElementTree(root).write(out, encoding="UTF-8", xml_declaration=True)
+print("%d tests, %d failed" % (len(tests), failed))
+sys.exit(1 if failed else 0)
+PY
+status=$?
+rm -f "$log_file"
+exit $status
