+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <limits>
+#include <map>
+#include <memory>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include <spatialindex/SpatialIndex.h>
+#include <spatialindex/capi/sidx_api.h>
+
+#include "NativeTestSupport.h"
+
+namespace {
+
+using SpatialIndex::id_type;
+
+struct Mover {
+    double lo[2];
+    double hi[2];
+    double vlo[2];
+    double vhi[2];
+    double ref;
+    double stop;
+};
+
+const double kNoStop = std::numeric_limits<double>::max();
+
+Mover pointMover(double ref, double x, double y, double vx, double vy) {
+    Mover m = {{x, y}, {x, y}, {vx, vy}, {vx, vy}, ref, kNoStop};
+    return m;
+}
+
+Mover boxMover(double ref, double x0, double y0, double x1, double y1, double vx, double vy) {
+    Mover m = {{x0, y0}, {x1, y1}, {vx, vy}, {vx, vy}, ref, kNoStop};
+    return m;
+}
+
+Mover stretchMover(double ref, double x0, double y0, double x1, double y1,
+                   double vlx, double vly, double vhx, double vhy) {
+    Mover m = {{x0, y0}, {x1, y1}, {vlx, vly}, {vhx, vhy}, ref, kNoStop};
+    return m;
+}
+
+Mover stopping(Mover m, double stop) {
+    m.stop = stop;
+    return m;
+}
+
+double moverLow(const Mover& m, int d, double t) { return m.lo[d] + m.vlo[d] * (std::min(t, m.stop) - m.ref); }
+double moverHigh(const Mover& m, int d, double t) { return m.hi[d] + m.vhi[d] * (std::min(t, m.stop) - m.ref); }
+double moverVLow(const Mover& m, int d, double t) { return (t < m.stop) ? m.vlo[d] : 0.0; }
+double moverVHigh(const Mover& m, int d, double t) { return (t < m.stop) ? m.vhi[d] : 0.0; }
+
+std::vector<double> motionPieces(const std::vector<Mover>& boxes, double t0, double t1) {
+    std::vector<double> pieces;
+    pieces.push_back(t0);
+    for (size_t i = 0; i < boxes.size(); ++i) {
+        if (boxes[i].stop > t0 && boxes[i].stop < t1) pieces.push_back(boxes[i].stop);
+    }
+    pieces.push_back(t1);
+    std::sort(pieces.begin(), pieces.end());
+    pieces.erase(std::unique(pieces.begin(), pieces.end()), pieces.end());
+    if (pieces.size() < 2) pieces.push_back(t1);
+    return pieces;
+}
+
+double distanceAt(const Mover& a, const Mover& b, double t) {
+    double sum = 0.0;
+    for (int d = 0; d < 2; ++d) {
+        double gap = std::max(0.0, std::max(moverLow(b, d, t) - moverHigh(a, d, t), moverLow(a, d, t) - moverHigh(b, d, t)));
+        sum += gap * gap;
+    }
+    return std::sqrt(sum);
+}
+
+double oracleDistance(const Mover& query, const Mover& entry, double t0, double t1) {
+    std::vector<Mover> boxes;
+    boxes.push_back(query);
+    boxes.push_back(entry);
+    std::vector<double> pieces = motionPieces(boxes, t0, t1);
+
+    double best = std::numeric_limits<double>::max();
+    for (size_t p = 1; p < pieces.size(); ++p) {
+        double lo = pieces[p - 1];
+        double hi = pieces[p];
+        best = std::min(best, std::min(distanceAt(query, entry, lo), distanceAt(query, entry, hi)));
+        for (int i = 0; i < 300; ++i) {
+            double m1 = lo + (hi - lo) / 3.0;
+            double m2 = hi - (hi - lo) / 3.0;
+            if (distanceAt(query, entry, m1) <= distanceAt(query, entry, m2)) hi = m2;
+            else lo = m1;
+        }
+        best = std::min(best, distanceAt(query, entry, (lo + hi) / 2.0));
+    }
+    return best;
+}
+
+class Scene {
+public:
+    explicit Scene(uint32_t capacity = 20, double horizon = 20.0)
+        : storage(sidx_test::memoryStorage()) {
+        tree.reset(SpatialIndex::TPRTree::createNewTPRTree(
+            *storage, 0.7, capacity, capacity, 2, SpatialIndex::TPRTree::TPRV_RSTAR, horizon, identifier));
+    }
+
+    void reopen() {
+        tree.reset();
+        tree.reset(SpatialIndex::TPRTree::loadTPRTree(*storage, identifier));
+    }
+
+    id_type identifier;
+
+    void insert(id_type id, const Mover& m) {
+        SpatialIndex::MovingRegion r(m.lo, m.hi, m.vlo, m.vhi, m.ref, m.stop, 2);
+        tree->insertData(0, nullptr, r, id);
+        movers[id] = m;
+    }
+
+    std::unique_ptr<SpatialIndex::IStorageManager> storage;
+    std::unique_ptr<SpatialIndex::ISpatialIndex> tree;
+    std::map<id_type, Mover> movers;
+};
+
+SpatialIndex::MovingRegion movingBox(const Mover& m, double t0, double t1) {
+    return SpatialIndex::MovingRegion(m.lo, m.hi, m.vlo, m.vhi, t0, t1, 2);
+}
+
+SpatialIndex::MovingPoint movingPoint(double x, double y, double vx, double vy, double t0, double t1) {
+    double p[2] = {x, y};
+    double v[2] = {vx, vy};
+    return SpatialIndex::MovingPoint(p, v, t0, t1, 2);
+}
+
+SpatialIndex::TimePoint timePoint(double x, double y, double t0, double t1) {
+    double p[2] = {x, y};
+    return SpatialIndex::TimePoint(p, t0, t1, 2);
+}
+
+SpatialIndex::TimeRegion timeBox(double x0, double y0, double x1, double y1, double t0, double t1) {
+    double lo[2] = {x0, y0};
+    double hi[2] = {x1, y1};
+    return SpatialIndex::TimeRegion(lo, hi, t0, t1, 2);
+}
+
+std::vector<id_type> sorted(std::vector<id_type> ids) {
+    std::sort(ids.begin(), ids.end());
+    return ids;
+}
+
+std::vector<id_type> ids(std::initializer_list<id_type> list) {
+    return sorted(std::vector<id_type>(list));
+}
+
+std::set<std::pair<id_type, id_type> > normalisedPairs(const sidx_test::IdVisitor& visitor) {
+    std::set<std::pair<id_type, id_type> > out;
+    for (size_t i = 0; i < visitor.pairs.size(); ++i) {
+        id_type a = visitor.pairs[i].first;
+        id_type b = visitor.pairs[i].second;
+        out.insert(std::make_pair(std::min(a, b), std::max(a, b)));
+    }
+    return out;
+}
+
+std::vector<id_type> oracleNearest(const Scene& scene, const Mover& query, double t0, double t1, uint32_t k, double* kth) {
+    std::vector<std::pair<double, id_type> > all;
+    for (std::map<id_type, Mover>::const_iterator it = scene.movers.begin(); it != scene.movers.end(); ++it) {
+        all.push_back(std::make_pair(oracleDistance(query, it->second, t0, t1), it->first));
+    }
+    std::sort(all.begin(), all.end());
+    std::vector<id_type> out;
+    for (size_t i = 0; i < all.size() && i < k; ++i) out.push_back(all[i].second);
+    *kth = all[std::min<size_t>(k, all.size()) - 1].first;
+    EXPECT_GT(all[k].first - all[k - 1].first, 1e-6);
+    return sorted(out);
+}
+
+struct Window {
+    double lo;
+    double hi;
+    double flatMargin;
+};
+
+void requireNonPositive(double valueAtStart, double rate, double t0, Window& w) {
+    if (rate == 0.0) {
+        w.flatMargin = std::min(w.flatMargin, std::fabs(valueAtStart));
+        if (valueAtStart > 0.0) w.hi = -std::numeric_limits<double>::max();
+        return;
+    }
+    double root = t0 - valueAtStart / rate;
+    if (rate > 0.0) w.hi = std::min(w.hi, root);
+    else w.lo = std::max(w.lo, root);
+}
+
+bool overlapAtInstant(const std::vector<Mover>& boxes, double t, double* margin) {
+    bool ok = true;
+    *margin = std::numeric_limits<double>::max();
+    for (size_t i = 0; i < boxes.size(); ++i) {
+        for (size_t j = 0; j < boxes.size(); ++j) {
+            if (i == j) continue;
+            for (int d = 0; d < 2; ++d) {
+                double value = moverLow(boxes[i], d, t) - moverHigh(boxes[j], d, t);
+                *margin = std::min(*margin, std::fabs(value));
+                if (value > 0.0) ok = false;
+            }
+        }
+    }
+    return ok;
+}
+
+bool sameInstantOverlap(const std::vector<Mover>& boxes, double t0, double t1, double* margin) {
+    if (t0 == t1) return overlapAtInstant(boxes, t0, margin);
+
+    std::vector<double> pieces = motionPieces(boxes, t0, t1);
+    bool found = false;
+    *margin = std::numeric_limits<double>::max();
+
+    for (size_t p = 1; p < pieces.size(); ++p) {
+        double first = pieces[p - 1];
+        double last = pieces[p];
+        double probe = (first + last) / 2.0;
+
+        Window w = {first, last, std::numeric_limits<double>::max()};
+        for (size_t i = 0; i < boxes.size(); ++i) {
+            for (size_t j = 0; j < boxes.size(); ++j) {
+                if (i == j) continue;
+                for (int d = 0; d < 2; ++d) {
+                    requireNonPositive(moverLow(boxes[i], d, first) - moverHigh(boxes[j], d, first),
+                                       moverVLow(boxes[i], d, probe) - moverVHigh(boxes[j], d, probe), first, w);
+                }
+            }
+        }
+        double span = w.hi - w.lo;
+        *margin = std::min(*margin, std::min(std::fabs(span), w.flatMargin));
+        if (span >= 0.0) found = true;
+    }
+    return found;
+}
+
+bool containedThroughout(const Mover& query, const Mover& entry, double t0, double t1, double* margin) {
+    bool inside = true;
+    *margin = std::numeric_limits<double>::max();
+    std::vector<Mover> boxes;
+    boxes.push_back(query);
+    boxes.push_back(entry);
+    std::vector<double> times = motionPieces(boxes, t0, t1);
+    for (size_t i = 0; i < times.size(); ++i) {
+        for (int d = 0; d < 2; ++d) {
+            double below = moverLow(entry, d, times[i]) - moverLow(query, d, times[i]);
+            double above = moverHigh(query, d, times[i]) - moverHigh(entry, d, times[i]);
+            *margin = std::min(*margin, std::min(std::fabs(below), std::fabs(above)));
+            if (below < 0.0 || above < 0.0) inside = false;
+        }
+    }
+    return inside;
+}
+
+double nextValue(uint64_t& state, double lo, double hi) {
+    state = state * 6364136223846793005ULL + 1442695040888963407ULL;
+    return lo + (hi - lo) * static_cast<double>((state >> 33) % 10001) / 10000.0;
+}
+
+void fillStoppingScene(Scene& scene, id_type count, uint64_t seed, double spread, double speed) {
+    uint64_t state = seed;
+    for (id_type id = 1; id <= count; ++id) {
+        double ref = static_cast<double>(id - 1) * 0.05;
+        double x = nextValue(state, -spread, spread);
+        double y = nextValue(state, -spread, spread);
+        double w = nextValue(state, 0.5, 3.0);
+        double h = nextValue(state, 0.5, 3.0);
+        double vx = nextValue(state, -speed, speed);
+        double vy = nextValue(state, -speed, speed);
+        double stop = (id % 3 == 0) ? kNoStop : ref + nextValue(state, 1.0, 9.0);
+        scene.insert(id, stopping(boxMover(ref, x, y, x + w, y + h, vx, vy), stop));
+    }
+}
+
+void fillStretchingScene(Scene& scene, id_type count, uint64_t seed, double spread, double speed) {
+    uint64_t state = seed;
+    for (id_type id = 1; id <= count; ++id) {
+        double ref = static_cast<double>(id - 1) * 0.05;
+        double x = nextValue(state, -spread, spread);
+        double y = nextValue(state, -spread, spread);
+        double w = nextValue(state, 0.5, 3.0);
+        double h = nextValue(state, 0.5, 3.0);
+        double vlx = nextValue(state, -speed, speed);
+        double vly = nextValue(state, -speed, speed);
+        double vhx = vlx + nextValue(state, 0.1, speed);
+        double vhy = vly + nextValue(state, 0.1, speed);
+        scene.insert(id, stretchMover(ref, x, y, x + w, y + h, vlx, vly, vhx, vhy));
+    }
+}
+
+void fillRandomScene(Scene& scene, id_type count, uint64_t seed, double spread, double speed) {
+    uint64_t state = seed;
+    for (id_type id = 1; id <= count; ++id) {
+        double ref = static_cast<double>(id - 1) * 0.05;
+        double x = nextValue(state, -spread, spread);
+        double y = nextValue(state, -spread, spread);
+        double w = (id % 2 == 0) ? nextValue(state, 0.5, 3.0) : 0.0;
+        double h = (id % 2 == 0) ? nextValue(state, 0.5, 3.0) : 0.0;
+        double vx = nextValue(state, -speed, speed);
+        double vy = nextValue(state, -speed, speed);
+        scene.insert(id, boxMover(ref, x, y, x + w, y + h, vx, vy));
+    }
+}
+
+std::vector<id_type> oracleIntersecting(const Scene& scene, const Mover& query, double t0, double t1) {
+    std::vector<id_type> out;
+    for (std::map<id_type, Mover>::const_iterator it = scene.movers.begin(); it != scene.movers.end(); ++it) {
+        std::vector<Mover> boxes;
+        boxes.push_back(query);
+        boxes.push_back(it->second);
+        double margin = 0.0;
+        if (sameInstantOverlap(boxes, t0, t1, &margin)) out.push_back(it->first);
+        EXPECT_GT(margin, 1e-6) << "ambiguous fixture entry " << it->first;
+    }
+    return sorted(out);
+}
+
+std::vector<id_type> oracleContained(const Scene& scene, const Mover& query, double t0, double t1) {
+    std::vector<id_type> out;
+    for (std::map<id_type, Mover>::const_iterator it = scene.movers.begin(); it != scene.movers.end(); ++it) {
+        double margin = 0.0;
+        if (containedThroughout(query, it->second, t0, t1, &margin)) out.push_back(it->first);
+        EXPECT_GT(margin, 1e-6) << "ambiguous fixture entry " << it->first;
+    }
+    return sorted(out);
+}
+
+std::vector<id_type> intersecting(Scene& scene, const SpatialIndex::IShape& query) {
+    sidx_test::IdVisitor visitor;
+    scene.tree->intersectsWithQuery(query, visitor);
+    return sorted(visitor.ids);
+}
+
+std::vector<id_type> contained(Scene& scene, const SpatialIndex::IShape& query) {
+    sidx_test::IdVisitor visitor;
+    scene.tree->containsWhatQuery(query, visitor);
+    return sorted(visitor.ids);
+}
+
+std::vector<id_type> located(Scene& scene, const SpatialIndex::Point& query) {
+    sidx_test::IdVisitor visitor;
+    scene.tree->pointLocationQuery(query, visitor);
+    return sorted(visitor.ids);
+}
+
+template <typename Shape>
+Shape atInstant(Shape shape, double t) {
+    shape.setBounds(t, t);
+    return shape;
+}
+
+class TimedBox : public SpatialIndex::Region, public SpatialIndex::ITimeShape {
+public:
+    TimedBox(const double* low, const double* high, double first, double last)
+        : SpatialIndex::Region(low, high, 2), begins(first), ends(last) {}
+
+    double getLowerBound() const override { return begins; }
+    double getUpperBound() const override { return ends; }
+    void setBounds(double first, double last) override { begins = first; ends = last; }
+    bool intersectsInterval(const Tools::IInterval& other) const override {
+        return begins <= other.getUpperBound() && other.getLowerBound() <= ends;
+    }
+    bool intersectsInterval(Tools::IntervalType, const double first, const double last) const override {
+        return begins <= last && first <= ends;
+    }
+    bool containsInterval(const Tools::IInterval& other) const override {
+        return begins <= other.getLowerBound() && other.getUpperBound() <= ends;
+    }
+    Tools::IntervalType getIntervalType() const override { return Tools::IT_RIGHTOPEN; }
+
+    bool intersectsShapeInTime(const SpatialIndex::ITimeShape&) const override { return false; }
+    bool intersectsShapeInTime(const Tools::IInterval&, const SpatialIndex::ITimeShape&) const override { return false; }
+    bool containsShapeInTime(const SpatialIndex::ITimeShape&) const override { return false; }
+    bool containsShapeInTime(const Tools::IInterval&, const SpatialIndex::ITimeShape&) const override { return false; }
+    bool touchesShapeInTime(const SpatialIndex::ITimeShape&) const override { return false; }
+    bool touchesShapeInTime(const Tools::IInterval&, const SpatialIndex::ITimeShape&) const override { return false; }
+    double getAreaInTime() const override { return 0.0; }
+    double getAreaInTime(const Tools::IInterval&) const override { return 0.0; }
+    double getIntersectingAreaInTime(const SpatialIndex::ITimeShape&) const override { return 0.0; }
+    double getIntersectingAreaInTime(const Tools::IInterval&, const SpatialIndex::ITimeShape&) const override { return 0.0; }
+
+    double begins;
+    double ends;
+};
+
+class BandedComparator : public SpatialIndex::INearestNeighborComparator {
+public:
+    double getMinimumDistance(const SpatialIndex::IShape&, const SpatialIndex::IShape&) override {
+        return 0.0;
+    }
+
+    double getMinimumDistance(const SpatialIndex::IShape&, const SpatialIndex::IData& data) override {
+        id_type id = data.getIdentifier();
+        if (id <= 2) return 1.0;
+        if (id <= 4) return 5.0;
+        return 9.0;
+    }
+};
+
+class ScaledIdComparator : public SpatialIndex::INearestNeighborComparator {
+public:
+    double getMinimumDistance(const SpatialIndex::IShape&, const SpatialIndex::IShape&) override {
+        return 0.0;
+    }
+
+    double getMinimumDistance(const SpatialIndex::IShape&, const SpatialIndex::IData& data) override {
+        return 100.0 - static_cast<double>(data.getIdentifier());
+    }
+};
+
+class CountingComparator : public SpatialIndex::INearestNeighborComparator {
+public:
+    double getMinimumDistance(const SpatialIndex::IShape&, const SpatialIndex::IShape&) override {
+        ++shapeCalls;
+        return 0.0;
+    }
+
+    double getMinimumDistance(const SpatialIndex::IShape&, const SpatialIndex::IData& data) override {
+        ++dataCalls;
+        return 100.0 - static_cast<double>(data.getIdentifier());
+    }
+
+    size_t shapeCalls{0};
+    size_t dataCalls{0};
+};
+
+class PairArityVisitor : public SpatialIndex::IVisitor {
+public:
+    void visitNode(const SpatialIndex::INode&) override {}
+
+    void visitData(const SpatialIndex::IData&) override { ++singles; }
+
+    void visitData(std::vector<const SpatialIndex::IData*>& data) override {
+        sizes.push_back(data.size());
+        if (data.size() >= 2) {
+            id_type a = data[0]->getIdentifier();
+            id_type b = data[1]->getIdentifier();
+            pairs.insert(std::make_pair(std::min(a, b), std::max(a, b)));
+        }
+    }
+
+    size_t singles{0};
+    std::vector<size_t> sizes;
+    std::set<std::pair<id_type, id_type> > pairs;
+};
+
+}
