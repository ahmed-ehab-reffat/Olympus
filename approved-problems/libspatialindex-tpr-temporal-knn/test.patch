+    }
+
+    ASSERT_GT(all[12].first - all[11].first, 1e-4);
+    double limit = (all[11].first + all[12].first) / 2.0;
+    std::vector<id_type> expected;
+    for (size_t i = 0; i < 12; ++i) expected.push_back(all[i].second);
+    sidx_test::IdVisitor limited;
+    double d = scene.tree->nearestNeighborQuery(50, query, limited, limit);
