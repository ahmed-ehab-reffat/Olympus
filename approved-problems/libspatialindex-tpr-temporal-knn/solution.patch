+static double heldLow(const MovingRegion& r, uint32_t d, double t)
+{
+	return r.getExtrapolatedLow(d, std::min(t, r.m_endTime));
+}
+
+static double heldHigh(const MovingRegion& r, uint32_t d, double t)
+{
+	return r.getExtrapolatedHigh(d, std::min(t, r.m_endTime));
+}
+
+static double heldVLow(const MovingRegion& r, uint32_t d, double t)
+{
+	return (t < r.m_endTime) ? r.getVLow(d) : 0.0;
+}
+
+static double heldVHigh(const MovingRegion& r, uint32_t d, double t)
+{
+	return (t < r.m_endTime) ? r.getVHigh(d) : 0.0;
+}
+
+static double getGapInTime(const MovingRegion& a, const MovingRegion& b, uint32_t d, double t)
+{
+	double above = heldLow(b, d, t) - heldHigh(a, d, t);
+	double below = heldLow(a, d, t) - heldHigh(b, d, t);
+	return std::max(0.0, std::max(above, below));
+}
+
+static double getSquaredDistanceAtTime(const MovingRegion& a, const MovingRegion& b, double t)
+{
+	double sum = 0.0;
+	for (uint32_t cDim = 0; cDim < a.m_dimension; ++cDim)
+	{
+		double gap = getGapInTime(a, b, cDim, t);
+		sum += gap * gap;
+	}
+	return sum;
+}
+
+static void addBreakpoint(std::vector<double>& times, double t, double tmin, double tmax)
+{
+	if (t > tmin && t < tmax) times.push_back(t);
+}
+
+static std::vector<double> getMotionPieces(const std::vector<const MovingRegion*>& parts, double tmin, double tmax)
+{
+	std::vector<double> pieces;
+	pieces.push_back(tmin);
+	for (size_t cPart = 0; cPart < parts.size(); ++cPart) addBreakpoint(pieces, parts[cPart]->m_endTime, tmin, tmax);
+	pieces.push_back(tmax);
+	std::sort(pieces.begin(), pieces.end());
+	pieces.erase(std::unique(pieces.begin(), pieces.end()), pieces.end());
+	if (pieces.size() < 2) pieces.push_back(tmax);
+	return pieces;
+}
+
+double MovingRegion::getMinimumDistanceInTime(const IInterval& ivI, const MovingRegion& r) const
+{
+	if (m_dimension != r.m_dimension) throw Tools::IllegalArgumentException("getMinimumDistanceInTime: MovingRegions have different number of dimensions.");
+
+	double tmin = ivI.getLowerBound();
+	double tmax = ivI.getUpperBound();
+	if (tmin > tmax) throw Tools::IllegalArgumentException("getMinimumDistanceInTime: the time interval is empty.");
+
+	std::vector<const MovingRegion*> parts;
+	parts.push_back(this);
+	parts.push_back(&r);
+	std::vector<double> pieces = getMotionPieces(parts, tmin, tmax);
+
+	double best = std::numeric_limits<double>::max();
+
+	for (size_t cPiece = 1; cPiece < pieces.size(); ++cPiece)
+	{
+		double first = pieces[cPiece - 1];
+		double last = pieces[cPiece];
+		double probe = (first + last) / 2.0;
+
+		std::vector<double> times;
+		times.push_back(first);
+		times.push_back(last);
+
+		for (uint32_t cDim = 0; cDim < m_dimension; ++cDim)
+		{
+			double above = heldLow(r, cDim, first) - heldHigh(*this, cDim, first);
+			double aboveRate = heldVLow(r, cDim, probe) - heldVHigh(*this, cDim, probe);
+			double below = heldLow(*this, cDim, first) - heldHigh(r, cDim, first);
+			double belowRate = heldVLow(*this, cDim, probe) - heldVHigh(r, cDim, probe);
+
+			if (aboveRate != 0.0) addBreakpoint(times, first - above / aboveRate, first, last);
+			if (belowRate != 0.0) addBreakpoint(times, first - below / belowRate, first, last);
+			if (aboveRate != belowRate) addBreakpoint(times, first - (above - below) / (aboveRate - belowRate), first, last);
+		}
+
+		std::sort(times.begin(), times.end());
+
+		for (size_t cTime = 0; cTime < times.size(); ++cTime)
+		{
+			best = std::min(best, getSquaredDistanceAtTime(*this, r, times[cTime]));
+		}
+
+		for (size_t cTime = 1; cTime < times.size(); ++cTime)
+		{
+			double t0 = times[cTime - 1];
+			double t1 = times[cTime];
+			if (t1 <= t0) continue;
+
+			double mid = (t0 + t1) / 2.0;
+			double a = 0.0, b = 0.0;
+
+			for (uint32_t cDim = 0; cDim < m_dimension; ++cDim)
+			{
+				double above = heldLow(r, cDim, mid) - heldHigh(*this, cDim, mid);
+				double below = heldLow(*this, cDim, mid) - heldHigh(r, cDim, mid);
+				if (above <= 0.0 && below <= 0.0) continue;
+
+				double gap = (above > below) ? above : below;
+				double rate = (above > below)
+					? heldVLow(r, cDim, mid) - heldVHigh(*this, cDim, mid)
+					: heldVLow(*this, cDim, mid) - heldVHigh(r, cDim, mid);
+				a += rate * rate;
+				b += gap * rate;
+			}
+
+			if (a > 0.0)
+			{
+				double t = mid - b / a;
+				if (t > t0 && t < t1) best = std::min(best, getSquaredDistanceAtTime(*this, r, t));
+			}
+		}
+	}
+
+	return std::sqrt(best);
+}
+
+static bool restrictToOverlap(const MovingRegion& x, const MovingRegion& y, double base, double probe, double& lo, double& hi)
+{
+	for (uint32_t cDim = 0; cDim < x.m_dimension; ++cDim)
+	{
+		for (int cSide = 0; cSide < 2; ++cSide)
+		{
+			const MovingRegion& p = (cSide == 0) ? x : y;
+			const MovingRegion& q = (cSide == 0) ? y : x;
+			double excess = heldLow(p, cDim, base) - heldHigh(q, cDim, base);
+			double rate = heldVLow(p, cDim, probe) - heldVHigh(q, cDim, probe);
+
+			if (rate == 0.0)
+			{
+				if (excess > 0.0) return false;
+			}
+			else if (rate > 0.0) hi = std::min(hi, base - excess / rate);
+			else lo = std::max(lo, base - excess / rate);
+		}
+	}
+	return lo <= hi;
+}
+
+bool MovingRegion::intersectsRegionAtSameInstant(const IInterval& ivI, const MovingRegion& r, const MovingRegion& s) const
+{
+	if (m_dimension != r.m_dimension || m_dimension != s.m_dimension) throw Tools::IllegalArgumentException("intersectsRegionAtSameInstant: MovingRegions have different number of dimensions.");
+
+	double tmin = ivI.getLowerBound();
+	double tmax = ivI.getUpperBound();
+	if (tmin > tmax) return false;
+
+	std::vector<const MovingRegion*> parts;
+	parts.push_back(this);
+	parts.push_back(&r);
+	parts.push_back(&s);
+	std::vector<double> pieces = getMotionPieces(parts, tmin, tmax);
+
+	for (size_t cPiece = 1; cPiece < pieces.size(); ++cPiece)
+	{
+		double lo = pieces[cPiece - 1];
+		double hi = pieces[cPiece];
+		double base = lo;
+		double probe = (lo + hi) / 2.0;
+
+		if (restrictToOverlap(*this, r, base, probe, lo, hi) &&
+			restrictToOverlap(*this, s, base, probe, lo, hi) &&
+			restrictToOverlap(r, s, base, probe, lo, hi)) return true;
+	}
+
+	return false;
+}
+
+bool MovingRegion::containsRegionAtEveryInstant(const IInterval& ivI, const MovingRegion& r) const
+{
+	if (m_dimension != r.m_dimension) throw Tools::IllegalArgumentException("containsRegionAtEveryInstant: MovingRegions have different number of dimensions.");
+
+	double tmin = ivI.getLowerBound();
+	double tmax = ivI.getUpperBound();
+	if (tmin > tmax) return false;
+
+	std::vector<const MovingRegion*> parts;
+	parts.push_back(this);
+	parts.push_back(&r);
+	std::vector<double> times = getMotionPieces(parts, tmin, tmax);
+
+	for (size_t cTime = 0; cTime < times.size(); ++cTime)
+	{
+		double t = times[cTime];
+		for (uint32_t cDim = 0; cDim < m_dimension; ++cDim)
+		{
+			if (heldLow(r, cDim, t) < heldLow(*this, cDim, t)) return false;
+			if (heldHigh(r, cDim, t) > heldHigh(*this, cDim, t)) return false;
+		}
+	}
+	return true;
+}
