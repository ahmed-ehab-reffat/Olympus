+void SpatialIndex::TPRTree::TPRTree::getShapeRegion(const IShape& query, MovingRegion& out)
+{
+	uint32_t dim = query.getDimension();
+	std::vector<double> zero(dim, 0.0);
+
+	const Tools::IInterval* iv = dynamic_cast<const Tools::IInterval*>(&query);
+	if (iv == nullptr) throw Tools::IllegalArgumentException("TPRTree: the shape must be a moving region, a moving point, a time region or a time point.");
+	if (iv->getLowerBound() > iv->getUpperBound()) throw Tools::IllegalArgumentException("TPRTree: the shape time interval starts after it ends.");
+
+	if (const MovingRegion* mr = dynamic_cast<const MovingRegion*>(&query))
+	{
+		out = *mr;
+	}
+	else if (const MovingPoint* mp = dynamic_cast<const MovingPoint*>(&query))
+	{
+		out = MovingRegion(mp->m_pCoords, mp->m_pCoords, mp->m_pVCoords, mp->m_pVCoords, mp->m_startTime, mp->m_endTime, dim);
+	}
+	else if (const TimeRegion* tr = dynamic_cast<const TimeRegion*>(&query))
+	{
+		out = MovingRegion(tr->m_pLow, tr->m_pHigh, zero.data(), zero.data(), tr->m_startTime, tr->m_endTime, dim);
+	}
+	else if (const TimePoint* tp = dynamic_cast<const TimePoint*>(&query))
+	{
+		out = MovingRegion(tp->m_pCoords, tp->m_pCoords, zero.data(), zero.data(), tp->m_startTime, tp->m_endTime, dim);
+	}
+	else
+	{
+		throw Tools::IllegalArgumentException("TPRTree: the shape must be a moving region, a moving point, a time region or a time point.");
+	}
+}
+
+
+void SpatialIndex::TPRTree::TPRTree::validateQueryInterval(const MovingRegion& query, const std::string& method) const
+{
+	if (query.m_startTime < m_currentTime || query.m_endTime >= m_currentTime + m_horizon)
+		throw Tools::IllegalArgumentException(method + ": Query time interval does not intersect current horizon.");
+}
+
+double SpatialIndex::TPRTree::TPRTree::NNComparator::getMinimumDistance(const IShape& query, const IShape& entry)
+{
+	const MovingRegion* e = dynamic_cast<const MovingRegion*>(&entry);
+	if (e == nullptr) return query.getMinimumDistance(entry);
+
+	MovingRegion q;
+	getShapeRegion(query, q);
+	return q.getMinimumDistanceInTime(q, *e);
+}
+
+double SpatialIndex::TPRTree::TPRTree::NNComparator::getMinimumDistance(const IShape& query, const IData& data)
+{
+	IShape* pS;
+	data.getShape(&pS);
+	double ret = getMinimumDistance(query, *pS);
+	delete pS;
+	return ret;
+}
+
+void SpatialIndex::TPRTree::TPRTree::selfJoinQuery(id_type id1, id_type id2, const MovingRegion& query, IVisitor& v)
+{
+	NodePtr n1 = readNode(id1);
+	NodePtr n2 = (id1 == id2) ? n1 : readNode(id2);
+	v.visitNode(*n1);
+	if (id1 != id2) v.visitNode(*n2);
+
+	for (uint32_t cChild1 = 0; cChild1 < n1->m_children; ++cChild1)
+	{
+		const MovingRegion& r1 = *(n1->m_ptrMBR[cChild1]);
+		if (! query.intersectsRegionAtSameInstant(query, r1, r1)) continue;
+
+		for (uint32_t cChild2 = (id1 == id2) ? cChild1 : 0; cChild2 < n2->m_children; ++cChild2)
+		{
+			const MovingRegion& r2 = *(n2->m_ptrMBR[cChild2]);
+			if (n1->m_level == 0 && id1 == id2 && cChild1 == cChild2) continue;
+			if (! query.intersectsRegionAtSameInstant(query, r1, r2)) continue;
+
+			if (n1->m_level == 0)
+			{
+				std::vector<const IData*> pair;
+				Data e1(n1->m_pDataLength[cChild1], n1->m_pData[cChild1], *(n1->m_ptrMBR[cChild1]), n1->m_pIdentifier[cChild1]);
+				Data e2(n2->m_pDataLength[cChild2], n2->m_pData[cChild2], *(n2->m_ptrMBR[cChild2]), n2->m_pIdentifier[cChild2]);
+				pair.push_back(&e1);
+				pair.push_back(&e2);
+				v.visitData(pair);
+				++(m_stats.m_queryResults);
+			}
+			else
+			{
+				selfJoinQuery(n1->m_pIdentifier[cChild1], n2->m_pIdentifier[cChild2], query, v);
 			}
 		}
 	}
