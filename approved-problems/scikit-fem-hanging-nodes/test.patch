+def test_estimator_gives_the_coarse_element_its_share():
+    m = two_corners()
+    e = ElementQuad1()
+    basis = Basis(m, e)
+    x = poisson(basis)
+
+    def load(p):
+        return 1. + 0. * p[0]
+
+    @Functional
+    def interior(w):
+        return w.h ** 2 * load(w.x) ** 2
+
+    @Functional
+    def jump(w):
+        return w.h * ((w['a'].grad[0] - w['b'].grad[0]) * w.n[0]
+                      + (w['a'].grad[1] - w['b'].grad[1]) * w.n[1]) ** 2
+
+    f2t = m.hanging_f2t()
+    facets = np.nonzero(f2t[1] != -1)[0]
+    sides = [InteriorFacetBasis(m, e, facets=facets, side=itr)
+             for itr in [0, 1]]
+    jumps = jump.elemental(sides[0],
+                           a=sides[0].interpolate(x),
+                           b=sides[1].interpolate(x))
+
+    expected = interior.elemental(basis)
+    for itr in [0, 1]:
+        np.add.at(expected, f2t[itr, facets], .5 * jumps)
+    assert_allclose(models.residual_estimator(basis, x, load), expected)
