+def test_estimator_distributes_every_jump():
+    m = two_corners()
+    e = ElementQuad1()
+    basis = Basis(m, e)
+    x = poisson(basis)
+
+    def load(p):
+        return 1. + 0. * p[0]
+
+    eta = models.residual_estimator(basis, x, load)
+
+    @Functional
+    def interior(w):
+        return w.h ** 2 * load(w.x) ** 2
+
+    facets = np.nonzero(m.hanging_f2t()[1] != -1)[0]
+    sides = [InteriorFacetBasis(m, e, facets=facets, side=itr)
+             for itr in [0, 1]]
+
+    @Functional
+    def jump(w):
+        return w.h * ((w['a'].grad[0] - w['b'].grad[0]) * w.n[0]
+                      + (w['a'].grad[1] - w['b'].grad[1]) * w.n[1]) ** 2
+
+    total = (interior.assemble(basis)
+             + jump.assemble(sides[0],
+                             a=sides[0].interpolate(x),
+                             b=sides[1].interpolate(x)))
+    assert_allclose(eta.sum(), total)
+
