+def coarsen_theta(est, theta=0.5, max=None):
+    """For choosing which elements to coarsen in an adaptive strategy.
+
+    The counterpart of :func:`skfem.utils.adaptive_theta`: the elements whose
+    indicator stays below the given fraction of the largest indicator are
+    returned.
+
+    """
+    if max is None:
+        max = np.max(est)
+    return np.nonzero(est <= theta * max)[0].astype(np.int32)
