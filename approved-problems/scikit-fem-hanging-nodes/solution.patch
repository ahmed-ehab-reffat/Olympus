+def residual_estimator(basis, x, f):
+    """Return elementwise error indicators for the Poisson equation.
+
+    The indicator of an element is the sum of the squared interior residual,
+    scaled by the squared element diameter, and half of the squared jump of
+    the normal derivative over each of its facets, scaled by the facet
+    diameter.  The halves of a split facet contribute to the element on the
+    coarse side as well.
+
+    Parameters
+    ----------
+    basis
+        An object of type :class:`~skfem.assembly.CellBasis`.
+    x
+        The finite element solution.
+    f
+        The load, a function of the global coordinates.
+
+    """
+    import numpy as np
+    from skfem.assembly import Functional, InteriorFacetBasis
+
+    @Functional
+    def interior(w):
+        return w.h ** 2 * f(w.x) ** 2
+
+    @Functional
+    def jump(w):
+        return w.h * dot(grad(w['u1']) - grad(w['u2']), w.n) ** 2
+
+    mesh = basis.mesh
+    f2t = mesh.hanging_f2t()
+    facets = np.nonzero(f2t[1] != -1)[0].astype(np.int32)
+    sides = [InteriorFacetBasis(mesh, basis.elem, facets=facets, side=itr)
+             for itr in [0, 1]]
+
+    eta = interior.elemental(basis)
+    jumps = jump.elemental(sides[0],
+                           u1=sides[0].interpolate(x),
+                           u2=sides[1].interpolate(x))
+
+    for itr in [0, 1]:
+        np.add.at(eta, f2t[itr, facets], .5 * jumps)
+
+    return eta
