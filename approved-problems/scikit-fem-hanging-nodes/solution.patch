+            for group, mids in zip(corners, halved):
+                for itr in range(4):
+                    ends = (group[itr], group[(itr + 1) % 4])
+                    facet = locate(*ends)
+                    for end in ends:
+                        half = before.get((min(end, mids[itr]),
+                                           max(end, mids[itr])), -1)
+                        if half >= 0:
+                            new_facets[half] = facet
+
+            m = replace(
+                m,
+                _boundaries={
+                    name: np.unique(new_facets[ixs][new_facets[ixs] >= 0])
+                    for name, ixs in self._boundaries.items()
+                },
+            )
+
+        return m
+
+    def _coarsen_elements(self, kept, merged, ixs):
+        """Map a set of element indices to the indices after coarsening."""
+        position = (-1) * np.ones(self.t.shape[1], dtype=np.int32)
+        position[kept] = np.arange(len(kept), dtype=np.int32)
+        inside = np.isin(np.array(merged, dtype=np.int32),
+                         np.array(ixs, dtype=np.int32)).reshape(-1, 4).all(1)
+        out = [position[np.array(ixs, dtype=np.int32)]]
+        out.append(np.nonzero(inside)[0] + len(kept))
+        out = np.concatenate(out)
+        return np.unique(out[out >= 0])
+
