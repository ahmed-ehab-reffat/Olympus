+def constrain(basis,
+              A: spmatrix,
+              b: Optional[ndarray] = None,
+              x: Optional[ndarray] = None,
+              D: Optional[DofsCollection] = None) -> CondensedSystem:
+    """Eliminate the constrained degrees-of-freedom from a linear system.
+
+    The degrees-of-freedom constrained by the hanging vertices of ``basis``
+    are eliminated together with the ones given through ``D``, and the vector
+    returned by :func:`skfem.utils.solve` has the constrained values filled
+    in.
+
+    Parameters
+    ----------
+    basis
+        The basis used for assembling ``A`` and ``b``.
+    A
+        The system matrix.
+    b
+        The right hand side vector.
+    x
+        The values of the eliminated degrees-of-freedom.  If not given,
+        assumed to be zero.
+    D
+        The set of degree-of-freedom indices to dismiss in addition to the
+        constrained ones.
+
+    """
+    P = basis.hanging_prolongation()
+    S = basis.hanging_dofs()
+    N = A.shape[0]
+
+    given = _flatten_dofs(D)
+    if given is None:
+        given = np.empty((0,), dtype=np.int32)
+    dismiss = np.unique(np.concatenate((given, S)))
+    keep = np.setdiff1d(np.arange(N, dtype=np.int32), dismiss)
+
+    y = np.zeros(N) if x is None else x.copy()
+    y[S] = 0.
+    A = (P.T @ A @ P).tocsr()
+    Pc = P.tocsc()
+
+    if b is None:
+        return (A[keep][:, keep],)
+
+    if isinstance(b, spmatrix):
+        # generalized eigenvalue problem: the mass matrix is constrained too
+        bout = (P.T @ b @ P).tocsr()[keep][:, keep]
+    else:
+        bout = (P.T @ b)[keep] - A[keep][:, dismiss] @ y[dismiss]
+
+    return (
+        A[keep][:, keep],
+        bout,
+        P @ y,
+        (
+            np.arange(N, dtype=np.int32),
+            lambda z: Pc[:, keep] @ z,
+        ),
+    )
+
