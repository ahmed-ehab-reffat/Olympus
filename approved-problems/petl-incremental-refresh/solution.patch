index 0000000..56cc2ab
--- /dev/null
+++ b/petl/delta/plan.py
@@ -0,0 +1,135 @@
+from __future__ import absolute_import, print_function, division
+
+
+from petl.errors import IncrementalError
+from petl.delta.feed import Feed
+from petl.transform.basics import CutView, CatView, AddFieldView, \
+    RowSliceView, StackView
+from petl.transform.conversions import FieldConvertView
+from petl.transform.dedup import DistinctView
+from petl.transform.joins import JoinView
+from petl.transform.reductions import SimpleAggregateView, MultiAggregateView
+from petl.transform.selects import FieldSelectView, RowSelectView
+from petl.transform.sorts import SortView
+
+
+KINDS = [
+    (Feed, 'feed'),
+    (CutView, 'cut'),
+    (AddFieldView, 'addfield'),
+    (FieldConvertView, 'convert'),
+    (RowSelectView, 'select'),
+    (FieldSelectView, 'select'),
+    (CatView, 'cat'),
+    (SortView, 'sort'),
+    (DistinctView, 'distinct'),
+    (RowSliceView, 'head'),
+    (JoinView, 'join'),
+    (SimpleAggregateView, 'aggregate'),
+    (MultiAggregateView, 'aggregate'),
+]
+
+
+def register_kind(cls, kind):
+    """Let a table class outside this module stand as a plan node."""
+
+    KINDS.append((cls, kind))
+
+
+class PlanNode(object):
+    """One table in an incremental pipeline, with its position in the plan."""
+
+    def __init__(self, node_id, kind, view, children):
+        self.node_id = node_id
+        self.kind = kind
+        self.view = view
+        self.children = children
+
+    def __repr__(self):
+        return 'PlanNode(%r)' % self.node_id
+
+
+def node_kind(view):
+    for cls, kind in KINDS:
+        if isinstance(view, cls):
+            return kind
+    raise IncrementalError(type(view).__name__)
+
+
+def unsort(view, key):
+    """Strip the sort a petl constructor wraps a source in."""
+
+    if isinstance(view, SortView) and view.key == key:
+        return view.source
+    return view
+
+
+def unstack(view):
+    """Strip the row length padding a petl constructor wraps a source in."""
+
+    if isinstance(view, StackView) and len(view.sources) == 1:
+        return view.sources[0]
+    return view
+
+
+def node_children(view, kind):
+    if kind in ('feed', 'pipeline'):
+        return []
+    if kind == 'cat':
+        return list(view.sources)
+    if kind == 'join':
+        return [unstack(unsort(view.left, view.lkey)),
+                unstack(unsort(view.right, view.rkey))]
+    if kind == 'distinct':
+        return [unsort(view.table, view.key)]
+    if kind == 'aggregate':
+        source = getattr(view, 'table', None)
+        if source is None:
+            source = view.source
+        return [unsort(source, view.key)]
+    if kind == 'head':
+        if len(view.sliceargs) != 1:
+            raise IncrementalError(type(view).__name__)
+        return [view.source]
+    if kind == 'addfield':
+        return [unstack(view.source)]
+    source = getattr(view, 'source', None)
+    if source is None:
+        source = view.table
+    return [source]
+
+
+def build_plan(table):
+    """Walk a table expression and return its plan nodes in evaluation order."""
+
+    nodes = []
+    by_identity = {}
+    _visit(table, nodes, by_identity)
+    return nodes
+
+
+def _visit(view, nodes, by_identity):
+    known = by_identity.get(id(view))
+    if known is not None:
+        return known
+    kind = node_kind(view)
+    children = [_visit(child, nodes, by_identity)
+                for child in node_children(view, kind)]
+    node_id = '%s#%s' % (kind, len(nodes) + 1)
+    node = PlanNode(node_id, kind, view, children)
+    nodes.append(node)
+    by_identity[id(view)] = node
+    return node
+
+
+def render_plan(nodes):
+    """Return one line per plan node, naming the children it reads."""
+
+    lines = []
+    for node in nodes:
+        if node.children:
+            children = ', '.join(child.node_id for child in node.children)
+        else:
+            children = '-'
+        lines.append('%s: %s' % (node.node_id, children))
+    return '\n'.join(lines)
