index 0000000..57b6a73
--- /dev/null
+++ b/petl/delta/pipeline.py
@@ -0,0 +1,141 @@
+from __future__ import absolute_import, print_function, division
+
+
+from collections import Counter
+
+
+from petl.errors import IncrementalError
+from petl.util.base import Table
+from petl.delta.operators import make_operator
+from petl.delta.plan import build_plan, register_kind, render_plan
+
+
+def bag_difference(old, new):
+    """Return the rows `new` gained over `old`, earliest occurrences first."""
+
+    excess = Counter(new)
+    excess.subtract(Counter(old))
+    gained = []
+    for row in new:
+        if excess[row] > 0:
+            excess[row] -= 1
+            gained.append(row)
+    return gained
+
+
+class Refresh(object):
+    """What one refresh did to a pipeline."""
+
+    def __init__(self, added, removed, emitted):
+        self.added = tuple(added)
+        self.removed = tuple(removed)
+        self.emitted = emitted
+
+    def to_dict(self):
+        """Return the added rows, removed rows and emission counts."""
+
+        return {'added': list(self.added),
+                'removed': list(self.removed),
+                'emitted': dict(self.emitted)}
+
+    def __repr__(self):
+        return 'Refresh(added=%s, removed=%s)' % (len(self.added),
+                                                  len(self.removed))
+
+
+class IncrementalPipeline(Table):
+    """A materialized table expression that follows the feeds it reads."""
+
+    def __init__(self, table, saved=None):
+        self.nodes = build_plan(table)
+        self.operators = [make_operator(node) for node in self.nodes]
+        self.positions = dict((id(node), index)
+                              for index, node in enumerate(self.nodes))
+        if saved is None:
+            self._sweep()
+        else:
+            self._load(saved)
+
+    def __iter__(self):
+        root = self.operators[-1]
+        yield root.header
+        for row in root.rows:
+            yield row
+
+    def plan(self):
+        """Return one line per node, naming the children it reads."""
+
+        return render_plan(self.nodes)
+
+    def refresh(self):
+        """Take in the rows the feeds gained and update the output."""
+
+        before = [list(operator.rows) for operator in self.operators]
+        saved = [operator.state() for operator in self.operators]
+        try:
+            self._sweep()
+        except Exception:
+            for operator, state in zip(self.operators, saved):
+                operator.restore(state)
+            raise
+        emitted = {}
+        for node, operator, old in zip(self.nodes, self.operators, before):
+            gained = bag_difference(old, operator.rows)
+            lost = bag_difference(operator.rows, old)
+            emitted[node.node_id] = len(gained) + len(lost)
+        root = self.operators[-1]
+        return Refresh(bag_difference(before[-1], root.rows),
+                       bag_difference(root.rows, before[-1]),
+                       emitted)
+
+    def checkpoint(self):
+        """Return the state of every node as plain lists and mappings."""
+
+        return {'plan': self.plan(),
+                'nodes': dict((node.node_id, operator.checkpoint())
+                              for node, operator
+                              in zip(self.nodes, self.operators))}
+
+    def _load(self, saved):
+        if saved.get('plan') != self.plan():
+            raise IncrementalError('a checkpoint taken from another plan')
+        for node, operator in zip(self.nodes, self.operators):
+            operator.load(saved['nodes'][node.node_id])
+
+    def _sweep(self):
+        for node, operator in zip(self.nodes, self.operators):
+            inputs = [(self.operators[self.positions[id(child)]].header,
+                       self.operators[self.positions[id(child)]].rows)
+                      for child in node.children]
+            operator.evaluate(inputs)
+
+
+def incremental(table):
+    """Materialize a table expression and keep it up to date from its feeds.
+
+    The expression must be built over :func:`petl.delta.feed.feed` sources or
+    over other pipelines.
+    Building the pipeline reads every row the feeds hold and works the
+    expression out once. Rows appended to a feed afterwards are taken in by
+    :meth:`IncrementalPipeline.refresh`.
+
+    """
+
+    return IncrementalPipeline(table)
+
+
+def resume(table, saved):
+    """Rebuild a pipeline over `table` from the state a checkpoint holds.
+
+    The expression has to have the plan the checkpoint was taken from. No feed
+    is read and no caller supplied callable is applied; the pipeline carries on
+    from the rows the checkpoint left it with.
+
+    """
+
+    return IncrementalPipeline(table, saved)
+
+
+Table.incremental = incremental
+Table.resume = resume
+register_kind(IncrementalPipeline, 'pipeline')
diff --git a/petl/delta/plan.py b/petl/delta/plan.py
