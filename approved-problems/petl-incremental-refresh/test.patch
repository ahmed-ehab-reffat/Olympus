+def test_leftjoin_matches_a_from_scratch_evaluation():
+    lrows = [('a', 1), ('b', 2)]
+    rrows = [('a', 9)]
+    left = _feed(LEFT, lrows)
+    right = _feed(RIGHT, rrows)
+    pipeline = etl.incremental(etl.leftjoin(left, right, key='foo'))
