+
+
+def test_sort_reverse_keeps_the_reverse_order():
+    source = _feed(LEFT, [('a', 3), ('b', 5)])
+    pipeline = etl.incremental(etl.sort(source, 'bar', reverse=True))
+    source.append(('c', 4))
