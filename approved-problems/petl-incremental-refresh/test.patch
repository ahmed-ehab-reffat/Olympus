+from __future__ import absolute_import, print_function, division
+
+import json
+
+import pytest
+
+import petl as etl
+from petl.test.helpers import eq_
+
+
+LEFT = ('foo', 'bar')
+RIGHT = ('foo', 'baz')
+
+
+def _feed(header, rows=()):
+    return etl.feed(header, rows)
+
+
+def _static(header, rows):
+    return [list(header)] + [list(row) for row in rows]
+
+
+def _rows(table):
+    return [tuple(row) for row in table]
+
+
+def _delta(rows):
+    return [tuple(row) for row in rows]
+
+
+def _expect_error(call, name):
+    with pytest.raises(etl.IncrementalError) as caught:
+        call()
+    assert name in str(caught.value)
+
+
+def test_plan_single_feed():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(source)
+    eq_('feed#1: -', pipeline.plan())
+
+
+def test_plan_chain_numbers_children_first():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.cut(etl.sort(source, 'bar'), 'foo'))
+    eq_('feed#1: -\nsort#2: feed#1\ncut#3: sort#2', pipeline.plan())
+
+
+def test_plan_join_walks_left_before_right():
+    left = _feed(LEFT, [('a', 1)])
+    right = _feed(RIGHT, [('a', 9)])
+    pipeline = etl.incremental(etl.join(left, right, key='foo'))
+    eq_('feed#1: -\nfeed#2: -\njoin#3: feed#1, feed#2', pipeline.plan())
+
+
+def test_plan_names_every_child_of_a_cat():
+    left = _feed(LEFT, [('a', 1)])
+    right = _feed(RIGHT, [('a', 9)])
+    pipeline = etl.incremental(etl.cat(left, right))
+    eq_('feed#1: -\nfeed#2: -\ncat#3: feed#1, feed#2', pipeline.plan())
+
+
+def test_plan_shared_feed_is_one_node():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.cat(etl.cut(source, 'foo'),
+                                       etl.cut(source, 'foo')))
+    eq_('feed#1: -\ncut#2: feed#1\ncut#3: feed#1\ncat#4: cut#2, cut#3',
+        pipeline.plan())
+
+
+def test_plan_deep_branch_numbered_before_shallow_one():
+    left = _feed(LEFT, [('a', 1)])
+    right = _feed(RIGHT, [('a', 9)])
+    pipeline = etl.incremental(etl.join(etl.sort(left, 'bar'), right,
+                                        key='foo'))
+    eq_('feed#1: -\nsort#2: feed#1\nfeed#3: -\njoin#4: sort#2, feed#3',
+        pipeline.plan())
+
+
+def test_unsupported_transform_names_its_class():
+    source = _feed(LEFT, [('a', 1)])
+    _expect_error(lambda: etl.incremental(etl.melt(source, 'foo')), 'MeltView')
+
+
+def test_unsupported_static_leaf_names_its_class():
+    _expect_error(lambda: etl.incremental(etl.cut([['foo'], ['a']], 'foo')),
+                  'list')
+
+
+def test_unsupported_rowslice_form_rejected():
+    source = _feed(LEFT, [('a', 1), ('b', 2), ('c', 3)])
+    _expect_error(lambda: etl.incremental(etl.rowslice(source, 1, 3)),
+                  'RowSliceView')
+
+
+def test_head_form_of_rowslice_accepted():
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    pipeline = etl.incremental(etl.head(source, 1))
+    eq_([LEFT, ('a', 1)], _rows(pipeline))
+
+
+def test_build_materializes_the_output():
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    pipeline = etl.incremental(etl.cut(source, 'foo'))
+    eq_([('foo',), ('a',), ('b',)], _rows(pipeline))
+
+
+def test_build_reads_every_row_once():
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    etl.incremental(etl.cut(source, 'foo'))
+    eq_(2, source.rows_read)
+
+
+def test_appended_rows_are_invisible_until_refresh():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(source)
+    source.append(('b', 2))
+    eq_([LEFT, ('a', 1)], _rows(pipeline))
+    pipeline.refresh()
+    eq_([LEFT, ('a', 1), ('b', 2)], _rows(pipeline))
+
+
+def test_refresh_reads_only_the_new_rows():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(source)
+    source.extend([('b', 2), ('c', 3)])
+    pipeline.refresh()
+    eq_(3, source.rows_read)
+
+
+def test_rows_from_hands_out_the_tail():
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    eq_([('b', 2)], _delta(source.rows_from(1)))
+    eq_(1, source.rows_read)
+
+
+def test_iterating_a_feed_counts_its_rows():
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    eq_([LEFT, ('a', 1), ('b', 2)], _rows(source))
+    eq_(2, source.rows_read)
+
+
+def test_refresh_without_new_rows_reports_nothing():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(source)
+    result = pipeline.refresh()
+    eq_([], _delta(result.added))
+    eq_([], _delta(result.removed))
+    eq_({'feed#1': 0}, result.emitted)
+
+
+def test_empty_feed_builds_an_empty_output():
+    source = _feed(LEFT)
+    pipeline = etl.incremental(etl.cut(source, 'foo'))
+    eq_([('foo',)], _rows(pipeline))
+
+
+def test_header_matches_a_from_scratch_evaluation():
+    source = _feed(LEFT, [('a', 1)])
+    expression = etl.addfield(etl.cut(source, 'foo'), 'baz', 2)
+    pipeline = etl.incremental(expression)
+    plain = etl.addfield(etl.cut(_static(LEFT, [('a', 1)]), 'foo'), 'baz', 2)
+    eq_(_rows(plain)[0], _rows(pipeline)[0])
+
+
+def test_cut_projects_rows_added_later():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.cut(source, 'bar'))
+    source.append(('b', 2))
+    pipeline.refresh()
+    eq_([('bar',), (1,), (2,)], _rows(pipeline))
+
+
+def test_cut_keeps_rows_that_become_equal():
+    source = _feed(LEFT, [('a', 1), ('b', 1)])
+    pipeline = etl.incremental(etl.cut(source, 'bar'))
+    source.append(('c', 1))
+    result = pipeline.refresh()
+    eq_([('bar',), (1,), (1,), (1,)], _rows(pipeline))
+    eq_([(1,)], _delta(result.added))
+
+
+def test_select_keeps_matching_rows_only():
+    source = _feed(LEFT, [('a', 1), ('b', 5)])
+    pipeline = etl.incremental(etl.select(source, lambda row: row.bar > 3))
+    source.extend([('c', 9), ('d', 0)])
+    pipeline.refresh()
+    eq_([LEFT, ('b', 5), ('c', 9)], _rows(pipeline))
+
+
+def test_select_applies_its_predicate_once_per_row():
+    seen = []
+
+    def predicate(row):
+        seen.append(tuple(row))
+        return True
+
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    etl.incremental(etl.select(source, predicate))
+    eq_([('a', 1), ('b', 2)], seen)
+
+
+def test_select_does_not_revisit_rows_on_refresh():
+    seen = []
+
+    def predicate(row):
+        seen.append(tuple(row))
+        return True
+
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    pipeline = etl.incremental(etl.select(source, predicate))
+    del seen[:]
+    source.append(('c', 3))
+    pipeline.refresh()
+    eq_([('c', 3)], seen)
+
+
+def test_select_visits_each_duplicate_row():
+    seen = []
+
+    def predicate(row):
+        seen.append(tuple(row))
+        return True
+
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.select(source, predicate))
+    del seen[:]
+    source.extend([('a', 1), ('a', 1)])
+    pipeline.refresh()
+    eq_([('a', 1), ('a', 1)], seen)
+    eq_([LEFT, ('a', 1), ('a', 1), ('a', 1)], _rows(pipeline))
+
+
+def test_select_rejecting_everything_leaves_the_header():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.select(source, lambda row: False))
+    source.append(('b', 2))
+    result = pipeline.refresh()
+    eq_([LEFT], _rows(pipeline))
+    eq_([], _delta(result.added))
+
+
+def test_addfield_adds_the_new_column():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.addfield(source, 'baz',
+                                            lambda row: row.bar * 2))
+    source.append(('b', 3))
+    pipeline.refresh()
+    eq_([('foo', 'bar', 'baz'), ('a', 1, 2), ('b', 3, 6)], _rows(pipeline))
+
+
+def test_addfield_calls_its_value_once_per_row():
+    seen = []
+
+    def value(row):
+        seen.append(tuple(row))
+        return len(seen)
+
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.addfield(source, 'baz', value))
+    source.append(('b', 2))
+    pipeline.refresh()
+    eq_([('a', 1), ('b', 2)], seen)
+
+
+def test_addfield_with_a_constant():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.addfield(source, 'baz', 7))
+    source.append(('b', 2))
+    pipeline.refresh()
+    eq_([('foo', 'bar', 'baz'), ('a', 1, 7), ('b', 2, 7)], _rows(pipeline))
+
+
+def test_convert_maps_a_field():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.convert(source, 'bar', lambda v: v + 10))
+    source.append(('b', 2))
+    pipeline.refresh()
+    eq_([LEFT, ('a', 11), ('b', 12)], _rows(pipeline))
+
+
+def test_convert_calls_its_converter_once_per_row():
+    seen = []
+
+    def converter(value):
+        seen.append(value)
+        return value
+
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.convert(source, 'bar', converter))
+    del seen[:]
+    source.append(('b', 2))
+    pipeline.refresh()
+    eq_([2], seen)
+
+
+def test_row_wise_chain_matches_a_from_scratch_evaluation():
+    rows = [('a', 1), ('b', 2)]
+    source = _feed(LEFT, rows)
+    expression = etl.cut(etl.addfield(etl.select(source,
+                                                 lambda row: row.bar > 0),
+                                      'baz', lambda row: row.foo * 2),
+                         'foo', 'baz')
+    pipeline = etl.incremental(expression)
+    source.append(('c', 3))
+    rows.append(('c', 3))
+    pipeline.refresh()
+    plain = etl.cut(etl.addfield(etl.select(_static(LEFT, rows),
+                                            lambda row: row.bar > 0),
+                                 'baz', lambda row: row.foo * 2),
+                    'foo', 'baz')
+    eq_(_rows(plain), _rows(pipeline))
+
+
+def test_cat_appends_the_second_source():
+    left = _feed(LEFT, [('a', 1)])
+    right = _feed(LEFT, [('b', 2)])
+    pipeline = etl.incremental(etl.cat(left, right))
+    right.append(('c', 3))
+    pipeline.refresh()
+    eq_([LEFT, ('a', 1), ('b', 2), ('c', 3)], _rows(pipeline))
+
+
+def test_cat_growth_of_the_first_source_lands_before_the_second():
+    left = _feed(LEFT, [('a', 1)])
+    right = _feed(LEFT, [('b', 2)])
+    pipeline = etl.incremental(etl.cat(left, right))
+    left.append(('c', 3))
+    result = pipeline.refresh()
+    eq_([LEFT, ('a', 1), ('c', 3), ('b', 2)], _rows(pipeline))
+    eq_([('c', 3)], _delta(result.added))
+
+
+def test_cat_unifies_the_two_headers():
+    left = _feed(LEFT, [('a', 1)])
+    right = _feed(RIGHT, [('b', 9)])
+    pipeline = etl.incremental(etl.cat(left, right))
+    left.append(('c', 3))
+    pipeline.refresh()
+    eq_([('foo', 'bar', 'baz'), ('a', 1, None), ('c', 3, None),
+         ('b', None, 9)], _rows(pipeline))
+
+
+def test_cat_of_one_feed_with_itself():
+    source = _feed(LEFT, [('a', 1)])
+    pipeline = etl.incremental(etl.cat(source, source))
+    source.append(('b', 2))
+    result = pipeline.refresh()
+    eq_([LEFT, ('a', 1), ('b', 2), ('a', 1), ('b', 2)], _rows(pipeline))
+    eq_(1, result.emitted['feed#1'])
+
+
+def test_sort_places_a_new_row_by_its_key():
+    source = _feed(LEFT, [('a', 3), ('b', 5)])
+    pipeline = etl.incremental(etl.sort(source, 'bar'))
+    source.append(('c', 4))
