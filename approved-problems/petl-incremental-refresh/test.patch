+    eq_([LEFT, ('b', 5), ('c', 4), ('a', 3)], _rows(pipeline))
+
+
+def test_sort_keeps_equal_keys_in_arrival_order():
+    source = _feed(LEFT, [('a', 1), ('b', 1)])
+    pipeline = etl.incremental(etl.sort(source, 'bar'))
+    source.append(('c', 1))
+    pipeline.refresh()
+    eq_([LEFT, ('a', 1), ('b', 1), ('c', 1)], _rows(pipeline))
+
+
+def test_sort_then_select_matches_a_from_scratch_evaluation():
+    rows = [('a', 3), ('b', 1)]
+    source = _feed(LEFT, rows)
+    pipeline = etl.incremental(etl.select(etl.sort(source, 'bar'),
+                                          lambda row: row.bar < 3))
+    source.append(('c', 2))
+    rows.append(('c', 2))
+    pipeline.refresh()
+    plain = etl.select(etl.sort(_static(LEFT, rows), 'bar'),
+                       lambda row: row.bar < 3)
+    eq_(_rows(plain), _rows(pipeline))
+
+
+def test_head_keeps_the_first_rows_only():
+    source = _feed(LEFT, [('a', 1), ('b', 2)])
+    pipeline = etl.incremental(etl.head(source, 2))
+    source.append(('c', 3))
+    result = pipeline.refresh()
+    eq_([LEFT, ('a', 1), ('b', 2)], _rows(pipeline))
+    eq_([], _delta(result.added))
+
+
+def test_head_window_drops_the_row_it_pushes_out():
+    source = _feed(LEFT, [('a', 3), ('b', 5)])
