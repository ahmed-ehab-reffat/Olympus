@@ -0,0 +1,296 @@
+// Copyright 2015 Ted Mielczarek. See the COPYRIGHT
+// file at the top-level directory of this distribution.
+
+//! Containment rules that constrain a stack walk to the thread's own stack.
+//!
+//! Each architecture's unwinder reports how it recovered a frame, and that report is
+//! taken at face value by the walker. These rules give the walk a notion of where the
+//! thread's stack actually lives, so a frame recovered from somewhere else can be
+//! recorded at a weaker trust than the unwinder claimed for it.
+
+use crate::{FrameTrust, FrameWalker, StackFrame};
+use minidump::UnifiedMemory;
+
+/// The address range that a thread's stack occupies.
+///
+/// The low address is part of the region and the high address is not, so a stack
+/// pointer exactly equal to [`StackRegion::end`][] lies outside of it.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub struct StackRegion {
+    /// The lowest address that belongs to the region.
+    pub base: u64,
+    /// The first address past the region.
+    pub end: u64,
+}
+
+impl StackRegion {
+    /// Derive the region from the stack memory a walk was handed.
+    ///
+    /// Returns `None` for memory that reports no usable range, which is the same
+    /// condition that stops the walker from unwinding past the context frame.
+    pub fn from_memory(stack_memory: UnifiedMemory<'_, '_>) -> Option<StackRegion> {
+        let range = stack_memory.memory_range()?;
+        let end = range.end.checked_add(1)?;
+        if end <= range.start {
+            return None;
+        }
+        Some(StackRegion {
+            base: range.start,
+            end,
+        })
+    }
+
+    /// Build a region from an inclusive-low, exclusive-high address pair.
+    pub fn new(base: u64, end: u64) -> StackRegion {
+        StackRegion { base, end }
+    }
+
+    /// Whether an address belongs to the region.
+    pub fn contains(&self, address: u64) -> bool {
+        address >= self.base && address < self.end
+    }
+}
+
+/// Why a stack walk stopped producing frames.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum WalkTermination {
+    /// An unwinder declined to produce a caller, which is the ordinary way a walk ends.
+    Exhausted,
+    /// The walk ran off the thread's stack and was cut short.
+    LeftStackRegion,
+    /// The thread had no usable stack memory, so nothing past the context frame was reachable.
+    NoStackMemory,
+    /// The walk produced as many frames as it is willing to record.
+    FrameLimit,
+    /// Unwind information declared that the last frame has no caller.
+    EndOfStack,
+}
+
+impl WalkTermination {
+    /// A stable token identifying the termination, for machine-readable output.
+    pub fn as_str(&self) -> &'static str {
+        match *self {
+            WalkTermination::Exhausted => "exhausted",
+            WalkTermination::LeftStackRegion => "left_stack_region",
+            WalkTermination::NoStackMemory => "no_stack_memory",
+            WalkTermination::FrameLimit => "frame_limit",
+            WalkTermination::EndOfStack => "end_of_stack",
+        }
+    }
+
+    /// A human-readable explanation of the termination.
+    pub fn description(&self) -> &'static str {
+        match *self {
+            WalkTermination::Exhausted => "no more callers could be recovered",
+            WalkTermination::LeftStackRegion => "the walk left the thread's stack",
+            WalkTermination::NoStackMemory => "the thread had no usable stack memory",
+            WalkTermination::FrameLimit => "the walk reached its frame limit",
+            WalkTermination::EndOfStack => "the module declared the call chain ends here",
+        }
+    }
+
+    /// Whether the walk was cut short rather than ending on its own terms.
+    pub fn is_truncated(&self) -> bool {
+        matches!(
+            *self,
+            WalkTermination::LeftStackRegion | WalkTermination::FrameLimit
+        )
+    }
+}
+
+impl Default for WalkTermination {
+    fn default() -> Self {
+        WalkTermination::Exhausted
+    }
+}
+/// Why a frame was recorded at a weaker trust than its unwinder claimed.
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum DegradeReason {
+    /// The frame's stack pointer was not inside the thread's stack region.
+    OutsideStackRegion,
+}
+
+impl DegradeReason {
+    /// A stable token identifying the reason, for machine-readable output.
+    pub fn as_str(&self) -> &'static str {
+        match *self {
+            DegradeReason::OutsideStackRegion => "outside_stack_region",
+        }
+    }
+}
+
+/// The weakest trust a recovered frame can be recorded at.
+///
+/// A degraded frame is worth no more than one that was found by scanning, because
+/// whatever the unwinder believed about it did not survive the containment rules.
+pub(crate) const DEGRADED_TRUST: FrameTrust = FrameTrust::Scan;
+
+/// Reduce a frame's trust, keeping a record of what its unwinder originally claimed.
+///
+/// Frames that already sit at or below the degraded trust keep their trust value but
+/// are still marked, so that consecutive degradations can be counted.
+pub(crate) fn degrade_frame(frame: &mut StackFrame, reason: DegradeReason) {
+    if !frame.trust_degraded {
+        frame.claimed_trust = frame.trust;
+    }
+    frame.trust_degraded = true;
+    frame.degrade_reason = Some(reason);
+    if trust_rank(frame.trust) > trust_rank(DEGRADED_TRUST) {
+        frame.trust = DEGRADED_TRUST;
+    }
+}
+
+/// Order the trust levels from weakest to strongest.
+///
+/// [`FrameTrust`][] carries no ordering of its own, so the walk needs one to tell
+/// whether a degradation would actually weaken a frame.
+fn trust_rank(trust: FrameTrust) -> u8 {
+    match trust {
+        FrameTrust::None => 0,
+        FrameTrust::Scan => 1,
+        FrameTrust::CfiScan => 2,
+        FrameTrust::FramePointer => 3,
+        FrameTrust::CallFrameInfo => 4,
+        FrameTrust::PreWalked => 5,
+        FrameTrust::Context => 6,
+    }
+}
+
+/// Whether a frame was recovered by guesswork and could be corroborated.
+///
+/// Only a scan is guesswork. The other strategies work from register state or unwind
+/// tables, so there is nothing about them left to corroborate.
+pub(crate) fn can_be_corroborated(frame: &StackFrame) -> bool {
+    frame.trust == FrameTrust::Scan && !frame.trust_degraded
+}
+
+/// Asks the unwind machinery whether it has anything to say about an address.
+///
+/// The walker reports the range its rules cover before it tries to apply them, so a
+/// probe that supplies no register values learns whether rules exist without needing
+/// them to succeed. That is the right question here, because the address came from a
+/// guess and there is no frame to unwind from yet.
+#[derive(Debug)]
+pub(crate) struct UnwindInfoProbe {
+    instruction: u64,
+    covered: bool,
+}
+
+impl UnwindInfoProbe {
+    pub(crate) fn new(instruction: u64) -> UnwindInfoProbe {
+        UnwindInfoProbe {
+            instruction,
+            covered: false,
+        }
+    }
+
+    pub(crate) fn covered(&self) -> bool {
+        self.covered
+    }
+}
+
+impl FrameWalker for UnwindInfoProbe {
+    fn get_instruction(&self) -> u64 {
+        self.instruction
+    }
+    fn has_grand_callee(&self) -> bool {
+        false
+    }
+    fn get_grand_callee_parameter_size(&self) -> u32 {
+        0
+    }
+    fn get_register_at_address(&self, _address: u64) -> Option<u64> {
+        None
+    }
+    fn get_callee_register(&self, _name: &str) -> Option<u64> {
+        None
+    }
+    fn set_caller_register(&mut self, _name: &str, _val: u64) -> Option<()> {
+        None
+    }
+    fn clear_caller_register(&mut self, _name: &str) {}
+    fn set_cfa(&mut self, _val: u64) -> Option<()> {
+        None
+    }
+    fn set_ra(&mut self, _val: u64) -> Option<()> {
+        None
+    }
+    fn set_cfi_rules_start_address(&mut self, addr: Option<u64>) {
+        // The walker clears this again once it is done, so the probe has to latch
+        // the fact that rules were reported rather than read the final value.
+        self.covered |= addr.is_some();
+    }
+    fn set_end_of_stack(&mut self) {
+        // A declaration that the range has no caller is published unwind information
+        // too, so an address landing on one is just as corroborated as an address
+        // landing on a rule.
+        self.covered = true;
+    }
+}
+
+/// Raise a scanned frame's trust because unwind information covers where it landed.
+///
+/// The frame was still found by guesswork, so this does not make it as good as one
+/// the unwind tables produced. It records that the guess landed somewhere the module
+/// describes, which is more than a bare scan can say.
+pub(crate) fn promote_frame(frame: &mut StackFrame) {
+    frame.trust = FrameTrust::CfiScan;
+    frame.claimed_trust = FrameTrust::CfiScan;
+}
+
+/// Tracks whether the walk has already recorded a frame off the thread's stack.
+///
+/// One frame off the stack is recoverable, because the unwinder may find its way back.
+/// A second one means the walk is no longer following the thread's stack at all, whether
+/// or not the two are adjacent, so an intervening contained frame does not clear this.
+#[derive(Debug, Default)]
+pub(crate) struct DegradeRun {
+    already_degraded: bool,
+}
+
+impl DegradeRun {
+    pub(crate) fn new() -> DegradeRun {
+        DegradeRun {
+            already_degraded: false,
+        }
+    }
+
+    /// Record whether the newest frame was degraded.
+    ///
+    /// Returns the termination to record when this frame is the second degraded one of
+    /// the walk, in which case the frame must not become part of the result.
+    pub(crate) fn observe(&mut self, degraded: bool) -> Option<WalkTermination> {
+        if !degraded {
+            return None;
+        }
+        if self.already_degraded {
+            return Some(WalkTermination::LeftStackRegion);
+        }
+        self.already_degraded = true;
