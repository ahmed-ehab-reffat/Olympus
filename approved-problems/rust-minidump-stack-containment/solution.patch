+/// Whether unwind information covers where a frame landed.
+async fn frame_has_unwind_info<P>(
+    frame: &StackFrame,
+    modules: &MinidumpModuleList,
+    symbol_provider: &P,
+) -> bool
+where
+    P: SymbolProvider + Sync,
+{
+    let Some(module) = modules.module_at_address(frame.instruction) else {
+        return false;
+    };
+    let mut probe = UnwindInfoProbe::new(frame.instruction);
+    let _ = symbol_provider.walk_frame(module, &mut probe).await;
+    probe.covered()
+}
