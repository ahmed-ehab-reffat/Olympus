+/// Decide whether a freshly produced frame belongs to the thread's stack.
+///
+/// The frame is only inspected once it has been produced and returned by an
+/// architecture's unwinder, so nothing here can influence how that unwinder chose to
+/// recover it.
+pub(crate) fn containment_reason(
+    region: Option<StackRegion>,
+    frame: &StackFrame,
+) -> Option<DegradeReason> {
+    let region = region?;
+    let stack_pointer = frame.context.get_stack_pointer();
+    if region.contains(stack_pointer) {
+        None
+    } else {
+        Some(DegradeReason::OutsideStackRegion)
+    }
+}
