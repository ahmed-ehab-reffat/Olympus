 // Copied from minidump-common, because we've preconstructed the array to sort.
+/// Work out which parts of a CFI record's range declare that there is no caller.
+///
+/// A return address rule in a later row replaces the one an earlier row gave rather
+/// than joining it, so a declaration only covers the addresses up to the next row that
+/// says something about the return address. A single row that both declares no caller
+/// and computes one is contradicting itself, and the whole record is dropped as corrupt
+/// rather than guessed at, which is reported here as `None`.
+fn end_of_stack_ranges(info: &StackInfoCfi, range: Range<u64>) -> Option<Vec<Range<u64>>> {
+    let mut declared = Vec::new();
+    let mut current = row_return_address(&info.init.rules)?;
+    let mut start = range.start;
+    for row in &info.add_rules {
+        let next = row_return_address(&row.rules)?;
+        if next.is_none() {
+            continue;
+        }
+        if row.address <= start || row.address > range.end {
+            current = next;
+            continue;
+        }
+        if current.as_deref() == Some(crate::sym_file::walker::UNDEFINED_RETURN_ADDRESS) {
+            declared.push(Range::new(start, row.address - 1));
+        }
+        start = row.address;
+        current = next;
+    }
+    if current.as_deref() == Some(crate::sym_file::walker::UNDEFINED_RETURN_ADDRESS) {
+        declared.push(Range::new(start, range.end));
+    }
+    Some(declared)
+}
+
+/// The return address a single row leaves in effect, or `None` if it says nothing.
+///
+/// A row that both declares no caller and computes one cannot be honoured either way,
+/// and is reported as the error case.
+fn row_return_address(rules: &str) -> Option<Option<String>> {
+    let exprs = return_address_exprs(rules);
+    if exprs.is_empty() {
+        return Some(None);
+    }
+    let undefined = crate::sym_file::walker::UNDEFINED_RETURN_ADDRESS;
+    if exprs.iter().any(|expr| expr == undefined) && exprs.iter().any(|expr| expr != undefined) {
+        return None;
+    }
+    Some(exprs.into_iter().next_back())
+}
+
+/// Pull out every expression a rules string assigns to the return address.
+///
+/// A row may assign the same register more than once, and the evaluator honours the
+/// last assignment, so every occurrence has to be recovered rather than just the first.
+fn return_address_exprs(rules: &str) -> Vec<String> {
+    let mut found = Vec::new();
+    let mut current: Option<Vec<&str>> = None;
+    for token in rules.split_whitespace() {
+        if token == ".ra:" {
+            if let Some(expr) = current.replace(Vec::new()) {
+                found.push(expr.join(" "));
+            }
+        } else if token.ends_with(':') {
+            if let Some(expr) = current.take() {
+                found.push(expr.join(" "));
+            }
+        } else if let Some(expr) = current.as_mut() {
+            expr.push(token);
+        }
+    }
+    if let Some(expr) = current.take() {
+        found.push(expr.join(" "));
+    }
+    found.retain(|expr| !expr.is_empty());
+    found
+}
