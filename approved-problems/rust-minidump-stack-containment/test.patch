@@ -0,0 +1,1101 @@
+use minidump::format::{CONTEXT_AMD64, CONTEXT_ARM64, CONTEXT_X86};
+use minidump::system_info::{Cpu, Os};
+use minidump::*;
+use minidump_unwind::*;
+use std::collections::HashMap;
+use test_assembler::*;
+
+struct Fixture {
+    raw: CONTEXT_X86,
+    modules: MinidumpModuleList,
+    symbols: HashMap<String, String>,
+}
+
+impl Fixture {
+    fn new() -> Fixture {
+        Fixture {
+            raw: CONTEXT_X86::default(),
+            modules: MinidumpModuleList::from_modules(vec![
+                MinidumpModule::new(0x40000000, 0x10000, "module1"),
+                MinidumpModule::new(0x50000000, 0x10000, "module2"),
+            ]),
+            symbols: HashMap::new(),
+        }
+    }
+
+    fn add_symbols(&mut self, name: &str, symbols: &str) {
+        self.symbols.insert(name.to_string(), symbols.to_string());
+    }
+
+    async fn walk(&self, stack: Section) -> CallStack {
+        let context = MinidumpContext {
+            raw: MinidumpRawContext::X86(self.raw.clone()),
+            valid: MinidumpContextValidity::All,
+        };
+        let base = stack.start().value().unwrap();
+        let size = stack.size();
+        let bytes = stack.get_contents().unwrap();
+        let stack_memory = MinidumpMemory {
+            desc: Default::default(),
+            base_address: base,
+            size,
+            bytes: &bytes,
+            endian: scroll::LE,
+        };
+        let system_info = SystemInfo {
+            os: Os::Windows,
+            os_version: None,
+            os_build: None,
+            cpu: Cpu::X86,
+            cpu_info: None,
+            cpu_microcode_version: None,
+            cpu_count: 1,
+        };
+        let symbolizer = Symbolizer::new(string_symbol_supplier(self.symbols.clone()));
+        let mut stack = CallStack::with_context(context);
+        walk_stack(
+            0,
+            (),
+            &mut stack,
+            Some(UnifiedMemory::Memory(&stack_memory)),
+            &self.modules,
+            &system_info,
+            &symbolizer,
+        )
+        .await;
+        stack
+    }
+
+    async fn walk_without_memory(&self) -> CallStack {
+        let context = MinidumpContext {
+            raw: MinidumpRawContext::X86(self.raw.clone()),
+            valid: MinidumpContextValidity::All,
+        };
+        let system_info = SystemInfo {
+            os: Os::Windows,
+            os_version: None,
+            os_build: None,
+            cpu: Cpu::X86,
+            cpu_info: None,
+            cpu_microcode_version: None,
+            cpu_count: 1,
+        };
+        let symbolizer = Symbolizer::new(string_symbol_supplier(self.symbols.clone()));
+        let mut stack = CallStack::with_context(context);
+        walk_stack(
+            0,
+            (),
+            &mut stack,
+            None,
+            &self.modules,
+            &system_info,
+            &symbolizer,
+        )
+        .await;
+        stack
+    }
+}
+
+const STACK_BASE: u64 = 0x80000000;
+
+fn contained_walk() -> (Fixture, Section) {
+    let mut f = Fixture::new();
+    let frame0_ebp = Label::new();
+    let frame1_ebp = Label::new();
+    let mut stack = Section::new();
+    stack.start().set_const(STACK_BASE);
+    stack = stack
+        .append_repeated(12, 0)
+        .mark(&frame0_ebp)
+        .D32(&frame1_ebp)
+        .D32(0x40008679)
+        .append_repeated(8, 0)
+        .mark(&frame1_ebp)
+        .D32(0)
+        .D32(0);
+    f.raw.eip = 0x4000c7a5;
+    f.raw.esp = STACK_BASE as u32;
+    f.raw.ebp = frame0_ebp.value().unwrap() as u32;
+    (f, stack)
+}
+
+fn escaping_walk() -> (Fixture, Section) {
+    let mut f = Fixture::new();
+    let frame0_ebp = Label::new();
+    let mut stack = Section::new();
+    stack.start().set_const(STACK_BASE);
+    stack = stack
+        .append_repeated(12, 0)
+        .mark(&frame0_ebp)
+        .D32(0)
+        .D32(0x40008679);
+    f.raw.eip = 0x4000c7a5;
+    f.raw.esp = STACK_BASE as u32;
+    f.raw.ebp = frame0_ebp.value().unwrap() as u32;
+    (f, stack)
+}
+
+fn frame_instructions(stack: &CallStack) -> Vec<u64> {
+    stack.frames.iter().map(|frame| frame.instruction).collect()
+}
+
+#[test]
+fn region_treats_low_address_as_inside_and_high_address_as_outside() {
+    let region = StackRegion::new(0x1000, 0x2000);
+    assert!(region.contains(0x1000));
+    assert!(region.contains(0x1fff));
+    assert!(!region.contains(0x2000));
+    assert!(!region.contains(0x0fff));
+}
+
+#[test]
+fn empty_region_contains_nothing() {
+    let region = StackRegion::new(0x1000, 0x1000);
+    assert!(!region.contains(0x1000));
+    assert!(!region.contains(0x0fff));
+}
+
+#[test]
+fn termination_tokens_are_stable() {
+    assert_eq!(WalkTermination::Exhausted.as_str(), "exhausted");
+    assert_eq!(
+        WalkTermination::LeftStackRegion.as_str(),
+        "left_stack_region"
+    );
+    assert_eq!(WalkTermination::NoStackMemory.as_str(), "no_stack_memory");
+    assert_eq!(WalkTermination::FrameLimit.as_str(), "frame_limit");
+}
+
+#[test]
+fn only_cut_short_terminations_count_as_truncated() {
+    assert!(!WalkTermination::Exhausted.is_truncated());
+    assert!(!WalkTermination::NoStackMemory.is_truncated());
+    assert!(WalkTermination::LeftStackRegion.is_truncated());
+    assert!(WalkTermination::FrameLimit.is_truncated());
+}
+
+#[test]
+fn degrade_reason_tokens_are_stable() {
+    assert_eq!(
+        DegradeReason::OutsideStackRegion.as_str(),
+        "outside_stack_region"
+    );
+}
+
+#[tokio::test]
+async fn contained_walk_degrades_nothing_and_exhausts() {
+    let (f, stack) = contained_walk();
+    let s = f.walk(stack).await;
+
+    assert_eq!(frame_instructions(&s), vec![0x4000c7a5, 0x40008678]);
+    assert_eq!(s.termination, WalkTermination::Exhausted);
+    assert_eq!(s.info, CallStackInfo::Ok);
+    assert_eq!(s.degraded_frame_count(), 0);
+    assert_eq!(s.trusted_prefix_len(), 2);
+    assert!(!s.is_truncated());
+    for frame in &s.frames {
+        assert!(!frame.trust_degraded);
+        assert_eq!(frame.degrade_reason, None);
+        assert_eq!(frame.claimed_trust, frame.trust);
+    }
+}
+
+#[tokio::test]
+async fn frame_leaving_the_region_keeps_its_place_at_reduced_trust() {
+    let (f, stack) = escaping_walk();
+    let s = f.walk(stack).await;
+
+    assert_eq!(frame_instructions(&s), vec![0x4000c7a5, 0x40008678]);
+    let escaped = &s.frames[1];
+    assert!(escaped.trust_degraded);
+    assert_eq!(escaped.trust, FrameTrust::Scan);
+    assert_eq!(escaped.claimed_trust, FrameTrust::FramePointer);
+    assert_eq!(
+        escaped.degrade_reason,
+        Some(DegradeReason::OutsideStackRegion)
+    );
+}
+
+#[tokio::test]
+async fn degradation_is_summarised_over_the_whole_walk() {
+    let (f, stack) = escaping_walk();
+    let s = f.walk(stack).await;
+
+    assert_eq!(s.degraded_frame_count(), 1);
+    assert_eq!(s.trusted_prefix_len(), 1);
+    assert!(!s.is_truncated());
+    assert_eq!(s.info, CallStackInfo::Ok);
+    let counts = s.degrade_reason_counts();
+    assert_eq!(counts.get("outside_stack_region"), Some(&1));
+}
+
+#[tokio::test]
+async fn a_thread_without_stack_memory_is_not_a_containment_failure() {
+    let mut f = Fixture::new();
+    f.raw.eip = 0x4000c7a5;
+    f.raw.esp = STACK_BASE as u32;
+    f.raw.ebp = STACK_BASE as u32;
+    let s = f.walk_without_memory().await;
+
+    assert_eq!(s.termination, WalkTermination::NoStackMemory);
+    assert_eq!(s.info, CallStackInfo::Ok);
+    assert_eq!(s.frames.len(), 1);
+    assert_eq!(s.degraded_frame_count(), 0);
+    assert!(!s.is_truncated());
+}
+
+#[tokio::test]
+async fn a_frame_inside_a_known_module_is_left_alone() {
+    let (f, stack) = contained_walk();
+    let s = f.walk(stack).await;
+    let inner = &s.frames[1];
+    assert!(!inner.trust_degraded);
+    assert_eq!(inner.trust, FrameTrust::FramePointer);
+    assert_eq!(inner.degrade_reason, None);
+}
+
+#[tokio::test]
+async fn walk_result_is_deterministic_across_repeated_walks() {
+    let (f, stack) = escaping_walk();
+    let first = f.walk(stack).await;
+    let (f, stack) = escaping_walk();
+    let second = f.walk(stack).await;
+
+    assert_eq!(frame_instructions(&first), frame_instructions(&second));
+    assert_eq!(first.termination, second.termination);
+    assert_eq!(first.degraded_frame_count(), second.degraded_frame_count());
+}
+
+const RETURN_ADDRESS_ON_STACK: u32 = 0x40008679;
+
+fn walk_with_cfi(ra_rule: &str) -> (Fixture, Section) {
+    let mut f = Fixture::new();
+    let symbols = format!(
+        "FUNC 4000 1000 10 outermost\nSTACK CFI INIT 4000 100 .cfa: $esp 4 + .ra: {ra_rule}\n"
+    );
+    f.add_symbols("module1", &symbols);
+
+    let frame0_ebp = Label::new();
+    let frame1_ebp = Label::new();
+    let mut stack = Section::new();
+    stack.start().set_const(STACK_BASE);
+    stack = stack
+        .append_repeated(12, 0)
+        .mark(&frame0_ebp)
+        .D32(&frame1_ebp)
+        .D32(RETURN_ADDRESS_ON_STACK)
+        .append_repeated(8, 0)
+        .mark(&frame1_ebp)
+        .D32(0)
+        .D32(0);
+    f.raw.eip = 0x40004010;
+    f.raw.esp = STACK_BASE as u32;
+    f.raw.ebp = frame0_ebp.value().unwrap() as u32;
+    (f, stack)
+}
+
+#[test]
+fn end_of_stack_token_is_stable() {
+    assert_eq!(WalkTermination::EndOfStack.as_str(), "end_of_stack");
+}
+
+#[test]
+fn a_declared_end_of_stack_is_not_a_truncation() {
+    assert!(!WalkTermination::EndOfStack.is_truncated());
+}
+
+#[tokio::test]
+async fn an_undefined_return_address_ends_the_walk() {
+    let (f, stack) = walk_with_cfi(".undef");
+    let s = f.walk(stack).await;
+
+    assert_eq!(frame_instructions(&s), vec![0x40004010]);
+    assert_eq!(s.termination, WalkTermination::EndOfStack);
+    assert!(!s.is_truncated());
+    assert_eq!(s.degraded_frame_count(), 0);
+}
+
+#[tokio::test]
+async fn a_declared_end_outranks_a_frame_a_later_strategy_would_produce() {
+    let (f, stack) = walk_with_cfi(".undef");
+    let ended = f.walk(stack).await;
+
+    let (f, stack) = walk_with_cfi(".cfa 4 - ^");
+    let continued = f.walk(stack).await;
+
+    assert_eq!(ended.frames.len(), 1);
+    assert!(continued.frames.len() > ended.frames.len());
+    assert_eq!(continued.termination, WalkTermination::Exhausted);
+}
+
+#[tokio::test]
+async fn a_frame_at_the_declared_end_is_inside_the_region_and_undegraded() {
+    let (f, stack) = walk_with_cfi(".undef");
+    let s = f.walk(stack).await;
+
+    let last = s.frames.last().unwrap();
+    assert!(!last.trust_degraded);
+    assert_eq!(last.degrade_reason, None);
+    assert_eq!(s.trusted_prefix_len(), s.frames.len());
+}
+
+fn walk_with_cfi_escaping(ra_rule: Option<&str>) -> (Fixture, Section) {
+    let mut f = Fixture::new();
+    if let Some(ra_rule) = ra_rule {
+        let symbols = format!(
+            "FUNC 4000 1000 10 outermost\nSTACK CFI INIT 4000 100 .cfa: $esp 4 + .ra: {ra_rule}\n"
+        );
+        f.add_symbols("module1", &symbols);
+    }
+
+    let frame0_ebp = Label::new();
+    let mut stack = Section::new();
+    stack.start().set_const(STACK_BASE);
+    stack = stack
+        .append_repeated(12, 0)
+        .mark(&frame0_ebp)
+        .D32(0)
+        .D32(RETURN_ADDRESS_ON_STACK);
+    f.raw.eip = 0x40004010;
+    f.raw.esp = STACK_BASE as u32;
+    f.raw.ebp = frame0_ebp.value().unwrap() as u32;
+    (f, stack)
+}
+
+#[tokio::test]
+async fn a_declared_end_outranks_a_frame_that_left_the_region() {
+    let (f, stack) = walk_with_cfi_escaping(Some(".undef"));
+    let ended = f.walk(stack).await;
+
+    let (f, stack) = walk_with_cfi_escaping(None);
+    let escaped = f.walk(stack).await;
+
+    assert_eq!(ended.termination, WalkTermination::EndOfStack);
+    assert_eq!(ended.info, CallStackInfo::Ok);
+    assert_eq!(ended.degraded_frame_count(), 0);
+
+    assert_ne!(escaped.termination, WalkTermination::EndOfStack);
+    assert_eq!(escaped.degraded_frame_count(), 1);
+}
+
+#[tokio::test]
+async fn a_declared_end_leaves_the_result_readable_at_face_value() {
+    let (f, stack) = walk_with_cfi_escaping(Some(".undef"));
+    let s = f.walk(stack).await;
+
+    assert_eq!(s.trusted_prefix_len(), s.frames.len());
+    assert!(s.degrade_reason_counts().is_empty());
+    assert!(!s.is_truncated());
+}
+
+#[tokio::test]
+async fn containment_still_applies_when_no_end_is_declared() {
+    let (f, stack) = walk_with_cfi_escaping(None);
+    let s = f.walk(stack).await;
+
+    let last = s.frames.last().unwrap();
+    assert!(last.trust_degraded);
+    assert_eq!(last.degrade_reason, Some(DegradeReason::OutsideStackRegion));
+    assert_eq!(s.trusted_prefix_len(), s.frames.len() - 1);
+}
+
+#[tokio::test]
+async fn a_second_reduced_frame_ends_the_walk() {
+    let mut f = Fixture::new();
+    f.add_symbols(
+        "module1",
+        "FUNC 4000 1000 10 register_unwound\n\
+         STACK CFI INIT 4000 1000 .cfa: $esp 8 + .ra: $edi\n",
+    );
+    let mut stack = Section::new();
+    stack.start().set_const(STACK_BASE);
+    stack = stack.D32(0).D32(0);
