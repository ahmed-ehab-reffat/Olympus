+#!/usr/bin/env bash
+set -uo pipefail
+
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+NEW_TARGET="stack_containment_d57b13"
+NEW_TEST_FILE="minidump-unwind/tests/${NEW_TARGET}.rs"
+NEW_PROC_TARGET="walk_output_d57b13"
+NEW_PROC_FILE="minidump-processor/tests/${NEW_PROC_TARGET}.rs"
+TEST_JSON="$(mktemp)"
+TEST_ERR="$(mktemp)"
+STATUS=0
+
+run_target() {
+  # shellcheck disable=SC2086
+  cargo test $1 --offline --locked -- -Z unstable-options --format json --report-time \
+    >> "$TEST_JSON" 2>> "$TEST_ERR" || STATUS=1
+}
+
+if [ "$MODE" = "base" ]; then
+  run_target "--workspace --lib --bins"
+  run_target "-p minidump --test test_minidump"
+  run_target "-p minidump-processor --test test_processor"
+  run_target "-p minidump-stackwalk --test test-minidump-stackwalk"
+else
+  run_target "-p minidump-unwind --test $NEW_TARGET"
+  run_target "-p minidump-processor --test $NEW_PROC_TARGET"
+fi
+
+cat "$TEST_ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2>/dev/null || true
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    # The suite did not build. Report every test in the target as failed, by name,
+    # so the result set matches the one a successful run produces.
+    sanitized=$( { cat "$TEST_ERR"; cat "$TEST_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g' )
+    names=$(cat "$NEW_TEST_FILE" "$NEW_PROC_FILE" 2>/dev/null \
+      | grep -A 1 -E '^#\[(tokio::)?test\]' \
+      | grep -oE '^(async )?fn [a-z0-9_]+' \
+      | sed -e 's/^async fn //' -e 's/^fn //')
+    [ -z "$names" ] && names="compilation"
+    count=$(printf '%s\n' "$names" | wc -l)
+    {
+      # Mirror cargo2junit's shape exactly (empty classname, same suite naming) so the
+      # test identities match the ones a successful run reports.
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n  <testsuite id="0" name="cargo test #0" package="testsuite/cargo test #0" tests="%s" errors="0" failures="%s">\n' "$count" "$count"
+      printf '%s\n' "$names" | while read -r n; do
+        [ -z "$n" ] && continue
+        printf '    <testcase name="%s" classname=""><failure message="build failed"><![CDATA[%s]]></failure></testcase>\n' "$n" "$sanitized"
+      done
+      printf '  </testsuite>\n</testsuites>\n'
+    } > "$OUTPUT_PATH"
+  fi
+fi
+
+rm -f "$TEST_JSON" "$TEST_ERR"
+exit $STATUS
