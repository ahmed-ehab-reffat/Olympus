@@ -0,0 +1,197 @@
+use minidump::Minidump;
+use minidump_processor::ProcessState;
+use minidump_synth::{Memory, SynthMinidump, SystemInfo, Thread};
+use minidump_unwind::{
+    simple_symbol_supplier, CallStackInfo, DegradeReason, FrameTrust, Symbolizer, WalkTermination,
+};
+use serde_json::Value;
+use test_assembler::{Endian, Section};
+
+async fn plain_state() -> ProcessState {
+    let context = minidump_synth::x86_context(Endian::Little, 0xabcd1234, 0x1010);
+    let stack = Memory::with_section(
+        Section::with_endian(Endian::Little).append_repeated(0, 0x1000),
+        0x1000,
+    );
+    let thread = Thread::new(Endian::Little, 0x1234, &stack, &context);
+    let dump = SynthMinidump::with_endian(Endian::Little)
+        .add_thread(thread)
+        .add_system_info(SystemInfo::new(Endian::Little))
+        .add(context)
+        .add_memory(stack);
+
+    let dump = Minidump::read(dump.finish().unwrap()).unwrap();
+    let state = minidump_processor::process_minidump(
+        &dump,
+        &Symbolizer::new(simple_symbol_supplier(vec![])),
+    )
+    .await
+    .unwrap();
+
+    state
+}
+
+fn to_json(state: &ProcessState) -> Value {
+    let mut out = Vec::new();
+    state.print_json(&mut out, false).unwrap();
+    serde_json::from_slice(&out).unwrap()
+}
+
+#[tokio::test]
+async fn a_plain_walk_carries_no_termination_or_reduction_in_the_processed_output() {
+    let state = plain_state().await;
+    assert_eq!(state.threads[0].termination, WalkTermination::Exhausted);
+    let json = to_json(&state);
+    let thread = &json["threads"][0];
+
+    assert!(thread.get("termination").is_none());
+    assert!(thread.get("degraded_frame_count").is_none());
+    assert!(thread.get("trusted_prefix_len").is_none());
+    assert!(thread.get("degrade_reasons").is_none());
+
+    for frame in thread["frames"].as_array().unwrap() {
+        assert!(frame.get("trust_degraded").is_none());
+        assert!(frame.get("claimed_trust").is_none());
+        assert!(frame.get("degrade_reason").is_none());
+        assert!(frame.get("trust").is_some());
+    }
+}
+
+#[tokio::test]
+async fn a_thread_without_usable_stack_memory_reports_its_termination_in_the_processed_output() {
+    let context = minidump_synth::x86_context(Endian::Little, 0xabcd1234, 0x1010);
+    let stack = Memory::with_section(Section::with_endian(Endian::Little), 0x1000);
+    let thread = Thread::new(Endian::Little, 0x1234, &stack, &context);
+    let dump = SynthMinidump::with_endian(Endian::Little)
+        .add_thread(thread)
+        .add_system_info(SystemInfo::new(Endian::Little))
+        .add(context)
+        .add_memory(stack);
+
+    let dump = Minidump::read(dump.finish().unwrap()).unwrap();
+    let state = minidump_processor::process_minidump(
+        &dump,
+        &Symbolizer::new(simple_symbol_supplier(vec![])),
+    )
+    .await
+    .unwrap();
+
+    assert_eq!(state.threads[0].termination, WalkTermination::NoStackMemory);
+
+    let mut out = Vec::new();
+    state.print_json(&mut out, false).unwrap();
+    let json: Value = serde_json::from_slice(&out).unwrap();
+
+    assert_eq!(
+        json["threads"][0]["termination"],
+        Value::from(WalkTermination::NoStackMemory.as_str())
+    );
+}
+
+#[tokio::test]
+async fn a_reduced_walk_carries_its_degradation_in_the_processed_output() {
+    let mut state = plain_state().await;
+    let thread = &mut state.threads[0];
+    thread.termination = WalkTermination::LeftStackRegion;
+    thread.info = CallStackInfo::WalkTruncated;
+    let frame = &mut thread.frames[0];
+    frame.claimed_trust = FrameTrust::FramePointer;
+    frame.trust = FrameTrust::Scan;
+    frame.trust_degraded = true;
+    frame.degrade_reason = Some(DegradeReason::OutsideStackRegion);
+
+    let json = to_json(&state);
+    let thread = &json["threads"][0];
+
+    assert_eq!(
+        thread["termination"],
+        Value::from(WalkTermination::LeftStackRegion.as_str())
+    );
+    assert_eq!(thread["degraded_frame_count"], Value::from(1));
+    assert_eq!(thread["trusted_prefix_len"], Value::from(0));
+    assert_eq!(
+        thread["degrade_reasons"][DegradeReason::OutsideStackRegion.as_str()],
+        Value::from(1)
+    );
+
+    let frame = &thread["frames"][0];
+    assert_eq!(frame["trust_degraded"], Value::from(true));
+    assert_eq!(frame["trust"], Value::from(FrameTrust::Scan.as_str()));
+    assert_eq!(
+        frame["claimed_trust"],
+        Value::from(FrameTrust::FramePointer.as_str())
+    );
+    assert_eq!(
+        frame["degrade_reason"],
+        Value::from(DegradeReason::OutsideStackRegion.as_str())
+    );
+}
+
+#[tokio::test]
+async fn every_cut_short_or_declared_ending_reaches_the_processed_output() {
+    for termination in [
+        WalkTermination::EndOfStack,
+        WalkTermination::LeftStackRegion,
+        WalkTermination::FrameLimit,
+    ] {
+        let mut state = plain_state().await;
+        state.threads[0].termination = termination;
+        let json = to_json(&state);
+        assert_eq!(
+            json["threads"][0]["termination"],
+            Value::from(termination.as_str())
+        );
+        assert!(json["threads"][0].get("degraded_frame_count").is_none());
+    }
+}
+
+#[tokio::test]
+async fn a_reduced_walk_that_ended_plainly_reports_its_reduction_but_no_termination() {
+    let mut state = plain_state().await;
+    let thread = &mut state.threads[0];
+    thread.termination = WalkTermination::Exhausted;
+    let frame = &mut thread.frames[0];
+    frame.claimed_trust = FrameTrust::FramePointer;
+    frame.trust = FrameTrust::Scan;
+    frame.trust_degraded = true;
+    frame.degrade_reason = Some(DegradeReason::OutsideStackRegion);
+
+    assert_eq!(thread.info, CallStackInfo::Ok);
+    assert!(!thread.is_truncated());
+
+    let json = to_json(&state);
+    let thread = &json["threads"][0];
+
+    assert!(thread.get("termination").is_none());
+    assert_eq!(thread["degraded_frame_count"], Value::from(1));
+    assert_eq!(thread["trusted_prefix_len"], Value::from(0));
+    assert_eq!(
+        thread["frames"][0]["degrade_reason"],
+        Value::from(DegradeReason::OutsideStackRegion.as_str())
+    );
+}
+
+#[tokio::test]
+async fn the_processed_output_counts_the_trusted_frames_before_the_reduced_one() {
+    let mut state = plain_state().await;
+    let thread = &mut state.threads[0];
+    let trusted = thread.frames[0].clone();
+    thread.frames.insert(0, trusted);
+    thread.termination = WalkTermination::LeftStackRegion;
+    thread.info = CallStackInfo::WalkTruncated;
+    let frame = &mut thread.frames[1];
+    frame.claimed_trust = FrameTrust::FramePointer;
+    frame.trust = FrameTrust::Scan;
+    frame.trust_degraded = true;
+    frame.degrade_reason = Some(DegradeReason::OutsideStackRegion);
+
+    assert_eq!(thread.trusted_prefix_len(), 1);
+
+    let json = to_json(&state);
+    let thread = &json["threads"][0];
+
+    assert_eq!(thread["degraded_frame_count"], Value::from(1));
+    assert_eq!(thread["trusted_prefix_len"], Value::from(1));
+    assert!(thread["frames"][0].get("trust_degraded").is_none());
+    assert_eq!(thread["frames"][1]["trust_degraded"], Value::from(true));
+}
diff --git a/minidump-unwind/tests/stack_containment_d57b13.rs b/minidump-unwind/tests/stack_containment_d57b13.rs
