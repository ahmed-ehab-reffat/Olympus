+"""Tests for block and inode accounting of fake filesystem mount points."""
+
+import errno
+import os
+import pathlib
+import shutil
+import sys
+import tempfile
+import unittest
+
+from pyfakefs import (
+    fake_filesystem,
+    fake_filesystem_shutil,
+    fake_filesystem_unittest,
+    fake_open,
+    fake_os,
+)
+from pyfakefs.fake_filesystem import OSType
+from pyfakefs.helpers import reset_ids, set_uid
+from pyfakefs.tests.test_utils import TestCase
+
+if sys.platform != "win32":
+    from os import statvfs
+
+BLOCK = 4096
+
+
+@unittest.skipIf(sys.platform == "win32", "statvfs is only available on Posix")
+class DiskAccountingTest(TestCase):
+    def setUp(self):
+        self.fs = fake_filesystem.FakeFilesystem()
+        self.os = fake_os.FakeOsModule(self.fs)
+        self.open = fake_open.FakeFileOpen(self.fs)
+        self.shutil = fake_filesystem_shutil.FakeShutilModule(self.fs)
+        self.addCleanup(reset_ids)
+
+    def configure(
+        self,
+        total_size,
+        block_size=BLOCK,
+        inode_count=None,
+        reserved_blocks=None,
+        reserved_inodes=None,
+    ):
+        self.fs.set_disk_usage(
+            total_size,
+            block_size=block_size,
+            inode_count=inode_count,
+            reserved_blocks=reserved_blocks,
+            reserved_inodes=reserved_inodes,
+        )
+
+    def write(self, path, size, mode="w"):
+        with self.open(path, mode, encoding="utf8") as f:
+            f.write("a" * size)
+
+    def used(self):
+        return self.fs.get_disk_usage().used
+
+    def free_inodes(self, path="/"):
+        return self.os.statvfs(path).f_ffree
+
+    def test_default_block_size_keeps_byte_exact_accounting(self):
+        self.fs.set_disk_usage(1000)
+        self.fs.create_file("/foo/bar", contents=b"xyzzy")
+        self.assertEqual((1000, 5, 995), self.fs.get_disk_usage())
+        self.assertEqual(1, self.os.statvfs("/").f_bsize)
+
+    def test_a_file_of_one_byte_takes_one_block(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a")
+        self.assertEqual(BLOCK, self.used())
+
+    def test_a_file_of_exactly_one_block_takes_one_block(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * BLOCK)
+        self.assertEqual(BLOCK, self.used())
+
+    def test_a_file_one_byte_over_a_block_takes_two_blocks(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 1))
+        self.assertEqual(2 * BLOCK, self.used())
+
+    def test_an_empty_file_takes_no_blocks_but_one_inode(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"")
+        self.assertEqual(0, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_repeated_sub_block_appends_stay_in_one_block(self):
+        self.configure(20 * BLOCK)
+        self.write("/foo", 1000)
+        for _ in range(3):
+            self.write("/foo", 1000, mode="a")
+        self.assertEqual(4000, self.os.stat("/foo").st_size)
+        self.assertEqual(BLOCK, self.used())
+
+    def test_growing_past_a_block_boundary_takes_the_next_block(self):
+        self.configure(20 * BLOCK)
+        self.write("/foo", BLOCK)
+        self.assertEqual(BLOCK, self.used())
+        self.write("/foo", 1, mode="a")
+        self.assertEqual(2 * BLOCK, self.used())
+
+    def test_truncating_down_gives_blocks_back(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * (2 * BLOCK + 10))
+        self.assertEqual(3 * BLOCK, self.used())
+        self.os.truncate("/foo", BLOCK - 1)
+        self.assertEqual(BLOCK, self.used())
+
+    def test_truncating_to_nothing_gives_every_block_back(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * 10)
+        self.os.truncate("/foo", 0)
+        self.assertEqual(0, self.used())
+
+    def test_shrinking_within_a_block_keeps_it(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 500))
+        self.assertEqual(2 * BLOCK, self.used())
+        self.os.truncate("/foo", BLOCK + 100)
+        self.assertEqual(2 * BLOCK, self.used())
+
+    def test_growing_within_an_allocated_block_is_free(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 100))
+        self.os.truncate("/foo", BLOCK + 500)
+        self.assertEqual(2 * BLOCK, self.used())
+
+    def test_truncating_up_takes_more_blocks(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * 10)
+        self.os.truncate("/foo", 2 * BLOCK + 1)
+        self.assertEqual(3 * BLOCK, self.used())
+
+    def test_a_declared_file_size_is_rounded_up(self):
+        self.configure(20 * BLOCK)
+        self.fs.create_file("/foo", st_size=BLOCK + 1)
+        self.assertEqual(2 * BLOCK, self.used())
+
+    def test_capacity_is_rounded_down_to_whole_blocks(self):
+        self.configure(3 * BLOCK - 1)
+        usage = self.fs.get_disk_usage()
+        self.assertEqual(2 * BLOCK, usage.total)
+        self.assertEqual(2 * BLOCK, usage.free)
+        self.assertEqual(2, self.os.statvfs("/").f_blocks)
+
+    def test_a_directory_takes_an_inode_and_no_blocks(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.mkdir("/dir")
+        self.assertEqual(0, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_every_created_directory_takes_an_inode(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.makedirs("/a/b/c")
+        self.assertEqual(7, self.free_inodes())
+
+    def test_removing_a_directory_gives_its_inode_back(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.mkdir("/dir")
+        self.os.rmdir("/dir")
+        self.assertEqual(10, self.free_inodes())
+
+    def test_repeated_directory_cycles_do_not_leak_inodes(self):
+        self.configure(20 * BLOCK, inode_count=3)
+        for _ in range(8):
+            self.os.mkdir("/dir")
+            self.os.rmdir("/dir")
+        self.assertEqual(3, self.free_inodes())
+
+    def test_removing_a_tree_gives_every_inode_back(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.makedirs("/a/b")
+        self.fs.create_file("/a/b/foo", contents=b"a")
+        self.fs.remove_object("/a")
+        self.assertEqual(10, self.free_inodes())
+        self.assertEqual(0, self.used())
+
+    def test_a_symlink_takes_an_inode_and_a_block_for_its_own_path(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        self.os.symlink("/foo", "/link")
+        self.assertEqual(2 * BLOCK, self.used())
+        self.assertEqual(8, self.free_inodes())
+
+    def test_a_symlink_is_not_charged_for_the_size_of_its_target(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * (3 * BLOCK))
+        self.assertEqual(3 * BLOCK, self.used())
+        self.os.symlink("/foo", "/link")
+        self.assertEqual(4 * BLOCK, self.used())
+
+    def test_a_symlink_holding_a_long_path_takes_more_blocks(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        target = "/" + "/".join(["dir"] * 1100)
+        self.os.symlink(target, "/link")
+        self.assertEqual(2 * BLOCK, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_a_hard_link_takes_no_inode_and_no_blocks(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        self.os.link("/foo", "/other")
+        self.assertEqual(BLOCK, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_removing_one_of_two_names_keeps_the_inode(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        self.os.link("/foo", "/other")
+        self.os.unlink("/other")
+        self.assertEqual(BLOCK, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_removing_the_last_name_gives_the_inode_back(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        self.os.link("/foo", "/other")
+        self.os.unlink("/other")
+        self.os.unlink("/foo")
+        self.assertEqual(0, self.used())
+        self.assertEqual(10, self.free_inodes())
+
+    def test_renaming_a_file_leaves_both_counts_alone(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * 10)
+        for index in range(5):
+            self.os.rename("/foo", f"/bar{index}")
+            self.os.rename(f"/bar{index}", "/foo")
+        self.assertEqual(BLOCK, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_renaming_a_directory_leaves_both_counts_alone(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.mkdir("/dir")
+        self.fs.create_file("/dir/foo", contents=b"a" * 10)
+        for index in range(5):
+            self.os.rename("/dir", f"/moved{index}")
+            self.os.rename(f"/moved{index}", "/dir")
+        self.assertEqual(BLOCK, self.used())
+        self.assertEqual(8, self.free_inodes())
+
+    def test_renaming_over_an_existing_file_gives_its_inode_back(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * 10)
+        self.fs.create_file("/bar", contents=b"a" * 10)
+        self.os.rename("/foo", "/bar")
+        self.assertEqual(BLOCK, self.used())
+        self.assertEqual(9, self.free_inodes())
+
+    def test_a_mount_root_directory_takes_no_inode(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.add_mount_point(
+            "/mount", total_size=8 * BLOCK, block_size=BLOCK, inode_count=4
+        )
+        self.assertEqual(4, self.free_inodes("/mount"))
+        self.assertEqual(10, self.free_inodes("/"))
+
+    def test_a_file_that_does_not_fit_in_the_free_blocks_is_refused(self):
+        self.configure(2 * BLOCK)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 1))
+        with self.raises_os_error(errno.ENOSPC):
+            self.fs.create_file("/bar", contents=b"a")
+
+    def test_the_mount_is_unchanged_after_a_refused_create(self):
+        self.configure(2 * BLOCK, inode_count=10)
+        with self.raises_os_error(errno.ENOSPC):
+            self.fs.create_file("/foo", contents=b"a" * (2 * BLOCK + 1))
+        self.assertEqual(0, self.used())
+        self.assertEqual(10, self.free_inodes())
+        self.assertFalse(self.os.path.exists("/foo"))
+
+    def test_the_last_inode_can_still_be_used(self):
+        self.configure(20 * BLOCK, inode_count=1)
+        self.fs.create_file("/foo", contents=b"a")
+        self.assertEqual(0, self.free_inodes())
+        self.assertEqual(BLOCK, self.used())
+
+    def test_a_new_object_without_a_free_inode_is_refused(self):
+        self.configure(20 * BLOCK, inode_count=1)
+        self.fs.create_file("/foo", contents=b"a")
+        self.assertEqual(19 * BLOCK, self.fs.get_disk_usage().free)
+        with self.raises_os_error(errno.ENOSPC):
+            self.fs.create_file("/bar", contents=b"a")
+        with self.raises_os_error(errno.ENOSPC):
+            self.os.mkdir("/dir")
+
+    def test_writing_to_an_existing_file_survives_inode_exhaustion(self):
+        self.configure(20 * BLOCK, inode_count=1)
+        self.fs.create_file("/foo", contents=b"a")
+        self.assertEqual(0, self.free_inodes())
+        self.write("/foo", 5 * BLOCK, mode="a")
+        self.assertEqual(6 * BLOCK, self.used())
+        self.os.truncate("/foo", 1)
+        self.assertEqual(BLOCK, self.used())
+
+    def test_fake_os_statvfs_does_not_answer_from_the_real_filesystem(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.assertIsNot(self.os.statvfs, os.statvfs)
+        result = self.os.statvfs("/")
+        self.assertEqual(os.statvfs_result, type(result))
+        self.assertEqual(20, result.f_blocks)
+        self.assertEqual(10, result.f_files)
+
+    def test_statvfs_reports_every_field_of_the_configured_mount(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 1))
+        self.os.mkdir("/dir")
+        result = self.os.statvfs("/")
+        self.assertEqual(BLOCK, result.f_bsize)
+        self.assertEqual(BLOCK, result.f_frsize)
+        self.assertEqual(20, result.f_blocks)
+        self.assertEqual(18, result.f_bfree)
+        self.assertEqual(18, result.f_bavail)
+        self.assertEqual(10, result.f_files)
+        self.assertEqual(8, result.f_ffree)
+        self.assertEqual(8, result.f_favail)
+        self.assertEqual(0, result.f_flag)
+        self.assertEqual(255, result.f_namemax)
+
+    def test_statvfs_follows_the_mount_the_path_is_on(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.add_mount_point(
+            "/mount", total_size=8 * BLOCK, block_size=2 * BLOCK, inode_count=4
+        )
+        self.fs.create_file("/mount/foo", contents=b"a")
+        self.assertEqual(2 * BLOCK, self.os.statvfs("/mount/foo").f_bsize)
+        self.assertEqual(4, self.os.statvfs("/mount").f_blocks)
+        self.assertEqual(3, self.os.statvfs("/mount").f_bfree)
+        self.assertEqual(3, self.os.statvfs("/mount").f_ffree)
+        self.assertEqual(20, self.os.statvfs("/").f_blocks)
+        self.assertEqual(10, self.os.statvfs("/").f_ffree)
+
+    def test_the_filesystem_reports_statvfs_for_the_mount_of_a_path(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.add_mount_point(
+            "/mount", total_size=8 * BLOCK, block_size=2 * BLOCK, inode_count=4
+        )
+        self.fs.create_file("/mount/foo", contents=b"a")
+        result = self.fs.statvfs("/mount/foo")
+        self.assertEqual(os.statvfs_result, type(result))
+        self.assertEqual(2 * BLOCK, result.f_bsize)
+        self.assertEqual(2 * BLOCK, result.f_frsize)
+        self.assertEqual(4, result.f_blocks)
+        self.assertEqual(3, result.f_bfree)
+        self.assertEqual(3, result.f_bavail)
+        self.assertEqual(4, result.f_files)
+        self.assertEqual(3, result.f_ffree)
+        self.assertEqual(3, result.f_favail)
+        self.assertEqual(0, result.f_flag)
+        self.assertEqual(255, result.f_namemax)
+
+    def test_the_filesystem_and_the_os_module_report_the_same_statvfs(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 1))
+        self.assertEqual(tuple(self.os.statvfs("/")), tuple(self.fs.statvfs("/")))
+        self.assertEqual(
+            (BLOCK, BLOCK, 20, 18, 18, 10, 9, 9, 0, 255),
+            tuple(self.fs.statvfs("/")),
+        )
+
+    def test_a_mount_without_limits_reports_as_many_inodes_as_blocks(self):
+        result = self.os.statvfs("/")
+        unlimited = self.fs.get_disk_usage().total
+        self.assertEqual(1, result.f_bsize)
+        self.assertEqual(unlimited, result.f_blocks)
+        self.assertEqual(unlimited, result.f_files)
+        self.fs.create_file("/foo", contents=b"a")
+        self.assertEqual(unlimited - 1, self.os.statvfs("/").f_ffree)
+
+    def test_disk_usage_agrees_with_statvfs(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * (BLOCK + 1))
+        usage = self.shutil.disk_usage("/")
+        result = self.os.statvfs("/")
+        self.assertEqual(usage.total, result.f_blocks * result.f_bsize)
+        self.assertEqual(usage.free, result.f_bfree * result.f_bsize)
+        self.assertEqual(usage.total - usage.used, usage.free)
+
+    def test_a_negative_inode_count_is_rejected(self):
+        with self.assertRaises(ValueError):
+            self.fs.set_disk_usage(20 * BLOCK, inode_count=-1)
+        with self.assertRaises(ValueError):
+            self.fs.add_mount_point("/mount", total_size=BLOCK, inode_count=-1)
+
+    def test_the_block_size_of_an_empty_mount_can_be_changed(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.set_disk_usage(20 * BLOCK, block_size=2 * BLOCK)
+        result = self.os.statvfs("/")
+        self.assertEqual(2 * BLOCK, result.f_bsize)
+        self.assertEqual(10, result.f_blocks)
+        self.assertEqual(10, result.f_files)
+
+    def test_changing_the_block_size_of_a_mount_holding_a_file_is_refused(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        with self.raises_os_error(errno.EBUSY):
+            self.fs.set_disk_usage(20 * BLOCK, block_size=2 * BLOCK)
+        self.assertEqual(BLOCK, self.os.statvfs("/").f_bsize)
+        self.assertEqual(BLOCK, self.used())
+
+    def test_changing_the_block_size_of_a_mount_holding_a_directory_is_refused(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.mkdir("/dir")
+        self.assertEqual(0, self.used())
+        with self.raises_os_error(errno.EBUSY):
+            self.fs.set_disk_usage(20 * BLOCK, block_size=2 * BLOCK)
+        self.assertEqual(BLOCK, self.os.statvfs("/").f_bsize)
+
+    def test_lowering_the_inode_count_below_the_number_in_use_is_refused(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.os.makedirs("/a/b/c")
+        with self.raises_os_error(errno.ENOSPC):
+            self.fs.set_disk_usage(20 * BLOCK, inode_count=2)
+        self.assertEqual(10, self.os.statvfs("/").f_files)
+        self.fs.set_disk_usage(20 * BLOCK, inode_count=3)
+        self.assertEqual(3, self.os.statvfs("/").f_files)
+        self.assertEqual(0, self.free_inodes())
+
+    def test_leaving_out_the_block_size_and_inode_count_keeps_them(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        self.fs.set_disk_usage(40 * BLOCK)
+        result = self.os.statvfs("/")
+        self.assertEqual(BLOCK, result.f_bsize)
+        self.assertEqual(40, result.f_blocks)
+        self.assertEqual(10, result.f_files)
+        self.assertEqual(9, result.f_ffree)
+        self.assertEqual(BLOCK, self.used())
+
+    def test_a_new_mount_point_counts_bytes_exactly_and_limits_no_inodes(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.add_mount_point("/plain", total_size=100)
+        result = self.os.statvfs("/plain")
+        self.assertEqual(1, result.f_bsize)
+        self.assertEqual(1, result.f_frsize)
+        self.assertEqual(100, result.f_blocks)
+        self.assertEqual(100, result.f_files)
+        self.fs.create_file("/plain/foo", contents=b"xyzzy")
+        self.assertEqual(5, self.fs.get_disk_usage("/plain").used)
+        self.assertEqual(99, self.os.statvfs("/plain").f_ffree)
+
+    def test_passing_none_keeps_the_block_size_and_the_inode_count(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a")
+        self.fs.set_disk_usage(40 * BLOCK, block_size=None, inode_count=None)
+        result = self.os.statvfs("/")
+        self.assertEqual(BLOCK, result.f_bsize)
+        self.assertEqual(40, result.f_blocks)
+        self.assertEqual(10, result.f_files)
+        self.assertEqual(9, result.f_ffree)
+
+    def test_set_disk_usage_only_touches_the_mount_of_the_path(self):
+        self.configure(20 * BLOCK, inode_count=10)
+        self.fs.add_mount_point(
+            "/mount", total_size=8 * BLOCK, block_size=BLOCK, inode_count=4
+        )
+        self.fs.set_disk_usage(
+            16 * BLOCK, "/mount", block_size=2 * BLOCK, inode_count=6
+        )
+        mounted = self.os.statvfs("/mount")
+        self.assertEqual(2 * BLOCK, mounted.f_bsize)
+        self.assertEqual(8, mounted.f_blocks)
+        self.assertEqual(6, mounted.f_files)
+        root = self.os.statvfs("/")
+        self.assertEqual(BLOCK, root.f_bsize)
+        self.assertEqual(20, root.f_blocks)
+        self.assertEqual(10, root.f_files)
+
+    def test_a_refused_truncate_leaves_the_file_and_the_counters_alone(self):
+        self.configure(2 * BLOCK, inode_count=10)
+        self.fs.create_file("/foo", contents=b"a" * BLOCK)
+        with self.raises_os_error(errno.ENOSPC):
+            self.os.truncate("/foo", 3 * BLOCK)
+        self.assertEqual(BLOCK, self.used())
+        self.assertEqual(BLOCK, self.os.stat("/foo").st_size)
+        self.assertEqual(9, self.free_inodes())
+
+    def test_a_refused_append_leaves_the_file_and_the_counters_alone(self):
+        self.configure(2 * BLOCK, inode_count=10)
