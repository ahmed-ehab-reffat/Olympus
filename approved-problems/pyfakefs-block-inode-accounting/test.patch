+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="/tmp/test_results.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")"
+
+NEW_TESTS="pyfakefs/tests/fake_disk_accounting_7179fb_test.py"
+
+if [ "$MODE" = "new" ]; then
+  TARGETS=("$NEW_TESTS")
+else
+  # Four cases of this repository are not compatible with this pytest invocation.
+  # TestClassSetup drives setUpClassPyfakefs, which errors during pytest collection
+  # with "OSError: [Errno 9] Bad file descriptor"; the repository runs those cases
+  # through python -m pyfakefs.tests.all_tests instead.
+  # FakeFilesystemVsRealTest::test_empty_path compares the fake filesystem against
+  # the real host filesystem, TestTempPathCreation::test_write_tmp_windows depends
+  # on real temp-directory discovery and on the ownership of "/", and
+  # test_owner_and_group_posix looks the current user and group up in the host
+  # passwd and group databases, so all three answer to the host environment
+  # rather than to the fake filesystem.
+  TARGETS=(
+    pyfakefs/tests
+    "--ignore=$NEW_TESTS"
+    "--deselect=pyfakefs/tests/fake_filesystem_unittest_test.py::TestClassSetup"
+    "--deselect=pyfakefs/tests/fake_filesystem_unittest_test.py::TestTempPathCreation::test_write_tmp_windows"
+    "--deselect=pyfakefs/tests/fake_filesystem_vs_real_test.py::FakeFilesystemVsRealTest::test_empty_path"
+    "--deselect=pyfakefs/tests/fake_pathlib_test.py::FakePathlibUsageInOsFunctionsTest::test_owner_and_group_posix"
+  )
+fi
+
+RUN_LOG="$(mktemp)"
+trap 'rm -f "$RUN_LOG"' EXIT
+
+python -m pytest "${TARGETS[@]}" \
+  -p no:cacheprovider -p no:randomly \
+  --junitxml="$OUTPUT_PATH" -q 2>&1 | tee "$RUN_LOG"
+EXIT_CODE=${PIPESTATUS[0]}
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  {
+    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
+    printf '%s\n' '<testsuites>'
+    printf '%s\n' '<testsuite name="pytest" tests="1" failures="1" errors="0" time="0">'
+    printf '%s\n' '<testcase name="collect_tests" classname="pyfakefs.tests">'
+    printf '<failure message="pytest exited with status %s without reporting a test case"><![CDATA[' "$EXIT_CODE"
+    tail -n 200 "$RUN_LOG" | sed 's/]]>/]]]]><![CDATA[>/g'
+    printf '%s\n' ']]></failure>'
+    printf '%s\n' '</testcase>'
+    printf '%s\n' '</testsuite>'
+    printf '%s\n' '</testsuites>'
+  } > "$OUTPUT_PATH"
+  if [ "$EXIT_CODE" -eq 0 ]; then
+    EXIT_CODE=1
+  fi
+fi
+
+exit $EXIT_CODE
