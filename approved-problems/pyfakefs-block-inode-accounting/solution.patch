+UNLIMITED_SIZE = 1024 * 1024 * 1024 * 1024
+TreeUsage = namedtuple("TreeUsage", "size, inodes")
+
+
+def blocks_for(size: int, block_size: int) -> int:
+    """Return the number of whole allocation units a byte length needs."""
+    if size <= 0:
+        return 0
+    return -(-size // block_size)
+
+
+def mount_capacity(mount_point: dict) -> int:
+    """Return the usable size of a mount point in bytes, which is the whole
+    allocation units that fit into its total size, and never less than none."""
+    total_size = mount_point["total_size"]
+    if total_size is None:
+        total_size = UNLIMITED_SIZE
+    block_size = mount_point["block_size"]
+    return max(0, total_size) // block_size * block_size
+
+
+def check_block_size(block_size: int | None) -> None:
+    """Raise if the given allocation unit size cannot be used."""
+    if block_size is not None and (not is_int_type(block_size) or block_size < 1):
+        raise ValueError("block_size must be a positive integer")
+
+
+def check_inode_count(inode_count: int | None) -> None:
+    """Raise if the given number of inodes cannot be used."""
+    if inode_count is not None and (not is_int_type(inode_count) or inode_count < 0):
+        raise ValueError("inode_count must be a non-negative integer")
+
+
+def check_reserved(name: str, reserved: int | None) -> None:
+    """Raise if the given size of a reserve cannot be used."""
+    if reserved is not None and (not is_int_type(reserved) or reserved < 0):
+        raise ValueError(f"{name} must be a non-negative integer")
+
+
+def free_size(mount_point: dict) -> int:
+    """Return the bytes of a mount point that hold no object."""
+    return mount_capacity(mount_point) - mount_point["used_size"]
+
+
+def available_size(mount_point: dict) -> int:
+    """Return the bytes of a mount point an unprivileged caller may still
+    take, which is the free space less the reserve."""
+    reserved = mount_point["reserved_blocks"] * mount_point["block_size"]
+    return max(0, free_size(mount_point) - reserved)
+
+
+def free_inodes(mount_point: dict) -> int:
+    """Return the number of inodes of a mount point that no object holds."""
+    inode_count = mount_point["inode_count"]
+    if inode_count is None:
+        inode_count = mount_capacity(mount_point) // mount_point["block_size"]
+    return inode_count - mount_point["used_inodes"]
+
+
+def available_inodes(mount_point: dict) -> int:
+    """Return the number of inodes of a mount point an unprivileged caller
+    may still take, which is the free inodes less the reserve."""
+    return max(0, free_inodes(mount_point) - mount_point["reserved_inodes"])
+
+
+def mount_settings(mount_point: dict) -> dict:
+    """Return the settings of a mount point, without anything it holds."""
+    return {
+        "block_size": mount_point["block_size"],
+        "inode_count": mount_point["inode_count"],
+        "reserved_blocks": mount_point["reserved_blocks"],
+        "reserved_inodes": mount_point["reserved_inodes"],
+    }
+
