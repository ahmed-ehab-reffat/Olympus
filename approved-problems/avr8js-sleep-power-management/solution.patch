diff --git a/src/peripherals/power.ts b/src/peripherals/power.ts
new file mode 100644
index 0000000..5c4d092
--- /dev/null
+++ b/src/peripherals/power.ts
@@ -0,0 +1,195 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) Uri Shaked and contributors
+
+/**
+ * AVR-8 Sleep Modes and Power Management
+ * Part of AVR8js
+ * Reference: http://ww1.microchip.com/downloads/en/DeviceDoc/ATmega48A-PA-88A-PA-168A-PA-328-P-DS-DS40002061A.pdf
+ *
+ * Copyright (C) 2019-2026 Uri Shaked
+ */
+
+import { AVRPeripheralClock, CPU } from '../cpu/cpu';
+import { u8 } from '../types';
+
+/** The values are the mode selection each one is written as. */
+export enum AVRSleepMode {
+  Idle = 0,
+  ADCNoiseReduction = 1,
+  PowerDown = 2,
+  PowerSave = 3,
+  Standby = 6,
+  ExtendedStandby = 7,
+}
+
+export interface AVRPowerConfig {
+  /** Register holding the sleep enable bit and the mode selection */
+  SMCR: u8;
+
+  /** Bits of that register the device implements */
+  SMCRMask: u8;
+
+  /** Sleep enable bit */
+  SE: u8;
+
+  /** Position and width of the mode selection inside the register */
+  modeShift: u8;
+  modeMask: u8;
+
+  /** The mode each selection value picks. A null entry is a reserved selection. */
+  modes: (AVRSleepMode | null)[];
+
+  /** Power reduction register, and the bits the device implements */
+  PRR: u8;
+  PRRMask: u8;
+
+  /** The peripheral clock each power reduction bit stops */
+  powerReduction: [AVRPeripheralClock, u8][];
+
+  /** Asynchronous status register, or 0 when the device has no asynchronous timer */
+  ASSR: u8;
+}
+
+export const powerConfig: AVRPowerConfig = {
+  SMCR: 0x53,
+  SMCRMask: 0x0f,
+  SE: 1,
+  modeShift: 1,
+  modeMask: 7,
+  modes: [
+    AVRSleepMode.Idle,
+    AVRSleepMode.ADCNoiseReduction,
+    AVRSleepMode.PowerDown,
+    AVRSleepMode.PowerSave,
+    null,
+    null,
+    AVRSleepMode.Standby,
+    AVRSleepMode.ExtendedStandby,
+  ],
+  PRR: 0x64,
+  PRRMask: 0xef,
+  powerReduction: [
+    [AVRPeripheralClock.ADC, 0x01],
+    [AVRPeripheralClock.USART0, 0x02],
+    [AVRPeripheralClock.SPI, 0x04],
+    [AVRPeripheralClock.Timer1, 0x08],
+    [AVRPeripheralClock.Timer0, 0x20],
+    [AVRPeripheralClock.Timer2, 0x40],
+    [AVRPeripheralClock.TWI, 0x80],
+  ],
+  ASSR: 0xb6,
+};
+
+/** ATtiny25/45/85: the sleep controls live in MCUCR and there is no asynchronous timer. */
+export const attinyPowerConfig: AVRPowerConfig = {
+  SMCR: 0x35,
+  SMCRMask: 0xff,
+  SE: 0x20,
+  modeShift: 3,
+  modeMask: 3,
+  modes: [AVRSleepMode.Idle, AVRSleepMode.ADCNoiseReduction, AVRSleepMode.PowerDown, null],
+  PRR: 0x20,
+  PRRMask: 0x0f,
+  powerReduction: [
+    [AVRPeripheralClock.ADC, 0x01],
+    [AVRPeripheralClock.Timer0, 0x04],
+    [AVRPeripheralClock.Timer1, 0x08],
+  ],
+  ASSR: 0,
+};
+
+const AS2 = 0x20;
+
+const ioClocks = [
+  AVRPeripheralClock.IO,
+  AVRPeripheralClock.Timer0,
+  AVRPeripheralClock.Timer1,
+  AVRPeripheralClock.Timer2,
+  AVRPeripheralClock.SPI,
+  AVRPeripheralClock.USART0,
+  AVRPeripheralClock.TWI,
+  AVRPeripheralClock.EEPROM,
+];
+
+const gatedClocks = [...ioClocks, AVRPeripheralClock.ADC];
+
+/** The modes that leave an asynchronously clocked timer 2 running. */
+const asyncModes = [AVRSleepMode.PowerSave, AVRSleepMode.ExtendedStandby];
+
+function stoppedByMode(mode: AVRSleepMode, asynchronous: boolean) {
+  if (mode === AVRSleepMode.Idle) {
+    return [];
+  }
+  const stopped = [...ioClocks];
+  if (mode !== AVRSleepMode.ADCNoiseReduction) {
+    stopped.push(AVRPeripheralClock.ADC);
+  }
+  if (asynchronous && asyncModes.includes(mode)) {
+    return stopped.filter((clock) => clock !== AVRPeripheralClock.Timer2);
+  }
+  return stopped;
+}
+
+export class AVRPower {
+  private activeMode: AVRSleepMode | null = null;
+
+  constructor(
+    private cpu: CPU,
+    private config: AVRPowerConfig = powerConfig,
+  ) {
+    cpu.writeHooks[config.SMCR] = (value: u8) => {
+      cpu.data[config.SMCR] = value & config.SMCRMask;
+      return true;
+    };
+
+    cpu.writeHooks[config.PRR] = (value: u8) => {
+      cpu.data[config.PRR] = value & config.PRRMask;
+      this.updateClocks();
+      return true;
+    };
+
+    cpu.onSleep = this.handleSleepInstruction;
+    cpu.sleepListeners.add(this.handleSleepChange);
+  }
+
+  /** The sleep mode the CPU is in, or null when it is awake. */
+  get mode() {
+    return this.activeMode;
+  }
+
+  /** Whether timer 2 is clocked from the asynchronous crystal. */
+  get asynchronous() {
+    const { ASSR } = this.config;
+    return ASSR !== 0 && (this.cpu.data[ASSR] & AS2) !== 0;
+  }
+
+  private handleSleepInstruction = () => {
+    const { SMCR, SE, modeShift, modeMask, modes } = this.config;
+    const register = this.cpu.data[SMCR];
+    if (!(register & SE)) {
+      return;
+    }
+    const mode = modes[(register >> modeShift) & modeMask];
+    if (mode == null) {
+      return;
+    }
+    this.cpu.enterSleep(mode);
+  };
+
+  private handleSleepChange = (mode: number | null) => {
+    this.activeMode = mode;
+    this.updateClocks();
+  };
+
+  private updateClocks() {
+    const { cpu } = this;
+    const prr = cpu.data[this.config.PRR];
+    const asleep =
+      this.activeMode !== null ? stoppedByMode(this.activeMode, this.asynchronous) : [];
+    for (const clock of gatedClocks) {
+      const reduction = this.config.powerReduction.find(([candidate]) => candidate === clock);
+      const reduced = reduction ? (prr & reduction[1]) !== 0 : false;
+      cpu.setClockStopped(clock, reduced || asleep.includes(clock));
+    }
+  }
+}
