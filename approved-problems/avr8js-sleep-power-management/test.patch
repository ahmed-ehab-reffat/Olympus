+describe('AVRPower - the owed time of work submitted long after the gate closed', () => {
+  const GATE = 0;
+  const SUBMIT = 100;
+  const RELEASE = 200;
+
+  function gatedSpi() {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    new AVRSPI(cpu, spiConfig, 16e6);
+    cpu.writeData(SPCR, 0x50);
+    cpu.cycles = GATE;
+    cpu.writeData(PRR, 0x04);
+    cpu.cycles = SUBMIT;
+    cpu.writeData(SPDR, 0x55);
+    cpu.cycles = RELEASE;
+    cpu.writeData(PRR, 0);
+    return cpu;
+  }
+
+  function runTo(cpu: InstanceType<typeof CPU>, cycle: number) {
+    cpu.cycles = cycle;
+    cpu.tick();
+    cpu.tick();
+  }
+
+  it('has not completed the transfer immediately after the clock returns', () => {
+    const cpu = gatedSpi();
+    runTo(cpu, RELEASE + 8);
+    expect(cpu.data[SPSR] & 0x80).toEqual(0);
+  });
+
+  it('completes the transfer after only the time it still owed', () => {
+    const cpu = gatedSpi();
+    runTo(cpu, RELEASE + 64);
+    expect(cpu.data[SPSR] & 0x80).toEqual(0x80);
+  });
+
+  it('does not carry the wait before submission into the owed time', () => {
+    const cpu = gatedSpi();
+    runTo(cpu, RELEASE + (SUBMIT - GATE));
+    expect(cpu.data[SPSR] & 0x80).toEqual(0x80);
+  });
+
+  function gatedConversion() {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    const adc = new AVRADC(cpu, adcConfig);
+    adc.channelValues[0] = 2.5;
+    cpu.writeData(ADMUX, 0);
+    cpu.writeData(ADCSRA, ADEN);
+    cpu.cycles = GATE;
+    cpu.writeData(PRR, 0x01);
+    cpu.cycles = SUBMIT;
+    cpu.writeData(ADCSRA, ADEN | ADSC);
+    cpu.cycles = RELEASE;
+    cpu.writeData(PRR, 0);
+    return cpu;
+  }
+
+  it('has not completed the conversion immediately after the clock returns', () => {
+    const cpu = gatedConversion();
+    runTo(cpu, RELEASE + 8);
+    expect(cpu.readData(ADCSRA) & ADSC).toEqual(ADSC);
+  });
+
+  it('completes the conversion after only the time it still owed', () => {
+    const cpu = gatedConversion();
+    runTo(cpu, RELEASE + 100);
+    expect(cpu.readData(ADCSRA) & ADSC).toEqual(0);
+  });
+
+  it('does not carry the wait before submission into the conversion owed time', () => {
+    const cpu = gatedConversion();
+    runTo(cpu, RELEASE + (SUBMIT - GATE));
+    expect(cpu.readData(ADCSRA) & ADSC).toEqual(0);
+  });
+});
