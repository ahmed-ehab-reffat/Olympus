+describe('AVRPower - which clocks each mode keeps running', () => {
+  function timerAfterSleep(
+    mode: number,
+    config: 'timer0' | 'timer1' | 'timer2',
+    assr = 0,
+    steps = 40,
+  ) {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(ASSR, assr);
+    if (config === 'timer0') {
+      new AVRTimer(cpu, timer0Config);
+      cpu.writeData(TCCR0B, 1);
+    } else if (config === 'timer1') {
+      new AVRTimer(cpu, timer1Config);
+      cpu.writeData(TCCR1B, 1);
+    } else {
+      new AVRTimer(cpu, timer2Config);
+      cpu.writeData(TCCR2B, 1);
+    }
+    settleTimer(cpu);
+    cpu.writeData(SMCR, smcr(mode));
+    runSleeping(cpu, steps);
+    const address = config === 'timer0' ? TCNT0 : config === 'timer1' ? TCNT1 : TCNT2;
+    return cpu.readData(address);
+  }
+
+  it('runs timer 0 in idle', () => {
+    expect(timerAfterSleep(IDLE, 'timer0')).toBeGreaterThan(0);
+  });
+
+  it('runs timer 1 in idle', () => {
+    expect(timerAfterSleep(IDLE, 'timer1')).toBeGreaterThan(0);
+  });
+
+  it('runs timer 2 in idle', () => {
+    expect(timerAfterSleep(IDLE, 'timer2')).toBeGreaterThan(0);
+  });
+
+  it('stops timer 0 in ADC noise reduction', () => {
+    expect(timerAfterSleep(ADC_NOISE_REDUCTION, 'timer0')).toEqual(0);
+  });
+
+  it('stops timer 2 in ADC noise reduction', () => {
+    expect(timerAfterSleep(ADC_NOISE_REDUCTION, 'timer2')).toEqual(0);
+  });
+
+  it('stops timer 0 in power-down', () => {
+    expect(timerAfterSleep(POWER_DOWN, 'timer0')).toEqual(0);
+  });
+
+  it('stops timer 1 in power-down', () => {
+    expect(timerAfterSleep(POWER_DOWN, 'timer1')).toEqual(0);
+  });
+
+  it('stops timer 2 in power-down', () => {
+    expect(timerAfterSleep(POWER_DOWN, 'timer2')).toEqual(0);
+  });
+
+  it('stops timer 0 in power-save', () => {
+    expect(timerAfterSleep(POWER_SAVE, 'timer0')).toEqual(0);
+  });
+
+  it('keeps an asynchronous timer 2 running in power-save', () => {
+    expect(timerAfterSleep(POWER_SAVE, 'timer2', AS2)).toBeGreaterThan(0);
+  });
+
+  it('stops timer 2 in power-save when it is not asynchronous', () => {
+    expect(timerAfterSleep(POWER_SAVE, 'timer2')).toEqual(0);
+  });
+
+  it('stops an asynchronous timer 2 in power-down', () => {
+    expect(timerAfterSleep(POWER_DOWN, 'timer2', AS2)).toEqual(0);
+  });
+
+  it('stops an asynchronous timer 2 in ADC noise reduction', () => {
+    expect(timerAfterSleep(ADC_NOISE_REDUCTION, 'timer2', AS2)).toEqual(0);
+  });
+
+  it('stops an asynchronous timer 2 in standby', () => {
+    expect(timerAfterSleep(STANDBY, 'timer2', AS2)).toEqual(0);
+  });
+
+  it('keeps timer 0 stopped in power-save even when timer 2 is asynchronous', () => {
+    expect(timerAfterSleep(POWER_SAVE, 'timer0', AS2)).toEqual(0);
+  });
+
+  it('stops timer 2 in standby', () => {
+    expect(timerAfterSleep(STANDBY, 'timer2')).toEqual(0);
+  });
+
+  it('stops timer 0 in standby', () => {
+    expect(timerAfterSleep(STANDBY, 'timer0')).toEqual(0);
+  });
+
+  it('keeps an asynchronous timer 2 running in extended standby', () => {
+    expect(timerAfterSleep(EXTENDED_STANDBY, 'timer2', AS2)).toBeGreaterThan(0);
+  });
+
+  it('stops timer 2 in extended standby when it is not asynchronous', () => {
+    expect(timerAfterSleep(EXTENDED_STANDBY, 'timer2')).toEqual(0);
+  });
+
+  it('stops timer 1 in extended standby', () => {
+    expect(timerAfterSleep(EXTENDED_STANDBY, 'timer1')).toEqual(0);
+  });
+});
