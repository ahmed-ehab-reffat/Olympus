+describe('AVRPower - externally clocked timers obey the gate', () => {
+  const T0_PIN = 4;
+  const EXTERNAL_RISING = 7;
+
+  function externalTimer() {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    const port = new AVRIOPort(cpu, portDConfig);
+    new AVRTimer(cpu, timer0Config);
+    cpu.writeData(TCCR0B, EXTERNAL_RISING);
+    settleTimer(cpu);
+    return { cpu, port };
+  }
+
+  function pulse(port: InstanceType<typeof AVRIOPort>, times: number) {
+    for (let i = 0; i < times; i++) {
+      port.setPin(T0_PIN, true);
+      port.setPin(T0_PIN, false);
+    }
+  }
+
+  it('counts external edges while the clock runs', () => {
+    const { cpu, port } = externalTimer();
+    pulse(port, 3);
+    expect(cpu.readData(TCNT0)).toEqual(3);
+  });
+
+  it('ignores external edges while its power reduction bit is set', () => {
+    const { cpu, port } = externalTimer();
+    pulse(port, 2);
+    const before = cpu.readData(TCNT0);
+    expect(before).toEqual(2);
+    cpu.writeData(PRR, 0x20);
+    pulse(port, 5);
+    expect(cpu.readData(TCNT0)).toEqual(before);
+  });
+
+  it('counts external edges again once the power reduction bit clears', () => {
+    const { cpu, port } = externalTimer();
+    cpu.writeData(PRR, 0x20);
+    pulse(port, 5);
+    cpu.writeData(PRR, 0);
+    pulse(port, 2);
+    expect(cpu.readData(TCNT0)).toEqual(2);
+  });
+
+  it('ignores external edges while a sleep mode stops the timer', () => {
+    const { cpu, port } = externalTimer();
+    pulse(port, 2);
+    const before = cpu.readData(TCNT0);
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    new TestProgramRunner(cpu).runInstructions(1);
+    pulse(port, 5);
+    expect(cpu.readData(TCNT0)).toEqual(before);
+  });
+
+  it('counts external edges again after waking', () => {
+    const { cpu, port } = externalTimer();
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    new TestProgramRunner(cpu).runInstructions(1);
+    pulse(port, 5);
+    cpu.wakeUp();
+    pulse(port, 3);
+    expect(cpu.readData(TCNT0)).toEqual(3);
+  });
+
+  it('raises no overflow interrupt from external edges while stopped', () => {
+    const { cpu, port } = externalTimer();
+    cpu.writeData(TIMSK0, 1);
+    cpu.data[SREG] = 0;
+    cpu.writeData(PRR, 0x20);
+    pulse(port, 300);
+    cpu.tick();
+    expect(cpu.readData(TCNT0)).toEqual(0);
+    expect(cpu.data[TIFR0] & 1).toEqual(0);
+    expect(cpu.nextInterrupt).toEqual(-1);
+  });
+
+  it('raises the overflow interrupt from external edges once the gate reopens', () => {
+    const { cpu, port } = externalTimer();
+    cpu.writeData(TIMSK0, 1);
+    cpu.data[SREG] = 0;
+    cpu.writeData(PRR, 0x20);
+    pulse(port, 300);
+    cpu.writeData(PRR, 0);
+    pulse(port, 256);
+    cpu.tick();
+    expect(cpu.data[TIFR0] & 1).toEqual(1);
+    expect(cpu.nextInterrupt).toEqual(TIMER0_OVF);
+  });
+});
