+describe('AVRPower - the cycle counter while asleep', () => {
+  it('advances to the next scheduled peripheral event', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    startTimer0(cpu);
+    cpu.writeData(TCCR0B, 5);
