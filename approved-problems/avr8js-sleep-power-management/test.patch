+describe('AVRPower - the sleeping scheduler skips stopped clocks', () => {
+  function twoTimers() {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    new AVRTimer(cpu, timer0Config);
+    new AVRTimer(cpu, timer2Config);
