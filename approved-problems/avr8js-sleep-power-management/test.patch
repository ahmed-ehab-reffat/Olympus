+
+  it('does not stop on an event belonging to a stopped clock', () => {
+    const cpu = twoTimers();
+    cpu.writeData(SMCR, smcr(POWER_SAVE));
+    new TestProgramRunner(cpu).runInstructions(1);
+    const before = cpu.cycles;
+    runSleeping(cpu, 1);
+    expect(cpu.cycles).toBeGreaterThan(before + 100);
+  });
+
+  it('advances one cycle at a time when every clock is stopped', () => {
+    const cpu = twoTimers();
+    cpu.writeData(ASSR, 0);
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    new TestProgramRunner(cpu).runInstructions(1);
+    const before = cpu.cycles;
+    runSleeping(cpu, 3);
+    expect(cpu.cycles).toEqual(before + 3);
+  });
+
+  it('leaves the stopped timer at zero while it skips past its event', () => {
+    const cpu = twoTimers();
+    cpu.writeData(SMCR, smcr(POWER_SAVE));
+    new TestProgramRunner(cpu).runInstructions(1);
+    runSleeping(cpu, 2);
