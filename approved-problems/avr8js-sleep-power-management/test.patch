+describe('AVRPower - USART reception obeys the gate as well', () => {
+  const RXEN = 0x10;
+  const RXC = 0x80;
+  const CHAR_CYCLES = 20000;
+
+  function receivingUsart() {
+    const cpu = buildCpu();
+    const power = new AVRPower(cpu);
+    const usart = new AVRUSART(cpu, usart0Config, 16e6);
+    cpu.writeData(UCSRB, RXEN);
+    cpu.writeData(UBRRL, 103);
+    return { cpu, usart, power };
+  }
+
+  it('holds a reception while its power reduction bit is set', () => {
+    const { cpu, usart } = receivingUsart();
+    cpu.writeData(PRR, 0x02);
+    expect(usart.writeByte(0x61)).toBe(true);
+    cpu.cycles = CHAR_CYCLES;
+    cpu.tick();
+    cpu.tick();
+    expect(cpu.data[UCSRA] & RXC).toEqual(0);
+    expect(usart.rxBusy).toBe(true);
+  });
+
+  it('completes that reception once the bit is cleared', () => {
+    const { cpu, usart } = receivingUsart();
+    cpu.writeData(PRR, 0x02);
+    usart.writeByte(0x61);
+    cpu.cycles = CHAR_CYCLES;
+    cpu.tick();
+    cpu.writeData(PRR, 0);
+    cpu.cycles = CHAR_CYCLES * 3;
+    cpu.tick();
+    cpu.tick();
+    expect(cpu.data[UCSRA] & RXC).toEqual(RXC);
+    expect(usart.rxBusy).toBe(false);
+  });
+
+  it('holds a reception through a non-idle sleep mode', () => {
+    const { cpu, usart } = receivingUsart();
+    usart.writeByte(0x61);
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    new TestProgramRunner(cpu).runInstructions(1);
+    runSleeping(cpu, 4000);
+    expect(cpu.data[UCSRA] & RXC).toEqual(0);
+    expect(usart.rxBusy).toBe(true);
+  });
+
+  it('completes that reception after waking', () => {
+    const { cpu, usart } = receivingUsart();
+    usart.writeByte(0x61);
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    new TestProgramRunner(cpu).runInstructions(1);
+    runSleeping(cpu, 4000);
+    cpu.wakeUp();
+    cpu.cycles += CHAR_CYCLES * 2;
+    cpu.tick();
+    cpu.tick();
+    expect(cpu.data[UCSRA] & RXC).toEqual(RXC);
+  });
+
+  it('completes a reception while idle stops nothing', () => {
+    const { cpu, usart } = receivingUsart();
+    usart.writeByte(0x61);
+    cpu.writeData(SMCR, smcr(IDLE));
+    new TestProgramRunner(cpu).runInstructions(1);
+    runSleeping(cpu, 4);
+    expect(cpu.data[UCSRA] & RXC).toEqual(RXC);
+  });
+
+  it('queues no receive interrupt while the clock is gated', () => {
+    const { cpu, usart } = receivingUsart();
+    cpu.data[SREG] = 0;
+    cpu.writeData(UCSRB, RXEN | 0x80);
+    cpu.writeData(PRR, 0x02);
+    usart.writeByte(0x61);
+    cpu.cycles = CHAR_CYCLES;
+    cpu.tick();
+    cpu.tick();
+    expect(cpu.nextInterrupt).toEqual(-1);
+  });
+});
