+describe('AVRPower - a pin carrying both an edge and a pin change interrupt', () => {
+  const PCICR2 = 0x04;
+  const PCMSK2 = 0x6d;
+  const PCINT2_VECTOR = 10;
+  const EIFR = 0x3c;
+  const INT0_PIN = 2;
+
+  function bothOnPin2(mode: number, isc: number) {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    const port = new AVRIOPort(cpu, portDConfig);
+    cpu.writeData(EICRA, isc);
+    cpu.writeData(EIMSK, 1);
+    cpu.writeData(PCICR, PCICR2);
+    cpu.writeData(PCMSK2, 1 << INT0_PIN);
+    cpu.data[SREG] = 0x80;
+    cpu.writeData(SMCR, smcr(mode));
+    new TestProgramRunner(cpu).runInstructions(1);
+    return { cpu, port };
+  }
+
+  it('still wakes on the pin change when the edge interrupt is lost', () => {
+    const { cpu, port } = bothOnPin2(POWER_DOWN, 3);
+    port.setPin(INT0_PIN, true);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('takes the pin change vector, not the external one', () => {
+    const { cpu, port } = bothOnPin2(POWER_DOWN, 3);
+    port.setPin(INT0_PIN, true);
+    cpu.tick();
+    expect(cpu.pc).toEqual(PCINT2_VECTOR);
+  });
+
+  it('does not flag the lost edge on that same pin', () => {
+    const { cpu, port } = bothOnPin2(POWER_DOWN, 3);
+    port.setPin(INT0_PIN, true);
+    cpu.tick();
+    expect(cpu.data[EIFR] & 1).toEqual(0);
+  });
+
+  it('still wakes on the pin change when a change triggered edge is lost', () => {
+    const { cpu, port } = bothOnPin2(STANDBY, 1);
+    port.setPin(INT0_PIN, true);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(false);
+    expect(cpu.pc).toEqual(PCINT2_VECTOR);
+  });
+
+  it('takes the external vector in idle, where the edge is not lost', () => {
+    const { cpu, port } = bothOnPin2(IDLE, 3);
+    port.setPin(INT0_PIN, true);
+    cpu.tick();
+    expect(cpu.pc).toEqual(INT0_VECTOR);
+  });
+});
