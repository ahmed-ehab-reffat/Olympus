+describe('AVRPower - waking up', () => {
+  function sleepUntilAwake(cpu: InstanceType<typeof CPU>, steps = 400) {
+    const runner = new TestProgramRunner(cpu);
+    for (let i = 0; i < steps; i++) {
+      runner.runInstructions(1);
+      if (!cpu.sleeping) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  it('wakes on a timer overflow in idle', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0x80;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(sleepUntilAwake(cpu)).toBe(true);
+  });
+
+  it('jumps to the interrupt vector when the global flag is set', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0x80;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    sleepUntilAwake(cpu);
+    expect(cpu.pc).toEqual(TIMER0_OVF);
+  });
+
+  it('wakes even when the global interrupt flag is clear', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(sleepUntilAwake(cpu)).toBe(true);
+  });
+
+  it('resumes after the sleep instruction when the global flag is clear', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    sleepUntilAwake(cpu);
+    expect(cpu.pc).toEqual(1);
+  });
+
+  it('keeps the interrupt pending when the global flag is clear', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    sleepUntilAwake(cpu);
+    expect(cpu.nextInterrupt).toEqual(TIMER0_OVF);
+  });
+
+  it('carries on executing after waking with the global flag clear', () => {
+    const { cpu, enter } = sleepingCpu(IDLE, 'SLEEP\nINC r16\nINC r16\nNOP');
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    sleepUntilAwake(cpu);
+    new TestProgramRunner(cpu).runInstructions(2);
+    expect(cpu.data[16]).toEqual(2);
+  });
+
+  it('does not wake a running CPU twice', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    const before = cpu.cycles;
+    cpu.wakeUp();
+    expect(cpu.cycles).toEqual(before);
+  });
+
+  it('stays asleep in power-down while only a stopped timer could fire', () => {
+    const { cpu, enter } = sleepingCpu(POWER_DOWN);
+    startTimer0(cpu, 0xfe);
+    cpu.data[SREG] = 0x80;
+    settleTimer(cpu);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(sleepUntilAwake(cpu, 100)).toBe(false);
+  });
+
+  it('wakes from power-save on a timer 2 overflow', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    new AVRTimer(cpu, timer2Config);
+    cpu.writeData(ASSR, AS2);
+    cpu.writeData(TCCR2B, 1);
+    cpu.writeData(TIMSK2, 1);
+    cpu.writeData(TCNT2, 0xfe);
+    cpu.data[SREG] = 0x80;
+    cpu.writeData(SMCR, smcr(POWER_SAVE));
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(sleepUntilAwake(cpu)).toBe(true);
+    expect(cpu.pc).toEqual(TIMER2_OVF);
+  });
+
+  it('does not wake from power-down on a timer 2 overflow', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    new AVRTimer(cpu, timer2Config);
+    cpu.writeData(TCCR2B, 1);
+    cpu.writeData(TIMSK2, 1);
+    cpu.writeData(TCNT2, 0xfe);
+    cpu.data[SREG] = 0x80;
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(sleepUntilAwake(cpu, 100)).toBe(false);
+  });
+
+  it('wakes from idle on a timer 1 overflow', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    new AVRTimer(cpu, timer1Config);
+    cpu.writeData(TCCR1B, 1);
+    cpu.writeData(TIMSK1, 1);
+    cpu.writeData(TCNT1 + 1, 0xff);
+    cpu.writeData(TCNT1, 0xf0);
+    cpu.data[SREG] = 0x80;
+    cpu.writeData(SMCR, smcr(IDLE));
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(sleepUntilAwake(cpu)).toBe(true);
+    expect(cpu.pc).toEqual(TIMER1_OVF);
+  });
+
+  it('wakes from an interrupt that was already pending when it fell asleep', () => {
+    const { cpu, enter } = sleepingCpu(POWER_DOWN);
+    startTimer0(cpu, 0xff);
+    settleTimer(cpu);
+    cpu.cycles = 4;
+    cpu.tick();
+    cpu.data[SREG] = 0;
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(false);
+  });
+});
+
+describe('AVRPower - the watchdog runs in every mode', () => {
+  function watchdogWake(mode: number) {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    const clock = new AVRClock(cpu, 16e6, clockConfig);
+    new AVRWatchdog(cpu, watchdogConfig, clock);
+    cpu.writeData(WDTCSR, 0x18);
+    cpu.writeData(WDTCSR, 0x40);
+    cpu.data[SREG] = 0x80;
+    cpu.writeData(SMCR, smcr(mode));
+    const runner = new TestProgramRunner(cpu);
+    runner.runInstructions(1);
+    for (let i = 0; i < 2000 && cpu.sleeping; i++) {
+      runner.runInstructions(1);
+    }
+    return cpu;
+  }
+
+  it('wakes from power-down on a watchdog interrupt', () => {
+    const cpu = watchdogWake(POWER_DOWN);
+    expect(cpu.sleeping).toBe(false);
+    expect(cpu.pc).toEqual(WATCHDOG_VECTOR);
+  });
+
+  it('wakes from power-save on a watchdog interrupt', () => {
+    expect(watchdogWake(POWER_SAVE).pc).toEqual(WATCHDOG_VECTOR);
+  });
+
+  it('wakes from standby on a watchdog interrupt', () => {
+    expect(watchdogWake(STANDBY).pc).toEqual(WATCHDOG_VECTOR);
+  });
+
+  it('wakes from extended standby on a watchdog interrupt', () => {
+    expect(watchdogWake(EXTENDED_STANDBY).pc).toEqual(WATCHDOG_VECTOR);
+  });
+
+  it('wakes from ADC noise reduction on a watchdog interrupt', () => {
+    expect(watchdogWake(ADC_NOISE_REDUCTION).pc).toEqual(WATCHDOG_VECTOR);
+  });
+
+  it('wakes from idle on a watchdog interrupt', () => {
+    expect(watchdogWake(IDLE).pc).toEqual(WATCHDOG_VECTOR);
+  });
+});
+
+describe('AVRPower - external and pin change interrupts', () => {
+  function portDCpu(mode: number, isc: number) {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    const port = new AVRIOPort(cpu, portDConfig);
+    cpu.writeData(EICRA, isc);
+    cpu.writeData(EIMSK, 1);
+    cpu.data[SREG] = 0x80;
+    cpu.writeData(SMCR, smcr(mode));
+    new TestProgramRunner(cpu).runInstructions(1);
+    return { cpu, port };
+  }
+
+  it('wakes from power-down on a low level external interrupt', () => {
+    const { cpu, port } = portDCpu(POWER_DOWN, 0);
+    port.setPin(2, false);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('takes the external interrupt vector when it wakes on a low level', () => {
+    const { cpu, port } = portDCpu(POWER_DOWN, 0);
+    port.setPin(2, false);
+    cpu.tick();
+    expect(cpu.pc).toEqual(INT0_VECTOR);
+  });
+
+  it('ignores a rising edge external interrupt in power-down', () => {
+    const { cpu, port } = portDCpu(POWER_DOWN, 3);
+    port.setPin(2, true);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(true);
+  });
+
+  it('ignores a falling edge external interrupt in power-down', () => {
+    const { cpu, port } = portDCpu(POWER_DOWN, 2);
+    port.setPin(2, true);
+    port.setPin(2, false);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(true);
+  });
+
+  it('ignores a change triggered external interrupt in power-down', () => {
+    const { cpu, port } = portDCpu(POWER_DOWN, 1);
+    port.setPin(2, true);
+    cpu.tick();
+    expect(cpu.sleeping).toBe(true);
+  });
+
+  it('ignores an edge triggered external interrupt in standby', () => {
+    const { cpu, port } = portDCpu(STANDBY, 3);
