+    expect(powerConfig.SMCR).toEqual(0x53);
+    expect(powerConfig.PRR).toEqual(0x64);
+  });
+
+  it('accepts an explicit config object', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu, powerConfig);
+    cpu.writeData(SMCR, smcr(IDLE));
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.sleeping).toBe(true);
+  });
+
+  it('starts awake', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('does not sleep when the sleep enable bit is clear', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(SMCR, 0);
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('keeps executing instructions when the sleep enable bit is clear', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(SMCR, POWER_DOWN << 1);
+    new TestProgramRunner(cpu).runInstructions(3);
+    expect(cpu.pc).toEqual(3);
+  });
+
+  it('sleeps when the sleep enable bit is set', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.sleeping).toBe(true);
+  });
+
+  it('leaves the program counter just after the sleep instruction', () => {
+    const { cpu, enter } = sleepingCpu(IDLE);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.pc).toEqual(1);
+  });
+
+  it('executes no instruction while asleep', () => {
+    const { cpu, enter } = sleepingCpu(IDLE, 'SLEEP\nINC r16\nINC r16\nINC r16');
+    enter();
+    runSleeping(cpu, 6);
+    expect(cpu.pc).toEqual(1);
+    expect(cpu.data[16]).toEqual(0);
+  });
+
+  it('reports the power management peripheral mode while asleep', () => {
+    const { cpu, power, enter } = sleepingCpu(POWER_SAVE);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(power.mode).not.toBeNull();
+  });
+
+  it('does not sleep in reserved mode four', () => {
+    const { cpu, enter } = sleepingCpu(4);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('does not sleep in reserved mode five', () => {
+    const { cpu, enter } = sleepingCpu(5);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('keeps running instructions after a reserved mode sleep', () => {
+    const { cpu, enter } = sleepingCpu(4, 'SLEEP\nINC r16\nINC r16');
+    enter();
+    new TestProgramRunner(cpu).runInstructions(3);
+    expect(cpu.data[16]).toEqual(2);
+  });
+
+  it('sleeps in every non reserved mode', () => {
+    for (const mode of [IDLE, ADC_NOISE_REDUCTION, POWER_DOWN, POWER_SAVE, STANDBY]) {
+      const { cpu, enter } = sleepingCpu(mode);
+      enter();
+      new TestProgramRunner(cpu).runInstructions(1);
+      expect(cpu.sleeping).toBe(true);
+    }
+  });
+
+  it('sleeps in extended standby', () => {
+    const { cpu, enter } = sleepingCpu(EXTENDED_STANDBY);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.sleeping).toBe(true);
+  });
+
+  it('keeps only the low four bits of SMCR', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(SMCR, 0xff);
+    expect(cpu.readData(SMCR)).toEqual(0x0f);
+  });
+
+  it('stores a plain mode selection in SMCR unchanged', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(SMCR, smcr(POWER_DOWN));
+    expect(cpu.readData(SMCR)).toEqual(0x05);
+  });
+
+  it('clears bit four of PRR', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(PRR, 0xff);
+    expect(cpu.readData(PRR)).toEqual(0xef);
+  });
+
+  it('keeps every defined PRR bit', () => {
+    const cpu = buildCpu();
+    new AVRPower(cpu);
+    cpu.writeData(PRR, 0xef);
+    expect(cpu.readData(PRR)).toEqual(0xef);
+  });
+
+  it('wakes up when the CPU is reset', () => {
+    const { cpu, enter } = sleepingCpu(POWER_DOWN);
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    cpu.reset();
+    expect(cpu.sleeping).toBe(false);
+  });
+
+  it('runs instructions again after a reset', () => {
+    const { cpu, enter } = sleepingCpu(POWER_DOWN, 'SLEEP\nINC r16\nINC r16');
+    enter();
+    new TestProgramRunner(cpu).runInstructions(1);
+    cpu.reset();
+    new TestProgramRunner(cpu).runInstructions(1);
+    expect(cpu.pc).toEqual(1);
