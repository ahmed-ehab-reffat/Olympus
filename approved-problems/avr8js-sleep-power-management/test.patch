+import { describe, expect, it } from 'vitest';
+import * as avr8js from '../index';
+import { asmProgram, TestProgramRunner } from '../utils/test-utils';
+
+const { CPU, AVRADC, AVRIOPort, AVRPower, AVRSPI, AVRTimer, AVRUSART, AVRWatchdog } = avr8js;
+const { adcConfig, portBConfig, portDConfig, powerConfig, spiConfig } = avr8js;
+const { timer0Config, timer1Config, timer2Config, usart0Config, watchdogConfig } = avr8js;
+const { AVRClock, clockConfig } = avr8js;
+
+const SREG = 95;
+const SMCR = 0x53;
+const PRR = 0x64;
+
+const TIFR0 = 0x35;
+const TCCR0B = 0x45;
+const TCNT0 = 0x46;
+const TIMSK0 = 0x6e;
+const TIMER0_OVF = 0x20;
+
+const TCNT1 = 0x84;
+const TCCR1B = 0x81;
+const TIMSK1 = 0x6f;
+const TIMER1_OVF = 0x1a;
+
+const TCNT2 = 0xb2;
+const TCCR2B = 0xb1;
+const TIMSK2 = 0x70;
+const TIMER2_OVF = 0x12;
+
+const ADMUX = 0x7c;
+const ADCSRA = 0x7a;
+const ADC_VECTOR = 0x2a;
+const ADEN = 0x80;
+const ADSC = 0x40;
+const ADIE = 0x8;
+
+const EICRA = 0x69;
+const EIMSK = 0x3d;
+const INT0_VECTOR = 2;
+const PCICR = 0x68;
+const PCMSK0 = 0x6b;
+const PCINT0_VECTOR = 6;
+
+const WDTCSR = 0x60;
+const WATCHDOG_VECTOR = 0x0c;
+
+const SPCR = 0x4c;
+const SPSR = 0x4d;
+const SPDR = 0x4e;
+const UCSRA = 0xc0;
+const UCSRB = 0xc1;
+const UBRRL = 0xc4;
+
+const IDLE = 0;
+const ADC_NOISE_REDUCTION = 1;
+const POWER_DOWN = 2;
+const POWER_SAVE = 3;
+const STANDBY = 6;
+const EXTENDED_STANDBY = 7;
+
+const SE = 1;
+const ASSR = 0xb6;
+const AS2 = 0x20;
+const MCUCR = 0x35;
+const ATTINY_PRR = 0x20;
+
+function smcr(mode: number) {
+  return SE | (mode << 1);
+}
+
+function buildCpu(source = 'SLEEP\nNOP\nNOP\nNOP') {
+  const { program } = asmProgram(source);
+  const progMem = new Uint16Array(0x1000);
+  progMem.set(program);
+  return new CPU(progMem);
+}
+
+function sleepingCpu(mode: number, source?: string) {
+  const cpu = buildCpu(source);
+  const power = new AVRPower(cpu);
+  return { cpu, power, enter: () => cpu.writeData(SMCR, smcr(mode)) };
+}
+
+function startTimer0(cpu: InstanceType<typeof CPU>, tcnt = 0) {
+  const timer = new AVRTimer(cpu, timer0Config);
+  cpu.writeData(TCCR0B, 1);
+  cpu.writeData(TIMSK0, 1);
+  cpu.writeData(TCNT0, tcnt);
+  return timer;
+}
+
+function runSleeping(cpu: InstanceType<typeof CPU>, steps: number) {
+  const runner = new TestProgramRunner(cpu);
+  for (let i = 0; i < steps; i++) {
+    runner.runInstructions(1);
+  }
+}
+
+function settleTimer(cpu: InstanceType<typeof CPU>, at = 1) {
+  cpu.cycles = at;
+  cpu.tick();
+}
+
