+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+
+if [ -z "$OUTPUT_PATH" ]; then
+  OUTPUT_PATH="/tmp/avr8js_${MODE}.xml"
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+NEW_TEST="src/peripherals/sleep_546ad4.spec.ts"
+
+if [ "$MODE" = "new" ]; then
+  ./node_modules/.bin/vitest run --reporter=junit --outputFile="$OUTPUT_PATH" "$NEW_TEST"
+  exit $?
+else
+  ./node_modules/.bin/vitest run --reporter=junit --outputFile="$OUTPUT_PATH" \
+    --exclude "$NEW_TEST" --exclude "**/node_modules/**" --exclude "**/dist/**"
+  exit $?
+fi
