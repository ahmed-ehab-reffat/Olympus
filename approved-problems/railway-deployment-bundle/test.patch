+#[test]
+fn deployment_plan_default_selection_matches_ordinary_upload() {
+    let temp = tempdir().unwrap();
+    let root = temp.path();
+    fs::create_dir(root.join(".git")).unwrap();
+    fs::create_dir(root.join("node_modules")).unwrap();
+    fs::create_dir(root.join("src")).unwrap();
+    fs::write(root.join(".git/config"), "private").unwrap();
+    fs::write(root.join("node_modules/dependency.js"), "private").unwrap();
+    fs::write(root.join(".gitignore"), "ignored.log\n").unwrap();
+    fs::write(root.join(".railwayignore"), "secret.env\n").unwrap();
+    fs::write(root.join("ignored.log"), "ignored").unwrap();
+    fs::write(root.join("secret.env"), "secret").unwrap();
+    fs::write(root.join("src/app.rs"), "fn main() {}\n").unwrap();
+
+    let ordinary = upload::create_deploy_tarball(root, root, false, |_, _| {}).unwrap();
+    let plan_path = root.join("deploy-plan.json");
+    let planned = create_deploy_plan(root, root, Some(&plan_path), false, true).unwrap();
+    fs::write(&plan_path, serialize_deploy_plan(&planned).unwrap()).unwrap();
+    let verified =
+        create_deploy_tarball_from_plan(root, root, Some(&plan_path), false, true, &planned)
+            .unwrap();
+
+    let (ordinary_paths, ordinary_files, _) = decode_archive(ordinary);
+    let (verified_paths, verified_files, _) = decode_archive(verified);
+    assert_eq!(
+        without_selected_root(ordinary_paths),
+        without_selected_root(verified_paths)
+    );
+    assert_eq!(ordinary_files, verified_files);
+    assert!(
+        !planned.entries.iter().any(|entry| {
+            entry.path == "deploy-plan.json"
+                || entry.path == "ignored.log"
+                || entry.path == "secret.env"
+                || entry.path.starts_with(".git/")
+                || entry.path.starts_with("node_modules/")
+        }),
+        "the plan must use ordinary selection and exclude its own output"
+    );
+}
