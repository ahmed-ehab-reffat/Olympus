new file mode 100755
index 0000000..43d2007
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,223 @@
+#!/usr/bin/env bash
+#
+# Usage: ./test.sh [--output_path PATH] <base|new>
+#   base runs Railway's pre-existing tests without grader-only features.
+#   new  runs only the deployment-plan grader tests.
+
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+RUNNER_LOG=""
+
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="${2-}"
+            shift 2
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#*=}"
+            shift
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+cd "$(dirname "$0")" || exit 2
+
+write_fallback_junit() {
+    local status="$1"
+    local output="$2"
+    local log="${3-}"
+    local diagnostics=""
+    local parsed_tests=0
+    local parsed_failures=0
+    local parsed_skips=0
+    local classname=""
+    local testname=""
+    case "$MODE" in
+        base)
+            classname="railwayapp::bin/railway"
+            testname="cli_tests.backwards_compat.root_commands_exist"
+            ;;
+        new)
+            classname="railwayapp::deployment_plan_cli"
+            testname="deployment_plan_write_is_offline_deterministic_and_self_excluding"
+            ;;
+        *)
+            classname="$MODE"
+            testname="run"
+            ;;
+    esac
+    if [ -n "$log" ] && [ -f "$log" ]; then
+        parsed_tests="$(grep -Ec '^test .* \.\.\. (ok|FAILED|ignored)$' "$log" || true)"
+        parsed_failures="$(grep -Ec '^test .* \.\.\. FAILED$' "$log" || true)"
+        parsed_skips="$(grep -Ec '^test .* \.\.\. ignored$' "$log" || true)"
+        diagnostics="$(
+            sed \
+                -e 's/&/\&amp;/g' \
+                -e 's/</\&lt;/g' \
+                -e 's/>/\&gt;/g' \
+                "$log"
+        )"
+    fi
+    mkdir -p "$(dirname "$output")"
+    if [ "$parsed_tests" -gt 0 ]; then
+        {
+            printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?>'
+            printf '<testsuites tests="%s" failures="%s" errors="0" skipped="%s">\n' \
+                "$parsed_tests" "$parsed_failures" "$parsed_skips"
+            printf '  <testsuite name="%s" tests="%s" failures="%s" errors="0" skipped="%s">\n' \
+                "$MODE" "$parsed_tests" "$parsed_failures" "$parsed_skips"
+            while IFS= read -r result; do
+                local name="${result#test }"
+                local outcome=""
+                case "$name" in
+                    *" ... ok")
+                        name="${name% ... ok}"
+                        outcome="ok"
+                        ;;
+                    *" ... FAILED")
+                        name="${name% ... FAILED}"
+                        outcome="failed"
+                        ;;
+                    *" ... ignored")
+                        name="${name% ... ignored}"
+                        outcome="ignored"
+                        ;;
+                esac
+                name="$(
+                    printf '%s' "$name" |
+                        sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+                )"
+                printf '    <testcase name="%s" classname="railwayapp">\n' "$name"
+                case "$outcome" in
+                    failed)
+                        printf '      <failure message="cargo test reported failure" type="test"/>\n'
+                        ;;
+                    ignored)
+                        printf '      <skipped/>\n'
+                        ;;
+                esac
+                printf '    </testcase>\n'
+            done < <(grep -E '^test .* \.\.\. (ok|FAILED|ignored)$' "$log")
+            printf '    <system-out>%s</system-out>\n' "$diagnostics"
+            printf '  </testsuite>\n</testsuites>\n'
+        } >"$output"
+        return
+    fi
+    cat >"$output" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="1" errors="0" skipped="0">
+  <testsuite name="$MODE" tests="1" failures="1" errors="0" skipped="0">
+    <testcase name="$testname" classname="$classname">
+      <failure message="test runner exited with status $status and produced no per-test JUnit" type="runner">$diagnostics</failure>
+      <system-out>$diagnostics</system-out>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+}
+
+run_and_capture() {
+    : >"$RUNNER_LOG"
+    "$@" 2>&1 | tee "$RUNNER_LOG"
+    return "${PIPESTATUS[0]}"
+}
+
+if [ -z "$MODE" ]; then
+    echo "usage: $0 [--output_path PATH] <base|new>" >&2
+    if [ -n "$OUTPUT_PATH" ]; then
+        MODE="invalid"
+        write_fallback_junit 2 "$OUTPUT_PATH" ""
+    fi
+    exit 2
+fi
+
+RUNNER_LOG="$(mktemp "${TMPDIR:-/tmp}/railway-test-run.XXXXXX")"
+trap 'rm -f -- "$RUNNER_LOG"' EXIT
+
+GRADER_CFG="--check-cfg=cfg(deployment_plan_tests)"
+if [ "$MODE" = "new" ]; then
+    GRADER_CFG="$GRADER_CFG --cfg deployment_plan_tests"
+fi
+export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }$GRADER_CFG"
+
+if [ -n "$OUTPUT_PATH" ]; then
+    rm -f -- "$OUTPUT_PATH"
+fi
+find target -path '*/nextest/*/junit.xml' -type f -delete 2>/dev/null
+
+CARGO=(cargo)
+if [ -n "${RAILWAY_TEST_TOOLCHAIN-}" ]; then
+    CARGO=(cargo "+${RAILWAY_TEST_TOOLCHAIN}")
+elif command -v rustup >/dev/null 2>&1 &&
+    rustup toolchain list | grep -Eq '^1\.88\.0(-|[[:space:]])'; then
+    CARGO=(cargo +1.88.0)
+fi
+
+STATUS=0
+if "${CARGO[@]}" nextest --version >/dev/null 2>&1; then
+    case "$MODE" in
+        base)
+            run_and_capture "${CARGO[@]}" nextest run \
+                --profile default \
+                --no-fail-fast \
+                --locked \
+                --offline \
+                -E 'not (test(deploy_plan) | test(deployment_plan) | test(up_plan))'
+            STATUS=$?
+            ;;
+        new)
+            run_and_capture "${CARGO[@]}" nextest run \
+                --profile default \
+                --no-fail-fast \
+                --locked \
+                --offline \
+                -E 'test(deployment_plan_)'
+            STATUS=$?
+            ;;
+    esac
+else
+    echo "cargo-nextest unavailable; using cargo test" >&2
+    case "$MODE" in
+        base)
+            run_and_capture "${CARGO[@]}" test \
+                --locked \
+                --offline \
+                --no-fail-fast \
+                -- \
+                --skip deploy_plan \
+                --skip deployment_plan \
+                --skip up_plan
+            STATUS=$?
+            ;;
+        new)
+            run_and_capture "${CARGO[@]}" test \
+                --locked \
+                --offline \
+                --no-fail-fast \
+                deployment_plan_
+            STATUS=$?
+            ;;
+    esac
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+    JUNIT_SOURCE="$(find target -path '*/nextest/*/junit.xml' -type f 2>/dev/null | head -1)"
+    if [ -n "$JUNIT_SOURCE" ] && [ -f "$JUNIT_SOURCE" ]; then
+        mkdir -p "$(dirname "$OUTPUT_PATH")"
+        cp "$JUNIT_SOURCE" "$OUTPUT_PATH"
+    else
+        write_fallback_junit "$STATUS" "$OUTPUT_PATH" "$RUNNER_LOG"
+    fi
+fi
+
+exit "$STATUS"
