new file mode 100644
index 0000000..2ace276
--- /dev/null
+++ b/tests/deployment_plan_cli.rs
@@ -0,0 +1,963 @@
+#![cfg(deployment_plan_tests)]
+
+use std::{
+    fs,
+    io::{Cursor, Read},
+    net::TcpListener,
+    path::Path,
+    process::{Child, Command, Output, Stdio},
+    sync::mpsc::{self, Sender},
+    thread,
+    time::{Duration, Instant},
+};
+
+use flate2::read::GzDecoder;
+use tempfile::tempdir;
+
+const UPLOAD_CAPTURE_PROXY: &str = r#"
+import json
+import socket
+import ssl
+import sys
+
+certificate, key, ready, capture, source = sys.argv[1:]
+context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+context.load_cert_chain(certificate, key)
+listener = socket.socket()
+listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+listener.bind(("127.0.0.1", 0))
+listener.listen()
+with open(ready, "w", encoding="utf-8") as output:
+    output.write(str(listener.getsockname()[1]))
+
+project = {
+    "data": {
+        "project": {
+            "id": "offline-probe",
+            "name": "Offline Probe",
+            "workspaceId": "workspace",
+            "deletedAt": None,
+            "workspace": {"name": "Workspace"},
+            "buckets": {"edges": []},
+            "environments": {
+                "edges": [{
+                    "node": {
+                        "id": "offline-environment",
+                        "name": "offline-environment",
+                        "canAccess": True,
+                        "deletedAt": None,
+                        "unmergedChangesCount": 0
+                    }
+                }]
+            },
+            "services": {"edges": []}
+        }
+    }
+}
+uploaded = {
+    "deploymentId": "deployment",
+    "url": "https://example.invalid",
+    "logsUrl": "https://example.invalid/logs",
+    "deploymentDomain": "example.invalid"
+}
+mutated = False
+done = False
+
+def read_headers(stream):
+    request = stream.readline()
+    if not request:
+        return None
+    headers = {}
+    while True:
+        line = stream.readline()
+        if line in (b"\r\n", b"\n", b""):
+            break
+        name, value = line.decode("iso-8859-1").split(":", 1)
+        headers[name.lower()] = value.strip()
+    return request.decode("iso-8859-1").strip().split(" "), headers
+
+while not done:
+    connection, _ = listener.accept()
+    plain = connection.makefile("rb", buffering=0)
+    connect = read_headers(plain)
+    if connect is None:
+        connection.close()
+        continue
+    connection.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
+    try:
+        tls = context.wrap_socket(connection, server_side=True)
+        stream = tls.makefile("rb")
+        while not done:
+            parsed = read_headers(stream)
+            if parsed is None:
+                break
+            request, headers = parsed
+            method, path, _ = request
+            length = int(headers.get("content-length", "0"))
+            body = stream.read(length)
+            if path == "/graphql/v2":
+                if not mutated:
+                    with open(source, "wb") as changed:
+                        changed.write(b"changed\n")
+                    mutated = True
+                response = json.dumps(project).encode()
+            elif "/up" in path:
+                with open(capture, "wb") as output:
+                    output.write(body)
+                response = json.dumps(uploaded).encode()
+                done = True
+            else:
+                response = b'{"message":"unexpected request"}'
+            tls.sendall(
+                b"HTTP/1.1 200 OK\r\n"
+                + b"Content-Type: application/json\r\n"
+                + b"Content-Length: " + str(len(response)).encode() + b"\r\n"
+                + b"Connection: close\r\n\r\n"
+                + response
+            )
+            break
+    except (ConnectionError, ssl.SSLError):
+        pass
+    finally:
+        connection.close()
+
+listener.close()
+"#;
+
+enum ProxyCommand {
+    Snapshot(Sender<usize>),
+    Stop,
+}
+
+struct CountingProxy {
+    address: String,
+    commands: Sender<ProxyCommand>,
+    thread: Option<thread::JoinHandle<()>>,
+}
+
+impl CountingProxy {
+    fn new() -> Self {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let address = format!("http://{}", listener.local_addr().unwrap());
+        let (commands, command_rx) = mpsc::channel();
+        let thread = thread::spawn(move || {
+            let mut connections = 0;
+            let drain_connections = |connections: &mut usize| loop {
+                match listener.accept() {
+                    Ok((_socket, _)) => *connections += 1,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => break,
+                    Err(error) => panic!("counting proxy failed: {error}"),
+                }
+            };
+            loop {
+                drain_connections(&mut connections);
+                match command_rx.recv_timeout(Duration::from_millis(5)) {
+                    Ok(ProxyCommand::Snapshot(reply)) => {
+                        drain_connections(&mut connections);
+                        reply.send(connections).unwrap();
+                    }
+                    Ok(ProxyCommand::Stop) | Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                    Err(mpsc::RecvTimeoutError::Timeout) => {}
+                }
+            }
+        });
+        Self {
+            address,
+            commands,
+            thread: Some(thread),
+        }
+    }
+
+    fn count(&self) -> usize {
+        let (reply, result) = mpsc::channel();
+        self.commands
+            .send(ProxyCommand::Snapshot(reply))
+            .expect("counting proxy stopped before snapshot");
+        result
+            .recv_timeout(Duration::from_secs(5))
+            .expect("counting proxy did not complete snapshot")
+    }
+}
+
+impl Drop for CountingProxy {
+    fn drop(&mut self) {
+        self.commands.send(ProxyCommand::Stop).unwrap();
+        self.thread.take().unwrap().join().unwrap();
+    }
+}
+
+struct UploadCaptureProxy {
+    address: String,
+    capture: std::path::PathBuf,
+    process: Child,
+}
+
+impl UploadCaptureProxy {
+    fn new(root: &Path, source: &Path) -> Self {
+        let script = root.join("capture-proxy.py");
+        let certificate = root.join("capture-cert.pem");
+        let key = root.join("capture-key.pem");
+        let ready = root.join("capture-ready");
+        let capture = root.join("captured-upload.tar.gz");
+        fs::write(&script, UPLOAD_CAPTURE_PROXY).unwrap();
+        let generated = Command::new("openssl")
+            .args(["req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout"])
+            .arg(&key)
+            .args(["-out"])
+            .arg(&certificate)
+            .args(["-subj", "/CN=backboard.railway-develop.com", "-days", "1"])
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status()
+            .expect("failed to invoke openssl for the upload-capture proxy");
+        assert!(
+            generated.success(),
+            "failed to create upload-capture TLS key"
+        );
+
+        let process = Command::new("python3")
+            .arg(&script)
+            .arg(&certificate)
+            .arg(&key)
+            .arg(&ready)
+            .arg(&capture)
+            .arg(source)
+            .stdout(Stdio::null())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .expect("failed to start upload-capture proxy");
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let port = loop {
+            if let Ok(port) = fs::read_to_string(&ready)
+                && port.trim().parse::<u16>().is_ok()
+            {
+                break port;
+            }
+            assert!(
+                Instant::now() < deadline,
+                "upload-capture proxy did not become ready"
+            );
+            thread::sleep(Duration::from_millis(5));
+        };
+        Self {
+            address: format!("http://127.0.0.1:{}", port.trim()),
+            capture,
+            process,
+        }
+    }
+
+    fn captured_body(&self) -> Vec<u8> {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        while !self.capture.exists() {
+            assert!(
+                Instant::now() < deadline,
+                "valid apply did not submit an upload body"
+            );
+            thread::sleep(Duration::from_millis(5));
+        }
+        fs::read(&self.capture).unwrap()
+    }
+}
+
+impl Drop for UploadCaptureProxy {
+    fn drop(&mut self) {
+        if self.process.try_wait().unwrap().is_none() {
+            self.process.kill().unwrap();
+        }
+        self.process.wait().unwrap();
+    }
+}
+
+fn run_with_auth_mode(
+    fixture: &Path,
+    proxy: &CountingProxy,
+    args: &[&str],
+    api_token: bool,
+) -> Output {
+    run_with_options(fixture, proxy, args, api_token, true)
+}
+
+fn run_without_network_opt_outs(
+    fixture: &Path,
+    proxy: &CountingProxy,
+    args: &[&str],
+    api_token: bool,
+) -> Output {
+    run_with_options(fixture, proxy, args, api_token, false)
+}
+
+fn run_with_options(
+    fixture: &Path,
+    proxy: &CountingProxy,
+    args: &[&str],
+    api_token: bool,
+    suppress_auxiliary_network: bool,
+) -> Output {
+    run_with_environment(
+        fixture,
+        proxy,
+        args,
+        api_token,
+        suppress_auxiliary_network,
+        &[],
+    )
+}
+
+fn run_with_target_environment(
+    fixture: &Path,
+    proxy: &CountingProxy,
+    args: &[&str],
+    api_token: bool,
+    environment: &[(&str, &str)],
+) -> Output {
+    run_with_environment(fixture, proxy, args, api_token, true, environment)
+}
+
+fn run_with_environment(
+    fixture: &Path,
+    proxy: &CountingProxy,
+    args: &[&str],
+    api_token: bool,
+    suppress_auxiliary_network: bool,
+    environment: &[(&str, &str)],
+) -> Output {
+    run_with_proxy_address(
+        fixture,
+        &proxy.address,
+        args,
+        api_token,
+        suppress_auxiliary_network,
+        environment,
+    )
+}
+
+fn run_with_proxy_address(
+    fixture: &Path,
+    proxy_address: &str,
+    args: &[&str],
+    api_token: bool,
+    suppress_auxiliary_network: bool,
+    environment: &[(&str, &str)],
+) -> Output {
+    let isolated_home = fixture.parent().unwrap().join("home");
+    fs::create_dir_all(&isolated_home).unwrap();
+    let mut command = Command::new(env!("CARGO_BIN_EXE_railway"));
+    command.current_dir(fixture).args(args);
+    for name in [
+        "ALL_PROXY",
+        "HTTPS_PROXY",
+        "HTTP_PROXY",
+        "all_proxy",
+        "https_proxy",
+        "http_proxy",
+    ] {
+        command.env(name, proxy_address);
+    }
+    command
+        .env("NO_PROXY", "")
+        .env("no_proxy", "")
+        .env("HOME", isolated_home)
+        .env_remove("RAILWAY_TOKEN")
+        .env_remove("RAILWAY_PROJECT_ID")
+        .env_remove("RAILWAY_ENVIRONMENT_ID")
+        .env_remove("RAILWAY_SERVICE_ID");
+    if suppress_auxiliary_network {
+        command
+            .env("CI", "1")
+            .env("DO_NOT_TRACK", "1")
+            .env("RAILWAY_NO_AUTO_UPDATE", "1")
+            .env("RAILWAY_NO_TELEMETRY", "1");
+    } else {
+        command
+            .env_remove("CI")
+            .env_remove("DO_NOT_TRACK")
+            .env_remove("RAILWAY_NO_AUTO_UPDATE")
+            .env_remove("RAILWAY_NO_TELEMETRY");
+    }
+    if api_token {
+        command.env("RAILWAY_API_TOKEN", "offline-probe-token");
+    } else {
+        command.env_remove("RAILWAY_API_TOKEN");
+    }
+    command.envs(environment.iter().copied());
+    command.output().unwrap()
+}
+
+fn archived_file(body: Vec<u8>, wanted: &str) -> Vec<u8> {
+    let mut archive = tar::Archive::new(GzDecoder::new(Cursor::new(body)));
+    for entry in archive.entries().unwrap() {
+        let mut entry = entry.unwrap();
+        if entry.path().unwrap() == Path::new(wanted) {
+            let mut bytes = Vec::new();
+            entry.read_to_end(&mut bytes).unwrap();
+            return bytes;
+        }
+    }
+    panic!("upload archive omitted {wanted}");
+}
+
+fn run(fixture: &Path, proxy: &CountingProxy, args: &[&str]) -> Output {
+    run_with_auth_mode(fixture, proxy, args, true)
+}
+
+fn write_expired_oauth_config(root: &Path) {
+    let config_dir = root.join("home/.railway");
+    fs::create_dir_all(&config_dir).unwrap();
+    fs::write(
+        config_dir.join("config.json"),
+        serde_json::to_vec(&serde_json::json!({
+            "projects": {},
+            "user": {
+                "accessToken": "expired-access-token",
+                "refreshToken": "refresh-token",
+                "tokenExpiresAt": 0
+            }
+        }))
+        .unwrap(),
+    )
+    .unwrap();
+}
+
+fn output_text(output: &Output) -> String {
+    format!(
+        "stdout:\n{}\nstderr:\n{}",
+        String::from_utf8_lossy(&output.stdout),
+        String::from_utf8_lossy(&output.stderr)
+    )
+}
