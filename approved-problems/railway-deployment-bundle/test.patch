+#[test]
+fn deployment_plan_service_prefix_and_path_as_root_modes_are_preserved() {
+    let temp = tempdir().unwrap();
+    let workspace = temp.path().join("workspace");
+    let service = workspace.join("services/api");
+    fs::create_dir_all(&service).unwrap();
+    fs::write(service.join("-hello.txt"), "sorts before the root marker").unwrap();
+    fs::write(service.join("app.txt"), "content").unwrap();
+
+    let prefixed = create_deploy_plan(&service, &workspace, None, false, false).unwrap();
+    assert_eq!(
+        prefixed
+            .entries
+            .iter()
+            .map(|entry| entry.path.as_str())
+            .collect::<Vec<_>>(),
+        [
+            "services/api",
+            "services/api/-hello.txt",
+            "services/api/app.txt",
+        ]
+    );
+    assert_eq!(
+        normalized_paths(
+            decode_archive(
+                create_deploy_tarball_from_plan(
+                    &service, &workspace, None, false, false, &prefixed,
+                )
+                .unwrap(),
+            )
+            .0,
+        ),
+        [
+            "services/api",
+            "services/api/-hello.txt",
+            "services/api/app.txt",
+        ]
+    );
+
+    let rooted = create_deploy_plan(&service, &service, None, false, true).unwrap();
+    assert_eq!(
+        rooted
+            .entries
+            .iter()
+            .map(|entry| entry.path.as_str())
+            .collect::<Vec<_>>(),
+        ["-hello.txt", ".", "app.txt"]
+    );
+    let ordinary_rooted_paths = normalized_paths(
+        decode_archive(
+            upload::create_deploy_tarball(&service, &service, false, |_, _| {}).unwrap(),
+        )
+        .0,
+    );
+    assert_eq!(ordinary_rooted_paths, ["-hello.txt", ".", "app.txt"]);
+    assert_eq!(
+        normalized_paths(
+            decode_archive(
+                create_deploy_tarball_from_plan(&service, &service, None, false, true, &rooted,)
+                    .unwrap(),
+            )
+            .0,
+        ),
+        ["-hello.txt", ".", "app.txt"]
+    );
+}
