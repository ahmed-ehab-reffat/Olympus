+#[test]
+fn deployment_plan_parser_rejects_unknown_fields_and_unsupported_versions() {
+    let temp = tempdir().unwrap();
+    fs::write(temp.path().join("app"), "content").unwrap();
+    let planned = plan(temp.path());
+
+    let mut unknown: serde_json::Value =
+        serde_json::from_slice(&serialize_deploy_plan(&planned).unwrap()).unwrap();
+    unknown
+        .as_object_mut()
+        .unwrap()
+        .insert("unexpected".to_owned(), serde_json::Value::Bool(true));
+    let plan_path = temp.path().join("plan.json");
+    fs::write(&plan_path, serde_json::to_vec(&unknown).unwrap()).unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut unknown_entry: serde_json::Value =
+        serde_json::from_slice(&serialize_deploy_plan(&planned).unwrap()).unwrap();
+    unknown_entry["entries"][0]
+        .as_object_mut()
+        .unwrap()
+        .insert("unexpected".to_owned(), serde_json::Value::Bool(true));
+    fs::write(&plan_path, serde_json::to_vec(&unknown_entry).unwrap()).unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut unsupported_value: serde_json::Value =
+        serde_json::from_slice(&serialize_deploy_plan(&planned).unwrap()).unwrap();
+    unsupported_value["version"] = serde_json::Value::from(planned.version + 1);
+    fs::write(&plan_path, serde_json::to_vec(&unsupported_value).unwrap()).unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut unsupported = planned;
+    unsupported.version += 1;
+    assert!(serialize_deploy_plan(&unsupported).is_err());
+}
