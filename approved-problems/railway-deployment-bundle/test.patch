+#[test]
+fn deployment_plan_cli_source_root_matches_link_and_explicit_project_resolution() {
+    let temp = tempdir().unwrap();
+    let root = temp.path().join("linked-root");
+    let service = root.join("service");
+    let home = root.join("home");
+    fs::create_dir_all(&service).unwrap();
+    fs::create_dir_all(home.join(".railway")).unwrap();
+    let root = fs::canonicalize(root).unwrap();
+    let service = root.join("service");
+    let home = root.join("home");
+    fs::write(root.join("root.txt"), "root").unwrap();
+    fs::write(service.join("app.txt"), "service").unwrap();
+    let mut projects = serde_json::Map::new();
+    projects.insert(
+        root.to_string_lossy().into_owned(),
+        serde_json::json!({
+            "projectPath": root,
+            "project": "linked-project"
+        }),
+    );
+    fs::write(
+        home.join(".railway/config.json"),
+        serde_json::to_vec(&serde_json::json!({
+            "projects": projects,
+            "user": {
+                "accessToken": "expired-access-token",
+                "refreshToken": "refresh-token",
+                "tokenExpiresAt": 0
+            }
+        }))
+        .unwrap(),
+    )
+    .unwrap();
+    let proxy = CountingProxy::new();
+
+    let linked = run_with_auth_mode(
+        &service,
+        &proxy,
+        &["up", "--write-plan", "linked-plan.json", "--json"],
+        false,
+    );
+    assert!(linked.status.success(), "{}", output_text(&linked));
+    let linked_plan: serde_json::Value =
+        serde_json::from_slice(&fs::read(service.join("linked-plan.json")).unwrap()).unwrap();
+    let linked_paths = linked_plan["entries"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter_map(|entry| entry["path"].as_str())
+        .collect::<Vec<_>>();
+    assert!(
+        linked_paths.contains(&"root.txt"),
+        "{linked_paths:?}\n{}",
+        output_text(&linked)
+    );
+    assert!(
+        linked_paths.contains(&"service/app.txt"),
+        "{linked_paths:?}\n{}",
+        output_text(&linked)
+    );
+    assert_eq!(proxy.count(), 0);
+
+    let before_linked_apply = proxy.count();
+    let linked_apply = run_with_auth_mode(
+        &service,
+        &proxy,
+        &["up", "--from-plan", "linked-plan.json", "--json"],
+        false,
+    );
+    assert!(
+        !linked_apply.status.success(),
+        "{}",
+        output_text(&linked_apply)
+    );
+    assert!(
+        proxy.count() > before_linked_apply,
+        "linked-root apply did not finish local reconciliation\n{}",
+        output_text(&linked_apply)
+    );
+
+    fs::remove_file(service.join("linked-plan.json")).unwrap();
+    let before_explicit_write = proxy.count();
+    let explicit = run_with_auth_mode(
+        &service,
+        &proxy,
+        &[
+            "up",
+            "--project",
+            "explicit-project",
+            "--environment",
+            "explicit-environment",
+            "--write-plan",
+            "explicit-plan.json",
+            "--json",
+        ],
+        false,
+    );
+    assert!(explicit.status.success(), "{}", output_text(&explicit));
+    let explicit_plan: serde_json::Value =
+        serde_json::from_slice(&fs::read(service.join("explicit-plan.json")).unwrap()).unwrap();
+    let explicit_paths = explicit_plan["entries"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter_map(|entry| entry["path"].as_str())
+        .collect::<Vec<_>>();
+    assert!(explicit_paths.contains(&"."));
+    assert!(explicit_paths.contains(&"app.txt"));
+    assert!(!explicit_paths.contains(&"root.txt"));
+    assert!(!explicit_paths.contains(&"service/app.txt"));
+    assert_eq!(
+        proxy.count(),
+        before_explicit_write,
+        "explicit-project planning attempted a request"
+    );
+
+    let explicit_args = [
+        "up",
+        "--project",
+        "explicit-project",
+        "--environment",
+        "explicit-environment",
+        "--from-plan",
+        "explicit-plan.json",
+        "--json",
+    ];
+    let before_explicit_apply = proxy.count();
+    let explicit_apply = run_with_auth_mode(&service, &proxy, &explicit_args, true);
+    assert!(
+        !explicit_apply.status.success(),
+        "{}",
+        output_text(&explicit_apply)
+    );
+    assert!(
+        proxy.count() > before_explicit_apply,
+        "explicit-project apply did not finish local reconciliation\n{}",
+        output_text(&explicit_apply)
+    );
+
+    let before_token_apply = proxy.count();
+    let token_apply = run_with_target_environment(
+        &service,
+        &proxy,
+        &["up", "--from-plan", "explicit-plan.json", "--json"],
+        false,
+        &[("RAILWAY_TOKEN", "project-token")],
+    );
+    assert!(
+        !token_apply.status.success(),
+        "{}",
+        output_text(&token_apply)
+    );
+    assert!(
+        proxy.count() > before_token_apply,
+        "project-token apply did not use the current-directory source root\n{}",
+        output_text(&token_apply)
+    );
+
+    let before_environment_apply = proxy.count();
+    let environment_apply = run_with_target_environment(
+        &service,
+        &proxy,
+        &["up", "--from-plan", "explicit-plan.json", "--json"],
+        true,
+        &[
+            ("RAILWAY_PROJECT_ID", "environment-project"),
+            ("RAILWAY_ENVIRONMENT_ID", "environment"),
+        ],
+    );
+    assert!(
+        !environment_apply.status.success(),
+        "{}",
+        output_text(&environment_apply)
+    );
+    assert!(
+        proxy.count() > before_environment_apply,
+        "environment-targeted apply did not use the current-directory source root\n{}",
+        output_text(&environment_apply)
+    );
+
+    fs::write(service.join("app.txt"), "changed").unwrap();
+    let before_changed_apply = proxy.count();
+    let changed_apply = run_with_auth_mode(&service, &proxy, &explicit_args, true);
+    assert!(
+        !changed_apply.status.success(),
+        "{}",
+        output_text(&changed_apply)
+    );
+    assert_eq!(
+        proxy.count(),
+        before_changed_apply,
+        "changed explicit-project input reached the network"
+    );
+}
