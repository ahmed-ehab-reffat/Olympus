+fn deployment_plan_verified_archive_uses_plan_paths_bytes_and_hashes() {
+    let temp = tempdir().unwrap();
+    fs::create_dir(temp.path().join("dir")).unwrap();
+    fs::write(temp.path().join("alpha"), "alpha").unwrap();
+    fs::write(temp.path().join("dir/beta"), "beta").unwrap();
