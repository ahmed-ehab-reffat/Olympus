+            .unwrap();
+    let (paths, files, _) = decode_archive(body);
+    assert_eq!(
+        normalized_paths(paths),
+        normalized_paths(
+            planned
+                .entries
+                .iter()
+                .map(|entry| entry.path.clone())
+                .collect::<Vec<_>>()
+        )
+    );
+    for entry in planned
+        .entries
+        .iter()
+        .filter(|entry| matches!(&entry.kind, DeployEntryKind::File))
+    {
+        let bytes = files
+            .get(&entry.path)
+            .unwrap_or_else(|| panic!("archive omitted {}", entry.path));
+        assert_eq!(entry.size, bytes.len() as u64);
+        assert_eq!(entry.sha256.as_deref(), Some(sha256(bytes).as_str()));
+    }
+}
