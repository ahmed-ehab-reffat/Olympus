+use std::{
+    collections::BTreeMap,
+    fs,
+    io::{Cursor, Read},
+    path::Path,
+};
+
+use flate2::read::GzDecoder;
+use sha2::{Digest, Sha256};
+use tempfile::tempdir;
+
+use crate::controllers::{
+    deploy_plan::{
+        DeployEntryKind, DeployPlan, create_deploy_plan, create_deploy_tarball_from_plan,
+        read_deploy_plan, serialize_deploy_plan,
+    },
+    upload,
+};
+
+type DecodedArchive = (
+    Vec<String>,
+    BTreeMap<String, Vec<u8>>,
+    BTreeMap<String, u32>,
+);
+
+fn plan(root: &Path) -> DeployPlan {
+    create_deploy_plan(root, root, None, false, true).unwrap()
+}
+
+fn sha256(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+
+fn decode_archive(body: Vec<u8>) -> DecodedArchive {
+    let mut archive = tar::Archive::new(GzDecoder::new(Cursor::new(body)));
+    let mut paths = Vec::new();
+    let mut files = BTreeMap::new();
+    let mut modes = BTreeMap::new();
+    for entry in archive.entries().unwrap() {
+        let mut entry = entry.unwrap();
+        let path = entry.path().unwrap().to_string_lossy().into_owned();
+        paths.push(path.clone());
+        modes.insert(path.clone(), entry.header().mode().unwrap() & 0o7777);
+        if entry.header().entry_type().is_file() {
+            let mut bytes = Vec::new();
+            entry.read_to_end(&mut bytes).unwrap();
+            files.insert(path, bytes);
+        }
+    }
+    (paths, files, modes)
+}
+
+fn normalized_paths(paths: Vec<String>) -> Vec<String> {
+    let mut paths = paths
+        .into_iter()
+        .map(|path| path.trim_end_matches('/').to_owned())
+        .collect::<Vec<_>>();
+    paths.sort();
+    paths
+}
+
+fn without_selected_root(paths: Vec<String>) -> Vec<String> {
+    normalized_paths(paths)
+        .into_iter()
+        .filter(|path| path != ".")
+        .collect()
+}
