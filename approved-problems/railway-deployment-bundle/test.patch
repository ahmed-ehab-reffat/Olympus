+#[test]
+fn deployment_plan_parser_rejects_unsorted_duplicate_and_invalid_entry_records() {
+    let temp = tempdir().unwrap();
+    fs::create_dir(temp.path().join("directory")).unwrap();
+    fs::write(temp.path().join("a"), "a").unwrap();
+    fs::write(temp.path().join("b"), "b").unwrap();
+
+    let mut unsorted = plan(temp.path());
+    unsorted.entries.reverse();
+    assert!(serialize_deploy_plan(&unsorted).is_err());
+
+    let mut duplicate = plan(temp.path());
+    let file_indices = duplicate
+        .entries
+        .iter()
+        .enumerate()
+        .filter(|(_, entry)| matches!(&entry.kind, DeployEntryKind::File))
+        .map(|(index, _)| index)
+        .collect::<Vec<_>>();
+    assert_eq!(file_indices.len(), 2);
+    let duplicate_path = duplicate.entries[file_indices[0]].path.clone();
+    duplicate.entries[file_indices[1]].path = duplicate_path;
+    assert!(serialize_deploy_plan(&duplicate).is_err());
+
+    let plan_path = temp.path().join("candidate-plan.json");
+    let valid_value: serde_json::Value =
+        serde_json::from_slice(&serialize_deploy_plan(&plan(temp.path())).unwrap()).unwrap();
+
+    let mut unsorted_value = valid_value.clone();
+    unsorted_value["entries"].as_array_mut().unwrap().reverse();
+    fs::write(&plan_path, serde_json::to_vec(&unsorted_value).unwrap()).unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut duplicate_value = valid_value.clone();
+    let entries = duplicate_value["entries"].as_array_mut().unwrap();
+    assert!(entries.len() >= 2);
+    entries[1] = entries[0].clone();
+    fs::write(&plan_path, serde_json::to_vec(&duplicate_value).unwrap()).unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let file_index = valid_value["entries"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .position(|entry| entry["kind"] == "file")
+        .unwrap();
+
+    let mut missing_digest_value = valid_value.clone();
+    missing_digest_value["entries"][file_index]
+        .as_object_mut()
+        .unwrap()
+        .remove("sha256");
+    fs::write(
+        &plan_path,
+        serde_json::to_vec(&missing_digest_value).unwrap(),
+    )
+    .unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut invalid_digest_value = valid_value.clone();
+    invalid_digest_value["entries"][file_index]["sha256"] =
+        serde_json::Value::String("abcd".to_owned());
+    fs::write(
+        &plan_path,
+        serde_json::to_vec(&invalid_digest_value).unwrap(),
+    )
+    .unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut unknown_kind_value = valid_value;
+    unknown_kind_value["entries"][file_index]["kind"] =
+        serde_json::Value::String("symlink".to_owned());
+    fs::write(&plan_path, serde_json::to_vec(&unknown_kind_value).unwrap()).unwrap();
+    assert!(read_deploy_plan(&plan_path).is_err());
+
+    let mut invalid_digest = plan(temp.path());
+    invalid_digest
+        .entries
+        .iter_mut()
+        .find(|entry| matches!(&entry.kind, DeployEntryKind::File))
+        .unwrap()
+        .sha256 = Some("ABC".to_owned());
+    assert!(serialize_deploy_plan(&invalid_digest).is_err());
+
+    let mut directory_digest = plan(temp.path());
+    directory_digest
+        .entries
+        .iter_mut()
+        .find(|entry| matches!(&entry.kind, DeployEntryKind::Directory))
+        .unwrap()
+        .sha256 = Some("0".repeat(64));
+    assert!(serialize_deploy_plan(&directory_digest).is_err());
+
+    let mut directory_size = plan(temp.path());
+    directory_size
+        .entries
+        .iter_mut()
+        .find(|entry| matches!(&entry.kind, DeployEntryKind::Directory))
+        .unwrap()
+        .size = 1;
+    assert!(serialize_deploy_plan(&directory_size).is_err());
+}
