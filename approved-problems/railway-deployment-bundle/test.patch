+#[test]
+fn deployment_plan_reader_rejects_directory_metadata_and_unsafe_paths() {
+    let temp = tempdir().unwrap();
+    fs::create_dir(temp.path().join("directory")).unwrap();
+    fs::write(temp.path().join("app"), "content").unwrap();
+    let value: serde_json::Value =
+        serde_json::from_slice(&serialize_deploy_plan(&plan(temp.path())).unwrap()).unwrap();
+    let plan_path = temp.path().join("candidate-plan.json");
+    let reject = |value: &serde_json::Value| {
+        fs::write(&plan_path, serde_json::to_vec(value).unwrap()).unwrap();
+        assert!(read_deploy_plan(&plan_path).is_err());
+    };
+
+    let mut directory_digest = value.clone();
+    directory_digest["entries"]
+        .as_array_mut()
+        .unwrap()
+        .iter_mut()
+        .find(|entry| entry["kind"].as_str() == Some("directory"))
+        .unwrap()
+        .as_object_mut()
+        .unwrap()
+        .insert(
+            "sha256".to_owned(),
+            serde_json::Value::String("0".repeat(64)),
+        );
+    reject(&directory_digest);
+
+    let mut directory_size = value.clone();
+    directory_size["entries"]
+        .as_array_mut()
+        .unwrap()
+        .iter_mut()
+        .find(|entry| entry["kind"].as_str() == Some("directory"))
+        .unwrap()
+        .as_object_mut()
+        .unwrap()
+        .insert("size".to_owned(), serde_json::Value::from(1));
+    reject(&directory_size);
+
+    #[cfg(unix)]
+    for kind in ["file", "directory"] {
+        let mut missing_mode = value.clone();
+        missing_mode["entries"]
+            .as_array_mut()
+            .unwrap()
+            .iter_mut()
+            .find(|entry| entry["kind"].as_str() == Some(kind))
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .remove("mode");
+        reject(&missing_mode);
+    }
+
+    for invalid_path in ["/absolute", "../escape", "nested/../escape"] {
+        let mut unsafe_path = value.clone();
+        unsafe_path["entries"]
+            .as_array_mut()
+            .unwrap()
+            .iter_mut()
+            .find(|entry| entry["kind"].as_str() == Some("file"))
+            .unwrap()
+            .as_object_mut()
+            .unwrap()
+            .insert(
+                "path".to_owned(),
+                serde_json::Value::String(invalid_path.to_owned()),
+            );
+        unsafe_path["entries"]
+            .as_array_mut()
+            .unwrap()
+            .sort_by(|left, right| {
+                left["path"]
+                    .as_str()
+                    .unwrap()
+                    .cmp(right["path"].as_str().unwrap())
+            });
+        reject(&unsafe_path);
+    }
+}
+
+#[cfg(unix)]
+#[test]
+fn deployment_plan_file_and_directory_modes_are_preserved_and_verified() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let temp = tempdir().unwrap();
+    fs::create_dir(temp.path().join("directory")).unwrap();
+    fs::write(temp.path().join("executable"), "#!/bin/sh\n").unwrap();
+    fs::set_permissions(
+        temp.path().join("directory"),
+        fs::Permissions::from_mode(0o755),
+    )
+    .unwrap();
+    fs::set_permissions(
+        temp.path().join("executable"),
+        fs::Permissions::from_mode(0o755),
+    )
+    .unwrap();
+    let planned = plan(temp.path());
+    let (_, _, modes) = decode_archive(
+        create_deploy_tarball_from_plan(temp.path(), temp.path(), None, false, true, &planned)
+            .unwrap(),
+    );
+    assert_eq!(modes["directory"], 0o755);
+    assert_eq!(modes["executable"], 0o755);
+
+    fs::set_permissions(
+        temp.path().join("executable"),
+        fs::Permissions::from_mode(0o644),
+    )
+    .unwrap();
+    assert!(
+        create_deploy_tarball_from_plan(temp.path(), temp.path(), None, false, true, &planned)
+            .is_err()
+    );
+
+    fs::set_permissions(
+        temp.path().join("executable"),
+        fs::Permissions::from_mode(0o755),
+    )
+    .unwrap();
+    fs::set_permissions(
+        temp.path().join("directory"),
+        fs::Permissions::from_mode(0o700),
+    )
+    .unwrap();
+    assert!(
+        create_deploy_tarball_from_plan(temp.path(), temp.path(), None, false, true, &planned)
+            .is_err()
+    );
+}
+
+#[cfg(unix)]
+#[test]
+fn deployment_plan_followed_file_and_directory_links_match_ordinary_upload() {
+    use std::os::unix::fs::symlink;
+
+    let temp = tempdir().unwrap();
+    let root = temp.path().join("root");
+    let external_dir = temp.path().join("external-dir");
+    let external_file = temp.path().join("external.txt");
+    fs::create_dir(&root).unwrap();
+    fs::create_dir(&external_dir).unwrap();
+    fs::write(&external_file, "outside").unwrap();
+    fs::write(external_dir.join("nested.txt"), "nested").unwrap();
+    symlink(&external_file, root.join("linked.txt")).unwrap();
+    symlink(&external_dir, root.join("linked-dir")).unwrap();
+
+    let ordinary = upload::create_deploy_tarball(&root, &root, false, |_, _| {}).unwrap();
+    let planned = plan(&root);
+    let verified =
+        create_deploy_tarball_from_plan(&root, &root, None, false, true, &planned).unwrap();
+    let (ordinary_paths, ordinary_files, _) = decode_archive(ordinary);
+    let (verified_paths, verified_files, _) = decode_archive(verified);
+    assert_eq!(
+        without_selected_root(ordinary_paths),
+        without_selected_root(verified_paths)
+    );
+    assert_eq!(ordinary_files, verified_files);
+    assert_eq!(verified_files["linked.txt"], b"outside");
+    assert_eq!(verified_files["linked-dir/nested.txt"], b"nested");
+}
+
+#[cfg(unix)]
+#[test]
+fn deployment_plan_broken_followed_links_are_rejected_in_both_modes() {
+    use std::os::unix::fs::symlink;
+
+    let temp = tempdir().unwrap();
+    symlink(temp.path().join("missing"), temp.path().join("broken")).unwrap();
+    assert!(upload::create_deploy_tarball(temp.path(), temp.path(), false, |_, _| {}).is_err());
+    assert!(create_deploy_plan(temp.path(), temp.path(), None, false, true).is_err());
+}
+#[cfg(target_os = "linux")]
+#[test]
+fn deployment_plan_non_utf8_archive_paths_are_rejected() {
+    use std::{ffi::OsString, os::unix::ffi::OsStringExt};
+
+    let temp = tempdir().unwrap();
+    fs::write(
+        temp.path()
+            .join(OsString::from_vec(b"invalid-\xff".to_vec())),
+        "content",
+    )
+    .unwrap();
+    assert!(create_deploy_plan(temp.path(), temp.path(), None, false, true).is_err());
+}
