+    let fixture = temp.path().join("source");
+    fs::create_dir(&fixture).unwrap();
+    fs::write(fixture.join("app.txt"), "content\n").unwrap();
+    let proxy = CountingProxy::new();
+
+    let write = run(
+        &fixture,
+        &proxy,
+        &[
+            "up",
+            "--project",
+            "offline-probe",
+            "--environment",
+            "offline-environment",
+            "--write-plan",
+            "plan.json",
+            "--json",
+        ],
+    );
+    assert!(write.status.success(), "{}", output_text(&write));
+    assert_eq!(proxy.count(), 0);
+    drop(proxy);
+
+    let capture = UploadCaptureProxy::new(temp.path(), &fixture.join("app.txt"));
+    let apply = run_with_proxy_address(
+        &fixture,
+        &capture.address,
+        &[
+            "up",
+            "--project",
+            "offline-probe",
+            "--environment",
+            "offline-environment",
+            "--from-plan",
+            "plan.json",
+            "--detach",
+            "--json",
+        ],
+        true,
+        true,
+        &[("RAILWAY_ENV", "dev")],
+    );
+    assert!(
+        apply.status.success(),
+        "valid apply did not complete its captured upload\n{}",
+        output_text(&apply)
+    );
+    assert_eq!(
+        archived_file(capture.captured_body(), "app.txt"),
+        b"content\n",
+        "the public apply command did not upload its verified snapshot"
+    );
+    assert_eq!(
+        fs::read(fixture.join("app.txt")).unwrap(),
+        b"changed\n",
+        "the upload-capture boundary did not mutate the source"
+    );
+}
