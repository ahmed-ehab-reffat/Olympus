+#[test]
+fn deployment_plan_serialization_is_byte_deterministic_and_sorted() {
+    let temp = tempdir().unwrap();
+    fs::create_dir(temp.path().join("z-dir")).unwrap();
+    fs::write(temp.path().join("z-dir/z.txt"), "z").unwrap();
+    fs::write(temp.path().join("a.txt"), "a").unwrap();
+
+    let first = create_deploy_plan(temp.path(), temp.path(), None, true, false).unwrap();
+    let second = create_deploy_plan(temp.path(), temp.path(), None, true, false).unwrap();
+    let serialized = serialize_deploy_plan(&first).unwrap();
+    assert_eq!(serialized, serialize_deploy_plan(&second).unwrap());
+    let json: serde_json::Value = serde_json::from_slice(&serialized).unwrap();
+    assert_eq!(
+        json.get("pathAsRoot").and_then(serde_json::Value::as_bool),
+        Some(false)
+    );
+    assert_eq!(
+        json.get("noGitignore").and_then(serde_json::Value::as_bool),
+        Some(true)
+    );
+    let directories = json["entries"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .filter(|entry| entry["kind"].as_str() == Some("directory"))
+        .collect::<Vec<_>>();
+    assert!(directories.iter().any(|entry| entry["path"] == "z-dir"));
+    for directory in directories {
+        assert_eq!(directory["size"].as_u64(), Some(0));
+        assert!(directory.get("sha256").is_none());
+    }
+    assert!(
+        first
+            .entries
+            .windows(2)
+            .all(|pair| pair[0].path < pair[1].path)
+    );
+    for expected in ["a.txt", "z-dir", "z-dir/z.txt"] {
+        assert!(first.entries.iter().any(|entry| entry.path == expected));
+    }
+}
