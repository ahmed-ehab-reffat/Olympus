+pub(crate) struct DeployEntry {
+    pub source_path: PathBuf,
+    pub archive_path: PathBuf,
+    pub walk_index: usize,
+}
+
+pub(crate) struct DeployEntries {
+    pub total_walked: usize,
+    pub entries: Vec<Result<DeployEntry>>,
+}
+
+pub(crate) fn collect_deploy_entries(
+    project_path: &Path,
+    archive_prefix_path: &Path,
+    no_gitignore: bool,
+) -> DeployEntries {
+    let ignored = [".git", "node_modules"];
+    let ignored: Vec<&OsStr> = ignored.iter().map(OsStr::new).collect();
+    let mut builder = WalkBuilder::new(project_path);
+    builder.add_custom_ignore_filename(".railwayignore");
+    if no_gitignore {
+        builder.git_ignore(false);
+    }
+
+    let walked = builder
+        .follow_links(true)
+        .hidden(false)
+        .build()
+        .collect::<Vec<_>>();
+    let total_walked = walked.len();
+    let entries = walked
+        .into_iter()
+        .enumerate()
+        .filter_map(|(index, entry)| match entry {
+            Err(error) => Some(Err(error.into())),
+            Ok(entry) => {
+                let source_path = entry.into_path();
+                if source_path
+                    .components()
+                    .any(|component| ignored.contains(&component.as_os_str()))
+                {
+                    return None;
+                }
+                Some(
+                    source_path
+                        .strip_prefix(archive_prefix_path)
+                        .map(|relative| DeployEntry {
+                            source_path: source_path.clone(),
+                            archive_path: PathBuf::from(".").join(relative),
+                            walk_index: index + 1,
+                        })
+                        .map_err(Into::into),
+                )
+            }
+        })
+        .collect();
+
+    DeployEntries {
+        total_walked,
+        entries,
+    }
+}
