@@ -0,0 +1,495 @@
+use std::{
+    collections::HashSet,
+    fmt::Write as _,
+    fs::{self, File, Metadata},
+    io::{Cursor, Read},
+    path::{Component, Path, PathBuf},
+    sync::{Arc, Mutex},
+};
+
+use anyhow::{Context, Result, bail};
+use gzp::{ZBuilder, deflate::Gzip};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use synchronized_writer::SynchronizedWriter;
+use tar::{Builder, Header};
+
+use super::upload::collect_deploy_entries;
+
+#[cfg(unix)]
+use std::os::unix::fs::PermissionsExt;
+
+const PLAN_VERSION: u32 = 1;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct DeployPlan {
+    pub version: u32,
+    pub path_as_root: bool,
+    pub no_gitignore: bool,
+    pub entries: Vec<DeployPlanEntry>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct DeployPlanEntry {
+    pub path: String,
+    pub kind: DeployEntryKind,
+    pub size: u64,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub mode: Option<u32>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub sha256: Option<String>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum DeployEntryKind {
+    File,
+    Directory,
+}
+
+#[derive(Debug)]
+struct SelectedEntry {
+    source_path: PathBuf,
+    plan_entry: DeployPlanEntry,
+}
+
+pub fn create_deploy_plan(
+    project_path: &Path,
+    archive_prefix_path: &Path,
+    plan_path: Option<&Path>,
+    no_gitignore: bool,
+    path_as_root: bool,
+) -> Result<DeployPlan> {
+    let mut selected = collect_entries(project_path, archive_prefix_path, plan_path, no_gitignore)?;
+    for entry in &mut selected {
+        if entry.plan_entry.kind == DeployEntryKind::File {
+            let snapshot = read_file_snapshot(&entry.source_path)?;
+            ensure_metadata_matches(&entry.plan_entry, &snapshot.metadata)?;
+            entry.plan_entry.sha256 = Some(snapshot.sha256);
+        }
+    }
+
+    let plan = DeployPlan {
+        version: PLAN_VERSION,
+        path_as_root,
+        no_gitignore,
+        entries: selected.into_iter().map(|entry| entry.plan_entry).collect(),
+    };
+    validate_plan(&plan)?;
+    Ok(plan)
+}
+
+pub fn serialize_deploy_plan(plan: &DeployPlan) -> Result<Vec<u8>> {
+    validate_plan(plan)?;
+    serde_json::to_vec_pretty(plan).context("Failed to serialize deployment plan")
+}
+
+pub fn read_deploy_plan(path: &Path) -> Result<DeployPlan> {
+    let bytes = fs::read(path)
+        .with_context(|| format!("Failed to read deployment plan {}", path.display()))?;
+    let plan: DeployPlan = serde_json::from_slice(&bytes)
+        .with_context(|| format!("Failed to parse deployment plan {}", path.display()))?;
+    validate_plan(&plan)?;
+    Ok(plan)
+}
+
+pub fn create_deploy_tarball_from_plan(
+    project_path: &Path,
+    archive_prefix_path: &Path,
+    plan_path: Option<&Path>,
+    no_gitignore: bool,
+    path_as_root: bool,
+    plan: &DeployPlan,
+) -> Result<Vec<u8>> {
+    validate_plan(plan)?;
+    if plan.no_gitignore != no_gitignore {
+        bail!(
+            "Deployment plan expects noGitignore={}, but the current invocation uses {}",
+            plan.no_gitignore,
+            no_gitignore
+        );
+    }
+    if plan.path_as_root != path_as_root {
+        bail!(
+            "Deployment plan expects pathAsRoot={}, but the current invocation uses {}",
+            plan.path_as_root,
+            path_as_root
+        );
+    }
+
+    let selected = collect_entries(project_path, archive_prefix_path, plan_path, no_gitignore)?;
+    ensure_same_selection(plan, &selected)?;
+
+    let bytes = Vec::<u8>::new();
+    let shared = Arc::new(Mutex::new(bytes));
+    let mut compressor = ZBuilder::<Gzip, _>::new()
+        .num_threads(num_cpus::get())
+        .from_writer(SynchronizedWriter::new(shared.clone()));
+
+    {
+        let mut archive = Builder::new(&mut compressor);
+        for (selected_entry, planned_entry) in selected.iter().zip(&plan.entries) {
+            match planned_entry.kind {
+                DeployEntryKind::Directory => {
+                    let metadata =
+                        fs::metadata(&selected_entry.source_path).with_context(|| {
+                            format!(
+                                "Failed to read metadata for {}",
+                                selected_entry.source_path.display()
+                            )
+                        })?;
+                    ensure_metadata_matches(planned_entry, &metadata)?;
+                    archive.append_dir(&planned_entry.path, &selected_entry.source_path)?;
+                }
+                DeployEntryKind::File => {
+                    let snapshot = read_file_snapshot(&selected_entry.source_path)?;
+                    ensure_metadata_matches(planned_entry, &snapshot.metadata)?;
+                    if planned_entry.sha256.as_deref() != Some(snapshot.sha256.as_str()) {
+                        bail!(
+                            "Deployment input changed since planning: content differs for {}",
+                            planned_entry.path
+                        );
+                    }
+
+                    let mut header = Header::new_gnu();
+                    header.set_metadata(&snapshot.metadata);
+                    header.set_size(snapshot.bytes.len() as u64);
+                    header.set_cksum();
+                    archive.append_data(
+                        &mut header,
+                        &planned_entry.path,
+                        Cursor::new(snapshot.bytes),
+                    )?;
+                }
+            }
+        }
+    }
+    compressor.finish()?;
+
+    Arc::try_unwrap(shared)
+        .map_err(|_| {
+            anyhow::anyhow!("internal error: deployment plan buffer still has references")
+        })?
+        .into_inner()
+        .map_err(|error| anyhow::anyhow!("internal error: failed to unwrap plan buffer: {error}"))
+}
+
+fn collect_entries(
+    project_path: &Path,
+    archive_prefix_path: &Path,
+    excluded_path: Option<&Path>,
+    no_gitignore: bool,
+) -> Result<Vec<SelectedEntry>> {
+    let excluded_path = excluded_path.map(absolute_path).transpose()?;
+    let mut entries = Vec::new();
+    for selected in collect_deploy_entries(project_path, archive_prefix_path, no_gitignore).entries
+    {
+        let selected = selected?;
+        let source_path = &selected.source_path;
+        if let Some(excluded) = &excluded_path {
+            if absolute_path(source_path)? == *excluded {
+                continue;
+            }
+        }
+
+        let path = normalize_archive_path(&selected.archive_path)?;
+        let metadata = fs::metadata(source_path)
+            .with_context(|| format!("Failed to read metadata for {}", source_path.display()))?;
+        let kind = if metadata.is_file() {
+            DeployEntryKind::File
+        } else if metadata.is_dir() {
+            DeployEntryKind::Directory
+        } else {
+            bail!(
+                "Unsupported deployment input type at {}",
+                source_path.display()
+            );
+        };
+        entries.push(SelectedEntry {
+            source_path: source_path.to_path_buf(),
+            plan_entry: DeployPlanEntry {
+                path,
+                kind,
+                size: if kind == DeployEntryKind::File {
+                    metadata.len()
+                } else {
+                    0
+                },
+                mode: file_mode(&metadata),
+                sha256: None,
+            },
+        });
+    }
+
+    entries.sort_by(|left, right| left.plan_entry.path.cmp(&right.plan_entry.path));
+    Ok(entries)
+}
+
+fn absolute_path(path: &Path) -> Result<PathBuf> {
+    let absolute = if path.is_absolute() {
+        path.to_path_buf()
+    } else {
+        std::env::current_dir()
+            .context("Failed to get current directory")?
+            .join(path)
+    };
+    let mut normalized = PathBuf::new();
+    for component in absolute.components() {
+        match component {
+            Component::CurDir => {}
+            Component::ParentDir => {
+                if !normalized.pop() {
+                    bail!("Deployment plan path escapes the filesystem root");
+                }
+            }
+            Component::Prefix(value) => normalized.push(value.as_os_str()),
+            Component::RootDir => normalized.push(component.as_os_str()),
+            Component::Normal(value) => normalized.push(value),
+        }
+    }
+    Ok(normalized)
+}
+
+fn normalize_archive_path(path: &Path) -> Result<String> {
+    let mut parts = Vec::new();
+    for component in path.components() {
+        match component {
+            Component::CurDir => {}
+            Component::Normal(value) => parts.push(
+                value
+                    .to_str()
+                    .context("Deployment plans require UTF-8 paths")?
+                    .to_owned(),
+            ),
+            Component::ParentDir | Component::RootDir | Component::Prefix(_) => {
+                bail!("Deployment plan path escapes its archive prefix")
+            }
+        }
+    }
+    if parts.is_empty() {
+        Ok(".".to_owned())
+    } else {
+        Ok(parts.join("/"))
+    }
+}
+
+fn validate_plan(plan: &DeployPlan) -> Result<()> {
+    if plan.version != PLAN_VERSION {
+        bail!(
+            "Unsupported deployment plan version {}; expected {}",
+            plan.version,
+            PLAN_VERSION
+        );
+    }
+
+    let mut seen = HashSet::new();
+    let mut previous: Option<&str> = None;
+    for entry in &plan.entries {
+        validate_plan_path(&entry.path)?;
+        if let Some(previous) = previous {
+            if previous >= entry.path.as_str() {
+                bail!("Deployment plan entries must be uniquely sorted by path");
+            }
+        }
+        previous = Some(&entry.path);
+        if !seen.insert(&entry.path) {
+            bail!("Deployment plan contains duplicate path {}", entry.path);
+        }
+
+        #[cfg(unix)]
+        if entry.mode.is_none() {
+            bail!("Deployment plan entry {} has no Unix mode", entry.path);
+        }
+
+        match entry.kind {
+            DeployEntryKind::File => {
+                let digest = entry.sha256.as_deref().with_context(|| {
+                    format!("Deployment plan file {} has no digest", entry.path)
+                })?;
+                if digest.len() != 64
+                    || !digest
+                        .bytes()
+                        .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+                {
+                    bail!("Deployment plan file {} has an invalid digest", entry.path);
+                }
+            }
+            DeployEntryKind::Directory => {
+                if entry.size != 0 || entry.sha256.is_some() {
+                    bail!(
+                        "Deployment plan directory {} has file-only metadata",
+                        entry.path
+                    );
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+fn validate_plan_path(path: &str) -> Result<()> {
+    if path == "." {
+        return Ok(());
+    }
+    if path.is_empty()
+        || path.starts_with('/')
+        || path.contains('\\')
+        || path
+            .split('/')
+            .any(|part| part.is_empty() || part == "." || part == "..")
+    {
+        bail!("Deployment plan contains invalid path {path:?}");
+    }
+    Ok(())
+}
+
+fn ensure_same_selection(plan: &DeployPlan, selected: &[SelectedEntry]) -> Result<()> {
+    if plan.entries.len() != selected.len() {
+        bail!(
+            "Deployment inputs changed since planning: expected {} entries, found {}",
+            plan.entries.len(),
+            selected.len()
+        );
+    }
+    for (planned, current) in plan.entries.iter().zip(selected) {
+        if planned.path != current.plan_entry.path {
+            bail!(
+                "Deployment inputs changed since planning: expected {}, found {}",
+                planned.path,
+                current.plan_entry.path
+            );
+        }
+        if planned.kind != current.plan_entry.kind {
+            bail!(
+                "Deployment input changed type since planning: {}",
+                planned.path
+            );
+        }
+        if planned.size != current.plan_entry.size {
+            bail!(
+                "Deployment input changed size since planning: {}",
+                planned.path
+            );
+        }
+        if planned.mode != current.plan_entry.mode {
+            bail!(
+                "Deployment input changed mode since planning: {}",
+                planned.path
+            );
+        }
+    }
+    Ok(())
+}
+
+fn ensure_metadata_matches(entry: &DeployPlanEntry, metadata: &Metadata) -> Result<()> {
+    let current_kind = if metadata.is_file() {
+        DeployEntryKind::File
+    } else if metadata.is_dir() {
+        DeployEntryKind::Directory
+    } else {
+        bail!(
+            "Deployment input changed to an unsupported type: {}",
+            entry.path
+        );
+    };
+    let current_size = if current_kind == DeployEntryKind::File {
+        metadata.len()
+    } else {
+        0
+    };
+    if current_kind != entry.kind || current_size != entry.size || file_mode(metadata) != entry.mode
+    {
+        bail!(
+            "Deployment input metadata changed since planning: {}",
+            entry.path
+        );
+    }
+    Ok(())
+}
+
+struct FileSnapshot {
+    metadata: Metadata,
+    bytes: Vec<u8>,
+    sha256: String,
+}
+
+fn read_file_snapshot(path: &Path) -> Result<FileSnapshot> {
+    let metadata_before_open = fs::metadata(path)
+        .with_context(|| format!("Failed to inspect deployment input {}", path.display()))?;
+    let mut file = File::open(path)
+        .with_context(|| format!("Failed to open deployment input {}", path.display()))?;
+    let metadata = file
+        .metadata()
+        .with_context(|| format!("Failed to read metadata for {}", path.display()))?;
+    let mut bytes = Vec::new();
+    file.read_to_end(&mut bytes)
+        .with_context(|| format!("Failed to read deployment input {}", path.display()))?;
+    let mut encoded = String::with_capacity(64);
+    for byte in Sha256::digest(&bytes) {
+        write!(&mut encoded, "{byte:02x}")?;
+    }
+    let metadata_after = file
+        .metadata()
+        .with_context(|| format!("Failed to recheck deployment input {}", path.display()))?;
+    let metadata_after_path = fs::metadata(path)
+        .with_context(|| format!("Failed to recheck deployment input path {}", path.display()))?;
+    if !metadata_before_open.is_file()
+        || !metadata_after.is_file()
+        || !metadata_after_path.is_file()
+        || !same_file_identity(&metadata_before_open, &metadata)
+        || !same_file_identity(&metadata, &metadata_after_path)
+        || metadata_before_open.len() != metadata.len()
+        || file_mode(&metadata_before_open) != file_mode(&metadata)
+        || modification_state(&metadata_before_open) != modification_state(&metadata)
+        || metadata_after.len() != metadata.len()
+        || file_mode(&metadata_after) != file_mode(&metadata)
+        || modification_state(&metadata_after) != modification_state(&metadata)
+        || u64::try_from(bytes.len()).ok() != Some(metadata.len())
+    {
+        bail!(
+            "Deployment input changed while planning: {}",
+            path.display()
+        );
+    }
+    Ok(FileSnapshot {
+        metadata,
+        bytes,
+        sha256: encoded,
+    })
+}
+
+#[cfg(unix)]
+fn same_file_identity(left: &Metadata, right: &Metadata) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    left.dev() == right.dev() && left.ino() == right.ino()
+}
+
+#[cfg(not(unix))]
+fn same_file_identity(left: &Metadata, right: &Metadata) -> bool {
+    left.len() == right.len()
+        && file_mode(left) == file_mode(right)
+        && modification_state(left) == modification_state(right)
+}
+
+#[cfg(unix)]
+fn modification_state(metadata: &Metadata) -> (i64, i64) {
+    use std::os::unix::fs::MetadataExt;
+    (metadata.mtime(), metadata.mtime_nsec())
+}
+
+#[cfg(not(unix))]
+fn modification_state(metadata: &Metadata) -> Option<std::time::SystemTime> {
+    metadata.modified().ok()
+}
+
+#[cfg(unix)]
+fn file_mode(metadata: &Metadata) -> Option<u32> {
+    Some(metadata.permissions().mode() & 0o7777)
+}
+
+#[cfg(not(unix))]
+fn file_mode(_metadata: &Metadata) -> Option<u32> {
+    None
+}
