+from __future__ import annotations
+
+from typing import (Callable, Dict, NamedTuple, Optional, Tuple)
+
+from ...utility.mask import bit_invert
+
+## Width in bits of a debug sequence value.
+VALUE_WIDTH = 64
+
+## Mask for the full width of a debug sequence value.
+VALUE_MASK = (1 << VALUE_WIDTH) - 1
+
+def to_value(value: int) -> int:
+    """@brief Reduce an integer to the unsigned value domain of debug sequences."""
+    return value & VALUE_MASK
+
+def is_true(value: int) -> bool:
+    """@brief Test a value for truth, as a logical operator or a predicate does."""
+    return to_value(value) != 0
+
+def _divide(left: int, right: int) -> int:
+    return 0 if right == 0 else left // right
+
+def _remainder(left: int, right: int) -> int:
+    return 0 if right == 0 else left % right
+
+def _shift_left(left: int, right: int) -> int:
+    return 0 if right >= VALUE_WIDTH else left << right
+
+def _shift_right(left: int, right: int) -> int:
+    return 0 if right >= VALUE_WIDTH else left >> right
+
+class Simplification(NamedTuple):
+    """@brief What an operator is worth once one of its operands is known to be a literal.
+
+    Either the operator produces the value of its other operand, named by #operand, or it produces
+    #constant whatever that other operand is worth. Only the second form makes the other operand
+    disappear, so only the second form can lose what evaluating it does.
+    """
+    operand: Optional[int]
+    constant: Optional[int]
+
+class BinaryOperator(NamedTuple):
+    """@brief Everything the evaluation model knows about one binary operator.
+
+    @param evaluate Applies the operator to two values of the domain.
+    @param decider For a logical operator, the truth of the operand that settles the result on its
+        own; the result is then that truth as a 1 or a 0. None for every other operator.
+    @param identities Operand index and literal value for which the operator produces the value of
+        its other operand.
+    @param constants Operand index, literal value and result for which the operator produces that
+        result whatever its other operand is worth.
+    """
+    evaluate: Callable[[int, int], int]
+    decider: Optional[bool] = None
+    identities: Tuple[Tuple[int, int], ...] = ()
+    constants: Tuple[Tuple[int, int, int], ...] = ()
+
+## The binary operators of the debug sequence language.
+#
+# Note that divide and modulo by 0 just results in 0 rather than an exception.
+BINARY_OPERATORS: Dict[str, BinaryOperator] = {
+    '+':    BinaryOperator(lambda l, r: l + r, identities=((0, 0), (1, 0))),
+    '-':    BinaryOperator(lambda l, r: l - r, identities=((1, 0),)),
+    '*':    BinaryOperator(lambda l, r: l * r, identities=((0, 1), (1, 1)),
+                constants=((0, 0, 0), (1, 0, 0))),
+    '/':    BinaryOperator(_divide, identities=((1, 1),), constants=((0, 0, 0), (1, 0, 0))),
+    '%':    BinaryOperator(_remainder, constants=((0, 0, 0), (1, 0, 0), (1, 1, 0))),
+    '&':    BinaryOperator(lambda l, r: l & r, identities=((0, VALUE_MASK), (1, VALUE_MASK)),
+                constants=((0, 0, 0), (1, 0, 0))),
+    '|':    BinaryOperator(lambda l, r: l | r, identities=((0, 0), (1, 0)),
+                constants=((0, VALUE_MASK, VALUE_MASK), (1, VALUE_MASK, VALUE_MASK))),
+    '^':    BinaryOperator(lambda l, r: l ^ r, identities=((0, 0), (1, 0))),
+    '<<':   BinaryOperator(_shift_left, identities=((1, 0),), constants=((0, 0, 0),)),
+    '>>':   BinaryOperator(_shift_right, identities=((1, 0),), constants=((0, 0, 0),)),
+    '&&':   BinaryOperator(lambda l, r: int(is_true(l) and is_true(r)), decider=False),
+    '||':   BinaryOperator(lambda l, r: int(is_true(l) or is_true(r)), decider=True),
+    '==':   BinaryOperator(lambda l, r: int(l == r)),
+    '!=':   BinaryOperator(lambda l, r: int(l != r)),
+    '>':    BinaryOperator(lambda l, r: int(l > r)),
+    '>=':   BinaryOperator(lambda l, r: int(l >= r)),
+    '<':    BinaryOperator(lambda l, r: int(l < r)),
+    '<=':   BinaryOperator(lambda l, r: int(l <= r)),
+    }
+
+## The unary operators of the debug sequence language.
+UNARY_OPERATORS: Dict[str, Callable[[int], int]] = {
+    '~':    lambda v: bit_invert(v, width=VALUE_WIDTH),
+    '!':    lambda v: int(not is_true(v)),
+    '+':    lambda v: v,
+    '-':    lambda v: -v,
+    }
+
+def evaluate_binary(op: str, left: int, right: int) -> int:
+    """@brief Apply a binary operator to two values and reduce its result to the domain."""
+    return to_value(BINARY_OPERATORS[op].evaluate(left, right))
+
+def evaluate_unary(op: str, value: int) -> int:
+    """@brief Apply a unary operator to a value and reduce its result to the domain."""
+    return to_value(UNARY_OPERATORS[op](value))
+
+def short_circuit_result(op: str, value: int) -> Optional[int]:
+    """@brief Result a logical operator produces from one operand alone.
+
+    A logical operator is settled by either of its operands being the deciding truth: the left one
+    settles it before the right one is evaluated at all, and the right one settles it whatever the
+    left one turned out to be worth. Returns None when the operator needs both operands, which is
+    always the case for an operator that is not a logical one.
+    """
+    operator = BINARY_OPERATORS[op]
+    if (operator.decider is None) or (is_true(value) != operator.decider):
+        return None
+    return int(operator.decider)
+
+def simplify_with_literal(op: str, index: int, literal: int) -> Optional[Simplification]:
+    """@brief Simplify an operator whose operand at @a index is the literal @a literal.
+
+    Returns None when knowing that one operand does not settle what the operator is worth.
+    """
+    operator = BINARY_OPERATORS[op]
+    literal = to_value(literal)
+
+    for identity_index, identity in operator.identities:
+        if (identity_index == index) and (literal == identity):
+            return Simplification(operand=(1 - index), constant=None)
+
+    for constant_index, trigger, constant in operator.constants:
+        if (constant_index == index) and (literal == trigger):
+            return Simplification(operand=None, constant=constant)
+
+    return None
