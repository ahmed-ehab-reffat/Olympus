+from __future__ import annotations
+
+import pytest
+from unittest import mock
+
+from pyocd.debug.sequences.scope import Scope
+from pyocd.debug.sequences.sequences import (
+    DebugSequenceExecutionContext,
+    DebugSequenceSemanticError,
+    DebugSequence,
+    Block,
+    WhileControl,
+    IfControl,
+)
+from pyocd.debug.sequences.functions import DebugSequenceCommonFunctions
+from pyocd.core.session import Session
+from pyocd.coresight.ap import (APv1Address, MEM_AP)
+from pyocd.probe.debug_probe import DebugProbe
+
+WORD_MASK = 0xffffffffffffffff
+
+## Number of reads after which the test target stops reporting a non-zero word, so that a
+## predicate built on a read cannot spin.
+READ_BUDGET = 8
+
+class RecordingSequenceFunctions:
+    def __init__(self, log):
+        self._log = log
+
+    def read32(self, addr: int) -> int:
+        self._log.append(('read32', addr))
+        if len([entry for entry in self._log if entry[0] == 'read32']) > READ_BUDGET:
+            return 0
+        return 0x10000 | (addr & 0xffff)
+
+    def write32(self, addr: int, val: int) -> None:
+        self._log.append(('write32', addr, val))
+
+    def dap_delay(self, delay: int) -> None:
+        self._log.append(('dap_delay', delay))
+
+    def message(self, type: int, format: str, *args: int) -> None:
+        self._log.append(('message', type, format) + args)
+
+    def text(self) -> str:
+        self._log.append(('text',))
+        return "x"
+
+    def signed(self) -> int:
+        self._log.append(('signed',))
+        return -1
+
+    def oversized(self) -> int:
+        self._log.append(('oversized',))
+        return (1 << 64) | 0x25
+
+class RecordingSequenceDelegate:
+    def __init__(self, functions=None):
+        self.log = []
+        self._root = Scope(name="eval-test-root")
+        self._functions = functions
+
+    @property
+    def sequences(self):
+        return set()
+
+    @property
+    def cmsis_pack_device(self):
+        device = mock.MagicMock()
+        device.uses_apid = False
+        return device
+
+    def get_root_scope(self, context) -> Scope:
+        return self._root
+
+    def has_sequence_with_name(self, name, pname=None):
+        return False
+
+    def get_sequence_with_name(self, name, pname=None):
+        return None
+
+    def get_protocol(self):
+        return 2
+
+    def get_connection_type(self):
+        return 1
+
+    def get_traceout(self):
+        return 0
+
+    def get_traceclockin(self) -> int:
+        return 0
+
+    def get_traceclockout(self) -> int:
+        return 0
+
+    def get_sequence_functions(self):
+        if self._functions is not None:
+            return self._functions
+        return RecordingSequenceFunctions(self.log)
+
+class RecordingProbe:
+    wire_protocol = DebugProbe.Protocol.SWD
+
+    def __init__(self, log=None):
+        self.log = [] if log is None else log
+        self.tdo = (1 << 40) | 0xff
+        self.capabilities = {
+            DebugProbe.Capability.SWJ_SEQUENCE,
+            DebugProbe.Capability.JTAG_SEQUENCE,
+            }
+
+    def lock(self):
+        pass
+
+    def unlock(self):
+        pass
+
+    def swj_sequence(self, cnt, val):
+        self.log.append(('swj_sequence', cnt, val))
+
+    def jtag_sequence(self, cnt, tms, capture, tdi):
+        self.log.append(('jtag_sequence', cnt, tms, tdi))
+        return self.tdo
+
+@pytest.fixture(scope='function')
+def delegate():
+    return RecordingSequenceDelegate()
+
+@pytest.fixture(scope='function')
+def context(delegate):
+    session = Session(None)
+    setattr(session, '_probe', RecordingProbe())
+    return DebugSequenceExecutionContext(session, delegate, pname=None)
+
+@pytest.fixture(scope='function')
+def transfer_ap():
+    ap = mock.MagicMock(spec=MEM_AP)
+    ap.read32.return_value = 0xabcd1234
+    return ap
+
+@pytest.fixture(scope='function')
+def transfer_probe():
+    return RecordingProbe()
+
+@pytest.fixture(scope='function')
+def transfer_target(transfer_ap):
+    target = mock.MagicMock()
+    target.aps = {APv1Address(0): transfer_ap}
+    return target
+
+@pytest.fixture(scope='function')
+def transfer_context(transfer_target, transfer_probe):
+    session = Session(None)
+    board = mock.MagicMock()
+    board.target = transfer_target
+    setattr(session, '_probe', transfer_probe)
+    setattr(session, '_board', board)
+
+    delegate = RecordingSequenceDelegate(functions=DebugSequenceCommonFunctions())
+    context = DebugSequenceExecutionContext(session, delegate, pname=None)
+    with context:
+        yield context
+
+def run_block(context, code):
+    seq = DebugSequence('eval_test')
+    scope = seq._create_scope(context)
+    context._push(seq, scope)
+    Block(code).execute(context)
+    return scope
+
+def run_nodes(context, *nodes):
+    seq = DebugSequence('eval_test')
+    for node in nodes:
+        seq.add_child(node)
+    return seq.execute(context)
+
+def calls_of(delegate, name):
+    return [entry for entry in delegate.log if entry[0] == name]
+
+class TestSequenceExpressionEffects:
+    def test_conjunction_with_a_literal_zero_right_operand_calls_the_left(self, context, delegate):
+        scope = run_block(context, "__var x = Read32(0x1000) && 0;")
+        assert delegate.log == [('read32', 0x1000)]
+        assert scope.get('x') == 0
+
+    def test_disjunction_with_a_literal_one_right_operand_calls_the_left(self, context, delegate):
+        scope = run_block(context, "__var x = Read32(0x1000) || 1;")
+        assert delegate.log == [('read32', 0x1000)]
+        assert scope.get('x') == 1
+
+    def test_multiply_by_a_literal_zero_calls_the_operand(self, context, delegate):
+        scope = run_block(context, "__var x = Read32(0x1004) * 0;")
+        assert delegate.log == [('read32', 0x1004)]
+        assert scope.get('x') == 0
+
+    def test_bitwise_and_with_a_literal_zero_left_operand_calls_the_right(self, context, delegate):
+        scope = run_block(context, "__var x = 0 & Read32(0x1008);")
+        assert delegate.log == [('read32', 0x1008)]
+        assert scope.get('x') == 0
+
+    def test_remainder_by_a_literal_one_calls_the_operand(self, context, delegate):
+        scope = run_block(context, "__var x = Read32(0x100c) % 1;")
+        assert delegate.log == [('read32', 0x100c)]
+        assert scope.get('x') == 0
+
+    def test_shift_of_a_literal_zero_calls_the_shift_count(self, context, delegate):
+        scope = run_block(context, "__var x = 0 << Read32(0x1010);")
+        assert delegate.log == [('read32', 0x1010)]
+        assert scope.get('x') == 0
+
+    def test_discarded_assignment_still_updates_the_variable(self, context, delegate):
+        scope = run_block(context, "__var y = 0; __var x = (y = 7) * 0;")
+        assert scope.get('y') == 7
+        assert scope.get('x') == 0
+
+    def test_call_nested_inside_a_discarded_operand_still_runs(self, context, delegate):
+        scope = run_block(context, "__var x = (Read32(0x1014) + 1) * 0;")
+        assert delegate.log == [('read32', 0x1014)]
+        assert scope.get('x') == 0
+
+    @pytest.mark.parametrize(("op", "literal"), [
+            ("*", 0), ("&", 0), ("/", 0), ("%", 1), ("&&", 0), ("||", 1),
+        ])
+    def test_a_literal_operand_behaves_like_a_variable_holding_it(self, context, delegate, op, literal):
+        with_literal = run_block(context, f"__var a = (0 - Read32(0x1a00)) {op} {literal};").get('a')
+        literal_log = list(delegate.log)
+        del delegate.log[:]
+        with_variable = run_block(context, f"__var v = {literal}; __var b = (0 - Read32(0x1a00)) {op} v;").get('b')
+        assert literal_log == delegate.log == [('read32', 0x1a00)]
+        assert with_literal == with_variable
+
+    @pytest.mark.parametrize(("with_literal", "with_variable", "expected"), [
+            ("{x} + 3", "{x} + z", 0xfffffffffffee404),
+            ("3 + {x}", "z + {x}", 0xfffffffffffee404),
+            ("{x} - 3", "{x} - z", 0xfffffffffffee3fe),
+            ("{x} * 3", "{x} * z", 0xfffffffffffcac03),
+            ("3 * {x}", "z * {x}", 0xfffffffffffcac03),
+            ("{x} / 3", "{x} / z", 0x555555555554f6ab),
+            ("3 / {x}", "z / {x}", 0x0),
+            ("{x} % 3", "{x} % z", 0x0),
+            ("3 % {x}", "z % {x}", 0x3),
+            ("{x} | 3", "{x} | z", 0xfffffffffffee403),
+            ("3 | {x}", "z | {x}", 0xfffffffffffee403),
+            ("{x} ^ 3", "{x} ^ z", 0xfffffffffffee402),
+            ("3 ^ {x}", "z ^ {x}", 0xfffffffffffee402),
+            ("{x} << 3", "{x} << z", 0xfffffffffff72008),
+            ("3 << {x}", "z << {x}", 0x0),
+            ("{x} >> 3", "{x} >> z", 0x1fffffffffffdc80),
+            ("3 >> {x}", "z >> {x}", 0x0),
+            ("{x} < 3", "{x} < z", 0x0),
+            ("3 < {x}", "z < {x}", 0x1),
+            ("{x} <= 3", "{x} <= z", 0x0),
+            ("3 <= {x}", "z <= {x}", 0x1),
+            ("{x} > 3", "{x} > z", 0x1),
+            ("3 > {x}", "z > {x}", 0x0),
+            ("{x} >= 3", "{x} >= z", 0x1),
+            ("3 >= {x}", "z >= {x}", 0x0),
+        ])
+    def test_every_operator_gives_a_literal_the_value_of_a_variable(self, context, delegate,
+            with_literal, with_variable, expected):
+        operand = "(1 - Read32(0x1c00))"
+        a = run_block(context, "__var a = " + with_literal.format(x=operand) + ";").get('a')
+        literal_log = list(delegate.log)
+        del delegate.log[:]
+        b = run_block(context, "__var z = 3; __var b = " + with_variable.format(x=operand) + ";").get('b')
+        assert literal_log == delegate.log == [('read32', 0x1c00)]
+        assert a == b == expected
+
+    @pytest.mark.parametrize(("with_literal", "with_variable", "literal"), [
+            ("{x} + 0",     "{x} + z",  0),
+            ("0 + {x}",     "z + {x}",  0),
+            ("{x} - 0",     "{x} - z",  0),
+            ("{x} | 0",     "{x} | z",  0),
+            ("0 | {x}",     "z | {x}",  0),
+            ("{x} ^ 0",     "{x} ^ z",  0),
+            ("0 ^ {x}",     "z ^ {x}",  0),
+            ("{x} << 0",    "{x} << z", 0),
+            ("{x} >> 0",    "{x} >> z", 0),
+            ("{x} * 1",     "{x} * z",  1),
+            ("1 * {x}",     "z * {x}",  1),
+            ("{x} / 1",     "{x} / z",  1),
+        ])
+    def test_an_identity_literal_keeps_its_operand_and_calls(self, context, delegate,
+            with_literal, with_variable, literal):
+        operand = "(0 - Read32(0x1b00))"
+        a = run_block(context, "__var a = " + with_literal.format(x=operand) + ";").get('a')
+        literal_log = list(delegate.log)
+        del delegate.log[:]
+        b = run_block(context, f"__var z = {literal}; __var b = " + with_variable.format(x=operand) + ";").get('b')
+        assert literal_log == delegate.log == [('read32', 0x1b00)]
+        assert a == b == WORD_MASK - 0x11b00 + 1
+
+    @pytest.mark.parametrize("op", [
+            "+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>",
+            "==", "!=", "<", "<=", ">", ">=",
+        ])
+    def test_both_operands_are_called_left_to_right(self, context, delegate, op):
+        run_block(context, f"__var x = (Read32(0x1100) * 0) {op} Read32(0x1200);")
+        assert delegate.log == [('read32', 0x1100), ('read32', 0x1200)]
+
+    def test_a_difference_of_two_calls_wraps_when_the_left_is_smaller(self, context, delegate):
+        scope = run_block(context, "__var x = Read32(0x1100) - Read32(0x1200);")
+        assert delegate.log == [('read32', 0x1100), ('read32', 0x1200)]
+        assert scope.get('x') == WORD_MASK - 0xff
+
+    def test_effects_on_both_sides_of_a_discarded_operand_all_run_in_order(self, context, delegate):
+        scope = run_block(context,
+                "__var a = 0; __var b = 0;"
+                "__var x = ((a = Read32(0x1300)) + Read32(0x1400)) * ((b = Read32(0x1500)) && 0);")
+        assert delegate.log == [
+            ('read32', 0x1300),
+            ('read32', 0x1400),
+            ('read32', 0x1500),
+            ]
+        assert scope.get('a') == 0x11300
+        assert scope.get('b') == 0x11500
+        assert scope.get('x') == 0
+
+    def test_call_arguments_are_evaluated_left_to_right(self, context, delegate):
+        run_block(context, "Write32(Read32(0x1600), 0 - Read32(0x1700));")
+        assert delegate.log == [
+            ('read32', 0x1600),
+            ('read32', 0x1700),
+            ('write32', 0x11600, WORD_MASK - 0x11700 + 1),
+            ]
+
+class TestSequenceExpressionShortCircuit:
+    def test_conjunction_evaluates_the_right_operand_only_when_the_left_is_true(self, context, delegate):
+        scope = run_block(context, "__var f = 0; __var x = f && Read32(0x2000);")
+        assert delegate.log == []
+        assert scope.get('x') == 0
+
+        scope = run_block(context, "__var g = 1; __var y = g && Read32(0x2004);")
+        assert delegate.log == [('read32', 0x2004)]
+        assert scope.get('y') == 1
+
+    def test_disjunction_evaluates_the_right_operand_only_when_the_left_is_false(self, context, delegate):
+        scope = run_block(context, "__var f = 1; __var x = f || Read32(0x2008);")
+        assert delegate.log == []
+        assert scope.get('x') == 1
+
+        scope = run_block(context, "__var g = 0; __var y = g || Read32(0x200c);")
+        assert delegate.log == [('read32', 0x200c)]
+        assert scope.get('y') == 1
+
+    def test_a_deciding_literal_on_the_left_skips_the_right_operand(self, context, delegate):
+        scope = run_block(context, "__var x = 0 && Read32(0x2010);")
+        assert delegate.log == []
+        assert scope.get('x') == 0
+
+        scope = run_block(context, "__var y = 1 || Read32(0x2014);")
+        assert delegate.log == []
+        assert scope.get('y') == 1
+
+    def test_ternary_evaluates_only_the_selected_branch(self, context, delegate):
+        scope = run_block(context, "__var f = 0; __var x = f ? Read32(0x3000) : 5;")
+        assert delegate.log == []
+        assert scope.get('x') == 5
+
+        scope = run_block(context, "__var g = 1; __var y = g ? Read32(0x3004) : Read32(0x3008);")
+        assert delegate.log == [('read32', 0x3004)]
+        assert scope.get('y') == 0x13004
+
+    def test_conjunction_nested_in_a_disjunction_keeps_both_calls(self, context, delegate):
+        scope = run_block(context, "__var x = (Read32(0x4000) && 0) || Read32(0x4004);")
+        assert delegate.log == [('read32', 0x4000), ('read32', 0x4004)]
+        assert scope.get('x') == 1
+
+class TestSequenceExpressionValues:
+    def test_logical_operators_with_a_literal_operand_produce_one_or_zero(self, context):
+        scope = run_block(context, "__var y = 5; __var x = y || 0;")
+        assert scope.get('x') == 1
+
+        scope = run_block(context, "__var z = 5; __var w = 0 || z;")
+        assert scope.get('w') == 1
+
+        scope = run_block(context, "__var p = 5; __var q = p && 1;")
+        assert scope.get('q') == 1
+
+        scope = run_block(context, "__var r = 5; __var t = 1 && r;")
+        assert scope.get('t') == 1
+
+    def test_zero_minus_a_variable_is_the_negation(self, context):
+        scope = run_block(context, "__var y = 1; __var x = 0 - y;")
+        assert scope.get('x') == WORD_MASK
+
+        scope = run_block(context, "__var z = 0x10000; __var w = 0 - z;")
+        assert scope.get('w') == 0xffffffffffff0000
+
+    def test_literal_subtraction_below_zero_wraps(self, context):
+        scope = run_block(context, "__var x = 0 - 1;")
+        assert scope.get('x') == WORD_MASK
+
+    def test_unary_negation_and_subtraction_agree(self, context):
+        scope = run_block(context, "__var a = 0 - 2; __var b = -2; __var c = a - b;")
+        assert scope.get('a') == 0xfffffffffffffffe
+        assert scope.get('b') == 0xfffffffffffffffe
+        assert scope.get('c') == 0
+
+    def test_compound_subtraction_below_zero_wraps(self, context):
+        scope = run_block(context, "__var y = 0; y -= 1;")
+        assert scope.get('y') == WORD_MASK
+
+    def test_shift_count_at_the_width_produces_zero(self, context):
+        scope = run_block(context, "__var x = 1 << 64;")
+        assert scope.get('x') == 0
+
+        scope = run_block(context, "__var y = 1; __var z = y << 64;")
+        assert scope.get('z') == 0
+
+    def test_shift_counts_beyond_the_width_produce_zero(self, context):
+        scope = run_block(context, "__var x = 1 << 65; __var y = 0x8000 >> 65;")
+        assert scope.get('x') == 0
+        assert scope.get('y') == 0
+
+        scope = run_block(context, "__var n = 200; __var p = 1 << n; __var q = 0x8000 >> n;")
+        assert scope.get('p') == 0
+        assert scope.get('q') == 0
+
+    def test_shift_by_a_wrapped_count_produces_zero(self, context):
+        scope = run_block(context, "__var y = 1; __var x = y << (0 - 1);")
+        assert scope.get('x') == 0
+
+        scope = run_block(context, "__var z = 0xff; __var w = z >> (0 - 1);")
+        assert scope.get('w') == 0
+
+    def test_a_shift_result_wider_than_the_domain_wraps(self, context):
+        scope = run_block(context, "__var y = 0xffffffffffffffff; __var x = y << 1;")
+        assert scope.get('x') == 0xfffffffffffffffe
+
+        scope = run_block(context, "__var z = (0 - 1) << 4;")
+        assert scope.get('z') == 0xfffffffffffffff0
+
+    def test_scope_stores_variables_in_the_value_domain(self):
+        scope = Scope(name='domain')
+        scope.set('v', -1)
+        assert scope.get('v') == WORD_MASK
+        scope.set('w', 1 << 64)
+        assert scope.get('w') == 0
+
+    def test_multiplication_wraps_at_the_width(self, context):
+        scope = run_block(context, "__var x = 0xffffffffffffffff * 2;")
