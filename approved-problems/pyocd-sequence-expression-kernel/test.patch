+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+
+PYTHON="python3"
+command -v "$PYTHON" >/dev/null 2>&1 || PYTHON="python"
+
+NEW_TESTS="test/unit/test_sequence_eval_6f893c.py"
+LOG_FILE="$(mktemp)"
+
+if [ "$MODE" = "new" ]; then
+    $PYTHON -m pytest "$NEW_TESTS" \
+        -p no:cacheprovider --junitxml="$OUTPUT_PATH" 2>&1 | tee "$LOG_FILE"
+else
+    $PYTHON -m pytest test/unit --ignore="$NEW_TESTS" \
+        -p no:cacheprovider --junitxml="$OUTPUT_PATH" 2>&1 | tee "$LOG_FILE"
+fi
+EXIT_CODE=${PIPESTATUS[0]}
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    DIAGNOSTIC=$(tail -c 3000 "$LOG_FILE" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+    cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" errors="0" failures="1" skipped="0" tests="1" time="0">
+<testcase classname="pyocd.sequence_eval" name="test_runner_produced_no_results" time="0">
+<failure message="pytest produced no test results">${DIAGNOSTIC}</failure>
+</testcase>
+</testsuite></testsuites>
+XMLEOF
+    EXIT_CODE=1
+fi
+
+rm -f "$LOG_FILE"
+exit $EXIT_CODE
