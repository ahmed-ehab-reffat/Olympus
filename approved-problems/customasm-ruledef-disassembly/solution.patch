+	report: &mut diagn::Report,
+	defs: &asm::ItemDefs,
+	output: &util::BitVec)
+	-> String
+{
+	let Ok(instructions) = asm::disassemble(report, defs, output)
+		else { return String::new() };
+
+	let mut result = String::new();
+
+	for instruction in instructions
+	{
+		result.push_str(&format!(
+			"{:04x}: {}\n",
+			instruction.offset,
+			instruction.text));
+	}
+
+	result
+}
