diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..aabed90
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+cd "$(dirname "$0")"
+
+NEW_PREFIX="disasm_123a9c"
+
+xml_escape() {
+  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
+}
+
+write_junit() {
+  local suite_name="$1"
+  local log_file="$2"
+
+  [ -z "$OUTPUT_PATH" ] && return 0
+
+  local cases=""
+  local total=0
+  local failures=0
+
+  while IFS= read -r line; do
+    local name status
+    name="$(printf '%s' "$line" | sed -n 's/^test \([A-Za-z0-9_:]*\) \.\.\. \(ok\|FAILED\|ignored\)$/\1/p')"
+    status="$(printf '%s' "$line" | sed -n 's/^test \([A-Za-z0-9_:]*\) \.\.\. \(ok\|FAILED\|ignored\)$/\2/p')"
+
+    [ -z "$name" ] && continue
+
+    total=$((total + 1))
+    local esc_name
+    esc_name="$(xml_escape "$name")"
+
+    if [ "$status" = "FAILED" ]; then
+      failures=$((failures + 1))
+      cases="${cases}<testcase name=\"${esc_name}\" classname=\"${suite_name}\"><failure message=\"assertion failed\">test ${esc_name} failed</failure></testcase>"
+    else
+      cases="${cases}<testcase name=\"${esc_name}\" classname=\"${suite_name}\"></testcase>"
+    fi
+  done < <(grep -E '^test [A-Za-z0-9_:]+ \.\.\. (ok|FAILED|ignored)$' "$log_file" | sort)
+
+  if [ "$total" -eq 0 ]; then
+    total=1
+    failures=1
+    cases="<testcase name=\"build\" classname=\"${suite_name}\"><failure message=\"no tests ran\">the crate failed to build or produced no test results</failure></testcase>"
+  fi
+
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites name="customasm" tests="%s" failures="%s" errors="0" time="0">\n' "$total" "$failures"
+    printf '<testsuite name="%s" tests="%s" failures="%s" errors="0" time="0">\n' "$suite_name" "$total" "$failures"
+    printf '%s\n' "$cases"
+    printf '</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+}
+
+LOG="$(mktemp)"
+trap 'rm -f "$LOG"' EXIT
+
+if [ "$MODE" = "new" ]; then
+  cargo test --lib -- "$NEW_PREFIX" 2>&1 | tee "$LOG"
+  EXIT_CODE="${PIPESTATUS[0]}"
+  write_junit "new" "$LOG"
+else
+  cargo test --lib -- --skip "$NEW_PREFIX" 2>&1 | tee "$LOG"
+  EXIT_CODE="${PIPESTATUS[0]}"
+  write_junit "base" "$LOG"
+fi
+
+exit "$EXIT_CODE"
