+    assert 'probe' in on_zeta
+    assert 'zeta' in on_zeta and 'omega' not in on_zeta
+    on_omega = added_lines(distinctive_loop({'probe': 'S.omega'}))
+    assert 'probe' in on_omega
+    assert 'omega' in on_omega and 'zeta' not in on_omega
