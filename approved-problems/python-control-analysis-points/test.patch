+"""loopan_b55c0a_test.py - tests for analysis points and loop analysis."""
+
+import numpy as np
+import pytest
+
+import control as ct
+
+
+OMEGAS = np.array([0.4, 1.0, 3.0])
+DELIM = ct.config.defaults['iosys.state_name_delim']
+
+
+def response(sys, omegas=OMEGAS):
+    if sys.isdtime(strict=True):
+        points = np.exp(1j * omegas * sys.dt)
+    else:
+        points = 1j * omegas
+    return np.array([np.atleast_2d(sys(point, squeeze=False))
+                     for point in points])
+
+
+def assert_same(actual, expected):
+    np.testing.assert_allclose(
+        response(actual), response(expected), rtol=1e-8, atol=1e-10)
+
+
+def assert_values(sys, values):
+    np.testing.assert_allclose(
+        response(sys), np.asarray(values), rtol=1e-8, atol=1e-10)
+
+
+def simple_loop(gain=2.0, points=('C.u',), dt=0):
+    plant = ct.tf([1], [1, 1], inputs='u', outputs='y', name='P', dt=dt)
+    ctrl = ct.tf([gain], [1], inputs='e', outputs='u', name='C', dt=dt)
+    junction = ct.summing_junction(
+        inputs=['r', '-y'], output='e', name='S', dt=dt)
+    extra = {} if points is None else {'analysis_points': list(points)}
+    return ct.interconnect(
+        [plant, ctrl, junction], inplist=['S.r'], outlist=['P.y'],
+        inputs=['r'], outputs=['y'], name='T', **extra)
+
+
+def named_loop():
+    plant = ct.tf([1], [1, 1], inputs='u', outputs='y', name='P')
+    ctrl = ct.tf([2], [1], inputs='e', outputs='u', name='C')
+    junction = ct.summing_junction(inputs=['r', '-y'], output='e', name='S')
+    return ct.interconnect(
+        [plant, ctrl, junction], inplist=['S.r'], outlist=['P.y'],
+        inputs=['r'], outputs=['y'], name='T',
+        analysis_points={'control': 'C.u', 'error': 'S.e'})
+
+
+def fanout_loop():
+    first = ct.tf([1], [1, 1], inputs='u', outputs='y1', name='P1')
+    second = ct.tf([1], [1, 2], inputs='u', outputs='y2', name='P2')
+    ctrl = ct.tf([1], [1], inputs='e', outputs='u', name='C')
+    junction = ct.summing_junction(
+        inputs=['r', '-y1', '-y2'], output='e', name='S')
+    return ct.interconnect(
+        [first, second, ctrl, junction], inplist=['S.r'], outlist=['P1.y1'],
+        inputs=['r'], outputs=['y'], name='F', analysis_points=['C.u'])
+
+
+def branch_gain_loop(gain=-3.0):
+    plant = ct.tf([1], [1, 1], inputs='u', outputs='y', name='P')
+    ctrl = ct.tf([1], [1], inputs='e', outputs='u', name='C')
+    junction = ct.summing_junction(inputs=['r', '-y'], output='e', name='S')
+    return ct.interconnect(
+        [plant, ctrl, junction],
+        connections=[['P.u', ('C', 'u', gain)], ['C.e', 'S.e'],
+                     ['S.y', 'P.y']],
+        inplist=['S.r'], outlist=['P.y'], inputs=['r'], outputs=['y'],
+        name='B', analysis_points=['C.u'])
+
+
+def two_loop():
+    outer_plant = ct.tf([1], [1, 1], inputs='v', outputs='w', name='P1')
+    inner_plant = ct.tf([1], [1, 2], inputs='u', outputs='y', name='P2')
+    inner_sum = ct.summing_junction(inputs=['w', '-y'], output='u', name='Si')
+    ctrl = ct.tf([3], [1], inputs='e', outputs='v', name='C')
+    outer_sum = ct.summing_junction(inputs=['r', '-y'], output='e', name='So')
+    return ct.interconnect(
+        [outer_plant, inner_plant, inner_sum, ctrl, outer_sum],
+        inplist=['So.r'], outlist=['P2.y'], inputs=['r'], outputs=['y'],
+        name='D', analysis_points={'inner': 'P1.w', 'outer': 'C.v'})
+
+
+def mimo_loop():
+    plant = ct.ss(
+        [[-1.0, 0.0], [0.0, -2.0]], np.eye(2), np.eye(2), np.zeros((2, 2)),
+        inputs=['u[0]', 'u[1]'], outputs=['y[0]', 'y[1]'], name='G')
+    ctrl = ct.ss(
+        [], [], [], [[0.0, 1.0], [1.0, 0.0]], inputs=['e[0]', 'e[1]'],
+        outputs=['u[0]', 'u[1]'], name='K')
+    junction = ct.summing_junction(
+        inputs=['r', '-y'], output='e', dimension=2, name='S')
+    return ct.interconnect(
+        [plant, ctrl, junction], inplist=['S.r'], outlist=['G.y'],
+        inputs=['r[0]', 'r[1]'], outputs=['y[0]', 'y[1]'], name='M',
+        analysis_points=['K.u'])
+
+
+def inner_system():
+    plant = ct.tf([1], [1, 1], inputs='u', outputs='y', name='P')
+    ctrl = ct.tf([1], [1], inputs='e', outputs='u', name='C')
+    junction = ct.summing_junction(inputs=['r', '-y'], output='e', name='S')
+    return ct.interconnect(
+        [plant, ctrl, junction], inplist=['S.r'], outlist=['P.y'],
+        inputs=['r'], outputs=['y'], name='inner', analysis_points=['C.u'])
+
+
+def nested_loop():
+    ctrl = ct.tf([5], [1], inputs='eo', outputs='ro', name='Cout')
+    junction = ct.summing_junction(
+        inputs=['ref', '-yo'], output='eo', name='So')
+    return ct.interconnect(
+        [inner_system(), ctrl, junction],
+        connections=[['inner.r', 'Cout.ro'], ['Cout.eo', 'So.eo'],
+                     ['So.yo', 'inner.y']],
+        inplist=['So.ref'], outlist=['inner.y'], inputs=['ref'],
+        outputs=['yo'], name='outer', analysis_points=['Cout.ro'])
+
+
+def disturbance_loop():
+    plant = ct.tf([1], [1, 1], inputs='w', outputs='y', name='P')
+    ctrl = ct.tf([2], [1], inputs='e', outputs='u', name='C')
+    inject = ct.summing_junction(inputs=['u', 'd'], output='w', name='Sd')
+    junction = ct.summing_junction(inputs=['r', '-y'], output='e', name='S')
+    return ct.interconnect(
+        [plant, ctrl, inject, junction], inplist=['S.r', 'Sd.d'],
+        outlist=['P.y'], inputs=['r', 'd'], outputs=['y'], name='W',
+        analysis_points=['C.u'])
+
+
+def output_tap_loop():
+    plant = ct.tf([1], [1, 1], inputs='u', outputs='y', name='P')
+    ctrl = ct.tf([1], [1], inputs='e', outputs='u', name='C')
+    junction = ct.summing_junction(inputs=['r', '-y'], output='e', name='S')
+    return ct.interconnect(
+        [plant, ctrl, junction], inplist=['S.r'], outlist=['P.y', 'C.u'],
+        inputs=['r'], outputs=['y', 'u'], name='O', analysis_points=['C.u'])
+
