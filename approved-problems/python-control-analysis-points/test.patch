+def test_failing_calls_leave_the_source_alone():
+    sys = simple_loop()
+    before = (list(sys.input_labels), list(sys.output_labels),
+              list(sys.analysis_point_labels))
+    for call in (lambda: ct.open_loop(sys, 'nope'),
+                 lambda: ct.close_loop(sys, 'u'),
+                 lambda: ct.loop_transfer(sys, ['u', 'u']),
+                 lambda: ct.sensitivity(sys, 'nope'),
+                 lambda: ct.io_transfer(sys, opened='nope'),
+                 lambda: ct.replace_point(sys, 'u', np.eye(2))):
+        with pytest.raises((ValueError, TypeError, IndexError)):
+            call()
+    assert (list(sys.input_labels), list(sys.output_labels),
+            list(sys.analysis_point_labels)) == before
+    assert_same(sys, simple_loop())
+
