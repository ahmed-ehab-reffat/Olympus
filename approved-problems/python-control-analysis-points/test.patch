+def test_io_transfer_multichannel_matrix_ordering():
+    values = response(ct.io_transfer(mimo_loop(), 'G.u', 'K.u'))
+    swap = np.array([[0.0, 1.0], [1.0, 0.0]])
+    for index, omega in enumerate(OMEGAS):
+        plant = np.diag([1 / (1j * omega + 1), 1 / (1j * omega + 2)])
+        expected = -swap @ np.linalg.inv(np.eye(2) + plant @ swap) @ plant
+        np.testing.assert_allclose(values[index], expected, atol=1e-10)
