+def distinctive_loop(points=None):
+    plant = ct.tf([1], [1, 1], inputs='u', outputs='y', name='P')
+    ctrl = ct.tf([2], [1], inputs='omega', outputs='zeta', name='C')
+    junction = ct.summing_junction(
+        inputs=['r', '-y'], output='omega', name='S')
+    extra = {} if points is None else {'analysis_points': points}
+    return ct.interconnect(
+        [plant, ctrl, junction],
+        connections=[['P.u', 'C.zeta'], ['C.omega', 'S.omega'],
+                     ['S.y', 'P.y']],
+        inplist=['S.r'], outlist=['P.y'], inputs=['r'], outputs=['y'],
+        name='T', **extra)
+
+
+def added_lines(sys):
+    plain = str(distinctive_loop()).splitlines()
+    return ' '.join(
+        line for line in str(sys).splitlines() if line not in plain)
+
+
+def test_string_form_shows_the_signal_each_point_sits_on():
