+                     ['P2.b', ('K', 'u[0]', -3)], ['P3.c', ('K', 'u[1]', 0.5)],
+                     ['S.y[0]', 'P1.p', 'P3.w'], ['S.y[1]', 'P2.q']],
+        inplist=['S.r'], outlist=['P1.p', 'K.u'], inputs=['r[0]', 'r[1]'],
