+use alloc::{
+    format,
+    string::{String, ToString},
+    vec::Vec,
+};
+use core::ops::Range;
+
+use crate::{strings::CowStr, Event, LinkType, Tag, TagEnd};
+
+/// The source-position map of a merged text run: each entry pairs the byte offset at which a
+/// segment begins in the merged text with that segment's range in the original source.
+pub(crate) type SourceMap = [(usize, Range<usize>)];
+
+fn map_offset(segments: &SourceMap, total: usize, offset: usize) -> usize {
+    for i in 0..segments.len() {
+        let seg_start = segments[i].0;
+        let seg_end = segments.get(i + 1).map(|s| s.0).unwrap_or(total);
+        if offset >= seg_start && offset <= seg_end {
+            let src = &segments[i].1;
+            return (src.start + (offset - seg_start)).min(src.end);
+        }
+    }
+    segments.last().map(|s| s.1.end).unwrap_or(0)
+}
+
+fn map_range(segments: &SourceMap, total: usize, start: usize, end: usize) -> Range<usize> {
+    let s = map_offset(segments, total, start);
+    let e = map_offset(segments, total, end);
+    s..e.max(s)
+}
+
+pub(crate) fn find_autolinks<'input>(
+    text: &str,
+    segments: &SourceMap,
+    preceding: Option<u8>,
+) -> Option<Vec<(Event<'input>, Range<usize>)>> {
+    let bytes = text.as_bytes();
+    let total = text.len();
+    let mut out: Vec<(Event<'input>, Range<usize>)> = Vec::new();
+    let mut last = 0;
+    let mut i = 0;
+    while i < text.len() {
+        let boundary = if i == 0 {
+            preceding.map_or(true, is_boundary_before)
+        } else {
+            is_boundary_before(bytes[i - 1])
+        };
+        if boundary {
+            if let Some((end, href, link_type)) = match_at(text, i) {
+                if last < i {
+                    out.push((
+                        Event::Text(text[last..i].to_string().into()),
+                        map_range(segments, total, last, i),
+                    ));
+                }
+                let link_range = map_range(segments, total, i, end);
+                out.push((
+                    Event::Start(Tag::Link {
+                        link_type,
+                        dest_url: href.into(),
+                        title: CowStr::from(""),
+                        id: CowStr::from(""),
+                    }),
+                    link_range.clone(),
+                ));
+                out.push((Event::Text(text[i..end].to_string().into()), link_range.clone()));
+                out.push((Event::End(TagEnd::Link), link_range));
+                last = end;
+                i = end;
+                continue;
+            }
+        }
+        i += 1;
+        while i < text.len() && (bytes[i] & 0xC0) == 0x80 {
+            i += 1;
+        }
+    }
+    if out.is_empty() {
+        return None;
+    }
+    if last < text.len() {
+        out.push((
+            Event::Text(text[last..].to_string().into()),
+            map_range(segments, total, last, total),
+        ));
+    }
+    Some(out)
+}
+
+fn is_boundary_before(b: u8) -> bool {
+    b.is_ascii_whitespace() || matches!(b, b'*' | b'_' | b'~' | b'(')
+}
+
+/// Whether the text ends with an autolink whose recognized run reaches the very end. Used to decide
+/// whether an interrupting inline construct (such as emphasis) is actually part of a longer URL.
+pub(crate) fn url_reaches_end(text: &str) -> bool {
+    let bytes = text.as_bytes();
+    let mut start = text.len();
+    while start > 0 && !is_boundary_before(bytes[start - 1]) {
+        start -= 1;
+    }
+    while start < text.len() && (bytes[start] & 0xC0) == 0x80 {
+        start += 1;
+    }
+    match match_at(text, start) {
+        Some((end, _, _)) => end == text.len(),
+        None => false,
+    }
+}
+
+fn match_at(text: &str, i: usize) -> Option<(usize, String, LinkType)> {
+    let rest = &text[i..];
+    if rest.starts_with("https://") {
+        let end_rel = scan_url_body(rest, 8)?;
+        return Some((i + end_rel, rest[..end_rel].to_string(), LinkType::Autolink));
+    }
+    if rest.starts_with("http://") {
+        let end_rel = scan_url_body(rest, 7)?;
+        return Some((i + end_rel, rest[..end_rel].to_string(), LinkType::Autolink));
+    }
+    if rest.starts_with("www.") {
+        let end_rel = scan_url_body(rest, 0)?;
+        return Some((i + end_rel, format!("http://{}", &rest[..end_rel]), LinkType::Autolink));
+    }
+    if let Some(end_rel) = scan_email(rest) {
+        return Some((i + end_rel, rest[..end_rel].to_string(), LinkType::Email));
+    }
+    None
+}
+
+fn scan_url_body(s: &str, host_start: usize) -> Option<usize> {
+    let bytes = s.as_bytes();
+    if host_start >= s.len() || !bytes[host_start].is_ascii_alphanumeric() {
+        return None;
+    }
+    let mut end = host_start;
+    while end < s.len() && !bytes[end].is_ascii_whitespace() && bytes[end] != b'<' {
+        end += 1;
+    }
+    end = trim_trailing(&s[..end]);
+    if end <= host_start {
+        return None;
+    }
+    let host_end = s[host_start..end]
+        .find(['/', '?', '#'])
+        .map(|p| host_start + p)
+        .unwrap_or(end);
+    if !is_valid_domain(&s[host_start..host_end]) {
+        return None;
+    }
+    Some(end)
+}
+
+fn is_valid_domain(host: &str) -> bool {
+    if !host
+        .bytes()
+        .all(|b| b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.'))
+    {
+        return false;
+    }
+    let segments: Vec<&str> = host.split('.').collect();
+    if segments.len() < 2 {
+        return false;
+    }
+    if segments.iter().any(|s| s.is_empty()) {
+        return false;
+    }
+    let n = segments.len();
+    if segments[n - 1].contains('_') || segments[n - 2].contains('_') {
+        return false;
+    }
+    if host.ends_with('-') {
+        return false;
+    }
+    true
+}
+
+fn scan_email(s: &str) -> Option<usize> {
+    let bytes = s.as_bytes();
+    let mut i = 0;
+    while i < s.len()
+        && (bytes[i].is_ascii_alphanumeric() || matches!(bytes[i], b'.' | b'_' | b'+' | b'-'))
+    {
+        i += 1;
+    }
+    if i == 0 || i >= s.len() || bytes[i] != b'@' {
+        return None;
+    }
+    let domain_start = i + 1;
+    let mut j = domain_start;
+    while j < s.len() && (bytes[j].is_ascii_alphanumeric() || matches!(bytes[j], b'-' | b'.' | b'_'))
+    {
+        j += 1;
+    }
+    let mut end = j;
+    while end > domain_start && matches!(bytes[end - 1], b'_' | b'.') {
+        end -= 1;
+    }
+    if !is_valid_domain(&s[domain_start..end]) {
+        return None;
+    }
+    Some(end)
+}
+
+fn trim_trailing(link: &str) -> usize {
+    let bytes = link.as_bytes();
+    let mut end = link.len();
+    loop {
+        let before = end;
+        while end > 0 && matches!(bytes[end - 1], b'?' | b'!' | b'.' | b',' | b':' | b'*' | b'_' | b'~')
+        {
+            end -= 1;
+        }
+        if end > 0 && bytes[end - 1] == b')' {
+            let open = link[..end].bytes().filter(|&c| c == b'(').count();
+            let close = link[..end].bytes().filter(|&c| c == b')').count();
+            let mut excess = close.saturating_sub(open);
+            while excess > 0 && end > 0 && bytes[end - 1] == b')' {
+                end -= 1;
+                excess -= 1;
+            }
+        }
+        if end == before {
+            break;
+        }
+    }
+    end
+}
