+    );
+}
+
+#[test]
+fn not_linked_inside_existing_link() {
+    assert_eq!(
+        render("[label](http://dest.example) http://real.example"),
+        "<p><a href=\"http://dest.example\">label</a> \
+<a href=\"http://real.example\">http://real.example</a></p>\n"
+    );
+}
+
+#[test]
+fn not_linked_inside_existing_autolink() {
+    assert_eq!(
+        render("<http://angle.example> http://real.example"),
+        "<p><a href=\"http://angle.example\">http://angle.example</a> \
