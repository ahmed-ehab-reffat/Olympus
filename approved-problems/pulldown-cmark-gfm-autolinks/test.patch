+#[test]
+fn works_alongside_strikethrough_extension() {
+    let mut opts = Options::from_bits_truncate(1 << 18);
+    opts.insert(Options::ENABLE_STRIKETHROUGH);
+    let mut s = String::new();
+    html::push_html(&mut s, Parser::new_ext("~http://ok.example~", opts));
+    assert_eq!(s, "<p><del><a href=\"http://ok.example\">http://ok.example</a></del></p>\n");
