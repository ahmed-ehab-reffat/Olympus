+}
+
+fn first_link_span(md: &str) -> String {
+    for (event, range) in Parser::new_ext(md, autolink_options()).into_offset_iter() {
+        if let Event::Start(Tag::Link { .. }) = event {
+            return md[range].to_string();
+        }
+    }
+    panic!("expected an autolink");
+}
+
+#[test]
+fn offset_iter_spans_cover_the_recognized_run() {
+    assert_eq!(first_link_span("see http://example.com/x_y here."), "http://example.com/x_y");
+}
+
+#[test]
+fn offset_iter_span_for_www_excludes_trailing_punctuation() {
+    assert_eq!(first_link_span("see www.example.com. here"), "www.example.com");
+}
+
+#[test]
+fn offset_iter_span_for_email_excludes_trailing_punctuation() {
+    assert_eq!(first_link_span("mail foo@example.com. here"), "foo@example.com");
+}
+
+#[test]
+fn offset_iter_span_stops_at_a_crossing_code_span() {
+    assert_eq!(first_link_span("www.example.com/`code`"), "www.example.com/");
+}
+
+#[test]
+fn offset_iter_span_stops_at_a_crossing_link() {
