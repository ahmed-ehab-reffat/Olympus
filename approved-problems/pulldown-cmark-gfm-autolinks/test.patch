+#![cfg(feature = "html")]
+
+use pulldown_cmark::{html, Event, LinkType, Options, Parser, Tag};
+
+fn autolink_options() -> Options {
+    Options::from_bits_truncate(1 << 18)
+}
+
+fn render_with(opts: Options, input: &str) -> String {
+    let mut s = String::new();
+    html::push_html(&mut s, Parser::new_ext(input, opts));
+    s
+}
+
+fn render(input: &str) -> String {
+    render_with(autolink_options(), input)
+}
+
+#[test]
+fn http_url_is_linked() {
+    assert_eq!(
+        render("see http://example.com/a here"),
+        "<p>see <a href=\"http://example.com/a\">http://example.com/a</a> here</p>\n"
+    );
+}
+
+#[test]
+fn https_url_is_linked() {
+    assert_eq!(
+        render("https://example.com"),
+        "<p><a href=\"https://example.com\">https://example.com</a></p>\n"
+    );
+}
+
+#[test]
+fn www_url_gets_http_scheme_in_destination_only() {
+    assert_eq!(
+        render("www.example.com"),
+        "<p><a href=\"http://www.example.com\">www.example.com</a></p>\n"
+    );
+}
+
+#[test]
+fn email_becomes_mailto_link() {
+    assert_eq!(
+        render("write to john.doe@example.com now"),
+        "<p>write to <a href=\"mailto:john.doe@example.com\">john.doe@example.com</a> now</p>\n"
+    );
+}
+
+#[test]
+fn bare_url_autolinks_flag_is_named_and_at_bit_18() {
+    assert!(Options::from_bits(1 << 18).is_some());
+    assert!(format!("{:?}", Options::from_bits_truncate(1 << 18))
+        .contains("ENABLE_BARE_URL_AUTOLINKS"));
+}
+
+#[test]
+fn url_containing_emphasis_markers_links_the_whole_run() {
+    assert_eq!(
+        render("http://example.com/a*b*c"),
+        "<p><a href=\"http://example.com/a*b*c\">http://example.com/a*b*c</a></p>\n"
+    );
+}
+
+#[test]
+fn url_containing_strong_markers_links_the_whole_run() {
+    assert_eq!(
+        render("http://example.com/x**y**z"),
+        "<p><a href=\"http://example.com/x**y**z\">http://example.com/x**y**z</a></p>\n"
+    );
+}
+
+#[test]
+fn emphasis_after_url_and_space_is_not_absorbed() {
+    assert_eq!(
+        render("see http://a.example *really*"),
+        "<p>see <a href=\"http://a.example\">http://a.example</a> <em>really</em></p>\n"
+    );
+}
+
+#[test]
+fn link_events_carry_expected_type_and_destination() {
+    let mut saw_www = false;
+    for event in Parser::new_ext("www.example.com", autolink_options()) {
+        if let Event::Start(Tag::Link { link_type, dest_url, .. }) = event {
+            assert_eq!(link_type, LinkType::Autolink);
+            assert_eq!(dest_url.as_ref(), "http://www.example.com");
+            saw_www = true;
+        }
+    }
+    assert!(saw_www);
+
+    let mut saw_email = false;
+    for event in Parser::new_ext("a@example.com", autolink_options()) {
+        if let Event::Start(Tag::Link { link_type, dest_url, .. }) = event {
+            assert_eq!(link_type, LinkType::Email);
+            assert_eq!(dest_url.as_ref(), "a@example.com");
+            saw_email = true;
+        }
+    }
+    assert!(saw_email);
+}
+
+#[test]
+fn host_with_disallowed_character_is_not_linked() {
+    assert_eq!(
+        render("http://ex%ample.com and http://ok.example"),
+        "<p>http://ex%ample.com and <a href=\"http://ok.example\">http://ok.example</a></p>\n"
+    );
+}
+
+#[test]
+fn disabled_by_default() {
+    assert!(render("see http://example.com here").contains("<a href=\"http://example.com\">"));
+    assert!(!render_with(Options::empty(), "see http://example.com here").contains("<a "));
+}
+
+#[test]
+fn enable_gfm_alone_does_not_enable_bare_autolinks() {
+    assert!(!render_with(Options::ENABLE_GFM, "http://example.com").contains("<a "));
+    assert!(render("http://example.com").contains("<a href=\"http://example.com\">"));
+}
+
+#[test]
+fn trailing_punctuation_is_excluded() {
+    assert_eq!(
+        render("visit https://example.com/a."),
+        "<p>visit <a href=\"https://example.com/a\">https://example.com/a</a>.</p>\n"
+    );
+}
+
+#[test]
+fn every_trailing_punctuation_character_is_excluded() {
+    for suffix in ["?", "!", ".", ",", ":", "*", "_", "~"] {
+        let mut input = String::from("https://example.com/a");
+        input.push_str(suffix);
+        let mut expected =
+            String::from("<p><a href=\"https://example.com/a\">https://example.com/a</a>");
+        expected.push_str(suffix);
+        expected.push_str("</p>\n");
+        assert_eq!(render(&input), expected, "failed for trailing {suffix:?}");
+    }
+}
+
+#[test]
+fn interior_punctuation_is_kept() {
+    assert_eq!(
+        render("https://example.com/a.b.c/d"),
+        "<p><a href=\"https://example.com/a.b.c/d\">https://example.com/a.b.c/d</a></p>\n"
+    );
+}
+
+#[test]
+fn balanced_closing_paren_is_kept() {
+    assert_eq!(
+        render("https://en.wikipedia.org/wiki/Ruby_(programming_language)"),
+        "<p><a href=\"https://en.wikipedia.org/wiki/Ruby_(programming_language)\">\
+https://en.wikipedia.org/wiki/Ruby_(programming_language)</a></p>\n"
+    );
+}
+
+#[test]
+fn unbalanced_closing_paren_is_excluded() {
+    assert_eq!(
+        render("(see https://example.com/a)"),
+        "<p>(see <a href=\"https://example.com/a\">https://example.com/a</a>)</p>\n"
+    );
+}
+
+#[test]
+fn trimming_one_trailing_character_exposes_another() {
+    assert_eq!(
+        render("see https://example.com/a)._ here"),
+        "<p>see <a href=\"https://example.com/a\">https://example.com/a</a>)._ here</p>\n"
+    );
+}
+
+#[test]
+fn autolink_only_after_a_valid_boundary() {
+    assert_eq!(
+        render("x.http://example.com and http://ok.com"),
+        "<p>x.http://example.com and <a href=\"http://ok.com\">http://ok.com</a></p>\n"
+    );
+}
+
+#[test]
+fn autolink_after_a_newline_boundary() {
+    assert_eq!(
+        render("see\nhttp://example.com"),
+        "<p>see\n<a href=\"http://example.com\">http://example.com</a></p>\n"
+    );
+}
+
+#[test]
+fn autolink_after_a_literal_asterisk_boundary() {
+    assert_eq!(
+        render("x*http://ok.example"),
+        "<p>x*<a href=\"http://ok.example\">http://ok.example</a></p>\n"
+    );
+}
+
+#[test]
+fn autolink_after_an_underscore_boundary() {
+    assert_eq!(
+        render("_http://example.com_"),
+        "<p><em><a href=\"http://example.com\">http://example.com</a></em></p>\n"
+    );
+}
+
+#[test]
+fn not_linked_inside_code_span() {
+    assert_eq!(
+        render("`http://code.example` and http://real.example"),
+        "<p><code>http://code.example</code> and \
+<a href=\"http://real.example\">http://real.example</a></p>\n"
+    );
+}
+
+#[test]
+fn not_linked_inside_code_block() {
+    assert_eq!(
+        render("```\nhttp://code.example\n```\n\nhttp://real.example"),
+        "<pre><code>http://code.example\n</code></pre>\n\
