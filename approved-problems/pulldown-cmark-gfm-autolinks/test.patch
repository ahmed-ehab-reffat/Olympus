+    );
+}
+
+#[test]
+fn host_without_dot_is_not_linked() {
+    assert_eq!(
+        render("http://localhost/x and http://has.dot/y"),
+        "<p>http://localhost/x and <a href=\"http://has.dot/y\">http://has.dot/y</a></p>\n"
+    );
+}
+
+#[test]
+fn host_ending_in_hyphen_is_not_linked() {
+    assert_eq!(
+        render("http://example.com- and http://ok.example"),
+        "<p>http://example.com- and <a href=\"http://ok.example\">http://ok.example</a></p>\n"
+    );
+}
+
+#[test]
+fn underscore_in_last_two_domain_segments_rejects() {
+    assert_eq!(
+        render("http://foo_bar.com and http://foo_bar.example.com"),
+        "<p>http://foo_bar.com and \
+<a href=\"http://foo_bar.example.com\">http://foo_bar.example.com</a></p>\n"
+    );
+}
+
+#[test]
+fn email_domain_ending_in_hyphen_is_not_linked() {
+    assert_eq!(
+        render("mail foo@example.com- and bar@ok.example"),
+        "<p>mail foo@example.com- and <a href=\"mailto:bar@ok.example\">bar@ok.example</a></p>\n"
+    );
+}
+
+#[test]
+fn email_domain_without_dot_is_not_linked() {
+    assert_eq!(
+        render("foo@localhost and bar@example.com"),
+        "<p>foo@localhost and <a href=\"mailto:bar@example.com\">bar@example.com</a></p>\n"
+    );
+}
+
+#[test]
+fn email_domain_with_underscore_in_last_two_segments_is_not_linked() {
+    assert_eq!(
+        render("a@bar_baz.com and b@example.com"),
+        "<p>a@bar_baz.com and <a href=\"mailto:b@example.com\">b@example.com</a></p>\n"
+    );
+}
+
+#[test]
+fn linked_inside_emphasis() {
+    assert_eq!(
+        render("*http://example.com*"),
+        "<p><em><a href=\"http://example.com\">http://example.com</a></em></p>\n"
+    );
+}
+
+#[test]
+fn linked_inside_list_and_blockquote() {
+    assert_eq!(
+        render("> visit http://example.com"),
+        "<blockquote>\n<p>visit <a href=\"http://example.com\">http://example.com</a></p>\n</blockquote>\n"
+    );
+    assert_eq!(
+        render("- http://example.com\n"),
+        "<ul>\n<li><a href=\"http://example.com\">http://example.com</a></li>\n</ul>\n"
+    );
+}
+
+#[test]
+fn url_containing_underscore_is_not_split() {
+    assert_eq!(
+        render("http://example.com/a_b_c"),
+        "<p><a href=\"http://example.com/a_b_c\">http://example.com/a_b_c</a></p>\n"
+    );
+}
+
+#[test]
+fn two_autolinks_in_one_paragraph() {
+    assert_eq!(
+        render("http://a.com and http://b.com"),
+        "<p><a href=\"http://a.com\">http://a.com</a> and <a href=\"http://b.com\">http://b.com</a></p>\n"
+    );
+}
+
+#[test]
+fn bare_url_in_link_text_is_not_autolinked() {
+    assert_eq!(
+        render("[see http://inner.example](/d) http://real.example"),
+        "<p><a href=\"/d\">see http://inner.example</a> \
+<a href=\"http://real.example\">http://real.example</a></p>\n"
+    );
+}
+
+#[test]
+fn url_as_image_destination_is_not_autolinked() {
+    assert_eq!(
+        render("![alt](http://img.example/a.png) http://real.example"),
+        "<p><img src=\"http://img.example/a.png\" alt=\"alt\" /> \
