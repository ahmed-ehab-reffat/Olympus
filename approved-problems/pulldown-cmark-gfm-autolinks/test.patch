+    );
+}
+
+#[test]
+fn not_linked_inside_image_description() {
+    assert_eq!(
+        render("![http://alt.example](/a.png) http://real.example"),
+        "<p><img src=\"/a.png\" alt=\"http://alt.example\" /> \
