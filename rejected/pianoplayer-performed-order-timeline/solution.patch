+def performance_order(measures: list[MeasureInfo]) -> list[int]:
+    order: list[int] = []
+    taken: dict[int, int] = {}
+    section_start = 0
+    pass_no = 1
+    jumped = False
+    used_jumps: set[int] = set()
+    i = 0
+    while i < len(measures):
+        m = measures[i]
+        if m.forward:
+            section_start = i
+        if m.endings:
+            if jumped:
+                if m.ending_has_repeat:
+                    i += 1
+                    continue
+            elif pass_no not in m.endings:
+                i += 1
+                continue
+        if not m.endings and order and order[-1] < i and measures[order[-1]].endings:
+            pass_no = 1
+            section_start = i
+        order.append(i)
+        if jumped and m.fine:
+            break
+        if jumped and m.tocoda:
+            target = next(
+                (k for k in range(i + 1, len(measures)) if measures[k].coda == m.tocoda),
+                None,
+            )
+            if target is not None:
+                i = target
+                continue
+        if m.backward_times and not jumped:
+            count = taken.get(i, 1)
+            if count < m.backward_times:
+                taken[i] = count + 1
+                pass_no = count + 1
+                i = section_start
+                continue
+            taken[i] = 0
+            pass_no = 1
+            section_start = i + 1
+        if (m.dacapo or m.dalsegno) and i not in used_jumps:
+            used_jumps.add(i)
+            jumped = True
+            target = 0
+            if m.dalsegno:
+                target = next(
+                    (k for k, mm in enumerate(measures) if mm.segno == m.dalsegno), 0
+                )
+            i = target
+            continue
+        i += 1
+    return order
+
+
+def unfold_part(part: PartInfo) -> PartInfo:
+    if not part.measures:
+        return part
+    by_measure: dict[int, list[EventInfo]] = {}
+    for evt in part.events:
+        by_measure.setdefault(evt.measure_index, []).append(evt)
+
+    events: list[EventInfo] = []
+    tempo_points: list[tuple[float, float]] = [(0.0, 120.0)]
+    cursor = 0.0
+    for idx in performance_order(part.measures):
+        measure = part.measures[idx]
+        shift = cursor - measure.start
+        for rel, bpm in measure.tempos:
+            tempo_points.append((cursor + rel, bpm))
+        for evt in by_measure.get(idx, []):
+            events.append(replace(evt, offset=evt.offset + shift))
+        cursor += measure.end - measure.start
+
+    tempo_points.sort(key=lambda point: point[0])
+    starts: list[float] = []
+    elapsed = 0.0
+    for k, (q, bpm) in enumerate(tempo_points):
+        if k:
+            prev_q, prev_bpm = tempo_points[k - 1]
+            elapsed += (q - prev_q) * 60.0 / prev_bpm
+        starts.append(elapsed)
+
+    def seconds(q: float) -> float:
+        k = len(tempo_points) - 1
+        while k > 0 and tempo_points[k][0] > q + 1e-9:
+            k -= 1
+        point_q, bpm = tempo_points[k]
+        return starts[k] + (q - point_q) * 60.0 / bpm
+
+    for evt in events:
+        end = seconds(evt.offset + evt.duration)
+        evt.offset = seconds(evt.offset)
+        evt.duration = end - evt.offset
+    return PartInfo(part_id=part.part_id, events=events, measures=part.measures)
+
