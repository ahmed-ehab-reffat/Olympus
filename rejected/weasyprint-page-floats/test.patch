+
+
+@assert_no_logs
+def test_a_page_float_inside_a_nested_formatting_context_anchors_to_the_page():
+    page, = render(
+        '200px 100px',
+        'section { overflow: hidden } div { float: top; width: 40px; height: 20px }',
