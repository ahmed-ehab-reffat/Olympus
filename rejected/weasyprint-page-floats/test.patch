+@pytest.mark.parametrize('display', ['flex', 'grid'])
+@pytest.mark.parametrize('side', ['top', 'bottom'])
+def test_columns_in_a_flex_or_grid_container_do_not_overlap_a_page_float(
+        display, side):
+    lines = ''.join(f'<p>l{index}</p>' for index in range(20))
+    pages = render(
+        '200px 100px',
+        'section { display: %s } article { columns: 2; column-gap: 0 }'
+        'p { margin: 0 } div { float: %s; width: 200px; height: 30px }'
+        % (display, side),
+        f'<div>F</div><section><article>{lines}</article></section>')
+    float_box, = page_floats(pages[0])
+    _, float_y, _, float_height = outer_area(float_box)
+    assert float_y == (0 if side == 'top' else 70)
+    children = [
+        child for box in pages[0].descendants() if box.element_tag == 'article'
+        for column in box.children for child in column.children]
+    assert children
+    for child in children:
+        assert (
+            child.position_y + child.margin_height() <= float_y or
+            child.position_y >= float_y + float_height)
+    assert [
+        text for page in pages for box in page.descendants()
+        if box.element_tag == 'p' and isinstance(box, boxes.BlockBox)
+        for text in texts(box)
+    ] == [f'l{index}' for index in range(20)]
