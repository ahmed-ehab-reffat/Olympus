+    assert outer_area(float_box) == (0, 0, 50, 30)
+    assert (float_box.content_box_x(), float_box.content_box_y()) == (5, 5)
+
+
+@assert_no_logs
+def test_several_top_floats_stack_downwards_in_document_order():
