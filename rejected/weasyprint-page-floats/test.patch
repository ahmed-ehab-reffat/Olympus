+    float_box, = page_floats(page)
+    assert outer_area(float_box) == (0, 0, 40, 20)
+    body = body_of(page)
+    assert [child.element_tag for child in body.children] == ['p', 'section', 'p']
+
+
+@assert_no_logs
+def test_a_page_float_inside_a_table_cell_anchors_to_the_page():
+    page, = render(
+        '200px 100px', 'div { float: top; width: 40px; height: 20px }',
+        '<p>one</p><table><tr><td><div>F</div></td></tr></table>')
+    float_box, = page_floats(page)
+    assert outer_area(float_box) == (0, 0, 40, 20)
+
+
+@assert_no_logs
+@pytest.mark.parametrize('outer', ['left', 'right'])
+@pytest.mark.parametrize('side', ['top', 'bottom'])
+def test_a_page_float_inside_a_normal_float_is_an_ordinary_float(outer, side):
+    page, = render(
+        '200px 100px',
+        'section { float: %s; width: 100px }'
+        'div { float: %s; width: 40px; height: 20px }' % (outer, side),
+        '<p>one</p><section><div>F</div>text</section>')
+    assert not page_floats(page)
+    section, = [
+        box for box in body_of(page).children
+        if box.element_tag == 'section' and box.is_floated()]
+    floated = [child for child in section.children if child.element_tag == 'div']
+    assert len(floated) == 1
+    assert floated[0].style['float'] == 'left'
+    assert not floated[0].is_page_floated()
+    assert floated[0].position_x == section.content_box_x()
+
+
+@assert_no_logs
+def test_a_bottom_float_sits_above_the_footnote_area():
