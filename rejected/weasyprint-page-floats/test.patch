+        '200px 100px',
+        'div { float: bottom; width: 40px; height: 20px } .fn { float: footnote }',
+        '<p>one<span class="fn">note</span></p><div>F</div>')
+    html, footnote_area = page.children
+    float_box, = [child for child in html.children if child.is_page_floated()]
+    assert float_box.position_y + float_box.margin_height() == footnote_area.position_y
