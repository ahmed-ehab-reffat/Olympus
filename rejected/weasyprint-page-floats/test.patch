+
+
+@assert_no_logs
+def test_content_laid_out_before_the_anchor_avoids_the_float():
+    page, = render(
+        '200px 300px', 'div { float: top; width: 200px; height: 40px }',
+        '<p>one</p><p>two</p><div>F</div>')
+    body = body_of(page)
+    first, second = body.children
+    assert first.children[0].position_y == 40
+    assert second.children[0].position_y == 50
+
+
+@assert_no_logs
+def test_clear_left_clears_a_top_page_float():
