+    assert outer_area(bottom_float) == (0, 75, 60, 25)
+
+
+@assert_no_logs
+def test_a_page_float_that_does_not_fit_moves_to_the_next_page():
+    page_1, page_2 = render(
+        '200px 100px', 'div { float: top; width: 60px; height: 60px }',
+        '<p>one</p><div>1</div><div>2</div><p>two</p>')
+    first, = page_floats(page_1)
+    second, = page_floats(page_2)
+    assert texts(first) == ['1']
+    assert texts(second) == ['2']
+    assert second.position_y == 0
+
+
+@assert_no_logs
+def test_a_deferred_page_float_does_not_move_its_anchor_content():
+    page_1, page_2 = render(
+        '200px 100px', 'div { float: top; width: 60px; height: 60px }',
+        '<p>one</p><div>1</div><div>2</div><p>two</p>')
+    assert texts(body_of(page_1)) == ['one', 'two']
+    html, = page_2.children[:1]
+    assert [child.element_tag for child in html.children] == ['div']
+
+
+@assert_no_logs
+def test_a_page_float_taller_than_the_page_is_placed_on_its_own_page():
+    page, = render(
+        '200px 100px', 'div { float: top; width: 60px; height: 120px }',
+        '<p>one</p><div>F</div><p>two</p>')
+    float_box, = page_floats(page)
+    assert outer_area(float_box) == (0, 0, 60, 120)
+
+
+@assert_no_logs
+def test_a_page_float_is_never_fragmented():
+    page, = render(
+        '200px 100px', 'div { float: top; width: 60px; height: 120px }',
+        '<p>one</p><div>F</div>')
