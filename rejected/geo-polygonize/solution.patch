+use crate::{Coord, LineString, MultiPolygon, Polygon};
+
+/// Turns traced faces into polygons: positively-oriented rings become shells,
+/// negatively-oriented rings become holes, and each hole is placed inside the
+/// smallest shell that strictly contains it. Rings that no shell contains (the
+/// unbounded face) are dropped.
+pub(super) fn build_polygons(rings: Vec<Vec<Coord<f64>>>) -> MultiPolygon<f64> {
+    let mut shells: Vec<Vec<Coord<f64>>> = Vec::new();
+    let mut holes: Vec<Vec<Coord<f64>>> = Vec::new();
+    for ring in rings {
+        let area = signed_area(&ring);
+        if area > 0.0 {
+            shells.push(ring);
+        } else if area < 0.0 {
+            holes.push(ring);
+        }
+    }
+
+    let shell_areas: Vec<f64> = shells.iter().map(|s| signed_area(s).abs()).collect();
+    let mut assigned: Vec<Vec<Vec<Coord<f64>>>> = vec![Vec::new(); shells.len()];
+
+    for hole in holes {
+        let mut best: Option<usize> = None;
+        for (index, shell) in shells.iter().enumerate() {
+            if !ring_strictly_contains(shell, &hole) {
+                continue;
+            }
+            if best.map_or(true, |b| shell_areas[index] < shell_areas[b]) {
+                best = Some(index);
+            }
+        }
+        if let Some(index) = best {
+            assigned[index].push(hole);
+        }
+    }
+
+    let polygons = shells
+        .into_iter()
+        .zip(assigned)
+        .map(|(shell, interiors)| {
+            Polygon::new(
+                LineString::new(shell),
+                interiors.into_iter().map(LineString::new).collect(),
+            )
+        })
+        .collect();
+    MultiPolygon::new(polygons)
+}
+
+fn signed_area(ring: &[Coord<f64>]) -> f64 {
+    let n = ring.len();
+    if n < 3 {
+        return 0.0;
+    }
+    let mut sum = 0.0;
+    for i in 0..n {
+        let a = ring[i];
+        let b = ring[(i + 1) % n];
+        sum += a.x * b.y - b.x * a.y;
+    }
+    sum / 2.0
+}
+
+/// True when every vertex of `hole` lies inside `shell` and at least one lies
+/// strictly inside it (never merely on its boundary). This distinguishes a real
+/// hole, whose vertices sit strictly within its container, from the unbounded
+/// face, whose vertices lie on the shells it borders.
+fn ring_strictly_contains(shell: &[Coord<f64>], hole: &[Coord<f64>]) -> bool {
+    let mut any_strictly_inside = false;
+    for &vertex in hole {
+        if point_on_ring(vertex, shell) {
+            continue;
+        }
+        if !point_in_ring(vertex, shell) {
+            return false;
+        }
+        any_strictly_inside = true;
+    }
+    any_strictly_inside
+}
+
+fn point_in_ring(p: Coord<f64>, ring: &[Coord<f64>]) -> bool {
+    let n = ring.len();
+    let mut inside = false;
+    let mut j = n - 1;
+    for i in 0..n {
+        let a = ring[i];
+        let b = ring[j];
+        if (a.y > p.y) != (b.y > p.y) {
+            let x_crossing = (b.x - a.x) * (p.y - a.y) / (b.y - a.y) + a.x;
+            if p.x < x_crossing {
+                inside = !inside;
+            }
+        }
+        j = i;
+    }
+    inside
+}
+
+fn point_on_ring(p: Coord<f64>, ring: &[Coord<f64>]) -> bool {
+    let n = ring.len();
+    (0..n).any(|i| point_on_segment(p, ring[i], ring[(i + 1) % n]))
+}
+
+fn point_on_segment(p: Coord<f64>, a: Coord<f64>, b: Coord<f64>) -> bool {
+    let cross = (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
+    if cross != 0.0 {
+        return false;
+    }
+    let dot = (p.x - a.x) * (p.x - b.x) + (p.y - a.y) * (p.y - b.y);
+    dot <= 0.0
+}
