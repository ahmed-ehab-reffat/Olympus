@@ -0,0 +1,240 @@
+use std::collections::HashMap;
+
+use crate::{Coord, LineString};
+
+/// A node is identified by the exact bit pattern of a coordinate, so two
+/// endpoints are the same node only when their `x` and `y` are exactly equal.
+type NodeKey = (u64, u64);
+
+fn node_key(coord: &Coord<f64>) -> NodeKey {
+    (coord.x.to_bits(), coord.y.to_bits())
+}
+
+fn endpoints(edge: &LineString<f64>) -> (NodeKey, NodeKey) {
+    (node_key(edge.0.first().unwrap()), node_key(edge.0.last().unwrap()))
+}
+
+/// The result of reducing a set of lines to the parts that bound polygons.
+pub(super) struct Decomposition {
+    /// Traced minimal faces, each a ring of coordinates (first not repeated).
+    pub rings: Vec<Vec<Coord<f64>>>,
+    /// Lines pruned because they dangle from a degree-one endpoint.
+    pub dangles: Vec<LineString<f64>>,
+    /// Lines removed because they bridge the graph without bounding any face.
+    pub cut_edges: Vec<LineString<f64>>,
+}
+
+/// Reduces `lines` to bounding edges — removing dangles and cut edges — and
+/// traces the faces the survivors enclose.
+pub(super) fn decompose(lines: Vec<LineString<f64>>) -> Decomposition {
+    let mut edges: Vec<LineString<f64>> = lines.into_iter().filter(|l| l.0.len() >= 2).collect();
+    let mut dangles = Vec::new();
+    let mut cut_edges = Vec::new();
+
+    loop {
+        let pruned = remove_dangles(&mut edges);
+        let pruned_any = !pruned.is_empty();
+        dangles.extend(pruned);
+
+        let cut = remove_cut_edges(&mut edges);
+        let cut_any = !cut.is_empty();
+        cut_edges.extend(cut);
+
+        if !pruned_any && !cut_any {
+            break;
+        }
+    }
+
+    let rings = if edges.is_empty() { Vec::new() } else { trace_faces(&edges) };
+    Decomposition { rings, dangles, cut_edges }
+}
+
+/// Repeatedly removes every edge touching a degree-one node until only edges on
+/// cycles remain, returning the removed edges.
+fn remove_dangles(edges: &mut Vec<LineString<f64>>) -> Vec<LineString<f64>> {
+    let mut removed = Vec::new();
+    loop {
+        let mut degree: HashMap<NodeKey, usize> = HashMap::new();
+        for edge in edges.iter() {
+            let (a, b) = endpoints(edge);
+            *degree.entry(a).or_default() += 1;
+            *degree.entry(b).or_default() += 1;
+        }
+        let mut kept = Vec::with_capacity(edges.len());
+        let mut removed_this_pass = 0;
+        for edge in edges.drain(..) {
+            let (a, b) = endpoints(&edge);
+            if degree[&a] >= 2 && degree[&b] >= 2 {
+                kept.push(edge);
+            } else {
+                removed.push(edge);
+                removed_this_pass += 1;
+            }
+        }
+        *edges = kept;
+        if removed_this_pass == 0 {
+            break;
+        }
+    }
+    removed
+}
+
+/// Removes bridges — edges whose removal disconnects the graph — since they lie
+/// on no cycle and cannot bound a face. Returns the removed edges.
+fn remove_cut_edges(edges: &mut Vec<LineString<f64>>) -> Vec<LineString<f64>> {
+    if edges.is_empty() {
+        return Vec::new();
+    }
+
+    // Index the nodes.
+    let mut ids: HashMap<NodeKey, usize> = HashMap::new();
+    for edge in edges.iter() {
+        let (a, b) = endpoints(edge);
+        let next = ids.len();
+        ids.entry(a).or_insert(next);
+        let next = ids.len();
+        ids.entry(b).or_insert(next);
+    }
+    let node_count = ids.len();
+
+    // Adjacency as (neighbour node, edge index).
+    let mut adjacency: Vec<Vec<(usize, usize)>> = vec![Vec::new(); node_count];
+    for (index, edge) in edges.iter().enumerate() {
+        let (a, b) = endpoints(edge);
+        let (a, b) = (ids[&a], ids[&b]);
+        adjacency[a].push((b, index));
+        adjacency[b].push((a, index));
+    }
+
+    let bridges = find_bridges(node_count, &adjacency);
+    if bridges.is_empty() {
+        return Vec::new();
+    }
+
+    let mut removed = Vec::new();
+    let mut kept = Vec::with_capacity(edges.len());
+    for (index, edge) in edges.drain(..).enumerate() {
+        if bridges.contains(&index) {
+            removed.push(edge);
+        } else {
+            kept.push(edge);
+        }
+    }
+    *edges = kept;
+    removed
+}
+
+/// Iterative Tarjan bridge search over a multigraph; edges are identified by
+/// index so parallel edges are never mistaken for bridges.
+fn find_bridges(node_count: usize, adjacency: &[Vec<(usize, usize)>]) -> Vec<usize> {
+    let mut disc = vec![usize::MAX; node_count];
+    let mut low = vec![0usize; node_count];
+    let mut timer = 0;
+    let mut bridges = Vec::new();
+
+    for source in 0..node_count {
+        if disc[source] != usize::MAX {
+            continue;
+        }
+        disc[source] = timer;
+        low[source] = timer;
+        timer += 1;
+        // Stack of (node, parent edge index, next neighbour to visit).
+        let mut stack: Vec<(usize, usize, usize)> = vec![(source, usize::MAX, 0)];
+        while let Some(&(node, parent_edge, cursor)) = stack.last() {
+            if cursor < adjacency[node].len() {
+                stack.last_mut().unwrap().2 += 1;
+                let (neighbour, edge) = adjacency[node][cursor];
+                if edge == parent_edge {
+                    continue;
+                }
+                if disc[neighbour] == usize::MAX {
+                    disc[neighbour] = timer;
+                    low[neighbour] = timer;
+                    timer += 1;
+                    stack.push((neighbour, edge, 0));
+                } else {
+                    low[node] = low[node].min(disc[neighbour]);
+                }
+            } else {
+                stack.pop();
+                if let Some(&(parent, _, _)) = stack.last() {
+                    low[parent] = low[parent].min(low[node]);
+                    if low[node] > disc[parent] {
+                        bridges.push(parent_edge);
+                    }
+                }
+            }
+        }
+    }
+    bridges
+}
+
+/// Builds directed edges, links each into the tightest-turning face, and traces
+/// those faces into coordinate rings.
+fn trace_faces(edges: &[LineString<f64>]) -> Vec<Vec<Coord<f64>>> {
+    // Two directed edges per input line: origin -> destination and its reverse.
+    let mut coords: Vec<Vec<Coord<f64>>> = Vec::with_capacity(edges.len() * 2);
+    let mut sym = Vec::with_capacity(edges.len() * 2);
+    for edge in edges {
+        let forward = edge.0.clone();
+        let mut backward = forward.clone();
+        backward.reverse();
+        let index = coords.len();
+        coords.push(forward);
+        sym.push(index + 1);
+        coords.push(backward);
+        sym.push(index);
+    }
+
+    let departure_angle = |seq: &[Coord<f64>]| {
+        let origin = seq[0];
+        let next = seq[1];
+        (next.y - origin.y).atan2(next.x - origin.x)
+    };
+
+    // Group directed edges by origin node.
+    let mut leaving: HashMap<NodeKey, Vec<usize>> = HashMap::new();
+    for (index, seq) in coords.iter().enumerate() {
+        leaving.entry(node_key(&seq[0])).or_default().push(index);
+    }
+
+    // Around each node link every arriving edge to the next edge clockwise,
+    // i.e. the previous one in counter-clockwise angular order, so each traced
+    // face is the smallest one to that side.
+    let mut next = vec![usize::MAX; coords.len()];
+    for group in leaving.values_mut() {
+        group.sort_by(|&a, &b| {
+            departure_angle(&coords[a])
+                .partial_cmp(&departure_angle(&coords[b]))
+                .unwrap()
+        });
+        let count = group.len();
+        for position in 0..count {
+            let departing = group[position];
+            let clockwise_prev = group[(position + count - 1) % count];
+            next[sym[departing]] = clockwise_prev;
+        }
+    }
+
+    let mut visited = vec![false; coords.len()];
+    let mut rings = Vec::new();
+    for start in 0..coords.len() {
+        if visited[start] {
+            continue;
+        }
+        let mut ring = Vec::new();
+        let mut edge = start;
+        loop {
+            visited[edge] = true;
+            let seq = &coords[edge];
+            ring.extend_from_slice(&seq[..seq.len() - 1]);
+            edge = next[edge];
+            if edge == start {
+                break;
+            }
+        }
+        rings.push(ring);
+    }
+    rings
+}
