@@ -0,0 +1,103 @@
+mod assemble;
+mod graph;
+
+use crate::{
+    Geometry, GeometryCollection, Line, LineString, MultiLineString, MultiPolygon,
+};
+
+/// The outcome of [`Polygonize`]: the polygons formed by the lines, together
+/// with the lines that could not take part in a polygon.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Polygonized {
+    /// The polygons formed by the lines.
+    pub polygons: MultiPolygon<f64>,
+    /// Dangling lines: those that hang off a free endpoint and bound nothing.
+    pub dangles: MultiLineString<f64>,
+    /// Cut edges: those that connect the graph but bound no polygon (bridges).
+    pub cut_edges: MultiLineString<f64>,
+}
+
+/// Build polygons from the lines of a geometry.
+///
+/// Every [`Line`] and [`LineString`] contained in the geometry is collected —
+/// including those nested inside a [`MultiLineString`], a
+/// [`GeometryCollection`], or a [`Geometry`], recursing through nested
+/// collections — and the arrangement they form is turned into polygons. Each
+/// smallest region enclosed by the lines becomes a polygon; where the lines of
+/// one enclosed region sit inside another, the inner region is cut out as a
+/// hole of the outer polygon.
+///
+/// Lines that bound no region are not part of any polygon: a line hanging off a
+/// free endpoint is reported as a *dangle*, and a line that connects the
+/// arrangement without closing a region is reported as a *cut edge*. Non-linear
+/// geometries contribute nothing.
+///
+/// The input lines are assumed to be noded, i.e. they touch only at their
+/// endpoints. The order of the returned polygons, and the starting vertex and
+/// winding of each ring, are unspecified.
+pub trait Polygonize {
+    fn polygonize(&self) -> Polygonized;
+}
+
+impl Polygonize for MultiLineString<f64> {
+    fn polygonize(&self) -> Polygonized {
+        polygonize_lines(self.0.clone())
+    }
+}
+
+impl Polygonize for LineString<f64> {
+    fn polygonize(&self) -> Polygonized {
+        polygonize_lines(vec![self.clone()])
+    }
+}
+
+impl Polygonize for Line<f64> {
+    fn polygonize(&self) -> Polygonized {
+        polygonize_lines(vec![LineString::from(self)])
+    }
+}
+
+impl Polygonize for GeometryCollection<f64> {
+    fn polygonize(&self) -> Polygonized {
+        let mut lines = Vec::new();
+        for geometry in &self.0 {
+            collect_lines(geometry, &mut lines);
+        }
+        polygonize_lines(lines)
+    }
+}
+
+impl Polygonize for Geometry<f64> {
+    fn polygonize(&self) -> Polygonized {
+        let mut lines = Vec::new();
+        collect_lines(self, &mut lines);
+        polygonize_lines(lines)
+    }
+}
+
+fn polygonize_lines(lines: Vec<LineString<f64>>) -> Polygonized {
+    let decomposition = graph::decompose(lines);
+    Polygonized {
+        polygons: assemble::build_polygons(decomposition.rings),
+        dangles: MultiLineString::new(decomposition.dangles),
+        cut_edges: MultiLineString::new(decomposition.cut_edges),
+    }
+}
+
+/// Recursively gathers every [`Line`] and [`LineString`] reachable in
+/// `geometry`, descending into multi-geometries and nested collections.
+fn collect_lines(geometry: &Geometry<f64>, out: &mut Vec<LineString<f64>>) {
+    match geometry {
+        Geometry::Line(line) => out.push(LineString::from(line)),
+        Geometry::LineString(line_string) => out.push(line_string.clone()),
+        Geometry::MultiLineString(multi_line_string) => {
+            out.extend(multi_line_string.0.iter().cloned());
+        }
+        Geometry::GeometryCollection(collection) => {
+            for geometry in &collection.0 {
+                collect_lines(geometry, out);
+            }
+        }
+        _ => {}
+    }
+}
