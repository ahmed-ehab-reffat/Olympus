+use geo::{
+    Area, Coord, Geometry, GeometryCollection, Line, LineString, MultiLineString, Point, Polygon,
+    Polygonize,
+};
+
+fn ls(coords: &[(f64, f64)]) -> LineString<f64> {
+    LineString::new(coords.iter().map(|&(x, y)| Coord { x, y }).collect())
+}
+
+fn mls(lines: &[&[(f64, f64)]]) -> MultiLineString<f64> {
+    MultiLineString::new(lines.iter().map(|l| ls(l)).collect())
+}
+
+#[test]
+fn single_square_is_one_polygon() {
+    let input = mls(&[
+        &[(0., 0.), (2., 0.)],
+        &[(2., 0.), (2., 2.)],
+        &[(2., 2.), (0., 2.)],
+        &[(0., 2.), (0., 0.)],
+    ]);
+    let out = input.polygonize().polygons;
+    assert_eq!(out.0.len(), 1);
+    assert_eq!(out.0[0].interiors().len(), 0);
+    assert!((out.0[0].unsigned_area() - 4.0).abs() < 1e-9);
+}
+
+#[test]
+fn square_with_diagonal_is_two_triangles() {
+    let input = mls(&[
+        &[(0., 0.), (2., 0.)],
+        &[(2., 0.), (2., 2.)],
+        &[(2., 2.), (0., 2.)],
+        &[(0., 2.), (0., 0.)],
+        &[(0., 0.), (2., 2.)],
+    ]);
+    let out = input.polygonize().polygons;
+    assert_eq!(out.0.len(), 2);
+    for poly in &out.0 {
+        assert!((poly.unsigned_area() - 2.0).abs() < 1e-9);
+    }
+}
+
+#[test]
+fn grid_two_by_two_is_four_cells() {
+    let input = mls(&[
+        &[(0., 0.), (1., 0.)],
+        &[(1., 0.), (2., 0.)],
+        &[(0., 1.), (1., 1.)],
+        &[(1., 1.), (2., 1.)],
+        &[(0., 2.), (1., 2.)],
+        &[(1., 2.), (2., 2.)],
+        &[(0., 0.), (0., 1.)],
+        &[(0., 1.), (0., 2.)],
+        &[(1., 0.), (1., 1.)],
+        &[(1., 1.), (1., 2.)],
+        &[(2., 0.), (2., 1.)],
+        &[(2., 1.), (2., 2.)],
+    ]);
+    let out = input.polygonize().polygons;
+    assert_eq!(out.0.len(), 4);
+    for poly in &out.0 {
+        assert!((poly.unsigned_area() - 1.0).abs() < 1e-9);
+        assert_eq!(poly.interiors().len(), 0);
+    }
+}
+
+#[test]
+fn nested_squares_make_a_hole() {
+    let input = mls(&[
+        &[(0., 0.), (6., 0.)],
+        &[(6., 0.), (6., 6.)],
+        &[(6., 6.), (0., 6.)],
+        &[(0., 6.), (0., 0.)],
+        &[(2., 2.), (4., 2.)],
+        &[(4., 2.), (4., 4.)],
+        &[(4., 4.), (2., 4.)],
+        &[(2., 4.), (2., 2.)],
+    ]);
+    let out = input.polygonize().polygons;
+    assert_eq!(out.0.len(), 2);
+    let with_hole = out.0.iter().find(|p| p.interiors().len() == 1).expect("hole polygon");
+    let filled = out.0.iter().find(|p| p.interiors().is_empty()).expect("filled polygon");
+    assert!((with_hole.unsigned_area() - 32.0).abs() < 1e-9);
+    assert!((filled.unsigned_area() - 4.0).abs() < 1e-9);
+}
+
+#[test]
+fn dangling_line_is_reported_not_polygonized() {
+    let input = mls(&[
+        &[(0., 0.), (2., 0.)],
+        &[(2., 0.), (2., 2.)],
+        &[(2., 2.), (0., 2.)],
+        &[(0., 2.), (0., 0.)],
+        &[(2., 2.), (5., 5.)],
+    ]);
+    let result = input.polygonize();
+    assert_eq!(result.polygons.0.len(), 1);
+    assert!((result.polygons.0[0].unsigned_area() - 4.0).abs() < 1e-9);
+    assert_eq!(result.dangles.0.len(), 1);
+    assert!(result.cut_edges.0.is_empty());
+}
+
+#[test]
+fn bridge_between_two_squares_is_a_cut_edge() {
+    // Two separate squares joined by a single line: the joining line bounds no
+    // region, so it is a cut edge and both squares are still polygonized.
+    let input = mls(&[
+        &[(0., 0.), (2., 0.)],
+        &[(2., 0.), (2., 2.)],
+        &[(2., 2.), (0., 2.)],
+        &[(0., 2.), (0., 0.)],
+        &[(2., 0.), (5., 0.)], // bridge between the two squares' corners
+        &[(5., 0.), (7., 0.)],
+        &[(7., 0.), (7., 2.)],
+        &[(7., 2.), (5., 2.)],
+        &[(5., 2.), (5., 0.)],
+    ]);
+    let result = input.polygonize();
+    assert_eq!(result.polygons.0.len(), 2);
+    assert_eq!(result.cut_edges.0.len(), 1);
+    for poly in &result.polygons.0 {
+        assert!((poly.unsigned_area() - 4.0).abs() < 1e-9);
+    }
+}
+
+#[test]
+fn lines_nested_in_geometry_collection_are_used() {
+    let gc = GeometryCollection::new_from(vec![
+        Geometry::MultiLineString(mls(&[&[(0., 0.), (2., 0.)], &[(2., 0.), (2., 2.)]])),
+        Geometry::LineString(ls(&[(2., 2.), (0., 2.)])),
+        Geometry::Line(Line::new(Coord { x: 0., y: 2. }, Coord { x: 0., y: 0. })),
+    ]);
+    let out = gc.polygonize().polygons;
+    assert_eq!(out.0.len(), 1);
+    assert!((out.0[0].unsigned_area() - 4.0).abs() < 1e-9);
+}
+
+#[test]
+fn non_line_members_are_ignored() {
+    let gc = GeometryCollection::new_from(vec![
+        Geometry::Point(Point::new(1., 1.)),
+        Geometry::Polygon(Polygon::new(ls(&[(9., 9.), (10., 9.), (10., 10.)]), vec![])),
+        Geometry::MultiLineString(mls(&[
+            &[(0., 0.), (2., 0.)],
+            &[(2., 0.), (2., 2.)],
+            &[(2., 2.), (0., 2.)],
+            &[(0., 2.), (0., 0.)],
+        ])),
+    ]);
+    let out = gc.polygonize().polygons;
+    assert_eq!(out.0.len(), 1);
+    assert!((out.0[0].unsigned_area() - 4.0).abs() < 1e-9);
+}
+
+#[test]
+fn open_lines_make_no_polygon() {
+    let input = mls(&[&[(0., 0.), (2., 0.)], &[(2., 0.), (2., 2.)]]);
+    let result = input.polygonize();
+    assert_eq!(result.polygons.0.len(), 0);
+}
