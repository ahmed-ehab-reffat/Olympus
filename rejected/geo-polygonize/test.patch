+#!/usr/bin/env bash
+# Test runner.
+#
+# Usage:
+#   ./test.sh [--output_path <junit.xml>] <base|new>
+#
+#   base  run the existing geo tests in the change's blast radius (the whole
+#         geo library test suite); these must pass before and after the change.
+#   new   run the new feature tests; these fail before the solution and pass
+#         after it.
+set -uo pipefail
+
+cd /app
+
+OUTPUT_PATH=""
+if [ "${1:-}" = "--output_path" ]; then
+  OUTPUT_PATH="$2"
+  shift 2
+fi
+
+MODE="${1:-new}"
+
+# Deterministic, single-threaded config lives in .config/nextest.toml, which
+# also writes JUnit XML to target/nextest/<profile>/junit.xml.
+JUNIT_SRC="target/nextest/default/junit.xml"
+
+run() {
+  cargo nextest run --profile default "$@"
+}
+
+STATUS=0
+case "$MODE" in
+  base)
+    run -p geo --lib
+    STATUS=$?
+    ;;
+  new)
+    run -p geo --test polygonize
+    STATUS=$?
+    ;;
+  *)
+    echo "unknown mode: $MODE (expected base or new)" >&2
+    exit 2
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  if [ -f "$JUNIT_SRC" ]; then
+    cp "$JUNIT_SRC" "$OUTPUT_PATH"
+  else
+    # Ensure a parseable report even when compilation or setup failed.
+    cat > "$OUTPUT_PATH" <<'XML'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="1" errors="0">
+  <testsuite name="polygonize" tests="1" failures="1" errors="0">
+    <testcase name="build_or_run"><failure message="tests did not run to completion"/></testcase>
+  </testsuite>
+</testsuites>
+XML
+  fi
+fi
+
+exit "$STATUS"
