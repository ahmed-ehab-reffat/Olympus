diff --git a/skfem/mapping/mapping.py b/skfem/mapping/mapping.py
index f4d8ac6..a980999 100644
--- a/skfem/mapping/mapping.py
+++ b/skfem/mapping/mapping.py
@@ -1,8 +1,73 @@
 from typing import Optional
 
+import numpy as np
 from numpy import ndarray
 
 
+def det(M: ndarray) -> ndarray:
+    """Determinant of a stack of square matrices of dimension one to three,
+    with the stack axes trailing."""
+    if M.shape[0] == 1:
+        return M[0, 0]
+    elif M.shape[0] == 2:
+        return M[0, 0] * M[1, 1] - M[0, 1] * M[1, 0]
+    elif M.shape[0] == 3:
+        return (M[0, 0] * (M[1, 1] * M[2, 2] - M[1, 2] * M[2, 1]) -
+                M[0, 1] * (M[1, 0] * M[2, 2] - M[1, 2] * M[2, 0]) +
+                M[0, 2] * (M[1, 0] * M[2, 1] - M[1, 1] * M[2, 0]))
+    raise Exception("Not implemented for the given dimension.")
+
+
+def inv(M: ndarray, detM: Optional[ndarray] = None) -> ndarray:
+    """Inverse of a stack of square matrices of dimension one to three."""
+    if detM is None:
+        detM = det(M)
+    invM = np.empty(M.shape)
+    if M.shape[0] == 1:
+        invM[0, 0] = 1. / M[0, 0]
+    elif M.shape[0] == 2:
+        invM[0, 0] = M[1, 1] / detM
+        invM[0, 1] = -M[0, 1] / detM
+        invM[1, 0] = -M[1, 0] / detM
+        invM[1, 1] = M[0, 0] / detM
+    elif M.shape[0] == 3:
+        invM[0, 0] = (-M[1, 2] * M[2, 1] + M[1, 1] * M[2, 2]) / detM
+        invM[1, 0] = (M[1, 2] * M[2, 0] - M[1, 0] * M[2, 2]) / detM
+        invM[2, 0] = (-M[1, 1] * M[2, 0] + M[1, 0] * M[2, 1]) / detM
+        invM[0, 1] = (M[0, 2] * M[2, 1] - M[0, 1] * M[2, 2]) / detM
+        invM[1, 1] = (-M[0, 2] * M[2, 0] + M[0, 0] * M[2, 2]) / detM
+        invM[2, 1] = (M[0, 1] * M[2, 0] - M[0, 0] * M[2, 1]) / detM
+        invM[0, 2] = (-M[0, 2] * M[1, 1] + M[0, 1] * M[1, 2]) / detM
+        invM[1, 2] = (M[0, 2] * M[1, 0] - M[0, 0] * M[1, 2]) / detM
+        invM[2, 2] = (-M[0, 1] * M[1, 0] + M[0, 0] * M[1, 1]) / detM
+    else:
+        raise Exception("Not implemented for the given dimension.")
+    return invM
+
+
+def gram(J: ndarray) -> ndarray:
+    """The Gram matrix of a stack of matrices with the stack axes trailing."""
+    return np.einsum('ij...,ik...->jk...', J, J)
+
+
+def measure(J: ndarray) -> ndarray:
+    """The volume scaling of a stack of matrices: the determinant when
+    square, otherwise the square root of the Gram determinant."""
+    if J.shape[0] == J.shape[1]:
+        return det(J)
+    if J.shape[1] == 0:
+        return np.ones(J.shape[2:])
+    return np.sqrt(det(gram(J)))
+
+
+def pinv(J: ndarray) -> ndarray:
+    """The inverse of a stack of matrices when square, otherwise the
+    left pseudoinverse."""
+    if J.shape[0] == J.shape[1]:
+        return inv(J)
+    return np.einsum('ij...,kj...->ik...', inv(gram(J)), J)
+
+
 class Mapping():
     """Base class for mappings between reference and global elements."""
 
