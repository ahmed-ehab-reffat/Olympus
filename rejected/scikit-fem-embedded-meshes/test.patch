+def test_cell_basis_supplies_surface_normals():
+    m = tilted_tri(29, 2).oriented()
+    basis = Basis(m, ElementTriP1())
+    n = basis.default_parameters()['n']
+    assert n.shape == (3, m.t.shape[1], basis.X.shape[1])
+    assert_allclose(np.linalg.norm(n, axis=0), 1.)
+    assert_allclose(n, np.broadcast_to(element_normals(m)[:, :, None], n.shape))
+    R = rotation(30)
