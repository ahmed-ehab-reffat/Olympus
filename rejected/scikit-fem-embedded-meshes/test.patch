+    assert projected.p.shape[0] == 2
+    fb = FacetBasis(m, ElementHex1(), facets=facets)
+    cb = Basis(tm, ElementQuad1())
+    assert_allclose(cb.dx.sum(), fb.dx.sum())
+    f = lambda w: np.sin(w.x[0]) * w.x[1] + w.x[2] ** 3
+    assert_allclose(Functional(f).assemble(cb), Functional(f).assemble(fb))
