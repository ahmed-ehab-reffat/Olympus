+    line = MeshLine(np.array([[0., 1., 2.], [0., 1., 0.]]), np.array([[0, 1], [1, 2]]))
+    nl = Basis(line, ElementLineP1()).default_parameters()['n']
+    assert_allclose(nl[:, :, 0].T, np.array([[1., -1.], [-1., -1.]]) / np.sqrt(2.))
