@@ -0,0 +1,732 @@
+from dataclasses import replace
+
+import numpy as np
+import pytest
+from numpy.testing import assert_allclose, assert_array_equal
+
+import meshio
+
+from skfem import (Basis, BilinearForm, ElementHex1, ElementLineP1,
+                   ElementLineP2, ElementQuad1, ElementQuad2, ElementTetP1,
+                   ElementTriMorley, ElementTriN1, ElementTriP1, ElementTriP2,
+                   ElementTriRT1, ElementVector, FacetBasis, Functional,
+                   InteriorFacetBasis, LinearForm, MeshHex, MeshLine,
+                   MeshQuad, MeshQuad2, MeshTet, MeshTri, MeshTri2)
+from skfem.helpers import curl, div, dot, grad
+from skfem.io.meshio import from_meshio, to_meshio
+from skfem.mapping import MappingAffine, MappingIsoparametric
+
+
+def line_in_plane(n=4):
+    s = np.linspace(0., 1., n + 1)
+    p = np.array([s, 2. * s])
+    t = np.array([np.arange(n), np.arange(n) + 1])
+    return MeshLine(p, t)
+
+
+def line_in_space(n=4):
+    s = np.linspace(0., 1., n + 1)
+    p = np.array([s, -s, 2. * s])
+    t = np.array([np.arange(n), np.arange(n) + 1])
+    return MeshLine(p, t)
+
+
+def arc_in_plane(n=8):
+    a = np.linspace(0., np.pi, n + 1)
+    p = np.array([np.cos(a), np.sin(a)])
+    t = np.array([np.arange(n), np.arange(n) + 1])
+    return MeshLine(p, t)
+
+
+def folded_line(n=4):
+    s = np.linspace(0., 1., n + 1)
+    p = np.array([np.sin(3. * s), s])
+    t = np.array([np.arange(n), np.arange(n) + 1])
+    return MeshLine(p, t)
+
+
+def embed(m, z=None, tilt=None):
+    p = np.vstack((m.p, np.zeros((1, m.p.shape[1])) if z is None else z))
+    if tilt is not None:
+        p = tilt @ p
+    return type(m)(p, m.t)
+
+
+def rotation(seed):
+    q, _ = np.linalg.qr(np.random.default_rng(seed).normal(size=(3, 3)))
+    if np.linalg.det(q) < 0:
+        q[:, 0] *= -1.
+    return q
+
+
+def tilted_tri(seed=0, nrefs=2):
+    return embed(MeshTri().refined(nrefs), tilt=rotation(seed))
+
+
+def tilted_quad(seed=0, nrefs=2):
+    return embed(MeshQuad().refined(nrefs), tilt=rotation(seed))
+
+
+def rotate(m, R):
+    return replace(m, doflocs=R @ m.p)
+
+
+def translate(m, d):
+    return replace(m, doflocs=(m.p.T + d).T)
+
+
+def cylinder_tri2(nrefs=2):
+    m = MeshTri().refined(nrefs)
+    m3 = MeshTri2.from_mesh(embed(m))
+    p = m3.doflocs
+    return MeshTri2(np.array([np.cos(np.pi * p[0]),
+                              np.sin(np.pi * p[0]),
+                              p[1]]), m3.t)
+
+
+def paraboloid_quad2(nrefs=2):
+    m = MeshQuad().refined(nrefs)
+    m3 = MeshQuad2.from_mesh(embed(m))
+    p = m3.doflocs
+    return MeshQuad2(np.array([p[0], p[1], p[0] ** 2 + p[1] ** 2]), m3.t)
+
+
+def mass(basis):
+    return BilinearForm(lambda u, v, w: u * v).assemble(basis)
+
+
+def stiffness(basis):
+    return BilinearForm(lambda u, v, w: dot(grad(u), grad(v))).assemble(basis)
+
+
+def load(basis):
+    return LinearForm(lambda v, w: w.x[0] * v).assemble(basis)
+
+
+def total(basis):
+    return Functional(lambda w: 1. + 0. * w.x[0]).assemble(basis)
+
+
+def nodal(basis, f):
+    return f(basis.doflocs)
+
+
+def project_tangent(a, p, t):
+    e1 = p[:, t[1]] - p[:, t[0]]
+    e2 = p[:, t[2]] - p[:, t[0]]
+    n = np.cross(e1.T, e2.T).T
+    n /= np.linalg.norm(n, axis=0)
+    return a[:, None] - n * (n * a[:, None]).sum(axis=0)
+
+
+@pytest.mark.parametrize("make", [
+    line_in_plane,
+    line_in_space,
+    tilted_tri,
+    tilted_quad,
+    cylinder_tri2,
+    paraboloid_quad2,
+])
+def test_embedded_mesh_keeps_reference_dim(make):
+    m = make()
+    assert m.p.shape[0] > m.dim()
+    assert m.dim() == m.elem.refdom.dim()
+    if not isinstance(m, (MeshTri2, MeshQuad2)):
+        assert m.is_valid()
+    basis = Basis(m, m.elem())
+    assert basis.default_parameters()['x'].shape[0] == m.p.shape[0]
+    assert basis.default_parameters()['h'].shape[0] == m.t.shape[1]
+
+
+def test_fewer_rows_than_reference_dim_is_invalid():
+    m = MeshTri()
+    assert MeshTri(np.vstack((m.p, m.p[:1])), m.t).is_valid()
+    assert MeshLine(np.array([[0., 1., 2.]] * 3),
+                    np.array([[0, 1], [1, 2]])).is_valid()
+    bad = MeshTri(m.p[:1], m.t, validate=False)
+    assert not bad.is_valid()
+    with pytest.raises(ValueError):
+        bad.is_valid(raise_=True)
+
+
+def test_square_meshes_are_unchanged():
+    for m, e in [(MeshTri().refined(2), ElementTriP1()),
+                 (MeshQuad().refined(2), ElementQuad1()),
+                 (MeshTet().refined(1), None)]:
+        assert m.p.shape[0] == m.dim()
+        if e is not None:
+            assert_allclose(mass(Basis(m, e)).sum(), 1.)
+            lifted = type(m)(np.vstack((m.p, np.ones((1, m.p.shape[1])))), m.t)
+            assert_allclose(mass(Basis(lifted, e)).sum(), 1.)
+            assert Basis(lifted, e).default_parameters()['x'].shape[0] == 3
+
+
+@pytest.mark.parametrize("make,e,length", [
+    (line_in_plane, ElementLineP1(), np.sqrt(5.)),
+    (line_in_space, ElementLineP1(), np.sqrt(6.)),
+    (line_in_plane, ElementLineP2(), np.sqrt(5.)),
+    (lambda: arc_in_plane(64), ElementLineP1(), 2. * 64. * np.sin(np.pi / 128.)),
+])
+def test_curve_measure(make, e, length):
+    m = make()
+    basis = Basis(m, e)
+    assert_allclose(basis.dx.sum(), length)
+    assert_allclose(mass(basis).sum(), length)
+    assert_allclose(total(basis), length)
+
+
+@pytest.mark.parametrize("make,e", [
+    (lambda: tilted_tri(1), ElementTriP1()),
+    (lambda: tilted_tri(2), ElementTriP2()),
+    (lambda: tilted_quad(3), ElementQuad1()),
+    (lambda: tilted_quad(4), ElementQuad2()),
+])
+def test_flat_surface_measure(make, e):
+    m = make()
+    basis = Basis(m, e)
+    assert_allclose(basis.dx.sum(), 1.)
+    assert_allclose(mass(basis).sum(), 1.)
+
+
+def test_curved_surface_measure():
+    m = cylinder_tri2(3)
+    assert_allclose(Basis(m, ElementTriP2()).dx.sum(), np.pi, rtol=1e-4)
+    m = paraboloid_quad2(3)
+    x, y = np.meshgrid(*[np.linspace(0, 1, 401)] * 2)
+    exact = np.trapezoid(np.trapezoid(np.sqrt(1. + 4. * x ** 2 + 4. * y ** 2),
+                              x[0]), y[:, 0])
+    assert_allclose(Basis(m, ElementQuad2()).dx.sum(), exact, rtol=1e-3)
+
+
+@pytest.mark.parametrize("make,e", [
+    (lambda: tilted_tri(5), ElementTriP1()),
+    (lambda: tilted_tri(6), ElementTriP2()),
+    (lambda: tilted_quad(7), ElementQuad1()),
+    (lambda: tilted_quad(8), ElementQuad2()),
+])
+def test_gradient_is_tangential_with_ambient_components(make, e):
+    m = make()
+    basis = Basis(m, e)
+    a = np.array([1.3, -0.7, 0.4])
+    u = nodal(basis, lambda x: a @ x + 2.)
+    g = basis.interpolate(u).grad
+    assert g.shape[0] == 3
+    expected = project_tangent(a, m.p, m.t[:3])
+    assert_allclose(g, np.broadcast_to(expected[:, :, None], g.shape),
+                    atol=1e-10)
+
+
+def test_line_gradient_is_the_unit_tangent_derivative():
+    m = line_in_plane()
+    basis = Basis(m, ElementLineP1())
+    u = nodal(basis, lambda x: 3. * x[0] + x[1])
+    g = basis.interpolate(u).grad
+    tangent = np.array([1., 2.]) / np.sqrt(5.)
+    assert_allclose(g, np.broadcast_to((5. / np.sqrt(5.) * tangent)[:, None, None],
+                                       g.shape))
+
+
+def test_laplace_beltrami_on_tilted_plane_matches_flat_plane():
+    flat = MeshTri().refined(3)
+    A = stiffness(Basis(flat, ElementTriP1()))
+    B = stiffness(Basis(embed(flat, tilt=rotation(9)), ElementTriP1()))
+    assert_allclose(A.toarray(), B.toarray(), atol=1e-12)
+
+
+@pytest.mark.parametrize("seed", range(6))
+@pytest.mark.parametrize("make,e", [
+    (line_in_space, ElementLineP1()),
+    (tilted_tri, ElementTriP1()),
+    (tilted_quad, ElementQuad1()),
+    (cylinder_tri2, ElementTriP2()),
+])
+def test_assembly_is_invariant_under_rigid_motions(seed, make, e):
+    m = make()
+    basis = Basis(m, e)
+    R = rotation(seed + 100)
+    d = np.random.default_rng(seed).normal(size=3)
+    moved = translate(rotate(m, R), d)
+    mbasis = Basis(moved, e)
+    assert_allclose(mass(mbasis).toarray(), mass(basis).toarray(), atol=1e-12)
+    assert_allclose(stiffness(mbasis).toarray(), stiffness(basis).toarray(),
+                    atol=1e-12)
+    assert_allclose(mbasis.dx, basis.dx, atol=1e-12)
+    h = basis.default_parameters()['h']
+    assert_allclose(mbasis.default_parameters()['h'], h, atol=1e-12)
+    x = basis.default_parameters()['x']
+    assert_allclose(mbasis.default_parameters()['x'],
+                    np.einsum('ij,jkl->ikl', R, x) + d[:, None, None],
+                    atol=1e-12)
+
+
+def test_reflection_leaves_matrices_and_moves_coordinates():
+    m = tilted_tri(11)
+    basis = Basis(m, ElementTriP1())
+    mirrored = m.mirrored((0., 0., 1.))
+    mbasis = Basis(mirrored, ElementTriP1())
+    assert_allclose(stiffness(mbasis).toarray(), stiffness(basis).toarray(),
+                    atol=1e-12)
+    assert_allclose(mirrored.p[2], -m.p[2])
+
+
+@pytest.mark.parametrize("m,e", [
+    (MeshTri().refined(2), ElementTriP1()),
+    (MeshQuad().refined(2), ElementQuad1()),
+])
+def test_surface_in_a_coordinate_plane_assembles_the_same(m, e):
+    basis = Basis(m, e)
+    big = type(m)(np.vstack((m.p, np.zeros((1, m.p.shape[1])))), m.t)
+    bbasis = Basis(big, e)
+    assert bbasis.default_parameters()['x'].shape[0] == 3
+    assert_allclose(bbasis.default_parameters()['x'][2], 0.)
+    assert_allclose(mass(bbasis).toarray(), mass(basis).toarray(), atol=1e-13)
+    assert_allclose(stiffness(bbasis).toarray(), stiffness(basis).toarray(),
+                    atol=1e-13)
+    assert_allclose(load(bbasis), load(basis), atol=1e-13)
+
+
+def test_line_on_a_coordinate_axis_assembles_the_same():
+    m = MeshLine().refined(3)
+    basis = Basis(m, ElementLineP1())
+    big = MeshLine(np.vstack((np.zeros((1, m.p.shape[1])), m.p)), m.t)
+    bbasis = Basis(big, ElementLineP1())
+    assert_allclose(mass(bbasis).toarray(), mass(basis).toarray(), atol=1e-13)
+    assert_allclose(stiffness(bbasis).toarray(), stiffness(basis).toarray(),
+                    atol=1e-13)
+    assert_allclose(LinearForm(lambda v, w: w.x[1] * v).assemble(bbasis),
+                    load(basis), atol=1e-13)
+
+
+@pytest.mark.parametrize("make", [lambda: tilted_tri(12), lambda: tilted_quad(13),
+                                  cylinder_tri2])
+def test_inverse_mapping_recovers_points_on_the_surface(make):
+    m = make()
+    mapping = m.mapping()
+    X = np.array([[.2, .6, .1], [.3, .1, .8]])
+    tind = np.arange(min(5, m.t.shape[1]))
+    x = mapping.F(X, tind=tind)
+    assert x.shape[0] == 3
+    Y = mapping.invF(x, tind=tind)
+    assert_allclose(Y, np.broadcast_to(X[:, None, :], Y.shape), atol=1e-9)
+    assert_allclose(mapping.F(Y, tind=tind), x, atol=1e-9)
+
+
+@pytest.mark.parametrize("make", [lambda: tilted_tri(14), lambda: tilted_quad(15)])
+def test_element_finder_and_interpolator_on_a_surface(make):
+    m = make()
+    basis = Basis(m, ElementTriP1() if isinstance(m, MeshTri) else ElementQuad1())
+    a = np.array([0.5, -1., 2.])
+    u = nodal(basis, lambda x: a @ x)
+    X = np.array([[.31, .77, .05], [.2, .11, .9]])
+    x = m.mapping().F(X, tind=np.array([0, 1, 2]))
+    x = x.transpose(0, 2, 1).reshape(3, -1)[:, ::4]
+    finder = m.element_finder()
+    elems = finder(*x)
+    assert len(elems) == x.shape[1]
+    assert_allclose(basis.interpolator(u)(x), a @ x, atol=1e-10)
+    assert_allclose(basis.probes(x) @ u, a @ x, atol=1e-10)
+
+
+def test_element_finder_on_a_folded_surface():
+    m = MeshTri().refined(3)
+    p = np.vstack((m.p, 1. - np.abs(m.p[0] - .5)))
+    folded = MeshTri(p, m.t)
+    basis = Basis(folded, ElementTriP1())
+    u = nodal(basis, lambda x: x[2])
+    mids = folded.p[:, folded.t].mean(axis=1)
+    assert_array_equal(folded.element_finder()(*mids), np.arange(folded.t.shape[1]))
+    assert_allclose(basis.interpolator(u)(mids), mids[2], atol=1e-12)
+    q = MeshQuad().refined(2)
+    pq = np.vstack((q.p, np.where(q.p[0] < .5, q.p[0], 1. - q.p[0])))
+    fq = MeshQuad(pq, q.t)
+    qbasis = Basis(fq, ElementQuad1())
+    uq = nodal(qbasis, lambda x: x[2])
+    qmids = fq.p[:, fq.t].mean(axis=1)
+    assert_allclose(qbasis.interpolator(uq)(qmids), qmids[2], atol=1e-12)
+
+
+def test_line_finder_does_not_rely_on_the_first_coordinate():
+    m = folded_line(20)
+    basis = Basis(m, ElementLineP1())
+    u = nodal(basis, lambda x: x[0] - 2. * x[1])
+    mids = m.p[:, m.t].mean(axis=1)
+    elems = m.element_finder()(*mids)
+    assert_array_equal(elems, np.arange(m.t.shape[1]))
+    assert_allclose(basis.interpolator(u)(mids), mids[0] - 2. * mids[1],
+                    atol=1e-12)
+
+
+def test_line_finder_in_one_dimension_is_unchanged():
+    m = MeshLine().refined(3)
+    x = np.array([0.05, 0.5, 0.999])
+    assert_array_equal(m.element_finder()(x),
+                       np.array([np.nonzero((m.p[0, m.t[0]] <= xi)
+                                            * (xi <= m.p[0, m.t[1]]))[0][0]
+                                 for xi in x]))
+
+
+def test_facet_measure_and_co_normal_on_a_tilted_patch():
+    R = rotation(16)
+    m = embed(MeshTri().refined(2), tilt=R)
+    fb = FacetBasis(m, ElementTriP1())
+    assert_allclose(fb.dx.sum(), 4.)
+    n = fb.normals
+    assert n.shape[0] == 3
+    assert_allclose(np.linalg.norm(n, axis=0), 1.)
+    surface_normal = R @ np.array([0., 0., 1.])
+    assert_allclose(np.einsum('i,ijk->jk', surface_normal, n), 0., atol=1e-12)
+    for i, f in enumerate(fb.find):
+        edge = m.p[:, m.facets[1, f]] - m.p[:, m.facets[0, f]]
+        assert_allclose(edge @ n[:, i, 0], 0., atol=1e-12)
+        mid = m.p[:, m.facets[:, f]].mean(axis=1)
+        centroid = m.p[:, m.t[:, fb.tind[i]]].mean(axis=1)
+        assert (mid - centroid) @ n[:, i, 0] > 0.
+
+
+def test_facet_measure_and_co_normal_on_a_tilted_quad_patch():
+    R = rotation(17)
+    m = embed(MeshQuad().refined(2), tilt=R)
+    fb = FacetBasis(m, ElementQuad1())
+    assert_allclose(fb.dx.sum(), 4.)
+    n = fb.normals
+    assert_allclose(np.linalg.norm(n, axis=0), 1.)
+    assert_allclose(np.einsum('i,ijk->jk', R @ np.array([0., 0., 1.]), n), 0.,
+                    atol=1e-12)
+    for i, f in enumerate(fb.find):
+        mid = m.p[:, m.facets[:, f]].mean(axis=1)
+        centroid = m.p[:, m.t[:, fb.tind[i]]].mean(axis=1)
+        assert (mid - centroid) @ n[:, i, 0] > 0.
+
+
+def test_curve_endpoint_co_normals_are_outward_unit_tangents():
+    m = arc_in_plane(8)
+    fb = FacetBasis(m, ElementLineP1())
+    assert_allclose(fb.dx.sum(), 2.)
+    n = fb.normals[:, :, 0]
+    assert_allclose(np.linalg.norm(n, axis=0), 1.)
+    for i, f in enumerate(fb.find):
+        elem = fb.tind[i]
+        tangent = m.p[:, m.t[1, elem]] - m.p[:, m.t[0, elem]]
+        tangent /= np.linalg.norm(tangent)
+        outward = 1. if m.facets[0, f] == m.t[1, elem] else -1.
+        assert_allclose(n[:, i], outward * tangent)
+
+
+def test_vector_field_with_ambient_components_on_a_surface():
+    m = tilted_tri(18)
+    basis = Basis(m, ElementVector(ElementTriP1(), dim=3))
+    fb = FacetBasis(m, ElementVector(ElementTriP1(), dim=3))
+    u = basis.project(lambda x: np.array([x[0], x[1], x[2]]))
+    flux = Functional(lambda w: dot(w['u'], w.n)).assemble(fb, u=fb.interpolate(u))
+    divergence = Functional(lambda w: 2. + 0. * w.x[0]).assemble(Basis(m, ElementTriP1()))
+    assert_allclose(flux, divergence, atol=1e-10)
+
+
+def test_interior_facets_on_a_surface():
+    m = tilted_quad(19)
+    basis = Basis(m, ElementQuad1())
+    u = nodal(basis, lambda x: x[0] + x[1] + x[2])
+    ifb0 = InteriorFacetBasis(m, ElementQuad1(), side=0)
+    ifb1 = InteriorFacetBasis(m, ElementQuad1(), side=1)
+    assert_allclose(ifb0.dx.sum(), 6.)
+    assert_allclose(ifb0.interpolate(u), ifb1.interpolate(u), atol=1e-12)
+    assert_allclose(ifb0.normals, ifb1.normals, atol=1e-12)
+    assert_allclose(np.linalg.norm(ifb0.normals, axis=0), 1.)
+
+
+def test_trace_of_a_tetrahedral_mesh_is_a_surface_mesh():
+    m = MeshTet().refined(2)
+    facets = m.boundary_facets()
+    tm, orig = m.trace(facets)
+    assert isinstance(tm, MeshTri)
+    assert tm.p.shape[0] == 3
+    assert tm.dim() == 2
+    fb = FacetBasis(m, ElementTetP1(), facets=facets)
+    cb = Basis(tm, ElementTriP1())
+    assert_allclose(cb.dx.sum(), fb.dx.sum())
+    f = lambda w: w.x[0] ** 2 + w.x[1] * w.x[2]
+    assert_allclose(Functional(f).assemble(cb), Functional(f).assemble(fb))
+
+
+def test_trace_of_a_hexahedral_mesh_is_a_quadrilateral_surface_mesh():
+    m = MeshHex().refined(1)
