+def test_orientation_of_quadrilateral_meshes():
+    m = MeshQuad().refined(2)
+    assert_array_equal(m.orientation(), np.ones(m.t.shape[1], dtype=np.int32))
+    assert_array_equal(m.oriented().t, m.t)
+    q = tilted_quad(36, 2)
+    assert q.orientation()[0] == 1
+    t = q.t.copy()
+    t[1, 3], t[3, 3] = t[3, 3], t[1, 3]
+    flipped = replace(q, t=t, sort_t=False)
+    ori = flipped.orientation()
+    assert ori[3] == -1
+    assert np.sum(ori == -1) == 1
+    qo = flipped.oriented()
+    assert_array_equal(qo.orientation(), np.ones(q.t.shape[1], dtype=np.int32))
+    assert_array_equal(qo.t, q.t)
+    n = Basis(qo, ElementQuad1()).default_parameters()['n']
+    assert_allclose(n, np.broadcast_to(n[:, :1, :1], n.shape), atol=1e-12)
+    assert_allclose(Basis(qo, ElementQuad1()).dx.sum(), 1.)
