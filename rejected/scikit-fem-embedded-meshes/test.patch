+def test_orientation_of_an_embedded_triangle_mesh_is_relative_to_the_first():
+    m = tilted_tri(28, 2)
+    ori = m.orientation()
+    assert ori[0] == 1
+    assert set(np.unique(ori)) <= {-1, 1}
+    n = element_normals(m)
+    assert_allclose(np.sign(n.T @ n[:, 0]), ori)
+    mo = m.oriented()
+    assert_array_equal(mo.orientation(), np.ones(m.t.shape[1], dtype=np.int32))
+    no = element_normals(mo)
+    assert_allclose(no, np.broadcast_to(no[:, :1], no.shape))
+    assert_allclose(mass(Basis(mo, ElementTriP1())).toarray(),
+                    mass(Basis(m, ElementTriP1())).toarray())
+    assert_array_equal(np.sort(mo.t, axis=0), np.sort(m.t, axis=0))
+
