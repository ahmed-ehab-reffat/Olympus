+def test_piola_elements_on_a_surface():
+    m = tilted_tri(32, 2).oriented()
+    R = rotation(32)
+    normal = R @ np.array([0., 0., 1.])
+    rt = Basis(m, ElementTriRT1())
+    u = rt.project(lambda x: x - normal[:, None, None] * np.einsum('i,ijk->jk', normal, x))
+    fb = FacetBasis(m, ElementTriRT1())
+    flux = Functional(lambda w: dot(w['u'], w.n)).assemble(fb, u=fb.interpolate(u))
+    total_div = Functional(lambda w: div(w['u'])).assemble(rt, u=rt.interpolate(u))
+    assert_allclose(total_div, 2., atol=1e-10)
+    assert_allclose(flux, total_div, atol=1e-10)
+    values = rt.interpolate(u)
+    assert_allclose(np.einsum('i,ijk->jk', normal, values), 0., atol=1e-12)
+    nd = Basis(m, ElementTriN1())
+    K = BilinearForm(lambda u, v, w: curl(u) * curl(v) + dot(u, v)).assemble(nd)
+    flat = Basis(MeshTri().refined(2).oriented(), ElementTriN1())
+    Kflat = BilinearForm(lambda u, v, w: curl(u) * curl(v) + dot(u, v)).assemble(flat)
+    assert_allclose(K.toarray(), Kflat.toarray(), atol=1e-12)
+    moved = Basis(rotate(m, rotation(33)), ElementTriN1())
+    assert_allclose(BilinearForm(lambda u, v, w: curl(u) * curl(v) + dot(u, v))
+                    .assemble(moved).toarray(), K.toarray(), atol=1e-12)
+
