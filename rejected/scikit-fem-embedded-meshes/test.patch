+def test_orientation_of_a_closed_surface_and_a_curve():
+    c = cylinder_strip()
+    co = c.oriented()
+    n = element_normals(co)
+    centres = co.p[:, co.t].mean(axis=1)
+    radial = np.array([centres[0], centres[1], 0. * centres[2]])
+    assert (np.sign((n * radial).sum(axis=0)) == np.sign((n * radial).sum(axis=0))[0]).all()
+    line = MeshLine(np.array([[0., 1., 2., 3.], [0., 1., 0., 1.]]),
+                    np.array([[0, 2, 2], [1, 1, 3]]))
+    assert_array_equal(line.orientation(), np.array([1, -1, 1]))
+    lo = line.oriented()
+    assert_array_equal(lo.orientation(), np.array([1, 1, 1]))
+    assert_array_equal(lo.t, np.array([[0, 1, 2], [1, 2, 3]]))
+
