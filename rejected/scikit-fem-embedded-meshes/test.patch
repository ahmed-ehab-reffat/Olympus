+def mobius_strip(n=24):
+    u = np.linspace(0., 2. * np.pi, n, endpoint=False)
+    v = np.array([-.3, .3])
+    p = []
+    for i in range(n):
+        for j in range(2):
+            r = 1. + v[j] * np.cos(u[i] / 2.)
+            p.append([r * np.cos(u[i]), r * np.sin(u[i]),
+                      v[j] * np.sin(u[i] / 2.)])
+    t = []
+    for i in range(n):
+        a, b = 2 * i, 2 * i + 1
+        c, d = (1, 0) if i == n - 1 else (2 * i + 2, 2 * i + 3)
+        t += [[a, b, c], [b, d, c]]
+    return MeshTri(np.array(p).T, np.array(t).T)
+
+
+def cylinder_strip(n=24):
+    u = np.linspace(0., 2. * np.pi, n, endpoint=False)
+    p = np.hstack([np.array([[np.cos(a), np.sin(a), z] for a in u]).T
+                   for z in (0., 1.)])
+    t = []
+    for i in range(n):
+        a, b, c, d = i, (i + 1) % n, n + i, n + (i + 1) % n
+        t += [[a, b, c], [b, d, c]]
+    return MeshTri(p, np.array(t).T)
+
+
+def element_normals(m):
+    e1 = m.p[:, m.t[1]] - m.p[:, m.t[0]]
+    e2 = m.p[:, m.t[2]] - m.p[:, m.t[0]]
+    n = np.cross(e1.T, e2.T).T
+    return n / np.linalg.norm(n, axis=0)
+
