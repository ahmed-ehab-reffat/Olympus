+def test_mappings_expose_rectangular_jacobians():
+    m = tilted_tri(26, 1)
+    mapping = m.mapping()
+    assert isinstance(mapping, MappingAffine)
+    X = np.array([[.2], [.3]])
+    assert mapping.DF(X).shape[:2] == (3, 2)
+    assert mapping.invDF(X).shape[:2] == (2, 3)
+    assert_allclose(np.einsum('ijkl,jmkl->imkl', mapping.invDF(X), mapping.DF(X)),
+                    np.broadcast_to(np.eye(2)[:, :, None, None], (2, 2, m.t.shape[1], 1)),
+                    atol=1e-12)
+    q = tilted_quad(27, 1)
+    qmapping = q.mapping()
+    assert isinstance(qmapping, MappingIsoparametric)
+    assert qmapping.DF(X).shape[:2] == (3, 2)
+    assert qmapping.invDF(X).shape[:2] == (2, 3)
+    assert_allclose(np.einsum('ijkl,jmkl->imkl', qmapping.invDF(X), qmapping.DF(X)),
+                    np.broadcast_to(np.eye(2)[:, :, None, None], (2, 2, q.t.shape[1], 1)),
+                    atol=1e-12)
