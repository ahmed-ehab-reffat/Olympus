@@ -0,0 +1,200 @@
+#![cfg(taffy_probe_lb)]
+
+use taffy::prelude::*;
+use taffy::TaffyTree;
+
+// Grandparent flex row aligning A (a plain leaf) and B (a wrapping sub-container
+// whose first-line baseline differs from its last-line baseline).
+fn build(align: AlignItems) -> (TaffyTree, NodeId, NodeId) {
+    let mut t: TaffyTree<()> = TaffyTree::new();
+    let a = t
+        .new_leaf(Style {
+            size: Size { width: Dimension::from_length(20.0), height: Dimension::from_length(30.0) },
+            ..Default::default()
+        })
+        .unwrap();
+    let b1 = t
+        .new_leaf(Style {
+            size: Size { width: Dimension::from_length(40.0), height: Dimension::from_length(20.0) },
+            ..Default::default()
+        })
+        .unwrap();
+    let b2 = t
+        .new_leaf(Style {
+            size: Size { width: Dimension::from_length(40.0), height: Dimension::from_length(20.0) },
+            ..Default::default()
+        })
+        .unwrap();
+    let b = t
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                flex_direction: FlexDirection::Row,
+                flex_wrap: FlexWrap::Wrap,
+                size: Size { width: Dimension::from_length(40.0), height: Dimension::auto() },
+                ..Default::default()
+            },
+            &[b1, b2],
+        )
+        .unwrap();
+    let gp = t
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                flex_direction: FlexDirection::Row,
+                align_items: Some(align),
+                size: Size { width: Dimension::from_length(200.0), height: Dimension::from_length(100.0) },
+                ..Default::default()
+            },
+            &[a, b],
+        )
+        .unwrap();
+    t.compute_layout(gp, Size::MAX_CONTENT).unwrap();
+    (t, a, b)
+}
+
+fn ys(t: &TaffyTree, a: NodeId, b: NodeId) -> (f32, f32) {
+    (t.layout(a).unwrap().location.y, t.layout(b).unwrap().location.y)
+}
+
+#[test]
+fn last_baseline_differs_from_first_for_wrapped_child() {
+    let (tf, af, bf) = build(AlignItems::BASELINE);
+    let (tl, al, bl) = build(AlignItems::LAST_BASELINE);
+    assert_ne!(ys(&tf, af, bf), ys(&tl, al, bl));
+}
+
+#[test]
+fn first_baseline_aligns_on_first_line() {
+    // Under first-baseline, B (whose first baseline sits above A's) is pushed down
+    // relative to A.
+    let (t, a, b) = build(AlignItems::BASELINE);
+    let (ay, by) = ys(&t, a, b);
+    assert!(by > ay, "expected B below A under first-baseline, got A={ay} B={by}");
+}
+
+#[test]
+fn last_baseline_aligns_on_last_line() {
+    // Under last-baseline, B's lower last-line baseline becomes the group baseline,
+    // so A is pushed down relative to B.
+    let (t, a, b) = build(AlignItems::LAST_BASELINE);
+    let (ay, by) = ys(&t, a, b);
+    assert!(ay > by, "expected A below B under last-baseline, got A={ay} B={by}");
+}
+
+#[test]
+fn leaves_agree_between_first_and_last_baseline() {
+    // Two single-line leaves have equal first and last baselines, so both modes
+    // produce identical positions.
+    fn two_leaves(align: AlignItems) -> (TaffyTree, NodeId, NodeId) {
+        let mut t: TaffyTree<()> = TaffyTree::new();
+        let a = t
+            .new_leaf(Style {
+                size: Size { width: Dimension::from_length(20.0), height: Dimension::from_length(20.0) },
+                ..Default::default()
+            })
+            .unwrap();
+        let b = t
+            .new_leaf(Style {
+                size: Size { width: Dimension::from_length(20.0), height: Dimension::from_length(40.0) },
+                ..Default::default()
+            })
+            .unwrap();
+        let root = t
+            .new_with_children(
+                Style {
+                    display: Display::Flex,
+                    align_items: Some(align),
+                    size: Size { width: Dimension::from_length(100.0), height: Dimension::from_length(80.0) },
+                    ..Default::default()
+                },
+                &[a, b],
+            )
+            .unwrap();
+        t.compute_layout(root, Size::MAX_CONTENT).unwrap();
+        (t, a, b)
+    }
+    let (tf, af, bf) = two_leaves(AlignItems::BASELINE);
+    let (tl, al, bl) = two_leaves(AlignItems::LAST_BASELINE);
+    assert_eq!(ys(&tf, af, bf), ys(&tl, al, bl));
+}
+
+#[test]
+fn grid_child_reports_last_baseline_from_last_row() {
+    // A two-row grid child has a first baseline from its first row and a last
+    // baseline from its last row, so aligning it by last baseline in a flex parent
+    // places it differently than by first baseline.
+    fn grid_build(align: AlignItems) -> (TaffyTree, NodeId, NodeId) {
+        let mut t: TaffyTree<()> = TaffyTree::new();
+        let a = t
+            .new_leaf(Style {
+                size: Size { width: Dimension::from_length(20.0), height: Dimension::from_length(30.0) },
+                ..Default::default()
+            })
+            .unwrap();
+        let g1 = t
+            .new_leaf(Style {
+                size: Size { width: Dimension::from_length(40.0), height: Dimension::from_length(20.0) },
+                ..Default::default()
+            })
+            .unwrap();
+        let g2 = t
+            .new_leaf(Style {
+                size: Size { width: Dimension::from_length(40.0), height: Dimension::from_length(20.0) },
+                ..Default::default()
+            })
+            .unwrap();
+        let b = t
+            .new_with_children(
+                Style {
+                    display: Display::Grid,
+                    grid_template_columns: vec![length(40.0)],
+                    grid_template_rows: vec![length(20.0), length(20.0)],
+                    ..Default::default()
+                },
+                &[g1, g2],
+            )
+            .unwrap();
+        let gp = t
+            .new_with_children(
+                Style {
+                    display: Display::Flex,
+                    align_items: Some(align),
+                    size: Size { width: Dimension::from_length(200.0), height: Dimension::from_length(100.0) },
+                    ..Default::default()
+                },
+                &[a, b],
+            )
+            .unwrap();
+        t.compute_layout(gp, Size::MAX_CONTENT).unwrap();
+        (t, a, b)
+    }
+    let (tf, af, bf) = grid_build(AlignItems::BASELINE);
+    let (tl, al, bl) = grid_build(AlignItems::LAST_BASELINE);
+    assert_ne!(ys(&tf, af, bf), ys(&tl, al, bl));
+}
+
+#[test]
+fn single_participant_line_is_unchanged() {
+    // A container with a single item leaves it at the cross-start regardless of mode.
+    let mut t: TaffyTree<()> = TaffyTree::new();
+    let a = t
+        .new_leaf(Style {
+            size: Size { width: Dimension::from_length(20.0), height: Dimension::from_length(30.0) },
+            ..Default::default()
+        })
+        .unwrap();
+    let root = t
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                align_items: Some(AlignItems::LAST_BASELINE),
+                size: Size { width: Dimension::from_length(100.0), height: Dimension::from_length(80.0) },
+                ..Default::default()
+            },
+            &[a],
+        )
+        .unwrap();
+    t.compute_layout(root, Size::MAX_CONTENT).unwrap();
+    assert_eq!(t.layout(a).unwrap().location.y, 0.0);
+}
