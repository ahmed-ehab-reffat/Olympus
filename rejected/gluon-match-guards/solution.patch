+pub fn pattern_binds_variables<Id>(pattern: &Pattern<'_, Id>) -> bool {
+    match pattern {
+        Pattern::Ident(_) | Pattern::As(..) => true,
+        Pattern::Constructor(_, args) => {
+            args.iter().any(|arg| pattern_binds_variables(&arg.value))
+        }
+        Pattern::Tuple { elems, .. } => {
+            elems.iter().any(|elem| pattern_binds_variables(&elem.value))
+        }
+        Pattern::Record {
+            fields,
+            implicit_import,
+            ..
+        } => {
+            implicit_import.is_some()
+                || pattern_values(fields).any(|(_, value)| match value {
+                    Some(pat) => pattern_binds_variables(&pat.value),
+                    None => true,
+                })
+        }
+        Pattern::Or(alternatives) => alternatives
+            .iter()
+            .any(|alternative| pattern_binds_variables(&alternative.value)),
+        Pattern::Literal(_) | Pattern::Error => false,
+    }
+}
