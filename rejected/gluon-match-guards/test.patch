+#[test]
+fn all_guards_fail_is_runtime_error() {
+    let _ = ::env_logger::try_init();
+    let vm = make_vm();
+    let text = r#"
+let cmp = import! std.cmp
+let { (>) } = cmp
+match 1 with
+| x if x > 5 -> 1
+| x if x > 3 -> 2
+"#;
+    let result = vm.run_expr::<i32>("<top>", text);
+    assert!(
+        result.is_err(),
+        "expected a runtime error when every guard fails, got {:?}",
+        result.map(|t| t.0)
+    );
+}
