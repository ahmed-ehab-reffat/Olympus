+    let vm = make_vm();
+    let text = r#"
+type C = | A Int | B Int
+match B 4 with
+| (A only_in_first | B only_in_second) -> 1
+"#;
+    let result = vm.run_expr::<i32>("<top>", text);
+    let message = result
+        .as_ref()
+        .err()
+        .map(|err| err.to_string())
+        .unwrap_or_default();
+    assert!(
+        result.is_err()
+            && (message.contains("only_in_first") || message.contains("only_in_second")),
+        "branches binding different names must be rejected naming the variable, got {:?}",
+        message
