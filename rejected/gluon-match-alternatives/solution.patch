 /// Shrink hidden spans to fit the visible expressions and flatten singleton blocks.
+fn distribute_as<'ast, Id>(
+    arena: ast::ArenaRef<'_, 'ast, Id>,
+    name: Spanned<Id, BytePos>,
+    mut pattern: SpannedPattern<'ast, Id>,
+) -> ast::Pattern<'ast, Id>
+where
+    Id: Clone,
+{
+    match pattern.value {
+        ast::Pattern::Or(alternatives) => {
+            let span = pattern.span;
+            let distributed = alternatives
+                .iter_mut()
+                .map(|alternative| {
+                    let inner =
+                        pos::spanned(alternative.span, std::mem::take(&mut alternative.value));
+                    pos::spanned(span, distribute_as(arena, name.clone(), inner))
+                })
+                .collect::<Vec<_>>();
+            ast::Pattern::Or(arena.alloc_extend(distributed))
+        }
+        _ => {
+            pattern.value = std::mem::take(&mut pattern.value);
+            ast::Pattern::As(name, arena.alloc(pattern))
+        }
+    }
+}
