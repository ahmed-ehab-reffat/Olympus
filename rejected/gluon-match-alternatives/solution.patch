+/// Collects every variable bound by `pattern` in the order the bindings appear. An or-pattern
+/// contributes the bindings of its first alternative since every alternative binds the same set.
+pub fn pattern_bound_names<Id>(pattern: &Pattern<'_, Id>, names: &mut Vec<Id>)
+where
+    Id: Clone,
+{
+    match pattern {
+        Pattern::Ident(id) => names.push(id.name.clone()),
+        Pattern::As(id, pat) => {
+            names.push(id.value.clone());
+            pattern_bound_names(&pat.value, names);
+        }
+        Pattern::Constructor(_, args) => {
+            for arg in args.iter() {
+                pattern_bound_names(&arg.value, names);
+            }
+        }
+        Pattern::Tuple { elems, .. } => {
+            for elem in elems.iter() {
+                pattern_bound_names(&elem.value, names);
+            }
+        }
+        Pattern::Record {
+            fields,
+            implicit_import,
+            ..
+        } => {
+            for (name, value) in pattern_values(fields) {
+                match value {
+                    Some(pat) => pattern_bound_names(&pat.value, names),
+                    None => names.push(name.value.clone()),
+                }
+            }
+            if let Some(implicit_import) = implicit_import {
+                names.push(implicit_import.value.clone());
+            }
+        }
+        Pattern::Or(alternatives) => {
+            if let Some(first) = alternatives.first() {
+                pattern_bound_names(&first.value, names);
+            }
+        }
+        Pattern::Literal(_) | Pattern::Error => (),
+    }
+}
