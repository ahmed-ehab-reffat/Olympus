+#[test]
+fn compressed_symbols_format_errors_not_silently_wrong() {
+    let import = ImportSpec { lib_ordinal: 1, weak: false, name: "whatever", addend: 0 };
+    let word = ptr64_bind_word(0, 0, 0);
+    let mut data = vec![0u8; DATA_SIZE as usize];
+    data[0..8].copy_from_slice(&word.to_le_bytes());
+    let page_bytes = 0u16.to_le_bytes();
+    let mut blob = chained_fixups_blob(DYLD_CHAINED_PTR_64, DYLD_CHAINED_IMPORT, 1, &page_bytes, &import);
+    // symbols_format lives at header byte offset 24 (7th u32 field); 9 is a distinctive
+    // non-zero (compressed) value that cannot appear incidentally elsewhere in the message.
+    blob[24..28].copy_from_slice(&9u32.to_le_bytes());
+    let bin = assemble(None, Some(&blob), &data);
+
+    with_imports_err(&bin, |msg| {
+        assert!(msg.contains('9'), "error should name the unsupported value: {msg}");
+    });
+}
