+#[test]
+fn arm64e_auth_rebase_is_walked_not_emitted() {
+    // auth-rebase (bind=0, auth=1) at entry 0, chains to an auth-bind at entry 1
+    let target: u64 = 0x1234;
+    let rebase_word = (1u64 << 63) | (0u64 << 62) | (1u64 << 51) | (target & 0x7_FFFF_FFFF_FFF);
+    let bind_word = arm64e_auth_bind_word(0, 0);
+    let import = ImportSpec { lib_ordinal: 1, weak: false, name: "after_auth_rebase", addend: 0 };
+    let mut data = vec![0u8; DATA_SIZE as usize];
+    data[0..8].copy_from_slice(&rebase_word.to_le_bytes());
+    data[8..16].copy_from_slice(&bind_word.to_le_bytes());
