+    let mut data = vec![0u8; DATA_SIZE as usize];
+    data[0..8].copy_from_slice(&word.to_le_bytes());
+    let page_bytes = 0u16.to_le_bytes();
+    let blob = chained_fixups_blob(DYLD_CHAINED_PTR_ARM64E, DYLD_CHAINED_IMPORT, 1, &page_bytes, &import);
+    let bin = assemble(None, Some(&blob), &data);
+
+    with_imports(&bin, |imports| {
+        assert_single_import(&imports, "arm64e_plain", "libFoo.dylib", 0, false);
+    });
+}
+
