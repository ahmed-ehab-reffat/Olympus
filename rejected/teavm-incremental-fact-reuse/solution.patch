+package org.teavm.cache;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.security.NoSuchAlgorithmException;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.function.Function;
+import org.teavm.model.AnnotationContainerReader;
+import org.teavm.model.AnnotationReader;
+import org.teavm.model.ClassReader;
+import org.teavm.model.ClassReaderSource;
+import org.teavm.model.FieldReader;
+import org.teavm.model.MethodReader;
+import org.teavm.model.MethodReference;
+import org.teavm.model.ProgramReader;
+import org.teavm.model.text.ListingBuilder;
+
+public final class CacheFacts {
+    public static final String BODY = "body";
+    public static final String SPLIT = "split";
+    private static final String API_PREFIX = "api:";
+
+    private CacheFacts() {
+    }
+
+    public static String[] collect(String body, Collection<String> classNames, ClassReaderSource classes,
+            String... extra) {
+        Set<String> facts = new LinkedHashSet<>();
+        facts.add(fact(BODY, body));
+        for (String className : classNames) {
+            facts.add(fact(API_PREFIX + className, apiFingerprint(classes.get(className))));
+        }
+        facts.addAll(List.of(extra));
+        return facts.toArray(new String[0]);
+    }
+
+    public static String fact(String key, String value) {
+        return key + "=" + value;
+    }
+
+    public static CacheStatus validator(CacheStatus status, ClassReaderSource classes,
+            Function<String, String> currentValues) {
+        return new CacheStatus() {
+            @Override
+            public boolean isStaleClass(String className) {
+                return status.isStaleClass(className);
+            }
+
+            @Override
+            public boolean isStaleMethod(MethodReference method) {
+                return status.isStaleMethod(method);
+            }
+
+            @Override
+            public boolean isStaleDependency(String dependency) {
+                int index = dependency.indexOf('=');
+                if (index < 0) {
+                    return status.isStaleDependency(dependency);
+                }
+                String key = dependency.substring(0, index);
+                String current = key.startsWith(API_PREFIX)
+                        ? apiFingerprint(classes.get(key.substring(API_PREFIX.length())))
+                        : currentValues.apply(key);
+                return !dependency.substring(index + 1).equals(current);
+            }
+        };
+    }
+
+    public static String programFingerprint(ProgramReader program) {
+        return digest(new ListingBuilder().buildListing(program, ""));
+    }
+
+    public static String apiFingerprint(ClassReader cls) {
+        if (cls == null) {
+            return "-";
+        }
+        List<String> members = new ArrayList<>();
+        for (FieldReader field : cls.getFields()) {
+            members.add("F" + field.getName() + ":" + field.getType() + ":" + field.getLevel()
+                    + field.readModifiers() + annotations(field.getAnnotations()) + ":" + field.getInitialValue());
+        }
+        for (MethodReader method : cls.getMethods()) {
+            members.add("M" + method.getDescriptor() + ":" + method.getLevel() + method.readModifiers()
+                    + annotations(method.getAnnotations()));
+        }
+        members.sort(String::compareTo);
+        StringBuilder sb = new StringBuilder();
+        sb.append(cls.getLevel()).append(cls.readModifiers()).append(annotations(cls.getAnnotations()))
+                .append(':').append(cls.getParent()).append(':').append(new TreeSet<>(cls.getInterfaces()));
+        for (String member : members) {
+            sb.append('\n').append(member);
+        }
+        return digest(sb.toString());
+    }
+
+    private static String annotations(AnnotationContainerReader annotations) {
+        Set<String> types = new TreeSet<>();
+        for (AnnotationReader annotation : annotations.all()) {
+            types.add(annotation.getType());
+        }
+        return types.toString();
+    }
+
+    public static String digest(String text) {
+        try {
+            byte[] hash = MessageDigest.getInstance("SHA-256").digest(text.getBytes(StandardCharsets.UTF_8));
+            StringBuilder sb = new StringBuilder();
+            for (int i = 0; i < 16; ++i) {
+                sb.append(Character.forDigit((hash[i] >> 4) & 15, 16)).append(Character.forDigit(hash[i] & 15, 16));
+            }
+            return sb.toString();
+        } catch (NoSuchAlgorithmException e) {
+            throw new RuntimeException(e);
+        }
+    }
+}
