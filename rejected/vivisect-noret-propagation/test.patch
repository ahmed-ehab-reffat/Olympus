+class StoreOfProgramCounterTest(unittest.TestCase):
+    """
+    Writing the program counter OUT to memory is data flow, not a transfer. Control carries on to
+    the next address whatever that slot holds, so a declaration about the slot says nothing about
+    the function that stored there, and what sits behind the store is reachable code.
+    """
+
+    def test_a_store_of_the_program_counter_is_not_a_transfer(self):
+        vw = newUnseededArmWorkspace()
+        fVa = 0x2000
+        slotVa = fVa + 8
+        mapCode(vw, fVa, ARM_STR_PC_PCREL + ARM_BX_LR + (0x1000).to_bytes(4, "little"), name="f")
+
+        vw.makeFunction(fVa)
+
+        self.assertEqual(
+            vw.addNoReturnVa(slotVa),
+            set(),
+            "the store put pc into that slot rather than jumping through it, so declaring the slot proves nothing about the function",
+        )
+        assertReturns(self, vw, fVa, "the return behind the store is on the one path this function has")
+
+    def test_a_trap_behind_a_store_of_the_program_counter_settles_the_function(self):
+        vw = newUnseededArmWorkspace()
+        fVa = 0x2000
+        mapCode(vw, fVa, ARM_STR_PC_PCREL + ARM_BKPT + (0x1000).to_bytes(4, "little"), name="f")
+
+        vw.makeFunction(fVa)
+        vw.propagateNoReturn()
+
+        assertNoReturn(
+            self,
+            vw,
+            fVa,
+            "the store transfers nothing, so the trap behind it is on this function's one path and proves it",
+        )
+
