+class NoFlowXrefPreservationTest(unittest.TestCase):
+    """
+    When codeflow marks a call site no-fall because its target is already known noreturn,
+    every xref the disassembler originally recorded from that call site -- its branch xref
+    to the real target, and, for a dereferenced call, its own data xref to the slot -- must
+    survive, not just the no-fall flag on the call site's own location.
+    """
+
+    def test_call_site_marked_noflow_still_has_an_xref_to_its_real_target(self):
+        vw = newWorkspace()
+        data = filledBuf(0x20)
+        exitVa = 0x1000
+        data[0:2] = UD2
+        bVa = 0x1010
+        data[0x10:0x15] = callRel32(exitVa, bVa + 5)
+        mapCode(vw, 0x1000, data)
+
+        # EXIT declared noreturn before B is ever walked, so codeflow marks B's call site
+        # noflow synchronously while disassembling B -- exactly the case that used to lose
+        # the xref.
+        vw.addNoReturnVa(exitVa)
+        vw.makeFunction(bVa)
+
+        xrefs = vw.getXrefsFrom(bVa, rtype=v_const.REF_CODE)
+        self.assertEqual(len(xrefs), 1)
+        fromva, tova, reftype, rflags = xrefs[0]
+        self.assertEqual((fromva, tova), (bVa, exitVa))
+        self.assertTrue(rflags & envi.BR_PROC)
+        self.assertIn(bVa, vw.getCallers(exitVa))
+
+    def test_a_declared_slot_is_the_destination_even_when_it_stores_a_returning_one(self):
+        vw = newUnseededWorkspace()
+        returnsVa = 0x1000
+        mapCode(vw, returnsVa, RET, name="returns")
+
+        # an ordinary initialized pointer slot, not an import, holding the address of a
+        # function that plainly returns
+        slotVa = 0x3000
+        mapNonCode(vw, slotVa, returnsVa.to_bytes(8, "little"), name="table")
+
+        fVa = 0x2000
+        mapCode(vw, fVa, NOP + callMemRip(fVa + 1, slotVa) + RET, name="f")
+
+        vw.makeFunction(returnsVa)
+        vw.makeFunction(fVa)
+        assertReturns(self, vw, fVa, "nothing is declared yet, and what the slot stores comes back")
+
+        newlyMarked = vw.addNoReturnVa(slotVa)
+
+        self.assertEqual(
+            newlyMarked,
+            {fVa},
+            "the declaration is on the slot, so the slot is where the call goes as far as this analysis is concerned",
+        )
+        assertNoReturn(
+            self,
+            vw,
+            fVa,
+            "dereferencing past a declared slot to whatever it currently stores would find a returning function and lose the conclusion",
+        )
+
+    def test_memory_indirect_caller_stays_discoverable_after_the_slot_is_proven_late(self):
+        vw = newWorkspace()
+
+        importVa = 0x1000
+        mapCode(vw, importVa, filledBuf(8), name="imp")
+        vw.makeImport(importVa, "*", "exit")
+
+        callerVa = 0x2000
+        mapCode(vw, callerVa, callMemRip(callerVa, importVa), name="caller")
+        vw.makeFunction(callerVa)
+
+        xrefs = vw.getXrefsFrom(callerVa, rtype=v_const.REF_CODE)
+        self.assertEqual(len(xrefs), 1)
+        fromva, tova, reftype, rflags = xrefs[0]
+        self.assertEqual((fromva, tova), (callerVa, importVa))
+        self.assertTrue(rflags & envi.BR_DEREF)
+        self.assertIn(callerVa, vw.getCallers(importVa))
+        assertReturns(self, vw, callerVa, "the import slot is not yet proven no-return")
+
+        # the slot is declared only after the caller has already been analyzed -- a
+        # restoration that only special-cases direct relative calls would still lose this
+        # memory-indirect caller's own discoverability the moment its call site is
+        # rewritten no-flow, and propagateNoReturn would then never find it to re-derive
+        vw.addNoReturnApi("*.exit")
+        vw.propagateNoReturn()
+
+        self.assertIn(
+            callerVa,
+            vw.getCallers(importVa),
+            "the memory-indirect caller must remain discoverable as a caller of the now-proven slot",
+        )
+        assertNoReturn(self, vw, callerVa)
+
+    def test_a_rewritten_memory_indirect_call_site_keeps_the_exact_xrefs_it_had(self):
+        vw = newUnseededWorkspace()
+
+        exitVa = 0x1000
+        mapCode(vw, exitVa, UD2, name="exit")
+
+        # a plain (non-import) pointer slot: codeflow drops a branch into an import
+        # location outright, so only a plain slot reaches the synchronous rewrite at all
+        ptrVa = 0x1100
+        mapCode(vw, ptrVa, exitVa.to_bytes(8, "little"), name="ptr")
+
+        # the identical call at two sites, one decoded before the target is proven and one
+        # after. Only the second is rewritten, and the first is what its xrefs are held
+        # against -- so what has to survive is the disassembler's own record of this call,
+        # not a shape chosen here
+        earlyVa = 0x2000
+        mapCode(vw, earlyVa, callMemRip(earlyVa, ptrVa) + RET, name="early")
+        lateVa = 0x3000
+        mapCode(vw, lateVa, callMemRip(lateVa, ptrVa) + RET, name="late")
+
+        vw.makeFunction(exitVa)
+        vw.makeFunction(earlyVa)
+        self.assertIsNotNone(
+            vw.getLocation(earlyVa + 6),
+            "nothing was proven when this site was decoded, so the instruction behind it was disassembled",
+        )
+        untouched = sorted((tova, rtype, rflags) for fromva, tova, rtype, rflags in vw.getXrefsFrom(earlyVa))
+
+        vw.addNoReturnVa(exitVa)
+        vw.makeFunction(lateVa)
+
+        self.assertIsNone(
+            vw.getLocation(lateVa + 6),
+            "this site was decoded with its target already proven, so the fallthrough behind it was cut",
+        )
+        rewritten = sorted((tova, rtype, rflags) for fromva, tova, rtype, rflags in vw.getXrefsFrom(lateVa))
+
+        self.assertEqual(
+            rewritten,
+            untouched,
+            "a rewritten call site must be left holding exactly what the same call records when it is not rewritten",
+        )
+        self.assertEqual(len(rewritten), len(set(rewritten)), "and none of them duplicated")
+        self.assertIn(
+            lateVa, vw.getCallers(ptrVa), "so it stays discoverable through whichever of them recorded the call"
+        )
+        assertNoReturn(self, vw, lateVa)
+
