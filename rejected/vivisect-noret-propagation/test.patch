index 0000000..b025f37
--- /dev/null
+++ b/vivisect/tests/testnoretprop6180ce.py
@@ -0,0 +1,1652 @@
+import sys
+import types
+import unittest
+
+import envi
+import vivisect
+import envi.const as e_const
+import vivisect.const as v_const
+import vivisect.impemu.monitor as v_imp_monitor
+
+RET = b"\xc3"
+HLT = b"\xf4"
+NOP = b"\x90"
+UD2 = b"\x0f\x0b"
+# the other two encodings x86 reserves as permanently undefined; the repo's own opcode
+# table gives all three the same INS_INVALIDOP class that ud2 has
+UD0 = b"\x0f\xff\xc0\x90"
+UD1 = b"\x0f\xb9\xc0\x90"
+# arm's own breakpoint, and an arithmetic write to pc: it goes to r0 plus 0x1000, so the
+# immediate it carries is an addend rather than the address it transfers to
+ARM_BKPT = (0xE1200070).to_bytes(4, "little")
+ARM_ADD_PC_R0_IMM = (0xE280FA01).to_bytes(4, "little")
+# bxne r0 -- a predicated branch through a register, so the instruction names no
+# destination at all for its taken side
+ARM_BXNE_R0 = (0x112FFF10).to_bytes(4, "little")
+# bkptne -- a breakpoint carrying a condition, so nothing happens at all when the
+# condition does not hold, and mvn pc, #0x1000, which writes the complement of the
+# immediate it carries into pc
+ARM_BKPTNE = (0x11200070).to_bytes(4, "little")
+ARM_MVN_PC_IMM = (0xE3E0FA01).to_bytes(4, "little")
+# str pc, [pc, #0] -- pc is the value being written OUT, to the word 8 bytes on
+ARM_STR_PC_PCREL = (0xE58FF000).to_bytes(4, "little")
+ARM_BX_LR = (0xE12FFF1E).to_bytes(4, "little")
+TEST_EAX_EAX = b"\x85\xc0"
+CALL_RAX = b"\xff\xd0"
+# cmovz eax, ebx -- an ordinary operation carrying a condition, not a branch
+CMOVZ_EAX_EBX = b"\x0f\x44\xc3"
+
+
+def callRel32(target, siteEnd):
+    return b"\xe8" + (target - siteEnd).to_bytes(4, "little", signed=True)
+
+
+def jzRel8(disp):
+    return b"\x74" + disp.to_bytes(1, "little", signed=True)
+
+
+def jzRel32(target, siteEnd):
+    return b"\x0f\x84" + (target - siteEnd).to_bytes(4, "little", signed=True)
+
+
+def jmpRel32(target, siteEnd):
+    return b"\xe9" + (target - siteEnd).to_bytes(4, "little", signed=True)
+
+
+def movRaxImm64(value):
+    return b"\x48\xb8" + value.to_bytes(8, "little")
+
+
+def movRcxImm64(value):
+    return b"\x48\xb9" + value.to_bytes(8, "little")
+
+
+CALL_RCX = b"\xff\xd1"
+JMP_RAX = b"\xff\xe0"
+
+
+def callMemRip(insnVa, ptrVa):
+    # FF /2, ModRM=00 010 101 (rip-relative), disp32 to ptrVa -- instruction is 6 bytes
+    disp = ptrVa - (insnVa + 6)
+    return b"\xff\x15" + disp.to_bytes(4, "little", signed=True)
+
+
+def filledBuf(size):
+    # int3-filled so any byte range codeflow reaches that we did not intend to be code
+    # halts disassembly instead of decoding as a plausible-looking instruction stream
+    return bytearray(b"\xcc" * size)
+
+
+def newWorkspace():
+    vw = vivisect.VivWorkspace()
+    vw.setMeta("Architecture", "amd64")
+    vw.setMeta("Platform", "linux")
+    vw.setMeta("Format", "blob")
+    vw.setMeta("DefaultCall", "sysvamd64call")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.codeblocks")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.noret")
+    return vw
+
+
+def newI386Workspace():
+    # INTO is illegal in long mode -- amd64's own disassembler rejects it outright, so
+    # exercising it needs a genuine 32-bit workspace, not newWorkspace()'s amd64 one
+    vw = vivisect.VivWorkspace()
+    vw.setMeta("Architecture", "i386")
+    vw.setMeta("Platform", "linux")
+    vw.setMeta("Format", "blob")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.codeblocks")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.noret")
+    return vw
+
+
+def newUnseededI386Workspace():
+    vw = vivisect.VivWorkspace()
+    vw.setMeta("Architecture", "i386")
+    vw.setMeta("Platform", "linux")
+    vw.setMeta("Format", "blob")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.codeblocks")
+    return vw
+
+
+def newUnseededArmWorkspace():
+    vw = vivisect.VivWorkspace()
+    vw.setMeta("Architecture", "arm")
+    vw.setMeta("Platform", "linux")
+    vw.setMeta("Format", "blob")
+    vw.setMeta("DefaultCall", "armcall")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.codeblocks")
+    return vw
+
+
+def newUnseededWorkspace():
+    # the blob/ihex/srec setups in vivisect.analysis register codeblocks but never the
+    # per-function noret pass, so nothing is ever examined before propagation runs -- only
+    # the PE and ELF setups add it
+    vw = vivisect.VivWorkspace()
+    vw.setMeta("Architecture", "amd64")
+    vw.setMeta("Platform", "linux")
+    vw.setMeta("Format", "blob")
+    vw.setMeta("DefaultCall", "sysvamd64call")
+    vw.addFuncAnalysisModule("vivisect.analysis.generic.codeblocks")
+    return vw
+
+
+def mapCode(vw, va, data, name="test"):
+    vw.addMemoryMap(va, 7, name, bytes(data))
+    vw.addSegment(va, len(data), name, name)
+
+
+def mapNonCode(vw, va, data, name="data"):
+    vw.addMemoryMap(va, e_const.MM_READ, name, bytes(data))
+    vw.addSegment(va, len(data), name, name)
+
+
+def mapUninitCode(vw, va, data, name="bss"):
+    vw.addMemoryMap(va, e_const.MM_RWX | e_const.MM_UNINIT, name, bytes(data))
+    vw.addSegment(va, len(data), name, name)
+
+
+def mapUninitData(vw, va, data, name="bss"):
+    vw.addMemoryMap(va, e_const.MM_READ | e_const.MM_WRITE | e_const.MM_UNINIT, name, bytes(data))
+    vw.addSegment(va, len(data), name, name)
+
+
+def assertNoReturn(test, vw, va, msg=""):
+    test.assertTrue(vw.isNoReturnVa(va), msg or ("expected 0x%x to be no-return" % va))
+
+
+def assertReturns(test, vw, va, msg=""):
+    test.assertFalse(vw.isNoReturnVa(va), msg or ("expected 0x%x to remain return-capable" % va))
+
+
+class NoReturnFalsePositiveTest(unittest.TestCase):
+    """
+    A terminal call to a function that has not been proven no-return -- including a plain,
+    ordinary, returning function -- must never by itself support a no-return conclusion.
+    """
+
+    def test_leaf_terminal_call_to_ordinary_function_is_not_noreturn(self):
+        vw = newWorkspace()
+        # each function lives in its own exactly-sized memory region: nothing is mapped
+        # after the call, so this is a genuine truncated-path leaf, not a call whose
+        # fallthrough happens to run into reachable filler bytes
+        normalVa = 0x1000
+        mapCode(vw, normalVa, RET, name="normal")
+
+        fVa = 0x1010
+        fBody = callRel32(normalVa, fVa + 5)
+        mapCode(vw, fVa, fBody, name="f")
+
+        vw.makeFunction(normalVa)
+        vw.makeFunction(fVa)
+        vw.propagateNoReturn()
+
+        assertReturns(self, vw, fVa)
+
+    def test_two_function_reference_cycle_with_no_exit_stays_return_capable(self):
+        vw = newWorkspace()
+        # each function lives in its own exactly-sized memory region -- see the comment
+        # above
+        pVa, qVa = 0x1000, 0x1010
+        pBody = callRel32(qVa, pVa + 5)
+        mapCode(vw, pVa, pBody, name="p")
+        qBody = callRel32(pVa, qVa + 5)
+        mapCode(vw, qVa, qBody, name="q")
+
+        vw.makeFunction(pVa)
+        vw.propagateNoReturn()
+
+        assertReturns(self, vw, pVa, "a pure reference cycle with no real exit must not be marked no-return")
+        assertReturns(self, vw, qVa, "a pure reference cycle with no real exit must not be marked no-return")
+
+    def test_three_function_reference_cycle_with_no_exit_stays_return_capable(self):
+        vw = newWorkspace()
+        # the same cycle one node longer, so the pair calling each other back and forth is
+        # not the only shape of it
+        pVa, qVa, rVa = 0x1000, 0x1010, 0x1020
+        pBody = callRel32(qVa, pVa + 5)
+        mapCode(vw, pVa, pBody, name="p")
+        qBody = callRel32(rVa, qVa + 5)
+        mapCode(vw, qVa, qBody, name="q")
+        rBody = callRel32(pVa, rVa + 5)
+        mapCode(vw, rVa, rBody, name="r")
+
+        vw.makeFunction(pVa)
+        vw.propagateNoReturn()
+
+        assertReturns(self, vw, pVa, "a three-function reference cycle with no real exit must not be marked no-return")
+        assertReturns(self, vw, qVa, "a three-function reference cycle with no real exit must not be marked no-return")
+        assertReturns(self, vw, rVa, "a three-function reference cycle with no real exit must not be marked no-return")
+
+    def test_terminal_path_truncated_by_unmapped_memory_is_not_noreturn(self):
+        vw = newWorkspace()
+        fVa = 0x1000
+        # ordinary instructions only -- no call, no return, no branch anywhere; the leaf
+        # exists purely because codeflow runs off the end of mapped memory
+        body = b"\x90\x90\x90"
+        mapCode(vw, fVa, body, name="f")
+
+        vw.makeFunction(fVa)
+
+        assertReturns(self, vw, fVa, "a path that merely runs out of mapped code is not evidence of no-return")
+
+    def test_x86_into_with_a_returning_fallthrough_is_not_noreturn(self):
+        vw = newI386Workspace()
+        # x86 INTO only traps when OF is set -- on every other path it falls straight
+        # through to whatever follows, exactly like any other conditional. It must be told
+        # apart from a genuine unconditional trap/halt the same way an architectural return
+        # must be, not treated as proof merely for lacking a fallthrough of its own.
+        fVa = 0x1000
+        body = b"\xce" + RET
+        mapCode(vw, fVa, body, name="f")
+
+        vw.makeFunction(fVa)
+
+        assertReturns(self, vw, fVa, "a conditional trap must never itself be evidence of no-return")
+
+    def test_x86_int1_debug_trap_is_independently_derived_noreturn(self):
+        vw = newUnseededI386Workspace()
+        # int1 (ICEBP, 0xf1) is the decoder's own debug-trap terminal, exactly the class
+        # int3 already is. Its operand-less form traps wherever it executes, so a function
+        # containing only it is proven no-return rather than merely escaping analysis.
+        trapVa = 0x1000
+        mapCode(vw, trapVa, b"\xf1", name="trap")
+
+        vw.makeFunction(trapVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {trapVa},
+            "nothing calls a trap-only function, so only a pass that examines every function can reach it at all",
+        )
+        assertNoReturn(
+            self, vw, trapVa, "an int1 debug trap is the same class of terminal as int3, so it is its own proof"
+        )
+
+    def test_x86_software_interrupt_with_an_operand_is_not_itself_a_trap(self):
+        vw = newI386Workspace()
+        # `int N` enters whatever handler is installed for N, which may well return. It is
+        # not self-evidently terminal the way int1 and int3 are, so it must stay unproven
+        # rather than being promoted to trap evidence alongside them.
+        fVa = 0x1000
+        mapCode(vw, fVa, b"\xcd\x21", name="f")
+
+        vw.makeFunction(fVa)
+
+        assertReturns(
+            self,
+            vw,
+            fVa,
+            "an arbitrary software interrupt is not a genuine trap and must not prove no-return on its own",
+        )
+
+    def test_x86_software_interrupt_on_a_different_vector_is_not_a_trap_either(self):
+        vw = newI386Workspace()
+        # a different interrupt number entirely: what disqualifies the instruction is
+        # carrying an operand at all, not which handler that operand happens to name
+        fVa = 0x1000
+        mapCode(vw, fVa, b"\xcd\x80", name="f")
+
+        vw.makeFunction(fVa)
+
+        assertReturns(
+            self,
+            vw,
+            fVa,
+            "every operand-carrying software interrupt transfers to a handler that may return, whichever vector it names",
+        )
+
+    def test_conditional_branch_to_proven_target_with_truncated_fallthrough_is_not_noreturn(self):
+        vw = newWorkspace()
+        exitVa = 0x1000
+        mapCode(vw, exitVa, UD2, name="exit")
+        vw.addNoReturnVa(exitVa)
+
+        # a function whose only instructions are test eax,eax ; jz <exitVa>, mapped so
+        # tightly that the fallthrough runs off the end of mapped memory -- the taken side
+        # leads to an already-proven no-return target, but a conditional branch is never
+        # itself evidence of no-return
+        fVa = 0x2000
+        head = TEST_EAX_EAX
+        jz = jzRel32(exitVa, fVa + len(head) + 6)
+        body = head + jz
+        mapCode(vw, fVa, body, name="f")
+
+        vw.makeFunction(fVa)
+
+        assertReturns(
+            self, vw, fVa, "a conditional branch to a proven no-return target must not itself make the caller no-return"
+        )
+
+
+class LocalBranchCycleTest(unittest.TestCase):
+    """
+    A walk that comes back to somewhere it has already been has not reached a terminal --
+    it has simply run out of new addresses. Nothing along the way trapped and nothing it
+    called was proven, so there is no evidence, and an empty proof is not a proof.
+    """
+
+    def test_a_bare_local_branch_cycle_proves_nothing(self):
+        vw = newWorkspace()
+        loopVa = 0x1000
+        mapCode(vw, loopVa, jmpRel32(loopVa, loopVa + 5), name="loop")
+
+        vw.makeFunction(loopVa)
+
+        assertReturns(
+            self,
+            vw,
+            loopVa,
+            "a jump back into the function's own body is ordinary control flow, so a cycle built only from it reaches no trap and proves no target -- it must not be concluded no-return",
+        )
+
+    def test_a_local_cycle_beside_a_trap_is_not_proven_by_that_trap(self):
