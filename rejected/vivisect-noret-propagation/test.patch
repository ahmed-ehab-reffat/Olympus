new file mode 100755
index 0000000..1a82b97
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+usage() {
+  echo "usage: test.sh [--output_path PATH] base|new" >&2
+  exit 2
+}
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      [ -n "$OUTPUT_PATH" ] || usage
+      shift
+      ;;
+    --output_path)
+      [ $# -ge 2 ] && [ -n "$2" ] || usage
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    base|new)
+      [ -z "$MODE" ] || usage
+      MODE="$1"
+      shift
+      ;;
+    *)
+      usage
+      ;;
+  esac
+done
+
+[ -n "$MODE" ] || usage
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")" || exit 1
+fi
+
+# vivisect's own suite mixes test_foo.py and testfoo.py naming; pytest's default collection
+# only recognizes the first, so this drives unittest's discovery directly (matching the
+# project's own CI config) via run_tests_6180ce.py, which also documents and applies the
+# package selection for each mode.
+python3 run_tests_6180ce.py "$MODE" "$OUTPUT_PATH"
+exit $?
diff --git a/vivisect/tests/testnoretprop6180ce.py b/vivisect/tests/testnoretprop6180ce.py
