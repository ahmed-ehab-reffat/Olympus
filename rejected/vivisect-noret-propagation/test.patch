+class NoReturnMemoryIndirectTest(unittest.TestCase):
+    """
+    A terminal call through a memory-indirect (dereferenced) branch must resolve the
+    pointer to find its real target, the same as codeflow's own branch walker does, and
+    that target participates in chain and propagation exactly like a direct call target.
+    """
+
+    def test_memory_indirect_call_dereferences_to_the_real_target(self):
+        vw = newWorkspace()
+
+        # every function lives in its own exactly-sized memory region: a memory-indirect
+        # call's dereferenced target is itself descended into by codeflow (the same
+        # "deepest callback first" recursion a direct call gets), so SHARED can be fully
+        # examined before EXIT is declared no-return if its own region is not sized
+        # tightly, which would corrupt its block boundary the same way an ordinary
+        # out-of-order discovery would. EXIT's own body is left as an unresolved
+        # register-indirect call, not a bare trap, so recursively discovering it as its
+        # own function does not by itself prove it noreturn ahead of the real declaration.
+        exitVa = 0x1000
+        mapCode(vw, exitVa, CALL_RAX, name="exit")
+
+        sharedVa = 0x1010
+        sharedBody = callRel32(exitVa, sharedVa + 5)
+        mapCode(vw, sharedVa, sharedBody, name="shared")
+
+        ptrVa = 0x1020
+        mapCode(vw, ptrVa, sharedVa.to_bytes(8, "little"), name="ptr")
+
+        memVa = 0x2000
+        mapCode(vw, memVa, callMemRip(memVa, ptrVa), name="mem")
+
+        vw.makeFunction(memVa)
+        assertReturns(self, vw, memVa, "MEM must not be noreturn before EXIT is declared")
+
+        vw.addNoReturnVa(exitVa)
+        vw.makeFunction(sharedVa)
+        vw.propagateNoReturn()
+
+        assertNoReturn(self, vw, sharedVa)
+        assertNoReturn(
+            self, vw, memVa, "a memory-indirect call must resolve through the pointer to its real, now-noreturn target"
+        )
+
+    def test_memory_indirect_call_through_an_uninitialized_slot_resolves_to_nothing(self):
+        vw = newUnseededWorkspace()
+        exitVa = 0x1000
+        mapCode(vw, exitVa, UD2, name="exit")
+
+        # an ordinary bss function pointer: readable, but nothing has been stored in it
+        # yet, so the bytes the image carries there are not the target the call will take
+        slotVa = 0x3000
+        mapUninitData(vw, slotVa, exitVa.to_bytes(8, "little"), name="bss")
+
+        fVa = 0x2000
+        mapCode(vw, fVa, NOP + callMemRip(fVa + 1, slotVa) + RET, name="f")
+
+        vw.makeFunction(exitVa)
+        vw.makeFunction(fVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {exitVa},
+            "the destination proves itself, and the caller resolves to nothing that could carry it",
+        )
+        assertReturns(
+            self,
+            vw,
+            fVa,
+            "a slot with nothing stored in it settles no path, whatever its backing bytes happen to spell",
+        )
+
