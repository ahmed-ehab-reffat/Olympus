+class ComputedTransferTest(unittest.TestCase):
+    """
+    A transfer whose destination is worked out from more than one source names that
+    destination nowhere. Whatever operand it carries is an addend, not a target, and a
+    conclusion drawn from reading one as the other would be about an address the
+    instruction never goes to.
+    """
+
+    def test_a_trap_behind_a_computed_transfer_is_outside_the_function(self):
+        vw = newUnseededArmWorkspace()
+        fVa = 0x2000
+        mapCode(vw, fVa, ARM_ADD_PC_R0_IMM + ARM_BKPT, name="f")
+
+        vw.makeFunction(fVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            set(),
+            "control leaves at the transfer, so the trap decoded behind it is on no path this function takes",
+        )
+        assertReturns(self, vw, fVa)
+
+    def test_a_computed_transfer_does_not_resolve_to_its_own_operand(self):
+        vw = newUnseededArmWorkspace()
+        exitVa = 0x1000
+        mapCode(vw, exitVa, ARM_BKPT, name="exit")
+
+        # add pc, r0, #0x1000 -- it goes to r0 plus 0x1000, and nothing here knows r0
+        fVa = 0x2000
+        mapCode(vw, fVa, ARM_ADD_PC_R0_IMM, name="f")
+
+        vw.makeFunction(exitVa)
+        vw.makeFunction(fVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {exitVa},
+            "the immediate this instruction carries happens to equal a proven address, which is a coincidence and not a destination",
+        )
+        assertReturns(self, vw, fVa, "nothing has established where this transfer goes, so it settles nothing")
+
+    def test_a_computed_transfer_settles_its_path_through_a_recorded_reference(self):
+        vw = newUnseededArmWorkspace()
+        exitVa = 0x3000
+        mapCode(vw, exitVa, ARM_BKPT, name="exit")
+
+        # the same instruction, and this time the workspace has recorded where it goes --
+        # to an address that is not the immediate it carries
+        fVa = 0x2000
+        mapCode(vw, fVa, ARM_ADD_PC_R0_IMM, name="f")
+
+        vw.makeFunction(exitVa)
+        vw.makeFunction(fVa)
+        vw.addXref(fVa, exitVa, v_const.REF_CODE)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {exitVa, fVa},
+            "the trap settles the destination, and a recorded reference is what resolves the transfer to it",
+        )
+        assertNoReturn(self, vw, fVa, "a transfer whose recorded destination is proven settles the path it sits on")
+
+    def test_a_computed_transfer_does_not_resolve_to_a_complemented_immediate(self):
+        vw = newUnseededArmWorkspace()
+        exitVa = 0x1000
+        mapCode(vw, exitVa, ARM_BKPT, name="exit")
+
+        # mvn pc, #0x1000 -- it goes to the complement of that immediate, so the immediate
+        # is no more its destination than an addend is
+        fVa = 0x2000
+        mapCode(vw, fVa, ARM_MVN_PC_IMM, name="f")
+
+        vw.makeFunction(exitVa)
+        vw.makeFunction(fVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {exitVa},
+            "one operand and a transformation of it are not the same address",
+        )
+        assertReturns(self, vw, fVa, "nothing has established where this transfer goes, so it settles nothing")
