diff --git a/run_tests_6180ce.py b/run_tests_6180ce.py
new file mode 100755
index 0000000..73dd817
--- /dev/null
+++ b/run_tests_6180ce.py
@@ -0,0 +1,192 @@
+"""
+Test driver for test.sh. vivisect's own test suite mixes two file-naming conventions
+(test_foo.py and testfoo.py) and pytest's default collection only recognizes the first, so
+this uses unittest's discovery (matching the project's own CI config) instead.
+
+JUnit XML is written by a small in-house TestResult (below) rather than an external
+dependency, so writing a structured report never depends on anything but the standard
+library.
+
+BASE_PACKAGES covers vivisect and envi: no-return analysis lives in the former and the
+architecture decoders it reads instruction flags from live in the latter. It drops the vtrace
+package, whose tests attach to and single-step a real child process via ptrace: that can hang
+for an unbounded time in a container restricting ptrace, and its attach/detach timing is
+non-deterministic anyway.
+"""
+
+import sys
+import time
+import unittest
+import traceback
+import xml.sax.saxutils
+
+EXCLUDED_MODULES = {
+    # this driver's companion test module: the two run modes are disjoint, so the module
+    # loaded by name for 'new' must not also be picked up by the package walk
+    "vivisect.tests.testnoretprop6180ce",
+    # imports a Qt binding for GUI config widgets, which the headless analysis image does not
+    # install; it covers GUI configuration rather than analysis or instruction decoding
+    "envi.tests.test_qt_config",
+}
+
+# both packages are walked: an edit to a shared decoder that satisfies one instruction
+# encoding while breaking an unrelated one would otherwise go unnoticed here
+BASE_PACKAGES = ("vivisect", "envi")
+
+
+def _isExcluded(testId):
+    for excluded in EXCLUDED_MODULES:
+        # a module that fails to import surfaces as a synthetic _FailedTest whose own module
+        # is unittest.loader, not the real one, with the real module name as an id suffix
+        # instead; a module that imports fine but whose individual test methods fail only at
+        # run time keeps its real module name as an id prefix. Match either shape.
+        if testId == excluded or testId.endswith("." + excluded) or testId.startswith(excluded + "."):
+            return True
+    return False
+
+
+def _filterSuite(suite):
+    kept = unittest.TestSuite()
+    for item in suite:
+        if isinstance(item, unittest.TestSuite):
+            kept.addTest(_filterSuite(item))
+            continue
+        if _isExcluded(item.id()):
+            continue
+        kept.addTest(item)
+    return kept
+
+
+def loadBaseSuite():
+    loader = unittest.TestLoader()
+    combined = unittest.TestSuite()
+    for pkg in BASE_PACKAGES:
+        combined.addTest(loader.discover("%s/tests" % pkg, pattern="test*.py", top_level_dir="."))
+    return _filterSuite(combined)
+
+
+def loadNewSuite():
+    loader = unittest.TestLoader()
+    return loader.loadTestsFromName("vivisect.tests.testnoretprop6180ce")
+
+
+class _JUnitResult(unittest.TestResult):
+    """
+    Collects per-test outcomes (pass/failure/error/skip) with timing, including the real
+    traceback text unittest itself would print.
+    """
+
+    def __init__(self):
+        unittest.TestResult.__init__(self)
+        self.records = []
+        self._started = None
+
+    def startTest(self, test):
+        unittest.TestResult.startTest(self, test)
+        self._started = time.time()
+
+    def _elapsed(self):
+        return time.time() - self._started if self._started else 0.0
+
+    def addSuccess(self, test):
+        unittest.TestResult.addSuccess(self, test)
+        self.records.append((test, "pass", None, self._elapsed()))
+
+    def addFailure(self, test, err):
+        unittest.TestResult.addFailure(self, test, err)
+        self.records.append((test, "failure", self._exc_info_to_string(err, test), self._elapsed()))
+
+    def addError(self, test, err):
+        unittest.TestResult.addError(self, test, err)
+        self.records.append((test, "error", self._exc_info_to_string(err, test), self._elapsed()))
+
+    def addSkip(self, test, reason):
+        unittest.TestResult.addSkip(self, test, reason)
+        self.records.append((test, "skip", reason, self._elapsed()))
+
+
+def _writeJUnit(outputPath, records):
+    esc = xml.sax.saxutils.escape
+    failures = sum(1 for _, status, _, _ in records if status == "failure")
+    errors = sum(1 for _, status, _, _ in records if status == "error")
+    skipped = sum(1 for _, status, _, _ in records if status == "skip")
+
+    cases = []
+    for test, status, detail, elapsed in records:
+        testId = test.id()
+        classname, _, name = testId.rpartition(".")
+        classname = esc(classname or testId)
+        name = esc(name or testId)
+        if status == "pass":
+            cases.append('<testcase classname="%s" name="%s" time="%.3f" />' % (classname, name, elapsed))
+        elif status == "skip":
+            cases.append(
+                '<testcase classname="%s" name="%s" time="%.3f"><skipped message="%s" /></testcase>'
+                % (classname, name, elapsed, esc(str(detail)))
+            )
+        else:
+            tag = "failure" if status == "failure" else "error"
+            cases.append(
+                '<testcase classname="%s" name="%s" time="%.3f"><%s>%s</%s></testcase>'
+                % (classname, name, elapsed, tag, esc(detail), tag)
+            )
+
+    xmlText = (
+        '<?xml version="1.0" encoding="UTF-8"?>\n'
+        '<testsuites><testsuite name="run_tests_6180ce" tests="%d" failures="%d" errors="%d" skipped="%d">\n'
+        "%s\n</testsuite></testsuites>\n"
+    ) % (len(records), failures, errors, skipped, "\n".join(cases))
+    with open(outputPath, "w", encoding="utf-8") as fd:
+        fd.write(xmlText)
+
+
+def _writeCollectionFailureJUnit(outputPath, target, detail):
+    """
+    Write a single failing testcase named for the module the suite failed to collect
+    (`target`), carrying its traceback (`detail`), so a collection-time failure still produces
+    a parseable JUnit document under the failing module's own identity.
+    """
+    _writeJUnit(outputPath, [(_CollectionFailure(target), "error", detail, 0.0)])
+
+
+class _CollectionFailure:
+    def __init__(self, target):
+        self._target = target
+
+    def id(self):
+        return self._target
+
+
+def main():
+    if len(sys.argv) < 2 or sys.argv[1] not in ("base", "new"):
+        sys.stderr.write("usage: run_tests_6180ce.py base|new [output_path]\n")
+        sys.exit(2)
+
+    mode = sys.argv[1]
+    outputPath = sys.argv[2] if len(sys.argv) > 2 else None
+    target = "vivisect.tests.testnoretprop6180ce" if mode == "new" else ".".join(BASE_PACKAGES)
+
+    try:
+        suite = loadNewSuite() if mode == "new" else loadBaseSuite()
+    except Exception:
+        detail = traceback.format_exc()
+        sys.stderr.write(detail)
+        if outputPath:
+            _writeCollectionFailureJUnit(outputPath, target, detail)
+        sys.exit(1)
+
+    if outputPath:
+        result = _JUnitResult()
+        suite.run(result)
+        _writeJUnit(outputPath, result.records)
+        wasSuccessful = not result.failures and not result.errors
+    else:
+        runner = unittest.TextTestRunner(verbosity=2)
+        result = runner.run(suite)
+        wasSuccessful = result.wasSuccessful()
+
+    sys.exit(0 if wasSuccessful else 1)
+
+
+if __name__ == "__main__":
+    main()
