+class NoReturnChainTest(unittest.TestCase):
+    """
+    A function whose only terminal call reaches a proven no-return function, directly or
+    through a chain of intermediate functions, is itself no-return.
+    """
+
+    def test_direct_declared_two_hop_chain(self):
+        vw = newWorkspace()
+        data = filledBuf(0x30)
+        exitVa = 0x1000
+        data[0:2] = UD2
+        bVa = 0x1010
+        data[0x10:0x15] = callRel32(exitVa, bVa + 5)
+        aVa = 0x1020
+        data[0x20:0x25] = callRel32(bVa, aVa + 5)
+        mapCode(vw, 0x1000, data)
+
+        vw.addNoReturnVa(exitVa)
+        vw.makeFunction(aVa)
+        vw.propagateNoReturn()
+
+        assertNoReturn(self, vw, bVa)
+        assertNoReturn(self, vw, aVa)
+
+    def test_three_hop_chain_and_a_genuinely_mixed_sibling(self):
+        vw = newWorkspace()
+        data = filledBuf(0x60)
+        exitVa = 0x1000
+        data[0:2] = UD2
+        cVa = 0x1010
+        data[0x10:0x15] = callRel32(exitVa, cVa + 5)
+        bVa = 0x1020
+        data[0x20:0x25] = callRel32(cVa, bVa + 5)
+        aVa = 0x1030
+        data[0x30:0x35] = callRel32(bVa, aVa + 5)
+        # MIXED: test eax,eax ; jz +7 ; call exit ; <pad> ; ret -- two distinct leaves, one
+        # of which genuinely returns, so MIXED must stay return-capable.
+        mixedVa = 0x1040
+        body = TEST_EAX_EAX + jzRel8(7) + callRel32(exitVa, mixedVa + 2 + 2 + 5)
+        body += b"\xcc" * (7 - 5) + RET
+        data[0x40 : 0x40 + len(body)] = body
+        mapCode(vw, 0x1000, data)
+
+        vw.addNoReturnVa(exitVa)
+        vw.makeFunction(aVa)
+        vw.makeFunction(mixedVa)
+        vw.propagateNoReturn()
+
+        assertNoReturn(self, vw, cVa)
+        assertNoReturn(self, vw, bVa)
+        assertNoReturn(self, vw, aVa)
+        assertReturns(self, vw, mixedVa, "a leaf with a genuine return must keep the function return-capable")
+
+    def test_all_terminal_paths_call_different_proven_noreturn_targets(self):
+        # both terminal paths reach their target through a register-indirect call rather than
+        # a direct one -- a direct call to an already-declared no-return target is descended
+        # into and resolved by codeflow's own recursion regardless of declaration order, which
+        # would make this pass without propagateNoReturn ever running
+        vw = newWorkspace()
+        exit1Va = 0x1000
+        exit2Va = 0x1010
+        mapCode(vw, exit1Va, UD2, name="exit1")
+        mapCode(vw, exit2Va, UD2, name="exit2")
+
+        fVa = 0x2000
+        head = TEST_EAX_EAX + jzRel8(12)
+        movRax = movRaxImm64(exit1Va)
+        branch1 = movRax + CALL_RAX
+        movRcx = movRcxImm64(exit2Va)
+        branch2 = movRcx + CALL_RCX
+        body = head + branch1 + branch2
+        mapCode(vw, fVa, body, name="f")
+        call1Va = fVa + len(head) + len(movRax)
+        call2Va = fVa + len(head) + len(branch1) + len(movRcx)
+
+        vw.makeFunction(fVa)
+        assertReturns(
+            self, vw, fVa, "unresolved indirect calls on every terminal path must not support a no-return conclusion"
+        )
+
+        vw.addNoReturnVa(exit1Va)
+        vw.addNoReturnVa(exit2Va)
+        assertReturns(self, vw, fVa, "declaring the targets alone must not retroactively change an unresolved caller")
+
+        vw.addXref(call1Va, exit1Va, v_const.REF_CODE, envi.BR_PROC)
+        vw.addXref(call2Va, exit2Va, v_const.REF_CODE, envi.BR_PROC)
+        assertReturns(self, vw, fVa, "resolving the targets alone must not retroactively change anything")
+
+        vw.propagateNoReturn()
+        assertNoReturn(
+            self, vw, fVa, "every terminal path calling a distinct proven no-return target must derive no-return"
+        )
