+class MixedDispatchFixedPointTest(unittest.TestCase):
+    """
+    One call reaches the fixed point. A dispatch with both an outgoing case and a case landing
+    back inside the dispatching function depends on what BOTH of them reach, so the outgoing
+    case being unproven when the dependencies are collected cannot end the collection:
+    whatever the local case calls is still a target this function comes to depend on, and
+    dropping it means nothing looks at this function again once that target is proven.
+    """
+
+    def test_one_call_reaches_a_caller_provable_only_through_a_local_case(self):
+        vw = newUnseededWorkspace()
+        rootVa = 0x1000
+        mapCode(vw, rootVa, UD2, name="root")
+
+        # a three-deep chain, so the local case's own dependency is proven strictly after
+        # the outgoing case is -- whichever order the two of them come up in
+        outVa = 0x1100
+        mapCode(vw, outVa, callRel32(rootVa, outVa + 5) + RET, name="out")
+        midVa = 0x1200
+        mapCode(vw, midVa, callRel32(outVa, midVa + 5) + RET, name="mid")
+        deepVa = 0x1300
+        mapCode(vw, deepVa, callRel32(midVa, deepVa + 5) + RET, name="deep")
+
+        fVa = 0x2000
+        caseVa = fVa + 2
+        mapCode(vw, fVa, JMP_RAX + CALL_RCX + RET, name="f")
+
+        for va in (rootVa, outVa, midVa, deepVa, fVa):
+            vw.makeFunction(va)
+
+        vw.addXref(fVa, outVa, v_const.REF_CODE, envi.BR_PROC)
+        vw.addXref(fVa, caseVa, v_const.REF_CODE)
+        vw.makeCode(caseVa)
+        vw.addXref(caseVa, deepVa, v_const.REF_CODE, envi.BR_PROC)
+        vw.analyzeFunction(fVa)
+        self.assertEqual(
+            vw.getFunction(caseVa),
+            fVa,
+            "the second case has to belong to the dispatching function, or it is not a local case at all",
+        )
+        self.assertEqual(
+            vw.getFunction(outVa), outVa, "the first case has to be a separate function, or it is not an outgoing one"
+        )
+
+        self.assertEqual(
+            vw.addNoReturnVa(rootVa),
+            {outVa, midVa, deepVa, fVa},
+            "every consequence of the declaration is derived by this one call, including the dispatcher whose remaining dependency is reached only through its local case",
+        )
+        self.assertEqual(vw.propagateNoReturn(), set(), "nothing is left for a second call to find")
+
