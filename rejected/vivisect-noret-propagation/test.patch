+class LateProvenCallWithDecodedFallthroughTest(unittest.TestCase):
+    """
+    A caller whose call site had an ordinary, already-decoded fallthrough at the time it was
+    first examined -- the common `call target; ret` shape -- must still become provable
+    noreturn once the target is proven noreturn afterward. Proof must be re-derived against
+    current knowledge by walking the instruction stream directly, not by trusting whichever
+    codeblock leaf codeflow happened to build when the target's status was still unknown.
+    """
+
+    def test_call_then_ret_becomes_noreturn_once_the_target_is_declared_afterward(self):
+        vw = newWorkspace()
+        exitVa = 0x1000
+        mapCode(vw, exitVa, UD2, name="exit")
+
+        # reached only through a register-indirect call, resolved later via addXref, so
+        # codeflow never recursively descends into exitVa while decoding callerVa -- the
+        # trailing RET is genuinely decoded and kept as part of callerVa's own codeblock
+        callerVa = 0x2000
+        mov = movRaxImm64(exitVa)
+        buf = mov + CALL_RAX + RET
+        mapCode(vw, callerVa, buf, name="caller")
+        callVa = callerVa + len(mov)
+
+        vw.makeFunction(callerVa)
+        assertReturns(self, vw, callerVa, "an unresolved indirect call followed by a real ret must stay return-capable")
+
+        vw.addXref(callVa, exitVa, v_const.REF_CODE, envi.BR_PROC)
+        assertReturns(self, vw, callerVa, "resolving the target alone must not retroactively change anything")
+
+        newlyMarked = vw.addNoReturnVa(exitVa)
+
+        self.assertIn(
+            callerVa,
+            newlyMarked,
+            "declaring the call target no-return must newly prove the caller, even though its own codeblock still ends in a decoded ret after the call",
+        )
+        assertNoReturn(self, vw, callerVa)
