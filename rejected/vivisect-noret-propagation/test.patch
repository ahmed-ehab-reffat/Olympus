+class TrapOnlyTerminalTest(unittest.TestCase):
+    """
+    A terminal instruction that is itself an explicit non-fallthrough trap or halt (int3,
+    ud2, and similar) -- one with no return and no branch of its own -- is positive
+    noreturn evidence on its own, the same as codeflow's original leaf classification. This
+    must be told apart from a path that merely runs out of mapped code, which stays unproven.
+    """
+
+    def test_bare_trap_instruction_is_independently_derived_noreturn(self):
+        vw = newUnseededWorkspace()
+        trapVa = 0x1000
+        mapCode(vw, trapVa, b"\xcc", name="trap")
+
+        vw.makeFunction(trapVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {trapVa},
+            "a trap-only function calls nothing, so no walk outward from an already-proven address ever reaches it -- every function has to be examined",
+        )
+        assertNoReturn(
+            self,
+            vw,
+            trapVa,
+            "a function whose only instruction is an explicit trap must be independently derived no-return, without any direct addNoReturnVa declaration",
+        )
+
+    def test_bare_halt_instruction_is_independently_derived_noreturn(self):
+        vw = newUnseededWorkspace()
+        haltVa = 0x1000
+        mapCode(vw, haltVa, HLT, name="halt")
+
+        vw.makeFunction(haltVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {haltVa},
+            "a halt is the other half of the trap-or-halt rule and settles a path exactly as a trap does",
+        )
+        assertNoReturn(
+            self,
+            vw,
+            haltVa,
+            "an implementation that only knows the undefined-instruction and breakpoint encodings has not read the rule",
+        )
+
+    def test_the_other_undefined_instruction_encodings_are_traps_too(self):
+        # ud2 is the encoding everyone knows; x86 reserves two more for the same purpose and
+        # this repository's own opcode table puts all three in one class. A classifier built
+        # from a list of remembered spellings recognises the famous one and not its siblings
+        for name, encoding in (("ud0", UD0), ("ud1", UD1)):
+            vw = newUnseededWorkspace()
+            trapVa = 0x1000
+            mapCode(vw, trapVa, encoding, name=name)
+
+            vw.makeFunction(trapVa)
+
+            self.assertEqual(
+                vw.propagateNoReturn(),
+                {trapVa},
+                "%s is as permanently undefined as ud2 and settles a path the same way" % name,
+            )
+            assertNoReturn(self, vw, trapVa)
+
+    def test_a_trap_behind_a_call_to_an_ordinary_function_is_still_the_proof(self):
+        vw = newUnseededWorkspace()
+        ordinaryVa = 0x1000
+        mapCode(vw, ordinaryVa, RET, name="ordinary")
+
+        fVa = 0x2000
+        mapCode(vw, fVa, callRel32(ordinaryVa, fVa + 5) + UD2, name="f")
+
+        vw.makeFunction(ordinaryVa)
+        vw.makeFunction(fVa)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {fVa},
+            "a call that is not proven leaves its fallthrough live, and the trap sitting on that fallthrough settles the only path this function has",
+        )
+        assertNoReturn(
+            self,
+            vw,
+            fVa,
+            "nothing about the callee is being relied on, so this function is proven on its own terms and no walk outward from another address is needed to reach it",
+        )
+
+
+class MonotonicConclusionTest(unittest.TestCase):
+    """
+    A conclusion already reached stands. Re-derivation examines what this workspace does not
+    already know, so a function that was already proven is not revisited to be argued out of
+    it when the code under it changes afterward.
+    """
+
+    def test_a_conclusion_stands_after_its_own_body_gains_a_returning_path(self):
+        vw = newUnseededWorkspace()
+        exitVa = 0x1000
+        mapCode(vw, exitVa, UD2 + NOP, name="exit")
+
+        fVa = 0x2000
+        mapCode(vw, fVa, callRel32(exitVa, fVa + 5) + RET, name="f")
+
+        vw.makeFunction(exitVa)
+        vw.makeFunction(fVa)
+
+        self.assertEqual(vw.propagateNoReturn(), {exitVa, fVa})
+
+        vw.writeMemory(exitVa, RET + NOP)
+        self.assertEqual(
+            vw.parseOpcode(exitVa).mnem,
+            "ret",
+            "the body has to read differently now for the re-derivation below to have anything to see",
+        )
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            set(),
+            "nothing is newly marked, and nothing already marked is revisited to be argued out of",
+        )
+        assertNoReturn(self, vw, exitVa, "the conclusion was reached and is not withdrawn")
+        assertNoReturn(self, vw, fVa, "nor is anything that was concluded from it")
+
+
+class WalkStopsAtNonCodeMemoryTest(unittest.TestCase):
+    """
+    Running off the end of a function's own executable memory is not evidence of anything.
+    vw.parseOpcode reads through getByteDef, which asks only that an address be mapped, so
+    whatever bytes happen to sit in an adjacent data map decode into some instruction --
+    possibly a trap. Codeflow itself refuses to schedule a destination that is not
+    executable and initialized, and this re-derivation has to stop at the same boundary or
+    it manufactures proof out of data the processor would never have executed.
+    """
+
+    def test_a_trap_in_an_adjacent_non_executable_map_is_not_evidence(self):
+        vw = newWorkspace()
+        fva = 0x1000
+        mapCode(vw, fva, NOP, name="code")
+        mapNonCode(vw, fva + 1, UD2, name="data")
+
+        vw.makeFunction(fva)
+
+        assertReturns(
+            self,
+            vw,
+            fva,
+            "a trap sitting in a non-executable map is not code this function reaches, so it cannot prove the function no-return",
+        )
+
+    def test_the_same_trap_inside_executable_memory_is_evidence(self):
+        vw = newUnseededWorkspace()
+        fva = 0x1000
+        mapCode(vw, fva, NOP + UD2, name="code")
+
+        vw.makeFunction(fva)
+
+        self.assertEqual(
+            vw.propagateNoReturn(),
+            {fva},
+            "the trap settles the only path this function has, so a workspace-wide pass proves it with nothing else to go on",
+        )
+        assertNoReturn(
+            self, vw, fva, "the identical trap bytes reached through executable memory are ordinary trap-leaf evidence"
+        )
+
+    def test_a_trap_in_an_executable_but_uninitialized_map_is_not_evidence(self):
+        vw = newWorkspace()
+        fva = 0x1000
+        mapCode(vw, fva, NOP, name="code")
+        mapUninitCode(vw, fva + 1, UD2, name="bss")
+
+        vw.makeFunction(fva)
+
+        assertReturns(
+            self,
+            vw,
+            fva,
+            "an uninitialized map holds nothing this analysis may read as an instruction, exactly as codeflow treats it, even though it is executable",
+        )
