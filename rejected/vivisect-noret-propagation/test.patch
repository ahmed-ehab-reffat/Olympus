+class PredicatedTrapTest(unittest.TestCase):
+    """
+    A trap that carries a condition executes nothing at all when that condition does not
+    hold, so the instruction after it is ordinary reachable code. Disassembly has to keep
+    that successor, and the function whose other path returns through it stays
+    return-capable.
+    """
+
+    def test_a_predicated_trap_keeps_the_instruction_after_it_reachable(self):
+        vw = newUnseededArmWorkspace()
+        fVa = 0x2000
+        mapCode(vw, fVa, ARM_BKPTNE + ARM_BX_LR, name="f")
+
+        vw.makeFunction(fVa)
+
+        retVa = fVa + 4
+        loc = vw.getLocation(retVa)
+        self.assertIsNotNone(loc, "the instruction after a predicated trap is reachable and has to be disassembled")
+        self.assertEqual(loc[v_const.L_LTYPE], v_const.LOC_OP)
+        self.assertEqual(vw.parseOpcode(retVa).mnem, "bx")
+
+        self.assertEqual(vw.propagateNoReturn(), set(), "the condition may not hold, and then this function returns")
+        assertReturns(self, vw, fVa, "a trap that fires only on a condition settles only the path it fires on")
+
