+"""
+A whole-workspace analysis module that re-derives no-return status across the call graph.
+
+The per-function noret pass (vivisect.analysis.generic.noret) proves a function noreturn by
+checking whether every terminal call target is itself already proven noreturn, but it only runs
+once per function, at the point codeflow first discovers that function. Two functions cannot
+always resolve each other's status in that single pass: a caller may be examined before a callee
+whose own noreturn status is only established afterward (directly, through a chain of further
+calls, or because the caller's own call target is only identified by a later analysis pass, such
+as a resolved indirect call). This module re-examines every function whose known callers have not
+yet been marked noreturn, each time a function anywhere in the workspace becomes newly proven
+noreturn, until nothing new is learned.
+
+The index it builds uses neither the pre-built codeblock graph nor the xref database, for the
+reason noret's own docstring gives: both keep whatever codeflow decided when the function was
+decoded. Every target here is resolved by walking the instruction stream through
+vivisect.analysis.generic.noret.walkFunctionTransfers, exactly as checkFunctionNoReturn does. A
+tail-call jump is indexed the way a call is, and a dispatch under every one of its cases, since
+the case a function becomes provable through must be watched whatever the other cases resolve to.
+"""
+
+import logging
+import collections
+
+from vivisect.analysis.generic.noret import (
+    checkFunctionNoReturn,
+    walkFunctionTransfers,
+    checkFunctionIsIntrinsicNoReturn,
+)
+
+logger = logging.getLogger(__name__)
+
+
+def _intrinsicProofs(vw):
+    """
+    Yield every not-yet-marked function this workspace can prove noreturn
+    without depending on any other function's status -- one whose every terminal leaf is a
+    trap or halt that is its own proof.
+
+    The reverse-call worklist can never reach these. It walks outward from addresses already
+    known noreturn, so a function is examined only once something it calls is proven, and a
+    trap-only function calls nothing and appears in no index entry. Under the PE and ELF setups
+    that is invisible, since the per-function noret pass already examined every function as
+    codeflow discovered it; the blob, ihex and srec setups never register that pass, so a
+    re-derivation that only walked the index would derive nothing at all there.
+
+    Only fully intrinsic proofs come from here. A function proven through some OTHER function's
+    status is left to the worklist, which reaches it through whatever target it depends on --
+    and reaching it that way is what makes the derivation a propagated one rather than a leaf.
+    """
+    for fva in vw.getFunctions():
+        if vw.isNoReturnVa(fva):
+            continue
+        if checkFunctionIsIntrinsicNoReturn(vw, fva):
+            yield fva
+
+
+def _terminalCallTarget(vw, fva):
+    """
+    Yield every resolved destination of fva's own call, tail-call jump and dispatch sites,
+    walking fva's reachable instructions directly -- one address per dispatch case, since a
+    caller sitting behind one of several cases has to be re-examined as soon as that case's
+    own target is proven, whatever the others resolve to.
+    """
+    try:
+        vw.parseOpcode(fva)
+    except Exception as exc:
+        logger.warning("NoRetProp: Failed to parse entry opcode for function 0x%x: %s", fva, exc)
+        return
+
+    _, transfers, _, _, _ = walkFunctionTransfers(vw, fva, stopOnEscape=False)
+    for opva, targets, proven in transfers:
+        for target in targets:
+            yield target
+
+
+def buildReverseCallIndex(vw):
+    """
+    Map every address that some function's call or tail-call site currently resolves to,
+    back to the set of functions making that call.
+    """
+    index = collections.defaultdict(set)
+    for fva in vw.getFunctions():
+        for target in _terminalCallTarget(vw, fva):
+            index[target].add(fva)
+    return index
+
+
+def analyze(vw):
+    """
+    Re-derive noreturn status across the whole call graph until nothing new is learned.
+    Returns the set of function addresses newly marked noreturn by this call (empty if
+    nothing changed), so a caller -- propagateNoReturn or an interactive session -- can
+    tell whether the re-derivation found anything without diffing workspace state itself.
+
+    Every function this workspace can prove on its own terms is swept in before the worklist
+    runs, so the re-derivation really is workspace-wide rather than a walk outward from
+    whatever was declared already -- see _intrinsicProofs. One sweep reaches the fixed point:
+    anything provable only through one of them is indexed under it, so the worklist carries
+    every further consequence outward from there, as it does for a declared address.
+    """
+    # everything already published starts out seen, so a conclusion that was already known
+    # is never re-reported as something this call newly marked, however many routes the
+    # worklist below reaches it by
+    index = buildReverseCallIndex(vw)
+    seen = set(vw.getMeta("NoReturnApisVa", {}).keys())
+    newlyMarked = set()
+
+    for fva in _intrinsicProofs(vw):
+        logger.info("NoRetProp: Marking 0x%.8x as no return" % fva)
+        vw._markNoReturnVa(fva)
+        seen.add(fva)
+        newlyMarked.add(fva)
+
+    worklist = list(seen)
+
+    while worklist:
+        fva = worklist.pop()
+        for caller in index.get(fva, ()):
+            if caller in seen:
+                continue
+            if checkFunctionNoReturn(vw, caller):
+                logger.info("NoRetProp: Marking 0x%.8x as no return" % caller)
+                # this worklist IS the re-derivation; addNoReturnVa's own automatic
+                # propagation would recurse back into a redundant, nested full pass
+                vw._markNoReturnVa(caller)
+                seen.add(caller)
+                newlyMarked.add(caller)
+                worklist.append(caller)
+
+    return newlyMarked
