+
+        #[test]
+        fn middle_rest_with_too_few_values() {
+            check("a, mid..., z = [1, 2]\na, mid, z", tuple(&[n(1), empty_tuple(), n(2)]));
+            check("a, mid..., z = [1]\na, mid, z", tuple(&[n(1), empty_tuple(), KValue::Null]));
+        }
+
+        #[test]
+        fn unnamed_rest_at_each_position() {
+            check("a, ... = 1..=3\na", 1);
+            check("..., z = 1..=3\nz", 3);
+            check("a, ..., z = 1..=5\na, z", number_tuple(&[1, 5]));
+            check("a, ..., z = [1]\na, z", tuple(&[n(1), KValue::Null]));
+        }
+
+        #[test]
+        fn rest_captures_are_tuples_whatever_the_source() {
+            check("a, rest... = [1, 2, 3]\nrest", number_tuple(&[2, 3]));
+            check("a, rest... = 'abc'\nrest", tuple(&[s("b"), s("c")]));
+            check("a, rest... = 1..=3\nrest", number_tuple(&[2, 3]));
+            check("a, rest... = 1, 2, 3\nrest", number_tuple(&[2, 3]));
+        }
+
+        #[test]
+        fn rest_from_a_generator() {
+            let script = "\
+g = ||
+  yield 1
+  yield 2
+  yield 3
+a, rest... = g()
+a, rest";
+            check(script, tuple(&[n(1), number_tuple(&[2, 3])]));
+        }
+
+        #[test]
+        fn rest_from_an_iterator_of_unknown_length() {
+            check(
+                "a, rest... = iterator.repeat(7).take 4\na, rest",
+                tuple(&[n(7), number_tuple(&[7, 7, 7])]),
+            );
+            check(
+                "first..., y = (1..10).keep(|n| n % 3 == 0)\nfirst, y",
+                tuple(&[number_tuple(&[3, 6]), n(9)]),
