+            check("f = |(..., last)| last\nf (1, 2, 3)", 3);
+            check_fails("f = |(a, b, c)| a\nf (1, 2)");
+            check("f = |(first, others...)| others\nx = f (10, 1, 2)\n(a, b), rest... = x, 5\na, b, rest", tuple(&[n(1), n(2), number_tuple(&[5])]));
+        }
+    }
