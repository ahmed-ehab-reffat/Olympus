+mod nested_bindings {
+    use koto_bytecode::{CompilerSettings, ModuleLoader};
+    use koto_runtime::prelude::*;
+    use koto_test_utils::*;
+
+    fn check(script: &str, expected: impl Into<KValue>) {
+        check_script_output(script, expected);
+    }
+
+    fn check_fails(script: &str) {
+        let mut vm = KotoVm::default();
+        let mut loader = ModuleLoader::default();
+        let chunk = match loader.compile_script(script, None, CompilerSettings::default()) {
+            Ok(chunk) => chunk,
+            Err(error) => panic!("expected the script to compile:\n{script}\n{error}"),
+        };
+        if vm.run(chunk).is_ok() {
+            panic!("expected the script to fail:\n{script}");
+        }
+    }
+
+    fn check_compile_fails(script: &str) {
+        let mut loader = ModuleLoader::default();
+        if loader
+            .compile_script(script, None, CompilerSettings::default())
+            .is_ok()
+        {
+            panic!("expected the script to fail to compile:\n{script}");
+        }
+    }
+
+    fn n(value: i64) -> KValue {
+        KValue::from(value)
+    }
+
+    fn s(value: &str) -> KValue {
+        KValue::from(value)
+    }
+
+    fn empty_tuple() -> KValue {
+        tuple(&[])
+    }
+
+    mod assignment {
