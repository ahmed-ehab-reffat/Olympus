+
+    mod exports {
+        use super::*;
+
+        fn exported(script: &str, name: &str) -> String {
+            let mut vm = KotoVm::default();
+            let mut loader = ModuleLoader::default();
+            let settings = CompilerSettings {
+                export_top_level_ids: true,
+                ..Default::default()
+            };
+            let chunk = loader.compile_script(script, None, settings).unwrap();
+            vm.run(chunk).unwrap();
+            let value = vm.exports().get(name).unwrap_or(KValue::Null);
+            vm.value_to_string(&value).unwrap()
+        }
+
+        #[test]
+        fn nested_ids_are_exported() {
+            let script = "a, (b, c...) = 1, (2, 3, 4)";
+            assert_eq!(exported(script, "a"), "1");
+            assert_eq!(exported(script, "b"), "2");
+            assert_eq!(exported(script, "c"), "(3, 4)");
+        }
+
+        #[test]
+        fn explicit_export_of_nested_targets() {
+            let script = "export a, (b, c...) = 1, (2, 3, 4)";
+            assert_eq!(exported(script, "a"), "1");
+            assert_eq!(exported(script, "c"), "(3, 4)");
+        }
+
+        #[test]
+        fn nested_for_ids_are_exported_at_top_level() {
+            let script = "for (a, rest...), b in ([[1, 2, 3], 4],)\n  a";
+            assert_eq!(exported(script, "a"), "1");
+            assert_eq!(exported(script, "rest"), "(2, 3)");
+            assert_eq!(exported(script, "b"), "4");
+        }
+    }
