+        fn missing_nested_values_bind_null() {
+            check(
+                "a, (b, c), d = [1, [2]]\na, b, c, d",
+                tuple(&[n(1), n(2), KValue::Null, KValue::Null]),
+            );
+        }
+
+        #[test]
+        fn extra_nested_values_are_ignored() {
+            check("(a, b) = [1, 2, 3, 4]\na, b", number_tuple(&[1, 2]));
+        }
+
+        #[test]
+        fn single_parenthesised_target_unpacks_the_whole_value() {
+            check("(a, b) = 7, 8\na, b", number_tuple(&[7, 8]));
+            check("(a, b) = [7, 8]\na + b", 15);
+            check("(a, (b, c)) = [1, [2, 3]]\na, b, c", number_tuple(&[1, 2, 3]));
+        }
+
+        #[test]
+        fn map_pattern_inside_tuple() {
+            check(
+                "({x, y}, z) = [{x: 1, y: 2}, 3]\nx, y, z",
+                number_tuple(&[1, 2, 3]),
+            );
+            check(
+                "a, ({x as p, y}, q) = [1, [{x: 2, y: 3}, 4]]\na, p, y, q",
+                number_tuple(&[1, 2, 3, 4]),
+            );
+        }
+
+        #[test]
+        fn ignored_values_inside_tuple() {
+            check("a, (_, c), _ = [1, [2, 3], 4]\na, c", number_tuple(&[1, 3]));
+            check("(_first, b) = 'xy'\nb", "y");
+        }
+
+        #[test]
+        fn nested_type_hint_passes_and_throws() {
+            check("let (a: Number, b), c = [[1, 2], 3]\na, b, c", number_tuple(&[1, 2, 3]));
+            check_fails("let (a: String, b), c = [[1, 2], 3]");
+            check_fails("let a, (b, c: Bool) = [1, [2, 3]]");
+            check_fails("let a, (_: String, c) = [1, [2, 3]]");
+            check("let a, ({x: Number}, c) = [1, [{x: 2}, 3]]\na, x, c", number_tuple(&[1, 2, 3]));
+            check_fails("let a, ({x: String}, c) = [1, [{x: 2}, 3]]");
+        }
+
+        #[test]
+        fn chain_target_beside_nested_targets() {
+            check(
+                "m = {}\nm.foo, (a, b) = [1, [2, 3]]\nm.foo, a, b",
+                number_tuple(&[1, 2, 3]),
+            );
+        }
+
+        #[test]
+        fn swap_through_nested_targets_reads_old_values() {
+            check("a, b, c = 1, 2, 3\na, (b, c) = c, (a, b)\na, b, c", number_tuple(&[3, 1, 2]));
+            check("x, y = 1, 2\ny, (x, _) = x, (y, y)\nx, y", number_tuple(&[2, 1]));
+        }
+
+        #[test]
+        fn closures_capture_nested_bindings() {
+            check("a, (b, c) = 1, (2, 3)\nf = || b + c\nf()", 5);
+            check("x, rest... = 1, 2, 3\nf = || rest\nf()", number_tuple(&[2, 3]));
+        }
+
+        #[test]
+        fn nested_targets_do_not_leak_into_the_enclosing_scope_of_a_function() {
+            check("f = ||\n  (p, q), r = [[1, 2], 3]\n  p + q + r\nf()", 6);
+            check_fails("f = ||\n  (p, q), r = [[1, 2], 3]\nf()\np");
+        }
+    }
+
+    mod rest {
+        use super::*;
+
+        #[test]
+        fn trailing_rest() {
+            check("a, rest... = 1..=5\na, rest", tuple(&[n(1), number_tuple(&[2, 3, 4, 5])]));
+            check("a, b, rest... = [1, 2, 3]\nrest", number_tuple(&[3]));
+        }
+
+        #[test]
+        fn trailing_rest_can_be_empty() {
+            check("a, rest... = [1]\nrest", empty_tuple());
+            check("a, b, rest... = [1]\na, b, rest", tuple(&[n(1), KValue::Null, empty_tuple()]));
+        }
+
+        #[test]
+        fn leading_rest() {
+            check(
+                "first..., y, z = 1..=5\nfirst, y, z",
+                tuple(&[number_tuple(&[1, 2, 3]), n(4), n(5)]),
+            );
+        }
+
+        #[test]
+        fn leading_rest_with_exactly_enough_values() {
+            check("first..., y, z = 4, 5\nfirst, y, z", tuple(&[empty_tuple(), n(4), n(5)]));
+        }
+
+        #[test]
+        fn leading_rest_with_too_few_values() {
+            check("first..., y, z = [1]\nfirst, y, z", tuple(&[empty_tuple(), n(1), KValue::Null]));
+            check(
+                "first..., y, z = []\nfirst, y, z",
+                tuple(&[empty_tuple(), KValue::Null, KValue::Null]),
+            );
+        }
+
+        #[test]
+        fn middle_rest() {
+            check("a, mid..., z = 1..=5\na, mid, z", tuple(&[n(1), number_tuple(&[2, 3, 4]), n(5)]));
+            check(
+                "a, b, mid..., y, z = 1..=7\nmid, y, z",
