+            check("match [1, 2, 3]\n  (..., last) then last", 3);
+            check("first, rest... = [1, 2, 3]\nmatch rest\n  (a, ...) then a", 2);
+        }
+
+        #[test]
+        fn middle_rests_in_match_and_args_remain_errors() {
+            check_compile_fails("match [1, 2, 3]\n  (a, mid..., z) then 0");
+            check_compile_fails("f = |(a, mid..., z)| mid");
