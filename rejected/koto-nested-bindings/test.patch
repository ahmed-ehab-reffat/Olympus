+
+        #[test]
+        fn rest_over_value_pairs_from_a_map() {
+            check(
+                "first, rest... = {a: 1, b: 2, c: 3}\nfirst, rest",
+                tuple(&[
+                    tuple(&[s("a"), n(1)]),
+                    tuple(&[tuple(&[s("b"), n(2)]), tuple(&[s("c"), n(3)])]),
