+        }
+
+        #[test]
+        fn rest_inside_nested_tuples() {
+            check(
+                "a, (b, rest...) = [1, [2, 3, 4]]\na, b, rest",
+                tuple(&[n(1), n(2), number_tuple(&[3, 4])]),
