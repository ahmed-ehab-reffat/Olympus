+#![cfg(taffy_probe_vis)]
+
+use taffy::prelude::*;
+use taffy::{Layout, TaffyTree};
+
+fn layout_of(tree: &TaffyTree, node: NodeId) -> Layout {
+    *tree.layout(node).unwrap()
+}
+
+fn leaf(tree: &mut TaffyTree, width: f32, height: f32, grow: f32, visibility: Visibility) -> NodeId {
+    tree.new_leaf(Style {
+        size: Size { width: Dimension::from_length(width), height: Dimension::from_length(height) },
+        flex_grow: grow,
+        visibility,
+        ..Default::default()
+    })
+    .unwrap()
+}
+
+fn row(tree: &mut TaffyTree, width: f32, height: f32, children: &[NodeId]) -> NodeId {
+    let root = tree
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                size: Size { width: Dimension::from_length(width), height: Dimension::from_length(height) },
+                ..Default::default()
+            },
+            children,
+        )
+        .unwrap();
+    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+    root
+}
+
+#[test]
+fn collapsed_item_has_zero_main_size() {
+    let mut tree: TaffyTree<()> = TaffyTree::new();
+    let a = leaf(&mut tree, 40.0, 20.0, 0.0, Visibility::Visible);
+    let b = leaf(&mut tree, 40.0, 30.0, 0.0, Visibility::Collapse);
+    row(&mut tree, 100.0, 60.0, &[a, b]);
+    assert_eq!(layout_of(&tree, b).size.width, 0.0);
+}
+
+#[test]
+fn sibling_absorbs_collapsed_space_when_growing() {
+    let mut tree: TaffyTree<()> = TaffyTree::new();
+    let a = leaf(&mut tree, 40.0, 20.0, 1.0, Visibility::Visible);
+    let b = leaf(&mut tree, 40.0, 30.0, 0.0, Visibility::Collapse);
+    row(&mut tree, 100.0, 60.0, &[a, b]);
+    assert_eq!(layout_of(&tree, a).size.width, 100.0);
+    assert_eq!(layout_of(&tree, b).size.width, 0.0);
+}
+
+#[test]
+fn visible_sibling_layout_is_unchanged() {
+    let mut tree: TaffyTree<()> = TaffyTree::new();
+    let a = leaf(&mut tree, 40.0, 20.0, 1.0, Visibility::Visible);
+    let b = leaf(&mut tree, 40.0, 30.0, 0.0, Visibility::Visible);
+    row(&mut tree, 100.0, 60.0, &[a, b]);
+    assert_eq!(layout_of(&tree, a).size.width, 60.0);
+    assert_eq!(layout_of(&tree, b).size.width, 40.0);
+}
+
+#[test]
+fn collapsed_item_still_present_unlike_display_none() {
+    let mut tree: TaffyTree<()> = TaffyTree::new();
+    let collapsed = leaf(&mut tree, 40.0, 30.0, 0.0, Visibility::Collapse);
+    let none = tree
+        .new_leaf(Style {
+            display: Display::None,
+            size: Size { width: Dimension::from_length(40.0), height: Dimension::from_length(30.0) },
+            ..Default::default()
+        })
+        .unwrap();
+    let a = leaf(&mut tree, 40.0, 20.0, 0.0, Visibility::Visible);
+    let root = row(&mut tree, 100.0, 60.0, &[a, collapsed]);
+    let root_none = tree
+        .new_with_children(
+            Style {
+                display: Display::Flex,
+                size: Size { width: Dimension::from_length(100.0), height: Dimension::from_length(60.0) },
+                ..Default::default()
+            },
+            &[a, none],
+        )
+        .unwrap();
+    tree.compute_layout(root_none, Size::MAX_CONTENT).unwrap();
+    assert_eq!(tree.child_count(root), 2);
+    assert!(tree.layout(collapsed).is_ok());
+}
+
+#[test]
+fn collapse_in_non_flex_container_is_unchanged() {
+    let mut tree: TaffyTree<()> = TaffyTree::new();
+    let child = tree
+        .new_leaf(Style {
+            size: Size { width: Dimension::from_length(40.0), height: Dimension::from_length(30.0) },
+            visibility: Visibility::Collapse,
+            ..Default::default()
+        })
+        .unwrap();
+    let root = tree
+        .new_with_children(
+            Style {
+                display: Display::Block,
+                size: Size { width: Dimension::from_length(100.0), height: Dimension::from_length(60.0) },
+                ..Default::default()
+            },
+            &[child],
+        )
+        .unwrap();
+    tree.compute_layout(root, Size::MAX_CONTENT).unwrap();
+    assert_eq!(layout_of(&tree, child).size.width, 40.0);
+}
