+/// The visibility of a node, controlling whether it is rendered and how it participates in layout.
+/// See: <https://www.w3.org/TR/css-flexbox-1/#algo-visibility>
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+#[cfg_attr(feature = "serde", derive(Serialize, Deserialize))]
+pub enum Visibility {
+    /// The node is laid out and rendered normally
+    Visible,
+    /// The node is not rendered, but still affects layout as a collapsed flex item
+    Collapse,
+}
+
+impl Visibility {
+    /// The default visibility
+    pub const DEFAULT: Visibility = Visibility::Visible;
+}
+
+impl Default for Visibility {
+    fn default() -> Self {
+        Self::DEFAULT
+    }
+}
+
+#[cfg(feature = "parse")]
+crate::util::parse::impl_parse_for_keyword_enum!(Visibility,
+    "visible" => Visible,
+    "collapse" => Collapse,
+);
+
+impl core::fmt::Display for Visibility {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Visibility::Visible => write!(f, "VISIBLE"),
+            Visibility::Collapse => write!(f, "COLLAPSE"),
+        }
+    }
+}
