+package astisub_test
+
+import (
+	"bytes"
+	"reflect"
+	"sort"
+	"testing"
+	"time"
+
+	astisub "github.com/asticode/go-astisub"
+)
+
+func mergeCollisionString(v string) *string { return &v }
+
+func mergeCollisionItem(text string, style *astisub.Style, region *astisub.Region) *astisub.Item {
+	return &astisub.Item{StartAt: time.Second, EndAt: 2 * time.Second, Style: style, Region: region, Lines: []astisub.Line{{Items: []astisub.LineItem{{Text: text}}}}}
+}
+
+func mergeCollisionTTMLRoundTrip(t *testing.T, s *astisub.Subtitles) *astisub.Subtitles {
+	t.Helper()
+	var output bytes.Buffer
+	if err := s.WriteToTTML(&output); err != nil {
+		t.Fatal(err)
+	}
+	reopened, err := astisub.ReadFromTTML(bytes.NewReader(output.Bytes()))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return reopened
+}
+
+func mergeCollisionFont(t *testing.T, style *astisub.Style) string {
+	t.Helper()
+	if style == nil || style.InlineStyle == nil || style.InlineStyle.TTMLFontFamily == nil {
+		t.Fatalf("style has no TTML font family: %#v", style)
+	}
+	return *style.InlineStyle.TTMLFontFamily
+}
+
+func TestMergeCollisionStyleRoundTrip(t *testing.T) {
+	receiverStyle := &astisub.Style{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("receiver")}}
+	donorStyle := &astisub.Style{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("donor")}}
+	receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", receiverStyle, nil)}, Styles: map[string]*astisub.Style{"shared": receiverStyle}, Regions: map[string]*astisub.Region{}}
+	donor := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("donor", donorStyle, nil)}, Styles: map[string]*astisub.Style{"shared": donorStyle}, Regions: map[string]*astisub.Region{}}
+
+	receiver.Merge(donor)
+	reopened := mergeCollisionTTMLRoundTrip(t, receiver)
+	if got := []string{mergeCollisionFont(t, reopened.Items[0].Style), mergeCollisionFont(t, reopened.Items[1].Style)}; !reflect.DeepEqual(got, []string{"receiver", "donor"}) {
+		t.Fatalf("cue fonts = %v", got)
+	}
+}
+
+func TestMergeCollisionRegionRoundTrip(t *testing.T) {
+	receiverRegion := &astisub.Region{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLOrigin: mergeCollisionString("10% 10%")}}
+	donorRegion := &astisub.Region{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLOrigin: mergeCollisionString("60% 60%")}}
+	receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", nil, receiverRegion)}, Styles: map[string]*astisub.Style{}, Regions: map[string]*astisub.Region{"shared": receiverRegion}}
+	donor := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("donor", nil, donorRegion)}, Styles: map[string]*astisub.Style{}, Regions: map[string]*astisub.Region{"shared": donorRegion}}
+
+	receiver.Merge(donor)
+	reopened := mergeCollisionTTMLRoundTrip(t, receiver)
+	got := []string{*reopened.Items[0].Region.InlineStyle.TTMLOrigin, *reopened.Items[1].Region.InlineStyle.TTMLOrigin}
+	if !reflect.DeepEqual(got, []string{"10% 10%", "60% 60%"}) {
+		t.Fatalf("cue region origins = %v", got)
+	}
+}
+
+func TestMergeCollisionTransitiveReferences(t *testing.T) {
+	receiverParent := &astisub.Style{ID: "base", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("receiver")}}
+	receiverRegion := &astisub.Region{ID: "region", Style: receiverParent}
+	donorParent := &astisub.Style{ID: "base", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("donor")}}
+	donorChild := &astisub.Style{ID: "child", Style: donorParent}
+	donorRegion := &astisub.Region{ID: "region", Style: donorChild}
+	donorItem := mergeCollisionItem("donor", donorChild, donorRegion)
+	donorItem.Lines[0].Items = []astisub.LineItem{{Text: "styled", Style: donorParent}}
+	receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", receiverParent, receiverRegion)}, Styles: map[string]*astisub.Style{"base": receiverParent}, Regions: map[string]*astisub.Region{"region": receiverRegion}}
+	donor := &astisub.Subtitles{Items: []*astisub.Item{donorItem}, Styles: map[string]*astisub.Style{"base": donorParent, "child": donorChild}, Regions: map[string]*astisub.Region{"region": donorRegion}}
+
+	receiver.Merge(donor)
+	reopened := mergeCollisionTTMLRoundTrip(t, receiver)
+	imported := reopened.Items[1]
+	if mergeCollisionFont(t, imported.Style.Style) != "donor" || mergeCollisionFont(t, imported.Lines[0].Items[0].Style) != "donor" {
+		t.Fatal("parent or line-item style resolved to the wrong definition")
+	}
+	if imported.Region.Style == nil || imported.Region.Style.ID != imported.Style.ID {
+		t.Fatal("region style did not resolve to the imported child style")
+	}
+}
+
+func TestMergeCollisionDonorUnchanged(t *testing.T) {
+	parent := &astisub.Style{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("donor")}}
+	child := &astisub.Style{ID: "child", Style: parent}
+	region := &astisub.Region{ID: "region", Style: child}
+	item := mergeCollisionItem("donor", child, region)
+	item.Lines[0].Items[0].Style = parent
+	donor := &astisub.Subtitles{Items: []*astisub.Item{item}, Styles: map[string]*astisub.Style{"shared": parent, "child": child}, Regions: map[string]*astisub.Region{"region": region}}
+	receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", &astisub.Style{ID: "shared"}, &astisub.Region{ID: "region"})}, Styles: map[string]*astisub.Style{"shared": {ID: "shared"}}, Regions: map[string]*astisub.Region{"region": {ID: "region"}}}
+
+	var donorBefore bytes.Buffer
+	if err := donor.WriteToTTML(&donorBefore); err != nil {
+		t.Fatal(err)
+	}
+	receiver.Merge(donor)
+	var donorAfter bytes.Buffer
+	if err := donor.WriteToTTML(&donorAfter); err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(donorBefore.Bytes(), donorAfter.Bytes()) {
+		t.Fatalf("merge changed donor serialization:\nbefore: %s\nafter: %s", donorBefore.Bytes(), donorAfter.Bytes())
+	}
+	reopened := mergeCollisionTTMLRoundTrip(t, receiver)
+	if mergeCollisionFont(t, reopened.Items[1].Lines[0].Items[0].Style) != "donor" {
+		t.Fatal("donor remained unchanged but its merged cue lost the donor definition")
+	}
+}
+
+func TestMergeCollisionDeterministicAllocation(t *testing.T) {
+	merge := func(reverse bool) []string {
+		shared := &astisub.Style{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("donor")}}
+		other := &astisub.Style{ID: "other"}
+		styles := make(map[string]*astisub.Style)
+		if reverse {
+			styles["other"], styles["shared"] = other, shared
+		} else {
+			styles["shared"], styles["other"] = shared, other
+		}
+		donor := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("donor", shared, nil)}, Styles: styles, Regions: map[string]*astisub.Region{}}
+		receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", &astisub.Style{ID: "shared"}, nil)}, Styles: map[string]*astisub.Style{"shared": {ID: "shared"}, "shared_2": {ID: "shared_2"}}, Regions: map[string]*astisub.Region{}}
+		receiver.Merge(donor)
+		ids := make([]string, 0, len(receiver.Styles))
+		for id := range receiver.Styles {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		if receiver.Items[1].Style.ID == "shared" || receiver.Items[1].Style.ID == "shared_2" {
+			t.Fatalf("generated ID is not unique: %q", receiver.Items[1].Style.ID)
+		}
+		return ids
+	}
+	if a, b := merge(false), merge(true); !reflect.DeepEqual(a, b) {
+		t.Fatalf("definition IDs depend on map insertion order: %v != %v", a, b)
+	}
+}
+
+func TestMergeCollisionDeterministicRegionAllocation(t *testing.T) {
+	merge := func(reverse bool) ([]string, string) {
+		shared := &astisub.Region{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLOrigin: mergeCollisionString("60% 60%")}}
+		other := &astisub.Region{ID: "other"}
+		regions := make(map[string]*astisub.Region)
+		if reverse {
+			regions["other"], regions["shared"] = other, shared
+		} else {
+			regions["shared"], regions["other"] = shared, other
+		}
+		donor := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("donor", nil, shared)}, Styles: map[string]*astisub.Style{}, Regions: regions}
+		receiverRegion := &astisub.Region{ID: "shared", InlineStyle: &astisub.StyleAttributes{TTMLOrigin: mergeCollisionString("10% 10%")}}
+		receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", nil, receiverRegion)}, Styles: map[string]*astisub.Style{}, Regions: map[string]*astisub.Region{"shared": receiverRegion, "shared_2": {ID: "shared_2"}}}
+		receiver.Merge(donor)
+
+		ids := make([]string, 0, len(receiver.Regions))
+		for id := range receiver.Regions {
+			ids = append(ids, id)
+		}
+		sort.Strings(ids)
+		importedID := receiver.Items[1].Region.ID
+		if importedID == "shared" || importedID == "shared_2" {
+			t.Fatalf("generated region ID is not unique: %q", importedID)
+		}
+		reopened := mergeCollisionTTMLRoundTrip(t, receiver)
+		if got := *reopened.Items[1].Region.InlineStyle.TTMLOrigin; got != "60% 60%" {
+			t.Fatalf("imported cue resolved to region origin %q", got)
+		}
+		return ids, importedID
+	}
+	aIDs, aCueID := merge(false)
+	bIDs, bCueID := merge(true)
+	if !reflect.DeepEqual(aIDs, bIDs) || aCueID != bCueID {
+		t.Fatalf("region allocation depends on map insertion order: %v/%q != %v/%q", aIDs, aCueID, bIDs, bCueID)
+	}
+}
+
+func TestMergeCollisionStableOrderAndExistingBehavior(t *testing.T) {
+	receiverStyle := &astisub.Style{ID: "same"}
+	donorStyle := &astisub.Style{ID: "same", InlineStyle: &astisub.StyleAttributes{TTMLFontFamily: mergeCollisionString("different")}}
+	unreferencedReceiver := &astisub.Style{ID: "unused"}
+	unreferencedDonor := &astisub.Style{ID: "unused"}
+	receiver := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("receiver", receiverStyle, nil)}, Styles: map[string]*astisub.Style{"same": receiverStyle, "unused": unreferencedReceiver}, Regions: map[string]*astisub.Region{}}
+	donor := &astisub.Subtitles{Items: []*astisub.Item{mergeCollisionItem("donor", donorStyle, nil)}, Styles: map[string]*astisub.Style{"same": donorStyle, "unused": unreferencedDonor, "new": {ID: "new"}}, Regions: map[string]*astisub.Region{}}
+
+	receiver.Merge(donor)
+	if receiver.Items[0].String() != "receiver" || receiver.Items[1].String() != "donor" {
+		t.Fatalf("equal-time order changed: %q, %q", receiver.Items[0], receiver.Items[1])
+	}
+	if _, ok := receiver.Styles["unused"]; !ok || len(receiver.Styles) != 4 {
+		t.Fatalf("unreferenced or non-colliding definitions changed: %#v", receiver.Styles)
+	}
+}
