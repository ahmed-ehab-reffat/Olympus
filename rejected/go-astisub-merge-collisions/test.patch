+#!/usr/bin/env bash
+set -uo pipefail
+
+output_path=""
+if [[ ${1:-} == "--output_path" && -n ${2:-} ]]; then
+  output_path=$2
+  shift 2
+fi
+mode=${1:-}
+if [[ -z $output_path || ($mode != base && $mode != new) ]]; then
+  echo "usage: $0 --output_path PATH {base|new}" >&2
+  exit 2
+fi
+
+case $mode in
+  base) pattern_args=(-skip 'MergeCollision') ;;
+  new) pattern_args=(-run 'MergeCollision') ;;
+esac
+
+set +e
+go test -count=1 -json "${pattern_args[@]}" ./... | go-junit-report -parser gojson > "$output_path"
+status=${PIPESTATUS[0]}
+set -e
+exit "$status"
