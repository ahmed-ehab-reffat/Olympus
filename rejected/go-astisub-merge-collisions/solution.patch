 // Merge merges subtitles i into subtitles
 func (s *Subtitles) Merge(i *Subtitles) {
+	// Preserve the existing zero-copy path when the two namespaces do not
+	// collide. Collision handling works on a private graph so that assigning
+	// new IDs never changes the donor.
+	if subtitlesNamespacesCollide(s, i) {
+		i = i.cloneForMerge()
+		i.resolveMergeCollisions(s)
+	}
+
 	// Append items
 	s.Items = append(s.Items, i.Items...)
 	s.Order()
