@@ -0,0 +1,174 @@
+package astisub
+
+import (
+	"fmt"
+	"sort"
+)
+
+func subtitlesNamespacesCollide(receiver, donor *Subtitles) bool {
+	for _, style := range donor.Styles {
+		if style != nil {
+			if _, ok := receiver.Styles[style.ID]; ok {
+				return true
+			}
+		}
+	}
+	for _, region := range donor.Regions {
+		if region != nil {
+			if _, ok := receiver.Regions[region.ID]; ok {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func (s *Subtitles) cloneForMerge() *Subtitles {
+	clone := &Subtitles{Items: make([]*Item, 0, len(s.Items)), Metadata: s.Metadata, Regions: make(map[string]*Region, len(s.Regions)), Styles: make(map[string]*Style, len(s.Styles))}
+	styles := make(map[*Style]*Style, len(s.Styles))
+	for key, style := range s.Styles {
+		if style == nil {
+			continue
+		}
+		copy := *style
+		styles[style] = &copy
+		clone.Styles[key] = &copy
+	}
+	for original, copy := range styles {
+		if parent, ok := styles[original.Style]; ok {
+			copy.Style = parent
+		}
+	}
+	regions := make(map[*Region]*Region, len(s.Regions))
+	for key, region := range s.Regions {
+		if region == nil {
+			continue
+		}
+		copy := *region
+		if style, ok := styles[region.Style]; ok {
+			copy.Style = style
+		}
+		regions[region] = &copy
+		clone.Regions[key] = &copy
+	}
+	for _, item := range s.Items {
+		copy := *item
+		if style, ok := styles[item.Style]; ok {
+			copy.Style = style
+		}
+		if region, ok := regions[item.Region]; ok {
+			copy.Region = region
+		}
+		copy.Lines = append([]Line(nil), item.Lines...)
+		for lineIndex := range copy.Lines {
+			copy.Lines[lineIndex].Items = append([]LineItem(nil), item.Lines[lineIndex].Items...)
+			for itemIndex := range copy.Lines[lineIndex].Items {
+				lineItem := &copy.Lines[lineIndex].Items[itemIndex]
+				if style, ok := styles[lineItem.Style]; ok {
+					lineItem.Style = style
+				}
+			}
+		}
+		clone.Items = append(clone.Items, &copy)
+	}
+	return clone
+}
+
+func (s *Subtitles) resolveMergeCollisions(receiver *Subtitles) {
+	referencedStyles, referencedRegions := s.mergeReferences()
+	for _, key := range sortedStyleKeys(s.Styles) {
+		style := s.Styles[key]
+		if style == nil {
+			continue
+		}
+		if _, collision := receiver.Styles[style.ID]; !collision {
+			continue
+		}
+		delete(s.Styles, key)
+		if !referencedStyles[style] {
+			continue
+		}
+		style.ID = nextStyleID(style.ID, receiver.Styles, s.Styles)
+		s.Styles[style.ID] = style
+	}
+	for _, key := range sortedRegionKeys(s.Regions) {
+		region := s.Regions[key]
+		if region == nil {
+			continue
+		}
+		if _, collision := receiver.Regions[region.ID]; !collision {
+			continue
+		}
+		delete(s.Regions, key)
+		if !referencedRegions[region] {
+			continue
+		}
+		region.ID = nextRegionID(region.ID, receiver.Regions, s.Regions)
+		s.Regions[region.ID] = region
+	}
+}
+
+func (s *Subtitles) mergeReferences() (map[*Style]bool, map[*Region]bool) {
+	styles, regions := make(map[*Style]bool), make(map[*Region]bool)
+	for _, item := range s.Items {
+		styles[item.Style], regions[item.Region] = true, true
+		for _, line := range item.Lines {
+			for _, lineItem := range line.Items {
+				styles[lineItem.Style] = true
+			}
+		}
+	}
+	for _, region := range s.Regions {
+		if region != nil {
+			styles[region.Style] = true
+		}
+	}
+	for _, style := range s.Styles {
+		if style != nil {
+			styles[style.Style] = true
+		}
+	}
+	return styles, regions
+}
+
+func sortedStyleKeys(styles map[string]*Style) []string {
+	keys := make([]string, 0, len(styles))
+	for key := range styles {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func sortedRegionKeys(regions map[string]*Region) []string {
+	keys := make([]string, 0, len(regions))
+	for key := range regions {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+func nextStyleID(id string, receiver, donor map[string]*Style) string {
+	for suffix := 2; ; suffix++ {
+		candidate := fmt.Sprintf("%s_%d", id, suffix)
+		if _, ok := receiver[candidate]; ok {
+			continue
+		}
+		if _, ok := donor[candidate]; !ok {
+			return candidate
+		}
+	}
+}
+
+func nextRegionID(id string, receiver, donor map[string]*Region) string {
+	for suffix := 2; ; suffix++ {
+		candidate := fmt.Sprintf("%s_%d", id, suffix)
+		if _, ok := receiver[candidate]; ok {
+			continue
+		}
+		if _, ok := donor[candidate]; !ok {
+			return candidate
+		}
+	}
+}
