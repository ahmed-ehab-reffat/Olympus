+  private static commitPublication(publication: Publication) {
+    PipelineExecutor.createDestinationParents(publication);
+    const destinationExisted = fs.existsSync(publication.destination);
+    let originalMoved = false;
+    let candidateMoved = false;
+
+    try {
+      if (destinationExisted) {
+        fs.renameSync(publication.destination, publication.backup);
+        originalMoved = true;
+      }
+      fs.renameSync(publication.candidate, publication.destination);
+      candidateMoved = true;
+      if (originalMoved) {
+        fs.rmSync(publication.backup, { recursive: true, force: true });
+        originalMoved = false;
+      }
+      publication.committed = true;
+    } catch (publicationError) {
+      if (candidateMoved && fs.existsSync(publication.destination)) {
+        try {
+          fs.renameSync(publication.destination, publication.candidate);
+          candidateMoved = false;
+        } catch (rollbackError) {
+          publication.retainWorkspace = true;
+          logger.error(
+            `Could not remove failed publication ${publication.destination}: ${rollbackError}`
+          );
+        }
+      }
+      if (originalMoved && fs.existsSync(publication.backup)) {
+        try {
+          fs.renameSync(publication.backup, publication.destination);
+          originalMoved = false;
+        } catch (rollbackError) {
+          publication.retainWorkspace = true;
+          logger.error(
+            `Could not restore ${publication.destination}: ${rollbackError}`
+          );
+        }
+      }
+      throw publicationError;
+    }
