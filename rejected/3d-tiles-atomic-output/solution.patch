+  private static hasCollision(source: string, destination: string): boolean {
+    for (const name of fs.readdirSync(source)) {
+      const sourceEntry = path.join(source, name);
+      const destinationEntry = path.join(destination, name);
+      const sourceStat = fs.lstatSync(sourceEntry);
+      if (!fs.existsSync(destinationEntry)) {
+        continue;
+      }
+      const destinationStat = fs.lstatSync(destinationEntry);
+      if (sourceStat.isDirectory() && destinationStat.isDirectory()) {
+        if (PipelineExecutor.hasCollision(sourceEntry, destinationEntry)) {
+          return true;
+        }
+      } else {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  private static copyTree(
+    source: string,
+    destination: string,
+    excludedPath: string
+  ) {
+    for (const name of fs.readdirSync(source)) {
+      const sourceEntry = path.join(source, name);
+      if (path.resolve(sourceEntry) === excludedPath) {
+        continue;
+      }
+      const destinationEntry = path.join(destination, name);
+      const stat = fs.lstatSync(sourceEntry);
+      if (stat.isDirectory()) {
+        fs.mkdirSync(destinationEntry);
+        PipelineExecutor.copyTree(sourceEntry, destinationEntry, excludedPath);
+      } else if (stat.isSymbolicLink()) {
+        fs.symlinkSync(fs.readlinkSync(sourceEntry), destinationEntry);
+      } else {
+        fs.copyFileSync(sourceEntry, destinationEntry);
+      }
+    }
+  }
+
+  private static overlayTree(source: string, destination: string) {
+    for (const name of fs.readdirSync(source)) {
+      const sourceEntry = path.join(source, name);
+      const destinationEntry = path.join(destination, name);
+      const stat = fs.lstatSync(sourceEntry);
+
+      if (stat.isDirectory()) {
+        if (
+          fs.existsSync(destinationEntry) &&
+          !fs.lstatSync(destinationEntry).isDirectory()
+        ) {
+          fs.rmSync(destinationEntry, { recursive: true, force: true });
+        }
+        fs.mkdirSync(destinationEntry, { recursive: true });
+        PipelineExecutor.overlayTree(sourceEntry, destinationEntry);
+      } else {
+        if (fs.existsSync(destinationEntry)) {
+          fs.rmSync(destinationEntry, { recursive: true, force: true });
+        }
+        if (stat.isSymbolicLink()) {
+          fs.symlinkSync(fs.readlinkSync(sourceEntry), destinationEntry);
+        } else {
+          fs.copyFileSync(sourceEntry, destinationEntry);
+        }
+      }
+    }
+  }
