+
+  private static createDestinationParents(publication: Publication) {
+    const missing: string[] = [];
+    let current = path.dirname(publication.destination);
+    while (!fs.existsSync(current)) {
+      missing.push(current);
+      current = path.dirname(current);
+    }
+    if (!fs.statSync(current).isDirectory()) {
+      throw new Error(`Output parent is not a directory: ${current}`);
+    }
+    for (const directory of missing.reverse()) {
+      fs.mkdirSync(directory);
+      publication.createdParents.push(directory);
+    }
+  }
+
+  private static findNearestExistingDirectory(start: string): string {
+    let current = start;
+    while (!fs.existsSync(current) || !fs.statSync(current).isDirectory()) {
+      const parent = path.dirname(current);
+      if (parent === current) {
+        throw new Error(`Could not find a directory above ${start}`);
+      }
+      current = parent;
+    }
+    return current;
+  }
+
+  private static removeCreatedParents(createdParents: string[]) {
+    for (const directory of [...createdParents].reverse()) {
+      try {
+        fs.rmdirSync(directory);
+      } catch (error) {
+        logger.warn(`Could not remove output parent ${directory}: ${error}`);
+      }
+    }
+  }
+
+  private static tryRemovePath(
+    target: string | undefined,
+    preservePrimaryError: boolean
+  ): unknown {
+    if (!target || !fs.existsSync(target)) {
+      return undefined;
+    }
+    try {
+      fs.rmSync(target, { recursive: true, force: true });
+      return undefined;
+    } catch (error) {
+      if (preservePrimaryError) {
+        logger.warn(`Could not remove temporary path ${target}: ${error}`);
+      }
+      return error;
+    }
+  }
+
+  private static toPipelineError(error: unknown): PipelineError {
+    if (error instanceof PipelineError) {
+      return error;
+    }
+    if (error instanceof Error) {
+      return new PipelineError(error.message);
     }
+    return new PipelineError(`${error}`);
   }
