@@ -0,0 +1,199 @@
+const fs = require("fs");
+const path = require("path");
+const Jasmine = require("jasmine");
+
+function xml(value) {
+  return String(value ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&apos;");
+}
+
+function failureReport(outputPath, message) {
+  const body =
+    '<?xml version="1.0" encoding="UTF-8"?>\n' +
+    '<testsuites tests="1" failures="1" errors="0">\n' +
+    '  <testsuite name="pipeline" tests="1" failures="1" errors="0">\n' +
+    `    <testcase name="setup"><failure message="${xml(message)}"/></testcase>\n` +
+    "  </testsuite>\n" +
+    "</testsuites>\n";
+  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
+  fs.writeFileSync(outputPath, body);
+}
+
+function createReporter(outputPath) {
+  const cases = [];
+  const starts = new Map();
+  let suiteStart = Date.now();
+
+  return {
+    jasmineStarted() {
+      suiteStart = Date.now();
+    },
+    specStarted(result) {
+      starts.set(result.id, Date.now());
+    },
+    specDone(result) {
+      const started = starts.get(result.id) ?? Date.now();
+      cases.push({
+        name: result.fullName,
+        status: result.status,
+        seconds: (Date.now() - started) / 1000,
+        failures: result.failedExpectations ?? [],
+      });
+    },
+    jasmineDone(result) {
+      if (cases.length === 0) {
+        cases.push({
+          name: "suite execution",
+          status: "failed",
+          seconds: 0,
+          failures: [
+            {
+              message: result.incompleteReason || "No specifications were executed",
+              stack: "",
+            },
+          ],
+        });
+      }
+
+      const failures = cases.filter((testCase) => testCase.status === "failed").length;
+      const skipped = cases.filter((testCase) =>
+        ["disabled", "excluded", "pending"].includes(testCase.status)
+      ).length;
+      const testCases = cases
+        .map((testCase) => {
+          const details = testCase.failures
+            .map((failure) => `${failure.message ?? ""}\n${failure.stack ?? ""}`)
+            .join("\n");
+          let child = "";
+          if (testCase.status === "failed") {
+            child = `<failure message="${xml(
+              testCase.failures[0]?.message ?? "Specification failed"
+            )}">${xml(details)}</failure>`;
+          } else if (["disabled", "excluded", "pending"].includes(testCase.status)) {
+            child = "<skipped/>";
+          }
+          return `    <testcase name="${xml(testCase.name)}" time="${testCase.seconds.toFixed(
+            3
+          )}">${child}</testcase>`;
+        })
+        .join("\n");
+      const seconds = (Date.now() - suiteStart) / 1000;
+      const body =
+        '<?xml version="1.0" encoding="UTF-8"?>\n' +
+        `<testsuites tests="${cases.length}" failures="${failures}" errors="0" skipped="${skipped}" time="${seconds.toFixed(
+          3
+        )}">\n` +
+        `  <testsuite name="pipeline" tests="${cases.length}" failures="${failures}" errors="0" skipped="${skipped}" time="${seconds.toFixed(
+          3
+        )}">\n` +
+        `${testCases}\n` +
+        "  </testsuite>\n" +
+        "</testsuites>\n";
+      fs.mkdirSync(path.dirname(outputPath), { recursive: true });
+      fs.writeFileSync(outputPath, body);
+    },
+  };
+}
+
+function normalizeForcedRecursiveRemovalForBase() {
+  const originalRmSync = fs.rmSync;
+  fs.rmSync = (target, options) => {
+    const isForcedRecursiveRemoval =
+      options?.force === true && options?.recursive === true;
+    if (isForcedRecursiveRemoval && typeof target === "string") {
+      const normalizedTarget = target.replace(/[\\/]+$/, "");
+      if (normalizedTarget !== target) {
+        try {
+          if (!fs.lstatSync(normalizedTarget).isDirectory()) {
+            return originalRmSync(normalizedTarget, options);
+          }
+        } catch (error) {
+          if (error?.code !== "ENOENT") {
+            throw error;
+          }
+        }
+      }
+    }
+    try {
+      return originalRmSync(target, options);
+    } catch (error) {
+      if (
+        error?.code !== "ENOTDIR" ||
+        !isForcedRecursiveRemoval ||
+        typeof target !== "string"
+      ) {
+        throw error;
+      }
+      const normalizedTarget = target.replace(/[\\/]+$/, "");
+      if (normalizedTarget === target) {
+        throw error;
+      }
+      return originalRmSync(normalizedTarget, options);
+    }
+  };
+}
+
+function prepareBaseScratchDirectories() {
+  const scratchDirectories = [
+    "specs/data/output/gzipUngzip",
+    "specs/data/migration/output",
+    "specs/data/output/tilesetProcessing",
+    "specs/data/createTilesetJson/output",
+    "specs/data/upgradeTileset/upAxisHandling/output",
+    "specs/data/upgradeTileset/general/output",
+  ];
+  for (const scratchDirectory of scratchDirectories) {
+    const absolutePath = path.resolve(scratchDirectory);
+    fs.rmSync(absolutePath, { recursive: true, force: true });
+    fs.mkdirSync(absolutePath, { recursive: true });
+  }
+}
+
+async function main() {
+  const mode = process.argv[2];
+  const outputPath = path.resolve(process.argv[3] || "junit.xml");
+  const specFiles =
+    mode === "base"
+      ? ["./specs/**/*Spec.ts"]
+      : mode === "new"
+        ? ["./grader_tests/9f3a76d1Spec.ts"]
+        : undefined;
+  if (!specFiles) {
+    failureReport(outputPath, `Unknown test mode: ${mode}`);
+    process.exitCode = 2;
+    return;
+  }
+  if (mode === "base") {
+    normalizeForcedRecursiveRemovalForBase();
+    prepareBaseScratchDirectories();
+  }
+
+  const runner = new Jasmine({ projectBaseDir: process.cwd() });
+  runner.exitOnCompletion = false;
+  runner.loadConfig({
+    spec_dir: "",
+    spec_files: specFiles,
+    helpers: [],
+    random: false,
+    stopOnSpecFailure: false,
+    stopSpecOnExpectationFailure: false,
+  });
+  runner.addReporter(createReporter(outputPath));
+  const result = await runner.execute();
+  process.exitCode = result.overallStatus === "passed" ? 0 : 1;
+}
+
+main().catch((error) => {
+  const outputPath = path.resolve(process.argv[3] || "junit.xml");
+  try {
+    failureReport(outputPath, error?.stack || error);
+  } catch (reportError) {
+    process.stderr.write(`${reportError}\n`);
+  }
+  process.stderr.write(`${error?.stack || error}\n`);
+  process.exitCode = 1;
+});
