+const boxGlb = path.join(
+  __dirname,
+  "..",
+  "specs",
+  "data",
+  "gltf",
+  "Box.glb"
+);
+
+function tilesetObject(contentUris: string[]) {
+  return {
+    asset: { version: "1.1" },
+    geometricError: 1,
+    root: {
+      boundingVolume: {
+        box: [0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0, 1],
+      },
+      geometricError: 0,
+      contents: contentUris.map((uri) => ({ uri })),
+    },
+  };
+}
+
+function jsonBuffer(contentUris: string[]) {
+  return Buffer.from(JSON.stringify(tilesetObject(contentUris), null, 2));
+}
+
+function createInput(directory: string, lateFailure: boolean) {
+  fs.mkdirSync(directory, { recursive: true });
+  const contentUris = lateFailure
+    ? ["first.glb", "late.glb"]
+    : ["first.glb"];
+  fs.writeFileSync(path.join(directory, "tileset.json"), jsonBuffer(contentUris));
+  fs.copyFileSync(boxGlb, path.join(directory, "first.glb"));
+  fs.writeFileSync(path.join(directory, "extra.bin"), "new-extra");
+  if (lateFailure) {
+    fs.writeFileSync(path.join(directory, "late.glb"), "glTFbroken");
+  }
+}
+
+function createNestedInput(directory: string) {
+  fs.mkdirSync(path.join(directory, "nested"), { recursive: true });
+  fs.writeFileSync(
+    path.join(directory, "tileset.json"),
+    jsonBuffer(["nested/first.glb"])
+  );
+  fs.copyFileSync(boxGlb, path.join(directory, "nested", "first.glb"));
+  fs.writeFileSync(path.join(directory, "extra.bin"), "new-extra");
+}
+
+function copyStage(name: string) {
+  return TilesetStages.create(name, "Copy the tileset", []);
+}
+
+function processingStage() {
+  return TilesetStages.create("process", "Process tile contents", [
+    ContentStages.createOptimizeGlb({}),
+  ]);
+}
+
+function pipeline(
+  input: string,
+  output: string,
+  lateFailure: boolean,
+  stageCount = 1
+): Pipeline {
+  const finalStage = lateFailure
+    ? processingStage()
+    : copyStage("copy final");
+  const tilesetStages =
+    stageCount === 1 ? [finalStage] : [copyStage("copy first"), finalStage];
+  return { input, output, tilesetStages };
+}
+
+async function captureFailure(operation: Promise<void>): Promise<unknown> {
+  try {
+    await operation;
+  } catch (error) {
+    return error;
+  }
+  throw new Error("Expected the pipeline to fail");
+}
+
+function expectProcessingFailure(error: unknown) {
+  expect(error).toEqual(jasmine.any(PipelineError));
+  expect((error as Error).message.trim().length).toBeGreaterThan(0);
+}
+
+function snapshotTree(root: string): string[] {
+  if (!fs.existsSync(root)) {
+    return ["<absent>"];
+  }
+  const result: string[] = [];
+  const visit = (current: string, relative: string) => {
+    const stat = fs.lstatSync(current);
+    if (stat.isDirectory()) {
+      result.push(`d:${relative}`);
+      const children = fs.readdirSync(current).sort();
+      for (const child of children) {
+        visit(path.join(current, child), path.join(relative, child));
+      }
+      return;
+    }
+    if (stat.isFile()) {
+      const value = fs.readFileSync(current);
+      const digest = crypto.createHash("sha256").update(value).digest("hex");
+      result.push(`f:${relative}:${value.length}:${digest}`);
+      return;
+    }
+    result.push(`o:${relative}`);
+  };
+  visit(root, ".");
+  return result;
+}
+
+async function readEntries(name: string): Promise<Record<string, string>> {
+  const source = await TilesetSources.createAndOpen(name);
+  try {
+    const keys: string[] = [];
+    for await (const key of await source.getKeys()) {
+      keys.push(key);
+    }
+    keys.sort();
+    const entries: Record<string, string> = {};
+    for (const key of keys) {
+      const value = await source.getValue(key);
+      if (!value) {
+        throw new Error(`Missing value for ${key}`);
+      }
+      entries[key] = value.toString("base64");
+    }
+    return entries;
+  } finally {
+    await source.close();
+  }
+}
+
+async function expectEquivalentEntries(
+  inputName: string,
+  outputName: string,
+  outputJsonName = "tileset.json",
+  allowAdditionalEntries = false
+) {
+  const inputEntries = await readEntries(inputName);
+  const outputEntries = await readEntries(outputName);
+  const expectedOutputKeys = Object.keys(inputEntries)
+    .map((key) => (key === "tileset.json" ? outputJsonName : key))
+    .sort();
+  if (allowAdditionalEntries) {
+    for (const expectedKey of expectedOutputKeys) {
+      expect(Object.keys(outputEntries)).toContain(expectedKey);
+    }
+  } else {
+    expect(Object.keys(outputEntries).sort()).toEqual(expectedOutputKeys);
+  }
+
+  for (const [inputKey, inputValue] of Object.entries(inputEntries)) {
+    const outputKey = inputKey === "tileset.json" ? outputJsonName : inputKey;
+    const outputValue = outputEntries[outputKey];
+    if (inputKey.toLowerCase().endsWith(".json")) {
+      expect(JSON.parse(Buffer.from(outputValue, "base64").toString("utf8"))).toEqual(
+        JSON.parse(Buffer.from(inputValue, "base64").toString("utf8"))
+      );
+    } else {
+      expect(outputValue).toBe(inputValue);
+    }
+  }
+}
+
+async function writePackage(name: string, entries?: Record<string, Buffer>) {
+  const target = TilesetTargets.createFromName(name);
+  await target.begin(name, true);
+  const values =
+    entries ??
+    ({
+      "tileset.json": jsonBuffer([]),
+      "sentinel.bin": Buffer.from("original-package"),
+    } as Record<string, Buffer>);
+  for (const key of Object.keys(values)) {
+    await target.addEntry(key, values[key]);
+  }
+  await target.end();
+}
+
+async function packageFromDirectory(directory: string, name: string) {
+  const entries = await readEntries(directory);
+  const buffers: Record<string, Buffer> = {};
+  for (const key of Object.keys(entries)) {
+    buffers[key] = Buffer.from(entries[key], "base64");
+  }
+  await writePackage(name, buffers);
+}
+
+function makeSentinelDirectory(directory: string, jsonName: string) {
+  fs.mkdirSync(path.join(directory, "nested"), { recursive: true });
+  fs.writeFileSync(path.join(directory, jsonName), "original-json");
+  fs.writeFileSync(path.join(directory, "first.glb"), "original-content");
+  fs.writeFileSync(path.join(directory, "unrelated.txt"), "keep-me");
+  fs.writeFileSync(path.join(directory, "nested", "keep.bin"), "nested");
+}
+
+function makeCollisionDirectory(directory: string) {
+  fs.mkdirSync(directory, { recursive: true });
+  fs.writeFileSync(path.join(directory, "first.glb"), "collision");
+  fs.writeFileSync(path.join(directory, "unrelated.txt"), "keep-me");
+}
