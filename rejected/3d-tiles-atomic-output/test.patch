+#!/usr/bin/env bash
+set -uo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$SCRIPT_DIR"
+
+MODE=""
+OUTPUT_PATH="junit.xml"
+
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    base|new)
+      if [ -n "$MODE" ]; then
+        echo "test mode was provided more than once" >&2
+        exit 2
+      fi
+      MODE="$1"
+      shift
+      ;;
+    --output_path)
+      if [ "$#" -lt 2 ]; then
+        echo "--output_path requires a path" >&2
+        exit 2
+      fi
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    --output_path=*)
+      OUTPUT_PATH="${1#--output_path=}"
+      shift
+      ;;
+    *)
+      echo "unknown argument: $1" >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [ -z "$MODE" ]; then
+  echo "expected test mode: base or new" >&2
+  exit 2
+fi
+
+rm -f -- "$OUTPUT_PATH"
+mkdir -p -- "$(dirname "$OUTPUT_PATH")"
+
+STATUS=0
+npx --no-install tsx grader_tests/run.cjs "$MODE" "$OUTPUT_PATH" || STATUS=$?
+
+if [ ! -s "$OUTPUT_PATH" ]; then
+  MESSAGE="test execution did not produce a report"
+  printf '%s\n' \
+    '<?xml version="1.0" encoding="UTF-8"?>' \
+    '<testsuites tests="1" failures="1" errors="0">' \
+    '  <testsuite name="pipeline" tests="1" failures="1" errors="0">' \
+    "    <testcase name=\"setup\"><failure message=\"$MESSAGE\"/></testcase>" \
+    '  </testsuite>' \
+    '</testsuites>' > "$OUTPUT_PATH"
+  if [ "$STATUS" -eq 0 ]; then
+    STATUS=1
+  fi
+fi
+
+exit "$STATUS"
