+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT" || exit 1
+
+if [ "$MODE" = "new" ]; then
+  ENTRY="test/ci-938977.js"
+else
+  ENTRY="test/ci.js"
+fi
+
+if [ -z "$OUTPUT_PATH" ]; then
+  node tools/run-ts "$ROOT/node_modules/.bin/mocha" --timeout 60000 "$ENTRY"
+  exit $?
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+LOG="$(mktemp)"
+
+node tools/run-ts "$ROOT/node_modules/.bin/mocha" --timeout 60000 --reporter xunit --reporter-option output="$OUTPUT_PATH" "$ENTRY" > "$LOG" 2>&1
+EXIT_CODE=$?
+cat "$LOG"
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites name="dropflow" tests="1" failures="1" errors="0" time="0">\n'
+    printf '<testsuite name="%s" tests="1" failures="1" errors="0" time="0">\n' "$MODE"
+    printf '<testcase name="test suite loads and runs" classname="%s" time="0">\n' "$MODE"
+    printf '<failure message="the test suite did not produce results"><![CDATA['
+    sed 's/]]>/]]]]><![CDATA[>/g' "$LOG"
+    printf ']]></failure>\n</testcase>\n</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+  rm -f "$LOG"
+  exit 1
+fi
+
+FAILED="$(grep -c '<failure' "$OUTPUT_PATH" 2>/dev/null || true)"
+if [ "${FAILED:-0}" -gt 0 ]; then
+  sed -i "s/\(<testsuite [^>]*\)failures=\"[0-9]*\"\([^>]*\)errors=\"[0-9]*\"/\1failures=\"$FAILED\"\2errors=\"0\"/" "$OUTPUT_PATH"
+fi
+
+if ! head -n 2 "$OUTPUT_PATH" | grep -q '<testsuites'; then
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+    sed '1{/^<?xml/d}' "$OUTPUT_PATH"
+    printf '\n</testsuites>\n'
+  } > "$OUTPUT_PATH.wrapped"
+  mv "$OUTPUT_PATH.wrapped" "$OUTPUT_PATH"
+fi
+
+rm -f "$LOG"
+exit $EXIT_CODE
