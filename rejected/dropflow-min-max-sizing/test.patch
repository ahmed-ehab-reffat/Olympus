+  });
+
+  describe('declarations', function () {
+    it('min_width_widens_a_narrower_width', function () {
+      const root = layoutHtml('<div id="a" style="width: 50px; min-width: 100px;"></div>');
+      expect(content(root, '#a').width).to.equal(100);
+    });
+
+    it('max_width_narrows_a_wider_width', function () {
+      const root = layoutHtml('<div id="a" style="width: 200px; max-width: 100px;"></div>');
+      expect(content(root, '#a').width).to.equal(100);
+    });
+
+    it('max_width_none_is_no_constraint', function () {
+      const root = layoutHtml('<div id="a" style="width: 200px; max-width: none;"></div>');
+      expect(content(root, '#a').width).to.equal(200);
+    });
+
+    it('auto_is_not_a_valid_maximum_and_is_dropped', function () {
+      const root = layoutHtml('<div id="a" style="width: 200px; max-width: auto; height: 10px;"></div>');
+      expect(size(content(root, '#a'))).to.deep.equal([200, 10]);
+    });
+
+    it('hyperscript_min_width_and_max_height_keys', function () {
+      const root = layoutDom([
+        flow.h('div', {attrs: {id: 'a'}, style: flow.style({width: 50, minWidth: 100, height: 80, maxHeight: 30})})
+      ]);
+      expect(size(content(root, '#a'))).to.deep.equal([100, 30]);
+    });
+
+    it('hyperscript_none_and_percentage_values', function () {
