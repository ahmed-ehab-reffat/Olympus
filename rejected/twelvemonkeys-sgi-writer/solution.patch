@@ -0,0 +1,61 @@
+/*
+ * Copyright (c) 2026, Harald Kuhr
+ * All rights reserved.
+ */
+
+package com.twelvemonkeys.imageio.plugins.sgi;
+
+import com.twelvemonkeys.imageio.spi.ImageWriterSpiBase;
+
+import javax.imageio.ImageTypeSpecifier;
+import javax.imageio.ImageWriter;
+import java.awt.color.ColorSpace;
+import java.awt.image.ColorModel;
+import java.awt.image.IndexColorModel;
+import java.awt.image.SampleModel;
+import java.util.Locale;
+
+public final class SGIImageWriterSpi extends ImageWriterSpiBase {
+    public SGIImageWriterSpi() {
+        super(new SGIProviderInfo());
+    }
+
+    @Override
+    public boolean canEncodeImage(final ImageTypeSpecifier type) {
+        SampleModel sampleModel = type.getSampleModel();
+        int bands = sampleModel.getNumBands();
+        if (bands < 1 || bands > 4) {
+            return false;
+        }
+
+        int bits = sampleModel.getSampleSize(0);
+        if (bits != 8 && bits != 16) {
+            return false;
+        }
+
+        for (int band = 1; band < bands; band++) {
+            if (sampleModel.getSampleSize(band) != bits) {
+                return false;
+            }
+        }
+
+        ColorModel colorModel = type.getColorModel();
+        if (colorModel instanceof IndexColorModel || colorModel.getNumComponents() != bands) {
+            return false;
+        }
+
+        int colorType = colorModel.getColorSpace().getType();
+        return colorType == ColorSpace.TYPE_GRAY && (bands == 1 || bands == 2)
+                || colorType == ColorSpace.TYPE_RGB && (bands == 3 || bands == 4);
+    }
+
+    @Override
+    public ImageWriter createWriterInstance(final Object extension) {
+        return new SGIImageWriter(this);
+    }
+
+    @Override
+    public String getDescription(final Locale locale) {
+        return "Silicon Graphics (SGI) image writer";
+    }
+}

