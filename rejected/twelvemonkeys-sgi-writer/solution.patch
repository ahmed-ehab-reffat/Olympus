@@ -0,0 +1,96 @@
+/*
+ * Copyright (c) 2026, Harald Kuhr
+ * All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without modification,
+ * are permitted provided that the conditions in the project LICENSE are met.
+ */
+
+package com.twelvemonkeys.imageio.plugins.sgi;
+
+import java.io.ByteArrayOutputStream;
+
+final class RLEEncoder {
+    private static final int MAX_RUN = 0x7f;
+
+    private RLEEncoder() {
+    }
+
+    static byte[] encode(final byte[] row, final int bytesPerSample) {
+        if (bytesPerSample != 1 && bytesPerSample != 2) {
+            throw new IllegalArgumentException("bytesPerSample must be 1 or 2");
+        }
+        if (row.length % bytesPerSample != 0) {
+            throw new IllegalArgumentException("row length must be sample aligned");
+        }
+
+        int samples = row.length / bytesPerSample;
+        ByteArrayOutputStream output = new ByteArrayOutputStream(row.length + row.length / MAX_RUN + bytesPerSample * 2);
+        int sample = 0;
+
+        while (sample < samples) {
+            int repeated = repeatedRun(row, sample, samples, bytesPerSample);
+            if (repeated >= 3) {
+                int count = Math.min(repeated, MAX_RUN);
+                writeControl(output, count, bytesPerSample);
+                writeSample(output, row, sample, bytesPerSample);
+                sample += count;
+            }
+            else {
+                int literalStart = sample;
+                sample += repeated;
+
+                while (sample < samples && sample - literalStart < MAX_RUN) {
+                    repeated = repeatedRun(row, sample, samples, bytesPerSample);
+                    if (repeated >= 3) {
+                        break;
+                    }
+
+                    sample += Math.min(repeated, MAX_RUN - (sample - literalStart));
+                }
+
+                int count = sample - literalStart;
+                writeControl(output, 0x80 | count, bytesPerSample);
+                output.write(row, literalStart * bytesPerSample, count * bytesPerSample);
+            }
+        }
+
+        writeControl(output, 0, bytesPerSample);
+        return output.toByteArray();
+    }
+
+    private static int repeatedRun(final byte[] row, final int start, final int samples, final int bytesPerSample) {
+        int count = 1;
+
+        while (start + count < samples && sameSample(row, start, start + count, bytesPerSample)) {
+            count++;
+        }
+
+        return count;
+    }
+
+    private static boolean sameSample(final byte[] row, final int left, final int right, final int bytesPerSample) {
+        int leftOffset = left * bytesPerSample;
+        int rightOffset = right * bytesPerSample;
+
+        for (int i = 0; i < bytesPerSample; i++) {
+            if (row[leftOffset + i] != row[rightOffset + i]) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    private static void writeControl(final ByteArrayOutputStream output, final int value, final int bytesPerSample) {
+        if (bytesPerSample == 2) {
+            output.write(0);
+        }
+
+        output.write(value);
+    }
+
+    private static void writeSample(final ByteArrayOutputStream output, final byte[] row, final int sample, final int bytesPerSample) {
+        output.write(row, sample * bytesPerSample, bytesPerSample);
+    }
+}

