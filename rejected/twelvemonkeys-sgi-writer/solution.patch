+/*
+ * Copyright (c) 2026, Harald Kuhr
+ * All rights reserved.
+ */
+
+package com.twelvemonkeys.imageio.plugins.sgi;
+
+import javax.imageio.ImageWriteParam;
+import java.util.Locale;
+
+public final class SGIImageWriteParam extends ImageWriteParam {
+    public SGIImageWriteParam() {
+        this(null);
+    }
+
+    SGIImageWriteParam(final Locale locale) {
+        super(locale);
+
+        canWriteCompressed = true;
+        compressionTypes = new String[] {"None", "RLE"};
+        compressionType = "RLE";
+    }
+
+    boolean isRLE() {
+        if (getCompressionMode() == MODE_DISABLED) {
+            return false;
+        }
+
+        return getCompressionMode() != MODE_EXPLICIT || "RLE".equals(getCompressionType());
+    }
+}

diff --git a/imageio/imageio-sgi/src/main/java/com/twelvemonkeys/imageio/plugins/sgi/SGIImageWriter.java b/imageio/imageio-sgi/src/main/java/com/twelvemonkeys/imageio/plugins/sgi/SGIImageWriter.java
new file mode 100644
index 00000000..e706d15f
--- /dev/null
+++ b/imageio/imageio-sgi/src/main/java/com/twelvemonkeys/imageio/plugins/sgi/SGIImageWriter.java
@@ -0,0 +1,272 @@
+/*
+ * Copyright (c) 2026, Harald Kuhr
+ * All rights reserved.
+ */
+
+package com.twelvemonkeys.imageio.plugins.sgi;
+
+import com.twelvemonkeys.imageio.ImageWriterBase;
+
+import javax.imageio.IIOException;
+import javax.imageio.IIOImage;
+import javax.imageio.ImageTypeSpecifier;
+import javax.imageio.ImageWriteParam;
+import javax.imageio.metadata.IIOMetadata;
+import javax.imageio.spi.ImageWriterSpi;
+import java.awt.Rectangle;
+import java.awt.image.Raster;
+import java.awt.image.RenderedImage;
+import java.io.IOException;
+import java.nio.ByteOrder;
+
+public final class SGIImageWriter extends ImageWriterBase {
+    private static final int HEADER_SIZE = 512;
+    private static final long UINT_MAX = 0xffff_ffffL;
+
+    SGIImageWriter(final ImageWriterSpi provider) {
+        super(provider);
+    }
+
+    @Override
+    public ImageWriteParam getDefaultWriteParam() {
+        return new SGIImageWriteParam(getLocale());
+    }
+
+    @Override
+    public IIOMetadata getDefaultImageMetadata(final ImageTypeSpecifier imageType, final ImageWriteParam param) {
+        return null;
+    }
+
+    @Override
+    public IIOMetadata convertImageMetadata(final IIOMetadata inData, final ImageTypeSpecifier imageType, final ImageWriteParam param) {
+        return null;
+    }
+
+    @Override
+    public boolean canWriteRasters() {
+        return true;
+    }
+
+    @Override
+    public void write(final IIOMetadata streamMetadata, final IIOImage image, final ImageWriteParam param) throws IOException {
+        assertOutput();
+        if (image == null) {
+            throw new IllegalArgumentException("image == null");
+        }
+
+        Raster source = getRaster(image);
+        Selection selection = createSelection(source, param);
+        boolean rle = param == null || ((SGIImageWriteParam) param).isRLE();
+
+        imageOutput.setByteOrder(ByteOrder.BIG_ENDIAN);
+        writeHeader(selection, rle);
+
+        processImageStarted(0);
+        if (rle) {
+            writeRLE(source, selection);
+        }
+        else {
+            writeUncompressed(source, selection);
+        }
+
+        if (abortRequested()) {
+            processWriteAborted();
+        }
+        else {
+            processImageComplete();
+        }
+    }
+
+    private Raster getRaster(final IIOImage image) {
+        if (image.hasRaster()) {
+            return image.getRaster();
+        }
+
+        RenderedImage renderedImage = image.getRenderedImage();
+        if (renderedImage == null) {
+            throw new IllegalArgumentException("image has neither Raster nor RenderedImage");
+        }
+
+        return renderedImage.getData();
+    }
+
+    private Selection createSelection(final Raster source, final ImageWriteParam param) throws IIOException {
+        Rectangle region = source.getBounds();
+        int xSub = 1;
+        int ySub = 1;
+
+        if (param != null) {
+            Rectangle requested = param.getSourceRegion();
+            if (requested != null) {
+                region = region.intersection(requested);
+            }
+
+            region.x += param.getSubsamplingXOffset();
+            region.y += param.getSubsamplingYOffset();
+            region.width -= param.getSubsamplingXOffset();
+            region.height -= param.getSubsamplingYOffset();
+            xSub = param.getSourceXSubsampling();
+            ySub = param.getSourceYSubsampling();
+        }
+
+        if (region.isEmpty()) {
+            throw new IIOException("Empty source region");
+        }
+
+        int width = (region.width + xSub - 1) / xSub;
+        int height = (region.height + ySub - 1) / ySub;
+        if (width > 0xffff || height > 0xffff) {
+            throw new IIOException("SGI dimensions exceed 65535");
+        }
+
+        int[] bands = param != null ? param.getSourceBands() : null;
+        if (bands == null) {
+            bands = new int[source.getNumBands()];
+            for (int band = 0; band < bands.length; band++) {
+                bands[band] = band;
+            }
+        }
+        else {
+            bands = bands.clone();
+        }
+
+        if (bands.length < 1 || bands.length > 4) {
+            throw new IIOException("SGI requires one through four selected bands");
+        }
+
+        int bits = -1;
+        boolean[] seen = new boolean[source.getNumBands()];
+        for (int band : bands) {
+            if (band < 0 || band >= source.getNumBands() || seen[band]) {
+                throw new IIOException("Invalid or duplicate source band: " + band);
+            }
+
+            seen[band] = true;
+            int bandBits = source.getSampleModel().getSampleSize(band);
+            if (bits < 0) {
+                bits = bandBits;
+            }
+            else if (bits != bandBits) {
+                throw new IIOException("SGI requires uniform sample sizes");
+            }
+        }
+
+        if (bits != 8 && bits != 16) {
+            throw new IIOException("SGI supports 8 or 16 bits per sample");
+        }
+
+        return new Selection(region, width, height, xSub, ySub, bands, bits / 8);
+    }
+
+    private void writeHeader(final Selection selection, final boolean rle) throws IOException {
+        imageOutput.writeShort(SGI.MAGIC);
+        imageOutput.writeByte(rle ? SGI.COMPRESSION_RLE : SGI.COMPRESSION_NONE);
+        imageOutput.writeByte(selection.bytesPerSample);
+        imageOutput.writeShort(selection.bands.length == 1 ? (selection.height == 1 ? 1 : 2) : 3);
+        imageOutput.writeShort(selection.width);
+        imageOutput.writeShort(selection.height);
+        imageOutput.writeShort(selection.bands.length);
+        imageOutput.writeInt(0);
+        imageOutput.writeInt(selection.bytesPerSample == 1 ? 0xff : 0xffff);
+        imageOutput.writeInt(0);
+        imageOutput.write(new byte[80]);
+        imageOutput.writeInt(SGI.COLORMODE_NORMAL);
+        imageOutput.write(new byte[404]);
+
+        if (imageOutput.getStreamPosition() != HEADER_SIZE) {
+            throw new AssertionError("Invalid SGI header size");
+        }
+    }
+
+    private void writeUncompressed(final Raster source, final Selection selection) throws IOException {
+        byte[] row = new byte[selection.width * selection.bytesPerSample];
+        int totalRows = selection.bands.length * selection.height;
+        int completed = 0;
+
+        for (int band : selection.bands) {
+            for (int fileY = 0; fileY < selection.height; fileY++) {
+                fillRow(source, selection, band, fileY, row);
+                imageOutput.write(row);
+                processImageProgress(100f * ++completed / totalRows);
+
+                if (abortRequested()) {
+                    return;
+                }
+            }
+        }
+    }
+
+    private void writeRLE(final Raster source, final Selection selection) throws IOException {
+        int rows = selection.height * selection.bands.length;
+        long tableStart = imageOutput.getStreamPosition();
+        imageOutput.write(new byte[Math.multiplyExact(rows, 8)]);
+
+        int[] offsets = new int[rows];
+        int[] lengths = new int[rows];
+        byte[] row = new byte[selection.width * selection.bytesPerSample];
+        int rowIndex = 0;
+
+        for (int band : selection.bands) {
+            for (int fileY = 0; fileY < selection.height; fileY++) {
+                fillRow(source, selection, band, fileY, row);
+                byte[] encoded = RLEEncoder.encode(row, selection.bytesPerSample);
+                long position = imageOutput.getStreamPosition();
+                if (position > UINT_MAX || encoded.length > UINT_MAX - position) {
+                    throw new IIOException("SGI RLE offset exceeds unsigned 32-bit range");
+                }
+
+                offsets[rowIndex] = (int) position;
+                lengths[rowIndex] = encoded.length;
+                imageOutput.write(encoded);
+                processImageProgress(100f * ++rowIndex / rows);
+
+                if (abortRequested()) {
+                    return;
+                }
+            }
+        }
+
+        long end = imageOutput.getStreamPosition();
+        imageOutput.seek(tableStart);
+        imageOutput.writeInts(offsets, 0, offsets.length);
+        imageOutput.writeInts(lengths, 0, lengths.length);
+        imageOutput.seek(end);
+    }
+
+    private void fillRow(final Raster source, final Selection selection, final int band, final int fileY, final byte[] row) {
+        int outputY = selection.height - 1 - fileY;
+        int sourceY = selection.region.y + outputY * selection.ySub;
+        int position = 0;
+
+        for (int outputX = 0; outputX < selection.width; outputX++) {
+            int sourceX = selection.region.x + outputX * selection.xSub;
+            int sample = source.getSample(sourceX, sourceY, band);
+
+            if (selection.bytesPerSample == 2) {
+                row[position++] = (byte) (sample >>> 8);
+            }
+            row[position++] = (byte) sample;
+        }
+    }
+
+    private static final class Selection {
+        final Rectangle region;
+        final int width;
+        final int height;
+        final int xSub;
+        final int ySub;
+        final int[] bands;
+        final int bytesPerSample;
+
+        Selection(final Rectangle region, final int width, final int height, final int xSub, final int ySub,
+                  final int[] bands, final int bytesPerSample) {
+            this.region = region;
+            this.width = width;
+            this.height = height;
+            this.xSub = xSub;
+            this.ySub = ySub;
+            this.bands = bands;
+            this.bytesPerSample = bytesPerSample;
+        }
+    }
+}

