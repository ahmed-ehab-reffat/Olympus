+#!/usr/bin/env bash
+
+set -u
+
+output_path=""
+mode=""
+
+while [[ $# -gt 0 ]]; do
+    case "$1" in
+        --output_path)
+            [[ $# -ge 2 ]] || { echo "--output_path requires a path" >&2; exit 2; }
+            output_path="$2"
+            shift 2
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            echo "usage: $0 --output_path PATH {base|new}" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ -z "$output_path" || -z "$mode" ]]; then
+    echo "usage: $0 --output_path PATH {base|new}" >&2
+    exit 2
+fi
+
+output_path="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$output_path")"
+report_dir="imageio/imageio-sgi/target/surefire-reports"
+rm -rf "$report_dir"
+
+if [[ "$mode" == "base" ]]; then
+    tests="SGIImageReaderTest,SGIProviderInfoTest"
+else
+    staged_test="imageio/imageio-sgi/src/test/java/com/twelvemonkeys/imageio/plugins/sgi/SGIImageWriterTest.java"
+    hidden_test="imageio/imageio-sgi/src/new-test/java/com/twelvemonkeys/imageio/plugins/sgi/SGIImageWriterTest.java"
+    mkdir -p "$(dirname "$staged_test")"
+    cp "$hidden_test" "$staged_test"
+    trap 'rm -f "$staged_test"' EXIT
+    tests="SGIImageWriterTest"
+fi
+
+status=0
+mvn -o -pl imageio/imageio-sgi -am test -DskipITs -Dtest="$tests" -Dsurefire.failIfNoSpecifiedTests=false || status=$?
+
+python3 - "$report_dir" "$output_path" "$mode" "$status" <<'PY'
+import glob
+import os
+import sys
+import xml.etree.ElementTree as ET
+
+report_dir, output_path, mode, status = sys.argv[1:]
+root = ET.Element("testsuites", name=f"sgi-{mode}")
+for path in sorted(glob.glob(os.path.join(report_dir, "TEST-*.xml"))):
+    suite = ET.parse(path).getroot()
+    if suite.tag == "testsuite":
+        root.append(suite)
+    else:
+        root.extend(suite.findall("testsuite"))
+
+if not list(root):
+    suite = ET.SubElement(root, "testsuite", name="test-harness", tests="1", failures="1")
+    case = ET.SubElement(suite, "testcase", name="maven-test-run")
+    failure = ET.SubElement(case, "failure", message=f"Maven exited with status {status} without producing Surefire XML")
+    failure.text = "The selected test lane did not produce a report."
+
+os.makedirs(os.path.dirname(output_path) or ".", exist_ok=True)
+ET.ElementTree(root).write(output_path, encoding="utf-8", xml_declaration=True)
+PY
+
+exit "$status"
