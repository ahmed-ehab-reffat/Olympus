+
+package com.twelvemonkeys.imageio.plugins.sgi;
+
+import com.twelvemonkeys.imageio.util.ImageWriterAbstractTest;
+
+import javax.imageio.IIOImage;
+import javax.imageio.ImageIO;
+import javax.imageio.ImageTypeSpecifier;
+import javax.imageio.ImageWriteParam;
+import javax.imageio.spi.IIORegistry;
+import javax.imageio.spi.ImageWriterSpi;
+import javax.imageio.stream.ImageInputStream;
+import javax.imageio.stream.ImageOutputStream;
+import java.awt.Point;
+import java.awt.Rectangle;
+import java.awt.color.ColorSpace;
+import java.awt.image.BufferedImage;
+import java.awt.image.DataBuffer;
+import java.awt.image.Raster;
+import java.awt.image.RenderedImage;
+import java.awt.image.WritableRaster;
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Arrays;
+import java.util.Iterator;
+import java.util.List;
+
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+public class SGIImageWriterTest extends ImageWriterAbstractTest<SGIImageWriter> {
+    @Override
+    protected ImageWriterSpi createProvider() {
+        return new SGIImageWriterSpi();
+    }
+
+    @Override
+    protected List<? extends RenderedImage> getTestData() {
+        return Arrays.asList(
+                new BufferedImage(19, 11, BufferedImage.TYPE_BYTE_GRAY),
+                new BufferedImage(19, 11, BufferedImage.TYPE_3BYTE_BGR),
+                new BufferedImage(19, 11, BufferedImage.TYPE_4BYTE_ABGR),
+                new BufferedImage(19, 11, BufferedImage.TYPE_USHORT_GRAY)
+        );
+    }
+
+    @Test
+    public void testDefaultParamIsSGI() throws IOException {
+        SGIImageWriter writer = createWriter();
+        assertInstanceOf(SGIImageWriteParam.class, writer.getDefaultWriteParam());
+        writer.dispose();
+    }
+
+    @Test
+    public void testProviderDiscovery() {
+        IIORegistry.getDefaultInstance().registerApplicationClasspathSpis();
+        Iterator<javax.imageio.ImageWriter> writers = ImageIO.getImageWritersByFormatName("SGI");
+
+        assertTrue(writers.hasNext());
+        assertInstanceOf(SGIImageWriter.class, writers.next());
+    }
+
+    @Test
+    public void testUncompressedHeaderAndPlanarBottomUpLayout() throws IOException {
+        WritableRaster raster = Raster.createBandedRaster(DataBuffer.TYPE_BYTE, 3, 2, 3, new Point());
+        for (int band = 0; band < 3; band++) {
+            for (int y = 0; y < 2; y++) {
+                for (int x = 0; x < 3; x++) {
+                    raster.setSample(x, y, band, 40 * band + 10 * y + x);
+                }
+            }
+        }
+
+        SGIImageWriteParam param = new SGIImageWriteParam();
+        param.setCompressionMode(ImageWriteParam.MODE_DISABLED);
+        byte[] data = write(new IIOImage(raster, null, null), param);
+
+        try (DataInputStream input = new DataInputStream(new ByteArrayInputStream(data))) {
+            assertEquals(474, input.readUnsignedShort());
+            assertEquals(0, input.readUnsignedByte());
+            assertEquals(1, input.readUnsignedByte());
+            assertEquals(3, input.readUnsignedShort());
+            assertEquals(3, input.readUnsignedShort());
+            assertEquals(2, input.readUnsignedShort());
+            assertEquals(3, input.readUnsignedShort());
+            assertEquals(0, input.readInt());
+            assertEquals(255, input.readInt());
+        }
+
+        assertArrayEquals(new byte[] {
+                10, 11, 12, 0, 1, 2,
+                50, 51, 52, 40, 41, 42,
+                90, 91, 92, 80, 81, 82
+        }, Arrays.copyOfRange(data, 512, data.length));
+    }
+
+    @Test
+    public void testRLE8BitTablesAndPacketBoundaries() throws IOException {
+        WritableRaster raster = Raster.createBandedRaster(DataBuffer.TYPE_BYTE, 300, 1, 1, new Point());
+        byte[] expected = new byte[300];
+        for (int x = 0; x < expected.length; x++) {
+            expected[x] = (byte) (x < 140 ? 17 : x);
+            raster.setSample(x, 0, 0, expected[x] & 0xff);
+        }
+
+        byte[] data = write(new IIOImage(raster, null, null), new SGIImageWriteParam());
+        ByteBuffer input = ByteBuffer.wrap(data).order(ByteOrder.BIG_ENDIAN);
+        assertEquals(1, input.get(2));
+        assertEquals(1, input.get(3));
+
+        int offset = input.getInt(512);
+        int length = input.getInt(516);
+        assertTrue(offset >= 520);
+        assertTrue(length > 0);
+        assertTrue(offset + length <= data.length);
+        assertArrayEquals(expected, decodeRLE(data, offset, length, 1, expected.length));
+    }
+
+    @Test
+    public void testRLE16BitUsesTwoByteAtomsAndRoundTrips() throws IOException {
+        WritableRaster raster = Raster.createBandedRaster(DataBuffer.TYPE_USHORT, 140, 2, 1, new Point());
+        for (int y = 0; y < 2; y++) {
+            for (int x = 0; x < 140; x++) {
+                raster.setSample(x, y, 0, x < 132 ? 0x1234 + y : 0x8000 + x + y);
+            }
+        }
+
+        byte[] data = write(new IIOImage(raster, null, null), new SGIImageWriteParam());
+        ByteBuffer input = ByteBuffer.wrap(data).order(ByteOrder.BIG_ENDIAN);
+        assertEquals(2, input.get(3));
+
+        for (int row = 0; row < 2; row++) {
+            int offset = input.getInt(512 + row * 4);
+            int length = input.getInt(512 + 8 + row * 4);
+            assertEquals(0, data[offset] & 0xff, "16-bit RLE control atoms are two bytes");
+
+            byte[] decoded = decodeRLE(data, offset, length, 2, 140);
+            ByteBuffer samples = ByteBuffer.wrap(decoded).order(ByteOrder.BIG_ENDIAN);
+            int sourceY = 1 - row;
+            for (int x = 0; x < 140; x++) {
+                assertEquals(raster.getSample(x, sourceY, 0), samples.getShort() & 0xffff);
+            }
+        }
+
+        SGIImageReader reader = new SGIImageReader(new SGIImageReaderSpi());
+        try (ImageInputStream stream = ImageIO.createImageInputStream(new ByteArrayInputStream(data))) {
+            reader.setInput(stream);
+            BufferedImage result = reader.read(0);
+            for (int y = 0; y < 2; y++) {
+                for (int x = 0; x < 140; x++) {
+                    assertEquals(raster.getSample(x, y, 0), result.getRaster().getSample(x, y, 0));
+                }
+            }
+        }
+        finally {
+            reader.dispose();
+        }
+    }
+
+    @Test
+    public void testAllChannelCountsAndSampleWidthsRoundTrip() throws IOException {
+        for (int dataType : new int[] {DataBuffer.TYPE_BYTE, DataBuffer.TYPE_USHORT}) {
+            for (int bands = 1; bands <= 4; bands++) {
+                int[] bankIndices = new int[bands];
+                int[] bandOffsets = new int[bands];
+                for (int band = 0; band < bands; band++) {
+                    bankIndices[band] = band;
+                }
+
+                ColorSpace colorSpace = ColorSpace.getInstance(bands < 3 ? ColorSpace.CS_GRAY : ColorSpace.CS_sRGB);
+                ImageTypeSpecifier type = ImageTypeSpecifier.createBanded(
+                        colorSpace, bankIndices, bandOffsets, dataType, bands == 2 || bands == 4, false
+                );
+                assertTrue(createProvider().canEncodeImage(type));
+
+                BufferedImage source = type.createBufferedImage(7, 3);
+                for (int band = 0; band < bands; band++) {
+                    for (int y = 0; y < source.getHeight(); y++) {
+                        for (int x = 0; x < source.getWidth(); x++) {
+                            int value = band * 10000 + y * 100 + x;
+                            source.getRaster().setSample(x, y, band, dataType == DataBuffer.TYPE_BYTE ? value & 0xff : value);
+                        }
+                    }
+                }
+
+                byte[] data = write(new IIOImage(source, null, null), new SGIImageWriteParam());
+                assertEquals(dataType == DataBuffer.TYPE_BYTE ? 1 : 2, data[3]);
+                assertEquals(bands, ByteBuffer.wrap(data).order(ByteOrder.BIG_ENDIAN).getShort(10));
+
+                SGIImageReader reader = new SGIImageReader(new SGIImageReaderSpi());
+                try (ImageInputStream input = ImageIO.createImageInputStream(new ByteArrayInputStream(data))) {
+                    reader.setInput(input);
+                    Raster result = reader.read(0).getRaster();
+                    for (int band = 0; band < bands; band++) {
+                        for (int y = 0; y < source.getHeight(); y++) {
+                            for (int x = 0; x < source.getWidth(); x++) {
+                                assertEquals(source.getRaster().getSample(x, y, band), result.getSample(x, y, band));
+                            }
+                        }
+                    }
+                }
+                finally {
+                    reader.dispose();
+                }
+            }
+        }
+    }
+
+    @Test
+    public void testRasterRegionSubsamplingOffsetsAndBandOrder() throws IOException {
+        WritableRaster raster = Raster.createBandedRaster(DataBuffer.TYPE_BYTE, 9, 7, 4, new Point(10, 20));
+        for (int band = 0; band < 4; band++) {
+            for (int y = raster.getMinY(); y < raster.getMinY() + raster.getHeight(); y++) {
+                for (int x = raster.getMinX(); x < raster.getMinX() + raster.getWidth(); x++) {
+                    raster.setSample(x, y, band, band * 50 + (y - 20) * 9 + x - 10);
+                }
+            }
+        }
+
+        SGIImageWriteParam param = new SGIImageWriteParam();
+        param.setCompressionMode(ImageWriteParam.MODE_DISABLED);
+        param.setSourceRegion(new Rectangle(11, 21, 7, 5));
+        param.setSourceSubsampling(2, 3, 1, 1);
+        param.setSourceBands(new int[] {3, 1});
+
+        byte[] data = write(new IIOImage(raster, null, null), param);
+        ByteBuffer input = ByteBuffer.wrap(data).order(ByteOrder.BIG_ENDIAN);
+        assertEquals(3, input.getShort(6) & 0xffff);
+        assertEquals(2, input.getShort(8) & 0xffff);
+        assertEquals(2, input.getShort(10) & 0xffff);
+        assertArrayEquals(new byte[] {
+                (byte) 197, (byte) 199, (byte) 201,
+                (byte) 170, (byte) 172, (byte) 174,
+                97, 99, 101,
+                70, 72, 74
+        }, Arrays.copyOfRange(data, 512, data.length));
+    }
+
+    private byte[] write(final IIOImage image, final ImageWriteParam param) throws IOException {
+        SGIImageWriter writer = createWriter();
+        ByteArrayOutputStream buffer = new ByteArrayOutputStream();
+
+        try (ImageOutputStream output = ImageIO.createImageOutputStream(buffer)) {
+            writer.setOutput(output);
+            writer.write(null, image, param);
+        }
+        finally {
+            writer.dispose();
+        }
+
+        return buffer.toByteArray();
+    }
+
+    private static byte[] decodeRLE(final byte[] data, final int offset, final int length,
+                                    final int bytesPerSample, final int sampleCount) throws IOException {
+        DataInputStream input = new DataInputStream(new ByteArrayInputStream(data, offset, length));
+        ByteArrayOutputStream decoded = new ByteArrayOutputStream(sampleCount * bytesPerSample);
+
+        while (true) {
+            int control = input.readUnsignedByte();
+            if (bytesPerSample == 2) {
+                assertEquals(0, control, "16-bit control atom high byte");
+                control = input.readUnsignedByte();
+            }
+
+            int count = control & 0x7f;
+            if (count == 0) {
+                break;
+            }
+
+            if ((control & 0x80) != 0) {
+                for (int index = 0; index < count * bytesPerSample; index++) {
+                    decoded.write(input.readUnsignedByte());
+                }
+            }
+            else {
+                byte[] sample = new byte[bytesPerSample];
+                input.readFully(sample);
+                for (int index = 0; index < count; index++) {
+                    decoded.write(sample);
+                }
+            }
+        }
+
+        byte[] result = decoded.toByteArray();
+        assertEquals(sampleCount * bytesPerSample, result.length);
+        return result;
+    }
+}

