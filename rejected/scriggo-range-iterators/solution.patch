diff --git a/internal/compiler/emitter_statements.go b/internal/compiler/emitter_statements.go
index 648f3538..f5d33898 100644
--- a/internal/compiler/emitter_statements.go
+++ b/internal/compiler/emitter_statements.go
@@ -1041,6 +1041,11 @@ func (em *emitter) emitTypeSwitch(node *ast.TypeSwitch) {
 // emitForRange emits a for range statement.
 func (em *emitter) emitForRange(node *ast.ForRange) {
 
+	if k := em.typ(node.Assignment.Rhs[0]).Kind(); reflect.Int <= k && k <= reflect.Uintptr {
+		em.emitForRangeInt(node)
