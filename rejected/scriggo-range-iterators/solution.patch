 	inForRange := em.inForRange
 	em.inForRange = true
 
@@ -1132,3 +1137,102 @@ func (em *emitter) emitForRange(node *ast.ForRange) {
 	}
 
 }
+
+// emitForRangeInt emits the code for a for-range statement whose range
+// expression is an integer.
+func (em *emitter) emitForRangeInt(node *ast.ForRange) {
+
+	vars := node.Assignment.Lhs
+	expr := node.Assignment.Rhs[0]
+	exprType := em.typ(expr)
+	kind := exprType.Kind()
+	pos := node.Pos()
+
+	currentBreakable := em.breakable
+	currentBreakLabel := em.breakLabel
+	em.breakable = true
+	em.breakLabel = nil
+
+	em.fb.enterScope()
+
+	// The range expression is evaluated once, so snapshot it into a
+	// dedicated register that the loop condition reads.
+	nReg := em.fb.newRegister(kind)
+	em.fb.emitMove(false, em.emitExpr(expr, exprType), nReg, kind)
+
+	// The counter drives the iteration and is kept separate from the range
+	// variable, so the range variable retains its last value (n-1) after
+	// the loop rather than n.
+	counter := em.fb.newRegister(kind)
+
+	var index, indirectIndex int8
+	hasVar := len(vars) >= 1 && !isBlankIdentifier(vars[0])
+	if hasVar {
+		name := vars[0].(*ast.Identifier).Name
+		if node.Assignment.Type == ast.AssignmentDeclaration {
+			index = em.fb.newRegister(kind)
+			if em.varStore.mustBeDeclaredAsIndirect(vars[0].(*ast.Identifier)) {
+				indirectIndex = em.fb.newIndirectRegister()
+				em.fb.emitNew(exprType, -indirectIndex)
+				em.fb.bindVarReg(name, indirectIndex)
+			} else {
+				em.fb.bindVarReg(name, index)
+			}
+		} else {
+			index = em.fb.scopeLookup(name)
+		}
+	}
+
+	cond := runtime.ConditionLess
+	switch kind {
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		cond = runtime.ConditionLessU
+	}
+
+	em.fb.emitMove(true, 0, counter, kind)
+
+	endForLabel := em.fb.newLabel()
+	var elseLabel label
+	if node.Else != nil {
+		elseLabel = em.fb.newLabel()
+		em.fb.emitIf(false, counter, cond, nReg, kind, pos)
+		em.fb.emitGoto(elseLabel)
+	}
+
+	forHead := em.fb.newLabel()
+	forPost := em.fb.newLabel()
+	em.fb.setLabelAddr(forHead)
+	em.fb.emitIf(false, counter, cond, nReg, kind, pos)
+	em.fb.emitGoto(endForLabel)
+
+	em.fb.enterScope()
+	if hasVar {
+		em.fb.emitMove(false, counter, index, kind)
+		if indirectIndex != 0 {
+			em.changeRegister(false, index, indirectIndex, exprType, exprType)
+		}
+	}
+	em.rangeLabels = append(em.rangeLabels, forPost)
+	em.emitNodes(node.Body)
+	em.rangeLabels = em.rangeLabels[:len(em.rangeLabels)-1]
+	em.fb.setLabelAddr(forPost)
+	em.fb.emitAdd(true, counter, 1, counter, kind)
+	em.fb.emitGoto(forHead)
+	em.fb.exitScope()
+
+	if node.Else != nil {
+		em.fb.setLabelAddr(elseLabel)
+		em.fb.enterScope()
+		em.emitNodes(node.Else.Nodes)
+		em.fb.exitScope()
+	}
+
+	em.fb.setLabelAddr(endForLabel)
+	em.fb.exitScope()
+
+	if em.breakLabel != nil {
+		em.fb.setLabelAddr(*em.breakLabel)
+	}
+	em.breakable = currentBreakable
+	em.breakLabel = currentBreakLabel
+}
