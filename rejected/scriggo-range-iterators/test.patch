+//go:build scriggo_range_int_63a672
+
+package scriggo_test
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"github.com/open2b/scriggo"
+)
+
+func runRangeIntProgram(t *testing.T, body string) (string, error) {
+	t.Helper()
+	var sb strings.Builder
+	src := "package main\n\nfunc main() {\n" + body + "\n}\n"
+	prog, err := scriggo.Build(scriggo.Files{"main.go": []byte(src)}, nil)
+	if err != nil {
+		return "", err
+	}
+	err = prog.Run(&scriggo.RunOptions{Print: func(v any) {
+		switch x := v.(type) {
+		case int:
+			sb.WriteString(strconv.Itoa(x))
+		case int8:
+			sb.WriteString(strconv.Itoa(int(x)))
+		case int16:
+			sb.WriteString(strconv.Itoa(int(x)))
+		case int32:
+			sb.WriteString(strconv.Itoa(int(x)))
+		case int64:
+			sb.WriteString(strconv.FormatInt(x, 10))
+		case uint:
+			sb.WriteString(strconv.FormatUint(uint64(x), 10))
+		case uint8:
+			sb.WriteString(strconv.FormatUint(uint64(x), 10))
+		case uint32:
+			sb.WriteString(strconv.FormatUint(uint64(x), 10))
+		default:
+			sb.WriteString("?")
+		}
+		sb.WriteString(",")
+	}})
+	return sb.String(), err
+}
+
+func runRangeIntTemplate(t *testing.T, src string) (string, error) {
+	t.Helper()
+	var sb strings.Builder
+	tp, err := scriggo.BuildTemplate(scriggo.Files{"index.txt": []byte(src)}, "index.txt", nil)
+	if err != nil {
+		return "", err
+	}
+	err = tp.Run(&sb, nil, nil)
+	return sb.String(), err
+}
+
+func TestRangeOverIntProgram(t *testing.T) {
+	cases := []struct {
+		name string
+		body string
+		want string
+	}{
+		{"basic_sequence", `for i := range 3 { print(i) }`, "0,1,2,"},
+		{"no_variable_runs_n_times", `n := 0; for range 4 { n++ }; print(n)`, "4,"},
+		{"zero_runs_no_iterations", `for i := range 0 { print(i) }; print(9)`, "9,"},
+		{"negative_runs_no_iterations", `for i := range -3 { print(i) }; print(9)`, "9,"},
+		{"break_stops", `for i := range 10 { if i == 2 { break }; print(i) }`, "0,1,"},
+		{"continue_skips", `for i := range 4 { if i == 1 { continue }; print(i) }`, "0,2,3,"},
+		{"typed_int32", `var n int32 = 3; for i := range n { print(i) }`, "0,1,2,"},
+		{"typed_uint", `var n uint = 2; for i := range n { print(i) }`, "0,1,"},
+		{"non_constant_expression", `n := 2; for i := range n + 1 { print(i) }`, "0,1,2,"},
+		{"evaluated_once", `n := 3; for i := range n { n = 0; print(i) }`, "0,1,2,"},
+		{"nested", `for i := range 2 { for j := range 2 { print(i); print(j) } }`, "0,0,0,1,1,0,1,1,"},
+		{"assignment_not_declaration", `i := 0; for i = range 3 { print(i) }; print(i)`, "0,1,2,2,"},
+	}
+	for _, c := range cases {
+		out, err := runRangeIntProgram(t, c.body)
+		if err != nil {
+			t.Errorf("%s: unexpected error: %v", c.name, err)
+			continue
+		}
+		if out != c.want {
+			t.Errorf("%s: got %q want %q", c.name, out, c.want)
+		}
+	}
+}
+
+func TestRangeOverIntTemplate(t *testing.T) {
+	out, err := runRangeIntTemplate(t, `{% for i := range 3 %}{{ i }}{% end %}`)
+	if err != nil {
+		t.Fatalf("basic: unexpected error: %v", err)
+	}
+	if out != "012" {
+		t.Fatalf("basic: got %q want %q", out, "012")
+	}
+
+	out, err = runRangeIntTemplate(t, `{% for range 0 %}x{% else %}empty{% end %}`)
+	if err != nil {
+		t.Fatalf("else: unexpected error: %v", err)
+	}
+	if out != "empty" {
+		t.Fatalf("else: got %q want %q", out, "empty")
+	}
+
+	out, err = runRangeIntTemplate(t, `{% for i := range 2 %}{{ i }}{% else %}z{% end %}`)
+	if err != nil {
+		t.Fatalf("nonempty_else: unexpected error: %v", err)
+	}
+	if out != "01" {
+		t.Fatalf("nonempty_else: got %q want %q", out, "01")
+	}
+}
+
+func TestRangeOverIntErrors(t *testing.T) {
+	twoVars := "package main\nfunc main() {\nfor i, j := range 3 { _ = i; _ = j }\n}\n"
+	if _, err := scriggo.Build(scriggo.Files{"main.go": []byte(twoVars)}, nil); err == nil {
+		t.Fatal("two range variables should be rejected")
+	} else if !strings.Contains(err.Error(), "range") {
+		t.Fatalf("two variables: unexpected error %q", err.Error())
+	}
+
+	floatRange := "package main\nfunc main() {\nfor range 3.5 {}\n}\n"
+	if _, err := scriggo.Build(scriggo.Files{"main.go": []byte(floatRange)}, nil); err == nil {
+		t.Fatal("ranging over a float should be rejected")
+	} else if !strings.Contains(err.Error(), "range") {
+		t.Fatalf("float: unexpected error %q", err.Error())
+	}
+}
