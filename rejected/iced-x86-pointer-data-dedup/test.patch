+#[test]
+fn different_relocated_instruction_targets_do_not_share() {
+	#[rustfmt::skip]
+	let data_a = [
+		0xB0, 0x00, 0xE9, 0xF9, 0x2F, 0x00, 0x00, 0xB0, 0x01, 0xE9, 0xF3, 0x2F,
+		0x00, 0x00, 0xB0, 0x02,
+	];
+	let data_b = [0x90u8, 0x90u8]; // two nops, original addresses 0x5000 and 0x5001
+	let orig_instrs_a = decode(64, 0x2000, &data_a, DECODER_OPTIONS);
+	let orig_instrs_b = decode(64, 0x5000, &data_b, DECODER_OPTIONS);
+	let block_a = InstructionBlock::new(&orig_instrs_a, 0x8000_0000_0000_0000);
+	let block_b = InstructionBlock::new(&orig_instrs_b, 0x1000);
+	const OPTIONS: u32 = BlockEncoderOptions::RETURN_RELOC_INFOS;
+	let results = BlockEncoder::encode_slice(64, &[block_a, block_b], OPTIONS).unwrap();
+	let result_a = results.iter().find(|r| r.rip == 0x8000_0000_0000_0000).unwrap();
+
+	// Two branches with two DIFFERENT relocated-instruction targets must never be merged into one slot.
+	assert_eq!(result_a.reloc_infos.len(), 2);
+	assert_eq!(
+		sort(result_a.reloc_infos.clone()),
+		sort(vec![
+			RelocInfo::new(RelocKind::Offset64, 0x8000_0000_0000_0018),
+			RelocInfo::new(RelocKind::Offset64, 0x8000_0000_0000_0020),
+		])
+	);
+}
