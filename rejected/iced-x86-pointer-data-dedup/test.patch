+#[test]
+fn same_relocated_instruction_target_two_sharers_share_one_slot() {
+	#[rustfmt::skip]
+	let data_a = [
+		0xB0, 0x00, 0xE9, 0xF9, 0x2F, 0x00, 0x00, 0xB0, 0x01, 0xE9, 0xF2, 0x2F,
+		0x00, 0x00, 0xB0, 0x02,
+	];
+	let data_b = [0x90u8]; // nop, original address 0x5000
+	let orig_instrs_a = decode(64, 0x2000, &data_a, DECODER_OPTIONS);
+	let orig_instrs_b = decode(64, 0x5000, &data_b, DECODER_OPTIONS);
+	let block_a = InstructionBlock::new(&orig_instrs_a, 0x8000_0000_0000_0000);
+	let block_b = InstructionBlock::new(&orig_instrs_b, 0x1000);
+	const OPTIONS: u32 = BlockEncoderOptions::RETURN_RELOC_INFOS | BlockEncoderOptions::RETURN_NEW_INSTRUCTION_OFFSETS;
+	let results = BlockEncoder::encode_slice(64, &[block_a, block_b], OPTIONS).unwrap();
+
+	// encode_slice does not preserve caller order; identify each result by its own rip.
+	let result_a = results.iter().find(|r| r.rip == 0x8000_0000_0000_0000).unwrap();
+	let result_b = results.iter().find(|r| r.rip == 0x1000).unwrap();
+
+	#[rustfmt::skip]
+	let expected_new_data_a = [
+		0xB0, 0x00, 0xFF, 0x25, 0x10, 0x00, 0x00, 0x00, 0xB0, 0x01, 0xFF, 0x25,
+		0x08, 0x00, 0x00, 0x00, 0xB0, 0x02, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC, 0xCC,
+		0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	];
+	assert_eq!(&result_a.code_buffer[..], &expected_new_data_a);
+	assert_eq!(&result_b.code_buffer[..], &[0x90]);
+
+	// Two branches resolving to the same relocated instruction must share one pointer data slot:
+	// exactly one relocation, not two.
+	assert_eq!(result_a.reloc_infos.len(), 1);
+	assert_eq!(result_a.reloc_infos[0], RelocInfo::new(RelocKind::Offset64, 0x8000_0000_0000_0018));
+	assert_eq!(&result_a.new_instruction_offsets[..], &[0x0000, u32::MAX, 0x0008, u32::MAX, 0x0010]);
+}
