+#[test]
+fn near_form_branch_to_shared_target_does_not_join_the_slot() {
+	// Three branches target the same external address. The first two are positioned early enough
+	// in the block that the target is still more than 2GB away (long form); the third is
+	// positioned far enough into the block that it can reach the same target with an ordinary
+	// near jump. Only the two long-form branches share a pointer data slot; the near-form branch
+	// must not be counted as a sharer, and must not affect the slot's contents.
+	#[rustfmt::skip]
+	let original_data = [
+		0xE9, 0xFB, 0x01, 0x00, 0x00, 0x90, 0x90, 0x90, 0xE9, 0xF3, 0x01, 0x00,
+		0x00, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0xE9, 0xBF, 0x01, 0x00, 0x00,
+	];
+	const NEW_RIP: u64 = 0xFFFF_FFFF_8000_11D9;
+	#[rustfmt::skip]
+	let new_data = [
+		0xFF, 0x25, 0x41, 0x00, 0x00, 0x00, 0x90, 0x90, 0x90, 0xFF, 0x25, 0x38,
+		0x00, 0x00, 0x00, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
+		0x90, 0x90, 0xE9, 0xE4, 0xFF, 0xFF, 0x7F, 0xCC, 0xCC, 0xCC, 0xCC, 0x00,
+		0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	];
+	#[rustfmt::skip]
+	let expected_instruction_offsets = [
+		u32::MAX, 0x0006, 0x0007, 0x0008, u32::MAX, 0x000F, 0x0010, 0x0011, 0x0012, 0x0013, 0x0014, 0x0015,
+		0x0016, 0x0017, 0x0018, 0x0019, 0x001A, 0x001B, 0x001C, 0x001D, 0x001E, 0x001F, 0x0020, 0x0021,
+		0x0022, 0x0023, 0x0024, 0x0025, 0x0026, 0x0027, 0x0028, 0x0029, 0x002A, 0x002B, 0x002C, 0x002D,
+		0x002E, 0x002F, 0x0030, 0x0031, 0x0032, 0x0033, 0x0034, 0x0035, 0x0036, 0x0037, 0x0038, 0x0039,
+		0x003A, 0x003B, 0x003C, 0x003D, 0x003E,
+	];
+	let expected_reloc_infos = [RelocInfo::new(RelocKind::Offset64, 0xFFFF_FFFF_8000_1220)];
+	encode_test(
+		64,
+		0x1000,
+		&original_data,
+		NEW_RIP,
+		&new_data,
+		BlockEncoderOptions::NONE,
+		DECODER_OPTIONS,
+		&expected_instruction_offsets,
+		&expected_reloc_infos,
+	);
+
+	// The shared slot's stored value must be the actual target address, unaffected by the presence
+	// of the near-form branch that shares the same numeric target but not the slot.
+	let result = BlockEncoder::encode(
+		64,
+		InstructionBlock::new(&decode(64, 0x1000, &original_data, DECODER_OPTIONS), NEW_RIP),
+		BlockEncoderOptions::RETURN_RELOC_INFOS,
+	)
+	.unwrap();
+	let off = (result.reloc_infos[0].address - result.rip) as usize;
+	assert_eq!(&result.code_buffer[off..off + 8], &[0x00, 0x12, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]);
+}
