@@ -109,6 +109,23 @@ impl TargetInstr {
 			TargetInstr::Uninitialized => unreachable!(),
 		}
 	}
+
+	// Identifies the final target a long-form branch resolves to, so that two branches sharing
+	// the same target can share one pointer data slot. `IsOwner` resolves to the encoding
+	// instruction's own (per-instruction) address, so it's never shareable between instructions.
+	pub(super) fn dedup_key(&self) -> Option<TargetKey> {
+		match self {
+			TargetInstr::Instruction(instr_index) => Some(TargetKey::Instr(*instr_index)),
+			TargetInstr::Address(address) => Some(TargetKey::Addr(*address)),
+			TargetInstr::IsOwner | TargetInstr::Uninitialized => None,
+		}
+	}
+}
+
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+pub(super) enum TargetKey {
+	Instr(usize),
+	Addr(u64),
 }
 
