+	// Long-form branches that resolve to the same final target (whether that target is another
+	// instruction being relocated in this call, or a fixed external address) share one pointer
+	// data slot instead of each getting their own. `target` identifies the caller's resolved
+	// target so a repeat request for the same target reuses the existing slot.
+	pub(super) fn alloc_pointer_location(&mut self, target: &TargetInstr) -> Rc<RefCell<BlockData>> {
+		if let Some(key) = target.dedup_key() {
+			if let Some((_, data)) = self.pointer_data_by_key.iter().find(|(k, _)| *k == key) {
+				data.borrow_mut().sharer_count += 1;
+				return data.clone();
+			}
+			let data = Self::new_pointer_data();
+			self.data_vec.push(data.clone());
+			self.pointer_data_by_key.push((key, data.clone()));
+			data
+		} else {
+			let data = Self::new_pointer_data();
+			self.data_vec.push(data.clone());
+			data
+		}
+	}
+
+	fn new_pointer_data() -> Rc<RefCell<BlockData>> {
+		Rc::new(RefCell::new(BlockData { data: 0, address: 0, address_initd: false, is_valid: true, sharer_count: 1 }))
+	}
+
+	// Releases one sharer's claim on a pointer data slot. A shared slot is only removed from the
+	// output once every branch that was assigned to it has released its claim; while at least one
+	// sharer still needs it, it stays valid.
+	pub(super) fn release_pointer_location(&self, data: &Rc<RefCell<BlockData>>) {
+		let mut data = data.borrow_mut();
+		debug_assert!(data.sharer_count > 0);
+		data.sharer_count -= 1;
+		if data.sharer_count == 0 {
+			data.is_valid = false;
+		}
 	}
 
