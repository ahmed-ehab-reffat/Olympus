@@ -0,0 +1,237 @@
+mod common;
+
+use common::get_test_context;
+
+use numbat::resolver::CodeSource;
+use numbat::{Context, InterpreterResult, markup::Formatter, markup::PlainTextFormatter};
+use numbat::pretty_print::PrettyPrint;
+
+#[track_caller]
+fn expect_output(code: &str, expected: &str) {
+    let mut ctx = get_test_context();
+    match ctx.interpret(code, CodeSource::Internal) {
+        Ok((_, InterpreterResult::Value(val))) => {
+            let fmt = PlainTextFormatter {};
+            assert_eq!(fmt.format(&val.pretty_print(), false).trim(), expected);
+        }
+        Ok(_) => panic!("expected a value for code:\n{code}"),
+        Err(e) => panic!("expected success for code:\n{code}\ngot error: {e:?}"),
+    }
+}
+
+#[track_caller]
+fn expect_failure(code: &str, expected_fragment: &str) {
+    let mut ctx = get_test_context();
+    match ctx.interpret(code, CodeSource::Internal) {
+        Err(e) => {
+            let message = format!("{e:?}");
+            assert!(
+                message.contains(expected_fragment),
+                "expected error containing {expected_fragment:?} for code:\n{code}\ngot: {message}"
+            );
+        }
+        Ok(_) => panic!("expected failure for code:\n{code}"),
+    }
+}
+
+#[track_caller]
+fn expect_same_dimension(annotation: &str, value: &str) {
+    expect_output(&format!("let q: {annotation} = {value}\nq"), &{
+        let mut ctx = get_test_context();
+        let fmt = PlainTextFormatter {};
+        match ctx.interpret(value, CodeSource::Internal) {
+            Ok((_, InterpreterResult::Value(val))) => {
+                fmt.format(&val.pretty_print(), false).trim().to_owned()
+            }
+            _ => panic!("could not evaluate {value}"),
+        }
+    });
+}
+
+#[test]
+fn literal_exponent_in_annotation_is_unchanged() {
+    expect_output("let q: Length^2 = 4 m^2\nq", "4 m²");
+}
+
+#[test]
+fn unicode_superscript_annotation_is_unchanged() {
+    expect_output("let q: Length² = 4 m^2\nq", "4 m²");
+}
+
+#[test]
+fn rational_exponent_in_annotation_is_unchanged() {
+    expect_output("let q: Length^(1/2) = 2 m^(1/2)\nq", "2 m^(1/2)");
+}
+
+#[test]
+fn negative_exponent_in_annotation_is_unchanged() {
+    expect_output("let q: Length^(-1) = 4 / m\nq", "4 m⁻¹");
+}
+
+#[test]
+fn addition_in_annotation_exponent() {
+    expect_output("let q: Length^(1+1) = 4 m^2\nq", "4 m²");
+}
+
+#[test]
+fn subtraction_in_annotation_exponent() {
+    expect_output("let q: Length^(5-2) = 8 m^3\nq", "8 m³");
+}
+
+#[test]
+fn multiplication_in_annotation_exponent() {
+    expect_output("let q: Length^(2*2) = 4 m^4\nq", "4 m⁴");
+}
+
+#[test]
+fn division_in_annotation_exponent() {
+    expect_output("let q: Length^(6/3) = 4 m^2\nq", "4 m²");
+}
+
+#[test]
+fn named_constant_as_annotation_exponent() {
+    expect_output("let n = 2\nlet q: Length^n = 4 m^2\nq", "4 m²");
+}
+
+#[test]
+fn named_constant_inside_annotation_arithmetic() {
+    expect_output("let n = 2\nlet q: Length^(n+1) = 8 m^3\nq", "8 m³");
+}
+
+#[test]
+fn named_constant_multiplied_in_annotation() {
+    expect_output("let n = 2\nlet q: Length^(n*2) = 4 m^4\nq", "4 m⁴");
+}
+
+#[test]
+fn negated_named_constant_in_annotation() {
+    expect_output("let n = 1\nlet q: Length^(-n) = 4 / m\nq", "4 m⁻¹");
+}
+
+#[test]
+fn named_constant_as_value_exponent() {
+    expect_output("let n = 2\n2 m^n", "2 m²");
+}
+
+#[test]
+fn named_constant_inside_value_arithmetic_exponent() {
+    expect_output("let n = 2\n2 m^(n+1)", "2 m³");
+}
+
+#[test]
+fn named_constant_agrees_across_annotation_and_value() {
+    expect_output("let n = 3\nlet q: Length^n = 5 m^n\nq", "5 m³");
+}
+
+#[test]
+fn named_constant_in_function_signature() {
+    expect_output(
+        "let n = 2\nfn area(x: Length^n) -> Length^n = x\narea(9 m^2)",
+        "9 m²",
+    );
+}
+
+#[test]
+fn named_constant_in_dimension_declaration() {
+    expect_output(
+        "let n = 3\ndimension Vol2 = Length^n\nlet q: Vol2 = 8 m^3\nq",
+        "8 m³",
+    );
+}
+
+#[test]
+fn named_constant_in_unit_definition() {
+    expect_output(
+        "let n = 3\ndimension Vol3 = Length^n\nunit stere: Vol3 = 1 m^3\n2 stere -> m^3",
+        "2 m³",
+    );
+}
+
+#[test]
+fn rational_constant_as_exponent() {
+    expect_output("let half = 1/2\nlet q: Length^half = 2 m^(1/2)\nq", "2 m^(1/2)");
+}
+
+#[test]
+fn constant_defined_from_another_constant() {
+    expect_output("let a = 1\nlet b = a + 1\nlet q: Length^b = 4 m^2\nq", "4 m²");
+}
+
+#[test]
+fn shadowed_constant_uses_the_latest_binding() {
+    expect_output("let n = 1\nlet n = 3\nlet q: Length^n = 8 m^3\nq", "8 m³");
+}
+
+#[test]
+fn unknown_name_in_annotation_exponent_is_rejected() {
+    expect_failure("let q: Length^nope = 4 m^2\nq", "nope");
+}
+
+#[test]
+fn name_used_before_binding_is_rejected() {
+    expect_failure("let q: Length^later = 4 m^2\nlet later = 2\nq", "later");
+}
+
+#[test]
+fn dimensionful_constant_is_not_a_valid_exponent() {
+    expect_failure("let dist = 2 m\nlet q: Length^dist = 4 m^2\nq", "dist");
+}
+
+#[test]
+fn division_by_zero_in_annotation_exponent_is_rejected() {
+    expect_failure("let q: Length^(1/0) = 4 m\nq", "DivisionByZero");
+}
+
+#[test]
+fn division_by_zero_through_a_constant_is_rejected() {
+    expect_failure("let zero_c = 0\nlet q: Length^(1/zero_c) = 4 m\nq", "Division by zero");
+}
+
+#[test]
+fn mismatched_computed_dimension_is_rejected() {
+    expect_failure("let n = 2\nlet q: Length^n = 4 m^3\nq", "");
+}
+
+#[test]
+fn computed_exponent_matches_the_literal_it_denotes() {
+    expect_same_dimension("Length^(1+1)", "4 m^2");
+}
+
+#[test]
+fn named_exponent_matches_the_literal_it_denotes() {
+    expect_output("let n = 2\nlet a: Length^n = 4 m^2\nlet b: Length^2 = a\nb", "4 m²");
+}
+
+#[test]
+fn computed_exponent_composes_in_a_product_dimension() {
+    expect_output(
+        "let n = 2\nlet q: Length^n / Time = 4 m^2 / s\nq",
+        "4 m²/s",
+    );
+}
+
+#[test]
+fn literal_exponent_division_still_parses_after_a_power() {
+    expect_output("dimension Zork2 = Length^2 / Time\nlet q: Zork2 = 4 m^2/s\nq", "4 m²/s");
+}
+
+#[test]
+fn rebinding_a_name_does_not_change_an_earlier_type() {
+    expect_output(
+        "let n = 2\nlet a: Length^n = 4 m^2\nlet n = 3\nlet b: Length^2 = a\nb",
+        "4 m²",
+    );
+}
+
+#[test]
+fn rebinding_a_name_applies_to_a_later_type() {
+    expect_output(
+        "let n = 2\nlet a: Length^n = 4 m^2\nlet n = 3\nlet c: Length^n = 8 m^3\nc",
+        "8 m³",
+    );
+}
+
+#[test]
+fn value_level_arithmetic_exponent_is_unchanged() {
+    expect_output("2 m^(1+1)", "2 m²");
+}
