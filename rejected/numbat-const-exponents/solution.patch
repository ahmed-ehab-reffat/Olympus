diff --git a/numbat/src/dimension_exponent.rs b/numbat/src/dimension_exponent.rs
new file mode 100644
index 0000000..55c4589
--- /dev/null
+++ b/numbat/src/dimension_exponent.rs
@@ -0,0 +1,169 @@
+use compact_str::CompactString;
+use num_traits::{CheckedAdd, CheckedDiv, CheckedMul, CheckedSub, Zero};
+
+use crate::arithmetic::{Exponent, Rational};
+use crate::span::Span;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum DimensionExponentOp {
+    Add,
+    Subtract,
+    Multiply,
+    Divide,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DimensionExponent {
+    Number(Span, Exponent),
+    Identifier(Span, CompactString),
+    Negate(Span, Box<DimensionExponent>),
+    BinaryOperator(
+        Span,
+        DimensionExponentOp,
+        Box<DimensionExponent>,
+        Box<DimensionExponent>,
+    ),
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum DimensionExponentError {
+    UnknownConstant(Span, CompactString),
+    DivisionByZero(Span),
+    OutOfRange(Span),
+}
+
+impl DimensionExponent {
+    pub fn full_span(&self) -> Span {
+        match self {
+            DimensionExponent::Number(span, _)
+            | DimensionExponent::Identifier(span, _)
+            | DimensionExponent::Negate(span, _)
+            | DimensionExponent::BinaryOperator(span, _, _, _) => *span,
+        }
+    }
+
+    #[cfg(test)]
+    pub fn replace_spans(&self) -> DimensionExponent {
+        match self {
+            DimensionExponent::Number(_, value) => {
+                DimensionExponent::Number(Span::dummy(), *value)
+            }
+            DimensionExponent::Identifier(_, name) => {
+                DimensionExponent::Identifier(Span::dummy(), name.clone())
+            }
+            DimensionExponent::Negate(_, inner) => {
+                DimensionExponent::Negate(Span::dummy(), Box::new(inner.replace_spans()))
+            }
+            DimensionExponent::BinaryOperator(_, op, lhs, rhs) => DimensionExponent::BinaryOperator(
+                Span::dummy(),
+                *op,
+                Box::new(lhs.replace_spans()),
+                Box::new(rhs.replace_spans()),
+            ),
+        }
+    }
+
+    pub fn as_literal(&self) -> Option<Exponent> {
+        match self {
+            DimensionExponent::Number(_, value) => Some(*value),
+            DimensionExponent::Negate(_, inner) => inner.as_literal().map(|value| -value),
+            _ => None,
+        }
+    }
+
+    pub fn is_literal(&self) -> bool {
+        self.as_literal().is_some()
+    }
+
+    pub fn contains_identifier(&self) -> bool {
+        match self {
+            DimensionExponent::Number(..) => false,
+            DimensionExponent::Identifier(..) => true,
+            DimensionExponent::Negate(_, inner) => inner.contains_identifier(),
+            DimensionExponent::BinaryOperator(_, _, lhs, rhs) => {
+                lhs.contains_identifier() || rhs.contains_identifier()
+            }
+        }
+    }
+}
+
+pub trait ConstantLookup {
+    fn lookup(&self, name: &str) -> Option<Exponent>;
+}
+
+impl ConstantLookup for () {
+    fn lookup(&self, _name: &str) -> Option<Exponent> {
+        None
+    }
+}
+
+pub fn evaluate(
+    exponent: &DimensionExponent,
+    constants: &dyn ConstantLookup,
+) -> Result<Exponent, DimensionExponentError> {
+    match exponent {
+        DimensionExponent::Number(_, value) => Ok(*value),
+        DimensionExponent::Identifier(span, name) => constants
+            .lookup(name)
+            .ok_or_else(|| DimensionExponentError::UnknownConstant(*span, name.clone())),
+        DimensionExponent::Negate(_, inner) => Ok(-evaluate(inner, constants)?),
+        DimensionExponent::BinaryOperator(span, op, lhs, rhs) => {
+            let rhs_span = rhs.full_span();
+            let lhs = evaluate(lhs, constants)?;
+            let rhs = evaluate(rhs, constants)?;
+            let result = match op {
+                DimensionExponentOp::Add => lhs.checked_add(&rhs),
+                DimensionExponentOp::Subtract => lhs.checked_sub(&rhs),
+                DimensionExponentOp::Multiply => lhs.checked_mul(&rhs),
+                DimensionExponentOp::Divide => {
+                    if rhs.is_zero() {
+                        return Err(DimensionExponentError::DivisionByZero(rhs_span));
+                    }
+                    lhs.checked_div(&rhs)
+                }
+            };
+            result.ok_or(DimensionExponentError::OutOfRange(*span))
+        }
+    }
+}
+
+pub fn exact_rational_from_f64(value: f64) -> Option<Exponent> {
+    if !value.is_finite() {
+        return None;
+    }
+    let mut denominator: i128 = 1;
+    let mut scaled = value;
+    for _ in 0..9 {
+        if scaled.fract() == 0.0 {
+            let numerator = scaled as i128;
+            return Some(Rational::new(numerator.into(), denominator.into()));
+        }
+        scaled *= 10.0;
+        denominator = denominator.checked_mul(10)?;
+    }
+    None
+}
+
+impl DimensionExponentError {
+    pub fn message(&self) -> String {
+        match self {
+            DimensionExponentError::UnknownConstant(_, name) => {
+                format!("Unknown constant '{name}' in dimension exponent")
+            }
+            DimensionExponentError::DivisionByZero(_) => {
+                "Division by zero in dimension exponent".to_owned()
+            }
+            DimensionExponentError::OutOfRange(_) => {
+                "Only integer numbers (< 2^128) are allowed in dimension exponents".to_owned()
+            }
+        }
+    }
+
+    pub fn span(&self) -> Span {
+        match self {
+            DimensionExponentError::UnknownConstant(span, _)
+            | DimensionExponentError::DivisionByZero(span)
+            | DimensionExponentError::OutOfRange(span) => *span,
+        }
+    }
+}
