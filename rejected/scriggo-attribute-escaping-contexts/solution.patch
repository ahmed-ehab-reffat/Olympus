+// attributeWriter is a strWriter that escapes what it writes, so it can be
+// placed inside an HTML attribute value.
+type attributeWriter struct {
+	w      strWriter
+	quoted bool
+}
+
+// newAttributeWriter returns an attributeWriter that writes to out. quoted
+// reports whether the attribute is quoted.
+func newAttributeWriter(out io.Writer, quoted bool) *attributeWriter {
+	return &attributeWriter{w: newStringWriter(out), quoted: quoted}
+}
+
+func (aw *attributeWriter) Write(b []byte) (int, error) {
+	err := attributeEscape(aw.w, string(b), true, aw.quoted)
+	if err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+
+func (aw *attributeWriter) WriteString(s string) (int, error) {
+	err := attributeEscape(aw.w, s, true, aw.quoted)
+	if err != nil {
+		return 0, err
+	}
+	return len(s), nil
+}
