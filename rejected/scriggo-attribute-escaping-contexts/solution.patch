+// attributeContext returns the context of the value of the attribute attr.
+// quoted reports whether the value is quoted.
+//
+// The value of the "style" attribute is in CSS context and the value of an
+// attribute whose name starts with "on", as an event handler, is in
+// JavaScript context.
+func attributeContext(attr string, quoted bool) ast.Context {
+	switch {
+	case attr == "style":
+		if quoted {
+			return ast.ContextCSSQuotedAttr
+		}
+		return ast.ContextCSSUnquotedAttr
+	case len(attr) > 2 && strings.HasPrefix(attr, "on"):
+		if quoted {
+			return ast.ContextJSQuotedAttr
+		}
+		return ast.ContextJSUnquotedAttr
+	case quoted:
+		return ast.ContextQuotedAttr
+	}
+	return ast.ContextUnquotedAttr
+}
+
+// isQuotedAttrContext reports whether ctx is the context of a quoted CSS or
+// JavaScript attribute value.
+func isQuotedAttrContext(ctx ast.Context) bool {
+	switch ctx {
+	case ast.ContextCSSQuotedAttr, ast.ContextCSSStringQuotedAttr,
+		ast.ContextJSQuotedAttr, ast.ContextJSStringQuotedAttr:
+		return true
+	}
+	return false
+}
+
+// stringAttrContext returns the string context of the CSS or JavaScript
+// attribute context ctx.
+func stringAttrContext(ctx ast.Context) ast.Context {
+	switch ctx {
+	case ast.ContextCSSQuotedAttr:
+		return ast.ContextCSSStringQuotedAttr
+	case ast.ContextCSSUnquotedAttr:
+		return ast.ContextCSSStringUnquotedAttr
+	case ast.ContextJSQuotedAttr:
+		return ast.ContextJSStringQuotedAttr
+	case ast.ContextJSUnquotedAttr:
+		return ast.ContextJSStringUnquotedAttr
+	}
+	panic("unexpected context")
+}
+
+// unstringAttrContext returns the CSS or JavaScript attribute context of the
+// string context ctx.
+func unstringAttrContext(ctx ast.Context) ast.Context {
+	switch ctx {
+	case ast.ContextCSSStringQuotedAttr:
+		return ast.ContextCSSQuotedAttr
+	case ast.ContextCSSStringUnquotedAttr:
+		return ast.ContextCSSUnquotedAttr
+	case ast.ContextJSStringQuotedAttr:
+		return ast.ContextJSQuotedAttr
+	case ast.ContextJSStringUnquotedAttr:
+		return ast.ContextJSUnquotedAttr
+	}
+	panic("unexpected context")
+}
+
+// scanAttrQuote scans a quote at the start of s, in an attribute value. The
+// quote can be written as a character or as a character reference. It
+// returns the quote and the length of its representation, or 0 and 0 if s
+// does not start with a quote.
+func scanAttrQuote(s []byte) (byte, int) {
+	if len(s) == 0 {
+		return 0, 0
+	}
+	switch s[0] {
+	case '"', '\'':
+		return s[0], 1
+	case '&':
+	default:
+		return 0, 0
+	}
+	if bytes.HasPrefix(s, quotRef) {
+		return '"', len(quotRef)
+	}
+	if bytes.HasPrefix(s, aposRef) {
+		return '\'', len(aposRef)
+	}
+	if len(s) < 4 || s[1] != '#' {
+		return 0, 0
+	}
+	p := 2
+	base := 10
+	if s[p] == 'x' || s[p] == 'X' {
+		base = 16
+		p++
+	}
+	start := p
+	code := 0
+	for ; p < len(s) && code <= '\''; p++ {
+		c := s[p]
+		switch {
+		case isDecDigit(c):
+			code = code*base + int(c-'0')
+		case base == 16 && 'a' <= c && c <= 'f':
+			code = code*base + int(c-'a'+10)
+		case base == 16 && 'A' <= c && c <= 'F':
+			code = code*base + int(c-'A'+10)
+		default:
+			if p > start && c == ';' && (code == '"' || code == '\'') {
+				return byte(code), p + 1
+			}
+			return 0, 0
+		}
+	}
+	return 0, 0
+}
