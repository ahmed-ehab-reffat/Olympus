+// license that can be found in the LICENSE file.
+
+//go:build attrctx_ed8cbb
+
+package misc
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/open2b/scriggo"
+	"github.com/open2b/scriggo/internal/fstest"
+	"github.com/open2b/scriggo/native"
+)
+
+type attributeContextTest struct {
+	src  string
+	res  string
+	vars Vars
+}
+
+func renderAttributeTemplate(name, src string, vars Vars) (string, error) {
+	fsys := fstest.Files{name: src}
+	opts := &scriggo.BuildOptions{Globals: asDeclarations(vars)}
+	template, err := scriggo.BuildTemplate(fsys, name, opts)
+	if err != nil {
+		return "", err
+	}
+	var b bytes.Buffer
+	err = template.Run(&b, vars, nil)
+	return b.String(), err
+}
+
+func runAttributeContextTests(t *testing.T, name string, tests []attributeContextTest) {
+	t.Helper()
+	for _, test := range tests {
+		res, err := renderAttributeTemplate(name, test.src, test.vars)
+		if err != nil {
+			t.Errorf("source: %q, unexpected error: %s", test.src, err)
+			continue
+		}
+		if res != test.res {
+			t.Errorf("source: %q\nexpecting %q\ngot       %q", test.src, test.res, res)
+		}
+	}
+}
+
+var styleAttributeTests = []attributeContextTest{
+	{`<p style="color: {{ a }}">`, `<p style="color: &#34;red\3b  x&#34;">`, Vars{"a": "red; x"}},
+	{`<p style={{ a }}>`, `<p style=&#34;a&#32;b&#34;>`, Vars{"a": "a b"}},
+	{`<p style="font-family: '{{ a }}'">`, `<p style="font-family: 'x\27y\26 '">`, Vars{"a": "x'y&"}},
+	{`<p style='font-family: "{{ a }}"'>`, `<p style='font-family: "a\22 b"'>`, Vars{"a": `a"b`}},
+	{`<p style="width: {{ n }}px">`, `<p style="width: 10px">`, Vars{"n": 10}},
+	{`<p style="{{ a }}">`, `<p style="a:&#34;b&#34;">`, Vars{"a": native.CSS(`a:"b"`)}},
+	{`<p style="{{ a }}">`, `<p style="&#34;\3c b\3e &#34;">`, Vars{"a": native.HTML("<b>")}},
+	{`<a data-style="{{ a }}">`, `<a data-style="&#34;x&#34;">`, Vars{"a": `"x"`}},
+	{`<style>p{color: {{ a }}}</style>`, `<style>p{color: "red"}</style>`, Vars{"a": "red"}},
+	{`<div STYLE="color: {{ a }}">`, `<div STYLE="color: &#34;red&#34;">`, Vars{"a": "red"}},
+}
+
+func TestStyleAttributeContext(t *testing.T) {
+	runAttributeContextTests(t, "index.html", styleAttributeTests)
+}
+
+var eventHandlerAttributeTests = []attributeContextTest{
+	{`<a onclick="f({{ a }})">`, `<a onclick="f(&#34;a\u003cb\&#34;c&#34;)">`, Vars{"a": `a<b"c`}},
+	{`<a onclick="f('{{ a }}')">`, `<a onclick="f('\u0027); alert(1); //')">`, Vars{"a": "'); alert(1); //"}},
+	{`<a onclick=f({{ a }})>`, `<a onclick=f(&#34;a&#32;b&#34;)>`, Vars{"a": "a b"}},
+	{`<a onclick='f("{{ a }}")'>`, `<a onclick='f("\&#34;\u0027")'>`, Vars{"a": `"'`}},
+	{`<a onclick="{{ a }}">`, `<a onclick="g(&#34;x&#34;) &amp;&amp; y">`, Vars{"a": native.JS(`g("x") && y`)}},
+	{`<a onclick="f({{ a }})">`, `<a onclick="f({&#34;k&#34;:1})">`, Vars{"a": map[string]int{"k": 1}}},
+	{`<a on="{{ a }}">`, `<a on="&#34;x&#34;">`, Vars{"a": `"x"`}},
+	{`<a data-onclick="{{ a }}">`, `<a data-onclick="&#34;x&#34;">`, Vars{"a": `"x"`}},
+	{`<script>f({{ a }})</script>`, `<script>f("a\u003cb")</script>`, Vars{"a": "a<b"}},
+	{`<a ONMOUSEOVER="f({{ a }})">`, `<a ONMOUSEOVER="f(&#34;x&#34;)">`, Vars{"a": "x"}},
+}
+
+func TestEventHandlerAttributeContext(t *testing.T) {
+	runAttributeContextTests(t, "index.html", eventHandlerAttributeTests)
+}
+
+var attributeQuoteReferenceTests = []attributeContextTest{
+	{`<a onclick="f(&quot;{{ a }}&quot;)">`, `<a onclick="f(&quot;x\&#34;y&quot;)">`, Vars{"a": `x"y`}},
+	{`<a onclick="f(&#39;{{ a }}&#39;)">`, `<a onclick="f(&#39;a b&#39;)">`, Vars{"a": "a b"}},
+	{`<a onclick="f(&#x27;{{ a }}&#x27;)">`, `<a onclick="f(&#x27;a b&#x27;)">`, Vars{"a": "a b"}},
+	{`<a onclick="f(&#0039;x&#39;, {{ a }})">`, `<a onclick="f(&#0039;x&#39;, &#34;z&#34;)">`, Vars{"a": "z"}},
+	{`<p style="content: &#X22;{{ a }}&#X22;">`, `<p style="content: &#X22;a\3b &#X22;">`, Vars{"a": "a;"}},
+}
+
+func TestAttributeQuoteCharacterReferences(t *testing.T) {
+	runAttributeContextTests(t, "index.html", attributeQuoteReferenceTests)
+}
+
+var attributeStringStateTests = []attributeContextTest{
+	{`<a onclick="f('it\'s {{ a }}')">`, `<a onclick="f('it\'s q')">`, Vars{"a": "q"}},
+	{`<a onclick="/* ' */ f({{ a }})">`, `<a onclick="/* ' */ f(&#34;z&#34;)">`, Vars{"a": "z"}},
+	{`<a onclick="f('x" title="{{ a }}">`, `<a onclick="f('x" title="&#39;">`, Vars{"a": "'"}},
+	{`<a onclick=f('{{ a }}') title="{{ b }}">`, `<a onclick=f('a&#32;b') title="&#34;">`, Vars{"a": "a b", "b": `"`}},
+}
+
+func TestAttributeStringState(t *testing.T) {
+	runAttributeContextTests(t, "index.html", attributeStringStateTests)
+}
+
+func TestAttributeContextInMarkdown(t *testing.T) {
+	runAttributeContextTests(t, "index.md", []attributeContextTest{
+		{`<a onclick="f({{ a }})">`, `<a onclick="f(&#34;x&#34;)">`, Vars{"a": "x"}},
+		{`<p style="color: {{ a }}">`, `<p style="color: &#34;red&#34;">`, Vars{"a": "red"}},
+	})
+}
+
+func TestAttributeContextShowTypes(t *testing.T) {
+	runAttributeContextTests(t, "index.html", []attributeContextTest{
+		{`<p style="background: '{{ b }}'">`, `<p style="background: 'AAEC'">`, Vars{"b": []byte{0, 1, 2}}},
+		{`<a onclick="f({{ b }})">`, `<a onclick="f(&#34;AAEC&#34;)">`, Vars{"b": []byte{0, 1, 2}}},
+	})
+	invalid := []attributeContextTest{
+		{`<p style="{{ c }}">`, "", Vars{"c": make(chan int)}},
+		{`<a onclick="f('{{ b }}')">`, "", Vars{"b": []byte{0, 1, 2}}},
+		{`<a onclick="f({{ c }})">`, "", Vars{"c": make(chan int)}},
+	}
+	for _, test := range invalid {
+		fsys := fstest.Files{"index.html": test.src}
+		opts := &scriggo.BuildOptions{Globals: asDeclarations(test.vars)}
+		if _, err := scriggo.BuildTemplate(fsys, "index.html", opts); err == nil {
+			t.Errorf("source: %q, expecting build error, got nil", test.src)
+		}
+	}
+}
