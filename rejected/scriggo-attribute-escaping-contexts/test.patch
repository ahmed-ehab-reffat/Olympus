diff --git a/test.sh b/test.sh
new file mode 100755
index 00000000..596a8fb9
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,53 @@
+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")"
+export GOFLAGS="-buildvcs=false"
+export GOTOOLCHAIN=local
+
+run() {
+  if [ "$MODE" = "new" ]; then
+    (cd test && go test -v -count=1 -tags attrctx_ed8cbb -run 'Attribute' ./misc 2>&1)
+  else
+    status=0
+    go test -v -count=1 ./... 2>&1 || status=1
+    (cd test && go test -v -count=1 ./... 2>&1) || status=1
+    return $status
+  fi
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  OUT_FILE="$(mktemp)"
+  run > "$OUT_FILE"
+  STATUS=$?
+  cat "$OUT_FILE"
+  go-junit-report < "$OUT_FILE" > "$OUTPUT_PATH" 2>/dev/null || true
+  rm -f "$OUT_FILE"
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+<testsuite name="scriggo" tests="1" failures="1" errors="0">
+<testcase name="build" classname="scriggo"><failure message="build or test failure">see stdout</failure></testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+  fi
+  exit $STATUS
+else
+  run
+  exit $?
+fi
diff --git a/test/misc/attribute_contexts_ed8cbb_test.go b/test/misc/attribute_contexts_ed8cbb_test.go
