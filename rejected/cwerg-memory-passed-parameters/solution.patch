+void PushPopInterface::GetCpuRegsForInSignature(
+    unsigned count, const base::DK* kinds,
+    std::vector<base::CpuReg>* out) const {
+  std::vector<CpuReg> cpu_regs;
+  CpuReg mem_reg = SplitInSignature(count, kinds, &cpu_regs);
+  out->clear();
+  for (CpuReg cpu_reg : cpu_regs) {
+    if (!cpu_reg.isnull()) out->push_back(cpu_reg);
+  }
+  if (!mem_reg.isnull()) out->push_back(mem_reg);
+}
+
+namespace {
+
+struct Param {
+  CpuReg cpu_reg;
+  int offset;
+};
+
+const char kParamMemName[] = "$param_mem";
+
+// returns the parameters in reverse order and the size of the memory region
+uint32_t GetInParams(unsigned count, const DK* kinds,
+                     const PushPopInterface& ppif, CpuReg* mem_reg,
+                     std::vector<Param>* params) {
+  std::vector<CpuReg> cpu_regs;
+  *mem_reg = ppif.SplitInSignature(count, kinds, &cpu_regs);
+  params->clear();
+  uint32_t size = 0;
+  for (unsigned i = 0; i < count; ++i) {
+    if (!cpu_regs[i].isnull()) {
+      params->push_back(Param{cpu_regs[i], -1});
+      continue;
+    }
+    const uint32_t width = DKBitWidth(kinds[i]) / 8;
+    size = (size + width - 1) / width * width;
+    params->push_back(Param{cpu_regs[i], int(size)});
+    size += width;
+  }
+  std::reverse(params->begin(), params->end());
+  return size;
+}
+
+void AddOutParams(unsigned count, const DK* kinds,
+                  const PushPopInterface& ppif, std::vector<Param>* params) {
+  std::vector<CpuReg> cpu_regs;
+  ppif.GetCpuRegsForOutSignature(count, kinds, &cpu_regs);
+  std::reverse(cpu_regs.begin(), cpu_regs.end());
+  for (CpuReg cpu_reg : cpu_regs) params->push_back(Param{cpu_reg, -1});
+}
+
+}  // namespace
+
