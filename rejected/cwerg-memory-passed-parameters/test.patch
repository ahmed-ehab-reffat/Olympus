+#!/usr/bin/env bash
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT"
+export PYTHONPATH="$ROOT"
+export PYPY="${PYPY:-python3}"
+export CC="${CC:-gcc}"
+export CXX="${CXX:-g++}"
+export MAKESILENT=""
+export QEMU_A32="${QEMU_A32:-qemu-armhf}"
+export QEMU_A64="${QEMU_A64:-qemu-aarch64}"
+export QEMU_X64="${QEMU_X64:-qemu-x86_64}"
+
+LOGDIR="$(mktemp -d)"
+CASES=()
+FAILED=0
+TOTAL=0
+
+xml_escape() {
+  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' | tr -d '\000-\010\013\014\016-\037'
+}
+
+record() {
+  local suite="$1" name="$2" status="$3" log="$4"
+  TOTAL=$((TOTAL + 1))
+  if [ "$status" != "0" ]; then
+    FAILED=$((FAILED + 1))
+    CASES+=("<testcase classname=\"$suite\" name=\"$name\"><failure message=\"exit status $status\">$(tail -c 12000 "$log" | xml_escape)</failure></testcase>")
+  else
+    CASES+=("<testcase classname=\"$suite\" name=\"$name\"/>")
+  fi
+}
+
+run_case() {
+  local suite="$1" name="$2"; shift 2
+  local log="$LOGDIR/$suite.$name.log"
+  ( "$@" ) > "$log" 2>&1
+  record "$suite" "$name" "$?" "$log"
+}
+
+write_xml() {
+  if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+    {
+      echo '<?xml version="1.0" encoding="UTF-8"?>'
+      echo "<testsuites name=\"cwerg\" tests=\"$TOTAL\" failures=\"$FAILED\">"
+      echo "<testsuite name=\"cwerg-$MODE\" tests=\"$TOTAL\" failures=\"$FAILED\">"
+      for c in "${CASES[@]}"; do echo "$c"; done
+      echo '</testsuite>'
+      echo '</testsuites>'
+    } > "$OUTPUT_PATH" || { echo "cannot write $OUTPUT_PATH"; exit 1; }
+  fi
+}
+trap 'write_xml' EXIT
+
+make_targets() {
+  make -s -f "$2" -C "$1" --eval='print-tests: ; @echo $(TESTS)' print-tests 2>/dev/null
+}
+
+build_tools() {
+  ( make cmake_setup && cd build && make -j2 a32_codegen_tool.exe a64_codegen_tool.exe x64_codegen_tool.exe optimize_tool.exe ) > "$LOGDIR/build.log" 2>&1
+  local status=$?
+  if [ "$status" != "0" ]; then
+    record "build" "cxx_tools" "$status" "$LOGDIR/build.log"
+    rm -f build/a32_codegen_tool.exe build/a64_codegen_tool.exe build/x64_codegen_tool.exe build/optimize_tool.exe
+  fi
+}
+
+stdlib_for() {
+  case "$1" in
+    a32) echo "BE/StdLib/startup_no_argv.asm BE/StdLib/syscall.a32.asm BE/StdLib/std_lib.32.asm" ;;
+    a64) echo "BE/StdLib/startup_no_argv.asm BE/StdLib/syscall.a64.asm BE/StdLib/std_lib.64.asm" ;;
+    x64) echo "BE/StdLib/startup_no_argv.x64.asm BE/StdLib/syscall.x64.asm BE/StdLib/std_lib.64.asm" ;;
+  esac
+}
+
+codegen_dir() { case "$1" in a32) echo A32 ;; a64) echo A64 ;; x64) echo X64 ;; esac; }
+qemu_for() { case "$1" in a32) echo "$QEMU_A32" ;; a64) echo "$QEMU_A64" ;; x64) echo "$QEMU_X64" ;; esac; }
+
+run_program() {
+  local impl="$1" target="$2" prog="$3"
+  local out="$LOGDIR/$impl.$target.$(basename "$prog").exe"
+  local dir; dir="$(codegen_dir "$target")"
+  local lib; lib="$(stdlib_for "$target")"
+  if [ "$impl" = py ]; then
+    $PYPY "BE/CodeGen$dir/codegen.py" -mode binary $lib "$prog" "$out" > /dev/null || return 1
+  else
+    cat $lib "$prog" | "build/${target}_codegen_tool.exe" -mode binary - "$out" > /dev/null || return 1
+  fi
+  chmod a+rx "$out"
+  "$(qemu_for "$target")" "$out" > "$out.actual" || return 1
+  diff "$out.actual" "$prog.golden"
+}
+
+run_parity() {
+  local target="$1" prog="$2" dir; dir="$(codegen_dir "$target")"
+  local lib; lib="$(stdlib_for "$target")"
+  local tag; tag="$(basename "${prog%.asm}").$target"
+  cat $lib "$prog" | $PYPY "BE/CodeGen$dir/codegen.py" -mode normal - "$LOGDIR/par.$tag.py" || return 1
+  cat $lib "$prog" | "build/${target}_codegen_tool.exe" -mode normal - "$LOGDIR/par.$tag.cc" || return 1
+  diff "$LOGDIR/par.$tag.cc" "$LOGDIR/par.$tag.py"
+}
+
+run_memory_check() {
+  local impl="$1" target="$2" prog="$3" dir; dir="$(codegen_dir "$target")"
+  local lib; lib="$(stdlib_for "$target")"
+  local asm="$LOGDIR/mem.$impl.$target.s"
+  if [ "$impl" = py ]; then
+    cat $lib "$prog" | $PYPY "BE/CodeGen$dir/codegen.py" -mode normal - "$asm" || return 1
+  else
+    cat $lib "$prog" | "build/${target}_codegen_tool.exe" -mode normal - "$asm" || return 1
+  fi
+  local body="$asm.sumint"
+  awk '/^\.fun sumint /{p=1} p{print} /^\.endfun/{if(p)exit}' "$asm" > "$body"
+  [ -s "$body" ] || return 1
+  local found
+  case "$target" in
+    a32) found="$(grep -E '^[[:space:]]+v?ldr[a-z0-9_]*[[:space:]]' "$body")" ;;
+    a64) found="$(grep -E '^[[:space:]]+(f?ldr|ldur|f?ldp)[a-z0-9_]*[[:space:]]' "$body" | grep -v '_post[[:space:]]')" ;;
+    x64) found="$(grep -E '^[[:space:]]+[a-z0-9_]+_[rx]_mbis[a-z0-9_]*[[:space:]]' "$body")" ;;
+  esac
+  if [ -z "$found" ]; then
+    echo "expected sumint to load at least one of its parameters from memory on $target ($impl), but its body has no load instruction:"
+    cat "$body"
+    return 1
+  fi
+  echo "$found"
+}
+
+NEW_PROGRAMS="BE/TestData/argmem_43df76.32.asm BE/TestData/argmem_43df76.64.asm BE/TestData/argflow_43df76.32.asm BE/TestData/argflow_43df76.64.asm BE/TestData/argedge_43df76.32.asm BE/TestData/argedge_43df76.64.asm BE/TestData/argleaf_43df76.32.asm BE/TestData/argleaf_43df76.64.asm"
+
+case "$MODE" in
+  base)
+    # The C++ frontend (FE/*.cc) needs GCC 13 (<format>) and BE/ApiDemo needs ARM
+    # cross compilers, neither of which the image ships. Everything else the
+    # repository's own `make tests` runs is covered below.
+    build_tools
+    for d in Base CpuA32 CpuA64 CpuX64 Elf CodeGenC ApiDemo; do
+      run_case "py.$d" "tests" make -s -f Makefile_py -C "BE/$d" tests
+    done
+    for t in a32 a64 x64; do
+      d="CodeGen$(codegen_dir "$t")"
+      for prog in $(make_targets "BE/$d" Makefile_py); do
+        run_case "py.$d" "${prog%.asm}" make -s -f Makefile_py -C "BE/$d" "build/$prog.exe"
+      done
+      run_case "py.$d" "rest" make -s -f Makefile_py -C "BE/$d" tests
+    done
+    make -s -f Makefile_py -C FE clean > /dev/null 2>&1
+    for t in eval_py pp_py x64 a64 a32; do
+      run_case "py.FE" "tests_$t" make -s -f Makefile_py -C FE "tests_$t"
+    done
+    for d in Base CpuA32 CpuA64 CpuX64 Elf; do
+      run_case "cc.$d" "tests" make -s -f Makefile_cc -C "BE/$d" tests
+    done
+    run_case "cc.BindingsC" "tests" make -s -f Makefile_cc -C BE/BindingsC tests
+    for t in a32 a64 x64; do
+      d="CodeGen$(codegen_dir "$t")"
+      for prog in $(make_targets "BE/$d" Makefile_cc); do
+        run_case "cc.$d" "${prog%.asm}" make -s -f Makefile_cc -C "BE/$d" "build/$prog.c.exe"
+      done
+      run_case "cc.$d" "rest" make -s -f Makefile_cc -C "BE/$d" tests
+    done
+    run_case "Util" "tests" make -s -C Util tests
+    ;;
+  new)
+    build_tools
+    for prog in $NEW_PROGRAMS; do
+      name="$(basename "${prog%.asm}")"
+      for t in a32 a64 x64; do
+        case "$prog" in *.32.asm) [ "$t" = a32 ] || continue ;; *) [ "$t" != a32 ] || continue ;; esac
+        run_case "params.py" "$name.$t" run_program py "$t" "$prog"
+        run_case "params.cc" "$name.$t" run_program cc "$t" "$prog"
+        run_case "params.parity" "$name.$t" run_parity "$t" "$prog"
+      done
+    done
+    for t in a32 a64 x64; do
+      case "$t" in a32) prog=BE/TestData/argleaf_43df76.32.asm ;; *) prog=BE/TestData/argleaf_43df76.64.asm ;; esac
+      run_case "params.memory" "py.$t" run_memory_check py "$t" "$prog"
+      run_case "params.memory" "cc.$t" run_memory_check cc "$t" "$prog"
+    done
+    ;;
+  *)
+    echo "usage: $0 --output_path <file> base|new"; exit 2 ;;
+esac
+
+echo "$MODE: $TOTAL cases, $FAILED failed"
+[ "$FAILED" -eq 0 ]
