@@ -0,0 +1,188 @@
+// Copyright ©2026 The Gonum Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package plot
+
+import (
+	"fmt"
+	"math"
+
+	"gonum.org/v1/plot/vg"
+	"gonum.org/v1/plot/vg/draw"
+)
+
+// bound is a lower bound, off - slope*w, on the room left on one
+// side of a data area of size w.
+type bound struct {
+	off   vg.Length
+	slope float64
+}
+
+// sides holds the room the axes and title take before and after a data
+// area along one direction, and the bounds the glyph boxes put on it.
+type sides struct {
+	min, max      vg.Length
+	before, after []bound
+}
+
+// box adds the bounds that keep a glyph box located at the normalized
+// position at, and extending from min to max around it, inside the region
+// left by the insets inBefore and inAfter from the edges of the canvas.
+func (s *sides) box(at float64, min, max, inBefore, inAfter vg.Length) {
+	s.before = append(s.before, bound{off: inBefore - min, slope: at})
+	s.after = append(s.after, bound{off: inAfter + max, slope: 1 - at})
+}
+
+// merge adds the room needed by t to s.
+func (s *sides) merge(t sides) {
+	s.min = max(s.min, t.min)
+	s.max = max(s.max, t.max)
+	s.before = append(s.before, t.before...)
+	s.after = append(s.after, t.after...)
+}
+
+// room returns the room needed before and after a data area of size w,
+// and the rate at which their sum decreases as the size grows up to w.
+func (s sides) room(w vg.Length) (before, after vg.Length, rate float64) {
+	before, rb := largest(s.min, s.before, w)
+	after, ra := largest(s.max, s.after, w)
+	return before, after, rb + ra
+}
+
+// largest returns the largest of v and the bounds for a data area of
+// size w, and the largest slope among the bounds reaching that value.
+func largest(v vg.Length, bounds []bound, w vg.Length) (vg.Length, float64) {
+	var slope float64
+	for _, b := range bounds {
+		switch x := b.off - vg.Length(b.slope)*w; {
+		case x > v:
+			v, slope = x, b.slope
+		case x == v:
+			slope = math.Max(slope, b.slope)
+		}
+	}
+	return v, slope
+}
+
+// fit returns the largest size w for which len(areas) data areas of size w,
+// each with the room its sides need, fit in the given length. It reports
+// false when no positive size fits.
+func fit(length vg.Length, areas []sides) (vg.Length, bool) {
+	n := vg.Length(len(areas))
+	steps := 2
+	for _, s := range areas {
+		steps += len(s.before) + len(s.after)
+	}
+	w := length / n
+	for range steps {
+		need, rate := n*w, float64(len(areas))
+		for _, s := range areas {
+			before, after, r := s.room(w)
+			need += before + after
+			rate -= r
+		}
+		if need <= length {
+			break
+		}
+		if rate <= 0 {
+			return 0, false
+		}
+		next := w - (need-length)/vg.Length(rate)
+		if next >= w {
+			break
+		}
+		w = next
+	}
+	return w, w > 0
+}
+
+// place returns the room before and after the data area along a
+// direction of the given length. When no data area keeps every glyph
+// box inside, it returns the room taken by the axes and title alone and
+// reports false. A length that cannot hold the axes and title is left
+// without padding.
+func (s sides) place(length vg.Length) (before, after vg.Length, ok bool) {
+	if length-s.min-s.max <= 0 {
+		return s.min, s.max, true
+	}
+	w, ok := fit(length, []sides{s})
+	if !ok {
+		return s.min, s.max, false
+	}
+	before, after, _ = s.room(w)
+	return before, after, true
+}
+
+// layout returns the bounds on the room around the data area of p,
+// horizontally and vertically, when a band of the given height is kept
+// free above it for the title.
+func (p *Plot) layout(title vg.Length) (x, y sides) {
+	p.X.sanitizeRange()
+	p.Y.sanitizeRange()
+	xa, ya := horizontalAxis{p.X}, verticalAxis{p.Y}
+	width, height := ya.size(), xa.size()
+
+	x.min, y.min, y.max = width, height, title
+	for _, b := range p.GlyphBoxes(p) {
+		if b.Size().X > 0 {
+			x.box(b.X, b.Min.X, b.Max.X, width, 0)
+		}
+		if b.Size().Y > 0 {
+			y.box(b.Y, b.Min.Y, b.Max.Y, height, title)
+		}
+	}
+	for _, b := range xa.GlyphBoxes(p) {
+		if b.Size().X > 0 && 0 <= b.X && b.X <= 1 {
+			x.box(b.X, b.Min.X, b.Max.X, 0, 0)
+		}
+	}
+	for _, b := range ya.GlyphBoxes(p) {
+		if b.Size().Y > 0 && 0 <= b.Y && b.Y <= 1 {
+			y.box(b.Y, b.Min.Y, b.Max.Y, 0, title)
+		}
+	}
+	return x, y
+}
+
+// titleBand returns the height taken by the title of p.
+func (p *Plot) titleBand() vg.Length {
+	if p.Title.Text == "" {
+		return 0
+	}
+	return p.Title.TextStyle.Rectangle(p.Title.Text).Size().Y + p.Title.Padding
+}
+
+// belowTitle returns c without the band taken by the title of p.
+func (p *Plot) belowTitle(c draw.Canvas) draw.Canvas {
+	if p.Title.Text != "" {
+		rect := p.Title.TextStyle.Rectangle(p.Title.Text)
+		c.Max.Y -= rect.Size().Y
+		c.Max.Y -= p.Title.Padding
+	}
+	return c
+}
+
+// dataRect returns the data area of p within c, the canvas left
+// below the title, and an error if its glyphs cannot all fit in c.
+func (p *Plot) dataRect(c draw.Canvas) (vg.Rectangle, error) {
+	x, y := p.layout(0)
+	left, right, okx := x.place(c.Max.X - c.Min.X)
+	bottom, top, oky := y.place(c.Max.Y - c.Min.Y)
+	var err error
+	switch {
+	case !okx:
+		err = fmt.Errorf("plot: glyphs do not fit in a canvas width of %v", c.Max.X-c.Min.X)
+	case !oky:
+		err = fmt.Errorf("plot: glyphs do not fit in a canvas height of %v", c.Max.Y-c.Min.Y)
+	}
+	return vg.Rectangle{
+		Min: vg.Point{X: c.Min.X + left, Y: c.Min.Y + bottom},
+		Max: vg.Point{X: c.Max.X - right, Y: c.Max.Y - top},
+	}, err
+}
+
+// within returns a canvas drawing to c over the rectangle r.
+func within(c draw.Canvas, r vg.Rectangle) draw.Canvas {
+	return draw.Canvas{Canvas: vg.Canvas(c), Rectangle: r}
+}
