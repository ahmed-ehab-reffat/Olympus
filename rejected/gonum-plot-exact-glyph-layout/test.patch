--- /dev/null
+++ b/layout_ee66e8_test.go
@@ -0,0 +1,320 @@
+// Copyright ©2026 The Gonum Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package plot_test
+
+import (
+	"math"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"gonum.org/v1/plot"
+	"gonum.org/v1/plot/plotter"
+	"gonum.org/v1/plot/text"
+	"gonum.org/v1/plot/vg"
+	"gonum.org/v1/plot/vg/draw"
+	"gonum.org/v1/plot/vg/recorder"
+)
+
+const layoutTol = 1e-6
+
+type glyphs []plot.GlyphBox
+
+func (g glyphs) Plot(draw.Canvas, *plot.Plot)          {}
+func (g glyphs) GlyphBoxes(*plot.Plot) []plot.GlyphBox { return g }
+
+type textBounds struct {
+	text.Handler
+	bounds map[string]vg.Rectangle
+}
+
+func (h *textBounds) Draw(c vg.Canvas, txt string, sty text.Style, pt vg.Point) {
+	h.bounds[txt] = sty.Rectangle(txt).Add(pt)
+}
+
+func recordText(sty *text.Style) *textBounds {
+	h := &textBounds{Handler: sty.Handler, bounds: make(map[string]vg.Rectangle)}
+	sty.Handler = h
+	return h
+}
+
+func layoutCanvas(w, h vg.Length) draw.Canvas {
+	return draw.Canvas{Canvas: new(recorder.Canvas), Rectangle: vg.Rectangle{Max: vg.Point{X: w, Y: h}}}
+}
+
+func hglyph(x float64, min, width vg.Length) plot.GlyphBox {
+	return plot.GlyphBox{X: x, Y: 0.5, Rectangle: vg.Rectangle{Min: vg.Point{X: min, Y: -1}, Max: vg.Point{X: min + width, Y: 1}}}
+}
+
+func vglyph(y float64, min, height vg.Length) plot.GlyphBox {
+	return plot.GlyphBox{X: 0.5, Y: y, Rectangle: vg.Rectangle{Min: vg.Point{X: -1, Y: min}, Max: vg.Point{X: 1, Y: min + height}}}
+}
+
+func bareLayoutPlot(gs ...plot.GlyphBox) *plot.Plot {
+	p := plot.New()
+	p.HideAxes()
+	p.X.Padding, p.Y.Padding = 0, 0
+	p.X.Min, p.X.Max, p.Y.Min, p.Y.Max = 0, 1, 0, 1
+	if len(gs) > 0 {
+		p.Add(glyphs(gs))
+	}
+	return p
+}
+
+func near(a, b vg.Length) bool { return math.Abs(float64(a-b)) <= layoutTol }
+
+func checkRect(t *testing.T, what string, got, want vg.Rectangle) {
+	t.Helper()
+	if !near(got.Min.X, want.Min.X) || !near(got.Min.Y, want.Min.Y) || !near(got.Max.X, want.Max.X) || !near(got.Max.Y, want.Max.Y) {
+		t.Errorf("%s: got %v, want %v", what, got, want)
+	}
+}
+
+func checkGlyphsInside(t *testing.T, p *plot.Plot, data, region vg.Rectangle) {
+	t.Helper()
+	dc := draw.Canvas{Rectangle: data}
+	for i, b := range p.GlyphBoxes(p) {
+		if b.Size().X > 0 {
+			x := dc.X(b.X) + b.Min.X
+			if x < region.Min.X-layoutTol || x+b.Size().X > region.Max.X+layoutTol {
+				t.Errorf("glyph box %d spans x [%v, %v] outside [%v, %v]", i, x, x+b.Size().X, region.Min.X, region.Max.X)
+			}
+		}
+		if b.Size().Y > 0 {
+			y := dc.Y(b.Y) + b.Min.Y
+			if y < region.Min.Y-layoutTol || y+b.Size().Y > region.Max.Y+layoutTol {
+				t.Errorf("glyph box %d spans y [%v, %v] outside [%v, %v]", i, y, y+b.Size().Y, region.Min.Y, region.Max.Y)
+			}
+		}
+	}
+}
+
+func overflowingPlot() *plot.Plot {
+	return bareLayoutPlot(hglyph(0.5, -300, 600))
+}
+
+func TestExactLayoutWidestDataAreaWhenTheExtremeBoxesDoNotBind(t *testing.T) {
+	p := bareLayoutPlot(hglyph(0, -50, 10), hglyph(0.3, -160, 10))
+	c := layoutCanvas(400, 300)
+	got := p.DataCanvas(c).Rectangle
+	w := vg.Length(240 / 0.7)
+	checkRect(t, "data canvas", got, vg.Rectangle{Min: vg.Point{X: 400 - w}, Max: vg.Point{X: 400, Y: 300}})
+	checkGlyphsInside(t, p, got, c.Rectangle)
+}
+
+func TestExactLayoutTallestDataAreaWhenTheExtremeBoxesDoNotBind(t *testing.T) {
+	p := bareLayoutPlot(vglyph(0, -50, 10), vglyph(0.3, -160, 10))
+	c := layoutCanvas(300, 400)
+	got := p.DataCanvas(c).Rectangle
+	h := vg.Length(240 / 0.7)
+	checkRect(t, "data canvas", got, vg.Rectangle{Min: vg.Point{Y: 400 - h}, Max: vg.Point{X: 300, Y: 400}})
+	checkGlyphsInside(t, p, got, c.Rectangle)
+}
+
+func TestExactLayoutBindingPairChangesAfterPadding(t *testing.T) {
+	p := bareLayoutPlot(
+		hglyph(0.05, -40, 10),
+		hglyph(0.4, -200, 10),
+		hglyph(0.6, 150, 30),
+		hglyph(0.95, -5, 30),
+	)
+	c := layoutCanvas(500, 200)
+	got := p.DataCanvas(c).Rectangle
+	checkGlyphsInside(t, p, got, c.Rectangle)
+	w := vg.Length(435 / 0.9)
+	n := 40 - 0.05*w
+	checkRect(t, "data canvas", got, vg.Rectangle{Min: vg.Point{X: n}, Max: vg.Point{X: n + w, Y: 200}})
+}
+
+func TestExactLayoutOverflowDataCanvasTakesTheSpaceBesideTheAxes(t *testing.T) {
+	p := overflowingPlot()
+	c := layoutCanvas(400, 300)
+	got := p.DataCanvas(c).Rectangle
+	checkRect(t, "data canvas", got, vg.Rectangle{Max: vg.Point{X: 400, Y: 300}})
+	p.Draw(c)
+}
+
+func TestExactLayoutOverflowWriterToReportsAnError(t *testing.T) {
+	w, err := overflowingPlot().WriterTo(400, 300, "png")
+	if err == nil {
+		t.Fatal("expected an error for glyphs that cannot fit")
+	}
+	if w != nil {
+		t.Errorf("expected no writer with the error, got %T", w)
+	}
+}
+
+func TestExactLayoutOverflowSaveCreatesNoFile(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "overflow.png")
+	if err := overflowingPlot().Save(400, 300, path); err == nil {
+		t.Fatal("expected an error for glyphs that cannot fit")
+	}
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Errorf("expected no file at %s, stat error: %v", path, err)
+	}
+}
+
+func TestExactLayoutOverflowSaveLeavesAnExistingFileAlone(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "overflow.svg")
+	if err := os.WriteFile(path, []byte("keep me"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := overflowingPlot().Save(400, 300, path); err == nil {
+		t.Fatal("expected an error for glyphs that cannot fit")
+	}
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "keep me" {
+		t.Errorf("existing file changed to %q", got)
+	}
+}
+
+func TestExactLayoutHorizontalAxisLabelsReachUnderAHiddenVerticalAxis(t *testing.T) {
+	p := plot.New()
+	p.HideY()
+	p.Y.Padding = 0
+	p.X.Min, p.X.Max = 0, 10
+	p.X.Tick.Marker = plot.ConstantTicks{{Value: 0, Label: "10000000"}, {Value: 10, Label: "1"}}
+	h := recordText(&p.X.Tick.Label)
+	c := layoutCanvas(300, 200)
+	p.Draw(c)
+	b, ok := h.bounds["10000000"]
+	if !ok {
+		t.Fatal("tick label was not drawn")
+	}
+	if !near(b.Min.X, 0) {
+		t.Errorf("left tick label starts at %v, want it to touch the canvas edge at 0", b.Min.X)
+	}
+	data := p.DataCanvas(c).Rectangle
+	if !near(data.Min.X, b.Size().X/2) {
+		t.Errorf("data area starts at %v, want %v", data.Min.X, b.Size().X/2)
+	}
+}
+
+func TestExactLayoutVerticalAxisLabelsReachDownBesideAHiddenHorizontalAxis(t *testing.T) {
+	p := plot.New()
+	p.HideX()
+	p.X.Padding = 0
+	p.Y.Min, p.Y.Max = 0, 10
+	p.Y.Tick.Label.Font.Size = 40
+	p.Y.Tick.Marker = plot.ConstantTicks{{Value: 0, Label: "0"}, {Value: 10, Label: "1"}}
+	data := p.DataCanvas(layoutCanvas(300, 300)).Rectangle
+	if want := p.Y.Tick.Label.Height("0") / 2; !near(data.Min.Y, want) {
+		t.Errorf("data area starts at %v, want %v", data.Min.Y, want)
+	}
+}
+
+func TestExactLayoutAlignGivesEqualAlignedDataCanvases(t *testing.T) {
+	plots := make([][]*plot.Plot, 2)
+	for j := range plots {
+		plots[j] = make([]*plot.Plot, 3)
+		for i := range plots[j] {
+			p := plot.New()
+			p.X.Min, p.X.Max, p.Y.Min, p.Y.Max = 0, 10, 0, 10
+			plots[j][i] = p
+		}
+	}
+	plots[0][0].Add(glyphs{hglyph(0.1, -60, 10)})
+	plots[1][2].Add(glyphs{vglyph(0.2, -70, 10)})
+	plots[1][1].Add(glyphs{hglyph(0.85, 40, 20)})
+	c := layoutCanvas(600, 400)
+	tiles := draw.Tiles{Rows: 2, Cols: 3, PadX: 4, PadY: 6, PadLeft: 3, PadRight: 2, PadTop: 5, PadBottom: 1}
+	cs := plot.Align(plots, tiles, c)
+	ref := plots[0][0].DataCanvas(cs[0][0]).Rectangle
+	for j := range plots {
+		for i, p := range plots[j] {
+			got := p.DataCanvas(cs[j][i]).Rectangle
+			if !near(got.Size().X, ref.Size().X) || !near(got.Size().Y, ref.Size().Y) {
+				t.Errorf("tile (%d,%d) data size %v, want %v", j, i, got.Size(), ref.Size())
+			}
+			col := plots[0][i].DataCanvas(cs[0][i]).Rectangle
+			if !near(got.Min.X, col.Min.X) || !near(got.Max.X, col.Max.X) {
+				t.Errorf("tile (%d,%d) data x [%v, %v], column has [%v, %v]", j, i, got.Min.X, got.Max.X, col.Min.X, col.Max.X)
+			}
+			row := plots[j][0].DataCanvas(cs[j][0]).Rectangle
+			if !near(got.Min.Y, row.Min.Y) || !near(got.Max.Y, row.Max.Y) {
+				t.Errorf("tile (%d,%d) data y [%v, %v], row has [%v, %v]", j, i, got.Min.Y, got.Max.Y, row.Min.Y, row.Max.Y)
+			}
+			checkGlyphsInside(t, p, got, cs[j][i].Rectangle)
+		}
+	}
+}
+
+func TestLayoutGuardAlignSingleTileMatchesTheWholeCanvas(t *testing.T) {
+	p := plot.New()
+	p.X.Min, p.X.Max, p.Y.Min, p.Y.Max = 0, 10, 0, 10
+	p.Add(glyphs{hglyph(0.1, -60, 10), vglyph(0.15, -50, 10)})
+	c := layoutCanvas(300, 200)
+	tiles := draw.Tiles{Rows: 1, Cols: 1, PadLeft: 4, PadRight: 6, PadTop: 3, PadBottom: 5}
+	cs := plot.Align([][]*plot.Plot{{p}}, tiles, c)
+	got := p.DataCanvas(cs[0][0]).Rectangle
+	want := p.DataCanvas(draw.Crop(c, 4, -6, 5, -3)).Rectangle
+	checkRect(t, "aligned data canvas", got, want)
+}
+
+func TestExactLayoutAlignTitledPlotKeepsTheRowAligned(t *testing.T) {
+	plots := [][]*plot.Plot{{plot.New(), plot.New()}}
+	for _, p := range plots[0] {
+		p.X.Min, p.X.Max, p.Y.Min, p.Y.Max = 0, 10, 0, 10
+	}
+	plots[0][0].Title.Text = "A title"
+	plots[0][0].Add(glyphs{vglyph(0.9, 20, 30)})
+	plots[0][1].Add(glyphs{vglyph(0.2, -70, 10)})
+	c := layoutCanvas(400, 250)
+	cs := plot.Align(plots, draw.Tiles{Rows: 1, Cols: 2, PadX: 5}, c)
+	a := plots[0][0].DataCanvas(cs[0][0]).Rectangle
+	b := plots[0][1].DataCanvas(cs[0][1]).Rectangle
+	if !near(a.Min.Y, b.Min.Y) || !near(a.Max.Y, b.Max.Y) {
+		t.Errorf("row data y ranges differ: %v and %v", a, b)
+	}
+	if !near(a.Size().X, b.Size().X) {
+		t.Errorf("data widths differ: %v and %v", a.Size().X, b.Size().X)
+	}
+}
+
+func TestLayoutGuardOrdinaryPlotKeepsItsDataArea(t *testing.T) {
+	p := plot.New()
+	p.Title.Text = "Title"
+	p.X.Label.Text = "X"
+	p.Y.Label.Text = "Y"
+	s, err := plotter.NewScatter(plotter.XYs{{X: 0, Y: 0}, {X: 1, Y: 2}, {X: 3, Y: 1}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p.Add(s)
+	got := p.DataCanvas(layoutCanvas(300, 200)).Rectangle
+	checkRect(t, "data canvas", got, vg.Rectangle{Min: vg.Point{X: 39.634765625, Y: 40.11328125}, Max: vg.Point{X: 297.5, Y: 181.173828125}})
+}
+
+func TestLayoutGuardTinyCanvasIsNotAnError(t *testing.T) {
+	p := plot.New()
+	p.Add(glyphs{hglyph(0.5, -3, 6)})
+	if _, err := p.WriterTo(4, 4, "png"); err != nil {
+		t.Errorf("unexpected error for a canvas smaller than the axes: %v", err)
+	}
+	p.Draw(layoutCanvas(4, 4))
+}
+
+func TestLayoutGuardPlotterGlyphsStayBesideTheAxes(t *testing.T) {
+	without := plot.New()
+	without.X.Min, without.X.Max, without.Y.Min, without.Y.Max = 0, 10, 0, 10
+	with := plot.New()
+	with.X.Min, with.X.Max, with.Y.Min, with.Y.Max = 0, 10, 0, 10
+	with.Add(glyphs{hglyph(0, -20, 25)})
+	c := layoutCanvas(300, 200)
+	a := without.DataCanvas(c).Rectangle
+	b := with.DataCanvas(c).Rectangle
+	if !near(b.Min.X, a.Min.X+20) {
+		t.Errorf("data area starts at %v, want %v", b.Min.X, a.Min.X+20)
+	}
+}
+
+func TestLayoutGuardFlatGlyphPadsOnlyVertically(t *testing.T) {
+	p := bareLayoutPlot(plot.GlyphBox{X: 0, Y: 1, Rectangle: vg.Rectangle{Min: vg.Point{X: -50, Y: -2}, Max: vg.Point{X: -50, Y: 12}}})
+	got := p.DataCanvas(layoutCanvas(200, 100)).Rectangle
+	checkRect(t, "data canvas", got, vg.Rectangle{Min: vg.Point{X: 0, Y: 0}, Max: vg.Point{X: 200, Y: 88}})
+}
