+/// Renders `module`'s resolved decorations (direct plus group-expanded, per
+/// [`dr::Module::resolve_decorations`]) as readable text, one line per decorated target and one
+/// per decorated target member, each decoration joined by `" | "`. Targets and members are
+/// listed in ascending id order; this does not affect the default `disassemble()` output, which
+/// still shows the raw, unresolved `OpDecorate`/`OpGroupDecorate` instructions as written.
+pub fn disassemble_decorations(module: &dr::Module) -> String {
+    let resolved = module.resolve_decorations();
+    let mut lines = Vec::new();
+    for target in resolved.decorated_targets() {
+        let entries = resolved.for_target(target);
+        lines.push(format!("%{}: {}", target, disas_join(entries, " | ")));
+    }
+    for (target, member) in resolved.decorated_members() {
+        let entries = resolved.for_member(target, member);
+        lines.push(format!(
+            "%{}.{}: {}",
+            target,
+            member,
+            disas_join(entries, " | ")
+        ));
+    }
+    for reference in resolved.unresolved() {
+        lines.push(format!("; unresolved: {}", disas_unresolved(reference)));
+    }
+    lines.join("\n")
+}
+
+fn disas_unresolved(reference: &dr::UnresolvedReference) -> String {
+    match reference {
+        dr::UnresolvedReference::UnknownGroup { group } => {
+            format!("group %{} is not a declared decoration group", group)
+        }
+        dr::UnresolvedReference::UnknownTarget { group, target } => {
+            format!("group %{} references undefined target %{}", group, target)
+        }
+        dr::UnresolvedReference::UnknownMemberTarget {
+            group,
+            target,
+            member,
+        } => format!(
+            "group %{} references undefined member %{}.{}",
+            group, target, member
+        ),
+    }
+}
