+// --- discard granularity (trap 1) ---
+
+#[test]
+fn dangling_middle_target_does_not_discard_the_others() {
+    let mut b = new_builder();
+    let first = b.type_void();
+    let dangling = b.id(); // never defined by any instruction
+    let third = b.type_bool();
+    let group = b.decoration_group();
+    b.decorate(group, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.group_decorate(group, vec![first, dangling, third]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.for_target(first),
+        &[plain_decorate(first, spirv::Decoration::RelaxedPrecision)]
+    );
+    assert_eq!(
+        resolved.for_target(third),
+        &[plain_decorate(third, spirv::Decoration::RelaxedPrecision)]
+    );
+    assert!(resolved.for_target(dangling).is_empty());
+    assert_eq!(
+        resolved.unresolved(),
+        &[dr::UnresolvedReference::UnknownTarget {
+            group,
+            target: dangling
+        }]
+    );
+}
+
+#[test]
+fn dangling_member_target_does_not_discard_the_others() {
+    let mut b = new_builder();
+    let first = b.type_void();
+    let dangling = b.id();
+    let group = b.decoration_group();
+    b.decorate(group, spirv::Decoration::Block, vec![]);
+    b.group_member_decorate(group, vec![(first, 0), (dangling, 1)]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.for_member(first, 0),
+        &[plain_member_decorate(first, 0, spirv::Decoration::Block)]
+    );
+    assert!(resolved.for_member(dangling, 1).is_empty());
+    assert_eq!(
+        resolved.unresolved(),
+        &[dr::UnresolvedReference::UnknownMemberTarget {
+            group,
+            target: dangling,
+            member: 1
+        }]
+    );
+}
