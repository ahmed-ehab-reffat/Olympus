+// --- cross-product (trap 2) ---
+
+#[test]
+fn group_used_via_both_group_decorate_and_group_member_decorate() {
+    let mut b = new_builder();
+    let whole_target = b.type_void();
+    let member_target = b.type_bool();
+    let group = b.decoration_group();
+    b.decorate(group, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.group_decorate(group, vec![whole_target]);
+    b.group_member_decorate(group, vec![(member_target, 5)]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.for_target(whole_target),
+        &[plain_decorate(whole_target, spirv::Decoration::RelaxedPrecision)]
+    );
+    assert_eq!(
+        resolved.for_member(member_target, 5),
+        &[plain_member_decorate(
+            member_target,
+            5,
+            spirv::Decoration::RelaxedPrecision
+        )]
+    );
+    // neither channel leaks into the other
+    assert!(resolved.for_member(whole_target, 5).is_empty());
+    assert!(resolved.for_target(member_target).is_empty());
+}
