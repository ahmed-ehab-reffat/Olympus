+use rspirv::dr;
+use rspirv::spirv;
+
+fn extra_decoration(operands: &[dr::Operand]) -> Vec<dr::Operand> {
+    operands.to_vec()
+}
+
+fn plain_decorate(target: spirv::Word, decoration: spirv::Decoration) -> dr::Instruction {
+    dr::Instruction::new(
+        spirv::Op::Decorate,
+        None,
+        None,
+        vec![dr::Operand::IdRef(target), dr::Operand::Decoration(decoration)],
+    )
+}
+
+fn plain_member_decorate(
+    target: spirv::Word,
+    member: u32,
+    decoration: spirv::Decoration,
+) -> dr::Instruction {
+    dr::Instruction::new(
+        spirv::Op::MemberDecorate,
+        None,
+        None,
+        vec![
+            dr::Operand::IdRef(target),
+            dr::Operand::LiteralBit32(member),
+            dr::Operand::Decoration(decoration),
+        ],
+    )
+}
+
+fn new_builder() -> dr::Builder {
+    let mut b = dr::Builder::new();
+    b.set_version(1, 0);
+    b.memory_model(spirv::AddressingModel::Logical, spirv::MemoryModel::Simple);
+    b
+}
+
+// --- direct decorations ---
+
+#[test]
+fn direct_decorate_visible_on_target() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.decorate(target, spirv::Decoration::RelaxedPrecision, vec![]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.for_target(target),
+        &[plain_decorate(target, spirv::Decoration::RelaxedPrecision)]
+    );
+}
+
+#[test]
+fn direct_member_decorate_visible_on_member() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.member_decorate(target, 2, spirv::Decoration::RelaxedPrecision, vec![]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.for_member(target, 2),
+        &[plain_member_decorate(target, 2, spirv::Decoration::RelaxedPrecision)]
+    );
+    assert!(resolved.for_member(target, 0).is_empty());
+}
