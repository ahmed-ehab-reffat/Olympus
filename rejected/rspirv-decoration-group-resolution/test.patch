+    b.decorate(group, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.group_decorate(group, vec![target]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(resolved.groups_contributing_to(target), &[group]);
+}
+
+#[test]
+fn target_reached_by_two_different_groups_lists_both() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    let group_a = b.decoration_group();
+    b.decorate(group_a, spirv::Decoration::RelaxedPrecision, vec![]);
+    let group_b = b.decoration_group();
+    b.decorate(group_b, spirv::Decoration::Block, vec![]);
+    b.group_decorate(group_a, vec![target]);
+    b.group_decorate(group_b, vec![target]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(resolved.groups_contributing_to(target), &[group_a, group_b]);
+}
+
+#[test]
+fn same_group_contributing_twice_is_listed_twice() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    let group = b.decoration_group();
+    b.decorate(group, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.group_decorate(group, vec![target]);
+    b.group_decorate(group, vec![target]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(resolved.groups_contributing_to(target), &[group, group]);
+}
+
+#[test]
+fn empty_group_contributes_no_entry_even_when_referenced() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    let group = b.decoration_group();
+    b.group_decorate(group, vec![target]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert!(resolved.groups_contributing_to(target).is_empty());
+    assert!(resolved.for_target(target).is_empty());
+}
+
+#[test]
+fn member_target_names_its_contributing_group() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    let group = b.decoration_group();
+    b.decorate(group, spirv::Decoration::Block, vec![]);
+    b.group_member_decorate(group, vec![(target, 4)]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(resolved.groups_contributing_to_member(target, 4), &[group]);
+    assert!(resolved.groups_contributing_to_member(target, 0).is_empty());
+}
+
+// --- enumeration and dedup views ---
+
+#[test]
+fn decorated_targets_lists_every_target_in_ascending_order() {
+    let mut b = new_builder();
+    let high = b.type_bool();
+    let low = b.type_void();
+    b.decorate(high, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.decorate(low, spirv::Decoration::RelaxedPrecision, vec![]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    let mut expected = vec![low, high];
+    expected.sort_unstable();
+    assert_eq!(resolved.decorated_targets(), expected);
+}
+
+#[test]
+fn decorated_members_lists_every_pair_sorted() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.member_decorate(target, 3, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.member_decorate(target, 1, spirv::Decoration::RelaxedPrecision, vec![]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(resolved.decorated_members(), vec![(target, 1), (target, 3)]);
+}
+
+#[test]
+fn unique_for_target_collapses_exact_duplicates_only() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.decorate(target, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.decorate(target, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.decorate(target, spirv::Decoration::Block, vec![]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.unique_for_target(target),
+        vec![
+            plain_decorate(target, spirv::Decoration::RelaxedPrecision),
+            plain_decorate(target, spirv::Decoration::Block),
+        ]
+    );
+}
+
+#[test]
+fn unique_for_target_does_not_collapse_conflicting_entries() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.decorate(
+        target,
+        spirv::Decoration::ArrayStride,
+        extra_decoration(&[dr::Operand::LiteralBit32(4)]),
+    );
+    b.decorate(
+        target,
+        spirv::Decoration::ArrayStride,
+        extra_decoration(&[dr::Operand::LiteralBit32(8)]),
+    );
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(resolved.unique_for_target(target).len(), 2);
+}
+
+#[test]
+fn unique_for_member_collapses_exact_duplicates() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.member_decorate(target, 0, spirv::Decoration::Block, vec![]);
+    b.member_decorate(target, 0, spirv::Decoration::Block, vec![]);
+    let module = b.module();
+
+    let resolved = module.resolve_decorations();
+    assert_eq!(
+        resolved.unique_for_member(target, 0),
+        vec![plain_member_decorate(target, 0, spirv::Decoration::Block)]
+    );
+}
+
+// --- decorations disassembly ---
+
+#[test]
+fn disassemble_decorations_renders_resolved_view_not_raw_annotations() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    let group = b.decoration_group();
+    b.decorate(group, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.group_decorate(group, vec![target]);
+    let module = b.module();
+
+    let text = rspirv::binary::disassemble_decorations(&module);
+    let mut ids = [target, group];
+    ids.sort_unstable();
+    let expected = ids
+        .iter()
+        .map(|id| format!("%{}: OpDecorate %{} RelaxedPrecision", id, id))
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert_eq!(text, expected);
+}
+
+#[test]
+fn disassemble_decorations_lists_members_after_targets() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.decorate(target, spirv::Decoration::Block, vec![]);
+    b.member_decorate(target, 0, spirv::Decoration::RelaxedPrecision, vec![]);
+    let module = b.module();
+
+    let text = rspirv::binary::disassemble_decorations(&module);
+    let lines: Vec<&str> = text.lines().collect();
+    assert_eq!(lines.len(), 2);
+    assert!(lines[0].starts_with(&format!("%{}:", target)));
+    assert!(lines[1].starts_with(&format!("%{}.0:", target)));
+}
+
+#[test]
+fn disassemble_decorations_appends_unresolved_references_as_comments() {
+    let mut b = new_builder();
+    let a = b.type_void();
+    let not_a_group = b.type_bool();
+    b.group_decorate(not_a_group, vec![a]);
+    let module = b.module();
+
+    let text = rspirv::binary::disassemble_decorations(&module);
+    assert!(text.contains(&format!(
+        "; unresolved: group %{} is not a declared decoration group",
+        not_a_group
+    )));
+}
+
+#[test]
+fn disassemble_decorations_does_not_affect_default_module_disassembly() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.decorate(target, spirv::Decoration::RelaxedPrecision, vec![]);
+    let module = b.module();
+
+    use rspirv::binary::Disassemble;
+    let default_text = module.disassemble();
+    assert!(default_text.contains("OpDecorate"));
+    let resolved_text = rspirv::binary::disassemble_decorations(&module);
+    assert!(!resolved_text.is_empty());
+}
+
+#[test]
+fn disassemble_decorations_joins_multiple_decorations_with_pipe() {
+    let mut b = new_builder();
+    let target = b.type_void();
+    b.decorate(target, spirv::Decoration::RelaxedPrecision, vec![]);
+    b.decorate(target, spirv::Decoration::Block, vec![]);
+    let module = b.module();
+
+    let text = rspirv::binary::disassemble_decorations(&module);
+    assert_eq!(
+        text,
+        format!(
+            "%{}: OpDecorate %{} RelaxedPrecision | OpDecorate %{} Block",
+            target, target, target
+        )
+    );
+}
