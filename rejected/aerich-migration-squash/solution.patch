     def get_all_version_files(cls) -> list[str]:
         return [m.name + ".py" for m in cls.get_all_version_modules()]
 
+    @staticmethod
+    def get_squashed_steps(module: ModuleType) -> list[MigrationStep] | None:
+        if (items := getattr(module, "SQUASHED_MIGRATIONS", None)) is None:
+            return None
+        return [
+            MigrationStep(version, upgrade_sql, downgrade_sql, decompress_dict(state))
+            for version, upgrade_sql, downgrade_sql, state in items
+        ]
+
+    @classmethod
+    def get_version_plan(cls) -> list[tuple[str, pkgutil.ModuleInfo, MigrationStep | None]]:
+        plan: list[tuple[str, pkgutil.ModuleInfo, MigrationStep | None]] = []
+        for version_module in cls.get_all_version_modules():
+            steps = cls.get_squashed_steps(import_py_module(version_module))
+            if steps is None:
+                plan.append((version_module.name + ".py", version_module, None))
+            else:
+                plan.extend((step.version, version_module, step) for step in steps)
+        return plan
+
+    @classmethod
+    async def read_migration_steps(
+        cls, version_module: pkgutil.ModuleInfo, connection: BaseDBAsyncClient
+    ) -> list[MigrationStep]:
+        module = import_py_module(version_module)
+        if (steps := cls.get_squashed_steps(module)) is not None:
+            return steps
+        if not (models_state := getattr(module, "MODELS_STATE", None)):
+            raise NotSupportError(
+                f"Migration file {version_module.name} has no MODELS_STATE, "
+                "run `aerich fix-migrations` first"
+            )
+        return [
+            MigrationStep(
+                version_module.name + ".py",
+                await module.upgrade(connection),
+                await module.downgrade(connection),
+                decompress_dict(models_state),
+            )
+        ]
+
+    @classmethod
+    def build_squashed_file_text(cls, steps: list[MigrationStep]) -> str:
+        text = cls.build_migration_file_text(
+            upgrade_sql="\n        ".join(s.upgrade_sql.strip() for s in steps),
+            downgrade_sql="\n        ".join(s.downgrade_sql.strip() for s in reversed(steps)),
+            models_state=steps[-1].models_state,
+        )
+        items = "".join(
+            f"    ({s.version!r}, {s.upgrade_sql!r}, {s.downgrade_sql!r}, "
+            f"{compress_dict(s.models_state)!r}),\n"
+            for s in steps
+        )
+        return f"{text}\nSQUASHED_MIGRATIONS = [\n{items}]\n"
+
     @classmethod
     def _get_model(cls, model: str) -> type[Model]:
         model_class = Tortoise.apps[cls.app].get(model)
