+        if start >= end or start not in modules or end not in modules:
+            raise DowngradeError(f"Cannot squash migrations {start} to {end}")
+        members = [m for number, m in modules.items() if start <= number <= end]
+        connection = get_app_connection(self.tortoise_config, self.app)
+        steps = [s for m in members for s in await Migrate.read_migration_steps(m, connection)]
+        entries = await self._applied_entries(Migrate.get_version_plan())
+        version = f"{end}_{datetime.now().strftime('%Y%m%d%H%M%S')}_{name}.py"
+        target = Path(Migrate.migrate_location, version)
