+func probeMoof(r io.ReadSeeker, bi *BoxInfo, trexes map[uint32]*Trex, decodeTimes map[uint32]uint64) (Segments, error) {
+	trafs, err := ExtractBox(r, bi, BoxPath{BoxTypeTraf()})
 	if err != nil {
 		return nil, err
 	}
+	segments := make(Segments, 0, len(trafs))
+	previousDataEnd, havePreviousData := uint64(0), false
+	for _, traf := range trafs {
+		bips, err := ExtractBoxesWithPayload(r, traf, []BoxPath{{BoxTypeTfhd()}, {BoxTypeTfdt()}, {BoxTypeTrun()}})
+		if err != nil {
+			return nil, err
+		}
+		var tfhd *Tfhd
+		var tfdt *Tfdt
+		truns := make([]*Trun, 0, len(bips))
+		for _, bip := range bips {
+			switch payload := bip.Payload.(type) {
+			case *Tfhd:
+				if tfhd != nil {
+					return nil, errors.New("duplicate tfhd")
+				}
+				tfhd = payload
+			case *Tfdt:
+				if tfdt != nil {
+					return nil, errors.New("duplicate tfdt")
+				}
+				tfdt = payload
+			case *Trun:
+				truns = append(truns, payload)
+			}
+		}
+		if tfhd == nil {
+			return nil, errors.New("tfhd not found")
+		}
+		segment := &Segment{TrackID: tfhd.TrackID, MoofOffset: bi.Offset, DefaultSampleDuration: tfhd.DefaultSampleDuration}
+		decodeTime := decodeTimes[tfhd.TrackID]
+		if tfdt != nil {
+			decodeTime = tfdt.GetBaseMediaDecodeTime()
+		}
+		segment.BaseMediaDecodeTime = decodeTime
+		base := bi.Offset
+		if tfhd.CheckFlag(TfhdBaseDataOffsetPresent) {
+			base = tfhd.BaseDataOffset
+		} else if !tfhd.CheckFlag(TfhdDefaultBaseIsMoof) && havePreviousData {
+			base = previousDataEnd
+		}
+		runEnd, haveRun := base, false
+		defaults := trexes[tfhd.TrackID]
+		if defaults == nil {
+			return nil, errors.New("trex not found")
+		}
+		for _, trun := range truns {
+			offset := base
+			if trun.CheckFlag(0x000001) {
+				value, err := presentationTime(base, int64(trun.DataOffset))
+				if err != nil || value < 0 {
+					return nil, errors.New("invalid fragment data offset")
+				}
+				offset = uint64(value)
+			} else if haveRun {
+				offset = runEnd
+			}
+			for i := range trun.Entries {
+				duration, size, flags := fragmentSampleFields(trun, tfhd, defaults, i)
+				compositionOffset := int64(0)
+				if trun.CheckFlag(0x000800) {
+					compositionOffset = trun.GetSampleCompositionTimeOffset(i)
+				}
+				presentation, err := presentationTime(decodeTime, compositionOffset)
+				if err != nil {
+					return nil, err
+				}
+				composition, err := presentationTime(uint64(segment.Duration), compositionOffset)
+				if err != nil || composition < math.MinInt32 || composition > math.MaxInt32 {
+					return nil, errors.New("fragment composition offset overflow")
+				}
+				if len(segment.Samples) == 0 || composition < int64(segment.CompositionTimeOffset) {
+					segment.CompositionTimeOffset = int32(composition)
+				}
+				sample := &Sample{Size: size, TimeDelta: duration, CompositionTimeOffset: compositionOffset,
+					Offset: offset, DecodeTime: decodeTime, PresentationTime: presentation,
+					IsSync: flags&0x00010000 == 0}
+				segment.Samples = append(segment.Samples, sample)
+				if segment.SampleCount == math.MaxUint32 || duration > math.MaxUint32-segment.Duration || size > math.MaxUint32-segment.Size {
+					return nil, errors.New("fragment aggregate overflow")
+				}
+				segment.SampleCount++
+				segment.Duration += duration
+				segment.Size += size
+				offset, err = addUint64(offset, uint64(size))
+				if err != nil {
+					return nil, err
+				}
+				decodeTime, err = addUint64(decodeTime, uint64(duration))
+				if err != nil {
+					return nil, err
+				}
+			}
+			runEnd, haveRun = offset, true
+		}
+		previousDataEnd, havePreviousData = runEnd, true
+		decodeTimes[tfhd.TrackID] = decodeTime
+		segments = append(segments, segment)
+	}
+	return segments, nil
+}
 
