+func TestClassicSampleLocationsAndTiming(t *testing.T) {
+	data, media := buildClassic(t, classicOptions{})
+	info, err := mp4.Probe(&guardedReadSeeker{Reader: bytes.NewReader(data), media: media})
+	require.NoError(t, err)
+	require.Len(t, info.Tracks, 1)
+	samples := info.Tracks[0].Samples
+	require.Len(t, samples, 3)
+
+	assert.Equal(t, []uint64{8, 12, 24}, []uint64{samples[0].Offset, samples[1].Offset, samples[2].Offset})
+	assert.Equal(t, []uint32{4, 4, 4}, []uint32{samples[0].Size, samples[1].Size, samples[2].Size})
+	assert.Equal(t, []uint64{0, 5, 10}, []uint64{samples[0].DecodeTime, samples[1].DecodeTime, samples[2].DecodeTime})
+	assert.Equal(t, []int64{-3, 7, 12}, []int64{samples[0].PresentationTime, samples[1].PresentationTime, samples[2].PresentationTime})
+	assert.Equal(t, []int64{-3, 2, 2}, []int64{samples[0].CompositionTimeOffset, samples[1].CompositionTimeOffset, samples[2].CompositionTimeOffset})
+	for _, sample := range samples {
+		assert.True(t, sample.IsSync)
+	}
+	assert.Equal(t, "AAAA", string(data[samples[0].Offset:samples[0].Offset+uint64(samples[0].Size)]))
+	assert.Equal(t, "BBBB", string(data[samples[1].Offset:samples[1].Offset+uint64(samples[1].Size)]))
+	assert.Equal(t, "CCCC", string(data[samples[2].Offset:samples[2].Offset+uint64(samples[2].Size)]))
+}
