+func TestFragmentStatesAreIndependent(t *testing.T) {
+	data, _, mediaStart, _ := buildFragmented(t, fragmentOptions{})
+	info, err := mp4.Probe(bytes.NewReader(data))
+	require.NoError(t, err)
+	t.Run("traf ownership", func(t *testing.T) {
+		assert.Equal(t, []uint32{1, 2, 1}, []uint32{info.Segments[0].TrackID, info.Segments[1].TrackID, info.Segments[2].TrackID})
+	})
+	t.Run("all runs", func(t *testing.T) {
+		assert.Equal(t, []uint32{3, 10, 7}, []uint32{info.Segments[0].SampleCount, info.Segments[0].Duration, info.Segments[0].Size})
+	})
+	t.Run("first flags scope", func(t *testing.T) {
+		assert.Equal(t, []bool{true, false}, []bool{info.Segments[0].Samples[0].IsSync, info.Segments[0].Samples[1].IsSync})
+	})
+	t.Run("signed offset", func(t *testing.T) { assert.Equal(t, mediaStart, info.Segments[0].Samples[0].Offset) })
+	t.Run("track time continuation", func(t *testing.T) {
+		assert.Equal(t, []uint64{0, 110}, []uint64{info.Segments[1].Samples[0].DecodeTime, info.Segments[2].Samples[0].DecodeTime})
+	})
+	t.Run("trex defaults", func(t *testing.T) {
+		assert.Equal(t, []uint32{5, 2}, []uint32{info.Segments[1].Samples[0].TimeDelta, info.Segments[1].Samples[0].Size})
+	})
+}
+
+func TestExplicitFragmentBaseDataOffset(t *testing.T) {
+	data, media, mediaStart, firstMoof := buildFragmented(t, fragmentOptions{explicitBase: true})
+	info, err := mp4.Probe(&guardedReadSeeker{Reader: bytes.NewReader(data), media: media})
+	require.NoError(t, err)
+	require.NotEmpty(t, info.Segments)
+	first := info.Segments[0]
+	assert.Equal(t, firstMoof, first.MoofOffset)
+	require.Len(t, first.Samples, 3)
+	assert.Equal(t, []uint64{mediaStart, mediaStart + 2, mediaStart + 4}, []uint64{first.Samples[0].Offset, first.Samples[1].Offset, first.Samples[2].Offset})
+}
+
+func TestClassicContradictionsReturnNil(t *testing.T) {
+	cases := []struct {
+		name    string
+		options classicOptions
+	}{
+		{name: "stts count", options: classicOptions{badTiming: true}},
+		{name: "ctts count", options: classicOptions{badComposition: true}},
+		{name: "bad first chunk", options: classicOptions{badSTSC: "first"}},
+		{name: "descending chunks", options: classicOptions{badSTSC: "descending"}},
+		{name: "uncovered samples", options: classicOptions{badSTSC: "uncovered"}},
+		{name: "extra samples", options: classicOptions{badSTSC: "extra"}},
+		{name: "zero sync index", options: classicOptions{syncSamples: []uint32{0}}},
+		{name: "duplicate sync index", options: classicOptions{syncSamples: []uint32{1, 1}}},
+		{name: "large sync index", options: classicOptions{syncSamples: []uint32{4}}},
+		{name: "offset overflow", options: classicOptions{overflowOffset: true}},
+		{name: "sample outside media", options: classicOptions{outsideOffset: true}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			tc.options.prependValid = true
+			data, _ := buildClassic(t, tc.options)
+			info, err := mp4.Probe(bytes.NewReader(data))
+			assert.Error(t, err)
+			assert.Nil(t, info)
+		})
+	}
+}
+
+func TestOutOfMediaRangeReturnsNil(t *testing.T) {
