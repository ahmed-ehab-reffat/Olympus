+type fragmentOptions struct {
+	duplicateTFHD bool
+	duplicateTFDT bool
+	explicitBase  bool
+	underflow     bool
+	shortMedia    bool
+	unresolved    bool
+	timeOverflow  bool
+	sizeOverflow  bool
+	zeroTrack2    bool
+}
+
+func writeTrex(t *testing.T, w *mp4.Writer, trackID, duration, size, flags uint32) {
+	writeBox(t, w, &mp4.Trex{TrackID: trackID, DefaultSampleDescriptionIndex: 1, DefaultSampleDuration: duration, DefaultSampleSize: size, DefaultSampleFlags: flags})
+}
+
+func buildFragmented(t *testing.T, options fragmentOptions) ([]byte, []byteRange, uint64, uint64) {
+	t.Helper()
+	f, w := newOutput(t)
+	payload := []byte("ABCDEFGHIJKLM")
+	if options.shortMedia {
+		payload = payload[:12]
+	}
+	mdat := startBox(t, w, mp4.BoxTypeMdat())
+	_, err := w.Write(payload)
+	require.NoError(t, err)
+	mdat = endBox(t, w)
+	mediaStart := mdat.Offset + mdat.HeaderSize
+
+	writeContainer(t, w, mp4.BoxTypeMoov(), func() {
+		writeContainer(t, w, mp4.BoxTypeMvex(), func() {
+			writeTrex(t, w, 1, 11, 2, 0x00010000)
+			if !options.unresolved {
+				writeTrex(t, w, 2, 5, 2, 0)
+			}
+		})
+	})
+
+	firstMoof := startBox(t, w, mp4.BoxTypeMoof())
+	writeContainer(t, w, mp4.BoxTypeTraf(), func() {
+		tfhd := &mp4.Tfhd{TrackID: 1, DefaultSampleDuration: 3, DefaultSampleSize: 2, DefaultSampleFlags: 0x00010000}
+		flags := uint32(mp4.TfhdDefaultSampleDurationPresent | mp4.TfhdDefaultSampleSizePresent | mp4.TfhdDefaultSampleFlagsPresent)
+		if options.explicitBase {
+			tfhd.BaseDataOffset = mediaStart
+			flags |= mp4.TfhdBaseDataOffsetPresent
+		} else {
+			flags |= mp4.TfhdDefaultBaseIsMoof
+		}
+		tfhd.SetFlags(flags)
+		writeBox(t, w, tfhd)
+		if options.duplicateTFHD {
+			writeBox(t, w, tfhd)
+		}
+		tfdt := &mp4.Tfdt{BaseMediaDecodeTimeV0: 100}
+		if options.timeOverflow {
+			tfdt.SetVersion(1)
+			tfdt.BaseMediaDecodeTimeV1 = math.MaxUint64
+		}
+		writeBox(t, w, tfdt)
+		if options.duplicateTFDT {
+			writeBox(t, w, &mp4.Tfdt{BaseMediaDecodeTimeV0: 100})
+		}
+		dataOffset := int32(mediaStart) - int32(firstMoof.Offset)
+		if options.explicitBase {
+			dataOffset = 0
+		}
+		if options.underflow {
+			dataOffset = math.MinInt32
+		}
+		firstRun := &mp4.Trun{SampleCount: 2, DataOffset: dataOffset, FirstSampleFlags: 0, Entries: make([]mp4.TrunEntry, 2)}
+		firstRun.SetFlags(0x000001 | 0x000004)
+		writeBox(t, w, firstRun)
+		secondRun := &mp4.Trun{SampleCount: 1, Entries: []mp4.TrunEntry{{SampleDuration: 4, SampleSize: 3, SampleFlags: 0, SampleCompositionTimeOffsetV1: -9}}}
+		if options.sizeOverflow {
+			secondRun.Entries[0].SampleSize = math.MaxUint32
+		}
+		secondRun.SetVersion(1)
+		secondRun.SetFlags(0x000100 | 0x000200 | 0x000400 | 0x000800)
+		writeBox(t, w, secondRun)
+	})
+	writeContainer(t, w, mp4.BoxTypeTraf(), func() {
+		writeBox(t, w, &mp4.Tfhd{TrackID: 2})
+		count := uint32(2)
+		if options.zeroTrack2 {
+			count = 0
+		}
+		run := &mp4.Trun{SampleCount: count, Entries: make([]mp4.TrunEntry, count)}
+		writeBox(t, w, run)
+	})
+	endBox(t, w)
+
+	secondMoof := startBox(t, w, mp4.BoxTypeMoof())
+	writeContainer(t, w, mp4.BoxTypeTraf(), func() {
+		tfhd := &mp4.Tfhd{TrackID: 1}
+		tfhd.SetFlags(mp4.TfhdDefaultBaseIsMoof)
+		writeBox(t, w, tfhd)
+		run := &mp4.Trun{SampleCount: 1, DataOffset: int32(mediaStart+11) - int32(secondMoof.Offset), Entries: make([]mp4.TrunEntry, 1)}
+		run.SetFlags(0x000001)
+		writeBox(t, w, run)
+	})
+	endBox(t, w)
+
+	return outputBytes(t, f), []byteRange{{start: int64(mediaStart), end: int64(mdat.Offset + mdat.Size)}}, mediaStart, firstMoof.Offset
+}
+
+func TestFragmentSampleOwnershipDefaultsAndContinuation(t *testing.T) {
+	data, media, mediaStart, firstMoof := buildFragmented(t, fragmentOptions{})
+	info, err := mp4.Probe(&guardedReadSeeker{Reader: bytes.NewReader(data), media: media})
+	require.NoError(t, err)
+	require.Len(t, info.Segments, 3)
+	assert.Equal(t, []uint32{1, 2, 1}, []uint32{info.Segments[0].TrackID, info.Segments[1].TrackID, info.Segments[2].TrackID})
+
+	first := info.Segments[0]
+	assert.Equal(t, uint32(3), first.SampleCount)
+	assert.Equal(t, uint32(10), first.Duration)
+	assert.Equal(t, uint32(7), first.Size)
+	assert.Equal(t, uint64(100), first.BaseMediaDecodeTime)
+	assert.Equal(t, firstMoof, first.MoofOffset)
+	assert.Equal(t, int32(-3), first.CompositionTimeOffset)
+	require.Len(t, first.Samples, 3)
+	assert.Equal(t, []uint64{mediaStart, mediaStart + 2, mediaStart + 4}, []uint64{first.Samples[0].Offset, first.Samples[1].Offset, first.Samples[2].Offset})
+	assert.Equal(t, []uint64{100, 103, 106}, []uint64{first.Samples[0].DecodeTime, first.Samples[1].DecodeTime, first.Samples[2].DecodeTime})
+	assert.Equal(t, []int64{100, 103, 97}, []int64{first.Samples[0].PresentationTime, first.Samples[1].PresentationTime, first.Samples[2].PresentationTime})
+	assert.True(t, first.Samples[0].IsSync)
+	assert.False(t, first.Samples[1].IsSync)
+	assert.True(t, first.Samples[2].IsSync)
+
+	second := info.Segments[1]
+	require.Len(t, second.Samples, 2)
+	assert.Equal(t, []uint64{mediaStart + 7, mediaStart + 9}, []uint64{second.Samples[0].Offset, second.Samples[1].Offset})
+	assert.Equal(t, []uint64{0, 5}, []uint64{second.Samples[0].DecodeTime, second.Samples[1].DecodeTime})
+	assert.True(t, second.Samples[0].IsSync)
+	assert.True(t, second.Samples[1].IsSync)
+
+	third := info.Segments[2]
+	require.Len(t, third.Samples, 1)
+	assert.Equal(t, mediaStart+11, third.Samples[0].Offset)
+	assert.Equal(t, uint64(110), third.BaseMediaDecodeTime)
+	assert.Equal(t, uint64(110), third.Samples[0].DecodeTime)
+	assert.False(t, third.Samples[0].IsSync)
+	assert.Equal(t, "LM", string(data[third.Samples[0].Offset:third.Samples[0].Offset+uint64(third.Samples[0].Size)]))
+}
