+type byteRange struct {
+	start int64
+	end   int64
+}
+
+type guardedReadSeeker struct {
+	*bytes.Reader
+	media []byteRange
+}
+
+func (r *guardedReadSeeker) Read(p []byte) (int, error) {
+	pos, err := r.Seek(0, io.SeekCurrent)
+	if err != nil {
+		return 0, err
+	}
+	for _, media := range r.media {
+		if pos < media.end && pos+int64(len(p)) > media.start {
+			return 0, errors.New("media payload read")
+		}
+	}
+	return r.Reader.Read(p)
+}
+
+func startBox(t *testing.T, w *mp4.Writer, typ mp4.BoxType) *mp4.BoxInfo {
+	t.Helper()
+	bi, err := w.StartBox(&mp4.BoxInfo{Type: typ})
+	require.NoError(t, err)
+	return bi
+}
+
+func endBox(t *testing.T, w *mp4.Writer) *mp4.BoxInfo {
+	t.Helper()
+	bi, err := w.EndBox()
+	require.NoError(t, err)
+	return bi
+}
+
+func writeBox(t *testing.T, w *mp4.Writer, box mp4.IImmutableBox) *mp4.BoxInfo {
+	t.Helper()
+	startBox(t, w, box.GetType())
+	_, err := mp4.Marshal(w, box, mp4.Context{})
+	require.NoError(t, err)
+	return endBox(t, w)
+}
+
+func writeContainer(t *testing.T, w *mp4.Writer, typ mp4.BoxType, children func()) *mp4.BoxInfo {
+	t.Helper()
+	startBox(t, w, typ)
+	children()
+	return endBox(t, w)
+}
+
+func newOutput(t *testing.T) (*os.File, *mp4.Writer) {
+	t.Helper()
+	f, err := os.CreateTemp(t.TempDir(), "samples-*.mp4")
+	require.NoError(t, err)
+	return f, mp4.NewWriter(f)
+}
+
+func outputBytes(t *testing.T, f *os.File) []byte {
+	t.Helper()
+	_, err := f.Seek(0, io.SeekStart)
+	require.NoError(t, err)
+	data, err := io.ReadAll(f)
+	require.NoError(t, err)
+	require.NoError(t, f.Close())
+	return data
+}
