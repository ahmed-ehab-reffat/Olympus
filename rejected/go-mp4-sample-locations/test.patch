diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..a6b16a2
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+
+set -u
+
+mode=""
+output_path=""
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        base|new)
+            if [ -n "$mode" ]; then
+                echo "mode specified more than once" >&2
+                exit 2
+            fi
+            mode="$1"
+            shift
+            ;;
+        --output_path)
+            if [ "$#" -lt 2 ]; then
+                echo "--output_path requires a path" >&2
+                exit 2
+            fi
+            output_path="$2"
+            shift 2
+            ;;
+        --output_path=*)
+            output_path="${1#*=}"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [ -z "$mode" ] || [ -z "$output_path" ]; then
+    echo "usage: ./test.sh [--output_path PATH] {base|new}" >&2
+    exit 2
+fi
+
+rm -f "$output_path"
+status=0
+if [ "$mode" = "base" ]; then
+    gotestsum --junitfile "$output_path" -- -count=1 ./... || status=$?
+else
+    gotestsum --junitfile "$output_path" -- -count=1 -tags samplelocations ./grader_tests || status=$?
+fi
+
+if [ ! -s "$output_path" ]; then
+    printf '%s\n' '<?xml version="1.0" encoding="UTF-8"?><testsuites tests="1" failures="1"><testsuite name="setup" tests="1" failures="1"><testcase name="runner"><failure message="test runner did not produce a report"/></testcase></testsuite></testsuites>' > "$output_path"
+    if [ "$status" -eq 0 ]; then
+        status=1
+    fi
+fi
+
+exit "$status"
