+type classicOptions struct {
+	badTiming      bool
+	badComposition bool
+	badSTSC        string
+	syncSamples    []uint32
+	overflowOffset bool
+	outsideOffset  bool
+	prependValid   bool
+}
+
+func writeClassicTrack(t *testing.T, w *mp4.Writer, trackID uint32, offsets []uint64, options classicOptions) {
+	writeContainer(t, w, mp4.BoxTypeTrak(), func() {
+		writeBox(t, w, &mp4.Tkhd{TrackID: trackID})
+		writeContainer(t, w, mp4.BoxTypeMdia(), func() {
+			writeBox(t, w, &mp4.Mdhd{Timescale: 1000, DurationV0: 17})
+			writeContainer(t, w, mp4.BoxTypeMinf(), func() {
+				writeContainer(t, w, mp4.BoxTypeStbl(), func() {
+					co64 := &mp4.Co64{EntryCount: 2, ChunkOffset: append([]uint64(nil), offsets...)}
+					if options.overflowOffset {
+						co64.ChunkOffset[0] = math.MaxUint64 - 1
+					} else if options.outsideOffset {
+						co64.ChunkOffset[0] += 1000
+					}
+					writeBox(t, w, co64)
+					stts := &mp4.Stts{EntryCount: 2, Entries: []mp4.SttsEntry{{SampleCount: 2, SampleDelta: 5}, {SampleCount: 1, SampleDelta: 7}}}
+					if options.badTiming {
+						stts.EntryCount = 1
+						stts.Entries = stts.Entries[:1]
+					}
+					writeBox(t, w, stts)
+					ctts := &mp4.Ctts{EntryCount: 2, Entries: []mp4.CttsEntry{{SampleCount: 1, SampleOffsetV1: -3}, {SampleCount: 2, SampleOffsetV1: 2}}}
+					ctts.SetVersion(1)
+					if options.badComposition {
+						ctts.Entries[1].SampleCount = 1
+					}
+					writeBox(t, w, ctts)
+					stsc := &mp4.Stsc{EntryCount: 2, Entries: []mp4.StscEntry{{FirstChunk: 1, SamplesPerChunk: 2, SampleDescriptionIndex: 1}, {FirstChunk: 2, SamplesPerChunk: 1, SampleDescriptionIndex: 1}}}
+					switch options.badSTSC {
+					case "first":
+						stsc.Entries[0].FirstChunk = 2
+					case "descending":
+						stsc.Entries[1].FirstChunk = 1
+					case "uncovered":
+						stsc.EntryCount = 1
+						stsc.Entries = []mp4.StscEntry{{FirstChunk: 1, SamplesPerChunk: 1, SampleDescriptionIndex: 1}}
+					case "extra":
+						stsc.EntryCount = 1
+						stsc.Entries = []mp4.StscEntry{{FirstChunk: 1, SamplesPerChunk: 2, SampleDescriptionIndex: 1}}
+					}
+					writeBox(t, w, stsc)
+					stsz := &mp4.Stsz{SampleSize: 4, SampleCount: 3}
+					writeBox(t, w, stsz)
+					if options.syncSamples != nil {
+						writeBox(t, w, &mp4.Stss{EntryCount: uint32(len(options.syncSamples)), SampleNumber: options.syncSamples})
+					}
+				})
+			})
+		})
+	})
+}
+
+func buildClassic(t *testing.T, options classicOptions) ([]byte, []byteRange) {
+	t.Helper()
+	f, w := newOutput(t)
+	first := startBox(t, w, mp4.BoxTypeMdat())
+	_, err := w.Write([]byte("AAAABBBB"))
+	require.NoError(t, err)
+	first = endBox(t, w)
+	second := startBox(t, w, mp4.BoxTypeMdat())
+	_, err = w.Write([]byte("CCCC"))
+	require.NoError(t, err)
+	second = endBox(t, w)
+	offsets := []uint64{first.Offset + first.HeaderSize, second.Offset + second.HeaderSize}
+	writeContainer(t, w, mp4.BoxTypeMoov(), func() {
+		if options.prependValid {
+			writeClassicTrack(t, w, 1, offsets, classicOptions{})
+		}
+		writeClassicTrack(t, w, 2, offsets, options)
+	})
+	return outputBytes(t, f), []byteRange{
+		{start: int64(first.Offset + first.HeaderSize), end: int64(first.Offset + first.Size)},
+		{start: int64(second.Offset + second.HeaderSize), end: int64(second.Offset + second.Size)},
+	}
+}
+
+func buildClassicWithTrailingMedia(t *testing.T) ([]byte, []byteRange, uint64) {
+	t.Helper()
+	f, w := newOutput(t)
+	var co64 *mp4.BoxInfo
+	writeContainer(t, w, mp4.BoxTypeMoov(), func() {
+		writeContainer(t, w, mp4.BoxTypeTrak(), func() {
+			writeBox(t, w, &mp4.Tkhd{TrackID: 1})
+			writeContainer(t, w, mp4.BoxTypeMdia(), func() {
+				writeBox(t, w, &mp4.Mdhd{Timescale: 1000, DurationV0: 5})
+				writeContainer(t, w, mp4.BoxTypeMinf(), func() {
+					writeContainer(t, w, mp4.BoxTypeStbl(), func() {
+						co64 = writeBox(t, w, &mp4.Co64{EntryCount: 1, ChunkOffset: []uint64{0}})
+						writeBox(t, w, &mp4.Stts{EntryCount: 1, Entries: []mp4.SttsEntry{{SampleCount: 1, SampleDelta: 5}}})
+						writeBox(t, w, &mp4.Stsc{EntryCount: 1, Entries: []mp4.StscEntry{{FirstChunk: 1, SamplesPerChunk: 1, SampleDescriptionIndex: 1}}})
+						writeBox(t, w, &mp4.Stsz{SampleSize: 4, SampleCount: 1})
+					})
+				})
+			})
+		})
+	})
+	mdat := startBox(t, w, mp4.BoxTypeMdat())
+	_, err := w.Write([]byte("TAIL"))
+	require.NoError(t, err)
+	mdat = endBox(t, w)
+	data := outputBytes(t, f)
+	mediaStart := mdat.Offset + mdat.HeaderSize
+	entryOffset := co64.Offset + co64.HeaderSize + 8
+	binary.BigEndian.PutUint64(data[entryOffset:entryOffset+8], mediaStart)
+	return data, []byteRange{{start: int64(mediaStart), end: int64(mdat.Offset + mdat.Size)}}, mediaStart
+}
+
+func buildEmptyClassic(t *testing.T) []byte {
+	t.Helper()
+	f, w := newOutput(t)
+	writeContainer(t, w, mp4.BoxTypeMoov(), func() {
+		writeContainer(t, w, mp4.BoxTypeTrak(), func() {
+			writeBox(t, w, &mp4.Tkhd{TrackID: 1})
+			writeContainer(t, w, mp4.BoxTypeMdia(), func() {
+				writeBox(t, w, &mp4.Mdhd{Timescale: 1000})
+				writeContainer(t, w, mp4.BoxTypeMinf(), func() {
+					writeContainer(t, w, mp4.BoxTypeStbl(), func() {
+						writeBox(t, w, &mp4.Co64{})
+						writeBox(t, w, &mp4.Stts{})
+						writeBox(t, w, &mp4.Stsc{})
+						writeBox(t, w, &mp4.Stsz{})
+					})
+				})
+			})
+		})
+	})
+	return outputBytes(t, f)
+}
