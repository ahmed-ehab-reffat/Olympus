+}
+
+func TestFragmentContradictionsReturnNil(t *testing.T) {
+	cases := []struct {
+		name    string
+		options fragmentOptions
+	}{
+		{name: "duplicate tfhd", options: fragmentOptions{duplicateTFHD: true}},
+		{name: "duplicate tfdt", options: fragmentOptions{duplicateTFDT: true}},
+		{name: "signed offset underflow", options: fragmentOptions{underflow: true}},
+		{name: "sample outside media", options: fragmentOptions{shortMedia: true}},
