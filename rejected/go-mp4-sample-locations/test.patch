+func TestExistingFragmentedFixture(t *testing.T) {
+	f, err := os.Open("../testdata/sample_fragmented.mp4")
+	require.NoError(t, err)
+	defer f.Close()
+	info, err := mp4.Probe(f)
+	require.NoError(t, err)
+	require.Len(t, info.Segments, 8)
+	for _, segment := range info.Segments {
+		assert.Len(t, segment.Samples, int(segment.SampleCount))
+		var duration, size uint32
+		for _, sample := range segment.Samples {
+			duration += sample.TimeDelta
+			size += sample.Size
+		}
+		assert.Equal(t, segment.Duration, duration)
+		assert.Equal(t, segment.Size, size)
+	}
+	assert.Equal(t, uint64(1363), info.Segments[0].Samples[0].Offset)
+	assert.Equal(t, uint64(0), info.Segments[0].Samples[0].DecodeTime)
+	assert.Equal(t, int64(18000), info.Segments[0].Samples[0].PresentationTime)
+}
