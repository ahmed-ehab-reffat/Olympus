+func TestClassicSyncTable(t *testing.T) {
+	data, _ := buildClassic(t, classicOptions{syncSamples: []uint32{1, 3}})
+	info, err := mp4.Probe(bytes.NewReader(data))
+	require.NoError(t, err)
+	assert.True(t, info.Tracks[0].Samples[0].IsSync)
+	assert.False(t, info.Tracks[0].Samples[1].IsSync)
+	assert.True(t, info.Tracks[0].Samples[2].IsSync)
+}
+
+func TestClassicFieldsAreDerivedIndependently(t *testing.T) {
+	data, _ := buildClassic(t, classicOptions{})
+	info, err := mp4.Probe(bytes.NewReader(data))
+	require.NoError(t, err)
+	samples := info.Tracks[0].Samples
+	t.Run("constant sizes", func(t *testing.T) {
+		assert.Equal(t, []uint32{4, 4, 4}, []uint32{samples[0].Size, samples[1].Size, samples[2].Size})
+	})
+	t.Run("signed composition", func(t *testing.T) { assert.Equal(t, int64(-3), samples[0].PresentationTime) })
+	t.Run("default sync", func(t *testing.T) { assert.True(t, samples[1].IsSync) })
+	t.Run("chunk accumulation", func(t *testing.T) { assert.Equal(t, samples[0].Offset+4, samples[1].Offset) })
+}
