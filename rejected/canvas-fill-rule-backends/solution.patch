+// FillGeometry returns the path a renderer should emit so that filling the result with the NonZero
+// rule paints exactly the area that fillRule selects on p. Native fill rules are returned unchanged
+// so that renderers keep emitting the format's own fill rule for them.
+func (p *Path) FillGeometry(fillRule FillRule) *Path {
+	if fillRule.Native() {
+		return p
+	}
+	return p.Settle(fillRule)
