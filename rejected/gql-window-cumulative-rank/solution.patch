+fn ordering_keys_equal(left: &[Box<dyn Value>], right: &[Box<dyn Value>]) -> bool {
+    left.len() == right.len()
+        && left
+            .iter()
+            .zip(right)
+            .all(|(left, right)| left.equals(right))
+}
+
+fn broadcast_rank(frame_len: usize, rank: i64) -> Vec<Box<dyn Value>> {
+    let mut values: Vec<Box<dyn Value>> = Vec::with_capacity(frame_len);
+    for _ in 0..frame_len {
+        values.push(Box::new(IntValue { value: rank }));
+    }
+    values
+}
+
+fn count_trailing_tied(frame: &[Vec<Box<dyn Value>>], current_key: &[Box<dyn Value>]) -> usize {
+    let mut tied = 0usize;
+    for row in frame.iter().rev() {
+        if ordering_keys_equal(row, current_key) {
+            tied += 1;
+        } else {
+            break;
+        }
+    }
+    tied
+}
+
+fn count_distinct_groups_before(
+    frame: &[Vec<Box<dyn Value>>],
+    current_key: &[Box<dyn Value>],
+) -> i64 {
+    let frame_len = frame.len();
+    let mut distinct_lesser = 0i64;
+    let mut index = 0;
+    while index < frame_len {
+        let group_key = &frame[index];
+        if ordering_keys_equal(group_key, current_key) {
+            break;
+        }
+
+        distinct_lesser += 1;
+        index += 1;
+        while index < frame_len && ordering_keys_equal(&frame[index], group_key) {
+            index += 1;
+        }
+    }
+    distinct_lesser
+}
+
+pub fn window_rank(frame: &[Vec<Box<dyn Value>>]) -> Vec<Box<dyn Value>> {
+    let frame_len = frame.len();
+    let current_key = &frame[frame_len - 1];
+    let tied = count_trailing_tied(frame, current_key);
+    let rank = (frame_len - tied + 1) as i64;
+    broadcast_rank(frame_len, rank)
+}
+
+pub fn window_dense_rank(frame: &[Vec<Box<dyn Value>>]) -> Vec<Box<dyn Value>> {
+    let frame_len = frame.len();
+    let current_key = &frame[frame_len - 1];
+    let rank = count_distinct_groups_before(frame, current_key) + 1;
+    broadcast_rank(frame_len, rank)
+}
+
+fn ranks_within_partition(frame: &[Vec<Box<dyn Value>>]) -> Vec<i64> {
+    let frame_len = frame.len();
+    let mut ranks: Vec<i64> = Vec::with_capacity(frame_len);
+    let mut index = 0;
+    while index < frame_len {
+        let group_key = &frame[index];
+        let mut group_end = index + 1;
+        while group_end < frame_len && ordering_keys_equal(&frame[group_end], group_key) {
+            group_end += 1;
+        }
+
+        let rank = index as i64 + 1;
+        for _ in index..group_end {
+            ranks.push(rank);
+        }
+        index = group_end;
+    }
+    ranks
+}
+
+pub fn window_percent_rank(frame: &[Vec<Box<dyn Value>>]) -> Vec<Box<dyn Value>> {
+    let frame_len = frame.len();
+    let ranks = ranks_within_partition(frame);
+    let mut values: Vec<Box<dyn Value>> = Vec::with_capacity(frame_len);
+    for rank in ranks {
+        let percent = if frame_len <= 1 {
+            0.0
+        } else {
+            (rank - 1) as f64 / (frame_len - 1) as f64
+        };
+        values.push(Box::new(FloatValue::new(percent)));
+    }
+    values
+}
+
+pub fn window_cume_dist(frame: &[Vec<Box<dyn Value>>]) -> Vec<Box<dyn Value>> {
+    let frame_len = frame.len();
+    let mut values: Vec<Box<dyn Value>> = Vec::with_capacity(frame_len);
+    let mut index = 0;
+    while index < frame_len {
+        let group_key = &frame[index];
+        let mut group_end = index + 1;
+        while group_end < frame_len && ordering_keys_equal(&frame[group_end], group_key) {
+            group_end += 1;
+        }
+
+        let dist = group_end as f64 / frame_len as f64;
+        for _ in index..group_end {
+            values.push(Box::new(FloatValue::new(dist)));
+        }
+        index = group_end;
+    }
+    values
+}
