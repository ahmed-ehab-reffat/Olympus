+// Row at position `row_index` is evaluated against rows `0..=row_index` of the ordered partition
+#[allow(clippy::too_many_arguments)]
+fn apply_cumulative_window_function(
+    env: &mut Environment,
+    gitql_object: &mut GitQLObject,
+    frame_index: usize,
+    partition_len: usize,
+    column_index: usize,
+    function: &WindowFunction,
+    is_order_key_function: bool,
+) -> Result<(), String> {
+    for row_index in 0..partition_len {
+        let frame_values = build_frame_values(
+            env,
+            gitql_object,
+            frame_index,
+            0,
+            row_index + 1,
+            function,
+            is_order_key_function,
+        )?;
+
+        if frame_values.is_empty() {
+            continue;
+        }
+
+        let result_value = evaluate_window_frame(env, function, &frame_values);
+        let target_row = &mut gitql_object.groups[frame_index].rows[row_index];
+        target_row.values[column_index] = result_value;
+    }
+
+    Ok(())
+}
+
+// Evaluated once against the whole partition and broadcast to every row. Used both for the
+// pre-cumulative broadcast behavior (no ORDER BY) and for order-key functions whose result
+// depends on the full partition size, not just the rows up to the current one
+#[allow(clippy::too_many_arguments)]
+fn apply_whole_partition_window_function(
+    env: &mut Environment,
+    gitql_object: &mut GitQLObject,
+    frame_index: usize,
+    partition_len: usize,
+    column_index: usize,
+    function: &WindowFunction,
+    is_order_key_function: bool,
+) -> Result<(), String> {
+    let frame_values = build_frame_values(
+        env,
+        gitql_object,
+        frame_index,
+        0,
+        partition_len,
+        function,
+        is_order_key_function,
+    )?;
+
+    if frame_values.is_empty() {
+        return Ok(());
+    }
+
+    match function.kind {
+        WindowFunctionKind::AggregatedWindowFunction => {
+            let aggregation_function = env.aggregation_function(&function.function_name).unwrap();
+            let aggregated_value = aggregation_function(&frame_values);
+            for row in gitql_object.groups[frame_index].rows.iter_mut() {
+                row.values[column_index] = aggregated_value.clone();
+            }
+        }
+        WindowFunctionKind::PureWindowFunction => {
+            let window_function = env.window_function(&function.function_name).unwrap();
+            let window_values = window_function(&frame_values);
+            for (index, value) in window_values.into_iter().enumerate() {
+                gitql_object.groups[frame_index].rows[index].values[column_index] = value;
+            }
+        }
+    };
+
+    Ok(())
+}
+
+// Order-key functions take no user-supplied arguments, so their frame is built from the
+// window definition's ordering key expressions instead of `function.arguments`
+fn build_frame_values(
+    env: &mut Environment,
+    gitql_object: &GitQLObject,
+    frame_index: usize,
+    start: usize,
+    end: usize,
+    function: &WindowFunction,
+    is_order_key_function: bool,
+) -> Result<Vec<Vec<Box<dyn Value>>>, String> {
+    let rows = &gitql_object.groups[frame_index].rows[start..end];
+
+    let key_expressions: Vec<_> = if is_order_key_function {
+        function
+            .window_definition
+            .ordering_clause
+            .as_ref()
+            .map(|ordering| ordering.order_by.arguments.iter().collect())
+            .unwrap_or_default()
+    } else {
+        function.arguments.iter().collect()
+    };
+
+    let mut frame_values = Vec::with_capacity(rows.len());
+    for row in rows {
+        let mut row_selected_values = Vec::with_capacity(key_expressions.len());
+        for expression in key_expressions.iter() {
+            let value = evaluate_expression(env, expression, &gitql_object.titles, &row.values)?;
+            row_selected_values.push(value);
+        }
+        frame_values.push(row_selected_values);
+    }
+
+    Ok(frame_values)
+}
+
+// Under cumulative framing every earlier row already has its own (smaller) frame's
+// result assigned from a prior iteration, so only the last element is needed here
+fn evaluate_window_frame(
+    env: &mut Environment,
+    function: &WindowFunction,
+    frame_values: &[Vec<Box<dyn Value>>],
+) -> Box<dyn Value> {
+    match function.kind {
+        WindowFunctionKind::AggregatedWindowFunction => {
+            let aggregation_function = env.aggregation_function(&function.function_name).unwrap();
+            aggregation_function(frame_values)
+        }
+        WindowFunctionKind::PureWindowFunction => {
+            let window_function = env.window_function(&function.function_name).unwrap();
+            let mut values = window_function(frame_values);
+            values.pop().unwrap()
+        }
+    }
+}
+
 fn apply_window_definition_on_gitql_object(
     env: &mut Environment,
     gitql_object: &mut GitQLObject,
