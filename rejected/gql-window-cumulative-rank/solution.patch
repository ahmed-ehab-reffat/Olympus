+
+/// Returns true if `function_name` is a window function whose frame is built from the
+/// window definition's ordering key rather than from its own call arguments.
+pub fn is_order_key_required_window_function(function_name: &str) -> bool {
+    order_key_required_window_functions().contains(&function_name)
+}
+
+/// Window functions that need the ordering key values for every row in the partition,
+/// not just the rows up to and including the current one, to compute their result.
+pub fn whole_partition_order_key_window_functions() -> &'static [&'static str] {
+    &["percent_rank", "cume_dist"]
+}
+
+/// Returns true if `function_name` is an order-key-required window function that must be
+/// evaluated against the entire ordered partition rather than a per-row cumulative sub-frame.
+pub fn is_whole_partition_order_key_window_function(function_name: &str) -> bool {
+    whole_partition_order_key_window_functions().contains(&function_name)
+}
