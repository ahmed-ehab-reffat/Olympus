+/// Window functions that compute their result from the window definition's ordering key
+/// instead of user-supplied arguments, and therefore require an `ORDER BY` clause inside
+/// their `OVER(...)` window definition.
+pub fn order_key_required_window_functions() -> &'static [&'static str] {
+    &["rank", "dense_rank", "percent_rank", "cume_dist"]
