+        "SELECT name, RANK() OVER (ORDER BY salary) AS r, ROW_NUMBER() OVER (ORDER BY salary DESC) AS n FROM employees WHERE department = \"eng\"",
+    );
+    let names = column_values(&object, "name");
+    let ranks = column_values(&object, "r");
+    let numbers = column_values(&object, "n");
+    let mut by_name: HashMap<String, (String, String)> = HashMap::new();
+    for i in 0..names.len() {
+        by_name.insert(names[i].clone(), (ranks[i].clone(), numbers[i].clone()));
+    }
+
+    assert_eq!(by_name["dave"].0, "1");
+    assert_eq!(by_name["dave"].1, "4");
+    assert_eq!(by_name["alice"].0, "4");
+    assert_eq!(by_name["alice"].1, "1");
+
+    assert_eq!(by_name["bob"].0, "2");
+    assert_eq!(by_name["carol"].0, "2");
+    let mut middle_numbers = vec![by_name["bob"].1.clone(), by_name["carol"].1.clone()];
+    middle_numbers.sort();
+    assert_eq!(middle_numbers, vec!["2".to_string(), "3".to_string()]);
+}
+
+#[test]
+fn percent_rank_and_cume_dist_follow_the_order_by_direction() {
+    let object = run_query(
+        "SELECT name, PERCENT_RANK() OVER (ORDER BY salary DESC) AS pr, CUME_DIST() OVER (ORDER BY salary DESC) AS cd FROM employees WHERE department = \"eng\"",
+    );
+    let names = column_values(&object, "name");
+    let prs = column_values(&object, "pr");
+    let cds = column_values(&object, "cd");
+    let mut by_name: HashMap<String, (String, String)> = HashMap::new();
+    for i in 0..names.len() {
+        by_name.insert(names[i].clone(), (prs[i].clone(), cds[i].clone()));
+    }
+
+    assert_eq!(by_name["alice"], ("0".to_string(), "0.25".to_string()));
+    assert_eq!(
+        by_name["bob"],
+        ("0.3333333333333333".to_string(), "0.75".to_string())
+    );
+    assert_eq!(
+        by_name["carol"],
+        ("0.3333333333333333".to_string(), "0.75".to_string())
+    );
+    assert_eq!(by_name["dave"], ("1".to_string(), "1".to_string()));
+}
