+use std::collections::HashMap;
+
+use gitql_core::environment::Environment;
+use gitql_core::object::GitQLObject;
+use gitql_core::object::Row;
+use gitql_core::schema::Schema;
+use gitql_core::values::integer::IntValue;
+use gitql_core::values::text::TextValue;
+use gitql_core::values::Value;
+use gitql_engine::data_provider::DataProvider;
+use gitql_engine::engine::evaluate;
+use gitql_engine::engine::EvaluationResult;
+use gitql_parser::parser::parse_gql;
+use gitql_parser::tokenizer::Tokenizer;
+use gitql_std::aggregation::aggregation_function_signatures;
+use gitql_std::aggregation::aggregation_functions;
+use gitql_std::standard::standard_function_signatures;
+use gitql_std::standard::standard_functions;
+use gitql_std::window::window_function_signatures;
+use gitql_std::window::window_functions;
+
+struct MemoryTable {
+    columns: Vec<&'static str>,
+    rows: Vec<Vec<Box<dyn Value>>>,
+}
+
+struct MemoryProvider {
+    tables: HashMap<&'static str, MemoryTable>,
+}
+
+impl DataProvider for MemoryProvider {
+    fn provide(&self, table: &str, selected_columns: &[String]) -> Result<Vec<Row>, String> {
+        let Some(memory_table) = self.tables.get(table) else {
+            return Ok(vec![]);
+        };
+
+        let mut rows = Vec::with_capacity(memory_table.rows.len());
+        for source_row in &memory_table.rows {
+            let mut values: Vec<Box<dyn Value>> = Vec::with_capacity(selected_columns.len());
+            for column_name in selected_columns {
+                let value = match memory_table
+                    .columns
+                    .iter()
+                    .position(|name| name == column_name)
+                {
+                    Some(index) => source_row[index].clone(),
+                    // Generated result columns (window/aggregate targets) are not real table
+                    // columns; the real GitQLDataProvider falls back to NULL for these too.
+                    None => Box::new(gitql_core::values::null::NullValue),
+                };
+                values.push(value);
+            }
+            rows.push(Row { values });
+        }
+        Ok(rows)
+    }
+}
+
+fn text(value: &str) -> Box<dyn Value> {
+    Box::new(TextValue::new(value.to_string()))
+}
+
+fn int(value: i64) -> Box<dyn Value> {
+    Box::new(IntValue::new(value))
+}
+
+fn employees_environment() -> (Environment, MemoryProvider) {
+    let mut tables_fields_names: HashMap<&'static str, Vec<&'static str>> = HashMap::new();
+    tables_fields_names.insert("employees", vec!["name", "department", "salary"]);
+
+    let mut tables_fields_types: HashMap<&'static str, Box<dyn gitql_ast::types::DataType>> =
+        HashMap::new();
+    tables_fields_types.insert("name", Box::new(gitql_ast::types::text::TextType));
+    tables_fields_types.insert("department", Box::new(gitql_ast::types::text::TextType));
+    tables_fields_types.insert("salary", Box::new(gitql_ast::types::integer::IntType));
+
+    let schema = Schema {
+        tables_fields_names,
+        tables_fields_types,
+    };
+
+    let mut env = Environment::new(schema);
+    env.with_standard_functions(&standard_function_signatures(), standard_functions());
+    env.with_aggregation_functions(&aggregation_function_signatures(), aggregation_functions());
+    env.with_window_functions(&window_function_signatures(), window_functions());
+
+    let rows: Vec<Vec<Box<dyn Value>>> = vec![
+        vec![text("alice"), text("eng"), int(90)],
+        vec![text("bob"), text("eng"), int(70)],
+        vec![text("carol"), text("eng"), int(70)],
+        vec![text("dave"), text("eng"), int(60)],
+        vec![text("erin"), text("sales"), int(50)],
+        vec![text("frank"), text("sales"), int(50)],
+    ];
+
+    let mut tables = HashMap::new();
+    tables.insert(
+        "employees",
+        MemoryTable {
+            columns: vec!["name", "department", "salary"],
+            rows,
+        },
+    );
+
+    (env, MemoryProvider { tables })
+}
+
+fn run_query(sql: &str) -> GitQLObject {
+    let (mut env, provider) = employees_environment();
+    let tokens = match Tokenizer::tokenize(sql) {
+        Ok(tokens) => tokens,
+        Err(diagnostic) => panic!("tokenizer should succeed: {}", diagnostic.message()),
+    };
+    let queries = match parse_gql(tokens, &mut env) {
+        Ok(queries) => queries,
+        Err(diagnostic) => panic!("parser should succeed: {}", diagnostic.message()),
+    };
+    let provider: Box<dyn DataProvider> = Box::new(provider);
+    let mut results = match evaluate(&mut env, &provider, queries) {
+        Ok(results) => results,
+        Err(message) => panic!("evaluation should succeed: {message}"),
+    };
+    match results.remove(0) {
+        EvaluationResult::SelectedGroups(object) => object,
+        _ => panic!("expected a select result"),
+    }
+}
+
+fn run_query_expect_parse_error(sql: &str) -> String {
+    let mut env = employees_environment().0;
+    let tokens = match Tokenizer::tokenize(sql) {
+        Ok(tokens) => tokens,
+        Err(diagnostic) => panic!("tokenizer should succeed: {}", diagnostic.message()),
+    };
+    match parse_gql(tokens, &mut env) {
+        Ok(_) => panic!("expected a parse error"),
+        Err(diagnostic) => diagnostic.message().clone(),
+    }
+}
+
+fn column_values(object: &GitQLObject, column: &str) -> Vec<String> {
+    let index = object
+        .titles
+        .iter()
+        .position(|title| title == column)
+        .unwrap_or_else(|| panic!("column `{column}` not found in result titles"));
+    object.groups[0]
+        .rows
+        .iter()
+        .map(|row| row.values[index].literal())
+        .collect()
+}
+
+fn assert_column_eq(object: &GitQLObject, column: &str, expected: &[&str]) {
+    let actual = column_values(object, column);
+    assert_eq!(actual, expected, "mismatch on column `{column}`");
+}
+
+#[test]
+fn cumulative_aggregated_sum_grows_per_row_with_order_by() {
+    let object = run_query(
+        "SELECT name, salary, SUM(salary) OVER (ORDER BY salary) AS running_total FROM employees WHERE department = \"eng\"",
+    );
+    assert_column_eq(&object, "salary", &["60", "70", "70", "90"]);
+    assert_column_eq(&object, "running_total", &["60", "130", "200", "290"]);
+}
+
+#[test]
+fn aggregated_sum_broadcasts_whole_partition_without_order_by() {
+    let object = run_query(
+        "SELECT name, SUM(salary) OVER (PARTITION BY department) AS total, RANK() OVER (PARTITION BY department ORDER BY salary) AS r FROM employees WHERE department = \"eng\"",
+    );
+    assert_column_eq(&object, "total", &["290", "290", "290", "290"]);
+    assert_column_eq(&object, "r", &["1", "2", "2", "4"]);
+}
