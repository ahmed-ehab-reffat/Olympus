+def get_process_tree(processes: list[ProcessAddress]) -> tuple[list[ProcessAddress], dict[ProcessAddress, list[ProcessAddress]]]:
+    """
+    link each process to its parent, by the parent's pid.
+    a process whose parent is not in the trace, is itself, or is ambiguous, is a root.
+    """
+    by_pid: dict[int, list[ProcessAddress]] = collections.defaultdict(list)
+    for p in processes:
+        by_pid[p.pid].append(p)
+
+    children: dict[ProcessAddress, list[ProcessAddress]] = {p: [] for p in processes}
+    roots: list[ProcessAddress] = []
+    for p in processes:
+        parents = by_pid.get(p.ppid, [])
+        if p.ppid == p.pid or len(parents) != 1:
+            roots.append(p)
+        else:
+            children[parents[0]].append(p)
+
+    # break any cycle by promoting its lowest member to a root.
+    reachable: set[ProcessAddress] = set()
+    stack = list(roots)
+    while True:
+        while stack:
+            p = stack.pop()
+            if p not in reachable:
+                reachable.add(p)
+                stack.extend(children[p])
+        remaining = sorted(p for p in processes if p not in reachable)
+        if not remaining:
+            break
+        root = remaining[0]
+        for siblings in children.values():
+            if root in siblings:
+                siblings.remove(root)
+        roots.append(root)
+        stack.append(root)
+
+    return sorted(roots), children
+
+
+def find_process_tree_capabilities(
+    ruleset: RuleSet, processes: dict[ProcessAddress, ProcessCapabilities]
+) -> MatchResults:
+    """
+    match process tree rules at every process, over the features of the process and all its descendants.
+    a rule is reported only at the smallest subtrees that match it,
+    unless a match reported at an ancestor depends on it.
+    """
+    roots, children = get_process_tree(list(processes.keys()))
+
+    matches_at: dict[ProcessAddress, MatchResults] = {}
+    matched_below: dict[ProcessAddress, set[str]] = {}
+
+    def rec(p: ProcessAddress) -> FeatureSet:
+        features: FeatureSet = collections.defaultdict(set)
+        for feature, vas in processes[p].features.items():
+            features[feature].update(vas)
+
+        below: set[str] = set()
+        for child in children[p]:
+            for feature, vas in rec(child).items():
+                features[feature].update(vas)
+            below.update(matched_below[child])
+            below.update(matches_at[child].keys())
+
+        _, matches = ruleset.match(Scope.PROCESS_TREE, features, p)
+        matches_at[p] = matches
+        matched_below[p] = below
+        return features
+
+    for root in roots:
+        rec(root)
+
+    tree_matches: MatchResults = collections.defaultdict(list)
+    for p, matches in matches_at.items():
+        reported = {name for name in matches if name not in matched_below[p]}
+        wanted = set(reported)
+        for name in reported:
+            wanted.update(ruleset.rules[name].get_dependencies(ruleset.rules_by_namespace))
+        for name, res in matches.items():
+            if name in wanted:
+                tree_matches[name].extend(res)
+
+    return tree_matches
 
 
