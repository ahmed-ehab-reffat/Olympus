diff --git a/guard/tests/arithmetic_af823d.rs b/guard/tests/arithmetic_af823d.rs
new file mode 100644
index 0000000..8bcb16f
--- /dev/null
+++ b/guard/tests/arithmetic_af823d.rs
@@ -0,0 +1,154 @@
+#[cfg(test)]
+mod arithmetic_tests {
+    use cfn_guard::{run_checks, ValidateInput};
+    use serde_json::Value;
+
+    fn evaluate(data: &str, rules: &str) -> Result<String, cfn_guard::Error> {
+        run_checks(
+            ValidateInput {
+                content: data,
+                file_name: "data.json",
+            },
+            ValidateInput {
+                content: rules,
+                file_name: "rules.guard",
+            },
+            false,
+        )
+    }
+
+    fn status(data: &str, rules: &str) -> String {
+        let output = evaluate(data, rules).expect("the rules should evaluate without an error");
+        let parsed: Value = serde_json::from_str(&output).expect("output should be valid json");
+        parsed["status"]
+            .as_str()
+            .expect("output should carry an overall status")
+            .to_string()
+    }
+
+    fn let_rule(expression: &str, expected: &str) -> String {
+        format!("let value = {expression}\nrule check {{ %value == {expected} }}\n")
+    }
+
+    const EMPTY: &str = "{}";
+
+    #[test]
+    fn addition_and_subtraction() {
+        assert_eq!(status(EMPTY, &let_rule("2 + 3 - 1", "4")), "PASS");
+    }
+
+    #[test]
+    fn multiplication() {
+        assert_eq!(status(EMPTY, &let_rule("4 * 3", "12")), "PASS");
+    }
+
+    #[test]
+    fn multiplication_binds_tighter_than_addition() {
+        assert_eq!(status(EMPTY, &let_rule("2 + 3 * 4", "14")), "PASS");
+    }
+
+    #[test]
+    fn multiplication_precedence_discriminator() {
+        assert_eq!(status(EMPTY, &let_rule("2 + 3 * 4", "20")), "FAIL");
+    }
+
+    #[test]
+    fn parentheses_override_precedence() {
+        assert_eq!(status(EMPTY, &let_rule("(2 + 3) * 4", "20")), "PASS");
+    }
+
+    #[test]
+    fn subtraction_is_left_associative() {
+        assert_eq!(status(EMPTY, &let_rule("8 - 3 - 2", "3")), "PASS");
+    }
+
+    #[test]
+    fn subtraction_associativity_discriminator() {
+        assert_eq!(status(EMPTY, &let_rule("8 - 3 - 2", "7")), "FAIL");
+    }
+
+    #[test]
+    fn division_of_evenly_divisible_integers_is_an_integer() {
+        assert_eq!(status(EMPTY, &let_rule("8 / 2", "4")), "PASS");
+    }
+
+    #[test]
+    fn division_that_is_not_exact_is_a_float() {
+        assert_eq!(status(EMPTY, &let_rule("10 / 4", "2.5")), "PASS");
+    }
+
+    #[test]
+    fn division_that_is_not_exact_is_not_truncated() {
+        assert_eq!(status(EMPTY, &let_rule("10 / 4", "2")), "FAIL");
+    }
+
+    #[test]
+    fn a_float_operand_makes_the_result_a_float() {
+        assert_eq!(status(EMPTY, &let_rule("2.5 * 2", "5.0")), "PASS");
+    }
+
+    #[test]
+    fn division_by_zero_is_an_evaluation_error() {
+        assert_eq!(status(EMPTY, &let_rule("6 / 3", "2")), "PASS");
+        assert!(evaluate(EMPTY, &let_rule("5 / 0", "0")).is_err());
+    }
+
+    #[test]
+    fn arithmetic_is_allowed_on_a_comparison_right_hand_side() {
+        let data = r#"{"Resources":{"a":{"Properties":{"Size":10}}}}"#;
+        let rules = "rule check { Resources.a.Properties.Size == 5 * 2 }\n";
+        assert_eq!(status(data, rules), "PASS");
+    }
+
+    #[test]
+    fn arithmetic_binds_tighter_than_the_comparison() {
+        let data = r#"{"Resources":{"a":{"Properties":{"Size":13}}}}"#;
+        let rules = "rule check { Resources.a.Properties.Size == 10 + 3 }\n";
+        assert_eq!(status(data, rules), "PASS");
+    }
+
+    #[test]
+    fn a_single_valued_reference_is_a_valid_operand() {
+        let data = r#"{"Resources":{"a":{"Properties":{"Size":10}}}}"#;
+        let rules =
+            "let scaled = Resources.a.Properties.Size * 2\nrule check { %scaled == 20 }\n";
+        assert_eq!(status(data, rules), "PASS");
+    }
+
+    #[test]
+    fn a_reference_matching_many_values_is_an_operand_error() {
+        let rules =
+            "let scaled = Resources.*.Properties.Size * 2\nrule check { %scaled == 20 }\n";
+        let single = r#"{"Resources":{"a":{"Properties":{"Size":10}}}}"#;
+        assert_eq!(status(single, rules), "PASS");
+        let many = r#"{"Resources":{"a":{"Properties":{"Size":10}},"b":{"Properties":{"Size":20}}}}"#;
+        assert!(evaluate(many, rules).is_err());
+    }
+
+    #[test]
+    fn a_reference_matching_no_value_is_an_operand_error() {
+        let rules =
+            "let scaled = Resources.a.Properties.Size * 2\nrule check { %scaled == 20 }\n";
+        let present = r#"{"Resources":{"a":{"Properties":{"Size":10}}}}"#;
+        assert_eq!(status(present, rules), "PASS");
+        let absent = r#"{"Resources":{"a":{"Properties":{"Other":10}}}}"#;
+        assert!(evaluate(absent, rules).is_err());
+    }
+
+    #[test]
+    fn a_non_numeric_operand_is_an_error() {
+        let rules =
+            "let scaled = Resources.a.Properties.Size * 2\nrule check { %scaled == 20 }\n";
+        let numeric = r#"{"Resources":{"a":{"Properties":{"Size":10}}}}"#;
+        assert_eq!(status(numeric, rules), "PASS");
+        let text = r#"{"Resources":{"a":{"Properties":{"Size":"large"}}}}"#;
+        assert!(evaluate(text, rules).is_err());
+    }
+
+    #[test]
+    fn existing_wildcard_and_regex_syntax_still_work_alongside_arithmetic() {
+        let data = r#"{"Resources":{"a":{"Type":"AWS::S3::Bucket","Properties":{"Size":10}},"b":{"Type":"AWS::S3::Bucket","Properties":{"Size":20}}}}"#;
+        let rules = "let floor = 2 + 3\nrule check {\n  Resources.*.Properties.Size >= %floor\n  Resources.*.Type == /S3/\n}\n";
+        assert_eq!(status(data, rules), "PASS");
+    }
+}
