+fn get_token_substitution<'query>(
+    subst_expr: &expr::Expr,
+    info: &'query expr::EvalAsmBlockQuery)
+    -> Option<std::borrow::Cow<'query, String>>
+{
+    let expr::Expr::Variable(_, name) = subst_expr
+        else { return None };
+
+    info.eval_ctx.get_token_subst(name)
+}
