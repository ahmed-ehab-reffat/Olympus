+fn collect_label_names(
+    ast: &asm::AstTopLevel)
+    -> Vec<String>
+{
+    let mut names = Vec::new();
+
+    for node in &ast.nodes
+    {
+        if let asm::AstAny::Symbol(ast_symbol) = node
+        {
+            if matches!(ast_symbol.kind, asm::AstSymbolKind::Label)
+            {
+                names.push(ast_symbol.name.clone());
+            }
+        }
+    }
+
+    names
+}
