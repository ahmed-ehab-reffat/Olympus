+fn check_substitution_in_scope(
+    subst_expr: &expr::Expr,
+    span: diagn::Span,
+    label_names: &Vec<String>,
+    decls: &asm::ItemDecls,
+    info: &mut expr::EvalAsmBlockQuery)
+    -> Result<(), ()>
+{
+    let expr::Expr::Variable(_, name) = subst_expr
+        else { return Ok(()) };
+
+    if info.eval_ctx.get_local(name).is_some()
+    {
+        return Ok(());
+    }
+
+    if label_names.iter().any(|l| l == name)
+    {
+        return Ok(());
+    }
+
+    if asm::resolver::resolve_builtin_symbol(name, info.eval_ctx.opts).is_some()
+    {
+        return Ok(());
+    }
+
+    let global_ctx = util::SymbolContext::new_global();
+
+    if decls.symbols.try_get_by_name(&global_ctx, 0, &[name.as_str()]).is_some()
+    {
+        return Ok(());
+    }
+
+    info.report.error_span(
+        format!(
+            "unknown substitution argument `{}`",
+            name),
+        span);
+
+    Err(())
+}
