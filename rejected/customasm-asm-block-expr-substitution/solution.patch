+
+fn resolve_deferred_substitutions(
+    fileserver: &mut dyn util::FileServer,
+    opts: &asm::AssemblyOptions,
+    decls: &asm::ItemDecls,
+    defs: &asm::ItemDefs,
+    inner_ctx: &asm::ResolverContext,
+    report: &mut diagn::Report,
+    scope_eval_ctx: &mut expr::EvalContext,
+    target_eval_ctx: &mut expr::EvalContext,
+    deferred: &mut Vec<AsmDeferredSubstitution>)
+    -> Result<asm::ResolutionState, ()>
+{
+    let mut resolution = asm::ResolutionState::Resolved;
+
+    for subst in deferred.iter_mut()
+    {
+        let value = asm::resolver::eval(
+            report,
+            fileserver,
+            opts,
+            decls,
+            defs,
+            inner_ctx,
+            scope_eval_ctx,
+            &subst.expr)?;
+
+        let value = check_substitution_value(
+            report,
+            subst.span,
+            inner_ctx.can_guess(),
+            value)?;
+
+        let is_stable = value.is_stable(&subst.value);
+        let mut is_resolved = false;
+
+        let subst_resolution = asm::resolver::handle_value_resolution(
+            target_eval_ctx.opts,
+            report,
+            subst.span,
+            inner_ctx.can_guess(),
+            value.is_guess(),
+            is_stable,
+            &mut is_resolved,
+            true,
+            "substitution",
+            "substitution value",
+            None,
+            &value)?;
+
+        resolution.merge(subst_resolution);
+
+        target_eval_ctx.set_local(
+            &subst.variable,
+            value.clone());
+
+        subst.value = value;
+    }
+
+    Ok(resolution)
+}
+
+
+fn check_substitution_value(
+    report: &mut diagn::Report,
+    span: diagn::Span,
+    can_guess: bool,
+    value: expr::Value)
+    -> Result<expr::Value, ()>
+{
+    match value
+    {
+        expr::Value::Integer(..) |
+        expr::Value::Unknown(..) => Ok(value),
+
+        _ =>
+        {
+            if can_guess
+            {
+                return Ok(expr::Value::make_unknown().as_guess());
+            }
+
+            report.error_span(
+                format!(
+                    "invalid type for substitution: {}",
+                    value.type_name()),
+                span);
+
+            Err(())
+        }
+    }
+}
