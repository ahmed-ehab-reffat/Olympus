+fn create_vmtx_table<'a>(
+    vmtx: &HmtxTable<'_>,
+    vvar: Option<&HvarTable<'_>>,
+    glyf: Option<&GlyfTable<'_>>,
+    instance: &OwnedTuple,
+    num_glyphs: u16,
+) -> Result<HmtxTable<'a>, ReadWriteError> {
+    let mut v_metrics = Vec::with_capacity(usize::from(num_glyphs));
+    for glyph_id in 0..num_glyphs {
+        let mut metric = vmtx.metric(glyph_id)?;
+        let vertical_origin = glyf
+            .map(|glyf| match glyf.records().get(usize::from(glyph_id)) {
+                Some(GlyfRecord::Parsed(glyph)) => {
+                    let bounding_box = glyph.bounding_box().unwrap_or_else(BoundingBox::empty);
+                    let phantom_points = glyph.phantom_points().ok_or(ParseError::MissingValue)?;
+                    Ok((phantom_points[2].1, phantom_points[3].1, bounding_box.y_max))
+                }
+                _ => Err(ParseError::BadIndex),
+            })
+            .transpose()?;
+        match (vvar, vertical_origin) {
+            (Some(vvar), _) => {
+                let delta = vvar.advance_delta(instance, glyph_id)?;
+                metric.advance_width = (metric.advance_width as f32 + delta)
+                    .round()
+                    .clamp(0., u16::MAX as f32) as u16;
+                if let Some(delta) = vvar.left_side_bearing_delta(instance, glyph_id)? {
+                    metric.lsb = add_delta_i16(metric.lsb, delta);
+                } else if let Some((pp3, _, y_max)) = vertical_origin {
+                    metric.lsb = pp3 - y_max;
+                }
+            }
+            (None, Some((pp3, pp4, y_max))) => {
+                metric.advance_width = u16::try_from(pp3 - pp4).unwrap_or(0);
+                metric.lsb = pp3 - y_max;
+            }
+            (None, None) => {}
+        }
+        v_metrics.push(metric);
+    }
+    Ok(HmtxTable {
+        h_metrics: ReadArrayCow::Owned(v_metrics),
+        left_side_bearings: ReadArrayCow::Owned(vec![]),
+    })
+}
