diff --git a/src/layout/instance.rs b/src/layout/instance.rs
new file mode 100644
index 0000000..322b208
--- /dev/null
+++ b/src/layout/instance.rs
@@ -0,0 +1,297 @@
+use crate::binary::read::ReadScope;
+use crate::error::ParseError;
+use crate::layout::{
+    FeatureTable, LayoutTable, LayoutTableType, ValueFormat, VariationIndex, GPOS,
+};
+use crate::tables::variable_fonts::owned::ItemVariationStore;
+use crate::tables::variable_fonts::Tuple;
+
+const HEADER_LEN: usize = 10;
+const VARIATIONS_HEADER_LEN: usize = 14;
+const SINGLE_POS: u16 = 1;
+const PAIR_POS: u16 = 2;
+const EXTENSION_POS: u16 = 9;
+const VARIATION_INDEX_FORMAT: u16 = 0x8000;
+
+pub(crate) fn instance_layout<T: LayoutTableType>(
+    data: &[u8],
+    tuple: Tuple<'_>,
+) -> Result<Vec<u8>, ParseError> {
+    let layout = ReadScope::new(data).read::<LayoutTable<T>>()?;
+    let Some(feature_variations) = layout.opt_feature_variations.as_ref() else {
+        return Ok(data.to_vec());
+    };
+    let substitution = feature_variations.matches(tuple)?;
+    let records = layout
+        .opt_feature_list
+        .as_ref()
+        .map(|feature_list| feature_list.feature_records.as_slice())
+        .unwrap_or_default();
+    let alternates = (0..records.len())
+        .map(|index| {
+            let index = u16::try_from(index).map_err(|_| ParseError::LimitExceeded)?;
+            Ok(substitution
+                .as_ref()
+                .and_then(|substitution| substitution.substitute(index)))
+        })
+        .collect::<Result<Vec<Option<FeatureTable>>, ParseError>>()?;
+    rebuild_feature_list(data, &alternates)
+}
+
+pub(crate) fn instance_gpos(
+    data: &[u8],
+    tuple: Tuple<'_>,
+    store: Option<&ItemVariationStore>,
+) -> Result<Vec<u8>, ParseError> {
+    let mut table = instance_layout::<GPOS>(data, tuple)?;
+    if let Some(store) = store {
+        DeltaBaker { tuple, store }.bake_lookups(&mut table)?;
+    }
+    Ok(table)
+}
+
+pub(crate) fn drop_gdef_variation_store(data: &[u8]) -> Result<Vec<u8>, ParseError> {
+    let mut table = data.to_vec();
+    if read_u16(&table, 2)? >= 3 {
+        write_u32(&mut table, 14, 0)?;
+    }
+    Ok(table)
+}
+
+fn rebuild_feature_list(
+    data: &[u8],
+    alternates: &[Option<FeatureTable>],
+) -> Result<Vec<u8>, ParseError> {
+    let old_feature_list = usize::from(read_u16(data, 6)?);
+    let records_len = 2 + 6 * alternates.len();
+    let alternates_len = alternates
+        .iter()
+        .flatten()
+        .map(|feature| 4 + 2 * feature.lookup_indices.len())
+        .sum::<usize>();
+    let body_start = HEADER_LEN + records_len + alternates_len;
+    let relocate = |offset: usize| -> Result<u16, ParseError> {
+        match offset {
+            0 => Ok(0),
+            _ => u16::try_from(offset - VARIATIONS_HEADER_LEN + body_start)
+                .map_err(|_| ParseError::LimitExceeded),
+        }
+    };
+
+    let mut table = Vec::with_capacity(data.len() + body_start);
+    push_u16(&mut table, 1);
+    push_u16(&mut table, 0);
+    push_u16(&mut table, relocate(usize::from(read_u16(data, 4)?))?);
+    push_u16(
+        &mut table,
+        if old_feature_list == 0 {
+            0
+        } else {
+            HEADER_LEN as u16
+        },
+    );
+    push_u16(&mut table, relocate(usize::from(read_u16(data, 8)?))?);
+
+    let mut alternate_tables = Vec::with_capacity(alternates_len);
+    push_u16(&mut table, alternates.len() as u16);
+    for (index, alternate) in alternates.iter().enumerate() {
+        let record = old_feature_list + 2 + 6 * index;
+        table.extend_from_slice(data.get(record..record + 4).ok_or(ParseError::BadOffset)?);
+        let offset = match alternate {
+            Some(feature) => {
+                let offset = records_len + alternate_tables.len();
+                push_u16(&mut alternate_tables, 0);
+                push_u16(&mut alternate_tables, feature.lookup_indices.len() as u16);
+                for lookup_index in &feature.lookup_indices {
+                    push_u16(&mut alternate_tables, *lookup_index);
+                }
+                offset
+            }
+            None => {
+                let feature = old_feature_list + usize::from(read_u16(data, record + 4)?);
+                usize::from(relocate(feature)?) - HEADER_LEN
+            }
+        };
+        push_u16(
+            &mut table,
+            u16::try_from(offset).map_err(|_| ParseError::LimitExceeded)?,
+        );
+    }
+    table.extend_from_slice(&alternate_tables);
+    table.extend_from_slice(
+        data.get(VARIATIONS_HEADER_LEN..)
+            .ok_or(ParseError::BadOffset)?,
+    );
+    Ok(table)
+}
+
+struct DeltaBaker<'a, 'b> {
+    tuple: Tuple<'a>,
+    store: &'b ItemVariationStore,
+}
+
+impl DeltaBaker<'_, '_> {
+    fn bake_lookups(&self, table: &mut [u8]) -> Result<(), ParseError> {
+        let lookup_list = usize::from(read_u16(table, 8)?);
+        if lookup_list == 0 {
+            return Ok(());
+        }
+        for i in 0..usize::from(read_u16(table, lookup_list)?) {
+            let lookup = lookup_list + usize::from(read_u16(table, lookup_list + 2 + 2 * i)?);
+            let lookup_type = read_u16(table, lookup)?;
+            for j in 0..usize::from(read_u16(table, lookup + 4)?) {
+                let mut subtable = lookup + usize::from(read_u16(table, lookup + 6 + 2 * j)?);
+                let mut subtable_type = lookup_type;
+                if lookup_type == EXTENSION_POS {
+                    subtable_type = read_u16(table, subtable + 2)?;
+                    subtable += usize::try_from(read_u32(table, subtable + 4)?)
+                        .map_err(|_| ParseError::BadOffset)?;
+                }
+                match subtable_type {
+                    SINGLE_POS => self.single_pos(table, subtable)?,
+                    PAIR_POS => self.pair_pos(table, subtable)?,
+                    _ => {}
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn single_pos(&self, table: &mut [u8], subtable: usize) -> Result<(), ParseError> {
+        let value_format = ValueFormat(read_u16(table, subtable + 4)?);
+        match read_u16(table, subtable)? {
+            1 => self.value_record(table, subtable, subtable + 6, value_format),
+            2 => {
+                for k in 0..usize::from(read_u16(table, subtable + 6)?) {
+                    let record = subtable + 8 + k * value_format.size();
+                    self.value_record(table, subtable, record, value_format)?;
+                }
+                Ok(())
+            }
+            _ => Err(ParseError::BadVersion),
+        }
+    }
+
+    fn pair_pos(&self, table: &mut [u8], subtable: usize) -> Result<(), ParseError> {
+        let first = ValueFormat(read_u16(table, subtable + 4)?);
+        let second = ValueFormat(read_u16(table, subtable + 6)?);
+        match read_u16(table, subtable)? {
+            1 => {
+                let record_len = 2 + first.size() + second.size();
+                for k in 0..usize::from(read_u16(table, subtable + 8)?) {
+                    let pair_set = subtable + usize::from(read_u16(table, subtable + 10 + 2 * k)?);
+                    for r in 0..usize::from(read_u16(table, pair_set)?) {
+                        let record = pair_set + 2 + r * record_len + 2;
+                        self.value_record(table, pair_set, record, first)?;
+                        self.value_record(table, pair_set, record + first.size(), second)?;
+                    }
+                }
+                Ok(())
+            }
+            2 => {
+                let class_pairs = usize::from(read_u16(table, subtable + 12)?)
+                    * usize::from(read_u16(table, subtable + 14)?);
+                let record_len = first.size() + second.size();
+                for k in 0..class_pairs {
+                    let record = subtable + 16 + k * record_len;
+                    self.value_record(table, subtable, record, first)?;
+                    self.value_record(table, subtable, record + first.size(), second)?;
+                }
+                Ok(())
+            }
+            _ => Err(ParseError::BadVersion),
+        }
+    }
+
+    fn value_record(
+        &self,
+        table: &mut [u8],
+        parent: usize,
+        record: usize,
+        value_format: ValueFormat,
+    ) -> Result<(), ParseError> {
+        let mut values = [None; 4];
+        let mut devices = [None; 4];
+        let mut position = record;
+        for bit in 0..8 {
+            if value_format.0 & (1 << bit) != 0 {
+                if bit < 4 {
+                    values[bit] = Some(position);
+                } else {
+                    devices[bit - 4] = Some(position);
+                }
+                position += 2;
+            }
+        }
+        let read_value = |table: &[u8], field: Option<usize>| -> Result<i16, ParseError> {
+            field.map_or(Ok(0), |field| {
+                read_u16(table, field).map(|value| value as i16)
+            })
+        };
+        let has_placement =
+            read_value(table, values[0])? != 0 || read_value(table, values[1])? != 0;
+        if read_value(table, values[3])? != 0 {
+            return Ok(());
+        }
+        for field in 0..3 {
+            if field < 2 && !has_placement {
+                continue;
+            }
+            let (Some(value), Some(device)) = (values[field], devices[field]) else {
+                continue;
+            };
+            let device_offset = usize::from(read_u16(table, device)?);
+            if device_offset == 0 {
+                continue;
+            }
+            let Some(index) = read_variation_index(table, parent + device_offset)? else {
+                continue;
+            };
+            let delta = self.store.adjustment(index, self.tuple)?.round() as i16;
+            let baked = (read_u16(table, value)? as i16).wrapping_add(delta);
+            write_u16(table, value, baked as u16)?;
+            write_u16(table, device, 0)?;
+        }
+        Ok(())
+    }
+}
+
+fn read_variation_index(table: &[u8], device: usize) -> Result<Option<VariationIndex>, ParseError> {
+    if read_u16(table, device + 4)? != VARIATION_INDEX_FORMAT {
+        return Ok(None);
+    }
+    Ok(Some(VariationIndex {
+        outer_index: read_u16(table, device)?,
+        inner_index: read_u16(table, device + 2)?,
+    }))
+}
+
+fn read_u16(data: &[u8], offset: usize) -> Result<u16, ParseError> {
+    data.get(offset..offset + 2)
+        .map(|bytes| u16::from_be_bytes([bytes[0], bytes[1]]))
+        .ok_or(ParseError::BadOffset)
+}
+
+fn read_u32(data: &[u8], offset: usize) -> Result<u32, ParseError> {
+    data.get(offset..offset + 4)
+        .map(|bytes| u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]]))
+        .ok_or(ParseError::BadOffset)
+}
+
+fn write_u16(data: &mut [u8], offset: usize, value: u16) -> Result<(), ParseError> {
+    data.get_mut(offset..offset + 2)
+        .ok_or(ParseError::BadOffset)?
+        .copy_from_slice(&value.to_be_bytes());
+    Ok(())
+}
+
+fn write_u32(data: &mut [u8], offset: usize, value: u32) -> Result<(), ParseError> {
+    data.get_mut(offset..offset + 4)
+        .ok_or(ParseError::BadOffset)?
+        .copy_from_slice(&value.to_be_bytes());
+    Ok(())
+}
+
+fn push_u16(out: &mut Vec<u8>, value: u16) {
+    out.extend_from_slice(&value.to_be_bytes());
+}
