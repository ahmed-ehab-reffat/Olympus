+#[test]
+fn vhea_takes_mvar_deltas() {
+    let store = var_store(3, &[wght_region(3)], &[vec![40], vec![-25]]);
+    let mut mvar = Vec::new();
+    for value in [1u16, 0, 0, 8, 2, 28] {
+        put16(&mut mvar, value);
+    }
+    for (inner, value_tag) in [tag::VASC, tag::VDSC].into_iter().enumerate() {
+        put32(&mut mvar, value_tag);
+        put16(&mut mvar, 0);
+        put16(&mut mvar, inner as u16);
+    }
+    mvar.extend_from_slice(&store);
+    let mut tables = vertical_tables();
+    tables.push((tag::MVAR, mvar));
+    let (static_font, _) = instance(&font_with(NOTO, tables), &[900.0, 100.0, 0.0]);
+    let (vhea, _) = vertical_metrics(&static_font);
+    assert_eq!((vhea.ascender, vhea.descender), (540, -525));
+}
