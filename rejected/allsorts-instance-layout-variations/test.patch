+#[test]
+fn vertical_metrics_follow_phantom_points_without_vvar() {
+    let data = font_with(NOTO, vertical_tables());
+    let (static_font, _) = instance(&data, &[900.0, 100.0, 0.0]);
+    let (vhea, metrics) = vertical_metrics(&static_font);
+    assert_eq!(vhea.num_h_metrics, 4);
+    assert_ne!(y_max(&static_font, 1), y_max(&data, 1));
+    for glyph in 1..4u16 {
+        let top = 100 + glyph as i16 + y_max(&data, glyph);
+        assert_eq!(
+            metrics[usize::from(glyph)],
+            (1000, top - y_max(&static_font, glyph))
+        );
+    }
+}
