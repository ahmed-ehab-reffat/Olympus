+#[test]
+fn vertical_metrics_follow_vvar() {
+    let store = var_store(
+        3,
+        &[wght_region(3)],
+        &[vec![0], vec![80], vec![-30], vec![0]],
+    );
+    let mut vvar = Vec::new();
+    put16(&mut vvar, 1);
+    put16(&mut vvar, 0);
+    put32(&mut vvar, 24);
+    put32(&mut vvar, 0);
+    put32(&mut vvar, 0);
+    put32(&mut vvar, 0);
+    put32(&mut vvar, 0);
+    vvar.extend_from_slice(&store);
+    let mut tables = vertical_tables();
+    tables.push((VVAR, vvar));
+    let data = font_with(NOTO, tables);
+    let (static_font, _) = instance(&data, &[900.0, 100.0, 0.0]);
+    let font_file = ReadScope::new(&static_font).read::<FontData<'_>>().unwrap();
+    let mut font = Font::new(font_file.table_provider(0).unwrap()).unwrap();
+    let advances = (0..4)
+        .map(|glyph| font.vertical_advance(glyph))
+        .collect::<Vec<_>>();
+    assert_eq!(
+        advances,
+        vec![Some(1000), Some(1080), Some(970), Some(1000)]
+    );
+    let (vhea, _) = vertical_metrics(&static_font);
+    assert_eq!(vhea.advance_width_max, 1080);
+}
