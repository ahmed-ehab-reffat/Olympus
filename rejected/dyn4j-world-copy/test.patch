--- /dev/null
+++ b/test.sh
@@ -0,0 +1,214 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-$(pwd)/test-results-$MODE.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+ROOT="$(pwd)"
+LIB="${DYN4J_TEST_LIB:-/opt/dyn4j-lib}"
+CP_LIB="$LIB/junit-4.13.1.jar:$LIB/hamcrest-core-1.3.jar"
+WORK="$(mktemp -d "${TMPDIR:-/tmp}/dyn4j-test.XXXXXX")"
+trap 'rm -rf "$WORK"' EXIT
+NEW_TESTS="src/test/java/org/dyn4j/world/WorldCopy0cbf19Test.java"
+
+write_error_xml() {
+  local name="$1" log="$2"
+  shift 2
+  python3 - "$OUTPUT_PATH" "$name" "$log" "$@" <<'PY'
+import re, sys
+from xml.sax.saxutils import escape, quoteattr
+out, name, log, sources = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
+try:
+    text = open(log, errors="replace").read()[-20000:]
+except OSError:
+    text = "no log"
+cases = []
+for src in sources:
+    body = open(src, errors="replace").read()
+    pkg = re.search(r"^package\s+([\w.]+);", body, re.M)
+    cls = re.search(r"\bclass\s+(\w+)", body)
+    prefix = (pkg.group(1) + "." if pkg else "") + (cls.group(1) if cls else "unknown")
+    for m in re.finditer(r"@Test\b[^{;]*?\bvoid\s+(\w+)\s*\(", body):
+        cases.append((prefix, m.group(1)))
+if not cases:
+    cases = [("dyn4j.build", name)]
+with open(out, "w") as f:
+    f.write('<?xml version="1.0" encoding="UTF-8"?>\n')
+    f.write('<testsuite name="dyn4j" tests="%d" failures="%d" errors="0" skipped="0">\n' % (len(cases), len(cases)))
+    for classname, test in cases:
+        f.write('<testcase classname=%s name=%s><failure message=%s>%s</failure></testcase>\n' % (quoteattr(classname), quoteattr(test), quoteattr(name), escape(text)))
+    f.write('</testsuite>\n')
+PY
+}
+
+mkdir -p "$WORK/main" "$WORK/test" "$WORK/runner"
+find src/main/java -name '*.java' ! -name 'module-info.java' > "$WORK/main.list"
+if ! javac -nowarn -encoding UTF-8 --release 11 -d "$WORK/main" @"$WORK/main.list" > "$WORK/main.log" 2>&1; then
+  cat "$WORK/main.log"
+  if [ "$MODE" = "new" ]; then
+    write_error_xml "compile_main_sources" "$WORK/main.log" $NEW_TESTS
+  else
+    write_error_xml "compile_main_sources" "$WORK/main.log"
+  fi
+  exit 1
+fi
+
+if [ "$MODE" = "new" ]; then
+  printf '%s\n' $NEW_TESTS > "$WORK/test.list"
+else
+  find src/test/java -name '*.java' > "$WORK/all.list"
+  grep -v -F -x -f <(printf '%s\n' $NEW_TESTS) "$WORK/all.list" > "$WORK/test.list"
+fi
+
+if ! javac -nowarn -encoding UTF-8 --release 11 -cp "$WORK/main:$CP_LIB" -d "$WORK/test" @"$WORK/test.list" > "$WORK/test.log" 2>&1; then
+  cat "$WORK/test.log"
+  if [ "$MODE" = "new" ]; then
+    write_error_xml "compile_new_tests" "$WORK/test.log" $NEW_TESTS
+  else
+    write_error_xml "compile_base_tests" "$WORK/test.log"
+  fi
+  exit 1
+fi
+
+CLASSES=$(xargs grep -l '@Test' < "$WORK/test.list" | sed -e 's#^src/test/java/##' -e 's#\.java$##' -e 's#/#.#g' | sort)
+
+cat > "$WORK/runner/Dyn4jXmlRunner.java" <<'JAVA'
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Paths;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.junit.runner.Description;
+import org.junit.runner.JUnitCore;
+import org.junit.runner.Request;
+import org.junit.runner.notification.Failure;
+import org.junit.runner.notification.RunListener;
+
+public class Dyn4jXmlRunner {
+	static final class Case {
+		String classname;
+		String name;
+		double time;
+		String kind;
+		String message;
+		String detail;
+	}
+
+	static String esc(String s) {
+		if (s == null) return "";
+		StringBuilder sb = new StringBuilder();
+		for (char c : s.toCharArray()) {
+			switch (c) {
+				case '<': sb.append("&lt;"); break;
+				case '>': sb.append("&gt;"); break;
+				case '&': sb.append("&amp;"); break;
+				case '"': sb.append("&quot;"); break;
+				default:
+					if (c < 0x20 && c != '\n' && c != '\r' && c != '\t') sb.append('?'); else sb.append(c);
+			}
+		}
+		return sb.toString();
+	}
+
+	static String id(String s) {
+		return s == null ? "unknown" : s.replace("::", "_");
+	}
+
+	public static void main(String[] args) throws Exception {
+		final Map<String, Case> cases = new LinkedHashMap<String, Case>();
+		final Map<String, Long> starts = new LinkedHashMap<String, Long>();
+		RunListener listener = new RunListener() {
+			Case get(Description d) {
+				String key = d.getClassName() + "#" + d.getMethodName() + "#" + d.getDisplayName();
+				Case c = cases.get(key);
+				if (c == null) {
+					c = new Case();
+					c.classname = id(d.getClassName());
+					c.name = id(d.getMethodName() != null ? d.getMethodName() : d.getDisplayName());
+					cases.put(key, c);
+				}
+				return c;
+			}
+			@Override public void testStarted(Description d) { get(d); starts.put(d.getDisplayName(), System.nanoTime()); }
+			@Override public void testFinished(Description d) {
+				Long s = starts.get(d.getDisplayName());
+				if (s != null) get(d).time = (System.nanoTime() - s) / 1e9;
+			}
+			@Override public void testFailure(Failure f) {
+				Case c = get(f.getDescription());
+				Throwable t = f.getException();
+				c.kind = (t instanceof AssertionError) ? "failure" : "error";
+				c.message = String.valueOf(t);
+				StringWriter sw = new StringWriter();
+				t.printStackTrace(new PrintWriter(sw));
+				c.detail = sw.toString();
+			}
+			@Override public void testAssumptionFailure(Failure f) { get(f.getDescription()).kind = "skipped"; }
+			@Override public void testIgnored(Description d) { get(d).kind = "skipped"; }
+		};
+		List<Class<?>> classes = new ArrayList<Class<?>>();
+		for (int i = 1; i < args.length; i++) {
+			classes.add(Class.forName(args[i]));
+		}
+		JUnitCore core = new JUnitCore();
+		core.addListener(listener);
+		core.run(Request.classes(classes.toArray(new Class<?>[0])));
+		int failures = 0, errors = 0, skipped = 0;
+		for (Case c : cases.values()) {
+			if ("failure".equals(c.kind)) failures++;
+			else if ("error".equals(c.kind)) errors++;
+			else if ("skipped".equals(c.kind)) skipped++;
+		}
+		try (Writer w = Files.newBufferedWriter(Paths.get(args[0]), StandardCharsets.UTF_8)) {
+			w.write("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
+			w.write("<testsuite name=\"dyn4j\" tests=\"" + cases.size() + "\" failures=\"" + failures + "\" errors=\"" + errors + "\" skipped=\"" + skipped + "\">\n");
+			for (Case c : cases.values()) {
+				w.write("<testcase classname=\"" + esc(c.classname) + "\" name=\"" + esc(c.name) + "\" time=\"" + String.format(java.util.Locale.ROOT, "%.3f", c.time) + "\"");
+				if (c.kind == null) {
+					w.write("/>\n");
+				} else if ("skipped".equals(c.kind)) {
+					w.write("><skipped/></testcase>\n");
+				} else {
+					w.write("><" + c.kind + " message=\"" + esc(c.message) + "\">" + esc(c.detail) + "</" + c.kind + "></testcase>\n");
+				}
+			}
+			w.write("</testsuite>\n");
+		}
+		System.out.println("tests=" + cases.size() + " failures=" + failures + " errors=" + errors + " skipped=" + skipped);
+		System.exit(failures + errors == 0 && !cases.isEmpty() ? 0 : 1);
+	}
+}
+JAVA
+
+if ! javac -nowarn -cp "$CP_LIB" -d "$WORK/runner" "$WORK/runner/Dyn4jXmlRunner.java" > "$WORK/runner.log" 2>&1; then
+  cat "$WORK/runner.log"
+  write_error_xml "compile_runner" "$WORK/runner.log"
+  exit 1
+fi
+
+java -cp "$WORK/runner:$WORK/test:$WORK/main:$ROOT/src/test/resources:$CP_LIB" Dyn4jXmlRunner "$OUTPUT_PATH" $CLASSES > "$WORK/run.log" 2>&1
+STATUS=$?
+tail -n 5 "$WORK/run.log"
+if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  write_error_xml "run_${MODE}_tests" "$WORK/run.log"
+  exit 1
+fi
+exit $STATUS
