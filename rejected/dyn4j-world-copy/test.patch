+package org.dyn4j.world;
+
+import java.util.Iterator;
+
+import org.dyn4j.collision.AxisAlignedBounds;
+import org.dyn4j.dynamics.Body;
+import org.dyn4j.dynamics.contact.ContactConstraint;
+import org.dyn4j.dynamics.joint.Joint;
+import org.dyn4j.dynamics.joint.RevoluteJoint;
+import org.dyn4j.geometry.Geometry;
+import org.dyn4j.geometry.MassType;
+import org.dyn4j.geometry.Transform;
+import org.dyn4j.geometry.Vector2;
+import org.dyn4j.world.listener.StepListenerAdapter;
+import org.junit.Test;
+
+import junit.framework.TestCase;
+
+/**
+ * Contains the test cases for {@link World#copy()}.
+ */
+public class WorldCopy0cbf19Test {
+	private static Body box(double size, double x, double y) {
+		Body body = new Body();
+		body.addFixture(Geometry.createSquare(size));
+		body.setMass(MassType.NORMAL);
+		body.translate(x, y);
+		return body;
+	}
+	
+	private static Body ball(double radius, double x, double y) {
+		Body body = new Body();
+		body.addFixture(Geometry.createCircle(radius));
+		body.setMass(MassType.NORMAL);
+		body.translate(x, y);
+		return body;
+	}
+	
+	private static Body ground(double width, double x, double y) {
+		Body body = new Body();
+		body.addFixture(Geometry.createRectangle(width, 1.0));
+		body.setMass(MassType.INFINITE);
+		body.translate(x, y);
+		return body;
+	}
+	
+	private static World<Body> stackWithChain() {
+		World<Body> world = new World<Body>();
+		Body ground = ground(20.0, 0.0, 0.0);
+		world.addBody(ground);
+		for (int i = 0; i < 8; i++) {
+			world.addBody(box(0.5, 0.03 * i, 0.5 + 0.55 * i));
+		}
+		Body previous = ground;
+		for (int i = 0; i < 5; i++) {
+			Body link = ball(0.2, 3.0 + 0.5 * i, 5.0);
+			world.addBody(link);
+			world.addJoint(new RevoluteJoint<Body>(previous, link, new Vector2(2.75 + 0.5 * i, 5.0)));
+			previous = link;
+		}
+		return world;
+	}
+	
+	private static World<Body> rain() {
+		World<Body> world = new World<Body>();
+		world.addBody(ground(30.0, 0.0, 0.0));
+		Body slope = ground(10.0, -5.0, 3.0);
+		slope.rotateAboutCenter(0.3);
+		world.addBody(slope);
+		for (int i = 0; i < 30; i++) {
+			Body body = i % 2 == 0 ? box(0.4, -8.0 + (i % 6) * 1.1, 6.0 + (i / 6) * 1.3) : ball(0.25, -8.0 + (i % 6) * 1.1, 6.0 + (i / 6) * 1.3);
+			body.setLinearVelocity(0.5 * (i % 3), 0.0);
+			world.addBody(body);
+		}
+		return world;
+	}
+	
+	private static void assertSameState(String message, World<Body> expected, World<Body> actual) {
+		TestCase.assertEquals(message + " body count", expected.getBodyCount(), actual.getBodyCount());
+		for (int i = 0; i < expected.getBodyCount(); i++) {
+			Body e = expected.getBody(i);
+			Body a = actual.getBody(i);
+			Transform et = e.getTransform();
+			Transform at = a.getTransform();
+			String where = message + " body " + i;
+			TestCase.assertEquals(where + " x", Double.doubleToLongBits(et.getTranslationX()), Double.doubleToLongBits(at.getTranslationX()));
+			TestCase.assertEquals(where + " y", Double.doubleToLongBits(et.getTranslationY()), Double.doubleToLongBits(at.getTranslationY()));
+			TestCase.assertEquals(where + " cos", Double.doubleToLongBits(et.getCost()), Double.doubleToLongBits(at.getCost()));
+			TestCase.assertEquals(where + " sin", Double.doubleToLongBits(et.getSint()), Double.doubleToLongBits(at.getSint()));
+			TestCase.assertEquals(where + " vx", Double.doubleToLongBits(e.getLinearVelocity().x), Double.doubleToLongBits(a.getLinearVelocity().x));
+			TestCase.assertEquals(where + " vy", Double.doubleToLongBits(e.getLinearVelocity().y), Double.doubleToLongBits(a.getLinearVelocity().y));
+			TestCase.assertEquals(where + " w", Double.doubleToLongBits(e.getAngularVelocity()), Double.doubleToLongBits(a.getAngularVelocity()));
+			TestCase.assertEquals(where + " at rest", e.isAtRest(), a.isAtRest());
+		}
+	}
+	
+	private static void stepBothAndCompare(World<Body> original, World<Body> copy, int steps) {
+		assertSameState("before stepping", original, copy);
+		for (int i = 1; i <= steps; i++) {
+			original.step(1);
+			copy.step(1);
+			assertSameState("step " + i, original, copy);
+		}
+	}
+	
+	/**
+	 * Tests that a copy of a settled stack with a jointed chain steps exactly like the original.
+	 */
+	@Test
+	public void copyOfSettledStackStepsIdentically() {
+		World<Body> world = stackWithChain();
+		world.step(60);
+		stepBothAndCompare(world, world.copy(), 300);
+	}
+	
+	/**
+	 * Tests that a copy taken while bodies are still falling and colliding steps exactly like the original.
+	 */
+	@Test
+	public void copyOfMovingSceneStepsIdentically() {
+		World<Body> world = rain();
+		world.step(45);
+		stepBothAndCompare(world, world.copy(), 300);
+	}
+	
+	/**
+	 * Tests that a copy of a world that has never been stepped steps exactly like the original.
+	 */
+	@Test
+	public void copyOfUnsteppedWorldStepsIdentically() {
+		World<Body> world = rain();
+		stepBothAndCompare(world, world.copy(), 200);
+	}
+	
+	/**
+	 * Tests that a copy taken after bodies were removed steps exactly like the original.
+	 */
+	@Test
+	public void copyAfterRemovalsStepsIdentically() {
+		World<Body> world = stackWithChain();
+		world.step(40);
+		world.removeBody(world.getBody(3));
+		world.removeBody(world.getBody(10));
+		world.step(20);
+		stepBothAndCompare(world, world.copy(), 300);
+	}
+	
+	/**
+	 * Tests that a copy taken right after a body was removed steps exactly like the original.
+	 */
+	@Test
+	public void copyRightAfterRemovalStepsIdentically() {
+		World<Body> world = stackWithChain();
+		world.step(40);
+		world.removeBody(world.getBody(3));
+		stepBothAndCompare(world, world.copy(), 200);
+	}
+	
+	/**
+	 * Tests that a copy continues a simulation that uses varying step sizes exactly like the original.
+	 */
+	@Test
+	public void copyContinuesVaryingStepSizes() {
+		World<Body> world = stackWithChain();
+		world.step(30, 1.0 / 30.0);
+		World<Body> copy = world.copy();
+		for (int i = 1; i <= 150; i++) {
+			double dt = i % 3 == 0 ? 1.0 / 45.0 : 1.0 / 60.0;
+			world.step(1, dt);
+			copy.step(1, dt);
+			assertSameState("step " + i, world, copy);
+		}
+	}
+	
+	/**
+	 * Tests that a copy keeps the time the original accumulated through update.
+	 */
+	@Test
+	public void copyKeepsAccumulatedTime() {
+		World<Body> world = stackWithChain();
+		for (int i = 0; i < 50; i++) {
+			world.update(0.011);
+		}
+		World<Body> copy = world.copy();
+		TestCase.assertEquals(world.getAccumulatedTime(), copy.getAccumulatedTime());
+		for (int i = 1; i <= 150; i++) {
+			TestCase.assertEquals("update " + i, world.update(0.011), copy.update(0.011));
+			assertSameState("update " + i, world, copy);
+		}
+	}
+	
+	/**
+	 * Tests that contact constraint changes a caller made on the original carry over to the copy.
+	 */
+	@Test
+	public void copyKeepsContactConstraintState() {
+		World<Body> world = stackWithChain();
+		world.step(60);
+		int n = 0;
+		Iterator<WorldCollisionData<Body>> it = world.getCollisionDataIterator();
+		while (it.hasNext()) {
+			WorldCollisionData<Body> data = it.next();
+			if (data.isContactConstraintCollision()) {
+				if (n == 1) data.getContactConstraint().setTangentSpeed(0.5);
+				if (n == 2) data.getContactConstraint().setEnabled(false);
+				n++;
+			}
+		}
+		TestCase.assertTrue(n > 2);
+		stepBothAndCompare(world, world.copy(), 200);
+	}
+	
+	/**
+	 * Tests that the copy shares no bodies, joints, contacts, settings or bounds with the original.
+	 */
+	@Test
+	public void copyIsIndependent() {
+		World<Body> world = stackWithChain();
+		world.setBounds(new AxisAlignedBounds(100.0, 100.0));
+		world.step(60);
+		World<Body> copy = world.copy();
+		
+		for (int i = 0; i < world.getBodyCount(); i++) {
+			TestCase.assertNotSame(world.getBody(i), copy.getBody(i));
+			TestCase.assertNotSame(world.getBody(i).getFixture(0), copy.getBody(i).getFixture(0));
+		}
+		for (int i = 0; i < world.getJointCount(); i++) {
+			Joint<Body> joint = copy.getJoint(i);
+			TestCase.assertNotSame(world.getJoint(i), joint);
+			TestCase.assertTrue(copy.containsBody(joint.getBody(0)));
+			TestCase.assertTrue(copy.containsBody(joint.getBody(1)));
+		}
+		Iterator<WorldCollisionData<Body>> it = copy.getCollisionDataIterator();
+		int contacts = 0;
+		while (it.hasNext()) {
+			ContactConstraint<Body> cc = it.next().getContactConstraint();
+			TestCase.assertTrue(copy.containsBody(cc.getBody1()));
+			TestCase.assertTrue(copy.containsBody(cc.getBody2()));
+			contacts++;
+		}
+		TestCase.assertTrue(contacts > 0);
+		TestCase.assertNotSame(world.getSettings(), copy.getSettings());
+		TestCase.assertNotSame(world.getGravity(), copy.getGravity());
+		TestCase.assertNotSame(world.getBounds(), copy.getBounds());
+		TestCase.assertNotSame(world.getTimeStep(), copy.getTimeStep());
+		
+		World<Body> twin = world.copy();
+		copy.setGravity(0.0, 5.0);
+		copy.getSettings().setStepFrequency(1.0 / 30.0);
+		copy.getBounds().translate(500.0, 0.0);
+		copy.getBody(3).translate(0.0, 2.0);
+		copy.removeBody(copy.getBody(5));
+		copy.step(30);
+		stepBothAndCompare(world, twin, 100);
+	}
+	
+	/**
+	 * Tests that listeners are not copied.
+	 */
+	@Test
+	public void copyHasNoListeners() {
+		World<Body> world = stackWithChain();
+		final int[] calls = new int[1];
+		world.addStepListener(new StepListenerAdapter<Body>() {
+			@Override
+			public void begin(org.dyn4j.dynamics.TimeStep step, PhysicsWorld<Body, ?> w) {
+				calls[0]++;
+			}
+		});
+		world.step(5);
+		World<Body> copy = world.copy();
+		TestCase.assertTrue(copy.getStepListeners().isEmpty());
+		copy.step(5);
+		TestCase.assertEquals(5, calls[0]);
+	}
+}
diff --git a/test.sh b/test.sh
