+package org.dyn4j.world;
+
+import java.util.HashMap;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+import org.dyn4j.Unsafe;
+import org.dyn4j.collision.BasicCollisionItem;
+import org.dyn4j.collision.BasicCollisionPair;
+import org.dyn4j.collision.CollisionBody;
+import org.dyn4j.collision.CollisionItem;
+import org.dyn4j.collision.CollisionPair;
+import org.dyn4j.collision.Fixture;
+
+/**
+ * Copies the bodies of a world and maps each body and body-fixture item of the world
+ * to its copy.
+ * @author William Bittle
+ * @version 6.1.0
+ * @since 6.1.0
+ * @param <T> the {@link CollisionBody} type
+ * @param <E> the {@link Fixture} type
+ */
+final class WorldCopy<T extends CollisionBody<E>, E extends Fixture> {
+	/** The copy of each body */
+	final Map<T, T> bodies;
+	
+	/** The copy of each body-fixture item */
+	final Map<CollisionItem<T, E>, CollisionItem<T, E>> items;
+	
+	/**
+	 * Copies the given bodies.
+	 * @param bodies the bodies to copy
+	 */
+	WorldCopy(List<T> bodies) {
+		this.bodies = new IdentityHashMap<T, T>();
+		this.items = new HashMap<CollisionItem<T, E>, CollisionItem<T, E>>();
+		for (T body : bodies) {
+			T copy = Unsafe.copy(body);
+			this.bodies.put(body, copy);
+			int size = body.getFixtureCount();
+			for (int i = 0; i < size; i++) {
+				this.items.put(new BasicCollisionItem<T, E>(body, body.getFixture(i)), new BasicCollisionItem<T, E>(copy, copy.getFixture(i)));
+			}
+		}
+	}
+	
+	/**
+	 * Returns the copy of the given pair or null if either item is no longer part of the world.
+	 * @param pair the pair
+	 * @return {@link CollisionPair}
+	 */
+	CollisionPair<CollisionItem<T, E>> pair(CollisionPair<CollisionItem<T, E>> pair) {
+		CollisionItem<T, E> first = this.items.get(pair.getFirst());
+		CollisionItem<T, E> second = this.items.get(pair.getSecond());
+		if (first == null || second == null) {
+			return null;
+		}
+		return new BasicCollisionPair<CollisionItem<T, E>>(first, second);
+	}
+}
