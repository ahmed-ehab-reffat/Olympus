+	/**
+	 * Copy constructor.
+	 * <p>
+	 * Builds a graph with the same nodes and edges, in the same order, as the given graph using the
+	 * replacement of each body, joint and contact constraint.
+	 * @param graph the graph to copy
+	 * @param bodies the replacement for each body
+	 * @param joints the replacement for each joint
+	 * @param contactConstraints the replacement for each contact constraint
+	 * @since 6.1.0
+	 */
+	ConstraintGraph(ConstraintGraph<T> graph, Map<T, T> bodies, Map<Joint<T>, Joint<T>> joints, Map<ContactConstraint<T>, ContactConstraint<T>> contactConstraints) {
+		this(graph.graph.size(), joints.size());
+		
+		for (ConstraintGraphNode<T> node : graph.graph.values()) {
+			T body = bodies.get(node.body);
+			if (body == null) {
+				continue;
+			}
+			
+			ConstraintGraphNode<T> copy = new ConstraintGraphNode<T>(body);
+			for (Joint<T> joint : node.joints) {
+				copy.joints.add(joints.get(joint));
+			}
+			for (ContactConstraint<T> contactConstraint : node.contactConstraints) {
+				ContactConstraint<T> cc = contactConstraints.get(contactConstraint);
+				if (cc != null) {
+					copy.contactConstraints.add(cc);
+				}
+			}
+			this.graph.put(body, copy);
+		}
+	}
