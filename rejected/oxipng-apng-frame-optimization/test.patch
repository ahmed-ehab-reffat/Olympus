index 00000000..52e659f2
--- /dev/null
+++ b/tests/apng_frames_8ecd58.rs
@@ -0,0 +1,1206 @@
+#![cfg(feature = "sanity-checks")]
+
+use std::{fs, io::Cursor, path::PathBuf, process::Command};
+
+use image::{AnimationDecoder, DynamicImage, RgbaImage, codecs::png::PngDecoder};
+use oxipng::{internal_tests::*, *};
+
+type Px = [u8; 4];
+
+const NONE: u8 = 0;
+const BACKGROUND: u8 = 1;
+const PREVIOUS: u8 = 2;
+const SOURCE: u8 = 0;
+const OVER: u8 = 1;
+
+const RED: Px = [220, 20, 20, 255];
+const GREEN: Px = [20, 200, 40, 255];
+const BLUE: Px = [30, 40, 210, 255];
+const WHITE: Px = [255, 255, 255, 255];
+const CLEAR: Px = [0, 0, 0, 0];
+
+#[derive(Clone)]
+struct Fr {
+    x: u32,
+    y: u32,
+    w: u32,
+    h: u32,
+    delay: (u16, u16),
+    dispose: u8,
+    blend: u8,
+    px: Vec<Px>,
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Format {
+    Rgba,
+    Indexed(u8),
+    Interlaced,
+}
+
+struct Anim {
+    w: u32,
+    h: u32,
+    hidden: Option<Vec<Px>>,
+    frames: Vec<Fr>,
+    plays: u32,
+    format: Format,
+}
+
+#[derive(Debug, PartialEq, Clone, Copy)]
+struct Ctl {
+    x: u32,
+    y: u32,
+    w: u32,
+    h: u32,
+    delay: (u16, u16),
+    dispose: u8,
+    blend: u8,
+}
+
+struct Parsed {
+    depth: u8,
+    color_type: u8,
+    interlaced: bool,
+    actl: (u32, u32),
+    ctls: Vec<Ctl>,
+    default_in_animation: bool,
+    fdat_count: usize,
+}
+
+fn fr(x: u32, y: u32, w: u32, h: u32, px: Vec<Px>) -> Fr {
+    Fr {
+        x,
+        y,
+        w,
+        h,
+        delay: (1, 10),
+        dispose: NONE,
+        blend: SOURCE,
+        px,
+    }
+}
+
+fn with(mut f: Fr, dispose: u8, blend: u8) -> Fr {
+    f.dispose = dispose;
+    f.blend = blend;
+    f
+}
+
+fn delayed(mut f: Fr, num: u16, den: u16) -> Fr {
+    f.delay = (num, den);
+    f
+}
+
+fn solid(w: u32, h: u32, c: Px) -> Vec<Px> {
+    vec![c; (w * h) as usize]
+}
+
+fn paint(mut px: Vec<Px>, w: u32, cells: &[(u32, u32)], c: Px) -> Vec<Px> {
+    for &(x, y) in cells {
+        px[(y * w + x) as usize] = c;
+    }
+    px
+}
+
+fn block(mut px: Vec<Px>, w: u32, x0: u32, y0: u32, bw: u32, bh: u32, c: Px) -> Vec<Px> {
+    for y in y0..y0 + bh {
+        for x in x0..x0 + bw {
+            px[(y * w + x) as usize] = c;
+        }
+    }
+    px
+}
+
+fn gradient(w: u32, h: u32, seed: u32) -> Vec<Px> {
+    (0..w * h)
+        .map(|i| {
+            let v = (i * 7 + seed * 13) % 251;
+            [v as u8, (v * 3 % 256) as u8, (255 - v) as u8, 255]
+        })
+        .collect()
+}
+
+fn anim(w: u32, h: u32, frames: Vec<Fr>) -> Anim {
+    Anim {
+        w,
+        h,
+        hidden: None,
+        frames,
+        plays: 0,
+        format: Format::Rgba,
+    }
+}
+
+fn chunk(out: &mut Vec<u8>, name: &[u8], data: &[u8]) {
+    out.extend_from_slice(&(data.len() as u32).to_be_bytes());
+    let mut body = name.to_vec();
+    body.extend_from_slice(data);
+    out.extend_from_slice(&body);
+    out.extend_from_slice(&crc32(&body).to_be_bytes());
+}
+
+fn palette_of(a: &Anim) -> Vec<Px> {
+    let mut palette: Vec<Px> = Vec::new();
+    let all = a
+        .hidden
+        .iter()
+        .flatten()
+        .chain(a.frames.iter().flat_map(|f| f.px.iter()));
+    for p in all {
+        if !palette.contains(p) {
+            palette.push(*p);
+        }
+    }
+    palette
+}
+
+fn scanline(format: Format, palette: &[Px], row: &[Px]) -> Vec<u8> {
+    match format {
+        Format::Indexed(depth) => {
+            let mut bytes = vec![0u8; (row.len() * depth as usize).div_ceil(8)];
+            for (i, p) in row.iter().enumerate() {
+                let idx = palette.iter().position(|c| c == p).unwrap() as u8;
+                let bit = i * depth as usize;
+                bytes[bit / 8] |= idx << (8 - depth as usize - bit % 8);
+            }
+            bytes
+        }
+        _ => row.iter().flatten().copied().collect(),
+    }
+}
+
+fn image_data(format: Format, palette: &[Px], w: u32, h: u32, px: &[Px]) -> Vec<u8> {
+    let mut raw = Vec::new();
+    if format == Format::Interlaced {
+        let passes = [
+            (0, 0, 8, 8),
+            (4, 0, 8, 8),
+            (0, 4, 4, 8),
+            (2, 0, 4, 4),
+            (0, 2, 2, 4),
+            (1, 0, 2, 2),
+            (0, 1, 1, 2),
+        ];
+        for (x0, y0, dx, dy) in passes {
+            if x0 >= w || y0 >= h {
+                continue;
+            }
+            for y in (y0..h).step_by(dy as usize) {
+                let row: Vec<Px> = (x0..w)
+                    .step_by(dx as usize)
+                    .map(|x| px[(y * w + x) as usize])
+                    .collect();
+                raw.push(0);
+                raw.extend(scanline(format, palette, &row));
+            }
+        }
+    } else {
+        for row in px.chunks(w as usize) {
+            raw.push(0);
+            raw.extend(scanline(format, palette, row));
+        }
+    }
+    deflate(&raw, 6, None).unwrap()
+}
+
+fn fctl(seq: u32, f: &Fr) -> Vec<u8> {
+    let mut d = seq.to_be_bytes().to_vec();
+    for v in [f.w, f.h, f.x, f.y] {
+        d.extend_from_slice(&v.to_be_bytes());
+    }
+    d.extend_from_slice(&f.delay.0.to_be_bytes());
+    d.extend_from_slice(&f.delay.1.to_be_bytes());
+    d.extend_from_slice(&[f.dispose, f.blend]);
+    d
+}
+
+fn encode(a: &Anim) -> Vec<u8> {
+    let palette = palette_of(a);
+    let (depth, color_type) = match a.format {
+        Format::Indexed(depth) => (depth, 3),
+        _ => (8, 6),
+    };
+    let mut out = vec![0x89, b'P', b'N', b'G', 13, 10, 26, 10];
+    let mut ihdr = a.w.to_be_bytes().to_vec();
+    ihdr.extend_from_slice(&a.h.to_be_bytes());
+    ihdr.extend_from_slice(&[
+        depth,
+        color_type,
+        0,
+        0,
+        u8::from(a.format == Format::Interlaced),
+    ]);
+    chunk(&mut out, b"IHDR", &ihdr);
+    let mut actl = (a.frames.len() as u32).to_be_bytes().to_vec();
+    actl.extend_from_slice(&a.plays.to_be_bytes());
+    chunk(&mut out, b"acTL", &actl);
+    if color_type == 3 {
+        let plte: Vec<u8> = palette.iter().flat_map(|p| p[..3].to_vec()).collect();
+        chunk(&mut out, b"PLTE", &plte);
+        let trns: Vec<u8> = palette.iter().map(|p| p[3]).collect();
+        chunk(&mut out, b"tRNS", &trns);
+    }
+    let mut seq = 0;
+    let rest = match &a.hidden {
+        Some(img) => {
+            chunk(
+                &mut out,
+                b"IDAT",
+                &image_data(a.format, &palette, a.w, a.h, img),
+            );
+            &a.frames[..]
+        }
+        None => {
+            chunk(&mut out, b"fcTL", &fctl(0, &a.frames[0]));
+            seq = 1;
+            let first = &a.frames[0];
+            chunk(
+                &mut out,
+                b"IDAT",
+                &image_data(a.format, &palette, a.w, a.h, &first.px),
+            );
+            &a.frames[1..]
+        }
+    };
+    for f in rest {
+        chunk(&mut out, b"fcTL", &fctl(seq, f));
+        let mut d = (seq + 1).to_be_bytes().to_vec();
+        d.extend(image_data(a.format, &palette, f.w, f.h, &f.px));
+        chunk(&mut out, b"fdAT", &d);
+        seq += 2;
+    }
+    chunk(&mut out, b"IEND", &[]);
+    out
+}
+
+fn be32(d: &[u8]) -> u32 {
+    u32::from_be_bytes(d[..4].try_into().unwrap())
+}
+
+fn be16(d: &[u8]) -> u16 {
+    u16::from_be_bytes(d[..2].try_into().unwrap())
+}
+
+fn parse(data: &[u8]) -> Parsed {
+    let mut p = Parsed {
+        depth: 0,
+        color_type: 0,
+        interlaced: false,
+        actl: (0, 0),
+        ctls: Vec::new(),
+        default_in_animation: false,
+        fdat_count: 0,
+    };
+    let mut seen_idat = false;
+    let mut i = 8;
+    while i < data.len() {
+        let n = be32(&data[i..]) as usize;
+        let name = &data[i + 4..i + 8];
+        let d = &data[i + 8..i + 8 + n];
+        match name {
+            b"IHDR" => {
+                p.depth = d[8];
+                p.color_type = d[9];
+                p.interlaced = d[12] == 1;
+            }
+            b"acTL" => p.actl = (be32(d), be32(&d[4..])),
+            b"IDAT" => seen_idat = true,
+            b"fdAT" => p.fdat_count += 1,
+            b"fcTL" => {
+                if !seen_idat {
+                    p.default_in_animation = true;
+                }
+                p.ctls.push(Ctl {
+                    w: be32(&d[4..]),
+                    h: be32(&d[8..]),
+                    x: be32(&d[12..]),
+                    y: be32(&d[16..]),
+                    delay: (be16(&d[20..]), be16(&d[22..])),
+                    dispose: d[24],
+                    blend: d[25],
+                });
+            }
+            _ => {}
+        }
+        i += 12 + n;
+    }
+    p
+}
+
+fn visible(img: RgbaImage) -> Vec<Px> {
+    img.pixels()
+        .map(|p| if p.0[3] == 0 { CLEAR } else { p.0 })
+        .collect()
+}
+
+fn frames_of(data: &[u8]) -> Vec<(Vec<Px>, (u64, u64))> {
+    let decoder = PngDecoder::new(Cursor::new(data)).unwrap();
+    decoder
+        .apng()
+        .unwrap()
+        .into_frames()
+        .map(|f| {
+            let f = f.unwrap();
+            let (num, den) = f.delay().numer_denom_ms();
+            (visible(f.into_buffer()), (u64::from(num), u64::from(den)))
+        })
+        .collect()
+}
+
+fn timeline(data: &[u8]) -> Vec<(Vec<Px>, (u64, u64))> {
+    let mut merged: Vec<(Vec<Px>, (u64, u64))> = Vec::new();
+    for (img, (num, den)) in frames_of(data) {
+        match merged.last_mut() {
+            Some((last, (n, d))) if *last == img => {
+                *n = *n * den + num * *d;
+                *d *= den;
+            }
+            _ => merged.push((img, (num, den))),
+        }
+    }
+    merged
+}
+
+fn same_delay(a: (u64, u64), b: (u64, u64)) -> bool {
+    a.0 * b.1 == b.0 * a.1
+}
+
+fn default_image(data: &[u8]) -> Vec<Px> {
+    let decoder = PngDecoder::new(Cursor::new(data)).unwrap();
+    visible(DynamicImage::from_decoder(decoder).unwrap().into_rgba8())
+}
+
+fn assert_plays_same(input: &[u8], output: &[u8]) {
+    let (a, b) = (timeline(input), timeline(output));
+    assert_eq!(
+        a.len(),
+        b.len(),
+        "number of distinct displayed canvases differs"
+    );
+    for (i, ((ia, da), (ib, db))) in a.iter().zip(&b).enumerate() {
+        assert!(ia == ib, "displayed canvas {i} differs");
+        assert!(
+            same_delay(*da, *db),
+            "display time {i} differs: {da:?} vs {db:?}"
+        );
+    }
+    assert_eq!(
+        default_image(input),
+        default_image(output),
+        "default image differs"
+    );
+}
+
+fn opts() -> Options {
+    Options {
+        force: true,
+        ..Options::from_preset(2)
+    }
+}
+
+fn run_with(a: &Anim, opts: &Options) -> (Vec<u8>, Vec<u8>, Parsed) {
+    let input = encode(a);
+    let output = optimize_from_memory(&input, opts).unwrap();
+    let parsed = parse(&output);
+    (input, output, parsed)
+}
+
+fn run(a: &Anim) -> (Vec<u8>, Vec<u8>, Parsed) {
+    run_with(a, &opts())
+}
+
+fn rect(c: &Ctl) -> (u32, u32, u32, u32) {
+    (c.x, c.y, c.w, c.h)
+}
+
+fn secs(d: (u16, u16)) -> (u64, u64) {
+    (u64::from(d.0), if d.1 == 0 { 100 } else { u64::from(d.1) })
+}
+
+fn assert_frame_count(p: &Parsed, n: usize) {
+    assert_eq!(p.ctls.len(), n);
+    assert_eq!(p.actl.0 as usize, n);
+    let expected_fdat = if p.default_in_animation { n - 1 } else { n };
+    assert_eq!(p.fdat_count, expected_fdat);
+}
+
+fn four_color_frames() -> Vec<Fr> {
+    let base = block(solid(48, 48, RED), 48, 0, 24, 48, 24, GREEN);
+    vec![
+        fr(0, 0, 48, 48, base.clone()),
+        fr(0, 0, 48, 48, block(base.clone(), 48, 8, 8, 16, 16, BLUE)),
+        fr(0, 0, 48, 48, block(base, 48, 20, 20, 12, 12, WHITE)),
+    ]
+}
+
+#[test]
+fn opaque_animation_drops_alpha_channel() {
+    let (input, output, p) = run(&anim(48, 48, four_color_frames()));
+    assert!(
+        matches!(p.color_type, 0 | 2 | 3),
+        "color type {}",
+        p.color_type
+    );
+    assert_plays_same(&input, &output);
+}
+
+#[test]
+fn few_color_animation_is_reduced_below_rgba8() {
+    let (input, output, p) = run(&anim(48, 48, four_color_frames()));
+    assert!(matches!(p.color_type, 0 | 3), "color type {}", p.color_type);
+    assert_plays_same(&input, &output);
+}
+
+#[test]
+fn palette_covers_colors_of_every_frame() {
+    let mut frames = vec![fr(
+        0,
+        0,
+        40,
+        40,
+        block(solid(40, 40, RED), 40, 0, 0, 20, 40, GREEN),
+    )];
+    for k in 0..6u8 {
+        let c1 = [10 + k * 30, 100, 50, 255];
+        let c2 = [60, 10 + k * 35, 200, 255];
+        let px = block(
+            block(solid(40, 40, RED), 40, 0, 0, 20, 40, c1),
+            40,
+            20,
+            0,
+            20,
+            40,
+            c2,
+        );
+        frames.push(fr(0, 0, 40, 40, px));
+    }
+    let (input, output, p) = run(&anim(40, 40, frames));
+    assert_ne!((p.color_type, p.depth), (6, 8));
+    assert_plays_same(&input, &output);
+}
+
+#[test]
+fn hidden_default_image_colors_survive_reduction() {
+    let mut hidden = block(solid(40, 40, BLUE), 40, 0, 0, 40, 10, WHITE);
+    hidden = block(hidden, 40, 0, 30, 40, 10, [250, 200, 0, 255]);
+    let mut a = anim(
+        40,
+        40,
+        four_color_frames()
+            .into_iter()
+            .map(|f| {
+                let px =
+                    f.px.chunks(48)
+                        .take(40)
+                        .flat_map(|r| r[..40].to_vec())
+                        .collect();
+                fr(0, 0, 40, 40, px)
+            })
+            .collect(),
+    );
+    a.hidden = Some(hidden);
+    let (input, output, p) = run(&a);
+    assert!(!p.default_in_animation);
+    assert_ne!((p.color_type, p.depth), (6, 8));
+    assert_plays_same(&input, &output);
+}
+
+#[test]
+fn grayscale_frames_with_one_colored_frame_stay_color() {
+    let gray = |v: u8| [v, v, v, 255];
+    let frames = vec![
+        fr(
+            0,
+            0,
+            32,
+            32,
+            gradient(32, 32, 1).iter().map(|p| gray(p[0])).collect(),
+        ),
+        fr(
+            0,
+            0,
+            32,
+            32,
+            gradient(32, 32, 2).iter().map(|p| gray(p[1])).collect(),
+        ),
+        fr(
+            0,
+            0,
+            32,
+            32,
+            paint(
+                gradient(32, 32, 3).iter().map(|p| gray(p[2])).collect(),
+                32,
+                &[(31, 31)],
+                RED,
+            ),
+        ),
+    ];
+    let (input, output, p) = run(&anim(32, 32, frames));
+    assert!(matches!(p.color_type, 2 | 3), "color type {}", p.color_type);
+    assert_plays_same(&input, &output);
+}
+
+#[test]
+fn grayscale_animation_becomes_grayscale() {
+    let gray = |v: u8| [v, v, v, 255];
+    let frames = vec![
+        fr(
+            0,
+            0,
+            32,
+            32,
+            gradient(32, 32, 1).iter().map(|p| gray(p[0])).collect(),
+        ),
+        fr(
+            0,
+            0,
+            32,
+            32,
+            gradient(32, 32, 5).iter().map(|p| gray(p[1])).collect(),
+        ),
+    ];
+    let (input, output, p) = run(&anim(32, 32, frames));
+    assert!(matches!(p.color_type, 0 | 3), "color type {}", p.color_type);
+    assert_plays_same(&input, &output);
+}
+
+fn many_colors(w: u32, h: u32) -> Vec<Px> {
+    (0..w * h)
+        .map(|i| [(i % 251) as u8 + 3, (i / 251) as u8 + 3, 90, 255])
+        .collect()
+}
+
+#[test]
+fn transparency_color_is_unused_in_every_frame() {
+    let first = paint(
+        many_colors(64, 64),
+        64,
+        &[(0, 0), (9, 9), (40, 3)],
+        [0, 0, 0, 255],
+    );
+    let second = block(many_colors(64, 64), 64, 10, 10, 20, 20, CLEAR);
+    let a = anim(
+        64,
+        64,
+        vec![fr(0, 0, 64, 64, first), fr(0, 0, 64, 64, second)],
+    );
+    let opts = Options {
+        optimize_alpha: true,
+        ..opts()
+    };
+    let (input, output, p) = run_with(&a, &opts);
+    assert_eq!(p.color_type, 2);
+    assert_plays_same(&input, &output);
+}
+
+#[test]
+fn interlaced_animation_is_deinterlaced_by_default() {
+    let mut a = anim(
+        24,
