+fn cli(args: &[&str], a: &Anim, name: &str) -> Parsed {
+    let input = PathBuf::from(format!("tests/files/{name}.png"));
+    let output = input.with_extension("out.png");
+    fs::write(&input, encode(a)).unwrap();
+    let status = Command::new(env!("CARGO_BIN_EXE_oxipng"))
+        .args(args)
+        .arg("--force")
+        .arg("--out")
+        .arg(&output)
+        .arg(&input)
+        .output()
+        .unwrap();
+    assert!(
+        status.status.success(),
+        "{}",
+        String::from_utf8_lossy(&status.stderr)
+    );
+    let data = fs::read(&output).unwrap();
+    let original = fs::read(&input).unwrap();
+    fs::remove_file(&input).ok();
+    fs::remove_file(&output).ok();
+    assert_plays_same(&original, &data);
+    parse(&data)
+}
