+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"; export CARGO_INCREMENTAL=0; export RUSTC_BOOTSTRAP=1
+MODE=""; OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+TEST_JSON="$(mktemp)"; TEST_ERR="$(mktemp)"; STATUS=0
+BASE_TARGETS="--lib --bins --test alpha --test filters --test flags --test interlaced --test interlacing --test lib --test raw --test reduction --test regression --test strategies"
+case "$MODE" in
+  base) cargo test --features sanity-checks $BASE_TARGETS -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"; STATUS=$? ;;
+  new)  cargo test --features sanity-checks --test apng_frames_8ecd58 -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"; STATUS=$? ;;
+esac
+cat "$TEST_ERR" >&2
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2>/dev/null || true
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    sanitized=$( { cat "$TEST_ERR"; cat "$TEST_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    if [ "$MODE" = "new" ]; then
+      count=0; cases=""
+      for name in $(grep -A1 '^#\[test\]' tests/apng_frames_8ecd58.rs | sed -n 's/^fn \([a-z0-9_]*\)().*/\1/p'); do
+        count=$((count + 1))
+        cases="${cases}    <testcase name=\"${name}\" classname=\"\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+      done
+    else
+      count=1
+      cases="    <testcase name=\"compilation\" classname=\"cargo-test\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+    fi
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+      printf '  <testsuite name="cargo test #0" tests="%s" failures="%s" errors="0">\n' "$count" "$count"
+      printf '%s' "$cases"
+      printf '  </testsuite>\n</testsuites>\n'
+    } > "$OUTPUT_PATH"
+  fi
+fi
+exit $STATUS
