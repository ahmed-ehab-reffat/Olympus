+    );
+    let b = anim(
+        12,
+        12,
+        vec![
+            fr(0, 0, 12, 12, base.clone()),
+            fr(0, 0, 12, 12, paint(base, 12, &[(5, 6)], WHITE)),
+        ],
+    );
+    assert!(!validate_output(&encode(&b), &encode(&a)));
+}
