+use crate::{apng::Frame, colors::ColorType, headers::IhdrData, png::PngImage};
+
+const DISPOSE_BACKGROUND: u8 = 1;
+const DISPOSE_PREVIOUS: u8 = 2;
+const BLEND_OVER: u8 = 1;
+
+type Pixel = [u16; 4];
+
+/// A frame of the animation together with its decoded image
+#[derive(Debug, Clone)]
+pub struct AnimationFrame {
+    pub control: Frame,
+    pub image: PngImage,
+}
+
+/// Read a pixel as normalized 16-bit RGBA, with every fully transparent pixel reading the same
+fn read_pixel(png: &PngImage, x: usize, y: usize) -> Pixel {
+    let bytes = png.bytes_per_channel();
+    let channels = png.channels_per_pixel();
+    let row = png.ihdr.width as usize * bytes * channels;
+    let start = y * row + x * bytes * channels;
+    let sample = |c: usize| -> u16 {
+        let i = start + c * bytes;
+        if bytes == 2 {
+            u16::from_be_bytes([png.data[i], png.data[i + 1]])
+        } else {
+            u16::from(png.data[i])
+        }
+    };
+    let scale = |v: u16| if bytes == 2 { v } else { v * 257 };
+    let px = match &png.ihdr.color_type {
+        ColorType::Grayscale { transparent_shade } => {
+            let v = sample(0);
+            let a = if Some(v) == *transparent_shade {
+                0
+            } else {
+                65535
+            };
+            [scale(v), scale(v), scale(v), a]
+        }
+        ColorType::RGB { transparent_color } => {
+            let (r, g, b) = (sample(0), sample(1), sample(2));
+            let key = transparent_color.is_some_and(|t| t.r == r && t.g == g && t.b == b);
+            [scale(r), scale(g), scale(b), if key { 0 } else { 65535 }]
+        }
+        ColorType::Indexed { palette } => {
+            let c = palette
+                .get(png.data[start] as usize)
+                .copied()
+                .unwrap_or_default();
+            [c.r, c.g, c.b, c.a].map(|v| u16::from(v) * 257)
+        }
+        ColorType::GrayscaleAlpha => [sample(0), sample(0), sample(0), sample(1)].map(scale),
+        ColorType::RGBA => [sample(0), sample(1), sample(2), sample(3)].map(scale),
+    };
+    if px[3] == 0 { [0; 4] } else { px }
+}
+
+/// Composite a pixel over another as described by the APNG specification
+fn blend_over(bg: Pixel, fg: Pixel) -> Pixel {
+    match fg[3] {
+        0 => return bg,
+        65535 => return fg,
+        _ => {}
+    }
+    let fa = f64::from(fg[3]) / 65535.0;
+    let ba = f64::from(bg[3]) / 65535.0;
+    let out_a = fa + ba * (1.0 - fa);
+    let mut out = [0; 4];
+    for c in 0..3 {
+        let v = (f64::from(fg[c]) * fa + f64::from(bg[c]) * ba * (1.0 - fa)) / out_a;
+        out[c] = v.round() as u16;
+    }
+    out[3] = (out_a * 65535.0).round() as u16;
+    out
+}
+
+/// The canvas region covered by a frame, as (x, y, width, height)
+fn region(frame: &Frame) -> (usize, usize, usize, usize) {
+    (
+        frame.x_offset as usize,
+        frame.y_offset as usize,
+        frame.width as usize,
+        frame.height as usize,
+    )
+}
+
+/// Render a frame onto the state left by the previous frame, returning the displayed canvas and
+/// the state it leaves for the next frame
+fn render(before: &[Pixel], width: usize, frame: &AnimationFrame) -> (Vec<Pixel>, Vec<Pixel>) {
+    let (fx, fy, fw, fh) = region(&frame.control);
+    let mut displayed = before.to_vec();
+    for y in 0..fh {
+        for x in 0..fw {
+            let i = (fy + y) * width + fx + x;
+            let px = read_pixel(&frame.image, x, y);
+            displayed[i] = if frame.control.blend_op == BLEND_OVER {
+                blend_over(before[i], px)
+            } else {
+                px
+            };
+        }
+    }
+    let mut after = displayed.clone();
+    for y in fy..fy + fh {
+        for x in fx..fx + fw {
+            let i = y * width + x;
+            match frame.control.dispose_op {
+                DISPOSE_BACKGROUND => after[i] = [0; 4],
+                DISPOSE_PREVIOUS => after[i] = before[i],
+                _ => {}
+            }
+        }
+    }
+    (displayed, after)
+}
+
+/// The smallest rectangle of a frame's region that still produces the same displayed canvas and
+/// leaves the same state for the next frame
+fn needed_rect(
+    frame: &Frame,
+    width: usize,
+    before: &[Pixel],
+    displayed: &[Pixel],
+) -> Option<(usize, usize, usize, usize)> {
+    let (fx, fy, fw, fh) = region(frame);
+    let mut bounds: Option<(usize, usize, usize, usize)> = None;
+    for y in fy..fy + fh {
+        for x in fx..fx + fw {
+            let i = y * width + x;
+            let changed = displayed[i] != before[i];
+            let cleared = frame.dispose_op == DISPOSE_BACKGROUND && displayed[i][3] != 0;
+            if changed || cleared {
+                bounds = Some(match bounds {
+                    None => (x, y, x, y),
+                    Some((x0, y0, x1, y1)) => (x0.min(x), y0.min(y), x1.max(x), y1.max(y)),
+                });
+            }
+        }
+    }
+    bounds.map(|(x0, y0, x1, y1)| (x0, y0, x1 - x0 + 1, y1 - y0 + 1))
+}
+
+/// Cut a rectangle out of an image of 8 or more bits per channel
+fn cropped_image(png: &PngImage, x: usize, y: usize, width: usize, height: usize) -> PngImage {
+    let pixel_bytes = png.ihdr.bpp() / 8;
+    let row = png.ihdr.width as usize * pixel_bytes;
+    let mut data = Vec::with_capacity(width * height * pixel_bytes);
+    for line in y..y + height {
+        let start = line * row + x * pixel_bytes;
+        data.extend_from_slice(&png.data[start..start + width * pixel_bytes]);
+    }
+    PngImage {
+        data,
+        ihdr: IhdrData {
+            width: width as u32,
+            height: height as u32,
+            color_type: png.ihdr.color_type.clone(),
+            ..png.ihdr
+        },
+    }
+}
+
+fn gcd(a: u64, b: u64) -> u64 {
+    if b == 0 { a } else { gcd(b, a % b) }
+}
+
+/// Add two frame delays exactly, returning `None` if the total cannot be stored in a fcTL chunk
+#[must_use]
+pub fn added_delays(a: (u16, u16), b: (u16, u16)) -> Option<(u16, u16)> {
+    let den = |d: u16| if d == 0 { 100 } else { u64::from(d) };
+    let (an, ad) = (u64::from(a.0), den(a.1));
+    let (bn, bd) = (u64::from(b.0), den(b.1));
+    let num = an * bd + bn * ad;
+    let den = ad * bd;
+    let divisor = gcd(num, den).max(1);
+    let (num, den) = (num / divisor, den / divisor);
+    Some((u16::try_from(num).ok()?, u16::try_from(den).ok()?))
+}
+
+/// Crop each frame to the region that changes the animation and merge frames that change nothing
+/// into the frame before them. The first frame is never altered.
+#[must_use]
+pub fn optimized_frames(
+    frames: Vec<AnimationFrame>,
+    width: u32,
+    height: u32,
+) -> Vec<AnimationFrame> {
+    let width = width as usize;
+    let mut before = vec![[0; 4]; width * height as usize];
+    let mut last: Option<(Vec<Pixel>, Vec<Pixel>)> = None;
+    let mut kept: Vec<AnimationFrame> = Vec::with_capacity(frames.len());
+    for mut frame in frames {
+        let (displayed, after) = render(&before, width, &frame);
+        if let (Some((last_displayed, last_after)), Some(prev)) = (&last, kept.last_mut()) {
+            let prev_delay = (prev.control.delay_num, prev.control.delay_den);
+            let delay = (frame.control.delay_num, frame.control.delay_den);
+            if *last_displayed == displayed
+                && *last_after == after
+                && let Some((num, den)) = added_delays(prev_delay, delay)
+            {
+                prev.control.delay_num = num;
+                prev.control.delay_den = den;
+                before = after;
+                continue;
+            }
+            let (fx, fy, _, _) = region(&frame.control);
+            let (x, y, w, h) =
+                needed_rect(&frame.control, width, &before, &displayed).unwrap_or((fx, fy, 1, 1));
+            frame.image = cropped_image(&frame.image, x - fx, y - fy, w, h);
+            frame.control.x_offset = x as u32;
+            frame.control.y_offset = y as u32;
+            frame.control.width = w as u32;
+            frame.control.height = h as u32;
+        }
+        before = after.clone();
+        last = Some((displayed, after));
+        kept.push(frame);
+    }
+    kept
+}
+
+/// Stack images of the same format on top of each other so they can be reduced as one
+#[must_use]
+pub fn stacked_images(images: &[PngImage]) -> PngImage {
+    let pixel_bytes = images[0].ihdr.bpp() / 8;
+    let width = images.iter().map(|i| i.ihdr.width).max().unwrap_or(1);
+    let height = images.iter().map(|i| i.ihdr.height).sum();
+    let mut data = Vec::with_capacity(width as usize * height as usize * pixel_bytes);
+    for image in images {
+        let row = image.ihdr.width as usize * pixel_bytes;
+        for line in image.data.chunks(row) {
+            data.extend_from_slice(line);
+            let last = &line[row - pixel_bytes..];
+            for _ in image.ihdr.width..width {
+                data.extend_from_slice(last);
+            }
+        }
+    }
+    PngImage {
+        data,
+        ihdr: IhdrData {
+            width,
+            height,
+            color_type: images[0].ihdr.color_type.clone(),
+            ..images[0].ihdr
+        },
+    }
+}
+
+/// Split a stacked image back into images of the given sizes
+#[must_use]
+pub fn split_images(stacked: &PngImage, sizes: &[(u32, u32)]) -> Vec<PngImage> {
+    let bits = stacked.ihdr.bpp();
+    let stacked_row = (stacked.ihdr.width as usize * bits).div_ceil(8);
+    let mut lines = stacked.data.chunks(stacked_row);
+    sizes
+        .iter()
+        .map(|&(width, height)| {
+            let row_bits = width as usize * bits;
+            let row = row_bits.div_ceil(8);
+            let mask = match row_bits % 8 {
+                0 => 0xFF,
+                used => 0xFFu8 << (8 - used),
+            };
+            let mut data = Vec::with_capacity(row * height as usize);
+            for line in lines.by_ref().take(height as usize) {
+                data.extend_from_slice(&line[..row]);
+                *data.last_mut().unwrap() &= mask;
+            }
+            PngImage {
+                data,
+                ihdr: IhdrData {
+                    width,
+                    height,
+                    color_type: stacked.ihdr.color_type.clone(),
+                    bit_depth: stacked.ihdr.bit_depth,
+                    ..stacked.ihdr
+                },
+            }
+        })
+        .collect()
+}
