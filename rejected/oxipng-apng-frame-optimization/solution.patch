+/// Choose the filters and deflater used to evaluate reductions
+fn evaluation_settings(opts: &Options) -> (IndexSet<FilterStrategy>, Deflater) {
+    let compression = match opts.deflater {
+        Deflater::Libdeflater { compression } if compression < 11 => 5.min(compression),
+        _ if opts.filters.len() <= 4 => 7,
+        _ => 8,
+    };
+    // If only one or two filters are given, use them for evaluations
+    let eval_filters = if opts.filters.len() <= 2 {
+        opts.filters.clone()
+    } else {
+        // None and Bigrams work well together, especially for alpha reductions
+        indexset! {FilterStrategy::NONE, FilterStrategy::Bigrams}
+    };
+    (eval_filters, Deflater::Libdeflater { compression })
+}
+
+/// Crop and merge the frames of an APNG and reduce the default image and every frame together,
+/// returning the frame images
+fn prepare_animation(
+    png: &mut PngData,
+    opts: &Options,
+    deadline: &Arc<Deadline>,
+) -> PngResult<Vec<PngImage>> {
+    let orig = png.raw.ihdr.clone();
+    let normalized = |image: PngImage| {
+        let image = changed_interlacing(&image, false).unwrap_or(image);
+        expanded_bit_depth_to_8(&image).unwrap_or(image)
+    };
+    let mut images = Vec::with_capacity(png.frames.len() + 1);
+    images.push(normalized((*png.raw).clone()));
+    for frame in &png.frames {
+        let ihdr = IhdrData {
+            width: frame.width,
+            height: frame.height,
+            color_type: orig.color_type.clone(),
+            ..orig
+        };
+        images.push(normalized(PngImage::new(ihdr, &frame.data)?));
+    }
+
+    if opts.frame_reduction {
+        let first_fctl = png
+            .aux_chunks
+            .iter()
+            .take_while(|c| &c.name != b"IDAT")
+            .position(|c| &c.name == b"fcTL");
+        let mut animation = Vec::with_capacity(images.len());
+        if let Some(i) = first_fctl {
+            animation.push(AnimationFrame {
+                control: Frame::from_fctl_data(&png.aux_chunks[i].data)?,
+                image: images[0].clone(),
+            });
+        }
+        for (control, image) in png.frames.drain(..).zip(images.drain(1..)) {
+            animation.push(AnimationFrame { control, image });
+        }
+        let mut optimized = optimized_frames(animation, orig.width, orig.height).into_iter();
+        if let Some(i) = first_fctl {
+            let first = optimized.next().unwrap();
+            let sequence_number = read_be_u32(&png.aux_chunks[i].data[0..4]);
+            png.aux_chunks[i].data = first.control.fctl_data(sequence_number);
+        }
+        for frame in optimized {
+            png.frames.push(frame.control);
+            images.push(frame.image);
+        }
+        let num_frames = png.frames.len() + usize::from(first_fctl.is_some());
+        if let Some(actl) = png.aux_chunks.iter_mut().find(|c| &c.name == b"acTL") {
+            actl.data[0..4].copy_from_slice(&(num_frames as u32).to_be_bytes());
+        }
+    }
+
+    // Interlacing is applied to each image separately after the reductions
+    let reduction_opts = Options {
+        interlace: None,
+        ..opts.clone()
+    };
+    let sizes: Vec<_> = images
+        .iter()
+        .map(|i| (i.ihdr.width, i.ihdr.height))
+        .collect();
+    let stacked = Arc::new(stacked_images(&images));
+    let (eval_filters, eval_deflater) = evaluation_settings(opts);
+    let eval = Evaluator::new(deadline.clone(), eval_filters, eval_deflater, false, false);
+    let reduced = perform_reductions(stacked, &reduction_opts, deadline, &eval);
+    let reduced = eval.get_best_candidate().map_or(reduced, |c| c.image);
+    let mut images = split_images(&reduced, &sizes);
+    for image in &mut images {
+        if image.ihdr.bit_depth < orig.bit_depth && !opts.bit_depth_reduction {
+            *image = reduced_bit_depth_forced(image, orig.bit_depth);
+        }
+        if opts.interlace.unwrap_or(orig.interlaced)
+            && let Some(interlaced) = changed_interlacing(image, true)
+        {
+            *image = interlaced;
+        }
+    }
+    png.raw = Arc::new(images.remove(0));
+    Ok(images)
+}
