+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+cd "$(dirname "$0")"
+
+
+emit_junit() {
+  [ -z "$OUTPUT_PATH" ] && return 0
+  awk '
+    /^(    )*--- (PASS|FAIL|SKIP): / {
+      line = $0
+      sub(/^[ \t]*--- /, "", line)
+      split(line, parts, ": ")
+      status = parts[1]
+      rest = substr(line, length(status) + 3)
+      sub(/ \(.*\)$/, "", rest)
+      n++
+      names[n] = rest
+      states[n] = status
+      if (status == "FAIL") failures++
+      next
+    }
+    { last[NR] = $0 }
+    END {
+      printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+      printf "<testsuites name=\"go test\" tests=\"%d\" failures=\"%d\" errors=\"0\" time=\"0\">\n", n, failures+0
+      printf "<testsuite name=\"orb\" tests=\"%d\" failures=\"%d\" errors=\"0\">\n", n, failures+0
+      for (i = 1; i <= n; i++) {
+        gsub(/&/, "\\&amp;", names[i]); gsub(/</, "\\&lt;", names[i]); gsub(/>/, "\\&gt;", names[i])
+        printf "<testcase name=\"%s\" classname=\"orb\">", names[i]
+        if (states[i] == "FAIL") printf "<failure message=\"test failed\">%s failed</failure>", names[i]
+        else if (states[i] == "SKIP") printf "<skipped/>"
+        printf "</testcase>\n"
+      }
+      printf "</testsuite>\n</testsuites>\n"
+    }
+  ' "$1" > "$OUTPUT_PATH"
+}
+
+write_fallback() {
+  [ -z "$OUTPUT_PATH" ] && return 0
+  if [ -s "$OUTPUT_PATH" ] && grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    return 0
+  fi
+  cat > "$OUTPUT_PATH" <<'XMLEOF'
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="go test" tests="1" failures="1" errors="0" time="0">
+<testsuite name="build" tests="1" failures="1" errors="0">
+<testcase name="package build" classname="build">
+<failure message="build failed">The packages under test did not build.</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+}
+
+if [ "$MODE" = "new" ]; then
+  go test -v -count=1 -tags orbroles -run 'TestRingOrient|TestPolygonOrient|TestMultiPolygonOrient|TestRingClosable|TestRingClose' . 2>&1
+  A=$?
+  go test -v -count=1 -tags orbroles -run 'TestTileRoundTrip|TestRawTileRingWinding|TestMarshalDoesNotMutate|TestMarshalDropsDegenerate|TestMarshalEmptyPolygon' ./encoding/mvt 2>&1
+  B=$?
+  go test -v -count=1 -tags orbroles -run 'TestCutAntimeridian|TestSeamCrossingPolygon' ./geojson 2>&1
+  C=$?
+
+  if [ -n "$OUTPUT_PATH" ]; then
+    LOG=$(mktemp)
+    {
+      go test -v -count=1 -tags orbroles -run 'TestRingOrient|TestPolygonOrient|TestMultiPolygonOrient|TestRingClosable|TestRingClose' .
+      go test -v -count=1 -tags orbroles -run 'TestTileRoundTrip|TestRawTileRingWinding|TestMarshalDoesNotMutate|TestMarshalDropsDegenerate|TestMarshalEmptyPolygon' ./encoding/mvt
+      go test -v -count=1 -tags orbroles -run 'TestCutAntimeridian|TestSeamCrossingPolygon' ./geojson
+    } > "$LOG" 2>&1
+    emit_junit "$LOG"
+    rm -f "$LOG"
+    write_fallback
+  fi
+
+  [ $A -eq 0 ] && [ $B -eq 0 ] && [ $C -eq 0 ]
+  exit $?
+fi
+
+go test -v -count=1 ./... 2>&1
+EXIT_CODE=$?
+
+if [ -n "$OUTPUT_PATH" ]; then
+  LOG=$(mktemp)
+  go test -v -count=1 ./... > "$LOG" 2>&1
+  emit_junit "$LOG"
+  rm -f "$LOG"
+  write_fallback
+fi
+
+exit $EXIT_CODE
