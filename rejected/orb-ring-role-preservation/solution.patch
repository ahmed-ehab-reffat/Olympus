+// tileExterior is the winding an exterior ring carries once a geometry has
+// been projected into tile coordinates, so that a reader recovers the same
+// ring roles from the encoded tile.
+const tileExterior = orb.CCW
+
+func encodeRing(e *geomEncoder, r orb.Ring) {
+	e.MoveTo([]orb.Point{r[0]})
+	if r.Closed() {
+		e.LineTo([]orb.Point(r[1 : len(r)-1]))
+	} else {
+		e.LineTo([]orb.Point(r[1:]))
+	}
+	e.ClosePath()
+}
+
