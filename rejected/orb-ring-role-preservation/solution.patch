diff --git a/geojson/antimeridian.go b/geojson/antimeridian.go
new file mode 100644
index 0000000..4d92e03
--- /dev/null
+++ b/geojson/antimeridian.go
@@ -0,0 +1,288 @@
+package geojson
+
+import (
+	"sort"
+
+	"github.com/paulmach/orb"
+)
+
+const antimeridian = 180.0
+
+// CutAntimeridian splits geometry that crosses the antimeridian so no ring or
+// line spans the seam. A polygon that crosses becomes a multi polygon whose
+// pieces are ordered west to east, each piece oriented as GeoJSON requires,
+// with every hole attached to the piece that contains it. Geometry that does
+// not cross the seam is returned unchanged. The input is never modified.
+func CutAntimeridian(g orb.Geometry) orb.Geometry {
+	switch g := g.(type) {
+	case orb.Ring:
+		return cutPolygon(orb.Polygon{g})
+	case orb.Polygon:
+		return cutPolygon(g)
+	case orb.MultiPolygon:
+		out := make(orb.MultiPolygon, 0, len(g))
+		for _, p := range g {
+			switch cut := cutPolygon(p).(type) {
+			case orb.Polygon:
+				out = append(out, cut)
+			case orb.MultiPolygon:
+				out = append(out, cut...)
+			}
+		}
+		return out.Orient()
+	case orb.LineString:
+		return cutLineString(g)
+	case orb.MultiLineString:
+		out := make(orb.MultiLineString, 0, len(g))
+		for _, ls := range g {
+			switch cut := cutLineString(ls).(type) {
+			case orb.LineString:
+				out = append(out, cut)
+			case orb.MultiLineString:
+				out = append(out, cut...)
+			}
+		}
+		return out
+	case orb.Collection:
+		out := make(orb.Collection, 0, len(g))
+		for _, c := range g {
+			out = append(out, CutAntimeridian(c))
+		}
+		return out
+	}
+
+	return g
+}
+
+func crossesSeam(points []orb.Point) bool {
+	for i := 1; i < len(points); i++ {
+		if isSeamJump(points[i-1][0], points[i][0]) {
+			return true
+		}
+	}
+	return false
+}
+
+func isSeamJump(a, b float64) bool {
+	d := a - b
+	if d < 0 {
+		d = -d
+	}
+	return d > antimeridian
+}
+
+func seamLatitude(a, b orb.Point) float64 {
+	ax, ay := a[0], a[1]
+	bx, by := b[0], b[1]
+
+	if ax < 0 {
+		ax += 360
+	}
+	if bx < 0 {
+		bx += 360
+	}
+
+	span := bx - ax
+	if span == 0 {
+		return ay
+	}
+
+	t := (antimeridian - ax) / span
+	return ay + t*(by-ay)
+}
+
+func splitAtSeam(points []orb.Point) [][]orb.Point {
+	chains := make([][]orb.Point, 0, 2)
+	current := []orb.Point{points[0]}
+
+	for i := 1; i < len(points); i++ {
+		prev := points[i-1]
+		next := points[i]
+
+		if !isSeamJump(prev[0], next[0]) {
+			current = append(current, next)
+			continue
+		}
+
+		lat := seamLatitude(prev, next)
+		current = append(current, orb.Point{sideOf(prev[0]) * antimeridian, lat})
+		chains = append(chains, current)
+		current = []orb.Point{{sideOf(next[0]) * antimeridian, lat}, next}
+	}
+
+	chains = append(chains, current)
+	return chains
+}
+
+func sideOf(lon float64) float64 {
+	if lon < 0 {
+		return -1
+	}
+	return 1
+}
+
+func cutLineString(ls orb.LineString) orb.Geometry {
+	if len(ls) < 2 || !crossesSeam(ls) {
+		return ls
+	}
+
+	chains := splitAtSeam(ls)
+	out := make(orb.MultiLineString, 0, len(chains))
+	for _, c := range chains {
+		if len(c) >= 2 {
+			out = append(out, orb.LineString(c))
+		}
+	}
+
+	if len(out) == 1 {
+		return out[0]
+	}
+	return out
+}
+
+func cutPolygon(p orb.Polygon) orb.Geometry {
+	if len(p) == 0 {
+		return p
+	}
+
+	if !crossesSeam(p[0]) {
+		return p.Orient()
+	}
+
+	pieces := seamPieces(p[0])
+	if len(pieces) < 2 {
+		return p.Orient()
+	}
+
+	mp := make(orb.MultiPolygon, 0, len(pieces))
+	for _, piece := range pieces {
+		mp = append(mp, orb.Polygon{piece})
+	}
+
+	mp = attachHoles(mp, p[1:])
+	sortWestToEast(mp)
+
+	return mp.Orient()
+}
+
+func seamPieces(exterior orb.Ring) []orb.Ring {
+	chains := splitAtSeam(exterior)
+
+	west := make([]orb.Point, 0)
+	east := make([]orb.Point, 0)
+
+	for _, c := range chains {
+		if len(c) == 0 {
+			continue
+		}
+		if interiorSide(c) < 0 {
+			west = append(west, c...)
+		} else {
+			east = append(east, c...)
+		}
+	}
+
+	pieces := make([]orb.Ring, 0, 2)
+	if len(west) >= 3 {
+		pieces = append(pieces, orb.Ring(west).Close())
+	}
+	if len(east) >= 3 {
+		pieces = append(pieces, orb.Ring(east).Close())
+	}
+
+	return pieces
+}
+
+func interiorSide(chain []orb.Point) float64 {
+	for _, p := range chain {
+		if p[0] != antimeridian && p[0] != -antimeridian {
+			return sideOf(p[0])
+		}
+	}
+	return sideOf(chain[0][0])
+}
+
+func attachHoles(mp orb.MultiPolygon, holes []orb.Ring) orb.MultiPolygon {
+	for _, h := range holes {
+		if len(h) == 0 {
+			continue
+		}
+
+		if crossesSeam(h) {
+			for _, piece := range seamPieces(h) {
+				if i := containingPiece(mp, piece); i >= 0 {
+					mp[i] = append(mp[i], piece)
+				}
+			}
+			continue
+		}
+
+		closed := h.Close()
+		if i := containingPiece(mp, closed); i >= 0 {
+			mp[i] = append(mp[i], closed)
+		}
+	}
+
+	return mp
+}
+
+func containingPiece(mp orb.MultiPolygon, hole orb.Ring) int {
+	if len(hole) == 0 {
+		return -1
+	}
+
+	probe := hole[0]
+	for i, p := range mp {
+		if len(p) == 0 {
+			continue
+		}
+		if ringContains(p[0], probe) {
+			return i
+		}
+	}
+
+	for i, p := range mp {
+		if len(p) == 0 {
+			continue
+		}
+		if p[0].Bound().Contains(probe) {
+			return i
+		}
+	}
+
+	return -1
+}
+
+func ringContains(r orb.Ring, p orb.Point) bool {
+	if !r.Bound().Contains(p) {
+		return false
+	}
+
+	inside := false
+	for i, j := 0, len(r)-1; i < len(r); j, i = i, i+1 {
+		yi, yj := r[i][1], r[j][1]
+		if (yi > p[1]) == (yj > p[1]) {
+			continue
+		}
+
+		x := (r[j][0]-r[i][0])*(p[1]-yi)/(yj-yi) + r[i][0]
+		if p[0] < x {
+			inside = !inside
+		}
+	}
+
+	return inside
+}
+
+func sortWestToEast(mp orb.MultiPolygon) {
+	sort.SliceStable(mp, func(i, j int) bool {
+		return westEdge(mp[i]) < westEdge(mp[j])
+	})
+}
+
+func westEdge(p orb.Polygon) float64 {
+	if len(p) == 0 || len(p[0]) == 0 {
+		return 0
+	}
+	return p[0].Bound().Min[0]
+}
diff --git a/orient.go b/orient.go
new file mode 100644
index 0000000..2c41657
--- /dev/null
+++ b/orient.go
@@ -0,0 +1,136 @@
+package orb
+
+const minRingPositions = 4
+
+func (r Ring) closable() bool {
+	if len(r) < 3 {
+		return false
+	}
+
+	if r.Closed() {
+		return len(r) >= minRingPositions
+	}
+
+	return distinctPositions(r) >= 3
+}
+
+func distinctPositions(r Ring) int {
+	count := 0
+	for i := range r {
+		seen := false
+		for j := 0; j < i; j++ {
+			if r[i] == r[j] {
+				seen = true
+				break
+			}
+		}
+		if !seen {
+			count++
+		}
+	}
+	return count
+}
+
+// Close returns a closed copy of the ring, repeating the first position when
+// needed. The receiver is never modified.
+func (r Ring) Close() Ring {
+	if len(r) == 0 {
+		return r
+	}
+
+	if r.Closed() {
+		return r.Clone()
+	}
+
+	out := make(Ring, 0, len(r)+1)
+	out = append(out, r...)
+	if out[0] != out[len(out)-1] {
+		out = append(out, out[0])
+	}
+	return out
+}
+
+// Orient returns a closed copy of the ring wound in the given orientation.
+// A ring with no area is returned closed but otherwise unchanged. The
+// receiver is never modified.
+func (r Ring) Orient(o Orientation) Ring {
+	out := r.Close()
+	if len(out) < minRingPositions {
+		return out
+	}
+
+	current := out.Orientation()
+	if current == 0 || current == o {
+		return out
+	}
+
+	out.Reverse()
+	return out
+}
+
+// Orient returns a copy of the polygon with its exterior ring wound
+// counterclockwise and every hole wound clockwise, as GeoJSON requires.
+// Rings that cannot be closed are dropped, and a polygon whose exterior is
+// degenerate becomes empty. The receiver is never modified.
+func (p Polygon) Orient() Polygon {
+	return p.orientWith(CCW)
+}
+
+// OrientWith returns a copy of the polygon with its exterior ring wound in the
+// given orientation and every hole wound the other way. The receiver is never
+// modified.
+func (p Polygon) OrientWith(o Orientation) Polygon {
+	return p.orientWith(o)
+}
+
+func (p Polygon) orientWith(o Orientation) Polygon {
+	if len(p) == 0 {
+		return p
+	}
+
+	if !p[0].closable() || p[0].Close().Orientation() == 0 {
+		return Polygon{}
+	}
+
+	out := make(Polygon, 0, len(p))
+	out = append(out, p[0].Orient(o))
+
+	for _, h := range p[1:] {
+		if !h.closable() {
+			continue
+		}
+		hole := h.Orient(-1 * o)
+		if hole.Orientation() == 0 {
+			continue
+		}
+		out = append(out, hole)
+	}
+
+	return out
+}
+
+// Orient returns a copy of the multi polygon with every polygon oriented as
+// GeoJSON requires. Polygons that become empty are dropped. The receiver is
+// never modified.
+func (mp MultiPolygon) Orient() MultiPolygon {
+	return mp.OrientWith(CCW)
+}
+
+// OrientWith returns a copy of the multi polygon with every polygon's exterior
+// ring wound in the given orientation. The receiver is never modified.
+func (mp MultiPolygon) OrientWith(o Orientation) MultiPolygon {
+	if len(mp) == 0 {
+		return mp
+	}
+
+	out := make(MultiPolygon, 0, len(mp))
+	for _, p := range mp {
+		op := p.orientWith(o)
+		if len(op) == 0 {
+			continue
+		}
+		out = append(out, op)
+	}
+
+	return out
+}
