diff --git a/oci/layer/unpack.go b/oci/layer/unpack.go
index 1ac63a4..b0b8837 100644
--- a/oci/layer/unpack.go
+++ b/oci/layer/unpack.go
@@ -28,12 +28,14 @@ import (
 	"io"
 	"os"
 	"path/filepath"
+	"strings"
 	"time"
 
 	// Import is necessary for go-digest.
 	_ "crypto/sha256"
 
 	"github.com/apex/log"
+	securejoin "github.com/cyphar/filepath-securejoin"
 	"github.com/opencontainers/go-digest"
 	ispec "github.com/opencontainers/image-spec/specs-go/v1"
 	rspec "github.com/opencontainers/runtime-spec/specs-go"
@@ -62,6 +64,7 @@ func UnpackLayer(root string, layer io.Reader, opt *UnpackOptions) error {
 
 	te := NewTarExtractor(opt)
 	tr := tar.NewReader(layer)
+	var pendingLinks []*tar.Header
 	for {
 		hdr, err := tr.Next()
 		if err == io.EOF {
@@ -70,10 +73,61 @@ func UnpackLayer(root string, layer io.Reader, opt *UnpackOptions) error {
 		if err != nil {
 			return fmt.Errorf("read next entry: %w", err)
 		}
+
+		// A later entry for the same path supersedes an unresolved hardlink.
+		// A non-directory entry also supersedes anything pending below it.
+		name := CleanPath(hdr.Name)
+		remaining := pendingLinks[:0]
+		for _, pending := range pendingLinks {
+			pendingName := CleanPath(pending.Name)
+			if pendingName == name ||
+				strings.HasPrefix(name, pendingName+string(filepath.Separator)) ||
+				(hdr.Typeflag != tar.TypeDir && strings.HasPrefix(pendingName, name+string(filepath.Separator))) {
+				continue
+			}
+			remaining = append(remaining, pending)
+		}
+		pendingLinks = remaining
+
+		if hdr.Typeflag == tar.TypeLink {
+			targetName := strings.TrimPrefix(CleanPath(hdr.Linkname), string(filepath.Separator))
+			if _, targetIsUpper := te.upperPaths[targetName]; !targetIsUpper {
+				pending := *hdr
+				pendingLinks = append(pendingLinks, &pending)
+				continue
+			}
+		}
+
 		if err := te.UnpackEntry(root, hdr, tr); err != nil {
+			if hdr.Typeflag == tar.TypeLink && securejoin.IsNotExist(err) {
+				pending := *hdr
+				pendingLinks = append(pendingLinks, &pending)
+				continue
+			}
 			return fmt.Errorf("unpack entry: %s: %w", hdr.Name, err)
 		}
 	}
+
+	for len(pendingLinks) > 0 {
+		remaining := pendingLinks[:0]
+		madeProgress := false
+		for _, hdr := range pendingLinks {
+			if err := te.UnpackEntry(root, hdr, nil); err != nil {
+				if securejoin.IsNotExist(err) {
+					remaining = append(remaining, hdr)
+					continue
+				}
+				return fmt.Errorf("unpack deferred entry: %s: %w", hdr.Name, err)
+			}
+			madeProgress = true
+		}
+		pendingLinks = remaining
+		if !madeProgress {
+			hdr := pendingLinks[0]
+			err := te.UnpackEntry(root, hdr, nil)
+			return fmt.Errorf("unpack deferred entry: %s: %w", hdr.Name, err)
+		}
+	}
 	return nil
 }
 
