+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-junit-$MODE.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+OUTPUT_PATH="$(cd "$(dirname "$OUTPUT_PATH")" && pwd)/$(basename "$OUTPUT_PATH")"
+
+cd "$(dirname "$(readlink -f "$0")")"
+
+NEW_TESTS=(
+  mf2/icu-messageformat-1/src/message-to-mf1.8753dc.test.ts
+  mf2/messageformat/src/select-pattern.96daf6.test.ts
+)
+
+if [ ! -f mf1/packages/runtime/esm/runtime.js ]; then
+  npm run build:esm -w mf1/packages/runtime >/dev/null 2>&1
+fi
+
+TMP="$(mktemp -d)"
+status=0
+
+run_vitest() {
+  local out="$1" limit="$2"
+  shift 2
+  timeout "$limit" npx vitest run "$@" --reporter=default --reporter=junit \
+    --outputFile.junit="$out"
+  local rc=$?
+  [ $rc -ne 0 ] && status=$rc
+  return 0
+}
+
+synthetic() {
+  local out="$1" file="$2" reason="$3"
+  cat > "$out" <<XML
+<?xml version="1.0" encoding="UTF-8" ?>
+<testsuites name="vitest tests" tests="1" failures="1" errors="0">
+<testsuite name="$file" tests="1" failures="1" errors="0" skipped="0">
+<testcase classname="$file" name="$file">
+<failure message="$reason">$reason</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XML
+}
+
+if [ "$MODE" = "base" ]; then
+  args=(--exclude mf2/messageformat/src/spec.test.ts)
+  for f in "${NEW_TESTS[@]}"; do args+=(--exclude "$f"); done
+  run_vitest "$TMP/0.xml" 1200 "${args[@]}"
+  if ! grep -q '<testcase' "$TMP/0.xml" 2>/dev/null; then
+    synthetic "$TMP/0.xml" base "vitest produced no results (exit $status)"
+    status=1
+  fi
+else
+  i=0
+  for f in "${NEW_TESTS[@]}"; do
+    i=$((i + 1))
+    run_vitest "$TMP/$i.xml" 60 "$f"
+    if ! grep -q '<testcase' "$TMP/$i.xml" 2>/dev/null; then
+      synthetic "$TMP/$i.xml" "$f" "vitest produced no results or timed out"
+      status=1
+    fi
+  done
+fi
+
+node -e '
+const fs = require("fs");
+const [out, ...files] = process.argv.slice(1);
+const suites = files.flatMap(f =>
+  fs.readFileSync(f, "utf8").match(/<testsuite[\s>][\s\S]*?<\/testsuite>/g) ?? []
+);
+const count = re => suites.reduce((n, s) => n + (s.match(re) ?? []).length, 0);
+fs.writeFileSync(out, `<?xml version="1.0" encoding="UTF-8" ?>\n<testsuites name="vitest tests" tests="${count(/<testcase[\s>]/g)}" failures="${count(/<failure[\s>]/g)}" errors="${count(/<error[\s>]/g)}">\n${suites.join("\n")}\n</testsuites>\n`);
+' "$OUTPUT_PATH" "$TMP"/*.xml
+
+rm -rf "$TMP"
+exit $status
