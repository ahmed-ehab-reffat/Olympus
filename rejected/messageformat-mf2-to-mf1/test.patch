+import { type Token, parse } from '@messageformat/parser';
+import { source } from '@messageformat/test-utils/source.js';
+import { type Model as MF, MessageFormat, parseMessage } from 'messageformat';
+import { describe, expect, test } from 'vitest';
+import { MF1Functions, messageToMF1, mf1ToMessage } from './index.ts';
+
+type Grid = Record<string, (number | string)[]>;
+
+const ints = [
+  ...Array.from({ length: 32 }, (_, i) => i),
+  100,
+  101,
+  102,
+  103,
+  105,
+  111,
+  1000,
+  1001
+];
+
+function inputs(grid: Grid) {
+  let res: Record<string, number | string>[] = [{}];
+  for (const [name, values] of Object.entries(grid)) {
+    res = res.flatMap(prev =>
+      values.map(value => ({ ...prev, [name]: value }))
+    );
+  }
+  return res;
+}
+
+function checkValid(locale: string, mf1: string) {
+  const plural = (type: 'cardinal' | 'ordinal') =>
+    new Intl.PluralRules(locale, { type }).resolvedOptions().pluralCategories;
+  const ast = parse(mf1, {
+    cardinal: plural('cardinal'),
+    ordinal: plural('ordinal'),
+    strictPluralKeys: true
+  });
+  const missingOther: string[] = [];
+  const walk = (tokens: Token[]) => {
+    for (const token of tokens) {
+      if ('cases' in token) {
+        if (!token.cases.some(c => c.key === 'other')) {
+          missingOther.push(token.arg);
+        }
+        for (const c of token.cases) walk(c.tokens);
+      }
+    }
+  };
+  walk(ast);
+  expect(missingOther).toEqual([]);
+}
+
+function mismatches(locale: string, msg: MF.Message, grid: Grid) {
+  const mf1 = messageToMF1(locale, msg);
+  checkValid(locale, mf1);
+  const exp = new MessageFormat(locale, msg, {
+    functions: MF1Functions,
+    bidiIsolation: 'none'
+  });
+  const res = mf1ToMessage(locale, mf1, { bidiIsolation: 'none' });
+  const bad: string[] = [];
+  for (const values of inputs(grid)) {
+    const a = exp.format(values);
+    const b = res.format(values);
+    if (a !== b) bad.push(`${JSON.stringify(values)}: ${a} != ${b}`);
+  }
+  return bad;
+}
+
+const roundTrip = (locale: string, src: string, grid: Grid) =>
+  expect(mismatches(locale, parseMessage(src), grid)).toEqual([]);
+
+describe('pattern messages', () => {
+  test('text and variable', () => {
+    roundTrip('en', 'Hello {$name}!', { name: ['World', 'x'] });
+  });
+
+  test('number placeholders', () => {
+    roundTrip('en', '{$a :number} and {$b :integer} and {$c}', {
+      a: [0, 5, 1000, 1234567],
+      b: [7, 12345],
+      c: [1000, 'x']
+    });
+  });
+
+  test('braces outside plural context', () => {
+    roundTrip('en', 'a \\{\\} b # c {$x} \\}\\{', { x: ['X'] });
+  });
+});
+
+describe('sparse selection', () => {
+  test('backtracking to the category key', () => {
+    roundTrip(
+      'en',
+      source`
+        .input {$a :number}
+        .input {$b :string}
+        .match $a $b
+        1 x {{A}}
+        one * {{B}}
+        * x {{C}}
+        * * {{D}}
+      `,
+      { a: ints, b: ['x', 'y'] }
+    );
+  });
+
+  test('offset changes the category of an exact key', () => {
+    roundTrip(
+      'en',
+      source`
+        .input {$a :mf1:plural offset=1}
+        .input {$b :string}
+        .match $a $b
+        1 x {{A {$a}}}
+        one * {{B {$a}}}
+        * * {{C {$a}}}
+      `,
+      { a: ints, b: ['x', 'y'] }
+    );
+  });
+
+  test('literal other key in a locale with more categories', () => {
+    roundTrip(
+      'pl',
+      source`
+        .input {$n :number}
+        .match $n
+        one {{jeden}}
+        few {{kilka}}
+        other {{inne}}
+        * {{wiele}}
+      `,
+      { n: ints }
+    );
+  });
+});
+
+describe('mf1ToMessage nested statements', () => {
+  const cases: [string, Record<string, string | number>, string][] = [
+    [
+      '{a, select, p {{b, select, other {B}}} other {{b, select, x {C} other {D}}}}',
+      { a: 'p', b: 'x' },
+      'B'
+    ],
+    [
+      '{a, select, p {{n, plural, one {P1} other {PO}}} other {{n, plural, =1 {E1} other {EO}}}}',
+      { a: 'p', n: 1 },
+      'P1'
+    ]
+  ];
+  for (const [src, values, exp] of cases) {
+    test(src, () => {
+      expect(mf1ToMessage('en', src).format(values)).toBe(exp);
+    });
+  }
+});
+
+describe('errors', () => {
+  const throws = (src: string) => {
+    expect(messageToMF1('en', parseMessage('Hello {$x}'))).toBeTypeOf('string');
+    expect(() => messageToMF1('en', parseMessage(src))).toThrow();
+  };
+
+  test('markup', () => {
+    throws('Hello {#b}x{/b}');
+  });
+});
