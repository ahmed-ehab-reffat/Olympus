+import { source } from '@messageformat/test-utils/source.js';
+import { describe, expect, test } from 'vitest';
+import { MessageFormat } from './index.ts';
+
+describe('select with three selectors', () => {
+  const src = source`
+    .input {$a :number}
+    .input {$b :string}
+    .input {$c :string}
+    .match $a $b $c
+    1 * x {{A}}
+    * * * {{Z}}
+  `;
+
+  test('falls back past a catchall key', () => {
+    const mf = new MessageFormat('en', src);
+    expect(mf.format({ a: 1, b: 'q', c: 'y' })).toBe('Z');
+    expect(mf.format({ a: 1, b: 'q', c: 'x' })).toBe('A');
+  });
+});
