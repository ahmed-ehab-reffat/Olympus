+import {
+  type Model as MF,
+  isCatchallKey,
+  isExpression,
+  isLiteral,
+  isSelectMessage
+} from 'messageformat';
+
+type Resolved =
+  | { type: 'literal'; value: string }
+  | {
+      type: 'variable';
+      name: string;
+      functionRef?: MF.FunctionRef;
+      attributes?: MF.Attributes;
+      offset: number;
+    };
+
+type Selector = {
+  arg: string;
+  type: 'plural' | 'select' | 'selectordinal';
+  offset: number;
+  exact: boolean;
+};
+
+type Case = { key: string; prefs: string[] };
+
+type Scope = { arg: string; plural: boolean; offset: number }[];
+
+const reName = /^[^\p{Pat_Syn}\p{Pat_WS}]+$/u;
+const reExactKey = /^(0|[1-9][0-9]*)$/;
+
+function literalOption(fn: MF.FunctionRef, name: string) {
+  const opt = fn.options?.[name];
+  if (!opt) return undefined;
+  if (!isLiteral(opt)) {
+    throw new Error(`The ${name} option of :${fn.name} must be a literal`);
+  }
+  return opt.value;
+}
+
+function checkOptions(fn: MF.FunctionRef, allowed: string[]) {
+  for (const name of Object.keys(fn.options ?? {})) {
+    if (!allowed.includes(name)) {
+      throw new Error(`Unsupported option ${name} for :${fn.name}`);
+    }
+  }
+}
+
+function getOffset(fn: MF.FunctionRef | undefined) {
+  if (fn?.name !== 'mf1:plural') return 0;
+  const offset = literalOption(fn, 'offset') ?? '0';
+  if (!reExactKey.test(offset)) throw new Error(`Invalid offset: ${offset}`);
+  return Number(offset);
+}
+
+function resolveExpression(
+  declarations: MF.Declaration[],
+  expr: MF.Expression
+): Resolved {
+  const { arg, functionRef, attributes } = expr;
+  if (!arg) throw new Error(`Unsupported function-only expression`);
+  if (isLiteral(arg)) {
+    if (functionRef && functionRef.name !== 'string') {
+      throw new Error(`Unsupported function :${functionRef.name} on a literal`);
+    }
+    return { type: 'literal', value: arg.value };
+  }
+
+  const idx = declarations.findIndex(decl => decl.name === arg.name);
+  let base: Resolved;
+  if (idx === -1) {
+    base = { type: 'variable', name: arg.name, offset: 0 };
+  } else {
+    const decl = declarations[idx];
+    base =
+      decl.type === 'input'
+        ? {
+            type: 'variable',
+            name: arg.name,
+            functionRef: decl.value.functionRef,
+            offset: getOffset(decl.value.functionRef)
+          }
+        : resolveExpression(declarations.slice(0, idx), decl.value);
+  }
+  if (!functionRef) {
+    return attributes && base.type === 'variable'
+      ? { ...base, attributes }
+      : base;
+  }
+  if (base.type === 'literal') {
+    if (functionRef.name !== 'string') {
+      throw new Error(`Unsupported function :${functionRef.name} on a literal`);
+    }
+    return base;
+  }
+  return {
+    type: 'variable',
+    name: base.name,
+    functionRef,
+    attributes,
+    offset: base.offset || getOffset(functionRef)
+  };
+}
+
+function getSelector(
+  declarations: MF.Declaration[],
+  ref: MF.VariableRef
+): Selector {
+  const res = resolveExpression(declarations, {
+    type: 'expression',
+    arg: ref
+  });
+  if (res.type !== 'variable' || !res.functionRef) {
+    throw new Error(`Selector $${ref.name} has no selection function`);
+  }
+  const fn = res.functionRef;
+  const arg = checkName(res.name);
+  switch (fn.name) {
+    case 'string':
+      checkOptions(fn, []);
+      return { arg, type: 'select', offset: 0, exact: false };
+    case 'number':
+    case 'integer':
+    case 'mf1:plural': {
+      checkOptions(
+        fn,
+        fn.name === 'mf1:plural' ? ['select', 'offset'] : ['select']
+      );
+      const select = literalOption(fn, 'select') ?? 'plural';
+      if (select === 'exact' && fn.name !== 'mf1:plural') {
+        return { arg, type: 'select', offset: 0, exact: true };
+      }
+      if (select !== 'plural' && select !== 'ordinal') {
+        throw new Error(`Unsupported select option value: ${select}`);
+      }
+      return {
+        arg,
+        type: select === 'ordinal' ? 'selectordinal' : 'plural',
+        offset: res.offset,
+        exact: false
+      };
+    }
+  }
+  throw new Error(`Unsupported selector function :${fn.name}`);
+}
+
+function checkName(name: string) {
+  if (!reName.test(name)) {
+    throw new Error(`Name cannot be represented in MF1: ${name}`);
+  }
+  return name;
+}
+
+function getCases(
+  locale: string,
+  sel: Selector,
+  variants: MF.Variant[],
+  idx: number
+): Case[] {
+  const keys = new Set<string>();
+  for (const { keys: vk } of variants) {
+    const key = vk[idx];
+    if (!isCatchallKey(key)) keys.add(key.value);
+  }
+
+  const cases: Case[] = [];
+  if (sel.type === 'select') {
+    for (const key of keys) {
+      if (sel.exact) {
+        if (reExactKey.test(key)) cases.push({ key, prefs: [key] });
+      } else if (key === 'other' || !reName.test(key) || key[0] === '=') {
+        throw new Error(`Select key cannot be represented in MF1: ${key}`);
+      } else {
+        cases.push({ key, prefs: [key] });
+      }
+    }
+    cases.push({ key: 'other', prefs: [] });
+    return cases;
+  }
+
+  const pr = new Intl.PluralRules(locale, {
+    type: sel.type === 'selectordinal' ? 'ordinal' : 'cardinal'
+  });
+  for (const key of keys) {
+    if (reExactKey.test(key)) {
+      const prefs = [key];
+      const cat = pr.select(Number(key) - sel.offset);
+      if (keys.has(cat)) prefs.push(cat);
+      cases.push({ key: `=${key}`, prefs });
+    }
+  }
+  const categories = pr.resolvedOptions().pluralCategories;
+  for (const cat of categories) {
+    if (cat !== 'other') {
+      cases.push({ key: cat, prefs: keys.has(cat) ? [cat] : [] });
+    }
+  }
+  cases.push({ key: 'other', prefs: keys.has('other') ? ['other'] : [] });
+  return cases;
+}
+
+function selectVariant(variants: MF.Variant[], prefs: string[][]) {
+  let best: MF.Variant | null = null;
+  let bestRank: number[] = [];
+  loop: for (const variant of variants) {
+    const rank: number[] = [];
+    for (let i = 0; i < prefs.length; ++i) {
+      const key = variant.keys[i];
+      const r = isCatchallKey(key)
+        ? prefs[i].length
+        : prefs[i].indexOf(key.value);
+      if (r === -1) continue loop;
+      rank.push(r);
+    }
+    const better = rank.findIndex((r, i) => r !== bestRank[i]);
+    if (!best || (better !== -1 && rank[better] < bestRank[better])) {
+      best = variant;
+      bestRank = rank;
+    }
+  }
+  if (!best) throw new Error('No variant matches');
+  return best;
+}
+
+function escapeText(text: string, scope: Scope) {
+  const special = scope.some(s => s.plural) ? /[{}#]/ : /[{}]/;
+  const esc = text.replace(/'/g, "''");
+  const idx = esc.search(special);
+  return idx === -1 ? esc : `${esc.slice(0, idx)}'${esc.slice(idx)}'`;
+}
+
+function placeholderToMF1(res: Resolved, scope: Scope) {
+  if (res.type === 'literal') return escapeText(res.value, scope);
+  const name = checkName(res.name);
+  const { attributes, functionRef, offset } = res;
+
+  if (offset) {
+    const plural = scope.filter(s => s.plural).pop();
+    return plural?.arg === name && plural.offset === offset
+      ? '#'
+      : `{${name}, plural, offset:${offset} other {#}}`;
+  }
+
+  const argType = attributes?.['mf1:argType'];
+  if (argType && argType !== true) {
+    const argStyle = attributes['mf1:argStyle'];
+    return argStyle && argStyle !== true
+      ? `{${name}, ${argType.value}, ${argStyle.value}}`
+      : `{${name}, ${argType.value}}`;
+  }
+
+  switch (functionRef?.name) {
+    case undefined:
+    case 'string':
+      if (functionRef) checkOptions(functionRef, []);
+      return `{${name}}`;
+    case 'number':
+      checkOptions(functionRef, ['select']);
+      return `{${name}, number}`;
+    case 'integer':
+      checkOptions(functionRef, ['select']);
+      return `{${name}, number, integer}`;
+  }
+  throw new Error(`Unsupported function :${functionRef?.name}`);
+}
+
+function patternToMF1(
+  declarations: MF.Declaration[],
+  pattern: MF.Pattern,
+  scope: Scope
+) {
+  let res = '';
+  let text = '';
+  for (const part of pattern) {
+    if (typeof part === 'string') {
+      text += part;
+    } else if (isExpression(part)) {
+      const ph = resolveExpression(declarations, part);
+      if (ph.type === 'literal') {
+        text += ph.value;
+      } else {
+        res += escapeText(text, scope) + placeholderToMF1(ph, scope);
+        text = '';
+      }
+    } else {
+      throw new Error(`Unsupported pattern part: ${part.type}`);
+    }
+  }
+  return res + escapeText(text, scope);
+}
+
+/**
+ * Convert a {@link MF.Message | Model.Message} data object into
+ * an ICU MessageFormat 1 source string for the given `locale`.
+ *
+ * When compiled with {@link mf1ToMessage}, the result formats its inputs
+ * in the same way as the source message.
+ * Selectors are nested in the order of the `.match` statement,
+ * and each MF1 case is given the pattern of the variant that the source message would select for it.
+ *
+ * Throws an error if the message uses a construct that cannot be represented in MF1.
+ */
+export function messageToMF1(locale: string, msg: MF.Message): string {
+  const { declarations } = msg;
+  if (!isSelectMessage(msg)) {
+    return patternToMF1(declarations, msg.pattern, []);
+  }
+
+  const selectors = msg.selectors.map(sel => getSelector(declarations, sel));
+  for (const { keys } of msg.variants) {
+    if (keys.length !== selectors.length) {
+      throw new Error('Mismatch in selector key counts');
+    }
+  }
+  const cases = selectors.map((sel, i) =>
+    getCases(locale, sel, msg.variants, i)
+  );
+
+  const build = (prefs: string[][], scope: Scope): string => {
+    const i = prefs.length;
+    if (i === selectors.length) {
+      const variant = selectVariant(msg.variants, prefs);
+      return patternToMF1(declarations, variant.value, scope);
+    }
+    const sel = selectors[i];
+    const inner: Scope = [
+      ...scope,
+      { arg: sel.arg, plural: sel.type !== 'select', offset: sel.offset }
+    ];
+    const body = cases[i].map(c => ({
+      key: c.key,
+      value: build([...prefs, c.prefs], inner)
+    }));
+    const other = body[body.length - 1].value;
+    let res = `{${sel.arg}, ${sel.type},`;
+    if (sel.offset) res += ` offset:${sel.offset}`;
+    for (const { key, value } of body) {
+      if (key === 'other' || value !== other) res += ` ${key} {${value}}`;
+    }
+    return res + '}';
+  };
+  return build([], []);
+}
