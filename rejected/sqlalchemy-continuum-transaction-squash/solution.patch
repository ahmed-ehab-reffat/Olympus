diff --git a/sqlalchemy_continuum/squash.py b/sqlalchemy_continuum/squash.py
new file mode 100644
index 0000000..6cfe882
--- /dev/null
+++ b/sqlalchemy_continuum/squash.py
@@ -0,0 +1,115 @@
+import sqlalchemy as sa
+
+from .operation import Operation
+
+
+def _version_tables(manager):
+    tables = {}
+    for parent_cls, version_cls in manager.version_class_map.items():
+        for table in sa.inspect(version_cls).tables:
+            tables.setdefault(table, parent_cls)
+    for table in manager.association_version_tables:
+        tables.setdefault(table, None)
+    return tables
+
+
+def _option(manager, parent_cls, name):
+    if parent_cls is None:
+        return manager.options[name]
+    return manager.option(parent_cls, name)
+
+
+def _fold_operation(previous, last, op_column):
+    existed = previous is not None and previous[op_column] != Operation.DELETE
+    if last[op_column] == Operation.DELETE:
+        return Operation.DELETE if existed else None
+    return Operation.UPDATE if existed else Operation.INSERT
+
+
+def _squash_table(session, table, names, first_id, last_id, mod_suffix):
+    tx, end_tx, op = names
+    key_columns = [c for c in table.primary_key.columns if c.name != tx]
+    rows = (
+        session.execute(
+            sa.select(table)
+            .where(table.c[tx] >= first_id, table.c[tx] <= last_id)
+            .order_by(table.c[tx])
+        )
+        .mappings()
+        .all()
+    )
+    groups = {}
+    for row in rows:
+        groups.setdefault(tuple(row[c.name] for c in key_columns), []).append(row)
+    for key, group in groups.items():
+        key_clause = sa.and_(*(c == value for c, value in zip(key_columns, key)))
+        previous = (
+            session.execute(
+                sa.select(table)
+                .where(key_clause, table.c[tx] < first_id)
+                .order_by(table.c[tx].desc())
+                .limit(1)
+            )
+            .mappings()
+            .first()
+        )
+        final = dict(group[-1])
+        operation = _fold_operation(previous, final, op)
+        session.execute(
+            sa.delete(table).where(
+                key_clause, table.c[tx] >= first_id, table.c[tx] <= last_id
+            )
+        )
+        if operation is not None:
+            final[tx] = last_id
+            final[op] = operation
+            for column in table.c:
+                if mod_suffix and column.name.endswith(mod_suffix):
+                    base = column.name[: -len(mod_suffix)]
+                    if operation == Operation.UPDATE and base in table.c:
+                        final[column.name] = previous[base] != final[base]
+                    else:
+                        final[column.name] = any(r[column.name] for r in group)
+            session.execute(sa.insert(table).values(**final))
+        if end_tx and previous is not None:
+            successor = last_id if operation is not None else final[end_tx]
+            session.execute(
+                sa.update(table)
+                .where(key_clause, table.c[tx] == previous[tx])
+                .values({end_tx: successor})
+            )
+
+
+def squash_transactions(session, first_id, last_id, manager=None):
+    """
+    Merge the transactions ``first_id`` to ``last_id`` into transaction
+    ``last_id``.
+    """
+    if manager is None:
+        from . import versioning_manager as manager
+    tx_cls = manager.transaction_cls
+    ids = session.scalars(
+        sa.select(tx_cls.id)
+        .where(tx_cls.id >= first_id, tx_cls.id <= last_id)
+        .order_by(tx_cls.id)
+    ).all()
+    if first_id >= last_id or not ids or ids[0] != first_id or ids[-1] != last_id:
+        raise ValueError(f'Cannot squash transactions {first_id} to {last_id}')
+    mod_suffix = next(
+        (p.column_suffix for p in manager.plugins if hasattr(p, 'column_suffix')), None
+    )
+    for table, parent_cls in _version_tables(manager).items():
+        names = tuple(
+            _option(manager, parent_cls, name)
+            for name in (
+                'transaction_column_name',
+                'end_transaction_column_name',
+                'operation_type_column_name',
+            )
+        )
+        if _option(manager, parent_cls, 'strategy') != 'validity':
+            names = (names[0], None, names[2])
+        _squash_table(session, table, names, first_id, last_id, mod_suffix)
+    manager.plugins.after_squash_transactions(manager, session, ids[:-1], last_id)
+    session.execute(sa.delete(tx_cls.__table__).where(tx_cls.id.in_(ids[:-1])))
+    session.expire_all()
