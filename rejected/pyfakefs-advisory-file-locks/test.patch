+import errno
+import os
+import struct
+import sys
+import unittest
+
+from pyfakefs import fake_filesystem_unittest
+
+if sys.platform == "linux":
+    import fcntl
+
+FLOCK = "hhqqi"
+
+
+def flock_struct(lock_type, start=0, length=0, whence=0):
+    return struct.pack(FLOCK, lock_type, whence, start, length, 0)
+
+
+def unpack(data):
+    return struct.unpack(FLOCK, data)
+
+
+@unittest.skipIf(sys.platform != "linux", "Linux locking semantics")
+class FileLockTest(fake_filesystem_unittest.TestCase):
+    def setUp(self):
+        self.setUpPyfakefs()
+        self.fs.create_file("/data", contents=b"x" * 100)
+
+    def open_rw(self, path="/data"):
+        fd = os.open(path, os.O_RDWR)
+        self.addCleanup(self.close_quietly, fd)
+        return fd
+
+    def close_quietly(self, fd):
+        try:
+            os.close(fd)
+        except OSError:
+            pass
+
+    def assert_errno(self, expected, func, *args):
+        with self.assertRaises(OSError) as cm:
+            func(*args)
+        self.assertEqual(expected, cm.exception.errno)
+
+    def ofd_lock(self, fd, lock_type, start=0, length=0):
+        return fcntl.fcntl(
+            fd, fcntl.F_OFD_SETLK, flock_struct(lock_type, start, length)
+        )
+
+    def ofd_query(self, fd, lock_type=None, start=0, length=0):
+        if lock_type is None:
+            lock_type = fcntl.F_WRLCK
+        return unpack(
+            fcntl.fcntl(fd, fcntl.F_OFD_GETLK, flock_struct(lock_type, start, length))
+        )
+
+    def test_flock_exclusive_conflicts_between_two_opens(self):
+        first = self.open_rw()
+        second = self.open_rw()
+        fcntl.flock(first, fcntl.LOCK_EX)
+        self.assert_errno(
+            errno.EAGAIN, fcntl.flock, second, fcntl.LOCK_SH | fcntl.LOCK_NB
+        )
+
+    def test_flock_through_a_dup_is_the_same_owner(self):
+        first = self.open_rw()
+        duplicate = os.dup(first)
+        self.addCleanup(self.close_quietly, duplicate)
+        fcntl.flock(first, fcntl.LOCK_EX)
+        fcntl.flock(duplicate, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        other = self.open_rw()
+        self.assert_errno(
+            errno.EAGAIN, fcntl.flock, other, fcntl.LOCK_EX | fcntl.LOCK_NB
+        )
+
+    def test_record_lock_conflicts_with_own_description_lock(self):
+        first = self.open_rw()
+        second = self.open_rw()
+        fcntl.fcntl(first, fcntl.F_SETLK, flock_struct(fcntl.F_WRLCK, 0, 10))
+        fcntl.fcntl(second, fcntl.F_SETLK, flock_struct(fcntl.F_WRLCK, 5, 10))
+        self.assert_errno(errno.EAGAIN, self.ofd_lock, second, fcntl.F_WRLCK, 5, 10)
+
+    def test_getlk_reports_owner_kind(self):
+        first = self.open_rw()
+        second = self.open_rw()
+        fcntl.fcntl(first, fcntl.F_SETLK, flock_struct(fcntl.F_WRLCK, 0, 10))
+        self.ofd_lock(second, fcntl.F_RDLCK, 20, 5)
+        self.assertEqual((fcntl.F_WRLCK, 0, 0, 10, os.getpid()), self.ofd_query(second))
+        self.assertEqual(
+            (fcntl.F_RDLCK, 0, 20, 5, -1),
+            unpack(
+                fcntl.fcntl(first, fcntl.F_GETLK, flock_struct(fcntl.F_WRLCK, 15, 0))
+            ),
+        )
+
+    def test_unlocking_the_middle_splits_a_lock(self):
+        owner = self.open_rw()
+        other = self.open_rw()
+        self.ofd_lock(owner, fcntl.F_WRLCK, 0, 10)
+        self.ofd_lock(owner, fcntl.F_WRLCK, 10, 10)
+        self.assertEqual((fcntl.F_WRLCK, 0, 0, 20, -1), self.ofd_query(other))
+        self.ofd_lock(owner, fcntl.F_UNLCK, 5, 5)
+        self.assertEqual((fcntl.F_WRLCK, 0, 0, 5, -1), self.ofd_query(other))
+        self.assertEqual((fcntl.F_WRLCK, 0, 10, 10, -1), self.ofd_query(other, None, 5))
+        self.assertEqual((fcntl.F_UNLCK, 0, 5, 5, 0), self.ofd_query(other, None, 5, 5))
+
+    def test_os_lockf_shares_the_record_lock_table(self):
+        fd = self.open_rw()
+        other = self.open_rw()
+        os.lseek(fd, 30, os.SEEK_SET)
+        os.lockf(fd, os.F_TLOCK, 4)
+        self.assertEqual((fcntl.F_WRLCK, 0, 30, 4, os.getpid()), self.ofd_query(other))
+
+    def test_closing_an_unrelated_descriptor_releases_record_locks(self):
+        fd = self.open_rw()
+        other = self.open_rw()
+        fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB, 10)
+        reader = os.open("/data", os.O_RDONLY)
+        os.close(reader)
+        self.assertEqual((fcntl.F_UNLCK, 0, 0, 0, 0), self.ofd_query(other))
+
+    def test_description_lock_survives_closing_one_dup(self):
+        fd = self.open_rw()
+        duplicate = os.dup(fd)
+        other = self.open_rw()
+        self.ofd_lock(fd, fcntl.F_WRLCK, 0, 10)
+        os.close(fd)
+        self.assert_errno(errno.EAGAIN, self.ofd_lock, other, fcntl.F_WRLCK, 0, 1)
+        os.close(duplicate)
+        self.ofd_lock(other, fcntl.F_WRLCK, 0, 1)
+
+    def test_dup_keeps_reading_after_original_is_closed(self):
+        fd = os.open("/data", os.O_RDONLY)
+        duplicate = os.dup(fd)
+        self.addCleanup(self.close_quietly, duplicate)
+        os.close(fd)
+        self.assertEqual(b"xxx", os.read(duplicate, 3))
+
+    def test_dup2_onto_a_dup_closes_only_that_descriptor(self):
+        self.fs.create_file("/other", contents=b"yyy")
+        fd = self.open_rw()
+        duplicate = os.dup(fd)
+        target = os.open("/other", os.O_RDONLY)
+        self.addCleanup(self.close_quietly, target)
+        os.dup2(target, duplicate)
+        self.addCleanup(self.close_quietly, duplicate)
+        self.assertEqual(b"xx", os.read(fd, 2))
+        self.assertEqual(b"yy", os.read(duplicate, 2))
+
+    def test_request_that_would_wait_raises_edeadlk(self):
+        fd = self.open_rw()
+        other = self.open_rw()
+        self.ofd_lock(fd, fcntl.F_RDLCK, 0, 10)
+        self.assert_errno(
+            errno.EDEADLK,
+            fcntl.fcntl,
+            other,
+            fcntl.F_SETLKW,
+            flock_struct(fcntl.F_WRLCK, 5, 1),
+        )
+        self.assertEqual((fcntl.F_UNLCK, 0, 0, 0, 0), self.ofd_query(fd))
+
+    def test_write_lock_needs_a_writable_descriptor(self):
+        reader = os.open("/data", os.O_RDONLY)
+        self.addCleanup(self.close_quietly, reader)
+        self.assert_errno(
+            errno.EBADF,
+            fcntl.fcntl,
+            reader,
+            fcntl.F_SETLK,
+            flock_struct(fcntl.F_WRLCK, 0, 1),
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
