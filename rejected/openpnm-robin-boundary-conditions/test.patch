+#!/usr/bin/env bash
+set -u
+
+output_path="results.xml"
+if [[ "${1:-}" == "--output_path" ]]; then
+    output_path="$2"
+    shift 2
+fi
+
+mode="${1:-}"
+case "$mode" in
+    base)
+        tests=(
+            tests/unit/algorithms/GenericTransportTest.py
+            tests/unit/algorithms/ReactiveTransportTest.py
+            tests/unit/algorithms/SubclassedTransportTest.py
+            tests/unit/algorithms/TransientReactiveTransportTest.py
+        )
+        ;;
+    new)
+        tests=(tests/unit/algorithms/RobinBoundaryConditionTest.py)
+        ;;
+    *)
+        echo "usage: $0 [--output_path PATH] {base|new}" >&2
+        exit 2
+        ;;
+esac
+
+python -m pytest "${tests[@]}" --junitxml="$output_path"
diff --git a/tests/unit/algorithms/RobinBoundaryConditionTest.py b/tests/unit/algorithms/RobinBoundaryConditionTest.py
