--- /dev/null
+++ b/tests/unit/algorithms/RobinBoundaryConditionTest.py
@@ -0,0 +1,135 @@
+import numpy as np
+import numpy.testing as nt
+import pytest
+
+import openpnm as op
+
+
+def transport(shape=(3, 1, 1), algorithm=op.algorithms.Transport):
+    network = op.network.Cubic(shape=shape)
+    phase = op.phase.Phase(network=network)
+    phase['throat.conductance'] = 1.0
+    alg = algorithm(network=network, phase=phase)
+    alg.settings['conductance'] = 'throat.conductance'
+    alg.settings['quantity'] = 'pore.quantity'
+    return network, phase, alg
+
+
+class RobinBoundaryConditionTest:
+
+    def teardown_method(self):
+        op.Workspace().clear()
+
+    def test_exact_steady_mixed_boundary_solution(self):
+        _, _, alg = transport()
+        alg.set_value_BC(pores=0, values=0.0)
+        alg.set_robin_BC(pores=2, values=1.0, coefficients=1.0)
+        alg.run()
+        nt.assert_allclose(alg.x, [0.0, 1 / 3, 2 / 3], rtol=1e-10, atol=1e-12)
+        nt.assert_allclose(alg.rate(pores=2), [1 / 3], rtol=1e-10)
+
+    def test_vector_values_and_coefficients(self):
+        _, _, alg = transport(shape=(4, 1, 1))
+        alg.set_robin_BC(pores=[0, 3], values=[0.0, 2.0], coefficients=[2.0, 1.0])
+        alg.run()
+        nt.assert_allclose(alg.x, [2 / 9, 6 / 9, 10 / 9, 14 / 9], rtol=1e-10, atol=1e-12)
+
+    @pytest.mark.parametrize(
+        ('values', 'coefficients'),
+        [([1.0, 2.0, 3.0], [1.0, 2.0]), ([1.0, 2.0], [1.0, 2.0, 3.0])],
+    )
+    def test_per_pore_inputs_must_match_selected_pores(self, values, coefficients):
+        _, _, alg = transport()
+        with pytest.raises(Exception):
+            alg.set_robin_BC(
+                pores=[0, 2],
+                values=values,
+                coefficients=coefficients,
+            )
+        assert np.isnan(alg['pore.bc.robin']).all()
+        assert np.isnan(alg['pore.robin.coefficient']).all()
+
+    def test_lifecycle_and_conflicts_are_atomic(self):
+        _, _, alg = transport()
+        alg.set_value_BC(pores=0, values=0.0)
+        with pytest.raises(Exception):
+            alg.set_robin_BC(pores=[0, 2], values=1.0, coefficients=[1.0, 2.0])
+        assert np.isnan(alg['pore.bc.robin']).all()
+
+        alg.set_robin_BC(pores=[0, 2], values=[1.0, 2.0], coefficients=[3.0, 4.0], mode='overwrite')
+        assert np.isnan(alg['pore.bc.value']).all()
+        alg.set_robin_BC(pores=0, mode='remove')
+        assert np.isnan(alg['pore.bc.robin'][0])
+        assert np.isnan(alg['pore.robin.coefficient'][0])
+        assert alg['pore.bc.robin'][2] == 2.0
+        assert alg['pore.robin.coefficient'][2] == 4.0
+
+        alg.clear_BCs()
+        assert np.isnan(alg['pore.bc.robin']).all()
+        assert np.isnan(alg['pore.robin.coefficient']).all()
+
+    @pytest.mark.parametrize('coefficient', [0.0, -1.0, np.inf, np.nan])
+    def test_coefficients_must_be_positive_and_finite(self, coefficient):
+        _, _, alg = transport()
+        with pytest.raises(Exception):
+            alg.set_robin_BC(pores=0, values=1.0, coefficients=coefficient)
+        assert np.isnan(alg['pore.bc.robin']).all()
+
+    def test_reactive_transport_uses_the_same_boundary_equation(self):
+        _, _, alg = transport(algorithm=op.algorithms.ReactiveTransport)
+        alg.set_value_BC(pores=0, values=0.0)
+        alg.set_robin_BC(pores=2, values=1.0, coefficients=1.0)
+        alg.run()
+        nt.assert_allclose(alg.x, [0.0, 1 / 3, 2 / 3], rtol=1e-10, atol=1e-12)
+
+    def test_source_and_robin_boundary_cannot_overlap(self):
+        _, phase, alg = transport(algorithm=op.algorithms.ReactiveTransport)
+        phase['pore.source.S1'] = -1.0
+        phase['pore.source.S2'] = 1.0
+        alg.set_source(pores=1, propname='pore.source')
+        with pytest.raises(Exception):
+            alg.set_robin_BC(pores=1, values=1.0, coefficients=1.0)
+        assert np.isnan(alg['pore.bc.robin'][1])
+
+    def test_existing_robin_boundary_blocks_a_source(self):
+        _, phase, alg = transport(algorithm=op.algorithms.ReactiveTransport)
+        phase['pore.source.S1'] = -1.0
+        phase['pore.source.S2'] = 1.0
+        alg.set_robin_BC(pores=1, values=1.0, coefficients=1.0)
+        with pytest.raises(Exception):
+            alg.set_source(pores=1, propname='pore.source')
+
+    def test_robin_conditions_anchor_each_disconnected_component(self):
+        network = op.network.Network(
+            coords=[[0, 0, 0], [1, 0, 0], [3, 0, 0], [4, 0, 0]],
+            conns=[[0, 1], [2, 3]],
+        )
+        phase = op.phase.Phase(network=network)
+        phase['throat.conductance'] = 1.0
+        alg = op.algorithms.Transport(network=network, phase=phase)
+        alg.settings['conductance'] = 'throat.conductance'
+        alg.settings['quantity'] = 'pore.quantity'
+        alg.set_robin_BC(pores=[0, 2], values=[1.0, 3.0], coefficients=[2.0, 4.0])
+        alg.run()
+        nt.assert_allclose(alg.x, [1.0, 1.0, 3.0, 3.0], rtol=1e-10, atol=1e-12)
+
+    def test_repeated_runs_do_not_accumulate_robin_terms(self):
+        _, _, alg = transport()
+        alg.set_value_BC(pores=0, values=0.0)
+        alg.set_robin_BC(pores=2, values=1.0, coefficients=1.0)
+        alg.run()
+        alg.run()
+        nt.assert_allclose(alg.x, [0.0, 1 / 3, 2 / 3], rtol=1e-10, atol=1e-12)
+        alg.set_robin_BC(pores=2, values=2.0, coefficients=2.0, mode='overwrite')
+        alg.run()
+        nt.assert_allclose(alg.x, [0.0, 0.8, 1.6], rtol=1e-10, atol=1e-12)
+
+    def test_transient_robin_relaxation_matches_analytic_solution(self):
+        network, _, alg = transport(
+            shape=(1, 1, 1),
+            algorithm=op.algorithms.TransientFickianDiffusion,
+        )
+        network['pore.volume'] = 1.0
+        alg.set_robin_BC(pores=0, values=1.0, coefficients=2.0)
+        alg.run(x0=0.0, tspan=(0.0, 1.0), saveat=[1.0])
+        nt.assert_allclose(alg.x, [1.0 - np.exp(-2.0)], rtol=2e-5)
