diff --git a/crates/kira/tests/start_frames_d57a37.rs b/crates/kira/tests/start_frames_d57a37.rs
new file mode 100644
index 00000000..57abaec0
--- /dev/null
+++ b/crates/kira/tests/start_frames_d57a37.rs
@@ -0,0 +1,398 @@
+use std::{
+	sync::mpsc::{Receiver, Sender, channel},
+	time::Duration,
+};
+
+use kira::{
+	AudioManager, AudioManagerSettings, Frame, StartTime, Tween,
+	backend::{Backend, Renderer},
+	clock::{ClockHandle, ClockSpeed, ClockTime},
+	sound::{
+		static_sound::{StaticSoundData, StaticSoundSettings},
+		streaming::{Decoder, StreamingSoundData},
+	},
+	track::TrackBuilder,
+};
+
+const SAMPLE_RATE: u32 = 64;
+
+struct CaptureBackend {
+	renderer: Option<Renderer>,
+}
+
+impl Backend for CaptureBackend {
+	type Settings = ();
+	type Error = ();
+
+	fn setup(_settings: (), _internal_buffer_size: usize) -> Result<(Self, u32), ()> {
+		Ok((Self { renderer: None }, SAMPLE_RATE))
+	}
+
+	fn start(&mut self, renderer: Renderer) -> Result<(), ()> {
+		self.renderer = Some(renderer);
+		Ok(())
+	}
+}
+
+impl CaptureBackend {
+	fn render(&mut self, num_frames: usize) -> Vec<f32> {
+		let renderer = self.renderer.as_mut().unwrap();
+		let mut out = vec![0.0; num_frames * 2];
+		renderer.on_start_processing();
+		renderer.process(&mut out, 2);
+		out.chunks(2).map(|frame| frame[0]).collect()
+	}
+
+	fn render_in_calls(&mut self, calls: usize, frames_per_call: usize) -> Vec<f32> {
+		(0..calls)
+			.flat_map(|_| self.render(frames_per_call))
+			.collect()
+	}
+}
+
+fn manager() -> AudioManager<CaptureBackend> {
+	AudioManager::new(AudioManagerSettings {
+		internal_buffer_size: 16,
+		backend_settings: (),
+		..Default::default()
+	})
+	.unwrap()
+}
+
+fn value(i: usize) -> f32 {
+	(i + 1) as f32 / 1024.0
+}
+
+fn frames(len: usize) -> Vec<Frame> {
+	(0..len).map(|i| Frame::from_mono(value(i))).collect()
+}
+
+fn static_data(len: usize) -> StaticSoundData {
+	StaticSoundData {
+		sample_rate: SAMPLE_RATE,
+		frames: frames(len).into(),
+		settings: StaticSoundSettings::default(),
+		slice: None,
+	}
+}
+
+fn started_at(start: usize, len: usize) -> Vec<f32> {
+	(0..len)
+		.map(|i| if i < start { 0.0 } else { value(i - start) })
+		.collect()
+}
+
+fn assert_starts_at(out: &[f32], start: usize) {
+	assert_eq!(out, started_at(start, out.len()).as_slice(), "expected the sound to start at frame {start}");
+}
+
+fn ticking_clock(manager: &mut AudioManager<CaptureBackend>, ticks_per_second: f64) -> ClockHandle {
+	let mut clock = manager
+		.add_clock(ClockSpeed::TicksPerSecond(ticks_per_second))
+		.unwrap();
+	clock.start();
+	clock
+}
+
+fn at(clock: &ClockHandle, ticks: u64, fraction: f64) -> ClockTime {
+	ClockTime {
+		clock: clock.id(),
+		ticks,
+		fraction,
+	}
+}
+
+struct TestDecoder {
+	frames: Vec<Frame>,
+	position: usize,
+	_dropped: Sender<()>,
+}
+
+impl Decoder for TestDecoder {
+	type Error = ();
+
+	fn sample_rate(&self) -> u32 {
+		SAMPLE_RATE
+	}
+
+	fn num_frames(&self) -> usize {
+		self.frames.len()
+	}
+
+	fn decode(&mut self) -> Result<Vec<Frame>, ()> {
+		let end = (self.position + 4).min(self.frames.len());
+		let chunk = self.frames[self.position..end].to_vec();
+		self.position = end;
+		Ok(chunk)
+	}
+
+	fn seek(&mut self, index: usize) -> Result<usize, ()> {
+		self.position = index.min(self.frames.len());
+		Ok(self.position)
+	}
+}
+
+fn streaming_data(len: usize) -> (StreamingSoundData<()>, Receiver<()>) {
+	let (sender, receiver) = channel();
+	let decoder = TestDecoder {
+		frames: frames(len),
+		position: 0,
+		_dropped: sender,
+	};
+	(StreamingSoundData::from_decoder(decoder), receiver)
+}
+
+fn wait_until_fully_buffered(receiver: Receiver<()>) {
+	assert!(
+		receiver.recv_timeout(Duration::from_secs(30)).is_err(),
+		"the decoder thread never finished"
+	);
+}
+
+mod clock_times {
+	use super::*;
+
+	#[test]
+	fn a_static_sound_starts_on_the_frame_its_clock_time_is_reached() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 1, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(32), 8);
+	}
+
+	#[test]
+	fn a_clock_time_in_a_later_buffer_starts_partway_through_that_buffer() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 3, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render_in_calls(3, 16), 24);
+	}
+
+	#[test]
+	fn a_time_reached_exactly_at_the_end_of_a_buffer_starts_the_next_buffer() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 2, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render_in_calls(3, 16), 16);
+	}
+
+	#[test]
+	fn a_fractional_tick_is_reached_between_whole_ticks() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 1, 0.5))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(32), 12);
+	}
+
+	#[test]
+	fn a_rate_with_fractional_frames_per_tick_starts_on_the_first_frame_past_the_time() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 24.0);
+		manager.play(static_data(64).start_time(at(&clock, 1, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(16), 3);
+	}
+
+	#[test]
+	fn a_rate_with_fractional_frames_per_tick_can_still_end_exactly_on_a_buffer() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 24.0);
+		manager.play(static_data(64).start_time(at(&clock, 6, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render_in_calls(2, 16), 16);
+	}
+
+	#[test]
+	fn tick_zero_of_a_clock_started_this_buffer_is_reached_on_its_first_frame() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 0, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(16), 0);
+	}
+
+	#[test]
+	fn a_time_the_clock_already_passed_starts_on_the_first_frame() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.backend_mut().render(32);
+		manager.play(static_data(64).start_time(at(&clock, 1, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(16), 0);
+	}
+
+	#[test]
+	fn a_stopped_clock_never_reaches_the_time() {
+		let mut manager = manager();
+		let mut clock = ticking_clock(&mut manager, 8.0);
+		clock.pause();
+		manager.play(static_data(64).start_time(at(&clock, 1, 0.0))).unwrap();
+		assert!(manager.backend_mut().render(64).iter().all(|v| *v == 0.0));
+	}
+
+	#[test]
+	fn a_clock_paused_before_the_time_starts_the_sound_after_it_resumes() {
+		let mut manager = manager();
+		let mut clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 3, 0.0))).unwrap();
+		let mut out = manager.backend_mut().render(16);
+		clock.pause();
+		out.extend(manager.backend_mut().render(16));
+		clock.start();
+		out.extend(manager.backend_mut().render(16));
+		assert_starts_at(&out, 40);
+	}
+
+	#[test]
+	fn the_speed_a_clock_moves_at_in_the_buffer_decides_the_frame() {
+		let mut manager = manager();
+		let mut clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 5, 0.0))).unwrap();
+		let mut out = manager.backend_mut().render(16);
+		clock.set_speed(
+			ClockSpeed::TicksPerSecond(16.0),
+			Tween {
+				duration: Duration::ZERO,
+				..Default::default()
+			},
+		);
+		out.extend(manager.backend_mut().render(16));
+		assert_starts_at(&out, 28);
+	}
+}
+
+mod delays {
+	use super::*;
+
+	fn delayed(seconds: f64) -> StaticSoundData {
+		static_data(64).start_time(StartTime::Delayed(Duration::from_secs_f64(seconds)))
+	}
+
+	#[test]
+	fn a_delay_starts_the_sound_that_many_frames_in() {
+		let mut manager = manager();
+		manager.play(delayed(0.125)).unwrap();
+		assert_starts_at(&manager.backend_mut().render(16), 8);
+	}
+
+	#[test]
+	fn a_delay_between_frames_starts_on_the_next_whole_frame() {
+		let mut manager = manager();
+		manager.play(delayed(0.1)).unwrap();
+		assert_starts_at(&manager.backend_mut().render(16), 7);
+	}
+
+	#[test]
+	fn a_delay_of_exactly_one_buffer_starts_the_next_buffer() {
+		let mut manager = manager();
+		manager.play(delayed(0.25)).unwrap();
+		assert_starts_at(&manager.backend_mut().render_in_calls(2, 16), 16);
+	}
+
+	#[test]
+	fn a_delay_spanning_buffers_starts_partway_through_a_later_one() {
+		let mut manager = manager();
+		manager.play(delayed(0.625)).unwrap();
+		assert_starts_at(&manager.backend_mut().render_in_calls(4, 16), 40);
+	}
+
+	#[test]
+	fn a_zero_delay_starts_on_the_first_frame() {
+		let mut manager = manager();
+		manager.play(delayed(0.0)).unwrap();
+		assert_starts_at(&manager.backend_mut().render(16), 0);
+	}
+}
+
+mod streaming {
+	use super::*;
+
+	fn play(manager: &mut AudioManager<CaptureBackend>, start_time: impl Into<StartTime>) {
+		let (data, receiver) = streaming_data(64);
+		manager.play(data.start_time(start_time)).unwrap();
+		wait_until_fully_buffered(receiver);
+	}
+
+	#[test]
+	fn a_streaming_sound_starts_on_the_frame_its_clock_time_is_reached() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		play(&mut manager, at(&clock, 3, 0.0));
+		assert_starts_at(&manager.backend_mut().render_in_calls(3, 16), 24);
+	}
+
+	#[test]
+	fn a_streaming_sound_waits_out_a_delay_to_the_frame() {
+		let mut manager = manager();
+		play(&mut manager, Duration::from_secs_f64(0.1875));
+		assert_starts_at(&manager.backend_mut().render(32), 12);
+	}
+
+	#[test]
+	fn a_streaming_sound_whose_time_ends_a_buffer_starts_the_next_one() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		play(&mut manager, at(&clock, 4, 0.0));
+		assert_starts_at(&manager.backend_mut().render_in_calls(3, 16), 32);
+	}
+
+	#[test]
+	fn a_streaming_sound_with_an_immediate_start_is_unchanged() {
+		let mut manager = manager();
+		play(&mut manager, StartTime::Immediate);
+		assert_starts_at(&manager.backend_mut().render(32), 0);
+	}
+}
+
+mod placement {
+	use super::*;
+
+	#[test]
+	fn a_sound_on_a_sub_track_starts_on_the_same_frame() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		let mut track = manager.add_sub_track(TrackBuilder::new()).unwrap();
+		track.play(static_data(64).start_time(at(&clock, 1, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(32), 8);
+	}
+
+	#[test]
+	fn a_sound_on_a_nested_sub_track_starts_on_the_same_frame() {
+		let mut manager = manager();
+		let mut outer = manager.add_sub_track(TrackBuilder::new()).unwrap();
+		let mut inner = outer.add_sub_track(TrackBuilder::new()).unwrap();
+		inner
+			.play(static_data(64).start_time(StartTime::Delayed(Duration::from_secs_f64(0.3125))))
+			.unwrap();
+		assert_starts_at(&manager.backend_mut().render_in_calls(2, 16), 20);
+	}
+
+	#[test]
+	fn one_backend_call_covering_several_internal_buffers_lands_on_the_same_frame() {
+		let mut manager = manager();
+		let clock = ticking_clock(&mut manager, 8.0);
+		manager.play(static_data(64).start_time(at(&clock, 5, 0.0))).unwrap();
+		assert_starts_at(&manager.backend_mut().render(64), 40);
+	}
+
+	#[test]
+	fn a_delay_inside_one_large_backend_call_lands_on_the_same_frame() {
+		let mut manager = manager();
+		manager
+			.play(static_data(64).start_time(StartTime::Delayed(Duration::from_secs_f64(0.5625))))
+			.unwrap();
+		assert_starts_at(&manager.backend_mut().render(64), 36);
+	}
+
+	#[test]
+	fn two_sounds_on_different_clocks_start_on_their_own_frames() {
+		let mut manager = manager();
+		let slow = ticking_clock(&mut manager, 8.0);
+		let fast = ticking_clock(&mut manager, 16.0);
+		manager.play(static_data(64).start_time(at(&slow, 1, 0.0))).unwrap();
+		manager.play(static_data(64).start_time(at(&fast, 3, 0.0))).unwrap();
+		let out = manager.backend_mut().render(32);
+		let expected: Vec<f32> = started_at(8, 32)
+			.iter()
+			.zip(started_at(12, 32))
+			.map(|(a, b)| a + b)
+			.collect();
+		assert_eq!(out, expected);
+	}
+}
