+++ b/test.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"; export CARGO_INCREMENTAL=0; export RUSTC_BOOTSTRAP=1
+FEATURES="symphonia,wav,ogg,vorbis,flac,mp3,pcm"
+MODE=""; OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+TEST_JSON="$(mktemp)"; TEST_ERR="$(mktemp)"; STATUS=0
+# The cpal backend is not built (it needs the ALSA headers, which the image does not have), so the
+# sync_send integration test, which imports kira::backend::cpal, is not part of either mode.
+case "$MODE" in
+  base) cargo test -p kira --no-default-features --features "$FEATURES" --lib --test change_sample_rate --test streaming_sound_stops_on_error -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"; STATUS=$? ;;
+  new)  cargo test -p kira --no-default-features --features "$FEATURES" --test start_frames_d57a37 -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"; STATUS=$? ;;
+esac
+cat "$TEST_ERR" >&2
+NEW_TESTS="clock_times a_clock_paused_before_the_time_starts_the_sound_after_it_resumes
+clock_times a_clock_time_in_a_later_buffer_starts_partway_through_that_buffer
+clock_times a_fractional_tick_is_reached_between_whole_ticks
+clock_times a_rate_with_fractional_frames_per_tick_can_still_end_exactly_on_a_buffer
+clock_times a_rate_with_fractional_frames_per_tick_starts_on_the_first_frame_past_the_time
+clock_times a_static_sound_starts_on_the_frame_its_clock_time_is_reached
+clock_times a_stopped_clock_never_reaches_the_time
+clock_times a_time_reached_exactly_at_the_end_of_a_buffer_starts_the_next_buffer
+clock_times a_time_the_clock_already_passed_starts_on_the_first_frame
+clock_times the_speed_a_clock_moves_at_in_the_buffer_decides_the_frame
+clock_times tick_zero_of_a_clock_started_this_buffer_is_reached_on_its_first_frame
+delays a_delay_between_frames_starts_on_the_next_whole_frame
+delays a_delay_of_exactly_one_buffer_starts_the_next_buffer
+delays a_delay_spanning_buffers_starts_partway_through_a_later_one
+delays a_delay_starts_the_sound_that_many_frames_in
+delays a_zero_delay_starts_on_the_first_frame
+placement a_delay_inside_one_large_backend_call_lands_on_the_same_frame
+placement a_sound_on_a_nested_sub_track_starts_on_the_same_frame
+placement a_sound_on_a_sub_track_starts_on_the_same_frame
+placement one_backend_call_covering_several_internal_buffers_lands_on_the_same_frame
+placement two_sounds_on_different_clocks_start_on_their_own_frames
+streaming a_streaming_sound_starts_on_the_frame_its_clock_time_is_reached
+streaming a_streaming_sound_waits_out_a_delay_to_the_frame
+streaming a_streaming_sound_whose_time_ends_a_buffer_starts_the_next_one
+streaming a_streaming_sound_with_an_immediate_start_is_unchanged"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2>/dev/null || true
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    sanitized=$( { cat "$TEST_ERR"; cat "$TEST_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    if [ "$MODE" = "new" ]; then
+      count=0; cases=""
+      while read -r class name; do
+        [ -n "$name" ] || continue
+        count=$((count + 1))
+        cases="${cases}    <testcase name=\"${name}\" classname=\"${class}\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+      done <<< "$NEW_TESTS"
+    else
+      count=1
+      cases="    <testcase name=\"compilation\" classname=\"cargo-test\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+    fi
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+      printf '  <testsuite name="cargo test #0" tests="%s" failures="%s" errors="0">\n' "$count" "$count"
+      printf '%s' "$cases"
+      printf '  </testsuite>\n</testsuites>\n'
+    } > "$OUTPUT_PATH"
+  fi
+fi
+exit $STATUS
