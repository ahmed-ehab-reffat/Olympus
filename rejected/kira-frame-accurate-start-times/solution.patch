+impl StartTime {
+	pub(crate) fn start_frame(&mut self, dt: f64, info: &Info) -> StartFrame {
+		let reached = match self {
+			StartTime::Immediate => Reached::At(0),
+			StartTime::Delayed(time_remaining) => match info.frame_after_delay(*time_remaining) {
+				Some(frame) => Reached::At(frame),
+				None => {
+					*time_remaining = time_remaining.saturating_sub(Duration::from_secs_f64(dt));
+					Reached::NotYet
+				}
+			},
+			StartTime::ClockTime(clock_time) => info.frame_reached(*clock_time),
+		};
+		match reached {
+			Reached::At(frame) => {
+				*self = StartTime::Immediate;
+				StartFrame::At(frame)
+			}
+			Reached::NotYet => StartFrame::Later,
+			Reached::Never => StartFrame::Never,
+		}
+	}
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum StartFrame {
+	At(usize),
+	Later,
