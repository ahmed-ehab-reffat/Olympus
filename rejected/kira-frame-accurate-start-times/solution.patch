+fn first_frame_at_or_after(start: f64, end: f64, target: f64, frames: usize) -> Reached {
+	if start >= target {
+		return Reached::At(0);
+	}
+	if end <= start {
+		return Reached::NotYet;
+	}
+	let frame = ((target - start) * frames as f64 / (end - start)).ceil() as usize;
+	if frame < frames {
+		Reached::At(frame)
+	} else {
+		Reached::NotYet
+	}
+}
