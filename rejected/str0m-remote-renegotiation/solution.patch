+/// Validates every condition that can reject a remote offer before any of the
+/// remote-owned ICE, DTLS, SCTP, or media state is changed.
+fn validate_offer(rtc: &Rtc, offer: &SdpOffer) -> Result<(), RtcError> {
+    if offer.media_lines.is_empty() {
+        return Err(RtcError::RemoteSdp("No m-lines in offer".into()));
+    }
+
+    if rtc.ice.ice_lite() && offer.session.ice_lite() {
+        return Err(RtcError::RemoteSdp(
+            "Both peers being ICE-Lite not supported".into(),
+        ));
+    }
+
+    offer.assert_consistency()?;
+
+    if offer.ice_creds().is_none() {
+        return Err(RtcError::RemoteSdp("missing a=ice-ufrag/pwd".into()));
+    }
+
+    if rtc.remote_fingerprint.is_none() && offer.fingerprint().is_none() {
+        return Err(RtcError::RemoteSdp("missing a=fingerprint".into()));
+    }
+
+    validate_remote_sctp_init(&rtc.sctp, offer.sctp_init())?;
+    validate_offer_medias(&rtc.session, offer).map_err(RtcError::RemoteSdp)?;
+
+    Ok(())
+}
