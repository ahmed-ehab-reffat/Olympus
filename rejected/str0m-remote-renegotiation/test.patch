+mod common;
+
+use std::net::Ipv4Addr;
+use std::time::Instant;
+
+use common::{
+    Peer, TestRtc, init_crypto_default, init_log, negotiate, progress, replace_sctp_init,
+};
+use str0m::change::SdpOffer;
+use str0m::media::{Direction, MediaKind};
+use str0m::{Event, Output, Rtc, RtcError};
+use tracing::info_span;
+
+#[test]
+fn rejected_reordered_offer_does_not_apply_media_state_or_events() {
+    init_log();
+    init_crypto_default();
+
+    let mut l = TestRtc::new(Peer::Left);
+    let mut r = TestRtc::new(Peer::Right);
+
+    let mids = negotiate(&mut l, &mut r, |change| {
+        [
+            change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None),
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None),
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None),
+        ]
+    });
+
+    let before = l.media(mids[0]).unwrap().direction();
+    assert_eq!(before, Direction::SendRecv);
+    drain_events(&mut l.rtc);
+
+    let (offer, _) = {
+        let mut change = r.rtc.sdp_api();
+        change.set_direction(mids[0], Direction::SendOnly);
+        change.apply().expect("direction change produces an offer")
+    };
+
+    let malformed = reorder_last_two_media_sections(&offer.to_sdp_string());
+    let offer = SdpOffer::from_sdp_string(&malformed).expect("reordered offer parses");
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_offer(offer)
+        .expect_err("changed m-line order must be rejected");
+    assert_remote_sdp(err);
+
+    assert_eq!(
+        l.media(mids[0]).unwrap().direction(),
+        before,
+        "a rejected offer must not apply changes from an earlier m-line"
+    );
+
+    let leaked = drain_events(&mut l.rtc)
+        .into_iter()
+        .any(|event| matches!(event, Event::MediaAdded(_) | Event::MediaChanged(_)));
+    assert!(!leaked, "a rejected offer must not queue media events");
+}
