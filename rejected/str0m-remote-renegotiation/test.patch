+#[test]
+fn rejected_snap_reoffer_does_not_apply_ice_or_media_state() {
+    init_log();
+    init_crypto_default();
+
+    let now = Instant::now();
+    let mut l = TestRtc::new_with_rtc(
+        info_span!("L"),
+        Rtc::builder().set_snap_enabled(true).build(now),
+    );
+    let mut r = TestRtc::new_with_rtc(
+        info_span!("R"),
+        Rtc::builder().set_snap_enabled(true).build(now),
+    );
+    l.add_host_candidate((Ipv4Addr::new(1, 1, 1, 1), 1000).into());
+    r.add_host_candidate((Ipv4Addr::new(2, 2, 2, 2), 2000).into());
+
+    let mid = negotiate(&mut l, &mut r, |change| {
+        change.add_channel("snap-atomicity".into());
+        change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None)
+    });
+
+    for _ in 0..1000 {
+        if l.is_connected() && r.is_connected() {
+            break;
+        }
+        progress(&mut l, &mut r).expect("SNAP peers make progress");
+    }
+    assert!(
+        l.is_connected() && r.is_connected(),
+        "SNAP association must be established before testing a re-offer"
+    );
+
+    let credentials_before = r.rtc.direct_api().local_ice_credentials();
+    let direction_before = r.media(mid).unwrap().direction();
+
+    let (offer, pending) = {
+        let mut change = l.rtc.sdp_api();
+        change.ice_restart(true);
+        change.set_direction(mid, Direction::SendOnly);
+        change.apply().expect("SNAP re-offer is generated")
+    };
+    let valid_sdp = offer.to_sdp_string();
+    let tampered = replace_sctp_init(&valid_sdp, "AQ==");
+
+    let err = r
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&tampered).unwrap())
+        .expect_err("a changed established SNAP value must be rejected");
+    assert_remote_sdp(err);
+    assert_eq!(
+        r.rtc.direct_api().local_ice_credentials(),
+        credentials_before,
+        "a rejected SNAP re-offer must not apply its earlier ICE restart"
+    );
+    assert_eq!(
+        r.media(mid).unwrap().direction(),
+        direction_before,
+        "a rejected SNAP re-offer must not apply media changes"
+    );
+
+    let answer = r
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&valid_sdp).unwrap())
+        .expect("the original SNAP re-offer remains acceptable");
+    l.rtc
+        .sdp_api()
+        .accept_answer(pending, answer)
+        .expect("the SNAP retry answer remains acceptable");
+
+    assert_ne!(
+        r.rtc.direct_api().local_ice_credentials(),
+        credentials_before,
+        "the valid SNAP retry must commit its ICE restart"
+    );
+    assert_ne!(
+        r.media(mid).unwrap().direction(),
+        direction_before,
+        "the valid SNAP retry must commit its media change"
+    );
+}
+
+fn reorder_last_two_media_sections(sdp: &str) -> String {
+    let mut sections = Vec::new();
+    let mut current = String::new();
+
+    for line in sdp.split_inclusive("\r\n") {
+        if line.starts_with("m=") && !current.is_empty() {
+            sections.push(std::mem::take(&mut current));
+        }
+        current.push_str(line);
+    }
+    if !current.is_empty() {
+        sections.push(current);
+    }
+
+    assert_eq!(sections.len(), 4, "session plus three media sections");
+    sections.swap(2, 3);
+    sections.concat()
+}
+
+fn remove_sdp_attributes(sdp: &str, prefixes: &[&str]) -> String {
+    sdp.split_inclusive("\r\n")
+        .filter(|line| !prefixes.iter().any(|prefix| line.starts_with(prefix)))
+        .collect()
+}
+
+fn remove_first_media_attributes(sdp: &str, prefixes: &[&str]) -> String {
+    let mut media_index = 0;
+
+    sdp.split_inclusive("\r\n")
+        .filter(|line| {
+            if line.starts_with("m=") {
+                media_index += 1;
+            }
+            media_index != 1 || !prefixes.iter().any(|prefix| line.starts_with(prefix))
+        })
+        .collect()
+}
+
+fn drain_events(rtc: &mut Rtc) -> Vec<Event> {
+    let mut events = Vec::new();
+
+    loop {
+        match rtc.poll_output().expect("polling output succeeds") {
+            Output::Event(event) => events.push(event),
+            Output::Transmit(_) => {}
+            Output::Timeout(_) => return events,
+        }
+    }
+}
+
+fn assert_remote_sdp(err: RtcError) {
+    assert!(
+        matches!(err, RtcError::RemoteSdp(_)),
+        "expected RemoteSdp, got {err}"
+    );
+}
