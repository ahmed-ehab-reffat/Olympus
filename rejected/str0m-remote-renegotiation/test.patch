+#[test]
+fn missing_initial_fingerprint_does_not_disconnect_receiver() {
+    init_log();
+    init_crypto_default();
+
+    let mut l = TestRtc::new(Peer::Left);
+    let mut r = TestRtc::new(Peer::Right);
+
+    let (offer, pending) = {
+        let mut change = r.rtc.sdp_api();
+        change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None);
+        change.apply().expect("media addition produces an offer")
+    };
+    let valid_sdp = offer.to_sdp_string();
+    let missing_fingerprint = remove_sdp_attributes(&valid_sdp, &["a=fingerprint:"]);
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&missing_fingerprint).unwrap())
+        .expect_err("an initial offer without a fingerprint must be rejected");
+    assert_remote_sdp(err);
+    assert!(
+        l.rtc.is_alive(),
+        "invalid remote input must not disconnect a live receiver"
+    );
+
+    let answer = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&valid_sdp).unwrap())
+        .expect("the untouched valid offer remains acceptable");
+    r.rtc
+        .sdp_api()
+        .accept_answer(pending, answer)
+        .expect("the retry answer remains acceptable");
+
+    assert_rejected_initial_offer_does_not_pin_fingerprint();
+    assert_rejected_offer_still_invalidates_pending_local_offer();
+}
+
+fn assert_rejected_initial_offer_does_not_pin_fingerprint() {
+    let mut l = TestRtc::new(Peer::Left);
+    let mut rejected_remote = TestRtc::new(Peer::Right);
+    let mut valid_remote = TestRtc::new(Peer::Right);
+
+    let (rejected_offer, _) = {
+        let mut change = rejected_remote.rtc.sdp_api();
+        change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None);
+        change.apply().expect("media addition produces an offer")
+    };
+    let missing_ice = remove_sdp_attributes(
+        &rejected_offer.to_sdp_string(),
+        &["a=ice-ufrag:", "a=ice-pwd:"],
+    );
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&missing_ice).unwrap())
+        .expect_err("an offer without ICE credentials must be rejected");
+    assert_remote_sdp(err);
+
+    l.add_host_candidate((Ipv4Addr::new(192, 0, 2, 1), 1000).into());
+    valid_remote.add_host_candidate((Ipv4Addr::new(192, 0, 2, 2), 2000).into());
+    let (valid_offer, pending) = {
+        let mut change = valid_remote.rtc.sdp_api();
+        change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None);
+        change.apply().expect("media addition produces an offer")
+    };
+    let answer = l
+        .rtc
+        .sdp_api()
+        .accept_offer(valid_offer)
+        .expect("a valid offer from another peer remains acceptable");
+    valid_remote
+        .rtc
+        .sdp_api()
+        .accept_answer(pending, answer)
+        .expect("the valid answer remains acceptable");
+
+    for _ in 0..1000 {
+        if l.is_connected() && valid_remote.is_connected() {
+            break;
+        }
+        progress(&mut l, &mut valid_remote).expect("valid peers make progress");
+    }
+    assert!(
+        l.is_connected() && valid_remote.is_connected(),
+        "the rejected offer's fingerprint must not poison a later valid handshake"
+    );
+}
+
+fn assert_rejected_offer_still_invalidates_pending_local_offer() {
+    let mut l = TestRtc::new(Peer::Left);
+    let mut r = TestRtc::new(Peer::Right);
+    let mut remote = TestRtc::new(Peer::Right);
+
+    let (local_offer, pending) = {
+        let mut change = l.rtc.sdp_api();
+        change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None);
+        change.apply().expect("media addition produces an offer")
+    };
+    let local_answer = r
+        .rtc
+        .sdp_api()
+        .accept_offer(local_offer)
+        .expect("the local offer is valid");
+
+    let (remote_offer, _) = {
+        let mut change = remote.rtc.sdp_api();
+        change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None);
+        change.apply().expect("media addition produces an offer")
+    };
+    let missing_ice = remove_sdp_attributes(
+        &remote_offer.to_sdp_string(),
+        &["a=ice-ufrag:", "a=ice-pwd:"],
+    );
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&missing_ice).unwrap())
+        .expect_err("an offer without ICE credentials must be rejected");
+    assert_remote_sdp(err);
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_answer(pending, local_answer)
+        .expect_err("accept_offer must invalidate the old pending offer");
+    assert!(
+        matches!(err, RtcError::ChangesOutOfOrder),
+        "unexpected pending-offer error: {err}"
+    );
+}
