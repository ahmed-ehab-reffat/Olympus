+#[test]
+fn rejected_reordered_offer_does_not_apply_ice_restart() {
+    init_log();
+    init_crypto_default();
+
+    let mut l = TestRtc::new(Peer::Left);
+    let mut r = TestRtc::new(Peer::Right);
+
+    let mids = negotiate(&mut l, &mut r, |change| {
+        [
+            change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None),
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None),
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None),
+        ]
+    });
+
+    let credentials_before = l.rtc.direct_api().local_ice_credentials();
+
+    let (offer, pending) = {
+        let mut change = r.rtc.sdp_api();
+        change.ice_restart(true);
+        change.set_direction(mids[0], Direction::SendOnly);
+        change.apply().expect("ICE restart produces an offer")
+    };
+    let valid_sdp = offer.to_sdp_string();
+    let malformed = reorder_last_two_media_sections(&valid_sdp);
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&malformed).unwrap())
+        .expect_err("changed m-line order must be rejected");
+    assert_remote_sdp(err);
+
+    assert_eq!(
+        l.rtc.direct_api().local_ice_credentials(),
+        credentials_before,
+        "a rejected remote ICE restart must not rotate local credentials"
+    );
+
+    let answer = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&valid_sdp).unwrap())
+        .expect("the original valid offer remains acceptable");
+    r.rtc
+        .sdp_api()
+        .accept_answer(pending, answer)
+        .expect("the retry answer remains acceptable");
+
+    assert_ne!(
+        l.rtc.direct_api().local_ice_credentials(),
+        credentials_before,
+        "the valid retry must still commit the ICE restart"
+    );
+}
