+#[test]
+fn rejected_reordered_offer_does_not_apply_remote_extension_changes() {
+    init_log();
+    init_crypto_default();
+
+    let mut l = TestRtc::new(Peer::Left);
+    let mut r = TestRtc::new(Peer::Right);
+
+    let mids = negotiate(&mut l, &mut r, |change| {
+        [
+            change.add_media(MediaKind::Audio, Direction::SendRecv, None, None, None),
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None),
+            change.add_media(MediaKind::Video, Direction::SendRecv, None, None, None),
+        ]
+    });
+    let extensions_before = l.media(mids[0]).unwrap().remote_extmap().clone();
+
+    let (offer, _) = {
+        let mut change = r.rtc.sdp_api();
+        change.set_direction(mids[0], Direction::SendOnly);
+        change.apply().expect("direction change produces an offer")
+    };
+    let without_first_media_extensions =
+        remove_first_media_attributes(&offer.to_sdp_string(), &["a=extmap:"]);
+    let malformed = reorder_last_two_media_sections(&without_first_media_extensions);
+
+    let err = l
+        .rtc
+        .sdp_api()
+        .accept_offer(SdpOffer::from_sdp_string(&malformed).unwrap())
+        .expect_err("changed m-line order must be rejected");
+    assert_remote_sdp(err);
+
+    assert_eq!(
+        l.media(mids[0]).unwrap().remote_extmap(),
+        &extensions_before,
+        "a rejected offer must not apply remote extension changes"
+    );
+}
