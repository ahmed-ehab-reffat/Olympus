+#!/usr/bin/env bash
+#
+# Test runner.
+#
+#   ./test.sh [--output_path <path>] <base|new>
+#
+#   base  runs the existing SDP negotiation and m-line recycling tests
+#   new   runs the rejected-offer state tests
+#
+# JUnit XML is written to --output_path when given.
+
+set -uo pipefail
+
+OUTPUT_PATH=""
+MODE=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path)
+            OUTPUT_PATH="${2-}"
+            shift 2
+            ;;
+        --output_path=*)
+            OUTPUT_PATH="${1#*=}"
+            shift
+            ;;
+        base | new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+if [ -z "$MODE" ]; then
+    echo "usage: $0 [--output_path <path>] <base|new>" >&2
+    exit 2
+fi
+
+cd "$(dirname "$0")" || exit 2
+
+case "$MODE" in
+    base)
+        TARGET=(
+            --test sdp-negotiation
+            --test sdp-m-recycle
+        )
+        ;;
+    new)
+        TARGET=(
+            --test sdp-rejected-offer-state_83efa2
+        )
+        ;;
+esac
+
+find target/nextest -name junit.xml -type f -delete 2>/dev/null
+
+cargo nextest run \
+    --locked \
+    --offline \
+    --no-default-features \
+    --features rust-crypto \
+    --profile default \
+    --no-fail-fast \
+    "${TARGET[@]}"
+STATUS=$?
+
+if [ -n "$OUTPUT_PATH" ]; then
+    mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+    JUNIT_SRC="$(find target/nextest -name junit.xml -type f 2>/dev/null | head -1)"
+
+    if [ -n "$JUNIT_SRC" ] && [ -f "$JUNIT_SRC" ]; then
+        cp "$JUNIT_SRC" "$OUTPUT_PATH"
+    else
+        cat > "$OUTPUT_PATH" <<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites tests="1" failures="1" errors="0">
+  <testsuite name="$MODE" tests="1" failures="1" errors="0">
+    <testcase name="run" classname="$MODE">
+      <failure message="test run failed before producing a report (exit $STATUS)"/>
+    </testcase>
+  </testsuite>
+</testsuites>
+XML
+    fi
+fi
+
+exit "$STATUS"
