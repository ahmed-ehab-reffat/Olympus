diff --git a/Packet++/header/SnapLayer.h b/Packet++/header/SnapLayer.h
new file mode 100644
index 00000000..b8a19bc2
--- /dev/null
+++ b/Packet++/header/SnapLayer.h
@@ -0,0 +1,94 @@
+#pragma once
+
+#include "Layer.h"
+
+/// @file
+
+/// @namespace pcpp
+/// @brief The main namespace for the PcapPlusPlus lib
+namespace pcpp
+{
+#pragma pack(push, 1)
+	/// @struct snap_header
+	/// Subnetwork Access Protocol (SNAP) header
+	struct snap_header
+	{
+		/// Organization Unique Identifier
+		uint8_t oui[3];
+		/// Protocol identifier
+		uint16_t protocolId;
+	};
+#pragma pack(pop)
+	static_assert(sizeof(snap_header) == 5, "snap_header size is not 5 bytes");
+
+	/// @class SnapLayer
+	/// Represents an IEEE 802.2 Subnetwork Access Protocol (SNAP) layer
+	class SnapLayer : public Layer
+	{
+	public:
+		/// A constructor that creates the layer from existing packet raw data
+		/// @param[in] data A pointer to the raw data
+		/// @param[in] dataLen Size of the data in bytes
+		/// @param[in] prevLayer A pointer to the previous layer
+		/// @param[in] packet A pointer to the Packet instance where the layer is stored
+		SnapLayer(uint8_t* data, size_t dataLen, Layer* prevLayer, Packet* packet)
+		    : Layer(data, dataLen, prevLayer, packet, SNAP)
+		{}
+
+		/// A constructor that creates a SNAP layer from provided values
+		/// @param[in] oui Organization Unique Identifier, stored in the low 24 bits
+		/// @param[in] protocolId Protocol identifier
+		SnapLayer(uint32_t oui, uint16_t protocolId);
+
+		/// Get a pointer to the SNAP header
+		/// @return Pointer to the SNAP header
+		inline snap_header* getSnapHeader() const
+		{
+			return reinterpret_cast<snap_header*>(m_Data);
+		}
+
+		/// Get the Organization Unique Identifier
+		/// @return The OUI as a 24-bit value in host byte order
+		uint32_t getOui() const;
+
+		/// Set the Organization Unique Identifier
+		/// @param[in] oui The OUI, taken from the low 24 bits
+		void setOui(uint32_t oui);
+
+		/// Get the protocol identifier
+		/// @return The protocol identifier in host byte order
+		uint16_t getProtocolId() const;
+
+		/// Set the protocol identifier
+		/// @param[in] protocolId The protocol identifier in host byte order
+		void setProtocolId(uint16_t protocolId);
+
+		/// Parse the next layer according to the OUI and protocol identifier
+		void parseNextLayer() override;
+
+		/// Set OUI and protocol identifier for supported next layers
+		void computeCalculateFields() override;
+
+		/// @return The fixed SNAP header size
+		size_t getHeaderLen() const override
+		{
+			return sizeof(snap_header);
+		}
+
+		/// @return The protocol info as a readable string
+		std::string toString() const override;
+
+		/// @return The OSI layer level of SNAP (Data Link Layer)
+		OsiModelLayer getOsiModelLayer() const override
+		{
+			return OsiModelDataLinkLayer;
+		}
+
+		/// Validate that data is long enough to contain a SNAP header
+		/// @param[in] data A pointer to the beginning of a byte stream
+		/// @param[in] dataLen The byte stream length
+		/// @return True if the data can represent a SNAP layer
+		static bool isDataValid(const uint8_t* data, size_t dataLen);
+	};
+
+}  // namespace pcpp
