diff --git a/Packet++/src/SnapLayer.cpp b/Packet++/src/SnapLayer.cpp
new file mode 100644
index 00000000..3b8196c4
--- /dev/null
+++ b/Packet++/src/SnapLayer.cpp
@@ -0,0 +1,163 @@
+#define LOG_MODULE PacketLogModuleSnapLayer
+
+#include "SnapLayer.h"
+#include "ArpLayer.h"
+#include "EndianPortable.h"
+#include "EthLayer.h"
+#include "IPv4Layer.h"
+#include "IPv6Layer.h"
+#include "MplsLayer.h"
+#include "PPPoELayer.h"
+#include "PayloadLayer.h"
+#include "StpLayer.h"
+#include "VlanLayer.h"
+#include "WakeOnLanLayer.h"
+
+namespace pcpp
+{
+	namespace
+	{
+		constexpr uint32_t StandardOui = 0x000000;
+		constexpr uint32_t CiscoOui = 0x00000c;
+		constexpr uint16_t CiscoPvstPid = 0x010b;
+	}  // namespace
+
+	SnapLayer::SnapLayer(uint32_t oui, uint16_t protocolId)
+	{
+		allocData(sizeof(snap_header));
+		m_Protocol = SNAP;
+		setOui(oui);
+		setProtocolId(protocolId);
+	}
+
+	uint32_t SnapLayer::getOui() const
+	{
+		auto* oui = getSnapHeader()->oui;
+		return (static_cast<uint32_t>(oui[0]) << 16) | (static_cast<uint32_t>(oui[1]) << 8) | oui[2];
+	}
+
+	void SnapLayer::setOui(uint32_t oui)
+	{
+		auto* bytes = getSnapHeader()->oui;
+		bytes[0] = static_cast<uint8_t>(oui >> 16);
+		bytes[1] = static_cast<uint8_t>(oui >> 8);
+		bytes[2] = static_cast<uint8_t>(oui);
+	}
+
+	uint16_t SnapLayer::getProtocolId() const
+	{
+		return be16toh(getSnapHeader()->protocolId);
+	}
+
+	void SnapLayer::setProtocolId(uint16_t protocolId)
+	{
+		getSnapHeader()->protocolId = htobe16(protocolId);
+	}
+
+	void SnapLayer::parseNextLayer()
+	{
+		if (m_DataLen <= sizeof(snap_header))
+			return;
+
+		uint8_t* payload = m_Data + sizeof(snap_header);
+		size_t payloadLen = m_DataLen - sizeof(snap_header);
+
+		if (getOui() == StandardOui)
+		{
+			switch (getProtocolId())
+			{
+			case PCPP_ETHERTYPE_IP:
+				tryConstructNextLayerWithFallback<IPv4Layer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_IPV6:
+				tryConstructNextLayerWithFallback<IPv6Layer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_ARP:
+				tryConstructNextLayerWithFallback<ArpLayer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_VLAN:
+			case PCPP_ETHERTYPE_IEEE_802_1AD:
+				tryConstructNextLayerWithFallback<VlanLayer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_PPPOES:
+				tryConstructNextLayerWithFallback<PPPoESessionLayer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_PPPOED:
+				tryConstructNextLayerWithFallback<PPPoEDiscoveryLayer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_MPLS:
+				tryConstructNextLayerWithFallback<MplsLayer, PayloadLayer>(payload, payloadLen);
+				break;
+			case PCPP_ETHERTYPE_WAKE_ON_LAN:
+				tryConstructNextLayerWithFallback<WakeOnLanLayer, PayloadLayer>(payload, payloadLen);
+				break;
+			}
+		}
+		else if (getOui() == CiscoOui && getProtocolId() == CiscoPvstPid &&
+		         StpLayer::isDataValid(payload, payloadLen))
+		{
+			constructNextLayerFromFactory(StpLayer::parseStpLayer, payload, payloadLen);
+		}
+
+		if (!hasNextLayer())
+			constructNextLayer<PayloadLayer>(payload, payloadLen);
+	}
+
+	void SnapLayer::computeCalculateFields()
+	{
+		if (m_NextLayer == nullptr)
+			return;
+
+		if (m_NextLayer->getProtocol() == STP)
+		{
+			setOui(CiscoOui);
+			setProtocolId(CiscoPvstPid);
+			return;
+		}
+
+		uint16_t protocolId = 0;
+		switch (m_NextLayer->getProtocol())
+		{
+		case IPv4:
+			protocolId = PCPP_ETHERTYPE_IP;
+			break;
+		case IPv6:
+			protocolId = PCPP_ETHERTYPE_IPV6;
+			break;
+		case ARP:
+			protocolId = PCPP_ETHERTYPE_ARP;
+			break;
+		case VLAN:
+			protocolId = PCPP_ETHERTYPE_VLAN;
+			break;
+		case PPPoESession:
+			protocolId = PCPP_ETHERTYPE_PPPOES;
+			break;
+		case PPPoEDiscovery:
+			protocolId = PCPP_ETHERTYPE_PPPOED;
+			break;
+		case MPLS:
+			protocolId = PCPP_ETHERTYPE_MPLS;
+			break;
+		case WakeOnLan:
+			protocolId = PCPP_ETHERTYPE_WAKE_ON_LAN;
+			break;
+		default:
+			return;
+		}
+
+		setOui(StandardOui);
+		setProtocolId(protocolId);
+	}
+
+	std::string SnapLayer::toString() const
+	{
+		return "Subnetwork Access Protocol";
+	}
+
+	bool SnapLayer::isDataValid(const uint8_t* data, size_t dataLen)
+	{
+		return data != nullptr && dataLen >= sizeof(snap_header);
+	}
+
+}  // namespace pcpp

