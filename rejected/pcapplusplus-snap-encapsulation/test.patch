+#!/usr/bin/env bash
+
+set -u
+
+export PATH="/usr/local/bin:/usr/bin:/bin:${PATH:-}"
+
+output_path=""
+mode=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      output_path="$2"
+      shift 2
+      ;;
+    base|new)
+      mode="$1"
+      shift
+      ;;
+    *)
+      echo "usage: $0 --output_path FILE {base|new}" >&2
+      exit 2
+      ;;
+  esac
+done
+
+if [[ -z "$output_path" || -z "$mode" ]]; then
+  echo "usage: $0 --output_path FILE {base|new}" >&2
+  exit 2
+fi
+
+output_path="$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$output_path")"
+new_test_args=(--expected-test Harness)
+if [[ "$mode" == "new" ]]; then
+  new_test_args=(
+    --expected-test SnapLayer.RecognitionAndFields
+    --expected-test SnapLayer.RecognitionBoundaries
+    --expected-test SnapLayer.NamespaceFallback
+    --expected-test SnapLayer.StandardDispatch
+    --expected-test SnapLayer.InnerFallback
+    --expected-test SnapLayer.CiscoStpDispatch
+    --expected-test SnapLayer.ConstructionAndSetters
+    --expected-test SnapLayer.ComputeFields
+    --expected-test SnapLayer.PredecessorPaths
+    --expected-test SnapLayer.AttachedRoundTripAndCopy
+  )
+fi
+
+cmake_bin="$(command -v cmake 2>/dev/null || true)"
+ctest_bin="$(command -v ctest 2>/dev/null || true)"
+if [[ -z "$cmake_bin" || -z "$ctest_bin" ]]; then
+  dependency_log="${output_path}.dependency.log"
+  {
+    printf 'required CMake tools are unavailable\n'
+    printf 'PATH=%s\n' "$PATH"
+    printf 'cmake=%s ctest=%s\n' "$cmake_bin" "$ctest_bin"
+  } >"$dependency_log"
+  python3 Tests/SnapLayerTest/ptf_to_junit.py \
+    "$dependency_log" "$output_path" 127 "${new_test_args[@]}"
+  result=$?
+  rm -f "$dependency_log"
+  exit "$result"
+fi
+
+build_dir="$(mktemp -d "${TMPDIR:-/tmp}/pcapplusplus-snap-tests.XXXXXX" 2>/dev/null)"
+setup_status=$?
+if [[ $setup_status -ne 0 || -z "$build_dir" ]]; then
+  setup_log="${output_path}.setup.log"
+  printf 'unable to create a temporary build directory\n' >"$setup_log"
+  python3 Tests/SnapLayerTest/ptf_to_junit.py \
+    "$setup_log" "$output_path" "$setup_status" "${new_test_args[@]}"
+  result=$?
+  rm -f "$setup_log"
+  exit "$result"
+fi
+trap 'rm -rf "$build_dir"' EXIT
+configure_log="$build_dir/configure.log"
+
+"$cmake_bin" -S . -B "$build_dir" \
+  -DCMAKE_BUILD_TYPE=Debug \
+  -DPCAPPP_BUILD_PCAPPP=OFF \
+  -DPCAPPP_BUILD_TESTS=ON \
+  -DPCAPPP_BUILD_EXAMPLES=OFF \
+  -DPCAPPP_BUILD_TUTORIALS=OFF >"$configure_log" 2>&1
+configure_status=$?
+if [[ $configure_status -ne 0 ]]; then
+  python3 Tests/SnapLayerTest/ptf_to_junit.py \
+    "$configure_log" "$output_path" "$configure_status" "${new_test_args[@]}"
+  exit $?
+fi
+
+if [[ "$mode" == "base" ]]; then
+  build_log="$build_dir/base-build.log"
+  "$cmake_bin" --build "$build_dir" --target Packet++Test --parallel 2 >"$build_log" 2>&1
+  build_status=$?
+  if [[ $build_status -ne 0 ]]; then
+    python3 Tests/SnapLayerTest/ptf_to_junit.py "$build_log" "$output_path" "$build_status"
+    exit $?
+  fi
+
+  "$ctest_bin" --test-dir "$build_dir" \
+    --output-on-failure \
+    --output-junit "$output_path" \
+    -R '^Packet\+\+Test$'
+  exit $?
+fi
+
+build_log="$build_dir/new-build.log"
+"$cmake_bin" --build "$build_dir" --target SnapLayerTest --parallel 2 >"$build_log" 2>&1
+build_status=$?
+if [[ $build_status -ne 0 ]]; then
+  python3 Tests/SnapLayerTest/ptf_to_junit.py \
+    "$build_log" "$output_path" "$build_status" "${new_test_args[@]}"
+  exit $?
+fi
+
+"$ctest_bin" --test-dir "$build_dir" \
+  --output-on-failure \
+  --output-junit "$output_path" \
+  -R '^SnapLayer\.'
