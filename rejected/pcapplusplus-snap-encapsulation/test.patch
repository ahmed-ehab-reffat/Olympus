@@ -0,0 +1,437 @@
+#include "ArpLayer.h"
+#include "EndianPortable.h"
+#include "EthDot3Layer.h"
+#include "EthLayer.h"
+#include "IPv4Layer.h"
+#include "IPv6Layer.h"
+#include "LLCLayer.h"
+#include "MplsLayer.h"
+#include "Packet.h"
+#include "PPPoELayer.h"
+#include "PayloadLayer.h"
+#include "RawPacket.h"
+#include "SnapLayer.h"
+#include "StpLayer.h"
+#include "VlanLayer.h"
+#include "WakeOnLanLayer.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <functional>
+#include <iostream>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace
+{
+	using Bytes = std::vector<uint8_t>;
+
+	void require(bool condition, const std::string& message)
+	{
+		if (!condition)
+			throw std::runtime_error(message);
+	}
+
+	struct ParsedPacket
+	{
+		Bytes bytes;
+		std::unique_ptr<pcpp::RawPacket> rawPacket;
+		std::unique_ptr<pcpp::Packet> packet;
+
+		ParsedPacket(Bytes packetBytes, pcpp::LinkLayerType linkType) : bytes(std::move(packetBytes))
+		{
+			timeval timestamp = {};
+			rawPacket.reset(new pcpp::RawPacket(bytes.data(), static_cast<int>(bytes.size()), timestamp, false, linkType));
+			packet.reset(new pcpp::Packet(rawPacket.get()));
+		}
+	};
+
+	std::unique_ptr<ParsedPacket> parse(Bytes bytes, pcpp::LinkLayerType linkType = pcpp::LINKTYPE_ETHERNET)
+	{
+		return std::unique_ptr<ParsedPacket>(new ParsedPacket(std::move(bytes), linkType));
+	}
+
+	Bytes makeEthernetDot3(const Bytes& body)
+	{
+		Bytes frame(14, 0);
+		for (size_t index = 0; index < 12; ++index)
+			frame[index] = static_cast<uint8_t>(index + 1);
+		uint16_t length = static_cast<uint16_t>(body.size());
+		frame[12] = static_cast<uint8_t>(length >> 8);
+		frame[13] = static_cast<uint8_t>(length);
+		frame.insert(frame.end(), body.begin(), body.end());
+		return frame;
+	}
+
+	Bytes makeLlcSnap(uint32_t oui, uint16_t protocolId, const Bytes& payload, uint8_t dsap = 0xaa,
+	                  uint8_t ssap = 0xaa, uint8_t control = 0x03)
+	{
+		Bytes body = { dsap,
+		               ssap,
+		               control,
+		               static_cast<uint8_t>(oui >> 16),
+		               static_cast<uint8_t>(oui >> 8),
+		               static_cast<uint8_t>(oui),
+		               static_cast<uint8_t>(protocolId >> 8),
+		               static_cast<uint8_t>(protocolId) };
+		body.insert(body.end(), payload.begin(), payload.end());
+		return body;
+	}
+
+	Bytes ipv4Payload()
+	{
+		Bytes bytes(20, 0);
+		bytes[0] = 0x45;
+		bytes[2] = 0;
+		bytes[3] = 20;
+		bytes[8] = 64;
+		return bytes;
+	}
+
+	Bytes ipv6Payload()
+	{
+		Bytes bytes(40, 0);
+		bytes[0] = 0x60;
+		return bytes;
+	}
+
+	void requirePayload(const pcpp::Layer* layer, const Bytes& expected)
+	{
+		require(layer != nullptr && layer->getProtocol() == pcpp::GenericPayload, "expected opaque payload");
+		auto payload = dynamic_cast<const pcpp::PayloadLayer*>(layer);
+		require(payload != nullptr && payload->getPayloadLen() == expected.size(), "unexpected payload size");
+		require(std::equal(expected.begin(), expected.end(), payload->getPayload()), "payload bytes changed");
+	}
+
+	void recognitionAndFields()
+	{
+		Bytes payload = ipv4Payload();
+		auto parsed = parse(makeEthernetDot3(makeLlcSnap(0, PCPP_ETHERTYPE_IP, payload)));
+		require(parsed->packet->isPacketOfType(pcpp::EthernetDot3), "802.3 layer missing");
+		require(parsed->packet->isPacketOfType(pcpp::LLC), "LLC layer missing");
+		require(parsed->packet->isPacketOfType(pcpp::SNAP), "SNAP layer missing");
+		require(parsed->packet->isPacketOfType(pcpp::IPv4), "IPv4 dispatch missing");
+
+		auto snap = parsed->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(snap != nullptr && snap->getProtocol() == pcpp::SNAP, "wrong SNAP protocol identity");
+		require(snap->getHeaderLen() == 5 && snap->getDataLen() == 25, "wrong SNAP layer size");
+		require(snap->getOui() == 0 && snap->getProtocolId() == PCPP_ETHERTYPE_IP, "wrong SNAP values");
+		auto header = snap->getSnapHeader();
+		require(header != nullptr && header->oui[0] == 0 && header->oui[1] == 0 && header->oui[2] == 0,
+		        "wrong OUI bytes");
+		require(snap->getData()[3] == 0x08 && snap->getData()[4] == 0x00, "protocol ID is not network order");
+		require(snap->getNextLayer() != nullptr && snap->getNextLayer()->getProtocol() == pcpp::IPv4,
+		        "wrong layer after SNAP");
+	}
+
+	void recognitionBoundaries()
+	{
+		Bytes payload = { 1, 2, 3, 4, 5, 6 };
+		for (size_t snapBytes = 0; snapBytes < 5; ++snapBytes)
+		{
+			Bytes body = { 0xaa, 0xaa, 0x03 };
+			body.insert(body.end(), payload.begin(), payload.begin() + snapBytes);
+			auto parsed = parse(makeEthernetDot3(body));
+			require(!parsed->packet->isPacketOfType(pcpp::SNAP), "truncated SNAP header was accepted");
+			auto llc = parsed->packet->getLayerOfType<pcpp::LLCLayer>();
+			require(llc != nullptr, "truncated input lost LLC");
+			if (snapBytes == 0)
+				require(llc->getNextLayer() == nullptr, "empty LLC payload produced a layer");
+			else
+				requirePayload(llc->getNextLayer(), Bytes(payload.begin(), payload.begin() + snapBytes));
+		}
+
+		for (const auto& signature : std::vector<Bytes>{ { 0xab, 0xaa, 0x03 }, { 0xaa, 0xab, 0x03 },
+		                                                  { 0xaa, 0xaa, 0x00 } })
+		{
+			Bytes body = signature;
+			body.insert(body.end(), { 0, 0, 0, 0x08, 0x00, 0x45 });
+			auto parsed = parse(makeEthernetDot3(body));
+			require(!parsed->packet->isPacketOfType(pcpp::SNAP), "near LLC signature was accepted");
+			auto llc = parsed->packet->getLayerOfType<pcpp::LLCLayer>();
+			requirePayload(llc->getNextLayer(), Bytes(body.begin() + 3, body.end()));
+		}
+
+		Bytes headerOnly = makeLlcSnap(0x010203, 0x4455, {});
+		auto parsed = parse(makeEthernetDot3(headerOnly));
+		auto snap = parsed->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(snap != nullptr && snap->getNextLayer() == nullptr, "header-only SNAP did not terminate cleanly");
+	}
+
+	void namespaceFallback()
+	{
+		Bytes payload = ipv4Payload();
+		auto vendor = parse(makeEthernetDot3(makeLlcSnap(0x000001, PCPP_ETHERTYPE_IP, payload)));
+		auto vendorSnap = vendor->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(vendorSnap != nullptr && vendorSnap->getOui() == 1, "vendor SNAP was not exposed");
+		require(!vendor->packet->isPacketOfType(pcpp::IPv4), "vendor protocol ID escaped its OUI namespace");
+		requirePayload(vendorSnap->getNextLayer(), payload);
+
+		Bytes unknownPayload = { 0xde, 0xad, 0xbe, 0xef, 0x17 };
+		auto unknown = parse(makeEthernetDot3(makeLlcSnap(0, 0x9999, unknownPayload)));
+		auto unknownSnap = unknown->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(unknownSnap != nullptr && unknownSnap->getProtocolId() == 0x9999, "unknown PID changed");
+		requirePayload(unknownSnap->getNextLayer(), unknownPayload);
+	}
+
+	void standardDispatch()
+	{
+		struct Case
+		{
+			uint16_t protocolId;
+			Bytes payload;
+			pcpp::ProtocolType expected;
+		};
+
+		Bytes arp(28, 0);
+		Bytes vlan(4, 0);
+		Bytes pppoeDiscovery = { 0x11, 0x09, 0, 0, 0, 0 };
+		Bytes pppoeSession = { 0x11, 0, 0, 1, 0, 2, 0, 0x21 };
+		Bytes mpls = { 0, 0, 1, 64 };
+		Bytes wakeOnLan(102, 0);
+		const std::vector<Case> cases = {
+			{ PCPP_ETHERTYPE_IP, ipv4Payload(), pcpp::IPv4 },
+			{ PCPP_ETHERTYPE_IPV6, ipv6Payload(), pcpp::IPv6 },
+			{ PCPP_ETHERTYPE_ARP, arp, pcpp::ARP },
+			{ PCPP_ETHERTYPE_VLAN, vlan, pcpp::VLAN },
+			{ PCPP_ETHERTYPE_IEEE_802_1AD, vlan, pcpp::VLAN },
+			{ PCPP_ETHERTYPE_PPPOED, pppoeDiscovery, pcpp::PPPoEDiscovery },
+			{ PCPP_ETHERTYPE_PPPOES, pppoeSession, pcpp::PPPoESession },
+			{ PCPP_ETHERTYPE_MPLS, mpls, pcpp::MPLS },
+			{ PCPP_ETHERTYPE_WAKE_ON_LAN, wakeOnLan, pcpp::WakeOnLan },
+		};
+
+		for (const auto& test : cases)
+		{
+			auto parsed = parse(makeEthernetDot3(makeLlcSnap(0, test.protocolId, test.payload)));
+			auto snap = parsed->packet->getLayerOfType<pcpp::SnapLayer>();
+			require(snap != nullptr, "standard SNAP layer missing");
+			require(snap->getNextLayer() != nullptr && snap->getNextLayer()->getProtocol() == test.expected,
+			        "standard protocol was not dispatched");
+		}
+	}
+
+	void innerFallback()
+	{
+		Bytes invalidIpv4 = { 0x45, 0, 0, 4 };
+		auto ip = parse(makeEthernetDot3(makeLlcSnap(0, PCPP_ETHERTYPE_IP, invalidIpv4)));
+		auto ipSnap = ip->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(ipSnap != nullptr, "invalid inner data removed SNAP");
+		requirePayload(ipSnap->getNextLayer(), invalidIpv4);
+
+		Bytes invalidArp = { 0, 1, 2, 3 };
+		auto arp = parse(makeEthernetDot3(makeLlcSnap(0, PCPP_ETHERTYPE_ARP, invalidArp)));
+		auto arpSnap = arp->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(arpSnap != nullptr, "invalid ARP data removed SNAP");
+		requirePayload(arpSnap->getNextLayer(), invalidArp);
+
+		Bytes invalidStp = { 0, 0, 2, 2 };
+		auto stp = parse(makeEthernetDot3(makeLlcSnap(0x00000c, 0x010b, invalidStp)));
+		auto stpSnap = stp->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(stpSnap != nullptr, "invalid Cisco inner data removed SNAP");
+		requirePayload(stpSnap->getNextLayer(), invalidStp);
+	}
+
+	void ciscoStpDispatch()
+	{
+		Bytes tcn = { 0, 0, 0, 0x80 };
+		auto tcnPacket = parse(makeEthernetDot3(makeLlcSnap(0x00000c, 0x010b, tcn)));
+		auto tcnSnap = tcnPacket->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(tcnSnap != nullptr && tcnSnap->getNextLayer() != nullptr &&
+		            tcnSnap->getNextLayer()->getProtocol() == pcpp::STP,
+		        "Cisco TCN was not sent to STP");
+		require(dynamic_cast<pcpp::StpTopologyChangeBPDULayer*>(tcnSnap->getNextLayer()) != nullptr,
+		        "wrong Cisco TCN subtype");
+
+		Bytes rapid(36, 0);
+		rapid[2] = 2;
+		rapid[3] = 2;
+		auto rapidPacket = parse(makeEthernetDot3(makeLlcSnap(0x00000c, 0x010b, rapid)));
+		auto rapidSnap = rapidPacket->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(rapidSnap != nullptr && dynamic_cast<pcpp::RapidStpLayer*>(rapidSnap->getNextLayer()) != nullptr,
+		        "Cisco rapid BPDU was not sent to RSTP");
+
+		for (const auto& identifier : std::vector<std::pair<uint32_t, uint16_t>>{ { 0x00000c, 0x010c },
+		                                                                                 { 0x00000d, 0x010b } })
+		{
+			auto parsed = parse(makeEthernetDot3(makeLlcSnap(identifier.first, identifier.second, tcn)));
+			auto snap = parsed->packet->getLayerOfType<pcpp::SnapLayer>();
+			require(snap != nullptr && !parsed->packet->isPacketOfType(pcpp::STP), "neighboring Cisco ID parsed as STP");
+			requirePayload(snap->getNextLayer(), tcn);
+		}
+	}
+
+	void constructionAndSetters()
+	{
+		pcpp::SnapLayer layer(0x12abcdef, 0x1234);
+		require(layer.getProtocol() == pcpp::SNAP && layer.getHeaderLen() == 5 && layer.getDataLen() == 5,
+		        "constructed layer shape is wrong");
+		require(layer.getOui() == 0xabcdef && layer.getProtocolId() == 0x1234, "constructed values are wrong");
+		const uint8_t expected[] = { 0xab, 0xcd, 0xef, 0x12, 0x34 };
+		require(std::equal(expected, expected + sizeof(expected), layer.getData()), "constructed wire bytes are wrong");
+
+		layer.setOui(0x00654321);
+		layer.setProtocolId(0xbeef);
+		const uint8_t changed[] = { 0x65, 0x43, 0x21, 0xbe, 0xef };
+		require(layer.getOui() == 0x654321 && layer.getProtocolId() == 0xbeef, "setter values are wrong");
+		require(std::equal(changed, changed + sizeof(changed), layer.getData()), "setter wire bytes are wrong");
+
+		uint8_t header[5] = {};
+		require(!pcpp::SnapLayer::isDataValid(nullptr, sizeof(header)), "null data was accepted");
+		require(!pcpp::SnapLayer::isDataValid(header, sizeof(header) - 1), "short data was accepted");
+		require(pcpp::SnapLayer::isDataValid(header, sizeof(header)), "complete header was rejected");
+	}
+
+	void requireComputed(std::unique_ptr<pcpp::Layer> nextLayer, uint32_t expectedOui, uint16_t expectedProtocolId)
+	{
+		pcpp::SnapLayer snap(0xffffff, 0xffff);
+		pcpp::Packet packet(512);
+		require(packet.addLayer(&snap), "could not attach SNAP for compute");
+		require(packet.addLayer(nextLayer.release(), true), "could not attach next layer for compute");
+		packet.computeCalculateFields();
+		require(snap.getOui() == expectedOui && snap.getProtocolId() == expectedProtocolId,
+		        "computeCalculateFields encoded the wrong identifier");
+	}
+
+	void computeFields()
+	{
+		requireComputed(std::unique_ptr<pcpp::Layer>(
+		                    new pcpp::IPv4Layer(pcpp::IPv4Address("192.0.2.1"), pcpp::IPv4Address("198.51.100.1"))),
+		                0, PCPP_ETHERTYPE_IP);
+		requireComputed(std::unique_ptr<pcpp::Layer>(
+		                    new pcpp::IPv6Layer(pcpp::IPv6Address("2001:db8::1"), pcpp::IPv6Address("2001:db8::2"))),
+		                0, PCPP_ETHERTYPE_IPV6);
+		requireComputed(std::unique_ptr<pcpp::Layer>(
+		                    new pcpp::ArpLayer(pcpp::ARP_REQUEST, pcpp::MacAddress("00:11:22:33:44:55"),
+		                                       pcpp::IPv4Address("192.0.2.1"), pcpp::MacAddress::Zero,
+		                                       pcpp::IPv4Address("192.0.2.2"))),
+		                0, PCPP_ETHERTYPE_ARP);
+		requireComputed(std::unique_ptr<pcpp::Layer>(new pcpp::VlanLayer(17, false, 0)), 0, PCPP_ETHERTYPE_VLAN);
+		requireComputed(std::unique_ptr<pcpp::Layer>(new pcpp::PPPoEDiscoveryLayer(
+		                    1, 1, pcpp::PPPoELayer::PPPOE_CODE_PADI, 0)),
+		                0, PCPP_ETHERTYPE_PPPOED);
+		Bytes sessionData = { 0x11, 0, 0, 1, 0, 2, 0, 0x21 };
+		auto sessionPacket = parse(makeEthernetDot3(makeLlcSnap(0, PCPP_ETHERTYPE_PPPOES, sessionData)));
+		auto sessionSnap = sessionPacket->packet->getLayerOfType<pcpp::SnapLayer>();
+		require(sessionSnap != nullptr && sessionSnap->getNextLayer() != nullptr &&
+		            sessionSnap->getNextLayer()->getProtocol() == pcpp::PPPoESession,
+		        "could not prepare parsed PPPoE session");
+		sessionSnap->setOui(0xffffff);
+		sessionSnap->setProtocolId(0xffff);
+		sessionSnap->computeCalculateFields();
+		require(sessionSnap->getOui() == 0 && sessionSnap->getProtocolId() == PCPP_ETHERTYPE_PPPOES,
+		        "computeCalculateFields did not restore PPPoE session identifier");
+		requireComputed(std::unique_ptr<pcpp::Layer>(new pcpp::MplsLayer(16, 64, 0, true)), 0,
+		                PCPP_ETHERTYPE_MPLS);
+		requireComputed(std::unique_ptr<pcpp::Layer>(
+		                    new pcpp::WakeOnLanLayer(pcpp::MacAddress("00:11:22:33:44:55"))),
+		                0, PCPP_ETHERTYPE_WAKE_ON_LAN);
+		requireComputed(std::unique_ptr<pcpp::Layer>(new pcpp::StpTopologyChangeBPDULayer()), 0x00000c, 0x010b);
+
+		const uint8_t byte = 0x42;
+		pcpp::SnapLayer snap(0x112233, 0x4455);
+		pcpp::PayloadLayer payload(&byte, 1);
+		pcpp::Packet packet(64);
+		require(packet.addLayer(&snap) && packet.addLayer(&payload), "could not attach unknown payload");
+		packet.computeCalculateFields();
+		require(snap.getOui() == 0x112233 && snap.getProtocolId() == 0x4455,
+		        "unknown next layer changed explicit SNAP values");
+	}
+
+	void predecessorsPaths()
+	{
+		Bytes body = makeLlcSnap(0, PCPP_ETHERTYPE_IP, ipv4Payload());
+
+		Bytes ethernet(18, 0);
+		ethernet[12] = 0x81;
+		ethernet[13] = 0x00;
+		uint16_t innerLength = static_cast<uint16_t>(body.size());
+		ethernet[16] = static_cast<uint8_t>(innerLength >> 8);
+		ethernet[17] = static_cast<uint8_t>(innerLength);
+		ethernet.insert(ethernet.end(), body.begin(), body.end());
+		auto vlan = parse(ethernet);
+		require(vlan->packet->isPacketOfType(pcpp::VLAN) && vlan->packet->isPacketOfType(pcpp::LLC) &&
+		            vlan->packet->isPacketOfType(pcpp::SNAP) && vlan->packet->isPacketOfType(pcpp::IPv4),
+		        "length-encoded VLAN did not reach SNAP");
+
+		Bytes sll2(20, 0);
+		sll2[0] = 0;
+		sll2[1] = 4;
+		sll2.insert(sll2.end(), body.begin(), body.end());
+		auto cooked = parse(sll2, pcpp::LINKTYPE_LINUX_SLL2);
+		require(cooked->packet->isPacketOfType(pcpp::SLL2) && cooked->packet->isPacketOfType(pcpp::LLC) &&
+		            cooked->packet->isPacketOfType(pcpp::SNAP) && cooked->packet->isPacketOfType(pcpp::IPv4),
+		        "SLL2 did not reach SNAP");
+	}
+
+	void attachedRoundTripAndCopy()
+	{
+		pcpp::EthDot3Layer ethernet(pcpp::MacAddress("00:11:22:33:44:55"),
+		                                pcpp::MacAddress("66:77:88:99:aa:bb"), 28);
+		pcpp::LLCLayer llc(0xaa, 0xaa, 0x03);
+		pcpp::SnapLayer snap(0xabcdef, 0x1234);
+		pcpp::IPv4Layer ipv4(pcpp::IPv4Address("192.0.2.1"), pcpp::IPv4Address("198.51.100.1"));
+		pcpp::Packet packet(128);
+		require(packet.addLayer(&ethernet) && packet.addLayer(&llc) && packet.addLayer(&snap) && packet.addLayer(&ipv4),
+		        "could not construct attached SNAP packet");
+		packet.computeCalculateFields();
+		require(snap.getOui() == 0 && snap.getProtocolId() == PCPP_ETHERTYPE_IP, "attached compute failed");
+		require(packet.getRawPacket()->getRawDataLen() == 42, "attached packet has wrong size");
+
+		pcpp::RawPacket reparsedRaw(*packet.getRawPacket());
+		pcpp::Packet reparsed(&reparsedRaw);
+		require(reparsed.isPacketOfType(pcpp::EthernetDot3) && reparsed.isPacketOfType(pcpp::LLC) &&
+		            reparsed.isPacketOfType(pcpp::SNAP) && reparsed.isPacketOfType(pcpp::IPv4),
+		        "serialized packet did not reparse through SNAP");
+		auto reparsedSnap = reparsed.getLayerOfType<pcpp::SnapLayer>();
+		require(reparsedSnap != nullptr && reparsedSnap->getData() == reparsed.getRawPacket()->getRawData() + 17,
+		        "reparsed SNAP has the wrong wire location");
+
+		pcpp::Packet copied(reparsed);
+		auto copiedSnap = copied.getLayerOfType<pcpp::SnapLayer>();
+		require(copiedSnap != nullptr && copiedSnap->getOui() == 0 && copiedSnap->getProtocolId() == PCPP_ETHERTYPE_IP,
+		        "packet copy lost SNAP fields");
+		copiedSnap->setOui(0x010203);
+		copiedSnap->setProtocolId(0x4455);
+		require(reparsedSnap->getOui() == 0 && reparsedSnap->getProtocolId() == PCPP_ETHERTYPE_IP,
+		        "editing a copied SNAP changed the original");
+	}
+}  // namespace
+
+int main(int argc, char* argv[])
+{
+	const std::unordered_map<std::string, std::function<void()>> scenarios = {
+		{ "RecognitionAndFields", recognitionAndFields },
+		{ "RecognitionBoundaries", recognitionBoundaries },
+		{ "NamespaceFallback", namespaceFallback },
+		{ "StandardDispatch", standardDispatch },
+		{ "InnerFallback", innerFallback },
+		{ "CiscoStpDispatch", ciscoStpDispatch },
+		{ "ConstructionAndSetters", constructionAndSetters },
+		{ "ComputeFields", computeFields },
+		{ "PredecessorPaths", predecessorsPaths },
+		{ "AttachedRoundTripAndCopy", attachedRoundTripAndCopy },
+	};
+
+	if (argc != 2 || scenarios.count(argv[1]) == 0)
+	{
+		std::cerr << "usage: " << argv[0] << " SCENARIO\n";
+		return 2;
+	}
+
+	try
+	{
+		scenarios.at(argv[1])();
+		std::cout << argv[1] << ": passed\n";
+		return 0;
+	}
+	catch (const std::exception& error)
+	{
+		std::cerr << argv[1] << ": " << error.what() << '\n';
+		return 1;
+	}
+}
