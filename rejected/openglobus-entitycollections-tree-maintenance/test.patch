+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --output_path=*)
+            OUTPUT_PATH="${1#--output_path=}"
+            shift
+            ;;
+        --output_path)
+            OUTPUT_PATH="$2"
+            shift 2
+            ;;
+        base|new)
+            MODE="$1"
+            shift
+            ;;
+        *)
+            shift
+            ;;
+    esac
+done
+
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/junit.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+rm -f "$OUTPUT_PATH"
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TESTS="tests/quadTree/EntityCollectionsTreeMaintenance.853b88.test.js"
+VITEST="./node_modules/.bin/vitest"
+RUNNER_LOG="$(mktemp)"
+
+if [ "$MODE" = "new" ]; then
+    "$VITEST" run "$NEW_TESTS" \
+        --reporter=junit --outputFile="$OUTPUT_PATH" >"$RUNNER_LOG" 2>&1
+else
+    "$VITEST" run \
+        --exclude '**/node_modules/**' \
+        --exclude '**/dist/**' \
+        --exclude '**/EntityCollectionsTreeMaintenance.*' \
+        --reporter=junit --outputFile="$OUTPUT_PATH" >"$RUNNER_LOG" 2>&1
+fi
+EXIT_CODE=$?
+
+cat "$RUNNER_LOG"
+
+if [ -f "$OUTPUT_PATH" ]; then
+    python3 - "$OUTPUT_PATH" <<'PYEOF'
+import re
+import sys
+
+path = sys.argv[1]
+with open(path, "r", encoding="utf-8", errors="replace") as f:
+    data = f.read()
+
+
+def scrub(match):
+    return match.group(1) + '="' + match.group(2).replace("::", ".") + '"'
+
+
+data = re.sub(r'\b(classname|name)="([^"]*)"', scrub, data)
+with open(path, "w", encoding="utf-8") as f:
+    f.write(data)
+PYEOF
+fi
+
+if ! grep -q "<testcase" "$OUTPUT_PATH" 2>/dev/null; then
+    DETAIL=$(tail -c 3000 "$RUNNER_LOG" | tr -d '\000' | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g')
+    cat >"$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites name="vitest tests" tests="1" failures="1" errors="0" time="0">
+<testsuite name="test.sh" tests="1" failures="1" errors="0">
+<testcase name="vitest produced no results in ${MODE} mode" classname="test.sh">
+<failure message="vitest produced no results">${DETAIL}</failure>
+</testcase>
+</testsuite>
+</testsuites>
+XMLEOF
+    rm -f "$RUNNER_LOG"
+    exit 1
+fi
+
+rm -f "$RUNNER_LOG"
+exit $EXIT_CODE
diff --git a/tests/quadTree/EntityCollectionsTreeMaintenance.853b88.test.js b/tests/quadTree/EntityCollectionsTreeMaintenance.853b88.test.js
