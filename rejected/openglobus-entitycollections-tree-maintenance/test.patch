+import { Planet } from "../../src/scene/Planet";
+import { Vector } from "../../src/layer/Vector";
+import { Entity } from "../../src/entity/Entity";
+import { EquiQuadTreeStrategy } from "../../src/quadTree/equi/EquiQuadTreeStrategy";
+import * as mercator from "../../src/mercator";
+
+const NW = 0;
+const NE = 1;
+const SW = 2;
+const SE = 3;
+
+function stubRenderer() {
+    return {
+        handler: { isInitialized: () => false },
+        isInitialized: () => false,
+        requestRedraw: () => {},
+        assignPickingColor: () => {},
+        clearPickingColor: () => {},
+        events: { on: () => {}, off: () => {} }
+    };
+}
+
+function makeLayer(nodeCapacity, StrategyProto) {
+    const planet = new Planet(StrategyProto ? { quadTreeStrategyPrototype: StrategyProto } : {});
+    planet.renderer = stubRenderer();
+    const layer = new Vector("vector", { nodeCapacity, async: false });
+    planet.addLayer(layer);
+    return layer;
+}
+
+function ent(lon, lat, name) {
+    return new Entity({ name: name, lonlat: [lon, lat, 0], billboard: { size: [1, 1] } });
+}
+
+function poly(name) {
+    return new Entity({ name: name, polyline: { path3v: [], thickness: 1 } });
+}
+
+function grid(lons, lats) {
+    const res = [];
+    for (let i = 0; i < lons.length; i++) {
+        for (let j = 0; j < lats.length; j++) {
+            res.push(ent(lons[i], lats[j], "g" + i + "_" + j));
+        }
+    }
+    return res;
+}
+
+function cluster(n, lon, lat, name) {
+    const res = [];
+    for (let i = 0; i < n; i++) {
+        res.push(ent(lon + i * 0.0009765625, lat + i * 0.0009765625, name + i));
+    }
+    return res;
+}
+
+function strategy(layer) {
+    return layer.getEntityCollectionsTreeStrategy();
+}
+
+function roots(layer) {
+    return strategy(layer).getRootNodes();
+}
+
+function residents(node) {
+    const res = [];
+    if (node.entityCollection) {
+        const e = node.entityCollection.getEntities();
+        for (let i = 0; i < e.length; i++) {
+            res.push(e[i]);
+        }
+    }
+    for (let i = 0; i < node.deferredEntities.length; i++) {
+        res.push(node.deferredEntities[i]);
+    }
+    return res;
+}
+
+function allNodes(node, acc) {
+    const out = acc || [];
+    out.push(node);
+    for (let i = 0; i < node.childNodes.length; i++) {
+        allNodes(node.childNodes[i], out);
+    }
+    return out;
+}
+
+function held(node) {
+    let total = residents(node).length;
+    for (let i = 0; i < node.childNodes.length; i++) {
+        total += held(node.childNodes[i]);
+    }
+    return total;
+}
+
+function assertTreeInvariants(node, capacity) {
+    const nodes = allNodes(node);
+    for (let i = 0; i < nodes.length; i++) {
+        const n = nodes[i];
+        const own = residents(n);
+
+        if (own.length) {
+            expect(n.childNodes.length).toBe(0);
+        }
+        expect(own.length).toBeLessThanOrEqual(capacity);
+
+        for (let j = 0; j < own.length; j++) {
+            expect(n.isInside(own[j])).toBe(true);
+            expect(own[j]._nodePtr ? own[j]._nodePtr.nodeId : -1).toBe(n.nodeId);
+            expect(own[j]._nodePtr === n).toBe(true);
+        }
+
+        if (own.length === 0) {
+            expect(n.entityCollection).toBe(null);
+        }
+
+        expect(n.count).toBe(held(n));
+
+        if (n.count === 0) {
+            expect(n.childNodes.length).toBe(0);
+        }
+    }
+}
+
+function leafCount(node) {
+    let total = node.childNodes.length ? 0 : 1;
+    for (let i = 0; i < node.childNodes.length; i++) {
+        total += leafCount(node.childNodes[i]);
+    }
+    return total;
+}
+
+test("bulk_build_puts_every_entity_in_a_childless_node", () => {
+    const layer = makeLayer(4);
+    const entities = grid([-40, -20, 20, 40], [-40, -20, 20, 40]);
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    expect(merc.count).toBe(16);
+    assertTreeInvariants(merc, 4);
+});
+
+test("an_insert_into_a_split_tree_descends_into_the_child", () => {
+    const layer = makeLayer(4);
+    layer.setEntities([
+        ent(20, 20, "a"),
+        ent(40, 40, "b"),
+        ent(-20, -20, "c"),
+        ent(-40, -40, "d"),
+        ent(-60, -60, "e")
+    ]);
+
+    const merc = roots(layer)[0];
+    expect(merc.childNodes.length).toBe(4);
+    expect(merc.childNodes[NE].childNodes.length).toBe(0);
+
+    const extra = ent(30, 30, "extra");
+    layer.add(extra);
+
+    expect(extra._nodePtr.nodeId).toBe(merc.childNodes[NE].nodeId);
+    expect(extra._nodePtr === merc.childNodes[NE]).toBe(true);
+    expect(residents(merc.childNodes[NE]).length).toBe(3);
+    expect(residents(merc).length).toBe(0);
+    expect(merc.entityCollection).toBe(null);
+    expect(merc.count).toBe(6);
+    assertTreeInvariants(merc, 4);
+});
+
+test("an_interior_node_holds_no_entities_of_its_own", () => {
+    const layer = makeLayer(2);
+    layer.setEntities(grid([-40, -20, 20, 40], [-40, -20, 20, 40]));
+    for (let i = 0; i < 12; i++) {
+        layer.add(ent(10 + i * 0.5, 10 + i * 0.5, "e" + i));
+    }
+
+    const merc = roots(layer)[0];
+    const nodes = allNodes(merc);
+    for (let i = 0; i < nodes.length; i++) {
+        if (nodes[i].childNodes.length) {
+            expect(nodes[i].entityCollection).toBe(null);
+            expect(nodes[i].deferredEntities.length).toBe(0);
+        }
+    }
+    assertTreeInvariants(merc, 2);
+});
+
+test("stays_a_leaf_at_capacity", () => {
+    const layer = makeLayer(4);
+    layer.setEntities([]);
+
+    const merc = roots(layer)[0];
+    for (let i = 0; i < 4; i++) {
+        layer.add(ent(10 + i, 10 + i, "e" + i));
+    }
+
+    expect(merc.childNodes.length).toBe(0);
+    expect(merc.count).toBe(4);
+    expect(residents(merc).length).toBe(4);
+});
+
+test("one_insert_past_capacity_splits_the_leaf", () => {
+    const layer = makeLayer(4);
+    layer.setEntities([]);
+
+    const merc = roots(layer)[0];
+    for (let i = 0; i < 4; i++) {
+        layer.add(ent(10 + i, 10 + i, "e" + i));
+    }
+    expect(merc.childNodes.length).toBe(0);
+
+    layer.add(ent(-30, -30, "last"));
+
+    expect(merc.childNodes.length).toBe(4);
+    expect(merc.count).toBe(5);
+    expect(merc.childNodes[NE].count).toBe(4);
+    expect(merc.childNodes[SW].count).toBe(1);
+    assertTreeInvariants(merc, 4);
+});
+
+test("a_clustered_run_splits_recursively", () => {
+    const layer = makeLayer(2);
+    layer.setEntities([]);
+
+    const entities = cluster(9, 10, 10, "c");
+    for (let i = 0; i < entities.length; i++) {
+        layer.add(entities[i]);
+    }
+
+    const merc = roots(layer)[0];
+    expect(merc.count).toBe(9);
+    expect(leafCount(merc)).toBeGreaterThan(4);
+    assertTreeInvariants(merc, 2);
+});
+
+test("capacity_holds_after_many_inserts", () => {
+    const layer = makeLayer(4);
+    layer.setEntities(grid([-100, -50, 50, 100], [-40, 40]));
+
+    const entities = cluster(60, 12, 12, "m");
+    for (let i = 0; i < entities.length; i++) {
+        layer.add(entities[i]);
+    }
+
+    const merc = roots(layer)[0];
+    expect(merc.count).toBe(68);
+    assertTreeInvariants(merc, 4);
+});
+
+test("entities_sharing_a_position_stay_in_one_leaf", () => {
+    const layer = makeLayer(2);
+    layer.setEntities([]);
+
+    const merc = roots(layer)[0];
+    for (let i = 0; i < 5; i++) {
+        layer.add(ent(25, 25, "same" + i));
+    }
+
+    expect(merc.childNodes.length).toBe(0);
+    expect(merc.count).toBe(5);
+    expect(residents(merc).length).toBe(5);
+});
+
+test("a_bulk_build_of_one_position_stays_in_one_leaf", () => {
+    const layer = makeLayer(2);
+    const entities = [];
+    for (let i = 0; i < 5; i++) {
+        entities.push(ent(-25, -25, "dup" + i));
+    }
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    expect(merc.childNodes.length).toBe(0);
+    expect(merc.count).toBe(5);
+    expect(residents(merc).length).toBe(5);
+
+    layer.removeEntity(entities[0]);
+    expect(merc.count).toBe(4);
+});
+
+test("counts_match_the_tree_after_a_bulk_build", () => {
+    const layer = makeLayer(3);
+    layer.setEntities(grid([-60, -20, 20, 60], [-60, -20, 20, 60]));
+
+    const merc = roots(layer)[0];
+    expect(merc.count).toBe(16);
+    expect(held(merc)).toBe(16);
+    assertTreeInvariants(merc, 3);
+});
+
+test("counts_match_the_tree_after_inserts", () => {
+    const layer = makeLayer(3);
+    layer.setEntities(grid([-60, -20], [-60, -20]));
+
+    const merc = roots(layer)[0];
+    for (let i = 0; i < 7; i++) {
+        layer.add(ent(30 + i, 30 + i, "n" + i));
+    }
+    expect(merc.count).toBe(11);
+    assertTreeInvariants(merc, 3);
+});
+
+test("remove_from_an_unsplit_tree_updates_the_count", () => {
+    const layer = makeLayer(5);
+    const entities = [ent(10, 10, "a"), ent(20, 20, "b"), ent(30, 30, "c")];
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    expect(merc.count).toBe(3);
+    expect(merc.childNodes.length).toBe(0);
+
+    layer.removeEntity(entities[0]);
+
+    expect(merc.count).toBe(2);
+    expect(residents(merc).length).toBe(2);
+    expect(entities[0]._nodePtr).toBeFalsy();
+    assertTreeInvariants(merc, 5);
+});
+
+test("remove_from_a_split_tree_updates_every_ancestor", () => {
+    const layer = makeLayer(2);
+    const entities = cluster(8, 10, 10, "d");
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    const target = entities[3];
+    const chain = [];
+    let node = target._nodePtr;
+    while (node) {
+        chain.push({ node: node, before: node.count });
+        node = node.parentNode;
+    }
+    expect(chain.length).toBeGreaterThan(2);
+
+    layer.removeEntity(target);
+
+    for (let i = 0; i < chain.length; i++) {
+        if (chain[i].node.parentNode || chain[i].node === merc) {
+            expect(chain[i].node.count).toBe(chain[i].before - 1);
+        }
+    }
+    expect(merc.count).toBe(7);
+    assertTreeInvariants(merc, 2);
+});
+
+test("removing_every_entity_leaves_an_empty_tree", () => {
+    const layer = makeLayer(2);
+    const entities = grid([-60, -20, 20, 60], [-60, -20, 20, 60]);
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    for (let i = 0; i < entities.length; i++) {
+        layer.removeEntity(entities[i]);
+    }
+
+    expect(merc.count).toBe(0);
+    expect(merc.childNodes.length).toBe(0);
+    expect(merc.entityCollection).toBe(null);
+    assertTreeInvariants(merc, 2);
+});
+
+test("splitting_releases_the_parent_collection", () => {
+    const layer = makeLayer(2);
+    layer.setEntities([]);
+
+    const merc = roots(layer)[0];
+    layer.add(ent(10, 10, "a"));
+    layer.add(ent(20, 20, "b"));
+    const before = merc.entityCollection;
+    expect(before).not.toBe(null);
+
+    layer.add(ent(-10, -10, "c"));
+
+    expect(merc.entityCollection).toBe(null);
+    expect(before.scene).toBeFalsy();
+    assertTreeInvariants(merc, 2);
+});
+
+test("emptying_a_leaf_releases_its_collection", () => {
+    const layer = makeLayer(2);
+    const entities = grid([-60, 60], [-60, 60]);
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    const leaf = entities[0]._nodePtr;
+    expect(leaf.entityCollection).not.toBe(null);
+
+    layer.removeEntity(entities[0]);
+
+    expect(leaf.count).toBe(0);
+    expect(leaf.entityCollection).toBe(null);
+    assertTreeInvariants(merc, 2);
+});
+
+test("emptying_every_child_drops_them", () => {
+    const layer = makeLayer(2);
+    const entities = grid([-60, 60], [-60, 60]);
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    expect(merc.childNodes.length).toBe(4);
+
+    for (let i = 0; i < entities.length; i++) {
+        layer.removeEntity(entities[i]);
+    }
+
+    expect(merc.childNodes.length).toBe(0);
+    expect(merc.count).toBe(0);
+});
+
+test("a_collapsed_node_accepts_entities_again", () => {
+    const layer = makeLayer(2);
+    const entities = grid([-60, 60], [-60, 60]);
+    layer.setEntities(entities);
+
+    const merc = roots(layer)[0];
+    for (let i = 0; i < entities.length; i++) {
+        layer.removeEntity(entities[i]);
+    }
+    expect(merc.childNodes.length).toBe(0);
+
+    const back = ent(15, 15, "back");
