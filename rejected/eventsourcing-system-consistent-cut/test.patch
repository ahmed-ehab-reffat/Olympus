+class Counter(Aggregate):
+    @dataclass(frozen=True)
+    class Incremented(Aggregate.Event):
+        label: str
+
+    def __init__(self, name: str) -> None:
+        self.name = name
+        self.labels: list[str] = []
+
+    @event(Incremented)
+    def increment(self, label: str) -> None:
+        self.labels.append(label)
+
+
+class Tally(Aggregate):
+    @staticmethod
+    def create_id(name: str) -> UUID:
+        return uuid5(NAMESPACE_URL, f"/tallies/{name}")
+
+    def __init__(self, name: str) -> None:
+        self.name = name
+        self.seen: list[str] = []
+
+    @dataclass(frozen=True)
+    class Seen(Aggregate.Event):
+        label: str
+
+    @event(Seen)
+    def see(self, label: str) -> None:
+        self.seen.append(label)
+
+
+class Note(Aggregate):
+    @dataclass(frozen=True)
+    class Created(Aggregate.Created):
+        label: str
+
+    def __init__(self, label: str) -> None:
+        self.label = label
+
+
+class Ball(Aggregate):
+    @dataclass(frozen=True)
+    class Created(Aggregate.Created):
+        label: str
+
+    def __init__(self, label: str) -> None:
+        self.label = label
+
+
+class Echo(Aggregate):
+    @dataclass(frozen=True)
+    class Created(Aggregate.Created):
+        label: str
+
+    def __init__(self, label: str) -> None:
+        self.label = label
+
+
+class Point(Aggregate):
+    @dataclass(frozen=True)
+    class Created(Aggregate.Created):
+        label: str
+
+    def __init__(self, label: str) -> None:
+        self.label = label
+
+
+class CounterApp(Application[UUID]):
+    def create_counter(self, name: str) -> UUID:
+        counter = Counter(name)
+        self.save(counter)
+        return counter.id
+
+    def increment(self, counter_id: UUID, label: str) -> None:
+        counter: Counter = self.repository.get(counter_id)
+        counter.increment(label)
+        self.save(counter)
+
+    def create_pair(self, first: str, second: str) -> tuple[UUID, UUID]:
+        a = Counter(first)
+        b = Counter(second)
+        self.save(a, b)
+        return a.id, b.id
+
+
+class Left(CounterApp):
+    pass
+
+
+class Right(CounterApp):
+    pass
+
+
+class TallyProcess(ProcessApplication[UUID]):
+    tally_name = "tally"
+
+    def tally(self) -> Tally:
+        try:
+            return self.repository.get(Tally.create_id(self.tally_name))
+        except AggregateNotFoundError:
+            return Tally(self.tally_name)
+
+
+class Merge(TallyProcess):
+    tally_name = "merge"
+
+    @singledispatchmethod
+    def policy(
+        self, domain_event: Any, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        pass
+
+    @policy.register
+    def _(
+        self, domain_event: Counter.Incremented, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        tally = self.tally()
+        tally.see(domain_event.label)
+        processing_event.collect_events(tally)
+
+
+class Relay(TallyProcess):
+    tally_name = "relay"
+
+    @singledispatchmethod
+    def policy(
+        self, domain_event: Any, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        pass
+
+    @policy.register
+    def _(
+        self, domain_event: Tally.Seen, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        tally = self.tally()
+        tally.see(domain_event.label)
+        processing_event.collect_events(tally)
+
+
+class Spawner(ProcessApplication[UUID]):
+    @singledispatchmethod
+    def policy(
+        self, domain_event: Any, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        pass
+
+    @policy.register
+    def _(
+        self, domain_event: Counter.Incremented, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        processing_event.collect_events(Note(domain_event.label))
+
+
+class Ping(ProcessApplication[UUID]):
+    def serve(self, label: str) -> UUID:
+        ball = Ball(label)
+        self.save(ball)
+        return ball.id
+
+    @singledispatchmethod
+    def policy(
+        self, domain_event: Any, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        pass
+
+    @policy.register
+    def _(
+        self, domain_event: Counter.Incremented, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        processing_event.collect_events(Ball(domain_event.label))
+
+    @policy.register
+    def _(
+        self, domain_event: Echo.Created, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        processing_event.collect_events(Point(domain_event.label))
+
+
+class Pong(ProcessApplication[UUID]):
+    @singledispatchmethod
+    def policy(
+        self, domain_event: Any, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        pass
+
+    @policy.register
+    def _(
+        self, domain_event: Ball.Created, processing_event: ProcessingEvent[UUID]
+    ) -> None:
+        processing_event.collect_events(Echo(domain_event.label))
+
+
+FAN_IN = System(pipes=[[Left, Merge], [Right, Merge]])
+CHAIN = System(pipes=[[Merge, Relay], [Left, Merge], [Right, Merge]])
+SPAWN = System(pipes=[[Left, Spawner]])
+LOOP = System(pipes=[[Ping, Pong, Ping], [Left, Ping]])
+
+
+def sqlite_env(directory: str, tag: str, names: list[str]) -> dict[str, str]:
+    env = {"PERSISTENCE_MODULE": "eventsourcing.sqlite"}
+    for name in names:
+        env[f"{name.upper()}_SQLITE_DBNAME"] = str(Path(directory) / f"{tag}-{name}.db")
+    return env
+
+
+def ids(app: Application[Any]) -> list[tuple[int, str, int, str, bytes]]:
+    return [
+        (n.id, str(n.originator_id), n.originator_version, n.topic, n.state)
+        for n in app.recorder.select_notifications(start=1, limit=1000)
+    ]
+
+
+class FanInHistory:
+    def build(
+        self,
+        env: EnvType | None = None,
+        runner_cls: type[Runner[Any]] = SingleThreadedRunner,
+    ) -> Any:
+        runner = runner_cls(FAN_IN, env=env)
+        left = runner.get(Left)
+        right = runner.get(Right)
+        merge = runner.get(Merge)
+        merge.follow("Left", left.notification_log)
+        merge.follow("Right", right.notification_log)
+        self.l_id = left.create_counter("l")
+        left.increment(self.l_id, "l1")
+        self.r_id = right.create_counter("r")
+        right.increment(self.r_id, "r1")
+        merge.pull_and_process("Left")
+        merge.pull_and_process("Right")
+        left.increment(self.l_id, "l2")
+        merge.pull_and_process("Left")
+        return runner
+
+
+class TestCutPositions(FanInHistory, TestCase):
+    def setUp(self) -> None:
+        self.runner = self.build()
+
+    def tearDown(self) -> None:
+        self.runner.stop()
+
+    def test_unbounded_cut_is_the_current_state(self) -> None:
+        cut = self.runner.cut()
+        self.assertEqual(cut.positions, {"Left": 3, "Right": 2, "Merge": 4})
+        self.assertEqual(cut.processed, {"Merge": {"Left": 3, "Right": 2}})
+
+    def test_follower_stops_at_first_step_beyond_a_leader_bound(self) -> None:
+        cut = self.runner.cut({"Left": 3, "Right": 1})
+        self.assertEqual(cut.positions, {"Left": 3, "Right": 1, "Merge": 2})
+        self.assertEqual(cut.processed, {"Merge": {"Left": 2, "Right": 1}})
+
+    def test_follower_keeps_steps_within_both_bounds(self) -> None:
+        cut = self.runner.cut({"Left": 2, "Right": 2})
+        self.assertEqual(cut.positions, {"Left": 2, "Right": 2, "Merge": 3})
+        self.assertEqual(cut.processed, {"Merge": {"Left": 2, "Right": 2}})
+
+    def test_step_that_recorded_nothing_still_bounds_the_follower(self) -> None:
+        cut = self.runner.cut({"Left": 0})
+        self.assertEqual(cut.positions, {"Left": 0, "Right": 2, "Merge": 0})
+        self.assertEqual(cut.processed, {"Merge": {"Left": 0, "Right": 0}})
+
+    def test_bound_on_follower_keeps_following_steps_that_recorded_nothing(
+        self,
+    ) -> None:
+        cut = self.runner.cut({"Merge": 2})
+        self.assertEqual(cut.positions, {"Left": 3, "Right": 2, "Merge": 2})
+        self.assertEqual(cut.processed, {"Merge": {"Left": 2, "Right": 1}})
+
+    def test_unknown_application_or_negative_bound_raises_value_error(self) -> None:
+        with self.assertRaises(ValueError):
+            self.runner.cut({"Nowhere": 1})
+        with self.assertRaises(ValueError):
+            self.runner.cut({"Left": -1})
+
