+class TestMultiEventSaves(TestCase):
+    def setUp(self) -> None:
+        self.runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(FAN_IN)
+        left = self.runner.get(Left)
+        merge = self.runner.get(Merge)
+        merge.follow("Left", left.notification_log)
+        merge.follow("Right", self.runner.get(Right).notification_log)
+        self.a_id, self.b_id = left.create_pair("a", "b")
+        left.increment(self.a_id, "a1")
+        merge.pull_and_process("Left")
+
+    def tearDown(self) -> None:
+        self.runner.stop()
+
+    def test_bound_inside_one_save_drops_the_whole_save(self) -> None:
+        cut = self.runner.cut({"Left": 1})
