+class TestCutFixedPoint(TestCase):
+    def test_chain_declared_downstream_first_settles_through_every_follower(
+        self,
+    ) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(CHAIN)
+        left = runner.get(Left)
+        right = runner.get(Right)
+        merge = runner.get(Merge)
+        relay = runner.get(Relay)
+        merge.follow("Left", left.notification_log)
+        merge.follow("Right", right.notification_log)
+        relay.follow("Merge", merge.notification_log)
+        l_id = left.create_counter("l")
+        left.increment(l_id, "l1")
+        r_id = right.create_counter("r")
+        right.increment(r_id, "r1")
+        merge.pull_and_process("Left")
+        merge.pull_and_process("Right")
+        left.increment(l_id, "l2")
+        merge.pull_and_process("Left")
+        relay.pull_and_process("Merge")
+
+        cut = runner.cut({"Left": 1})
+        self.assertEqual(cut.positions, {"Left": 1, "Right": 2, "Merge": 0, "Relay": 0})
+        self.assertEqual(
+            cut.processed,
+            {"Merge": {"Left": 1, "Right": 0}, "Relay": {"Merge": 0}},
+        )
+
+        cut = runner.cut({"Right": 1})
+        self.assertEqual(cut.positions, {"Left": 3, "Right": 1, "Merge": 2, "Relay": 2})
+        self.assertEqual(cut.get(Relay, Tally.create_id("relay")).seen, ["l1"])
+        runner.stop()
+
+    def test_loop_with_second_leader_settles_to_greatest_consistent_cut(self) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(LOOP)
+        left = runner.get(Left)
+        ping = runner.get(Ping)
+        pong = runner.get(Pong)
+        pong.follow("Ping", ping.notification_log)
+        ping.follow("Pong", pong.notification_log)
+        ping.follow("Left", left.notification_log)
+        ping.serve("s1")
+        pong.pull_and_process("Ping")
+        ping.pull_and_process("Pong")
+        c_id = left.create_counter("c")
+        left.increment(c_id, "k1")
+        ping.pull_and_process("Left")
+        pong.pull_and_process("Ping")
+        ping.pull_and_process("Pong")
+        pong.pull_and_process("Ping")
+
+        cut = runner.cut({"Left": 1})
+        self.assertEqual(cut.positions, {"Ping": 2, "Pong": 1, "Left": 1})
+        self.assertEqual(
+            cut.processed, {"Pong": {"Ping": 2}, "Ping": {"Pong": 1, "Left": 1}}
+        )
+
+        cut = runner.cut({"Pong": 1})
+        self.assertEqual(cut.positions, {"Ping": 3, "Pong": 1, "Left": 2})
+        self.assertEqual(
+            cut.processed, {"Pong": {"Ping": 2}, "Ping": {"Pong": 1, "Left": 2}}
+        )
+        runner.stop()
+
