+class TestForkOfLoop(TestCase):
+    def test_cuts_of_a_forked_loop_agree_with_the_original(self) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(LOOP)
+        left = runner.get(Left)
+        ping = runner.get(Ping)
+        pong = runner.get(Pong)
+        pong.follow("Ping", ping.notification_log)
+        ping.follow("Pong", pong.notification_log)
+        ping.follow("Left", left.notification_log)
+        ping.serve("s1")
+        pong.pull_and_process("Ping")
+        ping.pull_and_process("Pong")
+        c_id = left.create_counter("c")
+        left.increment(c_id, "k1")
+        ping.pull_and_process("Left")
+        pong.pull_and_process("Ping")
+        ping.pull_and_process("Pong")
+        pong.pull_and_process("Ping")
+        try:
+            fork = runner.cut({"Pong": 2}).fork()
+            try:
+                for bounds in ({}, {"Pong": 1}, {"Ping": 1}, {"Ping": 3}, {"Left": 1}):
+                    original = runner.cut({"Pong": 2, **bounds})
+                    forked = fork.cut(bounds)
+                    self.assertEqual(forked.positions, original.positions, bounds)
+                    self.assertEqual(forked.processed, original.processed, bounds)
+            finally:
+                fork.stop()
+        finally:
+            runner.stop()
