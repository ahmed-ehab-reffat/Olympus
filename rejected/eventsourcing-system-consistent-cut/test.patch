+class TestSQLite(FanInHistory, TestCase):
+    def setUp(self) -> None:
+        self.directory = tempfile.mkdtemp()
+        self.env = sqlite_env(self.directory, "source", ["Left", "Right", "Merge"])
+        self.build(self.env).stop()
+
+    def tearDown(self) -> None:
+        shutil.rmtree(self.directory, ignore_errors=True)
+
+    def test_cuts_survive_reopening_the_databases(self) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(FAN_IN, env=self.env)
+        try:
+            cut = runner.cut({"Left": 3, "Right": 1})
+            self.assertEqual(cut.positions, {"Left": 3, "Right": 1, "Merge": 2})
+            self.assertEqual(cut.processed, {"Merge": {"Left": 2, "Right": 1}})
+            cut = runner.cut({"Left": 0})
+            self.assertEqual(cut.positions, {"Left": 0, "Right": 2, "Merge": 0})
+            cut = runner.cut({"Merge": 2})
+            self.assertEqual(cut.processed, {"Merge": {"Left": 2, "Right": 1}})
+        finally:
+            runner.stop()
+
+    def test_reopened_runner_keeps_cutting_after_new_events(self) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(FAN_IN, env=self.env)
+        try:
+            left = runner.get(Left)
+            merge = runner.get(Merge)
+            merge.follow("Left", left.notification_log)
+            merge.follow("Right", runner.get(Right).notification_log)
+            left.increment(self.l_id, "l3")
+            merge.pull_and_process("Left")
+            cut = runner.cut({"Left": 3, "Right": 1})
+            self.assertEqual(cut.positions, {"Left": 3, "Right": 1, "Merge": 2})
+            self.assertEqual(cut.processed, {"Merge": {"Left": 2, "Right": 1}})
+            cut = runner.cut()
+            self.assertEqual(cut.positions, {"Left": 4, "Right": 2, "Merge": 5})
+            self.assertEqual(cut.processed, {"Merge": {"Left": 4, "Right": 2}})
+        finally:
+            runner.stop()
+
+    def test_fork_into_new_databases_and_refuse_used_ones(self) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(FAN_IN, env=self.env)
+        target = sqlite_env(self.directory, "fork", ["Left", "Right", "Merge"])
+        try:
+            cut = runner.cut({"Left": 3, "Right": 1})
+            cut.fork(target).stop()
+            fork: SingleThreadedRunner[UUID] = SingleThreadedRunner(FAN_IN, env=target)
+            try:
+                self.assertEqual(ids(fork.get(Merge)), ids(runner.get(Merge))[:2])
+                self.assertEqual(fork.cut().positions, cut.positions)
+                self.assertEqual(fork.cut({"Merge": 2}).processed, cut.processed)
+            finally:
+                fork.stop()
+            with self.assertRaises(ValueError):
+                cut.fork(self.env)
+        finally:
+            runner.stop()
+
