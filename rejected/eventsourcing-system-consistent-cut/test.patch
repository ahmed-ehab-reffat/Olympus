+    def test_fork_ignores_keyword_arguments_the_recorder_does_not_keep(self) -> None:
+        source = sqlite_env(self.directory, "kwargs", ["Left", "Right", "Merge"])
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(FAN_IN, env=source)
+        try:
+            left = runner.get(Left)
+            left.save(Counter("k"), unused=lambda: None)
+            target = sqlite_env(self.directory, "kwfork", ["Left", "Right", "Merge"])
+            fork = runner.cut().fork(target)
+            try:
+                self.assertEqual(ids(fork.get(Left)), ids(left))
+            finally:
+                fork.stop()
+        finally:
+            runner.stop()
+
+    def test_fork_refuses_target_where_one_application_has_events(self) -> None:
+        target = sqlite_env(self.directory, "used", ["Left", "Right", "Merge"])
+        used = Right(env=target)
+        used.create_counter("x")
+        used.close()
+        cut = self.runner.cut({"Left": 3, "Right": 1})
+        with self.assertRaises(ValueError):
+            cut.fork(target)
