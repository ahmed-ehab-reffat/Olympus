+class TestFork(FanInHistory, TestCase):
+    def setUp(self) -> None:
+        self.runner = self.build()
+
+    def tearDown(self) -> None:
+        self.runner.stop()
+
+    def test_fork_holds_the_cut_under_original_notification_ids(self) -> None:
+        fork = self.runner.cut({"Left": 3, "Right": 1}).fork()
+        try:
+            self.assertIsInstance(fork, SingleThreadedRunner)
+            self.assertTrue(fork.is_started)
+            self.assertEqual(ids(fork.get(Left)), ids(self.runner.get(Left)))
+            self.assertEqual(ids(fork.get(Right)), ids(self.runner.get(Right))[:1])
+            self.assertEqual(ids(fork.get(Merge)), ids(self.runner.get(Merge))[:2])
+            self.assertEqual(fork.get(Merge).recorder.max_tracking_id("Left"), 2)
+            self.assertEqual(fork.get(Merge).recorder.max_tracking_id("Right"), 1)
+        finally:
+            fork.stop()
+
+    def test_fork_continues_processing_from_the_processed_positions(self) -> None:
+        fork = self.runner.cut({"Left": 3, "Right": 1}).fork()
+        try:
+            fork.get(Right).increment(self.r_id, "r9")
+            fork.get(Left).increment(self.l_id, "l9")
+            tally: Tally = fork.get(Merge).repository.get(Tally.create_id("merge"))
+            self.assertEqual(tally.seen, ["l1", "r9", "l2", "l9"])
+        finally:
+            fork.stop()
+
+    def test_cuts_of_the_fork_agree_with_cuts_of_the_original(self) -> None:
+        fork = self.runner.cut({"Left": 3, "Right": 1}).fork()
+        try:
+            for bounds in ({}, {"Left": 0}, {"Merge": 0}, {"Merge": 2}, {"Left": 2}):
+                original = self.runner.cut({"Left": 3, "Right": 1, **bounds})
+                forked = fork.cut(bounds)
+                self.assertEqual(forked.positions, original.positions, bounds)
+                self.assertEqual(forked.processed, original.processed, bounds)
+        finally:
+            fork.stop()
+
+    def test_fork_copies_follower_events_instead_of_reprocessing(self) -> None:
+        runner: SingleThreadedRunner[UUID] = SingleThreadedRunner(SPAWN)
+        runner.start()
+        try:
+            left = runner.get(Left)
+            c_id = left.create_counter("c")
+            for label in ("a", "b", "c"):
+                left.increment(c_id, label)
+            fork = runner.cut({"Left": 3}).fork()
+            try:
+                self.assertEqual(ids(fork.get(Spawner)), ids(runner.get(Spawner))[:2])
+            finally:
+                fork.stop()
+        finally:
+            runner.stop()
+
