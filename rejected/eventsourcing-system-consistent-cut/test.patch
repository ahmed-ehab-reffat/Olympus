+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/junit-$MODE.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")"
+export PYTHONHASHSEED=0
+export PYTHONDONTWRITEBYTECODE=1
+
+NEW_TESTS="tests/system_tests/test_system_cut_fb30c2.py"
+LOG="$(mktemp)"
+
+if [ "$MODE" = "new" ]; then
+  python -m pytest "$NEW_TESTS" -p no:cacheprovider -o junit_family=xunit1 \
+    --junitxml="$OUTPUT_PATH" >"$LOG" 2>&1
+  STATUS=$?
+else
+  python -m pytest tests examples -p no:cacheprovider -o junit_family=xunit1 \
+    -k "not Postgres and not postgres and not umadb and not ConnectionPool and not MultiThreadedRunner and not test_concurrent_no_conflicts and not test_subscribe_concurrent_reading_and_writing" \
+    --ignore="$NEW_TESTS" \
+    --ignore=tests/persistence_tests/test_connection_pool.py \
+    --ignore=tests/docs_tests \
+    --ignore=tests/dcb_tests/test_dcb.py \
+    --ignore=tests/benchmark \
+    --ignore=examples/ftsprojection \
+    --junitxml="$OUTPUT_PATH" >"$LOG" 2>&1
+  STATUS=$?
+fi
+
+tail -n 40 "$LOG"
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q "<testcase" "$OUTPUT_PATH"; then
+  python - "$OUTPUT_PATH" "$LOG" <<'PY'
+import sys
+from xml.sax.saxutils import escape
+out, log = sys.argv[1], sys.argv[2]
+text = open(log, errors="replace").read()[-20000:]
+with open(out, "w") as f:
+    f.write('<?xml version="1.0" encoding="utf-8"?>\n')
+    f.write('<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0">\n')
+    f.write('<testcase classname="harness" name="pytest_run">')
+    f.write('<failure message="pytest produced no test results">%s</failure>' % escape(text))
+    f.write('</testcase></testsuite></testsuites>\n')
+PY
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -f "$LOG"
+exit "$STATUS"
