+#!/usr/bin/env bash
+
+mode=""
+output_path=""
+
+while (($# > 0)); do
+    case "$1" in
+        --output_path)
+            if (($# < 2)); then
+                echo "error: --output_path requires a path" >&2
+                exit 2
+            fi
+            output_path="$2"
+            shift 2
+            ;;
+        --output_path=*)
+            output_path="${1#--output_path=}"
+            shift
+            ;;
+        base|new)
+            mode="$1"
+            shift
+            ;;
+        *)
+            echo "unknown argument: $1" >&2
+            exit 2
+            ;;
+    esac
+done
+
+if [[ "$mode" != "base" && "$mode" != "new" ]]; then
+    echo "mode must be base or new" >&2
+    exit 2
+fi
+
+if [[ -z "$output_path" ]]; then
+    output_path="test-results.xml"
+fi
+
+cd "$(dirname "$0")"
+mkdir -p "$(dirname "$output_path")"
+rm -f "$output_path"
+
+new_test=packages/protoplugin-test/src/proto-source.8e6d1f.test.ts
+
+write_failure() {
+    local message="$1"
+    local log="$2"
+    {
+        printf '<?xml version="1.0" encoding="utf-8"?>\n<testsuites>\n'
+        printf '<testsuite name="build" tests="1" failures="1">\n'
+        printf '<testcase name="%s" classname="build">\n<failure message="%s"><![CDATA[\n' "$message" "$message"
+        printf '%s\n' "$log" | sed 's/]]>/]]]]><![CDATA[>/g'
+        printf ']]></failure>\n</testcase>\n</testsuite>\n</testsuites>\n'
+    } >"$output_path"
+}
+
+for workspace in protobuf protoplugin; do
+    rm -rf "packages/$workspace/dist"
+    if ! build_output=$(npm run build --workspace="@bufbuild/$workspace" 2>&1); then
+        echo "error: failed to build @bufbuild/$workspace" >&2
+        echo "$build_output" >&2
+        write_failure "build @bufbuild/$workspace" "$build_output"
+        exit 1
+    fi
+done
+
+if [[ "$mode" == "base" ]]; then
+    mapfile -t test_files < <(
+        find packages/protobuf-test packages/protoplugin-test -type f -name '*.test.ts' \
+            -not -path '*/node_modules/*' ! -path "$new_test" | sort
+    )
+else
+    test_files=("$new_test")
+fi
+
+if [[ ${#test_files[@]} -eq 0 ]]; then
+    echo "error: no test files found for mode '$mode'" >&2
+    exit 1
+fi
+
+npx tsx --test \
+    --test-reporter=spec \
+    --test-reporter-destination=stdout \
+    --test-reporter=junit \
+    --test-reporter-destination="$output_path" \
+    "${test_files[@]}"
+status=$?
+
+if [[ ! -s "$output_path" ]] || ! grep -q '<testcase' "$output_path"; then
+    write_failure "test runner produced no results" "exit status $status"
+    if [[ "$status" -eq 0 ]]; then
+        status=1
+    fi
+fi
+
+exit "$status"
