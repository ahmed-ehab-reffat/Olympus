+import { suite, test } from "node:test";
+import * as assert from "node:assert";
+import {
+  type AnyDesc,
+  type DescFile,
+  type Registry,
+  clone,
+  createFileRegistry,
+  fromBinary,
+  toJson,
+} from "@bufbuild/protobuf";
+import {
+  FileDescriptorProtoSchema,
+  FileDescriptorSetSchema,
+} from "@bufbuild/protobuf/wkt";
+import * as protoplugin from "@bufbuild/protoplugin";
+import { UpstreamProtobuf } from "upstream-protobuf";
+
+const { getComments } = protoplugin;
+const getProtoSource = (
+  protoplugin as unknown as {
+    getProtoSource: (file: DescFile, options?: { registry?: Registry }) => string;
+  }
+).getProtoSource;
+
+let upstream: UpstreamProtobuf | undefined;
+
+async function compileSet(files: Record<string, string>) {
+  upstream = upstream ?? new UpstreamProtobuf();
+  const bytes = await upstream.compileToDescriptorSet(files, {
+    includeImports: true,
+    retainOptions: true,
+    includeSourceInfo: true,
+  });
+  return createFileRegistry(fromBinary(FileDescriptorSetSchema, bytes));
+}
+
+function descriptorJson(file: DescFile, registry: Registry) {
+  const proto = clone(FileDescriptorProtoSchema, file.proto);
+  proto.sourceCodeInfo = undefined;
+  return toJson(FileDescriptorProtoSchema, proto, { registry });
+}
+
+async function roundTrip(
+  files: Record<string, string>,
+  name = "input.proto",
+  passRegistry = false,
+) {
+  const registry = await compileSet(files);
+  const file = registry.getFile(name);
+  assert.ok(file !== undefined);
+  const source = passRegistry
+    ? getProtoSource(file, { registry })
+    : getProtoSource(file);
+  const again = await compileSet({ ...files, [name]: source });
+  const printed = again.getFile(name);
+  assert.ok(printed !== undefined);
+  assert.deepStrictEqual(
+    descriptorJson(printed, again),
+    descriptorJson(file, registry),
+  );
+  return { file, printed, source };
+}
+
+function assertSameComments(a: AnyDesc, b: AnyDesc) {
+  if (a.kind === "file" || b.kind === "file") {
+    return;
+  }
+  const ca = getComments(a);
+  const cb = getComments(b);
+  assert.deepStrictEqual(
+    {
+      leading: cb.leading,
+      trailing: cb.trailing,
+      leadingDetached: cb.leadingDetached,
+    },
+    {
+      leading: ca.leading,
+      trailing: ca.trailing,
+      leadingDetached: ca.leadingDetached,
+    },
+    `comments of ${a.toString()}`,
+  );
+}
+
+const customOptions = `
+  syntax = "proto2";
+  package opt;
+  import "google/protobuf/descriptor.proto";
+  message Info {
+    optional string owner = 1;
+    repeated int32 tags = 2;
+    optional Info child = 3;
+  }
+  enum Level {
+    LEVEL_LOW = 0;
+    LEVEL_HIGH = 1;
+  }
+  extend google.protobuf.FileOptions {
+    optional string file_tag = 50001;
+  }
+  extend google.protobuf.MessageOptions {
+    optional Info info = 50002;
+    repeated string labels = 50003;
+  }
+  extend google.protobuf.FieldOptions {
+    optional Level level = 50004;
+    optional bytes raw = 50005;
+  }
+  extend google.protobuf.OneofOptions {
+    optional bool hot = 50006;
+  }
+  extend google.protobuf.EnumOptions {
+    optional int64 big = 50007;
+  }
+  extend google.protobuf.EnumValueOptions {
+    optional double weight = 50008;
+  }
+  extend google.protobuf.ServiceOptions {
+    optional string svc = 50009;
+  }
+  extend google.protobuf.MethodOptions {
+    optional Info rpc_info = 50010;
+  }
+`;
+
+void suite("getProtoSource()", () => {
+  void test("proto3 file with scalars, maps, oneofs and a service", async () => {
+    await roundTrip({
+      "input.proto": `
+        syntax = "proto3";
+        package shop.v1;
+        import "google/protobuf/timestamp.proto";
+        message Item {
+          string id = 1;
+          repeated int64 counts = 2;
+          map<string, Item> children = 3;
+          optional bool active = 4;
+          google.protobuf.Timestamp created = 5;
+          oneof choice {
+            string text = 6;
+            Kind kind = 7;
+          }
+          bytes data = 8 [json_name = "payload"];
+          enum Kind {
+            KIND_UNSPECIFIED = 0;
+            KIND_BOOK = 1;
+          }
+        }
+        service Store {
+          rpc Get(Item) returns (Item);
+          rpc Watch(stream Item) returns (stream Item);
+        }
+      `,
+    });
+  });
+
+  void test("proto2 groups, defaults, required fields and extensions", async () => {
+    await roundTrip({
+      "input.proto": `
+        syntax = "proto2";
+        package legacy;
+        message Msg {
+          required int32 id = 1;
+          optional string name = 2 [default = "anon"];
+          optional double ratio = 3 [default = -inf];
+          optional group Result = 4 {
+            optional string url = 5;
+          }
+          repeated group Entry = 6 {
+            required int32 key = 7;
+          }
+          extensions 100 to 199, 500 to max;
+        }
+        extend Msg {
+          optional group Note = 100 {
+            optional string text = 1;
+          }
+          repeated uint32 marks = 101 [packed = true];
+        }
+      `,
+    });
+  });
+
+  void test("editions 2023 delimited and legacy required fields", async () => {
+    await roundTrip({
+      "input.proto": `
+        edition = "2023";
+        package ed;
+        option features.field_presence = IMPLICIT;
+        message Outer {
+          message Inner {
+            int32 a = 1;
+          }
+          Inner inner = 1 [features.message_encoding = DELIMITED];
+          int32 must = 2 [features.field_presence = LEGACY_REQUIRED];
+          repeated int32 list = 3 [features.repeated_field_encoding = EXPANDED];
+          string text = 4 [features.field_presence = EXPLICIT, default = "x"];
+        }
+      `,
+    });
+  });
+
+  void test("edition 2024 visibility, reserved identifiers and option imports", async () => {
+    await roundTrip(
+      {
+        "input.proto": `
+        edition = "2024";
+        package vis;
+        import option "google/protobuf/cpp_features.proto";
+        local message Hidden {
+          string name = 1 [features.(pb.cpp).string_type = VIEW];
+          reserved 4, 8 to max;
+          reserved old_name, other;
+        }
+        export enum Mode {
+          MODE_UNSPECIFIED = 0;
+          reserved 2 to 5, 9 to max;
+          reserved MODE_GONE;
+        }
+      `,
+      },
+      "input.proto",
+      true,
+    );
+  });
+
+  void test("custom options on every element kind", async () => {
+    await roundTrip(
+      {
+        "opt.proto": customOptions,
+        "input.proto": `
+          syntax = "proto3";
+          package uses;
+          import "opt.proto";
+          option (opt.file_tag) = "files";
+          message M {
+            option (opt.info) = { owner: "team" tags: 1 tags: 2 child { owner: "sub" } };
+            option (opt.labels) = "a";
+            option (opt.labels) = "b";
+            string f = 1 [(opt.level) = LEVEL_HIGH, (opt.raw) = "\\001\\377"];
+            oneof o {
+              option (opt.hot) = true;
+              int32 x = 2;
+            }
+          }
+          enum E {
+            option (opt.big) = -9007199254740993;
+            E_ZERO = 0 [(opt.weight) = 0.5];
+          }
+          service S {
+            option (opt.svc) = "svc";
+            rpc Call(M) returns (M) {
+              option (opt.rpc_info) = { owner: "rpc" };
+            }
+          }
+        `,
+      },
+      "input.proto",
+    );
+  });
+
+  void test("nested declarations keep their order around map fields", async () => {
+    await roundTrip({
+      "input.proto": `
+        syntax = "proto3";
+        package order;
+        message M {
+          message A {}
+          map<string, int32> counts = 1;
+          message B {}
+          map<int32, A> byId = 2;
+        }
+      `,
+    });
+  });
+
+  void test("type references resolve to the same type", async () => {
+    await roundTrip({
+      "input.proto": `
+        syntax = "proto3";
+        package a.b;
+        message Target {}
+        message Holder {
+          message a {
+            message b {
+              message Target {}
+            }
+          }
+          a.b.Target t = 1;
+          .a.b.Target u = 2;
+        }
+      `,
+    });
+  });
+
+  void test("string defaults with quotes and backslashes", async () => {
+    await roundTrip({
+      "input.proto": `
+        syntax = "proto2";
+        package d;
+        message M {
+          optional string s = 1 [default = "say \\"hi\\" and \\"bye\\" \\\\ ok"];
+          optional bytes b = 2 [default = "\\000\\x01z\\""];
+        }
+      `,
+    });
+  });
+
+  void test("comments stay on their elements", async () => {
+    const { file, printed } = await roundTrip({
+      "input.proto": `
+        syntax = "proto3";
+        package c;
+
+        // Detached comment.
+
+        // Leading comment for M.
+        message M { // Trailing comment for M.
+          // Leading comment for f.
+          string f = 1; // Trailing comment for f.
+          int32 g = 2;
+        }
+
+        // Leading comment for E.
+        enum E {
+          E_ZERO = 0; // Trailing comment for E_ZERO.
+        }
+      `,
+    });
+    assertSameComments(file.messages[0], printed.messages[0]);
+    assertSameComments(file.messages[0].fields[0], printed.messages[0].fields[0]);
+    assertSameComments(file.messages[0].fields[1], printed.messages[0].fields[1]);
+    assertSameComments(file.enums[0], printed.enums[0]);
+    assertSameComments(file.enums[0].values[0], printed.enums[0].values[0]);
+  });
+});
