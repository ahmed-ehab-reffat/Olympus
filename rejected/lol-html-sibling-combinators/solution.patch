+/// Instruction sets armed by already-seen elements for the elements that follow them
+/// inside the same parent.
+#[derive(Default)]
+pub(crate) struct SiblingScope {
+    adjacent: Vec<AddressRange>,
+    later: Vec<AddressRange>,
+}
+
+impl SiblingScope {
+    #[inline]
+    fn take_adjacent(&mut self) -> Vec<AddressRange> {
+        std::mem::take(&mut self.adjacent)
+    }
+
+    #[inline]
+    fn arm(&mut self, adjacent: &[AddressRange], later: &[AddressRange]) {
+        for r in adjacent {
+            if !self.adjacent.contains(r) {
+                self.adjacent.push(r.clone());
+            }
+        }
+
+        for r in later {
+            if !self.later.contains(r) {
+                self.later.push(r.clone());
+            }
+        }
+    }
+}
