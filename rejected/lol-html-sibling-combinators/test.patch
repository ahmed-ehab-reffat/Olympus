+        matched_ids(
+            "<i class=a></i><p id=one></p>",
+            ".a + :is(*)"
+        ),
+        ids(&["one"])
+    );
+}
+
+#[test]
+fn sibling_combinators_parse() {
+    assert_parses("div + p");
+    assert_parses("div ~ p");
+    assert_parses(".a + .b ~ .c > .d .e");
+}
+
+#[test]
+fn is_and_where_parse() {
+    assert_parses(":is(div, p)");
+    assert_parses(":where(div, p)");
+    assert_parses("div:is(.a, [b], :not(.c))");
+}
+
+#[test]
+fn combinators_inside_is_are_rejected() {
+    assert_parses(":is(div, p)");
+
+    for selector in [":is(div p)", ":is(div > p)", ":is(div + p)", ":is(div ~ p)"] {
+        assert_eq!(
+            selector_error(selector),
+            SelectorError::UnsupportedPseudoClassOrElement,
+            "`{selector}` should be rejected"
+        );
+    }
+}
+
+#[test]
+fn combinators_inside_where_are_rejected() {
+    assert_parses(":where(div, p)");
+
+    assert_eq!(
+        selector_error(":where(div > p)"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+    assert_eq!(
+        selector_error(":where(div + p)"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+}
+
+#[test]
+fn combinators_inside_a_negation_are_still_rejected() {
+    assert_parses(":not(.a) + p");
+
+    assert_eq!(
+        selector_error(":not(div + p)"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+    assert_eq!(
+        selector_error(":not(div ~ p)"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+}
+
+#[test]
+fn unsupported_relational_selectors_are_still_rejected() {
+    assert_parses("div:is(.a) ~ p");
+
+    assert_eq!(
+        selector_error(":has(div)"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+    assert_eq!(
+        selector_error(":last-child"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+    assert_eq!(
+        selector_error("div:empty"),
+        SelectorError::UnsupportedPseudoClassOrElement
+    );
+}
