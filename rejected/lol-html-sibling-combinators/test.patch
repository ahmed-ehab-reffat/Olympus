+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/root/.cargo/bin:$PATH"
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+NEW_TARGET="selector_relations_fc54ff"
+NEW_TESTS=$(grep -A1 '^#\[test\]' "tests/${NEW_TARGET}.rs" | grep -oP '^fn \K\w+')
+
+TEST_JSON="$(mktemp)"
+TEST_ERR="$(mktemp)"
+STATUS=0
+
+case "$MODE" in
+  base)
+    cargo test --features=_integration_test --lib --test integration_tests \
+      -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"
+    STATUS=$?
+    ;;
+  new)
+    cargo test --features=_integration_test --test "$NEW_TARGET" \
+      -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"
+    STATUS=$?
+    ;;
+esac
+
+cat "$TEST_ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2>/dev/null || true
+
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    sanitized=$( { cat "$TEST_ERR"; cat "$TEST_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+
+    if [ "$MODE" = "new" ]; then
+      cases=""
+      count=0
+      while IFS= read -r name; do
+        [ -z "$name" ] && continue
+        cases+="    <testcase name=\"${name}\" classname=\"\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+        count=$((count + 1))
+      done <<< "$NEW_TESTS"
+    else
+      cases="    <testcase name=\"compilation\" classname=\"cargo-test\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+      count=1
+    fi
+
+    cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="cargo-test" tests="${count}" failures="${count}" errors="0">
+${cases}  </testsuite>
+</testsuites>
+XMLEOF
+  fi
+fi
+
+exit $STATUS
