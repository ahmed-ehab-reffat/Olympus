+use lol_html::html_content::ContentType;
+use lol_html::errors::SelectorError;
+use lol_html::{RewriteStrSettings, Selector, element, rewrite_str};
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::str::FromStr;
+
+fn matched_ids(html: &str, selector: &str) -> Vec<String> {
+    let ids = Rc::new(RefCell::new(Vec::new()));
+    let collected = Rc::clone(&ids);
+
+    rewrite_str(
+        html,
+        RewriteStrSettings::new().append_element_content_handler(element!(selector, move |el| {
+            collected
+                .borrow_mut()
+                .push(el.get_attribute("id").unwrap_or_default());
+            Ok(())
+        })),
+    )
+    .unwrap();
+
+    Rc::try_unwrap(ids).unwrap().into_inner()
+}
+
+fn marked(html: &str, selector: &str) -> String {
+    rewrite_str(
+        html,
+        RewriteStrSettings::new().append_element_content_handler(element!(selector, |el| {
+            el.before("[", ContentType::Text);
+            el.after("]", ContentType::Text);
+            Ok(())
+        })),
+    )
+    .unwrap()
+}
+
+fn ids(list: &[&str]) -> Vec<String> {
+    list.iter().map(|s| (*s).to_string()).collect()
+}
+
+fn selector_error(selector: &str) -> SelectorError {
+    Selector::from_str(selector).unwrap_err()
+}
+
+fn assert_parses(selector: &str) {
+    assert!(
+        Selector::from_str(selector).is_ok(),
+        "selector `{selector}` should parse"
+    );
+}
+
+#[test]
+fn adjacent_matches_only_the_immediately_following_sibling() {
+    assert_eq!(
+        matched_ids(
+            "<i class=a></i><p id=one></p><p id=two></p>",
+            ".a + p"
+        ),
+        ids(&["one"])
+    );
+}
+
+#[test]
+fn adjacent_does_not_match_a_preceding_sibling() {
+    assert_eq!(
+        matched_ids("<p id=one></p><i class=a></i>", ".a + p"),
+        Vec::<String>::new()
+    );
+}
+
+#[test]
+fn adjacent_is_blocked_by_an_intervening_element() {
