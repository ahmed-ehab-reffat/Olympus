+use crate::*;
+
+
+fn assemble_files(files: &[(&str, &str)], root: &str) -> Option<Vec<u8>>
+{
+    let mut report = diagn::Report::new();
+    let mut fileserver = util::FileServerMock::new();
+
+    for (name, contents) in files
+    {
+        fileserver.add(name.to_string(), contents.to_string());
+    }
+
+    let opts = asm::AssemblyOptions::new();
+    let assembly = asm::assemble(&mut report, &opts, &mut fileserver, &[root]);
+
+    if report.has_errors()
+    {
+        return None;
+    }
+
+    assembly.output.map(|o| o.format_binary(&mut report))
+}
+
+
+fn assemble(src: &str) -> Option<Vec<u8>>
+{
+    assemble_files(&[("test", src)], "test")
+}
+
+
+fn hex(src: &str) -> String
+{
+    let bytes = assemble(src).expect("expected assembly to succeed");
+
+    bytes.iter()
+        .map(|b| format!("{:02x}", b))
+        .collect()
+}
+
+
+fn expect_hex(src: &str, expected: &str)
+{
+    assert_eq!(hex(src), expected);
+}
+
+
+fn expect_rejected(src: &str)
+{
+    assert!(
+        assemble("#d8 $whole(1.5)").is_some(),
+        "fractional values are not available");
+
+    assert!(
+        assemble(src).is_none(),
+        "expected the input to be rejected, but assembly succeeded");
+}
+
+
+fn single_precision(literal: &str) -> String
+{
+    hex(&format!(
+        "#d32 ($exponent({0}, 23) + 127)`8 @ $mantissa({0}, 23)",
+        literal))
+}
+
+
+#[test]
+fn single_precision_of_one_tenth_matches_reference_encoding()
+{
+    assert_eq!(single_precision("0.1"), "3dcccccd");
+}
+
+
+#[test]
+fn single_precision_of_three_halves_matches_reference_encoding()
+{
+    assert_eq!(single_precision("1.5"), "3fc00000");
+}
+
+
+#[test]
+fn single_precision_of_pi_matches_reference_encoding()
+{
+    assert_eq!(single_precision("3.14159265358979"), "40490fdb");
+}
+
+
+#[test]
+fn exponent_of_one_tenth_is_minus_four()
+{
+    expect_hex("#d8 $exponent(0.1, 23) + 127", "7b");
+}
+
+
+#[test]
+fn exponent_of_one_half_is_minus_one()
+{
+    expect_hex("#d8 $exponent(0.5, 23) + 127", "7e");
+}
+
+
+#[test]
+fn exponent_of_one_hundred_is_six()
+{
+    expect_hex("#d8 $exponent(100.0, 7) + 127", "85");
+}
+
+
+#[test]
+fn mantissa_beyond_double_precision_stays_exact()
+{
+    expect_hex("#d64 $mantissa(0.1, 60)", "099999999999999a");
+}
+
+
+#[test]
+fn mantissa_at_double_precision_width_stays_exact()
+{
+    expect_hex("#d64 $mantissa(0.3, 52)", "0003333333333333");
+}
+
+
+#[test]
+fn halfway_value_rounds_down_when_last_kept_bit_is_zero()
+{
+    expect_hex("#d8 $mantissa(1.25, 1)`4 @ ($exponent(1.25, 1) + 1)`4", "01");
+}
+
+
+#[test]
+fn halfway_value_rounds_up_when_last_kept_bit_is_one()
+{
+    expect_hex("#d8 $mantissa(1.75, 1)`4 @ ($exponent(1.75, 1) + 1)`4", "02");
+}
+
+
+#[test]
+fn rounding_that_reaches_two_carries_into_the_exponent()
+{
+    expect_hex("#d8 $mantissa(1.9999999999, 3)`4 @ ($exponent(1.9999999999, 3) + 1)`4", "02");
+}
+
+
+#[test]
+fn exact_power_of_two_has_zero_mantissa()
+{
+    expect_hex("#d8 $mantissa(2.0, 23)`4 @ ($exponent(2.0, 23) + 1)`4", "02");
+}
+
+
+#[test]
+fn value_just_below_a_power_of_two_keeps_its_exponent()
+{
+    expect_hex("#d16 $mantissa(255.5, 8)`8 @ ($exponent(255.5, 8))`8", "ff07");
+}
+
+
+#[test]
+fn zero_decomposes_to_zero_exponent_and_zero_mantissa()
+{
+    expect_hex("#d16 $mantissa(0.0, 8)`8 @ ($exponent(0.0, 8) + 1)`8", "0001");
+}
+
+
+#[test]
+fn negative_value_decomposes_on_its_magnitude()
+{
+    assert_eq!(single_precision("-1.5"), "3fc00000");
+    assert_eq!(single_precision("-0.1"), "3dcccccd");
+}
+
+
+#[test]
+fn whole_truncates_a_positive_value_toward_zero()
+{
+    expect_hex("#d8 $whole(5.75)", "05");
+}
+
+
+#[test]
+fn whole_truncates_a_negative_value_toward_zero()
+{
+    expect_hex("#d8 $whole(-1.5) + 2", "01");
+}
+
+
+#[test]
+fn whole_of_an_integer_valued_fraction_is_that_integer()
+{
+    expect_hex("#d8 $whole(7.0)", "07");
+}
+
+
+#[test]
+fn fract_keeps_only_the_part_below_one()
+{
+    expect_hex("#d8 $exponent($fract(5.75), 23) + 127", "7e");
+}
+
+
+#[test]
+fn fract_of_an_integer_valued_fraction_is_zero()
+{
+    expect_hex("#d16 $mantissa($fract(2.0), 8)`8 @ ($exponent($fract(2.0), 8) + 1)`8", "0001");
+}
+
+
+#[test]
+fn mantissa_carries_the_requested_width()
+{
+    expect_hex("#d $mantissa(1.5, 24)", "800000");
+}
+
+
+#[test]
+fn mantissa_of_zero_width_emits_nothing()
+{
+    expect_hex("#d8 0x12 @ $mantissa(1.5, 0)", "12");
+}
+
+
+#[test]
+fn exponent_has_no_definite_size()
+{
+    expect_rejected("#d $exponent(1.5, 23)");
+}
+
+
+#[test]
+fn whole_has_no_definite_size()
+{
+    expect_rejected("#d $whole(1.5)");
+}
+
+
+#[test]
+fn a_fractional_value_cannot_be_emitted_directly()
+{
+    expect_rejected("#d 1.5");
+}
+
+
+#[test]
+fn a_fractional_value_is_not_an_integer()
+{
+    expect_rejected("#d8 $whole(1.5) @ 1.5");
+}
+
+
+#[test]
+fn a_point_without_a_following_digit_is_not_a_fractional_literal()
+{
+    expect_rejected("#d8 $whole(1.)");
+}
+
+
+#[test]
+fn a_point_is_rejected_in_a_hexadecimal_literal()
+{
+    expect_rejected("#d8 $whole(0x1.8)");
+}
+
+
+#[test]
+fn underscores_are_allowed_on_both_sides_of_the_point()
+{
+    expect_hex("#d8 $whole(1_0.2_5)", "0a");
+    expect_hex("#d8 $whole(1_2_3.4_5_6), ($fract(1_2_3.4_5_6) == 0.456) ? 1 : 0", "7b01");
+}
+
+
+#[test]
+fn mantissa_requires_two_arguments()
+{
+    expect_rejected("#d8 $mantissa(1.5)");
+}
+
+
+#[test]
+fn exponent_requires_two_arguments()
+{
+    expect_rejected("#d8 $exponent(1.5)");
+}
+
+
+#[test]
+fn whole_requires_one_argument()
+{
+    expect_rejected("#d8 $whole(1.5, 2)");
+}
+
+
+#[test]
+fn decomposition_rejects_a_non_numeric_first_argument()
+{
+    expect_rejected("#d8 $mantissa(true, 4)");
+}
+
+
+#[test]
+fn an_integer_argument_decomposes_like_its_fractional_value()
+{
+    expect_hex("#d8 $mantissa(3, 2)`4 @ ($exponent(3, 2) + 1)`4", "22");
+}
+
+
+#[test]
+fn integer_division_still_truncates()
+{
+    expect_hex("#d16 $mantissa(7 / 2, 8) @ $mantissa(-7 / 2, 8)", "8080");
+}
+
+
+#[test]
+fn integer_literals_are_still_integers()
+{
+    expect_hex("#d8 $whole(3.9) + 4", "07");
+}
+
+
+#[test]
+fn a_point_without_a_leading_digit_is_not_a_fractional_literal()
+{
+    expect_rejected("#d8 $whole(.5)");
+}
+
+
+#[test]
+fn fract_of_a_mixed_value_keeps_its_exact_remainder()
+{
+    expect_hex("#d8 $mantissa($fract(5.75), 8)", "80");
+}
+
+
+#[test]
+fn whole_and_fract_accept_an_integer()
+{
+    expect_hex("#d16 $whole(7)`8 @ $mantissa($fract(7), 4)`4 @ ($exponent($fract(7), 4) + 1)`4", "0701");
+}
+
+
+#[test]
+fn mantissa_rejects_a_third_argument()
+{
+    expect_rejected("#d8 $mantissa(1.5, 8, 2)");
+}
+
+
+#[test]
+fn whole_requires_an_argument()
+{
+    expect_rejected("#d8 $whole()");
+}
+
+
+#[test]
+fn fract_requires_one_argument()
+{
+    expect_rejected("#d8 $fract(1.5, 2)");
+}
+
+
+#[test]
+fn fract_of_a_negative_value_keeps_its_sign()
+{
+    expect_hex("#d8 ($fract(-5.75) == -0.75) ? 1 : 0, ($fract(-5.75) != 0.75) ? 1 : 0", "0101");
+}
+
+
+#[test]
+fn equal_fractional_values_compare_equal_however_they_are_written()
+{
+    expect_hex("#d8 (0.50 == 0.5) ? 1 : 0, (1.25 == 1.2) ? 1 : 0, (0.50 != 0.5) ? 1 : 0, (1.25 != 1.2) ? 1 : 0", "01000001");
+}
+
+
+#[test]
+fn a_fractional_value_compares_equal_to_the_same_integer()
+{
+    expect_hex("#d8 (1.0 == 1) ? 1 : 0, (2 == 2.0) ? 1 : 0, ($fract(7.5) != 0) ? 1 : 0, ($fract(7) == 0) ? 1 : 0, (0.5 == 0) ? 1 : 0", "0101010100");
+}
+
+
+#[test]
+fn a_point_is_rejected_in_a_binary_literal()
+{
+    expect_rejected("#d8 $whole(0b1.1)");
+}
+
+
+#[test]
+fn a_point_is_rejected_in_an_octal_literal()
+{
+    expect_rejected("#d8 $whole(0o1.4)");
+}
+
+
+#[test]
+fn fract_requires_an_argument()
+{
+    expect_rejected("#d8 $fract()");
+}
+
+
+#[test]
+fn exponent_rejects_a_third_argument()
+{
+    expect_rejected("#d8 $exponent(1.5, 8, 2)");
+}
+
+
+#[test]
+fn a_fractional_value_and_the_same_integer_are_not_unequal()
+{
+    expect_hex("#d8 (1.0 != 1) ? 1 : 0, (1 != 1.0) ? 1 : 0, (1 != 1.5) ? 1 : 0, (2.5 != 2) ? 1 : 0", "00000101");
+}
+
+
+#[test]
+fn arithmetic_on_fractional_values_is_exact()
+{
+    expect_hex("#d8 $whole(1.5 * 2), (1.5 * 2 == 3) ? 1 : 0, (0.1 + 0.2 == 0.3) ? 1 : 0", "030101");
+}
+
+
+#[test]
+fn division_is_exact_once_either_side_is_fractional()
+{
+    expect_hex("#d8 (7 / 2 == 3) ? 1 : 0, (7 / 2.0 == 3.5) ? 1 : 0, (7.0 / 2 == 3.5) ? 1 : 0", "010101");
+}
+
+
+#[test]
+fn a_quotient_with_no_finite_decimal_form_stays_exact()
+{
+    expect_hex("#d8 ((1.0 / 3.0) * 3 == 1) ? 1 : 0, ((1.0 / 3.0) == (2.0 / 6.0)) ? 1 : 0", "0101");
+    assert_eq!(single_precision("1.0 / 3.0"), "3eaaaaab");
+}
+
+
+#[test]
+fn subtraction_carries_a_negative_result_through_decomposition()
+{
+    expect_hex("#d8 $whole(0.5 - 2.0), ($fract(0.5 - 2.0) == -0.5) ? 1 : 0", "ff01");
+}
+
+
+#[test]
+fn arithmetic_with_a_sized_integer_gives_an_unsized_fraction()
+{
+    expect_hex("#d8 $whole(0x10 + 0.5)", "10");
+    expect_rejected("#d 0x10 + 0.5");
+}
+
+
+#[test]
+fn dividing_by_zero_stays_an_error()
+{
+    expect_rejected("#d8 $whole(1.0 / 0.0)");
+    expect_rejected("#d8 $whole(1.0 / 0)");
+}
+
+
+#[test]
+fn a_remainder_of_a_fractional_value_is_rejected()
+{
+    expect_rejected("#d8 $whole(5.5 % 2)");
+}
+
+
+#[test]
+fn shifting_a_fractional_value_is_rejected()
+{
+    expect_rejected("#d8 $whole(1.5 << 1)");
+}
+
+
+#[test]
+fn a_bitwise_operator_rejects_a_fractional_operand()
+{
+    expect_rejected("#d8 $whole(1.5 & 1)");
+}
+
+
+#[test]
+fn an_ordering_comparison_rejects_a_fractional_operand()
+{
+    expect_rejected("#d8 (1.5 < 2.0) ? 1 : 0");
+}
+
+
+#[test]
+fn integer_arithmetic_keeps_producing_integers()
+{
+    expect_hex("#d8 3 + 4, 9 - 2, 3 * 3, 8 % 3, $mantissa(3 + 4, 3)`4 @ ($exponent(3 + 4, 3) + 1)`4", "0707090263");
+}
