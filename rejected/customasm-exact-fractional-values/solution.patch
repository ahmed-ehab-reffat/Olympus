+}
+
+pub fn eval_builtin_whole(
+    query: &mut expr::EvalFunctionQuery)
+    -> Result<expr::Value, ()>
+{
+    query.ensure_arg_number(1)?;
+
+    let value = query.args[0].value.expect_fractional(
+        query.report,
+        query.args[0].span)?;
+
+    Ok(expr::Value::make_integer(value.truncate_toward_zero())
+        .statically_known()
+        .derived_from(&query.args[0].value))
+}
+
+
+pub fn eval_builtin_fract(
+    query: &mut expr::EvalFunctionQuery)
+    -> Result<expr::Value, ()>
+{
+    query.ensure_arg_number(1)?;
+
+    let value = query.args[0].value.expect_fractional(
+        query.report,
+        query.args[0].span)?;
+
+    Ok(expr::Value::make_fractional(value.fraction_part())
+        .statically_known()
+        .derived_from(&query.args[0].value))
+}
+
+
+fn eval_decomposition(
+    query: &mut expr::EvalFunctionQuery)
+    -> Result<(i128, util::BigInt), ()>
+{
+    query.ensure_arg_number(2)?;
+
+    let value = query.args[0].value.expect_fractional(
+        query.report,
+        query.args[0].span)?;
+
+    let bits = query.args[1].value.expect_usize(
+        query.report,
+        query.args[1].span)?;
+
+    if bits as u64 >= util::BIGINT_MAX_BITS
+    {
+        query.report.error_span(
+            "value is outside the supported range",
+            query.args[1].span);
+
+        return Err(());
+    }
+
+    Ok(value.abs().decompose(bits))
+}
+
+
+pub fn eval_builtin_exponent(
+    query: &mut expr::EvalFunctionQuery)
+    -> Result<expr::Value, ()>
+{
+    let (exponent, _mantissa) = eval_decomposition(query)?;
+
+    Ok(expr::Value::make_integer(
+        util::BigInt::new(num_bigint::BigInt::from(exponent), None))
+        .statically_known()
+        .derived_from(&query.args[0].value)
+        .derived_from(&query.args[1].value))
+}
+
+
+pub fn eval_builtin_mantissa(
+    query: &mut expr::EvalFunctionQuery)
+    -> Result<expr::Value, ()>
+{
+    let (_exponent, mantissa) = eval_decomposition(query)?;
+
+    Ok(expr::Value::make_integer(mantissa)
+        .statically_known()
+        .derived_from(&query.args[0].value)
+        .derived_from(&query.args[1].value))
+}
