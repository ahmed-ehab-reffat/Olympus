diff --git a/src/util/bigfrac.rs b/src/util/bigfrac.rs
new file mode 100644
index 0000000..b2a77be
--- /dev/null
+++ b/src/util/bigfrac.rs
@@ -0,0 +1,370 @@
+use crate::*;
+
+use num_bigint::BigInt as RawInt;
+use num_bigint::Sign;
+
+
+#[derive(Clone, Debug)]
+pub struct BigFrac
+{
+    num: RawInt,
+    den: RawInt,
+}
+
+
+impl BigFrac
+{
+    pub fn new(num: RawInt, den: RawInt) -> Option<BigFrac>
+    {
+        if sign_of(&den) == Sign::NoSign
+        {
+            return None;
+        }
+
+        let mut frac = BigFrac {
+            num,
+            den,
+        };
+
+        frac.reduce();
+        Some(frac)
+    }
+
+
+    pub fn from_integer(value: &util::BigInt) -> BigFrac
+    {
+        BigFrac {
+            num: value.as_raw().clone(),
+            den: one(),
+        }
+    }
+
+
+    pub fn from_decimal_digits(
+        integer_digits: &RawInt,
+        fraction_digits: &RawInt,
+        fraction_len: usize,
+        negative: bool)
+        -> BigFrac
+    {
+        let scale = pow10(fraction_len);
+
+        let mut num = integer_digits * &scale + fraction_digits;
+        if negative
+        {
+            num = -num;
+        }
+
+        let mut frac = BigFrac {
+            num,
+            den: scale,
+        };
+
+        frac.reduce();
+        frac
+    }
+
+
+    fn reduce(&mut self)
+    {
+        if sign_of(&self.den) == Sign::Minus
+        {
+            self.num = -self.num.clone();
+            self.den = -self.den.clone();
+        }
+
+        let divisor = gcd(&self.num, &self.den);
+        if divisor > one()
+        {
+            self.num /= &divisor;
+            self.den /= &divisor;
+        }
+
+        if sign_of(&self.num) == Sign::NoSign
+        {
+            self.den = one();
+        }
+    }
+
+
+    pub fn is_zero(&self) -> bool
+    {
+        sign_of(&self.num) == Sign::NoSign
+    }
+
+
+    pub fn is_negative(&self) -> bool
+    {
+        sign_of(&self.num) == Sign::Minus
+    }
+
+
+    pub fn abs(&self) -> BigFrac
+    {
+        BigFrac {
+            num: abs_of(&self.num),
+            den: self.den.clone(),
+        }
+    }
+
+
+    pub fn negate(&self) -> BigFrac
+    {
+        BigFrac {
+            num: -self.num.clone(),
+            den: self.den.clone(),
+        }
+    }
+
+
+    pub fn truncate_toward_zero(&self) -> util::BigInt
+    {
+        util::BigInt::new(&self.num / &self.den, None)
+    }
+
+
+    pub fn fraction_part(&self) -> BigFrac
+    {
+        let whole = &self.num / &self.den;
+
+        BigFrac {
+            num: &self.num - whole * &self.den,
+            den: self.den.clone(),
+        }
+    }
+
+
+    pub fn add(&self, other: &BigFrac) -> BigFrac
+    {
+        BigFrac::new(
+            &self.num * &other.den + &other.num * &self.den,
+            &self.den * &other.den).unwrap()
+    }
+
+
+    pub fn subtract(&self, other: &BigFrac) -> BigFrac
+    {
+        BigFrac::new(
+            &self.num * &other.den - &other.num * &self.den,
+            &self.den * &other.den).unwrap()
+    }
+
+
+    pub fn multiply(&self, other: &BigFrac) -> BigFrac
+    {
+        BigFrac::new(
+            &self.num * &other.num,
+            &self.den * &other.den).unwrap()
+    }
+
+
+    pub fn divide(&self, other: &BigFrac) -> Option<BigFrac>
+    {
+        BigFrac::new(
+            &self.num * &other.den,
+            &self.den * &other.num)
+    }
+
+
+    pub fn binary_exponent(&self) -> Option<i128>
+    {
+        if sign_of(&self.num) == Sign::NoSign
+        {
+            return None;
+        }
+
+        let num = abs_of(&self.num);
+        let mut exp = num.bits() as i128 - self.den.bits() as i128;
+
+        while cmp_against_shifted_den(&num, &self.den, exp) == std::cmp::Ordering::Less
+        {
+            exp -= 1;
+        }
+
+        while cmp_against_shifted_den(&num, &self.den, exp + 1) != std::cmp::Ordering::Less
+        {
+            exp += 1;
+        }
+
+        Some(exp)
+    }
+
+
+    pub fn decompose(&self, bits: usize) -> (i128, util::BigInt)
+    {
+        let exp = match self.binary_exponent()
+        {
+            None => return (0, util::BigInt::new(zero(), Some(bits))),
+            Some(exp) => exp,
+        };
+
+        let num = abs_of(&self.num);
+
+        let (scaled_num, scaled_den) = shift_to_common(&num, &self.den, exp, bits);
+
+        let floor = &scaled_num / &scaled_den;
+        let remainder = &scaled_num - &floor * &scaled_den;
+
+        let unit = one() << bits;
+        let mut mantissa = &floor - &unit;
+
+        let twice_remainder = &remainder * RawInt::from(2);
+        let rounds_up = match twice_remainder.cmp(&scaled_den)
+        {
+            std::cmp::Ordering::Greater => true,
+            std::cmp::Ordering::Less => false,
+            std::cmp::Ordering::Equal => sign_of(&(&mantissa % RawInt::from(2))) != Sign::NoSign,
+        };
+
+        if rounds_up
+        {
+            mantissa += 1;
+        }
+
+        if mantissa >= unit
+        {
+            return (exp + 1, util::BigInt::new(zero(), Some(bits)));
+        }
+
+        (exp, util::BigInt::new(mantissa, Some(bits)))
+    }
+}
+
+
+fn pow10(exponent: usize) -> RawInt
+{
+    let mut result = one();
+    for _ in 0..exponent
+    {
+        result *= 10;
+    }
+
+    result
+}
+
+
+fn gcd(a: &RawInt, b: &RawInt) -> RawInt
+{
+    let mut a = abs_of(a);
+    let mut b = abs_of(b);
+
+    while sign_of(&b) != Sign::NoSign
+    {
+        let remainder = &a % &b;
+        a = b;
+        b = remainder;
+    }
+
+    a
+}
+
+
+fn cmp_against_shifted_den(
+    num: &RawInt,
+    den: &RawInt,
+    exponent: i128)
+    -> std::cmp::Ordering
+{
+    if exponent >= 0
+    {
+        num.cmp(&(den << exponent as usize))
+    }
+    else
+    {
+        (num << (-exponent) as usize).cmp(den)
+    }
+}
+
+
+fn shift_to_common(
+    num: &RawInt,
+    den: &RawInt,
+    exponent: i128,
+    bits: usize)
+    -> (RawInt, RawInt)
+{
+    let num = num << bits;
+
+    if exponent >= 0
+    {
+        (num, den << exponent as usize)
+    }
+    else
+    {
+        (num << (-exponent) as usize, den.clone())
+    }
+}
+
+
+impl std::cmp::PartialEq for BigFrac
+{
+    fn eq(&self, other: &BigFrac) -> bool
+    {
+        self.num == other.num && self.den == other.den
+    }
+}
+
+
+impl std::cmp::Eq for BigFrac {}
+
+
+impl std::cmp::PartialOrd for BigFrac
+{
+    fn partial_cmp(&self, other: &BigFrac) -> Option<std::cmp::Ordering>
+    {
+        Some(self.cmp(other))
+    }
+}
+
+
+impl std::cmp::Ord for BigFrac
+{
+    fn cmp(&self, other: &BigFrac) -> std::cmp::Ordering
+    {
+        (&self.num * &other.den).cmp(&(&other.num * &self.den))
+    }
+}
+
+
+impl std::fmt::Display for BigFrac
+{
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result
+    {
+        if self.den == one()
+        {
+            write!(f, "{}.0", self.num)
+        }
+        else
+        {
+            write!(f, "{}/{}", self.num, self.den)
+        }
+    }
+}
+
+
+fn zero() -> RawInt
+{
+    RawInt::from(0)
+}
+
+
+fn one() -> RawInt
+{
+    RawInt::from(1)
+}
+
+
+fn sign_of(value: &RawInt) -> Sign
+{
+    value.sign()
+}
+
+
+fn abs_of(value: &RawInt) -> RawInt
+{
+    match value.sign()
+    {
+        Sign::Minus => -value.clone(),
+        _ => value.clone(),
+    }
+}
