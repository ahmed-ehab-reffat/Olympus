+pub fn excerpt_has_fraction_point(excerpt: &str) -> bool
+{
+	excerpt.contains('.')
+}
+
+
+pub fn excerpt_as_bigfrac(
+	report: Option<&mut diagn::Report>,
+	span: diagn::Span,
+	excerpt: &str)
+	-> Result<util::BigFrac, ()>
+{
+	let chars: Vec<char> = excerpt.chars().collect();
+
+	let (radix, start) = parse_radix(&chars, 0);
+
+	let mut integer_digits = num_bigint::BigInt::from(0);
+	let mut fraction_digits = num_bigint::BigInt::from(0);
+	let mut fraction_len = 0;
+	let mut digit_num = 0;
+	let mut seen_point = false;
+	let mut valid = radix == 10;
+
+	let mut index = start;
+	while index < chars.len()
+	{
+		let c = chars[index];
+		index += 1;
+
+		if c == '_'
+			{ continue; }
+
+		if c == '.'
+		{
+			if seen_point
+				{ valid = false; }
+
+			seen_point = true;
+			continue;
+		}
+
+		let digit = match c.to_digit(10)
+		{
+			Some(digit) => digit,
+			None =>
+			{
+				valid = false;
+				break;
+			}
+		};
+
+		digit_num += 1;
+
+		if seen_point
+		{
+			fraction_digits = fraction_digits * 10 + digit;
+			fraction_len += 1;
+		}
+		else
+		{
+			integer_digits = integer_digits * 10 + digit;
+		}
+	}
+
+	if !valid || digit_num == 0 || !seen_point || fraction_len == 0
+	{
+		if let Some(report) = report
+		{
+			report.error_span(
+				"invalid value",
+				span);
+		}
+
+		return Err(());
+	}
+
+	Ok(util::BigFrac::from_decimal_digits(
+		&integer_digits,
+		&fraction_digits,
+		fraction_len,
+		false))
+}
+
+
 fn parse_radix(chars: &[char], index: usize) -> (usize, usize)
 {
 	if chars[index] == '0' && index + 1 < chars.len()
