index 0000000..9f9c086
--- /dev/null
+++ b/src/cm/reference_links.rs
@@ -0,0 +1,234 @@
+use std::collections::HashMap;
+
+use crate::nodes::{Node, NodeLink, NodeValue};
+use crate::parser::options::ReferenceLinkStyle;
+
+use super::is_autolink;
+
+#[derive(Debug, PartialEq, Eq, Hash, Clone)]
+pub(super) struct Target {
+    pub url: String,
+    pub title: String,
+}
+
+impl Target {
+    fn new(nl: &NodeLink) -> Self {
+        Target {
+            url: nl.url.clone(),
+            title: nl.title.clone(),
+        }
+    }
+}
+
+#[derive(Default)]
+pub(super) struct ReferenceLabels {
+    labels: HashMap<Target, String>,
+    order: Vec<(String, Target)>,
+    taken: HashMap<String, usize>,
+}
+
+impl ReferenceLabels {
+    pub(super) fn label_for(&self, nl: &NodeLink) -> Option<&str> {
+        self.labels.get(&Target::new(nl)).map(|s| s.as_str())
+    }
+
+    pub(super) fn collapses(&self, node: Node<'_>, label: &str) -> bool {
+        !contains_nested_reference(node) && fold_label(&node_text(node)) == fold_label(label)
+    }
+
+    pub(super) fn shortcuts(&self, node: Node<'_>, label: &str) -> bool {
+        self.collapses(node, label) && !next_sibling_is_bracketed(node)
+    }
+
+    pub(super) fn is_empty(&self) -> bool {
+        self.order.is_empty()
+    }
+
+    pub(super) fn definitions(&self) -> impl Iterator<Item = &(String, Target)> {
+        self.order.iter()
+    }
+
+    fn assign(&mut self, target: Target, desired: Option<String>) {
+        if self.labels.contains_key(&target) {
+            return;
+        }
+
+        let label = match desired {
+            Some(slug) if !slug.is_empty() => self.disambiguate(slug),
+            _ => self.next_free_number(),
+        };
+
+        self.order.push((label.clone(), target.clone()));
+        self.labels.insert(target, label);
+    }
+
+    fn next_free_number(&mut self) -> String {
+        let mut candidate = self.order.len() + 1;
+        loop {
+            let label = candidate.to_string();
+            let key = fold_label(&label);
+            if !self.taken.contains_key(&key) {
+                self.taken.insert(key, 1);
+                return label;
+            }
+            candidate += 1;
+        }
+    }
+
+    fn disambiguate(&mut self, slug: String) -> String {
+        let key = fold_label(&slug);
+        match self.taken.get(&key).copied() {
+            None => {
+                self.taken.insert(key, 1);
+                slug
+            }
+            Some(count) => {
+                let mut next = count + 1;
+                loop {
+                    let candidate = format!("{}-{}", slug, next);
+                    let candidate_key = fold_label(&candidate);
+                    if !self.taken.contains_key(&candidate_key) {
+                        self.taken.insert(candidate_key, 1);
+                        self.taken.insert(key, next);
+                        return candidate;
+                    }
+                    next += 1;
+                }
+            }
+        }
+    }
+}
+
+pub(super) fn fold_label(label: &str) -> String {
+    let mut folded = String::with_capacity(label.len());
+    let mut pending_space = false;
+    for c in label.chars() {
+        if c.is_whitespace() {
+            pending_space = !folded.is_empty();
+            continue;
+        }
+        if pending_space {
+            folded.push(' ');
+            pending_space = false;
+        }
+        for lowered in c.to_lowercase() {
+            folded.push(lowered);
+        }
+    }
+    folded
+}
+
+pub(super) fn slugify(text: &str) -> String {
+    let mut slug = String::with_capacity(text.len());
+    let mut pending_dash = false;
+    for c in text.chars() {
+        if c.is_alphanumeric() {
+            if pending_dash && !slug.is_empty() {
+                slug.push('-');
+            }
+            pending_dash = false;
+            for lowered in c.to_lowercase() {
+                slug.push(lowered);
+            }
+        } else {
+            pending_dash = true;
+        }
+    }
+    slug
+}
+
+fn node_text(node: Node<'_>) -> String {
+    let mut text = String::new();
+    collect_text(node, &mut text);
+    text
+}
+
+fn collect_text(node: Node<'_>, out: &mut String) {
+    for child in node.children() {
+        match child.data().value {
+            NodeValue::Text(ref literal) => out.push_str(literal),
+            NodeValue::Code(ref code) => out.push_str(&code.literal),
+            NodeValue::LineBreak | NodeValue::SoftBreak => out.push(' '),
+            _ => collect_text(child, out),
+        }
+    }
+}
+
+fn contains_nested_reference(node: Node<'_>) -> bool {
+    node.descendants().skip(1).any(|d| {
+        matches!(
+            d.data().value,
+            NodeValue::Link(..) | NodeValue::Image(..) | NodeValue::WikiLink(..)
+        )
+    })
+}
+
+fn next_sibling_is_bracketed(node: Node<'_>) -> bool {
+    match node.next_sibling() {
+        None => false,
+        Some(sibling) => match sibling.data().value {
+            NodeValue::Text(ref literal) => literal.starts_with('[') || literal.starts_with('('),
+            NodeValue::Link(..) | NodeValue::Image(..) => true,
+            _ => false,
+        },
+    }
+}
+
+fn link_participates(node: Node<'_>, nl: &NodeLink) -> bool {
+    !nl.url.is_empty() && !is_autolink(node, nl)
+}
+
+fn image_participates(nl: &NodeLink) -> bool {
+    !nl.url.is_empty()
+}
+
+pub(super) fn collect(root: Node<'_>, style: ReferenceLinkStyle) -> ReferenceLabels {
+    let mut labels = ReferenceLabels::default();
+
+    for node in root.descendants() {
+        let participating = match node.data().value {
+            NodeValue::Link(ref nl) => link_participates(node, nl).then(|| nl.clone()),
+            NodeValue::Image(ref nl) => image_participates(nl).then(|| nl.clone()),
+            _ => None,
+        };
+
+        if let Some(nl) = participating {
+            let desired = match style {
+                ReferenceLinkStyle::Numeric => None,
+                ReferenceLinkStyle::Text => Some(slugify(&node_text(node))),
+            };
+            labels.assign(Target::new(&nl), desired);
+        }
+    }
+
+    labels
+}
+
+pub(super) fn escape_destination(url: &str) -> String {
+    let mut out = String::with_capacity(url.len());
+    for c in url.chars() {
+        if c == '<' || c == '>' || c == '\\' {
+            out.push('\\');
+        }
+        out.push(c);
+    }
+    out
+}
+
+pub(super) fn needs_angle_brackets(url: &str) -> bool {
+    url.is_empty()
+        || url
+            .chars()
+            .any(|c| c.is_whitespace() || c.is_control() || c == '(' || c == ')')
+}
+
+pub(super) fn escape_title(title: &str) -> String {
+    let mut out = String::with_capacity(title.len());
+    for c in title.chars() {
+        if c == '"' || c == '\\' {
+            out.push('\\');
+        }
+        out.push(c);
+    }
+    out
+}
