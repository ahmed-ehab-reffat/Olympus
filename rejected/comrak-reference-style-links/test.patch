+#[test]
+fn cli_reference_links_flag_renders_reference_style() {
+    let output = Command::new(env!("CARGO_BIN_EXE_comrak"))
+        .args(["--to", "commonmark", "--reference-links"])
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .spawn()
