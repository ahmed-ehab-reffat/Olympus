+fn reference_links_number_targets_in_document_order() {
+    commonmark(
+        "[a](http://a.com) then [b](http://b.com)",
+        "[a][1] then [b][2]\n\n[1]: http://a.com\n[2]: http://b.com\n",
+        Some(&refs_options()),
+    );
+}
