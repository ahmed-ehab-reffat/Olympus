+            child
+                .stdin
+                .take()
+                .unwrap()
+                .write_all(b"[a](http://a.com) and [b](http://a.com)\n")?;
+            child.wait_with_output()
+        })
+        .unwrap();
+
+    assert_eq!(
+        String::from_utf8(output.stdout).unwrap(),
+        "[a][1] and [b][1]\n\n[1]: http://a.com\n"
+    );
+}
