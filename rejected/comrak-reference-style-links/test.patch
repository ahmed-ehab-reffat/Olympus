+use std::io::Write;
+use std::process::{Command, Stdio};
+
+use comrak::{Arena, Options, ReferenceLinkStyle, format_commonmark, markdown_to_html, parse_document};
+
+fn commonmark(input: &str, expected: &str, options: Option<&Options>) {
+    let default = Options::default();
+    let options = options.unwrap_or(&default);
+    let arena = Arena::new();
+    let root = parse_document(&arena, input, options);
+    let mut output = String::new();
+    format_commonmark(root, options, &mut output).unwrap();
+    assert_eq!(output, expected);
+}
+
+fn refs_options() -> Options<'static> {
+    let mut options = Options::default();
+    options.render.reference_links = true;
+    options
+}
+
+fn refs_options_width(width: usize) -> Options<'static> {
+    let mut options = refs_options();
+    options.render.width = width;
+    options
+}
+
+fn refs_options_text() -> Options<'static> {
+    let mut options = refs_options();
+    options.render.reference_link_style = ReferenceLinkStyle::Text;
+    options
+}
+
+fn refs_options_footnotes() -> Options<'static> {
+    let mut options = refs_options();
+    options.extension.footnotes = true;
+    options
+}
+
