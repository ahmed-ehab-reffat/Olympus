+            self.session.subscribe(self._pre_run_handler, Target.Event.PRE_RUN)
+            self.session.subscribe(self._pre_reset_handler, Target.Event.PRE_RESET)
+            self.session.subscribe(self._flush_handler, Target.Event.PRE_DISCONNECT)
+            self.session.subscribe(self._flush_memory_handler, Target.Event.PRE_FLASH_ERASE)
+            self.session.subscribe(self._flush_memory_handler, Target.Event.PRE_FLASH_PROGRAM)
+
+    def flush(self):
+        if self._enable_memory:
+            self._memcache.flush()
+        if self._enable_register:
+            self._regcache.flush()
+
