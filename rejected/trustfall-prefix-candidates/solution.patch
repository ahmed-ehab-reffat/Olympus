index 4bafcf8..a648c1c 100644
--- a/trustfall_core/src/interpreter/hints/candidates.rs
+++ b/trustfall_core/src/interpreter/hints/candidates.rs
@@ -4,6 +4,7 @@ use std::{
     borrow::{Borrow, Cow},
     fmt::Debug,
     ops::Bound,
+    sync::Arc,
 };
 
 use itertools::Itertools;
@@ -11,6 +12,51 @@ use serde::{Deserialize, Serialize};
 
 use crate::ir::FieldValue;
 
+pub(super) fn string_prefix_upper_bound(prefix: &str) -> Option<String> {
+    let mut chars: Vec<char> = prefix.chars().collect();
+    while let Some(last) = chars.pop() {
+        let mut next = last as u32 + 1;
+        if next == 0xD800 {
+            next = 0xE000;
+        }
+        if let Some(c) = char::from_u32(next) {
+            chars.push(c);
+            return Some(chars.into_iter().collect());
+        }
+    }
+    None
+}
+
+pub(super) fn prefix_candidate_owned(prefix: &str) -> CandidateValue<FieldValue> {
+    if prefix.is_empty() {
+        return CandidateValue::Range(Range::full_non_null());
+    }
+    let start = Bound::Included(FieldValue::String(Arc::from(prefix)));
+    match string_prefix_upper_bound(prefix) {
+        Some(upper) => CandidateValue::Range(Range::new(
+            start,
+            Bound::Excluded(FieldValue::String(Arc::from(upper.as_str()))),
+            false,
+        )),
+        None => CandidateValue::Range(Range::with_start(start, false)),
+    }
+}
+
+pub(super) fn prefix_candidate_cow<'b>(prefix: &str) -> CandidateValue<Cow<'b, FieldValue>> {
+    if prefix.is_empty() {
+        return CandidateValue::Range(Range::full_non_null());
+    }
+    let start = Bound::Included(Cow::Owned(FieldValue::String(Arc::from(prefix))));
+    match string_prefix_upper_bound(prefix) {
+        Some(upper) => CandidateValue::Range(Range::new(
+            start,
+            Bound::Excluded(Cow::Owned(FieldValue::String(Arc::from(upper.as_str())))),
+            false,
+        )),
+        None => CandidateValue::Range(Range::with_start(start, false)),
+    }
+}
+
 /// Candidate values for the value of a vertex property.
 #[non_exhaustive]
 #[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
