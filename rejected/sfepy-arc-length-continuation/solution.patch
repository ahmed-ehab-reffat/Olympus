diff --git a/sfepy/solvers/ts.py b/sfepy/solvers/ts.py
index 4b1f50ac..ab823efa 100644
--- a/sfepy/solvers/ts.py
+++ b/sfepy/solvers/ts.py
@@ -204,6 +204,30 @@ class VariableTimeStepper(TimeStepper):
 
         self.n_step = self.step + 1
 
+    def set_time(self, time):
+        """
+        Move the current step to `time` without advancing.
+        """
+        if self.step > 0:
+            self.dt = time - self.times[self.step - 1]
+
+        self.time = time
+        self.times[self.step] = time
+        self.normalize_time()
+
+    def advance_to(self, time):
+        """
+        Advance to a new step at `time`, which may lie before the current one.
+        """
+        self.dt = time - self.time
+        self.step += 1
+        self.time = time
+        self.normalize_time()
+
+        self.times.append(time)
+
+        self.n_step = self.step + 1
+
     def iter_from(self, step):
         self.set_step(step=step)
 
