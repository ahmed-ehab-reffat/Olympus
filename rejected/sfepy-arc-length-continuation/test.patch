+import sys
+
+import numpy as nm
+import pytest
+
+from sfepy.base.base import IndexedStruct
+from sfepy.base.conf import ProblemConf
+from sfepy.discrete import Problem
+from sfepy.discrete.fem import Mesh
+from sfepy.discrete.fem.meshio import UserMeshIO
+
+
+def cubic(x):
+    return x**3 - 3.0 * x
+
+
+def d_cubic(x):
+    return 3.0 * x**2 - 3.0
+
+
+def define(t0=0.0, t1=3.0, ds=0.05, psi=1.0, n_nod=11, **extra):
+
+    def mesh_hook(mesh, mode):
+        if mode == 'read':
+            coors = nm.linspace(0.0, 1.0, n_nod).reshape((n_nod, 1))
+            conn = nm.arange(n_nod, dtype=nm.int32).repeat(2)[1:-1]
+            conn = conn.reshape((-1, 2))
+            mat_ids = nm.zeros(n_nod - 1, dtype=nm.int32)
+            return Mesh.from_data('line', coors, None, [conn], [mat_ids],
+                                  ['1_2'])
+
+    def get_load(ts, coors, mode=None, **kwargs):
+        if mode == 'qp':
+            return {'val' : nm.full((coors.shape[0], 1, 1), ts.time)}
+
+    ts_conf = {'t0' : t0, 't1' : t1, 'ds' : ds, 'psi' : psi,
+               'verbose' : False}
+    ts_conf.update(extra)
+
+    conf = {
+        'filename_mesh' : UserMeshIO(mesh_hook),
+        'materials' : {
+            'eps' : ({'val' : 1e-2},),
+            'load' : 'get_load',
+        },
+        'functions' : {
+            'get_load' : (get_load,),
+        },
+        'regions' : {'Omega' : 'all'},
+        'fields' : {'temperature' : ('real', 1, 'Omega', 1)},
+        'variables' : {
+            'T' : ('unknown field', 'temperature', 0),
+            's' : ('test field', 'temperature', 'T'),
+        },
+        'integrals' : {'i' : 4},
+        'equations' : {
+            'eq' : """dw_laplace.i.Omega(eps.val, s, T)
+                    + dw_volume_nvf.i.Omega(cubic, d_cubic, s, T)
+                    - dw_volume_lvf.i.Omega(load.val, s) = 0""",
+        },
+        'solvers' : {
+            'ls' : ('ls.scipy_direct', {}),
+            'newton' : ('nls.newton', {'i_max' : 30, 'eps_a' : 1e-10,
+                                       'eps_r' : 1.0}),
+            'ts' : ('ts.arc_length', ts_conf),
+        },
+        'options' : {'ts' : 'ts', 'nls' : 'newton', 'ls' : 'ls'},
+        'cubic' : cubic,
+        'd_cubic' : d_cubic,
+    }
+    return conf
+
+
+def run(t0=0.0, t1=3.0, start=-nm.sqrt(3.0), **kwargs):
+    conf = ProblemConf.from_dict(define(t0=t0, t1=t1, **kwargs),
+                                 sys.modules[__name__])
+    pb = Problem.from_conf(conf)
+    pb.conf.options.output_dir = None
+    status = IndexedStruct()
+    points = []
+
+    def hook(pb, ts, variables):
+        points.append((ts.time, variables['T']().copy()))
+
+    n_nod = pb.domain.mesh.n_nod
+    variables = pb.solve(state0=nm.full(n_nod, start), status=status,
+                         save_results=False, step_hook=hook)
+    return status, points, variables['T']()
+
+
+def uniform_root(lam, near):
+    roots = nm.roots([1.0, 0.0, -3.0, -lam])
+    roots = roots[nm.abs(roots.imag) < 1e-12].real
+    return roots[nm.argmin(nm.abs(roots - near))]
+
+
+def test_solver_is_registered():
+    from sfepy.solvers import solver_table
+    from sfepy.solvers.ts_solvers import ArcLengthSolver
+
+    assert solver_table['ts.arc_length'] is ArcLengthSolver
+
+
+def test_path_completes_at_target_load_factor():
+    status, points, vals = run()
+
+    assert status.termination == 'completed'
+    assert status.path[-1].time == 3.0
+    assert nm.allclose(vals, uniform_root(3.0, 2.0), atol=1e-8)
+
+
+def test_path_passes_both_limit_points():
+    status, points, vals = run()
+
+    times = {rec.step : rec.time for rec in status.path}
+    lams = [times[step] for step in status.limit_points]
+    assert len(lams) == 2
+    assert abs(lams[0] - 2.0) < 0.02
+    assert abs(lams[1] + 2.0) < 0.02
+
+
+def test_path_turns_back_below_initial_load_factor():
+    status, points, vals = run()
+
+    last = status.limit_points[-1]
+    lams = nm.array([rec.time for rec in status.path[:last + 1]])
+    assert lams.max() < 2.0 + 1e-8
+    assert lams.min() < -1.98
+    assert lams.min() > -2.0 - 1e-8
+    assert status.path[last].time == lams.min()
+
+
+def test_every_path_point_is_in_equilibrium():
+    status, points, vals = run()
+
+    assert len(points) == len(status.path)
+    for (lam, vals), rec in zip(points, status.path):
+        assert lam == rec.time
+        assert nm.allclose(vals, vals.mean(), atol=1e-8)
+        assert abs(vals.mean()**3 - 3.0 * vals.mean() - lam) < 1e-6
+
+
+def test_steps_satisfy_arc_length_constraint():
+    status, points, vals = run(psi=0.5)
+
+    for ii in range(1, len(points) - 1):
+        dlam = points[ii][0] - points[ii - 1][0]
+        dvec = (points[ii][1] - points[ii - 1][1]).ravel()
+        arc = nm.sqrt(nm.dot(dvec, dvec) + 0.25 * dlam**2)
+        assert abs(arc - status.path[ii].ds) < 1e-8 * status.path[ii].ds
+
+
+def test_path_steps_are_numbered_consecutively():
+    status, points, vals = run()
+
+    assert [rec.step for rec in status.path] == list(range(len(status.path)))
+    assert status.path[0].time == 0.0
+    assert status.path[0].ds == 0.0
+
+
+def test_decreasing_target_follows_mirrored_path():
+    status, points, vals = run(t1=-3.0, start=nm.sqrt(3.0))
+
+    times = {rec.step : rec.time for rec in status.path}
+    lams = [times[step] for step in status.limit_points]
+    assert status.termination == 'completed'
+    assert status.path[-1].time == -3.0
+    assert abs(lams[0] + 2.0) < 0.02
+    assert abs(lams[1] - 2.0) < 0.02
+    assert nm.allclose(vals, uniform_root(-3.0, -2.0), atol=1e-8)
+
+
+def test_cylindrical_constraint_completes():
+    status, points, vals = run(psi=0.0)
+
+    assert status.termination == 'completed'
+    assert len(status.limit_points) == 2
+    assert nm.allclose(vals, uniform_root(3.0, 2.0), atol=1e-8)
+
+
+def test_max_steps_stops_the_path():
+    status, points, vals = run(max_steps=5)
+
+    assert status.termination == 'max_steps'
+    assert len(status.path) == 6
+    assert len(points) == 6
+
+
+def test_load_factor_range_stops_the_path():
+    status, points, vals = run(t_max=1.0)
+
+    assert status.termination == 'out_of_range'
+    assert all(rec.time <= 1.0 for rec in status.path)
+    assert nm.allclose(vals, points[-1][1])
+
+
+def test_failing_corrector_stops_at_step_floor():
+    status, points, vals = run(i_max=0, ds_min=0.01)
+
+    assert status.termination == 'step_floor'
+    assert len(status.path) == 1
+    assert nm.allclose(vals, -nm.sqrt(3.0), atol=1e-8)
+
+
+@pytest.mark.parametrize('kwargs', [{'ds' : 0.0}, {'ds' : -0.1},
+                                    {'t1' : 0.0}])
+def test_invalid_configuration_raises(kwargs):
+    with pytest.raises(ValueError):
+        run(**kwargs)
