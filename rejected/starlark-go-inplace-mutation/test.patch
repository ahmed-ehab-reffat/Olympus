+//go:build mutate_bc87cd
+
+package starlark_test
+
+import (
+	"testing"
+
+	"go.starlark.net/starlark"
+)
+
+func execMut(t *testing.T, src string) starlark.StringDict {
+	t.Helper()
+	thread := &starlark.Thread{Name: "mutate"}
+	g, err := starlark.ExecFile(thread, "mutate.star", src, nil)
+	if err != nil {
+		t.Fatalf("exec failed: %v\nsrc:\n%s", err, src)
+	}
+	return g
+}
+
+func wantVal(t *testing.T, g starlark.StringDict, name, want string) {
+	t.Helper()
+	v, ok := g[name]
+	if !ok {
+		t.Fatalf("global %q not found", name)
+	}
+	if got := v.String(); got != want {
+		t.Errorf("%s = %s, want %s", name, got, want)
+	}
+}
+
+func wantErr(t *testing.T, src string) {
+	t.Helper()
+	thread := &starlark.Thread{Name: "mutate"}
+	if _, err := starlark.ExecFile(thread, "mutate.star", src, nil); err == nil {
+		t.Fatalf("expected error, got nil\nsrc:\n%s", src)
+	}
+}
+
+func TestSliceAssignReplaceShorter(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\nx[1:3] = [9]\n")
+	wantVal(t, g, "x", "[1, 9, 4]")
+}
+
+func TestSliceAssignGrow(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\nx[1:3] = [9, 9, 9]\n")
+	wantVal(t, g, "x", "[1, 9, 9, 9, 4]")
+}
+
+func TestSliceAssignInsert(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\nx[1:1] = [9]\n")
+	wantVal(t, g, "x", "[1, 9, 2, 3, 4]")
+}
+
+func TestSliceAssignDelete(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\nx[1:3] = []\n")
+	wantVal(t, g, "x", "[1, 4]")
+}
+
+func TestSliceAssignReplaceAllFromRange(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\nx[:] = range(2)\n")
+	wantVal(t, g, "x", "[0, 1]")
+}
+
+func TestSliceAssignFromString(t *testing.T) {
+	g := execMut(t, `x = [1, 2, 3]`+"\n"+`x[:] = "ab"`+"\n")
+	wantVal(t, g, "x", `["a", "b"]`)
+}
+
+func TestSliceAssignNegativeBounds(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\nx[-2:] = [9]\n")
+	wantVal(t, g, "x", "[1, 2, 9]")
+}
+
+func TestSliceAssignExtendedStep(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\nx[::2] = [9, 8]\n")
+	wantVal(t, g, "x", "[9, 2, 8, 4]")
+}
+
+func TestSliceAssignExtendedReverse(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4, 5]\nx[::-1] = [10, 20, 30, 40, 50]\n")
+	wantVal(t, g, "x", "[50, 40, 30, 20, 10]")
+}
+
+func TestSliceAssignExtendedSizeMismatch(t *testing.T) {
+	wantErr(t, "x = [1, 2, 3, 4]\nx[::2] = [9]\n")
+}
+
+func TestSliceAssignTupleTargetRejected(t *testing.T) {
+	wantErr(t, "x = (1, 2, 3)\nx[0:1] = [9]\n")
+}
+
+func TestSliceAssignStringTargetRejected(t *testing.T) {
+	wantErr(t, `x = "abc"`+"\n"+`x[0:1] = ["z"]`+"\n")
+}
+
+func TestDelListIndex(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\ndel x[1]\n")
+	wantVal(t, g, "x", "[1, 3]")
+}
+
+func TestDelListIndexNegative(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\ndel x[-1]\n")
+	wantVal(t, g, "x", "[1, 2]")
+}
+
+func TestDelListSlice(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\ndel x[1:3]\n")
+	wantVal(t, g, "x", "[1, 4]")
+}
+
+func TestDelListSliceStep(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4]\ndel x[::2]\n")
+	wantVal(t, g, "x", "[2, 4]")
+}
+
+func TestDelDictKey(t *testing.T) {
+	g := execMut(t, "d = {1: 10, 2: 20}\ndel d[1]\n")
+	wantVal(t, g, "d", "{2: 20}")
+}
+
+func TestDelListIndexOutOfRange(t *testing.T) {
+	wantErr(t, "x = [1, 2, 3]\ndel x[5]\n")
+}
+
+func TestDelDictMissingKey(t *testing.T) {
+	wantErr(t, "d = {1: 10}\ndel d[9]\n")
+}
+
+func TestDelTupleRejected(t *testing.T) {
+	wantErr(t, "x = (1, 2, 3)\ndel x[0]\n")
+}
+
+func TestDelStringRejected(t *testing.T) {
+	wantErr(t, `x = "abc"`+"\n"+`del x[0]`+"\n")
+}
+
+func TestDelBareNameRejected(t *testing.T) {
+	wantErr(t, "x = [1, 2, 3]\ndel x\n")
+}
+
+func TestDelDictSliceRejected(t *testing.T) {
+	wantErr(t, "d = {1: 10, 2: 20}\ndel d[0:1]\n")
+}
+
+func TestDelMultipleTargets(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3, 4, 5]\ndel x[0], x[0]\n")
+	wantVal(t, g, "x", "[3, 4, 5]")
+}
+
+func TestListSort(t *testing.T) {
+	g := execMut(t, "x = [3, 1, 2]\nx.sort()\n")
+	wantVal(t, g, "x", "[1, 2, 3]")
+}
+
+func TestListSortReverse(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\nx.sort(reverse = True)\n")
+	wantVal(t, g, "x", "[3, 2, 1]")
+}
+
+func TestListSortKey(t *testing.T) {
+	g := execMut(t, `x = ["bb", "a", "ccc"]`+"\nx.sort(key = len)\n")
+	wantVal(t, g, "x", `["a", "bb", "ccc"]`)
+}
+
+func TestListSortStable(t *testing.T) {
+	g := execMut(t, "x = [[1, 'a'], [1, 'b'], [0, 'c']]\nx.sort(key = lambda p: p[0])\n")
+	wantVal(t, g, "x", `[[0, "c"], [1, "a"], [1, "b"]]`)
+}
+
+func TestListSortReturnsNone(t *testing.T) {
+	g := execMut(t, "x = [3, 1, 2]\nr = x.sort()\n")
+	wantVal(t, g, "r", "None")
+	wantVal(t, g, "x", "[1, 2, 3]")
+}
+
+func TestListReverse(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\nx.reverse()\n")
+	wantVal(t, g, "x", "[3, 2, 1]")
+}
+
+func TestListReverseReturnsNone(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\nr = x.reverse()\n")
+	wantVal(t, g, "r", "None")
+}
+
+func TestSliceAssignOutOfRangeClamps(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\nx[5:10] = [9]\n")
+	wantVal(t, g, "x", "[1, 2, 3, 9]")
+}
+
+func TestDelListSliceOutOfRangeNoop(t *testing.T) {
+	g := execMut(t, "x = [1, 2, 3]\ndel x[9:20]\n")
+	wantVal(t, g, "x", "[1, 2, 3]")
+}
