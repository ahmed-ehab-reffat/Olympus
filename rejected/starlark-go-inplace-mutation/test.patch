+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+NEW_RE='^(TestSliceAssign|TestDel|TestListSort|TestListReverse)'
+
+run() {
+  if [ "$MODE" = "new" ]; then
+    go test -v -count=1 -tags mutate_bc87cd -run "$NEW_RE" ./starlark/ 2>&1
+  else
+    go test -v -count=1 ./... 2>&1
+  fi
+}
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  OUT="$(run)"
+  STATUS=$?
+  printf '%s\n' "$OUT" | go-junit-report > "$OUTPUT_PATH" 2>/dev/null || true
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    esc=$(printf '%s' "$OUT" | tail -c 3000 | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
+    cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="starlark" tests="1" failures="1" errors="0">
+    <testcase name="build" classname="starlark"><failure message="build or test failure">${esc}</failure></testcase>
+  </testsuite>
+</testsuites>
+XMLEOF
+  fi
+  printf '%s\n' "$OUT"
+  exit $STATUS
+else
+  run
+fi
