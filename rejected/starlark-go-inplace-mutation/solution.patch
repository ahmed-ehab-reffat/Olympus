+// values of rhs. When step is 1 the list grows or shrinks to fit; for any
+// other step the number of rhs values must equal the number of selected
+// elements.
+func (l *List) SetSlice(lo, hi, step_ Value, rhs []Value) error {
+	if err := l.checkMutable("assign to slice of"); err != nil {
+		return err
+	}
+	start, end, step, err := sliceIndices(len(l.elems), lo, hi, step_)
+	if err != nil {
+		return err
+	}
