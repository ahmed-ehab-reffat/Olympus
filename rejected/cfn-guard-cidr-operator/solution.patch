+#[derive(Clone, Copy)]
+pub(crate) enum IpNetwork {
+    V4(u32),
+    V6(u128),
+}
+
+pub(crate) fn parse_address(text: &str) -> Option<IpNetwork> {
+    if let Ok(v4) = text.parse::<std::net::Ipv4Addr>() {
+        return Some(IpNetwork::V4(u32::from(v4)));
+    }
+    if let Ok(v6) = text.parse::<std::net::Ipv6Addr>() {
+        return Some(IpNetwork::V6(u128::from(v6)));
+    }
+    None
+}
+
+pub(crate) fn parse_cidr(text: &str) -> Option<(IpNetwork, u8)> {
+    match text.split_once('/') {
+        Some((address, prefix)) => {
+            let address = parse_address(address.trim())?;
+            let prefix = prefix.trim().parse::<u8>().ok()?;
+            let width = match address {
+                IpNetwork::V4(_) => 32,
+                IpNetwork::V6(_) => 128,
+            };
+            if prefix > width {
+                return None;
+            }
+            Some((address, prefix))
+        }
+        None => {
+            let address = parse_address(text.trim())?;
+            let prefix = match address {
+                IpNetwork::V4(_) => 32,
+                IpNetwork::V6(_) => 128,
+            };
+            Some((address, prefix))
+        }
+    }
+}
+
+fn v4_mask(prefix: u8) -> u32 {
+    if prefix == 0 {
+        0
+    } else {
+        u32::MAX << (32 - prefix)
+    }
+}
+
+fn v6_mask(prefix: u8) -> u128 {
+    if prefix == 0 {
+        0
+    } else {
+        u128::MAX << (128 - prefix)
+    }
+}
+
+fn cidr_overlaps(a: (IpNetwork, u8), b: (IpNetwork, u8)) -> bool {
+    let prefix = a.1.min(b.1);
+    match (a.0, b.0) {
+        (IpNetwork::V4(x), IpNetwork::V4(y)) => {
+            let mask = v4_mask(prefix);
+            (x & mask) == (y & mask)
+        }
+        (IpNetwork::V6(x), IpNetwork::V6(y)) => {
+            let mask = v6_mask(prefix);
+            (x & mask) == (y & mask)
+        }
+        _ => false,
+    }
+}
+
+fn cidr_contains(inner: (IpNetwork, u8), outer: (IpNetwork, u8)) -> bool {
+    if inner.1 < outer.1 {
+        return false;
+    }
+    match (inner.0, outer.0) {
+        (IpNetwork::V4(inner_addr), IpNetwork::V4(outer_addr)) => {
+            let mask = v4_mask(outer.1);
+            (inner_addr & mask) == (outer_addr & mask)
+        }
+        (IpNetwork::V6(inner_addr), IpNetwork::V6(outer_addr)) => {
+            let mask = v6_mask(outer.1);
+            (inner_addr & mask) == (outer_addr & mask)
+        }
+        _ => false,
+    }
+}
+
+fn compare_in_cidr(lhs: &PathAwareValue, rhs: &PathAwareValue) -> crate::rules::Result<bool> {
+    let (lhs_text, rhs_text) = match (lhs, rhs) {
+        (PathAwareValue::String((_, l)), PathAwareValue::String((_, r))) => (l, r),
+        _ => {
+            return Err(Error::NotComparable(
+                "in_cidr expects an IP or CIDR string on both sides".to_string(),
+            ))
+        }
+    };
+    let inner = parse_cidr(lhs_text).ok_or_else(|| {
+        Error::NotComparable(format!(
+            "left operand of in_cidr is not a valid IP or CIDR: {}",
+            lhs_text
+        ))
+    })?;
+    if !rhs_text.contains('/') {
+        return Err(Error::NotComparable(format!(
+            "right operand of in_cidr must be a CIDR block with a prefix length: {}",
+            rhs_text
+        )));
+    }
+    let outer = parse_cidr(rhs_text).ok_or_else(|| {
+        Error::NotComparable(format!(
+            "right operand of in_cidr is not a valid CIDR: {}",
+            rhs_text
+        ))
+    })?;
+    Ok(cidr_contains(inner, outer))
+}
+
+fn compare_cidr_overlaps(lhs: &PathAwareValue, rhs: &PathAwareValue) -> crate::rules::Result<bool> {
+    let (lhs_text, rhs_text) = match (lhs, rhs) {
+        (PathAwareValue::String((_, l)), PathAwareValue::String((_, r))) => (l, r),
+        _ => {
+            return Err(Error::NotComparable(
+                "cidr_overlaps expects an IP or CIDR string on both sides".to_string(),
+            ))
+        }
+    };
+    let left = parse_cidr(lhs_text).ok_or_else(|| {
+        Error::NotComparable(format!(
+            "left operand of cidr_overlaps is not a valid IP or CIDR: {}",
+            lhs_text
+        ))
+    })?;
+    let right = parse_cidr(rhs_text).ok_or_else(|| {
+        Error::NotComparable(format!(
+            "right operand of cidr_overlaps is not a valid IP or CIDR: {}",
+            rhs_text
+        ))
+    })?;
+    Ok(cidr_overlaps(left, right))
+}
+
+fn cidr_bounds(network: IpNetwork, prefix: u8) -> (u8, u128, u128) {
+    match network {
+        IpNetwork::V4(address) => {
+            let start = (address & v4_mask(prefix)) as u128;
+            let end = start + ((1u128 << (32 - prefix)) - 1);
+            (4, start, end)
+        }
+        IpNetwork::V6(address) => {
+            let start = address & v6_mask(prefix);
+            let end = if prefix == 0 {
+                u128::MAX
+            } else {
+                start + ((1u128 << (128 - prefix)) - 1)
+            };
+            (6, start, end)
+        }
+    }
+}
+
+fn range_covered(target: (u8, u128, u128), mut ranges: Vec<(u8, u128, u128)>) -> bool {
+    let (family, target_start, target_end) = target;
+    ranges.retain(|r| r.0 == family);
+    ranges.sort_by(|a, b| a.1.cmp(&b.1));
+    let mut reach = target_start;
+    let mut index = 0;
+    loop {
+        if reach > target_end {
+            return true;
+        }
+        let mut best_end: Option<u128> = None;
+        while index < ranges.len() && ranges[index].1 <= reach {
+            if ranges[index].2 >= reach {
+                best_end = Some(best_end.map_or(ranges[index].2, |e| e.max(ranges[index].2)));
+            }
+            index += 1;
+        }
+        match best_end {
+            Some(end) if end >= target_end => return true,
+            Some(end) => reach = end + 1,
+            None => return false,
+        }
+    }
+}
+
+struct CoveredByOperation {}
+
+impl Comparator for CoveredByOperation {
+    fn compare<'value>(
+        &self,
+        lhs: &[QueryResult],
+        rhs: &[QueryResult],
+    ) -> crate::rules::Result<EvalResult> {
+        let mut results = Vec::with_capacity(lhs.len());
+        let lhs_flattened = flattened(lhs, |ur| {
+            results.push(ValueEvalResult::LhsUnresolved(ur.clone()))
+        });
+        let rhs_flattened = flattened(rhs, |_| {});
+        let mut covering: Vec<(u8, u128, u128)> = Vec::with_capacity(rhs_flattened.len());
+        let mut rhs_invalid = false;
+        for each in &rhs_flattened {
+            match &**each {
+                PathAwareValue::String((_, text)) => match parse_cidr(text) {
+                    Some((network, prefix)) => covering.push(cidr_bounds(network, prefix)),
+                    None => rhs_invalid = true,
+                },
+                _ => rhs_invalid = true,
+            }
+        }
+        for each_lhs in lhs_flattened {
+            let bounds = match &*each_lhs {
+                PathAwareValue::String((_, text)) => parse_cidr(text).map(|(n, p)| cidr_bounds(n, p)),
+                _ => None,
+            };
+            match bounds {
+                Some(target) if !rhs_invalid => {
+                    if range_covered(target, covering.clone()) {
+                        results.push(success(Rc::clone(&each_lhs), Rc::clone(&each_lhs)));
+                    } else {
+                        results.push(fail(Rc::clone(&each_lhs), Rc::clone(&each_lhs)));
+                    }
+                }
+                _ => results.push(not_comparable(Rc::clone(&each_lhs), Rc::clone(&each_lhs))),
+            }
+        }
+        Ok(EvalResult::Result(results))
+    }
+}
