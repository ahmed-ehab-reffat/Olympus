diff --git a/guard/tests/cidr_operators_3ff9e6.rs b/guard/tests/cidr_operators_3ff9e6.rs
new file mode 100644
index 0000000..0567529
--- /dev/null
+++ b/guard/tests/cidr_operators_3ff9e6.rs
@@ -0,0 +1,269 @@
+#[cfg(test)]
+mod cidr_operator_tests {
+    use cfn_guard::{run_checks, ValidateInput};
+    use serde_json::Value;
+
+    fn evaluate(data: &str, rules: &str) -> Result<String, cfn_guard::Error> {
+        run_checks(
+            ValidateInput { content: data, file_name: "data.json" },
+            ValidateInput { content: rules, file_name: "rules.guard" },
+            false,
+        )
+    }
+
+    fn status(data: &str, rules: &str) -> String {
+        let output = evaluate(data, rules).expect("the rules should evaluate without an error");
+        let parsed: Value = serde_json::from_str(&output).expect("output should be valid json");
+        parsed["status"].as_str().expect("output should carry an overall status").to_string()
+    }
+
+    fn check(value: &str, clause: &str) -> String {
+        status(&format!("{{\"value\":\"{value}\"}}"), &format!("rule r {{ value {clause} }}\n"))
+    }
+
+    fn check_raw(value_json: &str, clause: &str) -> String {
+        status(&format!("{{\"value\":{value_json}}}"), &format!("rule r {{ value {clause} }}\n"))
+    }
+
+    #[test]
+    fn address_inside_range_is_contained() {
+        assert_eq!(check("10.1.2.3", "in_cidr \"10.0.0.0/8\""), "PASS");
+    }
+
+    #[test]
+    fn address_outside_range_is_not_contained() {
+        assert_eq!(check("11.0.0.1", "in_cidr \"10.0.0.0/8\""), "FAIL");
+    }
+
+    #[test]
+    fn a_zero_prefix_contains_every_address() {
+        assert_eq!(check("203.0.113.9", "in_cidr \"0.0.0.0/0\""), "PASS");
+        assert_eq!(check("2001:db8::1", "in_cidr \"::/0\""), "PASS");
+    }
+
+    #[test]
+    fn a_full_prefix_matches_only_the_exact_host() {
+        assert_eq!(check("10.0.0.5", "in_cidr \"10.0.0.5/32\""), "PASS");
+        assert_eq!(check("10.0.0.6", "in_cidr \"10.0.0.5/32\""), "FAIL");
+    }
+
+    #[test]
+    fn host_bits_in_the_block_are_ignored() {
+        assert_eq!(check("10.5.3.1", "in_cidr \"10.0.0.99/8\""), "PASS");
+        assert_eq!(check("10.5.0.0/16", "in_cidr \"10.0.99.0/8\""), "PASS");
+    }
+
+    #[test]
+    fn a_smaller_range_is_contained_in_a_larger_one() {
+        assert_eq!(check("10.1.0.0/16", "in_cidr \"10.0.0.0/8\""), "PASS");
+    }
+
+    #[test]
+    fn a_larger_range_is_not_contained_in_a_smaller_one() {
+        assert_eq!(check("10.0.0.0/8", "in_cidr \"10.0.0.0/16\""), "FAIL");
+    }
+
+    #[test]
+    fn ipv6_containment_is_supported() {
+        assert_eq!(check("2001:db8::1", "in_cidr \"2001:db8::/32\""), "PASS");
+        assert_eq!(check("2001:dead::1", "in_cidr \"2001:db8::/32\""), "FAIL");
+    }
+
+    #[test]
+    fn an_ipv4_value_is_never_contained_in_an_ipv6_range() {
+        assert_eq!(check("10.0.0.1", "in_cidr \"2001:db8::/32\""), "FAIL");
+    }
+
+    #[test]
+    fn a_right_side_without_a_prefix_is_not_comparable() {
+        assert_eq!(check("10.0.0.5", "in_cidr \"10.0.0.0/8\""), "PASS");
+        assert_eq!(check("10.0.0.5", "in_cidr \"10.0.0.0\""), "FAIL");
+    }
+
+    #[test]
+    fn a_prefix_wider_than_the_family_is_not_a_valid_range() {
+        assert_eq!(check("10.0.0.5", "in_cidr \"10.0.0.0/33\""), "FAIL");
+        assert_eq!(check("2001:db8::1", "in_cidr \"2001:db8::/129\""), "FAIL");
+    }
+
+    #[test]
+    fn an_invalid_address_operand_is_not_comparable() {
+        assert_eq!(check("10.0.0.5", "in_cidr \"10.0.0.0/8\""), "PASS");
+        assert_eq!(check("not-an-ip", "in_cidr \"10.0.0.0/8\""), "FAIL");
+    }
+
+    #[test]
+    fn a_non_string_operand_is_not_comparable() {
+        assert_eq!(check("10.0.0.5", "in_cidr \"10.0.0.0/8\""), "PASS");
+        assert_eq!(check_raw("167772161", "in_cidr \"10.0.0.0/8\""), "FAIL");
+        assert_eq!(check_raw("true", "in_cidr \"10.0.0.0/8\""), "FAIL");
+        assert_eq!(check_raw("{\"a\":1}", "in_cidr \"10.0.0.0/8\""), "FAIL");
+    }
+
+    #[test]
+    fn in_cidr_can_be_negated() {
+        assert_eq!(check("11.0.0.1", "not in_cidr \"10.0.0.0/8\""), "PASS");
+        assert_eq!(check("10.0.0.1", "not in_cidr \"10.0.0.0/8\""), "FAIL");
+    }
+
+    #[test]
+    fn overlapping_ranges_are_detected() {
+        assert_eq!(check("10.1.0.0/16", "cidr_overlaps \"10.0.0.0/8\""), "PASS");
+    }
+
+    #[test]
+    fn disjoint_ranges_do_not_overlap() {
+        assert_eq!(check("192.168.0.0/16", "cidr_overlaps \"10.0.0.0/8\""), "FAIL");
+    }
+
+    #[test]
+    fn overlap_is_symmetric() {
+        assert_eq!(check("10.0.0.0/8", "cidr_overlaps \"10.1.0.0/16\""), "PASS");
+        assert_eq!(check("10.1.0.0/16", "cidr_overlaps \"10.0.0.0/8\""), "PASS");
+    }
+
+    #[test]
+    fn a_host_overlaps_a_range_that_contains_it() {
+        assert_eq!(check("10.0.0.5", "cidr_overlaps \"10.0.0.0/8\""), "PASS");
+    }
+
+    #[test]
+    fn overlap_supports_ipv6_and_rejects_mixed_families() {
+        assert_eq!(check("2001:db8:1::/48", "cidr_overlaps \"2001:db8::/32\""), "PASS");
+        assert_eq!(check("2001:db8::/32", "cidr_overlaps \"2001:dead::/32\""), "FAIL");
+        assert_eq!(check("10.0.0.0/8", "cidr_overlaps \"2001:db8::/32\""), "FAIL");
+    }
+
+    #[test]
+    fn overlap_of_a_non_string_operand_is_not_comparable() {
+        assert_eq!(check("10.0.0.0/8", "cidr_overlaps \"10.0.0.0/16\""), "PASS");
+        assert_eq!(check_raw("42", "cidr_overlaps \"10.0.0.0/8\""), "FAIL");
+    }
+
+    #[test]
+    fn is_cidr_accepts_ranges_and_rejects_bare_addresses() {
+        assert_eq!(check("10.0.0.0/8", "is_cidr"), "PASS");
+        assert_eq!(check("2001:db8::/32", "is_cidr"), "PASS");
+        assert_eq!(check("10.0.0.5", "is_cidr"), "FAIL");
+        assert_eq!(check("hello", "is_cidr"), "FAIL");
+        assert_eq!(check("10.0.0.0/33", "is_cidr"), "FAIL");
+    }
+
+    #[test]
+    fn is_ip_accepts_addresses_and_rejects_ranges_and_junk() {
+        assert_eq!(check("10.0.0.5", "is_ip"), "PASS");
+        assert_eq!(check("2001:db8::1", "is_ip"), "PASS");
+        assert_eq!(check("10.0.0.0/8", "is_ip"), "FAIL");
+        assert_eq!(check("nope", "is_ip"), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_a_single_enclosing_range() {
+        assert_eq!(check("10.1.0.0/16", "covered_by [\"10.0.0.0/8\"]"), "PASS");
+        assert_eq!(check("10.0.0.5", "covered_by [\"10.0.0.0/24\"]"), "PASS");
+    }
+
+    #[test]
+    fn covered_by_a_union_of_ranges_that_no_single_member_contains() {
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"10.0.0.0/9\", \"10.128.0.0/9\"]"), "PASS");
+    }
+
+    #[test]
+    fn a_gap_in_the_union_means_not_covered() {
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"10.0.0.0/9\"]"), "FAIL");
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"10.0.0.0/9\", \"11.0.0.0/9\"]"), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_supports_ipv6_and_rejects_mixed_families() {
+        assert_eq!(check("2001:db8::/32", "covered_by [\"2001:db8::/33\", \"2001:db8:8000::/33\"]"), "PASS");
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"2001:db8::/16\"]"), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_can_be_negated() {
+        assert_eq!(check("10.0.0.0/8", "not covered_by [\"10.0.0.0/9\"]"), "PASS");
+        assert_eq!(check("10.1.0.0/16", "not covered_by [\"10.0.0.0/8\"]"), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_with_an_invalid_operand_is_not_comparable() {
+        assert_eq!(check("10.1.0.0/16", "covered_by [\"10.0.0.0/8\"]"), "PASS");
+        assert_eq!(check("not-a-cidr", "covered_by [\"10.0.0.0/8\"]"), "FAIL");
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"bad\", \"10.0.0.0/9\"]"), "FAIL");
+    }
+
+    #[test]
+    fn a_host_outside_every_range_is_not_covered() {
+        assert_eq!(check("10.0.0.5", "covered_by [\"10.0.0.0/24\"]"), "PASS");
+        assert_eq!(check("10.0.0.5", "covered_by [\"11.0.0.0/8\"]"), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_requires_the_last_address_to_be_covered() {
+        assert_eq!(check("10.0.0.0/23", "covered_by [\"10.0.0.0/24\"]"), "FAIL");
+    }
+
+    #[test]
+    fn is_cidr_and_is_ip_reject_non_string_values() {
+        assert_eq!(check_raw("42", "is_cidr"), "FAIL");
+        assert_eq!(check_raw("true", "is_cidr"), "FAIL");
+        assert_eq!(check_raw("{\"a\":1}", "is_cidr"), "FAIL");
+        assert_eq!(check_raw("42", "is_ip"), "FAIL");
+        assert_eq!(check_raw("{\"a\":1}", "is_ip"), "FAIL");
+    }
+
+    #[test]
+    fn the_bang_negation_form_matches_the_keyword_operators() {
+        assert_eq!(check("11.0.0.1", "!in_cidr \"10.0.0.0/8\""), "PASS");
+        assert_eq!(check("10.0.0.1", "!in_cidr \"10.0.0.0/8\""), "FAIL");
+        assert_eq!(check("10.0.0.0/8", "!covered_by [\"10.0.0.0/9\"]"), "PASS");
+    }
+
+    #[test]
+    fn overlap_treats_a_bare_address_on_either_side_as_a_host() {
+        assert_eq!(check("10.0.0.0/8", "cidr_overlaps \"10.0.0.5\""), "PASS");
+        assert_eq!(check("10.0.0.5", "cidr_overlaps \"10.0.0.5\""), "PASS");
+        assert_eq!(check("10.0.0.5", "cidr_overlaps \"10.0.0.6\""), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_handles_the_top_of_the_address_space() {
+        assert_eq!(
+            check("255.255.255.254/31", "covered_by [\"255.255.255.254/32\", \"255.255.255.255/32\"]"),
+            "PASS"
+        );
+        assert_eq!(
+            check(
+                "ffff:ffff:ffff:ffff:ffff:ffff:ffff:fffe/127",
+                "covered_by [\"ffff:ffff:ffff:ffff:ffff:ffff:ffff:fffe/128\", \"ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff/128\"]"
+            ),
+            "PASS"
+        );
+    }
+
+    #[test]
+    fn is_cidr_accepts_non_canonical_ranges() {
+        assert_eq!(check("10.0.0.99/8", "is_cidr"), "PASS");
+        assert_eq!(check("2001:db8::1/32", "is_cidr"), "PASS");
+    }
+
+    #[test]
+    fn cidr_overlaps_rejects_out_of_range_prefixes() {
+        assert_eq!(check("10.0.0.0/16", "cidr_overlaps \"10.0.0.0/33\""), "FAIL");
+        assert_eq!(check("10.0.0.0/16", "cidr_overlaps \"2001:db8::/129\""), "FAIL");
+    }
+
+    #[test]
+    fn covered_by_rejects_invalid_right_side_elements() {
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"10.0.0.0/9\", 42]"), "FAIL");
+        assert_eq!(check("10.0.0.0/8", "covered_by [\"10.0.0.0/9\", \"10.128.0.0/33\"]"), "FAIL");
+    }
+
+    #[test]
+    fn existing_syntax_keeps_working_alongside_the_new_operators() {
+        let data = r#"{"Resources":{"a":{"Type":"AWS::EC2::SecurityGroup","Properties":{"Cidr":"10.1.0.0/16"}}}}"#;
+        let rules = "rule r {\n  Resources.*[ Type == /SecurityGroup/ ].Properties.Cidr in_cidr \"10.0.0.0/8\"\n}\n";
+        assert_eq!(status(data, rules), "PASS");
+    }
+}
diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..ee80e00
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/root/.cargo/bin:$PATH"
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+TEST_JSON=$(mktemp)
+TEST_ERR=$(mktemp)
+
+case "$MODE" in
+  base)
+    cargo test -p cfn-guard --lib --no-run > /dev/null 2>> "$TEST_ERR"
+    cargo test -p cfn-guard --lib -- \
+      -Z unstable-options --format json --report-time --test-threads=1 > "$TEST_JSON" 2>> "$TEST_ERR"
+    ;;
+  new)
+    cargo test -p cfn-guard --test cidr_operators_3ff9e6 --no-run > /dev/null 2>> "$TEST_ERR"
+    cargo test -p cfn-guard --test cidr_operators_3ff9e6 cidr_operator_tests -- \
+      -Z unstable-options --format json --report-time --test-threads=1 > "$TEST_JSON" 2>> "$TEST_ERR"
+    ;;
+esac
+STATUS=$?
+
+cat "$TEST_ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  grep '^{' "$TEST_JSON" | cargo2junit > "$OUTPUT_PATH" 2>/dev/null || true
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    sanitized=$( { cat "$TEST_ERR"; cat "$TEST_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n  <testsuite name="cargo-test" tests="1" failures="1" errors="0">\n    <testcase name="compilation" classname="cargo-test"><failure message="build failed"><![CDATA[%s]]></failure></testcase>\n  </testsuite>\n</testsuites>\n' "$sanitized" > "$OUTPUT_PATH"
+  fi
+fi
+
+exit $STATUS
