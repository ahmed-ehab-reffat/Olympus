+use crate::dom::rewrite::{Error, Rewrite};
+use crate::dom::{Keys, Node};
+use crate::parser::parse;
+
+fn rewrite_of(src: &str) -> Rewrite {
+    let root = parse(src).into_dom();
+    Rewrite::new(root).unwrap()
+}
+
+fn assert_rewrite(src: &str, apply: impl FnOnce(&mut Rewrite) -> Result<&mut Rewrite, Error>, expected: &str) {
+    let mut rewrite = rewrite_of(src);
+    apply(&mut rewrite).unwrap();
+    assert_eq!(expected, rewrite.to_string());
+}
+
+fn expect_dom_error(
+    src: &str,
+    apply: impl FnOnce(&mut Rewrite) -> Result<&mut Rewrite, Error>,
+    expected_substring: &str,
+) {
+    let mut rewrite = rewrite_of(src);
+    match apply(&mut rewrite) {
+        Err(Error::Dom(e)) => assert!(
+            e.to_string().contains(expected_substring),
+            "expected error containing {expected_substring:?}, got: {e}"
+        ),
+        Err(other) => panic!("expected a dom error, got: {other:?}"),
+        Ok(_) => panic!("expected an error"),
+    }
+}
+
+fn expect_local_error(
+    src: &str,
+    apply: impl FnOnce(&mut Rewrite) -> Result<&mut Rewrite, Error>,
+    expected_substring: &str,
+) {
+    let mut rewrite = rewrite_of(src);
+    match apply(&mut rewrite) {
+        Err(Error::ExpectedTable) => {
+            assert!(
+                Error::ExpectedTable.to_string().contains(expected_substring),
+                "expected error containing {expected_substring:?}, got: {}",
+                Error::ExpectedTable
+            );
+        }
+        Err(other) => panic!("expected ExpectedTable, got: {other:?}"),
+        Ok(_) => panic!("expected an error"),
+    }
+}
+
+fn remaining_count(result: &str, path: &str) -> usize {
+    let dom = parse(result).into_dom();
+    let keys: Keys = path.parse().unwrap();
+    match dom.path(&keys).unwrap() {
+        Node::Table(t) => t.entries().read().len(),
+        Node::Array(a) => a.items().read().len(),
+        _ => panic!("not a collection"),
+    }
+}
+
+fn parses_cleanly(src: &str) -> bool {
+    parse(src).errors.is_empty()
+}
+
+#[test]
+fn insert_header_table_empty() {
+    assert_rewrite(
+        "[table]\n",
+        |r| r.insert_entry("table", "key", "1"),
+        "[table]\nkey = 1\n",
+    );
+}
+
+#[test]
+fn insert_header_table_with_existing_entries() {
+    assert_rewrite(
+        "[table]\na = 1\n",
+        |r| r.insert_entry("table", "b", "2"),
+        "[table]\na = 1\nb = 2\n",
+    );
+}
+
+#[test]
+fn insert_header_table_before_later_nested_table() {
+    assert_rewrite(
+        "[table]\na = 1\n\n[table.sub]\nc = 3\n",
+        |r| r.insert_entry("table", "b", "2"),
+        "[table]\na = 1\nb = 2\n\n[table.sub]\nc = 3\n",
+    );
+}
+
+#[test]
+fn insert_header_table_immediately_followed_by_another_header() {
+    assert_rewrite(
+        "[table]\n[other]\nx = 1\n",
+        |r| r.insert_entry("table", "b", "2"),
+        "[table]\nb = 2\n[other]\nx = 1\n",
+    );
+}
+
+#[test]
+fn insert_root_table_empty_document() {
+    assert_rewrite("", |r| r.insert_entry("", "key", "1"), "key = 1\n");
+}
+
+#[test]
+fn insert_root_table_with_existing_entries() {
+    assert_rewrite("a = 1\n", |r| r.insert_entry("", "b", "2"), "a = 1\nb = 2\n");
+}
+
+#[test]
+fn insert_root_table_at_document_start_before_header() {
+    assert_rewrite(
+        "[table]\nx = 1\n",
+        |r| r.insert_entry("", "key", "1"),
+        "key = 1\n[table]\nx = 1\n",
+    );
+}
+
+#[test]
+fn insert_inline_table_empty() {
+    assert_rewrite("a = {}\n", |r| r.insert_entry("a", "x", "1"), "a = {x = 1}\n");
+}
+
+#[test]
+fn insert_inline_table_non_empty() {
+    assert_rewrite(
+        "a = { x = 1 }\n",
+        |r| r.insert_entry("a", "y", "2"),
+        "a = { x = 1 , y = 2}\n",
+    );
+}
+
+#[test]
+fn insert_inline_array_empty() {
+    assert_rewrite("a = []\n", |r| r.insert_array_value("a", "1"), "a = [1]\n");
+}
+
+#[test]
+fn insert_inline_array_non_empty() {
+    assert_rewrite(
+        "a = [ 1, 2 ]\n",
+        |r| r.insert_array_value("a", "3"),
+        "a = [ 1, 2 , 3]\n",
+    );
+}
+
+#[test]
+fn insert_duplicate_key_errors() {
+    expect_dom_error("a = 1\n", |r| r.insert_entry("", "a", "2"), "already exists");
+}
+
+#[test]
+fn insert_into_pseudo_table_errors() {
+    expect_dom_error(
+        "a.b = 1\n",
+        |r| r.insert_entry("a", "c", "1"),
+        "key = value",
+    );
+}
+
+#[test]
+fn remove_from_pseudo_table_errors() {
+    expect_dom_error("a.b = 1\n", |r| r.remove_entry("a"), "key = value");
+}
+
+#[test]
+fn insert_entry_missing_table_errors() {
+    expect_dom_error(
+        "a = 1\n",
+        |r| r.insert_entry("missing", "k", "1"),
+        "not found",
+    );
+}
+
+#[test]
+fn insert_array_value_into_non_array_errors() {
+    expect_dom_error(
+        "a = 1\n",
+        |r| r.insert_array_value("a", "2"),
+        "inline table or inline array",
+    );
+}
+
+#[test]
+fn insert_entry_into_non_table_errors() {
+    expect_local_error("a = 1\n", |r| r.insert_entry("a", "k", "2"), "expected table");
+}
+
+#[test]
+fn remove_header_table_first_entry() {
+    assert_rewrite(
+        "[t]\na = 1\nb = 2\n",
+        |r| r.remove_entry("t.a"),
+        "[t]\nb = 2\n",
+    );
+}
+
+#[test]
+fn remove_header_table_middle_entry() {
+    assert_rewrite(
+        "[t]\na = 1\nb = 2\nc = 3\n",
+        |r| r.remove_entry("t.b"),
+        "[t]\na = 1\nc = 3\n",
+    );
+}
+
+#[test]
+fn remove_header_table_last_entry() {
+    assert_rewrite("[t]\na = 1\n", |r| r.remove_entry("t.a"), "[t]\n");
+}
+
+#[test]
+fn remove_header_table_entry_with_trailing_comment() {
+    assert_rewrite(
+        "[t]\na = 1 # note\nb = 2\n",
+        |r| r.remove_entry("t.a"),
+        "[t]\nb = 2\n",
+    );
+}
+
+#[test]
+fn remove_header_table_entry_before_next_header() {
+    assert_rewrite(
+        "[t]\na = 1\n[u]\nb = 2\n",
+        |r| r.remove_entry("t.a"),
+        "[t]\n[u]\nb = 2\n",
+    );
+}
+
+#[test]
+fn remove_entry_not_found_errors() {
+    expect_dom_error("[t]\na = 1\n", |r| r.remove_entry("t.missing"), "not found");
+}
+
+#[test]
+fn remove_inline_table_first_entry() {
+    assert_rewrite(
+        "a = { x = 1, y = 2, z = 3 }\n",
+        |r| r.remove_entry("a.x"),
+        "a = { y = 2, z = 3 }\n",
+    );
+}
+
+#[test]
+fn remove_inline_table_middle_entry() {
+    assert_rewrite(
+        "a = { x = 1, y = 2, z = 3 }\n",
+        |r| r.remove_entry("a.y"),
+        "a = { x = 1, z = 3 }\n",
+    );
+}
+
+#[test]
+fn remove_inline_table_last_entry_strips_preceding_comma() {
+    assert_rewrite(
+        "a = { x = 1, y = 2, z = 3 }\n",
+        |r| r.remove_entry("a.z"),
+        "a = { x = 1, y = 2}\n",
+    );
+}
+
+#[test]
+fn remove_inline_table_sole_entry_leaves_valid_empty_table() {
+    let mut rewrite = rewrite_of("a = { x = 1 }\n");
+    rewrite.remove_entry("a.x").unwrap();
+    let result = rewrite.to_string();
+    assert!(parses_cleanly(&result), "result did not reparse cleanly: {result:?}");
+    assert_eq!(0, remaining_count(&result, "a"));
+}
+
+#[test]
+fn remove_inline_array_first_value() {
+    assert_rewrite(
+        "a = [ 1, 2, 3 ]\n",
+        |r| r.remove_array_value("a", 0),
+        "a = [ 2, 3 ]\n",
+    );
+}
+
+#[test]
+fn remove_inline_array_middle_value() {
+    assert_rewrite(
+        "a = [ 1, 2, 3 ]\n",
+        |r| r.remove_array_value("a", 1),
+        "a = [ 1, 3 ]\n",
+    );
+}
+
+#[test]
+fn remove_inline_array_last_value_strips_preceding_comma() {
+    assert_rewrite(
+        "a = [ 1, 2, 3 ]\n",
+        |r| r.remove_array_value("a", 2),
+        "a = [ 1, 2]\n",
+    );
+}
+
+#[test]
+fn remove_inline_array_sole_value_leaves_valid_empty_array() {
+    let mut rewrite = rewrite_of("a = [ 1 ]\n");
+    rewrite.remove_array_value("a", 0).unwrap();
+    let result = rewrite.to_string();
+    assert!(parses_cleanly(&result), "result did not reparse cleanly: {result:?}");
+    assert_eq!(0, remaining_count(&result, "a"));
+}
+
+#[test]
+fn remove_array_value_out_of_bounds_errors() {
+    expect_dom_error(
+        "a = [ 1 ]\n",
+        |r| r.remove_array_value("a", 5),
+        "out of bounds",
+    );
+}
+
+#[test]
+fn insert_array_value_missing_array_errors() {
+    expect_dom_error(
+        "a = [ 1 ]\n",
+        |r| r.insert_array_value("missing", "1"),
+        "not found",
+    );
+}
+
+#[test]
+fn remove_array_value_missing_array_errors() {
+    expect_dom_error(
+        "a = [ 1 ]\n",
+        |r| r.remove_array_value("missing", 0),
+        "not found",
+    );
+}
+
+#[test]
+fn chained_patches_apply_together() {
+    assert_rewrite(
+        "[t]\na = 1\nb = 2\n[u]\nc = 3\n",
+        |r| {
+            r.insert_entry("t", "d", "4")?;
+            r.remove_entry("u.c")?;
+            r.rename_keys("t.a", "renamed")
+        },
+        "[t]\nrenamed = 1\nb = 2\nd = 4\n[u]\n",
+    );
+}
+
+#[test]
+fn chained_patches_detect_overlap() {
+    let mut rewrite = rewrite_of("[t]\na = 1\n");
+    rewrite.remove_entry("t.a").unwrap();
+    match rewrite.insert_entry("t", "b", "2") {
+        Err(Error::Overlap) => {}
+        other => panic!("expected an overlap error, got: {other:?}"),
+    }
+}
