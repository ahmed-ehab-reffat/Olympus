+fn append_into_bracketed(
+    syntax: &SyntaxElement,
+    has_existing: bool,
+    text: &str,
+) -> Result<(usize, String), Error> {
+    let node = syntax.as_node().ok_or(Error::ExpectedTable)?;
+    let close = node.last_child_or_token().ok_or(Error::ExpectedTable)?;
+    let offset = usize::from(close.text_range().start());
+    let prefix = if has_existing { ", " } else { "" };
+
+    Ok((offset, format!("{prefix}{text}")))
+}
+
+fn line_removal_range(entry: &SyntaxElement) -> TextRange {
+    let mut end = entry.text_range().end();
+
+    if let Some(next) = entry.next_sibling_or_token() {
+        if next.kind() == SyntaxKind::NEWLINE {
+            end = next.text_range().end();
+        }
+    }
+
+    TextRange::new(entry.text_range().start(), end)
+}
+
+fn inline_member_removal_range(member: &SyntaxElement) -> TextRange {
+    let start = member.text_range().start();
+    let end = member.text_range().end();
+
+    if let Some(next) = member.next_sibling_or_token() {
+        if next.kind() == SyntaxKind::COMMA {
+            let mut end = next.text_range().end();
+
+            if let Some(after_comma) = next.next_sibling_or_token() {
+                if after_comma.kind() == SyntaxKind::WHITESPACE {
+                    end = after_comma.text_range().end();
+                }
+            }
+
+            return TextRange::new(start, end);
+        }
+    }
+
+    if let Some(preceding_comma_start) = preceding_comma_start(member) {
+        return TextRange::new(preceding_comma_start, end);
+    }
+
+    TextRange::new(start, end)
+}
+
+fn preceding_comma_start(member: &SyntaxElement) -> Option<TextSize> {
+    let before = member.prev_sibling_or_token()?;
+
+    let comma = match before.kind() {
+        SyntaxKind::COMMA => before,
+        SyntaxKind::WHITESPACE => {
+            let before_ws = before.prev_sibling_or_token()?;
+            if before_ws.kind() != SyntaxKind::COMMA {
+                return None;
+            }
+            before_ws
+        }
+        _ => return None,
+    };
+
+    Some(comma.text_range().start())
+}
+
+fn find_entry_ancestor(value_syntax: &SyntaxElement) -> Option<SyntaxElement> {
+    let mut current = value_syntax.clone();
+
+    loop {
+        if current.kind() == SyntaxKind::ENTRY {
+            return Some(current);
+        }
+
+        current = current.parent()?.into();
+    }
+}
+
+fn find_array_member(item_syntax: &SyntaxElement) -> Option<SyntaxElement> {
+    let mut current = item_syntax.clone();
+
+    loop {
+        let parent = current.parent()?;
+
+        if parent.kind() == SyntaxKind::ARRAY {
+            return Some(current);
+        }
+
+        current = parent.into();
+    }
 }
 
