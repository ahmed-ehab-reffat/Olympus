+impl Rewrite {
+    fn resolve_table(&self, table: &str) -> Result<Node, Error> {
+        if table.is_empty() {
+            return Ok(self.root.clone());
+        }
+
+        let keys = table.parse::<Keys>()?;
+        self.root
+            .find_all_matches(keys, false)?
+            .map(|(_, node)| node)
+            .next()
+            .ok_or_else(|| Error::Dom(dom::error::QueryError::NotFound.into()))
+    }
+
+    fn resolve_array(&self, array: &str) -> Result<Node, Error> {
