+            .next()
+            .ok_or_else(|| Error::Dom(dom::error::QueryError::NotFound.into()))
+    }
+
+    fn entry_insertion(&self, table: &str, key: &str, value: &str) -> Result<(usize, String), Error> {
+        let target = self.resolve_table(table)?;
+        let table_node = target.as_table().ok_or(Error::ExpectedTable)?;
+
+        if table_node.get(key).is_some() {
