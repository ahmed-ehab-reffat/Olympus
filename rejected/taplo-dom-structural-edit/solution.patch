+        }
+    }
+
+    fn regular_table_anchor(&self, syntax: &SyntaxElement) -> usize {
+        if syntax.kind() == SyntaxKind::ROOT {
+            let mut anchor = 0usize;
+            let mut cursor = syntax.as_node().and_then(|n| n.first_child_or_token());
+
+            while let Some(elem) = cursor {
+                match elem.kind() {
+                    SyntaxKind::ENTRY => {
+                        anchor = usize::from(elem.text_range().end());
+                        cursor = elem.next_sibling_or_token();
+                    }
+                    SyntaxKind::TABLE_HEADER | SyntaxKind::TABLE_ARRAY_HEADER => break,
+                    _ => cursor = elem.next_sibling_or_token(),
