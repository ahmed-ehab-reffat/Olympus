+            let mut anchor = usize::from(syntax.text_range().end());
+            let mut cursor = syntax.next_sibling_or_token();
+
+            while let Some(elem) = cursor {
+                match elem.kind() {
+                    SyntaxKind::ENTRY => {
+                        anchor = usize::from(elem.text_range().end());
+                        cursor = elem.next_sibling_or_token();
+                    }
+                    SyntaxKind::TABLE_HEADER | SyntaxKind::TABLE_ARRAY_HEADER => break,
+                    _ => cursor = elem.next_sibling_or_token(),
+                }
+            }
+
+            anchor
+        }
+    }
+
+    fn entry_removal_range(&self, key: &str) -> Result<TextRange, Error> {
+        let keys = key.parse::<Keys>()?;
+        let (_, node) = self
