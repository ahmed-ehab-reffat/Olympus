+    fn pre_process_solution(&self, context: &Self::Context, solution: Self::Solution) -> Self::Solution {
+        let problem = context.problem.clone();
+
+        if Arc::ptr_eq(&problem, &solution.problem) || problem.extras.get_original_problem().is_none() {
+            return solution;
+        }
+
+        let environment = solution.environment.clone();
+        let members = get_cluster_members(problem.jobs.all());
+        let solution: Solution = solution.into();
+        let served = get_served_clusters(solution.routes.as_slice(), &members);
+
+        let routes = solution
+            .routes
+            .into_iter()
+            .map(|route| replace_cluster_members(route, &members, &served))
+            .collect::<Vec<_>>();
+
+        let assigned = routes.iter().flat_map(|route| route.tour.jobs()).cloned().collect::<HashSet<_>>();
+        let mut unassigned = Vec::new();
+        let mut listed = HashSet::new();
+        solution.unassigned.into_iter().for_each(|(job, code)| {
+            let job = members.get(&job).map_or(job, |(cluster, _)| cluster.clone());
+            if !assigned.contains(&job) && listed.insert(job.clone()) {
