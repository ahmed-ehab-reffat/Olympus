+                    telemetry: solution.telemetry,
+                },
+                None,
+            ),
+            environment,
+        )
+    }
+}
+
+fn get_cluster_members(jobs: &[Job]) -> ClusterMembers {
+    jobs.iter()
+        .filter_map(|job| job.dimens().get_cluster_info().map(|infos| (job, infos)))
+        .flat_map(|(cluster, infos)| infos.iter().map(move |info| (info.job.clone(), (cluster.clone(), infos.len()))))
+        .collect()
+}
+
+fn get_served_clusters(routes: &[Route], members: &ClusterMembers) -> HashSet<Job> {
+    let mut runs = HashMap::<Job, usize>::new();
+    let mut complete = HashSet::new();
+
+    routes.iter().for_each(|route| {
+        let mut current: Option<(Job, usize, HashSet<Job>)> = None;
+        let mut close = |current: &mut Option<(Job, usize, HashSet<Job>)>| {
+            if let Some((cluster, size, seen)) = current.take() {
+                *runs.entry(cluster.clone()).or_default() += 1;
+                if seen.len() == size {
+                    complete.insert(cluster);
+                }
+            }
+        };
+
+        route.tour.all_activities().for_each(|activity| {
+            let member = activity.retrieve_job().and_then(|job| members.get(&job).map(|info| (job, info.clone())));
+            match member {
+                Some((job, (cluster, _))) if current.as_ref().is_some_and(|(active, ..)| *active == cluster) => {
+                    current.as_mut().unwrap().2.insert(job);
+                }
+                Some((job, (cluster, size))) => {
+                    close(&mut current);
+                    current = Some((cluster, size, once(job).collect()));
+                }
+                None => close(&mut current),
+            }
+        });
+        close(&mut current);
+    });
+
+    complete.retain(|cluster| runs.get(cluster) == Some(&1));
+
+    complete
+}
+
+fn replace_cluster_members(mut route: Route, members: &ClusterMembers, served: &HashSet<Job>) -> Route {
+    let route_start = route.tour.start().map_or(0., |start| start.schedule.departure);
+    let mut runs = Vec::<(usize, usize, Job)>::new();
+
+    route.tour.all_activities().enumerate().for_each(|(idx, activity)| {
+        let cluster = activity.retrieve_job().and_then(|job| members.get(&job).map(|(cluster, _)| cluster.clone()));
+        if let Some(cluster) = cluster {
+            match runs.last_mut() {
+                Some((_, end, active)) if *end + 1 == idx && *active == cluster => *end = idx,
+                _ => runs.push((idx, idx, cluster)),
+            }
+        }
+    });
+
+    runs.into_iter().rev().for_each(|(start, end, cluster)| {
+        let arrival = route.tour.get(start).unwrap().schedule.arrival;
+        let departure = route.tour.get(end).unwrap().schedule.departure;
+
+        (start..=end).rev().for_each(|idx| {
+            route.tour.remove_activity_at(idx);
+        });
+
+        if served.contains(&cluster) {
+            route.tour.insert_at(create_cluster_activity(&cluster, route_start, arrival, departure), start);
+        }
+    });
+
+    route
+}
+
+fn create_cluster_activity(cluster: &Job, route_start: f64, arrival: f64, departure: f64) -> Activity {
+    let single = cluster.to_single();
+    let place = single.places.first().expect("cluster has no place");
+    let time = place
+        .times
+        .iter()
+        .map(|time| time.to_time_window(route_start))
+        .find(|time| time.end >= arrival)
+        .unwrap_or_else(|| TimeWindow::new(arrival, departure));
+
+    Activity {
+        place: Place {
+            idx: 0,
+            location: place.location.expect("cluster has no location"),
+            duration: place.duration,
+            time,
+        },
+        schedule: Schedule::new(arrival, departure),
+        job: Some(single.clone()),
+        commute: None,
+    }
 }
 
