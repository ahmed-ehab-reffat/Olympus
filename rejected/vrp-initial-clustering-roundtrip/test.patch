+#[test]
+fn unclustered_solution_serves_clusters_whose_jobs_come_one_after_another() {
+    let problem = load_problem("initial.closed.problem.json");
+
+    let actual = solve_without_generations(&problem, &load_solution("initial.plain.solution.json"));
+
+    assert_eq!(
+        stop_jobs(&actual),
+        stops(&[&["departure"], &["job2", "job1"], &["job3"], &["job4"], &["job9", "job10", "job8"], &["arrival"]])
+    );
+    assert_eq!(unassigned_ids(&actual), ids(&["job5", "job6", "job7", "job11", "job12"]));
+    assert_eq!(parking_stops(&actual), 2);
+}
