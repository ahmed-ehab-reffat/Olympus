new file mode 100755
index 00000000..f41cd9e6
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_TARGET="initial_clustering_df3f26"
+NEW_TESTS=(
+  clustered_solution_on_a_closed_shift_reads_back_as_written
+  clustered_solution_on_an_open_shift_reads_back_as_written
+  solving_from_its_own_clustered_solution_on_a_closed_shift_writes_it_back
+  solving_from_its_own_clustered_solution_on_an_open_shift_writes_it_back
+  unclustered_solution_serves_clusters_whose_jobs_come_one_after_another
+  jobs_of_a_cluster_in_another_order_still_form_the_cluster
+  cluster_interrupted_by_another_job_starts_unassigned
+  cluster_with_an_unassigned_job_starts_unassigned
+)
+
+WORK_DIR="$(mktemp -d)"
+STATUS=0
+
+run_cargo_json() {
+  local out_json="$1"; local out_err="$2"; local cargo_args="$3"; shift 3
+  # shellcheck disable=SC2086
+  cargo test $cargo_args -- "$@" -Z unstable-options --format json --report-time > "$out_json" 2> "$out_err"
+  return $?
+}
+
+to_junit_or_fallback() {
+  local json_file="$1"; local err_file="$2"; local xml_file="$3"; shift 3
+  local names=("$@")
+
+  cargo2junit < "$json_file" > "$xml_file" 2>/dev/null || true
+
+  if ! grep -q '<testcase' "$xml_file" 2>/dev/null; then
+    local sanitized
+    sanitized=$( { cat "$err_file"; cat "$json_file"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    local testcases=""
+    for name in "${names[@]}"; do
+      testcases+="    <testcase name=\"${name}\" classname=\"\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>"$'\n'
+    done
+    cat > "$xml_file" <<XMLEOF
+<?xml version="1.0" encoding="UTF-8"?>
+<testsuites>
+  <testsuite name="cargo-test" tests="${#names[@]}" failures="${#names[@]}" errors="0">
+${testcases}  </testsuite>
+</testsuites>
+XMLEOF
+    return 1
+  fi
+
+  return 0
+}
+
+merge_junit() {
+  local out_path="$1"; shift
+  mkdir -p "$(dirname "$out_path")" || return 1
+  python3 - "$out_path" "$@" <<'PYEOF'
+import sys
+import xml.etree.ElementTree as ET
+
+out_path = sys.argv[1]
+root = ET.Element("testsuites")
+for path in sys.argv[2:]:
+    tree = ET.parse(path)
+    for suite in tree.getroot().iter("testsuite"):
+        for case in suite.iter("testcase"):
+            for key in ("name", "classname"):
+                if case.get(key) is not None:
+                    case.set(key, case.get(key).replace("::", "."))
+        root.append(suite)
+
+ET.ElementTree(root).write(out_path, encoding="UTF-8", xml_declaration=True)
+PYEOF
+}
+
+case "$MODE" in
+  base)
+    xml_files=()
+    for crate in rosomaxa vrp-core vrp-pragmatic; do
+      extra=()
+      if [ "$crate" = "vrp-pragmatic" ]; then
+        extra=(--skip can_handle_commute_error_in_init_solution)
+      fi
+      run_cargo_json "$WORK_DIR/$crate.json" "$WORK_DIR/$crate.err" "-p $crate --lib" "${extra[@]}"
+      run_status=$?
+      to_junit_or_fallback "$WORK_DIR/$crate.json" "$WORK_DIR/$crate.err" "$WORK_DIR/$crate.xml" "$crate-lib"
+      fallback_status=$?
+      STATUS=$(( STATUS != 0 || run_status != 0 || fallback_status != 0 ))
+      xml_files+=("$WORK_DIR/$crate.xml")
+    done
+    ;;
+  new)
+    run_cargo_json "$WORK_DIR/new.json" "$WORK_DIR/new.err" "-p vrp-pragmatic --test $NEW_TARGET"
+    run_status=$?
+    to_junit_or_fallback "$WORK_DIR/new.json" "$WORK_DIR/new.err" "$WORK_DIR/new.xml" "${NEW_TESTS[@]}"
+    fallback_status=$?
+    STATUS=$(( run_status != 0 || fallback_status != 0 ))
+    xml_files=("$WORK_DIR/new.xml")
+    ;;
+esac
+
+if [ -n "$OUTPUT_PATH" ]; then
+  merge_junit "$OUTPUT_PATH" "${xml_files[@]}"
+  merge_status=$?
+  STATUS=$(( STATUS != 0 || merge_status != 0 ))
+fi
+
+exit $STATUS
diff --git a/vrp-pragmatic/tests/initial_clustering_df3f26.rs b/vrp-pragmatic/tests/initial_clustering_df3f26.rs
new file mode 100644
index 00000000..7ad29b25
--- /dev/null
+++ b/vrp-pragmatic/tests/initial_clustering_df3f26.rs
@@ -0,0 +1,261 @@
+use serde_json::Value;
+use std::collections::BTreeSet;
+use std::io::{BufReader, BufWriter};
+use std::sync::Arc;
+use vrp_core::construction::heuristics::InsertionContext;
+use vrp_core::models::{Problem as CoreProblem, Solution as CoreSolution};
+use vrp_core::solver::{Solver, VrpConfigBuilder};
+use vrp_core::utils::{DefaultRandom, Environment, Parallelism};
+use vrp_pragmatic::format::problem::{PragmaticProblem, deserialize_matrix, deserialize_problem};
+use vrp_pragmatic::format::solution::{PragmaticOutputType, read_init_solution, write_pragmatic};
+
+fn data_path(name: &str) -> String {
+    format!("{}/../examples/data/pragmatic/clustering/{name}", env!("CARGO_MANIFEST_DIR"))
+}
+
+fn environment() -> Arc<Environment> {
+    Arc::new(Environment {
+        random: Arc::new(DefaultRandom::new_repeatable()),
+        parallelism: Parallelism::new_with_cpus(4),
+        logger: Arc::new(|_| {}),
+        ..Environment::default()
+    })
+}
+
+fn load_problem(name: &str) -> Arc<CoreProblem> {
+    let problem = deserialize_problem(BufReader::new(std::fs::File::open(data_path(name)).unwrap())).unwrap();
+    let matrix =
+        deserialize_matrix(BufReader::new(std::fs::File::open(data_path("initial.matrix.json")).unwrap())).unwrap();
+
+    Arc::new((problem, vec![matrix]).read_pragmatic().unwrap())
+}
+
+fn load_solution(name: &str) -> Value {
+    serde_json::from_str(&std::fs::read_to_string(data_path(name)).unwrap()).unwrap()
+}
+
+fn read(problem: &Arc<CoreProblem>, solution: &Value) -> CoreSolution {
+    let content = serde_json::to_string(solution).unwrap();
+
+    read_init_solution(BufReader::new(content.as_bytes()), problem.clone(), environment().random.clone())
+        .expect("cannot read initial solution")
+}
+
+fn write(problem: &Arc<CoreProblem>, solution: &CoreSolution) -> Value {
+    let mut buffer = Vec::new();
+    {
+        let mut writer = BufWriter::new(&mut buffer);
+        write_pragmatic(problem, solution, PragmaticOutputType::OnlyPragmatic, &mut writer).unwrap();
+    }
+
+    serde_json::from_slice(buffer.as_slice()).unwrap()
+}
+
+fn solve_without_generations(problem: &Arc<CoreProblem>, initial: &Value) -> Value {
+    let environment = environment();
+    let initial =
+        InsertionContext::new_from_solution(problem.clone(), (read(problem, initial), None), environment.clone());
+    let config = VrpConfigBuilder::new(problem.clone())
+        .set_environment(environment)
+        .prebuild()
+        .unwrap()
+        .with_init_solutions(vec![initial], Some(1))
+        .with_max_generations(Some(0))
+        .build()
+        .unwrap();
+    let solution = Solver::new(problem.clone(), config).solve().expect("cannot solve");
+
+    write(problem, &solution)
+}
+
+fn stop_jobs(solution: &Value) -> Vec<Vec<String>> {
+    solution["tours"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .flat_map(|tour| tour["stops"].as_array().unwrap().iter())
+        .map(|stop| {
+            stop["activities"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .map(|activity| activity["jobId"].as_str().unwrap().to_string())
+                .collect()
+        })
+        .collect()
+}
+
+fn unassigned_ids(solution: &Value) -> BTreeSet<String> {
+    solution["unassigned"]
+        .as_array()
+        .map(|jobs| jobs.iter().map(|job| job["jobId"].as_str().unwrap().to_string()).collect())
+        .unwrap_or_default()
+}
+
+fn parking_stops(solution: &Value) -> usize {
+    solution["tours"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .flat_map(|tour| tour["stops"].as_array().unwrap().iter())
+        .filter(|stop| stop.get("parking").is_some())
+        .count()
+}
+
+fn reorder_stops(solution: &Value, order: &[&str]) -> Value {
+    let mut solution = solution.clone();
+    let stops = solution["tours"][0]["stops"].as_array().unwrap().clone();
+    let find = |job_id: &str| {
+        stops.iter().find(|stop| stop["activities"][0]["jobId"].as_str() == Some(job_id)).cloned().unwrap()
+    };
+    solution["tours"][0]["stops"] = Value::Array(order.iter().map(|job_id| find(job_id)).collect());
+
+    solution
+}
+
+fn unassign(solution: &Value, job_id: &str) -> Value {
+    let mut solution = solution.clone();
+    let stops = solution["tours"][0]["stops"].as_array().unwrap().clone();
+    solution["tours"][0]["stops"] = Value::Array(
+        stops.into_iter().filter(|stop| stop["activities"][0]["jobId"].as_str() != Some(job_id)).collect(),
+    );
+    solution["unassigned"] = serde_json::json!([{
+        "jobId": job_id,
+        "reasons": [{ "code": "NO_REASON_FOUND", "description": "unknown" }]
+    }]);
+
+    solution
+}
+
+fn ids(ids: &[&str]) -> BTreeSet<String> {
+    ids.iter().map(|id| id.to_string()).collect()
+}
+
+fn stops(stops: &[&[&str]]) -> Vec<Vec<String>> {
+    stops.iter().map(|stop| stop.iter().map(|id| id.to_string()).collect()).collect()
+}
+
+const SERVED_TOGETHER: &[&str] = &[
+    "departure",
+    "job1",
+    "job2",
+    "job3",
+    "job4",
+    "job7",
+    "job5",
+    "job12",
+    "job6",
+    "job11",
+    "job8",
+    "job9",
+    "job10",
+    "arrival",
+];
+
+#[test]
+fn clustered_solution_on_a_closed_shift_reads_back_as_written() {
+    let problem = load_problem("initial.closed.problem.json");
+    let expected = load_solution("initial.closed.solution.json");
+
+    let actual = write(&problem, &read(&problem, &expected));
+
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn clustered_solution_on_an_open_shift_reads_back_as_written() {
+    let problem = load_problem("initial.open.problem.json");
+    let expected = load_solution("initial.open.solution.json");
+
+    let actual = write(&problem, &read(&problem, &expected));
+
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn solving_from_its_own_clustered_solution_on_a_closed_shift_writes_it_back() {
+    let problem = load_problem("initial.closed.problem.json");
+    let expected = load_solution("initial.closed.solution.json");
+
+    let actual = solve_without_generations(&problem, &expected);
+
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn solving_from_its_own_clustered_solution_on_an_open_shift_writes_it_back() {
+    let problem = load_problem("initial.open.problem.json");
+    let expected = load_solution("initial.open.solution.json");
+
+    let actual = solve_without_generations(&problem, &expected);
+
+    assert_eq!(actual, expected);
+}
