@@ -0,0 +1,179 @@
+use crate::interpreter_settings;
+use hayro_syntax::Pdf;
+
+const CATALOG: &str = "<< /Type /Catalog /Pages 2 0 R /OCProperties << /OCGs [5 0 R 6 0 R] /D << /OFF [6 0 R] >> >> >>";
+const OCG_SHOWN: &str = "<< /Type /OCG /Name (Shown) >>";
+const OCG_HIDDEN: &str = "<< /Type /OCG /Name (Hidden) >>";
+const FONT: &str = "/Font << /F1 << /Type /Font /Subtype /Type1 /BaseFont /Helvetica >> >>";
+
+fn stream(dict: &str, data: &str) -> String {
+    format!(
+        "<< {dict} /Length {} >>\nstream\n{data}\nendstream",
+        data.len()
+    )
+}
+
+fn document(objects: &[String]) -> Vec<u8> {
+    let mut out = b"%PDF-1.7\n".to_vec();
+    let mut offsets = vec![];
+
+    for (i, object) in objects.iter().enumerate() {
+        offsets.push(out.len());
+        out.extend_from_slice(format!("{} 0 obj\n{object}\nendobj\n", i + 1).as_bytes());
+    }
+
+    let xref = out.len();
+    out.extend_from_slice(
+        format!("xref\n0 {}\n0000000000 65535 f \n", objects.len() + 1).as_bytes(),
+    );
+
+    for offset in offsets {
+        out.extend_from_slice(format!("{offset:010} 00000 n \n").as_bytes());
+    }
+
+    out.extend_from_slice(
+        format!(
+            "trailer\n<< /Size {} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n",
+            objects.len() + 1
+        )
+        .as_bytes(),
+    );
+
+    out
+}
+
+fn layered_page(catalog: &str, resources: &str, content: &str, extra: &[&str]) -> Vec<u8> {
+    let mut objects = vec![
+        catalog.to_string(),
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>".to_string(),
+        format!(
+            "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 60 60] /Contents 4 0 R /Resources << /Properties << /on 5 0 R /off 6 0 R >> {resources} >> >>"
+        ),
+        stream("", content),
+        OCG_SHOWN.to_string(),
+        OCG_HIDDEN.to_string(),
+    ];
+    objects.extend(extra.iter().map(|o| o.to_string()));
+
+    document(&objects)
+}
+
+fn page(content: &str) -> Vec<u8> {
+    layered_page(CATALOG, FONT, content, &[])
+}
+
+fn render(data: Vec<u8>) -> Vec<Vec<u8>> {
+    let pdf = Pdf::new(data).unwrap();
+
+    hayro::render_pdf(&pdf, 1.0, interpreter_settings(), None)
+        .unwrap()
+        .into_iter()
+        .map(|pixmap| pixmap.data_as_u8_slice().to_vec())
+        .collect()
+}
+
+fn assert_extracts_as_shown(data: Vec<u8>) {
+    let shown = render(data.clone());
+    let pdf = Pdf::new(data).unwrap();
+
+    let as_page = render(hayro_write::extract_pages_to_pdf(&pdf, &[0]));
+    assert!(
+        as_page == shown,
+        "extracted page differs from the source page"
+    );
+
+    let as_xobject = render(hayro_write::extract_pages_as_xobject_to_pdf(&pdf, &[0]));
+    assert!(
+        as_xobject == shown,
+        "extracted XObject differs from the source page"
+    );
+}
+
+#[test]
+fn hidden_fill_is_not_drawn() {
+    assert_extracts_as_shown(page(
+        "0 0 1 rg 5 5 20 20 re f /OC /off BDC 1 0 0 rg 30 30 20 20 re f EMC",
+    ));
+}
+
+#[test]
+fn shown_group_is_drawn() {
+    assert_extracts_as_shown(page(
+        "/OC /on BDC 0 1 0 rg 5 5 20 20 re f EMC /OC /off BDC 1 0 0 rg 30 5 20 20 re f EMC",
+    ));
+}
+
+#[test]
+fn hidden_state_still_applies() {
+    assert_extracts_as_shown(page(
+        "/OC /off BDC 1 0 0 rg 40 40 10 10 re f 1 0 0 1 20 10 cm EMC 0 0 15 15 re f",
+    ));
+}
+
+#[test]
+fn hidden_clip_still_applies() {
+    assert_extracts_as_shown(page(
+        "/OC /off BDC q 1 0 0 rg 40 40 10 10 re f Q 10 10 20 20 re W n EMC 0 0 1 rg 0 0 60 60 re f",
+    ));
+}
+
+#[test]
+fn hidden_fill_does_not_leak_its_path() {
+    assert_extracts_as_shown(page(
+        "/OC /off BDC 30 30 20 20 re f EMC 0 0 1 rg 5 5 10 10 re f",
+    ));
+}
+
+#[test]
+fn hidden_text_keeps_its_advance() {
+    assert_extracts_as_shown(page(
+        "BT /F1 12 Tf 2 30 Td (AB) Tj /OC /off BDC (CD) Tj EMC (EF) Tj ET",
+    ));
+}
+
+#[test]
+fn hidden_text_keeps_the_render_mode_of_later_text() {
+    assert_extracts_as_shown(page(
+        "0 0 1 RG BT /F1 14 Tf 1 Tr 2 30 Td (AB) Tj /OC /off BDC (CD) Tj EMC (EF) Tj ET",
+    ));
+}
+
+#[test]
+fn plain_marked_content_inside_hidden_content_stays_hidden() {
+    assert_extracts_as_shown(page(
+        "/OC /off BDC /Span BMC 0 0 20 20 re f EMC 1 0 0 rg 30 30 20 20 re f EMC",
+    ));
+}
+
+#[test]
+fn xobject_with_hidden_optional_content_is_not_drawn() {
+    let data = layered_page(
+        CATALOG,
+        "/XObject << /Fm1 7 0 R /Fm2 8 0 R >>",
+        "/Fm1 Do /Fm2 Do",
+        &[
+            &stream(
+                "/Type /XObject /Subtype /Form /BBox [0 0 60 60] /OC 6 0 R",
+                "1 0 0 rg 5 5 20 20 re f",
+            ),
+            &stream(
+                "/Type /XObject /Subtype /Form /BBox [0 0 60 60] /OC 5 0 R",
+                "0 0 1 rg 30 30 20 20 re f",
+            ),
+        ],
+    );
+
+    assert_extracts_as_shown(data);
+}
+
+#[test]
+fn base_state_off_hides_groups_not_turned_on() {
+    let catalog = "<< /Type /Catalog /Pages 2 0 R /OCProperties << /OCGs [5 0 R 6 0 R] /D << /BaseState /OFF /ON [5 0 R] >> >> >>";
+
+    assert_extracts_as_shown(layered_page(
+        catalog,
+        FONT,
+        "/OC /on BDC 0 1 0 rg 5 5 20 20 re f EMC /OC /off BDC 1 0 0 rg 30 5 20 20 re f EMC",
+        &[],
+    ));
+}
