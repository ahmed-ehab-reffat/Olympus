index 00000000..75b002a6
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"; export CARGO_INCREMENTAL=0; export RUSTC_BOOTSTRAP=1; export CARGO_NET_OFFLINE=true
+MODE=""; OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+cd "$(dirname "$0")"
+TEST_JSON="$(mktemp)"; TEST_ERR="$(mktemp)"; STATUS=0; BROKEN=()
+run_cargo() {
+  local label="$1"; shift
+  local json err rc
+  json="$(mktemp)"; err="$(mktemp)"
+  cargo test "$@" -Z unstable-options --format json --report-time > "$json" 2> "$err"
+  rc=$?
+  cat "$json" >> "$TEST_JSON"; cat "$err" >> "$TEST_ERR"
+  if [ "$rc" -ne 0 ]; then
+    STATUS=1
+    if ! grep -q '"type": *"test"' "$json"; then
+      BROKEN+=("$label")
+      cat "$err" "$json" > "$TEST_ERR.$label"
+    fi
+  fi
+  rm -f "$json" "$err"
+}
+case "$MODE" in
+  base) for crate in hayro-syntax hayro-write hayro-interpret hayro-cmap hayro-postscript; do
+          run_cargo "$crate" -p "$crate" --lib -- --skip pdf::tests::pdf_version_header --skip pdf::tests::pdf_version_catalog
+        done
+        run_cargo hayro-tests -p hayro-tests --test tests -- load:: write::dont_cache_page_references \
+          write::write_xobject_does_not_synthesize_group write::write_xobject_preserves_page_group write::write_null_objects ;;
+  new)  run_cargo new -p hayro-tests --test tests -- write_oc_0eadd0:: ;;
+esac
+cat "$TEST_ERR" >&2
+NEW_TESTS="$(grep -E '^fn [a-z_0-9]+\(\) \{' hayro-tests/tests/write_oc_0eadd0.rs 2>/dev/null | sed -E 's/^fn ([a-z_0-9]+)\(.*/\1/')"
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  HAD_CASES=0
+  : > "$OUTPUT_PATH"
+  if grep -q '"type": *"test"' "$TEST_JSON"; then
+    cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2> "$TEST_ERR.junit"
+    if grep -q '<testcase' "$OUTPUT_PATH" \
+      && python3 -c 'import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])' "$OUTPUT_PATH" 2>> "$TEST_ERR.junit"; then
+      sed -i -e ':a' -e 's/\(classname="[^"]*\)::/\1./' -e 'ta' -e ':b' -e 's/\(name="[^"]*\)::/\1./' -e 'tb' "$OUTPUT_PATH" 2>/dev/null || true
+      grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null && HAD_CASES=1
+    else
+      STATUS=1
+      tail -c 2000 "$TEST_JSON" >> "$TEST_ERR.junit"
+      BROKEN+=(junit)
+    fi
+  fi
+  if [ "$HAD_CASES" -eq 0 ]; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    if [ "${#BROKEN[@]}" -eq 0 ]; then
+      BROKEN=(compilation)
+      cat "$TEST_ERR" "$TEST_JSON" > "$TEST_ERR.compilation"
+    fi
+  fi
+  count=0; cases=""
+  for label in "${BROKEN[@]}"; do
+    sanitized=$(tail -c 4000 "$TEST_ERR.$label" | sed -e 's/]]>/]]]]><![CDATA[>/g' -e 's/::/./g')
+    if [ "$label" = "new" ] && [ -n "$NEW_TESTS" ]; then
+      while read -r name; do
+        [ -n "$name" ] || continue
+        count=$((count + 1))
+        cases="${cases}    <testcase name=\"${name}\" classname=\"write_oc_0eadd0\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+      done <<< "$NEW_TESTS"
+    else
+      count=$((count + 1))
+      cases="${cases}    <testcase name=\"${label}\" classname=\"cargo-test\"><failure message=\"build failed\"><![CDATA[${sanitized}]]></failure></testcase>
+"
+    fi
+  done
+  if [ "$count" -gt 0 ]; then
+    suite="  <testsuite name=\"cargo build\" tests=\"${count}\" failures=\"${count}\" errors=\"0\">
+${cases}  </testsuite>
+"
+    if [ "$HAD_CASES" -eq 1 ]; then
+      body="$(cat "$OUTPUT_PATH")"
+      body="${body%</testsuites>*}"
+      { printf '%s' "$body"; printf '%s' "$suite"; printf '</testsuites>\n'; } > "$OUTPUT_PATH"
+    else
+      { printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'; printf '%s' "$suite"; printf '</testsuites>\n'; } > "$OUTPUT_PATH"
+    fi
+  fi
+fi
+rm -f "$TEST_JSON" "$TEST_ERR" "$TEST_ERR".*
+exit $STATUS
