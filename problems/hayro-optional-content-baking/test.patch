@@ -0,0 +1,41 @@
+use crate::WORKSPACE_PATH;
+use crate::write_oc_0eadd0::{document, render, stream};
+use hayro_syntax::Pdf;
+
+fn assert_extracts_unchanged(data: Vec<u8>) {
+    let shown = render(data.clone());
+    let pdf = Pdf::new(data).unwrap();
+
+    let as_page = render(hayro_write::extract_pages_to_pdf(&pdf, &[0]));
+    assert!(
+        as_page == shown,
+        "extracted page differs from the source page"
+    );
+
+    let as_xobject = render(hayro_write::extract_pages_as_xobject_to_pdf(&pdf, &[0]));
+    assert!(
+        as_xobject == shown,
+        "extracted XObject differs from the source page"
+    );
+}
+
+#[test]
+fn page_without_optional_content_extracts_unchanged() {
+    assert_extracts_unchanged(
+        std::fs::read(WORKSPACE_PATH.join("pdfs/custom/clip_path_evenodd.pdf")).unwrap(),
+    );
+}
+
+#[test]
+fn marked_content_without_a_configuration_extracts_unchanged() {
+    assert_extracts_unchanged(document(&[
+        "<< /Type /Catalog /Pages 2 0 R >>".to_string(),
+        "<< /Type /Pages /Kids [3 0 R] /Count 1 >>".to_string(),
+        "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 60 60] /Contents 4 0 R /Resources << /Properties << /off 5 0 R >> >> >>".to_string(),
+        stream(
+            "",
+            "/OC /off BDC 1 0 0 rg 5 5 20 20 re f EMC 0 0 1 rg 30 30 20 20 re f",
+        ),
+        "<< /Type /OCG /Name (Hidden) >>".to_string(),
+    ]));
+}
