index 00000000..59cc2bb6
--- /dev/null
+++ b/hayro-write/src/optional_content.rs
@@ -0,0 +1,553 @@
+use crate::primitive::{WriteDirect, write_dict};
+use crate::{ExtractionContext, ResourceAlias, deflate_encode, serialize_resources};
+use hayro_syntax::Pdf;
+use hayro_syntax::content::{Instruction, UntypedIter};
+use hayro_syntax::object::dict::keys::{
+    BASE_STATE, CHAR_PROCS, D, DECODE_PARMS, EXT_G_STATE, FILTER, FONT, FORM, G, LENGTH, OC, OCGS,
+    OCMD, OCPROPERTIES, OFF, ON, P, PATTERN, PATTERN_TYPE, RESOURCES, SMASK, SUBTYPE, TYPE, TYPE3,
+    XOBJECT,
+};
+use hayro_syntax::object::{Array, Dict, Name, Object, ObjectIdentifier, Stream};
+use hayro_syntax::page::Resources;
+use pdf_writer::{Chunk, Filter, Finish, Ref};
+use rustc_hash::FxHashSet;
+use std::ops::Deref;
+use std::rc::Rc;
+
+const PAINTS: [&[u8]; 9] = [b"f", b"F", b"f*", b"S", b"s", b"B", b"B*", b"b", b"b*"];
+const SHOWS: [&[u8]; 4] = [b"Tj", b"TJ", b"'", b"\""];
+const STREAM_SKIP: [&[u8]; 4] = [LENGTH, FILTER, DECODE_PARMS, RESOURCES];
+
+pub(crate) struct OcConfig {
+    hidden: FxHashSet<ObjectIdentifier>,
+}
+
+impl OcConfig {
+    pub(crate) fn new(pdf: &Pdf) -> Option<Rc<Self>> {
+        let xref = pdf.xref();
+        let properties = xref
+            .get::<Dict<'_>>(xref.root_id())?
+            .get::<Dict<'_>>(OCPROPERTIES)?;
+        let config = properties.get::<Dict<'_>>(D)?;
+        let mut hidden = FxHashSet::default();
+
+        if config.get::<Name<'_>>(BASE_STATE).as_deref() == Some(OFF) {
+            hidden.extend(refs_in(&properties, OCGS));
+        }
+
+        for id in refs_in(&config, ON) {
+            hidden.remove(&id);
+        }
+
+        hidden.extend(refs_in(&config, OFF));
+
+        Some(Rc::new(Self { hidden }))
+    }
+
+    fn hides(&self, id: Option<ObjectIdentifier>, dict: &Dict<'_>) -> bool {
+        if dict.get::<Name<'_>>(TYPE).as_deref() != Some(OCMD) {
+            return id.is_some_and(|id| self.hidden.contains(&id));
+        }
+
+        let mut members = refs_in(dict, OCGS);
+        if let Some(single) = dict.get_ref(OCGS) {
+            members.push(single.into());
+        }
+
+        if members.is_empty() {
+            return false;
+        }
+
+        let off = |id: &ObjectIdentifier| self.hidden.contains(id);
+        let visible = match dict.get::<Name<'_>>(P).as_deref() {
+            Some(b"AllOn") => !members.iter().any(off),
+            Some(b"AnyOff") => members.iter().any(off),
+            Some(b"AllOff") => members.iter().all(off),
+            _ => !members.iter().all(off),
+        };
+
+        !visible
+    }
+
+    fn hides_entry(&self, dict: &Dict<'_>, key: &[u8]) -> bool {
+        dict.get::<Dict<'_>>(key)
+            .is_some_and(|oc| self.hides(dict.get_ref(key).map(Into::into), &oc))
+    }
+}
+
+fn refs_in(dict: &Dict<'_>, key: &[u8]) -> Vec<ObjectIdentifier> {
+    dict.get::<Array<'_>>(key)
+        .map(|array| {
+            array
+                .raw_iter()
+                .filter_map(|item| item.as_obj_ref().map(Into::into))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+fn lookup<'a, T>(
+    resources: &Resources<'a>,
+    select: impl Fn(&Resources<'a>) -> Option<T> + Copy,
+) -> Option<T> {
+    select(resources).or_else(|| resources.parent().and_then(|p| lookup(p, select)))
+}
+
+fn category<'r, 'a>(resources: &'r Resources<'a>, key: &[u8]) -> &'r Dict<'a> {
+    match key {
+        XOBJECT => &resources.x_objects,
+        PATTERN => &resources.patterns,
+        FONT => &resources.fonts,
+        _ => &resources.ext_g_states,
+    }
+}
+
+fn resolve_stream<'a>(resources: &Resources<'a>, key: &[u8], name: &[u8]) -> Option<Stream<'a>> {
+    lookup(resources, |r| category(r, key).get::<Stream<'a>>(name))
+}
+
+fn resolve_dict<'a>(resources: &Resources<'a>, key: &[u8], name: &[u8]) -> Option<Dict<'a>> {
+    lookup(resources, |r| category(r, key).get::<Dict<'a>>(name))
+}
+
+pub(crate) struct Baked {
+    pub(crate) content: Vec<u8>,
+    pub(crate) aliases: Vec<ResourceAlias>,
+}
+
+enum Action {
+    Keep,
+    Drop,
+    EndPath,
+    Invisible,
+    Replace(Vec<u8>),
+}
+
+struct Baker<'c, 'e> {
+    config: Rc<OcConfig>,
+    ctx: &'c mut ExtractionContext<'e>,
+    visibility: Vec<bool>,
+    render_modes: Vec<i64>,
+    render_mode: i64,
+    scope: usize,
+    aliases: Vec<ResourceAlias>,
+    changed: bool,
+}
+
+impl Baker<'_, '_> {
+    fn is_hidden(&self) -> bool {
+        self.visibility.last().copied().unwrap_or(false)
+    }
+
+    fn marked_content_hides(
+        &self,
+        instruction: &Instruction<'_, '_>,
+        resources: &Resources<'_>,
+    ) -> bool {
+        match instruction.operands().nth(1) {
+            Some(Object::Name(name)) => {
+                let properties = &resources.properties;
+                properties
+                    .get::<Dict<'_>>(name.deref())
+                    .is_some_and(|dict| {
+                        let id = properties.get_ref(name.deref()).map(Into::into);
+                        self.config.hides(id, &dict)
+                    })
+            }
+            Some(Object::Dict(props)) => {
+                let id = props.get_ref(OC).map(ObjectIdentifier::from);
+                let dict = match id {
+                    Some(id) => self.ctx.pdf.xref().get::<Dict<'_>>(id),
+                    None => props.get::<Dict<'_>>(OC),
+                };
+                dict.is_some_and(|dict| self.config.hides(id, &dict))
+            }
+            _ => false,
+        }
+    }
+
+    fn variant(
+        &mut self,
+        key: &'static [u8],
+        name: &[u8],
+        resources: &Resources<'_>,
+    ) -> Option<Ref> {
+        let cache_key = (self.scope, key, name.to_vec());
+        if let Some(variant) = self.ctx.variants.get(&cache_key) {
+            return *variant;
+        }
+
+        let ctx = &mut *self.ctx;
+        let variant = match key {
+            XOBJECT => resolve_stream(resources, key, name)
+                .filter(|s| s.dict().get::<Name<'_>>(SUBTYPE).as_deref() == Some(FORM))
+                .and_then(|s| write_stream_variant(ctx, &s, resources)),
+            PATTERN => resolve_stream(resources, key, name)
+                .filter(|s| s.dict().get::<u8>(PATTERN_TYPE) == Some(1))
+                .and_then(|s| write_stream_variant(ctx, &s, resources)),
+            FONT => resolve_dict(resources, key, name)
+                .filter(|d| d.get::<Name<'_>>(SUBTYPE).as_deref() == Some(TYPE3))
+                .and_then(|d| write_type3_variant(ctx, &d, resources)),
+            _ => resolve_dict(resources, key, name)
+                .and_then(|d| write_ext_g_state_variant(ctx, &self.config, &d, resources)),
+        };
+
+        self.ctx.variants.insert(cache_key, variant);
+
+        variant
+    }
+
+    fn select(
+        &mut self,
+        key: &'static [u8],
+        instruction: &Instruction<'_, '_>,
+        resources: &Resources<'_>,
+    ) -> Action {
+        let operands = instruction.operands().collect::<Vec<_>>();
+        let Some(name) = operands.iter().find_map(|o| match o {
+            Object::Name(name) => Some(name.to_vec()),
+            _ => None,
+        }) else {
+            return Action::Keep;
+        };
+        let Some(variant) = self.variant(key, &name, resources) else {
+            return Action::Keep;
+        };
+
+        let mut alias = format!("oc{}", variant.get()).into_bytes();
+        while lookup(resources, |r| {
+            category(r, key).get::<Object<'_>>(alias.as_slice())
+        })
+        .is_some()
+        {
+            alias.push(b'_');
+        }
+
+        if !self
+            .aliases
+            .iter()
+            .any(|(k, n, _)| *k == key && *n == alias)
+        {
+            self.aliases.push((key, alias.clone(), variant));
+        }
+
+        let mut out = b"\n".to_vec();
+        for operand in &operands {
+            match operand {
+                Object::Name(_) => {
+                    out.push(b'/');
+                    out.extend_from_slice(&alias);
+                }
+                Object::Number(n) => out.extend_from_slice(n.as_f64().to_string().as_bytes()),
+                _ => return Action::Keep,
+            }
+            out.push(b' ');
+        }
+        out.extend_from_slice(instruction.operator.deref());
+
+        Action::Replace(out)
+    }
+
+    fn classify(&mut self, instruction: &Instruction<'_, '_>, resources: &Resources<'_>) -> Action {
+        let hidden = self.is_hidden();
+        let operator = instruction.operator.deref();
+
+        match operator {
+            b"BDC" => {
+                let hides = hidden || self.marked_content_hides(instruction, resources);
+                self.visibility.push(hides);
+                Action::Keep
+            }
+            b"BMC" => {
+                self.visibility.push(hidden);
+                Action::Keep
+            }
+            b"EMC" => {
+                self.visibility.pop();
+                Action::Keep
+            }
+            b"q" => {
+                self.render_modes.push(self.render_mode);
+                Action::Keep
+            }
+            b"Q" => {
+                if let Some(mode) = self.render_modes.pop() {
+                    self.render_mode = mode;
+                }
+                Action::Keep
+            }
+            b"Tr" => {
+                if let Some(Object::Number(mode)) = instruction.operands().next() {
+                    self.render_mode = mode.as_f64() as i64;
+                }
+                Action::Keep
+            }
+            b"scn" | b"SCN" => self.select(PATTERN, instruction, resources),
+            b"Tf" => self.select(FONT, instruction, resources),
+            b"gs" => self.select(EXT_G_STATE, instruction, resources),
+            _ if hidden && PAINTS.contains(&operator) => Action::EndPath,
+            _ if hidden && SHOWS.contains(&operator) => Action::Invisible,
+            b"Do" | b"sh" | b"BI" if hidden => Action::Drop,
+            b"Do" => {
+                let hides = match instruction.operands().next() {
+                    Some(Object::Name(name)) => resolve_stream(resources, XOBJECT, name)
+                        .is_some_and(|s| self.config.hides_entry(s.dict(), OC)),
+                    _ => false,
+                };
+
+                if hides {
+                    Action::Drop
+                } else {
+                    self.select(XOBJECT, instruction, resources)
+                }
+            }
+            _ => Action::Keep,
+        }
+    }
+}
+
+fn bake_stream(
+    ctx: &mut ExtractionContext<'_>,
+    stream: &Stream<'_>,
+    resources: &Resources<'_>,
+) -> Option<Baked> {
+    let id = stream.obj_id();
+    if ctx.active_streams.contains(&id) {
+        return None;
+    }
+
+    let data = stream.decoded().ok()?;
+
+    ctx.active_streams.push(id);
+    let baked = bake(&data, resources, ctx);
+    ctx.active_streams.pop();
+
+    baked
+}
+
+fn write_stream_variant<'a>(
+    ctx: &mut ExtractionContext<'_>,
+    stream: &Stream<'a>,
+    parent: &Resources<'a>,
+) -> Option<Ref> {
+    let own = stream.dict().get::<Dict<'_>>(RESOURCES).unwrap_or_default();
+    let resources = Resources::from_parent(own, parent.clone());
+    let baked = bake_stream(ctx, stream, &resources)?;
+
+    Some(write_stream(ctx, stream, &resources, &baked))
+}
+
+fn write_stream(
+    ctx: &mut ExtractionContext<'_>,
+    stream: &Stream<'_>,
+    resources: &Resources<'_>,
+    baked: &Baked,
+) -> Ref {
+    let variant = ctx.new_ref();
+    let mut chunk = Chunk::with_settings(ctx.chunk_settings);
+    let encoded = deflate_encode(&baked.content);
+    let mut writer = chunk.stream(variant, &encoded);
+    writer.filter(Filter::FlateDecode);
+    write_dict(stream.dict(), &mut writer, ctx, &STREAM_SKIP);
+    serialize_resources(resources, ctx, &mut writer, &baked.aliases);
+    writer.finish();
+    ctx.chunks.push(chunk);
+
+    variant
+}
+
+fn write_type3_variant<'a>(
+    ctx: &mut ExtractionContext<'_>,
+    font: &Dict<'a>,
+    parent: &Resources<'a>,
+) -> Option<Ref> {
+    let procs = font.get::<Dict<'_>>(CHAR_PROCS)?;
+    let own = font.get::<Dict<'_>>(RESOURCES).unwrap_or_default();
+    let resources = Resources::from_parent(own, parent.clone());
+    let mut chunk = Chunk::with_settings(ctx.chunk_settings);
+    let mut aliases: Vec<ResourceAlias> = Vec::new();
+    let mut baked_procs = Vec::new();
+
+    for (name, _) in procs.entries() {
+        let Some(proc) = procs.get::<Stream<'_>>(name.deref()) else {
+            continue;
+        };
+        let proc_resources = match proc.dict().get::<Dict<'_>>(RESOURCES) {
+            Some(own) => Resources::from_parent(own, resources.clone()),
+            None => resources.clone(),
+        };
+        let Some(baked) = bake_stream(ctx, &proc, &proc_resources) else {
+            continue;
+        };
+
+        let proc_ref = ctx.new_ref();
+        let encoded = deflate_encode(&baked.content);
+        let mut writer = chunk.stream(proc_ref, &encoded);
+        writer.filter(Filter::FlateDecode);
+        write_dict(proc.dict(), &mut writer, ctx, &STREAM_SKIP[..3]);
+        writer.finish();
+
+        for alias in baked.aliases {
+            if !aliases.contains(&alias) {
+                aliases.push(alias);
+            }
+        }
+        baked_procs.push((name.to_vec(), proc_ref));
+    }
+
+    if baked_procs.is_empty() {
+        return None;
+    }
+
+    let variant = ctx.new_ref();
+    let mut dict = chunk.indirect(variant).dict();
+    write_dict(font, &mut dict, ctx, &[CHAR_PROCS, RESOURCES]);
+
+    let mut char_procs = dict.insert(pdf_writer::Name(CHAR_PROCS)).dict();
+    for (name, proc) in procs.entries() {
+        match baked_procs
+            .iter()
+            .find(|(n, _)| n.as_slice() == name.deref())
+        {
+            Some((_, proc_ref)) => {
+                char_procs.pair(pdf_writer::Name(name.deref()), *proc_ref);
+            }
+            None => proc.write_direct(char_procs.insert(pdf_writer::Name(name.deref())), ctx),
+        }
+    }
+    char_procs.finish();
+
+    serialize_resources(&resources, ctx, &mut dict, &aliases);
+    dict.finish();
+    ctx.chunks.push(chunk);
+
+    Some(variant)
+}
+
+fn write_ext_g_state_variant<'a>(
+    ctx: &mut ExtractionContext<'_>,
+    config: &OcConfig,
+    ext_g_state: &Dict<'a>,
+    parent: &Resources<'a>,
+) -> Option<Ref> {
+    let mask = ext_g_state.get::<Dict<'_>>(SMASK);
+    let group_ref = mask
+        .as_ref()
+        .and_then(|mask| mask.get::<Stream<'_>>(G))
+        .and_then(|group| {
+            if config.hides_entry(group.dict(), OC) {
+                let empty = Baked {
+                    content: Vec::new(),
+                    aliases: Vec::new(),
+                };
+                let resources = Resources::from_parent(Dict::default(), parent.clone());
+                Some(write_stream(ctx, &group, &resources, &empty))
+            } else {
+                write_stream_variant(ctx, &group, parent)
+            }
+        });
+
+    let font = ext_g_state.get::<Array<'_>>(FONT);
+    let font_ref = font
+        .as_ref()
+        .and_then(|font| font.iter::<Dict<'_>>().next())
+        .filter(|d| d.get::<Name<'_>>(SUBTYPE).as_deref() == Some(TYPE3))
+        .and_then(|d| write_type3_variant(ctx, &d, parent));
+
+    if group_ref.is_none() && font_ref.is_none() {
+        return None;
+    }
+
+    let mut skip = Vec::new();
+    skip.extend(group_ref.map(|_| SMASK));
+    skip.extend(font_ref.map(|_| FONT));
+
+    let variant = ctx.new_ref();
+    let mut chunk = Chunk::with_settings(ctx.chunk_settings);
+    let mut dict = chunk.indirect(variant).dict();
+    write_dict(ext_g_state, &mut dict, ctx, &skip);
+
+    if let (Some(mask), Some(group_ref)) = (&mask, group_ref) {
+        let mut mask_writer = dict.insert(pdf_writer::Name(SMASK)).dict();
+        write_dict(mask, &mut mask_writer, ctx, &[G]);
+        mask_writer.pair(pdf_writer::Name(G), group_ref);
+        mask_writer.finish();
+    }
+
+    if let (Some(font), Some(font_ref)) = (&font, font_ref) {
+        let mut font_writer = dict.insert(pdf_writer::Name(FONT)).array();
+        font_writer.item(font_ref);
+        for size in font.raw_iter().skip(1) {
+            size.write_direct(font_writer.push(), ctx);
+        }
+        font_writer.finish();
+    }
+
+    dict.finish();
+    ctx.chunks.push(chunk);
+
+    Some(variant)
+}
+
+pub(crate) fn bake(
+    data: &[u8],
+    resources: &Resources<'_>,
+    ctx: &mut ExtractionContext<'_>,
+) -> Option<Baked> {
+    let config = ctx.oc_config.clone()?;
+    ctx.oc_scopes += 1;
+    let mut baker = Baker {
+        config,
+        scope: ctx.oc_scopes,
+        ctx,
+        visibility: Vec::new(),
+        render_modes: Vec::new(),
+        render_mode: 0,
+        aliases: Vec::new(),
+        changed: false,
+    };
+    let mut out = Vec::with_capacity(data.len());
+    let mut iter = UntypedIter::new(data);
+    let mut start = 0;
+
+    while let Some(instruction) = iter.next() {
+        let action = baker.classify(&instruction, resources);
+        let end = iter.offset();
+        let segment = &data[start..end];
+        start = end;
+
+        match action {
+            Action::Keep => out.extend_from_slice(segment),
+            Action::Drop => {
+                out.push(b'\n');
+                baker.changed = true;
+            }
+            Action::EndPath => {
+                out.extend_from_slice(b"\nn");
+                baker.changed = true;
+            }
+            Action::Invisible => {
+                let invisible: &[u8] = if baker.render_mode >= 4 {
+                    b"\n7 Tr\n"
+                } else {
+                    b"\n3 Tr\n"
+                };
+                out.extend_from_slice(invisible);
+                out.extend_from_slice(segment);
+                out.extend_from_slice(format!("\n{} Tr", baker.render_mode).as_bytes());
+                baker.changed = true;
+            }
+            Action::Replace(replacement) => {
+                out.extend_from_slice(&replacement);
+                baker.changed = true;
+            }
+        }
+    }
+
+    out.extend_from_slice(&data[start..]);
+
+    baker.changed.then_some(Baked {
+        content: out,
+        aliases: baker.aliases,
+    })
+}
