+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="$2"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/junit-${MODE}.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+cd "$(dirname "$0")" || exit 1
+
+export PYTHONDONTWRITEBYTECODE=1
+export PYTHONHASHSEED=0
+export OMP_NUM_THREADS=1
+export OPENBLAS_NUM_THREADS=1
+export MKL_NUM_THREADS=1
+export MPLBACKEND=Agg
+export HOME="${HOME:-/tmp}"
+[ -w "$HOME" ] || export HOME=/tmp
+
+NEW_TESTS="tests/test_search_space_092a65.py"
+
+if [ "$MODE" = "new" ]; then
+  TARGETS=("$NEW_TESTS")
+else
+  TARGETS=(tests --ignore=tests/test_notebooks_run.py --ignore="$NEW_TESTS")
+fi
+
+LOG="$(mktemp)"
+rm -f "$OUTPUT_PATH"
+python -m pytest -p no:cacheprovider -q "${TARGETS[@]}" --junitxml="$OUTPUT_PATH" 2>&1 | tee "$LOG"
+STATUS=${PIPESTATUS[0]}
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q "<testcase" "$OUTPUT_PATH"; then
+  DIAG="$(tail -n 60 "$LOG" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')"
+  cat > "$OUTPUT_PATH" <<XMLEOF
+<?xml version="1.0" encoding="utf-8"?>
+<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0">
+<testcase classname="tests.collection" name="pytest_run"><failure message="pytest produced no test results">${DIAG}</failure></testcase>
+</testsuite></testsuites>
+XMLEOF
+  [ "$STATUS" -eq 0 ] && STATUS=1
+fi
+
+rm -f "$LOG"
+exit "$STATUS"
