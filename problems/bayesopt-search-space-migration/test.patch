+def warmed_optimizer(make_acquisition):
+    optimizer = make_optimizer(UNIT, f=scaled_sum, acquisition_function=make_acquisition())
+    register_all(optimizer, UNIT_POINTS)
+    for _ in range(3):
+        optimizer.probe(optimizer.suggest(), lazy=False)
+    optimizer.suggest()
+    optimizer.probe({"x": 0.3, "y": 0.3}, lazy=True)
+    return optimizer
