+from __future__ import annotations
+
+import numpy as np
+import pytest
+from scipy.optimize import NonlinearConstraint
+
+from bayes_opt import BayesianOptimization, acquisition
+from bayes_opt.domain_reduction import SequentialDomainReductionTransformer
+
+
+def numeric_sum(**kwargs):
+    return float(sum(v for v in kwargs.values() if not isinstance(v, str)))
+
+
+def scaled_sum(**kwargs):
+    return 10 * numeric_sum(**kwargs)
+
+
+def make_optimizer(pbounds, f=None, **kwargs):
+    kwargs.setdefault("random_state", 1)
+    kwargs.setdefault("verbose", 0)
+    return BayesianOptimization(f=f, pbounds=pbounds, **kwargs)
+
+
+def register_all(optimizer, points):
+    for target, params in points:
+        optimizer.register(params=params, target=target)
+
+
+def res_values(optimizer):
+    return [(float(r["target"]), dict(r["params"])) for r in optimizer.res]
+
+
+def assert_same_course(optimizer, twin, rounds=3):
+    assert optimizer.res == twin.res
+    assert optimizer.max == twin.max
+    for _ in range(rounds):
+        suggestion = optimizer.suggest()
+        assert suggestion == twin.suggest()
+        optimizer.probe(suggestion, lazy=False)
+        twin.probe(suggestion, lazy=False)
+    assert optimizer.res == twin.res
+
+
+MIXED = {"x": (0, 10), "c": ["a", "b", "c"]}
+MIXED_POINTS = [
+    (1.0, {"x": 1.0, "c": "a"}),
+    (2.0, {"x": 2.0, "c": "b"}),
+    (3.0, {"x": 3.0, "c": "c"}),
+    (4.0, {"x": 4.0, "c": "b"}),
+]
+UNIT = {"x": (0, 1), "y": (0, 1)}
+UNIT_POINTS = [(3.0, {"x": 0.1, "y": 0.2}), (12.0, {"x": 0.4, "y": 0.8}), (9.0, {"x": 0.9, "y": 0.3})]
+
+
+def test_added_parameter_takes_the_fill_value_for_every_point():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)})
+    register_all(optimizer, [(1.0, {"x": 1.0, "y": 2.0}), (5.0, {"x": 3.0, "y": 4.0})])
+    optimizer.set_space({"x": (0, 10), "y": (0, 10), "z": (-1, 1)}, fill={"z": 0.25})
+    assert res_values(optimizer) == [
+        (1.0, {"x": 1.0, "y": 2.0, "z": 0.25}),
+        (5.0, {"x": 3.0, "y": 4.0, "z": 0.25}),
+    ]
+    assert optimizer.max["params"] == {"x": 3.0, "y": 4.0, "z": 0.25}
+
+
+def test_new_pbounds_order_becomes_the_parameter_order():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)})
+    register_all(optimizer, [(1.0, {"x": 1.0, "y": 2.0}), (3.0, {"x": 6.0, "y": 5.0})])
+    optimizer.set_space({"y": (0, 10), "w": (0, 5), "x": (0, 10)}, fill={"w": 4.0})
+    assert [list(r["params"].items()) for r in optimizer.res] == [
+        [("y", 2.0), ("w", 4.0), ("x", 1.0)],
+        [("y", 5.0), ("w", 4.0), ("x", 6.0)],
+    ]
+    suggestion = optimizer.suggest()
+    assert list(suggestion) == ["y", "w", "x"]
+    assert 0 <= suggestion["w"] <= 5
+
+
+def test_removed_parameter_disappears_from_every_point():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10), "z": (0, 10)})
+    register_all(optimizer, [(1.0, {"x": 1.0, "y": 2.0, "z": 3.0}), (2.0, {"x": 4.0, "y": 5.0, "z": 6.0})])
+    optimizer.set_space({"x": (0, 10), "z": (0, 10)})
+    assert res_values(optimizer) == [(1.0, {"x": 1.0, "z": 3.0}), (2.0, {"x": 4.0, "z": 6.0})]
+    assert set(optimizer.suggest()) == {"x", "z"}
+
+
+def test_removed_category_drops_the_points_that_used_it():
+    optimizer = make_optimizer(MIXED)
+    register_all(optimizer, MIXED_POINTS)
+    optimizer.set_space({"x": (0, 10), "c": ["a", "c"]})
+    assert res_values(optimizer) == [(1.0, {"x": 1.0, "c": "a"}), (3.0, {"x": 3.0, "c": "c"})]
+    assert optimizer.max == {"target": 3.0, "params": {"x": 3.0, "c": "c"}}
+
+
+def test_reordered_categories_keep_each_points_category():
+    optimizer = make_optimizer(MIXED)
+    register_all(optimizer, MIXED_POINTS)
+    optimizer.set_space({"x": (0, 10), "c": ["c", "a", "b"]})
+    assert res_values(optimizer) == [(t, p) for t, p in MIXED_POINTS]
+
+
+def test_added_category_keeps_existing_points():
+    optimizer = make_optimizer(MIXED)
+    register_all(optimizer, MIXED_POINTS)
+    optimizer.set_space({"c": ["a", "d", "b", "c"], "x": (0, 10)})
+    assert res_values(optimizer) == [(t, {"c": p["c"], "x": p["x"]}) for t, p in MIXED_POINTS]
+    assert optimizer.suggest()["c"] in ["a", "d", "b", "c"]
+
+
+def test_float_retyped_to_integer_rounds_each_value():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 1)})
+    register_all(optimizer, [(1.0, {"x": 2.7, "y": 0.5}), (2.0, {"x": 6.2, "y": 0.1})])
+    optimizer.set_space({"x": (0, 10, int), "y": (0, 1)})
+    assert res_values(optimizer) == [(1.0, {"x": 3, "y": 0.5}), (2.0, {"x": 6, "y": 0.1})]
+    assert all(isinstance(r["params"]["x"], int) for r in optimizer.res)
+
+
+def test_values_that_round_together_keep_the_earliest_point():
+    calls = []
+
+    def target(x, y):
+        calls.append((x, y))
+        return 50.0
+
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 1)}, f=target)
+    register_all(
+        optimizer, [(1.0, {"x": 2.7, "y": 0.5}), (2.0, {"x": 3.2, "y": 0.5}), (3.0, {"x": 6.2, "y": 0.5})]
+    )
+    optimizer.set_space({"x": (0, 10, int), "y": (0, 1)})
+    assert res_values(optimizer) == [(1.0, {"x": 3, "y": 0.5}), (3.0, {"x": 6, "y": 0.5})]
+    optimizer.probe({"x": 3, "y": 0.5}, lazy=False)
+    assert calls == []
+    assert len(optimizer.res) == 2
+
+
+def test_integer_retyped_to_categorical_keeps_matching_values_only():
+    optimizer = make_optimizer({"n": (0, 5, int), "y": (0, 1)})
+    register_all(optimizer, [(1.0, {"n": 1, "y": 0.2}), (2.0, {"n": 3, "y": 0.4}), (3.0, {"n": 4, "y": 0.6})])
+    optimizer.set_space({"n": [4, 1, 2], "y": (0, 1)})
+    assert res_values(optimizer) == [(1.0, {"n": 1, "y": 0.2}), (3.0, {"n": 4, "y": 0.6})]
+
+
+def test_categorical_retyped_to_float_keeps_numeric_categories_only():
+    optimizer = make_optimizer({"c": [0.5, "auto", 2.5], "y": (0, 1)})
+    register_all(
+        optimizer, [(1.0, {"c": 0.5, "y": 0.2}), (2.0, {"c": "auto", "y": 0.4}), (3.0, {"c": 2.5, "y": 0.6})]
+    )
+    optimizer.set_space({"c": (0, 3), "y": (0, 1)})
+    assert res_values(optimizer) == [(1.0, {"c": 0.5, "y": 0.2}), (3.0, {"c": 2.5, "y": 0.6})]
+
+
+def test_points_outside_the_new_bounds_are_kept_but_do_not_count_for_max():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)})
+    register_all(optimizer, [(9.0, {"x": 8.0, "y": 1.0}), (3.0, {"x": 2.0, "y": 1.0})])
+    optimizer.set_space({"x": (0, 5), "y": (0, 10), "z": (0, 1)}, fill={"z": 1.0})
+    assert res_values(optimizer) == [
+        (9.0, {"x": 8.0, "y": 1.0, "z": 1.0}),
+        (3.0, {"x": 2.0, "y": 1.0, "z": 1.0}),
+    ]
+    assert optimizer.max == {"target": 3.0, "params": {"x": 2.0, "y": 1.0, "z": 1.0}}
+
+
+def test_points_that_coincide_after_a_removal_keep_the_earliest():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)})
+    register_all(
+        optimizer, [(5.0, {"x": 1.0, "y": 1.0}), (7.0, {"x": 2.0, "y": 1.0}), (9.0, {"x": 1.0, "y": 3.0})]
+    )
+    optimizer.set_space({"x": (0, 10)})
+    assert res_values(optimizer) == [(5.0, {"x": 1.0}), (7.0, {"x": 2.0})]
+    assert optimizer.max["target"] == 7.0
+
+
+def test_points_that_coincide_are_all_kept_when_duplicates_are_allowed():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)}, allow_duplicate_points=True)
+    register_all(
+        optimizer, [(5.0, {"x": 1.0, "y": 1.0}), (7.0, {"x": 2.0, "y": 1.0}), (9.0, {"x": 1.0, "y": 3.0})]
+    )
+    optimizer.set_space({"x": (0, 10)})
+    assert res_values(optimizer) == [(5.0, {"x": 1.0}), (7.0, {"x": 2.0}), (9.0, {"x": 1.0})]
+
+
+def mixed_with_queue():
+    optimizer = make_optimizer(MIXED, f=numeric_sum)
+    register_all(optimizer, MIXED_POINTS)
+    optimizer.probe({"x": 5.0, "c": "a"}, lazy=True)
+    optimizer.probe({"x": 6.0, "c": "c"}, lazy=True)
+    return optimizer
+
+
+def test_missing_fill_value_raises_and_changes_nothing():
+    optimizer = mixed_with_queue()
+    twin = mixed_with_queue()
+    with pytest.raises(ValueError):
+        optimizer.set_space({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1)})
+    optimizer.maximize(init_points=0, n_iter=0)
+    twin.maximize(init_points=0, n_iter=0)
+    assert_same_course(optimizer, twin)
+
+
+@pytest.mark.parametrize(
+    ("pbounds", "fill"),
+    [
+        ({"x": (0, 10), "c": ["a", "b", "c"], "d": ["p", "q"]}, {"d": "r"}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1)}, {"z": 2.0}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1)}, {"z": "high"}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1)}, {"z": 0.5, "x": 1.0}),
+        ({"x": (0, 10), "c": ["a", "b"]}, {"c": "a"}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "n": (0, 3, int)}, {"n": 5}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "n": (0, 3, int)}, {"n": "two"}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1)}, {"z": 1 + 1j}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "n": (0, 3, int)}, {"n": 2 + 0j}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1), "n": (0, 3, int)}, {"z": 0.5}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "n": (0, 3, int)}, {"n": float("inf")}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "n": (0, 3, int)}, {"n": float("-inf")}),
+        ({"x": (0, 10), "c": ["a", "b", "c"], "z": (0, 1)}, {"z": float("nan")}),
+        ({"x": (0, 10), "c": ["only"]}, None),
+    ],
+)
+def test_an_unusable_fill_or_definition_raises_and_changes_nothing(pbounds, fill):
+    optimizer = mixed_with_queue()
+    twin = mixed_with_queue()
+    with pytest.raises(ValueError):
+        optimizer.set_space(pbounds, fill=fill)
+    optimizer.maximize(init_points=0, n_iter=0)
+    twin.maximize(init_points=0, n_iter=0)
+    assert_same_course(optimizer, twin)
+
+
+def test_constraint_values_stay_with_their_points():
+    constraint = NonlinearConstraint(lambda x, y: x + y, -np.inf, 5.0)
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)}, constraint=constraint)
+    optimizer.register({"x": 1.0, "y": 1.0}, target=5.0, constraint_value=2.0)
+    optimizer.register({"x": 2.0, "y": 8.0}, target=9.0, constraint_value=10.0)
+    optimizer.register({"x": 1.0, "y": 3.0}, target=7.0, constraint_value=3.5)
+    optimizer.register({"x": 3.0, "y": 1.0}, target=6.0, constraint_value=4.0)
+    optimizer.set_space({"x": (0, 10)})
+    assert [(r["target"], r["params"], r["constraint"], bool(r["allowed"])) for r in optimizer.res] == [
+        (5.0, {"x": 1.0}, 2.0, True),
+        (9.0, {"x": 2.0}, 10.0, False),
+        (6.0, {"x": 3.0}, 4.0, True),
+    ]
+    assert optimizer.max == {"target": 6.0, "params": {"x": 3.0}, "constraint": 4.0}
+
+
+def test_probing_a_carried_point_does_not_evaluate_it_again():
+    calls = []
+
+    def target(x, z):
+        calls.append((x, z))
+        return 100.0
+
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)}, f=target)
+    register_all(optimizer, [(1.5, {"x": 1.0, "y": 7.0})])
+    optimizer.set_space({"x": (0, 10), "z": (0, 3, int)}, fill={"z": 2})
+    optimizer.probe({"x": 1.0, "z": 2}, lazy=False)
+    assert calls == []
+    assert res_values(optimizer) == [(1.5, {"x": 1.0, "z": 2})]
+    optimizer.probe({"x": 1.0, "z": 1}, lazy=False)
+    assert calls == [(1.0, 1)]
+    assert res_values(optimizer) == [(1.5, {"x": 1.0, "z": 2}), (100.0, {"x": 1.0, "z": 1})]
+
+
+def test_probing_a_carried_constrained_point_does_not_evaluate_it_again():
+    calls = []
+
+    def limit(x, c):
+        calls.append((x, c))
+        return x
+
+    constraint = NonlinearConstraint(limit, -np.inf, 5.0)
+    optimizer = make_optimizer({"x": (0, 10), "c": ["a", "b"]}, f=numeric_sum, constraint=constraint)
+    optimizer.register({"x": 1.0, "c": "b"}, target=5.0, constraint_value=2.0)
+    optimizer.set_space({"c": ["b", "a"], "x": (0, 10)})
+    optimizer.probe({"x": 1.0, "c": "b"}, lazy=False)
+    assert calls == []
+    assert [(r["target"], r["params"], r["constraint"]) for r in optimizer.res] == [
+        (5.0, {"c": "b", "x": 1.0}, 2.0)
+    ]
+
+
+def test_queued_probes_are_carried_into_the_new_space():
+    optimizer = make_optimizer(MIXED, f=numeric_sum)
+    optimizer.probe({"x": 1.0, "c": "a"}, lazy=True)
+    optimizer.probe({"x": 2.0, "c": "b"}, lazy=True)
+    optimizer.probe({"x": 3.0, "c": "c"}, lazy=True)
+    optimizer.set_space({"c": ["c", "a"], "x": (0, 10), "k": (0, 5, int)}, fill={"k": 4})
+    optimizer.maximize(init_points=0, n_iter=0)
+    assert res_values(optimizer) == [(5.0, {"c": "a", "x": 1.0, "k": 4}), (7.0, {"c": "c", "x": 3.0, "k": 4})]
+
+
+def test_suggest_works_in_the_new_space():
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)})
+    register_all(
+        optimizer, [(1.0, {"x": 1.0, "y": 2.0}), (4.0, {"x": 3.0, "y": 7.0}), (2.0, {"x": 8.0, "y": 5.0})]
+    )
+    optimizer.set_space({"y": (0, 10), "c": ["p", "q", "r"]}, fill={"c": "q"})
+    suggestion = optimizer.suggest()
+    assert set(suggestion) == {"y", "c"}
+    assert 0 <= suggestion["y"] <= 10
+    assert suggestion["c"] in ["p", "q", "r"]
+
+
+def test_constrained_suggest_works_in_the_new_space():
+    constraint = NonlinearConstraint(lambda x, z: x - z, -np.inf, 4.0)
+    optimizer = make_optimizer({"x": (0, 10), "y": (0, 10)}, constraint=constraint)
+    optimizer.register({"x": 1.0, "y": 1.0}, target=1.0, constraint_value=0.0)
+    optimizer.register({"x": 6.0, "y": 2.0}, target=3.0, constraint_value=5.0)
+    optimizer.register({"x": 3.0, "y": 8.0}, target=2.0, constraint_value=3.0)
+    optimizer.set_space({"x": (0, 10), "z": (0, 2)}, fill={"z": 1.0})
+    suggestion = optimizer.suggest()
+    assert set(suggestion) == {"x", "z"}
+    assert 0 <= suggestion["x"] <= 10
+    assert 0 <= suggestion["z"] <= 2
+
+
+def unit_optimizer(make_acquisition):
+    optimizer = make_optimizer(UNIT, f=scaled_sum, acquisition_function=make_acquisition())
+    register_all(optimizer, UNIT_POINTS)
+    optimizer.suggest()
+    return optimizer
+
+
+def liar():
+    return acquisition.ConstantLiar(acquisition.UpperConfidenceBound())
+
+
+def hedge():
+    return acquisition.GPHedge([acquisition.UpperConfidenceBound(), acquisition.ExpectedImprovement(xi=0.01)])
+
+
+def liar_over_hedge():
+    return acquisition.ConstantLiar(hedge())
+
+
+@pytest.mark.parametrize("make_acquisition", [liar, hedge, liar_over_hedge])
+def test_acquisition_state_survives_an_undone_parameter_addition(make_acquisition):
+    optimizer = unit_optimizer(make_acquisition)
+    twin = unit_optimizer(make_acquisition)
+    for queued in (optimizer, twin):
+        queued.probe({"x": 0.7, "y": 0.1}, lazy=True)
+        queued.probe({"x": 0.2, "y": 0.9}, lazy=True)
+    optimizer.set_space({"y": (0, 1), "z": (0, 2), "x": (0, 1)}, fill={"z": 1.5})
+    optimizer.set_space(UNIT)
+    optimizer.maximize(init_points=0, n_iter=0)
+    twin.maximize(init_points=0, n_iter=0)
+    assert_same_course(optimizer, twin)
+
+
+@pytest.mark.parametrize("make_acquisition", [liar, hedge, liar_over_hedge])
+def test_acquisition_state_survives_an_undone_bounds_change(make_acquisition):
+    optimizer = unit_optimizer(make_acquisition)
+    twin = unit_optimizer(make_acquisition)
+    for queued in (optimizer, twin):
+        queued.probe({"x": 0.8, "y": 0.1}, lazy=True)
+        queued.probe({"x": 0.2, "y": 0.9}, lazy=True)
+    optimizer.set_space({"y": (-1, 1), "x": (0, 0.5)})
+    optimizer.set_space(UNIT)
+    optimizer.maximize(init_points=0, n_iter=0)
+    twin.maximize(init_points=0, n_iter=0)
+    assert_same_course(optimizer, twin)
+
+
+@pytest.mark.parametrize("make_acquisition", [liar, hedge, liar_over_hedge])
+def test_acquisition_suggests_after_a_categorical_parameter_is_added(make_acquisition):
+    optimizer = unit_optimizer(make_acquisition)
+    optimizer.set_space({"x": (0, 1), "y": (0, 1), "c": ["p", "q", "r"]}, fill={"c": "r"})
+    for _ in range(3):
+        suggestion = optimizer.suggest()
+        assert set(suggestion) == {"x", "y", "c"}
