     return (thisref, thisstart, thistlen)
 
+
+@cython.cfunc
+def bampe_origin_pair_parse(data: cython.pointer[cython.const[cython.uchar]],
+                            circular_rlengths: dict,
+                            endian_prefix=endian_prefix) -> tuple:
+    """Parse a BAMPE record whose pair spans the origin of a circular
+    chromosome.
+
+    Such a pair is a minus strand read near the start of the
+    chromosome whose plus strand mate sits near the end. The fragment
+    starts at the mate and runs past the chromosome length to the end
+    of this read.
+    """
+    thisref: cython.int
+    nextref: cython.int
+    pos: cython.int
+    nextpos: cython.int
+    thisend: cython.int
+    rlength: cython.int
+    l_read_name: cython.int
+    n_cigar_op: cython.int
+    bwflag: cython.ushort
+
+    if not data:
+        return (-1, -1, -1)
+
+    bwflag = unpack(endian_prefix+'H', data[14:16])[0]
+    if (bwflag & 3868) != 16 or not bwflag & 1:
+        return (-1, -1, -1)
+
+    (thisref, pos) = unpack(endian_prefix+'ii', data[0:8])
+    (nextref, nextpos) = unpack(endian_prefix+'ii', data[20:28])
+    if thisref != nextref or thisref not in circular_rlengths or nextpos <= pos:
+        return (-1, -1, -1)
+    rlength = circular_rlengths[thisref]
+
+    l_read_name = data[8]
+    n_cigar_op = unpack(endian_prefix+'H', data[12:14])[0]
+    thisend = pos
+    for cigar_code in unpack(endian_prefix+'%dI' % (n_cigar_op),
+                             data[32 + l_read_name: 32 + l_read_name + n_cigar_op*4]):
+        if cigar_code & 15 in [0, 2, 3, 7, 8]:
+            thisend += cigar_code >> 4
+    if thisend + rlength - nextpos > rlength // 2:
+        return (-1, -1, -1)
+    return (thisref, nextpos, thisend + rlength - nextpos)
+
