+    @cython.cfunc
+    def __chrom_locations(self, chrom: bytes) -> list:
+        """Return plus and minus tag positions of a chromosome.
+
+        A circular chromosome is rotated so that the middle of its
+        widest tag-free stretch becomes position 0, which keeps peaks
+        crossing the origin in one piece.
+        """
+        plus_tags: cnp.ndarray
+        minus_tags: cnp.ndarray
+        tags: cnp.ndarray
+        gaps: cnp.ndarray
+        rlength: cython.long
+        shift: cython.long
+        i: cython.long
