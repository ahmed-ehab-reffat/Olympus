+    @cython.cfunc
+    def __rotate_circular_regions(self,
+                                  chrom: bytes,
+                                  above_cutoff: cnp.ndarray,
+                                  startpos: cnp.ndarray,
+                                  endpos: cnp.ndarray,
+                                  indices: cnp.ndarray,
+                                  max_gap: cython.int) -> tuple:
+        """*private* Reorder above-cutoff regions of a circular
+        chromosome so that a run crossing the origin is contiguous.
+
+        Regions of the run that sit before the chromosome end are moved
+        to the front with coordinates shifted by minus the chromosome
+        length. Linear chromosomes are returned unchanged.
+        """
+        rlength: cython.long
+        n: cython.long
+        k: cython.long
+
+        rlength = self.circular_lengths.get(chrom, 0)
+        n = startpos.shape[0]
+        if rlength == 0 or n < 2:
+            return (startpos, endpos, indices)
+        if above_cutoff[0] == 0:
+            startpos[0] = 0
+        if rlength - endpos[n-1] + startpos[0] > max_gap:
+            return (startpos, endpos, indices)
+        k = n - 1
+        while k > 0 and startpos[k] - endpos[k-1] <= max_gap:
+            k -= 1
+        if k == 0:
+            return (startpos, endpos, indices)
+        startpos = np.concatenate((startpos[k:] - rlength, startpos[:k])).astype("i4")
+        endpos = np.concatenate((endpos[k:] - rlength, endpos[:k])).astype("i4")
+        indices = np.concatenate((indices[k:], indices[:k])).astype("i4")
+        return (startpos, endpos, indices)
+
