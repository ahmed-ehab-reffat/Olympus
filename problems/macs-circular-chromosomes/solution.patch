+    def __origin_offset(self, chrom: bytes, start: cython.long) -> cython.long:
+        """*private* Offset that moves a peak starting before the origin
+        of a circular chromosome back into [0, length)."""
+        if start < 0:
+            return self.circular_lengths[chrom]
+        return 0
