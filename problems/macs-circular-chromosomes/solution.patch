+@cython.cfunc
+def wrap_circular_ranges(start_poss: cnp.ndarray,
+                         end_poss: cnp.ndarray,
+                         rlength: cython.int) -> tuple:
+    """Fold ranges crossing the origin of a circular chromosome.
+
+    Each range is moved so its start falls in [0, rlength). A range
+    that then runs past rlength is split into [start, rlength) and
+    [0, end - rlength). Returned arrays are sorted.
+    """
+    lengths: cnp.ndarray
+    over: cnp.ndarray
+    new_starts: cnp.ndarray
+    new_ends: cnp.ndarray
+
+    lengths = end_poss - start_poss
+    lengths[lengths > rlength] = rlength
+    new_starts = np.mod(start_poss, rlength).astype("i4")
+    new_ends = (new_starts + lengths).astype("i4")
+    over = new_ends > rlength
+    if np.any(over):
+        new_starts = np.concatenate((new_starts,
+                                     np.zeros(np.count_nonzero(over),
+                                              dtype="i4")))
+        new_ends = np.concatenate((new_ends, new_ends[over] - rlength))
+        new_ends[:over.shape[0]][over] = rlength
+    new_starts.sort()
+    new_ends.sort()
+    return (new_starts, new_ends)
+
+
+@cython.cfunc
+def extend_to_rlength(pv: list,
+                      rlength: cython.int,
+                      baseline_value: cython.float) -> list:
+    """Extend a legacy [p, v] pileup of a circular chromosome so that it
+    covers the chromosome up to its length."""
+    if pv[0].shape[0] > 0 and pv[0][-1] >= rlength:
+        return pv
+    return [np.append(pv[0], rlength).astype("i4"),
+            np.append(pv[1], max(baseline_value, 0.0)).astype("f4")]
+
