+        if chrom not in self.circular_lengths:
+            return [plus_tags, minus_tags]
+        rlength = self.circular_lengths[chrom]
+        tags = np.sort(np.concatenate((plus_tags, minus_tags)))
+        if tags.shape[0] < 2:
+            return [plus_tags, minus_tags]
+        gaps = np.diff(np.append(tags, tags[0] + rlength))
+        i = np.argmax(gaps)
+        shift = rlength - (tags[i] + gaps[i] // 2) % rlength
+        plus_tags = np.sort((plus_tags.astype("i8") + shift) % rlength).astype("i4")
+        minus_tags = np.sort((minus_tags.astype("i8") + shift) % rlength).astype("i4")
+        return [plus_tags, minus_tags]
