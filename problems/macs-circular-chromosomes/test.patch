+def test_linear_chromosomes_keep_their_ends(tmp_path):
+    rng = np.random.default_rng(8)
+    chroms = [("chrA", L), ("chr1", L)]
+    lengths = {0: L, 1: L}
+    treat = background_reads(rng, 0, 400, L) + background_reads(rng, 1, 400, L)
+    treat += site_reads(rng, 0, 0, 80, L) + site_reads(rng, 0, 10000, 80, L)
+    treat += site_reads(rng, 1, 0, 80, L)
+    ctrl = background_reads(rng, 0, 600, L) + background_reads(rng, 1, 600, L)
+    treat, ctrl = valid_se(treat, lengths), valid_se(ctrl, lengths)
+    run_callpeak(tmp_path, "lin", chroms, treat, ctrl,
+                 extra=["--nomodel", "--extsize", str(FRAG), "-p", "0.00001"])
+    run_callpeak(tmp_path, "circ", chroms, treat, ctrl,
+                 extra=BASE_ARGS + ["-p", "0.00001"])
+
+    def chr_a(name):
+        return [(r[1], r[2], r[6], r[7], r[9])
+                for r in read_rows(outputs(tmp_path, name + "_peaks.narrowPeak"))
+                if r[0] == "chrA"]
+    assert chr_a("circ") == chr_a("lin")
+    assert all(int(r[2]) <= L for r in read_rows(outputs(tmp_path, "circ_peaks.narrowPeak"))
+               if r[0] == "chrA")
