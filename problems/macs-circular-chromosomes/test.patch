+    run_callpeak(tmp_path, "lin", chroms, treat, ctrl,
+                 extra=["--nomodel", "--extsize", str(FRAG), "-p", "0.00001", "-B"])
+    run_callpeak(tmp_path, "circ", chroms, treat, ctrl,
+                 extra=BASE_ARGS + ["-p", "0.00001", "-B"])
+    expected = np.zeros(L)
+    for ref, five, strand in treat:
+        if ref == 0:
+            start = five if strand == 0 else five - FRAG
+            expected[max(start, 0):min(start + FRAG, L)] += 1
+    got = np.full(L, np.nan)
+    for r in read_rows(outputs(tmp_path, "circ_treat_pileup.bdg")):
