+def test_circular_needs_chromosome_lengths_from_bam(tmp_path):
+    lengths, treat, ctrl = site_dataset()
+    bed = os.path.join(str(tmp_path), "t.bed")
+    with open(bed, "w") as f:
+        for _, five, strand in treat:
+            start = five if strand == 0 else five - RL
+            f.write("chr1\t%d\t%d\tr\t0\t%s\n" % (start, start + RL, "+-"[strand]))
+    proc = subprocess.run(MACS3 + ["callpeak", "-t", bed, "-f", "BED", "-g", str(L),
+                                   "-n", "bed", "--outdir", str(tmp_path),
+                                   "--nomodel", "--circular", "chr1"],
+                          capture_output=True, text=True, cwd=str(tmp_path))
+    assert proc.returncode != 0
+    assert not os.path.exists(outputs(tmp_path, "bed_peaks.narrowPeak"))
+    run_callpeak(tmp_path, "bam", CHROMS, treat, ctrl, extra=BASE_ARGS)
+    assert os.path.exists(outputs(tmp_path, "bam_peaks.narrowPeak"))
