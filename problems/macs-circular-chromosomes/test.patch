+            rows[name] = [r for r in read_rows(outputs(tmp_path, "%s_%s.bdg" % (name, track)))
+                          if r[0] == "chrA"]
+        assert rows["circ"] == rows["lin"]
+    covered = ~np.isnan(got)
+    assert covered[:FRAG].all() and covered[L - FRAG:].all()
+    scale = min(1.0, len(ctrl) / len(treat))
+    assert np.allclose(got[covered], expected[covered] * scale, rtol=1e-4, atol=1e-4)
