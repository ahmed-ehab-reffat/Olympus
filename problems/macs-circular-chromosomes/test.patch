+    lam = np.full(L, len(treat) * FRAG / L)
+    for window in (FRAG, 1000, 10000):
+        cover = np.zeros(L)
+        for _, five, strand in ctrl:
+            if strand == 0:
+                start = five - window // 2
+            else:
+                start = five - (window - window // 2)
+            cover[np.arange(start, start + window) % L] += 1
