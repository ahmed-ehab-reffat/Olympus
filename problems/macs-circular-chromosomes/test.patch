+def write_text_input(path, fmt, treat):
+    with open(path, "w") as f:
+        if fmt == "SAM":
+            f.write("@HD\tVN:1.6\n@SQ\tSN:chr1\tLN:%d\n" % L)
+        for i, (_, five, strand) in enumerate(treat):
+            start = five if strand == 0 else five - RL
+            if fmt == "BED":
+                f.write("chr1\t%d\t%d\tr\t0\t%s\n" % (start, start + RL, "+-"[strand]))
+            elif fmt == "BEDPE":
+                f.write("chr1\t%d\t%d\n" % (start, start + FRAG))
+            elif fmt == "FRAG":
+                f.write("chr1\t%d\t%d\tAAACCTGAGAAACCAT\t1\n" % (start, start + FRAG))
+            else:
+                f.write("r%d\t%d\tchr1\t%d\t60\t%dM\t*\t0\t0\t%s\t%s\n"
+                        % (i, 16 * strand, start + 1, RL, "A" * RL, "I" * RL))
