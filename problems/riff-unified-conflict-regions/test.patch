+            "+int x = [compute2](a, b[, c]);",
+            " log(\"x main\");",
+            "-[=======]",
+            "-int x = [compute](a, b, c);",
+            "-log(\"x [side]\");",
+            "-[>>>>>>> 4841270 (side)]",
+            " mid",
+            " return x;",
+            " tail",
+        ],
+    );
+    assert_unstyled(RESOLVED_KEPT_LINE, " log(\"x main\");");
