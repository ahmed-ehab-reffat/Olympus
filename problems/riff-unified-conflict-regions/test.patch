+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+cd "$(dirname "$0")"
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+NEW_TEST_FILE="tests/conflict_regions_119021.rs"
+TEST_JSON="$(mktemp)"
+TEST_ERR="$(mktemp)"
+STATUS=0
+case "$MODE" in
+  base) cargo test --bin riff -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"; STATUS=$? ;;
+  new)  cargo test --test conflict_regions_119021 -- -Z unstable-options --format json --report-time > "$TEST_JSON" 2> "$TEST_ERR"; STATUS=$? ;;
+esac
+cat "$TEST_ERR" >&2
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+  : > "$OUTPUT_PATH"
+  if grep -q '"type": *"test"' "$TEST_JSON"; then
+    cargo2junit < "$TEST_JSON" > "$OUTPUT_PATH" 2>> "$TEST_ERR" || true
+    sed -i -e 's/::/./g' -e 's/classname=""/classname="conflict_regions_119021"/g' "$OUTPUT_PATH"
+  fi
+  if ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+    [ "$STATUS" -eq 0 ] && STATUS=1
+    log=$( { cat "$TEST_ERR"; cat "$TEST_JSON"; } | tail -c 4000 | sed -e 's/]]>/]]]]><![CDATA[>/g')
+    cases=""
+    count=0
+    if [ "$MODE" = "new" ]; then
+      for name in $(grep -A1 '#\[test\]' "$NEW_TEST_FILE" | grep -oE 'fn [a-z0-9_]+' | awk '{print $2}'); do
+        count=$((count + 1))
+        cases="${cases}    <testcase name=\"${name}\" classname=\"conflict_regions_119021\"><failure message=\"cargo test did not run\"><![CDATA[${log}]]></failure></testcase>
+"
+      done
+    fi
+    if [ "$count" -eq 0 ]; then
+      count=1
+      cases="    <testcase name=\"compilation\" classname=\"cargo-test\"><failure message=\"cargo test did not run\"><![CDATA[${log}]]></failure></testcase>
+"
+    fi
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites>\n'
+      printf '  <testsuite name="cargo test" tests="%s" failures="%s" errors="0">\n' "$count" "$count"
+      printf '%s' "$cases"
+      printf '  </testsuite>\n</testsuites>\n'
+    } > "$OUTPUT_PATH"
+  fi
+fi
+
+rm -f "$TEST_JSON" "$TEST_ERR"
+exit $STATUS
