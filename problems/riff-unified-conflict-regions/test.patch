+#![allow(clippy::needless_return)]
+
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+#[derive(Clone, Debug, Default, PartialEq)]
+struct Look {
+    foreground: String,
+    background: String,
+    weight: u8,
+    inverse: bool,
+}
+
+type Cell = (char, Look);
+
+fn run_riff(input: &str) -> String {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_riff"))
+        .args(["--color=on", "--no-pager"])
+        .env_remove("RIFF")
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("riff should start");
+    let mut stdin = child.stdin.take().unwrap();
+    let input = input.to_string();
+    let writer = std::thread::spawn(move || {
+        stdin.write_all(input.as_bytes()).unwrap();
+    });
+    let output = child.wait_with_output().unwrap();
+    writer.join().unwrap();
+    assert!(
+        output.status.success(),
+        "riff failed: {}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    return String::from_utf8(output.stdout).unwrap();
+}
+
+fn apply_sgr(look: &mut Look, parameters: &str) {
+    let codes: Vec<&str> = parameters.split(';').collect();
+    let mut index = 0;
+    while index < codes.len() {
+        match codes[index] {
+            "" | "0" => *look = Look::default(),
+            "1" => look.weight = 1,
+            "2" => look.weight = 2,
+            "22" => look.weight = 0,
+            "7" => look.inverse = true,
+            "27" => look.inverse = false,
+            "39" => look.foreground = String::new(),
+            "49" => look.background = String::new(),
+            "38" | "48" => {
+                let length = if codes.get(index + 1) == Some(&"2") {
+                    5
+                } else {
+                    3
+                };
+                let value = codes[index..(index + length).min(codes.len())].join(";");
+                if codes[index] == "38" {
+                    look.foreground = value;
+                } else {
+                    look.background = value;
+                }
+                index += length - 1;
+            }
+            code => {
+                let number: u32 = code.parse().unwrap_or(0);
+                if (30..=37).contains(&number) || (90..=97).contains(&number) {
+                    look.foreground = code.to_string();
+                } else if (40..=47).contains(&number) || (100..=107).contains(&number) {
+                    look.background = code.to_string();
+                }
+            }
+        }
+        index += 1;
+    }
+}
+
+fn parse_line(line: &str) -> Vec<Cell> {
+    let mut cells = vec![];
+    let mut look = Look::default();
+    let chars: Vec<char> = line.chars().collect();
+    let mut index = 0;
+    while index < chars.len() {
+        if chars[index] != '\x1b' {
+            cells.push((chars[index], look.clone()));
+            index += 1;
+            continue;
+        }
+        match chars.get(index + 1) {
+            Some('[') => {
+                let start = index + 2;
+                let mut end = start;
+                while end < chars.len() && !('@'..='~').contains(&chars[end]) {
+                    end += 1;
+                }
+                if chars.get(end) == Some(&'m') {
+                    let parameters: String = chars[start..end].iter().collect();
+                    apply_sgr(&mut look, &parameters);
+                }
+                index = end + 1;
+            }
+            Some(']') => {
+                index += 2;
+                while index < chars.len() {
+                    if chars[index] == '\x07' {
+                        index += 1;
+                        break;
+                    }
+                    if chars[index] == '\x1b' && chars.get(index + 1) == Some(&'\\') {
+                        index += 2;
+                        break;
+                    }
+                    index += 1;
+                }
+            }
+            _ => index += 1,
+        }
+    }
+    return cells;
+}
+
+fn parse_output(output: &str) -> Vec<Vec<Cell>> {
+    let mut lines: Vec<&str> = output.split('\n').collect();
+    if lines.last() == Some(&"") {
+        lines.pop();
+    }
+    return lines.into_iter().map(parse_line).collect();
+}
+
+fn text_of(cells: &[Cell]) -> String {
+    return cells.iter().map(|(c, _)| *c).collect();
+}
+
+fn marked(cells: &[Cell]) -> String {
+    let mut result = String::new();
+    let mut open = false;
+    for (index, (c, look)) in cells.iter().enumerate() {
+        let inverse = index > 0 && look.inverse;
+        if inverse && !open {
+            result.push('[');
+        }
+        if !inverse && open {
+            result.push(']');
+        }
+        open = inverse;
+        result.push(*c);
+    }
+    if open {
+        result.push(']');
+    }
+    return result;
+}
+
+fn render(input: &str) -> Vec<Vec<Cell>> {
+    let rendered = parse_output(&run_riff(input));
+    let texts: Vec<String> = rendered.iter().map(|cells| text_of(cells)).collect();
+    let expected_texts: Vec<&str> = input.lines().collect();
+    assert_eq!(
+        texts, expected_texts,
+        "riff must keep every line and its order"
+    );
+    return rendered;
+}
+
+fn assert_marked(input: &str, expected: &[&str]) {
+    let rendered = render(input);
+    let first_hunk = rendered
+        .iter()
+        .position(|cells| text_of(cells).starts_with("@@"))
+        .unwrap();
+    let actual: Vec<String> = rendered[first_hunk..]
+        .iter()
+        .map(|cells| marked(cells))
+        .collect();
+    assert_eq!(actual, expected);
+}
+
+fn assert_unstyled(input: &str, line: &str) {
+    let rendered = render(input);
+    let matching: Vec<&Vec<Cell>> = rendered
+        .iter()
+        .filter(|cells| text_of(cells) == line)
+        .collect();
+    assert!(!matching.is_empty(), "no output line {:?}", line);
+    for cells in matching {
+        assert!(
+            cells.iter().all(|(_, look)| *look == Look::default()),
+            "{:?} should be shown without any styling",
+            line
+        );
+    }
+}
+
+fn assert_looks_like_today(input: &str, first_line: usize, today: &[&str]) {
+    let rendered = render(input);
+    let expected: Vec<Vec<Cell>> = today.iter().map(|line| parse_line(line)).collect();
+    assert_eq!(
+        rendered[first_line..first_line + today.len()].to_vec(),
+        expected
+    );
+}
