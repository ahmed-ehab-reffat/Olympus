+#[test]
+fn resolved_sides_are_refined_against_the_resolution() {
+    assert_marked(
+        RESOLVED_TWO_WAY,
+        &[
+            "@@ -1,7 +1,3 @@",
+            " fn total() {",
+            "-[<<<<<<< ours]",
+            "-    let total = price * [count];",
+            "-[=======]",
+            "-    let total = price * amount;",
+            "-[>>>>>>> theirs]",
+            "+    let total = price * [amount + tax];",
+            " }",
+        ],
+    );
+}
+
