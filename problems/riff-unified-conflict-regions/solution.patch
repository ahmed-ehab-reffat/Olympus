index 0000000..806fbdd
--- /dev/null
+++ b/src/unified_conflicts_highlighter.rs
@@ -0,0 +1,549 @@
+use threadpool::ThreadPool;
+
+use crate::constants::{INVERSE_VIDEO, NORMAL, NO_EOF_NEWLINE_COLOR};
+use crate::lines_highlighter::{LineAcceptance, LinesHighlighter, Response};
+use crate::plusminus_lines_highlighter::PlusMinusLinesHighlighter;
+use crate::refiner::{self, Formatter};
+use crate::string_future::StringFuture;
+use crate::token_collector::{
+    render_row, LineStyle, Style, StyledToken, LINE_STYLE_CONFLICT_BASE, LINE_STYLE_CONFLICT_NEW,
+    LINE_STYLE_CONFLICT_OLD,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum MarkerKind {
+    Open,
+    Base,
+    Separator,
+    Close,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Zone {
+    Before,
+    Side1,
+    Base,
+    Side2,
+    After,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Role {
+    Side1,
+    Base,
+    Side2,
+    Resolution,
+}
+
+#[derive(Clone, Debug)]
+enum RegionLine {
+    Content {
+        raw: String,
+        zone: Zone,
+        no_newline: bool,
+    },
+    Marker(String),
+    NoNewline(String),
+    HunkHeader(String),
+}
+
+#[derive(Debug)]
+pub(crate) struct UnifiedConflictsHighlighter {
+    lines: Vec<RegionLine>,
+    marker_prefix: char,
+    marker_length: usize,
+    zone: Zone,
+    valid: bool,
+    closing_block_has_plus: bool,
+    formatter: Formatter,
+}
+
+fn parse_marker(text: &str) -> Option<(MarkerKind, usize)> {
+    let first = text.chars().next()?;
+    let kind = match first {
+        '<' => MarkerKind::Open,
+        '|' => MarkerKind::Base,
+        '=' => MarkerKind::Separator,
+        '>' => MarkerKind::Close,
+        _ => return None,
+    };
+    let length = text.chars().take_while(|c| *c == first).count();
+    if length < 7 {
+        return None;
+    }
+    let rest = &text[length..];
+    if kind == MarkerKind::Separator && !rest.is_empty() {
+        return None;
+    }
+    if !rest.is_empty() && !rest.starts_with(' ') {
+        return None;
+    }
+    return Some((kind, length));
+}
+
+fn split_prefix(line: &str) -> (char, &str) {
+    let mut chars = line.chars();
+    let prefix = chars.next().unwrap_or(' ');
+    return (prefix, chars.as_str());
+}
+
+pub(crate) fn is_opening_marker(line: &str) -> bool {
+    let (prefix, text) = split_prefix(line);
+    if prefix != '-' && prefix != '+' {
+        return false;
+    }
+    return matches!(parse_marker(text), Some((MarkerKind::Open, _)));
+}
+
+impl LinesHighlighter for UnifiedConflictsHighlighter {
+    fn consume_line(&mut self, line: &str, thread_pool: &ThreadPool) -> Result<Response, String> {
+        if line.starts_with('\\') {
+            self.mark_no_newline(line);
+            return Ok(Response {
+                line_accepted: LineAcceptance::AcceptedWantMore,
+                highlighted: vec![],
+            });
+        }
+
+        let (prefix, text) = split_prefix(line);
+        if self.zone == Zone::After {
+            let block_ended =
+                prefix == ' ' || line.is_empty() || (prefix == '-' && self.closing_block_has_plus);
+            if block_ended {
+                return Ok(Response {
+                    line_accepted: LineAcceptance::RejectedDone,
+                    highlighted: self.render(thread_pool),
+                });
+            }
+            if prefix == '+' {
+                self.closing_block_has_plus = true;
+            }
+            self.push_content(line);
+            return Ok(Response {
+                line_accepted: LineAcceptance::AcceptedWantMore,
+                highlighted: vec![],
+            });
+        }
+
+        match self.marker_kind(prefix, text) {
+            Some(kind) => {
+                self.advance_zone(kind);
+                self.lines.push(RegionLine::Marker(line.to_string()));
+                if kind == MarkerKind::Close {
+                    self.closing_block_has_plus = prefix == '+';
+                }
+            }
+            None => self.push_content(line),
+        }
+        return Ok(Response {
+            line_accepted: LineAcceptance::AcceptedWantMore,
+            highlighted: vec![],
+        });
+    }
+
+    fn consume_eof(&mut self, thread_pool: &ThreadPool) -> Result<Vec<StringFuture>, String> {
+        return Ok(self.render(thread_pool));
+    }
+}
+
+impl UnifiedConflictsHighlighter {
+    pub(crate) fn from_block(
+        block_lines: Vec<String>,
+        marker_line: &str,
+        formatter: Formatter,
+    ) -> Self {
+        let (marker_prefix, text) = split_prefix(marker_line);
+        let marker_length = parse_marker(text).map_or(7, |(_, length)| length);
+
+        let mut highlighter = UnifiedConflictsHighlighter {
+            lines: vec![],
+            marker_prefix,
+            marker_length,
+            zone: Zone::Before,
+            valid: true,
+            closing_block_has_plus: false,
+            formatter,
+        };
+        for line in block_lines {
+            if line.starts_with('\\') {
+                highlighter.mark_no_newline(&line);
+            } else {
+                highlighter.push_content(&line);
+            }
+        }
+        highlighter.zone = Zone::Side1;
+        highlighter
+            .lines
+            .push(RegionLine::Marker(marker_line.to_string()));
+        return highlighter;
+    }
+
+    pub(crate) fn is_complete(&self) -> bool {
+        return self.zone == Zone::After;
+    }
+
+    pub(crate) fn push_hunk_header(&mut self, header: String) {
+        self.lines.push(RegionLine::HunkHeader(header));
+    }
+
+    fn marker_kind(&self, prefix: char, text: &str) -> Option<MarkerKind> {
+        if prefix != self.marker_prefix {
+            return None;
+        }
+        let (kind, length) = parse_marker(text)?;
+        if length != self.marker_length {
+            return None;
+        }
+        return Some(kind);
+    }
+
+    fn push_content(&mut self, line: &str) {
+        self.lines.push(RegionLine::Content {
+            raw: line.to_string(),
+            zone: self.zone,
+            no_newline: false,
+        });
+    }
+
+    fn mark_no_newline(&mut self, line: &str) {
+        if let Some(RegionLine::Content { no_newline, .. }) = self.lines.last_mut() {
+            *no_newline = true;
+        }
+        self.lines.push(RegionLine::NoNewline(line.to_string()));
+    }
+
+    fn advance_zone(&mut self, kind: MarkerKind) {
+        self.zone = match (self.zone, kind) {
+            (Zone::Side1, MarkerKind::Base) => Zone::Base,
+            (Zone::Side1 | Zone::Base, MarkerKind::Separator) => Zone::Side2,
+            (Zone::Side2, MarkerKind::Close) => Zone::After,
+            (_, MarkerKind::Close) => {
+                self.valid = false;
+                Zone::After
+            }
+            (zone, _) => {
+                self.valid = false;
+                zone
+            }
+        };
+    }
+
+    fn resolved(&self) -> bool {
+        return self.marker_prefix == '-';
+    }
+
+    fn roles_of(&self, raw: &str, zone: Zone) -> Vec<Role> {
+        let prefix = split_prefix(raw).0;
+        let side = match zone {
+            Zone::Side1 => Some(Role::Side1),
+            Zone::Base => Some(Role::Base),
+            Zone::Side2 => Some(Role::Side2),
+            Zone::Before | Zone::After => None,
+        };
+        if self.resolved() {
+            return match (prefix, side) {
+                ('+', _) => vec![Role::Resolution],
+                (' ', Some(side)) => vec![side, Role::Resolution],
+                ('-', Some(side)) => vec![side],
+                _ => vec![],
+            };
+        }
+        return match (prefix, side) {
+            ('+' | ' ', Some(side)) => vec![side],
+            _ => vec![],
+        };
+    }
+
+    fn collect_text(&self, role: Role) -> String {
+        let mut text = String::new();
+        for line in &self.lines {
+            if let RegionLine::Content {
+                raw,
+                zone,
+                no_newline,
+            } = line
+            {
+                if !self.roles_of(raw, *zone).contains(&role) {
+                    continue;
+                }
+                text.push_str(split_prefix(raw).1);
+                if !no_newline {
+                    text.push('\n');
+                }
+            }
+        }
+        return text;
+    }
+
+    fn render(&mut self, thread_pool: &ThreadPool) -> Vec<StringFuture> {
+        if !self.valid || !self.is_complete() {
+            return self.render_as_plain_diff(thread_pool);
+        }
+
+        let side1 = self.collect_text(Role::Side1);
+        let base = self.collect_text(Role::Base);
+        let side2 = self.collect_text(Role::Side2);
+        let resolution = self.collect_text(Role::Resolution);
+        let resolved = self.resolved();
+        let roles: Vec<Vec<Role>> = self
+            .lines
+            .iter()
+            .map(|line| match line {
+                RegionLine::Content { raw, zone, .. } => self.roles_of(raw, *zone),
+                _ => vec![],
+            })
+            .collect();
+        let region = std::mem::take(&mut self.lines);
+        let formatter = self.formatter.clone();
+
+        return vec![StringFuture::from_function(
+            move || {
+                let tokens = if resolved {
+                    attribute_resolved(&side1, &base, &side2, &resolution)
+                } else {
+                    attribute_unresolved(&side1, &base, &side2)
+                };
+                let mut cursors = RoleCursors::new(tokens);
+                let mut rendered = String::new();
+                for (line, line_roles) in region.iter().zip(roles.iter()) {
+                    rendered.push_str(&render_region_line(
+                        line,
+                        line_roles,
+                        resolved,
+                        &mut cursors,
+                        &formatter,
+                    ));
+                    rendered.push('\n');
+                }
+                rendered
+            },
+            thread_pool,
+        )];
+    }
+
+    fn render_as_plain_diff(&mut self, thread_pool: &ThreadPool) -> Vec<StringFuture> {
+        let mut rendered = vec![];
+        let mut block: Option<PlusMinusLinesHighlighter> = None;
+        for line in std::mem::take(&mut self.lines) {
+            let raw = match line {
+                RegionLine::Content { raw, .. } | RegionLine::Marker(raw) => raw,
+                RegionLine::NoNewline(raw) => {
+                    if let Some(highlighter) = block.as_mut() {
+                        if let Ok(response) = highlighter.consume_line(&raw, thread_pool) {
+                            rendered.extend(response.highlighted);
+                            if response.line_accepted == LineAcceptance::AcceptedDone {
+                                block = None;
+                            }
+                            continue;
+                        }
+                    }
+                    rendered.push(StringFuture::from_string(format!(
+                        "{NO_EOF_NEWLINE_COLOR}{raw}{NORMAL}\n"
+                    )));
+                    continue;
+                }
+                RegionLine::HunkHeader(header) => {
+                    if let Some(mut highlighter) = block.take() {
+                        rendered.extend(highlighter.consume_eof(thread_pool).unwrap_or_default());
+                    }
+                    rendered.push(StringFuture::from_string(header + "\n"));
+                    continue;
+                }
+            };
+            if let Some(highlighter) = block.as_mut() {
+                if let Ok(response) = highlighter.consume_line(&raw, thread_pool) {
+                    rendered.extend(response.highlighted);
+                    if response.line_accepted != LineAcceptance::RejectedDone {
+                        continue;
+                    }
+                }
+            }
+            block = PlusMinusLinesHighlighter::from_line(&raw, 1, self.formatter.clone());
+            if block.is_none() {
+                rendered.push(StringFuture::from_string(raw + "\n"));
+            }
+        }
+        if let Some(mut highlighter) = block {
+            rendered.extend(highlighter.consume_eof(thread_pool).unwrap_or_default());
+        }
+        return rendered;
+    }
+}
+
+struct RoleTokens {
+    side1: Vec<StyledToken>,
+    base: Vec<StyledToken>,
+    side2: Vec<StyledToken>,
+    resolution: Vec<StyledToken>,
+}
+
+fn text_or_newline(text: &str) -> &str {
+    if text.is_empty() {
+        return "\n";
+    }
+    return text;
+}
+
+fn max_merge(into: &mut [StyledToken], other: &[StyledToken]) {
+    for (token, other_token) in into.iter_mut().zip(other.iter()) {
+        if other_token.style as u8 > token.style as u8 {
+            token.style = other_token.style;
+        }
+    }
+}
+
+fn attribute_resolved(side1: &str, base: &str, side2: &str, resolution: &str) -> RoleTokens {
+    let resolution = text_or_newline(resolution);
+    let (side1_tokens, mut resolution_tokens) = refiner::diff(text_or_newline(side1), resolution);
+    let (side2_tokens, resolution_vs_side2) = refiner::diff(text_or_newline(side2), resolution);
+    max_merge(&mut resolution_tokens, &resolution_vs_side2);
+    let base_tokens = if base.is_empty() {
+        vec![]
+    } else {
+        refiner::diff(base, resolution).0
+    };
+    return RoleTokens {
+        side1: side1_tokens,
+        base: base_tokens,
+        side2: side2_tokens,
+        resolution: resolution_tokens,
+    };
+}
+
+fn attribute_unresolved(side1: &str, base: &str, side2: &str) -> RoleTokens {
+    if base.is_empty() {
+        let (side1_tokens, side2_tokens) =
+            refiner::diff(text_or_newline(side1), text_or_newline(side2));
+        return RoleTokens {
+            side1: side1_tokens,
+            base: vec![],
+            side2: side2_tokens,
+            resolution: vec![],
+        };
+    }
+
+    let (mut base_vs_side1, side1_tokens) = refiner::diff(base, text_or_newline(side1));
+    let (mut base_vs_side2, side2_tokens) = refiner::diff(base, text_or_newline(side2));
+    if side1.is_empty() {
+        base_vs_side1
+            .iter_mut()
+            .for_each(|t| t.style = Style::Context);
+    }
+    if side2.is_empty() {
+        base_vs_side2
+            .iter_mut()
+            .for_each(|t| t.style = Style::Context);
+    }
+    max_merge(&mut base_vs_side1, &base_vs_side2);
+    return RoleTokens {
+        side1: side1_tokens,
+        base: base_vs_side1,
+        side2: side2_tokens,
+        resolution: vec![],
+    };
+}
+
+fn split_rows(tokens: Vec<StyledToken>) -> Vec<Vec<StyledToken>> {
+    let mut rows = vec![];
+    let mut row = vec![];
+    for token in tokens {
+        if token.token == "\n" {
+            rows.push(std::mem::take(&mut row));
+            continue;
+        }
+        row.push(token);
+    }
+    if !row.is_empty() {
+        rows.push(row);
+    }
+    return rows;
+}
+
+struct RoleCursors {
+    rows: Vec<std::vec::IntoIter<Vec<StyledToken>>>,
+}
+
+impl RoleCursors {
+    fn new(tokens: RoleTokens) -> Self {
+        let rows = vec![
+            split_rows(tokens.side1).into_iter(),
+            split_rows(tokens.base).into_iter(),
+            split_rows(tokens.side2).into_iter(),
+            split_rows(tokens.resolution).into_iter(),
+        ];
+        return RoleCursors { rows };
+    }
+
+    fn next(&mut self, role: Role) -> Option<Vec<StyledToken>> {
+        let index = match role {
+            Role::Side1 => 0,
+            Role::Base => 1,
+            Role::Side2 => 2,
+            Role::Resolution => 3,
+        };
+        return self.rows[index].next();
+    }
+}
+
+fn role_style(role: Role, resolved: bool, formatter: &Formatter) -> LineStyle {
+    if resolved {
+        return match role {
+            Role::Resolution => formatter.new_line_style().clone(),
+            Role::Base => LINE_STYLE_CONFLICT_BASE.clone(),
+            _ => formatter.old_line_style().clone(),
+        };
+    }
+    return match role {
+        Role::Side1 => LINE_STYLE_CONFLICT_OLD.clone(),
+        Role::Base => LINE_STYLE_CONFLICT_BASE.clone(),
+        _ => LINE_STYLE_CONFLICT_NEW.clone(),
+    };
+}
+
+fn render_region_line(
+    line: &RegionLine,
+    roles: &[Role],
+    resolved: bool,
+    cursors: &mut RoleCursors,
+    formatter: &Formatter,
+) -> String {
+    let raw = match line {
+        RegionLine::HunkHeader(header) => return header.clone(),
+        RegionLine::NoNewline(raw) => return format!("{NO_EOF_NEWLINE_COLOR}{raw}{NORMAL}"),
+        RegionLine::Marker(raw) => {
+            let (prefix, text) = split_prefix(raw);
+            return format!("{prefix}{INVERSE_VIDEO}{text}{NORMAL}");
+        }
+        RegionLine::Content { raw, .. } => raw,
+    };
+
+    let mut rows: Vec<(Role, Option<Vec<StyledToken>>)> = roles
+        .iter()
+        .map(|role| (*role, cursors.next(*role)))
+        .collect();
+    let (prefix, text) = split_prefix(raw);
+    let prefix = prefix.to_string();
+    let plain = [StyledToken::new(
+        text.to_string(),
+        Style::DiffPartMidlighted,
+    )];
+
+    if raw.is_empty() || (resolved && raw.starts_with(' ')) {
+        return raw.to_string();
+    }
+    if rows.is_empty() {
+        let style = if prefix == "+" {
+            formatter.new_line_style()
+        } else {
+            formatter.old_line_style()
+        };
+        return render_row(style, &prefix, &plain, false);
+    }
+
+    let (role, row) = rows.remove(0);
+    let style = role_style(role, resolved, formatter);
+    return match row {
+        Some(row) => render_row(&style, &prefix, &row, false),
+        None => render_row(&style, &prefix, &plain, false),
+    };
+}
