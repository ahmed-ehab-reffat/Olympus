index 0000000..95c406a
--- /dev/null
+++ b/tests/negative_8f8ea0/library_8f8ea0.py
@@ -0,0 +1,125 @@
+import ctypes
+import os
+import subprocess
+import tempfile
+
+from support_8f8ea0 import Param, Suite
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
+
+PICT_SUCCESS = 0x00000000
+PICT_GENERATION_ERROR = 0xc0000002
+PICT_INVALID_VALUE = 0xc0000003
+
+
+class Item(ctypes.Structure):
+    _fields_ = [('Parameter', ctypes.c_void_p), ('ValueIndex', ctypes.c_size_t)]
+
+
+def load_library():
+    lib = ctypes.CDLL(os.path.join(ROOT, 'libpict.so'))
+    handle = ctypes.c_void_p
+    signatures = {
+        'PictCreateTask': (handle, []),
+        'PictCreateModel': (handle, [ctypes.c_uint]),
+        'PictSetRootModel': (None, [handle, handle]),
+        'PictAddParameter': (handle, [handle, ctypes.c_size_t, ctypes.c_uint, ctypes.POINTER(ctypes.c_uint)]),
+        'PictAttachChildModel': (ctypes.c_uint, [handle, handle, ctypes.c_uint]),
+        'PictAddExclusion': (ctypes.c_uint, [handle, ctypes.POINTER(Item), ctypes.c_size_t]),
+        'PictAddSeed': (ctypes.c_uint, [handle, ctypes.POINTER(Item), ctypes.c_size_t]),
+        'PictGenerate': (ctypes.c_uint, [handle]),
+        'PictGetTotalParameterCount': (ctypes.c_size_t, [handle]),
+        'PictAllocateResultBuffer': (ctypes.POINTER(ctypes.c_size_t), [handle]),
+        'PictFreeResultBuffer': (None, [ctypes.POINTER(ctypes.c_size_t)]),
+        'PictResetResultFetching': (None, [handle]),
+        'PictGetNextResultRow': (ctypes.c_size_t, [handle, ctypes.POINTER(ctypes.c_size_t)]),
+        'PictSetNegativeValue': (ctypes.c_uint, [handle, ctypes.c_size_t]),
+        'PictGetResultParameter': (handle, [handle, ctypes.c_size_t]),
+    }
+    for name, (restype, argtypes) in signatures.items():
+        function = getattr(lib, name)
+        function.restype = restype
+        function.argtypes = argtypes
+    return lib
+
+
+LIB = load_library()
+
+
+def run_client(mode):
+    workdir = tempfile.mkdtemp(prefix='pictclient-')
+    binary = os.path.join(workdir, 'client')
+    source = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'client_8f8ea0.cpp')
+    build = subprocess.run([os.environ.get('CXX', 'g++'), '-std=c++11', '-O1', '-I' + os.path.join(ROOT, 'api'),
+                            source, '-o', binary, '-L' + ROOT, '-lpict', '-Wl,-rpath,' + ROOT],
+                           capture_output=True, text=True, timeout=300)
+    assert build.returncode == 0, 'client does not compile against pictapi.h:\n%s' % build.stderr[-8000:]
+    proc = subprocess.run([binary, mode], capture_output=True, text=True, timeout=300)
+    assert proc.returncode == 0, 'client %s exited with %d:\n%s%s' % (mode, proc.returncode, proc.stdout, proc.stderr)
+
+
+class Tree:
+    def __init__(self, seed=0):
+        self.task = LIB.PictCreateTask()
+        self.root = LIB.PictCreateModel(seed)
+        self.params = {}
+
+    def model(self, seed=0):
+        return LIB.PictCreateModel(seed)
+
+    def attach(self, parent, child, order=2):
+        assert LIB.PictAttachChildModel(parent, child, order) == PICT_SUCCESS
+
+    def param(self, model, name, values, negatives=(), order=2, weights=None):
+        buffer = (ctypes.c_uint * values)(*weights) if weights else None
+        handle = LIB.PictAddParameter(model, values, order, buffer)
+        assert handle
+        param = Param(name, handle, values)
+        self.params[name] = param
+        for index in negatives:
+            self.negative(name, index)
+        return param
+
+    def negative(self, name, index):
+        param = self.params[name]
+        code = LIB.PictSetNegativeValue(param.handle, index)
+        assert code == PICT_SUCCESS, 'PictSetNegativeValue(%s, %d) returned 0x%x' % (name, index, code)
+        param.negatives.add(index)
+
+    def items(self, pairs):
+        array = (Item * len(pairs))()
+        for slot, (name, value) in enumerate(pairs):
+            array[slot].Parameter = self.params[name].handle
+            array[slot].ValueIndex = value
+        return array, len(pairs)
+
+    def exclude(self, *pairs):
+        array, count = self.items(pairs)
+        assert LIB.PictAddExclusion(self.task, array, count) == PICT_SUCCESS
+
+    def seed(self, *pairs):
+        array, count = self.items(pairs)
+        assert LIB.PictAddSeed(self.task, array, count) == PICT_SUCCESS
+
+    def generate(self):
+        LIB.PictSetRootModel(self.task, self.root)
+        code = LIB.PictGenerate(self.task)
+        assert code == PICT_SUCCESS, 'PictGenerate returned 0x%x' % code
+        return self.fetch()
+
+    def fetch(self):
+        count = LIB.PictGetTotalParameterCount(self.task)
+        by_handle = {p.handle: p for p in self.params.values()}
+        columns = []
+        for column in range(count):
+            handle = LIB.PictGetResultParameter(self.task, column)
+            assert handle in by_handle, 'column %d reports an unknown parameter' % column
+            columns.append(by_handle[handle].name)
+        assert sorted(columns) == sorted(self.params), 'columns %s do not list every parameter once' % columns
+        buffer = LIB.PictAllocateResultBuffer(self.task)
+        LIB.PictResetResultFetching(self.task)
+        rows = []
+        while LIB.PictGetNextResultRow(self.task, buffer):
+            rows.append({columns[c]: buffer[c] for c in range(count)})
+        LIB.PictFreeResultBuffer(buffer)
+        return Suite(self.params, rows)
