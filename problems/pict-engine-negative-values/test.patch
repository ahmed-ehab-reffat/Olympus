index 0000000..ff15c0f
--- /dev/null
+++ b/tests/negative_8f8ea0/client_8f8ea0.cpp
@@ -0,0 +1,218 @@
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <new>
+
+#include "pictapi.h"
+
+static std::atomic<long> liveAllocations( 0 );
+
+static void*  freedBlocks[ 1 << 16 ];
+static size_t freedCount   = 0;
+static bool   recordFrees  = false;
+static bool   freedOverflow = false;
+
+void* operator new( size_t size )
+{
+    void* block = malloc( size ? size : 1 );
+    if( nullptr == block ) throw std::bad_alloc();
+    ++liveAllocations;
+    return( block );
+}
+
+void operator delete( void* block ) noexcept
+{
+    if( nullptr == block ) return;
+    --liveAllocations;
+    if( recordFrees )
+    {
+        if( freedCount < sizeof( freedBlocks ) / sizeof( freedBlocks[ 0 ] ) ) freedBlocks[ freedCount++ ] = block;
+        else freedOverflow = true;
+    }
+    free( block );
+}
+
+void operator delete( void* block, size_t ) noexcept
+{
+    operator delete( block );
+}
+
+static_assert( PICT_INVALID_VALUE == 0xc0000003, "PICT_INVALID_VALUE" );
+
+static PICT_RET_CODE ( API_SPEC *setNegativeValue )( const PICT_HANDLE, PICT_VALUE ) = PictSetNegativeValue;
+static PICT_HANDLE ( API_SPEC *getResultParameter )( const PICT_HANDLE, size_t ) = PictGetResultParameter;
+
+static int failures = 0;
+
+static void expect( bool condition, const char* what )
+{
+    if( !condition )
+    {
+        printf( "FAILED: %s\n", what );
+        ++failures;
+    }
+}
+
+static PICT_HANDLE addParameter( PICT_HANDLE model, size_t values, PICT_VALUE negative, bool hasNegative )
+{
+    PICT_HANDLE param = PictAddParameter( model, values, 2 );
+    if( hasNegative ) expect( PICT_SUCCESS == setNegativeValue( param, negative ), "marking a value negative" );
+    return( param );
+}
+
+static int header()
+{
+    PICT_HANDLE task  = PictCreateTask();
+    PICT_HANDLE model = PictCreateModel();
+    PICT_HANDLE a = PictAddParameter( model, 3, 2 );
+    PICT_HANDLE b = PictAddParameter( model, 2, 2 );
+
+    PICT_RET_CODE code = setNegativeValue( a, 3 );
+    expect( PICT_INVALID_VALUE == code, "index past the last value" );
+    code = setNegativeValue( a, 0 );
+    expect( PICT_SUCCESS == code, "first value" );
+    code = setNegativeValue( a, 2 );
+    expect( PICT_SUCCESS == code, "last value" );
+    code = setNegativeValue( a, 1 );
+    expect( PICT_INVALID_VALUE == code, "only value that is not negative" );
+    code = setNegativeValue( a, 0 );
+    expect( PICT_SUCCESS == code, "value that is already negative" );
+
+    PictSetRootModel( task, model );
+    expect( PICT_SUCCESS == PictGenerate( task ), "generation" );
+
+    size_t columns = PictGetTotalParameterCount( task );
+    expect( 2 == columns, "column count" );
+    PICT_HANDLE first  = getResultParameter( task, 0 );
+    PICT_HANDLE second = getResultParameter( task, 1 );
+    expect( ( first == a && second == b ) || ( first == b && second == a ), "columns map to the parameters" );
+    expect( nullptr == getResultParameter( task, columns ), "column past the last one" );
+
+    PictDeleteModel( model );
+    PictDeleteTask( task );
+    return( failures );
+}
+
+struct ModelTree
+{
+    PICT_HANDLE models[ 4 ];
+    PICT_HANDLE params[ 7 ];
+};
+
+static ModelTree buildTree()
+{
+    ModelTree tree;
+    PICT_HANDLE root  = tree.models[ 0 ] = PictCreateModel( 7 );
+    PICT_HANDLE left  = tree.models[ 1 ] = PictCreateModel();
+    PICT_HANDLE inner = tree.models[ 2 ] = PictCreateModel();
+    PICT_HANDLE right = tree.models[ 3 ] = PictCreateModel();
+
+    tree.params[ 0 ] = addParameter( root,  3, 2, true );
+    tree.params[ 1 ] = addParameter( left,  2, 1, true );
+    tree.params[ 2 ] = addParameter( left,  3, 0, false );
+    tree.params[ 3 ] = addParameter( inner, 3, 2, true );
+    tree.params[ 4 ] = addParameter( inner, 2, 0, false );
+    tree.params[ 5 ] = addParameter( right, 3, 0, true );
+    tree.params[ 6 ] = addParameter( right, 4, 3, true );
+
+    expect( PICT_SUCCESS == PictAttachChildModel( left, inner, 2 ), "attach inner" );
+    expect( PICT_SUCCESS == PictAttachChildModel( root, left, 2 ), "attach left" );
+    expect( PICT_SUCCESS == PictAttachChildModel( root, right, 2 ), "attach right" );
+    return( tree );
+}
+
+static bool wasFreed( PICT_HANDLE handle )
+{
+    for( size_t index = 0; index < freedCount; ++index )
+    {
+        if( freedBlocks[ index ] == handle ) return( true );
+    }
+    return( false );
+}
+
+static void deleteTree( ModelTree& tree, const char* when )
+{
+    freedCount = 0;
+    freedOverflow = false;
+    recordFrees = true;
+    PictDeleteModel( tree.models[ 0 ] );
+    recordFrees = false;
+
+    int models = 0;
+    int params = 0;
+    for( PICT_HANDLE model : tree.models ) if( !wasFreed( model ) ) ++models;
+    for( PICT_HANDLE param : tree.params ) if( !wasFreed( param ) ) ++params;
+    if( models || params || freedOverflow )
+    {
+        printf( "FAILED: PictDeleteModel on the root %s left %d of 4 models and %d of 7 parameters allocated\n", when, models, params );
+        ++failures;
+    }
+}
+
+static void standalone()
+{
+    ModelTree tree = buildTree();
+    deleteTree( tree, "of a tree never attached to a task" );
+}
+
+static void cycle( int rounds )
+{
+    PICT_HANDLE task = PictCreateTask();
+    ModelTree tree = buildTree();
+    PictSetRootModel( task, tree.models[ 0 ] );
+
+    PICT_EXCLUSION_ITEM exclusion[] = { { tree.params[ 2 ], 1 }, { tree.params[ 4 ], 1 } };
+    expect( PICT_SUCCESS == PictAddExclusion( task, exclusion, 2 ), "exclusion" );
+    PICT_SEED_ITEM seed[] = { { tree.params[ 0 ], 1 }, { tree.params[ 5 ], 0 }, { tree.params[ 6 ], 1 } };
+    expect( PICT_SUCCESS == PictAddSeed( task, seed, 3 ), "seed" );
+
+    for( int round = 0; round < rounds; ++round )
+    {
+        expect( PICT_SUCCESS == PictGenerate( task ), "generation" );
+        PICT_RESULT_ROW row = PictAllocateResultBuffer( task );
+        PictResetResultFetching( task );
+        size_t rows = 0;
+        while( PictGetNextResultRow( task, row ) ) ++rows;
+        expect( rows > 0, "rows" );
+        PictFreeResultBuffer( row );
+    }
+
+    const char* when[] = { "of a task never generated", "after one generation, before the task is deleted,",
+                           "after two generations, before the task is deleted," };
+    deleteTree( tree, when[ rounds ] );
+    PictDeleteTask( task );
+}
+
+static int lifecycle()
+{
+    for( int warmup = 0; warmup < 3; ++warmup ) standalone();
+    long before = liveAllocations;
+    for( int repeat = 0; repeat < 5; ++repeat ) standalone();
+    long after = liveAllocations;
+    if( after != before )
+    {
+        printf( "FAILED: %ld allocations still live after PictDeleteModel on 5 trees never attached to a task\n", after - before );
+        ++failures;
+    }
+
+    for( int rounds = 0; rounds <= 2; ++rounds )
+    {
+        for( int warmup = 0; warmup < 3; ++warmup ) cycle( rounds );
+        before = liveAllocations;
+        for( int repeat = 0; repeat < 5; ++repeat ) cycle( rounds );
+        after = liveAllocations;
+        if( after != before )
+        {
+            printf( "FAILED: %ld allocations still live after deleting 5 model trees generated %d times\n", after - before, rounds );
+            ++failures;
+        }
+    }
+    return( failures );
+}
+
+int main( int argc, char* argv[] )
+{
+    if( argc > 1 && 0 == strcmp( argv[ 1 ], "lifecycle" ) ) return( lifecycle() ? 1 : 0 );
+    return( header() ? 1 : 0 );
+}
