@@ -0,0 +1,131 @@
+import importlib
+import os
+import re
+import subprocess
+import sys
+import time
+import traceback
+import xml.etree.ElementTree as ET
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.abspath(os.path.join(HERE, '..', '..'))
+MODULES = ['api_negative_8f8ea0', 'cli_negative_8f8ea0']
+TIMEOUT = 300
+
+
+def run_one(module_name, test_name):
+    sys.path.insert(0, HERE)
+    try:
+        module = importlib.import_module(module_name)
+        getattr(module, test_name)()
+    except BaseException:
+        traceback.print_exc()
+        sys.stdout.flush()
+        os._exit(1)
+    sys.stdout.flush()
+    os._exit(0)
+
+
+def list_tests(module_name):
+    source = open(os.path.join(HERE, module_name + '.py')).read()
+    return re.findall(r'^def (test_\w+)\(', source, re.M)
+
+
+def run_new():
+    results = []
+    for module_name in MODULES:
+        for test_name in list_tests(module_name):
+            started = time.time()
+            try:
+                proc = subprocess.run([sys.executable, '-B', os.path.abspath(__file__), '--one', module_name, test_name],
+                                      cwd=ROOT, capture_output=True, text=True, timeout=TIMEOUT)
+                ok = proc.returncode == 0
+                detail = (proc.stdout + proc.stderr)[-20000:]
+                if not ok and proc.returncode < 0:
+                    detail = 'terminated by signal %d\n%s' % (-proc.returncode, detail)
+            except subprocess.TimeoutExpired:
+                ok = False
+                detail = 'timed out after %d seconds' % TIMEOUT
+            results.append((module_name, test_name, ok, detail, time.time() - started))
+            print('%s %s.%s' % ('PASS' if ok else 'FAIL', module_name, test_name))
+            if not ok:
+                print(detail)
+    return results
+
+
+def run_base():
+    results = []
+    test_dir = os.path.join(ROOT, 'test')
+    started = time.time()
+    proc = subprocess.run(['perl', 'test.pl', os.path.join(ROOT, 'pict'), 'rel.log'],
+                          cwd=test_dir, capture_output=True, text=True)
+    elapsed = time.time() - started
+    current = None
+    seen = {}
+    order = []
+    verdicts = {}
+    for line in proc.stdout.splitlines():
+        if line.startswith('[') or not line.strip():
+            continue
+        if line.startswith('ERROR:'):
+            if current is not None:
+                verdicts[current].append(line)
+            continue
+        name = ' '.join(line.split())
+        seen[name] = seen.get(name, 0) + 1
+        if seen[name] > 1:
+            name = '%s #%d' % (name, seen[name])
+        name = name.replace('::', ': :')
+        current = name
+        order.append(name)
+        verdicts[name] = []
+    for name in order:
+        errors = verdicts[name]
+        classname = 'test.' + name.split('/')[0] if '/' in name else 'test'
+        results.append((classname, name, not errors, '\n'.join(errors), 0.0))
+    ok = proc.returncode == 0 and order
+    results.append(('test', 'perl harness completed', bool(ok),
+                    'exit %d\n%s\n%s' % (proc.returncode, proc.stdout[-5000:], proc.stderr[-5000:]), elapsed))
+    return results
+
+
+def write_junit(results, output_path, suite_name):
+    suites = ET.Element('testsuites')
+    failures = sum(1 for r in results if not r[2])
+    suite = ET.SubElement(suites, 'testsuite', name=suite_name, tests=str(len(results)),
+                          failures=str(failures), errors='0')
+    for classname, name, ok, detail, elapsed in results:
+        case = ET.SubElement(suite, 'testcase', classname=classname, name=name, time='%.3f' % elapsed)
+        if not ok:
+            failure = ET.SubElement(case, 'failure', message='failed')
+            failure.text = detail
+    ET.ElementTree(suites).write(output_path, encoding='utf-8', xml_declaration=True)
+
+
+def main():
+    args = sys.argv[1:]
+    if args and args[0] == '--one':
+        run_one(args[1], args[2])
+    mode = 'base'
+    output_path = None
+    index = 0
+    while index < len(args):
+        if args[index] == '--output_path':
+            output_path = args[index + 1]
+            index += 2
+            continue
+        if args[index].startswith('--output_path='):
+            output_path = args[index].split('=', 1)[1]
+        elif args[index] in ('base', 'new'):
+            mode = args[index]
+        index += 1
+    results = run_new() if mode == 'new' else run_base()
+    if output_path:
+        write_junit(results, output_path, 'negative_values' if mode == 'new' else 'pict_base')
+    failed = [r for r in results if not r[2]]
+    print('%d tests, %d failed' % (len(results), len(failed)))
+    sys.exit(1 if failed else 0)
+
+
+if __name__ == '__main__':
+    main()
