+import os
+import subprocess
+import tempfile
+
+from support_8f8ea0 import Param, Suite
+
+PICT = os.environ.get('PICT_BINARY', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'pict'))
+
+
+def run(model, *args, seeds=None):
+    proc = execute(model, *args, seeds=seeds)
+    assert proc.returncode == 0, 'pict exited with %d: %s' % (proc.returncode, proc.stderr)
+    return proc.stdout
+
+
+def execute(model, *args, seeds=None):
+    workdir = tempfile.mkdtemp(prefix='pictneg-')
+    path = os.path.join(workdir, 'model.txt')
+    with open(path, 'w') as handle:
+        handle.write(model)
+    extra = list(args)
+    if seeds is not None:
+        seed_path = os.path.join(workdir, 'seeds.txt')
+        with open(seed_path, 'w') as handle:
+            handle.write(seeds)
+        extra.append('/e:' + seed_path)
+    return subprocess.run([PICT, path] + extra, capture_output=True, text=True, timeout=120)
+
+
+def parse(model, output):
+    params = {}
+    for line in model.splitlines():
+        if ':' not in line or line.strip().startswith('#') or line.strip().startswith('{'):
+            continue
+        name, values = line.split(':', 1)
+        names = [v.strip() for v in values.split(',')]
+        param = Param(name.strip(), None, len(names), [i for i, v in enumerate(names) if v.startswith('~')])
+        param.labels = [v.lstrip('~') for v in names]
+        params[param.name] = param
+    lines = [line for line in output.splitlines() if line.strip()]
+    header = lines[0].split('\t')
+    assert sorted(header) == sorted(params), 'unexpected header %s' % header
+    rows = []
+    for line in lines[1:]:
+        cells = line.split('\t')
+        row = {}
+        for name, cell in zip(header, cells):
+            param = params[name]
+            label = cell[1:] if cell.startswith('~') else cell
+            value = param.labels.index(label)
+            assert cell.startswith('~') == (value in param.negatives), 'bad decoration %r for %s' % (cell, name)
+            row[name] = value
+        rows.append(row)
+    return Suite(params, rows)
+
+
+def seed_file(names, rows):
+    return '\t'.join(names) + '\n' + ''.join('\t'.join(row) + '\n' for row in rows)
+
+
+ISSUE_MODEL = """C1: 1, ~0
+C2: 1, 2, 3, ~0
+
+D1: ok, ~fail
+D2: 1, ~0, ~-1
+D3: 1, ~0, ~-1, ~-2, ~-3
+
+{C1, C2} @ 2
+{D1, D2, D3} @ 2
+"""
+
+WIDE_MODEL = """C1: a, b, ~x
+C2: 1, 2, 3, ~9
+
+D1: ok, ~fail
+D2: 1, 2, ~0
+D3: p, ~q, ~r, ~s
+
+{C1, C2} @ 2
+{D1, D2, D3} @ 2
+"""
+
+CONSTRAINED_MODEL = WIDE_MODEL + """
+IF [C1] = "x" THEN [D2] <> 1;
+IF [D1] = "fail" THEN [C2] <> 2;
+IF [C1] = "a" THEN [C2] <> 3;
+IF [D3] = "q" THEN [C1] <> "a";
+IF [C2] = 9 THEN [D2] <> 2;
+"""
+
+ONLY_NEGATIVE_LEFT_MODEL = """A: good1, good2, ~bad
+B: 1, 2
+C: x, y
+D: p, ~q
+
+{A, B}
+{C, D}
+
+[A] <> "good1";
+[A] <> "good2";
+"""
+
+CONSTRAINED_EXCLUSIONS = [{'C1': 2, 'D2': 0}, {'D1': 1, 'C2': 1}, {'C1': 0, 'C2': 2}, {'D3': 1, 'C1': 0}, {'C2': 3, 'D2': 1}]
+
+ORDER_THREE_MODEL = """A1: a, b, c, ~x
+A2: 1, 2
+B1: p, ~q
+B2: 1, ~0, ~-1
+B3: m, ~n, ~o
+C1: u, v, w
+C2: 7, ~9, 8
+
+{A1, A2} @ 2
+{B1, B2, B3} @ 2
+{C1, C2} @ 2
+"""
+
+SEEDED_MODEL = """D1: 1, ~0
+D2: 1, ~0
+D3: 1, ~0
+
+C1: 1, 2, ~0
+C2: 1, 2, ~0
+
+{C1, C2}
+{D1, D2, D3}
+"""
+
+TWO_VALUED_MODEL = """D1: 1, ~0
+D2: 1, ~0
+D3: 1, ~0
+
+C1: 1, ~0
+C2: 1, ~0
+
+{C1, C2}
+{D1, D2, D3}
+"""
+
+
+def assert_every_negative_shown(suite):
+    shown = {(name, row[name]) for row in suite.rows for name in suite.negatives_in(row)}
+    expected = {(p.name, v) for p in suite.params.values() for v in p.negatives}
+    assert shown == expected, 'negative values never generated: %s' % sorted(expected - shown)
+
+
+def test_cli_issue_model_shows_every_negative_value():
+    suite = parse(ISSUE_MODEL, run(ISSUE_MODEL))
+    suite.assert_single_negative()
+    assert_every_negative_shown(suite)
+    suite.assert_covered(['C1', 'C2'], 2)
+    suite.assert_covered(['D1', 'D2', 'D3'], 2)
+
+
+def test_cli_submodel_negative_value_meets_every_valid_value_of_the_other_submodel():
+    suite = parse(WIDE_MODEL, run(WIDE_MODEL))
+    suite.assert_single_negative()
+    suite.assert_across(['C1', 'C2'], ['D1', 'D2', 'D3'])
+
+
+def test_cli_submodel_order_three_with_negative_values():
+    model = ISSUE_MODEL.replace('D3: 1, ~0, ~-1, ~-2, ~-3\n', 'D3: 1, ~0, ~-1, ~-2, ~-3\nD4: y, ~n\n')
+    model = model.replace('{D1, D2, D3} @ 2', '{D1, D2, D3, D4} @ 3')
+    suite = parse(model, run(model))
+    suite.assert_single_negative()
+    assert_every_negative_shown(suite)
+    suite.assert_covered(['D1', 'D2', 'D3', 'D4'], 3)
+    suite.assert_across(['C1', 'C2'], ['D1', 'D2', 'D3', 'D4'])
+
+
+def test_cli_seeded_submodel_negative_values_appear():
+    seeds = seed_file(['C1', 'C2', 'D1'], [['1', '~0', ''], ['~0', '2', ''], ['2', '~0', '~0'], ['~0', '~0', '1']])
+    output = run(SEEDED_MODEL, '/o:1', seeds=seeds)
+    assert run(SEEDED_MODEL, '/o:1', seeds=seeds) == output
+    suite = parse(SEEDED_MODEL, output)
+    suite.assert_single_negative()
+    assert not suite.contains(suite.rows, {'C1': 1, 'C2': 2, 'D1': 1})
+    assert not suite.contains(suite.rows, {'C1': 2, 'C2': 2, 'D1': 0})
+    assert suite.contains(suite.rows, {'C1': 0, 'C2': 2})
+    assert suite.contains(suite.rows, {'C1': 2, 'C2': 1})
+    suite.assert_covered(['C1', 'C2', 'D1', 'D2', 'D3'], 1)
+
+
+def test_cli_two_valued_submodels_with_negative_seeds():
+    seeds = seed_file(['C1', 'C2'], [['1', '~0'], ['~0', '1']])
+    suite = parse(TWO_VALUED_MODEL, run(TWO_VALUED_MODEL, '/o:1', seeds=seeds))
+    suite.assert_single_negative()
+    assert suite.contains(suite.rows, {'C1': 0, 'C2': 1})
+    assert suite.contains(suite.rows, {'C1': 1, 'C2': 0})
+    suite.assert_covered(['C1', 'C2', 'D1', 'D2', 'D3'], 1)
+
+
+def test_cli_submodel_constraints_hold_with_negative_values():
+    output = run(CONSTRAINED_MODEL)
+    assert run(CONSTRAINED_MODEL) == output
+    suite = parse(CONSTRAINED_MODEL, output)
+    suite.assert_single_negative()
+    for row in suite.rows:
+        for exclusion in CONSTRAINED_EXCLUSIONS:
+            assert not all(row[name] == value for name, value in exclusion.items()), (row, exclusion)
+    assert_every_negative_shown(suite)
+    suite.assert_covered(['C1', 'C2'], 2, CONSTRAINED_EXCLUSIONS)
+    suite.assert_covered(['D1', 'D2', 'D3'], 2, CONSTRAINED_EXCLUSIONS)
+    suite.assert_across(['C1', 'C2'], ['D1', 'D2', 'D3'], CONSTRAINED_EXCLUSIONS)
+    proc = execute(ONLY_NEGATIVE_LEFT_MODEL)
+    assert proc.returncode != 0, 'pict generated rows although only a negative value of A is left:\n%s' % proc.stdout
+
+
+def test_cli_order_three_combines_submodels_in_triples():
+    suite = parse(ORDER_THREE_MODEL, run(ORDER_THREE_MODEL, '/o:3'))
+    suite.assert_single_negative()
+    assert_every_negative_shown(suite)
+    suite.assert_covered(['A1', 'A2'], 2)
+    suite.assert_covered(['B1', 'B2', 'B3'], 2)
+    suite.assert_covered(['C1', 'C2'], 2)
+    suite.assert_spanning([['A1', 'A2'], ['B1', 'B2', 'B3'], ['C1', 'C2']], 3)
