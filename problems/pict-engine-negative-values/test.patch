+import itertools
+
+
+class Param:
+    def __init__(self, name, handle, values, negatives=()):
+        self.name = name
+        self.handle = handle
+        self.values = values
+        self.negatives = set(negatives)
+
+    def valid(self):
+        return [v for v in range(self.values) if v not in self.negatives]
+
+
+class Suite:
+    def __init__(self, params, rows):
+        self.params = params
+        self.rows = rows
+
+    def is_negative(self, name, value):
+        return value in self.params[name].negatives
+
+    def negatives_in(self, row):
+        return [name for name, value in row.items() if self.is_negative(name, value)]
+
+    def positive_rows(self):
+        return [row for row in self.rows if not self.negatives_in(row)]
+
+    def contains(self, rows, assignment):
+        return any(all(row.get(name) == value for name, value in assignment.items()) for row in rows)
+
+    def assert_single_negative(self):
+        for row in self.rows:
+            found = self.negatives_in(row)
+            assert len(found) <= 1, 'row %s holds negative values of %s' % (row, found)
+
+    def missing_valid(self, names, order, excluded=()):
+        missing = []
+        positive = self.positive_rows()
+        for combo in itertools.combinations(names, order):
+            for values in itertools.product(*[self.params[n].valid() for n in combo]):
+                assignment = dict(zip(combo, values))
+                if skip(assignment, excluded):
+                    continue
+                if not self.contains(positive, assignment):
+                    missing.append(assignment)
+        return missing
+
+    def missing_negative(self, names, order, excluded=()):
+        missing = []
+        for combo in itertools.combinations(names, order):
+            for slot, name in enumerate(combo):
+                others = [self.params[n].valid() for n in combo[:slot] + combo[slot + 1:]]
+                for bad in sorted(self.params[name].negatives):
+                    for values in itertools.product(*others):
+                        rest = list(values)
+                        rest.insert(slot, bad)
+                        assignment = dict(zip(combo, rest))
+                        if skip(assignment, excluded):
+                            continue
+                        if not self.contains(self.rows, assignment):
+                            missing.append(assignment)
+        return missing
+
+    def assert_covered(self, names, order, excluded=()):
+        valid = self.missing_valid(names, order, excluded)
+        assert not valid, 'combinations of valid values missing from rows without negative values: %s' % valid[:5]
+        negative = self.missing_negative(names, order, excluded)
+        assert not negative, 'combinations of a negative value with valid values missing: %s' % negative[:5]
+
+    def assert_across(self, left, right, excluded=()):
+        missing_valid = []
+        missing_negative = []
+        positive = self.positive_rows()
+        for a in left:
+            for b in right:
+                pa, pb = self.params[a], self.params[b]
+                for va in range(pa.values):
+                    for vb in range(pb.values):
+                        assignment = {a: va, b: vb}
+                        if skip(assignment, excluded):
+                            continue
+                        bad = (va in pa.negatives) + (vb in pb.negatives)
+                        if bad == 0 and not self.contains(positive, assignment):
+                            missing_valid.append(assignment)
+                        if bad == 1 and not self.contains(self.rows, assignment):
+                            missing_negative.append(assignment)
+        assert not missing_valid, 'valid pairs across groups missing from rows without negative values: %s' % missing_valid[:5]
+        assert not missing_negative, 'negative values not combined with valid values across groups: %s' % missing_negative[:5]
+
+    def assert_spanning(self, groups, order, excluded=()):
+        missing_valid = []
+        missing_negative = []
+        positive = self.positive_rows()
+        for chosen in itertools.combinations(groups, order):
+            for names in itertools.product(*chosen):
+                for values in itertools.product(*[range(self.params[n].values) for n in names]):
+                    assignment = dict(zip(names, values))
+                    if skip(assignment, excluded):
+                        continue
+                    bad = sum(1 for n, v in assignment.items() if self.is_negative(n, v))
+                    if bad == 0 and not self.contains(positive, assignment):
+                        missing_valid.append(assignment)
+                    if bad == 1 and not self.contains(self.rows, assignment):
+                        missing_negative.append(assignment)
+        assert not missing_valid, 'valid combinations across groups missing from rows without negative values: %s' % missing_valid[:5]
+        assert not missing_negative, 'negative values not combined with valid values across groups: %s' % missing_negative[:5]
+
+
+def skip(assignment, excluded):
+    for exclusion in excluded:
+        if all(assignment.get(name) == value for name, value in exclusion.items()):
+            return True
+    return False
