+import os
+
+from library_8f8ea0 import LIB, PICT_GENERATION_ERROR, PICT_INVALID_VALUE, PICT_SUCCESS, ROOT, Tree, run_client
+
+
+def flat(order=2, seed=0):
+    tree = Tree(seed)
+    tree.param(tree.root, 'A', 4, negatives=[0], order=order)
+    tree.param(tree.root, 'B', 3, negatives=[2], order=order)
+    tree.param(tree.root, 'C', 3, order=order)
+    tree.param(tree.root, 'D', 4, negatives=[1, 3], order=order)
+    return tree
+
+
+def two_children():
+    tree = Tree()
+    left = tree.model()
+    right = tree.model()
+    tree.param(left, 'C1', 2, negatives=[1])
+    tree.param(left, 'C2', 4, negatives=[3])
+    tree.param(right, 'D1', 2, negatives=[1])
+    tree.param(right, 'D2', 3, negatives=[1, 2])
+    tree.param(right, 'D3', 5, negatives=[1, 2, 3, 4])
+    tree.attach(tree.root, left)
+    tree.attach(tree.root, right)
+    return tree
+
+
+def wide_children():
+    tree = Tree()
+    left = tree.model()
+    right = tree.model()
+    tree.param(left, 'L1', 3, negatives=[2])
+    tree.param(left, 'L2', 3)
+    tree.param(right, 'R1', 3, negatives=[0])
+    tree.param(right, 'R2', 4, negatives=[3])
+    tree.param(right, 'R3', 3)
+    tree.attach(tree.root, left)
+    tree.attach(tree.root, right)
+    return tree
+
+
+def test_marking_rejects_an_index_past_the_last_value():
+    tree = Tree()
+    param = tree.param(tree.root, 'A', 3)
+    wide = tree.param(tree.root, 'B', 6)
+    assert LIB.PictSetNegativeValue(param.handle, 3) == PICT_INVALID_VALUE
+    assert LIB.PictSetNegativeValue(wide.handle, 6) == PICT_INVALID_VALUE
+    assert LIB.PictSetNegativeValue(wide.handle, 40) == PICT_INVALID_VALUE
+    assert LIB.PictSetNegativeValue(param.handle, 2) == PICT_SUCCESS
+    assert LIB.PictSetNegativeValue(wide.handle, 5) == PICT_SUCCESS
+    tree.params['A'].negatives.add(2)
+    tree.params['B'].negatives.add(5)
+    suite = tree.generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['A', 'B'], 2)
+
+
+def test_marking_rejects_the_last_value_that_is_not_negative():
+    tree = Tree()
+    tree.param(tree.root, 'A', 3, negatives=[0, 2])
+    tree.param(tree.root, 'B', 2)
+    assert LIB.PictSetNegativeValue(tree.params['A'].handle, 1) == PICT_INVALID_VALUE
+    assert LIB.PictSetNegativeValue(tree.params['A'].handle, 0) == PICT_SUCCESS
+    assert LIB.PictSetNegativeValue(tree.params['A'].handle, 2) == PICT_SUCCESS
+    assert LIB.PictSetNegativeValue(tree.params['A'].handle, 1) == PICT_INVALID_VALUE
+    tree.param(tree.root, 'C', 4, negatives=[3, 0])
+    tree.negative('C', 2)
+    assert LIB.PictSetNegativeValue(tree.params['C'].handle, 1) == PICT_INVALID_VALUE
+    suite = tree.generate()
+    assert all(row['C'] == 1 for row in suite.positive_rows())
+    assert [row['A'] for row in suite.positive_rows()] and all(row['A'] == 1 for row in suite.positive_rows())
+    suite.assert_covered(['A', 'B', 'C'], 2)
+
+
+def test_flat_rows_hold_at_most_one_negative_value():
+    suite = flat().generate()
+    suite.assert_single_negative()
+    assert any(suite.negatives_in(row) for row in suite.rows)
+
+
+def test_flat_valid_pairs_come_from_rows_without_negative_values():
+    suite = flat().generate()
+    assert not suite.missing_valid(['A', 'B', 'C', 'D'], 2)
+
+
+def test_flat_negative_value_meets_every_valid_value():
+    suite = flat().generate()
+    suite.assert_single_negative()
+    assert not suite.missing_negative(['A', 'B', 'C', 'D'], 2)
+
+
+def test_flat_order_three_negative_value_meets_every_valid_pair():
+    suite = flat(order=3).generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['A', 'B', 'C', 'D'], 3)
+
+
+def test_flat_order_one_shows_every_value():
+    suite = flat(order=1).generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['A', 'B', 'C', 'D'], 1)
+
+
+def test_negative_rows_respect_exclusions():
+    tree = flat()
+    tree.exclude(('A', 0), ('C', 1))
+    tree.exclude(('B', 0), ('D', 1))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    excluded = [{'A': 0, 'C': 1}, {'B': 0, 'D': 1}]
+    for row in suite.rows:
+        assert not (row['A'] == 0 and row['C'] == 1) and not (row['B'] == 0 and row['D'] == 1), row
+    suite.assert_covered(['A', 'B', 'C', 'D'], 2, excluded)
+
+
+def test_exclusions_leaving_only_negative_values_fail_generation():
+    tree = Tree()
+    tree.param(tree.root, 'A', 3, negatives=[2])
+    tree.param(tree.root, 'B', 2)
+    tree.exclude(('A', 0))
+    tree.exclude(('A', 1))
+    LIB.PictSetRootModel(tree.task, tree.root)
+    assert LIB.PictGenerate(tree.task) == PICT_GENERATION_ERROR
+    nested = Tree()
+    middle = nested.model()
+    inner = nested.model()
+    nested.param(inner, 'I1', 3, negatives=[0])
+    nested.param(inner, 'I2', 2)
+    nested.param(middle, 'M1', 2)
+    nested.param(nested.root, 'R', 2)
+    nested.attach(middle, inner)
+    nested.attach(nested.root, middle)
+    nested.exclude(('I1', 1), ('I2', 0))
+    nested.exclude(('I1', 1), ('I2', 1))
+    nested.exclude(('I1', 2), ('M1', 0))
+    nested.exclude(('I1', 2), ('M1', 1))
+    LIB.PictSetRootModel(nested.task, nested.root)
+    assert LIB.PictGenerate(nested.task) == PICT_GENERATION_ERROR
+
+
+def test_seed_with_one_negative_value_is_a_negative_row():
+    tree = flat()
+    tree.seed(('A', 0), ('B', 1), ('C', 2), ('D', 2))
+    tree.seed(('B', 2), ('D', 0))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    assert suite.contains(suite.rows, {'A': 0, 'B': 1, 'C': 2, 'D': 2})
+    assert suite.contains(suite.rows, {'B': 2, 'D': 0})
+    assert not suite.missing_negative(['A', 'B', 'C', 'D'], 2)
+
+
+def test_seed_with_two_negative_values_is_not_honoured():
+    tree = flat()
+    tree.seed(('A', 0), ('B', 2), ('C', 0), ('D', 0))
+    tree.seed(('A', 1), ('B', 0), ('C', 0), ('D', 0))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    assert suite.contains(suite.positive_rows(), {'A': 1, 'B': 0, 'C': 0, 'D': 0})
+    suite.assert_covered(['A', 'B', 'C', 'D'], 2)
+
+
+def test_children_negative_values_all_appear():
+    suite = two_children().generate()
+    shown = {(name, row[name]) for row in suite.rows for name in suite.negatives_in(row)}
+    expected = {(p.name, v) for p in suite.params.values() for v in p.negatives}
+    assert shown == expected, 'negative values never generated: %s' % sorted(expected - shown)
+
+
+def test_child_negative_value_meets_its_own_child():
+    suite = two_children().generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['C1', 'C2'], 2)
+    suite.assert_covered(['D1', 'D2', 'D3'], 2)
+
+
+def test_child_negative_value_meets_every_valid_value_of_its_sibling():
+    suite = wide_children().generate()
+    suite.assert_single_negative()
+    suite.assert_across(['L1', 'L2'], ['R1', 'R2', 'R3'])
+
+
+def test_rows_never_hold_negative_values_of_two_children():
+    suite = two_children().generate()
+    suite.assert_single_negative()
+    suite.assert_across(['C1', 'C2'], ['D1', 'D2', 'D3'])
+
+
+def test_root_parameter_negative_value_meets_every_child():
+    tree = Tree()
+    child = tree.model()
+    other = tree.model()
+    tree.param(tree.root, 'R', 3, negatives=[2])
+    tree.param(child, 'X1', 2, negatives=[1])
+    tree.param(child, 'X2', 3)
+    tree.param(other, 'Y1', 3, negatives=[0])
+    tree.param(other, 'Y2', 2)
+    tree.attach(tree.root, child)
+    tree.attach(tree.root, other)
+    suite = tree.generate()
+    suite.assert_single_negative()
+    suite.assert_across(['R'], ['X1', 'X2', 'Y1', 'Y2'])
+    suite.assert_across(['X1', 'X2'], ['Y1', 'Y2'])
+
+
+def test_grandchild_negative_value_meets_every_valid_value_of_the_other_branch():
+    tree = Tree()
+    middle = tree.model()
+    inner = tree.model()
+    sibling = tree.model()
+    branch = tree.model()
+    tree.param(inner, 'I1', 3, negatives=[2])
+    tree.param(inner, 'I2', 2)
+    tree.param(sibling, 'S1', 3)
+    tree.param(sibling, 'S2', 2, negatives=[1])
+    tree.param(branch, 'B1', 3)
+    tree.param(branch, 'B2', 3, negatives=[0])
+    tree.attach(middle, inner)
+    tree.attach(middle, sibling)
+    tree.attach(tree.root, middle)
+    tree.attach(tree.root, branch)
+    suite = tree.generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['I1', 'I2'], 2)
+    suite.assert_across(['I1', 'I2'], ['S1', 'S2'])
+    suite.assert_across(['I1', 'I2', 'S1', 'S2'], ['B1', 'B2'])
+
+
+def test_seed_with_a_negative_child_value_appears():
+    tree = two_children()
+    tree.seed(('C1', 0), ('C2', 3))
+    tree.seed(('C1', 1), ('C2', 2))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    assert suite.contains(suite.rows, {'C1': 0, 'C2': 3})
+    assert suite.contains(suite.rows, {'C1': 1, 'C2': 2})
+
+
+def test_seed_across_children_with_one_negative_value_appears():
+    tree = wide_children()
+    tree.seed(('L1', 2), ('L2', 1), ('R1', 2), ('R2', 1), ('R3', 0))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    assert suite.contains(suite.rows, {'L1': 2, 'L2': 1, 'R1': 2, 'R2': 1, 'R3': 0})
+    suite.assert_across(['L1', 'L2'], ['R1', 'R2', 'R3'])
+
+
+def test_order_one_children_with_two_valued_parameters_and_negative_seeds():
+    tree = Tree()
+    left = tree.model()
+    right = tree.model()
+    for name in ('D1', 'D2', 'D3'):
+        tree.param(right, name, 2, negatives=[1], order=1)
+    for name in ('C1', 'C2'):
+        tree.param(left, name, 2, negatives=[1], order=1)
+    tree.attach(tree.root, left, 1)
+    tree.attach(tree.root, right, 1)
+    tree.seed(('C1', 0), ('C2', 1))
+    tree.seed(('C1', 1), ('C2', 0))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    assert suite.contains(suite.rows, {'C1': 0, 'C2': 1})
+    assert suite.contains(suite.rows, {'C1': 1, 'C2': 0})
+    suite.assert_covered(['C1', 'C2', 'D1', 'D2', 'D3'], 1)
+
+
+def test_result_parameters_map_every_column_once():
+    tree = two_children()
+    suite = tree.generate()
+    count = LIB.PictGetTotalParameterCount(tree.task)
+    assert count == 5
+    assert LIB.PictGetResultParameter(tree.task, count) is None
+    assert len(suite.rows) > 0
+
+
+def test_generating_again_repeats_the_rows():
+    tree = wide_children()
+    first = tree.generate().rows
+    second = tree.generate().rows
+    assert first == second
+    tree = flat()
+    first = tree.generate().rows
+    second = tree.generate().rows
+    assert first == second
+
+
+def test_generating_again_after_marking_another_value():
+    tree = wide_children()
+    tree.generate()
+    tree.negative('L2', 0)
+    tree.negative('R3', 2)
+    suite = tree.generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['L1', 'L2'], 2)
+    suite.assert_covered(['R1', 'R2', 'R3'], 2)
+    suite.assert_across(['L1', 'L2'], ['R1', 'R2', 'R3'])
+
+
+def test_public_header_declares_the_negative_value_api():
+    run_client('header')
+
+
+def test_deleting_model_trees_releases_every_parameter():
+    run_client('lifecycle')
+
+
+def excluded_tree():
+    tree = Tree()
+    middle = tree.model()
+    inner = tree.model()
+    branch = tree.model()
+    tree.param(inner, 'I1', 3, negatives=[2])
+    tree.param(inner, 'I2', 3)
+    tree.param(middle, 'M1', 4, negatives=[0])
+    tree.param(branch, 'B1', 3, negatives=[1])
+    tree.param(branch, 'B2', 3)
+    tree.attach(middle, inner)
+    tree.attach(tree.root, middle)
+    tree.attach(tree.root, branch)
+    excluded = [{'I1': 0, 'I2': 1}, {'I1': 2, 'I2': 0}, {'I2': 2, 'M1': 1}, {'M1': 2, 'B2': 0}, {'I2': 0, 'B1': 1}]
+    for exclusion in excluded:
+        tree.exclude(*exclusion.items())
+    return tree, excluded
+
+
+def test_exclusions_inside_and_across_child_models_hold_in_every_row():
+    tree, excluded = excluded_tree()
+    suite = tree.generate()
+    suite.assert_single_negative()
+    for row in suite.rows:
+        for exclusion in excluded:
+            assert not all(row[name] == value for name, value in exclusion.items()), (row, exclusion)
+
+
+def test_exclusions_in_a_model_tree_leave_every_other_combination_covered():
+    tree, excluded = excluded_tree()
+    suite = tree.generate()
+    suite.assert_covered(['I1', 'I2'], 2, excluded)
+    suite.assert_across(['I1', 'I2'], ['M1'], excluded)
+    suite.assert_across(['I1', 'I2', 'M1'], ['B1', 'B2'], excluded)
+
+
+def order_three_tree():
+    tree = Tree()
+    left = tree.model()
+    right = tree.model()
+    tree.param(tree.root, 'R', 6, negatives=[5], order=3)
+    tree.param(tree.root, 'S', 5, order=3)
+    tree.param(left, 'X1', 2, negatives=[1], order=3)
+    tree.param(left, 'X2', 2, order=3)
+    tree.param(left, 'X3', 2, order=3)
+    tree.param(right, 'Y1', 3, negatives=[0])
+    tree.param(right, 'Y2', 2)
+    tree.attach(tree.root, left, 3)
+    tree.attach(tree.root, right, 2)
+    return tree
+
+
+def test_order_three_model_combines_its_parameters_and_child_models_in_triples():
+    suite = order_three_tree().generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['X1', 'X2', 'X3'], 3)
+    suite.assert_covered(['Y1', 'Y2'], 2)
+    suite.assert_spanning([['R'], ['S'], ['X1', 'X2', 'X3'], ['Y1', 'Y2']], 3)
+
+
+def test_generating_again_repeats_the_rows_with_exclusions_and_seeds():
+    tree, excluded = excluded_tree()
+    tree.seed(('I1', 2), ('I2', 1), ('M1', 3), ('B1', 0), ('B2', 1))
+    tree.seed(('I1', 1), ('I2', 0), ('M1', 1))
+    first = tree.generate().rows
+    second = tree.generate().rows
+    third = tree.generate().rows
+    assert first == second == third
+    suite = tree.fetch()
+    assert suite.contains(suite.rows, {'I1': 2, 'I2': 1, 'M1': 3, 'B1': 0, 'B2': 1})
+    assert suite.contains(suite.rows, {'I1': 1, 'I2': 0, 'M1': 1})
+
+
+def test_seed_with_negative_values_of_two_children_is_not_honoured():
+    tree = wide_children()
+    tree.seed(('L1', 2), ('L2', 0), ('R1', 0), ('R2', 1), ('R3', 1))
+    tree.seed(('L1', 0), ('L2', 2), ('R1', 1), ('R2', 3), ('R3', 2))
+    suite = tree.generate()
+    suite.assert_single_negative()
+    assert not suite.contains(suite.rows, {'L1': 2, 'L2': 0, 'R1': 0, 'R2': 1, 'R3': 1})
+    assert suite.contains(suite.rows, {'L1': 0, 'L2': 2, 'R1': 1, 'R2': 3, 'R3': 2})
+    suite.assert_across(['L1', 'L2'], ['R1', 'R2', 'R3'])
+
+
+def test_flat_order_four_negative_value_meets_every_valid_triple():
+    tree = flat(order=4)
+    tree.param(tree.root, 'E', 3, negatives=[1], order=4)
+    suite = tree.generate()
+    suite.assert_single_negative()
+    suite.assert_covered(['A', 'B', 'C', 'D', 'E'], 4)
+
+
+def test_three_value_exclusions_hold_with_negative_values():
+    tree = flat(order=3)
+    tree.exclude(('A', 0), ('B', 1), ('C', 2))
+    tree.exclude(('B', 1), ('C', 0), ('D', 2))
+    tree.exclude(('A', 2), ('C', 1), ('D', 3))
+    excluded = [{'A': 0, 'B': 1, 'C': 2}, {'B': 1, 'C': 0, 'D': 2}, {'A': 2, 'C': 1, 'D': 3}]
+    suite = tree.generate()
+    suite.assert_single_negative()
+    for row in suite.rows:
+        for exclusion in excluded:
+            assert not all(row[name] == value for name, value in exclusion.items()), (row, exclusion)
+    suite.assert_covered(['A', 'B', 'C', 'D'], 3, excluded)
+
+
+def test_new_functions_are_listed_in_the_export_definition():
+    with open(os.path.join(ROOT, 'api', 'pict.def')) as handle:
+        lines = [line.split(';')[0].strip() for line in handle]
+    exports = lines[lines.index('EXPORTS') + 1:]
+    assert 'PictSetNegativeValue' in exports, exports
+    assert 'PictGetResultParameter' in exports, exports
