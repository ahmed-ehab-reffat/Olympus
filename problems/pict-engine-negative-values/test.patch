+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+cd "$(dirname "$0")"
+
+if [ -n "$OUTPUT_PATH" ]; then
+  mkdir -p "$(dirname "$OUTPUT_PATH")"
+fi
+
+BUILD_LOG="$(mktemp)"
+make -B -j"$(nproc 2>/dev/null || echo 2)" pict libpict.so >"$BUILD_LOG" 2>&1
+BUILD_STATUS=$?
+
+if [ $BUILD_STATUS -ne 0 ]; then
+  if [ -n "$OUTPUT_PATH" ]; then
+    {
+      printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+      printf '<testsuites><testsuite name="build" tests="1" failures="1" errors="0" time="0">\n'
+      printf '<testcase name="make" classname="build" time="0"><failure message="build failed"><![CDATA[\n'
+      tail -c 60000 "$BUILD_LOG" | sed 's/]]>/]] >/g'
+      printf ']]></failure></testcase>\n</testsuite></testsuites>\n'
+    } > "$OUTPUT_PATH"
+  fi
+  tail -40 "$BUILD_LOG"
+  exit 1
+fi
+
+if [ -n "$OUTPUT_PATH" ]; then
+  python3 -B tests/negative_8f8ea0/run_tests.py "$MODE" --output_path "$OUTPUT_PATH"
+else
+  python3 -B tests/negative_8f8ea0/run_tests.py "$MODE"
+fi
