+    pub(super) fn split_pieces(&self, laidx: usize) -> Option<Vec<LexerTypesT::LexemeT>> {
+        let lexeme = *self.lexemes.get(laidx)?;
+        let pieces = self.grm.token_split(TIdx(lexeme.tok_id()))?;
+        let span = lexeme.span();
+        let mut start = span.start();
+        let mut lexemes = Vec::with_capacity(pieces.len());
+        for &p_tidx in pieces {
+            let len = self.grm.token_name(p_tidx).unwrap().len();
+            lexemes.push(LexerTypesT::LexemeT::new(p_tidx.as_storaget(), start, len));
+            start += len;
+        }
+        (start == span.end()).then_some(lexemes)
+    }
