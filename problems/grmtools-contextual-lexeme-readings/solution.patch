+        laidx: usize,
+        pstack: impl FnOnce() -> PStack<StorageT>,
+    ) -> Reading<LexerTypesT::LexemeT> {
+        let Some(&lexeme) = self.lexemes.get(laidx) else {
+            return Reading::AsLexed;
+        };
+        let tidx = TIdx(lexeme.tok_id());
+        let fallback = self.grm.token_fallback(tidx);
+        let split = self.grm.token_split(tidx);
+        if fallback.is_none() && split.is_none() {
+            return Reading::AsLexed;
+        }
+        let pstack = pstack();
+        if self.can_shift_all(&pstack, &[tidx]) {
+            return Reading::AsLexed;
+        }
+        if let Some(fb_tidx) = fallback {
+            if self.can_shift_all(&pstack, &[fb_tidx]) {
+                let span = lexeme.span();
+                return Reading::Replaced(vec![LexerTypesT::LexemeT::new(
+                    fb_tidx.as_storaget(),
+                    span.start(),
+                    span.len(),
+                )]);
+            }
+            return Reading::Unreadable;
+        }
+        match self.split_pieces(laidx) {
+            Some(pieces) if self.can_shift_all(&pstack, split.unwrap()) => {
+                Reading::Replaced(pieces)
+            }
+            _ => Reading::Unreadable,
+        }
+    }
