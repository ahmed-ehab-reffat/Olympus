+use std::collections::{BTreeSet, HashMap};
+
+use cfgrammar::{
+    Span, Spanned, TIdx,
+    yacc::{YaccGrammar, YaccKind, YaccOriginalActionKind, parser::SpansKind},
+};
+use lrlex::{DefaultLexerTypes, LRNonStreamingLexerDef, LexerDef};
+use lrpar::{
+    LexParseError, Lexeme, NonStreamingLexer, ParseRepair, RTParserBuilder, RecoveryKind,
+    parser::AStackType,
+};
+use lrtable::{Minimiser, from_yacc};
+
+const KEYWORDS_LEX: &str = "%%
+let 'let'
+if 'if'
+= '='
+; ';'
+[a-z]+ 'id'
+[ \\t\\n]+ ;
+";
+
+const KEYWORDS_GRM: &str = "%start Stmts
+%fallback 'id' 'let' 'if'
+%%
+Stmts: Stmt | Stmts Stmt;
+Stmt: 'let' 'id' '=' 'id' ';' | 'if' 'id' ';' | 'id' ';';
+";
+
+const MERGED_LEX: &str = "%%
+x 'x'
+y 'y'
+z 'z'
+w 'w'
+q 'q'
+i 'id'
+[ \\t\\n]+ ;
+";
+
+const MERGED_GRM: &str = "%start S
+%fallback 'id' 'w'
+%%
+S: 'x' A 'y' | 'x' B 'id' 'y' | 'z' A 'w' | 'z' B 'q';
+A: 'id';
+B: 'id';
+";
+
+const GENERICS_LEX: &str = "%%
+>> '>>'
+> '>'
+\\< '<'
+, ','
+[a-z]+ 'id'
+[ \\t\\n]+ ;
+";
+
+const GENERICS_GRM: &str = "%start E
+%split '>>' '>' '>'
+%%
+E: T | E '>>' T;
+T: 'id' | 'id' '<' Args '>';
+Args: T | Args ',' T;
+";
+
+const BARE_LEX: &str = "%%
+let 'LET'
+= 'EQ'
+; 'SEMI'
+[a-z]+ 'ID'
+[ \\t\\n]+ ;
+";
+
+const BARE_GRM: &str = "%start S
+%token ID EQ SEMI
+%fallback ID LET
+%%
+S: LET ID EQ ID SEMI;
+";
+
+const SHIFT_ARROWS_LEX: &str = "%%
+>>= '>>='
+>> '>>'
+= '='
+\\< '<'
+[a-z]+ 'id'
+[ \\t\\n]+ ;
+";
+
+const SHIFT_ARROWS_GRM: &str = "%start S
+%split '>>=' '>>' '='
+%%
+S: 'id' '>>=' 'id' | T '=' 'id';
+T: 'id' '<' 'id' '<' 'id' '>>';
+";
+
+const COMPARE_LEX: &str = "%%
+>= '>='
+> '>'
+= '='
+[a-z]+ 'id'
+[ \\t\\n]+ ;
+";
+
+const COMPARE_GRM: &str = "%start S
+%split '>=' '>' '='
+%%
+S: 'id' '>' | 'id' '=';
+";
+
+const CLOSE_LEX: &str = "%%
+>> '>>'
+> '>'
+x 'X'
+[ \\t\\n]+ ;
+";
+
+const CLOSE_GRM: &str = "%start S
+%token X '>'
+%split '>>' '>' '>'
+%%
+S: X;
+";
+
+const NAMED_LEX: &str = "%%
+[a-z][a-z][a-z]? 'AB'
+[ \\t\\n]+ ;
+";
+
+const NAMED_GRM: &str = "%start S
+%token A B
+%split AB A B
+%%
+S: A B;
+";
+
+const THREE_LEX: &str = "%%
+>>>= '>>>='
+>> '>>'
+> '>'
+= '='
+\\< '<'
+[a-z]+ 'id'
+[ \\t\\n]+ ;
+";
+
+const THREE_GRM: &str = "%start S
+%split '>>>=' '>>' '>' '='
+%%
+S: T '>' '=' 'id' | 'id' '>>>=' 'id';
+T: 'id' '<' 'id' '<' 'id' '>>';
+";
+
+const THREE_RECOVERY_GRM: &str = "%start S
+%token '>'
+%split '>>>=' '>>' '>' '='
+%%
+S: T '=' 'id' | 'id' '>>>=' 'id';
+T: 'id' '<' 'id' '<' 'id' '>>';
+";
+
+fn grammar(src: &str) -> YaccGrammar<u32> {
+    match YaccGrammar::new(
+        YaccKind::Original(YaccOriginalActionKind::GenericParseTree),
+        src,
+    ) {
+        Ok(grm) => grm,
+        Err(errs) => panic!(
+            "grammar rejected: {:?}",
+            errs.iter().map(|e| e.to_string()).collect::<Vec<_>>()
+        ),
+    }
+}
+
+fn grammar_errors(src: &str) -> Vec<(Vec<String>, SpansKind)> {
+    match YaccGrammar::<u32>::new(
+        YaccKind::Original(YaccOriginalActionKind::GenericParseTree),
+        src,
+    ) {
+        Ok(_) => panic!("grammar accepted"),
+        Err(errs) => errs
+            .iter()
+            .map(|e| {
+                (
+                    e.spans().iter().map(|sp| at(src, *sp)).collect(),
+                    e.spanskind(),
+                )
+            })
+            .collect(),
+    }
+}
+
+enum Tree {
+    Leaf(String),
+    Node(String, Vec<Tree>),
+}
+
+fn render(tree: &Tree, out: &mut String) {
+    match tree {
+        Tree::Leaf(s) => out.push_str(s),
+        Tree::Node(name, nodes) => {
+            out.push_str(name);
+            out.push('(');
+            for (i, n) in nodes.iter().enumerate() {
+                if i > 0 {
+                    out.push(' ');
+                }
+                render(n, out);
+            }
+            out.push(')');
+        }
+    }
+}
+
+struct Outcome {
+    tree: Option<String>,
+    errors: Vec<(String, BTreeSet<String>)>,
+    error_tokens: Vec<String>,
+}
+
+fn at(input: &str, span: Span) -> String {
+    format!("{}@{}", &input[span.start()..span.end()], span.start())
+}
+
+fn run(lex_src: &str, grm_src: &str, input: &str, rk: RecoveryKind) -> Outcome {
+    run_with_costs(lex_src, grm_src, input, rk, &[])
+}
+
+fn run_with_costs(
+    lex_src: &str,
+    grm_src: &str,
+    input: &str,
+    rk: RecoveryKind,
+    costs: &[(&str, u8)],
+) -> Outcome {
+    let grm = grammar(grm_src);
+    let costs = costs
+        .iter()
+        .map(|&(n, c)| (grm.token_idx(n).unwrap(), c))
+        .collect::<HashMap<_, _>>();
+    let term_cost = |tidx| costs.get(&tidx).copied().unwrap_or(1);
+    let (_, stable) = from_yacc(&grm, Minimiser::Pager).unwrap();
+    let mut lexerdef = LRNonStreamingLexerDef::<DefaultLexerTypes<u32>>::from_str(lex_src).unwrap();
+    let rule_ids = grm
+        .tokens_map()
+        .iter()
+        .map(|(&n, &i)| (n, u32::from(i)))
+        .collect::<HashMap<&str, u32>>();
+    lexerdef.set_rule_ids(&rule_ids);
+    let lexer = lexerdef.lexer(input);
+    let fterm = |l: lrlex::DefaultLexeme<u32>| {
+        Tree::Leaf(format!(
+            "{}={}",
+            grm.token_name(TIdx(l.tok_id())).unwrap(),
+            lexer.span_str(l.span())
+        ))
+    };
+    let fnonterm = |ridx, nodes| Tree::Node(grm.rule_name_str(ridx).to_string(), nodes);
+    let (tree, errs) = RTParserBuilder::new(&grm, &stable)
+        .recoverer(rk)
+        .term_costs(&term_cost)
+        .parse_map(&lexer, &fterm, &fnonterm);
+    let tree = tree.map(|t| {
+        let mut s = String::new();
+        render(&t, &mut s);
+        s
+    });
+    let error_tokens = errs
+        .iter()
+        .map(|e| match e {
+            LexParseError::ParseError(pe) => grm
+                .token_name(TIdx(pe.lexeme().tok_id()))
+                .unwrap()
+                .to_string(),
+            LexParseError::LexError(_) => panic!("unexpected lexing error"),
+        })
+        .collect();
+    let errors = errs
+        .iter()
+        .map(|e| match e {
+            LexParseError::ParseError(pe) => {
+                let repairs = pe
+                    .repairs()
+                    .iter()
+                    .map(|seq| {
+                        seq.iter()
+                            .map(|r| match r {
+                                ParseRepair::Insert(t) => {
+                                    format!("insert {}", grm.token_name(*t).unwrap())
+                                }
+                                ParseRepair::Delete(l) => format!("delete {}", at(input, l.span())),
+                                ParseRepair::Shift(l) => format!("shift {}", at(input, l.span())),
+                            })
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    })
+                    .collect::<BTreeSet<_>>();
+                (at(input, pe.lexeme().span()), repairs)
+            }
+            LexParseError::LexError(_) => panic!("unexpected lexing error"),
+        })
+        .collect();
+    Outcome {
+        tree,
+        errors,
+        error_tokens,
+    }
+}
+
+fn actions(lex_src: &str, grm_src: &str, input: &str) -> String {
+    let grm = grammar(grm_src);
+    let (_, stable) = from_yacc(&grm, Minimiser::Pager).unwrap();
+    let mut lexerdef = LRNonStreamingLexerDef::<DefaultLexerTypes<u32>>::from_str(lex_src).unwrap();
+    let rule_ids = grm
+        .tokens_map()
+        .iter()
+        .map(|(&n, &i)| (n, u32::from(i)))
+        .collect::<HashMap<&str, u32>>();
+    lexerdef.set_rule_ids(&rule_ids);
+    let lexer = lexerdef.lexer(input);
+    let action = |ridx,
+                  _: &dyn NonStreamingLexer<DefaultLexerTypes<u32>>,
+                  _,
+                  args: std::vec::Drain<AStackType<lrlex::DefaultLexeme<u32>, String>>,
+                  _: ()| {
+        let args = args
+            .map(|a| match a {
+                AStackType::Lexeme(l) => format!(
+                    "{}@{}..{}",
+                    grm.token_name(TIdx(l.tok_id())).unwrap(),
+                    l.span().start(),
+                    l.span().end()
+                ),
+                AStackType::ActionType(s) => s,
+            })
+            .collect::<Vec<_>>();
+        format!("{}({})", grm.rule_name_str(ridx), args.join(" "))
+    };
+    let acts = vec![
+        &action
+            as &dyn Fn(
+                _,
+                &dyn NonStreamingLexer<DefaultLexerTypes<u32>>,
+                _,
+                std::vec::Drain<AStackType<lrlex::DefaultLexeme<u32>, String>>,
+                (),
+            ) -> String;
+        usize::from(grm.prods_len())
+    ];
+    let (res, errs) = RTParserBuilder::new(&grm, &stable).parse_actions(&lexer, &acts, ());
+    assert!(errs.is_empty(), "unexpected errors: {:?}", errs);
+    res.unwrap()
+}
+
+fn parses(lex_src: &str, grm_src: &str, input: &str) -> String {
+    let o = run(lex_src, grm_src, input, RecoveryKind::CPCTPlus);
+    assert!(o.errors.is_empty(), "unexpected errors: {:?}", o.errors);
+    o.tree.unwrap()
+}
+
+fn set(items: &[&str]) -> BTreeSet<String> {
+    items.iter().map(|s| s.to_string()).collect()
+}
+
+fn strs(items: &[&str]) -> Vec<String> {
+    items.iter().map(|s| s.to_string()).collect()
+}
+
+fn unused_tokens(src: &str) -> BTreeSet<String> {
+    let ast = cfgrammar::yacc::ast::ASTWithValidityInfo::new(
+        YaccKind::Original(YaccOriginalActionKind::GenericParseTree),
+        src,
+    );
+    assert!(ast.is_valid());
+    ast.ast()
+        .warnings()
+        .iter()
+        .map(|w| src[w.spans()[0].start()..w.spans()[0].end()].to_string())
+        .collect()
+}
+
+#[test]
+fn a_grammar_with_fallback_and_split_declarations_is_accepted() {
+    let grm = grammar(GENERICS_GRM);
+    assert!(grm.token_idx(">>").is_some());
+    let grm = grammar(KEYWORDS_GRM);
+    assert!(grm.token_idx("let").is_some());
+    assert!(grm.token_idx("if").is_some());
+}
+
+#[test]
+fn a_keyword_is_read_as_its_fallback_where_it_cannot_be_shifted() {
+    assert_eq!(
+        parses(KEYWORDS_LEX, KEYWORDS_GRM, "let let = if;"),
+        "Stmts(Stmt(let=let id=let === id=if ;=;))"
+    );
+}
+
+#[test]
+fn a_keyword_that_can_be_shifted_keeps_its_own_token() {
+    assert_eq!(
+        parses(KEYWORDS_LEX, KEYWORDS_GRM, "if x; let a = b;"),
+        "Stmts(Stmts(Stmt(if=if id=x ;=;)) Stmt(let=let id=a === id=b ;=;))"
+    );
+}
+
+#[test]
+fn a_keyword_that_can_be_shifted_is_not_reread_when_a_later_token_fails() {
+    let o = run(KEYWORDS_LEX, KEYWORDS_GRM, "let;", RecoveryKind::None);
+    assert!(o.tree.is_none());
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ";@3");
+}
+
+#[test]
+fn the_reading_is_decided_before_the_lexeme_triggers_a_reduction() {
+    assert_eq!(
+        parses(MERGED_LEX, MERGED_GRM, "x i w y"),
+        "S(x=x B(id=i) id=w y=y)"
+    );
+}
+
+#[test]
+fn a_fallback_token_that_can_be_shifted_is_read_as_lexed_in_a_merged_state() {
+    assert_eq!(
+        parses(MERGED_LEX, MERGED_GRM, "z i w"),
+        "S(z=z A(id=i) w=w)"
+    );
+}
+
+#[test]
+fn a_split_lexeme_closes_two_argument_lists() {
+    assert_eq!(
+        parses(GENERICS_LEX, GENERICS_GRM, "a<b<c>>"),
+        "E(T(id=a <=< Args(T(id=b <=< Args(T(id=c)) >=>)) >=>))"
+    );
+}
+
+#[test]
+fn a_split_lexeme_that_can_be_shifted_is_read_as_lexed() {
+    assert_eq!(
+        parses(GENERICS_LEX, GENERICS_GRM, "a<b<c>>>>d"),
+        "E(E(T(id=a <=< Args(T(id=b <=< Args(T(id=c)) >=>)) >=>)) >>=>> T(id=d))"
+    );
+}
+
+#[test]
+fn a_lexeme_no_reading_fits_is_reported_as_lexed_without_recovery() {
+    let o = run(GENERICS_LEX, GENERICS_GRM, "a<b>>", RecoveryKind::None);
+    assert!(o.tree.is_none());
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ">>@3");
+    assert!(o.errors[0].1.is_empty());
+    assert_eq!(o.error_tokens, strs(&[">>"]));
+}
+
+#[test]
+fn recovery_reads_a_later_split_lexeme_as_its_pieces() {
+    let o = run(
+        GENERICS_LEX,
+        GENERICS_GRM,
+        "a<b<c,,>>",
+        RecoveryKind::CPCTPlus,
+    );
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ",@6");
+    assert_eq!(
+        o.errors[0].1,
+        set(&["insert id, delete ,@6", "insert id, shift ,@6, insert id"])
+    );
+    assert!(o.tree.unwrap().ends_with(" >=>)) >=>))"));
+}
+
+#[test]
+fn recovery_repairs_a_split_lexeme_one_piece_at_a_time() {
+    let o = run(GENERICS_LEX, GENERICS_GRM, "a<b>>", RecoveryKind::CPCTPlus);
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ">>@3");
+    assert_eq!(o.errors[0].1, set(&["delete >@3", "shift >@3, delete >@4"]));
+    assert_eq!(o.tree.unwrap(), "E(T(id=a <=< Args(T(id=b)) >=>))");
+}
+
+#[test]
+fn an_unknown_fallback_target_is_an_error_at_the_target() {
+    let errs = grammar_errors("%start S\n%fallback 'q' 'b'\n%%\nS: 'a';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["q@20"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn a_token_declared_by_two_declarations_is_a_duplication_error() {
+    let errs =
+        grammar_errors("%start S\n%fallback 'a' 'b'\n%split 'b' 'x' 'y'\n%%\nS: 'a' | 'x' 'y';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["b@24", "b@35"]));
+    assert_eq!(errs[0].1, SpansKind::DuplicationError);
+}
+
+#[test]
+fn a_split_whose_pieces_do_not_spell_the_token_is_an_error() {
+    let errs = grammar_errors("%start S\n%split 'ab' 'a' 'c'\n%%\nS: 'a' 'b' | 'c';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["ab@17"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn a_declared_token_is_used_when_its_target_is_used() {
+    let src = "%start S\n%token u\n%fallback 'a' 'b'\n%fallback 'u' 'c'\n%%\nS: 'a';\n";
+    assert_eq!(unused_tokens(src), set(&["c", "u"]));
+}
+
+#[test]
+fn bare_named_declared_tokens_are_grammar_terminals() {
+    let grm = grammar("%start S\n%token T\n%fallback T A\n%%\nS: A;\n");
+    assert!(grm.token_idx("A").is_some());
+    let grm = grammar("%start S\n%token P\n%split PP P P\n%%\nS: PP | P;\n");
+    assert!(grm.token_idx("PP").is_some());
+    assert_eq!(
+        parses(BARE_LEX, BARE_GRM, "let let = x;"),
+        "S(LET=let ID=let EQ== ID=x SEMI=;)"
+    );
+}
+
+#[test]
+fn recovery_deletes_an_unreadable_split_lexeme_piece_by_piece() {
+    let o = run(CLOSE_LEX, CLOSE_GRM, "x>>", RecoveryKind::CPCTPlus);
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ">>@1");
+    assert_eq!(o.errors[0].1, set(&["delete >@1, delete >@2"]));
+    assert_eq!(o.tree.unwrap(), "S(X=x)");
+}
+
+#[test]
+fn deleting_a_split_piece_costs_what_its_token_costs() {
+    let o = run(COMPARE_LEX, COMPARE_GRM, "a>=", RecoveryKind::CPCTPlus);
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ">=@1");
+    assert_eq!(o.errors[0].1, set(&["delete >@1", "shift >@1, delete =@2"]));
+    let o = run_with_costs(
+        COMPARE_LEX,
+        COMPARE_GRM,
+        "a>=",
+        RecoveryKind::CPCTPlus,
+        &[(">", 3)],
+    );
+    assert_eq!(o.errors[0].1, set(&["shift >@1, delete =@2"]));
+    assert_eq!(o.tree.unwrap(), "S(id=a >=>)");
+    let o = run_with_costs(
+        COMPARE_LEX,
+        COMPARE_GRM,
+        "a>=",
+        RecoveryKind::CPCTPlus,
+        &[("=", 3)],
+    );
+    assert_eq!(o.errors[0].1, set(&["delete >@1"]));
+    assert_eq!(o.tree.unwrap(), "S(id=a ===)");
+}
+
+#[test]
+fn split_pieces_of_unequal_length_carry_their_own_spans() {
+    assert_eq!(
+        parses(SHIFT_ARROWS_LEX, SHIFT_ARROWS_GRM, "a<b<c>>=d"),
+        "S(T(id=a <=< id=b <=< id=c >>=>>) === id=d)"
+    );
+    assert_eq!(
+        parses(SHIFT_ARROWS_LEX, SHIFT_ARROWS_GRM, "a >>= c"),
+        "S(id=a >>==>>= id=c)"
+    );
+}
+
+#[test]
+fn recovery_reads_a_later_keyword_as_its_fallback() {
+    let o = run(
+        KEYWORDS_LEX,
+        KEYWORDS_GRM,
+        "let a = = if;",
+        RecoveryKind::CPCTPlus,
+    );
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, "=@8");
+    assert_eq!(o.errors[0].1, set(&["delete =@8"]));
+    assert_eq!(o.tree.unwrap(), "Stmts(Stmt(let=let id=a === id=if ;=;))");
+}
