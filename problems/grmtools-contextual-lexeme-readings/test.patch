+#[test]
+fn a_split_without_pieces_is_an_error_at_the_declared_token() {
+    let errs = grammar_errors("%start S\n%split 'a'\n%%\nS: 'a';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["a@17"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn a_split_with_one_piece_is_an_error_at_the_declared_token() {
+    let errs = grammar_errors("%start S\n%split 'a' 'a'\n%%\nS: 'a';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["a@17"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn a_fallback_to_the_declared_token_is_an_error_at_the_declared_token() {
+    let errs = grammar_errors("%start S\n%fallback 'a' 'a'\n%%\nS: 'a';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["a@24"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn a_fallback_to_a_declared_token_is_an_error_at_the_declared_token() {
+    let errs = grammar_errors("%start S\n%fallback 'b' 'c'\n%fallback 'a' 'b'\n%%\nS: 'a';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["c@24"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+    let errs =
+        grammar_errors("%start S\n%split 'xy' 'x' 'y'\n%fallback 'xy' 'd'\n%%\nS: 'x' 'y';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["d@45"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn an_unknown_split_piece_is_an_error_at_the_piece() {
+    let errs = grammar_errors("%start S\n%split 'ab' 'a' 'b'\n%%\nS: 'a';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["b@26"]));
+    assert_eq!(errs[0].1, SpansKind::Error);
+}
+
+#[test]
+fn a_token_declared_twice_by_one_kind_is_a_duplication_error() {
+    let errs =
+        grammar_errors("%start S\n%fallback 'a' 'b'\n%fallback 'x' 'b'\n%%\nS: 'a' | 'x';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["b@24", "b@42"]));
+    assert_eq!(errs[0].1, SpansKind::DuplicationError);
+    let errs =
+        grammar_errors("%start S\n%split 'xy' 'x' 'y'\n%split 'xy' 'x' 'y'\n%%\nS: 'x' 'y';\n");
+    assert_eq!(errs.len(), 1);
+    assert_eq!(errs[0].0, strs(&["xy@17", "xy@37"]));
+    assert_eq!(errs[0].1, SpansKind::DuplicationError);
+}
+
+#[test]
+fn a_split_token_is_used_only_when_every_piece_is_used() {
+    assert_eq!(
+        unused_tokens("%start S\n%token 'y'\n%split 'xy' 'x' 'y'\n%%\nS: 'x';\n"),
+        set(&["xy", "y"])
+    );
+    assert!(
+        unused_tokens("%start S\n%token 'y'\n%split 'xy' 'x' 'y'\n%%\nS: 'x' 'y';\n").is_empty()
+    );
+}
+
+#[test]
+fn a_keyword_no_reading_fits_is_reported_as_lexed_without_recovery() {
+    let o = run(KEYWORDS_LEX, KEYWORDS_GRM, "x let;", RecoveryKind::None);
+    assert!(o.tree.is_none());
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, "let@2");
+    assert!(o.errors[0].1.is_empty());
+    assert_eq!(o.error_tokens, strs(&["let"]));
+}
+
+#[test]
+fn actions_receive_a_fallback_lexeme_with_its_target_token_and_span() {
+    assert_eq!(
+        actions(KEYWORDS_LEX, KEYWORDS_GRM, "let let = if;"),
+        "Stmts(Stmt(let@0..3 id@4..7 =@8..9 id@10..12 ;@12..13))"
+    );
+}
+
+#[test]
+fn named_split_pieces_take_the_lengths_of_their_names() {
+    assert_eq!(actions(NAMED_LEX, NAMED_GRM, "xy"), "S(A@0..1 B@1..2)");
+}
+
+#[test]
+fn a_split_lexeme_longer_than_its_token_name_is_not_read_as_pieces() {
+    let o = run(NAMED_LEX, NAMED_GRM, "xyz", RecoveryKind::None);
+    assert!(o.tree.is_none());
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, "xyz@0");
+    assert_eq!(o.error_tokens, strs(&["AB"]));
+    let o = run(NAMED_LEX, NAMED_GRM, "xyz", RecoveryKind::CPCTPlus);
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, "xyz@0");
+    assert_eq!(o.errors[0].1, set(&["insert A, insert B, delete xyz@0"]));
+}
+
+#[test]
+fn a_three_piece_split_is_read_with_unequal_piece_spans() {
+    assert_eq!(
+        actions(THREE_LEX, THREE_GRM, "a<b<c>>>=d"),
+        "S(T(id@0..1 <@1..2 id@2..3 <@3..4 id@4..5 >>@5..7) >@7..8 =@8..9 id@9..10)"
+    );
+    assert_eq!(
+        actions(THREE_LEX, THREE_GRM, "a >>>= b"),
+        "S(id@0..1 >>>=@2..6 id@7..8)"
+    );
+}
+
+#[test]
+fn recovery_deletes_the_middle_piece_of_a_three_piece_split() {
+    let o = run(
+        THREE_LEX,
+        THREE_RECOVERY_GRM,
+        "a<b<c>>>=d",
+        RecoveryKind::CPCTPlus,
+    );
+    assert_eq!(o.errors.len(), 1);
+    assert_eq!(o.errors[0].0, ">>>=@5");
+    assert_eq!(o.errors[0].1, set(&["shift >>@5, delete >@7"]));
+    assert_eq!(
+        o.tree.unwrap(),
+        "S(T(id=a <=< id=b <=< id=c >>=>>) === id=d)"
+    );
+}
