+#!/usr/bin/env bash
+set -uo pipefail
+export PATH="/opt/cargo/bin:/root/.cargo/bin:$PATH"
+export CARGO_INCREMENTAL=0
+export RUSTC_BOOTSTRAP=1
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+
+cd "$(dirname "$0")" || exit 1
+
+NEW_FILE="lrlex/tests/readings_0638b7.rs"
+WORK="$(mktemp -d)"
+trap 'rm -rf "$WORK"' EXIT
+STATUS=0
+
+run_pkg() {
+  local pkg="$1"
+  shift
+  cargo test -p "$pkg" "$@" -- --test-threads=1 -Z unstable-options --format json >"$WORK/$pkg.json" 2>"$WORK/$pkg.log"
+  local rc=$?
+  cat "$WORK/$pkg.log" >&2
+  grep -v '^{' "$WORK/$pkg.json" >&2
+  if [ "$rc" -ne 0 ]; then
+    STATUS=1
+  fi
+  if grep -q '"type": *"test"' "$WORK/$pkg.json"; then
+    cargo2junit <"$WORK/$pkg.json" >"$WORK/$pkg.xml" 2>>"$WORK/$pkg.log"
+  fi
+  echo "$pkg $rc" >>"$WORK/packages"
+}
+
+if [ "$MODE" = "base" ]; then
+  cargo clean -p lrpar-tests >/dev/null 2>&1
+  run_pkg cfgrammar --lib
+  run_pkg lrtable --lib
+  run_pkg lrpar --lib
+  run_pkg lrlex --lib --bins
+  run_pkg lrpar-tests --lib
+  run_pkg nimbleparse --bins
+else
+  run_pkg lrlex --test readings_0638b7
+fi
+
+if [ -z "$OUTPUT_PATH" ]; then
+  exit $STATUS
+fi
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+python3 - "$WORK" "$MODE" "$NEW_FILE" "$OUTPUT_PATH" "$STATUS" <<'PY'
+import os
+import re
+import sys
+import xml.etree.ElementTree as ET
+
+work, mode, new_file, out, status = sys.argv[1:6]
+root = ET.Element("testsuites")
+missing = []
+for line in open(os.path.join(work, "packages")).read().splitlines():
+    pkg, rc = line.split()
+    path = os.path.join(work, pkg + ".xml")
+    suites = []
+    if os.path.exists(path):
+        try:
+            suites = list(ET.parse(path).getroot().iter("testsuite"))
+        except ET.ParseError:
+            suites = []
+    if not any(s.find("testcase") is not None for s in suites):
+        if rc != "0":
+            missing.append(pkg)
+        continue
+    for suite in suites:
+        suite.set("name", pkg)
+        for case in suite.iter("testcase"):
+            parts = case.get("classname", "").split("::")
+            if mode == "new":
+                parts = ["readings_0638b7"]
+            case.set("classname", ".".join([pkg] + [p for p in parts if p]))
+            case.set("name", case.get("name", "").replace("::", "."))
+        root.append(suite)
+
+for pkg in missing:
+    log = open(os.path.join(work, pkg + ".log"), errors="replace").read().splitlines()
+    diag = "\n".join(log[-60:])
+    if mode == "new":
+        src = open(new_file).read()
+        names = re.findall(r"#\[test\]\s*fn\s+([a-z0-9_]+)", src)
+        classname = pkg + ".readings_0638b7"
+    else:
+        names = ["build"]
+        classname = pkg
+    suite = ET.SubElement(root, "testsuite", name=pkg, tests=str(len(names)), failures=str(len(names)), errors="0")
+    for name in names:
+        case = ET.SubElement(suite, "testcase", name=name, classname=classname)
+        failure = ET.SubElement(case, "failure", message="cargo test exited with status %s before reporting this test" % status)
+        failure.text = diag
+
+ET.ElementTree(root).write(out, encoding="UTF-8", xml_declaration=True)
+if missing:
+    sys.exit(1)
+PY
+if [ $? -ne 0 ]; then
+  STATUS=1
+fi
+
+exit $STATUS
