+
+  test("wgsl_specialization_tracks_the_guard_profile", () => {
+    const dag = parseFormula("if(x > 2, 1 / 0, 7)", ["x"], { outputLabel: "f" });
+    const raw = createDagWgslSpecialization(dag, { parameters: [{ name: "x", range: [[0, 1]] }] });
+    const wrapped = createDagWgslSpecialization(dag, { parameters: [{ name: "x", range: [[0, 3]] }] });
+    assert.notEqual(raw.guardSignature, wrapped.guardSignature);
+    assert.equal(raw.guardProfile[dag.root], "raw");
+    assert.equal(wrapped.guardProfile[dag.root], "wrapped");
+    const compiled = generateDagWgslFunction(dag, {
+      parameters: [{ name: "x", range: [[0, 1]] }],
+      labels: ["f"],
+      specialization: raw,
+    });
+    assertWgslTypesAgree(compiled.code, "specialized if(x > 2, 1 / 0, 7)");
+  });
+
+  test("substitution_preserves_conditionals", () => {
+    const original = parseFormula("if(x > 0, x, 0 - x)", ["x"], { outputLabel: "f" });
+    const shifted = substituteDagParameters(original, {
+      x: parseFormula("x - x_0", ["x", "x_0"]),
+    });
+    const evaluate = createDagClosureEvaluator(shifted);
+    assert.equal(evaluate({ x: 1, x_0: 3 }).f, 2);
+    assert.equal(evaluate({ x: 5, x_0: 3 }).f, 2);
+    assert.equal(shifted.nodes.some((node) => node.kind === "call" && node.name === "if"), true);
+    assert.equal(shifted.nodes.some((node) => node.kind === "binary" && node.op === ">"), true);
+  });
+
+  test("number_extraction_preserves_conditionals", () => {
+    const dag = parseFormula("if(x > 1, 2, 3)", ["x"], { outputLabel: "f" });
+    const { dag: extracted, extracted: numbers } = extractNumbersAsParameters(dag);
+    assert.equal(numbers.length, 3);
+    const params = Object.fromEntries(numbers.map((entry) => [entry.name, entry.value]));
+    const evaluate = createDagClosureEvaluator(extracted);
+    assert.equal(evaluate({ ...params, x: 5 }).f, 2);
+    assert.equal(evaluate({ ...params, x: 0 }).f, 3);
+  });
+
+  test("combined_dags_keep_comparisons", () => {
+    const left = parseFormula("a = x < 1", ["x"]);
+    const right = parseFormula("b = if(x >= 1, x, 0)", ["x"]);
+    const combined = combineDags([left, right]);
+    const evaluate = createDagClosureEvaluator(combined);
+    assert.deepEqual({ ...evaluate({ x: 2 }) }, { a: 0, b: 2 });
+    assert.deepEqual({ ...evaluate({ x: 0 }) }, { a: 1, b: 0 });
+  });
+});
+
+function randomConditionalExpression(rng, depth) {
+  if (depth <= 0) return randomLeaf(rng);
+  const choice = Math.floor(rng() * 9);
+  const a = randomConditionalExpression(rng, depth - 1);
+  const b = randomConditionalExpression(rng, depth - 1);
+  const c = randomConditionalExpression(rng, depth - 1);
+  if (choice === 0) return `if(${randomCondition(rng, depth - 1)}, ${a}, ${b})`;
+  if (choice === 1) return `if(and(${randomCondition(rng, depth - 1)}, ${randomCondition(rng, depth - 1)}), ${a}, ${b})`;
+  if (choice === 2) return `if(or(${randomCondition(rng, depth - 1)}, ${randomCondition(rng, depth - 1)}), ${a}, ${b})`;
+  if (choice === 3) return `if(not(${randomCondition(rng, depth - 1)}), ${a}, ${b})`;
+  if (choice === 4) return `((${a}) + (${b}))`;
+  if (choice === 5) return `((${a}) * (${b}))`;
+  if (choice === 6) return `sin(${a})`;
+  if (choice === 7) return `if(${randomCondition(rng, depth - 1)}, ${a}, ${c})`;
+  return `((${a}) - (${b}))`;
+}
+
+function randomCondition(rng, depth) {
+  const ops = ["<", "<=", ">", ">=", "==", "!="];
+  const op = ops[Math.floor(rng() * ops.length)];
+  return `(${randomConditionalExpression(rng, depth)}) ${op} (${randomConditionalExpression(rng, depth)})`;
+}
+
+function randomLeaf(rng) {
+  const choice = Math.floor(rng() * 5);
+  if (choice === 0) return "x";
+  if (choice === 1) return "y";
+  return String([-2, -1, 0.5, 1, 2][Math.floor(rng() * 5)]);
+}
+
+function createRng(seed) {
+  let state = seed >>> 0;
+  return () => {
+    state = (state + 0x6d2b79f5) >>> 0;
+    let t = state;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
