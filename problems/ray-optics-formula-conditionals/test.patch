+import assert from "node:assert/strict";
+import { combineDags } from "../../src/core/formula/dag-combination.js";
+import {
+  createDagClosureEvaluator,
+  createDagEvaluator,
+} from "../../src/core/formula/dag-evaluator.js";
+import { generateDagJsEvaluator } from "../../src/core/formula/dag-js-generator.js";
+import { findNodeByLabel } from "../../src/core/formula/dag-util.js";
+import {
+  createDagWgslSpecialization,
+  generateDagWgslFunction,
+  WGSL_RUNTIME_CODE,
+} from "../../src/core/formula/dag-wgsl-generator.js";
+import { appendPartialDerivatives } from "../../src/core/formula/derivative.js";
+import {
+  isValidFormulaParameterName,
+  parseFormula,
+  FormulaParseError,
+} from "../../src/core/formula/formula-parser.js";
+import { extractNumbersAsParameters } from "../../src/core/formula/parameter-extraction.js";
+import { estimateDagRanges, formatRangeInfo } from "../../src/core/formula/range-estimator.js";
+import { substituteDagParameters } from "../../src/core/formula/substitution.js";
+
+function rejects(expression, parameters) {
+  assert.throws(
+    () => parseFormula(expression, parameters),
+    (error) => error instanceof FormulaParseError,
+    `${expression} should be a parse error`,
+  );
+}
+
+function root(expression, parameters = []) {
+  const dag = parseFormula(expression, parameters);
+  return { dag, node: dag.nodes[dag.root] };
+}
+
+function loadCompiled(dag) {
+  const generated = generateDagJsEvaluator(dag);
+  return new Function(`${generated.code}\nreturn ${generated.functionName};`)();
+}
+
+function both(expression, parameters, point) {
+  const dag = parseFormula(expression, parameters, { outputLabel: "f" });
+  const interpreted = createDagClosureEvaluator(dag)(point).f;
+  const compiled = loadCompiled(dag)(point).f;
+  const wrapped = createDagEvaluator(dag)(point).f;
+  if (Number.isNaN(interpreted)) {
+    assert.equal(Number.isNaN(compiled), true, `${expression} compiled at ${JSON.stringify(point)}`);
+    assert.equal(Number.isNaN(wrapped), true, `${expression} wrapped at ${JSON.stringify(point)}`);
+  } else {
+    assert.equal(compiled, interpreted, `${expression} compiled at ${JSON.stringify(point)}`);
+    assert.equal(wrapped, interpreted, `${expression} wrapped at ${JSON.stringify(point)}`);
+  }
+  return interpreted;
+}
+
+function value(expression, parameters, point) {
+  return both(expression, parameters, point);
+}
+
+function isNaNValue(expression, parameters, point) {
+  assert.equal(Number.isNaN(both(expression, parameters, point)), true, `${expression} at ${JSON.stringify(point)}`);
+}
+
+function partial(expression, parameters, parameter, point) {
+  const dag = parseFormula(expression, parameters, { outputLabel: "f" });
+  const result = appendPartialDerivatives(dag, {
+    sourceLabel: "f",
+    partials: [{ parameter, label: "dfdp" }],
+  });
+  assert.deepEqual(result.errors, [], expression);
+  assert.equal(result.dag.root, dag.root);
+  const closure = createDagClosureEvaluator(result.dag)(point).dfdp;
+  const compiled = loadCompiled(result.dag)(point).dfdp;
+  if (Number.isNaN(closure)) {
+    assert.equal(Number.isNaN(compiled), true, `${expression} derivative compiled at ${JSON.stringify(point)}`);
+  } else {
+    assert.equal(compiled, closure, `${expression} derivative compiled at ${JSON.stringify(point)}`);
+  }
+  return closure;
+}
+
+function rootRange(expression, parameters, parameterRanges) {
+  const dag = parseFormula(expression, parameters, { outputLabel: "f" });
+  return estimateDagRanges(dag, parameterRanges).nodeRanges[dag.root];
+}
+
+function covers(range, target) {
+  return range.intervals.some(([lo, hi]) => lo <= target && target <= hi);
+}
+
+function assertCovers(range, target) {
+  assert.equal(covers(range, target), true, `${JSON.stringify(range)} should cover ${target}`);
+}
+
+function assertDoesNotCover(range, target) {
+  assert.equal(covers(range, target), false, `${JSON.stringify(range)} should not cover ${target}`);
+}
+
+function wgsl(expression, parameters, ranges) {
+  const dag = parseFormula(expression, parameters, { outputLabel: "f" });
+  return generateDagWgslFunction(dag, {
+    parameters: parameters.map((name) => ({ name, range: ranges[name] })),
+    labels: ["f"],
+  }).code;
+}
+
+function lowering(expression, parameters, ranges) {
+  const dag = parseFormula(expression, parameters, { outputLabel: "f" });
+  const specialization = createDagWgslSpecialization(dag, {
+    parameters: parameters.map((name) => ({ name, range: ranges[name] })),
+  });
+  return specialization.guardProfile[dag.root];
+}
+
+const WGSL_KNOWN_CALLS = new Set([
+  "if", "for", "while", "switch", "return", "let", "var", "const",
+  "W", "f32", "i32", "u32", "bool", "vec2", "vec3", "vec4", "array",
+  "abs", "acos", "acosh", "all", "any", "asin", "asinh", "atan", "atan2", "atanh",
+  "ceil", "clamp", "cos", "cosh", "degrees", "dot", "exp", "exp2", "floor", "fma",
+  "fract", "inverseSqrt", "length", "log", "log2", "max", "min", "mix", "modf",
+  "pow", "radians", "round", "saturate", "select", "sign", "sin", "sinh",
+  "smoothstep", "sqrt", "step", "tan", "tanh", "trunc",
+]);
+
+function assertWgslTypesAgree(code, expression) {
+  const types = new Map();
+  for (const [, name, type] of code.matchAll(/var (v\d+)\s*:\s*(f32|W)\s*=/g)) types.set(name, type);
+  for (const [, target, type, body] of code.matchAll(/var (v\d+)\s*:\s*(f32|W)\s*=\s*(.*);/g)) {
+    for (const [, name, field] of body.matchAll(/(v\d+)(\.value)?/g)) {
+      const declared = types.get(name);
+      if (declared === undefined) continue;
+      if (field) {
+        assert.equal(declared, "W", `${expression}: ${target} takes .value of ${name} declared ${declared}`);
+      } else if (type === "f32") {
+        assert.equal(declared, "f32", `${expression}: ${target} uses wrapped ${name} as a plain f32`);
+      }
+    }
+  }
+}
+
+function assertWgslCallsAreDeclared(code, expression) {
+  const declared = new Set();
+  for (const source of [code, WGSL_RUNTIME_CODE]) {
+    for (const [, name] of source.matchAll(/fn\s+(\w+)\s*\(/g)) declared.add(name);
+  }
+  for (const [, name] of code.matchAll(/(?<![\w.])([A-Za-z_]\w*)\s*\(/g)) {
+    if (declared.has(name) || WGSL_KNOWN_CALLS.has(name)) continue;
+    assert.fail(`${expression}: generated WGSL calls undeclared ${name}`);
+  }
+}
+
+const WGSL_CASES = [
+  ["x < 1", ["x"], { x: [[0, 2]] }],
+  ["sqrt(x) < 1", ["x"], { x: [[-1, 4]] }],
+  ["x >= 1", ["x"], { x: [[0, 2]] }],
+  ["sqrt(x) != 1", ["x"], { x: [[-1, 4]] }],
+  ["and(x > 0, x < 1)", ["x"], { x: [[-1, 2]] }],
+  ["or(x > 0, x < 1)", ["x"], { x: [[-1, 2]] }],
+  ["not(x > 0)", ["x"], { x: [[-1, 2]] }],
+  ["and(sqrt(x) > 0, 1)", ["x"], { x: [[-1, 1]] }],
+  ["not(sqrt(x) > 0)", ["x"], { x: [[-1, 1]] }],
+  ["if(x > 0, x, 7)", ["x"], { x: [[-1, 2]] }],
+  ["if(x > 0, 1 / x, 7)", ["x"], { x: [[-1, 2]] }],
+  ["if(x > 0.5, 1 / x, 7)", ["x"], { x: [[-1, 2]] }],
+  ["if(x > 3, 1 / 0, 7)", ["x"], { x: [[0, 2]] }],
+  ["if(and(x > 0, x < 1), 1 / x, 7)", ["x"], { x: [[-1, 2]] }],
+  ["if(x > 1, if(x > 2, 1 / (x - 2), 5), 7)", ["x"], { x: [[0, 4]] }],
+  ["fallback(1 / x, 7) < 8", ["x"], { x: [[-1, 1]] }],
+  ["and(fallback(1 / x, 7) > 0, 1)", ["x"], { x: [[-1, 1]] }],
+  ["not(fallback(1 / x, 7))", ["x"], { x: [[-1, 1]] }],
+  ["if(fallback(1 / x, 7) > 0, x, 7)", ["x"], { x: [[-1, 1]] }],
+];
+
+describe("formula conditionals", () => {
+  test("parses_less_than_as_a_binary_node", () => {
+    const { node } = root("x < 1", ["x"]);
+    assert.equal(node.kind, "binary");
+    assert.equal(node.op, "<");
+  });
+
+  test("parses_every_comparison_operator", () => {
+    for (const op of ["<", "<=", ">", ">=", "==", "!="]) {
+      const { node } = root(`x ${op} y`, ["x", "y"]);
+      assert.equal(node.kind, "binary");
+      assert.equal(node.op, op);
+    }
+  });
+
+  test("comparison_binds_looser_than_addition", () => {
+    const { dag, node } = root("x < y + 1", ["x", "y"]);
+    assert.equal(node.op, "<");
+    assert.equal(dag.nodes[node.args[1]].op, "+");
+    assert.equal(value("x < y + 1", ["x", "y"], { x: 3, y: 3 }), 1);
+  });
+
+  test("comparison_binds_looser_than_subtraction", () => {
+    const { dag, node } = root("x < y - 1", ["x", "y"]);
+    assert.equal(node.op, "<");
+    assert.equal(dag.nodes[node.args[1]].op, "-");
+    assert.equal(value("x < y - 1", ["x", "y"], { x: 1, y: 3 }), 1);
+    assert.equal(value("x - 1 >= y", ["x", "y"], { x: 3, y: 3 }), 0);
+  });
+
+  test("comparison_binds_looser_than_power_and_product", () => {
+    const { dag, node } = root("x^2 >= 4 * y", ["x", "y"]);
+    assert.equal(node.op, ">=");
+    assert.equal(dag.nodes[node.args[0]].op, "^");
+    assert.equal(dag.nodes[node.args[1]].op, "*");
+  });
+
+  test("unary_minus_binds_tighter_than_comparison", () => {
+    const { dag, node } = root("-x <= 1", ["x"]);
+    assert.equal(node.op, "<=");
+    assert.equal(dag.nodes[node.args[0]].kind, "unary");
+  });
+
+  test("if_is_a_three_argument_call_inside_arithmetic", () => {
+    const { dag, node } = root("if(x < 1, x, 2) + 1", ["x"]);
+    assert.equal(node.op, "+");
+    const call = dag.nodes[node.args[0]];
+    assert.equal(call.kind, "call");
+    assert.equal(call.name, "if");
+    assert.equal(call.args.length, 3);
+    assert.equal(dag.nodes[call.args[0]].op, "<");
+  });
+
+  test("parenthesised_comparisons_can_be_compared", () => {
+    const { dag, node } = root("(x < 1) == (y < 1)", ["x", "y"]);
+    assert.equal(node.op, "==");
+    assert.equal(dag.nodes[node.args[0]].op, "<");
+    assert.equal(dag.nodes[node.args[1]].op, "<");
+  });
+
+  test("comparison_inside_a_function_argument", () => {
+    const { node } = root("max(x < 1, 0)", ["x"]);
+    assert.equal(node.name, "max");
+  });
+
+  test("logical_functions_parse_as_calls", () => {
+    const { node } = root("and(x > 0, not(y == 2))", ["x", "y"]);
+    assert.equal(node.name, "and");
+  });
+
+  test("conditionals_in_power_and_unary_positions", () => {
+    const { dag, node } = root("2 ^ (x < 1)", ["x"]);
+    assert.equal(node.op, "^");
+    assert.equal(dag.nodes[node.args[1]].op, "<");
+    assert.equal(value("2 ^ (x < 1)", ["x"], { x: 0 }), 2);
+    assert.equal(value("2 ^ (x < 1)", ["x"], { x: 5 }), 1);
+    assert.equal(value("-(x < 1)", ["x"], { x: 0 }), -1);
+    assert.equal(value("-if(x < 1, 3, 4)", ["x"], { x: 0 }), -3);
+    assert.equal(value("if(x < 1, 2, 3) ^ 2", ["x"], { x: 0 }), 4);
+    assert.equal(value("-not(x)", ["x"], { x: 0 }), -1);
+    assert.equal(value("6 / if(x < 1, 2, 3)", ["x"], { x: 0 }), 3);
+    assert.equal(value("abs(if(x < 1, 0 - 2, 3))", ["x"], { x: 0 }), 2);
+    assert.equal(value("sqrt(and(x > 0, x < 2))", ["x"], { x: 1 }), 1);
+    assert.equal(value("flag = x > 1; flag * 5", ["x"], { x: 2 }), 5);
+  });
+
+  test("chained_comparison_rejects", () => {
+    assert.equal(root("a < b", ["a", "b"]).node.op, "<");
+    rejects("a < b < c", ["a", "b", "c"]);
+    rejects("a < b >= c", ["a", "b", "c"]);
+  });
+
+  test("chained_equality_rejects", () => {
+    assert.equal(root("a == b", ["a", "b"]).node.op, "==");
+    rejects("a == b != c", ["a", "b", "c"]);
+  });
+
+  test("if_with_two_arguments_rejects", () => {
+    assert.equal(root("if(1, 2, 3)", []).node.name, "if");
+    rejects("if(1, 2)", []);
+  });
+
+  test("if_with_four_arguments_rejects", () => {
+    assert.equal(root("if(1, 2, 3)", []).node.name, "if");
+    rejects("if(1, 2, 3, 4)", []);
+    rejects("if()", []);
+  });
+
+  test("if_with_trailing_comma_rejects", () => {
+    assert.equal(root("if(1, 2, 3)", []).node.name, "if");
+    rejects("if(1, 2, 3,)", []);
+  });
+
+  test("bare_if_name_rejects", () => {
+    assert.equal(root("if(1, 2, 3)", []).node.name, "if");
+    rejects("if + 1", []);
+    rejects("and + 1", []);
+    rejects("not", []);
+  });
+
+  test("and_with_one_argument_rejects", () => {
+    assert.equal(root("and(1, 0)", []).node.name, "and");
+    rejects("and(1)", []);
+    rejects("or(1)", []);
+    rejects("and(1, 2, 3)", []);
+    rejects("or(1, 2, 3)", []);
+  });
+
+  test("not_with_two_arguments_rejects", () => {
+    assert.equal(root("not(1)", []).node.name, "not");
+    rejects("not(1, 2)", []);
+    rejects("not()", []);
+  });
+
+  test("dangling_comparison_rejects", () => {
+    assert.equal(root("x < 1", ["x"]).node.op, "<");
+    rejects("x < ", ["x"]);
+  });
+
+  test("conditional_names_are_reserved", () => {
+    assert.equal(isValidFormulaParameterName("if"), false);
+    assert.equal(isValidFormulaParameterName("and"), false);
+    assert.equal(isValidFormulaParameterName("or"), false);
+    assert.equal(isValidFormulaParameterName("not"), false);
+    assert.throws(() => parseFormula("x", ["if"]), TypeError);
+  });
+
+  test("assignment_with_a_less_or_equal_comparison", () => {
+    const dag = parseFormula("y = x <= 1", ["x"]);
+    assert.equal(dag.nodes[dag.root].label, "y");
+    assert.equal(dag.nodes[dag.root].op, "<=");
+  });
+
+  test("assignment_splitter_ignores_comparison_equals", () => {
+    for (const op of ["<=", ">=", "==", "!="]) {
+      const dag = parseFormula(`flag = x ${op} 1; if(flag, 10, 20)`, ["x"]);
+      const evaluate = createDagClosureEvaluator(dag);
+      assert.equal(findNodeByLabel(dag, "flag"), dag.nodes.findIndex((node) => node.label === "flag"));
+      const holds = op === "<=" || op === ">=" || op === "==";
+      assert.equal(evaluate({ x: 1 }).flag, holds ? 1 : 0, op);
+    }
+  });
+
+  test("top_level_equality_is_not_an_assignment", () => {
+    const dag = parseFormula("x == 1", ["x"]);
+    assert.equal(dag.nodes[dag.root].label, undefined);
+    assert.equal(dag.nodes[dag.root].op, "==");
+  });
+
+  test("assignment_with_the_parameter_on_the_right", () => {
+    const dag = parseFormula("y = 1 <= x; y", ["x"]);
+    assert.equal(createDagClosureEvaluator(dag)({ x: 2 }).y, 1);
+  });
+
+  test("comparison_values_when_distinct", () => {
+    assert.equal(value("x < y", ["x", "y"], { x: 1, y: 2 }), 1);
+    assert.equal(value("x <= y", ["x", "y"], { x: 1, y: 2 }), 1);
+    assert.equal(value("x > y", ["x", "y"], { x: 1, y: 2 }), 0);
+    assert.equal(value("x >= y", ["x", "y"], { x: 1, y: 2 }), 0);
+    assert.equal(value("x == y", ["x", "y"], { x: 1, y: 2 }), 0);
+    assert.equal(value("x != y", ["x", "y"], { x: 1, y: 2 }), 1);
+  });
+
+  test("comparison_values_when_equal", () => {
+    assert.equal(value("x < y", ["x", "y"], { x: 2, y: 2 }), 0);
+    assert.equal(value("x <= y", ["x", "y"], { x: 2, y: 2 }), 1);
+    assert.equal(value("x > y", ["x", "y"], { x: 2, y: 2 }), 0);
+    assert.equal(value("x >= y", ["x", "y"], { x: 2, y: 2 }), 1);
+    assert.equal(value("x == y", ["x", "y"], { x: 2, y: 2 }), 1);
+    assert.equal(value("x != y", ["x", "y"], { x: 2, y: 2 }), 0);
+  });
+
+  test("if_selects_on_nonzero", () => {
+    assert.equal(value("if(x, 1, 2)", ["x"], { x: 0.5 }), 1);
+    assert.equal(value("if(x, 1, 2)", ["x"], { x: -3 }), 1);
+    assert.equal(value("if(x, 1, 2)", ["x"], { x: 0 }), 2);
+    assert.equal(value("if(x < 1, x * 10, x - 10)", ["x"], { x: 0.5 }), 5);
+    assert.equal(value("if(x < 1, x * 10, x - 10)", ["x"], { x: 12 }), 2);
+  });
+
+  test("invalid_operands_make_comparison_and_if_invalid", () => {
+    isNaNValue("x < sqrt(-1)", ["x"], { x: 1 });
+    isNaNValue("sqrt(-1) >= x", ["x"], { x: 1 });
+    isNaNValue("if(sqrt(-1), 1, 2)", [], {});
+    isNaNValue("if(1, sqrt(-1), 2)", [], {});
+    isNaNValue("if(0, 1, 1 / 0)", [], {});
+  });
+
+  test("unselected_branch_never_invalidates", () => {
+    assert.equal(value("if(x != 0, 1 / x, 7)", ["x"], { x: 0 }), 7);
+    assert.equal(value("if(x != 0, 1 / x, 7)", ["x"], { x: 2 }), 0.5);
+    assert.equal(value("if(x >= 0, sqrt(x), 0 - sqrt(0 - x))", ["x"], { x: -4 }), -2);
+    assert.equal(value("if(0, sqrt(-1), 3)", [], {}), 3);
+  });
+
+  test("logical_function_values", () => {
+    assert.equal(value("and(x > 0, x < 1)", ["x"], { x: 0.5 }), 1);
+    assert.equal(value("and(x > 0, x < 1)", ["x"], { x: 2 }), 0);
+    assert.equal(value("or(x > 1, x < 0)", ["x"], { x: 0.5 }), 0);
+    assert.equal(value("or(x > 1, x < 0)", ["x"], { x: -1 }), 1);
+    assert.equal(value("not(x)", ["x"], { x: 0 }), 1);
+    assert.equal(value("not(x)", ["x"], { x: 2 }), 0);
+    assert.equal(value("and(2, 3)", [], {}), 1);
+    assert.equal(value("or(0, 0)", [], {}), 0);
+    isNaNValue("and(x > 0, sqrt(-1))", ["x"], { x: 1 });
+    isNaNValue("or(1, sqrt(-1))", [], {});
+    isNaNValue("not(sqrt(-1))", [], {});
+  });
+
+  test("generated_javascript_compiles_conditionals", () => {
+    for (const expression of ["if(x > 1, x, 1)", "and(x > 1, x < 3)", "not(x == 2)", "or(x >= 1, x != 0)"]) {
+      const dag = parseFormula(expression, ["x"], { outputLabel: "f" });
+      assert.equal(createDagEvaluator(dag).evaluationMode, "compiled", expression);
+    }
+    assert.equal(value("if(x > 1, x, 1)", ["x"], { x: 4 }), 4);
+    assert.equal(value("if(x > 1, x, 1)", ["x"], { x: 0 }), 1);
