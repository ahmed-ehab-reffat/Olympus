+      const evaluate = loadCompiled(result.dag);
+      const center = evaluate(point);
+      const left = evaluate({ ...point, x: point.x - h });
+      const right = evaluate({ ...point, x: point.x + h });
+      if (![center.dfdx, center.f, left.f, right.f].every(Number.isFinite)) continue;
+      const numerical = (right.f - left.f) / (2 * h);
+      if (Math.abs(numerical) > 1e3) continue;
+      const tolerance = 2e-4 * Math.max(1, Math.abs(center.dfdx), Math.abs(numerical));
