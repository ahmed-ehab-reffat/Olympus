+          continue;
+        }
+        assert.equal(covers(range, result), true, `${expression} at ${JSON.stringify(point)} gives ${result} outside ${JSON.stringify(range)}`);
+        checked += 1;
+      }
+    }
+    assert.ok(checked >= 1500, `expected at least 1500 finite random range checks, got ${checked}`);
+  });
+
+  test("wgsl_comparison_lowering_follows_the_range_analysis", () => {
+    for (const op of ["<", "<=", ">", ">=", "==", "!="]) {
+      assert.equal(lowering(`x ${op} 1`, ["x"], { x: [[0, 2]] }), "raw", op);
+      assert.equal(lowering(`sqrt(x) ${op} 1`, ["x"], { x: [[-1, 4]] }), "wrapped", op);
+    }
+  });
+
+  test("wgsl_conditional_lowering_follows_the_range_analysis", () => {
+    assert.equal(lowering("if(x > 0, x, 7)", ["x"], { x: [[-1, 2]] }), "raw");
+    assert.equal(lowering("if(x > 0, 1 / x, 7)", ["x"], { x: [[-1, 2]] }), "wrapped");
+    assert.equal(lowering("if(x > 3, 1 / 0, 7)", ["x"], { x: [[0, 2]] }), "raw");
+    assert.equal(lowering("if(x > 0.5, 1 / x, 7)", ["x"], { x: [[-1, 2]] }), "raw");
+    assert.equal(lowering("if(and(x > 1, x < 3), 1 / x, 7)", ["x"], { x: [[0, 4]] }), "raw");
+    assert.equal(lowering("if(not(x < 1), 1 / x, 7)", ["x"], { x: [[0, 4]] }), "raw");
+    assert.equal(lowering("if(x < 1, 7, 1 / x)", ["x"], { x: [[0, 4]] }), "raw");
+  });
+
+  test("wgsl_logic_lowering_follows_the_range_analysis", () => {
+    assert.equal(lowering("and(x > 0, x < 1)", ["x"], { x: [[-1, 2]] }), "raw");
+    assert.equal(lowering("or(x > 0, x < 1)", ["x"], { x: [[-1, 2]] }), "raw");
+    assert.equal(lowering("not(x > 0)", ["x"], { x: [[-1, 2]] }), "raw");
+    assert.equal(lowering("and(sqrt(x) > 0, 1)", ["x"], { x: [[-1, 1]] }), "wrapped");
+    assert.equal(lowering("or(sqrt(x) > 0, 1)", ["x"], { x: [[-1, 1]] }), "wrapped");
+    assert.equal(lowering("not(sqrt(x) > 0)", ["x"], { x: [[-1, 1]] }), "wrapped");
+  });
+
+  test("wgsl_types_agree_across_the_new_lowerings", () => {
+    for (const [expression, parameters, ranges] of WGSL_CASES) {
+      assertWgslTypesAgree(wgsl(expression, parameters, ranges), expression);
+    }
+  });
+
+  test("wgsl_raw_lowering_reads_wrapped_operands_as_values", () => {
+    const cases = [
+      ["fallback(1 / x, 7) < 8", ["x"], { x: [[-1, 1]] }],
+      ["not(fallback(1 / x, 7))", ["x"], { x: [[-1, 1]] }],
+      ["if(x > 0.5, 1 / x, 7)", ["x"], { x: [[-1, 2]] }],
+      ["if(x > 3, 1 / 0, 7)", ["x"], { x: [[0, 2]] }],
+    ];
+    for (const [expression, parameters, ranges] of cases) {
+      assert.equal(lowering(expression, parameters, ranges), "raw", expression);
+      const code = wgsl(expression, parameters, ranges);
+      assert.equal(/var v\d+\s*:\s*W\s*=/.test(code), true, `${expression} should still build a wrapped operand`);
+      assertWgslTypesAgree(code, expression);
+    }
+  });
+
+  test("wgsl_runtime_declares_every_generated_helper", () => {
+    for (const [expression, parameters, ranges] of WGSL_CASES) {
+      assertWgslCallsAreDeclared(wgsl(expression, parameters, ranges), expression);
+    }
