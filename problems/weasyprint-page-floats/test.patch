+@assert_no_logs
+def test_a_page_float_inside_a_footnote_floats_inside_the_footnote_area():
+    page, = render(
+        '200px 100px',
+        '.fn { float: footnote } .pf { float: top; width: 40px; height: 20px }',
+        '<p>one<span class="fn">n<span class="pf">F</span></span></p>')
+    html, footnote_area = page.children
+    footnote, = footnote_area.children
+    floated = [
+        box for box in footnote.descendants()
+        if box.is_floated() and box.element_tag == 'span']
+    assert len(floated) == 1
+    assert not [box for box in footnote.descendants() if box.is_page_floated()]
+    assert (floated[0].margin_width(), floated[0].margin_height()) == (40, 20)
+    assert floated[0].position_y == footnote.position_y
