new file mode 100755
index 0000000..a554f25
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,55 @@
+#!/bin/sh
+set -u
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+[ -n "$OUTPUT_PATH" ] || OUTPUT_PATH=/tmp/report.xml
+mkdir -p "$(dirname "$OUTPUT_PATH")" || exit 1
+
+PY=python
+command -v "$PY" >/dev/null 2>&1 || PY=python3
+
+NEW_TESTS="tests/layout/test_page_float_729ab9.py"
+
+if [ "$MODE" = "new" ]; then
+  TARGETS="$NEW_TESTS"
+  IGNORE=""
+else
+  TARGETS="tests/layout tests/css tests/test_boxes.py tests/test_stacking.py tests/test_html.py"
+  IGNORE="--ignore=$NEW_TESTS"
+fi
+
+DESELECT="--deselect tests/layout/test_inline.py::test_breaking_linebox_regression_6
+--deselect tests/layout/test_inline.py::test_breaking_linebox_regression_10
+--deselect tests/layout/test_inline.py::test_breaking_linebox_regression_13
+--deselect tests/layout/test_inline.py::test_font_stretch"
+
+# shellcheck disable=SC2086
+"$PY" -m pytest $TARGETS $IGNORE $DESELECT -p no:randomly -q \
+  --junitxml="$OUTPUT_PATH"
+EXIT_CODE=$?
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  LOG=$("$PY" -m pytest $TARGETS $IGNORE $DESELECT -p no:randomly -q 2>&1 | tail -40)
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo '<testsuites><testsuite name="pytest" tests="1" failures="1" errors="0" time="0">'
+    echo '<testcase name="collect tests" classname="pytest">'
+    echo '<failure message="pytest produced no test case"><![CDATA['
+    echo "$LOG"
+    echo ']]></failure>'
+    echo '</testcase></testsuite></testsuites>'
+  } > "$OUTPUT_PATH"
+  [ $EXIT_CODE -eq 0 ] && EXIT_CODE=1
+fi
+
+exit $EXIT_CODE
