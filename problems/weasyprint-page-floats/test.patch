+"""Tests for page and column floats layout."""
+
+import pytest
+
+from weasyprint.formatting_structure import boxes
+
+from ..testing_utils import assert_no_logs, render_pages
+
+PAGE = '''
+  <style>
+    @page { size: %s; margin: 0 }
+    body { margin: 0; font-family: weasyprint; font-size: 10px; line-height: 1 }
+    %s
+  </style>
+  %s'''
+
+
+def outer_area(box):
+    return (box.position_x, box.position_y,
+            box.margin_width(), box.margin_height())
+
+
+def render(size, css, body):
+    return render_pages(PAGE % (size, css, body))
+
+
+def page_floats(page):
+    html, = page.children[:1]
+    return [child for child in html.children if child.is_page_floated()]
+
+
+def body_of(page):
+    html, = page.children[:1]
+    for child in html.children:
+        if child.element_tag == 'body':
+            return child
+
+
+def texts(box):
+    result = []
+    for child in getattr(box, 'children', ()):
+        if isinstance(child, boxes.TextBox):
+            result.append(child.text)
+        else:
+            result.extend(texts(child))
+    return result
+
+
+@assert_no_logs
+def test_page_float_top_is_placed_at_the_top_of_its_page():
+    page, = render(
+        '200px 300px', 'div { float: top; width: 80px; height: 50px }',
+        '<p>one</p><p>two</p><div>F</div><p>three</p>')
+    float_box, = page_floats(page)
+    assert outer_area(float_box) == (0, 0, 80, 50)
+
+
+@assert_no_logs
+def test_page_float_top_is_removed_from_the_flow():
+    page, = render(
+        '200px 300px', 'div { float: top; width: 80px; height: 50px }',
+        '<p>one</p><p>two</p><div>F</div><p>three</p>')
+    body = body_of(page)
+    assert [child.element_tag for child in body.children] == ['p', 'p', 'p']
+    assert texts(body) == ['one', 'two', 'three']
+
+
+@assert_no_logs
+def test_lines_are_laid_out_beside_a_narrow_top_float():
+    page, = render(
+        '200px 300px', 'div { float: top; width: 80px; height: 50px }',
+        '<p>one</p><p>two</p><div>F</div><p>three</p>')
+    body = body_of(page)
+    first, second, third = body.children
+    assert first.children[0].position_x == 80
+    assert second.children[0].position_x == 80
+    assert third.children[0].position_x == 80
+
+
+@assert_no_logs
+def test_lines_after_a_full_width_top_float_start_below_it():
+    page, = render(
+        '200px 300px', 'div { float: top; width: 200px; height: 50px }',
+        '<p>one</p><div>F</div>')
+    body = body_of(page)
+    paragraph, = body.children
+    line, = paragraph.children
+    assert line.position_y == 50
+
+
+@assert_no_logs
+def test_page_float_bottom_is_placed_at_the_bottom_of_its_page():
+    page, = render(
+        '200px 100px', 'div { float: bottom; width: 80px; height: 30px }',
+        '<p>one</p><div>F</div><p>two</p>')
+    float_box, = page_floats(page)
+    assert outer_area(float_box) == (0, 70, 80, 30)
+
+
+@assert_no_logs
+def test_content_is_laid_out_above_a_full_width_bottom_float():
+    page, = render(
+        '200px 100px', 'div { float: bottom; width: 200px; height: 30px }',
