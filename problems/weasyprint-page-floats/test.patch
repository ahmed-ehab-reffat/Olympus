+        '200px 40px', 'div { float: top; width: 60px }',
+        '<p>one</p><div>a<br>b<br>c<br>d<br>e<br>f</div>')
+    float_box, = page_floats(page)
+    assert len(float_box.children) == 6
+    assert texts(float_box) == ['a', 'b', 'c', 'd', 'e', 'f']
