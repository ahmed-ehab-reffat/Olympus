+import gzip
+import struct
+
+
+def _varint(buf, pos):
+    result = 0
+    shift = 0
+    while True:
+        b = buf[pos]
+        pos += 1
+        result |= (b & 0x7F) << shift
+        if not (b & 0x80):
+            return result, pos
+        shift += 7
+
+
+def _fields(buf, start, end):
+    pos = start
+    while pos < end:
+        key, pos = _varint(buf, pos)
+        field, wire = key >> 3, key & 7
+        if wire == 0:
+            value, pos = _varint(buf, pos)
+            yield field, value
+        elif wire == 1:
+            yield field, struct.unpack_from('<d', buf, pos)[0]
+            pos += 8
+        elif wire == 2:
+            length, pos = _varint(buf, pos)
+            yield field, (pos, pos + length)
+            pos += length
+        elif wire == 5:
+            yield field, struct.unpack_from('<f', buf, pos)[0]
+            pos += 4
+        else:
+            raise ValueError('unsupported wire type %d' % wire)
+
+
+def _packed(buf, start, end):
+    out = []
+    pos = start
+    while pos < end:
+        value, pos = _varint(buf, pos)
+        out.append(value)
+    return out
+
+
+def _zigzag(n):
+    return (n >> 1) ^ -(n & 1)
+
+
+def _value(buf, start, end):
+    for field, payload in _fields(buf, start, end):
+        if field == 1:
+            return buf[payload[0]:payload[1]].decode('utf-8')
+        if field in (2, 3):
+            return payload
+        if field in (4, 5):
+            return payload
+        if field == 6:
+            return _zigzag(payload)
+        if field == 7:
+            return bool(payload)
+    return None
+
+
+def _feature(buf, start, end):
+    feature = {'id': None, 'tags': [], 'type': 0, 'geometry': []}
+    for field, payload in _fields(buf, start, end):
+        if field == 1:
+            feature['id'] = payload
+        elif field == 2:
+            feature['tags'] = _packed(buf, payload[0], payload[1])
+        elif field == 3:
+            feature['type'] = payload
+        elif field == 4:
+            feature['geometry'] = _packed(buf, payload[0], payload[1])
+    return feature
+
+
+def _layer(buf, start, end):
+    layer = {'name': '', 'keys': [], 'values': [], 'features': [], 'extent': 4096}
+    for field, payload in _fields(buf, start, end):
+        if field == 1:
+            layer['name'] = buf[payload[0]:payload[1]].decode('utf-8')
+        elif field == 2:
+            layer['features'].append(_feature(buf, payload[0], payload[1]))
+        elif field == 3:
+            layer['keys'].append(buf[payload[0]:payload[1]].decode('utf-8'))
+        elif field == 4:
+            layer['values'].append(_value(buf, payload[0], payload[1]))
+        elif field == 5:
+            layer['extent'] = payload
+    return layer
+
+
+def decode_tile(data):
+    if data[:2] == b'\x1f\x8b':
+        data = gzip.decompress(data)
+    layers = []
+    for field, payload in _fields(data, 0, len(data)):
+        if field == 3:
+            layers.append(_layer(data, payload[0], payload[1]))
+    return layers
+
+
+def attributes(layer, feature):
+    out = {}
+    tags = feature['tags']
+    for i in range(0, len(tags) - 1, 2):
+        out[layer['keys'][tags[i]]] = layer['values'][tags[i + 1]]
+    return out
+
+
+def used_pool_indexes(layer):
+    keys = set()
+    values = set()
+    for feature in layer['features']:
+        tags = feature['tags']
+        for i in range(0, len(tags) - 1, 2):
+            keys.add(tags[i])
+            values.add(tags[i + 1])
+    return keys, values
+
+
+def bbox(feature):
+    x = y = 0
+    xs = []
+    ys = []
+    geom = feature['geometry']
+    i = 0
+    while i < len(geom):
+        command = geom[i] & 0x7
+        count = geom[i] >> 3
+        i += 1
+        if command in (1, 2):
+            for _ in range(count):
+                x += _zigzag(geom[i])
+                y += _zigzag(geom[i + 1])
+                i += 2
+                xs.append(x)
+                ys.append(y)
+        else:
+            pass
+    if not xs:
+        return None
+    return min(xs), min(ys), max(xs), max(ys)
+
+
+def extent_of(feature):
+    box = bbox(feature)
+    if box is None or feature['type'] == 1:
+        return 0.0
+    width = box[2] - box[0]
+    height = box[3] - box[1]
+    if feature['type'] == 3:
+        return float(width) * float(height)
+    return float(width) + float(height)
