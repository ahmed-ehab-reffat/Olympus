+import json
+import os
+import random
+import shutil
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import time
+import xml.etree.ElementTree as ET
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import mvt
+
+ROOT = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..'))
+WORK = None
+
+BASE_TARGETS = [
+    'raw-tiles-test', 'parallel-test', 'radix-sort-test', 'pbf-test', 'join-test',
+    'enumerate-test', 'decode-test', 'join-filter-test', 'json-tool-test',
+    'allow-existing-test', 'csv-test', 'layer-json-test', 'pmtiles-test',
+    'decode-pmtiles-test', 'overzoom-test', 'flatgeobuf-test',
+]
+
+
+def run(args, cwd=ROOT):
+    proc = subprocess.run(args, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    return proc.returncode, proc.stdout.decode('utf-8', 'replace'), proc.stderr.decode('utf-8', 'replace')
+
+
+def path(name):
+    return os.path.join(WORK, name)
+
+
+def write_geojson(name, features):
+    target = path(name)
+    with open(target, 'w') as f:
+        for feature in features:
+            f.write(json.dumps(feature) + '\n')
+    return target
+
+
+def point(i, x, y, props=None):
+    attributes = {'id': i, 'name': 'feature-%d-abcdefghijklmnopqrst' % i, 'cat': 'c%d' % (i % 7)}
+    if props:
+        attributes.update(props)
+    return {'type': 'Feature', 'properties': attributes,
+            'geometry': {'type': 'Point', 'coordinates': [x, y]}}
+
+
+def square(i, x, y, size, props=None):
+    attributes = {'id': i, 'name': 'square-%d' % i}
+    if props:
+        attributes.update(props)
+    ring = [[x, y], [x + size, y], [x + size, y + size], [x, y + size], [x, y]]
+    return {'type': 'Feature', 'properties': attributes,
+            'geometry': {'type': 'Polygon', 'coordinates': [ring]}}
+
+
+def dense_points(count, seed=1):
+    rng = random.Random(seed)
+    return [point(i, -122.5 + rng.random() * 0.5, 37.7 + rng.random() * 0.4) for i in range(count)]
+
+
+def graduated_squares(count):
+    features = []
+    for i in range(count):
+        size = 0.0006 * (i + 1)
+        features.append(square(i, -122.4 + i * 0.02, 37.75, size))
+    return features
+
+
+def build_tileset(name, features, extra=None):
+    source = write_geojson(name + '.json', features)
+    out = path(name + '.mbtiles')
+    args = [os.path.join(ROOT, 'tippecanoe'), '-q', '-f', '-o', out, '-z0', '-r1', '-pf', '-pk', '-pS']
+    if extra:
+        args += extra
+    args.append(source)
+    code, _, err = run(args)
+    if code != 0:
+        raise AssertionError('tippecanoe failed: %s' % err[-400:])
+    return out
+
+
+def join(name, inputs, extra=None):
+    out = path(name + '.mbtiles')
+    args = [os.path.join(ROOT, 'tile-join'), '-f', '-o', out]
+    if extra:
+        args += extra
+    args += inputs
+    code, _, err = run(args)
+    return out, code, err
+
+
+def tiles(mbtiles):
+    conn = sqlite3.connect(mbtiles)
+    rows = list(conn.execute('select zoom_level, tile_column, tile_row, tile_data from tiles'))
+    conn.close()
+    return rows
+
+
+def only_tile(mbtiles):
+    rows = tiles(mbtiles)
+    assert len(rows) == 1, 'expected exactly one tile, got %d' % len(rows)
+    return rows[0][3]
+
+
+def metadata(mbtiles):
+    conn = sqlite3.connect(mbtiles)
+    rows = dict(conn.execute('select name, value from metadata'))
+    conn.close()
+    return rows
+
+
+def strategies(mbtiles):
+    raw = metadata(mbtiles).get('strategies')
+    if raw is None:
+        return None
+    return json.loads(raw)
+
+
+def layers_of(mbtiles):
+    return mvt.decode_tile(only_tile(mbtiles))
+
+
+def feature_count(mbtiles):
+    return sum(len(layer['features']) for layer in layers_of(mbtiles))
+
+
+def ids_of(layers):
+    found = set()
+    for layer in layers:
+        for feature in layer['features']:
+            attributes = mvt.attributes(layer, feature)
+            if 'id' in attributes:
+                found.add(attributes['id'])
+    return found
+
+
+def assert_pools_are_used(layers):
+    for layer in layers:
+        used_keys, used_values = mvt.used_pool_indexes(layer)
+        unused_keys = set(range(len(layer['keys']))) - used_keys
+        unused_values = set(range(len(layer['values']))) - used_values
+        assert not unused_keys, 'layer %s keeps %d unused attribute keys' % (layer['name'], len(unused_keys))
+        assert not unused_values, 'layer %s keeps %d unused attribute values' % (layer['name'], len(unused_values))
+
+
+def oversized_source():
+    return build_tileset('oversized', dense_points(90000))
+
+
+TESTS = []
+
+
+def test(fn):
+    TESTS.append(fn)
+    return fn
+
+
+@test
+def maximum_tile_bytes_option_is_accepted():
+    source = build_tileset('small', dense_points(200))
+    out, code, err = join('small_joined', [source], ['-M', '2000000'])
+    assert code == 0, err[-400:]
+    assert len(tiles(out)) == 1
+
+
+@test
+def maximum_tile_bytes_long_form_is_accepted():
+    source = build_tileset('small2', dense_points(200))
+    out, code, err = join('small2_joined', [source], ['--maximum-tile-bytes=2000000'])
+    assert code == 0, err[-400:]
+    assert len(tiles(out)) == 1
+
+
+@test
+def oversized_tile_is_skipped_without_the_option():
+    source = oversized_source()
+    out, code, _ = join('skipped', [source])
+    assert code == 0
+    assert len(tiles(out)) == 0
+
+
+@test
+def oversized_tile_is_reduced_instead_of_skipped():
+    source = oversized_source()
+    out, code, err = join('reduced', [source], ['--drop-smallest-as-needed'])
+    assert code == 0, err[-400:]
+    assert len(tiles(out)) == 1
+
+
+@test
+def reduced_tile_is_within_the_limit():
+    source = oversized_source()
+    out, _, _ = join('reduced2', [source], ['--drop-smallest-as-needed'])
+    assert len(only_tile(out)) <= 500000
+
+
+@test
+def raised_limit_keeps_every_feature():
+    source = oversized_source()
+    out, _, _ = join('raised', [source], ['-M', '2000000', '--drop-smallest-as-needed'])
+    assert feature_count(out) == 90000
+
+
+@test
+def lowered_limit_reduces_a_tile_that_otherwise_fits():
+    source = build_tileset('midsize', dense_points(20000))
+    whole, _, _ = join('midsize_whole', [source], ['-M', '2000000'])
+    reduced, _, _ = join('midsize_reduced', [source], ['-M', '40000', '--drop-smallest-as-needed'])
+    assert feature_count(whole) == 20000
+    assert feature_count(reduced) < 20000
+    assert len(only_tile(reduced)) <= 40000
+
+
+@test
+def tile_at_exactly_the_limit_is_not_reduced():
+    source = build_tileset('exact', dense_points(5000))
+    whole, _, _ = join('exact_whole', [source], ['-M', '5000000'])
+    size = len(only_tile(whole))
+    out, _, _ = join('exact_join', [source], ['-M', str(size), '--drop-smallest-as-needed'])
+    assert feature_count(out) == 5000
+    assert strategies(out) is None
+
+
+@test
+def no_tile_size_limit_keeps_the_oversized_tile():
+    source = oversized_source()
+    out, _, _ = join('unlimited', [source], ['-pk', '--drop-smallest-as-needed'])
+    assert feature_count(out) == 90000
+
+
+@test
+def reduced_layer_keeps_no_unused_attribute_entries():
+    source = oversized_source()
+    out, _, _ = join('pools', [source], ['--drop-smallest-as-needed'])
+    assert_pools_are_used(layers_of(out))
+
+
+@test
+def surviving_features_keep_their_own_attributes():
+    source = oversized_source()
+    out, _, _ = join('attrs', [source], ['--drop-smallest-as-needed'])
+    for layer in layers_of(out):
+        for feature in layer['features']:
+            attributes = mvt.attributes(layer, feature)
+            assert set(attributes) == {'id', 'name', 'cat'}, sorted(attributes)
+            assert attributes['name'] == 'feature-%d-abcdefghijklmnopqrst' % attributes['id']
+            assert attributes['cat'] == 'c%d' % (attributes['id'] % 7)
+
+
+@test
+def features_are_shed_in_increasing_order_of_extent():
+    source = build_tileset('graduated', graduated_squares(400))
+    whole, _, _ = join('graduated_whole', [source], ['-M', '5000000'])
+    whole_layers = layers_of(whole)
+    extents = {}
+    for layer in whole_layers:
+        for feature in layer['features']:
+            extents[mvt.attributes(layer, feature)['id']] = mvt.extent_of(feature)
+    size = len(only_tile(whole))
+    reduced, _, _ = join('graduated_reduced', [source], ['-M', str(size // 3), '--drop-smallest-as-needed'])
+    kept = ids_of(layers_of(reduced))
+    assert 0 < len(kept) < len(extents)
+    dropped = set(extents) - kept
+    assert min(extents[i] for i in kept) >= max(extents[i] for i in dropped)
+
+
+@test
+def reduction_is_reported_in_the_strategies_metadata():
+    source = oversized_source()
+    out, _, _ = join('reported', [source], ['--drop-smallest-as-needed'])
+    recorded = strategies(out)
+    assert recorded is not None
+    assert recorded[0]['dropped_as_needed'] == 90000 - feature_count(out)
+    assert recorded[0]['tile_size_desired'] > 500000
+
+
+@test
+def strategies_are_untouched_when_nothing_is_reduced():
+    source = build_tileset('untouched', dense_points(500))
+    out, _, _ = join('untouched_join', [source], ['--drop-smallest-as-needed'])
+    assert strategies(out) is None
+
+
+@test
+def an_emptied_layer_is_not_written():
+    small = [square(i, -122.4 + (i % 40) * 0.004, 37.70 + (i // 40) * 0.004, 0.0004) for i in range(400)]
+    wide = [square(1000 + i, -122.0 + (i % 20) * 0.05, 37.90 + (i // 20) * 0.05, 0.04) for i in range(400)]
+    source_small = build_tileset('tiny_layer', small, ['-l', 'tiny'])
+    source_wide = build_tileset('wide_layer', wide, ['-l', 'wide'])
+    wide_only, _, _ = join('wide_only', [source_wide], ['-M', '5000000'])
+    budget = len(only_tile(wide_only))
+    out, _, _ = join('two_layers_reduced', [source_small, source_wide],
+                     ['-M', str(budget), '--drop-smallest-as-needed'])
+    names = [layer['name'] for layer in layers_of(out)]
+    assert 'wide' in names, names
+    assert 'tiny' not in names, names
+
+
+def junit(results, output_path, suite):
+    suites = ET.Element('testsuites')
+    element = ET.SubElement(suites, 'testsuite', name=suite,
+                            tests=str(len(results)),
+                            failures=str(sum(1 for r in results if r[1] is not None)),
+                            errors='0', time='%.3f' % sum(r[2] for r in results))
+    for name, failure, seconds, output in results:
+        case = ET.SubElement(element, 'testcase', name=name, classname=suite, time='%.3f' % seconds)
+        if failure is not None:
+            node = ET.SubElement(case, 'failure', message=failure[:200])
+            node.text = output
+    directory = os.path.dirname(output_path)
+    if directory:
+        os.makedirs(directory, exist_ok=True)
+    ET.ElementTree(suites).write(output_path, encoding='utf-8', xml_declaration=True)
+
+
+def run_new():
+    global WORK
+    results = []
+    for fn in TESTS:
+        WORK = tempfile.mkdtemp(prefix='tjlimit-')
+        started = time.time()
+        try:
+            fn()
+            results.append((fn.__name__, None, time.time() - started, ''))
+        except BaseException as exc:
+            results.append((fn.__name__, '%s: %s' % (type(exc).__name__, exc),
+                            time.time() - started, repr(exc)))
+        finally:
+            shutil.rmtree(WORK, ignore_errors=True)
+    return results
+
+
+def golden_checks():
+    out = []
+    for directory in sorted(os.listdir(os.path.join(ROOT, 'tests'))):
+        outdir = os.path.join(ROOT, 'tests', directory, 'out')
+        if os.path.isdir(outdir):
+            for name in sorted(os.listdir(outdir)):
+                if name.endswith('.json'):
+                    out.append('tests/%s/out/%s.check' % (directory, name))
+    return out
+
+
+def run_base():
+    results = []
+    jobs = '-j%d' % (os.cpu_count() or 2)
+    for target in BASE_TARGETS:
+        started = time.time()
+        code, out, err = run(['make', jobs, target])
+        results.append(('make_%s' % target.replace('-', '_'),
+                        None if code == 0 else 'exit %d' % code,
+                        time.time() - started, out[-4000:] + err[-4000:]))
+
+    unit_xml = os.path.join(tempfile.mkdtemp(prefix='tjunit-'), 'unit.xml')
+    started = time.time()
+    code, out, err = run([os.path.join(ROOT, 'unit'), '-r', 'junit', '-o', unit_xml])
+    parsed = False
+    if os.path.exists(unit_xml):
+        try:
+            tree = ET.parse(unit_xml)
+            for case in tree.iter('testcase'):
+                failure = case.find('failure')
+                results.append(('unit_' + case.get('name', 'case').replace(' ', '_'),
+                                None if failure is None else (failure.get('message') or 'failed'),
+                                float(case.get('time', '0') or 0),
+                                '' if failure is None else (failure.text or '')))
+            parsed = True
+        except ET.ParseError:
+            parsed = False
+    if not parsed:
+        results.append(('unit_suite', None if code == 0 else 'exit %d' % code,
+                        time.time() - started, out[-4000:] + err[-4000:]))
+
+    checks = golden_checks()
+    started = time.time()
+    code, out, err = run(['make', jobs] + checks)
+    results.append(('golden_file_checks', None if code == 0 else 'exit %d' % code,
+                    time.time() - started, out[-6000:] + err[-6000:]))
+    return results
+
+
+def main():
+    mode = 'base'
+    output_path = None
+    args = sys.argv[1:]
+    i = 0
+    while i < len(args):
+        if args[i].startswith('--output_path='):
+            output_path = args[i].split('=', 1)[1]
+        elif args[i] == '--output_path':
+            output_path = args[i + 1]
+            i += 1
+        elif args[i] in ('base', 'new'):
+            mode = args[i]
+        i += 1
+
+    results = run_new() if mode == 'new' else run_base()
+    if output_path:
+        junit(results, output_path, 'tile_join_limit' if mode == 'new' else 'tippecanoe_base')
+    failed = [r for r in results if r[1] is not None]
+    for name, failure, _, _ in results:
+        print('%s %s' % ('FAIL' if failure else 'ok  ', name))
+    print('%d/%d passed' % (len(results) - len(failed), len(results)))
+    return 1 if failed else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
