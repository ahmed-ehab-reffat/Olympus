+void mvt_layer::compact_attributes() {
+	std::vector<std::string> old_keys = std::move(keys);
+	std::vector<mvt_value> old_values = std::move(values);
+	std::vector<mvt_feature> old_features = std::move(features);
+
+	keys.clear();
+	values.clear();
+	features.clear();
+	key_dedup.assign(key_dedup.size(), -1);
+	value_dedup.assign(value_dedup.size(), -1);
+
+	for (size_t f = 0; f < old_features.size(); f++) {
+		mvt_feature &in = old_features[f];
+
+		mvt_feature out;
+		out.type = in.type;
+		out.id = in.id;
+		out.has_id = in.has_id;
+		out.dropped = in.dropped;
+		out.seq = in.seq;
+		out.geometry = std::move(in.geometry);
+
+		for (size_t i = 0; i + 1 < in.tags.size(); i += 2) {
+			if (in.tags[i] < old_keys.size() && in.tags[i + 1] < old_values.size()) {
+				tag(out, old_keys[in.tags[i]], old_values[in.tags[i + 1]]);
+			}
+		}
+
+		features.push_back(std::move(out));
+	}
+}
