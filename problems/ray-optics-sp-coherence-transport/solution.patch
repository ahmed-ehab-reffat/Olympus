+
+import {
+  collectNodeLabels,
+  collectParameterNames
+} from '../formula/dag-util.js';
+
+export const COHERENCE_INPUT_NAMES = ['C_0r', 'C_0i'];
+
+export function getSurfaceCoherenceSlots(surfaceType) {
+  const labels = collectNodeLabels(surfaceType.dag);
+  const slots = [];
+  for (let index = 1; index <= surfaceType.outRayCount; index++) {
+    const hasReal = labels.has(`C_${index}r`);
+    const hasImaginary = labels.has(`C_${index}i`);
+    if (hasReal !== hasImaginary) {
+      throw new TypeError(
+        `Surface type ${JSON.stringify(surfaceType.name)} must label both C_${index}r and C_${index}i or neither.`
+      );
+    }
+    slots.push(hasReal);
+  }
+  return slots;
+}
+
+export function sourceTypeHasCoherence(sourceType) {
+  const labels = collectNodeLabels(sourceType.dag);
+  if (labels.has('C_r') !== labels.has('C_i')) {
+    throw new TypeError(
+      `Source type ${JSON.stringify(sourceType.name)} must label both C_r and C_i or neither.`
+    );
+  }
+  return labels.has('C_r');
+}
+
+export function validateCoherenceInputNames(type, kind) {
+  for (const name of COHERENCE_INPUT_NAMES) {
+    if ((type?.paramNames ?? []).includes(name)) {
+      throw new TypeError(
+        `${kind} type ${JSON.stringify(type.name)} must not declare the reserved input ${JSON.stringify(name)}.`
+      );
+    }
+  }
+}
+
+export function dagReadsCoherence(dag) {
+  const names = collectParameterNames(dag);
+  return COHERENCE_INPUT_NAMES.some(name => names.has(name));
+}
+
+export function processedSceneUsesCoherence(description) {
+  const { sources, surfaces, detectors } = description.types;
+  return sources.some(type => sourceTypeHasCoherence(type.definition)) ||
+    surfaces.some(type =>
+      dagReadsCoherence(type.definition.dag) ||
+      getSurfaceCoherenceSlots(type.definition).some(Boolean)
+    ) ||
+    detectors.some(type => dagReadsCoherence(type.definition.dag));
+}
+
+export function limitCoherence(real, imaginary, powerS, powerP) {
+  if (!Number.isFinite(real) || !Number.isFinite(imaginary)) {
+    return null;
+  }
+  const limit = Math.sqrt(powerS * powerP);
+  const magnitude = Math.hypot(real, imaginary);
+  if (!(limit > 0)) return { real: 0, imaginary: 0 };
+  if (magnitude <= limit) return { real, imaginary };
+  const scale = limit / magnitude;
+  return { real: real * scale, imaginary: imaginary * scale };
+}
+
+export function scaleCoherenceByPowers(
+  real,
+  imaginary,
+  powerS,
+  powerP,
+  nextPowerS,
+  nextPowerP,
+  sign
+) {
+  const before = powerS * powerP;
+  const after = nextPowerS * nextPowerP;
+  if (!(before > 0) || !(after > 0)) {
+    return { real: 0, imaginary: 0 };
+  }
+  const scale = sign * Math.sqrt(after / before);
+  return { real: real * scale, imaginary: imaginary * scale };
+}
+
+export function multiplyCoherence(real, imaginary, factorReal, factorImaginary) {
+  return {
+    real: real * factorReal - imaginary * factorImaginary,
+    imaginary: real * factorImaginary + imaginary * factorReal
+  };
+}
