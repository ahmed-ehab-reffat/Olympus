+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ */
+
+import geometry from '../geometry.js';
+import { parseFormula } from '../formula/formula-parser.js';
+import { getEffectiveRayPowerOptions } from '../simulationEngines/rayPower.js';
+
+const SURFACE_INPUTS = [
+  'd_0x', 'd_0y', 'P_0s', 'P_0p', 'C_0r', 'C_0i', 'sigma'
+];
+
+const AXIS_STATEMENTS = `
+  b_s = cos(theta);
+  b_p = sigma * (-d_0y) * sin(theta);
+  N = sqrt(b_s * b_s + b_p * b_p);
+  a_s = b_s / N;
+  a_p = b_p / N;
+  d_1x = d_0x;
+  d_1y = d_0y;
+`;
+
+export const POLARIZER_SURFACE_TYPE = {
+  name: 'Polarizer',
+  paramNames: ['theta'],
+  dag: parseFormula(
+    `
+      ${AXIS_STATEMENTS}
+      I = a_s * a_s * P_0s + a_p * a_p * P_0p + 2 * a_s * a_p * C_0r;
+      P_1s = a_s * a_s * I;
+      P_1p = a_p * a_p * I;
+      C_1r = a_s * a_p * I;
+      C_1i = 0;
+    `,
+    [...SURFACE_INPUTS, 'theta']
+  ),
+  outRayCount: 1,
+  mergesWithBoundary: false
+};
+
+export const RETARDER_SURFACE_TYPE = {
+  name: 'Retarder',
+  paramNames: ['theta', 'Gamma'],
+  dag: parseFormula(
+    `
+      ${AXIS_STATEMENTS}
+      X = a_s * a_s * P_0s + a_p * a_p * P_0p + 2 * a_s * a_p * C_0r;
+      Y = a_p * a_p * P_0s + a_s * a_s * P_0p - 2 * a_s * a_p * C_0r;
+      K_r = a_s * a_p * (P_0p - P_0s) + (a_s * a_s - a_p * a_p) * C_0r;
+      Q_r = K_r * cos(Gamma) + C_0i * sin(Gamma);
+      Q_i = C_0i * cos(Gamma) - K_r * sin(Gamma);
+      P_1s = a_s * a_s * X + a_p * a_p * Y - 2 * a_s * a_p * Q_r;
+      P_1p = a_p * a_p * X + a_s * a_s * Y + 2 * a_s * a_p * Q_r;
+      C_1r = a_s * a_p * (X - Y) + (a_s * a_s - a_p * a_p) * Q_r;
+      C_1i = Q_i;
+    `,
+    [...SURFACE_INPUTS, 'theta', 'Gamma']
+  ),
+  outRayCount: 1,
+  mergesWithBoundary: false
+};
+
+export function createPolarizationElementPrimitive(obj, surfaceType, params) {
+  if (!obj.p1 || !obj.p2 ||
+      (obj.p1.x === obj.p2.x && obj.p1.y === obj.p2.y)) {
+    return [];
+  }
+  return [{
+    kind: 'surface',
+    curve: {
+      kind: 'lineSegment',
+      params: {
+        start: { x: obj.p1.x, y: obj.p1.y },
+        end: { x: obj.p2.x, y: obj.p2.y }
+      }
+    },
+    twoSided: true,
+    surfaceType,
+    params
+  }];
+}
+
+export function getRayAxisComponents(obj, ray, axisDegrees) {
+  const rayLength = geometry.segmentLength(ray);
+  const objLength = geometry.segmentLength(obj);
+  const directionX = (ray.p2.x - ray.p1.x) / rayLength;
+  const directionY = (ray.p2.y - ray.p1.y) / rayLength;
+  const alignment =
+    (-directionY * (obj.p2.x - obj.p1.x) +
+      directionX * (obj.p2.y - obj.p1.y)) / objLength;
+  const theta = axisDegrees * Math.PI / 180;
+  const unnormalizedS = Math.cos(theta);
+  const unnormalizedP = alignment * Math.sin(theta);
+  const norm = Math.hypot(unnormalizedS, unnormalizedP);
+  return { s: unnormalizedS / norm, p: unnormalizedP / norm };
+}
+
+export function passRayThrough(obj, ray, incidentPoint, powerS, powerP) {
+  ray.p2 = geometry.point(
+    incidentPoint.x + ray.p2.x - ray.p1.x,
+    incidentPoint.y + ray.p2.y - ray.p1.y
+  );
+  ray.p1 = incidentPoint;
+  ray.brightness_s = powerS;
+  ray.brightness_p = powerP;
+  const { rayPowerCutoff } = getEffectiveRayPowerOptions(obj.scene);
+  const power = powerS + powerP;
+  if (!(power > 0) || power < rayPowerCutoff) {
+    return {
+      isAbsorbed: true,
+      truncation: Math.max(power, 0)
+    };
+  }
+}
