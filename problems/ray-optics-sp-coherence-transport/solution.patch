+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+import BaseSceneObj from '../BaseSceneObj.js';
+import LineObjMixin from '../LineObjMixin.js';
+import i18next from 'i18next';
+import {
+  POLARIZER_SURFACE_TYPE,
+  createPolarizationElementPrimitive,
+  getRayAxisComponents,
+  passRayThrough
+} from '../polarizationElementPrimitive.js';
+
+/**
+ * Linear polarizer.
+ *
+ * Tools -> Other -> Polarizer
+ * @class
+ * @extends BaseSceneObj
+ * @memberof sceneObjs
+ * @property {Point} p1 - The first endpoint.
+ * @property {Point} p2 - The second endpoint.
+ * @property {number} axis - The angle in degrees of the transmission axis from the s direction toward the direction from `p1` to `p2`.
+ */
+class Polarizer extends LineObjMixin(BaseSceneObj) {
+  static type = 'Polarizer';
+  static isOptical = true;
+  static serializableDefaults = {
+    p1: null,
+    p2: null,
+    axis: 0
+  };
+
+  static getDescription(objData, scene, detailed = false) {
+    return i18next.t('main:tools.Polarizer.title');
+  }
+
+  static getPropertySchema(objData, scene) {
+    return [
+      ...super.getPropertySchema(objData, scene),
+      { key: 'axis', type: 'number', label: i18next.t('simulator:sceneObjs.Polarizer.axis') + ' (°)' },
+    ];
+  }
+
+  populateObjBar(objBar) {
+    objBar.setTitle(i18next.t('main:tools.Polarizer.title'));
+    objBar.createNumber(i18next.t('simulator:sceneObjs.Polarizer.axis') + ' (°)', -90, 90, 1, this.axis, function (obj, value) {
+      obj.axis = value;
+    });
+  }
+
+  draw(canvasRenderer, isAboveLight, isHovered) {
+    const ctx = canvasRenderer.ctx;
+    const ls = canvasRenderer.lengthScale;
+
+    if (this.p1.x == this.p2.x && this.p1.y == this.p2.y) {
+      ctx.fillStyle = 'rgb(128,128,128)';
+      ctx.fillRect(this.p1.x - 1.5 * ls, this.p1.y - 1.5 * ls, 3 * ls, 3 * ls);
+      return;
+    }
+
+    ctx.strokeStyle = isHovered ? this.scene.highlightColorCss : canvasRenderer.rgbaToCssColor(this.scene.theme.polarizer.color);
+    ctx.lineWidth = this.scene.theme.polarizer.width * ls;
+    ctx.setLineDash([4 * ls, 2 * ls]);
+    ctx.beginPath();
+    ctx.moveTo(this.p1.x, this.p1.y);
+    ctx.lineTo(this.p2.x, this.p2.y);
+    ctx.stroke();
+    ctx.setLineDash([]);
+  }
+
+  getPrimitives() {
+    return createPolarizationElementPrimitive(this, POLARIZER_SURFACE_TYPE, {
+      theta: this.axis * Math.PI / 180
+    });
+  }
+
+  checkRayIntersects(ray) {
+    return this.checkRayIntersectsShape(ray);
+  }
+
+  onRayIncident(ray, rayIndex, incidentPoint) {
+    const axis = getRayAxisComponents(this, ray, this.axis);
+    const transmitted =
+      axis.s * axis.s * ray.brightness_s + axis.p * axis.p * ray.brightness_p;
+    return passRayThrough(
+      this,
+      ray,
+      incidentPoint,
+      axis.s * axis.s * transmitted,
+      axis.p * axis.p * transmitted
+    );
+  }
+};
+
+export default Polarizer;
