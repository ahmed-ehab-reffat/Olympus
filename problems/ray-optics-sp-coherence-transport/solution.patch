+ * limitations under the License.
+ */
+
+import BaseSceneObj from '../BaseSceneObj.js';
+import LineObjMixin from '../LineObjMixin.js';
+import i18next from 'i18next';
+import {
+  RETARDER_SURFACE_TYPE,
+  createPolarizationElementPrimitive,
+  getRayAxisComponents,
+  passRayThrough
+} from '../polarizationElementPrimitive.js';
+
+/**
+ * Wave plate (linear retarder).
+ *
+ * Tools -> Other -> Retarder
+ * @class
+ * @extends BaseSceneObj
+ * @memberof sceneObjs
+ * @property {Point} p1 - The first endpoint.
+ * @property {Point} p2 - The second endpoint.
+ * @property {number} axis - The angle in degrees of the axis from the s direction toward the direction from `p1` to `p2`.
+ * @property {number} retardance - The phase in degrees added to the field component perpendicular to the axis.
+ */
+class Retarder extends LineObjMixin(BaseSceneObj) {
+  static type = 'Retarder';
+  static isOptical = true;
+  static serializableDefaults = {
+    p1: null,
+    p2: null,
+    axis: 0,
+    retardance: 90
+  };
+
+  static getDescription(objData, scene, detailed = false) {
+    return i18next.t('main:tools.Retarder.title');
+  }
+
+  static getPropertySchema(objData, scene) {
+    return [
+      ...super.getPropertySchema(objData, scene),
+      { key: 'axis', type: 'number', label: i18next.t('simulator:sceneObjs.Polarizer.axis') + ' (°)' },
+      { key: 'retardance', type: 'number', label: i18next.t('simulator:sceneObjs.Retarder.retardance') + ' (°)' },
+    ];
+  }
+
+  populateObjBar(objBar) {
+    objBar.setTitle(i18next.t('main:tools.Retarder.title'));
+    objBar.createNumber(i18next.t('simulator:sceneObjs.Polarizer.axis') + ' (°)', -90, 90, 1, this.axis, function (obj, value) {
+      obj.axis = value;
+    });
+    objBar.createNumber(i18next.t('simulator:sceneObjs.Retarder.retardance') + ' (°)', 0, 360, 1, this.retardance, function (obj, value) {
+      obj.retardance = value;
+    });
+  }
+
+  draw(canvasRenderer, isAboveLight, isHovered) {
+    const ctx = canvasRenderer.ctx;
+    const ls = canvasRenderer.lengthScale;
+
+    if (this.p1.x == this.p2.x && this.p1.y == this.p2.y) {
+      ctx.fillStyle = 'rgb(128,128,128)';
+      ctx.fillRect(this.p1.x - 1.5 * ls, this.p1.y - 1.5 * ls, 3 * ls, 3 * ls);
+      return;
+    }
+
+    ctx.strokeStyle = isHovered ? this.scene.highlightColorCss : canvasRenderer.rgbaToCssColor(this.scene.theme.retarder.color);
+    ctx.lineWidth = this.scene.theme.retarder.width * ls;
+    ctx.setLineDash([1 * ls, 2 * ls]);
+    ctx.beginPath();
+    ctx.moveTo(this.p1.x, this.p1.y);
+    ctx.lineTo(this.p2.x, this.p2.y);
+    ctx.stroke();
+    ctx.setLineDash([]);
+  }
+
+  getPrimitives() {
+    return createPolarizationElementPrimitive(this, RETARDER_SURFACE_TYPE, {
+      theta: this.axis * Math.PI / 180,
+      Gamma: this.retardance * Math.PI / 180
+    });
+  }
+
+  checkRayIntersects(ray) {
+    return this.checkRayIntersectsShape(ray);
+  }
+
+  onRayIncident(ray, rayIndex, incidentPoint) {
+    const axis = getRayAxisComponents(this, ray, this.axis);
+    const along =
+      axis.s * axis.s * ray.brightness_s + axis.p * axis.p * ray.brightness_p;
+    const across =
+      axis.p * axis.p * ray.brightness_s + axis.s * axis.s * ray.brightness_p;
+    const mixed = axis.s * axis.p * (ray.brightness_p - ray.brightness_s) *
+      Math.cos(this.retardance * Math.PI / 180);
+    return passRayThrough(
+      this,
+      ray,
+      incidentPoint,
+      axis.s * axis.s * along + axis.p * axis.p * across - 2 * axis.s * axis.p * mixed,
+      axis.p * axis.p * along + axis.s * axis.s * across + 2 * axis.s * axis.p * mixed
+    );
+  }
+};
+
+export default Retarder;
