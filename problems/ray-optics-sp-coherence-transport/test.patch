+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path) OUTPUT_PATH="${2:-}"; shift 2 ;;
+    base|new) MODE="$1"; shift ;;
+    *) shift ;;
+  esac
+done
+
+MODE="${MODE:-base}"
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT" || exit 1
+
+JEST="$ROOT/node_modules/.bin/jest"
+NEW_TESTS="test/primitive/coherence-e4d83f.test.js"
+
+if [ "$MODE" = "new" ]; then
+  set -- "$NEW_TESTS"
+else
+  set -- test/formula test/primitive test/propertyUtils test/sceneObjs --testPathIgnorePatterns "$NEW_TESTS"
+fi
+
+if [ -z "$OUTPUT_PATH" ]; then
+  "$JEST" "$@"
+  exit $?
+fi
+
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+REPORTER="$ROOT/node_modules/jest-junit"
+if [ ! -d "$REPORTER" ]; then
+  REPORTER="$(npm root -g)/jest-junit"
+fi
+LOG="$(mktemp)"
+
+JEST_JUNIT_OUTPUT_FILE="$OUTPUT_PATH" JEST_JUNIT_CLASSNAME="{filepath}" JEST_JUNIT_TITLE="{title}" \
+  "$JEST" "$@" --reporters=default --reporters="$REPORTER" > "$LOG" 2>&1
+EXIT_CODE=$?
+cat "$LOG"
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH" 2>/dev/null; then
+  {
+    printf '<?xml version="1.0" encoding="UTF-8"?>\n'
+    printf '<testsuites name="ray-optics" tests="1" failures="1" errors="0" time="0">\n'
+    printf '<testsuite name="%s" tests="1" failures="1" errors="0" time="0">\n' "$MODE"
+    printf '<testcase name="test suite loads and runs" classname="%s" time="0">\n' "$MODE"
+    printf '<failure message="the test suite did not produce results"><![CDATA['
+    sed 's/]]>/]]]]><![CDATA[>/g' "$LOG"
+    printf ']]></failure>\n</testcase>\n</testsuite>\n</testsuites>\n'
+  } > "$OUTPUT_PATH"
+  rm -f "$LOG"
+  exit 1
+fi
+
+rm -f "$LOG"
+exit $EXIT_CODE
diff --git a/test/primitive/coherence-e4d83f.test.js b/test/primitive/coherence-e4d83f.test.js
