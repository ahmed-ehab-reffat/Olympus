+import CpuSimulationEngine from '../../src/core/simulationEngines/cpu/CpuSimulationEngine';
+import WebGpuSimulationEngine from '../../src/core/simulationEngines/webgpu/WebGpuSimulationEngine';
+import { parseFormula } from '../../src/core/formula/formula-parser';
+import { preprocessPrimitives } from '../../src/core/primitive/preprocess';
+import Scene from '../../src/core/Scene';
+import { Detector, Polarizer, Retarder } from '../../src/core/sceneObjs';
+
+const SQRT_HALF = Math.SQRT1_2;
+
+function sourceType(outputs, name = 'source') {
+  return {
+    name,
+    paramNames: [],
+    dag: parseFormula(outputs, [])
+  };
+}
+
+function source({
+  x = 0,
+  y = 5,
+  dx = 1,
+  dy = 0,
+  s = 0.5,
+  p = 0.5,
+  cr,
+  ci
+} = {}) {
+  const coherence = cr === undefined ? '' : `C_r = ${cr}; C_i = ${ci};`;
+  return {
+    kind: 'source',
+    rayCount: 1,
+    params: {},
+    sourceType: sourceType(
+      `x = ${x}; y = ${y}; d_x = ${dx}; d_y = ${dy}; P_s = ${s}; P_p = ${p}; lambda = 540; ${coherence}`
+    )
+  };
+}
+
+function segment(start, end) {
+  return {
+    kind: 'lineSegment',
+    params: {
+      start: { x: start[0], y: start[1] },
+      end: { x: end[0], y: end[1] }
+    }
+  };
+}
+
+function rectangle(left, bottom, right, top) {
+  return [
+    segment([left, bottom], [left, top]),
+    segment([left, top], [right, top]),
+    segment([right, top], [right, bottom]),
+    segment([right, bottom], [left, bottom])
+  ];
+}
+
+const STOKES_DETECTOR_TYPE = {
+  name: 'state',
+  paramNames: [],
+  writeCount: 4,
+  dag: parseFormula(
+    'k_1 = 0; v_1 = P_0s; k_2 = 1; v_2 = P_0p; k_3 = 2; v_3 = C_0r; k_4 = 3; v_4 = C_0i;',
+    ['P_0s', 'P_0p', 'C_0r', 'C_0i']
+  )
+};
+
+function detector(start, end) {
+  return {
+    kind: 'detector',
+    curve: segment(start, end),
+    twoSided: true,
+    detectorType: STOKES_DETECTOR_TYPE,
+    params: {},
+    resultSize: 4,
+    result: { values: null }
+  };
+}
+
+function surface(curve, dag, outRayCount = 1, name = 'surface') {
+  return {
+    kind: 'surface',
+    curve,
+    twoSided: true,
+    surfaceType: {
+      name,
+      paramNames: [],
+      outRayCount,
+      mergesWithBoundary: false,
+      dag: parseFormula(dag, [
+        'd_0x', 'd_0y', 'P_0s', 'P_0p', 'C_0r', 'C_0i', 'sigma'
+      ])
+    },
+    params: {}
+  };
+}
+
+function polarizer(x, axisS, axisP, name) {
+  const ss = axisS * axisS;
+  const pp = axisP * axisP;
+  const sp = axisS * axisP;
+  return surface(
+    segment([x, 0], [x, 10]),
+    `A = ${ss} * P_0s + ${pp} * P_0p + ${2 * sp} * C_0r;
+     d_1x = d_0x; d_1y = d_0y;
+     P_1s = ${ss} * A; P_1p = ${pp} * A;
+     C_1r = ${sp} * A; C_1i = 0;`,
+    1,
+    name
+  );
+}
+
+const MIRROR = 'd_1x = d_0x; d_1y = -d_0y; P_1s = P_0s; P_1p = P_0p;';
+
+function glass(n, alpha = 0) {
+  return {
+    name: `glass ${n} ${alpha}`,
+    paramNames: [],
+    dag: parseFormula(`n = ${n}; alpha = ${alpha};`, [])
+  };
+}
+
+function region(curves, n, { partialReflect = true, stepSize = 0, alpha = 0 } = {}) {
+  return {
+    kind: 'region',
+    curves,
+    bulkType: glass(n, alpha),
+    params: {},
+    stepSize,
+    partialReflect
+  };
+}
+
+async function run(primitives, options = {}) {
+  const { processedScene } = preprocessPrimitives(primitives, {
+    numericEpsilon: Number.EPSILON
+  });
+  const engine = new CpuSimulationEngine();
+  engine.beginRenderer = () => null;
+  const simulation = await engine.createRun({
+    preparedScene: await engine.prepare(processedScene),
+    ...options
+  });
+  let update;
+  do {
+    update = await simulation.advance();
+  } while (update.status !== 'complete');
+  return update.result.detectors.map(values => Array.from(values));
+}
+
+function expectState(actual, expected) {
+  expect(actual).toHaveLength(4);
+  for (let index = 0; index < 4; index++) {
+    expect(actual[index]).toBeCloseTo(expected[index], 9);
+  }
+}
+
+function fresnel(n1, n2, cosIncident) {
+  const m = n1 / n2;
+  const cosTransmitted = Math.sqrt(1 - m * m * (1 - cosIncident * cosIncident));
+  const rs = (m * cosIncident - cosTransmitted) / (m * cosIncident + cosTransmitted);
+  const rp = (cosIncident - m * cosTransmitted) / (cosIncident + m * cosTransmitted);
+  return { rs, rp };
+}
+
+describe('primitive coherence contract', () => {
+  it('rejects a source type that labels only one coherence component', () => {
+    for (const label of ['C_r = 0.5;', 'C_i = 0.5;']) {
+      expect(() => preprocessPrimitives([{
+        kind: 'source',
+        rayCount: 1,
+        params: {},
+        sourceType: sourceType(`x = 0; y = 0; d_x = 1; d_y = 0; P_s = 1; P_p = 1; lambda = 540; ${label}`)
+      }], { numericEpsilon: Number.EPSILON })).toThrow(TypeError);
+    }
+  });
+
+  it('rejects a surface slot that labels only one coherence component', () => {
+    for (const label of ['C_1r = 0;', 'C_1i = 0;']) {
+      expect(() => preprocessPrimitives([
+        surface(segment([1, 0], [1, 1]), `${MIRROR} ${label}`)
+      ], { numericEpsilon: Number.EPSILON })).toThrow(TypeError);
+    }
+    for (const label of ['C_2r = 0;', 'C_2i = 0;']) {
+      expect(() => preprocessPrimitives([
+        surface(segment([1, 0], [1, 1]),
+          `${MIRROR} C_1r = 0; C_1i = 0; d_2x = d_0x; d_2y = d_0y; P_2s = 0; P_2p = 0; ${label}`, 2)
+      ], { numericEpsilon: Number.EPSILON })).toThrow(TypeError);
+    }
+  });
+
+  it('rejects coherence inputs declared as surface parameters', () => {
+    for (const name of ['C_0r', 'C_0i']) {
+      const primitive = surface(segment([1, 0], [1, 1]), MIRROR);
+      primitive.surfaceType = { ...primitive.surfaceType, paramNames: [name] };
+      primitive.params = { [name]: 0 };
+      expect(() => preprocessPrimitives([primitive], {
+        numericEpsilon: Number.EPSILON
+      })).toThrow(TypeError);
+    }
+  });
+
+  it('rejects coherence inputs declared as detector parameters', () => {
+    for (const name of ['C_0r', 'C_0i']) {
+      const primitive = detector([1, 0], [1, 1]);
+      primitive.detectorType = { ...primitive.detectorType, paramNames: [name] };
+      primitive.params = { [name]: 0 };
+      expect(() => preprocessPrimitives([primitive], {
+        numericEpsilon: Number.EPSILON
+      })).toThrow(TypeError);
+    }
+  });
+
+  it('delivers the source coherence to a detector', async () => {
+    const [state] = await run([
+      source({ s: 0.8, p: 0.2, cr: 0.24, ci: -0.3 }),
+      detector([5, 0], [5, 10])
+    ]);
+    expectState(state, [0.8, 0.2, 0.24, -0.3]);
+  });
+
+  it('scales an over-coherent source value down to the fully polarized bound', async () => {
+    const [state] = await run([
+      source({ s: 0.8, p: 0.2, cr: 0.6, ci: 0.8 }),
+      detector([5, 0], [5, 10])
+    ]);
+    expectState(state, [0.8, 0.2, 0.24, 0.32]);
+  });
+
+  it('treats a source with non-finite coherence as invalid', async () => {
+    const [state] = await run([
+      source({ cr: '1 / 0', ci: 0 }),
+      detector([5, 0], [5, 10])
+    ]);
+    expectState(state, [0, 0, 0, 0]);
+  });
+
+  it('treats a source with a non-finite imaginary coherence as invalid', async () => {
+    const [state] = await run([
+      source({ cr: 0, ci: '1 / 0' }),
+      detector([5, 0], [5, 10])
+    ]);
+    expectState(state, [0, 0, 0, 0]);
+  });
+
+  it('keeps a surface that reads coherence active for an incoherent ray', async () => {
+    const [state] = await run([
+      source(),
+      surface(segment([3, 0], [3, 10]),
+        'd_1x = d_0x; d_1y = d_0y; P_1s = P_0s + C_0r; P_1p = P_0p + C_0i;'),
+      detector([5, 0], [5, 10])
+    ]);
+    expectState(state, [0.5, 0.5, 0, 0]);
+  });
+});
+
+describe('formula surfaces', () => {
+  it('blocks light between crossed diagonal polarizers', async () => {
+    const [between, after] = await run([
+      source({ cr: 0, ci: 0 }),
+      polarizer(3, SQRT_HALF, SQRT_HALF, 'plus'),
+      detector([4, 0], [4, 10]),
+      polarizer(5, SQRT_HALF, -SQRT_HALF, 'minus'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(between, [0.25, 0.25, 0.25, 0]);
+    expectState(after, [0, 0, 0, 0]);
+  });
+
+  it('passes diagonal light through a matching polarizer', async () => {
+    const [state] = await run([
+      source({ cr: 0.5, ci: 0 }),
+      polarizer(3, SQRT_HALF, SQRT_HALF, 'plus'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(state, [0.5, 0.5, 0.5, 0]);
+  });
+
+  it('limits explicit coherence outputs to the output powers', async () => {
+    const [state] = await run([
+      source({ cr: 0, ci: 0 }),
+      surface(segment([3, 0], [3, 10]),
+        'd_1x = d_0x; d_1y = d_0y; P_1s = 0.9; P_1p = 0.1; C_1r = 0; C_1i = -3;'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(state, [0.9, 0.1, 0, -0.3]);
+  });
+
+  it('deactivates a slot whose explicit coherence is not finite', async () => {
+    const [state] = await run([
+      source({ cr: 0.1, ci: 0 }),
+      surface(segment([3, 0], [3, 10]),
+        'd_1x = d_0x; d_1y = d_0y; P_1s = P_0s; P_1p = P_0p; C_1r = sqrt(-1); C_1i = 0;'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(state, [0, 0, 0, 0]);
+  });
+
+  it('deactivates a slot whose explicit imaginary coherence is not finite', async () => {
+    const [state] = await run([
+      source({ cr: 0.1, ci: 0 }),
+      surface(segment([3, 0], [3, 10]),
+        'd_1x = d_0x; d_1y = d_0y; P_1s = P_0s; P_1p = P_0p; C_1r = 0; C_1i = sqrt(-1);'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(state, [0, 0, 0, 0]);
+  });
+
+  it('negates coherence on a mirror that declares no coherence outputs', async () => {
+    const [state] = await run([
+      source({ x: 3, cr: 0.3, ci: 0.2 }),
+      surface(segment([5, 0], [5, 10]), MIRROR),
+      detector([1, 0], [1, 10])
+    ]);
+    expectState(state, [0.5, 0.5, -0.3, -0.2]);
+  });
+
+  it('scales transmitted coherence by the geometric mean of the power ratios', async () => {
+    const [state] = await run([
+      source({ s: 0.8, p: 0.2, cr: 0.2, ci: 0.1 }),
+      surface(segment([3, 0], [3, 10]),
+        'd_1x = d_0x; d_1y = d_0y; P_1s = 0.25 * P_0s; P_1p = P_0p;'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(state, [0.2, 0.2, 0.1, 0.05]);
+  });
+
+  it('signs each default slot by the side of the surface it leaves on', async () => {
+    const [transmitted, reflected] = await run([
+      source({ x: 3, s: 0.8, p: 0.2, cr: 0.2, ci: -0.1 }),
+      surface(segment([5, 0], [5, 10]),
+        `d_1x = d_0x; d_1y = d_0y; P_1s = 0.36 * P_0s; P_1p = 0.64 * P_0p;
+         d_2x = d_0x; d_2y = -d_0y; P_2s = 0.64 * P_0s; P_2p = 0.36 * P_0p;`,
+        2),
+      detector([7, 0], [7, 10]),
+      detector([1, 0], [1, 10])
+    ]);
+    expectState(transmitted, [0.288, 0.128, 0.096, -0.048]);
+    expectState(reflected, [0.512, 0.072, -0.096, 0.048]);
+  });
+
+  it('gives no coherence to slots that carry a single polarization', async () => {
+    const [transmitted, bothWays] = await run([
+      source({ cr: 0.2, ci: 0.1 }),
+      surface(segment([5, 0], [5, 10]),
+        `d_1x = d_0x; d_1y = d_0y; P_1s = P_0s; P_1p = 0;
+         d_2x = d_0x; d_2y = -d_0y; P_2s = 0; P_2p = P_0p;`,
+        2),
+      detector([7, 0], [7, 10]),
+      detector([1, 0], [1, 10])
+    ]);
+    expectState(transmitted, [0.5, 0, 0, 0]);
+    expectState(bothWays, [0.5, 1, 0.2, 0.1]);
+    const [fed] = await run([
+      source({ s: 0, p: 0.5 }),
+      surface(segment([3, 0], [3, 10]),
+        'd_1x = d_0x; d_1y = d_0y; P_1s = P_0p; P_1p = P_0p;'),
+      detector([7, 0], [7, 10])
+    ]);
+    expectState(fed, [0.5, 0.5, 0, 0]);
+  });
+
+  it('sets explicit coherence on a later output slot', async () => {
+    const [transmitted, reflected] = await run([
+      source({ x: 3, cr: 0.1, ci: 0.1 }),
+      surface(segment([5, 0], [5, 10]),
+        `d_1x = d_0x; d_1y = d_0y; P_1s = 0.2; P_1p = 0.2;
+         d_2x = d_0x; d_2y = -d_0y; P_2s = 0.3; P_2p = 0.3; C_2r = 0.1; C_2i = -0.2;`,
+        2),
+      detector([7, 0], [7, 10]),
+      detector([1, 0], [1, 10])
+    ]);
+    expectState(transmitted, [0.2, 0.2, 0.04, 0.04]);
+    expectState(reflected, [0.3, 0.3, 0.1, -0.2]);
+  });
+
+  it('mixes explicit and default slots within one surface type', async () => {
+    const [transmitted, reflected] = await run([
+      source({ x: 3, cr: 0.4, ci: 0 }),
+      surface(segment([5, 0], [5, 10]),
+        `d_1x = d_0x; d_1y = d_0y; P_1s = 0.5 * P_0s; P_1p = 0.5 * P_0p; C_1r = 0; C_1i = 0.2;
+         d_2x = d_0x; d_2y = -d_0y; P_2s = 0.5 * P_0s; P_2p = 0.5 * P_0p;`,
+        2),
+      detector([7, 0], [7, 10]),
+      detector([1, 0], [1, 10])
+    ]);
+    expectState(transmitted, [0.25, 0.25, 0, 0.2]);
+    expectState(reflected, [0.25, 0.25, -0.2, 0]);
+  });
+
+  it('decides the default sign from the curve rather than the interpolated normal', async () => {
+    const tilt = { x: -1, y: -2 };
+    const [crossed] = await run([
+      source({ cr: 0.3, ci: 0.1 }),
+      {
+        ...surface(null, MIRROR),
+        curve: {
+          kind: 'smoothLineSegment',
+          params: {
+            start: { x: 5, y: 0 },
+            end: { x: 5, y: 10 },
+            startNormal: tilt,
+            endNormal: tilt
+          }
+        }
+      },
+      detector([5.5, -20], [5.5, 20])
+    ]);
+    expectState(crossed, [0.5, 0.5, 0.3, 0.1]);
+  });
+});
+
+describe('region boundaries', () => {
+  it('reflects coherence with the sign an ideal mirror gives at normal incidence', async () => {
+    const [state] = await run([
+      source({ x: 3, cr: 0.3, ci: 0.2 }),
+      region(rectangle(5, 0, 15, 10), 1.5),
+      detector([1, 0], [1, 10])
+    ], { maxRayDepth: 2 });
+    expectState(state, [0.02, 0.02, -0.012, -0.008]);
+  });
+
+  it('reflects coherence with the product of the oblique amplitude coefficients', async () => {
+    const c = Math.cos(Math.PI / 4);
+    const { rs, rp } = fresnel(1, 1.5, c);
+    const [state] = await run([
+      source({ x: 0, y: 0, dx: c, dy: c, s: 0.6, p: 0.4, cr: 0.3, ci: -0.2 }),
+      region(rectangle(-50, 10, 50, 30), 1.5),
+      detector([5, 0], [30, 0])
+    ]);
+    expectState(state, [0.6 * rs * rs, 0.4 * rp * rp, 0.3 * rs * rp, -0.2 * rs * rp]);
+    const angle = Math.PI / 3;
+    const steep = fresnel(1, 1.8, Math.cos(angle));
+    const [steepState] = await run([
+      source({ x: 0, y: 0, dx: Math.sin(angle), dy: Math.cos(angle), s: 0.6, p: 0.4, cr: 0.3, ci: -0.2 }),
+      region(rectangle(-50, 10, 50, 30), 1.8),
+      detector([5, 0], [40, 0])
+    ], { maxRayDepth: 2 });
+    const product = steep.rs * steep.rp;
+    expectState(steepState, [
+      0.6 * steep.rs * steep.rs, 0.4 * steep.rp * steep.rp, 0.3 * product, -0.2 * product
+    ]);
+  });
+
+  it('transmits coherence scaled by both transmitted amplitudes', async () => {
+    const { rs, rp } = fresnel(1, 1.5, 1);
+    const scale = Math.sqrt((1 - rs * rs) * (1 - rp * rp));
+    const [state] = await run([
+      source({ s: 0.6, p: 0.4, cr: 0.3, ci: -0.2 }),
+      region(rectangle(5, 0, 15, 10), 1.5),
+      detector([7, 0], [7, 10])
+    ], { maxRayDepth: 2 });
+    expectState(state, [
+      0.6 * (1 - rs * rs), 0.4 * (1 - rp * rp), 0.3 * scale, -0.2 * scale
+    ]);
+  });
+
+  it('transmits coherence with the geometric mean of unequal oblique transmissions', async () => {
+    const c = Math.cos(Math.PI / 4);
+    const { rs, rp } = fresnel(1, 1.5, c);
+    const transmittedS = 1 - rs * rs;
+    const transmittedP = 1 - rp * rp;
+    const scale = Math.sqrt(transmittedS * transmittedP);
+    const [state] = await run([
+      source({ x: 0, y: 0, dx: c, dy: c, s: 0.6, p: 0.4, cr: 0.3, ci: -0.2 }),
+      region(rectangle(5, -50, 60, 50), 1.5),
+      detector([10, -50], [10, 50])
+    ], { maxRayDepth: 2 });
+    expect(Math.abs(transmittedS - transmittedP)).toBeGreaterThan(0.01);
+    expectState(state, [
+      0.6 * transmittedS, 0.4 * transmittedP, 0.3 * scale, -0.2 * scale
+    ]);
+  });
+
+  it('keeps coherence unchanged across a boundary without partial reflection', async () => {
+    const [state] = await run([
+      source({ s: 0.6, p: 0.4, cr: 0.3, ci: -0.2 }),
+      region(rectangle(5, 0, 15, 10), 1.5, { partialReflect: false }),
