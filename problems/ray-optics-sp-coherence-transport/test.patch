+function complex(re, im = 0) {
+  return { re, im };
+}
+
+function cmul(a, b) {
+  return { re: a.re * b.re - a.im * b.im, im: a.re * b.im + a.im * b.re };
+}
+
+function cadd(a, b) {
+  return { re: a.re + b.re, im: a.im + b.im };
+}
+
+function cconj(a) {
+  return { re: a.re, im: -a.im };
+}
+
+function matmul(a, b) {
+  return [0, 1].map(row => [0, 1].map(column =>
+    cadd(cmul(a[row][0], b[0][column]), cmul(a[row][1], b[1][column]))
+  ));
+}
+
+function adjoint(a) {
+  return [[cconj(a[0][0]), cconj(a[1][0])], [cconj(a[0][1]), cconj(a[1][1])]];
+}
+
+function applyJones(state, jones) {
+  const [powerS, powerP, real, imaginary] = state;
+  const coherency = [
+    [complex(powerS), complex(real, imaginary)],
+    [complex(real, -imaginary), complex(powerP)]
+  ];
+  const result = matmul(matmul(jones, coherency), adjoint(jones));
+  return [result[0][0].re, result[1][1].re, result[0][1].re, result[0][1].im];
+}
+
+function elementAxis(start, end, direction, axisDegrees) {
+  const length = Math.hypot(end[0] - start[0], end[1] - start[1]);
+  const size = Math.hypot(direction[0], direction[1]);
+  const alignment = (
+    -direction[1] * (end[0] - start[0]) + direction[0] * (end[1] - start[1])
+  ) / (length * size);
+  const theta = axisDegrees * Math.PI / 180;
+  const along = Math.cos(theta);
+  const across = Math.sin(theta) * alignment;
+  const norm = Math.hypot(along, across);
+  return [along / norm, across / norm];
+}
+
+function polarizerJones([as, ap]) {
+  return [
+    [complex(as * as), complex(as * ap)],
+    [complex(as * ap), complex(ap * ap)]
+  ];
+}
+
+function retarderJones([as, ap], retardanceDegrees) {
+  const gamma = retardanceDegrees * Math.PI / 180;
+  const phase = complex(Math.cos(gamma), Math.sin(gamma));
+  const scaled = value => cmul(phase, complex(value));
+  return [
+    [cadd(complex(as * as), scaled(ap * ap)), cadd(complex(as * ap), scaled(-as * ap))],
+    [cadd(complex(as * ap), scaled(-as * ap)), cadd(complex(ap * ap), scaled(as * as))]
+  ];
+}
+
+function polarizerObject(start, end, axis) {
+  return new Polarizer(new Scene(), {
+    p1: { x: start[0], y: start[1] },
+    p2: { x: end[0], y: end[1] },
+    axis
+  });
+}
+
+function retarderObject(start, end, axis, retardance) {
+  return new Retarder(new Scene(), {
+    p1: { x: start[0], y: start[1] },
+    p2: { x: end[0], y: end[1] },
+    axis,
+    retardance
+  });
+}
+
+function detectorObject(options) {
+  return new Detector(new Scene(), {
+    p1: { x: 5, y: 0 },
+    p2: { x: 5, y: 10 },
+    ...options
+  });
+}
+
+function readDetector(object, values) {
+  object.results.values = values;
+  object.updateMeasurementsFromPrimitiveResults();
+  return object;
+}
+
+function expectClose(actual, expected) {
+  expect(actual).toHaveLength(expected.length);
+  expected.forEach((value, index) => {
+    expect(actual[index]).toBeCloseTo(value, 9);
+  });
+}
