+    _, resumed = resume_first_order(files[step])
+    tail = [(ii.step, ii.dt) for ii in log_of(whole) if ii.step > step]
+    assert tail
+    assert [(ii.step, ii.dt) for ii in log_of(resumed)
+            if ii.step > step] == tail
