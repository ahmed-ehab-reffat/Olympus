+    pb.solve(status=status)
+    log = log_of(status)
+    assert status.termination == 'max_rejections'
+    assert log.for_step(0)[0].result == 'reject'
+    assert log[-1].result == 'reject'
+    assert not log.accepted()
+    assert nm.array_equal(pb.get_variables()['t'](), initial)
+
+def test_a_rejected_initial_solve_leaves_a_state_of_its_own():
+    pb = make_first_order(eps_a=1e-30, i_max=1, max_rejections=0)
+    initial = initial_state_of(pb)
+    moved_pb, moved = run_first_order(ts='ts.simple', eps_a=1e-30, i_max=1,
+                                      n_step=2)
+    assert log_of(moved).for_step(0)[0].result == 'reject'
+    assert not nm.array_equal(moved_pb.get_variables()['t'](), initial)
+
+def ramping_value(ts, coors, bc=None, problem=None, **kwargs):
+    value = 1.0 + ts.time if ts.time < 2.0 else 1e12
+
+    return nm.full(coors.shape[0], value)
+
+def test_a_run_stopped_after_progress_returns_its_last_accepted_state():
+    pb, status = run_first_order(
+        i_max=1, max_rejections=0,
+        extra_ebcs={'driven' : ('Right', {'t.all' : 'ramping_value'})},
+        extra_functions={'ramping_value' : (ramping_value,)},
+    )
+    log = log_of(status)
+    assert status.termination == 'max_rejections'
+    assert log[-1].result == 'reject'
+    accepted = log.accepted()
+    assert len(accepted) > 1
+    coors = pb.fields['temperature'].get_coor()[:, 0]
+    expected = (1.0 + accepted[-1].time) * coors
+    assert nm.allclose(pb.get_variables()['t'](), expected, rtol=0.0,
+                       atol=1e-10)
+
+def test_a_quasistatic_run_logs_its_initial_solve():
+    for ts in ('ts.simple', 'ts.adaptive'):
+        _, status = run_first_order(ts=ts)
+        initial = log_of(status).for_step(0)
+        assert len(initial) == 1
+        assert initial[0].result == 'accept'
+        assert initial[0].condition == 0
+
+def test_a_run_that_is_not_quasistatic_has_no_initial_attempt():
+    _, status = run_first_order(ts='ts.simple',
+                                extra_ts={'quasistatic' : False})
+    log = log_of(status)
+    assert log
+    assert not log.for_step(0)
+    assert min(steps(log)) == 1
+
+def test_an_initial_solve_aims_at_the_initial_time():
+    pb, status = run_first_order(ts='ts.simple')
+    assert log_of(status).for_step(0)[0].time == pb.solver.ts.t0
+
+def test_a_non_converged_initial_solve_is_rejected():
+    for ts in ('ts.simple', 'ts.adaptive'):
+        _, status = run_first_order(ts=ts, eps_a=1e-30, i_max=1,
+                                    max_rejections=2)
+        initial = log_of(status).for_step(0)
+        assert len(initial) == 1
+        assert initial[0].result == 'reject'
+        assert initial[0].condition != 0
+        assert initial[0].n_iter > 0
+
+def test_a_rejected_initial_solve_counts_as_a_rejection():
+    _, clean = run_first_order(ts='ts.simple')
+    _, failing = run_first_order(ts='ts.simple', eps_a=1e-30, i_max=1)
+    assert clean.n_rejected == 0
+    assert 0 in steps(log_of(failing))
+    assert failing.n_rejected == len(log_of(failing))
+
+def test_a_rejected_initial_solve_is_not_retried():
+    _, status = run_first_order(eps_a=1e-30, i_max=1, max_rejections=2)
+    log = log_of(status)
+    assert log.attempts_per_step()[0] == 1
+    assert log.for_step(0)[0].result == 'reject'
+    assert log[-1].step == 1
+    assert status.termination == 'max_rejections'
+
+def overshooting_adapt_fun(ts, status, adt, context=None, verbose=False):
+    ts.set_time_step(2.0 * ts.t1, update_time=True)
+    adt.wait += 1
+
+    return adt.wait > 6
+
+def test_no_attempt_aims_past_the_final_time():
+    pb, status = run_first_order(
+        eps_a=1e-30, i_max=1, max_rejections=3,
+        extra_ts={'adapt_fun' : overshooting_adapt_fun},
+    )
+    log = log_of(status)
+    t1 = pb.solver.ts.t1
+    assert len(log.for_step(1)) > 1
+    assert all(ii.time <= t1 + 1e-12 for ii in log)
+
+@pytest.mark.parametrize('extra_ts',
+                         [{}, {'adapt_fun' : overshooting_adapt_fun}])
+def test_a_retry_is_smaller_than_the_attempt_it_replaces(extra_ts):
+    _, status = run_first_order(eps_a=1e-30, i_max=1, max_rejections=3,
+                                extra_ts=extra_ts)
+    records = log_of(status).for_step(1)
+    assert len(records) > 1
+    assert all(b.dt < a.dt for a, b in zip(records, records[1:]))
+
+def jumping_adapt_fun(ts, status, adt, context=None, verbose=False):
+    ts.set_time_step(2.0 * ts.t1)
+
+    return True
+
+def test_an_accepted_step_may_not_carry_a_run_past_the_final_time():
+    pb, status = run_first_order(extra_ts={'adapt_fun' : jumping_adapt_fun})
+    ts = pb.solver.ts
+    assert all(ii.time <= ts.t1 + 1e-14 for ii in log_of(status))
+    assert abs(ts.time - ts.t1) < 1e-14
+    assert status.termination == 'completed'
+
+@pytest.mark.parametrize('extra_ts', [
+    {'dt_red_factor' : 0.0},
+    {'dt_red_factor' : -0.1},
+    {'dt_red_factor' : 1.0, 'dt_red_max' : 2.0},
+    {'dt_red_factor' : 1.5, 'dt_red_max' : 2.0},
+])
+def test_a_reduction_factor_that_cannot_shrink_a_retry_is_refused(extra_ts):
+    pb = make_first_order(extra_ts=extra_ts)
+    with pytest.raises(ValueError):
+        pb.init_solvers()
+
+def test_a_user_adapt_fun_keeps_the_run_accounted_for():
+    def always_break(ts, status, adt, context=None, verbose=False):
+        return True
+
+    _, status = run_first_order(extra_ts={'adapt_fun' : always_break})
+    assert status.termination == 'completed'
+    assert len(log_of(status)) > 0
