+def define_first_order(ts='ts.adaptive', t1=4.0, n_step=5, eps_a=1e-8,
+                       i_max=2, max_rejections=10, dt_min=0.0, extra_ts=None,
+                       extra_options=None, extra_ebcs=None,
+                       extra_functions=None):
+
+    def mesh_hook(mesh, mode):
+        if mode == 'read':
+            return gen_block_mesh((1.0, 1.0), (3, 3), (0.5, 0.5),
+                                  name='user_block', verbose=False)
+
+        elif mode == 'write':
+            pass
+
+    filename_mesh = UserMeshIO(mesh_hook)
+
+    regions = {
+        'Omega' : 'all',
+        'Left' : ('vertices in (x < 1e-12)', 'facet'),
+        'Right' : ('vertices in (x > 0.999999)', 'facet'),
+    }
+
+    materials = {
+        'one' : ({'val' : 1.0},),
+    }
+
+    fields = {
+        'temperature' : ('real', 1, 'Omega', 1),
+    }
+
+    variables = {
+        't' : ('unknown field', 'temperature', 0),
+        's' : ('test field', 'temperature', 't'),
+    }
+
+    ebcs = {
+        'fixed' : ('Left', {'t.all' : 0.0}),
+        'driven' : ('Right', {'t.all' : 1.0}),
+    }
+    ebcs.update(extra_ebcs if extra_ebcs is not None else {})
+
+    functions = dict(extra_functions if extra_functions is not None else {})
+
+    equations = {
+        'eq' : """dw_laplace.2.Omega(one.val, s, t) = 0""",
+    }
+
+    ts_conf = {
+        't0' : 0.0,
+        't1' : t1,
+        'dt' : None,
+        'n_step' : n_step,
+        'quasistatic' : True,
+        'verbose' : 0,
+    }
+    if ts == 'ts.adaptive':
+        ts_conf['max_rejections'] = max_rejections
+        ts_conf['dt_min'] = dt_min
+
+    ts_conf.update(extra_ts if extra_ts is not None else {})
+
+    solvers = {
+        'ls' : ('ls.scipy_direct', {}),
+        'newton' : ('nls.newton', {
+            'i_max' : i_max,
+            'eps_a' : eps_a,
+        }),
+        'ts' : (ts, ts_conf),
+    }
+
+    options = {
+        'ts' : 'ts',
+        'nls' : 'newton',
+        'ls' : 'ls',
+        'active_only' : False,
+    }
+    options.update(extra_options if extra_options is not None else {})
+
+    return locals()
+
+def make_first_order(**kwargs):
+    from sfepy.discrete import Problem
+    from sfepy.base.conf import ProblemConf
+
+    conf = ProblemConf.from_dict(define_first_order(**kwargs),
+                                 sys.modules[__name__])
+    pb = Problem.from_conf(conf)
+    pb.update_materials()
+
+    return pb
+
+def run_first_order(**kwargs):
+    pb = make_first_order(**kwargs)
+    status = IndexedStruct()
+    pb.solve(status=status)
+
+    return pb, status
