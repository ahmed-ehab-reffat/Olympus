+def test_a_step_rejected_repeatedly_and_then_accepted_continues(rejecting_run):
+    _, status = rejecting_run
+    log = log_of(status)
+    counts = log.attempts_per_step()
+    worst = max(counts.values())
+    assert worst > 1
+    step = min(key for key, val in counts.items() if val == worst)
+    got = [ii.result for ii in log.for_step(step)]
+    assert got == ['reject'] * (worst - 1) + ['accept']
+    assert status.termination == 'completed'
