+def test_a_record_carries_the_error_the_controller_reported(monkeypatch):
+    from sfepy.solvers.ts_controllers import ElastodynamicsBasicTSC
+    reported = []
+    original = ElastodynamicsBasicTSC.__call__
+
+    def recording(self, ts, vec0, vec1, **kwargs):
+        new_dt, tsc_status = original(self, ts, vec0, vec1, **kwargs)
+        reported.append(tsc_status.emax)
+
+        return new_dt, tsc_status
+
+    monkeypatch.setattr(ElastodynamicsBasicTSC, '__call__', recording)
+    _, status = run(tsc='tsc.ed_basic')
+
+    assert len(reported) > 1
+    assert [ii.emax for ii in log_of(status)] == reported
