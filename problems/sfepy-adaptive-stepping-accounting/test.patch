+import sys
+
+import numpy as nm
+import pytest
+
+from sfepy.base.base import IndexedStruct
+from sfepy.discrete.fem.meshio import UserMeshIO
+from sfepy.mesh.mesh_generators import gen_block_mesh
+import sfepy.mechanics.matcoefs as mc
+
+
+def define(t1=8e-6, dt=2e-6, dims=(0.1, 0.02), shape=(4, 2), young=70e9,
+           poisson=0.3, density=2700, eps_r=1e-3, eps_a=1e-6, veps=None,
+           ts='ts.velocity_verlet', tsc='tsc.ed_basic', max_rejections=10,
+           dt_min=0.0, extra_tsc=None, extra_ts=None, extra_options=None):
+
+    def mesh_hook(mesh, mode):
+        if mode == 'read':
+            return gen_block_mesh(dims, shape, 0.5 * nm.array(dims),
+                                  name='user_block', verbose=False)
+
+        elif mode == 'write':
+            pass
+
+    filename_mesh = UserMeshIO(mesh_hook)
+    dim = len(dims)
+
+    regions = {
+        'Omega' : 'all',
+        'Left' : ('vertices in (x < 1e-12)', 'facet'),
+    }
+
+    materials = {
+        'solid' : ({
+            'D': mc.stiffness_from_youngpoisson(
+                dim=dim, young=young, poisson=poisson, plane='strain'
+            ),
+            'rho': density,
+         },),
+    }
+
+    fields = {
+        'displacement': ('real', 'vector', 'Omega', 1),
+    }
+
+    integrals = {
+        'i' : 2,
+    }
+
+    variables = {
+        'u' : ('unknown field', 'displacement', 0),
+        'du' : ('unknown field', 'displacement', 1),
+        'ddu' : ('unknown field', 'displacement', 2),
+        'v' : ('test field', 'displacement', 'u'),
+        'dv' : ('test field', 'displacement', 'du'),
+        'ddv' : ('test field', 'displacement', 'ddu'),
+    }
+    var_names = {'u' : 'u', 'du' : 'du', 'ddu' : 'ddu'}
+
+    ebcs = {
+        'fix' : ('Left', {'u.all' : 0.0, 'du.all' : 0.0, 'ddu.all' : 0.0}),
+    }
+
+    def get_ic(coors, ic, mode='u'):
+        val = nm.zeros_like(coors)
+        if mode == 'du':
+            xmax = coors[:, 0].max()
+            val[:, -1] = nm.where((coors[:, 0] > (xmax - 1e-12)), 1.0, 0.0)
+
+        return val
+
+    functions = {
+        'get_ic_u' : (get_ic,),
+        'get_ic_du' : (lambda coor, ic: get_ic(coor, None, mode='du'),),
+    }
+
+    ics = {
+        'ic' : ('Omega', {'u.all' : 'get_ic_u', 'du.all' : 'get_ic_du'}),
+    }
+
+    equations = {
+        'balance_of_forces' :
+        """dw_dot.i.Omega(solid.rho, ddv, ddu)
+         + dw_zero.i.Omega(dv, du)
+         + dw_lin_elastic.i.Omega(solid.D, v, u) = 0""",
+    }
+
+    ts_conf = {
+        't0' : 0.0,
+        't1' : t1,
+        'dt' : dt,
+        'n_step' : None,
+        'is_linear' : True,
+        'var_names' : var_names,
+        'verbose' : 0,
+        'max_rejections' : max_rejections,
+        'dt_min' : dt_min,
+    }
+    ts_conf.update(extra_ts if extra_ts is not None else {})
+
+    veps_r, veps_a = veps if veps is not None else (1e-1, 1e-2)
+    tsc_conf = {
+        'eps_r' : (eps_r, veps_r),
+        'eps_a' : (eps_a, veps_a),
+        'fmin' : 0.3,
+        'fmax' : 2.5,
+        'fsafety' : 0.85,
+    }
+    tsc_conf.update(extra_tsc if extra_tsc is not None else {})
+
+    solvers = {
+        'ls' : ('ls.auto_direct', {}),
+        'newton' : ('nls.newton', {
+            'i_max' : 1,
+            'eps_a' : 1e-6,
+            'eps_r' : 1e-6,
+        }),
+        'tsvv' : (ts, ts_conf),
+        'tsc' : (tsc, tsc_conf),
+    }
+
+    options = {
+        'ts' : 'tsvv',
+        'tsc' : 'tsc',
+        'nls' : 'newton',
+        'ls' : 'ls',
+        'active_only' : False,
+        'output_format' : 'h5',
+    }
+    options.update(extra_options if extra_options is not None else {})
+
+    return locals()
+
+def make_problem(**kwargs):
+    from sfepy.discrete import Problem
+    from sfepy.base.conf import ProblemConf
+
+    conf = ProblemConf.from_dict(define(**kwargs), sys.modules[__name__])
+    pb = Problem.from_conf(conf)
+    pb.update_materials()
+
+    return pb
+
+def run(**kwargs):
+    pb = make_problem(**kwargs)
+    status = IndexedStruct()
+    pb.solve(status=status)
+
+    return pb, status
+
+def log_of(status):
+    return status.step_log
+
+def results(log):
+    return [ii.result for ii in log]
+
+def steps(log):
+    return [ii.step for ii in log]
+
+def fields(log):
+    return [(ii.step, ii.time, ii.dt, ii.result, ii.emax, ii.condition,
+             ii.n_iter) for ii in log]
+
+def starts_of(log, step):
+    return [ii.time - ii.dt for ii in log.for_step(step)]
+
+def check_state_round_trip(fresh, used):
+    initial = dict(fresh.get_state())
+    after = dict(used.get_state())
+    assert after and (after != initial)
+    fresh.set_state(**after)
+    assert fresh.get_state() == after
+    used.set_state(**initial)
+    assert used.get_state() == initial
+
+@pytest.fixture(scope='module')
+def clean_run():
+    return run(eps_a=1.0, eps_r=1.0, veps=(1.0, 1.0))
+
+@pytest.fixture(scope='module')
