+def test_a_times_sequence_state_replays_after_its_schedule_is_used_up():
+    times = [1e-6, 2e-6, 3e-6]
+    pb = make_problem(tsc='tsc.time_sequence',
+                      extra_tsc={'times' : iter(times)})
+    pb.init_solvers()
+    tsc, ts = pb.solver.tsc, pb.solver.ts
+    ts.set_step(0)
+    initial = dict(tsc.get_state())
+    expected = tsc.get_initial_dt(ts, None)
+
+    for _ in range(len(times) + 1):
+        ts.time = 0.0
+        tsc(ts, None, None)
+
+    tsc.set_state(**initial)
+    assert abs(tsc.get_initial_dt(ts, None) - expected) < 1e-18
