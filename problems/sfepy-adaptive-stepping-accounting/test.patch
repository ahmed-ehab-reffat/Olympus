+def resume(filename, output_dir=None, **kwargs):
+    pb = make_problem(extra_options={'load_restart' : filename}, **kwargs)
+    if output_dir is not None:
+        output_dir.mkdir(exist_ok=True)
+        pb.output_dir = str(output_dir)
+    status = IndexedStruct()
+    pb.solve(status=status)
+
+    return pb, status
