+    _, status = clean_run
+    counts = log_of(status).attempts_per_step()
+    assert set(counts.values()) == {1}
+
+def test_step_indices_are_non_decreasing(clean_run):
+    _, status = clean_run
+    seq = steps(log_of(status))
+    assert seq == sorted(seq)
+
+def test_a_record_carries_the_step_size_it_used(clean_run):
