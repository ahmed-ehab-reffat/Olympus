+    pb = make_problem(**kw)
+    pb.init_solvers()
+    tsc, ts = pb.solver.tsc, pb.solver.ts
+    ts.set_step(0)
+    tsc.get_initial_dt(ts, None)
+    saved = dict(tsc.get_state())
+    ts.time = 0.0
+    expected, _ = tsc(ts, None, None)
+
+    other = make_problem(**kw)
+    other.init_solvers()
+    other.solver.ts.time = 0.0
+    other.solver.tsc.set_state(**saved)
+    got, _ = other.solver.tsc(other.solver.ts, None, None)
+    assert abs(got - expected) < 1e-18
