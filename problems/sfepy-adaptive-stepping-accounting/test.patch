+def slowing_adapt_fun(ts, status, adt, context=None, verbose=False):
+    adt.wait += 1
+    if adt.wait > 1:
+        adt.red = max(0.25, 0.5 * adt.red)
+        ts.set_time_step(adt.dt0 * adt.red)
+        adt.wait = 0
+
+    return True
