+def test_a_completed_run_reports_completed(clean_run):
+    _, status = clean_run
+    assert status.termination == 'completed'
+
+def test_a_completed_run_has_no_rejections(clean_run):
+    _, status = clean_run
+    assert status.n_rejected == 0
+    assert results(log_of(status)) == ['accept'] * len(log_of(status))
+
