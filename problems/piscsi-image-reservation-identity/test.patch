+class ImageReservationTest : public ::testing::Test
+{
+protected:
+
+	void SetUp() override
+	{
+		StorageDevice::UnreserveAll();
+		folder = temp_directory_path() / ("piscsi_reservation_" +
+				string(::testing::UnitTest::GetInstance()->current_test_info()->name()));
+		remove_all(folder);
+		create_directories(folder);
+		CreateImage("disk.hds");
+		ASSERT_TRUE(image.SetDefaultFolder(folder.string()).empty());
+	}
+
+	void TearDown() override
+	{
+		controller_manager.DeleteAllControllers();
+		StorageDevice::UnreserveAll();
+		error_code error;
+		remove_all(folder, error);
+	}
+
+	void CreateImage(const string& name) const
+	{
+		ofstream(folder / name).close();
+		resize_file(folder / name, 512 * 64);
+	}
+
+	void Link(const string& name, const string& target) const
+	{
+		create_symlink(folder / target, folder / name);
+	}
+
+	void HardLink(const string& name, const string& target) const
+	{
+		create_hard_link(folder / target, folder / name);
+	}
+
+	path Outside(const string& suffix) const
+	{
+		return folder.parent_path() / (folder.filename().string() + suffix);
+	}
+
+	static void AddDisk(PbCommand& command, int id, const string& file)
+	{
+		auto device = command.add_devices();
+		device->set_type(SCHD);
+		device->set_id(id);
+		device->set_unit(0);
+		SetParam(*device, "file", file);
+	}
+
+	bool Attach(int id, const string& file)
+	{
+		PbCommand command;
+		command.set_operation(ATTACH);
+		AddDisk(command, id, file);
+		return Execute(command);
+	}
+
+	bool Detach(int id)
+	{
+		PbCommand command;
+		command.set_operation(DETACH);
+		auto device = command.add_devices();
+		device->set_id(id);
+		device->set_unit(0);
+		return Execute(command);
+	}
+
+	bool AttachAs(PbDeviceType type, int id, const string& file, bool write_protected = false, int lun = 0)
+	{
+		PbCommand command;
+		command.set_operation(ATTACH);
+		auto device = command.add_devices();
+		device->set_type(type);
+		device->set_id(id);
+		device->set_unit(lun);
+		device->set_protected_(write_protected);
+		if (!file.empty()) {
+			SetParam(*device, "file", file);
+		}
+		return Execute(command);
+	}
+
+	bool AttachRemovable(int id, const string& file)
+	{
+		return AttachAs(SCRM, id, file);
+	}
+
+	static vector<id_set> HolderIds(const string& file)
+	{
+		vector<id_set> ids;
+		for (const auto& holder : StorageDevice::GetHoldersForReservedFile(file)) {
+			ids.push_back(holder.ids);
+		}
+		return ids;
+	}
+
+	static void AddDevice(PbCommand& command, PbDeviceType type, int id, const string& file, int lun = 0)
+	{
+		auto device = command.add_devices();
+		device->set_type(type);
+		device->set_id(id);
+		device->set_unit(lun);
+		SetParam(*device, "file", file);
+	}
+
+	bool Insert(int id, const string& file, int lun = 0)
+	{
+		PbCommand command;
+		command.set_operation(INSERT);
+		auto device = command.add_devices();
+		device->set_id(id);
+		device->set_unit(lun);
+		SetParam(*device, "file", file);
+		return Execute(command);
+	}
+
+	bool Eject(int id)
+	{
+		PbCommand command;
+		command.set_operation(EJECT);
+		auto device = command.add_devices();
+		device->set_id(id);
+		device->set_unit(0);
+		return Execute(command);
+	}
+
+	bool Execute(const PbCommand& command)
+	{
+		const CommandContext context(command, folder.string(), "");
+		return executor.ProcessCmd(context);
+	}
+
+	string ExecuteForError(const PbCommand& command)
+	{
+		PbResult result;
+		const CommandContext context(command, folder.string(), "en", &result);
+		EXPECT_FALSE(executor.ProcessCmd(context));
+		return result.msg();
+	}
+
+	bool ImageCommand(PbOperation operation, const string& key, const string& value, const string& key2 = "",
+			const string& value2 = "", PbResult *result = nullptr) const
+	{
+		PbCommand command;
+		command.set_operation(operation);
+		SetParam(command, key, value);
+		if (!key2.empty()) {
+			SetParam(command, key2, value2);
+		}
+		const CommandContext context(command, folder.string(), "en", result);
+		switch (operation) {
+		case CREATE_IMAGE:
+			return image.CreateImage(context);
+		case DELETE_IMAGE:
+			return image.DeleteImage(context);
+		case RENAME_IMAGE:
+			return image.RenameImage(context);
+		case COPY_IMAGE:
+			return image.CopyImage(context);
+		case PROTECT_IMAGE:
+		case UNPROTECT_IMAGE:
+			return image.SetImagePermissions(context);
+		default:
+			return false;
+		}
+	}
+
+	string Full(const string& name) const
+	{
+		return (folder / name).string();
+	}
+
+	path folder;
+	PiscsiImage image;
+	shared_ptr<MockBus> bus = make_shared<MockBus>();
+	ControllerManager controller_manager;
+	PiscsiExecutor executor { *bus, controller_manager };
+};
