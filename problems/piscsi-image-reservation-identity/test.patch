+#!/usr/bin/env bash
+set -uo pipefail
+
+MODE=""
+OUTPUT_PATH=""
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --output_path=*) OUTPUT_PATH="${1#--output_path=}"; shift ;;
+    --output_path)   OUTPUT_PATH="$2"; shift 2 ;;
+    base|new)        MODE="$1"; shift ;;
+    *)               shift ;;
+  esac
+done
+MODE="${MODE:-base}"
+OUTPUT_PATH="${OUTPUT_PATH:-/tmp/piscsi_test_results.xml}"
+mkdir -p "$(dirname "$OUTPUT_PATH")"
+
+ROOT="$(cd "$(dirname "$0")" && pwd)"
+cd "$ROOT/cpp" || exit 1
+
+NEW_SUITE="ImageReservationTest.*"
+BASE_EXCLUDE="PiscsiResponseTest.GetNetworkInterfacesInfo:StorageDeviceTest.ValidateFile"
+UNPRIVILEGED_TEST="StorageDeviceTest.ValidateFile"
+
+NEW_SOURCE="image_reservation_e3806d_test.cpp"
+
+write_failure_xml() {
+  local log="$1"
+  local names=""
+  if [ "$MODE" = "new" ]; then
+    names="$(sed -n 's/^TEST_F(ImageReservationTest, \([A-Za-z0-9_]*\)).*/\1/p' "test/$NEW_SOURCE")"
+  fi
+  if [ -z "$names" ]; then
+    names="compile"
+    suite="build"
+  else
+    suite="ImageReservationTest"
+  fi
+  local count
+  count="$(echo "$names" | wc -l)"
+  {
+    echo '<?xml version="1.0" encoding="UTF-8"?>'
+    echo "<testsuites tests=\"$count\" failures=\"$count\" errors=\"0\">"
+    echo "<testsuite name=\"$suite\" tests=\"$count\" failures=\"$count\" errors=\"0\">"
+    local first=1
+    for name in $names; do
+      echo "<testcase name=\"$name\" classname=\"$suite\">"
+      if [ "$first" = 1 ]; then
+        echo '<failure message="piscsi_test did not build or produced no results"><![CDATA['
+        tail -n 80 "$log" | sed 's/]]>/]] >/g'
+        echo ']]></failure>'
+        first=0
+      else
+        echo '<failure message="piscsi_test did not build or produced no results"/>'
+      fi
+      echo '</testcase>'
+    done
+    echo '</testsuite>'
+    echo '</testsuites>'
+  } > "$OUTPUT_PATH"
+}
+
+if [ "$MODE" = "new" ]; then
+  TEST_SOURCES="$(find ./test -name '*.cpp')"
+else
+  TEST_SOURCES="$(find ./test -name '*.cpp' ! -name "$NEW_SOURCE")"
+fi
+TEST_SOURCES="$TEST_SOURCES $(find ./scsidump -name '*.cpp' | grep -v scsidump.cpp)"
+
+BUILD_LOG="$(mktemp)"
+if ! make -j"$(nproc)" DEBUG=1 EXTRA_FLAGS=-g0 SRC_PISCSI_TEST="$TEST_SOURCES" bin/piscsi_test > "$BUILD_LOG" 2>&1; then
+  cat "$BUILD_LOG" >&2
+  write_failure_xml "$BUILD_LOG"
+  exit 1
+fi
+
+if [ "$MODE" = "new" ]; then
+  FILTER="$NEW_SUITE"
+else
+  FILTER="-$NEW_SUITE:$BASE_EXCLUDE"
+fi
+
+RUN_LOG="$(mktemp)"
+rm -f "$OUTPUT_PATH"
+GTEST_SHUFFLE=0 bin/piscsi_test --gtest_filter="$FILTER" --gtest_output="xml:$OUTPUT_PATH" > "$RUN_LOG" 2>&1
+STATUS=$?
+cat "$RUN_LOG"
+
+if [ ! -s "$OUTPUT_PATH" ] || ! grep -q '<testcase' "$OUTPUT_PATH"; then
+  write_failure_xml "$RUN_LOG"
+  exit 1
+fi
+
+if [ "$MODE" = "base" ]; then
+  EXTRA_DIR="$(mktemp -d)"
+  chmod 777 "$EXTRA_DIR"
+  RUN_AS=""
+  if [ "$(id -u)" = 0 ]; then
+    RUN_AS="setpriv --reuid=65534 --regid=65534 --clear-groups"
+  fi
+  $RUN_AS env GTEST_SHUFFLE=0 bin/piscsi_test --gtest_filter="$UNPRIVILEGED_TEST" \
+    --gtest_output="xml:$EXTRA_DIR/extra.xml" > "$EXTRA_DIR/extra.log" 2>&1 || STATUS=1
+  cat "$EXTRA_DIR/extra.log"
+  python3 - "$OUTPUT_PATH" "$EXTRA_DIR/extra.xml" "$UNPRIVILEGED_TEST" "$EXTRA_DIR/extra.log" <<'PY' || STATUS=1
+import sys
+import xml.etree.ElementTree as ET
+
+output, extra, name, log = sys.argv[1:5]
+tree = ET.parse(output)
+root = tree.getroot()
+try:
+    suites = ET.parse(extra).getroot().findall("testsuite")
+except (OSError, ET.ParseError):
+    suites = []
+if not any(suite.find("testcase") is not None for suite in suites):
+    suite_name, case_name = name.split(".")
+    suite = ET.Element("testsuite", name=suite_name, tests="1", failures="1", errors="0")
+    case = ET.SubElement(suite, "testcase", name=case_name, classname=suite_name)
+    failure = ET.SubElement(case, "failure", message="piscsi_test produced no results")
+    with open(log, errors="replace") as f:
+        failure.text = f.read()[-4000:]
+    suites = [suite]
+for suite in suites:
+    root.append(suite)
+for attribute in ("tests", "failures", "errors", "disabled"):
+    root.set(attribute, str(sum(int(suite.get(attribute, "0")) for suite in root.findall("testsuite"))))
+tree.write(output, encoding="UTF-8", xml_declaration=True)
+PY
+  rm -rf "$EXTRA_DIR"
+fi
+
+exit $STATUS
