+	EXPECT_NE(string::npos, disk_error.find("1:0, 3:0")) << disk_error;
+
+	PbCommand attach_cd;
+	attach_cd.set_operation(ATTACH);
+	AddDevice(attach_cd, SCCD, 4, Full("disk2.hds"));
+	const string cd_error = ExecuteForError(attach_cd);
+	EXPECT_NE(string::npos, cd_error.find("5:0")) << cd_error;
+
+	ASSERT_TRUE(AttachRemovable(6, ""));
+	PbCommand insert;
+	insert.set_operation(INSERT);
+	auto medium = insert.add_devices();
+	medium->set_id(6);
+	medium->set_unit(0);
+	SetParam(*medium, "file", "disk.hds");
+	const string insert_error = ExecuteForError(insert);
+	EXPECT_NE(string::npos, insert_error.find("1:0, 3:0")) << insert_error;
+
+	struct Refusal
+	{
+		PbOperation operation;
+		string key;
+		string value;
+		string key2;
+		string value2;
+	};
+	for (const auto& [operation, key, value, key2, value2] : vector<Refusal> {
+			{ DELETE_IMAGE, "file", "alias.hds", "", "" },
+			{ RENAME_IMAGE, "from", Full("disk.hds"), "to", "moved.hds" },
+			{ COPY_IMAGE, "from", "./alias.hds", "to", "copied.hds" },
+			{ PROTECT_IMAGE, "file", "disk.hds", "", "" },
+			{ UNPROTECT_IMAGE, "file", "sub/../disk.hds", "", "" } }) {
+		SCOPED_TRACE(PbOperation_Name(operation));
+		PbResult result;
+		EXPECT_FALSE(ImageCommand(operation, key, value, key2, value2, &result));
+		EXPECT_NE(string::npos, result.msg().find("1:0, 3:0")) << result.msg();
+	}
+	EXPECT_TRUE(is_symlink(folder / "alias.hds"));
+	EXPECT_FALSE(exists(folder / "moved.hds"));
+	EXPECT_FALSE(exists(folder / "copied.hds"));
+}
