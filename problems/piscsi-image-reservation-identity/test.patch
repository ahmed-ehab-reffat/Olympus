+TEST_F(ImageReservationTest, image_commands_refuse_names_outside_the_image_folder)
+{
+	const path outside = folder.parent_path() / (folder.filename().string() + "_outside.hds");
+	ofstream(outside).close();
+	const string relative = "../" + outside.filename().string();
+
+	EXPECT_FALSE(ImageCommand(DELETE_IMAGE, "file", relative));
+	EXPECT_FALSE(ImageCommand(DELETE_IMAGE, "file", outside.string()));
+	EXPECT_FALSE(ImageCommand(COPY_IMAGE, "from", relative, "to", "copy.hds"));
+	EXPECT_FALSE(ImageCommand(RENAME_IMAGE, "from", "disk.hds", "to", relative + ".moved"));
+	EXPECT_FALSE(ImageCommand(RENAME_IMAGE, "from", relative, "to", "moved.hds"));
+	EXPECT_FALSE(ImageCommand(RENAME_IMAGE, "from", outside.string(), "to", "moved.hds"));
+	EXPECT_FALSE(ImageCommand(RENAME_IMAGE, "from", "disk.hds", "to", outside.string() + ".moved"));
+	EXPECT_FALSE(ImageCommand(COPY_IMAGE, "from", outside.string(), "to", "copy.hds"));
+	EXPECT_FALSE(ImageCommand(COPY_IMAGE, "from", "disk.hds", "to", relative + ".copy"));
+	EXPECT_FALSE(ImageCommand(COPY_IMAGE, "from", "disk.hds", "to", outside.string() + ".copy"));
+	EXPECT_FALSE(ImageCommand(PROTECT_IMAGE, "file", relative));
+	EXPECT_FALSE(ImageCommand(PROTECT_IMAGE, "file", outside.string()));
+	EXPECT_TRUE(exists(outside));
+	EXPECT_NE(perms::none, filesystem::status(outside).permissions() & perms::owner_write);
+	permissions(outside, perms::owner_read | perms::group_read | perms::others_read);
+	EXPECT_FALSE(ImageCommand(UNPROTECT_IMAGE, "file", relative));
+	EXPECT_FALSE(ImageCommand(UNPROTECT_IMAGE, "file", outside.string()));
+	EXPECT_EQ(perms::none, filesystem::status(outside).permissions() & perms::owner_write);
+	EXPECT_TRUE(exists(folder / "disk.hds"));
+	EXPECT_FALSE(exists(folder / "copy.hds"));
+	EXPECT_FALSE(exists(folder / "moved.hds"));
+	EXPECT_FALSE(exists(outside.string() + ".moved"));
+	EXPECT_FALSE(exists(outside.string() + ".copy"));
+	error_code error;
+	remove(outside, error);
+	remove(outside.string() + ".moved", error);
+	remove(outside.string() + ".copy", error);
+}
